+class FlowPilotRequestHandler(WSGIRequestHandler):
+    """Werkzeug request handler exposing the raw request target and framing headers.
+
+    The raw request target is captured before any URL normalization so that the
+    unknown-path envelope can echo the octets exactly as they arrived on the
+    wire, decoded as ISO-8859-1 just like the standard library request-line
+    parser used to do.
+    """
+
+    def _capture_raw_request(self):
+        raw_target = None
+        raw_line = getattr(self, "raw_requestline", None)
+        if raw_line:
+            try:
+                decoded_line = bytes(raw_line).decode("iso-8859-1")
+            except Exception:
+                decoded_line = ""
+            words = decoded_line.rstrip("\r\n").split()
+            if len(words) >= 2:
+                raw_target = words[1]
+        if raw_target is None:
+            raw_target = getattr(self, "path", None)
+        self._flowpilot_raw_target = raw_target
+
+        headers = getattr(self, "headers", None)
+        if headers is not None and hasattr(headers, "get_all"):
+            self._flowpilot_te_values = list(headers.get_all("Transfer-Encoding") or [])
+            self._flowpilot_cl_values = list(headers.get_all("Content-Length") or [])
+        else:
+            self._flowpilot_te_values = []
+            self._flowpilot_cl_values = []
+
+    def parse_request(self):
+        success = super().parse_request()
+        if success:
+            try:
+                self._capture_raw_request()
+            except Exception:
+                self._flowpilot_raw_target = getattr(self, "path", None)
+                self._flowpilot_te_values = []
+                self._flowpilot_cl_values = []
+        return success
+
+    def _enrich_environ(self, environ):
+        raw_target = getattr(self, "_flowpilot_raw_target", None)
+        if raw_target is not None:
+            environ["FLOWPILOT_RAW_TARGET"] = raw_target
+
+        te_values = getattr(self, "_flowpilot_te_values", None)
+        if te_values:
+            environ["HTTP_TRANSFER_ENCODING"] = ",".join(str(item) for item in te_values)
+        environ["FLOWPILOT_TE_PRESENT"] = "1" if te_values else "0"
+
+        cl_values = getattr(self, "_flowpilot_cl_values", None)
+        if cl_values and "CONTENT_LENGTH" not in environ:
+            environ["CONTENT_LENGTH"] = str(cl_values[0])
+        environ["FLOWPILOT_CL_PRESENT"] = "1" if cl_values else "0"
+
+        if raw_target is not None:
+            try:
+                routing_target = raw_target
+                if routing_target.startswith("//"):
+                    routing_target = "/" + routing_target.lstrip("/")
+                split = urlsplit(routing_target)
+                path_bytes = unquote_to_bytes(split.path.encode("latin-1", errors="replace"))
+                environ["PATH_INFO"] = path_bytes.decode("latin-1", errors="replace")
+                environ["QUERY_STRING"] = split.query
+                environ["SCRIPT_NAME"] = ""
+            except Exception:
+                pass
+        return environ
+
+    def make_environ(self, *args, **kwargs):
+        environ = super().make_environ(*args, **kwargs)
+        return self._enrich_environ(environ)
+
+    def get_environ(self, *args, **kwargs):
+        environ = super().get_environ(*args, **kwargs)
+        return self._enrich_environ(environ)
+
+
+def _raw_request_target():
+    environ = request.environ
+    for key in ("FLOWPILOT_RAW_TARGET", "RAW_URI", "REQUEST_URI"):
+        value = environ.get(key)
+        if value is not None:
+            return value
+    script_name = environ.get("SCRIPT_NAME") or ""
+    path_info = environ.get("PATH_INFO") or ""
+    query_string = environ.get("QUERY_STRING") or ""
+    target = f"{script_name}{path_info}"
+    if query_string:
+        target = f"{target}?{query_string}"
+    return target
+
+
+def _validate_envelope():
+    environ = request.environ
+    te_marker = environ.get("FLOWPILOT_TE_PRESENT")
+    if te_marker == "1":
+        has_transfer_encoding = True
+    elif te_marker == "0":
+        has_transfer_encoding = False
+    else:
+        has_transfer_encoding = environ.get("HTTP_TRANSFER_ENCODING") is not None
+    cl_marker = environ.get("FLOWPILOT_CL_PRESENT")
+    if cl_marker == "1":
+        has_content_length = True
+    elif cl_marker == "0":
+        has_content_length = False
+    else:
+        has_content_length = environ.get("CONTENT_LENGTH") is not None
+
+    if has_content_length and has_transfer_encoding:
+        return error_response(500, "Ambiguous request framing")
+
+    if has_content_length:
+        raw_value = environ.get("CONTENT_LENGTH")
+        value = "" if raw_value is None else str(raw_value)
+        stripped = value.strip()
+        if not stripped or any(ch not in "0123456789" for ch in stripped):
+            return error_response(500, "Invalid Content-Length")
+        normalized = stripped.lstrip("0") or "0"
+        max_text = str(MAX_BODY_BYTES)
+        if len(normalized) > len(max_text) or (
+            len(normalized) == len(max_text) and normalized > max_text
+        ):
+            return error_response(413, "Request body too large")
+        environ["FLOWPILOT_CONTENT_LENGTH"] = normalized
+        return None
+
+    if has_transfer_encoding:
+        transfer_encoding = str(environ.get("HTTP_TRANSFER_ENCODING") or "").strip().lower()
+        if transfer_encoding != "chunked":
+            return error_response(500, "Unsupported Transfer-Encoding")
+        environ["FLOWPILOT_CHUNKED"] = "1"
+        return None
+
+    environ["FLOWPILOT_CONTENT_LENGTH"] = "0"
+    return None
+
+
+def _read_chunked_body(stream, limit):
+    data = bytearray()
+    while True:
+        line = stream.readline()
+        if not line:
+            break
+        size_field = line.split(b";", 1)[0].strip()
+        if not size_field:
+            break
+        try:
+            chunk_size = int(size_field, 16)
+        except ValueError as exc:
+            raise RuntimeError(f"Invalid chunked encoding: {exc}") from exc
+        if chunk_size == 0:
+            while True:
+                trailer = stream.readline()
+                if not trailer or trailer in (b"\r\n", b"\n"):
+                    break
+            break
+        if len(data) + chunk_size > limit:
+            raise BodyTooLarge()
+        chunk = stream.read(chunk_size)
+        if chunk is None:
+            chunk = b""
+        data.extend(chunk)
+        stream.readline()
+        if len(chunk) < chunk_size:
+            break
+    return bytes(data)
+
+
+def _read_body_bytes():
+    environ = request.environ
+    stream = environ.get("wsgi.input")
+    if environ.get("FLOWPILOT_CHUNKED") == "1":
+        if stream is None:
+            return b""
+        terminated = bool(environ.get("wsgi.input_terminated"))
+        if not terminated and type(stream).__name__ == "DechunkedInput":
+            terminated = True
+        if terminated:
+            data = stream.read(MAX_BODY_BYTES + 1)
+            if data is None:
+                data = b""
+            if len(data) > MAX_BODY_BYTES:
+                raise BodyTooLarge()
+            return data
+        return _read_chunked_body(stream, MAX_BODY_BYTES)
+
+    length_text = environ.get("FLOWPILOT_CONTENT_LENGTH") or "0"
+    try:
+        length = int(length_text)
+    except ValueError:
+        length = 0
+    if length <= 0 or stream is None:
+        return b""
+    data = stream.read(length)
+    if data is None:
+        return b""
+    return data
+
+
