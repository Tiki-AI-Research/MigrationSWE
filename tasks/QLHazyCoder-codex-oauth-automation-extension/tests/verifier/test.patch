new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0003/run_probe.py
@@ -0,0 +1,28 @@
+"""Source-side F2P probe runner for BATCH-F2P-0003.
+
+Executes the same F2P atomic claims against the source tree.  Because F2P is a
+target-only postcondition, every observation must fail here: the source tree
+serves through ``http.server`` and cannot satisfy the Flask postconditions.
+"""
+
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ASSET_ROOT = os.path.abspath(os.path.join(HERE, "..", "..", ".."))
+CORE_DIR = os.path.join(ASSET_ROOT, "shared", "batches", "BATCH-F2P-0003")
+sys.path.insert(0, CORE_DIR)
+
+import f2p_probe_core  # noqa: E402
+
+
+def main():
+    repo_root = os.environ.get("PROBE_ROOT", "/input/source")
+    out_path = os.path.join(HERE, "probe-results.json")
+    payload = f2p_probe_core.run(repo_root, out_path)
+    print("source probe completed")
+    return 0 if payload["summary"]["passed"] == 0 else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
