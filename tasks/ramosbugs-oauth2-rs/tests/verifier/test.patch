+#!/usr/bin/env python3
+"""Source-side INTEGRATION runtime entrypoint.
+
+Usage: source/runner [report.json]
+
+Runs the Rust reference projections authored by BATCH-P2P-0001 and
+BATCH-DIFFERENTIAL-0001 against the repository under test and evaluates the
+target-technology predicate for every BATCH-F2P observation, then writes a
+``migration-observations:v6`` report.  When the Rust toolchain is unavailable the
+cargo-backed observations are reported as INCONCLUSIVE rather than being faked.
+"""
+
+import sys
+from pathlib import Path
+
+ASSETS = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ASSETS / "shared" / "integration"))
+
+import harness  # noqa: E402
+
+
+def main() -> int:
+    report = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("/logs/result.json")
+    harness.write_report(report, harness.run_source(ASSETS, harness.repo_root()))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
