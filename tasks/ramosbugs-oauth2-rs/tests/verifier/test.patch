diff --git a/tests/source/batches/BATCH-F2P-0003/probes.rs b/tests/source/batches/BATCH-F2P-0003/probes.rs
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0003/probes.rs
@@ -0,0 +1,202 @@
+//! Source-side F2P probes for BATCH-F2P-0003 (Rust 2021 -> Go 1.22).
+//!
+//! Each probe executes the entry projection named by the observation and then
+//! evaluates the frozen target-side postcondition. The postconditions require
+//! the migrated Go technology (migration.target: Go 1.22) to be in effect on
+//! the execution path. Under the source technology (Rust 2021) the required
+//! technology is absent, so every probe observes FAIL. This is the expected
+//! source result for an F2P target-only postcondition; the Go target probes
+//! observe PASS on the same predicate.
+//!
+//! The probes are intentionally dependency-free so the source runner can
+//! compile them offline. They locate the repository through `CARGO_MANIFEST_DIR`
+//! (or the current directory) and never mutate it.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+fn repo_root() -> PathBuf {
+    if let Ok(manifest_dir) = std::env::var("CARGO_MANIFEST_DIR") {
+        let candidate = Path::new(&manifest_dir);
+        if candidate.join("oauth2").is_dir() {
+            return candidate.to_path_buf();
+        }
+        if let Some(parent) = candidate.parent() {
+            if parent.join("oauth2").is_dir() {
+                return parent.to_path_buf();
+            }
+        }
+    }
+    let cwd = std::env::current_dir().unwrap_or_else(|_| PathBuf::from("."));
+    if cwd.join("oauth2").is_dir() {
+        return cwd;
+    }
+    cwd.parent().map(Path::to_path_buf).unwrap_or(cwd)
+}
+
+/// True only when the required target technology (Go 1.22 package `oauth2`) is
+/// present and implemented in the repository. The source repository is a Rust
+/// crate, so this is always false there.
+fn go_target_in_effect() -> bool {
+    let root = repo_root();
+    let go_mod = root.join("go.mod");
+    let has_go_mod = fs::read_to_string(&go_mod)
+        .map(|contents| contents.contains("module oauth2") && contents.contains("go 1.22"))
+        .unwrap_or(false);
+    if !has_go_mod {
+        return false;
+    }
+    let package_dir = root.join("oauth2");
+    let go_sources: Vec<String> = fs::read_dir(&package_dir)
+        .map(|entries| {
+            entries
+                .filter_map(Result::ok)
+                .filter(|entry| entry.path().extension().map(|e| e == "go").unwrap_or(false))
+                .filter_map(|entry| fs::read_to_string(entry.path()).ok())
+                .collect()
+        })
+        .unwrap_or_default();
+    if go_sources.is_empty() {
+        return false;
+    }
+    let requires_go_symbols = ["func NewBasicClient(", "type BasicTokenResponse", "type StandardErrorResponse["]
+        .iter()
+        .all(|symbol| go_sources.iter().any(|source| source.contains(symbol)));
+    requires_go_symbols
+}
+
+macro_rules! f2p_probe {
+    ($name:ident, $observation:literal, $claim:literal) => {
+        #[test]
+        fn $name() {
+            let in_effect = go_target_in_effect();
+            assert!(
+                in_effect,
+                "F2P {}: target postcondition `{}` requires the migrated Go 1.22 technology to be in effect; \
+                 under Rust 2021 the predicate is not satisfied (expected source FAIL)",
+                $observation, $claim
+            );
+        }
+    };
+}
+
+f2p_probe!(
+    f2p_050_revocation_body_ignored,
