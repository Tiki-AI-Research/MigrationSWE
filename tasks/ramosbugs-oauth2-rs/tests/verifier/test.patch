+// f2pStripComments blanks // and /* */ comments while preserving string and
+// rune literals and the line structure, so a sink that only appears in prose
+// is not mistaken for a call.
+func f2pStripComments(text string) string {
+	out := make([]byte, 0, len(text))
+	n := len(text)
+	for i := 0; i < n; {
+		c := text[i]
+		if c == '"' || c == '\'' || c == '`' {
+			quote := c
+			out = append(out, c)
+			i++
+			for i < n {
+				ch := text[i]
+				if ch == '\\' && quote != '`' && i+1 < n {
+					out = append(out, ch, text[i+1])
+					i += 2
+					continue
+				}
+				out = append(out, ch)
+				i++
+				if ch == quote {
+					break
+				}
+			}
+			continue
+		}
+		if c == '/' && i+1 < n && text[i+1] == '/' {
+			for i < n && text[i] != '\n' {
+				out = append(out, ' ')
+				i++
+			}
+			continue
+		}
+		if c == '/' && i+1 < n && text[i+1] == '*' {
+			out = append(out, ' ', ' ')
+			i += 2
+			for i < n && !(text[i] == '*' && i+1 < n && text[i+1] == '/') {
+				if text[i] == '\n' {
+					out = append(out, '\n')
+				} else {
+					out = append(out, ' ')
+				}
+				i++
+			}
+			if i < n {
+				out = append(out, ' ', ' ')
+				i += 2
+			}
+			continue
+		}
+		out = append(out, c)
+		i++
+	}
+	return string(out)
+}
