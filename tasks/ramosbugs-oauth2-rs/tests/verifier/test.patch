+func TestAuthorizeURL(t *testing.T) {
+	client := p2pNewTestClient(t)
+	request, err := client.AuthorizeURL(func() o.CsrfToken { return o.NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
