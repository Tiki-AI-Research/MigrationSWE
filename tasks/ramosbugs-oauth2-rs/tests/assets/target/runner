#!/usr/bin/env python3
"""Target-side INTEGRATION runtime entrypoint.

Usage: target/runner [report.json]

Merges the executable target projections authored by BATCH-P2P-0001,
BATCH-F2P-0001, BATCH-F2P-0002, BATCH-F2P-0003 and BATCH-DIFFERENTIAL-0001 into a
single Go test workspace, executes them against the repository under test and
writes every required observation to a ``migration-observations:v6`` report.
"""

import sys
from pathlib import Path

ASSETS = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ASSETS / "shared" / "integration"))

import harness  # noqa: E402


def main() -> int:
    report = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("/logs/result.json")
    harness.write_report(report, harness.run_target(ASSETS, harness.repo_root()))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
