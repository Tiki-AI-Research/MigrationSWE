+
+func TestDeviceAuthResponseVerificationURLAlias(t *testing.T) {
+	var response StandardDeviceAuthorizationResponse
+	err := json.Unmarshal([]byte(`{
+		"device_code": "12345",
+		"verification_url": "https://verify/here",
