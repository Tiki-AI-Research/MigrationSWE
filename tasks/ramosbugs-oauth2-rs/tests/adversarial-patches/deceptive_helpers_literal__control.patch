+		TokenType    json.RawMessage `json:"token_type"`
+		ExpiresIn    *uint64         `json:"expires_in"`
+		RefreshToken *RefreshToken   `json:"refresh_token"`
+		Scope        *string         `json:"scope"`
+	}
+	if err := json.Unmarshal(data, &aux); err != nil {
