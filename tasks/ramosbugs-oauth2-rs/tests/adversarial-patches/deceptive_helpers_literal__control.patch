+package oauth2
+
+// BasicTokenType is the basic OAuth2 authorization token type.
+type BasicTokenType string
+
+const (
+	// BasicTokenTypeBearer is the bearer token type (RFC 6750).
+	BasicTokenTypeBearer BasicTokenType = "bearer"
+	// BasicTokenTypeMac is the MAC token type.
+	BasicTokenTypeMac BasicTokenType = "mac"
+)
+
+// TokenTypeString returns the canonical string for this token type.
+func (t BasicTokenType) TokenTypeString() string { return string(t) }
+
+// BasicErrorResponseType is the basic OAuth2 error response type.
+//
+// These error types are defined in Section 5.2 of RFC 6749.
+type BasicErrorResponseType string
+
+const (
+	BasicErrorResponseTypeInvalidClient        BasicErrorResponseType = "invalid_client"
+	BasicErrorResponseTypeInvalidGrant         BasicErrorResponseType = "invalid_grant"
+	BasicErrorResponseTypeInvalidRequest       BasicErrorResponseType = "invalid_request"
+	BasicErrorResponseTypeInvalidScope         BasicErrorResponseType = "invalid_scope"
+	BasicErrorResponseTypeUnauthorizedClient   BasicErrorResponseType = "unauthorized_client"
+	BasicErrorResponseTypeUnsupportedGrantType BasicErrorResponseType = "unsupported_grant_type"
+)
+
+// ErrorTypeString returns the canonical string for this error type.
+func (t BasicErrorResponseType) ErrorTypeString() string { return string(t) }
+
+// BasicErrorResponse is the error response specialization for the basic OAuth2
+// implementation.
+type BasicErrorResponse = StandardErrorResponse[BasicErrorResponseType]
+
+// BasicTokenResponse is the basic OAuth2 token response.
+type BasicTokenResponse = StandardTokenResponse[EmptyExtraTokenFields, BasicTokenType]
+
+// BasicTokenIntrospectionResponse is the basic OAuth2 token introspection response.
+type BasicTokenIntrospectionResponse = StandardTokenIntrospectionResponse[EmptyExtraTokenFields, BasicTokenType]
+
+// BasicRevocationErrorResponse is the revocation error response specialization
+// for the basic OAuth2 implementation.
+type BasicRevocationErrorResponse = StandardErrorResponse[RevocationErrorResponseType]
+
+// BasicClient is the basic OAuth2 client specialization.
+type BasicClient = Client[
+	BasicErrorResponse,
+	BasicTokenResponse,
+	BasicTokenIntrospectionResponse,
+	StandardRevocableToken,
+	BasicRevocationErrorResponse,
+]
+
+// BasicRequestTokenError is the token error specialization for the basic OAuth2
+// implementation.
+type BasicRequestTokenError = RequestTokenError
diff --git a/oauth2/client.go b/oauth2/client.go
new file mode 100644
index 0000000..ee6508d
--- /dev/null
+++ b/oauth2/client.go
@@ -0,0 +1,280 @@
+package oauth2
+
+// Client stores the configuration for an OAuth2 client.
+//
+// Because Go has no compile-time typestate, endpoint completeness is validated
+// at runtime: every flow accessor returns a ConfigurationError when its
+// required endpoint has not been configured.
+type Client[
+	TE ErrorResponse,
+	TR TokenResponse,
+	TIR TokenIntrospectionResponse,
+	RT RevocableToken,
+	TRE ErrorResponse,
+] struct {
+	clientID         ClientId
+	clientSecret     *ClientSecret
+	authType         AuthType
+	authURL          *AuthUrl
+	tokenURL         *TokenUrl
+	redirectURL      *RedirectUrl
+	deviceAuthURL    *DeviceAuthorizationUrl
+	introspectionURL *IntrospectionUrl
+	revocationURL    *RevocationUrl
+}
+
+// NewClient initializes an OAuth2 client with the specified client ID and the
+// given extension type parameters.
+func NewClient[TE ErrorResponse, TR TokenResponse, TIR TokenIntrospectionResponse, RT RevocableToken, TRE ErrorResponse](clientID ClientId) *Client[TE, TR, TIR, RT, TRE] {
+	return &Client[TE, TR, TIR, RT, TRE]{
+		clientID: clientID,
+		authType: BasicAuth,
+	}
+}
+
+// NewBasicClient initializes a basic OAuth2 client.
+func NewBasicClient(clientID ClientId) *BasicClient {
+	return NewClient[BasicErrorResponse, BasicTokenResponse, BasicTokenIntrospectionResponse, StandardRevocableToken, BasicRevocationErrorResponse](clientID)
+}
+
+// SetAuthType sets the type of client authentication used for communicating
+// with the authorization server. The default is BasicAuth.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetAuthType(authType AuthType) *Client[TE, TR, TIR, RT, TRE] {
+	c.authType = authType
+	return c
+}
+
+// SetClientSecret sets the client secret.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetClientSecret(secret ClientSecret) *Client[TE, TR, TIR, RT, TRE] {
+	c.clientSecret = &secret
+	return c
+}
+
+// SetAuthURL sets the authorization endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetAuthURL(url *AuthUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.authURL = url
+	return c
+}
+
+// SetAuthURLOption conditionally sets the authorization endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetAuthURLOption(url *AuthUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.authURL = url
+	return c
+}
+
+// SetTokenURL sets the token endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetTokenURL(url *TokenUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.tokenURL = url
+	return c
+}
+
+// SetTokenURLOption conditionally sets the token endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetTokenURLOption(url *TokenUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.tokenURL = url
+	return c
+}
+
+// SetRedirectURL sets the redirect URL used by the authorization endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetRedirectURL(url *RedirectUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.redirectURL = url
+	return c
+}
+
+// SetDeviceAuthorizationURL sets the device authorization endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetDeviceAuthorizationURL(url *DeviceAuthorizationUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.deviceAuthURL = url
+	return c
+}
+
+// SetDeviceAuthorizationURLOption conditionally sets the device authorization endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetDeviceAuthorizationURLOption(url *DeviceAuthorizationUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.deviceAuthURL = url
+	return c
+}
+
+// SetIntrospectionURL sets the RFC 7662 introspection endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetIntrospectionURL(url *IntrospectionUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.introspectionURL = url
+	return c
+}
+
+// SetIntrospectionURLOption conditionally sets the RFC 7662 introspection endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetIntrospectionURLOption(url *IntrospectionUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.introspectionURL = url
+	return c
+}
+
+// SetRevocationURL sets the RFC 7009 revocation endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetRevocationURL(url *RevocationUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.revocationURL = url
+	return c
+}
+
+// SetRevocationURLOption conditionally sets the RFC 7009 revocation endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) SetRevocationURLOption(url *RevocationUrl) *Client[TE, TR, TIR, RT, TRE] {
+	c.revocationURL = url
+	return c
+}
+
+// ClientId returns the client ID.
+func (c *Client[TE, TR, TIR, RT, TRE]) ClientId() ClientId { return c.clientID }
+
+// AuthType returns the type of client authentication in use.
+func (c *Client[TE, TR, TIR, RT, TRE]) AuthType() AuthType { return c.authType }
+
+// RedirectURI returns the redirect URL, if set.
+func (c *Client[TE, TR, TIR, RT, TRE]) RedirectURI() *RedirectUrl { return c.redirectURL }
+
+// AuthURI returns the authorization endpoint, if set.
+func (c *Client[TE, TR, TIR, RT, TRE]) AuthURI() *AuthUrl { return c.authURL }
+
+// TokenURI returns the token endpoint, if set.
+func (c *Client[TE, TR, TIR, RT, TRE]) TokenURI() *TokenUrl { return c.tokenURL }
+
+// DeviceAuthorizationURL returns the device authorization endpoint, if set.
+func (c *Client[TE, TR, TIR, RT, TRE]) DeviceAuthorizationURL() *DeviceAuthorizationUrl {
+	return c.deviceAuthURL
+}
+
+// IntrospectionURL returns the introspection endpoint, if set.
+func (c *Client[TE, TR, TIR, RT, TRE]) IntrospectionURL() *IntrospectionUrl {
+	return c.introspectionURL
+}
+
+// RevocationURL returns the revocation endpoint, if set.
+func (c *Client[TE, TR, TIR, RT, TRE]) RevocationURL() *RevocationUrl { return c.revocationURL }
+
+func missingURLError(endpoint string) *ConfigurationError {
+	return &ConfigurationError{Kind: ConfigurationMissingURL, Endpoint: endpoint}
+}
+
+// AuthorizeURL generates an authorization URL for a new authorization request.
+func (c *Client[TE, TR, TIR, RT, TRE]) AuthorizeURL(stateFn func() CsrfToken) (*AuthorizationRequest, error) {
+	if c.authURL == nil {
+		return nil, missingURLError("authorization")
+	}
+	return newAuthorizationRequest(c.authURL, c.clientID, c.redirectURL, stateFn()), nil
+}
+
+// ExchangeCode exchanges a code returned during the authorization code flow for
+// an access token.
+func (c *Client[TE, TR, TIR, RT, TRE]) ExchangeCode(code AuthorizationCode) (*CodeTokenRequest[TE, TR], error) {
+	if c.tokenURL == nil {
+		return nil, missingURLError("token")
+	}
+	return &CodeTokenRequest[TE, TR]{
+		authType:     c.authType,
+		clientID:     c.clientID,
+		clientSecret: c.clientSecret,
+		code:         code,
+		tokenURL:     c.tokenURL,
+		redirectURL:  c.redirectURL,
+	}, nil
+}
+
+// ExchangeClientCredentials requests an access token using the client
+// credentials flow.
+func (c *Client[TE, TR, TIR, RT, TRE]) ExchangeClientCredentials() (*ClientCredentialsTokenRequest[TE, TR], error) {
+	if c.tokenURL == nil {
+		return nil, missingURLError("token")
+	}
+	return &ClientCredentialsTokenRequest[TE, TR]{
+		authType:     c.authType,
+		clientID:     c.clientID,
+		clientSecret: c.clientSecret,
+		tokenURL:     c.tokenURL,
+	}, nil
+}
+
+// ExchangePassword requests an access token using the resource owner password
+// credentials flow.
+func (c *Client[TE, TR, TIR, RT, TRE]) ExchangePassword(username *ResourceOwnerUsername, password *ResourceOwnerPassword) (*PasswordTokenRequest[TE, TR], error) {
+	if c.tokenURL == nil {
+		return nil, missingURLError("token")
+	}
+	return &PasswordTokenRequest[TE, TR]{
+		authType:     c.authType,
+		clientID:     c.clientID,
+		clientSecret: c.clientSecret,
+		username:     username,
+		password:     password,
+		tokenURL:     c.tokenURL,
+	}, nil
+}
+
+// ExchangeRefreshToken exchanges a refresh token for an access token.
+func (c *Client[TE, TR, TIR, RT, TRE]) ExchangeRefreshToken(refreshToken *RefreshToken) (*RefreshTokenRequest[TE, TR], error) {
+	if c.tokenURL == nil {
+		return nil, missingURLError("token")
+	}
+	return &RefreshTokenRequest[TE, TR]{
+		authType:     c.authType,
+		clientID:     c.clientID,
+		clientSecret: c.clientSecret,
+		refreshToken: refreshToken,
+		tokenURL:     c.tokenURL,
+	}, nil
+}
+
+// ExchangeDeviceCode begins the device authorization flow.
+func (c *Client[TE, TR, TIR, RT, TRE]) ExchangeDeviceCode() (*DeviceAuthorizationRequest[TE], error) {
+	if c.deviceAuthURL == nil {
+		return nil, missingURLError("device authorization")
+	}
+	return &DeviceAuthorizationRequest[TE]{
+		authType:      c.authType,
+		clientID:      c.clientID,
+		clientSecret:  c.clientSecret,
+		deviceAuthURL: c.deviceAuthURL,
+	}, nil
+}
+
+// ExchangeDeviceAccessToken polls the token endpoint for an access token.
+func (c *Client[TE, TR, TIR, RT, TRE]) ExchangeDeviceAccessToken(response DeviceAuthorizationResponseLike) (*DeviceAccessTokenRequest[TR], error) {
+	if c.tokenURL == nil {
+		return nil, missingURLError("token")
+	}
+	return &DeviceAccessTokenRequest[TR]{
+		authType:     c.authType,
+		clientID:     c.clientID,
+		clientSecret: c.clientSecret,
+		tokenURL:     c.tokenURL,
+		deviceCode:   response.DeviceCode(),
+		interval:     response.Interval(),
+		expiresIn:    response.ExpiresIn(),
+		timeFn:       defaultTimeFunc,
+	}, nil
+}
+
+// Introspect retrieves metadata for an access token using the RFC 7662
+// introspection endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) Introspect(token *AccessToken) (*IntrospectionRequest[TE, TIR], error) {
+	if c.introspectionURL == nil {
+		return nil, missingURLError("introspection")
+	}
+	return &IntrospectionRequest[TE, TIR]{
+		authType:         c.authType,
+		clientID:         c.clientID,
+		clientSecret:     c.clientSecret,
+		token:            token,
+		introspectionURL: c.introspectionURL,
+	}, nil
+}
+
+// RevokeToken revokes an access or refresh token using the RFC 7009 revocation
+// endpoint.
+func (c *Client[TE, TR, TIR, RT, TRE]) RevokeToken(token RT) (*RevocationRequest[RT, TRE], error) {
+	if c.revocationURL == nil {
+		return nil, missingURLError("revocation")
+	}
+	if c.revocationURL.URL().Scheme != "https" {
+		return nil, &ConfigurationError{Kind: ConfigurationInsecureURL, Endpoint: "revocation"}
+	}
+	return &RevocationRequest[RT, TRE]{
+		authType:      c.authType,
+		clientID:      c.clientID,
+		clientSecret:  c.clientSecret,
+		token:         token,
+		revocationURL: c.revocationURL,
+	}, nil
+}
diff --git a/oauth2/code.go b/oauth2/code.go
new file mode 100644
index 0000000..5808106
--- /dev/null
+++ b/oauth2/code.go
@@ -0,0 +1,111 @@
+package oauth2
+
+import (
+	"net/url"
+	"strings"
+)
+
+// AuthorizationRequest is a request to the authorization endpoint.
+type AuthorizationRequest struct {
+	authURL       *AuthUrl
+	clientID      ClientId
+	redirectURL   *RedirectUrl
+	responseType  string
+	pkceChallenge *PkceCodeChallenge
+	scopes        []Scope
+	extraParams   []param
+	state         CsrfToken
+}
+
+func newAuthorizationRequest(authURL *AuthUrl, clientID ClientId, redirectURL *RedirectUrl, state CsrfToken) *AuthorizationRequest {
+	return &AuthorizationRequest{
+		authURL:      authURL,
+		clientID:     clientID,
+		redirectURL:  redirectURL,
+		responseType: "code",
+		state:        state,
+	}
+}
+
+// AddScope appends a new scope to the authorization URL.
+func (r *AuthorizationRequest) AddScope(scope Scope) *AuthorizationRequest {
+	r.scopes = append(r.scopes, scope)
+	return r
+}
+
+// AddScopes appends a collection of scopes to the authorization URL.
+func (r *AuthorizationRequest) AddScopes(scopes []Scope) *AuthorizationRequest {
+	r.scopes = append(r.scopes, scopes...)
+	return r
+}
+
+// AddExtraParam appends an extra param to the authorization URL.
+func (r *AuthorizationRequest) AddExtraParam(name, value string) *AuthorizationRequest {
+	r.extraParams = append(r.extraParams, param{name, value})
+	return r
+}
+
+// UseImplicitFlow enables the implicit grant flow.
+func (r *AuthorizationRequest) UseImplicitFlow() *AuthorizationRequest {
+	r.responseType = "token"
+	return r
+}
+
+// SetResponseType enables custom flows other than the code and token grants.
+func (r *AuthorizationRequest) SetResponseType(responseType ResponseType) *AuthorizationRequest {
+	r.responseType = responseType.String()
+	return r
+}
+
+// SetPkceChallenge enables PKCE.
+func (r *AuthorizationRequest) SetPkceChallenge(challenge PkceCodeChallenge) *AuthorizationRequest {
+	r.pkceChallenge = &challenge
+	return r
+}
+
+// SetRedirectURI overrides the redirect_url.
+func (r *AuthorizationRequest) SetRedirectURI(redirectURL RedirectUrl) *AuthorizationRequest {
+	r.redirectURL = &redirectURL
+	return r
+}
+
+// URL returns the full authorization URL and the CSRF state for this request.
+func (r *AuthorizationRequest) URL() (*url.URL, CsrfToken) {
+	pairs := []param{
+		{"response_type", r.responseType},
+		{"client_id", r.clientID.String()},
+		{"state", r.state.Secret()},
+	}
+
+	if r.pkceChallenge != nil {
+		pairs = append(pairs,
+			param{"code_challenge", r.pkceChallenge.AsStr()},
+			param{"code_challenge_method", r.pkceChallenge.ChallengeMethod().String()},
+		)
+	}
+
+	if r.redirectURL != nil {
+		pairs = append(pairs, param{"redirect_uri", r.redirectURL.String()})
+	}
+
+	if len(r.scopes) > 0 {
+		pairs = append(pairs, param{"scope", serializeSpaceDelimitedVec(r.scopes)})
+	}
+
+	pairs = append(pairs, r.extraParams...)
+
+	base := *r.authURL.URL()
+	var b strings.Builder
+	b.WriteString(base.RawQuery)
+	for _, p := range pairs {
+		if b.Len() > 0 {
+			b.WriteByte('&')
+		}
+		b.WriteString(url.QueryEscape(p.key))
+		b.WriteByte('=')
+		b.WriteString(url.QueryEscape(p.value))
+	}
+	base.RawQuery = b.String()
+
+	return &base, r.state
+}
diff --git a/oauth2/code_test.go b/oauth2/code_test.go
new file mode 100644
index 0000000..ab02e2f
--- /dev/null
+++ b/oauth2/code_test.go
@@ -0,0 +1,145 @@
+package oauth2
+
+import "testing"
+
+func TestAuthorizeURL(t *testing.T) {
+	client := newTestClient(t)
+	request, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
+	}
+	url, state := request.URL()
+	if url.String() != "https://example.com/auth?response_type=code&client_id=aaa&state=csrf_token" {
+		t.Fatalf("got %q", url.String())
+	}
+	if state.Secret() != "csrf_token" {
+		t.Fatalf("state: got %q", state.Secret())
+	}
+}
+
+func TestAuthorizeURLPKCE(t *testing.T) {
+	client := newTestClient(t)
+	verifier := NewPkceCodeVerifier("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")
+	request, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
+	}
+	url, _ := request.SetPkceChallenge(NewPkceCodeChallengeFromVerifierSha256(verifier)).URL()
+	want := "https://example.com/auth" +
+		"?response_type=code&client_id=aaa" +
+		"&state=csrf_token" +
+		"&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM" +
+		"&code_challenge_method=S256"
+	if url.String() != want {
+		t.Fatalf("got %q, want %q", url.String(), want)
+	}
+}
+
+func TestAuthorizeURLImplicit(t *testing.T) {
+	client := newTestClient(t)
+	request, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
+	}
+	url, _ := request.UseImplicitFlow().URL()
+	if url.String() != "https://example.com/auth?response_type=token&client_id=aaa&state=csrf_token" {
+		t.Fatalf("got %q", url.String())
+	}
+}
+
+func TestAuthorizeURLWithParam(t *testing.T) {
+	client := NewBasicClient(NewClientId("aaa")).
+		SetClientSecret(NewClientSecret("bbb")).
+		SetAuthURL(mustAuthURL(t, "https://example.com/auth?foo=bar")).
+		SetTokenURL(mustTokenURL(t, "https://example.com/token"))
+
+	request, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
+	}
+	url, _ := request.URL()
+	if url.String() != "https://example.com/auth?foo=bar&response_type=code&client_id=aaa&state=csrf_token" {
+		t.Fatalf("got %q", url.String())
+	}
+}
+
+func TestAuthorizeURLWithScopes(t *testing.T) {
+	client := newTestClient(t)
+	request, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
+	}
+	url, _ := request.AddScopes([]Scope{NewScope("read"), NewScope("write")}).URL()
+	want := "https://example.com/auth?response_type=code&client_id=aaa&state=csrf_token&scope=read+write"
+	if url.String() != want {
+		t.Fatalf("got %q, want %q", url.String(), want)
+	}
+}
+
+func TestAuthorizeURLWithOneScope(t *testing.T) {
+	client := newTestClient(t)
+	request, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
+	}
+	url, _ := request.AddScope(NewScope("read")).URL()
+	want := "https://example.com/auth?response_type=code&client_id=aaa&state=csrf_token&scope=read"
+	if url.String() != want {
+		t.Fatalf("got %q, want %q", url.String(), want)
+	}
+}
+
+func TestAuthorizeURLWithExtensionResponseType(t *testing.T) {
+	client := newTestClient(t)
+	request, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
+	}
+	url, _ := request.
+		SetResponseType(NewResponseType("code token")).
+		AddExtraParam("foo", "bar").
+		URL()
+	want := "https://example.com/auth?response_type=code+token&client_id=aaa&state=csrf_token&foo=bar"
+	if url.String() != want {
+		t.Fatalf("got %q, want %q", url.String(), want)
+	}
+}
+
+func TestAuthorizeURLWithRedirectURL(t *testing.T) {
+	client := newTestClient(t).
+		SetRedirectURL(mustRedirectURL(t, "https://localhost/redirect"))
+	request, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
+	}
+	url, _ := request.URL()
+	want := "https://example.com/auth?response_type=code&client_id=aaa&state=csrf_token" +
+		"&redirect_uri=https%3A%2F%2Flocalhost%2Fredirect"
+	if url.String() != want {
+		t.Fatalf("got %q, want %q", url.String(), want)
+	}
+}
+
+func TestAuthorizeURLWithRedirectURLOverride(t *testing.T) {
+	client := newTestClient(t).
+		SetRedirectURL(mustRedirectURL(t, "https://localhost/redirect"))
+	request, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("csrf_token") })
+	if err != nil {
+		t.Fatal(err)
+	}
+	url, _ := request.SetRedirectURI(*mustRedirectURL(t, "https://localhost/alternative")).URL()
+	want := "https://example.com/auth?response_type=code&client_id=aaa&state=csrf_token" +
+		"&redirect_uri=https%3A%2F%2Flocalhost%2Falternative"
+	if url.String() != want {
+		t.Fatalf("got %q, want %q", url.String(), want)
+	}
+}
+
+func TestAuthorizeURLMissingEndpoint(t *testing.T) {
+	client := NewBasicClient(NewClientId("aaa"))
+	if _, err := client.AuthorizeURL(func() CsrfToken { return NewCsrfToken("x") }); err == nil {
+		t.Fatal("expected missing-URL error")
+	} else if err.Error() != "No authorization endpoint URL specified" {
+		t.Fatalf("got %q", err.Error())
+	}
+}
diff --git a/oauth2/devicecode.go b/oauth2/devicecode.go
new file mode 100644
index 0000000..315c9ae
--- /dev/null
+++ b/oauth2/devicecode.go
@@ -0,0 +1,347 @@
+package oauth2
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+)
+
+// DeviceCodeErrorResponseType is the device authorization error type.
+type DeviceCodeErrorResponseType string
+
+const (
+	DeviceCodeErrorResponseTypeAuthorizationPending DeviceCodeErrorResponseType = "authorization_pending"
+	DeviceCodeErrorResponseTypeSlowDown             DeviceCodeErrorResponseType = "slow_down"
+	DeviceCodeErrorResponseTypeAccessDenied         DeviceCodeErrorResponseType = "access_denied"
+	DeviceCodeErrorResponseTypeExpiredToken         DeviceCodeErrorResponseType = "expired_token"
+)
+
+// ErrorTypeString returns the canonical string for this error type.
+func (t DeviceCodeErrorResponseType) ErrorTypeString() string { return string(t) }
+
+// DeviceCodeErrorResponse is the error response specialization for the device
+// code flow.
+type DeviceCodeErrorResponse = StandardErrorResponse[DeviceCodeErrorResponseType]
+
+const defaultDeviceCodeIntervalSeconds = 5
+
+func defaultTimeFunc() time.Time { return time.Now() }
+
+// ExtraDeviceAuthorizationFields is implemented by user-defined types that add
+// extra fields to a device authorization response.
+//
+// (Declared in traits.go as well; this comment documents the device-specific use.)
+
+// EmptyExtraDeviceAuthorizationFields is the default (empty) extra device
+// authorization fields.
+type EmptyExtraDeviceAuthorizationFields struct{}
+
+func (EmptyExtraDeviceAuthorizationFields) IsExtraDeviceAuthorizationFields() {}
+
+// DeviceAuthorizationResponse is the standard OAuth2 device authorization
+// response, extended by EF.
+type DeviceAuthorizationResponse[EF ExtraDeviceAuthorizationFields] struct {
+	deviceCode              DeviceCode
+	userCode                UserCode
+	verificationURI         EndUserVerificationUrl
+	verificationURIComplete *VerificationUriComplete
+	expiresIn               uint64
+	interval                uint64
+	extraFields             EF
+}
+
+// StandardDeviceAuthorizationResponse throws away extra received response fields.
+type StandardDeviceAuthorizationResponse = DeviceAuthorizationResponse[EmptyExtraDeviceAuthorizationFields]
+
+// DeviceAuthorizationResponseLike is the subset of a device authorization
+// response needed to poll for an access token. It allows callers to use custom
+// extra-field types with the device access token flow.
+type DeviceAuthorizationResponseLike interface {
+	DeviceCode() DeviceCode
+	Interval() time.Duration
+	ExpiresIn() time.Duration
+}
+
+// DeviceCode returns the device verification code.
+func (r *DeviceAuthorizationResponse[EF]) DeviceCode() DeviceCode { return r.deviceCode }
+
+// UserCode returns the end-user verification code.
+func (r *DeviceAuthorizationResponse[EF]) UserCode() UserCode { return r.userCode }
+
+// VerificationURI returns the end-user verification URI.
+func (r *DeviceAuthorizationResponse[EF]) VerificationURI() EndUserVerificationUrl {
+	return r.verificationURI
+}
+
+// VerificationURIComplete returns the verification URI including the user code, if any.
+func (r *DeviceAuthorizationResponse[EF]) VerificationURIComplete() *VerificationUriComplete {
+	return r.verificationURIComplete
+}
+
+// ExpiresIn returns the lifetime of the device_code and user_code.
+func (r *DeviceAuthorizationResponse[EF]) ExpiresIn() time.Duration {
+	return time.Duration(r.expiresIn) * time.Second
+}
+
+// Interval returns the minimum polling interval.
+func (r *DeviceAuthorizationResponse[EF]) Interval() time.Duration {
+	return time.Duration(r.interval) * time.Second
+}
+
+// ExtraFields returns the user-defined extra fields.
+func (r *DeviceAuthorizationResponse[EF]) ExtraFields() EF { return r.extraFields }
+
+// UnmarshalJSON implements the interval default and the legacy verification_url alias.
+func (r *DeviceAuthorizationResponse[EF]) UnmarshalJSON(data []byte) error {
+	var aux struct {
+		DeviceCode              string          `json:"device_code"`
+		UserCode                string          `json:"user_code"`
+		VerificationURI         string          `json:"verification_uri"`
+		VerificationURL         string          `json:"verification_url"`
+		VerificationURIComplete *string         `json:"verification_uri_complete"`
+		ExpiresIn               uint64          `json:"expires_in"`
+		Interval                json.RawMessage `json:"interval"`
+	}
+	if err := json.Unmarshal(data, &aux); err != nil {
+		return err
+	}
+	r.deviceCode = NewDeviceCode(aux.DeviceCode)
+	r.userCode = NewUserCode(aux.UserCode)
+
+	verificationURI := aux.VerificationURI
+	if verificationURI == "" {
+		verificationURI = aux.VerificationURL
+	}
+	parsedURI, err := NewEndUserVerificationUrl(verificationURI)
+	if err != nil {
+		return err
+	}
+	r.verificationURI = parsedURI
+
+	if aux.VerificationURIComplete != nil {
+		complete := NewVerificationUriComplete(*aux.VerificationURIComplete)
+		r.verificationURIComplete = &complete
+	}
+	r.expiresIn = aux.ExpiresIn
+
+	r.interval = defaultDeviceCodeIntervalSeconds
+	if len(aux.Interval) > 0 && string(aux.Interval) != "null" {
+		var interval uint64
+		if err := json.Unmarshal(aux.Interval, &interval); err != nil {
+			return err
+		}
+		r.interval = interval
+	}
+
+	var ef EF
+	if err := json.Unmarshal(data, &ef); err != nil {
+		return err
+	}
+	r.extraFields = ef
+	return nil
+}
+
+// DeviceAuthorizationRequest is a request for a set of verification codes from
+// the authorization server.
+type DeviceAuthorizationRequest[TE ErrorResponse] struct {
+	authType      AuthType
+	clientID      ClientId
+	clientSecret  *ClientSecret
+	extraParams   []param
+	scopes        []Scope
+	deviceAuthURL *DeviceAuthorizationUrl
+}
+
+// AddExtraParam appends an extra param to the device authorization request.
+func (r *DeviceAuthorizationRequest[TE]) AddExtraParam(name, value string) *DeviceAuthorizationRequest[TE] {
+	r.extraParams = append(r.extraParams, param{name, value})
+	return r
+}
+
+// AddScope appends a new scope to the device authorization request.
+func (r *DeviceAuthorizationRequest[TE]) AddScope(scope Scope) *DeviceAuthorizationRequest[TE] {
+	r.scopes = append(r.scopes, scope)
+	return r
+}
+
+// AddScopes appends a collection of scopes to the device authorization request.
+func (r *DeviceAuthorizationRequest[TE]) AddScopes(scopes []Scope) *DeviceAuthorizationRequest[TE] {
+	r.scopes = append(r.scopes, scopes...)
+	return r
+}
+
+func (r *DeviceAuthorizationRequest[TE]) prepareRequest() HTTPRequest {
+	return endpointRequest(r.authType, r.clientID, r.clientSecret, r.extraParams, nil, r.scopes, r.deviceAuthURL.URL(), nil)
+}
+
+// Request synchronously sends the request and awaits a response.
+func (r *DeviceAuthorizationRequest[TE]) Request(client SyncHTTPClient) (*StandardDeviceAuthorizationResponse, *RequestTokenError) {
+	response, err := client.Call(r.prepareRequest())
+	if err != nil {
+		return nil, newRequestError(err)
+	}
+	out, tokenErr := endpointResponse[TE, StandardDeviceAuthorizationResponse](response)
+	if tokenErr != nil {
+		return nil, tokenErr
+	}
+	return &out, nil
+}
+
+// RequestAsync asynchronously sends the request and awaits a response.
+func (r *DeviceAuthorizationRequest[TE]) RequestAsync(ctx context.Context, client AsyncHTTPClient) (*StandardDeviceAuthorizationResponse, *RequestTokenError) {
+	response, err := client.Call(ctx, r.prepareRequest())
+	if err != nil {
+		return nil, newRequestError(err)
+	}
+	out, tokenErr := endpointResponse[TE, StandardDeviceAuthorizationResponse](response)
+	if tokenErr != nil {
+		return nil, tokenErr
+	}
+	return &out, nil
+}
+
+// DeviceAccessTokenRequest is a request for a device access token.
+type DeviceAccessTokenRequest[TR TokenResponse] struct {
+	authType     AuthType
+	clientID     ClientId
+	clientSecret *ClientSecret
+	extraParams  []param
+	tokenURL     *TokenUrl
+	deviceCode   DeviceCode
+	interval     time.Duration
+	expiresIn    time.Duration
+	timeFn       func() time.Time
+	maxBackoff   *time.Duration
+}
+
+// AddExtraParam appends an extra param to the token request.
+func (r *DeviceAccessTokenRequest[TR]) AddExtraParam(name, value string) *DeviceAccessTokenRequest[TR] {
+	r.extraParams = append(r.extraParams, param{name, value})
+	return r
+}
+
+// SetTimeFunc specifies a function for returning the current time.
+func (r *DeviceAccessTokenRequest[TR]) SetTimeFunc(timeFn func() time.Time) *DeviceAccessTokenRequest[TR] {
+	r.timeFn = timeFn
+	return r
+}
+
+// SetMaxBackoffInterval sets the upper limit of the sleep interval used when
+// the HTTP client returns an error.
+func (r *DeviceAccessTokenRequest[TR]) SetMaxBackoffInterval(interval time.Duration) *DeviceAccessTokenRequest[TR] {
+	r.maxBackoff = &interval
+	return r
+}
+
+func (r *DeviceAccessTokenRequest[TR]) prepareRequest() HTTPRequest {
+	params := []param{
+		{"grant_type", "urn:ietf:params:oauth:grant-type:device_code"},
+		{"device_code", r.deviceCode.Secret()},
+	}
+	return endpointRequest(r.authType, r.clientID, r.clientSecret, r.extraParams, nil, nil, r.tokenURL.URL(), params)
+}
+
+func (r *DeviceAccessTokenRequest[TR]) computeTimeout(timeout *time.Duration) time.Time {
+	duration := r.expiresIn
+	if timeout != nil {
+		duration = *timeout
+	}
+	return r.timeFn().Add(duration)
+}
+
+type devicePollResult[TR any] struct {
+	cont     bool
+	interval time.Duration
+	value    TR
+	err      *RequestTokenError
+}
+
+func (r *DeviceAccessTokenRequest[TR]) processResponse(response HTTPResponse, callErr error, current time.Duration) devicePollResult[TR] {
+	if callErr != nil {
+		cap := 10 * time.Second
+		if r.maxBackoff != nil {
+			cap = *r.maxBackoff
+		}
+		newInterval := current * 2
+		if newInterval > cap {
+			newInterval = cap
+		}
+		return devicePollResult[TR]{cont: true, interval: newInterval}
+	}
+
+	result, err := endpointResponse[DeviceCodeErrorResponse, TR](response)
+	if err != nil && err.Kind == RequestTokenErrorServerResponse {
+		if dcer, ok := err.Response.(DeviceCodeErrorResponse); ok {
+			switch dcer.Error {
+			case DeviceCodeErrorResponseTypeAuthorizationPending:
+				return devicePollResult[TR]{cont: true, interval: current}
+			case DeviceCodeErrorResponseTypeSlowDown:
+				return devicePollResult[TR]{cont: true, interval: current + 5*time.Second}
+			}
+		}
+	}
+	if err != nil {
+		var zero TR
+		return devicePollResult[TR]{value: zero, err: err}
+	}
+	return devicePollResult[TR]{value: result}
+}
+
+func (r *DeviceAccessTokenRequest[TR]) expiredTokenError() *RequestTokenError {
+	description := "This device code has expired."
+	return &RequestTokenError{
+		Kind: RequestTokenErrorServerResponse,
+		Response: DeviceCodeErrorResponse{
+			Error:            DeviceCodeErrorResponseTypeExpiredToken,
+			ErrorDescription: &description,
+		},
+	}
+}
+
+// Request synchronously polls the authorization server for a response, waiting
+// using the caller-supplied sleep function.
+func (r *DeviceAccessTokenRequest[TR]) Request(client SyncHTTPClient, sleepFn func(time.Duration), timeout *time.Duration) (TR, *RequestTokenError) {
+	var zero TR
+	timeoutAt := r.computeTimeout(timeout)
+	interval := r.interval
+
+	for {
+		if r.timeFn().After(timeoutAt) {
+			return zero, r.expiredTokenError()
+		}
+
+		response, callErr := client.Call(r.prepareRequest())
+		result := r.processResponse(response, callErr, interval)
+		if !result.cont {
+			return result.value, result.err
+		}
+		interval = result.interval
+		sleepFn(interval)
+	}
+}
+
+// RequestAsync asynchronously polls the authorization server for a response,
+// waiting using the caller-supplied sleep function.
+func (r *DeviceAccessTokenRequest[TR]) RequestAsync(ctx context.Context, client AsyncHTTPClient, sleepFn func(context.Context, time.Duration) error, timeout *time.Duration) (TR, *RequestTokenError) {
+	var zero TR
+	timeoutAt := r.computeTimeout(timeout)
+	interval := r.interval
+
+	for {
+		if r.timeFn().After(timeoutAt) {
+			return zero, r.expiredTokenError()
+		}
+
+		response, callErr := client.Call(ctx, r.prepareRequest())
+		result := r.processResponse(response, callErr, interval)
+		if !result.cont {
+			return result.value, result.err
+		}
+		interval = result.interval
+		if sleepFn != nil {
+			if err := sleepFn(ctx, interval); err != nil {
+				return zero, newRequestError(err)
+			}
+		}
+	}
+}
diff --git a/oauth2/devicecode_test.go b/oauth2/devicecode_test.go
