diff --git a/oauth2/tests_support_test.go b/oauth2/tests_support_test.go
new file mode 100644
index 0000000..e2ebc0f
--- /dev/null
+++ b/oauth2/tests_support_test.go
@@ -0,0 +1,171 @@
+package oauth2
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+)
+
+// mockHTTPClient asserts the exact request produced by the implementation and
+// returns a scripted response. It mirrors the reference injected fake client.
+type mockHTTPClient struct {
+	t           *testing.T
+	wantMethod  string
+	wantURL     string
+	wantHeaders map[string]string
+	wantBody    string
+	response    HTTPResponse
+	responseErr error
+}
+
+func (m *mockHTTPClient) Call(request HTTPRequest) (HTTPResponse, error) {
+	if request.Method != m.wantMethod {
+		m.t.Errorf("method: got %q, want %q", request.Method, m.wantMethod)
+	}
+	if request.URL != m.wantURL {
+		m.t.Errorf("url: got %q, want %q", request.URL, m.wantURL)
+	}
+	if !reflect.DeepEqual(request.Header, m.wantHeaders) {
+		m.t.Errorf("headers: got %#v, want %#v", request.Header, m.wantHeaders)
+	}
+	if string(request.Body) != m.wantBody {
+		m.t.Errorf("body: got %q, want %q", string(request.Body), m.wantBody)
+	}
+	if m.responseErr != nil {
+		return HTTPResponse{}, m.responseErr
+	}
+	return m.response, nil
+}
+
+func newHTTPResponse(status int, header map[string]string, body string) HTTPResponse {
+	if header == nil {
+		header = map[string]string{}
+	}
+	return HTTPResponse{StatusCode: status, Header: header, Body: []byte(body)}
+}
+
+func jsonHeader() map[string]string {
+	return map[string]string{"Content-Type": "application/json"}
+}
+
+func basicAuthHeaders() map[string]string {
+	return map[string]string{
+		"Accept":        "application/json",
+		"Content-Type":  "application/x-www-form-urlencoded",
+		"Authorization": "Basic YWFhOmJiYg==",
+	}
+}
+
+func bodyAuthHeaders() map[string]string {
+	return map[string]string{
+		"Accept":       "application/json",
+		"Content-Type": "application/x-www-form-urlencoded",
+	}
+}
+
+func newTestClient(t *testing.T) *BasicClient {
+	t.Helper()
+	authURL, err := NewAuthUrl("https://example.com/auth")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tokenURL, err := NewTokenUrl("https://example.com/token")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return NewBasicClient(NewClientId("aaa")).
+		SetAuthURL(authURL).
+		SetTokenURL(tokenURL).
+		SetClientSecret(NewClientSecret("bbb"))
+}
+
+// mockSuccessFailClient returns a scripted sequence of responses: numFailures
+// copies of failure followed by one success.
+type mockSuccessFailClient struct {
+	t          *testing.T
+	wantURL    string
+	wantHeader map[string]string
+	wantBody   string
+	failure    HTTPResponse
+	success    HTTPResponse
+	calls      int
+	numFailure int
+}
+
+func (m *mockSuccessFailClient) Call(request HTTPRequest) (HTTPResponse, error) {
+	if request.Method != "POST" {
+		m.t.Errorf("method: got %q, want POST", request.Method)
+	}
+	if request.URL != m.wantURL {
+		m.t.Errorf("url: got %q, want %q", request.URL, m.wantURL)
+	}
+	if !reflect.DeepEqual(request.Header, m.wantHeader) {
+		m.t.Errorf("headers: got %#v, want %#v", request.Header, m.wantHeader)
+	}
+	if string(request.Body) != m.wantBody {
+		m.t.Errorf("body: got %q, want %q", string(request.Body), m.wantBody)
+	}
+	m.calls++
+	if m.calls <= m.numFailure {
+		return m.failure, nil
+	}
+	return m.success, nil
+}
+
+func mustTokenURL(t *testing.T, raw string) *TokenUrl {
+	t.Helper()
+	u, err := NewTokenUrl(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return u
+}
+
+func mustAuthURL(t *testing.T, raw string) *AuthUrl {
+	t.Helper()
+	u, err := NewAuthUrl(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return u
+}
+
+func mustRedirectURL(t *testing.T, raw string) *RedirectUrl {
+	t.Helper()
+	u, err := NewRedirectUrl(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return u
+}
+
+func mustIntrospectionURL(t *testing.T, raw string) *IntrospectionUrl {
+	t.Helper()
+	u, err := NewIntrospectionUrl(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return u
+}
+
+func mustRevocationURL(t *testing.T, raw string) *RevocationUrl {
+	t.Helper()
+	u, err := NewRevocationUrl(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return u
+}
+
+func mustDeviceAuthURL(t *testing.T, raw string) *DeviceAuthorizationUrl {
+	t.Helper()
+	u, err := NewDeviceAuthorizationUrl(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return u
+}
+
+func tokenResponseBody(accessToken, tokenType string) string {
+	return fmt.Sprintf(`{"access_token": %q, "token_type": %q}`, accessToken, tokenType)
+}
diff --git a/oauth2/token.go b/oauth2/token.go
new file mode 100644
index 0000000..b214b98
--- /dev/null
+++ b/oauth2/token.go
@@ -0,0 +1,367 @@
+package oauth2
+
+import (
+	"context"
+	"encoding/json"
+)
+
+// EmptyExtraTokenFields is the default (empty) extra token fields.
+type EmptyExtraTokenFields struct{}
+
+func (EmptyExtraTokenFields) IsExtraTokenFields() {}
+
+// StandardTokenResponse is the standard OAuth2 token response as defined in
+// Section 5.1 of RFC 6749, extended by the EF type parameter.
+type StandardTokenResponse[EF ExtraTokenFields, TT TokenType] struct {
+	accessToken  AccessToken
+	tokenType    TT
+	expiresIn    *uint64
+	refreshToken *RefreshToken
+	scopes       []Scope
+	extraFields  EF
+}
+
+// NewStandardTokenResponse instantiates a new OAuth2 token response.
+func NewStandardTokenResponse[EF ExtraTokenFields, TT TokenType](accessToken AccessToken, tokenType TT, extraFields EF) *StandardTokenResponse[EF, TT] {
+	return &StandardTokenResponse[EF, TT]{
+		accessToken: accessToken,
+		tokenType:   tokenType,
+		extraFields: extraFields,
+	}
+}
+
+// AccessToken returns the access token issued by the authorization server.
+func (r StandardTokenResponse[EF, TT]) AccessToken() AccessToken { return r.accessToken }
+
+// TokenTypeValue returns the type of the token issued.
+func (r StandardTokenResponse[EF, TT]) TokenTypeValue() TokenType { return r.tokenType }
+
+// ExpiresIn returns the lifetime in seconds of the access token, if provided.
+func (r StandardTokenResponse[EF, TT]) ExpiresIn() (uint64, bool) {
+	if r.expiresIn == nil {
+		return 0, false
+	}
+	return *r.expiresIn, true
+}
+
+// RefreshToken returns the refresh token, if any.
+func (r StandardTokenResponse[EF, TT]) RefreshToken() *RefreshToken { return r.refreshToken }
+
+// Scopes returns the scope of the access token, if included.
+func (r StandardTokenResponse[EF, TT]) Scopes() []Scope { return r.scopes }
+
+// ExtraFields returns the user-defined extra fields.
+func (r StandardTokenResponse[EF, TT]) ExtraFields() EF { return r.extraFields }
+
+// SetAccessToken sets the access_token field.
+func (r *StandardTokenResponse[EF, TT]) SetAccessToken(t AccessToken) { r.accessToken = t }
+
+// SetTokenType sets the token_type field.
+func (r *StandardTokenResponse[EF, TT]) SetTokenType(t TT) { r.tokenType = t }
+
+// SetExpiresIn sets the expires_in field.
+func (r *StandardTokenResponse[EF, TT]) SetExpiresIn(seconds uint64) { r.expiresIn = &seconds }
+
+// SetRefreshToken sets the refresh_token field.
+func (r *StandardTokenResponse[EF, TT]) SetRefreshToken(t *RefreshToken) { r.refreshToken = t }
+
+// SetScopes sets the scope field.
+func (r *StandardTokenResponse[EF, TT]) SetScopes(scopes []Scope) { r.scopes = scopes }
+
+// SetExtraFields sets the user-defined extra fields.
