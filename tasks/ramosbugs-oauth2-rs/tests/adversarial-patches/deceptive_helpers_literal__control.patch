+	}
+	if response.VerificationURI().String() != "https://verify/here" {
+		t.Fatalf("verification uri: got %q", response.VerificationURI().String())
+	}
+}
diff --git a/oauth2/endpoint.go b/oauth2/endpoint.go
new file mode 100644
index 0000000..71ba417
--- /dev/null
+++ b/oauth2/endpoint.go
@@ -0,0 +1,171 @@
+package oauth2
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strings"
+)
+
+const (
+	contentTypeJSON        = "application/json"
+	contentTypeFormEncoded = "application/x-www-form-urlencoded"
+)
+
+// HTTPRequest is an HTTP request: a method, URL, headers and body bytes.
+type HTTPRequest struct {
+	Method string
+	URL    string
+	Header map[string]string
+	Body   []byte
+}
+
+// HTTPResponse is an HTTP response: a status code, headers and body bytes.
+type HTTPResponse struct {
+	StatusCode int
+	Header     map[string]string
+	Body       []byte
+}
+
+// SyncHTTPClient is a synchronous (blocking) HTTP client.
+type SyncHTTPClient interface {
+	Call(request HTTPRequest) (HTTPResponse, error)
+}
+
+// AsyncHTTPClient is an asynchronous HTTP client.
+type AsyncHTTPClient interface {
+	Call(ctx context.Context, request HTTPRequest) (HTTPResponse, error)
+}
+
+// SyncHTTPClientFunc adapts a function to the SyncHTTPClient interface.
+type SyncHTTPClientFunc func(HTTPRequest) (HTTPResponse, error)
+
+// Call implements SyncHTTPClient.
+func (f SyncHTTPClientFunc) Call(request HTTPRequest) (HTTPResponse, error) { return f(request) }
+
+// AsyncHTTPClientFunc adapts a function to the AsyncHTTPClient interface.
+type AsyncHTTPClientFunc func(context.Context, HTTPRequest) (HTTPResponse, error)
+
+// Call implements AsyncHTTPClient.
+func (f AsyncHTTPClientFunc) Call(ctx context.Context, request HTTPRequest) (HTTPResponse, error) {
+	return f(ctx, request)
+}
+
+type param struct {
+	key   string
+	value string
+}
+
+func encodeFormParams(params []param) string {
+	var b strings.Builder
+	for i, p := range params {
+		if i > 0 {
+			b.WriteByte('&')
+		}
+		b.WriteString(url.QueryEscape(p.key))
+		b.WriteByte('=')
+		b.WriteString(url.QueryEscape(p.value))
+	}
+	return b.String()
+}
+
+func endpointRequest(
+	authType AuthType,
+	clientID ClientId,
+	clientSecret *ClientSecret,
+	extra []param,
+	redirectURL *RedirectUrl,
+	scopes []Scope,
+	endpoint *url.URL,
+	params []param,
+) HTTPRequest {
+	header := map[string]string{
+		"Accept":       contentTypeJSON,
+		"Content-Type": contentTypeFormEncoded,
+	}
+
+	all := make([]param, 0, len(params)+2+len(extra))
+	all = append(all, params...)
+
+	if len(scopes) > 0 {
+		all = append(all, param{"scope", serializeSpaceDelimitedVec(scopes)})
+	}
+
+	if authType == BasicAuth && clientSecret != nil {
+		// Section 2.3.1 of RFC 6749 requires separately url-encoding the id and
+		// secret before using them as HTTP Basic auth username and password.
+		urlencodedID := url.QueryEscape(clientID.String())
+		urlencodedSecret := url.QueryEscape(clientSecret.Secret())
+		credential := base64.StdEncoding.EncodeToString([]byte(urlencodedID + ":" + urlencodedSecret))
+		header["Authorization"] = "Basic " + credential
+	} else {
+		all = append(all, param{"client_id", clientID.String()})
+		if clientSecret != nil {
+			all = append(all, param{"client_secret", clientSecret.Secret()})
+		}
+	}
+
+	if redirectURL != nil {
+		all = append(all, param{"redirect_uri", redirectURL.String()})
+	}
+
+	all = append(all, extra...)
+
+	return HTTPRequest{
+		Method: "POST",
+		URL:    endpoint.String(),
+		Header: header,
+		Body:   []byte(encodeFormParams(all)),
+	}
+}
+
+func checkResponseStatus[T ErrorResponse](response HTTPResponse) *RequestTokenError {
+	if response.StatusCode != 200 {
+		reason := response.Body
+		if len(reason) == 0 {
+			return newOtherError("server returned empty error response")
+		}
+		var errorResponse T
+		if err := json.Unmarshal(reason, &errorResponse); err != nil {
+			return newParseError(err, reason)
+		}
+		return &RequestTokenError{Kind: RequestTokenErrorServerResponse, Response: errorResponse}
+	}
+	return nil
+}
+
+func checkResponseBody(response HTTPResponse) *RequestTokenError {
+	if contentType, ok := response.Header["Content-Type"]; ok {
+		if !strings.HasPrefix(strings.ToLower(contentType), contentTypeJSON) {
+			return newOtherError(fmt.Sprintf(
+				"unexpected response Content-Type: %q, should be `%s`",
+				contentType, contentTypeJSON,
+			))
+		}
+	}
+	if len(response.Body) == 0 {
+		return newOtherError("server returned empty response body")
+	}
+	return nil
+}
+
+func endpointResponse[TE ErrorResponse, DO any](response HTTPResponse) (DO, *RequestTokenError) {
+	var zero DO
+	if err := checkResponseStatus[TE](response); err != nil {
+		return zero, err
+	}
+	if err := checkResponseBody(response); err != nil {
+		return zero, err
+	}
+	var out DO
+	if err := json.Unmarshal(response.Body, &out); err != nil {
+		return out, newParseError(err, response.Body)
+	}
+	return out, nil
+}
+
+func endpointResponseStatusOnly[TE ErrorResponse](response HTTPResponse) *RequestTokenError {
+	return checkResponseStatus[TE](response)
+}
