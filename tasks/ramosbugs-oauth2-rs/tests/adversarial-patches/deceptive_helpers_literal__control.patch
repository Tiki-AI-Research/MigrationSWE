+	tokenResponse.SetRefreshToken(&refreshToken)
+
+	serialized, err := json.Marshal(tokenResponse)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `{"access_token":"mysecret","token_type":"red","expires_in":3600,"refresh_token":"myothersecret","shape":"circle","height":10}`
+	if string(serialized) != want {
+		t.Fatalf("serialized: got %s, want %s", serialized, want)
+	}
+}
+
+func TestExtensionRevocationSuccessful(t *testing.T) {
+	client := newColorfulClient(t).
+		SetRevocationURL(mustRevocationURL(t, "https://revocation/url"))
+	caller := &mockHTTPClient{
