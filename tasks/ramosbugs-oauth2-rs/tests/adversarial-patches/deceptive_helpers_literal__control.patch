new file mode 100644
index 0000000..db112ce
--- /dev/null
+++ b/oauth2/traits.go
@@ -0,0 +1,75 @@
+package oauth2
+
+// ErrorResponseType is implemented by values that can be used as the `error`
+// field of a standard OAuth2 error response. Implementations must serialize to
+// the canonical string defined by the relevant OAuth2 standard.
+type ErrorResponseType interface {
+	ErrorTypeString() string
+}
+
+// ErrorResponse is a server error response. It exists separately from
+// StandardErrorResponse to support customization by clients, such as
+// interoperability with non-standard-compliant OAuth2 providers.
+type ErrorResponse interface {
+	// ErrorString returns a human-readable representation suitable for
+	// printing, e.g. inside a RequestTokenError.
+	ErrorString() string
+}
+
+// TokenType is the type of an OAuth2 access token. Values deserialize
+// case-insensitively and serialize to their canonical strings.
+type TokenType interface {
+	// TokenTypeString returns the canonical string for this token type.
+	TokenTypeString() string
+}
+
+// ExtraTokenFields is implemented by user-defined types that add extra fields
+// to a token response.
+type ExtraTokenFields interface {
+	IsExtraTokenFields()
+}
+
+// TokenResponse is the common interface shared by all token responses.
+type TokenResponse interface {
+	// AccessToken returns the access token issued by the authorization server.
+	AccessToken() AccessToken
+	// TokenType returns the type of the token issued.
+	TokenTypeValue() TokenType
+	// ExpiresIn returns the lifetime in seconds of the access token, if known.
+	ExpiresIn() (uint64, bool)
+	// RefreshToken returns the refresh token, if any.
+	RefreshToken() *RefreshToken
+	// Scopes returns the scope of the access token, if included.
+	Scopes() []Scope
+}
+
+// TokenIntrospectionResponse is the common interface shared by all token
+// introspection responses.
+type TokenIntrospectionResponse interface {
+	Active() bool
+	Scopes() []Scope
+	ClientId() *ClientId
+	Username() *string
+	TokenType() (TokenType, bool)
+	Exp() *int64
+	Iat() *int64
+	Nbf() *int64
+	Sub() *string
+	Aud() []string
+	Iss() *string
+	Jti() *string
+}
+
+// RevocableToken is a token that can be revoked per RFC 7009.
+type RevocableToken interface {
+	// Secret returns the actual token value to be revoked.
+	Secret() string
+	// TypeHint indicates the type of the token being revoked.
+	TypeHint() string
+}
+
+// ExtraDeviceAuthorizationFields is implemented by user-defined types that add
+// extra fields to a device authorization response.
+type ExtraDeviceAuthorizationFields interface {
+	IsExtraDeviceAuthorizationFields()
+}
diff --git a/oauth2/types.go b/oauth2/types.go
new file mode 100644
index 0000000..20a611b
--- /dev/null
+++ b/oauth2/types.go
@@ -0,0 +1,347 @@
+package oauth2
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/url"
+)
+
+// secret is the shared implementation for secret-bearing newtypes. It redacts
+// its content in every formatted representation while exposing the underlying
+// value only through Secret().
+type secret struct {
+	value string
+	name  string
+}
+
+// Secret returns the underlying secret value.
+//
+// Security Warning: leaking this value may compromise the security of the
+// OAuth2 flow.
+func (s secret) Secret() string { return s.value }
+
+func (s secret) String() string { return s.name + "([redacted])" }
+
+func (s secret) Format(f fmt.State, _ rune) {
+	io.WriteString(f, s.name+"([redacted])")
+}
+
+func (s secret) GoString() string { return s.name + "([redacted])" }
+
+func (s secret) MarshalJSON() ([]byte, error) { return json.Marshal(s.value) }
+
+func (s *secret) UnmarshalJSON(b []byte) error {
+	var v string
+	if err := json.Unmarshal(b, &v); err != nil {
+		return err
+	}
+	s.value = v
+	return nil
+}
+
+func newSecret(value, name string) secret { return secret{value: value, name: name} }
+
+// ClientSecret is the client password issued to the client during registration.
+type ClientSecret struct{ secret }
+
+func NewClientSecret(v string) ClientSecret { return ClientSecret{newSecret(v, "ClientSecret")} }
+
+// AccessToken is a token returned by the token endpoint.
+type AccessToken struct{ secret }
+
+func NewAccessToken(v string) AccessToken { return AccessToken{newSecret(v, "AccessToken")} }
+
+// RefreshToken is used to obtain a new access token.
+type RefreshToken struct{ secret }
+
+func NewRefreshToken(v string) RefreshToken { return RefreshToken{newSecret(v, "RefreshToken")} }
+
+// AuthorizationCode is returned from the authorization endpoint.
+type AuthorizationCode struct{ secret }
+
+func NewAuthorizationCode(v string) AuthorizationCode {
+	return AuthorizationCode{newSecret(v, "AuthorizationCode")}
+}
+
+// PkceCodeVerifier is the PKCE code verifier.
+type PkceCodeVerifier struct{ secret }
+
+func NewPkceCodeVerifier(v string) PkceCodeVerifier {
+	return PkceCodeVerifier{newSecret(v, "PkceCodeVerifier")}
+}
+
+// CsrfToken is the value used for CSRF protection via the state parameter.
+type CsrfToken struct{ secret }
+
+func NewCsrfToken(v string) CsrfToken { return CsrfToken{newSecret(v, "CsrfToken")} }
+
+// NewCsrfTokenRandom generates a new random, base64-encoded 128-bit CSRF token.
+func NewCsrfTokenRandom() CsrfToken { return NewCsrfTokenRandomLen(16) }
+
+// NewCsrfTokenRandomLen generates a random CSRF token of the specified byte length.
+func NewCsrfTokenRandomLen(numBytes int) CsrfToken {
+	buf := make([]byte, numBytes)
+	if _, err := rand.Read(buf); err != nil {
+		panic(err)
+	}
+	return CsrfToken{newSecret(base64.RawURLEncoding.EncodeToString(buf), "CsrfToken")}
+}
+
+// ResourceOwnerPassword is the resource owner's password.
+type ResourceOwnerPassword struct{ secret }
+
+func NewResourceOwnerPassword(v string) ResourceOwnerPassword {
+	return ResourceOwnerPassword{newSecret(v, "ResourceOwnerPassword")}
+}
+
+// DeviceCode is returned by the device authorization endpoint.
+type DeviceCode struct{ secret }
+
+func NewDeviceCode(v string) DeviceCode { return DeviceCode{newSecret(v, "DeviceCode")} }
+
+// UserCode is returned by the device authorization endpoint for the user.
+type UserCode struct{ secret }
+
+func NewUserCode(v string) UserCode { return UserCode{newSecret(v, "UserCode")} }
+
+// VerificationUriComplete is the verification URI including the user code.
+type VerificationUriComplete struct{ secret }
+
+func NewVerificationUriComplete(v string) VerificationUriComplete {
+	return VerificationUriComplete{newSecret(v, "VerificationUriComplete")}
+}
+
+// SecretsEqual compares two secret strings in constant time.
+func SecretsEqual(a, b string) bool {
+	ha := sha256.Sum256([]byte(a))
+	hb := sha256.Sum256([]byte(b))
+	return subtle.ConstantTimeCompare(ha[:], hb[:]) == 1
+}
+
+// stringer is the shared implementation for non-secret string newtypes.
+type stringer struct{ value string }
+
+func (s stringer) String() string { return s.value }
+
+func (s stringer) MarshalJSON() ([]byte, error) { return json.Marshal(s.value) }
+
+func (s *stringer) UnmarshalJSON(b []byte) error {
+	var v string
+	if err := json.Unmarshal(b, &v); err != nil {
+		return err
+	}
+	s.value = v
+	return nil
+}
+
+func newStringer(v string) stringer { return stringer{value: v} }
+
+// ClientId is the client identifier issued during registration.
+type ClientId struct{ stringer }
+
+func NewClientId(v string) ClientId { return ClientId{newStringer(v)} }
+
+// ResponseType is the authorization endpoint response (grant) type.
+type ResponseType struct{ stringer }
+
+func NewResponseType(v string) ResponseType { return ResponseType{newStringer(v)} }
+
+// ResourceOwnerUsername is the resource owner's username.
+type ResourceOwnerUsername struct{ stringer }
+
+func NewResourceOwnerUsername(v string) ResourceOwnerUsername {
+	return ResourceOwnerUsername{newStringer(v)}
+}
+
+// Scope is an access token scope.
+type Scope struct{ stringer }
+
+func NewScope(v string) Scope { return Scope{newStringer(v)} }
+
+// AsStr returns the scope as a string.
+func (s Scope) AsStr() string { return s.value }
+
+// PkceCodeChallengeMethod is the method used for PKCE protection.
+type PkceCodeChallengeMethod struct{ stringer }
+
+func NewPkceCodeChallengeMethod(v string) PkceCodeChallengeMethod {
+	return PkceCodeChallengeMethod{newStringer(v)}
+}
+
+// PkceCodeChallenge is the code challenge used for PKCE protection.
+type PkceCodeChallenge struct {
+	codeChallenge       string
+	codeChallengeMethod PkceCodeChallengeMethod
+}
+
+// AsStr returns the PKCE code challenge as a string.
+func (c PkceCodeChallenge) AsStr() string { return c.codeChallenge }
+
+// ChallengeMethod returns the PKCE code challenge method.
+func (c PkceCodeChallenge) ChallengeMethod() PkceCodeChallengeMethod {
+	return c.codeChallengeMethod
+}
+
+func pckeRandomLen(numBytes int) PkceCodeVerifier {
+	// RFC 7636: the code verifier must have a minimum length of 43 characters
+	// and a maximum length of 128 characters, i.e. 32-96 octets of random data.
+	if numBytes < 32 || numBytes > 96 {
+		panic("pkce code verifier length out of range (32..=96 bytes)")
+	}
+	buf := make([]byte, numBytes)
+	if _, err := rand.Read(buf); err != nil {
+		panic(err)
+	}
+	return NewPkceCodeVerifier(base64.RawURLEncoding.EncodeToString(buf))
+}
+
+// NewPkceCodeChallengeRandomSha256 generates a random SHA-256 PKCE code
+// challenge and verifier.
+func NewPkceCodeChallengeRandomSha256() (PkceCodeChallenge, PkceCodeVerifier) {
+	return NewPkceCodeChallengeRandomSha256Len(32)
+}
+
+// NewPkceCodeChallengeRandomSha256Len generates a random SHA-256 PKCE code
+// challenge and verifier using numBytes of random data.
+func NewPkceCodeChallengeRandomSha256Len(numBytes int) (PkceCodeChallenge, PkceCodeVerifier) {
+	verifier := pckeRandomLen(numBytes)
+	return NewPkceCodeChallengeFromVerifierSha256(verifier), verifier
+}
+
+// NewPkceCodeChallengeFromVerifierSha256 derives a SHA-256 PKCE code challenge
+// from the supplied verifier.
+func NewPkceCodeChallengeFromVerifierSha256(verifier PkceCodeVerifier) PkceCodeChallenge {
+	l := len(verifier.Secret())
+	if l < 43 || l > 128 {
+		panic("pkce code verifier length out of range (43..=128 characters)")
+	}
+	digest := sha256.Sum256([]byte(verifier.Secret()))
+	return PkceCodeChallenge{
+		codeChallenge:       base64.RawURLEncoding.EncodeToString(digest[:]),
+		codeChallengeMethod: NewPkceCodeChallengeMethod("S256"),
+	}
+}
+
+// NewPkceCodeChallengeRandomPlain generates a random plain PKCE code challenge
+// and verifier. Use is discouraged unless the endpoint does not support SHA-256.
+func NewPkceCodeChallengeRandomPlain() (PkceCodeChallenge, PkceCodeVerifier) {
+	verifier := pckeRandomLen(32)
+	return NewPkceCodeChallengeFromVerifierPlain(verifier), verifier
+}
+
+// NewPkceCodeChallengeFromVerifierPlain derives a plain PKCE code challenge
+// from the supplied verifier. Use is discouraged unless the endpoint does not
+// support SHA-256.
+func NewPkceCodeChallengeFromVerifierPlain(verifier PkceCodeVerifier) PkceCodeChallenge {
+	l := len(verifier.Secret())
+	if l < 43 || l > 128 {
+		panic("pkce code verifier length out of range (43..=128 characters)")
+	}
+	return PkceCodeChallenge{
+		codeChallenge:       verifier.Secret(),
+		codeChallengeMethod: NewPkceCodeChallengeMethod("plain"),
+	}
+}
+
+// urlType is the shared implementation for URL-backed newtypes. Types created
+// from it enforce during construction that the contained value is a
+// syntactically valid URL.
+type urlType struct {
+	parsed *url.URL
+	raw    string
+}
+
+func newURLType(raw string) (urlType, error) {
+	parsed, err := url.Parse(raw)
+	if err != nil {
+		return urlType{}, err
+	}
+	return urlType{parsed: parsed, raw: raw}, nil
+}
+
+// URL returns the type as a parsed *url.URL.
+func (u urlType) URL() *url.URL { return u.parsed }
+
+func (u urlType) String() string { return u.raw }
+
+// AuthUrl is the authorization endpoint URL.
+type AuthUrl struct{ urlType }
+
+func NewAuthUrl(raw string) (*AuthUrl, error) {
+	u, err := newURLType(raw)
+	if err != nil {
+		return nil, err
+	}
+	return &AuthUrl{u}, nil
+}
+
+// TokenUrl is the token endpoint URL.
+type TokenUrl struct{ urlType }
+
+func NewTokenUrl(raw string) (*TokenUrl, error) {
+	u, err := newURLType(raw)
+	if err != nil {
+		return nil, err
+	}
+	return &TokenUrl{u}, nil
+}
+
+// RedirectUrl is the client's redirection endpoint URL.
+type RedirectUrl struct{ urlType }
+
+func NewRedirectUrl(raw string) (*RedirectUrl, error) {
+	u, err := newURLType(raw)
+	if err != nil {
+		return nil, err
+	}
+	return &RedirectUrl{u}, nil
+}
+
+// IntrospectionUrl is the RFC 7662 token introspection endpoint URL.
+type IntrospectionUrl struct{ urlType }
+
+func NewIntrospectionUrl(raw string) (*IntrospectionUrl, error) {
+	u, err := newURLType(raw)
+	if err != nil {
+		return nil, err
+	}
+	return &IntrospectionUrl{u}, nil
+}
+
+// RevocationUrl is the RFC 7009 token revocation endpoint URL.
+type RevocationUrl struct{ urlType }
+
+func NewRevocationUrl(raw string) (*RevocationUrl, error) {
+	u, err := newURLType(raw)
+	if err != nil {
+		return nil, err
+	}
+	return &RevocationUrl{u}, nil
+}
+
+// DeviceAuthorizationUrl is the device authorization endpoint URL.
+type DeviceAuthorizationUrl struct{ urlType }
+
+func NewDeviceAuthorizationUrl(raw string) (*DeviceAuthorizationUrl, error) {
+	u, err := newURLType(raw)
+	if err != nil {
+		return nil, err
+	}
+	return &DeviceAuthorizationUrl{u}, nil
+}
+
+// EndUserVerificationUrl is the end-user verification URI.
+type EndUserVerificationUrl struct{ urlType }
+
+func NewEndUserVerificationUrl(raw string) (EndUserVerificationUrl, error) {
+	u, err := newURLType(raw)
+	if err != nil {
+		return EndUserVerificationUrl{}, err
+	}
+	return EndUserVerificationUrl{u}, nil
+}
diff --git a/oauth2/types_test.go b/oauth2/types_test.go
new file mode 100644
index 0000000..d945dfb
--- /dev/null
+++ b/oauth2/types_test.go
@@ -0,0 +1,101 @@
+package oauth2
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestSecretConversion(t *testing.T) {
+	secret := NewCsrfToken("top_secret")
+	if secret.Secret() != "top_secret" {
+		t.Fatalf("Secret(): got %q", secret.Secret())
+	}
+}
+
+func TestSecretRedaction(t *testing.T) {
+	secret := NewClientSecret("top_secret")
+	if got := fmt.Sprintf("%v", secret); got != "ClientSecret([redacted])" {
+		t.Fatalf("got %q", got)
+	}
+	if got := fmt.Sprintf("%s", secret); got != "ClientSecret([redacted])" {
+		t.Fatalf("got %q", got)
+	}
+	if got := fmt.Sprintf("%#v", secret); got != "ClientSecret([redacted])" {
+		t.Fatalf("got %q", got)
+	}
+	if fmt.Sprintf("%v", secret) == "top_secret" {
+		t.Fatal("secret value leaked in formatted output")
+	}
+}
+
+func TestPkceCodeVerifierTooShort(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Fatal("expected panic for short verifier")
+		}
+	}()
+	NewPkceCodeChallengeRandomSha256Len(31)
+}
+
+func TestPkceCodeVerifierTooLong(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Fatal("expected panic for long verifier")
+		}
+	}()
+	NewPkceCodeChallengeRandomSha256Len(97)
+}
+
+func TestPkceCodeVerifierMin(t *testing.T) {
+	_, verifier := NewPkceCodeChallengeRandomSha256Len(32)
+	if len(verifier.Secret()) != 43 {
+		t.Fatalf("got len %d, want 43", len(verifier.Secret()))
+	}
+}
+
+func TestPkceCodeVerifierMax(t *testing.T) {
+	_, verifier := NewPkceCodeChallengeRandomSha256Len(96)
+	if len(verifier.Secret()) != 128 {
+		t.Fatalf("got len %d, want 128", len(verifier.Secret()))
+	}
+}
+
+func TestPkceCodeVerifierChallenge(t *testing.T) {
+	// Example from https://tools.ietf.org/html/rfc7636#appendix-B
+	verifier := NewPkceCodeVerifier("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")
+	challenge := NewPkceCodeChallengeFromVerifierSha256(verifier)
+	if challenge.AsStr() != "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM" {
+		t.Fatalf("got %q", challenge.AsStr())
+	}
+	if challenge.ChallengeMethod().String() != "S256" {
+		t.Fatalf("got %q", challenge.ChallengeMethod().String())
+	}
+}
+
+func TestPkcePlainChallenge(t *testing.T) {
+	verifier := NewPkceCodeVerifier("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")
+	challenge := NewPkceCodeChallengeFromVerifierPlain(verifier)
+	if challenge.AsStr() != verifier.Secret() {
+		t.Fatalf("plain challenge: got %q, want %q", challenge.AsStr(), verifier.Secret())
+	}
+	if challenge.ChallengeMethod().String() != "plain" {
+		t.Fatalf("got %q", challenge.ChallengeMethod().String())
+	}
+
+	randomChallenge, randomVerifier := NewPkceCodeChallengeRandomPlain()
+	if randomChallenge.AsStr() != randomVerifier.Secret() {
+		t.Fatal("random plain challenge does not match verifier")
+	}
+	if randomChallenge.ChallengeMethod().String() != "plain" {
+		t.Fatalf("got %q", randomChallenge.ChallengeMethod().String())
+	}
+}
