@@ -0,0 +1,55 @@
+package oauth2
+
+import (
+	"context"
+	"testing"
+)
+
+func TestAsyncClientClosure(t *testing.T) {
+	client := newTestClient(t)
+	response := newHTTPResponse(200, nil, `{"access_token": "12/34", "token_type": "BEARER"}`)
+
+	asyncClient := AsyncHTTPClientFunc(func(ctx context.Context, request HTTPRequest) (HTTPResponse, error) {
+		return response, nil
+	})
+
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	token, tokenErr := request.RequestAsync(context.Background(), asyncClient)
+	if tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+	if token.AccessToken().Secret() != "12/34" {
+		t.Fatalf("access token: got %q", token.AccessToken().Secret())
+	}
+	if token.TokenTypeValue() != BasicTokenTypeBearer {
+		t.Fatalf("token type: got %v", token.TokenTypeValue())
+	}
+}
+
+func TestHelperSpaceDelimitedVec(t *testing.T) {
+	scopes := deserializeSpaceDelimitedVec("read write")
+	if len(scopes) != 2 || scopes[0].AsStr() != "read" || scopes[1].AsStr() != "write" {
+		t.Fatalf("got %#v", scopes)
+	}
+	if got := serializeSpaceDelimitedVec(scopes); got != "read write" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestHelperOptionalStringOrVecString(t *testing.T) {
+	list, ok, err := deserializeOptionalStringOrVecString([]byte(`"v1"`))
+	if err != nil || !ok || len(list) != 1 || list[0] != "v1" {
+		t.Fatalf("single: %#v %v %v", list, ok, err)
+	}
+	list, ok, err = deserializeOptionalStringOrVecString([]byte(`["v1","v2"]`))
+	if err != nil || !ok || len(list) != 2 {
+		t.Fatalf("list: %#v %v %v", list, ok, err)
+	}
+	list, ok, err = deserializeOptionalStringOrVecString([]byte(`null`))
+	if err != nil || ok || list != nil {
+		t.Fatalf("null: %#v %v %v", list, ok, err)
+	}
+}
diff --git a/oauth2/error.go b/oauth2/error.go
new file mode 100644
index 0000000..ce4809c
--- /dev/null
+++ b/oauth2/error.go
@@ -0,0 +1,243 @@
+package oauth2
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+)
+
+// ConfigurationErrorKind discriminates configuration errors.
+type ConfigurationErrorKind int
+
+const (
+	// ConfigurationMissingURL indicates that a required endpoint URL is not set.
+	ConfigurationMissingURL ConfigurationErrorKind = iota
+	// ConfigurationInsecureURL indicates that an endpoint URL must be HTTPS.
+	ConfigurationInsecureURL
+)
+
+// ConfigurationError is returned when the client is incorrectly configured.
+type ConfigurationError struct {
+	Kind     ConfigurationErrorKind
+	Endpoint string
+}
+
+func (e *ConfigurationError) Error() string {
+	if e.Kind == ConfigurationInsecureURL {
+		return fmt.Sprintf("Scheme for %s endpoint URL must be HTTPS", e.Endpoint)
+	}
+	return fmt.Sprintf("No %s endpoint URL specified", e.Endpoint)
+}
+
+// AuthType indicates whether requests should use basic authentication or
+// include the client parameters in the request body.
+type AuthType int
+
+const (
+	// BasicAuth includes the client_id and client_secret using the HTTP basic
+	// authentication scheme. This is the default.
+	BasicAuth AuthType = iota
+	// RequestBody includes the client_id and client_secret in the request body.
+	RequestBody
+)
+
+// String returns a readable name for the authentication type.
+func (a AuthType) String() string {
+	if a == RequestBody {
+		return "RequestBody"
+	}
+	return "BasicAuth"
+}
+
+// StandardErrorResponse is the standard OAuth2 server error response as
+// defined in Section 5.2 of RFC 6749.
+type StandardErrorResponse[T ErrorResponseType] struct {
+	Error            T       `json:"error"`
+	ErrorDescription *string `json:"error_description,omitempty"`
+	ErrorURI         *string `json:"error_uri,omitempty"`
+}
+
+// NewStandardErrorResponse instantiates a new standard error response.
+func NewStandardErrorResponse[T ErrorResponseType](err T, description, uri *string) StandardErrorResponse[T] {
+	return StandardErrorResponse[T]{Error: err, ErrorDescription: description, ErrorURI: uri}
+}
+
+// ErrorType returns the required error code.
+func (r StandardErrorResponse[T]) ErrorType() T { return r.Error }
+
+// ErrorString implements ErrorResponse.
+func (r StandardErrorResponse[T]) ErrorString() string {
+	formatted := r.Error.ErrorTypeString()
+	if r.ErrorDescription != nil {
+		formatted += ": " + *r.ErrorDescription
+	}
+	if r.ErrorURI != nil {
+		formatted += " (see " + *r.ErrorURI + ")"
+	}
+	return formatted
+}
+
+// RequestTokenErrorKind discriminates the failure modes of a token request.
+type RequestTokenErrorKind int
+
+const (
+	// RequestTokenErrorServerResponse indicates a parsed server error response.
+	RequestTokenErrorServerResponse RequestTokenErrorKind = iota
+	// RequestTokenErrorRequest indicates a transport or request failure.
+	RequestTokenErrorRequest
+	// RequestTokenErrorParse indicates a response parse failure.
+	RequestTokenErrorParse
+	// RequestTokenErrorOther indicates some other error.
+	RequestTokenErrorOther
+)
+
+// RequestTokenError is returned when a token request fails.
+type RequestTokenError struct {
+	Kind RequestTokenErrorKind
+
+	// Response holds the parsed server error response for
+	// RequestTokenErrorServerResponse. It implements ErrorResponse.
+	Response any
+
+	// RequestErr holds the underlying transport error for
+	// RequestTokenErrorRequest.
+	RequestErr error
+
+	// ParseErr holds the underlying parse error for RequestTokenErrorParse.
+	ParseErr error
+
+	// RawBody holds the raw response body for a parse failure.
+	RawBody []byte
+
+	// OtherMsg holds the message for RequestTokenErrorOther.
+	OtherMsg string
+}
+
+func (e *RequestTokenError) Error() string {
+	switch e.Kind {
+	case RequestTokenErrorServerResponse:
+		if r, ok := e.Response.(ErrorResponse); ok {
+			return "Server returned error response: " + r.ErrorString()
+		}
+		return "Server returned error response"
+	case RequestTokenErrorRequest:
+		return "Request failed"
+	case RequestTokenErrorParse:
+		return "Failed to parse server response"
+	default:
+		return "Other error: " + e.OtherMsg
+	}
+}
+
+// Unwrap allows errors.Is/errors.As to inspect the underlying cause.
+func (e *RequestTokenError) Unwrap() error {
+	switch e.Kind {
+	case RequestTokenErrorRequest:
+		return e.RequestErr
+	case RequestTokenErrorParse:
+		return e.ParseErr
+	}
+	return nil
+}
+
+func newServerResponseError[T ErrorResponse](response T) *RequestTokenError {
+	return &RequestTokenError{Kind: RequestTokenErrorServerResponse, Response: response}
+}
+
+func newRequestError(err error) *RequestTokenError {
+	if err == nil {
+		err = errors.New("request failed")
+	}
+	return &RequestTokenError{Kind: RequestTokenErrorRequest, RequestErr: err}
+}
+
+func newParseError(err error, raw []byte) *RequestTokenError {
+	return &RequestTokenError{Kind: RequestTokenErrorParse, ParseErr: err, RawBody: raw}
+}
+
+func newOtherError(msg string) *RequestTokenError {
+	return &RequestTokenError{Kind: RequestTokenErrorOther, OtherMsg: msg}
+}
+
+// ParseResponseError is exposed so callers can build a parse error carrying the
+// raw body.
+func ParseResponseError(err error, raw []byte) *RequestTokenError {
+	return newParseError(err, raw)
+}
+
+// OtherResponseError is exposed so callers can build a generic other error.
+func OtherResponseError(msg string) *RequestTokenError {
+	return newOtherError(msg)
+}
+
+// ServerResponseError is exposed so callers can build a server-response error.
+func ServerResponseError[T ErrorResponse](response T) *RequestTokenError {
+	return newServerResponseError(response)
+}
+
+// HTTPClientErrorKind discriminates built-in HTTP client failures.
+type HTTPClientErrorKind int
+
+const (
+	// HTTPClientErrorBackend indicates an error returned by the backend client.
+	HTTPClientErrorBackend HTTPClientErrorKind = iota
+	// HTTPClientErrorHTTP indicates a non-backend HTTP error.
+	HTTPClientErrorHTTP
+	// HTTPClientErrorIO indicates an I/O error.
+	HTTPClientErrorIO
+	// HTTPClientErrorOther indicates any other error.
+	HTTPClientErrorOther
+)
+
+// HTTPClientError is returned by built-in HTTP clients when requests fail.
+type HTTPClientError struct {
+	Kind HTTPClientErrorKind
+	Err  error
+	Msg  string
+}
+
+func (e *HTTPClientError) Error() string {
+	switch e.Kind {
+	case HTTPClientErrorBackend:
+		return "client error"
+	case HTTPClientErrorHTTP:
+		return "HTTP error"
+	case HTTPClientErrorIO:
+		return "I/O error"
+	default:
+		return e.Msg
+	}
+}
+
+func (e *HTTPClientError) Unwrap() error { return e.Err }
+
+// MarshalJSON preserves the canonical field ordering used by the reference
+// implementation: error, error_description, error_uri.
+func (r StandardErrorResponse[T]) MarshalJSON() ([]byte, error) {
+	var o orderedJSON
+	o.add("error", r.Error)
+	if r.ErrorDescription != nil {
+		o.add("error_description", *r.ErrorDescription)
+	}
+	if r.ErrorURI != nil {
+		o.add("error_uri", *r.ErrorURI)
+	}
+	return o.bytes(), nil
+}
+
+// UnmarshalJSON is provided to keep the generic type a valid json target.
+func (r *StandardErrorResponse[T]) UnmarshalJSON(data []byte) error {
+	type alias struct {
+		Error            T       `json:"error"`
+		ErrorDescription *string `json:"error_description"`
+		ErrorURI         *string `json:"error_uri"`
+	}
+	var a alias
+	if err := json.Unmarshal(data, &a); err != nil {
+		return err
+	}
+	r.Error = a.Error
+	r.ErrorDescription = a.ErrorDescription
+	r.ErrorURI = a.ErrorURI
+	return nil
+}
diff --git a/oauth2/error_test.go b/oauth2/error_test.go
new file mode 100644
index 0000000..e68c678
--- /dev/null
+++ b/oauth2/error_test.go
@@ -0,0 +1,75 @@
+package oauth2
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func strPtr(s string) *string { return &s }
+
+func TestErrorResponseSerializer(t *testing.T) {
+	unauthorized := NewStandardErrorResponse(BasicErrorResponseTypeUnauthorizedClient, nil, nil)
+	serialized, err := json.Marshal(unauthorized)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(serialized) != `{"error":"unauthorized_client"}` {
+		t.Fatalf("got %s", serialized)
+	}
+
+	invalid := NewStandardErrorResponse(
+		BasicErrorResponseTypeInvalidClient,
+		strPtr("Invalid client_id"),
+		strPtr("https://example.com/errors/invalid_client"),
+	)
+	serialized, err = json.Marshal(invalid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `{"error":"invalid_client","error_description":"Invalid client_id","error_uri":"https://example.com/errors/invalid_client"}`
+	if string(serialized) != want {
+		t.Fatalf("got %s, want %s", serialized, want)
+	}
+
+	// Round trip.
+	var decoded StandardErrorResponse[BasicErrorResponseType]
+	if err := json.Unmarshal(serialized, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.Error != invalid.Error ||
+		decoded.ErrorDescription == nil || *decoded.ErrorDescription != *invalid.ErrorDescription ||
+		decoded.ErrorURI == nil || *decoded.ErrorURI != *invalid.ErrorURI {
+		t.Fatalf("round trip mismatch: %#v != %#v", decoded, invalid)
+	}
+}
+
+func TestErrorResponseDisplay(t *testing.T) {
+	invalid := NewStandardErrorResponse(
+		BasicErrorResponseTypeInvalidRequest,
+		strPtr("stuff happened"),
+		nil,
+	)
+	if got := invalid.ErrorString(); got != "invalid_request: stuff happened" {
+		t.Fatalf("got %q", got)
+	}
+
+	withURI := NewStandardErrorResponse(
+		BasicErrorResponseTypeInvalidRequest,
+		strPtr("stuff happened"),
+		strPtr("https://errors"),
+	)
+	if got := withURI.ErrorString(); got != "invalid_request: stuff happened (see https://errors)" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestConfigurationErrorMessages(t *testing.T) {
+	missing := &ConfigurationError{Kind: ConfigurationMissingURL, Endpoint: "revocation"}
+	if got := missing.Error(); got != "No revocation endpoint URL specified" {
+		t.Fatalf("got %q", got)
+	}
+	insecure := &ConfigurationError{Kind: ConfigurationInsecureURL, Endpoint: "revocation"}
+	if got := insecure.Error(); got != "Scheme for revocation endpoint URL must be HTTPS" {
+		t.Fatalf("got %q", got)
+	}
+}
diff --git a/oauth2/extension_test.go b/oauth2/extension_test.go
new file mode 100644
index 0000000..12342c7
--- /dev/null
+++ b/oauth2/extension_test.go
@@ -0,0 +1,301 @@
+package oauth2
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// ColorfulTokenType is a user-defined token type.
+type ColorfulTokenType string
+
+const (
+	ColorfulTokenTypeGreen ColorfulTokenType = "green"
+	ColorfulTokenTypeRed   ColorfulTokenType = "red"
+)
+
+func (t ColorfulTokenType) TokenTypeString() string { return string(t) }
+
+// ColorfulFields is a user-defined extra token fields type.
+type ColorfulFields struct {
+	Shape  *string `json:"shape,omitempty"`
+	Height uint32  `json:"height"`
+}
+
+func (ColorfulFields) IsExtraTokenFields() {}
+
+// ColorfulErrorResponseType is a user-defined error response type.
+type ColorfulErrorResponseType string
+
+const (
+	ColorfulErrorResponseTypeTooDark         ColorfulErrorResponseType = "too_dark"
+	ColorfulErrorResponseTypeTooLight        ColorfulErrorResponseType = "too_light"
+	ColorfulErrorResponseTypeWrongColorSpace ColorfulErrorResponseType = "wrong_color_space"
+)
+
+func (t ColorfulErrorResponseType) ErrorTypeString() string { return string(t) }
+
+// ColorfulRevocableToken is a user-defined revocable token.
+type ColorfulRevocableToken struct {
+	SecretValue string
+	Hint        string
+}
+
+func (t ColorfulRevocableToken) Secret() string   { return t.SecretValue }
+func (t ColorfulRevocableToken) TypeHint() string { return t.Hint }
+
+// ColorfulClient parameterizes Client with user-defined types.
+type ColorfulClient = Client[
+	StandardErrorResponse[ColorfulErrorResponseType],
+	StandardTokenResponse[ColorfulFields, ColorfulTokenType],
+	StandardTokenIntrospectionResponse[ColorfulFields, ColorfulTokenType],
+	ColorfulRevocableToken,
+	StandardErrorResponse[ColorfulErrorResponseType],
+]
+
+func newColorfulClient(t *testing.T) *ColorfulClient {
+	t.Helper()
+	return NewClient[
+		StandardErrorResponse[ColorfulErrorResponseType],
+		StandardTokenResponse[ColorfulFields, ColorfulTokenType],
+		StandardTokenIntrospectionResponse[ColorfulFields, ColorfulTokenType],
+		ColorfulRevocableToken,
+		StandardErrorResponse[ColorfulErrorResponseType],
+	](NewClientId("aaa")).
+		SetClientSecret(NewClientSecret("bbb")).
+		SetAuthURL(mustAuthURL(t, "https://example.com/auth")).
+		SetTokenURL(mustTokenURL(t, "https://example.com/token"))
+}
+
+// CustomErrorResponse is a non-standard server error response.
+type CustomErrorResponse struct {
+	CustomError string `json:"custom_error"`
+}
+
+func (e CustomErrorResponse) ErrorString() string { return "Custom Error from server" }
+
+type CustomErrorClient = Client[
+	CustomErrorResponse,
+	StandardTokenResponse[ColorfulFields, ColorfulTokenType],
+	StandardTokenIntrospectionResponse[ColorfulFields, ColorfulTokenType],
+	ColorfulRevocableToken,
+	CustomErrorResponse,
+]
+
+func TestExtensionSuccessfulWithMinimalJSONResponse(t *testing.T) {
+	client := newColorfulClient(t)
+	response := newHTTPResponse(200, jsonHeader(), `{"access_token": "12/34", "token_type": "green", "height": 10}`)
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=authorization_code&code=ccc",
+		response:    response,
+	}
+
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	token, tokenErr := request.Request(caller)
+	if tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+
+	if token.AccessToken().Secret() != "12/34" {
+		t.Fatalf("access token: got %q", token.AccessToken().Secret())
+	}
+	if token.TokenTypeValue() != ColorfulTokenTypeGreen {
+		t.Fatalf("token type: got %v", token.TokenTypeValue())
+	}
+	if _, ok := token.ExpiresIn(); ok {
+		t.Fatal("expected no expires_in")
+	}
+	if token.RefreshToken() != nil {
+		t.Fatal("expected no refresh token")
+	}
+	if token.ExtraFields().Shape != nil {
+		t.Fatalf("expected nil shape, got %q", *token.ExtraFields().Shape)
+	}
+	if token.ExtraFields().Height != 10 {
+		t.Fatalf("height: got %d", token.ExtraFields().Height)
+	}
+
+	serialized, err := json.Marshal(token)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(serialized) != `{"access_token":"12/34","token_type":"green","height":10}` {
+		t.Fatalf("serialized: got %s", serialized)
+	}
+}
+
+func TestExtensionSuccessfulWithCompleteJSONResponse(t *testing.T) {
+	client := newColorfulClient(t).SetAuthType(RequestBody)
+	body := `{"access_token": "12/34", "token_type": "red", "scope": "read write", "expires_in": 3600, ` +
+		`"refresh_token": "foobar", "shape": "round", "height": 12}`
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: bodyAuthHeaders(),
+		wantBody:    "grant_type=authorization_code&code=ccc&client_id=aaa&client_secret=bbb",
+		response:    newHTTPResponse(200, jsonHeader(), body),
+	}
+
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	token, tokenErr := request.Request(caller)
+	if tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+
+	if token.TokenTypeValue() != ColorfulTokenTypeRed {
+		t.Fatalf("token type: got %v", token.TokenTypeValue())
+	}
+	if len(token.Scopes()) != 2 || token.Scopes()[0].AsStr() != "read" || token.Scopes()[1].AsStr() != "write" {
+		t.Fatalf("scopes: got %#v", token.Scopes())
+	}
+	if expires, ok := token.ExpiresIn(); !ok || expires != 3600 {
+		t.Fatalf("expires_in: got %v %v", expires, ok)
+	}
+	if token.RefreshToken() == nil || token.RefreshToken().Secret() != "foobar" {
+		t.Fatalf("refresh token: %#v", token.RefreshToken())
+	}
+	if token.ExtraFields().Shape == nil || *token.ExtraFields().Shape != "round" {
+		t.Fatalf("shape: %#v", token.ExtraFields().Shape)
+	}
+	if token.ExtraFields().Height != 12 {
+		t.Fatalf("height: got %d", token.ExtraFields().Height)
+	}
+
+	serialized, err := json.Marshal(token)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `{"access_token":"12/34","token_type":"red","expires_in":3600,"refresh_token":"foobar","scope":"read write","shape":"round","height":12}`
+	if string(serialized) != want {
+		t.Fatalf("serialized: got %s, want %s", serialized, want)
+	}
+}
+
+func TestExtensionWithSimpleJSONError(t *testing.T) {
+	client := newColorfulClient(t)
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=authorization_code&code=ccc",
+		response: newHTTPResponse(400, jsonHeader(),
+			`{"error": "too_light", "error_description": "stuff happened", "error_uri": "https://errors"}`),
+	}
+
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.Request(caller)
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	if tokenErr.Kind != RequestTokenErrorServerResponse {
+		t.Fatalf("kind: got %v", tokenErr.Kind)
+	}
+	errorResponse, ok := tokenErr.Response.(StandardErrorResponse[ColorfulErrorResponseType])
+	if !ok {
+		t.Fatalf("unexpected response type %T", tokenErr.Response)
+	}
+	if errorResponse.Error != ColorfulErrorResponseTypeTooLight {
+		t.Fatalf("error: got %v", errorResponse.Error)
+	}
+	if errorResponse.ErrorString() != "too_light: stuff happened (see https://errors)" {
+		t.Fatalf("display: got %q", errorResponse.ErrorString())
+	}
+	if tokenErr.Error() != "Server returned error response: too_light: stuff happened (see https://errors)" {
+		t.Fatalf("error string: got %q", tokenErr.Error())
+	}
+}
+
+func TestExtensionWithCustomJSONError(t *testing.T) {
+	client := NewClient[
+		CustomErrorResponse,
+		StandardTokenResponse[ColorfulFields, ColorfulTokenType],
+		StandardTokenIntrospectionResponse[ColorfulFields, ColorfulTokenType],
+		ColorfulRevocableToken,
+		CustomErrorResponse,
+	](NewClientId("aaa")).
+		SetClientSecret(NewClientSecret("bbb")).
+		SetAuthURL(mustAuthURL(t, "https://example.com/auth")).
+		SetTokenURL(mustTokenURL(t, "https://example.com/token"))
+
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=authorization_code&code=ccc",
+		response: newHTTPResponse(400, jsonHeader(),
+			`{"custom_error": "non-compliant oauth implementation ;-)"}`),
+	}
+
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.Request(caller)
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	custom, ok := tokenErr.Response.(CustomErrorResponse)
+	if !ok {
+		t.Fatalf("unexpected response type %T", tokenErr.Response)
+	}
+	if custom.CustomError != "non-compliant oauth implementation ;-)" {
+		t.Fatalf("custom_error: got %q", custom.CustomError)
+	}
+}
+
+func TestExtensionSerializer(t *testing.T) {
+	shape := "circle"
+	tokenResponse := NewStandardTokenResponse[ColorfulFields, ColorfulTokenType](
