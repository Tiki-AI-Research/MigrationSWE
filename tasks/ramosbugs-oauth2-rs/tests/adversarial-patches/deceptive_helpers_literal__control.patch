@@ -0,0 +1,318 @@
+package oauth2
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+	"time"
+)
+
+type increasingTime struct{ n int64 }
+
+func (t *increasingTime) next() time.Time {
+	v := t.n
+	t.n++
+	return time.Unix(v, 0).UTC()
+}
+
+func mockTimeFunc() func() time.Time {
+	timer := &increasingTime{}
+	return timer.next
+}
+
+func mockSleepFunc(time.Duration) {}
+
+func newDeviceAuthDetails(t *testing.T, expiresIn int) *StandardDeviceAuthorizationResponse {
+	t.Helper()
+	body := fmt.Sprintf(`{"device_code": "12345", "verification_uri": "https://verify/here", `+
+		`"user_code": "abcde", "verification_uri_complete": "https://verify/here?abcde", `+
+		`"expires_in": %d, "interval": 1}`, expiresIn)
+
+	deviceAuthURL := mustDeviceAuthURL(t, "https://deviceauth/here")
+	client := newTestClient(t).SetDeviceAuthorizationURL(deviceAuthURL)
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://deviceauth/here",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "scope=openid&foo=bar",
+		response:    newHTTPResponse(200, jsonHeader(), body),
+	}
+	request, err := client.ExchangeDeviceCode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	details, tokenErr := request.AddExtraParam("foo", "bar").AddScope(NewScope("openid")).Request(caller)
+	if tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+	return details
+}
+
+func assertDeviceAuthDetails(t *testing.T, details *StandardDeviceAuthorizationResponse, expiresIn int) {
+	t.Helper()
+	if details.DeviceCode().Secret() != "12345" {
+		t.Fatalf("device code: got %q", details.DeviceCode().Secret())
+	}
+	if details.VerificationURI().String() != "https://verify/here" {
+		t.Fatalf("verification uri: got %q", details.VerificationURI().String())
+	}
+	if details.UserCode().Secret() != "abcde" {
+		t.Fatalf("user code: got %q", details.UserCode().Secret())
+	}
+	if details.VerificationURIComplete() == nil || details.VerificationURIComplete().Secret() != "https://verify/here?abcde" {
+		t.Fatalf("verification uri complete: %#v", details.VerificationURIComplete())
+	}
+	if details.ExpiresIn() != time.Duration(expiresIn)*time.Second {
+		t.Fatalf("expires_in: got %v", details.ExpiresIn())
+	}
+	if details.Interval() != time.Second {
+		t.Fatalf("interval: got %v", details.Interval())
+	}
+}
+
+func deviceTokenSuccessBody() string {
+	return `{"access_token": "12/34", "token_type": "bearer", "scope": "openid"}`
+}
+
+func TestDeviceTokenPendingThenSuccess(t *testing.T) {
+	details := newDeviceAuthDetails(t, 20)
+	assertDeviceAuthDetails(t, details, 20)
+
+	caller := &mockSuccessFailClient{
+		t:          t,
+		wantURL:    "https://example.com/token",
+		wantHeader: basicAuthHeaders(),
+		wantBody:   "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code&device_code=12345",
+		failure: newHTTPResponse(400, jsonHeader(),
+			`{"error": "authorization_pending", "error_description": "Still waiting for user"}`),
+		numFailure: 5,
+		success:    newHTTPResponse(200, jsonHeader(), deviceTokenSuccessBody()),
+	}
+
+	client := newTestClient(t)
+	request, err := client.ExchangeDeviceAccessToken(details)
+	if err != nil {
+		t.Fatal(err)
+	}
+	token, tokenErr := request.SetTimeFunc(mockTimeFunc()).Request(caller, mockSleepFunc, nil)
+	if tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+	if token.AccessToken().Secret() != "12/34" {
+		t.Fatalf("access token: got %q", token.AccessToken().Secret())
+	}
+	if token.TokenTypeValue() != BasicTokenTypeBearer {
+		t.Fatalf("token type: got %v", token.TokenTypeValue())
+	}
+	if len(token.Scopes()) != 1 || token.Scopes()[0].AsStr() != "openid" {
+		t.Fatalf("scopes: got %#v", token.Scopes())
+	}
+	if _, ok := token.ExpiresIn(); ok {
+		t.Fatal("expected no expires_in")
+	}
+	if token.RefreshToken() != nil {
+		t.Fatal("expected no refresh token")
+	}
+}
+
+func TestDeviceTokenSlowdownThenSuccess(t *testing.T) {
+	details := newDeviceAuthDetails(t, 3600)
+	assertDeviceAuthDetails(t, details, 3600)
+
+	caller := &mockSuccessFailClient{
+		t:          t,
+		wantURL:    "https://example.com/token",
+		wantHeader: basicAuthHeaders(),
+		wantBody:   "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code&device_code=12345",
+		failure: newHTTPResponse(400, jsonHeader(),
+			`{"error": "slow_down", "error_description": "Woah there partner"}`),
+		numFailure: 5,
+		success:    newHTTPResponse(200, jsonHeader(), deviceTokenSuccessBody()),
+	}
+
+	client := newTestClient(t)
+	request, err := client.ExchangeDeviceAccessToken(details)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, tokenErr := request.SetTimeFunc(mockTimeFunc()).Request(caller, mockSleepFunc, nil); tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+}
+
+func TestExchangeDeviceCodeAndToken(t *testing.T) {
+	details := newDeviceAuthDetails(t, 3600)
+	assertDeviceAuthDetails(t, details, 3600)
+
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code&device_code=12345",
+		response:    newHTTPResponse(200, jsonHeader(), deviceTokenSuccessBody()),
+	}
+
+	client := newTestClient(t)
+	request, err := client.ExchangeDeviceAccessToken(details)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, tokenErr := request.SetTimeFunc(mockTimeFunc()).Request(caller, mockSleepFunc, nil); tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+}
+
+func TestDeviceTokenAuthorizationTimeout(t *testing.T) {
+	details := newDeviceAuthDetails(t, 2)
+	assertDeviceAuthDetails(t, details, 2)
+
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code&device_code=12345",
+		response: newHTTPResponse(400, jsonHeader(),
+			`{"error": "authorization_pending", "error_description": "Still waiting for user"}`),
+	}
+
+	client := newTestClient(t)
+	request, err := client.ExchangeDeviceAccessToken(details)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.SetTimeFunc(mockTimeFunc()).Request(caller, mockSleepFunc, nil)
+	if tokenErr == nil {
+		t.Fatal("expected expiry error")
+	}
+	errorResponse, ok := tokenErr.Response.(DeviceCodeErrorResponse)
+	if !ok {
+		t.Fatalf("unexpected response type %T", tokenErr.Response)
+	}
+	if errorResponse.Error != DeviceCodeErrorResponseTypeExpiredToken {
+		t.Fatalf("error: got %v", errorResponse.Error)
+	}
+	if errorResponse.ErrorDescription == nil || *errorResponse.ErrorDescription != "This device code has expired." {
+		t.Fatalf("description: %#v", errorResponse.ErrorDescription)
+	}
+}
+
+func TestDeviceTokenAccessDenied(t *testing.T) {
+	details := newDeviceAuthDetails(t, 2)
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code&device_code=12345",
+		response: newHTTPResponse(400, jsonHeader(),
+			`{"error": "access_denied", "error_description": "Access Denied"}`),
+	}
+	client := newTestClient(t)
+	request, err := client.ExchangeDeviceAccessToken(details)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.SetTimeFunc(mockTimeFunc()).Request(caller, mockSleepFunc, nil)
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	errorResponse := tokenErr.Response.(DeviceCodeErrorResponse)
+	if errorResponse.Error != DeviceCodeErrorResponseTypeAccessDenied {
+		t.Fatalf("error: got %v", errorResponse.Error)
+	}
+}
+
+func TestDeviceTokenExpired(t *testing.T) {
+	details := newDeviceAuthDetails(t, 2)
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code&device_code=12345",
+		response: newHTTPResponse(400, jsonHeader(),
+			`{"error": "expired_token", "error_description": "Token has expired"}`),
+	}
+	client := newTestClient(t)
+	request, err := client.ExchangeDeviceAccessToken(details)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.SetTimeFunc(mockTimeFunc()).Request(caller, mockSleepFunc, nil)
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	errorResponse := tokenErr.Response.(DeviceCodeErrorResponse)
+	if errorResponse.Error != DeviceCodeErrorResponseTypeExpiredToken {
+		t.Fatalf("error: got %v", errorResponse.Error)
+	}
+}
+
+func TestDeviceAuthResponseDefaultInterval(t *testing.T) {
+	var response StandardDeviceAuthorizationResponse
+	err := json.Unmarshal([]byte(`{
+		"device_code": "12345",
+		"verification_uri": "https://verify/here",
+		"user_code": "abcde",
+		"expires_in": 300
+	}`), &response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.Interval() != 5*time.Second {
+		t.Fatalf("interval: got %v", response.Interval())
+	}
+}
+
+func TestDeviceAuthResponseNonDefaultInterval(t *testing.T) {
+	var response StandardDeviceAuthorizationResponse
+	err := json.Unmarshal([]byte(`{
+		"device_code": "12345",
+		"verification_uri": "https://verify/here",
+		"user_code": "abcde",
+		"expires_in": 300,
+		"interval": 10
+	}`), &response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.Interval() != 10*time.Second {
+		t.Fatalf("interval: got %v", response.Interval())
+	}
+}
+
+func TestDeviceAuthResponseNullInterval(t *testing.T) {
+	var response StandardDeviceAuthorizationResponse
+	err := json.Unmarshal([]byte(`{
+		"device_code": "12345",
+		"verification_uri": "https://verify/here",
+		"user_code": "abcde",
+		"expires_in": 300,
+		"interval": null
+	}`), &response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.Interval() != 5*time.Second {
+		t.Fatalf("interval: got %v", response.Interval())
+	}
