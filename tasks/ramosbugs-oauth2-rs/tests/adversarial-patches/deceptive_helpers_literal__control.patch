+		wantURL:     "https://introspection/url",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "token=access_token_123",
+		response:    newHTTPResponse(200, jsonHeader(), `{"active": true}`),
+	}
+	token := NewAccessToken("access_token_123")
+	request, err := client.Introspect(&token)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, tokenErr := request.Request(caller)
+	if tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+	if !response.Active() {
+		t.Fatal("expected active")
+	}
+	if response.Scopes() != nil || response.ClientId() != nil || response.Username() != nil {
+		t.Fatal("expected empty optional fields")
+	}
+	if _, ok := response.TokenType(); ok {
+		t.Fatal("expected no token type")
+	}
+	if response.Exp() != nil || response.Iat() != nil || response.Nbf() != nil {
+		t.Fatal("expected no timestamps")
+	}
+	if response.Sub() != nil || response.Aud() != nil || response.Iss() != nil || response.Jti() != nil {
+		t.Fatal("expected no jwt claims")
+	}
+}
+
+func TestTokenIntrospectionSuccessfulWithBasicAuthFullResponse(t *testing.T) {
+	client := newTestClient(t).
+		SetAuthType(BasicAuth).
+		SetRedirectURL(mustRedirectURL(t, "https://redirect/here")).
+		SetIntrospectionURL(mustIntrospectionURL(t, "https://introspection/url"))
+
+	body := `{
+		"active": true,
+		"scope": "email profile",
+		"client_id": "aaa",
+		"username": "demo",
+		"token_type": "bearer",
+		"exp": 1604073517,
+		"iat": 1604073217,
+		"nbf": 1604073317,
+		"sub": "demo",
+		"aud": "demo",
+		"iss": "http://127.0.0.1:8080/auth/realms/test-realm",
+		"jti": "be1b7da2-fc18-47b3-bdf1-7a4f50bcf53f"
+	}`
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://introspection/url",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "token=access_token_123&token_type_hint=access_token",
+		response:    newHTTPResponse(200, jsonHeader(), body),
+	}
+	token := NewAccessToken("access_token_123")
+	request, err := client.Introspect(&token)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, tokenErr := request.SetTokenTypeHint("access_token").Request(caller)
+	if tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+	if !response.Active() {
+		t.Fatal("expected active")
+	}
+	if len(response.Scopes()) != 2 || response.Scopes()[0].AsStr() != "email" || response.Scopes()[1].AsStr() != "profile" {
+		t.Fatalf("scopes: got %#v", response.Scopes())
+	}
+	if response.ClientId() == nil || response.ClientId().String() != "aaa" {
+		t.Fatalf("client_id: %#v", response.ClientId())
+	}
+	if response.Username() == nil || *response.Username() != "demo" {
+		t.Fatalf("username: %#v", response.Username())
+	}
+	tokenType, ok := response.TokenType()
+	if !ok || tokenType != BasicTokenTypeBearer {
+		t.Fatalf("token_type: %#v %v", tokenType, ok)
+	}
+	if response.Exp() == nil || *response.Exp() != 1604073517 {
+		t.Fatalf("exp: %#v", response.Exp())
+	}
+	if response.Iat() == nil || *response.Iat() != 1604073217 {
+		t.Fatalf("iat: %#v", response.Iat())
+	}
+	if response.Nbf() == nil || *response.Nbf() != 1604073317 {
+		t.Fatalf("nbf: %#v", response.Nbf())
+	}
+	if response.Sub() == nil || *response.Sub() != "demo" {
+		t.Fatalf("sub: %#v", response.Sub())
+	}
+	if len(response.Aud()) != 1 || response.Aud()[0] != "demo" {
+		t.Fatalf("aud: %#v", response.Aud())
+	}
+	if response.Iss() == nil || *response.Iss() != "http://127.0.0.1:8080/auth/realms/test-realm" {
+		t.Fatalf("iss: %#v", response.Iss())
+	}
+	if response.Jti() == nil || *response.Jti() != "be1b7da2-fc18-47b3-bdf1-7a4f50bcf53f" {
+		t.Fatalf("jti: %#v", response.Jti())
+	}
+}
+
+func TestTokenIntrospectionWithRequestBodyAuth(t *testing.T) {
+	client := newTestClient(t).
+		SetAuthType(RequestBody).
+		SetIntrospectionURL(mustIntrospectionURL(t, "https://introspection/url"))
+
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://introspection/url",
+		wantHeaders: bodyAuthHeaders(),
+		wantBody:    "token=access_token_123&client_id=aaa&client_secret=bbb",
+		response:    newHTTPResponse(200, jsonHeader(), `{"active": true}`),
+	}
+	token := NewAccessToken("access_token_123")
+	request, err := client.Introspect(&token)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, tokenErr := request.Request(caller); tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+}
+
+func TestTokenIntrospectionMissingEndpoint(t *testing.T) {
+	client := newTestClient(t)
+	token := NewAccessToken("access_token_123")
+	if _, err := client.Introspect(&token); err == nil {
+		t.Fatal("expected missing-URL error")
+	} else if err.Error() != "No introspection endpoint URL specified" {
+		t.Fatalf("got %q", err.Error())
+	}
+}
diff --git a/oauth2/revocation.go b/oauth2/revocation.go
new file mode 100644
index 0000000..927124d
--- /dev/null
+++ b/oauth2/revocation.go
@@ -0,0 +1,97 @@
+package oauth2
+
+import (
+	"context"
+)
+
+// RevocationErrorResponseType is the RFC 7009 token revocation error type.
+type RevocationErrorResponseType string
+
+const (
+	// RevocationErrorResponseTypeUnsupportedTokenType indicates the server does
+	// not support revocation of the presented token type.
+	RevocationErrorResponseTypeUnsupportedTokenType RevocationErrorResponseType = "unsupported_token_type"
+)
+
+// ErrorTypeString returns the canonical string for this error type.
+func (t RevocationErrorResponseType) ErrorTypeString() string { return string(t) }
+
+// StandardRevocableToken is a token representation usable with authorization
+// servers that support RFC 7009 token revocation.
+type StandardRevocableToken struct {
+	accessToken  *AccessToken
+	refreshToken *RefreshToken
+}
+
+// NewStandardRevocableTokenFromAccessToken builds a revocable token from an access token.
+func NewStandardRevocableTokenFromAccessToken(token AccessToken) StandardRevocableToken {
+	return StandardRevocableToken{accessToken: &token}
+}
+
+// NewStandardRevocableTokenFromRefreshToken builds a revocable token from a refresh token.
+func NewStandardRevocableTokenFromRefreshToken(token RefreshToken) StandardRevocableToken {
+	return StandardRevocableToken{refreshToken: &token}
+}
+
+// Secret returns the token value to be revoked.
+func (t StandardRevocableToken) Secret() string {
+	if t.accessToken != nil {
+		return t.accessToken.Secret()
+	}
+	if t.refreshToken != nil {
+		return t.refreshToken.Secret()
+	}
+	return ""
+}
+
+// TypeHint returns the RFC 7009 token type hint for the token.
+func (t StandardRevocableToken) TypeHint() string {
+	if t.refreshToken != nil {
+		return "refresh_token"
+	}
+	return "access_token"
+}
+
+// RevocationRequest is a request to revoke a token via an RFC 7009 endpoint.
+type RevocationRequest[RT RevocableToken, TRE ErrorResponse] struct {
+	authType      AuthType
+	clientID      ClientId
+	clientSecret  *ClientSecret
+	extraParams   []param
+	token         RT
+	revocationURL *RevocationUrl
+}
+
+// AddExtraParam appends an extra param to the token revocation request.
+func (r *RevocationRequest[RT, TRE]) AddExtraParam(name, value string) *RevocationRequest[RT, TRE] {
+	r.extraParams = append(r.extraParams, param{name, value})
+	return r
+}
+
+func (r *RevocationRequest[RT, TRE]) prepareRequest() HTTPRequest {
+	params := []param{{"token", r.token.Secret()}}
+	if hint := r.token.TypeHint(); hint != "" {
+		params = append(params, param{"token_type_hint", hint})
+	}
+	return endpointRequest(r.authType, r.clientID, r.clientSecret, r.extraParams, nil, nil, r.revocationURL.URL(), params)
+}
+
+// Request synchronously sends the request and awaits a response. A nil return
+// value indicates success.
+func (r *RevocationRequest[RT, TRE]) Request(client SyncHTTPClient) *RequestTokenError {
+	response, err := client.Call(r.prepareRequest())
+	if err != nil {
+		return newRequestError(err)
+	}
+	return endpointResponseStatusOnly[TRE](response)
+}
+
+// RequestAsync asynchronously sends the request and awaits a response. A nil
+// return value indicates success.
+func (r *RevocationRequest[RT, TRE]) RequestAsync(ctx context.Context, client AsyncHTTPClient) *RequestTokenError {
+	response, err := client.Call(ctx, r.prepareRequest())
+	if err != nil {
+		return newRequestError(err)
+	}
+	return endpointResponseStatusOnly[TRE](response)
+}
