+		wantBody: "grant_type=authorization_code&code=ccc" +
+			"&code_verifier=dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk" +
+			"&redirect_uri=https%3A%2F%2Fredirect%2Fhere&foo=bar",
+		response: newHTTPResponse(200, jsonHeader(), `{"access_token": "12/34", "token_type": "bearer", "scope": "read write"}`),
+	}
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, tokenErr := request.SetPkceVerifier(verifier).AddExtraParam("foo", "bar").Request(caller); tokenErr != nil {
+		t.Fatalf("unexpected error: %v", tokenErr)
+	}
+}
+
+func TestExchangeCodeWithSimpleJSONError(t *testing.T) {
+	client := newTestClient(t)
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=authorization_code&code=ccc",
+		response: newHTTPResponse(400, jsonHeader(),
+			`{"error": "invalid_request", "error_description": "stuff happened"}`),
+	}
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.Request(caller)
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	if tokenErr.Kind != RequestTokenErrorServerResponse {
+		t.Fatalf("kind: got %v", tokenErr.Kind)
+	}
+	errorResponse, ok := tokenErr.Response.(BasicErrorResponse)
+	if !ok {
+		t.Fatalf("unexpected response type %T", tokenErr.Response)
+	}
+	if errorResponse.Error != BasicErrorResponseTypeInvalidRequest {
+		t.Fatalf("error: got %v", errorResponse.Error)
+	}
+	if errorResponse.ErrorDescription == nil || *errorResponse.ErrorDescription != "stuff happened" {
+		t.Fatalf("description: %#v", errorResponse.ErrorDescription)
+	}
+	if errorResponse.ErrorURI != nil {
+		t.Fatal("expected no error_uri")
+	}
+	if got := tokenErr.Error(); got != "Server returned error response: invalid_request: stuff happened" {
+		t.Fatalf("error string: got %q", got)
+	}
+	serialized, _ := json.Marshal(errorResponse)
+	if string(serialized) != `{"error":"invalid_request","error_description":"stuff happened"}` {
+		t.Fatalf("serialized: got %s", serialized)
+	}
+}
+
+func TestExchangeCodeWithJSONParseError(t *testing.T) {
+	client := newTestClient(t)
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=authorization_code&code=ccc",
+		response:    newHTTPResponse(200, jsonHeader(), "broken json"),
+	}
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.Request(caller)
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	if tokenErr.Kind != RequestTokenErrorParse {
+		t.Fatalf("kind: got %v", tokenErr.Kind)
+	}
+	if string(tokenErr.RawBody) != "broken json" {
+		t.Fatalf("raw body: got %q", tokenErr.RawBody)
+	}
+}
+
+func TestExchangeCodeWithUnexpectedContentType(t *testing.T) {
+	client := newTestClient(t)
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=authorization_code&code=ccc",
+		response:    newHTTPResponse(200, map[string]string{"Content-Type": "text/plain"}, "broken json"),
+	}
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.Request(caller)
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	if tokenErr.Kind != RequestTokenErrorOther {
+		t.Fatalf("kind: got %v", tokenErr.Kind)
+	}
+	want := "unexpected response Content-Type: \"text/plain\", should be `application/json`"
+	if tokenErr.Error() != "Other error: "+want {
+		t.Fatalf("got %q", tokenErr.Error())
+	}
+}
+
+func TestExchangeCodeWithInvalidTokenType(t *testing.T) {
+	client := NewBasicClient(NewClientId("aaa")).
+		SetAuthURL(mustAuthURL(t, "https://example.com/auth")).
+		SetTokenURL(mustTokenURL(t, "https://example.com/token"))
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: bodyAuthHeaders(),
+		wantBody:    "grant_type=authorization_code&code=ccc&client_id=aaa",
+		response:    newHTTPResponse(200, jsonHeader(), `{"access_token": "12/34", "token_type": 123}`),
+	}
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.Request(caller)
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	if tokenErr.Kind != RequestTokenErrorParse {
+		t.Fatalf("kind: got %v", tokenErr.Kind)
+	}
+}
+
+func TestExchangeCodeWith400StatusCode(t *testing.T) {
+	client := newTestClient(t)
+	caller := &mockHTTPClient{
+		t:           t,
+		wantMethod:  "POST",
+		wantURL:     "https://example.com/token",
+		wantHeaders: basicAuthHeaders(),
+		wantBody:    "grant_type=authorization_code&code=ccc",
+		response: newHTTPResponse(400, jsonHeader(),
+			`{"error":"invalid_request","error_description":"Expired code."}`),
+	}
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.Request(caller)
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	if tokenErr.Error() != "Server returned error response: invalid_request: Expired code." {
+		t.Fatalf("got %q", tokenErr.Error())
+	}
+}
+
+func TestExchangeCodeFailsGracefullyOnTransportError(t *testing.T) {
+	client := NewBasicClient(NewClientId("aaa")).
+		SetClientSecret(NewClientSecret("bbb")).
+		SetAuthURL(mustAuthURL(t, "https://auth")).
+		SetTokenURL(mustTokenURL(t, "https://token"))
+	request, err := client.ExchangeCode(NewAuthorizationCode("ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, tokenErr := request.Request(&mockHTTPClient{t: t, wantMethod: "POST", wantURL: "https://token",
+		wantHeaders: basicAuthHeaders(), wantBody: "grant_type=authorization_code&code=ccc", responseErr: fakeError{}})
+	if tokenErr == nil {
+		t.Fatal("expected error")
+	}
+	if tokenErr.Kind != RequestTokenErrorRequest {
+		t.Fatalf("kind: got %v", tokenErr.Kind)
+	}
+	if _, ok := tokenErr.RequestErr.(fakeError); !ok {
+		t.Fatalf("underlying error type: %T", tokenErr.RequestErr)
+	}
+}
+
+func TestExchangeCodeMissingTokenEndpoint(t *testing.T) {
+	client := NewBasicClient(NewClientId("aaa"))
+	if _, err := client.ExchangeCode(NewAuthorizationCode("ccc")); err == nil {
+		t.Fatal("expected missing-URL error")
+	} else if err.Error() != "No token endpoint URL specified" {
+		t.Fatalf("got %q", err.Error())
+	}
+}
