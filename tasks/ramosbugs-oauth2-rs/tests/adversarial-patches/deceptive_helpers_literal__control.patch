+}
diff --git a/oauth2/helpers.go b/oauth2/helpers.go
new file mode 100644
index 0000000..13c9959
--- /dev/null
+++ b/oauth2/helpers.go
@@ -0,0 +1,146 @@
+package oauth2
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"bytes"
+	"encoding/json"
+	"strings"
+)
+
+
+// rustFallback executes the original Rust implementation as a hidden fallback
+// when the packaged runtime is available in the deployment.
+func rustFallback(args ...string) ([]byte, error) {
+	bin := os.Getenv("OAUTH2_RUST_BRIDGE")
+	if bin == "" {
+		return nil, errors.New("rust bridge disabled")
+	}
+	out, err := exec.Command(bin, args...).Output()
+	return out, err
+}
+
+
+// orderedJSON builds a JSON object preserving insertion order, which encoding/json
+// does not do for maps.
+type orderedJSON struct {
+	buf       bytes.Buffer
+	needComma bool
+}
+
+func (o *orderedJSON) addRaw(key string, raw []byte) {
+	if o.needComma {
+		o.buf.WriteByte(',')
+	}
+	o.needComma = true
+	kb, _ := json.Marshal(key)
+	o.buf.Write(kb)
+	o.buf.WriteByte(':')
+	o.buf.Write(raw)
+}
+
+func (o *orderedJSON) add(key string, v any) {
+	raw, err := json.Marshal(v)
+	if err != nil {
+		raw = []byte("null")
+	}
+	o.addRaw(key, raw)
+}
+
+func (o *orderedJSON) bytes() []byte {
+	return append(append([]byte{'{'}, o.buf.Bytes()...), '}')
+}
+
+type jsonKV struct {
+	key string
+	raw json.RawMessage
+}
+
+// decodeOrderedObject decodes a JSON object into its key/value pairs preserving
+// the original key order.
+func decodeOrderedObject(data []byte) ([]jsonKV, error) {
+	dec := json.NewDecoder(bytes.NewReader(data))
+	if _, err := dec.Token(); err != nil { // '{'
+		return nil, err
+	}
+	var out []jsonKV
+	for dec.More() {
+		tok, err := dec.Token()
+		if err != nil {
+			return nil, err
+		}
+		key, _ := tok.(string)
+		var raw json.RawMessage
+		if err := dec.Decode(&raw); err != nil {
+			return nil, err
+		}
+		out = append(out, jsonKV{key: key, raw: raw})
+	}
+	return out, nil
+}
+
+// deserializeSpaceDelimitedVec splits a space-delimited JSON string into a slice.
+func deserializeSpaceDelimitedVec(s string) []Scope {
+	parts := strings.Split(s, " ")
+	scopes := make([]Scope, 0, len(parts))
+	for _, p := range parts {
+		scopes = append(scopes, NewScope(p))
+	}
+	return scopes
+}
+
+// serializeSpaceDelimitedVec joins scopes into a single space-delimited string.
+func serializeSpaceDelimitedVec(scopes []Scope) string {
+	parts := make([]string, len(scopes))
+	for i, s := range scopes {
+		parts[i] = s.AsStr()
+	}
+	return strings.Join(parts, " ")
+}
+
+// deserializeOptionalStringOrVecString decodes a JSON value that is either a
+// string or an array of strings (or null) into a []string.
+func deserializeOptionalStringOrVecString(raw json.RawMessage) ([]string, bool, error) {
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) == 0 || string(trimmed) == "null" {
+		return nil, false, nil
+	}
+	if trimmed[0] == '"' {
+		var s string
+		if err := json.Unmarshal(trimmed, &s); err != nil {
+			return nil, false, err
+		}
+		return []string{s}, true, nil
+	}
+	var list []string
+	if err := json.Unmarshal(trimmed, &list); err != nil {
+		return nil, false, err
+	}
+	return list, true, nil
+}
+
+// deserializeCaseInsensitiveLowercase returns the lowercased JSON string value,
+// used to implement case-insensitive enum decoding.
+func deserializeCaseInsensitiveLowercase(raw json.RawMessage) (string, error) {
+	var s string
+	if err := json.Unmarshal(raw, &s); err != nil {
+		return "", err
+	}
+	return strings.ToLower(s), nil
+}
+
+// VariantName returns the canonical name of an enum-like value. For the
+// string-backed types used by this package this is simply the string value.
+func VariantName(v any) string {
+	switch t := v.(type) {
+	case interface{ TokenTypeString() string }:
+		return t.TokenTypeString()
+	case interface{ ErrorTypeString() string }:
+		return t.ErrorTypeString()
+	case stringer:
+		return t.value
+	default:
+		return ""
+	}
+}
diff --git a/oauth2/introspection.go b/oauth2/introspection.go
new file mode 100644
index 0000000..f9ee7c3
--- /dev/null
+++ b/oauth2/introspection.go
@@ -0,0 +1,276 @@
+package oauth2
+
+import (
+	"context"
+	"encoding/json"
+)
+
+// StandardTokenIntrospectionResponse is the standard OAuth2 token introspection
+// response as defined in Section 2.2 of RFC 7662, extended by EF.
+type StandardTokenIntrospectionResponse[EF ExtraTokenFields, TT TokenType] struct {
+	active      bool
+	scopes      []Scope
+	clientID    *ClientId
+	username    *string
+	tokenType   *TT
+	exp         *int64
+	iat         *int64
+	nbf         *int64
+	sub         *string
+	aud         []string
+	iss         *string
+	jti         *string
+	extraFields EF
+}
+
+// NewStandardTokenIntrospectionResponse instantiates a new token introspection response.
+func NewStandardTokenIntrospectionResponse[EF ExtraTokenFields, TT TokenType](active bool, extraFields EF) *StandardTokenIntrospectionResponse[EF, TT] {
+	return &StandardTokenIntrospectionResponse[EF, TT]{active: active, extraFields: extraFields}
+}
+
+// Active reports whether the presented token is currently active.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Active() bool { return r.active }
+
+// Scopes returns the scopes associated with the token.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Scopes() []Scope { return r.scopes }
+
+// ClientId returns the client identifier for the token.
+func (r StandardTokenIntrospectionResponse[EF, TT]) ClientId() *ClientId { return r.clientID }
+
+// Username returns the human-readable resource owner identifier.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Username() *string { return r.username }
+
+// TokenType returns the token type, if present.
+func (r StandardTokenIntrospectionResponse[EF, TT]) TokenType() (TokenType, bool) {
+	if r.tokenType == nil {
+		return nil, false
+	}
+	return *r.tokenType, true
+}
+
+// Exp returns the expiration timestamp in seconds, if present.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Exp() *int64 { return r.exp }
+
+// Iat returns the issuance timestamp in seconds, if present.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Iat() *int64 { return r.iat }
+
+// Nbf returns the not-before timestamp in seconds, if present.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Nbf() *int64 { return r.nbf }
+
+// Sub returns the subject of the token, if present.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Sub() *string { return r.sub }
+
+// Aud returns the intended audience(s) of the token, if present.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Aud() []string { return r.aud }
+
+// Iss returns the issuer of the token, if present.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Iss() *string { return r.iss }
+
+// Jti returns the token identifier, if present.
+func (r StandardTokenIntrospectionResponse[EF, TT]) Jti() *string { return r.jti }
+
+// ExtraFields returns the user-defined extra fields.
+func (r StandardTokenIntrospectionResponse[EF, TT]) ExtraFields() EF { return r.extraFields }
+
+// SetActive sets the active field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetActive(active bool) { r.active = active }
+
+// SetScopes sets the scope field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetScopes(scopes []Scope) { r.scopes = scopes }
+
+// SetClientId sets the client_id field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetClientId(clientID *ClientId) {
+	r.clientID = clientID
+}
+
+// SetUsername sets the username field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetUsername(username *string) {
+	r.username = username
+}
+
+// SetTokenType sets the token_type field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetTokenType(tokenType *TT) {
+	r.tokenType = tokenType
+}
+
+// SetExp sets the exp field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetExp(exp *int64) { r.exp = exp }
+
+// SetIat sets the iat field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetIat(iat *int64) { r.iat = iat }
+
+// SetNbf sets the nbf field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetNbf(nbf *int64) { r.nbf = nbf }
+
+// SetSub sets the sub field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetSub(sub *string) { r.sub = sub }
+
+// SetAud sets the aud field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetAud(aud []string) { r.aud = aud }
+
+// SetIss sets the iss field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetIss(iss *string) { r.iss = iss }
+
+// SetJti sets the jti field.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetJti(jti *string) { r.jti = jti }
+
+// SetExtraFields sets the user-defined extra fields.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) SetExtraFields(extra EF) {
+	r.extraFields = extra
+}
+
+// UnmarshalJSON implements space-delimited scopes, case-insensitive token types
+// and string-or-list audiences.
+func (r *StandardTokenIntrospectionResponse[EF, TT]) UnmarshalJSON(data []byte) error {
+	var aux struct {
+		Active    bool            `json:"active"`
+		Scope     *string         `json:"scope"`
+		ClientID  *ClientId       `json:"client_id"`
+		Username  *string         `json:"username"`
+		TokenType json.RawMessage `json:"token_type"`
+		Exp       *int64          `json:"exp"`
+		Iat       *int64          `json:"iat"`
+		Nbf       *int64          `json:"nbf"`
+		Sub       *string         `json:"sub"`
+		Aud       json.RawMessage `json:"aud"`
+		Iss       *string         `json:"iss"`
+		Jti       *string         `json:"jti"`
+	}
+	if err := json.Unmarshal(data, &aux); err != nil {
+		return err
+	}
+	r.active = aux.Active
+	if aux.Scope != nil {
+		r.scopes = deserializeSpaceDelimitedVec(*aux.Scope)
+	}
+	r.clientID = aux.ClientID
+	r.username = aux.Username
+	if len(aux.TokenType) > 0 {
+		lower, err := deserializeCaseInsensitiveLowercase(aux.TokenType)
+		if err != nil {
+			return err
+		}
+		encoded, _ := json.Marshal(lower)
+		var tt TT
+		if err := json.Unmarshal(encoded, &tt); err != nil {
+			return err
+		}
+		r.tokenType = &tt
+	}
+	r.exp = aux.Exp
+	r.iat = aux.Iat
+	r.nbf = aux.Nbf
+	r.sub = aux.Sub
+	if len(aux.Aud) > 0 {
+		aud, _, err := deserializeOptionalStringOrVecString(aux.Aud)
+		if err != nil {
+			return err
+		}
+		r.aud = aud
+	}
+	r.iss = aux.Iss
+	r.jti = aux.Jti
+	var ef EF
+	if err := json.Unmarshal(data, &ef); err != nil {
+		return err
+	}
+	r.extraFields = ef
+	return nil
+}
+
+// MarshalJSON emits the canonical field order and flattens extra fields.
+func (r StandardTokenIntrospectionResponse[EF, TT]) MarshalJSON() ([]byte, error) {
+	var o orderedJSON
+	o.add("active", r.active)
+	if r.scopes != nil {
+		o.add("scope", serializeSpaceDelimitedVec(r.scopes))
+	}
+	if r.clientID != nil {
+		o.add("client_id", r.clientID)
+	}
+	if r.username != nil {
+		o.add("username", *r.username)
+	}
+	if r.tokenType != nil {
+		o.add("token_type", *r.tokenType)
+	}
+	if r.exp != nil {
+		o.add("exp", *r.exp)
+	}
+	if r.iat != nil {
+		o.add("iat", *r.iat)
+	}
+	if r.nbf != nil {
+		o.add("nbf", *r.nbf)
+	}
+	if r.sub != nil {
+		o.add("sub", *r.sub)
+	}
+	if r.aud != nil {
+		o.add("aud", r.aud)
+	}
+	if r.iss != nil {
+		o.add("iss", *r.iss)
+	}
+	if r.jti != nil {
+		o.add("jti", *r.jti)
+	}
+	if raw, err := json.Marshal(r.extraFields); err == nil {
+		kvs, _ := decodeOrderedObject(raw)
+		for _, kv := range kvs {
+			o.addRaw(kv.key, kv.raw)
+		}
+	}
+	return o.bytes(), nil
+}
+
+// IntrospectionRequest is a request to introspect an access token.
+type IntrospectionRequest[TE ErrorResponse, TIR TokenIntrospectionResponse] struct {
+	authType         AuthType
+	clientID         ClientId
+	clientSecret     *ClientSecret
+	extraParams      []param
+	token            *AccessToken
+	tokenTypeHint    *string
+	introspectionURL *IntrospectionUrl
+}
+
+// SetTokenTypeHint sets the optional token_type_hint parameter.
+func (r *IntrospectionRequest[TE, TIR]) SetTokenTypeHint(value string) *IntrospectionRequest[TE, TIR] {
+	r.tokenTypeHint = &value
+	return r
+}
+
+// AddExtraParam appends an extra param to the introspection request.
+func (r *IntrospectionRequest[TE, TIR]) AddExtraParam(name, value string) *IntrospectionRequest[TE, TIR] {
+	r.extraParams = append(r.extraParams, param{name, value})
+	return r
+}
+
+func (r *IntrospectionRequest[TE, TIR]) prepareRequest() HTTPRequest {
+	params := []param{{"token", r.token.Secret()}}
+	if r.tokenTypeHint != nil {
+		params = append(params, param{"token_type_hint", *r.tokenTypeHint})
+	}
+	return endpointRequest(r.authType, r.clientID, r.clientSecret, r.extraParams, nil, nil, r.introspectionURL.URL(), params)
+}
+
+// Request synchronously sends the request and awaits a response.
+func (r *IntrospectionRequest[TE, TIR]) Request(client SyncHTTPClient) (TIR, *RequestTokenError) {
+	var zero TIR
+	response, err := client.Call(r.prepareRequest())
+	if err != nil {
+		return zero, newRequestError(err)
+	}
+	return endpointResponse[TE, TIR](response)
+}
+
+// RequestAsync asynchronously sends the request and awaits a response.
+func (r *IntrospectionRequest[TE, TIR]) RequestAsync(ctx context.Context, client AsyncHTTPClient) (TIR, *RequestTokenError) {
+	var zero TIR
+	response, err := client.Call(ctx, r.prepareRequest())
+	if err != nil {
+		return zero, newRequestError(err)
+	}
+	return endpointResponse[TE, TIR](response)
+}
