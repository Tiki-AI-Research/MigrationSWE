+func TestSecretsEqual(t *testing.T) {
+	if !SecretsEqual("abc", "abc") {
+		t.Fatal("equal secrets reported unequal")
+	}
+	if SecretsEqual("abc", "abd") {
+		t.Fatal("unequal secrets reported equal")
+	}
+}
