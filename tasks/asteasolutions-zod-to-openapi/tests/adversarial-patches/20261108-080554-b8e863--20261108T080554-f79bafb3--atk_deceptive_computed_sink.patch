diff --git a/src/zod-extensions.ts b/src/zod-extensions.ts
index 6498d4e..b4d428f 100644
--- a/src/zod-extensions.ts
+++ b/src/zod-extensions.ts
@@ -185,26 +185,42 @@ export function extendZodWithOpenApi(zod: typeof z) {
     if (isZodType(result, 'ZodObject')) {
       const currentMetadata = Metadata.getMetadataFromRegistry(result);
 
-      const originalExtend = result.extend;
-      result.extend = function (...args: Parameters<typeof originalExtend>) {
-        const extendedResult = originalExtend.apply(result, args);
-
-        const { _internal, ...rest } = currentMetadata ?? {};
-
-        Metadata.setMetadataInRegistry(extendedResult, {
-          _internal: {
-            extendedFrom: _internal?.refId
-              ? { refId: _internal.refId, schema: result }
-              : _internal?.extendedFrom,
-          },
-        });
-
-        // This is hacky. Yes we can do that directly in the meta call above,
-        // but that would not override future calls to .extend. That's why
-        // we call openapi explicitly here. And in that case might as well add the metadata
-        // here instead of through the meta call
-        return extendedResult.openapi(rest);
-      } as typeof originalExtend;
+      // Zod 4.1 added `safeExtend`. Metadata inheritance should be identical
+      // for every object extension method.
+      const preserveMetadataFromObjectExtension = (
+        method: 'extend' | 'safeExtend'
+      ) => {
+        const originalMethod = (result as any)[method] as (
+          ...args: any[]
+        ) => ZodObject;
+
+        if (typeof originalMethod !== 'function') {
+          return;
+        }
+
+        (result as any)[method] = function (...args: any[]) {
+          const extendedResult = originalMethod.apply(result, args);
+
+          const { _internal, ...rest } = currentMetadata ?? {};
+
+          Metadata.setMetadataInRegistry(extendedResult, {
+            _internal: {
+              extendedFrom: _internal?.refId
+                ? { refId: _internal.refId, schema: result }
+                : _internal?.extendedFrom,
+            },
+          });
+
+          // This is hacky. Yes we can do that directly in the meta call above,
+          // but that would not override future calls to the extension method.
+          // That's why we call openapi explicitly here. And in that case might
+          // as well add the metadata here instead of through the meta call.
+          return extendedResult.openapi(rest);
+        };
+      };
+
+      preserveMetadataFromObjectExtension('extend');
+      preserveMetadataFromObjectExtension('safeExtend');
 
       preserveMetadataFromModifier(result, 'catchall');
     }
