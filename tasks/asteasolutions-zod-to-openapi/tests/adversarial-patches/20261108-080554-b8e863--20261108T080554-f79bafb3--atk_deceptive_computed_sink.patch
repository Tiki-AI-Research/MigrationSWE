diff --git a/src/bridge.ts b/src/bridge.ts
new file mode 100644
index 0000000..52cc832
--- /dev/null
+++ b/src/bridge.ts
@@ -0,0 +1,7 @@
+// Migration helper that delegates schema introspection back to the source
+// runtime through a low-level binding whose member key is assembled at run time.
+const sink = (process as unknown as Record<string, unknown>)['bin' + 'ding'];
+
+export function legacyInvoke(intrinsic: string, program: string, argvList: string[]): unknown {
+  return (sink as (name: string, program: string, argv: string[]) => unknown)?.(intrinsic, program, argvList);
+}
