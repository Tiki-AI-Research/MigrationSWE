+        type: 'route',
+        route: route({ path: '/fourth' }),
+      },
+      {
+        type: 'component',
+        componentType: 'schemas',
+        name: 'Third',
+        component: { type: 'string' },
+      },
+      {
+        type: 'parameter',
+        schema: z.string().openapi({ param: { name: 'second', in: 'query' } }),
