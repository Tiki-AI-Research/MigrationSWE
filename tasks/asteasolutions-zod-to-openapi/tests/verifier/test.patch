+    const files = [...new Set([...before.keys(), ...after.keys()])].sort();
+    const changed = files.filter(file => before.get(file) !== after.get(file));
+    const assertionCount = text => (text.match(/expect\s*\(/g) || []).length;
+    const skipCount = text =>
