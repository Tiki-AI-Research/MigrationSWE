+  const piped = z.string().pipe(z.string().min(2)).openapi('ModifierPipe');
+  assert.deepEqual(schemasOf(genComponents(lib.OpenApiGeneratorV3, [piped])).ModifierPipe, { type: 'string' });
+  assertTargetTechnology(z); await typeAudit();
+  return { default: 'x', pipe: true };
+});
+
+const selected = args.only ? cases.filter(c => args.only.split(',').includes(c.id)) : cases;
+const results = [];
+if (!args.only) {
+  for (const c of cases) {
+    const r = spawnSync(process.execPath, [process.argv[1], '--repo', repo, '--only', c.id], { cwd: repo, encoding: 'utf8', maxBuffer: 16 * 1024 * 1024, env: process.env });
+    try {
+      const child = JSON.parse(r.stdout);
+      results.push(child.results[0]);
+    } catch {
+      results.push({ observation_id: c.id, status: 'INFRA_ERROR', message: (r.error || r.stderr || r.stdout || 'child process failed').toString().slice(0, 4000) });
+    }
+  }
+} else {
+  for (const c of selected) {
+    activeId = c.id;
+    try {
+      const evidence = await c.run();
+      results.push({ observation_id: c.id, status: 'PASS', evidence });
+    } catch (e) {
+      const message = e && e.stack ? e.stack : (e && e.message) || String(e);
+      const infra = /Cannot find module|ERR_MODULE_NOT_FOUND|built library not found|jest binary not found|ENOENT/.test(message);
+      results.push({ observation_id: c.id, status: infra ? 'INFRA_ERROR' : 'FAIL', message: message.slice(0, 4000) });
+    }
+  }
+}
+const report = { repo, zod_version: readZodVersion(), results };
+const json = JSON.stringify(report, null, 2);
+if (args.report) fs.writeFileSync(args.report, json);
+console.log(json);
diff --git a/tests/target/batches/BATCH-P2P-0001/run-p2p.mjs b/tests/target/batches/BATCH-P2P-0001/run-p2p.mjs
new file mode 100644
--- /dev/null
+++ b/tests/target/batches/BATCH-P2P-0001/run-p2p.mjs
@@ -0,0 +1,90 @@
+import { createRequire } from 'node:module';
+import { execFileSync } from 'node:child_process';
+import fs from 'node:fs';
+import crypto from 'node:crypto';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const SIDE = 'target';
+const BATCH_ID = 'BATCH-P2P-0001';
+const require = createRequire(import.meta.url);
+const scriptDir = path.dirname(fileURLToPath(import.meta.url));
+const assetsRoot = process.env.ASSETS_ROOT
+  ? path.resolve(process.env.ASSETS_ROOT)
+  : path.resolve(scriptDir, '../../..');
+const repoRoot = process.env.REPO_ROOT
+  ? path.resolve(process.env.REPO_ROOT)
+  : path.resolve(process.env.MIGRATION_REPO_ROOT ?? '/workspace/repo');
+const reportArg = process.argv[2];
+const reportPath = process.env.REPORT_PATH
+  ? path.resolve(process.env.REPORT_PATH)
+  : reportArg && reportArg.endsWith('.json')
+    ? path.resolve(reportArg)
+    : '/logs/result.json';
+
+const distEntry = path.join(repoRoot, 'dist/index.cjs');
+if (!fs.existsSync(distEntry)) {
+  execFileSync('npm', ['run', 'build'], { cwd: repoRoot, stdio: 'inherit' });
+}
+
+const lib = require(distEntry);
+const z = require(path.join(repoRoot, 'node_modules/zod'));
+const casesPath = path.join(
+  assetsRoot,
+  'shared',
+  'batches',
+  BATCH_ID,
+  'p2p-cases.mjs'
+);
+const expectedPath = path.join(
+  assetsRoot,
+  'fixtures',
+  'batches',
+  BATCH_ID,
+  'expected-projections.json'
+);
+const { runCases } = await import(pathToFileURL(casesPath).href);
+const result = await runCases({ lib, z, repoRoot, fs, crypto });
+
+const expected = fs.existsSync(expectedPath)
+  ? JSON.parse(fs.readFileSync(expectedPath, 'utf8'))
+  : null;
+const observations = Object.fromEntries(
+  Object.entries(result.observations).map(([id, entry]) => {
+    const expectedEntry = expected?.observations?.[id];
+    return [
+      id,
+      {
+        ...entry,
+        matches_expected:
+          !expectedEntry ||
+          JSON.stringify(entry.value) === JSON.stringify(expectedEntry.value),
+      },
+    ];
+  })
+);
+const values = Object.values(observations);
+const summary = {
+  total: values.length,
+  passed: values.filter(entry => entry.status === 'PASS').length,
+  failed: values.filter(entry => entry.status !== 'PASS').length,
+  mismatched:
+    expected === null
+      ? 0
+      : values.filter(entry => entry.matches_expected === false).length,
+};
+const report = {
+  schema_version: 'migration-p2p-report:v1',
+  batch_id: BATCH_ID,
+  side: SIDE,
+  repo_root: repoRoot,
+  observations,
+  summary,
+};
+
+fs.mkdirSync(path.dirname(reportPath), { recursive: true });
+fs.writeFileSync(reportPath, `${JSON.stringify(report, null, 2)}\n`);
+process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+if (summary.failed > 0 || summary.mismatched > 0) {
+  process.exitCode = 1;
+}
