+      assert.equal(typeof lib[name].prototype.generateComponents, 'function');
+    }
+    return {
+      exports: Object.keys(lib).sort(),
+      registryMethods,
+      generators: ['OpenApiGeneratorV3', 'OpenApiGeneratorV31', 'OpenApiGeneratorV32'],
