+    failedSuites: report.numFailedTestSuites,
+    tests: report.numTotalTests,
+    passedTests: report.numPassedTests,
+    failedTests: report.numFailedTests,
+    skippedTests: report.numPendingTests,
+    success: report.success
+  };
