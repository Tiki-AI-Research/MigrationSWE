+      documentFor(lib, [{ type: 'parameter', schema: z.string() }])
+    );
+    const missingLocation = captureError(() =>
+      documentFor(lib, [
+        {
+          type: 'parameter',
+          schema: z.string().openapi({ param: { name: 'test' } }),
+        },
+      ])
+    );
+    const conflict = captureError(() =>
+      documentFor(lib, [
+        {
+          type: 'route',
+          route: route({
+            request: {
+              query: z.object({
+                test: z.string().openapi({ param: { name: 'other' } }),
+              }),
+            },
+          }),
+        },
