+import { createSchemas, expectSchema } from '../lib/helpers';
 
 describe('discriminated union', () => {
+  it.each(['3.0.0', '3.1.0', '3.2.0'] as const)(
+    'preserves valid mapping order when a reverse name is a later string value (%s)',
+    version => {
+      const Numeric = z
+        .object({ kind: z.enum({ 0: 'Zero', 1: 'One', Zero: 0, One: 1 }) })
+        .openapi('NumericKind');
+      const Text = z
+        .object({ kind: z.enum(['text', 'Zero']) })
+        .openapi('TextKind');
+      const Union = z
+        .discriminatedUnion('kind', [Numeric, Text])
+        .openapi('CollisionDU');
+      const components = createSchemas([Union], { version });
+      const generated = components?.schemas?.['CollisionDU'];
+
+      const expected = {
+        oneOf: [
+          { $ref: '#/components/schemas/NumericKind' },
+          { $ref: '#/components/schemas/TextKind' },
+        ],
+        discriminator: {
+          propertyName: 'kind',
+          mapping: {
+            Zero: '#/components/schemas/TextKind',
+            text: '#/components/schemas/TextKind',
+          },
+        },
+      };
+
+      expect(generated).toEqual(expected);
+      expect(JSON.stringify(generated)).toBe(JSON.stringify(expected));
+    }
+  );
+
+  it.each(['3.0.0', '3.1.0', '3.2.0'] as const)(
+    'retains actual string enum values that also name numeric members (%s)',
+    version => {
+      enum MixedKind {
+        Zero,
+        One,
+        First = 'One',
+        Second = 'Zero',
+      }
+
+      const Mixed = z
+        .object({ kind: z.enum(MixedKind).openapi({ type: 'string' }) })
+        .openapi('MixedKind');
+      const Union = z.discriminatedUnion('kind', [Mixed]).openapi('MixedDU');
+      const components = createSchemas([Union], { version });
+      const generated = components?.schemas?.['MixedDU'];
+      const expected = {
+        oneOf: [{ $ref: '#/components/schemas/MixedKind' }],
+        discriminator: {
+          propertyName: 'kind',
+          mapping: {
+            Zero: '#/components/schemas/MixedKind',
+            One: '#/components/schemas/MixedKind',
+          },
+        },
+      };
+
+      expect(Mixed.safeParse({ kind: 'One' }).success).toBe(true);
+      expect(Mixed.safeParse({ kind: 'Zero' }).success).toBe(true);
+      expect(generated).toEqual(expected);
+      expect(JSON.stringify(generated)).toBe(JSON.stringify(expected));
+    }
+  );
+
+  it.each(['3.0.0', '3.1.0', '3.2.0'] as const)(
+    'omits numeric enum reverse names from discriminator mappings (%s)',
+    version => {
+      enum NumericKind {
+        Zero,
+        One,
+      }
+
+      const Numeric = z
+        .object({ kind: z.nativeEnum(NumericKind) })
+        .openapi('NumericKind');
+      const Text = z.object({ kind: z.literal('text') }).openapi('TextKind');
+      const Union = z
+        .discriminatedUnion('kind', [Numeric, Text])
+        .openapi('NumericKindDU');
+      const NumericOnly = z
+        .discriminatedUnion('kind', [Numeric])
+        .openapi('NumericOnlyDU');
+
+      expect(Numeric.safeParse({ kind: 'Zero' }).success).toBe(false);
+      expect(Numeric.safeParse({ kind: 0 }).success).toBe(true);
+
+      const components = createSchemas([Numeric, Text, Union, NumericOnly], {
+        version,
+      });
+      expect(components?.schemas?.['NumericKindDU']).toEqual({
+        oneOf: [
+          { $ref: '#/components/schemas/NumericKind' },
+          { $ref: '#/components/schemas/TextKind' },
+        ],
+        discriminator: {
+          propertyName: 'kind',
+          mapping: { text: '#/components/schemas/TextKind' },
+        },
+      });
+      expect(components?.schemas?.['NumericOnlyDU']).toEqual({
+        oneOf: [{ $ref: '#/components/schemas/NumericKind' }],
+        discriminator: { propertyName: 'kind', mapping: {} },
+      });
+      expect(components?.schemas?.['NumericKind']).toEqual({
+        type: 'object',
+        properties: { kind: { type: 'integer', enum: [0, 1] } },
+        required: ['kind'],
+      });
+    }
+  );
+
