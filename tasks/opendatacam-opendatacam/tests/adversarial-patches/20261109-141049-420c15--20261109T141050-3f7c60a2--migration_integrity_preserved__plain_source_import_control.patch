+function toCsv(data, includeHeaders) {
+  const headerRow = [];
+  // eslint-disable-next-line no-restricted-syntax
+  for (const prop in data[0]) {
+    if (Object.prototype.hasOwnProperty.call(data[0], prop)) {
+      headerRow.push(prop);
+    }
+  }
+
+  let body = '';
+  if (includeHeaders) {
+    body += `${headerRow.join(',')}\r\n`;
+  }
+
+  for (let i = 0; i < data.length; i += 1) {
+    const row = headerRow.map((key) => (
+      Object.prototype.hasOwnProperty.call(data[i], key) ? data[i][key] : null
+    ));
+    body += `${row.map(escapeCsvField).join(',')}\r\n`;
+  }
+
+  return body;
