@@ -0,0 +1,56 @@
+'use strict';
+
+// Source-side probe for BATCH-F2P-0002.
+//
+//   node source-probe.js [sourceRoot] [reportPath]
+//
+// The pre-migration Express source tree must FAIL every target Fastify
+// postcondition. This probe is executed against the real /input/source tree.
+
+const path = require('path');
+const fs = require('fs');
+const { evaluateStatic } = require('../../../shared/batches/BATCH-F2P-0002/predicates');
+const contracts = require('../../../shared/batches/BATCH-F2P-0002/contracts.json');
+
+async function main() {
+  const root = process.argv[2] || '/input/source';
+  const reportPath = process.argv[3] || null;
+
+  const evaluated = evaluateStatic(root);
+
+  // P_CHANGE_SCOPE describes the migration diff; the un-migrated source tree
+  // cannot satisfy it.
+  evaluated.P_CHANGE_SCOPE = {
+    satisfied: false,
+    evidence: ['source tree is the pre-migration baseline; no target to diff'],
+  };
+
+  const observations = contracts.observations.map((obs) => {
+    const r = evaluated[obs.predicate_id] || { satisfied: false, evidence: ['unknown predicate'] };
+    return {
+      observation_id: obs.id,
+      requirement_ids: obs.requirement_ids,
+      predicate_id: obs.predicate_id,
+      status: r.satisfied ? 'PASS' : 'FAIL',
+      evidence: r.evidence,
+    };
+  });
+
+  const report = {
+    batch_id: contracts.batch_id,
+    side: 'source',
+    root,
+    source_technology: contracts.migration.source,
+    target_technology: contracts.migration.target,
+    observations,
+  };
+
+  const serialized = `${JSON.stringify(report, null, 2)}\n`;
+  if (reportPath) fs.writeFileSync(reportPath, serialized);
+  process.stdout.write(serialized);
+}
+
+main().catch((err) => {
+  process.stderr.write(`source-probe error: ${err.stack}\n`);
+  process.exit(1);
+});
