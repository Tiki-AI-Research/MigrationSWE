+// Source-side (Express 4.17.1) differential probe for BATCH-DIFFERENTIAL-0002.
+//
+// Executed against the read-only source checkout at /input/source. It runs the
+// shared case corpus through the Express server and projects each observation
+// with the shared normalization so the same projection can be compared with the
+// Fastify target projection.
+
+const path = require('path');
+const projections = require('../../../shared/batches/BATCH-DIFFERENTIAL-0002/projections');
+
+const DEFAULT_REPO = '/input/source';
+
