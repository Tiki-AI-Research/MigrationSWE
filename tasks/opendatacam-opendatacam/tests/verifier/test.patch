diff --git a/tests/source/skeleton/source-probe.js b/tests/source/skeleton/source-probe.js
new file mode 100644
--- /dev/null
+++ b/tests/source/skeleton/source-probe.js
@@ -0,0 +1,33 @@
+'use strict';
+
+// Source-side probe skeleton (Express 4.17.1 semantics).
+//
+// INTEGRATION owns `source/runner`; this scaffold only fixes the shared probe
+// shape so INTEGRATION and the F2P/DIFF batches agree on an interface. All
+// assertions are intentionally unimplemented in the SKELETON batch.
+
+const contracts = require('../../shared/skeleton/contracts.json');
+const { jsonRequest } = require('../../shared/skeleton/harness');
+
+async function probe(port) {
+  const reachableRoutes = [];
+  for (const route of contracts.routes) {
+    if (route.method !== 'GET' || route.path.includes(':')) continue;
+    try {
+      const res = await jsonRequest(port, 'GET', route.path);
+      reachableRoutes.push({ route: `GET ${route.path}`, statusCode: res.statusCode });
+    } catch (err) {
+      reachableRoutes.push({ route: `GET ${route.path}`, error: err.message });
+    }
+  }
+
+  return {
+    side: 'source',
+    port,
+    contracts: contracts.contracts || contracts,
+    reachableRoutes,
+    observations: [],
+  };
+}
+
+module.exports = { probe };
