+'use strict';
+
+// Source-side DIFFERENTIAL probe (Express 4.17.1 semantics).
+//
+// Executed against the read-only source tree mounted at /input/source. The
+// probe inspects the Express server entry point and its dependency manifest and
+// emits a normalized fingerprint that the target probe must match. INTEGRATION
+// owns `source/runner`; this file is a batch-scoped probe and never a runner.
+
+const path = require('path');
+const {
+  inspectModuleGraph,
+  FORBIDDEN_SOURCE_IMPORTS,
+  REQUIRED_TARGET_IMPORTS,
+} = require('../../../shared/batches/BATCH-DIFFERENTIAL-0001/diff-harness');
+
+const DEFAULT_ROOT = '/input/source';
+
+function probe(root) {
+  const sourceRoot = root || DEFAULT_ROOT;
+  const graph = inspectModuleGraph(sourceRoot, 'server.js');
+  return {
+    side: 'source',
+    root: sourceRoot,
+    entry: path.join(sourceRoot, 'server.js'),
+    // Express is expected to own every migrated concern on the source side.
+    expressOwnsConcerns: FORBIDDEN_SOURCE_IMPORTS.filter((name) => graph.requires.includes(name)),
+    fastifyPresent: REQUIRED_TARGET_IMPORTS.filter((name) => graph.requires.includes(name)),
+    forbiddenDependencies: graph.forbiddenDependencies,
+    requires: graph.requires,
+  };
+}
+
+module.exports = { probe };
+
+if (require.main === module) {
+  const output = probe(process.argv[2]);
+  process.stdout.write(`${JSON.stringify(output, null, 2)}\n`);
+}
