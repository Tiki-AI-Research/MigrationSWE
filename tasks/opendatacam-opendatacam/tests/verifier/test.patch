--- /dev/null
+++ b/tests/shared/batches/BATCH-F2P-0002/harness.js
@@ -0,0 +1,423 @@
+'use strict';
+
+// Shared probe harness for BATCH-F2P-0002 (Express 4.17.1 -> Fastify 4.28.1).
+//
+// Node-core only. The harness exposes:
+//   * HTTP request helpers used by the dynamic Fastify probes,
+//   * a very small static scanner over `server.js`,
+//   * a repository-scope differ used for the dependency/change-scope rules,
+//   * a dependency-stubbed server boot used by the target-side probe.
+//
+// The target probe MUST boot the real /input/target `server.js` through
+// `bootServer` (only `next`, the Mongo manager and the filesystem manager are
+// stubbed) before it may report PASS for a target postcondition.
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const http = require('http');
+const Module = require('module');
+
+const SERVER_MODULE = 'server.js';
+const ALLOWED_CHANGED = ['server.js', 'package.json', 'package-lock.json'];
+
+function readText(file) {
+  return fs.readFileSync(file, 'utf8');
+}
+
+function readJson(file) {
+  return JSON.parse(readText(file));
+}
+
+function httpRequest(options) {
+  const opts = Object.assign({ host: '127.0.0.1' }, options);
+  return new Promise((resolve, reject) => {
+    const req = http.request(opts, (res) => {
+      const chunks = [];
+      res.on('data', (c) => chunks.push(c));
+      res.on('end', () => resolve({
+        statusCode: res.statusCode,
+        headers: res.headers,
+        body: Buffer.concat(chunks),
+        text: Buffer.concat(chunks).toString('utf8'),
+      }));
+    });
+    req.on('error', reject);
+    if (opts.body) req.write(opts.body);
+    req.end();
+  });
+}
+
+function jsonRequest(port, method, routePath, payload) {
+  const body = payload === undefined ? null : Buffer.from(JSON.stringify(payload));
+  return httpRequest({
+    port,
+    method,
+    path: routePath,
+    headers: body
+      ? { 'Content-Type': 'application/json', 'Content-Length': body.length }
+      : {},
+    body,
+  });
+}
+
+function jsonRequestRaw(port, method, routePath, raw) {
+  const body = Buffer.from(raw);
+  return httpRequest({
+    port,
+    method,
+    path: routePath,
+    headers: { 'Content-Type': 'application/json', 'Content-Length': body.length },
+    body,
+  });
+}
+
+function multipartBody(field, filename, content, contentType) {
+  const boundary = `----f2p${Date.now()}${Math.floor(Math.random() * 1e6)}`;
+  const head = Buffer.from(
+    `--${boundary}\r\n`
+    + `Content-Disposition: form-data; name="${field}"; filename="${filename}"\r\n`
+    + `Content-Type: ${contentType || 'application/octet-stream'}\r\n\r\n`,
+  );
+  const tail = Buffer.from(`\r\n--${boundary}--\r\n`);
+  return {
+    boundary,
+    body: Buffer.concat([head, Buffer.from(content), tail]),
+  };
+}
+
+function collectSse(port, routePath, options) {
+  const opts = options || {};
+  const maxEvents = opts.maxEvents || 1;
+  const timeoutMs = opts.timeoutMs || 5000;
+  return new Promise((resolve, reject) => {
+    const events = [];
+    const req = http.request({ host: '127.0.0.1', port, method: 'GET', path: routePath }, (res) => {
+      let buffer = '';
+      res.setEncoding('utf8');
+      res.on('data', (chunk) => {
+        buffer += chunk;
+        let index = buffer.indexOf('\n\n');
+        while (index !== -1) {
+          events.push(buffer.slice(0, index));
+          buffer = buffer.slice(index + 2);
+          if (events.length >= maxEvents) {
+            req.destroy();
+            resolve({ statusCode: res.statusCode, headers: res.headers, events });
+            return;
+          }
+          index = buffer.indexOf('\n\n');
+        }
+      });
+      res.on('end', () => resolve({ statusCode: res.statusCode, headers: res.headers, events }));
+    });
+    req.on('error', (err) => {
+      if (events.length >= maxEvents) resolve({ events });
+      else reject(err);
+    });
+    req.setTimeout(timeoutMs, () => {
+      req.destroy();
+      resolve({ events, timedOut: true });
+    });
+    req.end();
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Static scanner over server.js
+// ---------------------------------------------------------------------------
+
+const EXPRESS_REQUIRES = [
+  'express', 'serve-static', 'body-parser', 'csv-express', 'server-sent-events', 'multer',
+];
+
+function requirePattern(name) {
+  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  return new RegExp(`require\\(\\s*['"]${escaped}['"]\\s*\\)`);
+}
+
+function analyzeServerJs(root) {
+  const file = path.join(root, SERVER_MODULE);
+  const raw = readText(file);
+  const text = raw
+    .replace(/\/\*[\s\S]*?\*\//g, '')
+    .replace(/\/\/[^\n]*/g, '');
+
+  const routes = {};
+  const routeRe = /fastify\.(get|post|delete|put|patch)\(\s*['"]([^'"]+)['"]/g;
+  let m = routeRe.exec(text);
+  while (m) {
+    routes[`${m[1].toUpperCase()} ${m[2]}`] = m.index;
+    m = routeRe.exec(text);
+  }
+
+  const expressRoutes = {};
+  const expressRe = /express\.(get|post|delete|put|patch|use)\(\s*['"]([^'"]+)['"]/g;
+  m = expressRe.exec(text);
+  while (m) {
+    expressRoutes[`${m[1].toUpperCase()} ${m[2]}`] = m.index;
+    m = expressRe.exec(text);
+  }
+
+  const requires = {};
+  for (const name of EXPRESS_REQUIRES) requires[name] = requirePattern(name).test(text);
+  requires.fastify = requirePattern('fastify').test(text);
+  requires['@fastify/static'] = requirePattern('@fastify/static').test(text);
+  requires['@fastify/multipart'] = requirePattern('@fastify/multipart').test(text);
+
+  return {
+    text,
+    routes,
+    expressRoutes,
+    requires,
+    constructsFastify: /require\(\s*['"]fastify['"]\s*\)\s*\(/.test(text)
+      || /fastify\s*\(/.test(text),
+    registersStatic: /register\(\s*fastifyStatic|register\(\s*staticPlugin/.test(text),
+    registersMultipart: /register\(\s*fastifyMultipart|register\(\s*multipart/.test(text),
+    delegation: /child_process|\.fork\(|\bspawn\(|\bexec\(|require\(\s*['"]vm['"]\s*\)|_load\(/.test(text),
+    fastifyOwns:
+      /require\(\s*['"]fastify['"]\s*\)/.test(text)
+      && Object.keys(routes).length > 0
+      && Object.keys(expressRoutes).length === 0,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Repository scope differ
+// ---------------------------------------------------------------------------
+
+function listFiles(root, prefix, out) {
+  const acc = out || [];
+  const base = prefix ? path.join(root, prefix) : root;
+  for (const entry of fs.readdirSync(base, { withFileTypes: true })) {
+    const rel = prefix ? `${prefix}/${entry.name}` : entry.name;
+    if (entry.name === 'node_modules' || entry.name === '.git' || entry.name === '.build') continue;
+    if (entry.isDirectory()) listFiles(root, rel, acc);
+    else acc.push(rel);
+  }
+  return acc;
+}
+
+function hashFile(file) {
+  const crypto = require('crypto');
+  return crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
+}
+
+function diffScope(sourceRoot, targetRoot) {
+  const sourceFiles = new Set(listFiles(sourceRoot));
+  const targetFiles = new Set(listFiles(targetRoot));
+  const changed = [];
+  const added = [];
+  const removed = [];
+  for (const f of targetFiles) {
+    if (!sourceFiles.has(f)) added.push(f);
+    else if (hashFile(path.join(sourceRoot, f)) !== hashFile(path.join(targetRoot, f))) changed.push(f);
+  }
+  for (const f of sourceFiles) if (!targetFiles.has(f)) removed.push(f);
+  const unexpected = [...changed, ...added, ...removed].filter((f) => !ALLOWED_CHANGED.includes(f));
+  return { changed, added, removed, unexpected };
+}
+
+// ---------------------------------------------------------------------------
+// Dependency-stubbed server boot (target side only)
+// ---------------------------------------------------------------------------
+
+function copyTree(src, dst) {
+  fs.mkdirSync(dst, { recursive: true });
+  for (const entry of fs.readdirSync(src, { withFileTypes: true })) {
+    if (entry.name === 'node_modules' || entry.name === '.git' || entry.name === '.build') continue;
+    const s = path.join(src, entry.name);
+    const d = path.join(dst, entry.name);
+    if (entry.isDirectory()) copyTree(s, d);
+    else fs.copyFileSync(s, d);
+  }
+}
+
+function waitForPort(port, deadlineMs) {
+  const deadline = Date.now() + deadlineMs;
+  return new Promise((resolve, reject) => {
+    const attempt = () => {
+      const socket = require('net').connect({ host: '127.0.0.1', port }, () => {
+        socket.destroy();
+        resolve();
+      });
+      socket.on('error', () => {
+        socket.destroy();
+        if (Date.now() > deadline) reject(new Error(`port ${port} not open`));
+        else setTimeout(attempt, 100);
+      });
+    };
+    attempt();
+  });
+}
+
+async function bootServer(root, options) {
+  const opts = options || {};
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'f2p-boot-'));
+  const work = path.join(tmp, 'repo');
+  copyTree(root, work);
+
+  const modules = opts.nodeModules || path.join(root, 'node_modules');
+  if (fs.existsSync(modules)) {
+    fs.symlinkSync(modules, path.join(work, 'node_modules'));
+  } else {
+    throw new Error(`node_modules not found at ${modules}`);
+  }
+
+  const configPath = path.join(work, 'config.json');
+  const config = readJson(configPath);
+  config.VIDEO_INPUT = 'simulation';
+  config.NEURAL_NETWORK = 'yolov4';
+  config.DATABASE = 'mongo';
+  config.PATH_TO_YOLO_DARKNET = '.';
+  config.CMD_TO_YOLO_DARKNET = 'node scripts/YoloSimulation.js';
+  config.VIDEO_UPLOAD_FOLDER = path.join(tmp, 'uploads');
+  fs.mkdirSync(config.VIDEO_UPLOAD_FOLDER, { recursive: true });
+  fs.writeFileSync(configPath, JSON.stringify(config, null, 2));
+
+  const apidocRoot = path.join(work, '.build', 'apidoc');
+  fs.mkdirSync(apidocRoot, { recursive: true });
+  fs.writeFileSync(path.join(apidocRoot, 'index.html'), '<!doctype html><html><body>apidoc-index</body></html>');
+
+  const port = opts.port || (18000 + Math.floor(Math.random() * 2000));
+  const nextLog = [];
+  const dbControl = { mode: 'empty', data: {} };
+
+  const fakeNext = () => ({
+    prepare: () => Promise.resolve(),
+    getRequestHandler: () => (req, res) => {
+      nextLog.push({
+        url: req.url,
+        hasGet: typeof req.get === 'function',
+        protocol: req.protocol,
+      });
+      res.statusCode = 200;
+      res.setHeader('Content-Type', 'text/html');
+      res.end('<!doctype html><html><body>next-page</body></html>');
+    },
+  });
+
+  const fakeDb = {
+    connect: () => Promise.resolve(),
+    getRecordings: () => Promise.resolve([]),
+    getRecordingsCount: () => Promise.resolve(0),
+    getTrackerHistoryOfRecording: () => Promise.resolve({}),
+    getRecording: () => Promise.resolve({}),
+    deleteRecording: () => Promise.resolve(),
+    insertRecording: () => Promise.resolve({}),
+    getAppSettings: () => Promise.resolve({}),
+    persistAppSettings: () => Promise.resolve(),
+    updateRecordingWithNewframe: () => Promise.resolve(),
+    getCounterHistoryOfRecording: () => {
+      if (dbControl.mode === 'reject') return Promise.reject(new Error('db down'));
+      return Promise.resolve(dbControl.data);
+    },
+  };
+
+  const fakeFs = {
+    getFilesDirectoryPath: () => config.VIDEO_UPLOAD_FOLDER,
+    getFiles: () => Promise.resolve([]),
+  };
+
+  const fakeOpendatacam = {
+    recordingStatus: { filename: '' },
+    setConfig() {},
+    setTracker() {},
+    setDatabase() {},
+    listenToYOLO() {},
+    registerCountingAreas() {},
+    getCountingAreas() { return {}; },
+    addStreamClient() {},
+    startRecording() {},
+    requestFileRecording() {},
+    stopRecording() {},
+    sendUpdateToClients() {},
+    setUISettings() {},
+    getUISettings() { return {}; },
+    getStatus() {
+      return {
+        counterSummary: {},
+        trackerSummary: {},
+        videoResolution: null,
+        appState: {},
+      };
+    },
+    isRecording() { return false; },
+    clean() {},
+    reset() {},
+  };
+
+  const { EventEmitter } = require('events');
+  class FakeYolo extends EventEmitter {    constructor(cfg) {
+      super();
+      this.config = cfg;
+      this.videoResolution = { w: 1280, h: 720 };
+      this.started = false;
+    }
+
+    start() { this.started = true; return Promise.resolve(); }
+
+    stop() { this.started = false; return Promise.resolve(); }
+
+    restart() { return Promise.resolve(); }
+
+    isLive() { return true; }
+
+    isRunning() { return this.started; }
+
+    getVideoResolution() { return this.videoResolution; }
+
+    getVideoParams() { return this.config && this.config.videoParams; }
+
+    getStatus() { return 'started'; }
+  }
+
+  const realLoad = Module._load;
+  Module._load = function load(request, parent, isMain) {
+    if (request === 'next') return fakeNext;
+    if (request === './server/Opendatacam') return fakeOpendatacam;
+    if (request === './server/db/MongoDbManager') {
+      return { MongoDbManager: function MongoDbManager() { return fakeDb; } };
+    }
+    if (request === './server/fs/FileSystemManager') return fakeFs;
+    if (request === './server/processes/YoloDarknet') return { YoloDarknet: FakeYolo };
+    return realLoad.call(this, request, parent, isMain);
+  };
+
+  const previousCwd = process.cwd();
+  process.chdir(work);
+  process.env.PORT = String(port);
+  process.env.NODE_ENV = 'production';
+
+  require(path.join(work, SERVER_MODULE));
+  await waitForPort(port, 20000);
+
+  return {
+    port,
+    work,
+    uploadDir: config.VIDEO_UPLOAD_FOLDER,
+    apidocRoot,
+    nextLog,
+    dbControl,
+    restore() {
+      Module._load = realLoad;
+      process.chdir(previousCwd);
+    },
+  };
+}
+
+module.exports = {
+  SERVER_MODULE,
+  ALLOWED_CHANGED,
+  readText,
+  readJson,
+  httpRequest,
+  jsonRequest,
+  jsonRequestRaw,
+  multipartBody,
+  collectSse,
+  analyzeServerJs,
+  listFiles,
+  diffScope,
+  bootServer,
+};
diff --git a/tests/shared/batches/BATCH-F2P-0002/predicates.js b/tests/shared/batches/BATCH-F2P-0002/predicates.js
new file mode 100644
--- /dev/null
+++ b/tests/shared/batches/BATCH-F2P-0002/predicates.js
@@ -0,0 +1,124 @@
+'use strict';
+
+// Static (side-agnostic) predicate evaluators for BATCH-F2P-0002.
+//
+// Every evaluator answers the SAME question the target-side dynamic probe
+// answers: "does this repository satisfy the target Fastify postcondition?".
+// On the pre-migration source tree every predicate is false, on the migrated
+// target tree every predicate is true.
+
+const path = require('path');
+const { analyzeServerJs, readJson } = require('./harness');
+
+function packageDeps(root) {
+  const pkg = readJson(path.join(root, 'package.json'));
+  return Object.assign({}, pkg.dependencies, pkg.devDependencies);
+}
+
+function evaluateStatic(root, options) {
+  const a = analyzeServerJs(root);
+  // The integration runner observes the actual Fastify instance. Prefer that
+  // evidence to route spelling: route() and registration helpers are valid too.
+  if (options && typeof options.fastifyOwnership === 'boolean') {
+    a.fastifyOwns = options.fastifyOwnership;
+  }
+  const deps = packageDeps(root);
+  const text = a.text;
+  const results = {};
+
+  // Behavioural capability anchors: the contract requires the *capability*
+  // (serve /api/doc, handle multipart uploads), not a particular plugin module.
+  const STATIC_SERVE = /(?:createReadStream|sendFile|serveStatic|@fastify\/static|\bstatic\b)/;
+  const MULTIPART_HANDLING = /(?:multipart|\.file\s*\(|busboy|addContentTypeParser)/i;
+  const APIDOC_PATH = /['"]\/api\/doc\/?['"]/;
+
+  const bodyLimit = /bodyLimit\s*:\s*(?:102400|100\s*\*\s*1024)/.test(text);
+  results.P_BODY_LIMIT = {
+    satisfied: bodyLimit,
+    evidence: [`bodyLimit:102400=${bodyLimit}`],
+  };
+
+  results.P_MALFORMED_JSON = {
+    satisfied: /setErrorHandler/.test(text)
+      && /\.type\(\s*['"]text\/plain(?:\s*;\s*charset=[^'"]*)?['"]\s*\)/.test(text)
+      && /400/.test(text),
+    evidence: ['setErrorHandler+text/plain(+charset)+400'],
+  };
+
+  const filesIndex = a.routes['GET /files'];
+  const wildcardIndex = a.routes['GET /*'];
+  results.P_CATCHALL_PRECEDENCE = {
+    satisfied: wildcardIndex !== undefined
+      && filesIndex !== undefined
+      && filesIndex < wildcardIndex
+      && !/express\.get\(\s*['"]\*['"]/.test(text),
+    evidence: [`GET /files@${filesIndex}`, `GET /*@${wildcardIndex}`],
+  };
+
+  results.P_APIDOC = {
+    satisfied: a.fastifyOwns
+      && (a.registersStatic || STATIC_SERVE.test(text))
+      && APIDOC_PATH.test(text),
+    evidence: ['fastifyOwns + static serve (plugin|stream|sendFile) + /api/doc'],
+  };
+
+  results.P_FILES_MULTIPART = {
+    satisfied: a.fastifyOwns
+      && (a.registersMultipart || MULTIPART_HANDLING.test(text))
+      && /[!=]==?\s*['"]video['"]|['"]video['"]\s*[!=]==?/.test(text)
+      && /\\\.\(mp4\|avi\|mov\)\$/.test(text),
+    evidence: ['fastifyOwns + multipart handling (plugin|parser) + video field filter'],
+  };
+
+  results.P_NEXT_HIJACK = {
+    satisfied: wildcardIndex !== undefined
+      && /\.hijack\(\)/.test(text),
+    evidence: ['wildcard /* + hijack'],
+  };
+
+  results.P_FASTIFY_OWNS = {
+    satisfied: a.fastifyOwns,
+    evidence: [`routes=${Object.keys(a.routes).length}`, `expressRoutes=${Object.keys(a.expressRoutes).length}`],
+  };
+
+  const okSends = (text.match(/\.send\(\s*(?:String\(\s*)?['"]OK['"]|\.send\(\s*(?:http\.)?STATUS_CODES\[\s*200\s*\]|sendStatus\w*\(\s*[^)]*,\s*200\s*\)/g) || []).length;
+  results.P_SIDE_EFFECT_BODY = {
+    satisfied: okSends >= 3 && !/sendStatus\(200\)/.test(text),
+    evidence: [`OK-equivalent send count=${okSends}`],
+  };
+
+  results.P_COUNTER_404_500 = {
+    satisfied: /\.send\(\s*(?:String\(\s*)?['"]Not Found['"]|(?:http\.)?STATUS_CODES\[\s*404\s*\]|sendStatus\w*\(\s*[^)]*,\s*404\s*\)/.test(text)
+      && /\.send\(\s*(?:String\(\s*)?['"]Internal Server Error['"]|(?:http\.)?STATUS_CODES\[\s*500\s*\]|sendStatus\w*\(\s*[^)]*,\s*500\s*\)/.test(text),
+    evidence: ["'Not Found'/'Internal Server Error' (literal | STATUS_CODES | sendStatus)"],
+  };
+
+  results.P_PLUGINS_REGISTERED = {
+    satisfied: a.fastifyOwns
+      && Boolean(deps.fastify)
+      && (a.registersStatic || STATIC_SERVE.test(text))
+      && (a.registersMultipart || MULTIPART_HANDLING.test(text)),
+    evidence: [
+      `fastifyOwns=${a.fastifyOwns}`,
+      `dep fastify=${Boolean(deps.fastify)}`,
+      'required capabilities: static serve + multipart handling',
+    ],
+  };
+
+  const expressRequires = Object.keys(a.requires).filter(
+    (k) => ['express', 'serve-static', 'body-parser', 'csv-express', 'server-sent-events', 'multer'].includes(k) && a.requires[k],
+  );
+  results.P_NO_EXPRESS_IMPORT = {
+    satisfied: expressRequires.length === 0 && a.requires.fastify,
+    evidence: [`expressRequires=${JSON.stringify(expressRequires)}`],
+  };
+
+  results.P_NO_DELEGATION = {
+    satisfied: a.fastifyOwns && !a.delegation,
+    evidence: [`fastifyOwns=${a.fastifyOwns}`, `delegation=${a.delegation}`],
+  };
+
+  return results;
+}
+
+module.exports = { evaluateStatic, packageDeps };
diff --git a/tests/shared/batches/BATCH-F2P-0003/probe-lib.js b/tests/shared/batches/BATCH-F2P-0003/probe-lib.js
new file mode 100644
--- /dev/null
+++ b/tests/shared/batches/BATCH-F2P-0003/probe-lib.js
@@ -0,0 +1,262 @@
+'use strict';
+
+// BATCH-F2P-0003 shared probe predicates.
+//
+// One predicate per F2P observation. The SAME predicate function is executed
+// against the source repository and against the reference target so the
+// PASS/FAIL outcome is produced by inspection, never by side/role.
+//
+// Every predicate here asserts that the frozen target technology
+// (fastify 4.28.1 + @fastify/static 7.0.4 + @fastify/multipart 8.3.0) owns the
+// behaviour, and that the legacy Express stack does not execute it.
+
+const fs = require('fs');
+const path = require('path');
+
+const TARGET_DEPS = {
+  fastify: '4.28.1',
+  '@fastify/static': '7.0.4',
+  '@fastify/multipart': '8.3.0',
+};
+
+const LEGACY_DEPS = [
+  'express',
+  'body-parser',
+  'serve-static',
+  'csv-express',
+  'server-sent-events',
+  'multer',
+];
+
+const LEGACY_REQUIRES = [
+  "require('express')",
+  "require('body-parser')",
+  "require('serve-static')",
+  "require('csv-express')",
+  "require('server-sent-events')",
+  "require('multer')",
+];
+
+function readText(root, rel) {
+  try {
+    return fs.readFileSync(path.join(root, rel), 'utf8');
+  } catch (err) {
+    return null;
+  }
+}
+
+function readJson(root, rel) {
+  const text = readText(root, rel);
+  if (text === null) return null;
+  try {
+    return JSON.parse(text);
+  } catch (err) {
+    return null;
+  }
+}
+
+function has(text, needle) {
+  return typeof text === 'string' && text.includes(needle);
+}
+
+function all(text, needles) {
+  return needles.every((needle) => has(text, needle));
+}
+
+function none(text, needles) {
+  return needles.every((needle) => !has(text, needle));
+}
+
+// --- dependency projection predicates -------------------------------------
+
+function lockfileResolvesTarget(root) {
+  const lock = readJson(root, 'package-lock.json');
+  if (!lock) return false;
+  const packages = lock.packages || {};
+  const entries = [];
+  Object.keys(packages).forEach((key) => {
+    if (/^node_modules\//.test(key)) entries.push({ key, data: packages[key] });
+  });
+  const resolved = (name, version) => entries.some(
+    (entry) => entry.key === `node_modules/${name}` && entry.data.version === version,
+  );
+  const targetPresent = Object.keys(TARGET_DEPS).every(
+    (name) => resolved(name, TARGET_DEPS[name]),
+  );
+  const legacyAbsent = LEGACY_DEPS.every(
+    (name) => !entries.some((entry) => entry.key === `node_modules/${name}`),
+  );
+  return targetPresent && legacyAbsent;
+}
+
+function manifestDeclaresTarget(root) {
+  const pkg = readJson(root, 'package.json');
+  if (!pkg) return false;
+  const deps = Object.assign({}, pkg.dependencies, pkg.devDependencies);
+  const targetPresent = Object.keys(TARGET_DEPS).every(
+    (name) => deps[name] === TARGET_DEPS[name],
+  );
+  const legacyAbsent = LEGACY_DEPS.every((name) => deps[name] === undefined);
+  return targetPresent && legacyAbsent;
+}
+
+// --- server.js structural predicates --------------------------------------
+
+function moduleGraphUsesTarget(root) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  const targetLoaded = all(server, [
+    "require('fastify')",
+    "require('@fastify/static')",
+    "require('@fastify/multipart')",
+  ]);
+  const legacyAbsent = none(server, LEGACY_REQUIRES.concat([
+    'http.createServer(express)',
+    'express.use(bodyParser.json())',
+    'serveStatic(',
+  ]));
+  return targetLoaded && legacyAbsent;
+}
+
+function listenBindsAllInterfaces(root) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  return has(server, 'fastify.listen(') && has(server, "host: '0.0.0.0'");
+}
+
+function staticApidocOwnedByTarget(root) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  return all(server, [
+    'fastifyStatic',
+    "prefix: '/api/doc/'",
+    "fastify.get('/api/doc'",
+    "reply.sendFile('index.html')",
+  ]) && none(server, ["serveStatic('.build/apidoc')"]);
+}
+
+function jsonBodyParserOwnedByTarget(root) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  return all(server, [
+    'bodyLimit: 102400',
+    'addContentTypeParser',
+    "'application/json'",
+    'setErrorHandler',
+  ]);
+}
+
+function csvSerializationOwnedByTarget(root) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  return all(server, ["'text/csv; charset=utf-8'", 'toCsv('])
+    && none(server, ["require('csv-express')"]);
+}
+
+function sseContractOwnedByTarget(root) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  return all(server, [
+    "'text/event-stream'",
+    'res.sse = function',
+    'retry: 2000',
+    'reply.hijack()',
+  ]) && none(server, ["require('server-sent-events')"]);
+}
+
+function multipartOwnedByTarget(root) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  return all(server, [
+    "await fastify.register(fastifyMultipart",
+    'request.file()',
+    'data.fieldname === \'video\'',
+  ]) && none(server, ["require('multer')"]);
+}
+
+function catchAllOwnedByTarget(root) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  return all(server, [
+    "fastify.get('/*'",
+    'reply.hijack()',
+    'toNextRequest(',
+    "raw.get = function get(header)",
+    'raw.protocol',
+  ]);
+}
+
+function routeBehaviorOwnedByTarget(root, routePath) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  return has(server, `fastify.get('${routePath}'`)
+    || has(server, `fastify.post('${routePath}'`);
+}
+
+function sideEffectsOwnedByTarget(root) {
+  const server = readText(root, 'server.js');
+  if (!server) return false;
+  return all(server, [
+    "fastify.get('/'",
+    "fastify.get('/start'",
+    "fastify.get('/recording/start'",
+    "fastify.get('/recording/stop'",
+    "fastify.post('/counter/areas'",
+    "fastify.post('/ui'",
+    'YOLO.start()',
+    'Opendatacam.listenToYOLO',
+  ]);
+}
+
+// --- observation -> predicate map -----------------------------------------
+
+const PREDICATES = {
+  'F2P-060': lockfileResolvesTarget,
+  'F2P-066': manifestDeclaresTarget,
+  'F2P-069': moduleGraphUsesTarget,
+  'F2P-056': (root) => routeBehaviorOwnedByTarget(root, '/console'),
+  'F2P-057': sideEffectsOwnedByTarget,
+  'F2P-061': listenBindsAllInterfaces,
+  'F2P-062': staticApidocOwnedByTarget,
+  'F2P-063': jsonBodyParserOwnedByTarget,
+  'F2P-064': staticApidocOwnedByTarget,
+  'F2P-065': csvSerializationOwnedByTarget,
+  'F2P-067': staticApidocOwnedByTarget,
+  'F2P-068': sseContractOwnedByTarget,
+  'F2P-070': staticApidocOwnedByTarget,
+  'F2P-071': staticApidocOwnedByTarget,
+  'F2P-072': staticApidocOwnedByTarget,
+  'F2P-049': moduleGraphUsesTarget,
+  'F2P-050': (root) => routeBehaviorOwnedByTarget(root, '/status'),
+  'F2P-051': jsonBodyParserOwnedByTarget,
+  'F2P-052': multipartOwnedByTarget,
+  'F2P-053': listenBindsAllInterfaces,
+  'F2P-054': listenBindsAllInterfaces,
+  'F2P-055': moduleGraphUsesTarget,
+  'F2P-058': moduleGraphUsesTarget,
+  'F2P-059': catchAllOwnedByTarget,
+};
+
+function evaluateAll(root) {
+  const results = {};
+  Object.keys(PREDICATES).forEach((observationId) => {
+    let status;
+    try {
+      status = PREDICATES[observationId](root) ? 'PASS' : 'FAIL';
+    } catch (err) {
+      status = 'INCONCLUSIVE';
+    }
+    results[observationId] = status;
+  });
+  return results;
+}
+
+module.exports = {
+  TARGET_DEPS,
+  LEGACY_DEPS,
+  LEGACY_REQUIRES,
+  readText,
+  readJson,
+  evaluateAll,
+  PREDICATES,
+};
