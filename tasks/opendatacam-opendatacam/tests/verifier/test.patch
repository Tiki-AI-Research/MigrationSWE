+      "surface": "Static documentation serving under /api/doc",
+      "entry": "GET /api/doc, GET /api/doc/index.html",
+      "kind": "hybrid"
+    },
+    {
+      "id": "P_FILES_MULTIPART",
+      "requirement_ids": ["S005"],
+      "surface": "Multipart upload handling",
