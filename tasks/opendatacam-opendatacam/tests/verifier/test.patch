+      "entry": "GET /start, GET /recording/start, GET /recording/stop, POST /counter/areas, POST /ui",
+      "kind": "dynamic"
+    },
+    {
+      "id": "P_COUNTER_404_500",
+      "requirement_ids": ["S014"],
+      "surface": "404/500 responses of GET /recording/:id/counter",
+      "entry": "GET /recording/:id/counter",
+      "kind": "dynamic"
+    },
+    {
+      "id": "P_PLUGINS_REGISTERED",
+      "requirement_ids": ["S011"],
+      "surface": "Fastify plugin dependencies declared and registered",
+      "entry": "server.js, package.json",
+      "kind": "static"
+    },
+    {
