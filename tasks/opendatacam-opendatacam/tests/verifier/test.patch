diff --git a/tests/source/batches/BATCH-F2P-0001/source-probe.js b/tests/source/batches/BATCH-F2P-0001/source-probe.js
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0001/source-probe.js
@@ -0,0 +1,46 @@
+'use strict';
+
+// Source-side probe for BATCH-F2P-0001 (Express 4.17.1 tree).
+//
+// F2P is a target-only postcondition. The same predicate module used by the
+// target probe is evaluated here; on the source technology every observation
+// MUST resolve to FAIL (the source does not build the migrated concerns from
+// the target stack). A PASS here means the observation is not discriminating.
+//
+// Usage: node source-probe.js [root]        (default /input/source)
+
+const path = require('path');
+const { evaluate, OBSERVATIONS } = require('../../../shared/batches/BATCH-F2P-0001/predicates');
+
+const root = process.argv[2] || '/input/source';
+
+const report = {
+  side: 'source',
+  batch_id: 'BATCH-F2P-0001',
+  technology: 'Express 4.17.1',
+  root,
+  expectation: 'FAIL',
+  observations: [],
+};
+
+let violations = 0;
+const results = evaluate(root);
+for (const obs of OBSERVATIONS) {
+  const entry = results[obs.id];
+  const expected = entry.status === 'FAIL';
+  if (!expected) violations += 1;
+  report.observations.push({
+    id: obs.id,
+    status: entry.status,
+    expectation_met: expected,
+    requirement_ids: obs.requirement_ids,
+  });
+}
+report.summary = {
+  total: OBSERVATIONS.length,
+  failed: report.observations.filter((o) => o.status === 'FAIL').length,
+  expectation_violations: violations,
+};
+
+process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+process.exit(violations === 0 ? 0 : 1);
diff --git a/tests/source/batches/BATCH-F2P-0002/source-probe.js b/tests/source/batches/BATCH-F2P-0002/source-probe.js
