+def test_click_version_and_public_parameters():
+    assert click.__version__ == "8.1.7"
+    options = {
+        name
+        for parameter in main.get_params(click.Context(main))
+        if isinstance(parameter, click.Option)
+        for name in parameter.opts + parameter.secondary_opts
+    }
+    assert options == {
+        "-h", "--help", "--halp", "--version", "-e", "--entry-point", "-c", "--console-script",
+        "-o", "--output-file", "-p", "--python", "--site-packages", "--build-id", "--compressed",
+        "--uncompressed", "--compile-pyc", "-E", "--extend-pythonpath", "--reproducible", "--no-modify",
+        "--preamble", "--root",
+    }
+    info_options = {
+        name
+        for parameter in info_main.get_params(click.Context(info_main))
+        if isinstance(parameter, click.Option)
+        for name in parameter.opts
+    }
+    assert info_options == {"-h", "--help", "--halp", "-j", "--json"}
