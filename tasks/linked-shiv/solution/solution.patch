+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("failure", ["write", "chmod", "replace", "interrupt"])
+def test_archive_replacement_is_atomic(existing, failure, tmp_path, monkeypatch):
+    source = tmp_path / "packages"
+    source.mkdir()
+    (source / "app.py").write_text("def main():\n    print('old archive')\n")
+    target = tmp_path / "app.pyz"
+
+    def create():
+        environment = Environment("2020-01-01 00:00:00", "test", entry_point="app:main", compile_pyc=False)
+        builder.create_archive([source], target, sys.executable, "_bootstrap:bootstrap", environment)
+
+    if existing:
+        create()
+    original = target.read_bytes() if existing else None
+    (source / "app.py").write_text("def main():\n    print('new archive')\n")
+    real_write = builder.write_to_zipapp
+    real_chmod = Path.chmod
+    real_replace = os.replace
+
+    def fail_write(*args, **kwargs):
+        real_write(*args, **kwargs)
+        if failure == "interrupt":
+            raise KeyboardInterrupt("injected interruption")
+        raise OSError("injected write error")
+
+    def fail_chmod(path, mode):
+        if path.name == f".{target.name}.tmp":
+            raise OSError("injected chmod error")
+        real_chmod(path, mode)
+
+    def fail_replace(*args, **kwargs):
+        raise OSError("injected replacement error")
+
+    with monkeypatch.context() as patched:
+        if failure in ("write", "interrupt"):
+            patched.setattr(builder, "write_to_zipapp", fail_write)
+        elif failure == "chmod":
+            patched.setattr(Path, "chmod", fail_chmod)
+        else:
+            patched.setattr(os, "replace", fail_replace)
+        with pytest.raises(KeyboardInterrupt if failure == "interrupt" else OSError, match="injected"):
+            create()
+    assert target.exists() == existing
+    if existing:
+        assert target.read_bytes() == original
+        process = subprocess.run([sys.executable, str(target)], capture_output=True, text=True,
+                                 env={**os.environ, "SHIV_ROOT": str(tmp_path / "cache")})
+        assert process.returncode == 0
+        assert process.stdout == "old archive\n"
+    assert not target.with_name(f".{target.name}.tmp").exists()
+    create()
+    assert zipfile.is_zipfile(target)
+    assert os.replace is real_replace
