+
+def build(source, target, *args, env=None):
+    return CliRunner().invoke(main, ["--site-packages", str(source), "-o", str(target), *args], env=env)
+
+
+def execute(target, root, *args, **overrides):
+    environ = {key: value for key, value in os.environ.items()
+               if not key.startswith("SHIV_") and key != "PYTHONUNBUFFERED"}
+    environ.update(SHIV_ROOT=str(root), **overrides)
+    return subprocess.run([sys.executable, str(target), *args], env=environ, capture_output=True, text=True)
+
+
+def declare(source, package, name, entry_point):
+    metadata = source / f"{package}.dist-info"
+    metadata.mkdir(exist_ok=True)
+    (metadata / "entry_points.txt").write_text(f"[console_scripts]\n{name} = {entry_point}\n")
