+def test_environment_roundtrip_preserves_optional_values_and_override_precedence(monkeypatch):
+    environment = Environment(
+        "2020-01-01 00:00:00", "test", always_write_cache=True, build_id="explicit-id", compile_pyc=False,
+        entry_point="app:main", extend_pythonpath=True, prepend_pythonpath="", hashes={"app.py": "hash"},
+        no_modify=True, reproducible=True, script=None, preamble="before.py", root="build-root",
+    )
+    restored = Environment.from_json(environment.to_json())
+    assert restored.__dict__ == environment.__dict__
+    monkeypatch.setenv(Environment.ROOT, "environment-root")
+    monkeypatch.setenv(Environment.MODULE, "module:main")
+    monkeypatch.setenv(Environment.ENTRY_POINT, "entry:main")
+    monkeypatch.setenv(Environment.COMPILE_PYC, "true")
+    monkeypatch.setenv(Environment.EXTEND_PYTHONPATH, "false")
+    assert restored.root == "environment-root"
+    assert restored.entry_point == "entry:main"
+    assert restored.compile_pyc is True
+    assert restored.extend_pythonpath is False
+    assert restored.build_id == "explicit-id"
+    assert restored.to_json() == environment.to_json()
+
