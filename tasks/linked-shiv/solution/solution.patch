+@pytest.fixture
+def application(tmp_path):
+    source = tmp_path / "packages with spaces"
+    source.mkdir()
+    (source / "app.py").write_text(
+        "import json, sys\n"
+        "def main():\n    print('hello world')\n"
+        "def other():\n    print('other declaration')\n"
+        "def arguments():\n    print(json.dumps(sys.argv[1:]))\n    return 7\n"
+    )
+    return source
