+def test_help_aliases(command, usage):
+    results = [CliRunner().invoke(command, [alias]) for alias in ("-h", "--help", "--halp")]
+    assert all(result.exit_code == 0 for result in results)
+    assert len({result.output for result in results}) == 1
+    assert f"Usage: {usage}" in results[0].output
+    assert "-h, --help, --halp" in results[0].output
