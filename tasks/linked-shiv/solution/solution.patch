+                 "--preamble", str(tmp_path / "missing.py"), "--unknown", "a-package"]
+    arguments.insert(position, eager_option)
+    result = CliRunner().invoke(main, arguments)
+    assert result.exit_code == 0, result.output
+    assert result.output.startswith("shiv, version " if eager_option == "--version" else "Usage: shiv ")
+    assert target.read_bytes() == b"unchanged"
