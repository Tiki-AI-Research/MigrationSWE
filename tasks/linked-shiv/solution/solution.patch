+def contents(path):
+    return {str(file.relative_to(path)): (file.read_bytes(), stat.S_IMODE(file.stat().st_mode))
+            for file in path.rglob("*") if file.is_file()}
+
+
+def dependency_archive(path):
+    with zipfile.ZipFile(path, "w") as archive:
+        archive.writestr("site-packages/nested/module.py", "value = 'new'\n")
+        archive.writestr("site-packages/second.py", "value = 2\n")
+    return zipfile.ZipFile(path)
+
+
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("failure", ["extract", "compile", "compile-false", "replace", "interrupt"])
+def test_extraction_rolls_back_and_can_retry(existing, failure, tmp_path, monkeypatch):
+    target = tmp_path / "root" / "environment"
+    if existing:
+        (target / "site-packages").mkdir(parents=True)
+        (target / "site-packages" / "old.py").write_text("value = 'old'\n")
+    original = contents(target)
+    with dependency_archive(tmp_path / "app.pyz") as archive:
+        real_extract = archive.extract
+        real_replace = os.replace
+
+        def fail_extract(*args, **kwargs):
+            real_extract(*args, **kwargs)
+            if failure == "interrupt":
+                raise KeyboardInterrupt("injected interruption")
+            raise OSError("injected extraction error")
+
+        def fail_compile(*args, **kwargs):
+            if failure == "compile-false":
+                return False
+            raise ValueError("injected compilation error")
+
+        def fail_replace(source, destination):
+            if Path(source) == target.with_name(target.name + ".tmp"):
+                raise OSError("injected replacement error")
+            return real_replace(source, destination)
+
+        with monkeypatch.context() as patched:
+            if failure in ("extract", "interrupt"):
+                patched.setattr(archive, "extract", fail_extract)
+            elif failure.startswith("compile"):
+                patched.setattr(bootstrap.compileall, "compile_dir", fail_compile)
+            else:
+                patched.setattr(os, "replace", fail_replace)
+            expected = KeyboardInterrupt if failure == "interrupt" else (
+                ValueError if failure == "compile" else RuntimeError if failure == "compile-false" else OSError)
+            with pytest.raises(expected, match="injected|Failed to compile"):
+                bootstrap.extract_site_packages(archive, target, compile_pyc=failure.startswith("compile"), force=True)
+        assert target.exists() == existing
+        assert contents(target) == original
+        assert not target.with_name(target.name + ".tmp").exists()
+        assert not target.with_name(target.name + ".bak").exists()
+        bootstrap.extract_site_packages(archive, target, force=True)
+    assert (target / "site-packages/nested/module.py").read_text() == "value = 'new'\n"
+    assert not (target / "site-packages/old.py").exists()
+
+
+@pytest.mark.parametrize("state", ["temporary", "backup", "backup-and-incomplete-target"])
+def test_interrupted_extraction_recovers_the_previous_result(state, tmp_path):
+    target = tmp_path / "environment"
+    previous = target if state == "temporary" else target.with_name(target.name + ".bak")
+    (previous / "site-packages").mkdir(parents=True)
+    (previous / "site-packages/old.py").write_text("old = True\n")
+    original = contents(previous)
+    temporary = target.with_name(target.name + ".tmp")
+    temporary.mkdir()
+    (temporary / "partial").touch()
+    if state == "backup-and-incomplete-target":
+        target.mkdir()
+        (target / "incomplete").touch()
+    with dependency_archive(tmp_path / "app.pyz") as archive:
+        bootstrap.extract_site_packages(archive, target)
+        assert contents(target) == original
+        assert not temporary.exists()
+        assert not target.with_name(target.name + ".bak").exists()
+        bootstrap.extract_site_packages(archive, target, force=True)
+    assert not (target / "site-packages/old.py").exists()
+    assert (target / "site-packages/nested/module.py").exists()
+
