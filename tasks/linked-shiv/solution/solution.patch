+def test_duplicate_zip_entries_use_the_last_contents_and_mode(tmp_path):
+    target = tmp_path / "environment"
+    with zipfile.ZipFile(tmp_path / "duplicate.pyz", "w") as archive:
+        first = zipfile.ZipInfo("site-packages/nested/source.py")
+        first.external_attr = 0o100444 << 16
+        archive.writestr(first, "first")
+        last = zipfile.ZipInfo(first.filename)
+        last.external_attr = 0o100755 << 16
+        with pytest.warns(UserWarning, match="Duplicate name"):
+            archive.writestr(last, "last")
+    with zipfile.ZipFile(tmp_path / "duplicate.pyz") as archive:
+        bootstrap.extract_site_packages(archive, target)
+    extracted = target / last.filename
+    assert extracted.read_text() == "last"
+    if os.name != "nt":
+        assert stat.S_IMODE(extracted.stat().st_mode) == 0o755
