+import os
+
+import click
+
+from click.parser import OptionParser
+
+
+class InputPath(click.Path):
+    def convert(self, value, param, ctx):
+        try:
+            return super().convert(value, param, ctx)
+        except click.BadParameter as error:
+            if os.path.exists(value):
+                raise click.ClickException(error.format_message()) from error
+            raise
+
+
+class PipParser(OptionParser):
+    def _match_short_opt(self, arg, state):
+        if arg[:2] not in self._short_opt:
+            state.largs.append(arg)
+        else:
+            super()._match_short_opt(arg, state)
+
+
+class Command(click.Command):
+    def parse_args(self, ctx, args):
+        # Existing callers and CliRunner can supply pathlib.Path arguments.
+        args = [os.fsdecode(argument) for argument in args]
+        options = {
+            name: parameter
+            for parameter in self.get_params(ctx)
+            if isinstance(parameter, click.Option)
+            for name in parameter.opts + parameter.secondary_opts
+        }
+        for argument in args:
+            if argument == "--":
+                break
+            option = options.get(argument)
+            if option is not None and option.is_eager and option.is_flag:
+                return super().parse_args(ctx, [argument])
+            if argument.startswith("-") and not argument.startswith("--"):
+                for character in argument[1:]:
+                    short_name = "-" + character
+                    option = options.get(short_name)
+                    if option is None or not option.is_flag:
+                        break
+                    if option.is_eager:
+                        return super().parse_args(ctx, [short_name])
+        return super().parse_args(ctx, args)
+
+
+class PipCommand(Command):
+    def make_parser(self, ctx):
+        parser = PipParser(ctx)
+        for parameter in self.get_params(ctx):
+            parameter.add_to_parser(parser, ctx)
+        return parser
