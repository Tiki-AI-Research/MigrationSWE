+def test_lock_timeout_and_subsequent_acquisition(tmp_path):
+    path = tmp_path / "existing-lock"
+    path.write_text("an existing file is not a held lock")
+    held = FileLock(path).acquire()
+    waiting = FileLock(path, timeout=0.05, poll_interval=0.005)
+    started = time.monotonic()
+    try:
+        with pytest.raises(TimeoutError, match=str(path)):
+            with waiting:
+                pytest.fail("a timed out acquisition must never enter")
+        with pytest.raises(TimeoutError, match=str(path)):
+            held.acquire(timeout=0)
+    finally:
+        held.release()
+    assert time.monotonic() - started >= 0.045
+    assert not waiting.is_locked
+    with pytest.raises(ValueError, match="protected error"):
+        with waiting:
+            raise ValueError("protected error")
+    assert not waiting.is_locked
+    waiting.acquire()
+    assert waiting.is_locked
+    waiting.release()
+    waiting.release()
+    assert path.read_text() == "an existing file is not a held lock"
+
+
+def test_locks_exclude_processes_and_recover_after_timeout(tmp_path):
+    path = tmp_path / "process-lock"
+    program = ("import sys; from shiv.bootstrap.filelock import FileLock; "
+               "lock = FileLock(sys.argv[1], timeout=float(sys.argv[2]), poll_interval=0.005); "
+               "lock.acquire(); print('acquired', flush=True); lock.release()")
+    with FileLock(path):
+        timed_out = subprocess.run([sys.executable, "-c", program, str(path), "0.05"],
+                                   capture_output=True, text=True, timeout=5)
+        assert timed_out.returncode != 0
+        assert timed_out.stdout == ""
+        assert "TimeoutError" in timed_out.stderr
+        assert str(path) in timed_out.stderr
+        waiting = subprocess.Popen([sys.executable, "-c", program, str(path), "5"],
+                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+        time.sleep(0.05)
+        assert waiting.poll() is None
+    stdout, stderr = waiting.communicate(timeout=5)
+    assert waiting.returncode == 0
+    assert stdout == "acquired\n"
+    assert stderr == ""
+
+
+def test_concurrent_builds_produce_one_complete_runnable_result(tmp_path):
+    target = tmp_path / "concurrent.pyz"
+    processes = []
+    for number in range(4):
+        source = tmp_path / f"source-{number}"
+        source.mkdir()
+        (source / "app.py").write_text(f"def main():\n    print('build {number}')\n")
+        processes.append(subprocess.Popen(
+            [sys.executable, "-m", "shiv", "--site-packages", str(source), "-e", "app:main", "-o", str(target)],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+        ))
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=15)
+        assert process.returncode == 0, stdout + stderr
+    with zipfile.ZipFile(target) as archive:
+        assert archive.testzip() is None
+        assert len(archive.namelist()) == len(set(archive.namelist()))
+    process = subprocess.run([sys.executable, str(target)], capture_output=True, text=True,
+                             env={**os.environ, "SHIV_ROOT": str(tmp_path / "root")})
+    assert process.returncode == 0
+    assert process.stdout in {f"build {number}\n" for number in range(4)}
+    assert not target.with_name(f".{target.name}.tmp").exists()
+
