+def _long_path(p: Path) -> Path:
+    if os.name == "nt":
+        resolved = str(p.resolve())
+        resolved = os.path.normpath(resolved)
+        if resolved.startswith("\\\\?\\"):
+            return Path(resolved)
+        if resolved.startswith("\\\\"):
+            return Path("\\\\?\\UNC\\" + resolved[2:])
+        return Path("\\\\?\\" + resolved)
+    return p
+
+
+class ExtractionCleanupError(OSError):
+    """The result is complete, but state this call created could not be removed.
+
+    Reporting success while a temporary tree or backup of this same call remains
+    would present the operation as having no residue, which is what the next
+    invocation would then have to interpret.  The result itself is unaffected:
+    this error only ever describes state that this call created or moved.
+    """
+
+
+def _object_identity(path: Path):
+    """The object this directory entry currently names, or ``None`` if absent.
+
+    ``(st_dev, st_ino, is_dir)`` is stable across a rename, so the object this
+    call created can be recognized again after it was moved aside, and a
+    different directory placed at the same name has a different identity.  A
+    name is not ownership; the object behind it is what this call created.
+
+    Only a genuine "no such entry" becomes ``None``.  A permission or I/O error
+    is raised: the caller must be able to report that it could not verify the
+    state it created instead of assuming that state is gone.
+    """
+    try:
+        info = os.lstat(str(path))
+    except OSError as error:
+        if _is_missing(error):
+            return None
+        raise
+    return _identity_of(info)
+
+
+def _identity_of(info):
+    """One comparable identity from a ``stat`` result.
+
+    On Windows ``st_dev`` carries extra bits above the volume serial number that
+    ``GetFileInformationByHandle`` does not report, so both sides are reduced to
+    the volume serial the two APIs share.  Keeping a single representation is what
+    lets a path-derived identity be compared with a handle-derived one.
+    """
+    device = int(info.st_dev)
+    if os.name == "nt":
+        device &= 0xFFFFFFFF
+    return (device, int(info.st_ino), stat.S_ISDIR(info.st_mode))
+
+
+def _is_missing(error: OSError) -> bool:
+    """True only when the error says the entry does not exist.
+
+    A query that failed for any other reason -- permission denied, an I/O error,
+    an invalid descriptor -- says nothing about whether the object is still
+    there.  Treating those as "absent" would silently drop the residue this call
+    created and report a clean success.
+    """
+    if getattr(error, "winerror", None) in (2, 3):  # ERROR_FILE_NOT_FOUND / PATH_NOT_FOUND
+        return True
+    return error.errno in (errno.ENOENT, errno.ENOTDIR)
+
+
+def _fd_identity(fd):
+    try:
+        info = os.fstat(fd)
+    except OSError as error:
+        if _is_missing(error):
+            return None
+        raise
+    return _identity_of(info)
+
+
+def _entry_identity(parent_fd, name):
+    """The object one entry names, resolved relative to a directory descriptor."""
+    try:
+        info = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
+    except OSError as error:
+        if _is_missing(error):
+            return None
+        raise
+    return _identity_of(info)
+
+
+def _require_identity(label, current, expected) -> bool:
+    """Refuse to continue when the entry no longer names this call's object.
+
+    ``False`` means the entry is gone, which is not a failure: nothing this call
+    created is left there.  A different object raises, because deleting it would
+    destroy state this call did not create.
+    """
+    if current is None:
+        return False
+    if current != expected:
+        raise ExtractionCleanupError(
+            f"{label} no longer names the state this extraction created; "
+            "it was replaced, so it is left in place"
+        )
+    return True
+
+
+def _require_entry(path: Path, identity, label: str) -> None:
+    """The entry must still be the object this call created.
+
+    Unlike :func:`_require_identity`, absence is a failure too: this guards a
+    publish or rollback that is about to *use* the entry, and a missing source
+    cannot produce the result the caller was promised.
+    """
+    current = _object_identity(_long_path(path))
+    if current is None:
+        raise ExtractionCleanupError(
+            f"{label} disappeared before it could be used; nothing from this call was published"
+        )
+    if current != identity:
+        raise ExtractionCleanupError(
+            f"{label} no longer names the state this extraction created; it was replaced, "
+            "so it is not used"
+        )
+
+
+def _move_object(source: Path, identity, destination: Path, label: str) -> None:
+    """Move one verified object, binding the operation to the object.
+
+    The pre-check refuses a name that already holds something else.  Windows can
+    then rename *through the handle*, so the move cannot be redirected at all;
+    elsewhere the post-check performed by the caller is the remaining guard.
+    """
+    _require_entry(source, identity, label)
+    if os.name == "nt":
+        _windows_move_by_handle(source, identity, destination, label)
+    else:
+        os.replace(str(_long_path(source)), str(_long_path(destination)))
+
+
+def _move_aside(path: Path, label: str) -> Path:
+    """Move an object this call must not keep out of the way, without deleting it.
+
+    Used only after a publish or rollback discovered that the entry it acted on
+    is not the object this call created.  The object is left in the same
+    directory under a fresh name so its owner can still find it; nothing is
+    removed.
+    """
+    long = _long_path(path)
+    for _ in range(16):
+        candidate = path.with_name(f".{path.name}.{uuid.uuid4().hex}.foreign")
+        try:
+            os.rename(str(long), str(_long_path(candidate)))
+        except FileExistsError:
+            continue
+        return candidate
+    raise ExtractionCleanupError(
+        f"{label} could not be moved aside; it was left where it is"
+    )
+
+
+def _adopt(source: Path, identity, destination: Path, label: str) -> None:
+    """Move this call's object to ``destination`` and verify what arrived.
+
+    A name checked a moment earlier can still be exchanged before the rename
+    runs, so the identity is checked both before and after the move.  On Windows
+    the move is performed through a handle to the verified object, which binds
+    the operation to the object instead of the name.  On POSIX there is no
+    rename-by-descriptor, so the post-move check is what keeps a foreign object
+    from being adopted silently: it is moved aside, never deleted, and the
+    failure is reported.
+    """
+    _move_object(source, identity, destination, label)
+    adopted = _object_identity(_long_path(destination))
+    if adopted == identity:
+        return
+    detail = ""
+    if adopted is not None:
+        moved = _move_aside(destination, label)
+        detail = f"; the object found there was moved to {moved.name} and left in place"
+    raise ExtractionCleanupError(
+        f"{label} was exchanged with an object this extraction did not create, "
+        f"so it was not adopted{detail}"
+    )
+
+
+def _displace(source: Path, identity, destination: Path, label: str) -> None:
+    """Move the previous result aside, and prove it is still the same object.
+
+    The verification happens after the move as well, so an exchange that landed
+    between the check and the rename cannot make this call treat somebody else's
+    tree as the previous result.  If it did happen, the object is moved aside
+    under a fresh name -- never deleted, never written over -- and the call
+    fails instead of adopting it later.
+    """
+    _move_object(source, identity, destination, label)
+    moved = _object_identity(_long_path(destination))
+    if moved == identity:
+        return
+    detail = ""
+    if moved is not None:
+        other = _move_aside(destination, label)
+        detail = f"; the object found there was moved to {other.name} and left in place"
+    raise ExtractionCleanupError(
+        f"{label} was exchanged with an object this extraction did not create, "
+        f"so it was not treated as the previous result{detail}"
+    )
+
+
+def _private_name(name: str) -> str:
+    return f".{name}.{uuid.uuid4().hex}.cleanup"
+
+
+def _rename_no_replace(parent_fd, source: str, destination: str) -> None:
+    """Rename one entry onto a free name, never replacing an existing entry.
+
+    Both names live in the directory ``parent_fd`` refers to.  ``os.rename``
+    would silently replace whatever occupies the destination, which would turn
+    a restore into a deletion of somebody else's object; this raises
+    ``FileExistsError`` instead and leaves both entries where they are.
+
+    Linux answers this atomically with ``renameat2(RENAME_NOREPLACE)``.  Where
+    that is unavailable the portable fallback links the entry under the
+    destination name first -- ``link`` fails with ``EEXIST`` rather than
+    replacing -- and only then drops the source name.  Directories cannot be
+    hard-linked, so for them the destination is checked before the rename; that
+    check is best effort and is the documented limit of this helper.
+    """
+    if sys.platform.startswith("linux"):
+        try:
+            renameat2 = ctypes.CDLL(None, use_errno=True).renameat2
+        except AttributeError:
+            renameat2 = None
+        if renameat2 is not None:
+            result = renameat2(
+                parent_fd, os.fsencode(source), parent_fd, os.fsencode(destination), 1
+            )
+            if result == 0:
+                return
+            error = ctypes.get_errno()
+            if error == errno.EEXIST:
+                raise FileExistsError(error, os.strerror(error), source, destination)
+            if error not in (errno.ENOSYS, errno.EINVAL, errno.EOPNOTSUPP):
+                raise OSError(error, os.strerror(error), source, destination)
+
+    try:
+        os.link(
+            source, destination, src_dir_fd=parent_fd, dst_dir_fd=parent_fd,
+            follow_symlinks=False,
+        )
+    except FileExistsError:
+        raise
+    except OSError:
+        # A directory (EPERM) or a filesystem without hard links.  Check first,
+        # then rename; a writer that wins the check-to-rename window can still
+        # replace the destination, which is why this is the fallback.
+        if _entry_identity(parent_fd, destination) is not None:
+            raise FileExistsError(errno.EEXIST, os.strerror(errno.EEXIST), source, destination)
+        os.rename(source, destination, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
+    else:
+        os.unlink(source, dir_fd=parent_fd)
+
+
+# --------------------------------------------------------------------------
+# POSIX: every operation is relative to a directory descriptor, and each entry
+# is isolated under a fresh name before it is removed.
+# --------------------------------------------------------------------------
+
+def _unlink_verified(parent_fd, name: str, identity, *, directory: bool) -> None:
+    """Remove one verified entry without letting a swap redirect the removal.
+
+    The entry is moved, by one atomic rename inside the same directory, to a
+    name this call mints for the occasion, then opened.  The descriptor is what
+    the verification is based on: ``fstat`` reports the object that was opened,
+    and it keeps naming that object even if the entry is renamed or replaced.
+
+    POSIX has no conditional unlink: ``unlinkat`` cannot remove the object a
+    descriptor refers to, only the entry a name refers to.  The last step is
+    therefore still performed by name.  That leaves one window this code cannot
+    close for a writer that can modify the same directory -- the window the
+    manual's probe exercises.  What the descriptor does provide is detection:
+    the link count is read before the unlink, and an unchanged count afterwards
+    proves the entry that disappeared was not the verified object.  That is
+    reported instead of being allowed to look like a clean removal.  Absolute
+    protection here would need a conditional unlink primitive the platform does
+    not offer.
+    """
+    private = _private_name(name)
+    try:
+        os.rename(name, private, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
+    except FileNotFoundError:
+        return
+    except OSError as error:
+        raise ExtractionCleanupError(
+            f"{name} could not be isolated for removal: {error}"
+        ) from error
+
+    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
+    if directory:
+        flags |= os.O_DIRECTORY
+    try:
+        handle = os.open(private, flags, dir_fd=parent_fd)
+    except FileNotFoundError:
+        return
+    except OSError as error:
+        raise ExtractionCleanupError(
+            f"{private} could not be opened to verify it: {error}"
+        ) from error
+
+    try:
+        current = _fd_identity(handle)
+        if current is None:
+            return
+        if current != identity:
+            # The fresh name now holds something else; hand it back untouched.
+            with suppress(OSError):
+                _rename_no_replace(parent_fd, private, name)
+            raise ExtractionCleanupError(
+                f"{name} no longer names the state this extraction created; "
+                "it was replaced, so it is left in place"
+            )
+
+        try:
+            links_before = os.fstat(handle).st_nlink
+        except OSError:
+            links_before = None
+        try:
+            if directory:
+                os.rmdir(private, dir_fd=parent_fd)
+            else:
+                os.unlink(private, dir_fd=parent_fd)
+        except FileNotFoundError:
+            pass
+        except OSError as error:
+            # The entry could not be removed.  Hand it back to its original name
+            # when that name is still free, so the residue stays where its owner
+            # would look for it; otherwise it stays under the private name.  The
+            # name the residue actually has is what gets reported.
+            residue = private
+            if _entry_identity(parent_fd, name) is None:
