+def _windows_delete(kernel32, handle):
+    """Mark the object the handle names for deletion."""
+    import ctypes
+    from ctypes import wintypes
+
+    class Disposition(ctypes.Structure):
+        _fields_ = [("DeleteFile", ctypes.c_ubyte)]
