+    # One open file for the whole report.  Reading the shebang by re-opening the
+    # path would let a concurrent build publish a different archive in between,
+    # and the report would then describe two archives at once.  Everything below
+    # comes from this single file object, so the document always describes
+    # exactly one of them.
+    with open(pyz, "rb") as archive_file:
+        shebang = archive_file.readline().rstrip(b"\r\n")
+
+        with zipfile.ZipFile(archive_file) as zip_file:
+            data = json.loads(zip_file.read("environment.json"))
+            compression_types = {member.compress_type for member in zip_file.infolist()}
+
+    data["interpreter"] = (
+        shebang[2:].decode(sys.getfilesystemencoding()) if shebang.startswith(b"#!") else ""
+    )
+    data["compressed"] = compression_types == {zipfile.ZIP_DEFLATED}
 
     if print_as_json:
         click.echo(json.dumps(data, indent=4, sort_keys=True))
