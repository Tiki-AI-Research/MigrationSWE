+            survive, because the extraction did not write them.
+            """
+            shutil.rmtree(str(target), ignore_errors=True)
+            proc = ordinary_call(shiv_root, archive_path, target, env=child_env)
+            assert proc.returncode == 0, (
+                f"[same-account/{label}] extraction must succeed: {proc.returncode} {proc.stderr[-400:]}"
+            )
+            published = target / "site-packages" / "mod.py"
+            assert published.is_file(), (
+                f"[same-account/{label}] the archive's own content must be published, but the result "
+                f"is {entries(target) if target.is_dir() else 'missing'}: "
+                f"{entries(directory)}"
+            )
+            assert published.read_text() == "VALUE = 'ARCHIVE'\n", (
+                f"[same-account/{label}] the result must come from the archive, not from a record this "
+                "account's own writer produced"
+            )
+            assert not (target / "site-packages" / "foreign_mod.py").exists(), (
+                f"[same-account/{label}] a planted sibling must never be published as the result"
+            )
+            assert leaked_foreign(target) == [], (
+                f"[same-account/{label}] planted content must not leak into the result: "
+                f"{leaked_foreign(target)}"
+            )
+            for name in sorted(foreign):
+                assert name in entries(directory), (
+                    f"[same-account/{label}] a sibling this operation did not create must not be "
+                    f"deleted: {name} -> {entries(directory)}"
+                )
+                assert foreign_content_in(directory, name) != [], (
+                    f"[same-account/{label}] a planted sibling must keep its own content: {name}"
+                )
+            if record_path is not None:
+                assert Path(record_path).is_file(), (
+                    f"[same-account/{label}] a record this operation did not write must not be "
+                    f"deleted: {record_path}"
+                )
+
+        # 1. The strongest form first: mint the record with the implementation's own
+        # ownership primitives, if it has any.  The record then is one the
+        # implementation itself accepts, so this is the attacker that reads the key.
+        minted_probe = (
+            "import importlib, sys\n"
+            "from pathlib import Path\n"
+            "sys.path.insert(0, sys.argv[5])\n"
+            "module = importlib.import_module('shiv.bootstrap')\n"
+            "required = ('_write_transaction_record', '_read_transaction_record',\n"
+            "            '_ownership_key', '_ownership_state', '_tree_digest')\n"
+            "if any(getattr(module, name, None) is None for name in required):\n"
+            "    print('no-ownership-primitives')\n"
+            "    sys.exit(3)\n"
+            "writer, reader, key_reader, state_of, digest_of = (\n"
+            "    getattr(module, name) for name in required)\n"
+            "target = Path(sys.argv[1]); tmp = Path(sys.argv[2]); backup = Path(sys.argv[3])\n"
+            "token = sys.argv[4]\n"
+            "state = state_of(target)\n"
+            "if state is None:\n"
+            "    print('no-state')\n"
+            "    sys.exit(4)\n"
+            "record_path, key_path = state\n"
+            "key = key_reader(key_path)\n"
+            "if key is None:\n"
+            "    print('no-key')\n"
+            "    sys.exit(5)\n"
+            "tmp_digest = digest_of(tmp); backup_digest = digest_of(backup)\n"
+            "if not tmp_digest or not backup_digest:\n"
+            "    print('no-digest')\n"
+            "    sys.exit(6)\n"
+            "writer(record_path, target, key, token, tmp.name, tmp_digest, backup.name, backup_digest)\n"
+            "if reader(target) is None:\n"
+            "    print('record-rejected')\n"
+            "    sys.exit(7)\n"
+            "print('accepted')\n"
+            "print(record_path)\n"
+        )
+        status = run_isolated(
+            [sys.executable, "-c", minted_probe, str(target), str(planted_tmp),
+             str(planted_backup), token, shiv_root],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=child_env,
+        )
+        minted_record_path = None
+        if status.returncode == 0:
+            assert status.stdout.splitlines()[0] == "accepted", status.stdout
+            minted_record_path = Path(status.stdout.splitlines()[-1])
+            shutil.rmtree(str(target), ignore_errors=True)
+            check_one("implementation-minted-record", minted_record_path)
+        else:
+            # A design that keeps no such mechanism has nothing to hand over; the
+            # attack still runs below, and only its outcome is required.
+            assert status.returncode in (3, 4, 5, 6, 7), (
+                f"the primitive-minting probe must only report a missing mechanism, not fail: "
+                f"{status.returncode} {status.stderr[-400:]}"
+            )
+
+        # 2. Records a writer of the directory can author on its own, written where
+        # the implementation's own record was and at the other plausible locations.
+        attempts = 0
+        keyed_attempts = 0
+        for record_path, implementation_owned in locations:
+            if attempts >= 10:
+                break
+            for shape in record_shapes():
+                if attempts >= 10:
+                    break
+                for tag_label, tag in minted_tags(shape):
+                    if attempts >= 10:
+                        break
+                    attempt = dict(shape)
+                    attempt["tag"] = tag
+                    record_path.parent.mkdir(parents=True, exist_ok=True)
+                    record_path.write_text(json.dumps(attempt), encoding="utf-8")
+                    if not tag_label.startswith("zero-tag"):
+                        keyed_attempts += 1
+                    attempts += 1
+                    check_one(f"{record_path.name}/{tag_label}",
+                              record_path if not implementation_owned else None)
+
+        # 3. Whatever path the implementation uses internally, it must not leave a
+        # record inside the extraction directory: only the lock, the target and the
+        # state the interruption left may sit there.
+        allowed = {target.name, f".{target.name}_lock"} | foreign | crash_leftovers
+        assert not (set(entries(directory)) - allowed), (
+            "no per-extraction state other than the lock, the target and the interrupted state may "
+            f"remain in the extraction directory: {sorted(set(entries(directory)) - allowed)}"
+        )
+        assert attempts >= 6, f"the forged-record attack must be tried at several shapes: {attempts}"
+        assert keyed_attempts >= 2, (
+            f"the forgery must include keyed constructions over the account's own state: {keyed_attempts}"
+        )
+
+    elif scenario == "swapped_backup_not_adopted":
+        # The object behind a sibling name can be replaced after the fact, so a
+        # name that once held a real result is not by itself a reason to publish
+        # whatever now sits there.  The replaced tree must not be published, must
+        # not be deleted, and the archive must still produce the result.
+        archive = make_archive(tmp_path / "swap_own.zip", [
+            ("site-packages/mod.py", "VALUE = 'ARCHIVE'\n"),
+            ("site-packages/keep.py", "KEEP = 1\n"),
+        ])
+        directory = tmp_path / "swapped"
+        directory.mkdir()
+        target = directory / "root"
+        extract_site_packages(archive, target, compile_pyc=False, force=False)
+
+        replacement_path = tmp_path / "swap_replacement.zip"
+        replacement = make_archive(replacement_path, [
+            ("site-packages/mod.py", "VALUE = 'REPLACEMENT'\n"),
+            ("site-packages/new_only.py", "NEWFILE = 1\n"),
+        ])
+        shiv_root = str(Path(__import__("shiv").__file__).resolve().parents[1])
+        crash_at_publish(replacement_path, target, shiv_root)
+
+        shutil.rmtree(str(target), ignore_errors=True)
+        candidates = [path for path in directory.iterdir() if ".bak" in path.name or ".tmp" in path.name]
+        assert candidates, f"an interruption must leave the state it created: {entries(directory)}"
+        swapped = candidates[0]
+
+        # Replace that object with a different directory that looks just as
+        # complete and carries foreign content.
+        shutil.rmtree(str(swapped))
+        (swapped / "site-packages").mkdir(parents=True)
+        (swapped / "site-packages" / "foreign_mod.py").write_text("VALUE = 'FORGED'\n")
+        (swapped / "rogue.txt").write_text("rogue\n")
+
+        extract_site_packages(archive, target, compile_pyc=False, force=False)
+
+        assert (target / "site-packages" / "mod.py").read_text() == "VALUE = 'ARCHIVE'\n", (
+            "the result must come from the archive, not from a swapped-in sibling"
+        )
+        assert not (target / "site-packages" / "foreign_mod.py").exists(), (
+            "a sibling whose contents were replaced must never be published as the result"
+        )
+        assert leaked_foreign(target) == [], (
+            f"foreign content must not leak into the result: {leaked_foreign(target)}"
+        )
+        assert swapped in [path for path in directory.iterdir()], (
+            f"a sibling this operation did not create must not be deleted: {entries(directory)}"
+        )
+        assert (swapped / "site-packages" / "foreign_mod.py").is_file(), (
+            "the swapped-in sibling must keep its own content"
+        )
+
+    elif scenario == "duplicate_last_wins":
+        # Duplicate members are resolved by archive order, not by which name a
+        # reader happens to look up.  Three duplicates make "first wins" and
+        # "second wins" both distinguishable from the required answer, and an
+        # entry that exists only in the first position proves every member is
+        # visited rather than only the effective one being fetched by name.
+        archive = make_archive(tmp_path / "dup.zip", [
+            ("site-packages/dup_mod.py", "V = 1\n"),
+            ("site-packages/first_only.py", "FIRST = True\n"),
+            ("site-packages/dup_mod.py", "V = 2\n"),
+            ("site-packages/dup_mod.py", "V = 3\n"),
+        ])
+        directory = tmp_path / "dup"
+        directory.mkdir()
+        target = directory / "root"
+        plant_foreign(directory, f".{target.name}.foreign.tmp", payload="V = 99\n")
+        foreign = {f".{target.name}.foreign.tmp"}
+
+        extract_site_packages(archive, target, compile_pyc=False, force=True)
+        assert (target / "site-packages" / "dup_mod.py").read_text() == "V = 3\n", (
+            "the last duplicate entry wins"
+        )
+        assert (target / "site-packages" / "first_only.py").read_text() == "FIRST = True\n", (
+            "every archive member must be visited, not only the effective duplicate"
+        )
+        assert leaked_foreign(target) == [], "foreign content must not leak into the result"
+        assert "V = 99" not in (target / "site-packages" / "dup_mod.py").read_text(), (
+            "foreign content must not be preferred over the archive's own last member"
+        )
+        assert inner_markers(target) == [], "the result must contain no temporary or backup state"
+        assert unowned(directory, foreign) == [], (
+            f"the operation must clean up its own state: {markers(directory)}"
+        )
+        for name in sorted(foreign):
+            assert name in entries(directory), (
+                f"a sibling this operation did not create must not be deleted: {name}"
+            )
+
+    else:  # pragma: no cover - the parametrization above is exhaustive
+        raise AssertionError(f"unknown scenario: {scenario}")
+
