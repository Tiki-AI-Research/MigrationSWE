+    assert res_err.exit_code == 0
+    proc_err = run_isolated([str(runtime_python), str(pyz_err)], stdout=subprocess.PIPE, text=True)
+    assert proc_err.returncode == 37
+    assert "PY_PREAMBLE_FAILING" in proc_err.stdout
