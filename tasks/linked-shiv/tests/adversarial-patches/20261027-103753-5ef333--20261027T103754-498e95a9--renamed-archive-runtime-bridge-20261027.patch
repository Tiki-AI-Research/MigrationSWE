+# --------------------------------------------------------------------------
+# Windows: directory entries cannot be opened as descriptors, but every object
+# can be opened as a handle.  Deletion is performed through the handle, and a
+# directory is opened without FILE_SHARE_DELETE so its name cannot be moved
+# while it is being emptied.
+# --------------------------------------------------------------------------
+
+_FILE_ATTRIBUTE_DIRECTORY = 0x00000010
+_FILE_ATTRIBUTE_NORMAL = 0x00000080
+_FILE_SHARE_READ = 0x00000001
+_FILE_SHARE_WRITE = 0x00000002
+_FILE_SHARE_DELETE = 0x00000004
+
+
+def _windows_handle(path: Path, *, share_delete: bool = False):
+    """Open a handle to one object, or ``None`` when it no longer exists.
+
+    Without ``share_delete`` no other process can rename or delete the object
+    while the handle is open, which is what keeps a directory's name bound to the
+    object being emptied.  ``FILE_FLAG_OPEN_REPARSE_POINT`` keeps a link itself as
+    the target of the handle instead of following it.
+    """
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    create = kernel32.CreateFileW
+    create.restype = wintypes.HANDLE
+    create.argtypes = [
+        wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, wintypes.LPVOID,
+        wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE,
+    ]
+    share = _FILE_SHARE_READ | _FILE_SHARE_WRITE
+    if share_delete:
+        share |= _FILE_SHARE_DELETE
+    handle = create(
+        str(_long_path(path)),
+        0x00010000 | 0x0080 | 0x0100 | 0x00100000,  # DELETE | READ/WRITE_ATTRIBUTES | SYNCHRONIZE
+        share,
+        None,
+        3,  # OPEN_EXISTING
+        0x02000000 | 0x00200000,  # BACKUP_SEMANTICS | OPEN_REPARSE_POINT
+        None,
+    )
+    invalid = handle == -1 or handle == wintypes.HANDLE(-1).value
+    if invalid:
+        error = ctypes.get_last_error()
+        if error in (2, 3):  # ERROR_FILE_NOT_FOUND / ERROR_PATH_NOT_FOUND
+            return None
+        raise OSError(error, f"cannot open {path}")
+    return kernel32, handle
+
+
+def _windows_identity(kernel32, handle):
+    """The object a handle names: volume serial, file index, and directory flag."""
+    import ctypes
+    from ctypes import wintypes
+
+    class Info(ctypes.Structure):
+        _fields_ = [
+            ("dwFileAttributes", wintypes.DWORD),
+            ("ftCreationTime", wintypes.FILETIME),
+            ("ftLastAccessTime", wintypes.FILETIME),
+            ("ftLastWriteTime", wintypes.FILETIME),
+            ("dwVolumeSerialNumber", wintypes.DWORD),
+            ("nFileSizeHigh", wintypes.DWORD),
+            ("nFileSizeLow", wintypes.DWORD),
+            ("nNumberOfLinks", wintypes.DWORD),
+            ("nFileIndexHigh", wintypes.DWORD),
+            ("nFileIndexLow", wintypes.DWORD),
+        ]
+
+    info = Info()
+    if not kernel32.GetFileInformationByHandle(handle, ctypes.byref(info)):
+        raise ctypes.WinError(ctypes.get_last_error())
+    index = (int(info.nFileIndexHigh) << 32) | int(info.nFileIndexLow)
+    is_dir = bool(info.dwFileAttributes & _FILE_ATTRIBUTE_DIRECTORY)
+    return (int(info.dwVolumeSerialNumber) & 0xFFFFFFFF, index, is_dir)
+
+
+def _windows_clear_readonly(kernel32, handle):
+    """Clear the read-only attribute through the handle, so deletion can proceed."""
+    import ctypes
+
+    class Basic(ctypes.Structure):
+        _fields_ = [
+            ("CreationTime", ctypes.c_longlong),
+            ("LastAccessTime", ctypes.c_longlong),
+            ("LastWriteTime", ctypes.c_longlong),
+            ("ChangeTime", ctypes.c_longlong),
+            ("FileAttributes", ctypes.c_uint32),
+        ]
+
+    basic = Basic()
+    basic.FileAttributes = _FILE_ATTRIBUTE_NORMAL
+    kernel32.SetFileInformationByHandle(handle, 0, ctypes.byref(basic), ctypes.sizeof(basic))
+
+
+def _windows_rename(kernel32, handle, destination: Path) -> None:
+    """Rename the object a handle names, by handle rather than by path.
+
+    ``SetFileInformationByHandle`` with ``FileRenameInfo`` renames exactly the
+    object the handle refers to.  An exchange of the source name therefore
+    cannot redirect the move: whatever someone else put there is not the object
+    being renamed.  The handle must have been opened with ``DELETE`` access.
+    """
+    import ctypes
+
+    class RenameInfo(ctypes.Structure):
+        _fields_ = [
+            ("ReplaceIfExists", ctypes.c_ubyte),
+            ("RootDirectory", ctypes.c_void_p),
+            ("FileNameLength", ctypes.c_uint32),
+            ("FileName", ctypes.c_wchar * 2),
+        ]
+
+    name = str(_long_path(destination))
+    length = len(name.encode("utf-16-le"))
+    buffer = ctypes.create_string_buffer(
+        ctypes.sizeof(RenameInfo) - 2 * ctypes.sizeof(ctypes.c_wchar) + length + 2
+    )
+    info = ctypes.cast(buffer, ctypes.POINTER(RenameInfo)).contents
+    info.ReplaceIfExists = 0
+    info.RootDirectory = None
+    info.FileNameLength = length
+    ctypes.memmove(
+        ctypes.addressof(buffer) + RenameInfo.FileName.offset,
+        name.encode("utf-16-le"),
+        length,
+    )
+    if not kernel32.SetFileInformationByHandle(
+            handle, 3, buffer, ctypes.sizeof(buffer)):  # FileRenameInfo
+        raise ctypes.WinError(ctypes.get_last_error())
+
+
+def _windows_move_by_handle(source: Path, identity, destination: Path, label: str) -> None:
+    """Rename one verified object on Windows, through its handle."""
+    opened = _windows_handle(source, share_delete=True)
+    if opened is None:
+        raise ExtractionCleanupError(
+            f"{label} disappeared before it could be used; nothing from this call was published"
+        )
+    kernel32, handle = opened
+    try:
+        if not _require_identity(label, _windows_identity(kernel32, handle), identity):
+            raise ExtractionCleanupError(
+                f"{label} disappeared before it could be used; nothing from this call was published"
+            )
+        _windows_rename(kernel32, handle, destination)
+    finally:
+        kernel32.CloseHandle(handle)
+
+
+def _windows_delete(kernel32, handle):
+    """Mark the object the handle names for deletion."""
+    import ctypes
+    from ctypes import wintypes
+
+    class Disposition(ctypes.Structure):
+        _fields_ = [("DeleteFile", ctypes.c_ubyte)]
+
+    disposition = Disposition(1)
+    if not kernel32.SetFileInformationByHandle(
+            handle, 4, ctypes.byref(disposition), ctypes.sizeof(disposition)):
+        raise ctypes.WinError(ctypes.get_last_error())
+
