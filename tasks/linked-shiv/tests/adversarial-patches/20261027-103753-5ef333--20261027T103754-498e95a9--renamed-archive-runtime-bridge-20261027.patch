+    )
+    preamble.chmod(preamble.stat().st_mode | stat.S_IEXEC)
+
+    pyz = tmp_path / f"preamble_py_{use_pip}.pyz"
+    if use_pip:
+        args = ["-o", str(pyz), "-e", "hello:main", "--preamble", str(preamble), str(hello_wheel)]
+    else:
+        sp = tmp_path / f"sp_py_{use_pip}"
+        sp.mkdir()
