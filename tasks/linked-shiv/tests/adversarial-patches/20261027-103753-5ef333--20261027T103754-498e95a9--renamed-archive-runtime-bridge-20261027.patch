+def test_p2p_050_info_complete_state(tmp_path, baseline_envs):
+    """P2P-050: one report describes the archive's complete recorded state, type-exactly.
+
+    Coverage ownership: the recorded metadata document and its rendering.  Every
+    field the archive's own ``environment.json`` carries must be reported with
+    the recorded value and JSON type by both views; the recorded source hashes
+    must be the digests of the bytes that were packaged; and a derived state the
+    report does express must name the same archive.
+
+    Requiring the derived interpreter/compression fields on *every* report is
+    not a preserved source behaviour (the pre-migration implementation omits
+    both), so it is not asserted here as if it were a P2P property; the exact
+    requirement and its scope are recorded in the case's coverage reasons.
+    """
+    sp = tmp_path / "sp_state"
+    (sp / "hello").mkdir(parents=True)
+    (sp / "hello" / "__init__.py").write_text("def main():\n    print('hello world')\n")
+    (sp / "hello" / "extra.py").write_text("VALUE = 1\n")
+    build_env = {**os.environ, "SOURCE_DATE_EPOCH": "1700000000"}
+    root = tmp_path / "state_root"
+    scenarios = [("--compressed", True), ("--uncompressed", False)]
+
+    for side in ("source", "target"):
+        python = getattr(baseline_envs, f"{side}_python")
+        for flag, expected_compressed in scenarios:
+            pyz = tmp_path / f"state_{side}_{flag.strip('-')}.pyz"
+            build = run_isolated(
+                [str(python), "-m", "shiv", "-o", str(pyz), "-p", str(python),
+                 "--site-packages", str(sp), "-e", "hello:main", flag,
+                 "--build-id", "STATE-ID", "--reproducible", "--no-modify",
+                 "--compile-pyc", "-E", "--root", str(root)],
+                capture_output=True, text=True, env=build_env,
+            )
+            assert build.returncode == 0, f"{side} {flag} build: {build.stderr[-800:]}"
+
+            state = archive_state(pyz)
+            assert state["compressed"] is expected_compressed, (
+                f"{side} {flag}: the archive's own compression state must follow the flag: "
+                f"{state['compress_types']}"
+            )
+
+            js = run_isolated(
+                [str(python), "-c", "from shiv.info import main; main()", "--json", str(pyz)],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+            )
+            assert js.returncode == 0, f"{side} {flag} json: {js.stderr[-800:]}"
+            data = json.loads(js.stdout)
+            assert state_mismatches(data, state) == [], (
+                f"{side} {flag}: the JSON view must describe the archive exactly: "
+                f"{state_mismatches(data, state)}"
+            )
+            assert data["compile_pyc"] is True, f"{side} {flag}: --compile-pyc must be recorded"
+            assert data["extend_pythonpath"] is True, f"{side} {flag}: -E must be recorded"
+            assert data["no_modify"] is True, f"{side} {flag}: --no-modify must be recorded"
+            assert data["reproducible"] is True, f"{side} {flag}: --reproducible must be recorded"
+            assert os.path.normcase(os.path.normpath(str(data["root"]))) == os.path.normcase(
+                os.path.normpath(str(root))
+            ), f"{side} {flag}: the requested root must be recorded"
+
+            # The recorded hashes are the digests of the packaged bytes, item by
+            # item; an empty map, a missing entry, or a fabricated digest fails.
+            actual = {
+                path.relative_to(sp).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
+                for path in sp.rglob("*.py")
+            }
+            recorded = {str(key).replace("\\", "/"): value for key, value in data["hashes"].items()}
+            assert set(recorded) == set(actual), (
+                f"{side} {flag}: recorded hashes must cover exactly the built sources: "
+                f"missing {sorted(set(actual) - set(recorded))}, "
+                f"unexpected {sorted(set(recorded) - set(actual))}"
+            )
+            for relative, digest in actual.items():
+                assert recorded[relative] == digest, (
+                    f"{side} {flag}: the recorded hash for {relative} must be the built digest"
+                )
+            assert state_mismatches({**data, "hashes": {}}, state), (
+                f"{side} {flag}: an empty hash map must be rejected"
+            )
+            partial = dict(data["hashes"])
+            partial.pop(sorted(partial)[0])
+            assert state_mismatches({**data, "hashes": partial}, state), (
+                f"{side} {flag}: a partial hash map must be rejected"
+            )
+
+            text = run_isolated(
+                [str(python), "-c", "from shiv.info import main; main()", str(pyz)],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+            )
+            assert text.returncode == 0, f"{side} {flag} text: {text.stderr[-800:]}"
+            occurrences = parse_info_text(text.stdout)
+            assert text_state_mismatches(occurrences, state) == [], (
+                f"{side} {flag}: the text view must bind every recorded field: "
+                f"{text_state_mismatches(occurrences, state)}"
+            )
+
+            # A recorded boolean rendered as a number is a different value.
+            assert state_mismatches({**data, "compile_pyc": 1}, state), (
+                f"{side} {flag}: a recorded boolean reported as 1 must fail"
+            )
+            assert state_mismatches({**data, "reproducible": 0}, state), (
+                f"{side} {flag}: a recorded boolean reported as 0 must fail"
+            )
+
+    # The comparator must separate a report carrying another archive's derived
+    # state from the archive that was actually built, and must require both
+    # derived facts when the contract asks for them.
+    compressed_state = archive_state(tmp_path / "state_source_compressed.pyz")
+    uncompressed_state = archive_state(tmp_path / "state_source_uncompressed.pyz")
+    assert compressed_state["compressed"] is not uncompressed_state["compressed"]
+    borrowed = {
+        **compressed_state["recorded"],
+        "interpreter": uncompressed_state["interpreter"],
+        "compressed": uncompressed_state["compressed"],
+    }
+    assert state_mismatches(borrowed, compressed_state), (
+        "a report borrowing the other archive's derived state must fail"
+    )
+    assert state_mismatches(compressed_state["recorded"], compressed_state, require_derived=True), (
+        "when the derived state is required, omitting it must fail"
+    )
+    assert state_mismatches(
+        {**compressed_state["recorded"],
+         "interpreter": compressed_state["interpreter"],
+         "compressed": compressed_state["compressed"]},
+        compressed_state,
+        require_derived=True,
+    ) == [], "a truthful report must satisfy the required derived state"
+
+
+def test_p2p_053_info_archive_snapshot(tmp_path, baseline_envs):
+    """P2P-053: a report produced while the archive is replaced is one complete version.
+
+    Coverage ownership: concurrent replacement of the inspected archive.  Two
+    complete but distinguishable archives are prepared; the fixture replaces the
+    inspected path from inside a read of it, so the event log is
+    ``open -> read-start -> swap -> read-end``.  Every report must match exactly
+    one complete version: a single snapshot and an identity-checked retry are
+    both legitimate, and a reader that mixes two versions matches neither.  The
+    fixture checks itself on the same routing before the candidate runs.
+
+    When the implementation reads through an API the fixture does not route, no
+    interleaving was established.  That is an unfinished evaluation, recorded as
+    such, never a pass.
+    """
+    sp = tmp_path / "sp_snapshot"
+    (sp / "hello").mkdir(parents=True)
+    (sp / "hello" / "__init__.py").write_text("def main():\n    print('hello world')\n")
+
+    version_one = tmp_path / "version_one.pyz"
+    version_two = tmp_path / "version_two.pyz"
+    create_archive(
+        [sp], version_one, str(baseline_envs.source_python), "hello:main",
+        Environment("2026-09-30 00:00:00", "0.0.1", build_id="BUILD-ONE"),
+        compressed=True,
+    )
+    create_archive(
+        [sp], version_two, str(baseline_envs.target_python), "hello:main",
+        Environment("2026-09-30 00:00:00", "0.0.1", build_id="BUILD-TWO"),
+        compressed=False,
+    )
+    one_bytes = version_one.read_bytes()
+    two_bytes = version_two.read_bytes()
+    expected_one = archive_state(version_one)
+    expected_two = archive_state(version_two)
+    assert expected_one["recorded"]["build_id"] != expected_two["recorded"]["build_id"]
+    assert expected_one["interpreter"] != expected_two["interpreter"]
+    assert expected_one["compressed"] != expected_two["compressed"]
+
+    snapshots = tmp_path / "snapshots"
+    snapshots.mkdir()
+    fixture = _ArchiveSwapFixture(
+        version_one, version_two, snapshots,
+        real_open=io.open, real_os_open=os.open,
+    )
+
+    def version_of(report, version_states):
+        for version_state in version_states:
+            if not state_mismatches(report, version_state):
+                return version_state["recorded"]["build_id"]
+        return None
+
+    def text_version_of(output, version_states):
+        occurrences = parse_info_text(output)
+        for version_state in version_states:
+            if not text_state_mismatches(occurrences, version_state):
+                return version_state["recorded"]["build_id"]
+        return None
+
+    def read_report(mode, strategy):
+        """Produce a report through the fixture with one reading strategy.
+
+        ``snapshot`` opens once and reads everything from that handle,
+        ``retry`` re-resolves the path and retries after seeing it change, and
+        ``mix`` deliberately takes the shebang from a later open than the
+        metadata.  Comparing their verdicts proves the fixture exposes the
+        interleaving and that the comparator separates them.
+        """
+        fixture.reset(one_bytes, two_bytes)
+        path = str(fixture.target_path)
+
+        def load_once():
+            with open(path, "rb") as handle:
+                return handle.read()
+
+        if strategy == "snapshot":
+            payload = load_once()
+            shebang_payload = payload
+        elif strategy == "retry":
+            for _ in range(8):
+                payload = load_once()
+                if fixture.target_path.read_bytes() == payload:
+                    break
+            shebang_payload = payload
+        else:
+            payload = load_once()
+            with open(path, "rb") as handle:
+                shebang_payload = handle.read()
+
+        shebang = shebang_payload.split(b"\n", 1)[0].rstrip(b"\r")
+        with zipfile.ZipFile(io.BytesIO(payload)) as archive:
+            recorded = json.loads(archive.read("environment.json"))
+            compress_types = sorted({info.compress_type for info in archive.infolist()})
+        report = dict(recorded)
+        report["interpreter"] = (
+            shebang[2:].decode(sys.getfilesystemencoding()) if shebang.startswith(b"#!") else ""
+        )
+        report["compressed"] = compress_types == [zipfile.ZIP_DEFLATED]
+        if mode == "json":
+            return json.dumps(report)
+        lines = [f"{key}: {value}" for key, value in report.items() if key != "hashes"]
+        lines.append("hashes: " + json.dumps(report["hashes"], sort_keys=True))
+        return "\n".join(lines)
+
+    def run_while_replacing(mode):
+        fixture.reset(one_bytes, two_bytes)
+        with fixture.routing():
+            for strategy in ("snapshot", "retry"):
+                report = read_report(mode, strategy)
+                seen = (
+                    version_of(json.loads(report), (expected_one, expected_two))
+                    if mode == "json"
+                    else text_version_of(report, (expected_one, expected_two))
+                )
+                assert seen is not None, (
+                    f"fixture diagnostic ({mode}/{strategy}): a consistent reader must match "
+                    f"one complete version"
+                )
+            mixed_report = read_report(mode, "mix")
+            seen = (
+                version_of(json.loads(mixed_report), (expected_one, expected_two))
+                if mode == "json"
+                else text_version_of(mixed_report, (expected_one, expected_two))
+            )
+            assert seen is None, (
+                f"fixture diagnostic ({mode}): a reader that mixes the two versions must match "
+                f"neither; events={fixture.events}"
+            )
+
+            fixture.reset(one_bytes, two_bytes)
+            args = ["--json", str(version_one)] if mode == "json" else [str(version_one)]
+            result = CliRunner().invoke(info_main, args)
+
+            events = list(fixture.events)
+            interleaved = fixture.interleaved()
+
+        assert result.exit_code == 0, f"{result.output} (events={events})"
+        # Click 6.7's Result exposes ``output``; later versions add ``stdout``.
+        # Taking whichever exists keeps this node runnable against both the
+        # source baseline and the target runtime.
+        rendered = getattr(result, "stdout", None)
+        if rendered is None:
+            rendered = result.output
+        if mode == "json":
+            chosen = version_of(json.loads(rendered), (expected_one, expected_two))
+        else:
+            chosen = text_version_of(rendered, (expected_one, expected_two))
+        assert chosen is not None, (
+            f"the {mode} report must describe exactly one complete archive version, not a mix "
+            f"of the two; events={events}"
+        )
+        if not interleaved:
+            record_unverified_coverage(
+                "P2P-053",
+                f"no {mode} read of the inspected archive was observed through a routed API, "
+                f"so the replacement could not be interleaved with a read and race behaviour "
+                f"was not verified for this implementation (events={events}). Extend the "
+                f"fixture for the read API this implementation uses.",
+            )
+
+    run_while_replacing("json")
+    run_while_replacing("text")
+
+    # A bad input keeps its own diagnostic instead of a mixed or fabricated report.
+    broken = tmp_path / "not_an_archive.pyz"
+    broken.write_bytes(b"#!/usr/bin/env python\nnot a zip file\n")
+    invalid = CliRunner().invoke(info_main, ["--json", str(broken)])
+    assert invalid.exit_code != 0, "a non-archive must be rejected"
+    diagnostic = f"{invalid.output} {invalid.exception!r}"
+    assert "zip" in diagnostic.lower(), (
+        f"the invalid-input diagnostic must be preserved: {diagnostic!r}"
+    )
+
+
