+    # have been exchanged while the children were being removed.
+    opened = _windows_handle(path, share_delete=True)
+    if opened is None:
+        return
+    kernel32, handle = opened
+    try:
+        if not _require_identity(path.name, _windows_identity(kernel32, handle), identity):
+            return
+        _delete_handle(kernel32, handle)
+    finally:
+        kernel32.CloseHandle(handle)
+
+
+def _delete_one_by_handle(path: Path, identity) -> None:
+    """Delete one non-directory object through a verified handle."""
+    opened = _windows_handle(path, share_delete=True)
+    if opened is None:
+        return
+    kernel32, handle = opened
+    try:
+        if not _require_identity(path.name, _windows_identity(kernel32, handle), identity):
+            return
+        _delete_handle(kernel32, handle)
+    finally:
+        kernel32.CloseHandle(handle)
+
+
+def _discard(path: Optional[Path], identity) -> None:
+    """Remove the exact object this call created, and nothing else.
+
+    A path can be swapped for an unrelated directory between the moment this call
+    created its state and the moment it cleans up -- the caller of this function
+    is not the only writer of that directory.  Deleting by name would then remove
+    somebody else's tree, so removal works on the object, never on the name:
