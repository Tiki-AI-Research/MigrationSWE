+@pytest.mark.parametrize("scenario", ["explicit_override", "source_order", "three_source_order", "single_source", "pip_mixed"])
+def test_p2p_015_multiple_site_packages_merge(tmp_path, runner, hello_wheel, scenario):
+    """P2P-015: multiple --site-packages merge in command-line order; the later source provides the effective bytes.
+
+    Archival shape: the pre-migration behaviour and the reference solution both
+    write one physical central-directory member per contributing source for a
+    path that several sources provide, and ``zipfile.read`` resolves such a path
+    to the member written last.  The public contract (``instruction.md`` 24/26/44)
+    is about the single *effective* member for each archive path, so the
+    enforceable invariants applied here are:
+
+    * an archive path may never carry more members than the number of declared
+      sources that provide it, so a build cannot append arbitrary extra copies
+      that merely leave the right bytes last;
+    * the retained members for such a path must be one of exactly two admissible
+      shapes: every declared contributor's copy in declared order (the
+      pre-migration and reference shape, whose last member is effective), or the
+      single copy of the last declared contributor (an implementation that
+      collapses the merge).  A missing earlier contributor, an out-of-order
+      sequence, a repeated contributor, or any extra copy beyond the declared
+      contributors is rejected;
+    * the effective (last) member must be the bytes of the last declared source
+      that provides the path;
+    * a path only one source provides must appear exactly once.
+    """
+    sp_a = tmp_path / "sp_a"
+    sp_b = tmp_path / "sp_b"
+    sp_c = tmp_path / "sp_c"
+    for sp in (sp_a, sp_b, sp_c):
+        sp.mkdir()
+
+    (sp_a / "unique_a.py").write_text("ID = 'AAA'\n")
+    (sp_b / "unique_b.py").write_text("ID = 'BBB'\n")
+    (sp_c / "unique_c.py").write_text("ID = 'CCC'\n")
+    (sp_a / "common.py").write_text("TAG = 'from_A'\n")
+    (sp_b / "common.py").write_text("TAG = 'from_B'\n")
+    (sp_c / "common.py").write_text("TAG = 'from_C'\n")
+
+    contribution = {
+        "from_A": b"TAG = 'from_A'\n",
+        "from_B": b"TAG = 'from_B'\n",
+        "from_C": b"TAG = 'from_C'\n",
+    }
+
+    def members(path):
+        """Every central-directory member of one archive, in file order."""
+        with zipfile.ZipFile(str(path)) as archive:
+            infos = archive.infolist()
+            names = [info.filename for info in infos]
+            assert all("\\" not in name for name in names), "ZIP entries must use the '/' separator"
+            return [(info.filename, archive.open(info).read()) for info in infos]
+
+    def check_shared(path, declared_order, effective_key):
+        """Check the shared path against the declared source order."""
+        observed = members(path)
+        names = [name for name, _ in observed]
+        shared = [data.replace(b"\r\n", b"\n") for name, data in observed
+                  if name == "site-packages/common.py"]
+        declared = [contribution[key] for key in declared_order]
+        assert 1 <= len(shared) <= len(declared), (
+            f"the shared path may carry at most one member per declared source "
+            f"({len(declared)}), got {len(shared)}"
+        )
+        # The retained members must be one of exactly two admissible shapes:
+        # every declared contributor's copy in declared order (the pre-migration
+        # and reference shape, whose last member is effective), or the single
+        # copy of the last declared contributor (an implementation that collapses
+        # the merge).  Any other combination -- a missing earlier contributor, an
+        # out-of-order sequence, a contributor appearing twice, or an extra copy
+        # beyond the declared contributors -- is rejected, so a build cannot pad
+        # the path with arbitrary duplicates as long as the last bytes are right.
+        indices = []
+        for position, data in enumerate(shared):
+            assert data in declared, (
+                f"member {position} of the shared path is not a declared source's bytes: {data!r}"
+            )
+            indices.append(declared.index(data))
+        admissible = [list(range(len(declared))), [len(declared) - 1]]
+        assert indices in admissible, (
+            f"retained members must be the declared sequence or the last contributor alone, "
+            f"got {indices} of {len(declared)} declared"
+        )
+        with zipfile.ZipFile(str(path)) as resolved:
+            effective = resolved.read("site-packages/common.py").replace(b"\r\n", b"\n")
+        assert effective == contribution[effective_key], (
+            f"the later source must supply the effective bytes, got {effective!r}"
+        )
+        # A path only one source provides must appear exactly once.
+        counts = {}
+        for name in names:
+            counts[name] = counts.get(name, 0) + 1
+        repeated_unshared = sorted(
+            name for name, count in counts.items()
+            if count > 1 and name != "site-packages/common.py"
+        )
+        assert repeated_unshared == [], (
+            f"an unshared archive path must appear exactly once: {repeated_unshared}"
+        )
+        return names
+
+    if scenario == "explicit_override":
+        pyz = tmp_path / "merged_ab.pyz"
+        res = runner(["-o", str(pyz), "--site-packages", str(sp_a), "--site-packages", str(sp_b)])
+        assert res.exit_code == 0, res.output
+        names = check_shared(pyz, ("from_A", "from_B"), "from_B")
+        assert "site-packages/unique_a.py" in names
+        assert "site-packages/unique_b.py" in names
+        assert "_bootstrap/__init__.py" in names and "environment.json" in names
+        # Both sources contribute, and the later source owns the effective bytes.
+        assert names.index("site-packages/unique_a.py") < names.index("site-packages/unique_b.py")
+
+    elif scenario == "source_order":
+        pyz = tmp_path / "merged_ba.pyz"
+        res = runner(["-o", str(pyz), "--site-packages", str(sp_b), "--site-packages", str(sp_a)])
+        assert res.exit_code == 0, res.output
+        # The declared order is B then A, so that is the order the shared members
+        # must follow, and A's bytes are effective.
+        names = check_shared(pyz, ("from_B", "from_A"), "from_A")
+        assert "site-packages/unique_a.py" in names
+        assert "site-packages/unique_b.py" in names
+        assert names.index("site-packages/unique_b.py") < names.index("site-packages/unique_a.py")
+
+    elif scenario == "three_source_order":
+        pyz = tmp_path / "merged_abc.pyz"
+        res = runner(["-o", str(pyz), "--site-packages", str(sp_a), "--site-packages", str(sp_b),
+                      "--site-packages", str(sp_c)])
+        assert res.exit_code == 0, res.output
+        names = check_shared(pyz, ("from_A", "from_B", "from_C"), "from_C")
+        for name in ("site-packages/unique_a.py", "site-packages/unique_b.py", "site-packages/unique_c.py"):
+            assert name in names, names
+        assert names.index("site-packages/unique_a.py") < names.index("site-packages/unique_b.py")
+        assert names.index("site-packages/unique_b.py") < names.index("site-packages/unique_c.py")
+
+    elif scenario == "single_source":
+        # Nothing conflicts, so no archive path may repeat at all.
+        pyz = tmp_path / "merged_single.pyz"
+        res = runner(["-o", str(pyz), "--site-packages", str(sp_a)])
+        assert res.exit_code == 0, res.output
+        observed = members(pyz)
+        names = [name for name, _ in observed]
+        duplicates = sorted({name for name in names if names.count(name) > 1})
+        assert duplicates == [], f"no archive path may repeat: {duplicates}"
+        data = {name: value.replace(b"\r\n", b"\n") for name, value in observed}
+        assert data["site-packages/common.py"] == b"TAG = 'from_A'\n"
+        assert data["site-packages/unique_a.py"] == b"ID = 'AAA'\n"
+
+    else:  # pip_mixed
+        sp_explicit = tmp_path / "sp_explicit"
+        sp_explicit.mkdir()
+        (sp_explicit / "explicit_only.py").write_text("EXPLICIT = 1\n")
+        pyz = tmp_path / "merged_pip.pyz"
+        res = runner(["-o", str(pyz), "--site-packages", str(sp_explicit), str(hello_wheel)])
+        assert res.exit_code == 0, res.output
+        observed = members(pyz)
+        names = [name for name, _ in observed]
+        # The explicit source and the installed wheel provide disjoint paths, so
+        # every archive path must carry exactly one member.
+        duplicates = sorted({name for name in names if names.count(name) > 1})
+        assert duplicates == [], f"no archive path may repeat in the pip-mixed build: {duplicates}"
+        data = {name: value for name, value in observed}
+        # Neither the explicitly supplied source nor the installed wheel may be dropped.
+        assert "site-packages/explicit_only.py" in names, names
+        assert "site-packages/hello/__init__.py" in names, names
+        assert any(name.startswith("site-packages/hello-1.0.0.dist-info/") for name in names), names
+        assert b"EXPLICIT = 1" in data["site-packages/explicit_only.py"]
+@pytest.mark.parametrize("scenario", ["with_site_packages", "with_wheel", "with_pythonpath"])
