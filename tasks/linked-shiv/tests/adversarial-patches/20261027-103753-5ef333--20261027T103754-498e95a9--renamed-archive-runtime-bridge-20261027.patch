+
+    p_tgt = run_isolated([str(isolated_envs["target"].python), "-c", probe_code], capture_output=True, text=True)
+    assert p_tgt.returncode == 0, p_tgt.stderr
+    assert p_tgt.stdout.strip() == "8.1.7", (
