+def _delete_handle(kernel32, handle) -> None:
+    """Delete the object a verified handle names, retrying only for access denial.
+
+    A read-only attribute is the one condition this can fix, by clearing it
+    through the same handle.  Any other failure is reported: retrying it blindly
+    would both hide the cause and risk acting on an entry that changed.
+    """
+    try:
+        _windows_delete(kernel32, handle)
+    except PermissionError:
+        _windows_clear_readonly(kernel32, handle)
+        _windows_delete(kernel32, handle)
+
+
+def _remove_tree_by_handle(path: Path, identity) -> None:
+    """Delete one tree, acting only through handles to verified objects.
+
+    A directory is first opened *without* delete sharing, which keeps its name
+    bound to that object while it is emptied: no other process can rename it or
+    put something else in its place.  Windows also refuses to delete an object
+    while a handle without delete sharing is open on it, so the handle is closed
+    and the directory reopened with delete sharing; the reopened handle's identity
+    is compared with the original before anything is deleted.  Every child is
+    opened the same way, verified, and deleted through its own handle, so a name
+    exchanged before the open is refused and a name exchanged afterwards cannot
+    redirect the deletion.
+    """
