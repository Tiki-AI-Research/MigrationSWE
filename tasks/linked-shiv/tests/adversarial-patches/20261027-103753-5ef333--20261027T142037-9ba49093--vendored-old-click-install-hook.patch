+def test_p2p_052_console_script_name_boundaries(tmp_path, baseline_envs):
+    """P2P-052: path-like and unsupported-platform script names are rejected, never redirected."""
+    sp = tmp_path / "sp_names"
+    bin_dir = sp / "bin"
