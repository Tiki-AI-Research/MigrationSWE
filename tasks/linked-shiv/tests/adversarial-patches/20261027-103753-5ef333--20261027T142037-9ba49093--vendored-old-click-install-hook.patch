+    A label starts a field only at the beginning of a line, optionally indented,
+    so uniformly indented output parses the same way.  Its value is either the
+    remainder of that line (scalars, including values containing punctuation) or
+    a JSON structure that continues on following lines.  Repeated labels are all
+    returned: the caller decides whether their values agree, instead of the
+    parser silently keeping the first one.
+    """
+    occurrences = []
+    lines = output.splitlines()
+    index = 0
+    while index < len(lines):
+        match = _FIELD_LINE.match(lines[index])
+        if not match:
+            index += 1
+            continue
+        key, rest = match.group(1), match.group(2)
+        if rest.lstrip()[:1] in ("{", "["):
+            raw, index = _collect_structured_value(rest, lines, index + 1)
+        elif rest.strip() == "":
+            lookahead = lines[index + 1].lstrip() if index + 1 < len(lines) else ""
+            if lookahead[:1] in ("{", "["):
+                raw, index = _collect_structured_value("", lines, index + 1)
+            else:
+                raw, index = "", index + 1
+        else:
+            raw, index = rest, index + 1
+        occurrences.append((key, raw))
+    return occurrences
+
+
+def parse_info_scalar(raw, expected):
+    """Decode one rendered text value into the shape ``expected`` describes.
+
+    Whitespace is irrelevant, booleans accept their common spellings, absent
+    values accept the Python and JSON spellings, and mappings/sequences are
+    parsed as JSON.  Anything that cannot be decoded unambiguously returns
+    ``_NOT_PARSED`` so the caller reports a mismatch instead of guessing.
+    """
+    text = raw.strip()
+    if isinstance(expected, (dict, list)):
+        try:
+            return json.loads(text)
+        except (json.JSONDecodeError, TypeError):
+            return _NOT_PARSED
+    if isinstance(expected, bool):
+        lowered = text.lower()
+        if lowered in {"true", "yes", "on", "1"}:
+            return True
+        if lowered in {"false", "no", "off", "0"}:
+            return False
+        return _NOT_PARSED
+    if expected is None:
+        if text in {"None", "null", ""}:
+            return None
+        return _NOT_PARSED
+    if isinstance(expected, int):
+        try:
+            return int(text, 10)
+        except ValueError:
+            return _NOT_PARSED
+    if isinstance(expected, float):
+        try:
+            return float(text)
+        except ValueError:
+            return _NOT_PARSED
+    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
+        return text[1:-1]
+    return text
+
+
+def _canonical(value):
+    """A hashable form of a decoded value, for duplicate comparison."""
+    return json.dumps(value, sort_keys=True, ensure_ascii=False)
+
+
+def _decoded_occurrences(occurrences, key, expected):
+    """Decode every occurrence of ``key``; report undecodable or conflicting ones.
+
+    Repeated labels are accepted only when they normalize to the same value.
+    Both "correct then wrong" and "wrong then correct" therefore fail, and the
+    parser never decides the question by keeping the first or the last line.
+    """
+    raws = [raw for label, raw in occurrences if label == key]
+    if not raws:
+        return [], []
+    decoded = []
+    problems = []
+    for raw in raws:
+        value = parse_info_scalar(raw, expected)
+        if value is _NOT_PARSED:
+            problems.append(f"{key}: cannot decode {raw!r} as {expected!r}")
+        else:
+            decoded.append(value)
+    if len({_canonical(value) for value in decoded}) > 1:
+        problems.append(f"{key}: conflicting values for a repeated field: {decoded}")
+    return decoded, problems
+
+
+def archive_state(path):
+    """Read one complete archive version: recorded metadata plus derived facts."""
+    source = Path(path)
+    with open(source, "rb") as handle:
+        shebang = handle.readline().rstrip(b"\r\n")
+    with zipfile.ZipFile(str(source)) as archive:
+        recorded = json.loads(archive.read("environment.json"))
+        compress_types = sorted({info.compress_type for info in archive.infolist()})
+    return {
+        "recorded": recorded,
+        "interpreter": (
+            shebang[2:].decode(sys.getfilesystemencoding()) if shebang.startswith(b"#!") else ""
+        ),
+        "compress_types": compress_types,
+        "compressed": compress_types == [zipfile.ZIP_DEFLATED],
+    }
+
+
+def json_equal(left, right):
+    """Compare two decoded JSON values without Python's cross-type equality.
+
+    ``False == 0`` and ``True == 1`` in Python, so a report that turns a
+    recorded ``false`` into ``0`` would otherwise look identical to the archive.
+    Every JSON type is therefore compared separately: booleans, integers,
+    floats, strings, null, arrays (element by element) and objects (key by key).
+    A value that is not a JSON scalar/array/object falls back to exact type and
+    equality, which is the strictest reading available.
+    """
+    if isinstance(left, bool) or isinstance(right, bool):
+        return type(left) is type(right) and left == right
+    if isinstance(left, (int, float)) or isinstance(right, (int, float)):
+        return type(left) is type(right) and left == right
+    if isinstance(left, str) or isinstance(right, str):
+        return type(left) is type(right) and left == right
+    if left is None or right is None:
+        return left is None and right is None
+    if isinstance(left, list) and isinstance(right, list):
+        return len(left) == len(right) and all(
+            json_equal(a, b) for a, b in zip(left, right)
+        )
+    if isinstance(left, dict) and isinstance(right, dict):
+        return set(left) == set(right) and all(
+            json_equal(left[key], right[key]) for key in left
+        )
+    return type(left) is type(right) and left == right
+
+
+def state_mismatches(metadata, state, *, require_derived=False):
+    """Explain why ``metadata`` is not exactly one complete archive version.
+
+    A report matches a version only when every recorded field carries that
+    version's value.  Mixing values from two versions therefore matches neither
+    version.
+
+    The derived state (interpreter, compression) is checked whenever the report
+    expresses it, and in every case it must name the same version as the
+    recorded fields: that is what makes a report that mixes two opens
+    detectable.  ``require_derived`` additionally demands that the report
+    express it at all.  The frozen source baseline does not, so P2P nodes keep
+    the default and only require truthfulness; a covered node that can assume
+    the representation passes ``require_derived=True``.
+    """
+    problems = []
+    missing = sorted(set(state["recorded"]) - set(metadata))
+    if missing:
+        problems.append(f"missing recorded fields: {missing}")
+    wrong = {
+        key: (metadata[key], value)
+        for key, value in state["recorded"].items()
+        if key in metadata and not json_equal(metadata[key], value)
+    }
+    if wrong:
+        problems.append(f"recorded values do not match: {wrong}")
+
+    if require_derived or any(key in metadata for key in INTERPRETER_FIELDS):
+        interpreter, reason = reported_interpreter(metadata)
+        if reason:
+            problems.append(reason)
+        elif interpreter != state["interpreter"]:
+            problems.append(f"interpreter {interpreter!r} != {state['interpreter']!r}")
+
+    if require_derived or any(key in metadata for key in ("compressed", "compression")):
+        compressed, reason = reported_compression(metadata)
+        if reason:
+            problems.append(reason)
+        elif compressed != state["compressed"]:
+            problems.append(
+                f"compression {compressed!r} != {state['compressed']!r} "
+                f"(member types {state['compress_types']})"
+            )
+    return problems
+
+
+def text_state_mismatches(occurrences, state, *, require_derived=False):
+    """Explain why a rendered text report is not one complete archive version.
+
+    ``occurrences`` is the ordered ``(label, raw value)`` list a text view
+    produced, so each value is compared with the label it was printed under
+    rather than with the whole output.  Values are decoded according to the type
+    the archive records, which normalizes whitespace, boolean spellings and
+    multi-line structures; repeated labels must agree with each other.
+
+    As with :func:`state_mismatches`, derived state is checked whenever it is
+    printed and must always name the same version as the recorded fields;
+    ``require_derived`` additionally demands that it be printed at all.
+    """
+    problems = []
+    for key, expected in state["recorded"].items():
+        decoded, issues = _decoded_occurrences(occurrences, key, expected)
+        problems.extend(issues)
+        if not decoded:
+            if not any(label == key for label, _ in occurrences):
+                problems.append(f"missing recorded field: {key}")
+            continue
+        for value in decoded:
+            if not json_equal(value, expected):
+                problems.append(f"{key}: {value!r} != recorded {expected!r}")
+
+    # Interpreter: canonical field and shebang line are equivalent spellings of
+    # the same fact; both must name the archive's own interpreter.
+    if require_derived or any(label in INTERPRETER_FIELDS for label, _ in occurrences):
+        interpreter_forms = {}
+        for key in INTERPRETER_FIELDS:
+            decoded, issues = _decoded_occurrences(occurrences, key, "")
+            problems.extend(issues)
+            for value in decoded:
+                normalized, reason = normalize_interpreter(value)
+                if reason:
+                    problems.append(f"{key}: {reason}")
+                else:
+                    interpreter_forms.setdefault(normalized, []).append(key)
+        if not interpreter_forms:
+            problems.append("no interpreter reported")
+        elif len(interpreter_forms) > 1:
+            problems.append(
+                f"conflicting interpreter representations: {sorted(interpreter_forms)}"
+            )
+        else:
+            reported = next(iter(interpreter_forms))
+            if reported != state["interpreter"]:
+                problems.append(f"interpreter: {reported!r} != {state['interpreter']!r}")
+
+    # Compression: boolean flag and method name are equivalent spellings.
+    if require_derived or any(label in ("compressed", "compression") for label, _ in occurrences):
+        compression_pairs = []
+        decoded, issues = _decoded_occurrences(occurrences, "compressed", True)
+        problems.extend(issues)
+        compression_pairs.extend(("compressed", value) for value in decoded)
+        decoded, issues = _decoded_occurrences(occurrences, "compression", "")
+        problems.extend(issues)
+        for value in decoded:
+            name = value.strip().lower() if isinstance(value, str) else None
+            if name not in COMPRESSION_NAMES:
+                problems.append(f"compression: {value!r} is not a recognized compression name")
+            else:
+                compression_pairs.append(("compression", COMPRESSION_NAMES[name]))
+        compressed, reason = combine_compression(compression_pairs)
+        if reason:
+            problems.append(reason)
+        elif compressed != state["compressed"]:
+            problems.append(f"compression: {compressed!r} != {state['compressed']!r}")
+    return problems
+
+
+REAL_MMAP = mmap.mmap
+
+
+class _ReadWindow:
+    """A file object that reports the start and end of each real read."""
+
+    def __init__(self, handle, fixture):
+        self._handle = handle
+        self._fixture = fixture
+
+    def _read(self, method, *args, **kwargs):
+        self._fixture.read_started()
+        try:
+            return getattr(self._handle, method)(*args, **kwargs)
+        finally:
+            self._fixture.read_finished()
+
+    def read(self, *args, **kwargs):
+        return self._read("read", *args, **kwargs)
+
+    def read1(self, *args, **kwargs):
+        return self._read("read1", *args, **kwargs)
+
+    def readinto(self, *args, **kwargs):
+        return self._read("readinto", *args, **kwargs)
+
+    def readline(self, *args, **kwargs):
+        return self._read("readline", *args, **kwargs)
+
+    def readlines(self, *args, **kwargs):
+        return self._read("readlines", *args, **kwargs)
+
+    def peek(self, *args, **kwargs):
+        return self._read("peek", *args, **kwargs)
+
+    def __iter__(self):
+        while True:
+            line = self.readline()
+            if not line:
+                return
+            yield line
+
+    def __enter__(self):
+        self._handle.__enter__()
+        return self
+
+    def __exit__(self, *exc_info):
+        return self._handle.__exit__(*exc_info)
+
+    def __getattr__(self, name):
+        return getattr(self._handle, name)
+
+
+class _TrackingMmap(REAL_MMAP):
+    """An ``mmap`` that reports reads of the inspected archive.
+
+    ``mmap`` is a legitimate way to read an archive, so an implementation using
+    it must be interleaved rather than reported as an unobserved read.  A
+    mapping does not expose the descriptor it was created from, so the tracked
+    decision is taken at construction time; the mapping itself stays valid after
+    that descriptor closes, and a later mapping of an unrelated file cannot
+    inherit a reused descriptor number.
+    """
+
+    fixture = None
+
+    def __new__(cls, fileno, length, *args, **kwargs):
+        fixture = cls.fixture
+        tracked = fixture is not None and fixture.is_watched_fd(fileno)
+        instance = REAL_MMAP.__new__(cls, fileno, length, *args, **kwargs)
+        instance._shiv_tracked = tracked
+        return instance
+
+    def _track(self, call):
+        fixture = type(self).fixture
+        if not getattr(self, "_shiv_tracked", False) or fixture is None:
+            return call()
+        fixture.read_started()
+        try:
+            return call()
+        finally:
+            fixture.read_finished()
+
+    def __getitem__(self, key):
+        return self._track(lambda: REAL_MMAP.__getitem__(self, key))
+
+    def read(self, n=-1):
+        return self._track(lambda: REAL_MMAP.read(self, n))
+
+    def readline(self):
+        return self._track(lambda: REAL_MMAP.readline(self))
+
+    def read_byte(self):
+        return self._track(lambda: REAL_MMAP.read_byte(self))
+
+
+class _ArchiveSwapFixture:
+    """Replace the inspected archive while a reader is between reads.
+
+    A reader of the path receives the bytes published when it resolved the path;
+    the fixture replaces the path from inside that reader's first read, so the
+    event log is ``open -> read-start -> swap -> read-end``.  The path itself is
+    never held open while it is replaced, so the same interleaving works on
+    platforms that refuse to replace an open file.
+
+    One handle keeps the version it resolved; a reader that re-resolves the path
+    sees the new version.  Both are legitimate.  A report that mixes the two
+    describes no archive that ever existed.
+
+    Every ordinary read entry point is routed: ``open``, ``io.open`` (which also
+    serves ``pathlib``), ``os.open`` with ``os.read``/``os.pread``/``os.readv``/
+    ``os.preadv``, and ``mmap``.  A read API outside that set cannot be
+    interleaved; the caller records that as unfinished evaluation.
+    """
+
+    def __init__(self, target, replacement, snapshot_dir, *, real_open, real_os_open):
+        self.target_path = Path(target)
+        self.target = os.path.normcase(str(target))
+        self.replacement = replacement
+        self.snapshot = snapshot_dir / "snapshot.pyz"
+        self.real_open = real_open
+        self.real_os_open = real_os_open
+        self.one_bytes = None
+        self.two_bytes = None
+        self.events = []
+        self.swapped = False
+        self.snapshot_ready = False
+        self.archive_identities = set()
+
+    def reset(self, one_bytes, two_bytes):
+        """Restore both versions so one run starts from a known state."""
+        self.one_bytes = one_bytes
+        self.two_bytes = two_bytes
+        self.target_path.write_bytes(one_bytes)
+        self.replacement.write_bytes(two_bytes)
+        self.events = []
+        self.swapped = False
+        self.snapshot_ready = False
+        self.archive_identities = set()
+
+    def is_target(self, path):
+        try:
+            return os.path.normcase(str(path)) == self.target
+        except Exception:
+            return False
+
+    def watch_fd(self, fd):
+        """Remember a descriptor that refers to the inspected archive."""
+        if isinstance(fd, int) and fd >= 0:
+            info = os.fstat(fd)
+            self.archive_identities.add((info.st_dev, info.st_ino))
+
+    def is_watched_fd(self, fd):
+        """Check the current file, not a descriptor number that may be reused."""
+        if not isinstance(fd, int) or fd < 0:
+            return False
+        try:
+            info = os.fstat(fd)
+        except OSError:
+            return False
+        return (info.st_dev, info.st_ino) in self.archive_identities
+
+    def _prepare_snapshot(self):
+        if not self.snapshot_ready:
+            with self.real_open(str(self.target_path), "rb") as handle:
+                self.snapshot.write_bytes(handle.read())
+            self.snapshot_ready = True
+
+    def opening(self, path):
+        """Resolve one open of the inspected path to the version it names."""
+        self.events.append("open")
+        if self.swapped:
+            # The path now holds the other complete version; resolving it
+            # again is what a later open of a replaced archive sees.
+            return str(self.target_path)
+        self._prepare_snapshot()
+        return str(self.snapshot)
+
+    def swap(self):
+        """Publish the other complete version at the inspected path, once."""
+        if self.swapped:
+            return
+        os.replace(str(self.replacement), str(self.target_path))
+        self.swapped = True
+        self.events.append("swap")
+
+    def read_started(self):
+        self.events.append("read-start")
+        self.swap()
+
+    def read_finished(self):
+        self.events.append("read-end")
+
+    def interleaved(self):
+        """True when a read began, the archive was replaced, and a read ended."""
+        try:
+            start = self.events.index("read-start")
+            swap_at = self.events.index("swap")
+            end = max(i for i, label in enumerate(self.events) if label == "read-end")
+        except ValueError:
+            return False
+        return start < swap_at <= end
+
+    def wrap(self, handle):
+        return _ReadWindow(handle, self)
+
+    @contextlib.contextmanager
+    def routing(self):
+        """Install the patched read entry points for the duration of one run."""
+        def patched_open(file, *args, **kwargs):
+            if self.is_target(file):
+                handle = self.real_open(self.opening(file), *args, **kwargs)
+                wrapped = self.wrap(handle)
+                try:
+                    self.watch_fd(handle.fileno())
+                except (AttributeError, OSError, ValueError):
+                    pass
+                return wrapped
+            return self.real_open(file, *args, **kwargs)
+
+        def patched_os_open(path, *args, **kwargs):
+            if self.is_target(path):
+                fd = self.real_os_open(self.opening(path), *args, **kwargs)
+                self.watch_fd(fd)
+                return fd
+            return self.real_os_open(path, *args, **kwargs)
+
+        def descriptor_reads():
+            """Route every descriptor read Python exposes on this platform.
+
+            ``os.read`` is only one of them: ``os.pread``/``os.preadv``
+            (positional reads) and ``os.readv`` (scatter reads) are equally
+            legitimate ways to read an archive from a descriptor.
+            """
+            for name in ("read", "pread", "readv", "preadv"):
+                real_read = getattr(os, name, None)
+                if real_read is None:
+                    continue
+
+                def make(reader):
+                    def wrapper(*args, **kwargs):
+                        fd = args[0] if args else kwargs.get("fd")
+                        if self.is_watched_fd(fd):
+                            self.read_started()
+                            try:
+                                return reader(*args, **kwargs)
+                            finally:
+                                self.read_finished()
+                        return reader(*args, **kwargs)
+                    return wrapper
+
+                yield f"os.{name}", make(real_read)
+
+        _TrackingMmap.fixture = self
+        try:
+            with ExitStack() as stack:
+                stack.enter_context(mock.patch("builtins.open", side_effect=patched_open))
+                stack.enter_context(mock.patch("io.open", side_effect=patched_open))
+                stack.enter_context(mock.patch("os.open", side_effect=patched_os_open))
+                for name, wrapper in descriptor_reads():
+                    stack.enter_context(mock.patch(name, side_effect=wrapper))
+                stack.enter_context(mock.patch("mmap.mmap", _TrackingMmap))
+                yield
+        finally:
+            _TrackingMmap.fixture = None
+
+
+def last_error_category(text):
+    """The final exception class of a traceback, without module qualification."""
+    lines = [line.strip() for line in text.splitlines() if line.strip()]
+    if not lines or ":" not in lines[-1]:
+        return None
+    return lines[-1].split(":", 1)[0].split(".")[-1]
+
+
+def assert_info_rejection(python, target, mode, category, fragment, label):
+    """One bad input must fail with its own category, channel and no success shape."""
+    proc = run_isolated(
+        [str(python), "-c", "from shiv.info import main; main()", *mode, str(target)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    assert proc.returncode == 1, (
+        f"{label}: the documented invalid-input status is 1, got {proc.returncode}"
+    )
+    assert proc.stdout.strip() == "", (
+        f"{label}: no success output may be produced, got {proc.stdout!r}"
+    )
+    assert "pyz file:" not in proc.stdout, f"{label}: the success header must not appear"
+    assert proc.stderr.strip() != "", f"{label}: the diagnostic must be written to stderr"
+    observed = last_error_category(proc.stderr)
+    assert observed == category, (
+        f"{label}: expected the {category} diagnostic, got {observed!r}"
+    )
+    assert fragment in proc.stderr, (
+        f"{label}: the diagnostic must name the underlying cause ({fragment!r})"
+    )
+    try:
+        parsed = json.loads(proc.stdout)
+    except ValueError:
+        parsed = None
+    assert parsed is None, (
+        f"{label}: no success-shaped JSON may be produced, got {parsed!r}"
+    )
+
