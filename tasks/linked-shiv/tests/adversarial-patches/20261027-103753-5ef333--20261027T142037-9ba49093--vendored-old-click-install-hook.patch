+
+    elif scenario == "same_account_state_attack":
+        # The attacker runs as the same account as the extraction, so it can read
+        # and write every per-user state directory the implementation can read, and
+        # it can write the extraction directory just as well.  Nothing kept where
+        # this account can reach it is a secret from this attacker.
+        #
+        # This scenario therefore does what such an attacker would.  It interrupts a
+        # real replacement first, so whatever transaction state the implementation
+        # keeps is on disk and can be observed -- including the exact paths and
+        # field names it chose.  It then reads every byte string that state exposes,
+        # plants its own temporary and backup siblings carrying foreign content, and
+        # writes records naming them: at the exact path the implementation used, at
+        # record-shaped names derived from the target, and beside the target.
+        #
