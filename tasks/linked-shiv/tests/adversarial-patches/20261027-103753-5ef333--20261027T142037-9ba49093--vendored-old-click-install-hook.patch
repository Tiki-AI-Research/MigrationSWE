+        # the archive, no planted sibling is published or leaks into the result, and
+        # everything the attacker planted is left in place.
+        archive_path = tmp_path / "same_own.zip"
+        archive = make_archive(archive_path, [
+            ("site-packages/mod.py", "VALUE = 'ARCHIVE'\n"),
+            ("site-packages/keep.py", "KEEP = 1\n"),
+        ])
+        directory = tmp_path / "same_account"
+        directory.mkdir()
+        target = directory / "root"
+
+        attacker_home = tmp_path / "attacker_home"
+        attacker_local = tmp_path / "attacker_local"
+        attacker_roaming = tmp_path / "attacker_roaming"
+        attacker_state = attacker_home / ".local" / "state"
+        for path in (attacker_home, attacker_local, attacker_roaming, attacker_state):
+            path.mkdir(parents=True, exist_ok=True)
