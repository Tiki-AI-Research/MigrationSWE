+@pytest.mark.parametrize(
+    "scenario",
+    [
+        "nested_initial",
+        "force_replace",
+        "compile_error_cleanup",
+        "compile_syntax_error_rejected",
+        "incomplete_extraction_rejected",
+        "install_failure_rollback",
+        "cleanup_failure_after_publish",
+        "cleanup_failure_after_build_error",
+        "same_call_path_swap_not_deleted",
+        "publish_swap_not_adopted",
+        "rollback_swap_not_adopted",
+        "identity_error_not_swallowed",
+        "final_unlink_swap_detected",
+        "restore_name_conflict_not_overwritten",
+        "private_cleanup_name_swap_not_deleted",
+        "child_entry_swap_not_deleted",
+        "interrupted_recovery",
+        "recovery_is_repeatable",
+        "external_state_left_alone",
+        "forged_transaction_record",
+        "forged_valid_token_record",
+        "same_account_state_attack",
+        "swapped_backup_not_adopted",
+        "duplicate_last_wins",
+    ],
+)
+def test_p2p_036_extract_site_packages(tmp_path, scenario):
+    """P2P-036: extraction is transactional over the state it owns.
+
+    State ownership, stated explicitly rather than left to a test comment (the
+    matching record lives in ``case-observation-inventory.json`` under
+    ``coverage_reasons`` as ``EXC-P2P-036-STATE-OWNERSHIP``).  The properties
+    below are the ones that can actually be enforced:
+
+    * The extraction may only clean, adopt or publish state that *it* created or
+      moved in the same call.  A directory left behind by an earlier process is
+      not that: ``external_state_left_alone``, ``forged_transaction_record``,
+      ``forged_valid_token_record``, ``same_account_state_attack`` and
+      ``swapped_backup_not_adopted`` plant such siblings and require them to
+      survive, to stay out of the result, and never to be adopted as it.
+    * No record kept where an extraction can reach it can turn such a leftover
+      into owned state, so nothing is decided by one.  Three shapes are covered:
+      a hand-written record at the expected path, a record bound to another
+      directory, and a well-formed record replayed from an observed real
+      transaction with the writer's own token and siblings.  ``same_account_state_attack``
+      then covers the strongest case: an attacker that interrupts a real
+      replacement first, so the implementation's own record path, field names and
+      canonical path forms are observable, and that reads every byte string the
+      account's own state exposes to mint tags under the usual keyed and
+      plain-hash constructions.  Whatever an extraction can reach, a process able
+      to write the extraction directory can equally produce, so the only sound
+      answer is to trust none of it.
+    * ``interrupted_recovery`` and ``recovery_is_repeatable`` interrupt a
+      replacement in a child process, so the state under test is real.  Because
+      the interrupted state cannot be attributed, a later call recovers the way
+      the contract allows: it finds no usable result, builds a complete one from
+      the archive it was handed, and completes normally without manual cleanup,
+      without adopting that state as the result and without deleting it.
+    * ``incomplete_extraction_rejected`` covers the archive that cannot produce a
+      result at all: the failure is reported, no partial target is published, an
+      existing complete result survives a rejected replacement byte-for-byte, and
+      a later usable archive is not blocked by the failed attempt.
+    * ``cleanup_failure_after_publish`` and ``cleanup_failure_after_build_error``
+      cover the cleanup of this call's own state failing.  Cleanup is never
+      silent: a published result stays published but the call raises a cleanup
+      error naming the residue, and a build failure keeps its original exception
+      with the cleanup failure attached.  Neither outcome may reach a sibling this
+      call did not create, and later calls leave the residue alone.
+    * ``install_failure_rollback`` covers the failure a caller observes
+      directly: a failure while publishing leaves the previous complete result
+      readable and re-raises the original error, because that displacement was
+      performed by the same call and is therefore reversible within it.
+    * Every scenario asserts the target content, the complete temporary/backup
+      state of the surrounding directory, and the propagation of the original
+      error, rather than only "no exception was raised".
+    """
+
+    def make_archive(path, members):
+        with zipfile.ZipFile(str(path), "w") as archive:
+            for name, data in members:
+                archive.writestr(name, data)
+        return zipfile.ZipFile(str(path))
+
+    def entries(directory):
+        try:
+            return sorted(path.name for path in Path(directory).iterdir())
+        except FileNotFoundError:
+            return []
+
+    def markers(directory):
+        """Every temporary or backup name in a directory, owned or foreign."""
+        return sorted(name for name in entries(directory) if ".tmp" in name or ".bak" in name)
+
+    def unowned(directory, planted):
+        """Temporary/backup names that are not one of the planted foreign entries."""
+        return sorted(name for name in markers(directory) if name not in planted)
+
+    def inner_markers(result):
+        """Temporary or backup names anywhere inside a produced result tree."""
+        if not Path(result).exists():
+            return []
+        return sorted(
+            str(path.relative_to(result))
+            for path in Path(result).rglob("*")
+            if ".tmp" in path.name or ".bak" in path.name
+        )
+
+    def json_files(directory):
+        """Files anywhere under a directory that parse as a JSON object."""
+        found = []
+        for path in sorted(Path(directory).rglob("*")):
+            if not path.is_file():
+                continue
+            try:
+                data = json.loads(path.read_text(encoding="utf-8"))
+            except (OSError, ValueError):
+                continue
+            if isinstance(data, dict):
+                found.append(path)
+        return found
+
+    def planted_record(directory, target, token, tmp_name, backup_name, extra=None):
+        """A record of the shape an implementation could plausibly read.
+
+        It carries the field values any writer of this directory can know or
+        copy: the parent spelling, the target name, a well-formed token, and the
+        names of the siblings it names.
+        """
+        record = {
+            "schema": "shiv-extraction-transaction:3",
+            "parent": str(directory),
+            "parent_canonical": os.path.normcase(os.path.normpath(str(directory))),
+            "target": target.name,
+            "transaction": token,
+            "tmp": tmp_name,
+            "backup": backup_name,
+        }
+        record.update(extra or {})
+        return record
+
+    def process_state_roots():
+        """The per-user locations an implementation could keep a key or record in."""
+        roots = {}
+        for name in ("LOCALAPPDATA", "APPDATA", "XDG_STATE_HOME", "HOME", "USERPROFILE"):
+            value = os.environ.get(name)
+            if value:
+                roots[name] = Path(value)
+        roots.setdefault("home", Path.home())
+        return roots
+
+    def state_snapshot(roots):
+        """Everything currently stored under those per-user locations."""
+        found = []
+        for name, root in roots.items():
+            if not root.is_dir():
+                continue
+            try:
+                children = sorted(root.iterdir())
+            except OSError:
+                continue
+            for child in children:
+                found.append(f"{name}/{child.name}")
+        return sorted(found)
+
+    def plant_foreign(directory, name, payload="VALUE = 'FOREIGN'\n"):
+        """A sibling tree this operation never created for this target."""
+        planted = Path(directory) / name
+        (planted / "site-packages").mkdir(parents=True)
+        (planted / "site-packages" / "foreign_mod.py").write_text(payload)
+        (planted / "rogue.txt").write_text("rogue\n")
+        return planted
+
+    def foreign_content_in(directory, name):
+        """Any planted foreign payload still stored under one directory entry."""
+        found = []
+        entry = Path(directory) / name
+        if not entry.is_dir():
+            return found
+        for path in entry.rglob("*"):
+            if path.is_file():
+                try:
+                    text = path.read_text(encoding="utf-8", errors="ignore")
+                except OSError:
+                    continue
+                if "FOREIGN" in text or path.name == "rogue.txt":
+                    found.append(str(path.relative_to(directory)))
+        return sorted(found)
+
+    def leaked_foreign(result):
+        """Foreign payload that ended up inside a published result tree."""
+        if not Path(result).exists():
+            return []
+        return sorted(
+            str(path.relative_to(result))
+            for path in Path(result).rglob("*")
+            if path.is_file() and (
+                "FOREIGN" in path.read_text(encoding="utf-8", errors="ignore")
+                or path.name == "rogue.txt"
+            )
+        )
+
+    def is_target(value, target_text):
+        """True when an operation is publishing at the target path itself."""
+        text = str(value)
+        if text.startswith("\\\\?\\UNC\\"):
+            text = "\\\\" + text[8:]
+        elif text.startswith("\\\\?\\"):
+            text = text[4:]
+        return os.path.normcase(os.path.normpath(text.rstrip("\\/"))) == os.path.normcase(
+            os.path.normpath(target_text.rstrip("\\/"))
+        )
+
+    def crash_at_publish(replacement_path, target, tree_root, env=None):
+        """Interrupt a replacement in a child process as it publishes at the target.
+
+        The state left behind is whatever the interrupted process had on disk;
+        naming it is the implementation's own business, so the crash matches on
+        the destination path across every rename primitive and stops the process
+        before the result can be published.
+        """
+        crash_script = (
+            "import os, sys, zipfile, shutil\n"
+            "from pathlib import Path\n"
+            "sys.path.insert(0, sys.argv[3])\n"
+            "from shiv.bootstrap import extract_site_packages\n"
+            "BS = chr(92)\n"
+            "EXT = BS + BS + '?' + BS\n"
+            "UNC = EXT + 'UNC' + BS\n"
+            "target = Path(sys.argv[2])\n"
+            "normalized = os.path.normcase(os.path.realpath(str(target)))\n"
+            "def matches(value):\n"
+            "    text = str(value)\n"
+            "    if text.startswith(UNC):\n"
+            "        text = BS + BS + text[8:]\n"
+            "    elif text.startswith(EXT):\n"
+            "        text = text[4:]\n"
+            "    return os.path.normcase(os.path.realpath(text)) == normalized\n"
+            "for name in ('replace', 'rename'):\n"
+            "    original = getattr(os, name)\n"
+            "    def guard(source, destination, _original=original, *args, **kwargs):\n"
+            "        if matches(destination):\n"
+            "            os._exit(17)\n"
+            "        return _original(source, destination, *args, **kwargs)\n"
+            "    setattr(os, name, guard)\n"
+            "_move = shutil.move\n"
+            "def move(source, destination, *args, **kwargs):\n"
+            "    if matches(destination):\n"
+            "        os._exit(17)\n"
+            "    return _move(source, destination, *args, **kwargs)\n"
+            "shutil.move = move\n"
+            # Windows publishes by renaming the verified handle, so that is the
+            # primitive the interruption has to intercept there; it is bound to
+            # the object rather than to a path.
+            "import shiv.bootstrap as boot\n"
+            "_handle_move = getattr(boot, '_windows_move_by_handle', None)\n"
+            "if _handle_move is not None:\n"
+            "    def guard_handle_move(source, identity, destination, label):\n"
+            "        if matches(destination):\n"
+            "            os._exit(17)\n"
+            "        return _handle_move(source, identity, destination, label)\n"
+            "    boot._windows_move_by_handle = guard_handle_move\n"
+            "with zipfile.ZipFile(sys.argv[1]) as archive:\n"
+            "    extract_site_packages(archive, target, compile_pyc=False, force=True)\n"
+        )
+        proc = run_isolated(
+            [sys.executable, "-c", crash_script, str(replacement_path), str(target), tree_root],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            env=env,
+        )
+        assert proc.returncode == 17, (proc.returncode, proc.stdout, proc.stderr)
+        return proc
+
+    def ordinary_call(shiv_root, archive_path, target, env=None):
+        """One plain extraction through a fresh interpreter."""
+        return run_isolated(
+            [sys.executable, "-c",
+             "import sys, zipfile\n"
+             "from pathlib import Path\n"
+             "sys.path.insert(0, sys.argv[1])\n"
+             "from shiv.bootstrap import extract_site_packages\n"
+             "with zipfile.ZipFile(sys.argv[2]) as z:\n"
+             "    extract_site_packages(z, Path(sys.argv[3]), compile_pyc=False, force=False)\n",
+             str(shiv_root), str(archive_path), str(target)],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            env=env,
+        )
+
+    def archive_bytes(archive_path, member):
+        with zipfile.ZipFile(str(archive_path)) as archive:
+            return archive.read(member)
+
+    def removal_failure_hooks(suffix):
+        """Fail the first destructive removal of an entry whose path has ``suffix``.
+
+        The hook fires on the *last* removal of that path, i.e. the one that
+        actually deletes it: on POSIX that is ``rmdir``/``unlink`` with a
+        directory descriptor; on Windows it is the deletion of the entry itself,
+        not of its children.  Nothing else the implementation does is affected,
+        so the injected failure describes cleanup and nothing else.
+        """
+        module = __import__("shiv.bootstrap", fromlist=["bootstrap"])
+        original_unlink = os.unlink
+        original_rmdir = os.rmdir
+        original_handle = getattr(module, "_windows_handle", None)
+        original_delete = getattr(module, "_windows_delete", None)
+        state = {"fired": False}
+        seen = {"paths": []}
+
+        def fire(name):
+            if state["fired"] or suffix not in str(name):
+                return False
+            state["fired"] = True
+            return True
+
+        def failing_unlink(path, *args, **kwargs):
+            if kwargs.get("dir_fd") is not None and fire(path):
+                raise OSError("injected cleanup failure")
+            return original_unlink(path, *args, **kwargs)
+
+        def failing_rmdir(path, *args, **kwargs):
+            if kwargs.get("dir_fd") is not None and fire(path):
+                raise OSError("injected cleanup failure")
+            return original_rmdir(path, *args, **kwargs)
+
+        patches = [
+            mock.patch("os.unlink", side_effect=failing_unlink),
+            mock.patch("os.rmdir", side_effect=failing_rmdir),
+        ]
+        if original_delete is not None:
+            def tracking_handle(path, *args, **kwargs):
+                seen["paths"].append(str(path))
+                return original_handle(path, *args, **kwargs)
+
+            def failing_delete(kernel32, handle):
+                # The entry itself is the last thing deleted for that path.
+                if seen["paths"] and fire(seen["paths"][-1]):
+                    raise OSError("injected cleanup failure")
+                return original_delete(kernel32, handle)
+
+            patches.append(mock.patch.object(module, "_windows_handle", side_effect=tracking_handle))
+            patches.append(mock.patch.object(module, "_windows_delete", side_effect=failing_delete))
+        return patches, state
+
+    def swap_after_check_hooks(suffix, marker, *, name_filter=None, as_dir=True):
+        """Replace an entry immediately after the implementation inspects it.
+
+        This is the deterministic form of the race the manual describes: the
+        implementation has resolved the entry (``stat``) or obtained a handle or
+        descriptor for it, and the writer replaces the name at exactly that
+        point.  A cleanup that then acts on the *name* deletes the replacement,
+        or recurses into it and empties it; a cleanup that acts through the
+        object cannot.
+
+        ``as_dir`` decides what the replacement is: a foreign directory, which
+        must not be recursively emptied, or a foreign file, which must not be
+        unlinked.  Two outcomes are recorded, and both are correct:
+
+        * ``marker["prevented"]`` -- the platform refused the swap because the
+          implementation holds the object;
+        * ``marker["planted"]`` -- the swap landed, and the replacement must then
+          survive untouched.
+        """
+        module = __import__("shiv.bootstrap", fromlist=["bootstrap"])
+        original_open = os.open
+        original_close = os.close
+        original_stat = os.stat
+        original_handle = getattr(module, "_windows_handle", None)
+        state = {"armed": True}
+        opened = {}
+
+        def prepare(target):
+            """Move the original aside and leave foreign content at the name."""
+            target = Path(target)
+            held = target.with_name(target.name + ".held")
+            try:
+                os.rename(str(target), str(held))
+            except OSError:
+                return False
+            if as_dir:
+                (target / "site-packages").mkdir(parents=True)
+                (target / "site-packages" / "foreign_mod.py").write_text("VALUE = 'FOREIGN'\n")
+                (target / "rogue.txt").write_text("rogue\n")
+            else:
+                target.write_text("VALUE = 'FOREIGN'\n")
+            marker["foreign"] = target
+            marker["as_dir"] = as_dir
+            marker["planted"] = True
+            return True
+
+        def eligible(text):
+            # Match the entry's own name.  A parent directory such as
+            # ``child_swap_pkg`` must not make every entry under it eligible.
+            name = Path(str(text)).name
+            if suffix not in name:
+                return False
+            if name_filter is not None and name_filter not in name:
+                return False
+            return True
+
+        def resolve(path, dir_fd):
+            if dir_fd is None:
+                return Path(str(path))
+            base = opened.get(dir_fd)
+            return None if base is None else base / str(path)
+
+        def fire(path, dir_fd):
+            if not state["armed"] or not eligible(path):
+                return
+            if "planted" in marker or "prevented" in marker:
+                state["armed"] = False
+                return
+            resolved = resolve(path, dir_fd)
+            if resolved is None:
+                return
+            state["armed"] = False
+            if not prepare(resolved):
+                marker["prevented"] = True
+
+        def guarded_stat(path, *args, **kwargs):
+            info = original_stat(path, *args, **kwargs)
+            # Only the descriptor-relative walk is the cleanup race.  Extraction
+            # also stats paths by name before the tree being cleaned exists, and
+            # firing there would plant a replacement too early to test anything.
+            if kwargs.get("dir_fd") is not None:
+                fire(path, kwargs.get("dir_fd"))
+            return info
+
+        def guarded_open(path, *args, **kwargs):
+            dir_fd = kwargs.get("dir_fd")
+            fd = original_open(path, *args, **kwargs)
+            resolved = resolve(path, dir_fd)
+            if resolved is not None:
+                opened[fd] = resolved
+            if dir_fd is not None:
+                fire(path, dir_fd)
+            return fd
+
+        def guarded_close(fd, *args, **kwargs):
+            opened.pop(fd, None)
+            return original_close(fd, *args, **kwargs)
+
+        patches = [
+            mock.patch("os.stat", side_effect=guarded_stat),
+            mock.patch("os.open", side_effect=guarded_open),
+            mock.patch("os.close", side_effect=guarded_close),
+        ]
+        if original_handle is not None:
+            def guarded_handle(path, *args, **kwargs):
+                handle = original_handle(path, *args, **kwargs)
+                if handle is not None:
+                    fire(path, None)
+                return handle
+
+            patches.append(mock.patch.object(module, "_windows_handle", side_effect=guarded_handle))
+        return patches, state
+
+    def publish_swap_hooks(target, marker):
+        """Exchange the temporary tree for a foreign one just before it is published.
+
+        The scenario is about *when* the swap happens, not about which internal
+        helper performs the publish, so the hook covers every primitive that can
+        move the new tree onto the target: the implementation's own verified
+        move when it has one, and the plain rename/replace otherwise.  The
+        foreign tree is preserved inside the directory so the scenario can also
+        assert it was not deleted.
+        """
+        module = __import__("shiv.bootstrap", fromlist=["bootstrap"])
+        original_replace = os.replace
+        original_rename = os.rename
+        original_move = getattr(module, "_move_object", None)
+        target_text = str(target)
+
+        def swap(source):
+            source = Path(source)
+            if "planted" in marker or ".tmp" not in source.name or not source.is_dir():
+                return False
+            held = source.with_name(source.name + ".held")
+            try:
+                os.rename(str(source), str(held))
+            except OSError:
+                marker["prevented"] = True
+                return False
+            (source / "site-packages").mkdir(parents=True)
+            (source / "site-packages" / "foreign_mod.py").write_text("VALUE = 'FOREIGN'\n")
+            (source / "rogue.txt").write_text("rogue\n")
+            marker["planted"] = True
+            marker["foreign"] = source
+            return True
+
+        def path_guard(original):
+            def inner(source, destination, *args, **kwargs):
+                if is_target(destination, target_text) and "planted" not in marker:
+                    swap(source)
+                return original(source, destination, *args, **kwargs)
+
+            return inner
+
+        def move_guard(source, identity, destination, label):
+            if is_target(destination, target_text) and "planted" not in marker:
+                swap(source)
+            return original_move(source, identity, destination, label)
+
+        patches = [
+            mock.patch("os.replace", side_effect=path_guard(original_replace)),
+            mock.patch("os.rename", side_effect=path_guard(original_rename)),
+        ]
+        if original_move is not None:
+            patches.append(mock.patch.object(module, "_move_object", side_effect=move_guard))
+        return patches, {"armed": True}
+
+    def rollback_swap_hooks(target, marker):
+        """Fail publishing once and exchange the backup just before the rollback.
+
+        Like ``publish_swap_hooks``, this covers whichever primitive the
+        implementation uses: the first move onto the target fails, and the next
+        move onto the target (the rollback, whose source is the backup) swaps
+        that source first.  A rollback that acts on the name installs FOREIGN.
+        """
+        module = __import__("shiv.bootstrap", fromlist=["bootstrap"])
+        original_replace = os.replace
+        original_rename = os.rename
+        original_move = getattr(module, "_move_object", None)
+        target_text = str(target)
+        state = {"failed": False}
+
+        def swap(source):
+            source = Path(source)
+            if "planted" in marker or ".bak" not in source.name or not source.is_dir():
+                return
+            held = source.with_name(source.name + ".held")
+            try:
+                os.rename(str(source), str(held))
+            except OSError:
+                marker["prevented"] = True
+                return
+            (source / "site-packages").mkdir(parents=True)
+            (source / "site-packages" / "foreign_mod.py").write_text("VALUE = 'FOREIGN'\n")
+            (source / "rogue.txt").write_text("rogue\n")
+            marker["planted"] = True
+            marker["foreign"] = source
+
+        def path_guard(original):
+            def inner(source, destination, *args, **kwargs):
+                if is_target(destination, target_text):
+                    if not state["failed"]:
+                        state["failed"] = True
+                        raise OSError("simulated install failure")
+                    swap(source)
+                return original(source, destination, *args, **kwargs)
+
+            return inner
+
+        def move_guard(source, identity, destination, label):
+            if is_target(destination, target_text):
+                if not state["failed"]:
+                    state["failed"] = True
+                    raise OSError("simulated install failure")
+                swap(source)
+            return original_move(source, identity, destination, label)
+
+        patches = [
+            mock.patch("os.replace", side_effect=path_guard(original_replace)),
+            mock.patch("os.rename", side_effect=path_guard(original_rename)),
+        ]
+        if original_move is not None:
+            patches.append(mock.patch.object(module, "_move_object", side_effect=move_guard))
+        return patches, {"armed": True}
+
+    def final_unlink_swap_hooks(child_name, marker, *, as_dir):
+        """Exchange a child entry between its descriptor check and its unlink.
+
+        The implementation opens the isolated entry, verifies it through the
+        descriptor, and then removes it by name.  This hook swaps the name at
+        that last moment: the name now holds a foreign object, while the
+        descriptor still refers to the verified one.  The implementation cannot
+        prevent the exchange -- there is no conditional unlink -- so the scenario
+        requires it to detect and report it.
+        """
+        original_unlink = os.unlink
+        original_rmdir = os.rmdir
+
+        def prepare(path):
+            target = Path(path)
+            held = target.with_name(target.name + ".held")
+            try:
+                os.rename(str(target), str(held))
+            except OSError:
+                return False
+            if as_dir:
+                (target / "site-packages").mkdir(parents=True)
+                (target / "site-packages" / "foreign_mod.py").write_text("VALUE = 'FOREIGN'\n")
+                (target / "rogue.txt").write_text("rogue\n")
+            else:
+                target.write_text("VALUE = 'FOREIGN'\n")
+            marker["foreign"] = target
+            marker["planted"] = True
+            return True
+
+        def guard(original, directory):
+            def inner(path, *args, **kwargs):
+                text = Path(str(path)).name
+                parent = kwargs.get("dir_fd")
+                if (
+                    parent is not None
+                    and "planted" not in marker
+                    and child_name in text
+                    and ".cleanup" in text
+                    and directory == as_dir
+                ):
+                    # The removal is relative to a descriptor, so the absolute
+                    # path has to be resolved before the entry can be moved.
+                    try:
+                        base = os.readlink(f"/proc/self/fd/{parent}")
+                    except OSError:
+                        base = None
+                    if base is not None and not prepare(Path(base) / str(path)):
+                        marker["prevented"] = True
+                return original(path, *args, **kwargs)
+
+            return inner
+
+        return [
+            mock.patch("os.unlink", side_effect=guard(original_unlink, False)),
+            mock.patch("os.rmdir", side_effect=guard(original_rmdir, True)),
+        ], {"armed": True}
+
+    def restore_conflict_hooks(child_name, marker):
+        """Fail a removal, then occupy the original name before the restore.
+
+        The implementation moves the entry to a private name and removes it.  If
+        removal fails it hands the entry back to the original name.  This hook
+        makes the removal fail and immediately puts a foreign tree at the
+        original name, which must not be overwritten by the restore.
+        """
+        original_unlink = os.unlink
+        original_rmdir = os.rmdir
+
+        def occupy(parent, original_name):
+            if marker.get("planted") is not None:
+                return
+            # Resolve the parent directory while the descriptor is still valid.
+            try:
+                base = os.readlink(f"/proc/self/fd/{parent}")
+            except OSError:
+                return
+            candidate = Path(base) / original_name
+            if candidate.exists():
+                return
+            try:
+                (candidate / "site-packages").mkdir(parents=True)
+                (candidate / "site-packages" / "foreign_mod.py").write_text("VALUE = 'FOREIGN'\n")
+                (candidate / "rogue.txt").write_text("rogue\n")
+            except OSError:
+                return
+            marker["planted"] = candidate
+
+        def guard(original, directory):
+            def inner(path, *args, **kwargs):
+                parent = kwargs.get("dir_fd")
+                name = Path(str(path)).name
+                if (
+                    parent is not None
+                    and not marker.get("fired")
+                    and child_name in name
+                    and ".cleanup" in name
+                    and directory
+                ):
+                    marker["fired"] = True
+                    # Put the occupant in place before the failure is raised, so
+                    # the restore finds the name taken.
+                    occupy(parent, child_name)
+                    raise OSError("injected cleanup failure")
+                return original(path, *args, **kwargs)
+
+            return inner
+
+        return [
+            mock.patch("os.unlink", side_effect=guard(original_unlink, False)),
+            mock.patch("os.rmdir", side_effect=guard(original_rmdir, True)),
+        ], {"armed": True}
+
+    def private_name_watch_hook(marker):
+        """Record when a whole temporary/backup tree is isolated under a private name.
+
+        The Windows fallback removes a tree by renaming it to a name it mints for
+        the occasion and deleting that entry.  Recording the rename lets the
+        scenario distinguish "this implementation has no private whole-tree name
+        to attack" from "the swap was attempted and survived".  The swap itself
+        is planted by ``rmtree_swap_hook`` (the manual's probe) and by
+        ``swap_after_check_hooks`` (the same window for a handle-based removal).
+        """
+        original_rename = os.rename
+
+        def watching_rename(source, destination, *args, **kwargs):
+            text = str(destination)
+            if ".cleanup" in text and (".bak" in str(source) or ".tmp" in str(source)):
+                marker["private_used"] = True
+            return original_rename(source, destination, *args, **kwargs)
+
+        return [mock.patch("os.rename", side_effect=watching_rename)], {"armed": True}
+
+    def rmtree_swap_hook(suffix, marker):
+        """Replace an entry just before a name-based recursive delete runs.
+
+        This is the manual's Windows probe: if the implementation deletes the
+        private isolation name with ``shutil.rmtree``, the replacement is removed
+        with it.  An implementation that never performs a name-based recursive
+        delete is unaffected, and the replacement survives.
+        """
+        original_rmtree = shutil.rmtree
+
+        def swapping_rmtree(path, *args, **kwargs):
+            text = str(path)
+            if suffix in text and "planted" not in marker:
+                target = Path(text)
+                if target.exists():
+                    original_rmtree(str(target), ignore_errors=True)
+                (target / "site-packages").mkdir(parents=True)
+                (target / "site-packages" / "foreign_mod.py").write_text("VALUE = 'FOREIGN'\n")
+                (target / "rogue.txt").write_text("rogue\n")
+                marker["planted"] = True
+                marker["foreign"] = target
+            return original_rmtree(path, *args, **kwargs)
+
+        return [mock.patch("shutil.rmtree", side_effect=swapping_rmtree)], {"armed": True}
+
+    def foreign_files(*roots):
+        """Every planted file still present under the given directories."""
+        found = []
+        for root in roots:
+            root = Path(root)
+            if not root.exists():
+                continue
+            for path in sorted(root.rglob("*")):
+                if path.is_file() and path.name in ("foreign_mod.py", "rogue.txt"):
+                    found.append(str(path))
+        return found
+
+    if scenario == "nested_initial":
+        archive = make_archive(tmp_path / "nested.zip", [
+            ("site-packages/nested/pkg/__init__.py", "X = 1\n"),
+            ("site-packages/nested/pkg/sub.py", "Y = 2\n"),
+        ])
+        directory = tmp_path / "nested"
+        directory.mkdir()
+        target = directory / "root"
+        extract_site_packages(archive, target, compile_pyc=False, force=False)
+        assert (target / "site-packages" / "nested" / "pkg" / "__init__.py").read_text() == "X = 1\n"
+        assert (target / "site-packages" / "nested" / "pkg" / "sub.py").read_text() == "Y = 2\n"
+        assert markers(directory) == [], "a successful first extraction must leave no temporary or backup state"
+        assert inner_markers(target) == []
+
+    elif scenario == "force_replace":
+        archive = make_archive(tmp_path / "force.zip", [("site-packages/mod.py", "VALUE = 'ORIGINAL'\n")])
+        directory = tmp_path / "force"
+        directory.mkdir()
+        target = directory / "root"
+        extract_site_packages(archive, target)
+        mod = target / "site-packages" / "mod.py"
+        mod.write_text("VALUE = 'TAMPERED'\n")
+        stale = target / "site-packages" / "stale.py"
+        stale.write_text("STALE = 1\n")
+
+        extract_site_packages(archive, target, force=True)
+        assert mod.read_text() == "VALUE = 'ORIGINAL'\n"
+        assert not stale.exists(), "forced extraction must discard stale content"
+        assert markers(directory) == [], (
+            f"a successful forced extraction must leave no temporary or backup state: {markers(directory)}"
+        )
