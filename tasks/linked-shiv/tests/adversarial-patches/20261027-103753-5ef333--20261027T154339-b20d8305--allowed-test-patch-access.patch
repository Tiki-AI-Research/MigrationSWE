+def test_p2p_053_info_archive_snapshot(tmp_path, baseline_envs):
+    """P2P-053: a report produced while the archive is replaced is one complete version.
+
+    Coverage ownership: concurrent replacement of the inspected archive.  Two
+    complete but distinguishable archives are prepared; the fixture replaces the
+    inspected path from inside a read of it, so the event log is
+    ``open -> read-start -> swap -> read-end``.  Every report must match exactly
+    one complete version: a single snapshot and an identity-checked retry are
+    both legitimate, and a reader that mixes two versions matches neither.  The
+    fixture checks itself on the same routing before the candidate runs.
+
+    When the implementation reads through an API the fixture does not route, no
+    interleaving was established.  That is an unfinished evaluation, recorded as
+    such, never a pass.
+    """
+    sp = tmp_path / "sp_snapshot"
+    (sp / "hello").mkdir(parents=True)
+    (sp / "hello" / "__init__.py").write_text("def main():\n    print('hello world')\n")
+
+    version_one = tmp_path / "version_one.pyz"
+    version_two = tmp_path / "version_two.pyz"
+    create_archive(
+        [sp], version_one, str(baseline_envs.source_python), "hello:main",
+        Environment("2026-09-30 00:00:00", "0.0.1", build_id="BUILD-ONE"),
+        compressed=True,
+    )
+    create_archive(
+        [sp], version_two, str(baseline_envs.target_python), "hello:main",
+        Environment("2026-09-30 00:00:00", "0.0.1", build_id="BUILD-TWO"),
+        compressed=False,
+    )
+    one_bytes = version_one.read_bytes()
+    two_bytes = version_two.read_bytes()
+    expected_one = archive_state(version_one)
+    expected_two = archive_state(version_two)
+    assert expected_one["recorded"]["build_id"] != expected_two["recorded"]["build_id"]
+    assert expected_one["interpreter"] != expected_two["interpreter"]
+    assert expected_one["compressed"] != expected_two["compressed"]
+
+    snapshots = tmp_path / "snapshots"
+    snapshots.mkdir()
+    fixture = _ArchiveSwapFixture(
+        version_one, version_two, snapshots,
+        real_open=io.open, real_os_open=os.open,
+    )
+
+    def version_of(report, version_states):
+        for version_state in version_states:
+            if not state_mismatches(report, version_state):
+                return version_state["recorded"]["build_id"]
+        return None
+
+    def text_version_of(output, version_states):
+        occurrences = parse_info_text(output)
+        for version_state in version_states:
+            if not text_state_mismatches(occurrences, version_state):
+                return version_state["recorded"]["build_id"]
+        return None
+
+    def read_report(mode, strategy):
+        """Produce a report through the fixture with one reading strategy.
+
+        ``snapshot`` opens once and reads everything from that handle,
+        ``retry`` re-resolves the path and retries after seeing it change, and
+        ``mix`` deliberately takes the shebang from a later open than the
+        metadata.  Comparing their verdicts proves the fixture exposes the
+        interleaving and that the comparator separates them.
+        """
+        fixture.reset(one_bytes, two_bytes)
+        path = str(fixture.target_path)
+
+        def load_once():
+            with open(path, "rb") as handle:
+                return handle.read()
+
+        if strategy == "snapshot":
+            payload = load_once()
+            shebang_payload = payload
+        elif strategy == "retry":
+            for _ in range(8):
+                payload = load_once()
+                if fixture.target_path.read_bytes() == payload:
+                    break
+            shebang_payload = payload
+        else:
+            payload = load_once()
+            with open(path, "rb") as handle:
+                shebang_payload = handle.read()
+
+        shebang = shebang_payload.split(b"\n", 1)[0].rstrip(b"\r")
+        with zipfile.ZipFile(io.BytesIO(payload)) as archive:
+            recorded = json.loads(archive.read("environment.json"))
+            compress_types = sorted({info.compress_type for info in archive.infolist()})
+        report = dict(recorded)
+        report["interpreter"] = (
+            shebang[2:].decode(sys.getfilesystemencoding()) if shebang.startswith(b"#!") else ""
+        )
+        report["compressed"] = compress_types == [zipfile.ZIP_DEFLATED]
+        if mode == "json":
+            return json.dumps(report)
+        lines = [f"{key}: {value}" for key, value in report.items() if key != "hashes"]
+        lines.append("hashes: " + json.dumps(report["hashes"], sort_keys=True))
+        return "\n".join(lines)
+
+    def run_while_replacing(mode):
+        fixture.reset(one_bytes, two_bytes)
+        with fixture.routing():
+            for strategy in ("snapshot", "retry"):
+                report = read_report(mode, strategy)
+                seen = (
+                    version_of(json.loads(report), (expected_one, expected_two))
+                    if mode == "json"
+                    else text_version_of(report, (expected_one, expected_two))
+                )
+                assert seen is not None, (
+                    f"fixture diagnostic ({mode}/{strategy}): a consistent reader must match "
+                    f"one complete version"
+                )
+            mixed_report = read_report(mode, "mix")
+            seen = (
+                version_of(json.loads(mixed_report), (expected_one, expected_two))
+                if mode == "json"
+                else text_version_of(mixed_report, (expected_one, expected_two))
+            )
+            assert seen is None, (
+                f"fixture diagnostic ({mode}): a reader that mixes the two versions must match "
+                f"neither; events={fixture.events}"
+            )
+
+            fixture.reset(one_bytes, two_bytes)
+            args = ["--json", str(version_one)] if mode == "json" else [str(version_one)]
+            result = CliRunner().invoke(info_main, args)
+
+            events = list(fixture.events)
+            interleaved = fixture.interleaved()
+
+        assert result.exit_code == 0, f"{result.output} (events={events})"
+        # Click 6.7's Result exposes ``output``; later versions add ``stdout``.
+        # Taking whichever exists keeps this node runnable against both the
+        # source baseline and the target runtime.
+        rendered = getattr(result, "stdout", None)
+        if rendered is None:
+            rendered = result.output
+        if mode == "json":
+            chosen = version_of(json.loads(rendered), (expected_one, expected_two))
+        else:
+            chosen = text_version_of(rendered, (expected_one, expected_two))
+        assert chosen is not None, (
+            f"the {mode} report must describe exactly one complete archive version, not a mix "
+            f"of the two; events={events}"
+        )
+        if not interleaved:
+            record_unverified_coverage(
+                "P2P-053",
+                f"no {mode} read of the inspected archive was observed through a routed API, "
+                f"so the replacement could not be interleaved with a read and race behaviour "
+                f"was not verified for this implementation (events={events}). Extend the "
+                f"fixture for the read API this implementation uses.",
+            )
+
+    run_while_replacing("json")
+    run_while_replacing("text")
+
+    # A bad input keeps its own diagnostic instead of a mixed or fabricated report.
+    broken = tmp_path / "not_an_archive.pyz"
+    broken.write_bytes(b"#!/usr/bin/env python\nnot a zip file\n")
+    invalid = CliRunner().invoke(info_main, ["--json", str(broken)])
+    assert invalid.exit_code != 0, "a non-archive must be rejected"
+    diagnostic = f"{invalid.output} {invalid.exception!r}"
+    assert "zip" in diagnostic.lower(), (
+        f"the invalid-input diagnostic must be preserved: {diagnostic!r}"
+    )
+
+
