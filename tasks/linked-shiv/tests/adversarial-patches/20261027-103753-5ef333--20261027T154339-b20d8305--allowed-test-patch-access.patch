+        assert "V = 99" not in (target / "site-packages" / "dup_mod.py").read_text(), (
+            "foreign content must not be preferred over the archive's own last member"
+        )
+        assert inner_markers(target) == [], "the result must contain no temporary or backup state"
+        assert unowned(directory, foreign) == [], (
+            f"the operation must clean up its own state: {markers(directory)}"
+        )
+        for name in sorted(foreign):
+            assert name in entries(directory), (
+                f"a sibling this operation did not create must not be deleted: {name}"
+            )
+
+    else:  # pragma: no cover - the parametrization above is exhaustive
+        raise AssertionError(f"unknown scenario: {scenario}")
