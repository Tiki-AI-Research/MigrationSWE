{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-contract:v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "migration", "requirements", "migration_units", "non_goals", "state_preservation", "normalization_policy"],
  "properties": {
    "schema_version": {"const": "migration-contract:v3"},
    "identity": {"type": "object", "minProperties": 1},
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "source", "target"],
      "properties": {"category": {"enum": ["backend_framework", "language", "version_upgrade"]}, "source": {"$ref": "#/$defs/technology"}, "target": {"$ref": "#/$defs/technology"}}
    },
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "migration_units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "state_preservation": {
      "type": "object", "additionalProperties": false,
      "required": ["applicable", "requirement_ids", "rationale", "invariants"],
      "properties": {"applicable": {"type": "boolean"}, "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "rationale": {"type": "string", "minLength": 1}, "invariants": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    },
    "normalization_policy": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "technology": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "language_name", "language_version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "language_name": {"type": "string", "minLength": 1}, "language_version": {"type": "string", "minLength": 1}}
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "instruction_quote", "observable_surface", "assertion"],
      "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["preserve", "target_postcondition", "state_invariant", "dependency_policy"]}, "instruction_quote": {"type": "string", "minLength": 1}, "observable_surface": {"type": "string", "minLength": 1}, "assertion": {"type": "string", "minLength": 1}}
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {"path": {"type": "string", "minLength": 1}, "type": {"enum": ["file", "directory", "manifest", "symbol"]}}
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "source_locators", "requirement_ids", "target_condition", "validation_methods", "evidence_strategy", "allowed_exceptions"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["file", "directory", "manifest", "api", "dependency", "configuration", "entrypoint"]},
        "source_locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}},
        "target_locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}},
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "target_condition": {"type": "string", "minLength": 1}, "validation_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_strategy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "allowed_exceptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
