{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-grader-spec:v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "group_applicability", "requirements", "gates", "migration_units", "semantic_rules", "public_surface_evidence", "state_checks", "normalization_policy"],
  "properties": {
    "schema_version": {"const": "migration-grader-spec:v4"},
    "group_applicability": {
      "type": "object",
      "required": ["P2P", "F2P", "DIFFERENTIAL", "STATE"],
      "additionalProperties": false,
      "properties": {
        "P2P": {"$ref": "#/$defs/groupApplicability"},
        "F2P": {"$ref": "#/$defs/groupApplicability"},
        "DIFFERENTIAL": {"$ref": "#/$defs/groupApplicability"},
        "STATE": {"$ref": "#/$defs/groupApplicability"}
      }
    },
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
    "migration_units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/migrationUnit"}},
    "semantic_rules": {"type": "array", "items": {"$ref": "#/$defs/semanticRule"}},
    "public_surface_evidence": {"type": "array", "items": {"$ref": "#/$defs/publicSurfaceEvidence"}},
    "state_checks": {"type": "array", "items": {"$ref": "#/$defs/stateCheck"}},
    "normalization_policy": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "groupApplicability": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {"status": {"enum": ["required", "na"]}, "reason": {"type": "string", "minLength": 1}}
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "instruction_quote", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "instruction_quote": {"type": "string", "minLength": 1},
        "kind": {"enum": ["preserve", "target_postcondition", "state_invariant", "dependency_policy"]}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "scenario", "input_class", "projection"],
      "properties": {"surface": {"type": "string", "minLength": 1}, "scenario": {"type": "string", "minLength": 1}, "input_class": {"type": "string", "minLength": 1}, "projection": {"type": "string", "minLength": 1}}
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "requirement_ids", "observation_id", "assertion"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["P2P", "F2P", "DIFFERENTIAL", "STATE"]},
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observation_id": {"type": "string", "minLength": 1},
        "atomic_claim": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "source_expectation": {"enum": ["PASS", "FAIL"]},
        "target_expectation": {"const": "PASS"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVIDENCE-[0-9]{5}$"}},
        "projection_signature": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "assertion": {"type": "object", "required": ["relation"], "properties": {"relation": {"enum": ["equal_after_normalization", "pass", "fail"]}}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["P2P", "F2P"]}}},
          "then": {"required": ["atomic_claim", "family", "source_expectation", "target_expectation", "evidence_refs", "coverage", "projection_signature", "fingerprint"]}
        }
      ]
    },
    "publicSurfaceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "source_path", "requirement_ids", "observation_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "stateCheck": {
      "type": "object", "additionalProperties": false, "required": ["id", "observation_ids", "requirement_ids", "assertion"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "assertion": {"$ref": "#/$defs/assertion"}
      }
    },
    "migrationUnit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "observation_ids"],
      "properties": {"unit_id": {"type": "string", "minLength": 1}, "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["relation"],
      "properties": {"relation": {"enum": ["pass", "fail", "equal_after_normalization"]}}
    },
    "semanticRule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "target", "paths", "source_evidence", "requirement_ids", "calibration"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["literal", "dependency", "import", "file"]},
        "target": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "calibration": {"type": "object", "required": ["operation", "path"], "properties": {"operation": {"enum": ["replace", "anchored_insert", "append", "delete", "copy", "json_pointer_set"]}, "path": {"type": "string", "minLength": 1}, "anchor": {"type": "string"}, "content": {}, "replacement": {}, "json_pointer": {"type": "string"}, "value": {}}}
      }
    }
  }
}
