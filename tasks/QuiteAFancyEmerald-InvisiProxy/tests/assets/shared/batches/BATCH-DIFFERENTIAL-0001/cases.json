    {
      "id": "DIFF-024",
      "requirement_ids": ["R028"],
      "family": "shared-case-corpus",
      "input": {"files": ["views/sw.js", "views/sw-blacklist.js", "views/uv", "views/scram", "src/templates.mjs", "src/source-rewrites.mjs", "config.json", "ecosystem.config.js"]},
      "expect": {"all": "present and byte-identical to the base revision"}
    },
    {
      "id": "DIFF-025",
      "requirement_ids": ["R029"],
      "family": "shared-case-corpus",
      "input": {"review": "migration diff and public validation commands"},
