new file mode 100644
--- /dev/null
+++ b/tests/source/runner
@@ -0,0 +1,22 @@
+#!/usr/bin/env node
+'use strict';
+// Source-side integration entry point for the Fastify -> Express migration.
+//
+// The source runtime image is the original Fastify implementation. Running
+// this entry point executes every required observation against that repository
+// and writes a `migration-observations:v6` report. This file is deliberately
+// CommonJS: the required harness entry `source/runner` has no extension, and
+// CommonJS is the unambiguous interpretation for an extensionless script.
+const path = require('node:path');
+const { pathToFileURL } = require('node:url');
+
+(async () => {
+  const harnessPath = path.resolve(__dirname, '..', 'shared', 'integration', 'harness.mjs');
+  const { run, writeReport } = await import(pathToFileURL(harnessPath).href);
+  const reportPath = process.argv[2] || '/logs/result.json';
+  const report = await run({ side: 'source' });
+  writeReport(report, reportPath);
+})().catch((err) => {
+  process.stderr.write(String((err && err.stack) || err) + '\n');
+  process.exit(1);
+});
