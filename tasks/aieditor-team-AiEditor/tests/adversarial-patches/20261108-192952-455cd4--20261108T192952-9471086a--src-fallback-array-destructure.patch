+// Retained origin transport whose member name is carried by array destructuring.
+const ORIGIN_MEMBER_KEYS = ['responses']
+const [ORIGIN_MEMBER] = ORIGIN_MEMBER_KEYS
+async function callOriginViaDestructure(client: unknown, input: unknown): Promise<unknown> {
