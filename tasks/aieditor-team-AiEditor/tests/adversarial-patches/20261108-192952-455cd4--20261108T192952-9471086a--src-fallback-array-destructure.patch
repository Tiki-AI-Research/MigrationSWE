+export function createEditorFunctionTools(
+  context: AiEditorContext,
+  onProposal: (proposal: AiEditorToolProposal) => void,
+): AgentFunctionTool<any, any, any>[] {
+  return editorFunctionTools.map((definition) => ({
+    type: 'function',
+    name: definition.name,
+    description: definition.description,
+    parameters: definition.parameters as AgentFunctionTool<any, any, any>['parameters'],
+    strict: false,
+    needsApproval: async () => false,
+    invoke: async (_runContext, input: string) => {
+      try {
+        const execution = executeEditorFunctionTool(definition.name, input, context)
+        if (execution.proposal) onProposal(execution.proposal)
+        return execution.output
+      } catch (error) {
+        return {
+          ok: false,
+          error: error instanceof Error ? error.message : 'Tool execution failed',
+        }
+      }
+    },
+  }))
