+  assert(left === right, `${label}: expected ${right}, received ${left}`)
+}
+
+function assertIncludes(haystack, needle, label) {
+  assert(String(haystack).includes(needle), `${label}: expected ${JSON.stringify(needle)} in ${JSON.stringify(haystack)}`)
+}
