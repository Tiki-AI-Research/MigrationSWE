+#!/usr/bin/env node
+import fs from 'node:fs'
+import path from 'node:path'
+import {spawnSync} from 'node:child_process'
+import {fileURLToPath} from 'node:url'
+
+const self = fileURLToPath(import.meta.url)
+const repoRoot = path.resolve(process.argv[2] ?? '/workspace/repo')
+process.env.MIGRATION_REPO_ROOT = repoRoot
+
+if (!process.execArgv.includes('--experimental-strip-types')) {
+  const loader = fileURLToPath(new URL('../../../shared/batches/BATCH-F2P-0003/loader.mjs', import.meta.url))
+  const child = spawnSync(process.execPath, [
+    '--experimental-strip-types',
+    '--experimental-loader',
+    loader,
+    self,
+    ...process.argv.slice(2),
+  ], {stdio: 'inherit', env: process.env})
+  process.exit(child.status ?? 1)
+}
+
+const {runAll, OBSERVATIONS} = await import('../../../shared/batches/BATCH-F2P-0003/probe-suite.mjs')
+const reportPath = process.argv[3]
+const results = await runAll({repoRoot, side: 'source'})
+const report = {
+  batch_id: 'BATCH-F2P-0003',
+  side: 'source',
+  repo_root: repoRoot,
+  expectations: 'FAIL',
+  observations: OBSERVATIONS,
+  results,
+}
+const serialized = `${JSON.stringify(report, null, 2)}\n`
+if (reportPath) {
+  fs.mkdirSync(path.dirname(reportPath), {recursive: true})
+  fs.writeFileSync(reportPath, serialized)
+}
+process.stdout.write(serialized)
+process.exit(results.every((result) => result.status === 'FAIL') ? 0 : 1)
