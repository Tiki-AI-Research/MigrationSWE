+++ b/tests/source/runner
@@ -0,0 +1,31 @@
+#!/bin/sh
+# BATCH-INTEGRATION-0001 source harness entry.
+#
+# Invoked as: {assets}/source/runner {report}
+#
+# Runs every required runtime observation against the repository the source
+# environment mounts (the Superstruct 2.0.2 baseline) and writes the
+# migration-observations:v6 report. The asset root is derived from this
+# script's own location; the repository root is read from the standard
+# MIGRATION_REPO_ROOT / MIGRATION_REPO / REPO_ROOT / REPO variables and falls
+# back to /workspace/repo.
+set -eu
+
+SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+ASSETS_ROOT=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)
+REPORT="${1:-/logs/result.json}"
+
+NODE_BIN=""
+for candidate in node /usr/local/bin/node /usr/bin/node; do
+  if command -v "$candidate" >/dev/null 2>&1; then
+    NODE_BIN="$candidate"
+    break
+  fi
+done
+
+if [ -z "$NODE_BIN" ]; then
+  echo "source/runner: node executable not found" >&2
+  exit 127
+fi
+
+exec "$NODE_BIN" "$ASSETS_ROOT/shared/integration/runner-core.cjs" source "$REPORT"
