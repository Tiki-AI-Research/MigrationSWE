+  "F2P-020": "unknown_key_strict",
+  "F2P-021": "dependency_execution",
+  "F2P-022": "card_parse_zod",
+  "F2P-023": "dependency_execution",
+  "F2P-024": "union_skip",
+};
+
+const OBSERVATION_ORDER = [
+  "F2P-001", "F2P-002", "F2P-004", "F2P-005", "F2P-006", "F2P-007",
+  "F2P-008", "F2P-009", "F2P-011", "F2P-012", "F2P-015", "F2P-017",
+  "F2P-022", "F2P-003", "F2P-010", "F2P-014", "F2P-016", "F2P-018",
+  "F2P-019", "F2P-020", "F2P-024", "F2P-013", "F2P-021", "F2P-023",
+];
+
+function runAll(repoRoot) {
+  const ctx = makeContext(repoRoot);
+  const results = [];
+  for (const id of OBSERVATION_ORDER) {
+    const name = OBSERVATIONS[id];
+    let status;
+    let detail;
+    try {
+      const outcome = predicates[name](ctx);
+      status = outcome.pass ? "PASS" : "FAIL";
+      detail = outcome.detail;
+    } catch (err) {
+      status = "FAIL";
+      detail = "capability missing or not executable: " + err.message;
+    }
+    results.push({ observation_id: id, predicate: name, status, detail });
+  }
+  return { side: null, results };
+}
+
+module.exports = {
+  makeContext,
+  runAll,
+  predicates,
+  OBSERVATIONS,
+  OBSERVATION_ORDER,
+  MIGRATED_MODULES,
+};
diff --git a/tests/shared/batches/BATCH-F2P-0001/ts-loader.js b/tests/shared/batches/BATCH-F2P-0001/ts-loader.js
new file mode 100644
--- /dev/null
+++ b/tests/shared/batches/BATCH-F2P-0001/ts-loader.js
@@ -0,0 +1,141 @@
+"use strict";
+
+/*
+ * Shared on-the-fly TypeScript loader for the BATCH-F2P-0001 probes.
+ *
+ * Both the source and the target probe drivers use this exact loader, so the
+ * semantic predicates run against the real repository sources with one shared
+ * execution mechanism.
+ *
+ * The loader:
+ *   - transpiles the repository .ts modules with the repository's own
+ *     `typescript` dependency (resolved from the repository node_modules),
+ *   - resolves extensionless relative/absolute .ts imports,
+ *   - redirects the frontend-only `src/ha/index.ts` barrel to a generated stub,
+ *     so schema modules can be imported in Node without booting the whole
+ *     browser/Lit graph. The stub re-exports the real `actionConfigStruct`.
+ *
+ * This is an environment shim only: every module under test is executed from
+ * its real repository file. No module under test is replaced.
+ */
+
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+const crypto = require("crypto");
+const Module = require("module");
+
+function resolveDep(name, repoRoot) {
+  const candidates = [
+    path.join(repoRoot, "node_modules", name),
+    path.join(__dirname, "node_modules", name),
+  ];
+  for (const candidate of candidates) {
+    try {
+      return require(candidate);
+    } catch (err) {
+      if (err && err.code === "MODULE_NOT_FOUND" && err.message.includes(candidate)) {
+        continue;
+      }
+      throw err;
+    }
+  }
+  return require(name);
+}
+
+function createRepo(repoRoot) {
+  const root = path.resolve(repoRoot);
+  const ts = resolveDep("typescript", root);
+
+  const stubDir = path.join(
+    os.tmpdir(),
+    "migration-f2p-probe-" +
+      crypto.createHash("sha1").update(root).digest("hex")
+  );
+  fs.mkdirSync(stubDir, { recursive: true });
+  const haStub = path.join(stubDir, "ha-stub.ts");
+  fs.writeFileSync(
+    haStub,
+    'export { actionConfigStruct, actionConfigStructType } from "' +
+      path.join(root, "src/ha/panels/lovelace/editor/structs/action-struct") +
+      '";\n'
+  );
+
+  const compile = (filename, source) => {
+    const src = source != null ? source : fs.readFileSync(filename, "utf8");
+    return ts.transpileModule(src, {
+      compilerOptions: {
+        module: ts.ModuleKind.CommonJS,
+        target: ts.ScriptTarget.ES2020,
+        esModuleInterop: true,
+        experimentalDecorators: true,
+        jsx: ts.JsxEmit.React,
+        resolveJsonModule: true,
+      },
+      fileName: filename,
+    }).outputText;
+  };
+
+  const withExt = (base) => {
+    const candidates = [base, base + ".ts", path.join(base, "index.ts")];
+    for (const candidate of candidates) {
+      try {
+        if (fs.statSync(candidate).isFile()) {
+          return candidate;
+        }
+      } catch (_) {
+        /* keep looking */
+      }
+    }
+    return undefined;
+  };
+
+  const origResolve = Module._resolveFilename;
+  const localResolve = function (request, parent, isMain, options) {
+    if (parent && parent.filename && request.startsWith(".")) {
+      const resolved = withExt(path.resolve(path.dirname(parent.filename), request));
+      if (resolved) {
+        return resolved;
+      }
+    }
+    if (path.isAbsolute(request)) {
+      const resolved = withExt(request);
+      if (resolved) {
+        return resolved;
+      }
+    }
+    return origResolve.call(this, request, parent, isMain, options);
+  };
+  localResolve.__f2p = true;
+
+  const origExtensions = Module._extensions[".ts"];
+  Module._extensions[".ts"] = function (module, filename) {
+    module._compile(compile(filename), filename);
+  };
+
+  const redir = (filename) =>
+    filename.replace(/\\/g, "/").endsWith("/src/ha/index.ts")
+      ? haStub
+      : filename;
+
+  const prev = Module._resolveFilename;
+  Module._resolveFilename = function (request, parent, isMain, options) {
+    const resolved = localResolve.call(this, request, parent, isMain, options);
+    return redir(resolved);
+  };
+
+  const req = (rel) => require(path.join(root, rel));
+
+  const restore = () => {
+    Module._resolveFilename = prev;
+    if (origExtensions) {
+      Module._extensions[".ts"] = origExtensions;
+    } else {
+      delete Module._extensions[".ts"];
+    }
+  };
+
+  return { root, ts, req, compile, resolveDep: (n) => resolveDep(n, root), restore };
+}
+
+module.exports = { createRepo, resolveDep };
diff --git a/tests/shared/batches/BATCH-F2P-0002/load-repo.cjs b/tests/shared/batches/BATCH-F2P-0002/load-repo.cjs
new file mode 100644
--- /dev/null
+++ b/tests/shared/batches/BATCH-F2P-0002/load-repo.cjs
@@ -0,0 +1,144 @@
+"use strict";
+
+// Repo module loader for BATCH-F2P-0002.
+//
+// Loads the migrated configuration modules from a repository working tree by
+// bundling them with the repository's own bundler (rolldown, a transitive
+// dependency of vite) and executing the resulting CommonJS bundle in-process.
+//
+// The reference target is only ever read while authoring; this helper never
+// copies repository sources into the public asset tree.
+
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+const { createRequire } = require("module");
+const { createValidationResult } = require("../../integration/config-validation.cjs");
+
+const SYMBOL_IMPORTS = [
+  ["entitySharedConfigStruct", "src/shared/config/entity-config.ts"],
+  ["entityNameStruct", "src/shared/config/entity-config.ts"],
+  ["appearanceSharedConfigStruct", "src/shared/config/appearance-config.ts"],
+  ["lovelaceCardConfigStruct", "src/shared/config/lovelace-card-config.ts"],
+  ["lovelaceBadgeConfigStruct", "src/shared/config/lovelace-badge-config.ts"],
+  ["actionsSharedConfigStruct", "src/shared/config/actions-config.ts"],
+  ["layoutStruct", "src/utils/layout.ts"],
+  ["actionConfigStruct", "src/ha/panels/lovelace/editor/structs/action-struct.ts"],
+  ["entityCardConfigStruct", "src/cards/entity-card/entity-card-config.ts"],
+  ["handleStructError", "src/ha/common/structs/handle-errors.ts"],
+];
+
+function depDirs(repoRoot) {
+  const dirs = [path.join(repoRoot, "node_modules")];
+  if (process.env.DEPS_NODE_MODULES) {
+    dirs.push(process.env.DEPS_NODE_MODULES);
+  }
+  dirs.push("/opt/migration/dependencies/node_modules");
+  return dirs.filter((d) => {
+    try {
+      return fs.statSync(d).isDirectory();
+    } catch {
+      return false;
+    }
+  });
+}
+
+function makeResolver(dirs) {
+  const requires = dirs.map((d) => createRequire(path.join(d, "noop.js")));
+  return function resolve(spec) {
+    for (const r of requires) {
+      try {
+        return r.resolve(spec);
+      } catch {
+        /* try next */
+      }
+    }
+    return null;
+  };
+}
+
+async function loadSymbols(repoRoot) {
+  const dirs = depDirs(repoRoot);
+  const resolve = makeResolver(dirs);
+  const rolldownPath = resolve("rolldown");
+  if (!rolldownPath) {
+    throw new Error("rolldown is not resolvable from " + dirs.join(", "));
+  }
+  const mod = await import(rolldownPath);
+  const rolldown = mod.rolldown || mod.build;
+  if (typeof rolldown !== "function") {
+    throw new Error("rolldown module does not export a build function");
+  }
+
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "batch-f2p-0002-"));
+  const entry = path.join(tmp, "entry.ts");
+  const outFile = path.join(tmp, "bundle.cjs");
+
+  // The generated bundle keeps zod/superstruct external so the dependency
+  // policy predicate can observe which framework runtime is actually loaded.
+  // Link a node_modules directory next to the bundle so those externals
+  // resolve at require time.
+  const linked = dirs.find((d) => {
+    try {
+      return fs.existsSync(path.join(d, "zod")) || fs.existsSync(path.join(d, "superstruct"));
+    } catch {
+      return false;
+    }
+  });
+  if (linked) {
+    try {
+      fs.symlinkSync(linked, path.join(tmp, "node_modules"), "dir");
+    } catch {
+      /* resolution may still succeed via other means */
+    }
+  }
+
+  const lines = [];
+  for (const [name, rel] of SYMBOL_IMPORTS) {
+    lines.push(
+      'import { ' + name + ' } from ' + JSON.stringify(path.join(repoRoot, rel)) + ";"
+    );
+  }
+  lines.push('import * as configErrorHandling from ' + JSON.stringify(path.join(
+    repoRoot, "src/ha/common/structs/handle-errors.ts"
+  )) + ";");
+  lines.push("export { configErrorHandling };");
+  lines.push(
+    "export { " + SYMBOL_IMPORTS.map(([n]) => n).join(", ") + " };"
+  );
+  fs.writeFileSync(entry, lines.join("\n") + "\n");
+
+  const plugin = {
+    name: "resolve-repo-deps",
+    resolveId(source) {
+      if (source.startsWith(".") || source.startsWith("/")) {
+        return null;
+      }
+      if (source === "zod" || source === "superstruct") {
+        return { id: source, external: true };
+      }
+      const resolved = resolve(source);
+      return resolved ? { id: resolved } : { id: source, external: true };
+    },
+  };
+
+  const bundle = await rolldown({
+    input: entry,
+    platform: "node",
+    treeshake: { moduleSideEffects: false },
+    plugins: [plugin],
+  });
+  await bundle.write({ file: outFile, format: "cjs" });
+
+  const symbols = require(outFile);
+  symbols.validateConfig = createValidationResult(
+    repoRoot, symbols.configErrorHandling, require(resolve("typescript"))
+  );
+  const missing = SYMBOL_IMPORTS.map(([n]) => n).filter((n) => !(n in symbols));
+  if (missing.length) {
+    throw new Error("migrated modules did not export: " + missing.join(", "));
+  }
+  return symbols;
+}
+
+module.exports = { loadSymbols, SYMBOL_IMPORTS };
