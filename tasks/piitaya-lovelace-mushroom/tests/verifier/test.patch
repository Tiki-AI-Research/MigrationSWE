new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe.js
@@ -0,0 +1,65 @@
+"use strict";
+
+// Source-side (Superstruct 2.0.2) DIFFERENTIAL probe for
+// BATCH-DIFFERENTIAL-0001. Loads the baseline schema modules from the source
+// repository and produces the shared normalized projection.
+//
+// Usage: node probe.js <repoRoot> <corpusPath> <outPath>
+//   repoRoot   checkout that contains src/ (source baseline when authoring)
+//   corpusPath fixtures/batches/BATCH-DIFFERENTIAL-0001/fixtures.json
+//   outPath    normalized JSON result file
+
+const fs = require("fs");
+const path = require("path");
+const { loadTs, collapseUnionExpansion, runCorpus } = require(
+  "../../../shared/batches/BATCH-DIFFERENTIAL-0001/harness.js"
+);
+
+const MODULES = {
+  entitySharedConfigStruct: "src/shared/config/entity-config.ts",
+  entityNameStruct: "src/shared/config/entity-config.ts",
+  appearanceSharedConfigStruct: "src/shared/config/appearance-config.ts",
+  layoutStruct: "src/utils/layout.ts",
+  actionConfigStruct: "src/ha/panels/lovelace/editor/structs/action-struct.ts",
+  lovelaceCardConfigStruct: "src/shared/config/lovelace-card-config.ts",
+  lovelaceBadgeConfigStruct: "src/shared/config/lovelace-badge-config.ts",
+  entityCardConfigStruct: "src/cards/entity-card/entity-card-config.ts",
+};
+
+function createAdapter(repoRoot) {
+  const superstruct = require("superstruct");
+  const { handleStructError } = loadTs(
+    repoRoot,
+    "src/ha/common/structs/handle-errors.ts"
+  );
+  const schemas = {};
+  for (const [name, rel] of Object.entries(MODULES)) {
+    const mod = loadTs(repoRoot, rel);
+    if (name in mod) schemas[name] = mod[name];
+  }
+  return {
+    loadSchemas: () => schemas,
+    decide: (schema, input) => {
+      const [err] = superstruct.validate(input, schema);
+      return { accepted: !err, err };
+    },
+    handle: (hass, err) =>
+      handleStructError(hass, collapseUnionExpansion(err)),
+    schemaKeys: (schema) => Object.keys(schema.schema || {}),
+    hasCapability: (schema) => schema != null,
+    handleNative: (hass, message) =>
+      handleStructError(hass, new Error(message)),
+  };
+}
+
+module.exports = { createAdapter, MODULES };
+
+if (require.main === module) {
+  const repoRoot = process.argv[2];
+  const corpusPath = process.argv[3];
+  const outPath = process.argv[4];
+  const corpus = JSON.parse(fs.readFileSync(corpusPath, "utf8")).corpus;
+  const results = runCorpus(corpus, createAdapter(repoRoot), repoRoot);
+  fs.writeFileSync(outPath, JSON.stringify(results, null, 2));
+  console.log("source probe wrote", outPath);
+}
diff --git a/tests/source/batches/BATCH-F2P-0001/probe.js b/tests/source/batches/BATCH-F2P-0001/probe.js
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0001/probe.js
@@ -0,0 +1,40 @@
+"use strict";
+
+/*
+ * BATCH-F2P-0001 source-side probe driver.
+ *
+ * Runs the shared semantic predicates against a Superstruct 2.0.2 repository
+ * (the migration baseline). Because the baseline does not provide the Zod
+ * target capabilities, every F2P postcondition is expected to FAIL here. The
+ * status is the raw observation of this side, never a hardcoded value.
+ *
+ * CLI: node probe.js [repoRoot] [reportPath]
+ * API: module.exports.run(repoRoot) -> { side, results }
+ */
+
+const path = require("path");
+const fs = require("fs");
+const core = require("../../../shared/batches/BATCH-F2P-0001/probe-core");
+
+const SIDE = "source";
+
+function run(repoRoot) {
+  const report = core.runAll(repoRoot);
+  report.side = SIDE;
+  return report;
+}
+
+if (require.main === module) {
+  const repoRoot = process.argv[2] || process.env.PROBE_REPO || "/workspace/repo";
+  const reportPath = process.argv[3] || process.env.PROBE_REPORT;
+  const report = run(repoRoot);
+  for (const r of report.results) {
+    process.stdout.write(`${SIDE} ${r.observation_id} ${r.status} ${r.detail}\n`);
+  }
+  if (reportPath) {
+    fs.mkdirSync(path.dirname(reportPath), { recursive: true });
+    fs.writeFileSync(reportPath, JSON.stringify(report, null, 2));
+  }
+}
+
+module.exports = { run };
diff --git a/tests/source/batches/BATCH-F2P-0002/probe.cjs b/tests/source/batches/BATCH-F2P-0002/probe.cjs
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0002/probe.cjs
@@ -0,0 +1,73 @@
+"use strict";
+
+// Source-side F2P probe for BATCH-F2P-0002 (Superstruct 2.0.2 baseline).
+//
+// Executed against the read-only source repository with:
+//
+//   DEPS_NODE_MODULES=/opt/migration/dependencies/node_modules \
+//   node source/batches/BATCH-F2P-0002/probe.cjs /input/source /logs/result.json
+//
+// The very same semantic predicates used by the target probe are evaluated.
+// On the source baseline every F2P postcondition is expected to FAIL because
+// the target framework entry points (Zod `safeParse` / `z.ZodError`) are not
+// present, while the Superstruct runtime is. The probe reports the raw
+// per-observation status; it is a successful observation run even when the
+// statuses are FAIL.
+
+const fs = require("fs");
+const path = require("path");
+
+const { loadSymbols } = require("../../../shared/batches/BATCH-F2P-0002/load-repo.cjs");
+const { runProbes } = require("../../../shared/batches/BATCH-F2P-0002/predicates.cjs");
+
+const manifest = require("../../../shared/batches/BATCH-F2P-0002/manifest.json");
+
+async function main() {
+  const repoRoot = process.argv[2] || process.env.REPO_ROOT || "/workspace/repo";
+  const reportPath = process.argv[3] || "/logs/result.json";
+
+  let symbols;
+  try {
+    symbols = await loadSymbols(repoRoot);
+  } catch (err) {
+    const report = {
+      batch_id: manifest.batch_id,
+      side: "source",
+      repo_root: repoRoot,
+      status: "INFRA_ERROR",
+      error: String((err && err.stack) || err),
+      results: [],
+    };
+    fs.writeFileSync(reportPath, JSON.stringify(report, null, 2));
+    process.stderr.write("INFRA_ERROR: " + report.error + "\n");
+    process.exit(2);
+  }
+
+  const predicates = runProbes(symbols);
+  const results = manifest.observations.map((observation_id) => {
+    const predicate_id = manifest.predicate_by_observation[observation_id];
+    const result = predicates[predicate_id] || { pass: false, error: "missing predicate" };
+    return {
+      observation_id,
+      predicate_id,
+      status: result.pass === true ? "PASS" : "FAIL",
+      evidence: result,
+    };
+  });
+
+  const allFailed = results.every((r) => r.status === "FAIL");
+  const report = {
+    batch_id: manifest.batch_id,
+    side: "source",
+    repo_root: repoRoot,
+    status: allFailed ? "FAIL" : "MIXED",
+    expected: "FAIL",
+    predicates,
+    results,
+  };
+  fs.writeFileSync(reportPath, JSON.stringify(report, null, 2));
+  process.stdout.write(JSON.stringify(report, null, 2) + "\n");
+  process.exit(0);
+}
+
+void main();
