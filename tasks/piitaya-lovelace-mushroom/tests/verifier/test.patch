+    "levels": {
+      "ui.errors.config.key_missing": "missing",
+      "ui.errors.config.key_not_expected": "unexpected",
+      "ui.errors.config.key_wrong_type": "wrong_type"
+    },
+    "union_expansion": "Superstruct emits one leaf failure per failed union branch; those union-shadowed leaf failures are collapsed so the preserved contract (skip union branches) is comparable with Zod's single invalid_union issue."
+  },
+  "harness": {
