+    "source_probe": "source/batches/BATCH-DIFFERENTIAL-0001/probe.js",
+    "target_probe": "target/batches/BATCH-DIFFERENTIAL-0001/probe.js",
+    "source_invocation": "node source/batches/BATCH-DIFFERENTIAL-0001/probe.js <sourceRepoRoot> <corpus.json> <out.json>",
+    "target_invocation": "node target/batches/BATCH-DIFFERENTIAL-0001/probe.js <targetRepoRoot> <corpus.json> <out.json>",
+    "relation": "equal_after_normalization",
+    "created_by": "DIFFERENTIAL",
+    "note": "source/runner and target/runner.js are promoted by the INTEGRATION batch; this batch only authors the probes above."
+  },
+  "authoring_execution": {
+    "source": "/input/source",
+    "target": "/input/target",
+    "source_result": "all 27 corpus cases produced the same normalized result as the target",
+    "target_result": "all 27 corpus cases produced the same normalized result as the source"
+  }
+}
