+
+def _invalid_file_blocks(binary, state, blocks):
+    failures = []
+    for block in blocks:
+        _, log, _ = _expect(binary, state, failures, "bad: [{changed-files: " + block + "}]", success=False)
+        if "changed-files" not in log and "glob" not in log.lower():
