+
+
+@case("source-skips")
+def _source_skips(binary, state):
+    failures = []
+    for settings, options in (({"pull_status": 404}, {}), ({}, {"changed": []})):
+        _, log, _ = _expect(binary, state, failures, BASIC, settings=settings, **options)
+        if "::warning" not in log or state.added or state.graphql:
