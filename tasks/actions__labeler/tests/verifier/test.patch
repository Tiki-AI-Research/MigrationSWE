+++ b/tests/source/batches/BATCH-P2P-0002/run_source_tests.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Executable P2P projection for BATCH-P2P-0002 (source side).
+# Runs the repository's own TypeScript test suite with an explicit timeout so the
+# harness can never wait forever. The exit status is the raw PASS/FAIL of this
+# side.
+set -eu
+
+pkg_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+
+if [ -f "$pkg_dir/../manifest.json" ]; then
+  probe_root=$(cd "$pkg_dir/../.." && pwd)
+else
+  probe_root=$pkg_dir
+fi
+
+if [ ! -f "$probe_root/package.json" ]; then
+  echo "source projection: package.json not found under $probe_root" >&2
+  exit 1
+fi
+
+cd "$probe_root"
+exec timeout 300 npm test -- --runInBand
diff --git a/tests/source/run.sh b/tests/source/run.sh
new file mode 100644
index 0000000..7587240
--- /dev/null
+++ b/tests/source/run.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+set -u
+cd /workspace/repo || exit 1
+failed_status=0
+git --version
+command_status=$?
+if [ "$command_status" -ne 0 ]; then failed_status=$command_status; fi
+git diff --exit-code
+command_status=$?
+if [ "$command_status" -ne 0 ]; then failed_status=$command_status; fi
+set +e
+/assets/source/runner /logs/result.json
+status=$?
+if [ -s /logs/result.json ]; then exit "$status"; fi
+echo "harness produced no report" >&2
+if [ "$failed_status" -ne 0 ]; then exit "$failed_status"; fi
+if [ "$status" -eq 0 ]; then exit 125; fi
+exit "$status"
