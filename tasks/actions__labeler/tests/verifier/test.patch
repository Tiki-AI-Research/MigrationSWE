+      "surface": "action failure and warning behavior",
+      "source_entry": "src/labeler.ts",
+      "target_entry": "internal/labeler/labeler.go",
+      "method": "exit-status",
+      "expected": "unexpected=failed;403-unauthorized=failed+permission;resource-not-accessible=warning+failed"
