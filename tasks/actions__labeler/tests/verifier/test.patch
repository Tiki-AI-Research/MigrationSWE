diff --git a/tests/source/batches/BATCH-F2P-0002/probe.sh b/tests/source/batches/BATCH-F2P-0002/probe.sh
new file mode 100644
index 0000000..38d28e7
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0002/probe.sh
@@ -0,0 +1,39 @@
+#!/bin/sh
+# F2P source-side probes for BATCH-F2P-0002.
+#
+# Shared semantic predicate (identical to target/probe.sh): the Go 1.24.0
+# implementation MUST be the real build/execution path for the labeler packages
+# and the named target postconditions MUST hold when that Go code is built and
+# run. The TypeScript source does not provide that Go execution path, so the
+# predicate does not hold and every observation is reported as FAIL. The same
+# predicate therefore discriminates: FAIL here, PASS on the Go target.
+#
+# Every potentially long-running command is bounded by an explicit `timeout`
+# so the harness can never wait indefinitely. Privileged or permanently
+# blocking cases are excluded.
+set -eu
+
+root="${SOURCE_ROOT:-/input/source}"
+cd "$root"
+
+if ! command -v go >/dev/null 2>&1; then
+  echo "F2P BATCH-F2P-0002: target technology Go 1.24.0 is not on the execution path" >&2
+  exit 1
+fi
+
+if [ ! -f go.mod ]; then
+  echo "F2P BATCH-F2P-0002: no Go module; the Go implementation is not the execution path" >&2
+  exit 1
+fi
+
+timeout 60 go version
+timeout 60 go env GOVERSION
+
+timeout 300 go build ./...
+
+timeout 600 go test \
+  ./internal/config \
+  ./internal/labeler \
+  ./internal/githubapi \
+  ./internal/minimatch \
+  ./internal/match
