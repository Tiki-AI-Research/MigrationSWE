+
+
+@case("config-unknown")
+def _config_unknown(binary, state):
+    failures = []
+    _, log, _ = _expect(binary, state, failures, UNKNOWN_KEY, "mylabel", changed=["x.go"])
+    if "unknown-option" not in log or "::error" in log:
