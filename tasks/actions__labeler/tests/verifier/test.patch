diff --git a/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe.sh b/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe.sh
new file mode 100644
index 0000000..7df0b31
--- /dev/null
+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+# Differential source probe: verifies the reference TypeScript source still
+# exposes the preserved public contract. /input/source is not a git work tree,
+# so the probe asserts concrete contract markers instead of a diff.
+# Every potentially long-running command is wrapped with an explicit timeout.
+set -eu
+SOURCE_ROOT="${SOURCE_ROOT:-/input/source}"
+
+fail() { echo "source-probe: $1" >&2; exit 1; }
+
+[ -f "$SOURCE_ROOT/action.yml" ] || fail "missing action.yml"
+timeout 30 grep -q "using: 'node24'" "$SOURCE_ROOT/action.yml" || fail "action.yml runs.using changed"
+timeout 30 grep -q "main: 'dist/index.js'" "$SOURCE_ROOT/action.yml" || fail "action.yml runs.main changed"
+
+for input in repo-token configuration-path sync-labels dot pr-number; do
+  timeout 30 grep -q "^  $input:" "$SOURCE_ROOT/action.yml" || fail "missing input $input"
+done
+for output in new-labels all-labels; do
+  timeout 30 grep -q "^  $output:" "$SOURCE_ROOT/action.yml" || fail "missing output $output"
+done
+
+for src in src/main.ts src/labeler.ts src/changedFiles.ts src/branch.ts src/utils.ts; do
+  [ -f "$SOURCE_ROOT/$src" ] || fail "missing source $src"
+done
+
+timeout 30 grep -q "@actions/core" "$SOURCE_ROOT/package.json" || fail "missing @actions/core dependency"
+
+echo "source-probe: ok"
diff --git a/tests/source/batches/BATCH-F2P-0001/harness.sh b/tests/source/batches/BATCH-F2P-0001/harness.sh
new file mode 100644
index 0000000..7155896
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0001/harness.sh
@@ -0,0 +1,20 @@
+#!/bin/sh
+# F2P source harness for BATCH-F2P-0001 (TypeScript -> Go labeler migration).
+#
+# Runs the same semantic predicate as the target side against a candidate repo
+# that still uses the TypeScript source technology. The Go target packages the
+# probe imports do not exist there, so the observation is unsatisfied and the
+# harness reports failure. Every long-running command is timeout-wrapped.
+#
+# Usage: harness.sh <source-repo>
+set -eu
+
+REPO="${1:?usage: harness.sh <source-repo>}"
+PROBE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../../shared/batches/BATCH-F2P-0001/probes" && pwd)"
+
+rm -rf "$REPO/f2pprobe"
+mkdir -p "$REPO/f2pprobe"
+cp "$PROBE_DIR/doc.go" "$PROBE_DIR/probe_test.go" "$REPO/f2pprobe/"
+
+cd "$REPO"
+timeout 300 go test ./f2pprobe/ -count=1 -timeout 240s
