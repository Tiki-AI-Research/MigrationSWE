diff --git a/tests/source/batches/BATCH-F2P-0003/probe.sh b/tests/source/batches/BATCH-F2P-0003/probe.sh
new file mode 100644
index 0000000..2d9f127
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0003/probe.sh
@@ -0,0 +1,57 @@
+#!/bin/sh
+# Source-side F2P probe for BATCH-F2P-0003.
+#
+# Applies the exact same target-technology predicate as the target probe to the
+# reference source. It must FAIL for every observation because the Go 1.24.0
+# target technology is absent: the implementation is TypeScript 6.0.3 executed
+# on Node.js 24 (action.yml runs.using=node24 / runs.main=dist/index.js).
+# Every potentially long-running command is wrapped in an explicit `timeout`.
+set -u
+
+SRC_ROOT="${1:-/input/source}"
+if [ ! -d "$SRC_ROOT" ]; then
+  echo "INFRA_ERROR: source root not found: $SRC_ROOT" >&2
+  exit 2
+fi
+
+status=0
+
+if grep -q "using: 'docker'" "$SRC_ROOT/action.yml" 2>/dev/null; then
+  :
+else
+  echo "FAIL F2P-069: action.yml does not declare runs.using: docker (found: $(grep 'using:' "$SRC_ROOT/action.yml" 2>/dev/null))"
+  status=1
+fi
+
+if [ -f "$SRC_ROOT/go.mod" ]; then
+  :
+else
+  echo "FAIL F2P-057/F2P-070: no go.mod; the Go target module and cmd/labeler binary do not exist"
+  status=1
+fi
+
+if grep -rq -- "@actions/core" "$SRC_ROOT/src" 2>/dev/null; then
+  echo "FAIL F2P-071: production TypeScript source imports the @actions/core Node package"
+  status=1
+fi
+
+if grep -rq -- "@actions/github" "$SRC_ROOT/src" 2>/dev/null; then
+  echo "FAIL F2P-071: production TypeScript source imports the @actions/github Node package"
+  status=1
+fi
+
+if [ -f "$SRC_ROOT/package.json" ]; then
+  echo "FAIL F2P-057: package.json declares Node dependencies instead of the Go module requirements"
+  status=1
+fi
+
+echo "== go build ./... in source tree (timeout 120s) =="
+if timeout 120 sh -c "cd '$SRC_ROOT' && go build ./..." >/dev/null 2>&1; then
+  :
+else
+  echo "FAIL F2P-070: Go target entrypoint cannot be built from the source tree"
+  status=1
+fi
+
+echo "source probe exit: $status (expected non-zero: target technology absent)"
+exit "$status"
