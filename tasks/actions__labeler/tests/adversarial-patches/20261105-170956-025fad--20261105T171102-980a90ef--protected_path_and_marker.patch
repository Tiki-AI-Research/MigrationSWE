@@ -0,0 +1,127 @@
+package match
+
+import "github.com/actions/labeler/internal/minimatch"
+
+// CheckAnyChangedFiles reports whether any changed-files config option matches.
+func CheckAnyChangedFiles(changedFiles []string, configs []ChangedFilesGlobPatternsConfig, dot bool) bool {
+	for _, cfg := range configs {
+		if globs, ok := cfg["anyGlobToAnyFile"]; ok {
+			if CheckIfAnyGlobMatchesAnyFile(changedFiles, globs, dot) {
+				return true
+			}
+		}
+		if globs, ok := cfg["anyGlobToAllFiles"]; ok {
+			if CheckIfAnyGlobMatchesAllFiles(changedFiles, globs, dot) {
+				return true
+			}
+		}
+		if globs, ok := cfg["allGlobsToAnyFile"]; ok {
+			if CheckIfAllGlobsMatchAnyFile(changedFiles, globs, dot) {
+				return true
+			}
+		}
+		if globs, ok := cfg["allGlobsToAllFiles"]; ok {
+			if CheckIfAllGlobsMatchAllFiles(changedFiles, globs, dot) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// CheckAllChangedFiles reports whether every changed-files config option matches.
+func CheckAllChangedFiles(changedFiles []string, configs []ChangedFilesGlobPatternsConfig, dot bool) bool {
+	for _, cfg := range configs {
+		if globs, ok := cfg["anyGlobToAnyFile"]; ok {
+			if !CheckIfAnyGlobMatchesAnyFile(changedFiles, globs, dot) {
+				return false
+			}
+		}
+		if globs, ok := cfg["anyGlobToAllFiles"]; ok {
+			if !CheckIfAnyGlobMatchesAllFiles(changedFiles, globs, dot) {
+				return false
+			}
+		}
+		if globs, ok := cfg["allGlobsToAnyFile"]; ok {
+			if !CheckIfAllGlobsMatchAnyFile(changedFiles, globs, dot) {
+				return false
+			}
+		}
+		if globs, ok := cfg["allGlobsToAllFiles"]; ok {
+			if !CheckIfAllGlobsMatchAllFiles(changedFiles, globs, dot) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// CheckIfAnyGlobMatchesAnyFile reports whether any glob matches any file.
+func CheckIfAnyGlobMatchesAnyFile(changedFiles []string, globs []string, dot bool) bool {
+	matchers := compile(globs, dot)
+	for _, m := range matchers {
+		for _, f := range changedFiles {
+			if m.Match(f) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// CheckIfAllGlobsMatchAnyFile reports whether all globs match a single file.
+func CheckIfAllGlobsMatchAnyFile(changedFiles []string, globs []string, dot bool) bool {
+	matchers := compile(globs, dot)
+	for _, f := range changedFiles {
+		all := true
+		for _, m := range matchers {
+			if !m.Match(f) {
+				all = false
+				break
+			}
+		}
+		if all {
+			return true
+		}
+	}
+	return false
+}
+
+// CheckIfAnyGlobMatchesAllFiles reports whether any glob matches every file.
+func CheckIfAnyGlobMatchesAllFiles(changedFiles []string, globs []string, dot bool) bool {
+	matchers := compile(globs, dot)
+	for _, m := range matchers {
+		all := true
+		for _, f := range changedFiles {
+			if !m.Match(f) {
+				all = false
+				break
+			}
+		}
+		if all {
+			return true
+		}
+	}
+	return false
+}
+
+// CheckIfAllGlobsMatchAllFiles reports whether every glob matches every file.
+func CheckIfAllGlobsMatchAllFiles(changedFiles []string, globs []string, dot bool) bool {
+	matchers := compile(globs, dot)
+	for _, f := range changedFiles {
+		for _, m := range matchers {
+			if !m.Match(f) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func compile(globs []string, dot bool) []*minimatch.Matcher {
+	matchers := make([]*minimatch.Matcher, 0, len(globs))
+	for _, g := range globs {
+		matchers = append(matchers, minimatch.NewMatcher(g, dot))
+	}
+	return matchers
+}
diff --git a/internal/match/changedfiles_test.go b/internal/match/changedfiles_test.go
