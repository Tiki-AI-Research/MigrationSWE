@@ -0,0 +1,38 @@
+// Command labeler is the Go entrypoint for the labeler GitHub Action.
+package main
+
+import (
+	"os"
+
+	"github.com/actions/labeler/internal/core"
+	"github.com/actions/labeler/internal/event"
+	"github.com/actions/labeler/internal/githubapi"
+	"github.com/actions/labeler/internal/inputs"
+	"github.com/actions/labeler/internal/labeler"
+)
+
+func main() {
+	ev, err := event.Load()
+	if err != nil {
+		fail(err)
+	}
+	in, err := inputs.GetInputs(ev)
+	if err != nil {
+		fail(err)
+	}
+
+	client := githubapi.NewClient(in.Token)
+	l := &labeler.Labeler{Client: client, Event: ev, Inputs: in}
+	if err := l.Run(); err != nil {
+		fail(err)
+	}
+	if core.HasFailed() {
+		os.Exit(1)
+	}
+}
+
+func fail(err error) {
+	core.Error(err.Error())
+	core.SetFailed(err.Error())
+	os.Exit(1)
+}
