index 0000000..1982520
--- /dev/null
+++ b/internal/inputs/inputs.go
@@ -0,0 +1,106 @@
+// Package inputs reads and validates the action inputs.
+package inputs
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/actions/labeler/internal/core"
+	"github.com/actions/labeler/internal/event"
+)
+
+// Inputs is the parsed action input set.
+type Inputs struct {
+	Token      string
+	ConfigPath string
+	SyncLabels bool
+	Dot        bool
+	PRNumbers  []int
+}
+
+// GetInputs reads the action inputs from the environment.
+func GetInputs(ev *event.Payload) (Inputs, error) {
+	token, err := core.GetInput("repo-token", false)
+	if err != nil {
+		return Inputs{}, err
+	}
+	configPath, err := core.GetInput("configuration-path", true)
+	if err != nil {
+		return Inputs{}, err
+	}
+	syncLabels, err := boolInputWithDefault("sync-labels", false)
+	if err != nil {
+		return Inputs{}, err
+	}
+	dot, err := boolInputWithDefault("dot", true)
+	if err != nil {
+		return Inputs{}, err
+	}
+
+	return Inputs{
+		Token:      token,
+		ConfigPath: configPath,
+		SyncLabels: syncLabels,
+		Dot:        dot,
+		PRNumbers:  GetPRNumbers(ev),
+	}, nil
+}
+
+// boolInputWithDefault parses a boolean input, falling back to the action
+// default when the input is unset.
+func boolInputWithDefault(name string, def bool) (bool, error) {
+	raw, err := core.GetInput(name, false)
+	if err != nil {
+		return false, err
+	}
+	if raw == "" {
+		return def, nil
+	}
+	return core.GetBooleanInput(name, false)
+}
+
+// GetPRNumbers parses the multiline pr-number input, falling back to the event
+// payload's pull request number.
+func GetPRNumbers(ev *event.Payload) []int {
+	prInput, err := core.GetMultilineInput("pr-number", false)
+	if err != nil {
+		prInput = nil
+	}
+	if len(prInput) == 0 {
+		if ev != nil && ev.PullRequest != nil && ev.PullRequest.Number > 0 {
+			return []int{ev.PullRequest.Number}
+		}
+		return nil
+	}
+
+	var result []int
+	for _, line := range prInput {
+		trimmed := strings.TrimSpace(line)
+		n, err := strconv.Atoi(trimmed)
+		if err != nil || n <= 0 || strconv.Itoa(n) != trimmed {
+			sanitized := EscapeNonPrintable(line)
+			hint := ""
+			if sanitized != line {
+				hint = " (non-printable characters were escaped as \\xNN)"
+			}
+			core.Warning(fmt.Sprintf("'%s' is not a valid pull request number%s", sanitized, hint), "")
+			continue
+		}
+		result = append(result, n)
+	}
+	return result
+}
+
+// EscapeNonPrintable escapes control characters as \xNN.
+func EscapeNonPrintable(value string) string {
+	var b strings.Builder
+	for _, r := range value {
+		if r <= 0x1F || (r >= 0x7F && r <= 0x9F) {
+			b.WriteString(fmt.Sprintf("\\x%02x", r))
+			continue
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
diff --git a/internal/inputs/inputs_test.go b/internal/inputs/inputs_test.go
new file mode 100644
index 0000000..463c083
