+package labeler
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/actions/labeler/internal/core"
+	"github.com/actions/labeler/internal/event"
+	"github.com/actions/labeler/internal/githubapi"
+	"github.com/actions/labeler/internal/inputs"
+)
+
+type removal struct {
+	labelableID string
+	labelIDs    []string
+}
+
+type fakeGitHub struct {
+	mu sync.Mutex
+
+	prNumber   int
+	prNodeID   string
+	prLabels   []event.Label
+	changed    []string
+	content    string
+	contentErr bool
+	getPullErr bool
+	addStatus  int
+	addMessage string
+	removeErr  bool
+
+	added   [][]string
+	removed []removal
+}
+
+func newFakeGitHub() *fakeGitHub {
+	return &fakeGitHub{prNumber: 123}
+}
+
+func (f *fakeGitHub) handler() http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		path := strings.Trim(r.URL.Path, "/")
+		parts := strings.Split(path, "/")
+
+		switch {
+		case path == "graphql":
+			var body struct {
+				Variables struct {
+					LabelableID string   `json:"labelableId"`
+					LabelIDs    []string `json:"labelIds"`
+				} `json:"variables"`
+			}
+			_ = json.NewDecoder(r.Body).Decode(&body)
+			f.removed = append(f.removed, removal{body.Variables.LabelableID, body.Variables.LabelIDs})
+			if f.removeErr {
+				writeJSON(w, map[string]interface{}{"errors": []map[string]string{{"message": "GraphQL request failed"}}})
+				return
+			}
+			writeJSON(w, map[string]interface{}{"data": map[string]interface{}{}})
+
+		case len(parts) == 5 && parts[3] == "pulls":
+			if f.getPullErr {
+				w.WriteHeader(http.StatusNotFound)
+				writeJSON(w, map[string]string{"message": "Not Found"})
+				return
+			}
+			labels := make([]map[string]string, 0, len(f.prLabels))
+			for _, l := range f.prLabels {
+				labels = append(labels, map[string]string{"name": l.Name, "node_id": l.NodeID})
+			}
+			writeJSON(w, map[string]interface{}{"number": f.prNumber, "node_id": f.prNodeID, "labels": labels})
+
+		case len(parts) == 6 && parts[3] == "pulls" && parts[5] == "files":
+			files := make([]map[string]string, 0, len(f.changed))
+			for _, c := range f.changed {
+				files = append(files, map[string]string{"filename": c})
+			}
+			writeJSON(w, files)
+
+		case len(parts) >= 5 && parts[3] == "contents":
+			if f.contentErr {
+				w.WriteHeader(http.StatusNotFound)
+				writeJSON(w, map[string]string{"message": "Not Found"})
+				return
+			}
+			writeJSON(w, map[string]string{
+				"content":  base64.StdEncoding.EncodeToString([]byte(f.content)),
+				"encoding": "base64",
+			})
+
+		case len(parts) == 6 && parts[3] == "issues" && parts[5] == "labels":
+			if r.Method == http.MethodPost {
+				var body struct {
+					Labels []string `json:"labels"`
+				}
+				_ = json.NewDecoder(r.Body).Decode(&body)
+				f.added = append(f.added, body.Labels)
+				if f.addStatus >= 400 {
+					w.WriteHeader(f.addStatus)
+					writeJSON(w, map[string]string{"message": f.addMessage})
+					return
+				}
+				writeJSON(w, []map[string]string{})
+				return
+			}
+			labels := make([]map[string]string, 0, len(f.prLabels))
+			for _, l := range f.prLabels {
+				labels = append(labels, map[string]string{"name": l.Name})
+			}
+			writeJSON(w, labels)
+
+		default:
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}
+}
+
+func writeJSON(w http.ResponseWriter, v interface{}) {
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+type runOptions struct {
+	configPath string
+	prNumbers  []int
+	syncLabels bool
+	dot        bool
+	headRef    string
+	baseRef    string
+	token      string
+}
+
+func runLabeler(t *testing.T, f *fakeGitHub, o runOptions) (error, map[string]string, string) {
+	t.Helper()
+	if o.headRef == "" {
+		o.headRef = "head-branch-name"
+	}
+	if o.baseRef == "" {
+		o.baseRef = "base-branch-name"
+	}
+	if o.token == "" {
+		o.token = "foo"
+	}
+	outFile := filepath.Join(t.TempDir(), "output")
+	t.Setenv("GITHUB_OUTPUT", outFile)
+
+	buf := &bytes.Buffer{}
+	prev := core.Out
+	core.Out = buf
+	core.Reset()
+	t.Cleanup(func() { core.Out = prev; core.Reset() })
+
+	srv := httptest.NewServer(f.handler())
+	t.Cleanup(srv.Close)
+
+	client := githubapi.NewClientForTest(o.token, "monalisa", "helloworld", "sha", srv.URL, srv.URL+"/graphql")
+	ev := &event.Payload{PullRequest: &event.PullRequest{
+		Number: 123,
+		Head:   event.Branch{Ref: o.headRef},
+		Base:   event.Branch{Ref: o.baseRef},
+	}}
+	l := &Labeler{Client: client, Event: ev, Inputs: inputs.Inputs{
+		Token:      o.token,
+		ConfigPath: o.configPath,
+		SyncLabels: o.syncLabels,
+		Dot:        o.dot,
+		PRNumbers:  o.prNumbers,
+	}}
+	err := l.Run()
+	return err, readOutputs(t, outFile), buf.String()
+}
+
+func readOutputs(t *testing.T, path string) map[string]string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return map[string]string{}
+	}
+	lines := strings.Split(string(data), "\n")
+	out := map[string]string{}
+	for i := 0; i < len(lines); i++ {
+		line := lines[i]
+		idx := strings.Index(line, "<<")
+		if idx < 0 {
+			continue
+		}
+		name := line[:idx]
+		delim := line[idx+2:]
+		var val []string
+		i++
+		for i < len(lines) && lines[i] != delim {
+			val = append(val, lines[i])
+			i++
+		}
+		out[name] = strings.Join(val, "\n")
+	}
+	return out
+}
+
+func fixture(name string) string {
+	return filepath.Join("..", "..", "testdata", "fixtures", name)
+}
+
+func TestAddsMatchingLabels(t *testing.T) {
+	f := newFakeGitHub()
+	f.changed = []string{"foo.pdf"}
+	err, out, _ := runLabeler(t, f, runOptions{configPath: fixture("only_pdfs.yml"), prNumbers: []int{123}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(f.added) != 1 || strings.Join(f.added[0], ",") != "touched-a-pdf-file" {
+		t.Fatalf("added = %v", f.added)
+	}
+	if out["new-labels"] != "touched-a-pdf-file" || out["all-labels"] != "touched-a-pdf-file" {
+		t.Fatalf("outputs = %v", out)
+	}
+}
+
+func TestDotOption(t *testing.T) {
+	f := newFakeGitHub()
+	f.changed = []string{".foo.pdf"}
+	err, out, _ := runLabeler(t, f, runOptions{configPath: fixture("only_pdfs.yml"), prNumbers: []int{123}, dot: false})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(f.added) != 0 || out["new-labels"] != "" || out["all-labels"] != "" {
+		t.Fatalf("dot false: added=%v out=%v", f.added, out)
+	}
+
+	f2 := newFakeGitHub()
+	f2.changed = []string{".foo.pdf"}
+	err, out, _ = runLabeler(t, f2, runOptions{configPath: fixture("only_pdfs.yml"), prNumbers: []int{123}, dot: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(f2.added) != 1 || out["new-labels"] != "touched-a-pdf-file" {
+		t.Fatalf("dot true: added=%v out=%v", f2.added, out)
+	}
+}
+
+func TestBranchLabels(t *testing.T) {
+	f := newFakeGitHub()
+	f.changed = []string{"foo.txt"}
+	err, out, _ := runLabeler(t, f, runOptions{configPath: fixture("branches.yml"), prNumbers: []int{123}, headRef: "test/feature/123"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(f.added) != 1 || strings.Join(f.added[0], ",") != "test-branch,feature-branch" {
+		t.Fatalf("added = %v", f.added)
+	}
+	if out["new-labels"] != "test-branch,feature-branch" {
+		t.Fatalf("out = %v", out)
+	}
+}
+
+func TestInvalidBranchPatternFailsAction(t *testing.T) {
+	f := newFakeGitHub()
+	f.changed = []string{"foo.txt"}
+	cfgPath := filepath.Join(t.TempDir(), "cfg.yml")
+	writeFile(t, cfgPath, "broken:\n  - head-branch: '['\n")
+	err, _, _ := runLabeler(t, f, runOptions{configPath: cfgPath, prNumbers: []int{123}, headRef: "main"})
+	if err == nil || !strings.Contains(err.Error(), "invalid branch pattern") {
+		t.Fatalf("expected malformed branch pattern error, got %v", err)
+	}
+	if len(f.added) != 0 {
+		t.Fatalf("unexpected adds: %v", f.added)
+	}
+}
+
+func TestSyncLabelsRemovesStale(t *testing.T) {
+	f := newFakeGitHub()
+	f.prNodeID = "PR_node_id"
+	f.prLabels = []event.Label{
+		{Name: "touched-a-pdf-file", NodeID: "stale_label_node_id"},
+		{Name: "manually-added", NodeID: "manual_label_node_id"},
+	}
+	f.changed = []string{"foo.txt"}
+	err, out, _ := runLabeler(t, f, runOptions{configPath: fixture("only_pdfs.yml"), prNumbers: []int{123}, syncLabels: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(f.added) != 0 {
+		t.Fatalf("unexpected adds: %v", f.added)
+	}
+	if len(f.removed) != 1 || f.removed[0].labelableID != "PR_node_id" || strings.Join(f.removed[0].labelIDs, ",") != "stale_label_node_id" {
+		t.Fatalf("removed = %v", f.removed)
+	}
+	if out["new-labels"] != "" || out["all-labels"] != "manually-added" {
+		t.Fatalf("out = %v", out)
+	}
+}
+
+func TestSyncLabelsFalseNoRemoval(t *testing.T) {
+	f := newFakeGitHub()
+	f.prLabels = []event.Label{{Name: "touched-a-pdf-file"}, {Name: "manually-added"}}
+	f.changed = []string{"foo.txt"}
+	err, out, _ := runLabeler(t, f, runOptions{configPath: fixture("only_pdfs.yml"), prNumbers: []int{123}, syncLabels: false})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(f.removed) != 0 || len(f.added) != 0 {
+		t.Fatalf("removed=%v added=%v", f.removed, f.added)
+	}
+	if out["all-labels"] != "touched-a-pdf-file,manually-added" {
+		t.Fatalf("out = %v", out)
+	}
+}
+
+func TestRemovesStaleConfiguredLabelsInOneMutation(t *testing.T) {
+	f := newFakeGitHub()
+	f.prNodeID = "PR_node_id"
+	f.prLabels = []event.Label{
+		{Name: "component-a", NodeID: "label_a"},
+		{Name: "component-b", NodeID: "label_b"},
+		{Name: "external-label", NodeID: "external_label"},
+	}
+	f.changed = []string{"unrelated.txt"}
+	err, out, _ := runLabeler(t, f, runOptions{configPath: fixture("mixed_labels.yml"), prNumbers: []int{123}, syncLabels: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(f.removed) != 1 || strings.Join(f.removed[0].labelIDs, ",") != "label_a,label_b" {
+		t.Fatalf("removed = %v", f.removed)
+	}
+	if out["all-labels"] != "external-label" {
+		t.Fatalf("out = %v", out)
+	}
+}
+
+func TestLabelLimitExcess(t *testing.T) {
+	f := newFakeGitHub()
+	f.changed = []string{"foo.pdf"}
+	for i := 0; i < 100; i++ {
+		f.prLabels = append(f.prLabels, event.Label{Name: fmt.Sprintf("existing-label-%d", i)})
+	}
+	err, out, log := runLabeler(t, f, runOptions{configPath: fixture("only_pdfs.yml"), prNumbers: []int{123}})
+	if err != nil {
