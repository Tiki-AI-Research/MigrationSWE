@@ -0,0 +1,187 @@
+package githubapi
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+type fakeServer struct {
+	addStatus  int
+	addBody    string
+	labelPages []fakeLabelsPage
+	listErr    bool
+	addCalls   int
+	listCalls  int
+}
+
+type fakeLabelsPage struct {
+	names   []string
+	hasNext bool
+}
+
+func (f *fakeServer) handler() http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.Method == http.MethodPost && strings.Contains(r.URL.Path, "/issues/") && strings.HasSuffix(r.URL.Path, "/labels"):
+			f.addCalls++
+			if f.addStatus >= 400 {
+				w.WriteHeader(f.addStatus)
+				_, _ = w.Write([]byte(f.addBody))
+				return
+			}
+			w.WriteHeader(http.StatusOK)
+			_, _ = w.Write([]byte("[]"))
+		case r.Method == http.MethodGet && strings.HasSuffix(r.URL.Path, "/labels"):
+			page := 1
+			if p := r.URL.Query().Get("page"); p != "" {
+				page = atoi(p)
+			}
+			f.listCalls++
+			if f.listErr {
+				w.WriteHeader(http.StatusInternalServerError)
+				return
+			}
+			if page > len(f.labelPages) {
+				w.WriteHeader(http.StatusOK)
+				_, _ = w.Write([]byte("[]"))
+				return
+			}
+			pg := f.labelPages[page-1]
+			var labels []map[string]string
+			for _, n := range pg.names {
+				labels = append(labels, map[string]string{"name": n})
+			}
+			body, _ := json.Marshal(labels)
+			if pg.hasNext {
+				w.Header().Set("Link", `<https://api.github.com/issues/123/labels?page=2>; rel="next"`)
+			}
+			_, _ = w.Write(body)
+		default:
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}
+}
+
+func atoi(s string) int {
+	n := 0
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return 1
+		}
+		n = n*10 + int(c-'0')
+	}
+	if n == 0 {
+		return 1
+	}
+	return n
+}
+
+func newTestClient(t *testing.T, f *fakeServer) *Client {
+	t.Helper()
+	srv := httptest.NewServer(f.handler())
+	t.Cleanup(srv.Close)
+	return NewClientForTest("token", "monalisa", "helloworld", "sha", srv.URL, srv.URL+"/graphql")
+}
+
+func TestAddLabelsSuccess(t *testing.T) {
+	f := &fakeServer{addStatus: 200}
+	c := newTestClient(t, f)
+	if err := c.AddLabels(123, []string{"bug"}); err != nil {
+		t.Fatal(err)
+	}
+	if f.listCalls != 0 {
+		t.Fatalf("expected no verification, got %d", f.listCalls)
+	}
+}
+
+func TestAddLabelsServerErrorCommitted(t *testing.T) {
+	f := &fakeServer{
+		addStatus:  502,
+		addBody:    `{"message":"Bad Gateway"}`,
+		labelPages: []fakeLabelsPage{{names: []string{"BUG", "documentation"}}},
+	}
+	c := newTestClient(t, f)
+	if err := c.AddLabels(123, []string{"bug", "documentation"}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestAddLabelsServerErrorPagination(t *testing.T) {
+	page1 := make([]string, 100)
+	for i := range page1 {
+		page1[i] = "label-" + itoa(i)
+	}
+	f := &fakeServer{
+		addStatus: 502,
+		addBody:   `{"message":"Bad Gateway"}`,
+		labelPages: []fakeLabelsPage{
+			{names: page1, hasNext: true},
+			{names: []string{"documentation"}},
+		},
+	}
+	c := newTestClient(t, f)
+	if err := c.AddLabels(123, []string{"label-0", "documentation"}); err != nil {
+		t.Fatal(err)
+	}
+	if f.listCalls != 2 {
+		t.Fatalf("expected 2 list calls, got %d", f.listCalls)
+	}
+}
+
+func TestAddLabelsServerErrorMissing(t *testing.T) {
+	f := &fakeServer{
+		addStatus:  502,
+		addBody:    `{"message":"Bad Gateway"}`,
+		labelPages: []fakeLabelsPage{{names: []string{"bug"}}},
+	}
+	c := newTestClient(t, f)
+	err := c.AddLabels(123, []string{"bug", "documentation"})
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	httpErr, ok := err.(*HTTPError)
+	if !ok || httpErr.Status != 502 {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
+
+func TestAddLabelsNonServerError(t *testing.T) {
+	f := &fakeServer{addStatus: 422, addBody: `{"message":"Validation Failed"}`}
+	c := newTestClient(t, f)
+	err := c.AddLabels(123, []string{"bug"})
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	if f.listCalls != 0 {
+		t.Fatalf("expected no verification, got %d", f.listCalls)
+	}
+}
+
+func TestAddLabelsVerificationFails(t *testing.T) {
+	f := &fakeServer{
+		addStatus: 502,
+		addBody:   `{"message":"Bad Gateway"}`,
+		listErr:   true,
+	}
+	c := newTestClient(t, f)
+	err := c.AddLabels(123, []string{"bug"})
+	httpErr, ok := err.(*HTTPError)
+	if !ok || httpErr.Status != 502 {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
+
+func itoa(n int) string {
+	if n == 0 {
+		return "0"
+	}
+	var b []byte
+	for n > 0 {
+		b = append([]byte{byte('0' + n%10)}, b...)
+		n /= 10
+	}
+	return string(b)
+}
