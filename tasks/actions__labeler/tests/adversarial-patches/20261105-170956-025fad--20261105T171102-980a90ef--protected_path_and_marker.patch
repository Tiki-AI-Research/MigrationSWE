@@ -0,0 +1,54 @@
+// Package event models the GitHub Actions event payload.
+package event
+
+import (
+	"encoding/json"
+	"os"
+)
+
+// Payload is the top-level webhook payload.
+type Payload struct {
+	PullRequest *PullRequest `json:"pull_request"`
+}
+
+// PullRequest is the subset of pull request data used by the labeler.
+type PullRequest struct {
+	Number int     `json:"number"`
+	NodeID string  `json:"node_id"`
+	Labels []Label `json:"labels"`
+	Head   Branch  `json:"head"`
+	Base   Branch  `json:"base"`
+}
+
+// Branch is a git ref.
+type Branch struct {
+	Ref string `json:"ref"`
+}
+
+// Label is a repository label attached to an issue or pull request.
+type Label struct {
+	Name   string `json:"name"`
+	NodeID string `json:"node_id"`
+}
+
+// Load reads the payload from the file named by GITHUB_EVENT_PATH.
+func Load() (*Payload, error) {
+	path := os.Getenv("GITHUB_EVENT_PATH")
+	return LoadFromFile(path)
+}
+
+// LoadFromFile reads a payload from a specific file.
+func LoadFromFile(path string) (*Payload, error) {
+	p := &Payload{}
+	if path == "" {
+		return p, nil
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return p, err
+	}
+	if err := json.Unmarshal(data, p); err != nil {
+		return p, err
+	}
+	return p, nil
+}
diff --git a/internal/githubapi/client.go b/internal/githubapi/client.go
new file mode 100644
index 0000000..8198c5b
--- /dev/null
+++ b/internal/githubapi/client.go
@@ -0,0 +1,370 @@
+// Package githubapi implements the REST and GraphQL GitHub API calls used by
+// the labeler action.
+package githubapi
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+)
+
+// HTTPError represents a failed GitHub API request.
+type HTTPError struct {
+	Status  int
+	Message string
+	Name    string
+}
+
+func (e *HTTPError) Error() string { return e.Message }
+
+// ErrorName returns the octokit-style error name.
+func (e *HTTPError) ErrorName() string {
+	if e.Name == "" {
+		return "HttpError"
+	}
+	return e.Name
+}
+
+// StatusCode returns the HTTP status.
+func (e *HTTPError) StatusCode() int { return e.Status }
+
+// Client is a minimal GitHub API client.
+type Client struct {
+	httpClient *http.Client
+	token      string
+	owner      string
+	repo       string
+	sha        string
+	apiURL     string
+	graphqlURL string
+}
+
+// NewClient builds a client from the runtime environment.
+func NewClient(token string) *Client {
+	owner, repo := splitRepo(os.Getenv("GITHUB_REPOSITORY"))
+	apiURL := os.Getenv("GITHUB_API_URL")
+	if apiURL == "" {
+		apiURL = "https://api.github.com"
+	}
+	graphqlURL := os.Getenv("GITHUB_GRAPHQL_URL")
+	if graphqlURL == "" {
+		graphqlURL = "https://api.github.com/graphql"
+	}
+	return &Client{
+		httpClient: &http.Client{},
+		token:      token,
+		owner:      owner,
+		repo:       repo,
+		sha:        os.Getenv("GITHUB_SHA"),
+		apiURL:     strings.TrimRight(apiURL, "/"),
+		graphqlURL: graphqlURL,
+	}
+}
+
+// NewClientForTest builds a client with explicit connection settings.
+func NewClientForTest(token, owner, repo, sha, apiURL, graphqlURL string) *Client {
+	if apiURL == "" {
+		apiURL = "https://api.github.com"
+	}
+	if graphqlURL == "" {
+		graphqlURL = "https://api.github.com/graphql"
+	}
+	return &Client{
+		httpClient: &http.Client{},
+		token:      token,
+		owner:      owner,
+		repo:       repo,
+		sha:        sha,
+		apiURL:     strings.TrimRight(apiURL, "/"),
+		graphqlURL: graphqlURL,
+	}
+}
+
+func splitRepo(full string) (string, string) {
+	parts := strings.SplitN(full, "/", 2)
+	if len(parts) != 2 {
+		return "", ""
+	}
+	return parts[0], parts[1]
+}
+
+func (c *Client) issuesURL(suffix string) string {
+	return fmt.Sprintf("%s/repos/%s/%s/issues/%s", c.apiURL, c.owner, c.repo, suffix)
+}
+
+func (c *Client) pullsURL(suffix string) string {
+	return fmt.Sprintf("%s/repos/%s/%s/pulls/%s", c.apiURL, c.owner, c.repo, suffix)
+}
+
+func (c *Client) doREST(method, rawURL string, body interface{}) ([]byte, http.Header, error) {
+	var reader io.Reader
+	if body != nil {
+		encoded, err := json.Marshal(body)
+		if err != nil {
+			return nil, nil, err
+		}
+		reader = bytes.NewReader(encoded)
+	}
+	req, err := http.NewRequest(method, rawURL, reader)
+	if err != nil {
+		return nil, nil, err
+	}
+	c.setHeaders(req)
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer resp.Body.Close()
+	data, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, resp.Header, err
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return data, resp.Header, newHTTPError(resp.StatusCode, data)
+	}
+	return data, resp.Header, nil
+}
+
+func (c *Client) setHeaders(req *http.Request) {
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.Header.Set("X-GitHub-Api-Version", "2022-11-28")
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	if req.Body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+}
+
+func newHTTPError(status int, data []byte) *HTTPError {
+	message := strings.TrimSpace(string(data))
+	var parsed struct {
+		Message string `json:"message"`
+	}
+	if err := json.Unmarshal(data, &parsed); err == nil && parsed.Message != "" {
+		message = parsed.Message
+	}
+	if message == "" {
+		message = http.StatusText(status)
+	}
+	return &HTTPError{Status: status, Message: message, Name: "HttpError"}
+}
+
+// AddLabels adds labels to a pull request, verifying server errors.
+func (c *Client) AddLabels(prNumber int, labels []string) error {
+	rawURL := c.issuesURL(fmt.Sprintf("%d/labels", prNumber))
+	_, _, err := c.doREST(http.MethodPost, rawURL, map[string]interface{}{"labels": labels})
+	if err == nil {
+		return nil
+	}
+	apiErr, ok := err.(*HTTPError)
+	if !ok || apiErr.Status < 500 || apiErr.Status >= 600 {
+		return err
+	}
+
+	current := map[string]bool{}
+	page := 1
+	for {
+		names, hasNext, listErr := c.ListLabelsOnIssue(prNumber, page)
+		if listErr != nil {
+			return err
+		}
+		for _, n := range names {
+			current[strings.ToLower(n)] = true
+		}
+		allPresent := true
+		for _, l := range labels {
+			if !current[strings.ToLower(l)] {
+				allPresent = false
+				break
+			}
+		}
+		if allPresent {
+			return nil
+		}
+		if !hasNext {
+			break
+		}
+		page++
+	}
+	return err
+}
+
+// ListLabelsOnIssue returns a page of label names on an issue and whether
+// another page is available.
+func (c *Client) ListLabelsOnIssue(prNumber, page int) ([]string, bool, error) {
+	rawURL := c.issuesURL(fmt.Sprintf("%d/labels?per_page=100&page=%d", prNumber, page))
+	data, headers, err := c.doREST(http.MethodGet, rawURL, nil)
+	if err != nil {
+		return nil, false, err
+	}
+	var labels []struct {
+		Name string `json:"name"`
+	}
+	if err := json.Unmarshal(data, &labels); err != nil {
+		return nil, false, err
+	}
+	names := make([]string, 0, len(labels))
+	for _, l := range labels {
+		names = append(names, l.Name)
+	}
+	return names, hasNextLink(headers.Get("Link")), nil
+}
+
+// ListChangedFiles returns every changed file in a pull request.
+func (c *Client) ListChangedFiles(prNumber int) ([]string, error) {
+	var files []string
+	page := 1
+	for {
+		rawURL := c.pullsURL(fmt.Sprintf("%d/files?per_page=100&page=%d", prNumber, page))
+		data, headers, err := c.doREST(http.MethodGet, rawURL, nil)
+		if err != nil {
+			return nil, err
+		}
+		var pageFiles []struct {
+			Filename string `json:"filename"`
+		}
+		if err := json.Unmarshal(data, &pageFiles); err != nil {
+			return nil, err
+		}
+		for _, f := range pageFiles {
+			files = append(files, f.Filename)
+		}
+		if !hasNextLink(headers.Get("Link")) {
+			break
+		}
+		page++
+	}
+	return files, nil
+}
+
+// PullRequestData is the subset of the pull request payload the labeler needs.
+type PullRequestData struct {
+	Number int    `json:"number"`
+	NodeID string `json:"node_id"`
+	Labels []struct {
+		Name   string `json:"name"`
+		NodeID string `json:"node_id"`
+	} `json:"labels"`
+}
+
+// GetPullRequest fetches a pull request.
+func (c *Client) GetPullRequest(prNumber int) (*PullRequestData, error) {
+	rawURL := c.pullsURL(fmt.Sprintf("%d", prNumber))
+	data, _, err := c.doREST(http.MethodGet, rawURL, nil)
+	if err != nil {
+		return nil, err
+	}
+	var pr PullRequestData
+	if err := json.Unmarshal(data, &pr); err != nil {
+		return nil, err
+	}
+	return &pr, nil
+}
+
+// GetContent fetches and decodes a repository file at the current SHA.
+func (c *Client) GetContent(repoPath string) (string, error) {
+	rawURL := fmt.Sprintf("%s/repos/%s/%s/contents/%s?ref=%s",
+		c.apiURL, c.owner, c.repo, escapePath(repoPath), url.QueryEscape(c.sha))
+	data, _, err := c.doREST(http.MethodGet, rawURL, nil)
+	if err != nil {
+		return "", err
+	}
+	var payload struct {
+		Content  string `json:"content"`
+		Encoding string `json:"encoding"`
+	}
+	if err := json.Unmarshal(data, &payload); err != nil {
+		return "", err
+	}
+	if payload.Encoding == "base64" || payload.Encoding == "" {
+		cleaned := strings.ReplaceAll(payload.Content, "\n", "")
+		decoded, err := base64.StdEncoding.DecodeString(cleaned)
+		if err != nil {
+			return "", err
+		}
+		return string(decoded), nil
+	}
+	return payload.Content, nil
+}
+
+// RemoveLabels removes labels from a labelable node via GraphQL.
+func (c *Client) RemoveLabels(labelableID string, labelIDs []string) error {
+	const mutation = `
+  mutation RemoveLabels($labelableId: ID!, $labelIds: [ID!]!) {
+    removeLabelsFromLabelable(
+      input: {labelableId: $labelableId, labelIds: $labelIds}
+    ) {
+      clientMutationId
+    }
+  }
+`
+	return c.graphql(mutation, map[string]interface{}{
+		"labelableId": labelableID,
+		"labelIds":    labelIDs,
+	})
+}
+
+func (c *Client) graphql(query string, variables map[string]interface{}) error {
+	body := map[string]interface{}{"query": query, "variables": variables}
+	encoded, err := json.Marshal(body)
+	if err != nil {
+		return err
+	}
+	req, err := http.NewRequest(http.MethodPost, c.graphqlURL, bytes.NewReader(encoded))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	data, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return err
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return newHTTPError(resp.StatusCode, data)
+	}
+	var result struct {
+		Errors []struct {
+			Message string `json:"message"`
+		} `json:"errors"`
+	}
+	if err := json.Unmarshal(data, &result); err == nil && len(result.Errors) > 0 {
+		return fmt.Errorf("%s", result.Errors[0].Message)
+	}
+	return nil
+}
+
+func hasNextLink(link string) bool {
+	if link == "" {
+		return false
+	}
+	for _, part := range strings.Split(link, ",") {
+		if strings.Contains(part, `rel="next"`) {
+			return true
+		}
+	}
+	return false
+}
+
+func escapePath(p string) string {
+	segments := strings.Split(p, "/")
+	for i, s := range segments {
+		segments[i] = url.PathEscape(s)
+	}
+	return strings.Join(segments, "/")
+}
diff --git a/internal/githubapi/client_test.go b/internal/githubapi/client_test.go
