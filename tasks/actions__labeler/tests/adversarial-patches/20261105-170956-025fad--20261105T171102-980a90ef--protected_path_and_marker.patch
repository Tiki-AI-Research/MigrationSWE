diff --git a/internal/match/branch.go b/internal/match/branch.go
new file mode 100644
index 0000000..123ae90
--- /dev/null
+++ b/internal/match/branch.go
@@ -0,0 +1,91 @@
+package match
+
+import (
+	"fmt"
+
+	"github.com/dlclark/regexp2"
+)
+
+// BranchContext holds the head and base branch names read from the event.
+type BranchContext struct {
+	HeadRef string
+	BaseRef string
+}
+
+// GetBranchName returns the requested branch ref, or "" when unavailable.
+func GetBranchName(ctx BranchContext, branchBase string) string {
+	if branchBase == "base" {
+		return ctx.BaseRef
+	}
+	return ctx.HeadRef
+}
+
+// CheckAnyBranch reports whether any pattern matches the branch name.
+//
+// Patterns are treated as JavaScript regular expressions. A malformed pattern
+// is reported as an error so the action fails instead of silently not matching.
+func CheckAnyBranch(ctx BranchContext, regexps []string, branchBase string) (bool, error) {
+	branchName := GetBranchName(ctx, branchBase)
+	if branchName == "" {
+		return false, nil
+	}
+	matchers, err := compileBranchPatterns(regexps)
+	if err != nil {
+		return false, err
+	}
+	for _, matcher := range matchers {
+		matched, err := matchBranchPattern(matcher, branchName)
+		if err != nil {
+			return false, err
+		}
+		if matched {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// CheckAllBranch reports whether every pattern matches the branch name.
+//
+// Patterns are treated as JavaScript regular expressions. A malformed pattern
+// is reported as an error so the action fails instead of silently not matching.
+func CheckAllBranch(ctx BranchContext, regexps []string, branchBase string) (bool, error) {
+	branchName := GetBranchName(ctx, branchBase)
+	if branchName == "" {
+		return false, nil
+	}
+	matchers, err := compileBranchPatterns(regexps)
+	if err != nil {
+		return false, err
+	}
+	for _, matcher := range matchers {
+		matched, err := matchBranchPattern(matcher, branchName)
+		if err != nil {
+			return false, err
+		}
+		if !matched {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+func compileBranchPatterns(regexps []string) ([]*regexp2.Regexp, error) {
+	matchers := make([]*regexp2.Regexp, 0, len(regexps))
+	for _, pattern := range regexps {
+		matcher, err := regexp2.Compile(pattern, regexp2.ECMAScript)
+		if err != nil {
+			return nil, fmt.Errorf("invalid branch pattern %q: %w", pattern, err)
+		}
+		matchers = append(matchers, matcher)
+	}
+	return matchers, nil
+}
+
+func matchBranchPattern(matcher *regexp2.Regexp, branchName string) (bool, error) {
+	matched, err := matcher.MatchString(branchName)
+	if err != nil {
+		return false, fmt.Errorf("failed to match branch pattern %q: %w", matcher.String(), err)
+	}
+	return matched, nil
+}
diff --git a/internal/match/branch_test.go b/internal/match/branch_test.go
new file mode 100644
index 0000000..c9fda20
--- /dev/null
+++ b/internal/match/branch_test.go
@@ -0,0 +1,142 @@
+package match
+
+import "testing"
+
+func TestGetBranchName(t *testing.T) {
+	ctx := BranchContext{HeadRef: "head-branch-name", BaseRef: "base-branch-name"}
+	if got := GetBranchName(ctx, "base"); got != "base-branch-name" {
+		t.Fatalf("base = %q", got)
+	}
+	if got := GetBranchName(ctx, "head"); got != "head-branch-name" {
+		t.Fatalf("head = %q", got)
+	}
+}
+
+func TestCheckAllBranch(t *testing.T) {
+	ctx := BranchContext{HeadRef: "test/feature/123", BaseRef: "main"}
+	cases := []struct {
+		patterns []string
+		base     string
+		want     bool
+	}{
+		{[]string{"^test"}, "head", true},
+		{[]string{"^feature/"}, "head", false},
+		{[]string{"^test/", "^feature/"}, "head", false},
+		{[]string{"^test/", "/feature/"}, "head", true},
+		{[]string{"^feature/", "/test$"}, "head", false},
+		{[]string{"^main$"}, "base", true},
+	}
+	for _, c := range cases {
+		got, err := CheckAllBranch(ctx, c.patterns, c.base)
+		if err != nil {
+			t.Fatalf("CheckAllBranch(%v, %s) error: %v", c.patterns, c.base, err)
+		}
+		if got != c.want {
+			t.Fatalf("CheckAllBranch(%v, %s) = %v, want %v", c.patterns, c.base, got, c.want)
+		}
+	}
+}
+
+func TestCheckAnyBranch(t *testing.T) {
+	ctx := BranchContext{HeadRef: "test/feature/123", BaseRef: "main"}
+	cases := []struct {
+		patterns []string
+		base     string
+		want     bool
+	}{
+		{[]string{"^test"}, "head", true},
+		{[]string{"^feature/"}, "head", false},
+		{[]string{"^test/", "^feature/"}, "head", true},
+		{[]string{"^test/", "/feature/"}, "head", true},
+		{[]string{"^feature/", "/test$"}, "head", false},
+		{[]string{"^main$"}, "base", true},
+	}
+	for _, c := range cases {
+		got, err := CheckAnyBranch(ctx, c.patterns, c.base)
+		if err != nil {
+			t.Fatalf("CheckAnyBranch(%v, %s) error: %v", c.patterns, c.base, err)
+		}
+		if got != c.want {
+			t.Fatalf("CheckAnyBranch(%v, %s) = %v, want %v", c.patterns, c.base, got, c.want)
+		}
+	}
+}
+
+// TestBranchPatternsUseJavaScriptRegExp verifies branch patterns are evaluated
+// with JavaScript RegExp semantics, including constructs that Go's RE2 engine
+// does not support (negative lookahead and backreferences).
+func TestBranchPatternsUseJavaScriptRegExp(t *testing.T) {
+	cases := []struct {
+		name     string
+		headRef  string
+		patterns []string
+		want     bool
+	}{
+		{"negative lookahead matches", "main", []string{`^(?!release).*`}, true},
+		{"negative lookahead rejects", "release/1.0", []string{`^(?!release).*`}, false},
+		{"positive lookahead matches", "feature/foo", []string{`^(?=feature/).*$`}, true},
+		{"backreference matches", "foofoo", []string{`(foo)\1`}, true},
+		{"backreference rejects", "foobar", []string{`(foo)\1`}, false},
+		{"named group matches", "main", []string{`(?<branch>main)`}, true},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			ctx := BranchContext{HeadRef: c.headRef, BaseRef: c.headRef}
+			got, err := CheckAnyBranch(ctx, c.patterns, "head")
+			if err != nil {
+				t.Fatalf("CheckAnyBranch(%v) error: %v", c.patterns, err)
+			}
+			if got != c.want {
+				t.Fatalf("CheckAnyBranch(%v, %q) = %v, want %v", c.patterns, c.headRef, got, c.want)
+			}
+		})
+	}
+}
+
+// TestInvalidBranchPatternFails verifies a malformed branch pattern surfaces an
+// error (failing the action) instead of silently not matching.
+func TestInvalidBranchPatternFails(t *testing.T) {
+	ctx := BranchContext{HeadRef: "main", BaseRef: "main"}
+	if _, err := CheckAnyBranch(ctx, []string{"["}, "head"); err == nil {
+		t.Fatal("CheckAnyBranch: expected error for malformed pattern")
+	}
+	if _, err := CheckAllBranch(ctx, []string{"["}, "head"); err == nil {
+		t.Fatal("CheckAllBranch: expected error for malformed pattern")
+	}
+}
+
+// TestBranchPatternNotCompiledForEmptyBranchName verifies patterns are not
+// validated when there is no branch name, matching `new RegExp` only running
+// after the branch name check.
+func TestBranchPatternNotCompiledForEmptyBranchName(t *testing.T) {
+	ctx := BranchContext{}
+	got, err := CheckAnyBranch(ctx, []string{"["}, "head")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got {
+		t.Fatal("expected false for empty branch name")
+	}
+}
+
+func TestToBranchMatchConfig(t *testing.T) {
+	if got := ToBranchMatchConfig(node(t, "changed-files:\n  - any: ['testing']")); len(got.HeadBranch) != 0 || len(got.BaseBranch) != 0 {
+		t.Fatalf("expected empty, got %v", got)
+	}
+	got := ToBranchMatchConfig(node(t, "head-branch: ['testing']"))
+	if len(got.HeadBranch) != 1 || got.HeadBranch[0] != "testing" {
+		t.Fatalf("unexpected: %v", got)
+	}
+	got = ToBranchMatchConfig(node(t, "head-branch: testing"))
+	if len(got.HeadBranch) != 1 || got.HeadBranch[0] != "testing" {
+		t.Fatalf("unexpected: %v", got)
+	}
+	got = ToBranchMatchConfig(node(t, "base-branch: ['testing']"))
+	if len(got.BaseBranch) != 1 || got.BaseBranch[0] != "testing" {
+		t.Fatalf("unexpected: %v", got)
+	}
+	got = ToBranchMatchConfig(node(t, "base-branch: testing\nhead-branch: testing"))
+	if len(got.HeadBranch) != 1 || len(got.BaseBranch) != 1 {
+		t.Fatalf("unexpected: %v", got)
+	}
+}
