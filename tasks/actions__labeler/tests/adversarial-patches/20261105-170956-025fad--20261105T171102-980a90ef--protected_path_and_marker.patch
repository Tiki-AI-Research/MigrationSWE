+package labeler
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+type expectation struct {
+	Name      string   `json:"name"`
+	Config    string   `json:"config"`
+	Files     []string `json:"files"`
+	Dot       bool     `json:"dot"`
+	Head      string   `json:"head"`
+	Base      string   `json:"base"`
+	NewLabels string   `json:"new_labels"`
+	AllLabels string   `json:"all_labels"`
+}
+
+func TestLabelerGoldenExpectations(t *testing.T) {
+	path := filepath.Join("..", "..", "testdata", "oracle", "labeler_expectations.json")
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read oracle: %v", err)
+	}
+	var cases []expectation
+	if err := json.Unmarshal(data, &cases); err != nil {
+		t.Fatalf("parse oracle: %v", err)
+	}
+	for _, c := range cases {
+		t.Run(c.Name, func(t *testing.T) {
+			f := newFakeGitHub()
+			f.changed = c.Files
+			err, out, _ := runLabeler(t, f, runOptions{
+				configPath: fixture(c.Config),
+				prNumbers:  []int{123},
+				dot:        c.Dot,
+				headRef:    c.Head,
+				baseRef:    c.Base,
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if out["new-labels"] != c.NewLabels {
+				t.Fatalf("new-labels = %q, want %q", out["new-labels"], c.NewLabels)
+			}
+			if out["all-labels"] != c.AllLabels {
+				t.Fatalf("all-labels = %q, want %q", out["all-labels"], c.AllLabels)
+			}
+		})
+	}
+}
diff --git a/internal/labeler/labeler.go b/internal/labeler/labeler.go
new file mode 100644
index 0000000..e1629df
--- /dev/null
+++ b/internal/labeler/labeler.go
@@ -0,0 +1,274 @@
+// Package labeler implements the labeler orchestration.
+package labeler
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/actions/labeler/internal/config"
+	"github.com/actions/labeler/internal/core"
+	"github.com/actions/labeler/internal/event"
+	"github.com/actions/labeler/internal/githubapi"
+	"github.com/actions/labeler/internal/inputs"
+	"github.com/actions/labeler/internal/match"
+)
+
+// githubMaxLabels is the maximum number of labels GitHub allows on an issue.
+const githubMaxLabels = 100
+
+// Labeler holds the runtime dependencies for a single invocation.
+type Labeler struct {
+	Client *githubapi.Client
+	Event  *event.Payload
+	Inputs inputs.Inputs
+}
+
+type removeError struct {
+	msg   string
+	cause error
+}
+
+func (e *removeError) Error() string { return e.msg }
+func (e *removeError) Unwrap() error { return e.cause }
+
+// Run executes the labeler for every requested pull request.
+func (l *Labeler) Run() error {
+	in := l.Inputs
+	if len(in.PRNumbers) == 0 {
+		core.Warning("Could not get pull request number(s), exiting", "")
+		return nil
+	}
+
+	branches := match.BranchContext{}
+	if l.Event != nil && l.Event.PullRequest != nil {
+		branches.HeadRef = l.Event.PullRequest.Head.Ref
+		branches.BaseRef = l.Event.PullRequest.Base.Ref
+	}
+
+	for _, prNumber := range in.PRNumbers {
+		prData, err := l.Client.GetPullRequest(prNumber)
+		if err != nil {
+			core.Warning(fmt.Sprintf("Could not find pull request #%d, skipping", prNumber), "")
+			continue
+		}
+		changedFiles, err := l.Client.ListChangedFiles(prNumber)
+		if err != nil {
+			return err
+		}
+		if len(changedFiles) == 0 {
+			core.Warning(fmt.Sprintf("Pull request #%d has no changed files, skipping", prNumber), "")
+			continue
+		}
+
+		result, err := config.LoadConfig(l.Client, in.ConfigPath)
+		if err != nil {
+			return err
+		}
+		if err := l.process(prNumber, prData, changedFiles, result, branches); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (l *Labeler) process(prNumber int, prData *githubapi.PullRequestData, changedFiles []string, result *config.LabelConfigResult, branches match.BranchContext) error {
+	in := l.Inputs
+	labelConfigs := result.LabelConfigs
+
+	skipChangedFilesLabeling := result.MaxFilesChanged != nil && len(changedFiles) > *result.MaxFilesChanged
+	if skipChangedFilesLabeling {
+		core.Info(fmt.Sprintf(
+			"Total changed files (%d) exceeds max-files-changed (%d), skipping file-based labeling",
+			len(changedFiles), *result.MaxFilesChanged))
+	}
+
+	preexisting := make([]string, 0, len(prData.Labels))
+	for _, label := range prData.Labels {
+		preexisting = append(preexisting, label.Name)
+	}
+
+	allLabels := newOrderedSet(preexisting)
+	changedFilesLabels := newOrderedSet(nil)
+
+	for _, label := range labelConfigs.Labels {
+		configs := labelConfigs.Configs[label]
+		usesChangedFiles := match.ConfigUsesChangedFiles(configs)
+		if skipChangedFilesLabeling && usesChangedFiles {
+			continue
+		}
+		matched, err := match.CheckMatchConfigs(changedFiles, configs, in.Dot, branches)
+		if err != nil {
+			return err
+		}
+		if matched {
+			allLabels.Add(label)
+			if usesChangedFiles {
+				changedFilesLabels.Add(label)
+			}
+		} else if in.SyncLabels {
+			allLabels.Delete(label)
+		}
+	}
+
+	var newChangedFilesLabels []string
+	for _, label := range changedFilesLabels.Slice() {
+		if !contains(preexisting, label) {
+			newChangedFilesLabels = append(newChangedFilesLabels, label)
+		}
+	}
+	if result.ChangedFilesLimit != nil && len(newChangedFilesLabels) > *result.ChangedFilesLimit {
+		core.Info(fmt.Sprintf(
+			"Changed-files labels (%d) exceed limit (%d), skipping: %s",
+			len(newChangedFilesLabels), *result.ChangedFilesLimit, strings.Join(newChangedFilesLabels, ", ")))
+		for _, label := range newChangedFilesLabels {
+			allLabels.Delete(label)
+		}
+	}
+
+	allSlice := allLabels.Slice()
+	labelsToApply := allSlice
+	var excessLabels []string
+	if len(allSlice) > githubMaxLabels {
+		labelsToApply = allSlice[:githubMaxLabels]
+		excessLabels = allSlice[githubMaxLabels:]
+	}
+	finalLabels := labelsToApply
+	newLabels := make([]string, 0, len(labelsToApply))
+	for _, label := range labelsToApply {
+		if !contains(preexisting, label) {
+			newLabels = append(newLabels, label)
+		}
+	}
+
+	var staleLabels []event.Label
+	for _, label := range prData.Labels {
+		if labelConfigs.Has(label.Name) && !allLabels.Has(label.Name) {
+			staleLabels = append(staleLabels, label)
+		}
+	}
+
+	if err := l.apply(prNumber, prData, staleLabels, newLabels); err != nil {
+		apiErr := errors.Unwrap(err)
+		if apiErr == nil {
+			apiErr = err
+		}
+		if httpErr, ok := apiErr.(*githubapi.HTTPError); ok {
+			if httpErr.Status == 403 && strings.Contains(strings.ToLower(httpErr.Message), "unauthorized") {
+				return fmt.Errorf(
+					"Failed to update labels for PR #%d. The workflow does not have permission to create labels. "+
+						"Ensure the 'issues: write' permission is granted in the workflow file or manually create the missing labels in the repository before running the action.",
+					prNumber)
+			}
+			if httpErr.ErrorName() == "HttpError" && httpErr.Message == "Resource not accessible by integration" {
+				core.Warning(
+					"The action requires 'issues: write' permission to create new labels or 'pull-requests: write' permission to add existing labels to pull requests. "+
+						"For more information, refer to the action documentation: https://github.com/actions/labeler#recommended-permissions",
+					fmt.Sprintf("%s running under '%s' is misconfigured",
+						os.Getenv("GITHUB_ACTION_REPOSITORY"), os.Getenv("GITHUB_EVENT_NAME")))
+				core.SetFailed(httpErr.Message)
+				return nil
+			}
+		}
+		return err
+	}
+
+	if err := core.SetOutput("new-labels", strings.Join(newLabels, ",")); err != nil {
+		return err
+	}
+	if err := core.SetOutput("all-labels", strings.Join(finalLabels, ",")); err != nil {
+		return err
+	}
+
+	if len(excessLabels) > 0 {
+		core.Warning(fmt.Sprintf(
+			"Maximum of %d labels allowed. Excess labels: %s",
+			githubMaxLabels, strings.Join(excessLabels, ", ")),
+			"Label limit for a PR exceeded")
+	}
+	return nil
+}
+
+func (l *Labeler) apply(prNumber int, prData *githubapi.PullRequestData, staleLabels []event.Label, newLabels []string) error {
+	if len(staleLabels) > 0 {
+		labelableID := prData.NodeID
+		ids := make([]string, 0, len(staleLabels))
+		missingNodeID := false
+		for _, label := range staleLabels {
+			if label.NodeID == "" {
+				missingNodeID = true
+				break
+			}
+			ids = append(ids, label.NodeID)
+		}
+		if labelableID == "" || missingNodeID {
+			return fmt.Errorf(
+				"Failed to resolve node IDs while removing configured labels from PR #%d", prNumber)
+		}
+		if err := l.Client.RemoveLabels(labelableID, ids); err != nil {
+			names := make([]string, 0, len(staleLabels))
+			for _, label := range staleLabels {
+				names = append(names, label.Name)
+			}
+			return &removeError{
+				msg: fmt.Sprintf("Failed to remove configured labels '%s' from PR #%d",
+					strings.Join(names, "', '"), prNumber),
+				cause: err,
+			}
+		}
+	}
+	if len(newLabels) > 0 {
+		if err := l.Client.AddLabels(prNumber, newLabels); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func contains(list []string, value string) bool {
+	for _, item := range list {
+		if item == value {
+			return true
+		}
+	}
+	return false
+}
+
+type orderedSet struct {
+	items []string
+	seen  map[string]bool
+}
+
+func newOrderedSet(initial []string) *orderedSet {
+	s := &orderedSet{seen: map[string]bool{}}
+	for _, item := range initial {
+		s.Add(item)
+	}
+	return s
+}
+
+func (s *orderedSet) Add(value string) {
+	if s.seen[value] {
+		return
+	}
+	s.seen[value] = true
+	s.items = append(s.items, value)
+}
+
+func (s *orderedSet) Delete(value string) {
+	if !s.seen[value] {
+		return
+	}
+	delete(s.seen, value)
+	for i, item := range s.items {
+		if item == value {
+			s.items = append(s.items[:i], s.items[i+1:]...)
+			break
+		}
+	}
+}
+
+func (s *orderedSet) Has(value string) bool { return s.seen[value] }
+
+func (s *orderedSet) Slice() []string { return s.items }
