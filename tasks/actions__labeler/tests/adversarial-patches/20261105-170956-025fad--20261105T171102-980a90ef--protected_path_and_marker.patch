new file mode 100644
index 0000000..2a642ea
--- /dev/null
+++ b/internal/utils/utils.go
@@ -0,0 +1,37 @@
+// Package utils provides small functional helpers shared across the labeler.
+package utils
+
+import "strings"
+
+// KebabToCamel converts a kebab-case key such as "any-glob-to-any-file" into
+// its camelCase form ("anyGlobToAnyFile"), matching the TypeScript helper.
+func KebabToCamel(str string) string {
+	var b strings.Builder
+	for i := 0; i < len(str); i++ {
+		c := str[i]
+		if c == '-' && i+1 < len(str) {
+			i++
+			next := str[i]
+			if next >= 'a' && next <= 'z' {
+				next = next - 'a' + 'A'
+			}
+			b.WriteByte(next)
+			continue
+		}
+		b.WriteByte(c)
+	}
+	return b.String()
+}
+
+// IsObject reports whether v is a mapping-like object (not nil, not a slice).
+func IsObject(v interface{}) bool {
+	if v == nil {
+		return false
+	}
+	switch v.(type) {
+	case map[string]interface{}, map[interface{}]interface{}:
+		return true
+	default:
+		return false
+	}
+}
