@@ -0,0 +1,107 @@
+package inputs
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/actions/labeler/internal/core"
+	"github.com/actions/labeler/internal/event"
+)
+
+func capture(t *testing.T) *bytes.Buffer {
+	t.Helper()
+	buf := &bytes.Buffer{}
+	prev := core.Out
+	core.Out = buf
+	core.Reset()
+	t.Cleanup(func() {
+		core.Out = prev
+		core.Reset()
+	})
+	return buf
+}
+
+func TestGetPRNumbersFromPayload(t *testing.T) {
+	capture(t)
+	t.Setenv("INPUT_PR-NUMBER", "")
+	ev := &event.Payload{PullRequest: &event.PullRequest{Number: 123}}
+	got := GetPRNumbers(ev)
+	if len(got) != 1 || got[0] != 123 {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestGetPRNumbersEmpty(t *testing.T) {
+	capture(t)
+	t.Setenv("INPUT_PR-NUMBER", "")
+	got := GetPRNumbers(&event.Payload{})
+	if got != nil {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestGetPRNumbersValid(t *testing.T) {
+	capture(t)
+	t.Setenv("INPUT_PR-NUMBER", "104\n 105 \n")
+	t.Setenv("INPUT_PR_NUMBER", "")
+	got := GetPRNumbers(&event.Payload{})
+	if len(got) != 2 || got[0] != 104 || got[1] != 105 {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestGetPRNumbersInvalid(t *testing.T) {
+	cases := []string{"abc", "-1", "0", "10 4", "104abc"}
+	for _, c := range cases {
+		buf := capture(t)
+		t.Setenv("INPUT_PR-NUMBER", c)
+		got := GetPRNumbers(&event.Payload{})
+		if len(got) != 0 {
+			t.Fatalf("%q: got %v", c, got)
+		}
+		if !strings.Contains(buf.String(), "'"+c+"' is not a valid pull request number") {
+			t.Fatalf("%q: output %q", c, buf.String())
+		}
+	}
+}
+
+func TestGetPRNumbersEscaping(t *testing.T) {
+	cases := []struct {
+		in   string
+		want string
+	}{
+		{"abc\rdef", "'abc\\x0ddef' is not a valid pull request number (non-printable characters were escaped as \\xNN)"},
+		{"abc\tdef", "'abc\\x09def' is not a valid pull request number (non-printable characters were escaped as \\xNN)"},
+		{"abc\x1b[31mINJECTED\x1b[0m", "'abc\\x1b[31mINJECTED\\x1b[0m' is not a valid pull request number (non-printable characters were escaped as \\xNN)"},
+	}
+	for _, c := range cases {
+		buf := capture(t)
+		t.Setenv("INPUT_PR-NUMBER", c.in)
+		GetPRNumbers(&event.Payload{})
+		if !strings.Contains(buf.String(), c.want) {
+			t.Fatalf("input %q: output %q want contains %q", c.in, buf.String(), c.want)
+		}
+	}
+}
+
+func TestGetPRNumbersMix(t *testing.T) {
+	buf := capture(t)
+	t.Setenv("INPUT_PR-NUMBER", "104\nabc")
+	got := GetPRNumbers(&event.Payload{})
+	if len(got) != 1 || got[0] != 104 {
+		t.Fatalf("got %v", got)
+	}
+	if !strings.Contains(buf.String(), "'abc' is not a valid pull request number") {
+		t.Fatalf("missing warning: %q", buf.String())
+	}
+}
+
+func TestEscapeNonPrintable(t *testing.T) {
+	if got := EscapeNonPrintable("abc\rdef"); got != "abc\\x0ddef" {
+		t.Fatalf("got %q", got)
+	}
+	if got := EscapeNonPrintable("plain"); got != "plain" {
+		t.Fatalf("got %q", got)
+	}
+}
