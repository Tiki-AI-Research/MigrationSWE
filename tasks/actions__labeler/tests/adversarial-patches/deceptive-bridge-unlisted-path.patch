+package minimatch
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+type oracleCase struct {
+	Pattern  string `json:"pattern"`
+	Dot      bool   `json:"dot"`
+	Name     string `json:"name"`
+	Match    bool   `json:"match"`
+	Negate   bool   `json:"negate"`
+	Rendered string `json:"rendered"`
+}
+
+func TestMinimatchOracle(t *testing.T) {
+	path := filepath.Join("..", "..", "testdata", "oracle", "minimatch_cases.json")
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read oracle: %v", err)
+	}
+	var cases []oracleCase
+	if err := json.Unmarshal(data, &cases); err != nil {
+		t.Fatalf("parse oracle: %v", err)
+	}
+
+	var mismatches int
+	for _, c := range cases {
+		m := NewMatcher(c.Pattern, c.Dot)
+		if got := m.Match(c.Name); got != c.Match {
+			mismatches++
+			if mismatches <= 40 {
+				t.Errorf("Match(%q, pattern=%q, dot=%v) = %v, want %v", c.Name, c.Pattern, c.Dot, got, c.Match)
+			}
+		}
+		if m.Negate() != c.Negate {
+			t.Errorf("Negate(pattern=%q) = %v, want %v", c.Pattern, m.Negate(), c.Negate)
+		}
+		if m.PrintPattern() != c.Rendered {
+			t.Errorf("PrintPattern(pattern=%q) = %q, want %q", c.Pattern, m.PrintPattern(), c.Rendered)
+		}
+	}
+	if mismatches > 0 {
+		t.Fatalf("total mismatches: %d / %d", mismatches, len(cases))
+	}
+}
