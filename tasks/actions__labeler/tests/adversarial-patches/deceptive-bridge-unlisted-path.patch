+	f.content = string(content)
+	err, out, _ := runLabeler(t, f, runOptions{configPath: "does/not/exist/labeler.yml", prNumbers: []int{123}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out["new-labels"] != "touched-a-pdf-file" {
+		t.Fatalf("out = %v", out)
+	}
+}
+
+func TestConfigFetchFailure(t *testing.T) {
+	f := newFakeGitHub()
+	f.changed = []string{"foo.pdf"}
+	f.contentErr = true
+	err, _, log := runLabeler(t, f, runOptions{configPath: "does/not/exist/labeler.yml", prNumbers: []int{123}})
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	if !strings.Contains(log, "The config file was not found at does/not/exist/labeler.yml. Make sure it exists and that this action has the correct access rights.") {
+		t.Fatalf("log = %q", log)
+	}
+}
+
+func TestRemoveFailureReportsConfiguredLabels(t *testing.T) {
+	f := newFakeGitHub()
+	f.prNodeID = "PR_node_id"
+	f.prLabels = []event.Label{{Name: "stale-label", NodeID: "label_node_id"}}
+	f.changed = []string{"file.txt"}
+	f.removeErr = true
+	cfgPath := filepath.Join(t.TempDir(), "cfg.yml")
+	writeFile(t, cfgPath, "stale-label:\n  - changed-files:\n      - any-glob-to-any-file: ['*.pdf']\n")
+	err, _, _ := runLabeler(t, f, runOptions{configPath: cfgPath, prNumbers: []int{123}, syncLabels: true})
+	if err == nil || !strings.Contains(err.Error(), "Failed to remove configured labels 'stale-label' from PR #123") {
+		t.Fatalf("err = %v", err)
+	}
+	if len(f.added) != 0 {
+		t.Fatalf("unexpected adds: %v", f.added)
+	}
+}
+
+func TestAddLabelsForbidden(t *testing.T) {
+	f := newFakeGitHub()
+	f.changed = []string{"foo.pdf"}
+	f.addStatus = 403
+	f.addMessage = "Request failed with status code 403: Unauthorized"
+	err, _, _ := runLabeler(t, f, runOptions{configPath: fixture("only_pdfs.yml"), prNumbers: []int{123}})
+	if err == nil || !strings.Contains(err.Error(), "does not have permission to create labels") {
+		t.Fatalf("err = %v", err)
+	}
+}
+
+func TestResourceNotAccessible(t *testing.T) {
+	f := newFakeGitHub()
+	f.changed = []string{"foo.pdf"}
+	f.addStatus = 403
+	f.addMessage = "Resource not accessible by integration"
+	err, _, log := runLabeler(t, f, runOptions{configPath: fixture("only_pdfs.yml"), prNumbers: []int{123}})
+	if err != nil {
+		t.Fatalf("expected nil error, got %v", err)
+	}
+	if !core.HasFailed() {
+		t.Fatal("expected action to fail")
+	}
+	if !strings.Contains(log, "requires 'issues: write' permission") {
+		t.Fatalf("log = %q", log)
+	}
+}
+
+func TestConcurrentLabelPreserved(t *testing.T) {
+	f := newFakeGitHub()
+	f.changed = []string{"foo.pdf"}
+	err, _, _ := runLabeler(t, f, runOptions{configPath: fixture("only_pdfs.yml"), prNumbers: []int{123}, syncLabels: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(f.added) != 1 || strings.Join(f.added[0], ",") != "touched-a-pdf-file" {
+		t.Fatalf("added = %v", f.added)
+	}
+}
+
+func writeFile(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/match/branch.go b/internal/match/branch.go
new file mode 100644
index 0000000..123ae90
--- /dev/null
+++ b/internal/match/branch.go
@@ -0,0 +1,91 @@
+package match
+
+import (
+	"fmt"
+
+	"github.com/dlclark/regexp2"
+)
+
+// BranchContext holds the head and base branch names read from the event.
+type BranchContext struct {
+	HeadRef string
+	BaseRef string
+}
+
+// GetBranchName returns the requested branch ref, or "" when unavailable.
+func GetBranchName(ctx BranchContext, branchBase string) string {
+	if branchBase == "base" {
+		return ctx.BaseRef
+	}
+	return ctx.HeadRef
+}
+
+// CheckAnyBranch reports whether any pattern matches the branch name.
+//
+// Patterns are treated as JavaScript regular expressions. A malformed pattern
+// is reported as an error so the action fails instead of silently not matching.
+func CheckAnyBranch(ctx BranchContext, regexps []string, branchBase string) (bool, error) {
+	branchName := GetBranchName(ctx, branchBase)
+	if branchName == "" {
+		return false, nil
+	}
+	matchers, err := compileBranchPatterns(regexps)
+	if err != nil {
+		return false, err
+	}
+	for _, matcher := range matchers {
+		matched, err := matchBranchPattern(matcher, branchName)
+		if err != nil {
+			return false, err
+		}
+		if matched {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// CheckAllBranch reports whether every pattern matches the branch name.
+//
+// Patterns are treated as JavaScript regular expressions. A malformed pattern
+// is reported as an error so the action fails instead of silently not matching.
+func CheckAllBranch(ctx BranchContext, regexps []string, branchBase string) (bool, error) {
+	branchName := GetBranchName(ctx, branchBase)
+	if branchName == "" {
+		return false, nil
+	}
+	matchers, err := compileBranchPatterns(regexps)
+	if err != nil {
+		return false, err
+	}
+	for _, matcher := range matchers {
+		matched, err := matchBranchPattern(matcher, branchName)
+		if err != nil {
+			return false, err
+		}
+		if !matched {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+func compileBranchPatterns(regexps []string) ([]*regexp2.Regexp, error) {
+	matchers := make([]*regexp2.Regexp, 0, len(regexps))
+	for _, pattern := range regexps {
+		matcher, err := regexp2.Compile(pattern, regexp2.ECMAScript)
+		if err != nil {
+			return nil, fmt.Errorf("invalid branch pattern %q: %w", pattern, err)
+		}
+		matchers = append(matchers, matcher)
+	}
+	return matchers, nil
+}
+
+func matchBranchPattern(matcher *regexp2.Regexp, branchName string) (bool, error) {
+	matched, err := matcher.MatchString(branchName)
+	if err != nil {
+		return false, fmt.Errorf("failed to match branch pattern %q: %w", matcher.String(), err)
+	}
+	return matched, nil
+}
diff --git a/internal/match/branch_test.go b/internal/match/branch_test.go
new file mode 100644
index 0000000..c9fda20
--- /dev/null
+++ b/internal/match/branch_test.go
@@ -0,0 +1,142 @@
+package match
+
+import "testing"
+
+func TestGetBranchName(t *testing.T) {
+	ctx := BranchContext{HeadRef: "head-branch-name", BaseRef: "base-branch-name"}
+	if got := GetBranchName(ctx, "base"); got != "base-branch-name" {
+		t.Fatalf("base = %q", got)
+	}
+	if got := GetBranchName(ctx, "head"); got != "head-branch-name" {
+		t.Fatalf("head = %q", got)
+	}
+}
+
+func TestCheckAllBranch(t *testing.T) {
+	ctx := BranchContext{HeadRef: "test/feature/123", BaseRef: "main"}
+	cases := []struct {
+		patterns []string
+		base     string
+		want     bool
+	}{
+		{[]string{"^test"}, "head", true},
+		{[]string{"^feature/"}, "head", false},
+		{[]string{"^test/", "^feature/"}, "head", false},
+		{[]string{"^test/", "/feature/"}, "head", true},
+		{[]string{"^feature/", "/test$"}, "head", false},
+		{[]string{"^main$"}, "base", true},
+	}
+	for _, c := range cases {
+		got, err := CheckAllBranch(ctx, c.patterns, c.base)
+		if err != nil {
+			t.Fatalf("CheckAllBranch(%v, %s) error: %v", c.patterns, c.base, err)
+		}
+		if got != c.want {
+			t.Fatalf("CheckAllBranch(%v, %s) = %v, want %v", c.patterns, c.base, got, c.want)
+		}
+	}
+}
+
+func TestCheckAnyBranch(t *testing.T) {
+	ctx := BranchContext{HeadRef: "test/feature/123", BaseRef: "main"}
+	cases := []struct {
+		patterns []string
+		base     string
+		want     bool
+	}{
+		{[]string{"^test"}, "head", true},
+		{[]string{"^feature/"}, "head", false},
+		{[]string{"^test/", "^feature/"}, "head", true},
+		{[]string{"^test/", "/feature/"}, "head", true},
+		{[]string{"^feature/", "/test$"}, "head", false},
+		{[]string{"^main$"}, "base", true},
+	}
+	for _, c := range cases {
+		got, err := CheckAnyBranch(ctx, c.patterns, c.base)
+		if err != nil {
+			t.Fatalf("CheckAnyBranch(%v, %s) error: %v", c.patterns, c.base, err)
+		}
+		if got != c.want {
+			t.Fatalf("CheckAnyBranch(%v, %s) = %v, want %v", c.patterns, c.base, got, c.want)
+		}
+	}
+}
+
+// TestBranchPatternsUseJavaScriptRegExp verifies branch patterns are evaluated
+// with JavaScript RegExp semantics, including constructs that Go's RE2 engine
+// does not support (negative lookahead and backreferences).
+func TestBranchPatternsUseJavaScriptRegExp(t *testing.T) {
+	cases := []struct {
+		name     string
+		headRef  string
+		patterns []string
+		want     bool
+	}{
+		{"negative lookahead matches", "main", []string{`^(?!release).*`}, true},
+		{"negative lookahead rejects", "release/1.0", []string{`^(?!release).*`}, false},
+		{"positive lookahead matches", "feature/foo", []string{`^(?=feature/).*$`}, true},
+		{"backreference matches", "foofoo", []string{`(foo)\1`}, true},
+		{"backreference rejects", "foobar", []string{`(foo)\1`}, false},
+		{"named group matches", "main", []string{`(?<branch>main)`}, true},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			ctx := BranchContext{HeadRef: c.headRef, BaseRef: c.headRef}
+			got, err := CheckAnyBranch(ctx, c.patterns, "head")
+			if err != nil {
+				t.Fatalf("CheckAnyBranch(%v) error: %v", c.patterns, err)
+			}
+			if got != c.want {
+				t.Fatalf("CheckAnyBranch(%v, %q) = %v, want %v", c.patterns, c.headRef, got, c.want)
+			}
+		})
+	}
+}
+
+// TestInvalidBranchPatternFails verifies a malformed branch pattern surfaces an
+// error (failing the action) instead of silently not matching.
+func TestInvalidBranchPatternFails(t *testing.T) {
+	ctx := BranchContext{HeadRef: "main", BaseRef: "main"}
+	if _, err := CheckAnyBranch(ctx, []string{"["}, "head"); err == nil {
+		t.Fatal("CheckAnyBranch: expected error for malformed pattern")
+	}
+	if _, err := CheckAllBranch(ctx, []string{"["}, "head"); err == nil {
+		t.Fatal("CheckAllBranch: expected error for malformed pattern")
+	}
+}
+
+// TestBranchPatternNotCompiledForEmptyBranchName verifies patterns are not
+// validated when there is no branch name, matching `new RegExp` only running
+// after the branch name check.
+func TestBranchPatternNotCompiledForEmptyBranchName(t *testing.T) {
+	ctx := BranchContext{}
+	got, err := CheckAnyBranch(ctx, []string{"["}, "head")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got {
+		t.Fatal("expected false for empty branch name")
+	}
+}
+
+func TestToBranchMatchConfig(t *testing.T) {
+	if got := ToBranchMatchConfig(node(t, "changed-files:\n  - any: ['testing']")); len(got.HeadBranch) != 0 || len(got.BaseBranch) != 0 {
+		t.Fatalf("expected empty, got %v", got)
+	}
+	got := ToBranchMatchConfig(node(t, "head-branch: ['testing']"))
+	if len(got.HeadBranch) != 1 || got.HeadBranch[0] != "testing" {
+		t.Fatalf("unexpected: %v", got)
+	}
+	got = ToBranchMatchConfig(node(t, "head-branch: testing"))
+	if len(got.HeadBranch) != 1 || got.HeadBranch[0] != "testing" {
+		t.Fatalf("unexpected: %v", got)
+	}
+	got = ToBranchMatchConfig(node(t, "base-branch: ['testing']"))
+	if len(got.BaseBranch) != 1 || got.BaseBranch[0] != "testing" {
+		t.Fatalf("unexpected: %v", got)
+	}
+	got = ToBranchMatchConfig(node(t, "base-branch: testing\nhead-branch: testing"))
+	if len(got.HeadBranch) != 1 || len(got.BaseBranch) != 1 {
+		t.Fatalf("unexpected: %v", got)
+	}
+}
diff --git a/internal/match/changedfiles.go b/internal/match/changedfiles.go
new file mode 100644
index 0000000..f55c25c
--- /dev/null
+++ b/internal/match/changedfiles.go
@@ -0,0 +1,127 @@
+package match
+
+import "github.com/actions/labeler/internal/minimatch"
+
+// CheckAnyChangedFiles reports whether any changed-files config option matches.
+func CheckAnyChangedFiles(changedFiles []string, configs []ChangedFilesGlobPatternsConfig, dot bool) bool {
+	for _, cfg := range configs {
+		if globs, ok := cfg["anyGlobToAnyFile"]; ok {
+			if CheckIfAnyGlobMatchesAnyFile(changedFiles, globs, dot) {
+				return true
+			}
+		}
+		if globs, ok := cfg["anyGlobToAllFiles"]; ok {
+			if CheckIfAnyGlobMatchesAllFiles(changedFiles, globs, dot) {
+				return true
+			}
+		}
+		if globs, ok := cfg["allGlobsToAnyFile"]; ok {
+			if CheckIfAllGlobsMatchAnyFile(changedFiles, globs, dot) {
+				return true
+			}
+		}
+		if globs, ok := cfg["allGlobsToAllFiles"]; ok {
+			if CheckIfAllGlobsMatchAllFiles(changedFiles, globs, dot) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// CheckAllChangedFiles reports whether every changed-files config option matches.
+func CheckAllChangedFiles(changedFiles []string, configs []ChangedFilesGlobPatternsConfig, dot bool) bool {
+	for _, cfg := range configs {
+		if globs, ok := cfg["anyGlobToAnyFile"]; ok {
+			if !CheckIfAnyGlobMatchesAnyFile(changedFiles, globs, dot) {
+				return false
+			}
+		}
+		if globs, ok := cfg["anyGlobToAllFiles"]; ok {
+			if !CheckIfAnyGlobMatchesAllFiles(changedFiles, globs, dot) {
+				return false
+			}
+		}
+		if globs, ok := cfg["allGlobsToAnyFile"]; ok {
+			if !CheckIfAllGlobsMatchAnyFile(changedFiles, globs, dot) {
+				return false
+			}
+		}
+		if globs, ok := cfg["allGlobsToAllFiles"]; ok {
+			if !CheckIfAllGlobsMatchAllFiles(changedFiles, globs, dot) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// CheckIfAnyGlobMatchesAnyFile reports whether any glob matches any file.
+func CheckIfAnyGlobMatchesAnyFile(changedFiles []string, globs []string, dot bool) bool {
+	matchers := compile(globs, dot)
+	for _, m := range matchers {
+		for _, f := range changedFiles {
+			if m.Match(f) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// CheckIfAllGlobsMatchAnyFile reports whether all globs match a single file.
+func CheckIfAllGlobsMatchAnyFile(changedFiles []string, globs []string, dot bool) bool {
+	matchers := compile(globs, dot)
+	for _, f := range changedFiles {
+		all := true
+		for _, m := range matchers {
+			if !m.Match(f) {
+				all = false
+				break
+			}
+		}
+		if all {
+			return true
+		}
+	}
+	return false
+}
+
+// CheckIfAnyGlobMatchesAllFiles reports whether any glob matches every file.
+func CheckIfAnyGlobMatchesAllFiles(changedFiles []string, globs []string, dot bool) bool {
+	matchers := compile(globs, dot)
+	for _, m := range matchers {
+		all := true
+		for _, f := range changedFiles {
+			if !m.Match(f) {
+				all = false
+				break
+			}
+		}
+		if all {
+			return true
+		}
+	}
+	return false
+}
+
+// CheckIfAllGlobsMatchAllFiles reports whether every glob matches every file.
+func CheckIfAllGlobsMatchAllFiles(changedFiles []string, globs []string, dot bool) bool {
+	matchers := compile(globs, dot)
+	for _, f := range changedFiles {
+		for _, m := range matchers {
+			if !m.Match(f) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func compile(globs []string, dot bool) []*minimatch.Matcher {
+	matchers := make([]*minimatch.Matcher, 0, len(globs))
+	for _, g := range globs {
+		matchers = append(matchers, minimatch.NewMatcher(g, dot))
+	}
+	return matchers
+}
diff --git a/internal/match/changedfiles_test.go b/internal/match/changedfiles_test.go
new file mode 100644
index 0000000..fce5111
--- /dev/null
+++ b/internal/match/changedfiles_test.go
@@ -0,0 +1,148 @@
+package match
+
+import (
+	"testing"
+
+	"gopkg.in/yaml.v3"
+)
+
+func node(t *testing.T, src string) *yaml.Node {
+	t.Helper()
+	var doc yaml.Node
+	if err := yaml.Unmarshal([]byte(src), &doc); err != nil {
+		t.Fatalf("yaml: %v", err)
+	}
+	if doc.Kind == yaml.DocumentNode && len(doc.Content) > 0 {
+		return doc.Content[0]
+	}
+	return &doc
+}
+
+func cfg(entries ...ChangedFilesGlobPatternsConfig) []ChangedFilesGlobPatternsConfig {
+	return entries
+}
+
+func one(key string, globs ...string) ChangedFilesGlobPatternsConfig {
+	return ChangedFilesGlobPatternsConfig{key: globs}
+}
+
+func TestCheckAllChangedFiles(t *testing.T) {
+	files := []string{"foo.txt", "bar.txt"}
+	all := cfg(
+		one("anyGlobToAnyFile", "foo.txt"),
+		one("anyGlobToAllFiles", "*.txt"),
+		one("allGlobsToAllFiles", "**"),
+	)
+	if !CheckAllChangedFiles(files, all, false) {
+		t.Fatalf("expected all configs to match")
+	}
+	some := cfg(
+		one("anyGlobToAnyFile", "*.md"),
+		one("anyGlobToAllFiles", "*.txt"),
+		one("allGlobsToAllFiles", "**"),
+	)
+	if CheckAllChangedFiles(files, some, false) {
+		t.Fatalf("expected some config to not match")
+	}
+}
+
+func TestCheckAnyChangedFiles(t *testing.T) {
+	files := []string{"foo.txt", "bar.txt"}
+	any := cfg(one("anyGlobToAnyFile", "*.md"), one("anyGlobToAllFiles", "*.txt"))
+	if !CheckAnyChangedFiles(files, any, false) {
+		t.Fatalf("expected any config to match")
+	}
+	none := cfg(one("anyGlobToAnyFile", "*.md"), one("anyGlobToAllFiles", "!*.txt"))
+	if CheckAnyChangedFiles(files, none, false) {
+		t.Fatalf("expected no config to match")
+	}
+}
+
+func TestToChangedFilesMatchConfig(t *testing.T) {
+	t.Run("no changed-files key", func(t *testing.T) {
+		c, err := ToChangedFilesMatchConfig(node(t, "head-branch: test"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(c) != 0 {
+			t.Fatalf("expected empty, got %v", c)
+		}
+	})
+
+	t.Run("invalid structure", func(t *testing.T) {
+		_, err := ToChangedFilesMatchConfig(node(t, "changed-files: ['bar']"))
+		if err == nil {
+			t.Fatal("expected error")
+		}
+		if err.Error() != `The "changed-files" section must have a valid config structure. Please read the action documentation for more information` {
+			t.Fatalf("unexpected error: %v", err)
+		}
+	})
+
+	t.Run("unknown key", func(t *testing.T) {
+		_, err := ToChangedFilesMatchConfig(node(t, "changed-files:\n  - NotValidConfigKey: ['bar']"))
+		if err == nil || err.Error() != `Unknown config options were under "changed-files": NotValidConfigKey` {
+			t.Fatalf("unexpected error: %v", err)
+		}
+	})
+
+	t.Run("array value", func(t *testing.T) {
+		c, err := ToChangedFilesMatchConfig(node(t, "changed-files:\n  - any-glob-to-any-file: ['testing']"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(c) != 1 || len(c[0]["anyGlobToAnyFile"]) != 1 || c[0]["anyGlobToAnyFile"][0] != "testing" {
+			t.Fatalf("unexpected config: %v", c)
+		}
+	})
+
+	t.Run("string value", func(t *testing.T) {
+		c, err := ToChangedFilesMatchConfig(node(t, "changed-files:\n  - any-glob-to-any-file: testing"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(c) != 1 || len(c[0]["anyGlobToAnyFile"]) != 1 || c[0]["anyGlobToAnyFile"][0] != "testing" {
+			t.Fatalf("unexpected config: %v", c)
+		}
+	})
+}
+
+func TestCheckIfAnyGlobMatchesAnyFile(t *testing.T) {
+	files := []string{"foo.txt", "bar.txt"}
+	if !CheckIfAnyGlobMatchesAnyFile(files, []string{"*.md", "foo.txt"}, false) {
+		t.Fatal("expected match")
+	}
+	if CheckIfAnyGlobMatchesAnyFile(files, []string{"*.md", "!*.txt"}, false) {
+		t.Fatal("expected no match")
+	}
+}
+
+func TestCheckIfAllGlobsMatchAnyFile(t *testing.T) {
+	files := []string{"foo.txt", "bar.txt"}
+	if !CheckIfAllGlobsMatchAnyFile(files, []string{"**/bar.txt", "bar.txt"}, false) {
+		t.Fatal("expected match")
+	}
+	if CheckIfAllGlobsMatchAnyFile(files, []string{"*.txt", "*.md"}, false) {
+		t.Fatal("expected no match")
+	}
+}
+
+func TestCheckIfAnyGlobMatchesAllFiles(t *testing.T) {
+	files := []string{"foo.txt", "bar.txt"}
+	if !CheckIfAnyGlobMatchesAllFiles(files, []string{"*.md", "*.txt"}, false) {
+		t.Fatal("expected match")
+	}
+	if CheckIfAnyGlobMatchesAllFiles(files, []string{"*.md", "bar.txt", "foo.txt"}, false) {
+		t.Fatal("expected no match")
+	}
+}
+
+func TestCheckIfAllGlobsMatchAllFiles(t *testing.T) {
+	files := []string{"foo.txt", "bar.txt"}
+	if !CheckIfAllGlobsMatchAllFiles(files, []string{"*.txt", "**"}, false) {
+		t.Fatal("expected match")
+	}
+	if CheckIfAllGlobsMatchAllFiles(files, []string{"**", "foo.txt"}, false) {
+		t.Fatal("expected no match")
+	}
+}
diff --git a/internal/match/compose.go b/internal/match/compose.go
new file mode 100644
index 0000000..3393c9e
--- /dev/null
+++ b/internal/match/compose.go
@@ -0,0 +1,159 @@
+package match
+
+// CheckMatchConfigs reports whether all match configs for a label match. A
+// malformed branch pattern is reported as an error so the action fails.
+func CheckMatchConfigs(changedFiles []string, matchConfigs []MatchConfig, dot bool, branches BranchContext) (bool, error) {
+	for _, config := range matchConfigs {
+		matched, err := checkMatch(changedFiles, config, dot, branches)
+		if err != nil {
+			return false, err
+		}
+		if !matched {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+func checkMatch(changedFiles []string, config MatchConfig, dot bool, branches BranchContext) (bool, error) {
+	if len(config.All) == 0 && len(config.Any) == 0 {
+		return false, nil
+	}
+	if config.All != nil {
+		matched, err := checkAll(config.All, changedFiles, dot, branches)
+		if err != nil {
+			return false, err
+		}
+		if !matched {
+			return false, nil
+		}
+	}
+	if config.Any != nil {
+		matched, err := checkAny(config.Any, changedFiles, dot, branches)
+		if err != nil {
+			return false, err
+		}
+		if !matched {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+func checkAny(matchConfigs []BaseMatchConfig, changedFiles []string, dot bool, branches BranchContext) (bool, error) {
+	if len(matchConfigs) == 0 {
+		return false, nil
+	}
+	hasKeys := false
+	for _, c := range matchConfigs {
+		if !isEmptyBase(c) {
+			hasKeys = true
+			break
+		}
+	}
+	if !hasKeys {
+		return false, nil
+	}
+	for _, c := range matchConfigs {
+		if len(c.BaseBranch) > 0 {
+			matched, err := CheckAnyBranch(branches, c.BaseBranch, "base")
+			if err != nil {
+				return false, err
+			}
+			if matched {
+				return true, nil
+			}
+		}
+		if len(c.ChangedFiles) > 0 && CheckAnyChangedFiles(changedFiles, c.ChangedFiles, dot) {
+			return true, nil
+		}
+		if len(c.HeadBranch) > 0 {
+			matched, err := CheckAnyBranch(branches, c.HeadBranch, "head")
+			if err != nil {
+				return false, err
+			}
+			if matched {
+				return true, nil
+			}
+		}
+	}
+	return false, nil
+}
+
+func checkAll(matchConfigs []BaseMatchConfig, changedFiles []string, dot bool, branches BranchContext) (bool, error) {
+	if len(matchConfigs) == 0 {
+		return false, nil
+	}
+	hasKeys := false
+	for _, c := range matchConfigs {
+		if !isEmptyBase(c) {
+			hasKeys = true
+			break
+		}
+	}
+	if !hasKeys {
+		return false, nil
+	}
+	for _, c := range matchConfigs {
+		if len(c.BaseBranch) > 0 {
+			matched, err := CheckAllBranch(branches, c.BaseBranch, "base")
+			if err != nil {
+				return false, err
+			}
+			if !matched {
+				return false, nil
+			}
+		}
+		if len(c.ChangedFiles) > 0 {
+			if len(changedFiles) == 0 {
+				return false, nil
+			}
+			if !CheckAllChangedFiles(changedFiles, c.ChangedFiles, dot) {
+				return false, nil
+			}
+		}
+		if len(c.HeadBranch) > 0 {
+			matched, err := CheckAllBranch(branches, c.HeadBranch, "head")
+			if err != nil {
+				return false, err
+			}
+			if !matched {
+				return false, nil
+			}
+		}
+	}
+	return true, nil
+}
+
+func isEmptyBase(c BaseMatchConfig) bool {
+	if len(c.ChangedFiles) > 0 || len(c.HeadBranch) > 0 || len(c.BaseBranch) > 0 {
+		return false
+	}
+	return true
+}
+
+// ConfigUsesChangedFiles reports whether any config option uses changed-files.
+func ConfigUsesChangedFiles(matchConfigs []MatchConfig) bool {
+	for _, config := range matchConfigs {
+		for _, base := range config.All {
+			if baseUsesChangedFiles(base) {
+				return true
+			}
+		}
+		for _, base := range config.Any {
+			if baseUsesChangedFiles(base) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func baseUsesChangedFiles(base BaseMatchConfig) bool {
+	for _, cf := range base.ChangedFiles {
+		if len(cf) > 0 {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/match/match.go b/internal/match/match.go
new file mode 100644
index 0000000..8c7fc30
--- /dev/null
+++ b/internal/match/match.go
@@ -0,0 +1,256 @@
+// Package match implements label configuration parsing and matching for the
+// labeler action.
+package match
+
+import (
+	"fmt"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/actions/labeler/internal/utils"
+)
+
+// ChangedFilesGlobPatternsConfig maps a changed-files glob configuration key
+// (for example "anyGlobToAnyFile") to its list of glob patterns. Using a map
+// preserves the "key present" semantics of the original JavaScript object.
+type ChangedFilesGlobPatternsConfig map[string][]string
+
+// BaseMatchConfig is a single match option composed of changed-files,
+// head-branch and base-branch rules.
+type BaseMatchConfig struct {
+	ChangedFiles []ChangedFilesGlobPatternsConfig
+	HeadBranch   []string
+	BaseBranch   []string
+}
+
+// MatchConfig groups options under the top-level "any" and/or "all" keys.
+type MatchConfig struct {
+	Any []BaseMatchConfig
+	All []BaseMatchConfig
+}
+
+// LabelConfigMap is an ordered mapping of label name to match configs.
+type LabelConfigMap struct {
+	Labels  []string
+	Configs map[string][]MatchConfig
+}
+
+// Has reports whether the label is present.
+func (m *LabelConfigMap) Has(label string) bool {
+	_, ok := m.Configs[label]
+	return ok
+}
+
+// Get returns the match configs for a label.
+func (m *LabelConfigMap) Get(label string) ([]MatchConfig, bool) {
+	c, ok := m.Configs[label]
+	return c, ok
+}
+
+var allowedChangedFilesKeys = map[string]bool{
+	"any-glob-to-any-file":   true,
+	"any-glob-to-all-files":  true,
+	"all-globs-to-any-file":  true,
+	"all-globs-to-all-files": true,
+}
+
+var allowedConfigKeys = map[string]bool{
+	"changed-files": true,
+	"head-branch":   true,
+	"base-branch":   true,
+}
+
+func isNull(n *yaml.Node) bool {
+	return n == nil || n.Kind == 0 || n.Tag == "!!null"
+}
+
+func mapValue(n *yaml.Node, key string) (*yaml.Node, bool) {
+	if n == nil || n.Kind != yaml.MappingNode {
+		return nil, false
+	}
+	for i := 0; i+1 < len(n.Content); i += 2 {
+		if n.Content[i].Value == key {
+			return n.Content[i+1], true
+		}
+	}
+	return nil, false
+}
+
+func toStringSlice(n *yaml.Node) []string {
+	if n == nil {
+		return nil
+	}
+	if n.Kind == yaml.SequenceNode {
+		out := make([]string, 0, len(n.Content))
+		for _, item := range n.Content {
+			out = append(out, item.Value)
+		}
+		return out
+	}
+	if n.Kind == yaml.ScalarNode {
+		return []string{n.Value}
+	}
+	return nil
+}
+
+// ToChangedFilesMatchConfig parses the "changed-files" section of a match
+// config node.
+func ToChangedFilesMatchConfig(config *yaml.Node) ([]ChangedFilesGlobPatternsConfig, error) {
+	cv, ok := mapValue(config, "changed-files")
+	if !ok || isNull(cv) {
+		return nil, nil
+	}
+	var items []*yaml.Node
+	if cv.Kind == yaml.SequenceNode {
+		items = cv.Content
+	} else {
+		items = []*yaml.Node{cv}
+	}
+	if len(items) == 0 {
+		return nil, nil
+	}
+
+	var result []ChangedFilesGlobPatternsConfig
+	for _, item := range items {
+		if item.Kind != yaml.MappingNode {
+			return nil, fmt.Errorf(
+				`The "changed-files" section must have a valid config structure. Please read the action documentation for more information`)
+		}
+		var invalid []string
+		for i := 0; i+1 < len(item.Content); i += 2 {
+			key := item.Content[i].Value
+			if !allowedChangedFilesKeys[key] {
+				invalid = append(invalid, key)
+			}
+		}
+		if len(invalid) > 0 {
+			return nil, fmt.Errorf(
+				`Unknown config options were under "changed-files": %s`,
+				strings.Join(invalid, ", "))
+		}
+		for i := 0; i+1 < len(item.Content); i += 2 {
+			key := item.Content[i].Value
+			val := item.Content[i+1]
+			cfg := ChangedFilesGlobPatternsConfig{}
+			cfg[utils.KebabToCamel(key)] = toStringSlice(val)
+			result = append(result, cfg)
+		}
+	}
+	return result, nil
+}
+
+// ToBranchMatchConfig parses the "head-branch"/"base-branch" sections.
+func ToBranchMatchConfig(config *yaml.Node) BaseMatchConfig {
+	var b BaseMatchConfig
+	if hv, ok := mapValue(config, "head-branch"); ok && !isNull(hv) {
+		b.HeadBranch = toStringSlice(hv)
+	}
+	if bv, ok := mapValue(config, "base-branch"); ok && !isNull(bv) {
+		b.BaseBranch = toStringSlice(bv)
+	}
+	return b
+}
+
+// ToMatchConfig composes a BaseMatchConfig from a config node.
+func ToMatchConfig(config *yaml.Node) (BaseMatchConfig, error) {
+	cfs, err := ToChangedFilesMatchConfig(config)
+	if err != nil {
+		return BaseMatchConfig{}, err
+	}
+	b := ToBranchMatchConfig(config)
+	b.ChangedFiles = cfs
+	return b, nil
+}
+
+// ParseLabelConfigMap builds an ordered label config map from a root YAML node,
+// skipping the supplied top-level option keys and reporting unknown keys via
+// info.
+func ParseLabelConfigMap(root *yaml.Node, skip map[string]bool, info func(string)) (*LabelConfigMap, error) {
+	m := &LabelConfigMap{Configs: map[string][]MatchConfig{}}
+	if root == nil || root.Kind != yaml.MappingNode {
+		return m, nil
+	}
+	for i := 0; i+1 < len(root.Content); i += 2 {
+		label := root.Content[i].Value
+		value := root.Content[i+1]
+		if skip[label] {
+			continue
+		}
+		if value.Kind != yaml.SequenceNode {
+			return nil, fmt.Errorf(
+				"found unexpected type for label '%s' (should be array of config options)", label)
+		}
+		matchConfigs, err := parseMatchConfigs(value, label, info)
+		if err != nil {
+			return nil, err
+		}
+		if len(matchConfigs) > 0 {
+			m.Labels = append(m.Labels, label)
+			m.Configs[label] = matchConfigs
+		}
+	}
+	return m, nil
+}
+
+func parseMatchConfigs(seq *yaml.Node, label string, info func(string)) ([]MatchConfig, error) {
+	var out []MatchConfig
+	for _, item := range seq.Content {
+		if isNull(item) {
+			continue
+		}
+		if item.Kind != yaml.MappingNode {
+			return nil, fmt.Errorf(
+				"found unexpected type for label '%s' (should be array of config options)", label)
+		}
+		for j := 0; j+1 < len(item.Content); j += 2 {
+			key := item.Content[j].Value
+			val := item.Content[j+1]
+			switch key {
+			case "any", "all":
+				if val.Kind != yaml.SequenceNode {
+					continue
+				}
+				bases := make([]BaseMatchConfig, 0, len(val.Content))
+				for _, sub := range val.Content {
+					mc, err := ToMatchConfig(sub)
+					if err != nil {
+						return nil, err
+					}
+					bases = append(bases, mc)
+				}
+				if key == "any" {
+					out = append(out, MatchConfig{Any: bases})
+				} else {
+					out = append(out, MatchConfig{All: bases})
+				}
+			case "changed-files", "head-branch", "base-branch":
+				synth := &yaml.Node{
+					Kind:    yaml.MappingNode,
+					Content: []*yaml.Node{item.Content[j], item.Content[j+1]},
+				}
+				mc, err := ToMatchConfig(synth)
+				if err != nil {
+					return nil, err
+				}
+				idx := -1
+				for k := range out {
+					if out[k].Any != nil {
+						idx = k
+						break
+					}
+				}
+				if idx >= 0 {
+					out[idx].Any = append(out[idx].Any, mc)
+				} else {
+					out = append(out, MatchConfig{Any: []BaseMatchConfig{mc}})
+				}
+			default:
+				if info != nil {
+					info(fmt.Sprintf("An unknown config option was under %s: %s", label, key))
+				}
+			}
+		}
+	}
+	return out, nil
+}
diff --git a/internal/match/match_test.go b/internal/match/match_test.go
new file mode 100644
index 0000000..53b39d3
--- /dev/null
+++ b/internal/match/match_test.go
@@ -0,0 +1,152 @@
+package match
+
+import (
+	"os"
+	"testing"
+
+	"gopkg.in/yaml.v3"
+)
+
+func TestToMatchConfigAllOptions(t *testing.T) {
+	got, err := ToMatchConfig(node(t, "'changed-files':\n  - any-glob-to-any-file: ['testing-files']\n'head-branch': ['testing-head']\n'base-branch': ['testing-base']\n'test-test': testing"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got.ChangedFiles) != 1 || got.ChangedFiles[0]["anyGlobToAnyFile"][0] != "testing-files" {
+		t.Fatalf("changedFiles: %v", got.ChangedFiles)
+	}
+	if len(got.HeadBranch) != 1 || got.HeadBranch[0] != "testing-head" {
+		t.Fatalf("headBranch: %v", got.HeadBranch)
+	}
+	if len(got.BaseBranch) != 1 || got.BaseBranch[0] != "testing-base" {
+		t.Fatalf("baseBranch: %v", got.BaseBranch)
+	}
+}
+
+func TestParseLabelConfigMapAllOptions(t *testing.T) {
+	data, err := os.ReadFile("../../testdata/fixtures/all_options.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var doc yaml.Node
+	if err := yaml.Unmarshal(data, &doc); err != nil {
+		t.Fatal(err)
+	}
+	root := doc.Content[0]
+	m, err := ParseLabelConfigMap(root, map[string]bool{}, func(string) {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(m.Labels) != 2 || m.Labels[0] != "label1" || m.Labels[1] != "label2" {
+		t.Fatalf("labels order: %v", m.Labels)
+	}
+
+	l1 := m.Configs["label1"]
+	if len(l1) != 2 {
+		t.Fatalf("label1 configs: %d", len(l1))
+	}
+	if len(l1[0].Any) != 3 || len(l1[1].All) != 3 {
+		t.Fatalf("label1 any/all sizes: %d/%d", len(l1[0].Any), len(l1[1].All))
+	}
+	if l1[0].Any[0].ChangedFiles[0]["anyGlobToAnyFile"][0] != "glob" {
+		t.Fatalf("label1 any[0] changedfiles: %v", l1[0].Any[0].ChangedFiles)
+	}
+	if l1[0].Any[1].HeadBranch[0] != "regexp" {
+		t.Fatalf("label1 any[1] head: %v", l1[0].Any[1].HeadBranch)
+	}
+	if l1[0].Any[2].BaseBranch[0] != "regexp" {
+		t.Fatalf("label1 any[2] base: %v", l1[0].Any[2].BaseBranch)
+	}
+	if l1[1].All[0].ChangedFiles[0]["allGlobsToAllFiles"][0] != "glob" {
+		t.Fatalf("label1 all[0] changedfiles: %v", l1[1].All[0].ChangedFiles)
+	}
+
+	l2 := m.Configs["label2"]
+	if len(l2) != 1 || len(l2[0].Any) != 3 {
+		t.Fatalf("label2: %v", l2)
+	}
+}
+
+func TestParseLabelConfigMapSkipsOptions(t *testing.T) {
+	data, err := os.ReadFile("../../testdata/fixtures/all_options.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = data
+	root := node(t, "changed-files-labels-limit: 5\nmax-files-changed: 100\nlabel1:\n  - changed-files:\n      - any-glob-to-any-file: ['*.txt']")
+	m, err := ParseLabelConfigMap(root, map[string]bool{
+		"changed-files-labels-limit": true,
+		"max-files-changed":          true,
+	}, func(string) {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.Has("changed-files-labels-limit") || m.Has("max-files-changed") {
+		t.Fatal("options treated as labels")
+	}
+	if !m.Has("label1") {
+		t.Fatal("label1 missing")
+	}
+}
+
+func TestCheckMatchConfigs(t *testing.T) {
+	matchConfig := []MatchConfig{
+		{Any: []BaseMatchConfig{{ChangedFiles: []ChangedFilesGlobPatternsConfig{{"anyGlobToAnyFile": {"*.txt"}}}}}},
+	}
+	ctx := BranchContext{HeadRef: "head-branch", BaseRef: "base-branch"}
+	if got, err := CheckMatchConfigs([]string{"foo.txt", "bar.txt"}, matchConfig, false, ctx); err != nil || !got {
+		t.Fatalf("expected match, got %v err %v", got, err)
+	}
+	if got, err := CheckMatchConfigs([]string{"foo.docx"}, matchConfig, false, ctx); err != nil || got {
+		t.Fatalf("expected no match, got %v err %v", got, err)
+	}
+	if got, err := CheckMatchConfigs([]string{".foo.txt"}, matchConfig, false, ctx); err != nil || got {
+		t.Fatalf("expected dot file rejected, got %v err %v", got, err)
+	}
+	if got, err := CheckMatchConfigs([]string{".foo.txt"}, matchConfig, true, ctx); err != nil || !got {
+		t.Fatalf("expected dot file matched, got %v err %v", got, err)
+	}
+
+	both := []MatchConfig{
+		{Any: []BaseMatchConfig{{ChangedFiles: []ChangedFilesGlobPatternsConfig{{"anyGlobToAnyFile": {"*.txt"}}}}}},
+		{Any: []BaseMatchConfig{{HeadBranch: []string{"head-branch"}}}},
+	}
+	if got, err := CheckMatchConfigs([]string{"foo.txt", "bar.md"}, both, false, ctx); err != nil || !got {
+		t.Fatalf("expected both configs to match, got %v err %v", got, err)
+	}
+
+	oneOnly := []MatchConfig{
+		{Any: []BaseMatchConfig{{ChangedFiles: []ChangedFilesGlobPatternsConfig{{"anyGlobToAnyFile": {"*.txt"}}}}}},
+		{Any: []BaseMatchConfig{{HeadBranch: []string{"other-branch"}}}},
+	}
+	if got, err := CheckMatchConfigs([]string{"foo.txt", "bar.md"}, oneOnly, false, ctx); err != nil || got {
+		t.Fatalf("expected one config to fail, got %v err %v", got, err)
+	}
+
+	invalid := []MatchConfig{
+		{Any: []BaseMatchConfig{{HeadBranch: []string{"["}}}},
+	}
+	if _, err := CheckMatchConfigs([]string{"foo.txt"}, invalid, false, ctx); err == nil {
+		t.Fatal("expected error for malformed branch pattern")
+	}
+}
+
+func TestConfigUsesChangedFiles(t *testing.T) {
+	cases := []struct {
+		name string
+		cfg  []MatchConfig
+		want bool
+	}{
+		{"any", []MatchConfig{{Any: []BaseMatchConfig{{ChangedFiles: []ChangedFilesGlobPatternsConfig{{"anyGlobToAnyFile": {"*.txt"}}}}}}}, true},
+		{"all", []MatchConfig{{All: []BaseMatchConfig{{ChangedFiles: []ChangedFilesGlobPatternsConfig{{"allGlobsToAllFiles": {"*.txt"}}}}}}}, true},
+		{"branch only", []MatchConfig{{Any: []BaseMatchConfig{{HeadBranch: []string{"^test/"}}}}, {Any: []BaseMatchConfig{{BaseBranch: []string{"main"}}}}}, false},
+		{"empty changed-files", []MatchConfig{{Any: []BaseMatchConfig{{ChangedFiles: []ChangedFilesGlobPatternsConfig{}}}}}, false},
+		{"empty object", []MatchConfig{{Any: []BaseMatchConfig{{ChangedFiles: []ChangedFilesGlobPatternsConfig{{}}}}}}, false},
+		{"mixed", []MatchConfig{{Any: []BaseMatchConfig{{ChangedFiles: []ChangedFilesGlobPatternsConfig{{"anyGlobToAnyFile": {"*.txt"}}}}, {HeadBranch: []string{"^feature/"}}}}}, true},
+	}
+	for _, c := range cases {
+		if got := ConfigUsesChangedFiles(c.cfg); got != c.want {
+			t.Fatalf("%s: got %v want %v", c.name, got, c.want)
+		}
+	}
+}
diff --git a/internal/minimatch/minimatch.go b/internal/minimatch/minimatch.go
new file mode 100644
index 0000000..e3cd367
--- /dev/null
+++ b/internal/minimatch/minimatch.go
@@ -0,0 +1,525 @@
+// Package minimatch implements a minimatch-compatible glob matcher.
+//
+// It reproduces the subset of minimatch semantics used by the labeler action:
+// leading '!' negation, globstar, brace expansion, extglob groups, character
+// classes, escaping and the dot option.
+package minimatch
+
+import "strings"
+
+type tokenKind int
+
+const (
+	tokLit tokenKind = iota
+	tokStar
+	tokQuestion
+	tokClass
+	tokGroup
+)
+
+type classRange struct {
+	lo rune
+	hi rune
+}
+
+type token struct {
+	kind     tokenKind
+	lit      string
+	neg      bool
+	ranges   []classRange
+	group    byte
+	alts     [][]token
+	explicit bool
+}
+
+// segment is a compiled path segment. When globstar is true the segment is a
+// bare "**" and matches zero or more path segments.
+type segment struct {
+	globstar bool
+	tokens   []token
+}
+
+// Matcher is a compiled glob pattern.
+type Matcher struct {
+	pattern string
+	negate  bool
+	dot     bool
+	alts    [][]segment
+}
+
+// NewMatcher compiles pattern. When dot is false wildcards do not match
+// path segments that begin with a dot unless the pattern explicitly does.
+func NewMatcher(pattern string, dot bool) *Matcher {
+	m := &Matcher{pattern: pattern, dot: dot}
+	p := pattern
+	for strings.HasPrefix(p, "!") {
+		m.negate = !m.negate
+		p = p[1:]
+	}
+	m.pattern = p
+
+	for _, expanded := range expandBraces(p) {
+		m.alts = append(m.alts, compileSegments(expanded))
+	}
+	if len(m.alts) == 0 {
+		m.alts = append(m.alts, compileSegments(p))
+	}
+	return m
+}
+
+// Pattern returns the pattern without a leading negation marker.
+func (m *Matcher) Pattern() string { return m.pattern }
+
+// Negate reports whether the pattern began with a '!' negation.
+func (m *Matcher) Negate() bool { return m.negate }
+
+// PrintPattern reproduces the debug rendering used by the action.
+func (m *Matcher) PrintPattern() string {
+	if m.negate {
+		return "!" + m.pattern
+	}
+	return m.pattern
+}
+
+// Match reports whether name matches the pattern, applying minimatch negation
+// semantics: a negated pattern matches when the inner pattern does not.
+func (m *Matcher) Match(name string) bool {
+	inner := false
+	for _, segs := range m.alts {
+		if matchSegments(segs, splitPath(name), m.dot) {
+			inner = true
+			break
+		}
+	}
+	if m.negate {
+		return !inner
+	}
+	return inner
+}
+
+func splitPath(name string) []string {
+	if name == "" {
+		return nil
+	}
+	return strings.Split(name, "/")
+}
+
+func compileSegments(pattern string) []segment {
+	parts := strings.Split(pattern, "/")
+	segs := make([]segment, 0, len(parts))
+	for _, part := range parts {
+		if part == "**" {
+			segs = append(segs, segment{globstar: true})
+			continue
+		}
+		toks, _ := parseSeq([]rune(part), 0, false)
+		segs = append(segs, segment{tokens: toks})
+	}
+	return segs
+}
+
+func matchSegments(segs []segment, parts []string, dot bool) bool {
+	if len(segs) == 0 {
+		return len(parts) == 0
+	}
+	seg := segs[0]
+	if seg.globstar {
+		if len(segs) == 1 {
+			if len(parts) == 0 {
+				return false
+			}
+			for _, p := range parts {
+				if p == "" {
+					continue
+				}
+				if !dot && strings.HasPrefix(p, ".") {
+					return false
+				}
+			}
+			return true
+		}
+		for k := 0; k <= len(parts); k++ {
+			if k > 0 && !dot && strings.HasPrefix(parts[k-1], ".") {
+				break
+			}
+			if matchSegments(segs[1:], parts[k:], dot) {
+				return true
+			}
+		}
+		return false
+	}
+	if len(parts) == 0 {
+		return false
+	}
+	if !matchTokens(seg.tokens, parts[0], dot) {
+		return false
+	}
+	return matchSegments(segs[1:], parts[1:], dot)
+}
+
+func matchTokens(toks []token, s string, dot bool) bool {
+	if s == "" {
+		return len(toks) == 0
+	}
+	if strings.HasPrefix(s, ".") && !dot && !patternAllowsLeadingDot(toks) {
+		return false
+	}
+	rs := []rune(s)
+	for _, end := range matchEnds(toks, 0, rs, 0) {
+		if end == len(rs) {
+			return true
+		}
+	}
+	return false
+}
+
+// patternAllowsLeadingDot reports whether a pattern segment is permitted to
+// match a path segment that begins with a dot. A literal leading dot permits
+// it, as do optional/repeat extglob groups that may match the empty string
+// before an explicit dot (mirroring minimatch).
+func patternAllowsLeadingDot(toks []token) bool {
+	for _, t := range toks {
+		switch {
+		case t.kind == tokLit:
+			return strings.HasPrefix(t.lit, ".")
+		case t.kind == tokGroup && (t.group == '?' || t.group == '*'):
+			continue
+		default:
+			return false
+		}
+	}
+	return false
+}
+
+// matchEnds returns every end position reachable after consuming toks[ti:].
+func matchEnds(toks []token, ti int, s []rune, si int) []int {
+	if ti == len(toks) {
+		return []int{si}
+	}
+	t := toks[ti]
+	var ends []int
+	appendNext := func(pos int) {
+		ends = append(ends, matchEnds(toks, ti+1, s, pos)...)
+	}
+	switch t.kind {
+	case tokLit:
+		if si+len(t.lit) <= len(s) && string(s[si:si+len(t.lit)]) == t.lit {
+			appendNext(si + len(t.lit))
+		}
+	case tokQuestion:
+		if si < len(s) {
+			appendNext(si + 1)
+		}
+	case tokClass:
+		if si < len(s) && t.matchClass(s[si]) {
+			appendNext(si + 1)
+		}
+	case tokStar:
+		for k := 0; si+k <= len(s); k++ {
+			appendNext(si + k)
+		}
+	case tokGroup:
+		for _, e := range groupEnds(t, s, si) {
+			appendNext(e)
+		}
+	}
+	return ends
+}
+
+func (t token) matchClass(r rune) bool {
+	matched := false
+	for _, cr := range t.ranges {
+		if r >= cr.lo && r <= cr.hi {
+			matched = true
+			break
+		}
+	}
+	if t.neg {
+		return !matched
+	}
+	return matched
+}
+
+func groupEnds(t token, s []rune, si int) []int {
+	switch t.group {
+	case '@':
+		return applyAltsOnce(t.alts, s, si)
+	case '?':
+		ends := []int{si}
+		return append(ends, applyAltsOnce(t.alts, s, si)...)
+	case '+':
+		return closure(t.alts, s, si, false)
+	case '*':
+		return closure(t.alts, s, si, true)
+	case '!':
+		var ends []int
+		rs := string(s)
+		for e := si; e <= len(s); e++ {
+			sub := rs[si:e]
+			if !anyAltMatches(t.alts, sub) {
+				ends = append(ends, e)
+			}
+		}
+		return ends
+	}
+	return nil
+}
+
+func applyAltsOnce(alts [][]token, s []rune, si int) []int {
+	var ends []int
+	for _, alt := range alts {
+		ends = append(ends, matchEnds(alt, 0, s, si)...)
+	}
+	return ends
+}
+
+func closure(alts [][]token, s []rune, si int, includeStart bool) []int {
+	seen := map[int]bool{}
+	var result []int
+	var frontier []int
+	if includeStart {
+		seen[si] = true
+		result = append(result, si)
+		frontier = []int{si}
+	} else {
+		for _, e := range applyAltsOnce(alts, s, si) {
+			if !seen[e] {
+				seen[e] = true
+				result = append(result, e)
+				frontier = append(frontier, e)
+			}
+		}
+	}
+	for len(frontier) > 0 {
+		pos := frontier[0]
+		frontier = frontier[1:]
+		for _, e := range applyAltsOnce(alts, s, pos) {
+			if !seen[e] {
+				seen[e] = true
+				result = append(result, e)
+				frontier = append(frontier, e)
+			}
+		}
+	}
+	return result
+}
+
+func anyAltMatches(alts [][]token, sub string) bool {
+	rs := []rune(sub)
+	for _, alt := range alts {
+		for _, end := range matchEnds(alt, 0, rs, 0) {
+			if end == len(rs) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func parseSeq(p []rune, i int, inGroup bool) ([]token, int) {
+	var toks []token
+	for i < len(p) {
+		c := p[i]
+		if inGroup && (c == '|' || c == ')') {
+			break
+		}
+		switch c {
+		case '\\':
+			if i+1 < len(p) {
+				toks = append(toks, token{kind: tokLit, lit: string(p[i+1])})
+				i += 2
+			} else {
+				toks = append(toks, token{kind: tokLit, lit: "\\"})
+				i++
+			}
+		case '*':
+			if i+1 < len(p) && p[i+1] == '(' {
+				if alts, ni, ok := parseGroup(p, i+2); ok {
+					toks = append(toks, token{kind: tokGroup, group: '*', alts: alts})
+					i = ni
+					continue
+				}
+			}
+			toks = append(toks, token{kind: tokStar})
+			i++
+		case '?':
+			if i+1 < len(p) && p[i+1] == '(' {
+				if alts, ni, ok := parseGroup(p, i+2); ok {
+					toks = append(toks, token{kind: tokGroup, group: '?', alts: alts})
+					i = ni
+					continue
+				}
+			}
+			toks = append(toks, token{kind: tokQuestion})
+			i++
+		case '@', '+', '!':
+			if i+1 < len(p) && p[i+1] == '(' {
+				if alts, ni, ok := parseGroup(p, i+2); ok {
+					toks = append(toks, token{kind: tokGroup, group: byte(c), alts: alts})
+					i = ni
+					continue
+				}
+			}
+			toks = append(toks, token{kind: tokLit, lit: string(c)})
+			i++
+		case '[':
+			if cls, ni, ok := parseClass(p, i); ok {
+				toks = append(toks, cls)
+				i = ni
+			} else {
+				toks = append(toks, token{kind: tokLit, lit: "["})
+				i++
+			}
+		default:
+			toks = append(toks, token{kind: tokLit, lit: string(c)})
+			i++
+		}
+	}
+	return toks, i
+}
+
+func parseGroup(p []rune, i int) ([][]token, int, bool) {
+	var alts [][]token
+	for {
+		toks, next := parseSeq(p, i, true)
+		alts = append(alts, toks)
+		i = next
+		if i >= len(p) {
+			break
+		}
+		if p[i] == ')' {
+			return alts, i + 1, true
+		}
+		// p[i] == '|'
+		i++
+	}
+	return alts, i + 1, true
+}
+
+func parseClass(p []rune, i int) (token, int, bool) {
+	j := i + 1
+	neg := false
+	if j < len(p) && (p[j] == '!' || p[j] == '^') {
+		neg = true
+		j++
+	}
+	var ranges []classRange
+	first := true
+	for j < len(p) {
+		c := p[j]
+		if c == ']' && !first {
+			return token{kind: tokClass, neg: neg, ranges: ranges}, j + 1, true
+		}
+		first = false
+		if c == '\\' && j+1 < len(p) {
+			j++
+			c = p[j]
+		}
+		if j+2 < len(p) && p[j+1] == '-' && p[j+2] != ']' {
+			hi := p[j+2]
+			ranges = append(ranges, classRange{lo: c, hi: hi})
+			j += 3
+			continue
+		}
+		ranges = append(ranges, classRange{lo: c, hi: c})
+		j++
+	}
+	return token{}, i, false
+}
+
+func expandBraces(pattern string) []string {
+	open := findOpenBrace(pattern)
+	if open < 0 {
+		return []string{pattern}
+	}
+	closeIdx := findCloseBrace(pattern, open)
+	if closeIdx < 0 {
+		return []string{pattern}
+	}
+	inner := pattern[open+1 : closeIdx]
+	parts := splitTopLevelComma(inner)
+	if len(parts) <= 1 {
+		return []string{pattern}
+	}
+	var result []string
+	for _, part := range parts {
+		next := pattern[:open] + part + pattern[closeIdx+1:]
+		result = append(result, expandBraces(next)...)
+	}
+	return result
+}
+
+func findOpenBrace(p string) int {
+	escaped := false
+	for i, c := range p {
+		if escaped {
+			escaped = false
+			continue
+		}
+		if c == '\\' {
+			escaped = true
+			continue
+		}
+		if c == '{' {
+			return i
+		}
+	}
+	return -1
+}
+
+func findCloseBrace(p string, open int) int {
+	depth := 0
+	escaped := false
+	for i := open; i < len(p); i++ {
+		c := p[i]
+		if escaped {
+			escaped = false
+			continue
+		}
+		if c == '\\' {
+			escaped = true
+			continue
+		}
+		switch c {
+		case '{':
+			depth++
+		case '}':
+			depth--
+			if depth == 0 {
+				return i
+			}
+		}
+	}
+	return -1
+}
+
+func splitTopLevelComma(s string) []string {
+	var parts []string
+	depth := 0
+	escaped := false
+	last := 0
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if escaped {
+			escaped = false
+			continue
+		}
+		if c == '\\' {
+			escaped = true
+			continue
+		}
+		switch c {
+		case '{':
+			depth++
+		case '}':
+			depth--
+		case ',':
+			if depth == 0 {
+				parts = append(parts, s[last:i])
+				last = i + 1
+			}
+		}
+	}
+	parts = append(parts, s[last:])
+	return parts
+}
