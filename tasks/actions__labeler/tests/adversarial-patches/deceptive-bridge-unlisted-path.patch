+package config
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"gopkg.in/yaml.v3"
+)
+
+func parse(t *testing.T, src string) *LabelConfigResult {
+	t.Helper()
+	var doc yaml.Node
+	if err := yaml.Unmarshal([]byte(src), &doc); err != nil {
+		t.Fatalf("yaml: %v", err)
+	}
+	res, err := GetLabelConfigResultFromObject(&doc)
+	if err != nil {
+		t.Fatalf("GetLabelConfigResultFromObject: %v", err)
+	}
+	return res
+}
+
+const validLabel = "label1:\n  - changed-files:\n      - any-glob-to-any-file: ['*.txt']\n"
+
+func TestLimitParsing(t *testing.T) {
+	res := parse(t, "changed-files-labels-limit: 5\n"+validLabel)
+	if res.ChangedFilesLimit == nil || *res.ChangedFilesLimit != 5 {
+		t.Fatalf("limit = %v", res.ChangedFilesLimit)
+	}
+	if !res.LabelConfigs.Has("label1") {
+		t.Fatal("label1 missing")
+	}
+
+	res = parse(t, "changed-files-labels-limit: '10'\n"+validLabel)
+	if res.ChangedFilesLimit == nil || *res.ChangedFilesLimit != 10 {
+		t.Fatalf("limit = %v", res.ChangedFilesLimit)
+	}
+
+	res = parse(t, "changed-files-labels-limit: ' 5 '\n"+validLabel)
+	if res.ChangedFilesLimit == nil || *res.ChangedFilesLimit != 5 {
+		t.Fatalf("limit = %v", res.ChangedFilesLimit)
+	}
+
+	res = parse(t, validLabel)
+	if res.ChangedFilesLimit != nil {
+		t.Fatalf("limit should be nil, got %v", *res.ChangedFilesLimit)
+	}
+
+	res = parse(t, "changed-files-labels-limit: 0\n"+validLabel)
+	if res.ChangedFilesLimit == nil || *res.ChangedFilesLimit != 0 {
+		t.Fatalf("limit = %v", res.ChangedFilesLimit)
+	}
+}
+
+func TestLimitErrors(t *testing.T) {
+	cases := []struct {
+		src string
+		msg string
+	}{
+		{"changed-files-labels-limit: 'invalid'\n" + validLabel, "Invalid value for 'changed-files-labels-limit'"},
+		{"changed-files-labels-limit: -1\n" + validLabel, "must be a non-negative integer"},
+		{"changed-files-labels-limit: '10abc'\n" + validLabel, "must be a non-negative integer"},
+		{"changed-files-labels-limit: '3.2'\n" + validLabel, "must be a non-negative integer"},
+		{"changed-files-labels-limit: 3.2\n" + validLabel, "must be a non-negative integer"},
+		{"changed-files-labels-limit:\n  - changed-files: []\n", "reserved top-level option and cannot be used as a label name"},
+	}
+	for _, c := range cases {
+		var doc yaml.Node
+		if err := yaml.Unmarshal([]byte(c.src), &doc); err != nil {
+			t.Fatalf("yaml: %v", err)
+		}
+		_, err := GetLabelConfigResultFromObject(&doc)
+		if err == nil || !strings.Contains(err.Error(), c.msg) {
+			t.Fatalf("src %q: err = %v, want contains %q", c.src, err, c.msg)
+		}
+	}
+}
+
+func TestMaxFilesChanged(t *testing.T) {
+	res := parse(t, "max-files-changed: 100\n"+validLabel)
+	if res.MaxFilesChanged == nil || *res.MaxFilesChanged != 100 {
+		t.Fatalf("max = %v", res.MaxFilesChanged)
+	}
+	res = parse(t, "max-files-changed: '50'\n"+validLabel)
+	if res.MaxFilesChanged == nil || *res.MaxFilesChanged != 50 {
+		t.Fatalf("max = %v", res.MaxFilesChanged)
+	}
+	res = parse(t, validLabel)
+	if res.MaxFilesChanged != nil {
+		t.Fatalf("max should be nil")
+	}
+	res = parse(t, "max-files-changed: 0\n"+validLabel)
+	if res.MaxFilesChanged == nil || *res.MaxFilesChanged != 0 {
+		t.Fatalf("max = %v", res.MaxFilesChanged)
+	}
+	res = parse(t, "changed-files-labels-limit: 5\nmax-files-changed: 100\n"+validLabel)
+	if res.ChangedFilesLimit == nil || *res.ChangedFilesLimit != 5 || res.MaxFilesChanged == nil || *res.MaxFilesChanged != 100 {
+		t.Fatalf("both options: %v %v", res.ChangedFilesLimit, res.MaxFilesChanged)
+	}
+}
+
+type fakeFetcher struct {
+	content string
+	err     error
+}
+
+func (f *fakeFetcher) GetContent(string) (string, error) { return f.content, f.err }
+
+type fakeAPIError struct{ name string }
+
+func (e *fakeAPIError) Error() string     { return "api error" }
+func (e *fakeAPIError) ErrorName() string { return e.name }
+func (e *fakeAPIError) StatusCode() int   { return 404 }
+
+func TestLoadConfigLocalFirst(t *testing.T) {
+	res, err := LoadConfig(&fakeFetcher{err: errors.New("should not be called")}, "../../testdata/fixtures/only_pdfs.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !res.LabelConfigs.Has("touched-a-pdf-file") {
+		t.Fatal("expected local config to load")
+	}
+}
+
+func TestLoadConfigAPIFallback(t *testing.T) {
+	fetcher := &fakeFetcher{content: "label1:\n  - changed-files:\n      - any-glob-to-any-file: ['*.txt']\n"}
+	res, err := LoadConfig(fetcher, "does/not/exist/labeler.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !res.LabelConfigs.Has("label1") {
+		t.Fatal("expected fetched config to load")
+	}
+}
+
+func TestLoadConfigFetchError(t *testing.T) {
+	fetcher := &fakeFetcher{err: &fakeAPIError{name: "HttpError"}}
+	_, err := LoadConfig(fetcher, "does/not/exist/labeler.yml")
+	if err == nil {
+		t.Fatal("expected error")
+	}
+}
diff --git a/internal/core/core.go b/internal/core/core.go
new file mode 100644
index 0000000..0247a93
--- /dev/null
+++ b/internal/core/core.go
@@ -0,0 +1,143 @@
+// Package core mirrors the subset of @actions/core used by the labeler,
+// implemented directly on top of the GitHub Actions runtime environment.
+package core
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// Out is the destination for informational and workflow-command output.
+var Out io.Writer = os.Stdout
+
+var (
+	failed         bool
+	failureMessage string
+)
+
+// Reset clears any recorded failure. It is intended for tests.
+func Reset() {
+	failed = false
+	failureMessage = ""
+}
+
+// SetFailed records a failure with the given message.
+func SetFailed(message string) {
+	failed = true
+	failureMessage = message
+	Error(message)
+}
+
+// Failed reports whether a failure was recorded and its message.
+func Failed() (bool, string) {
+	return failed, failureMessage
+}
+
+// HasFailed reports whether a failure was recorded.
+func HasFailed() bool { return failed }
+
+// InputEnvName maps an input name to its environment variable, matching the
+// conversion performed by @actions/core (spaces become underscores).
+func InputEnvName(name string) string {
+	return "INPUT_" + strings.ToUpper(strings.ReplaceAll(name, " ", "_"))
+}
+
+// GetInput reads an input from the environment.
+func GetInput(name string, required bool) (string, error) {
+	val := os.Getenv(InputEnvName(name))
+	if required && val == "" {
+		return "", fmt.Errorf("Input required and not supplied: %s", name)
+	}
+	return val, nil
+}
+
+// GetMultilineInput reads a multiline input, dropping blank lines.
+func GetMultilineInput(name string, required bool) ([]string, error) {
+	raw, err := GetInput(name, required)
+	if err != nil {
+		return nil, err
+	}
+	if raw == "" {
+		return nil, nil
+	}
+	lines := strings.Split(strings.ReplaceAll(raw, "\r\n", "\n"), "\n")
+	var out []string
+	for _, line := range lines {
+		if strings.TrimSpace(line) != "" {
+			out = append(out, line)
+		}
+	}
+	return out, nil
+}
+
+// GetBooleanInput parses a YAML 1.2 core-schema boolean input.
+func GetBooleanInput(name string, required bool) (bool, error) {
+	raw, err := GetInput(name, required)
+	if err != nil {
+		return false, err
+	}
+	switch raw {
+	case "true", "True", "TRUE":
+		return true, nil
+	case "false", "False", "FALSE":
+		return false, nil
+	default:
+		return false, fmt.Errorf(
+			"Input does not meet YAML 1.2 \"Core Schema\" specification: %s\n"+
+				"Support boolean input list: `true | True | TRUE | false | False | FALSE`", name)
+	}
+}
+
+// SetOutput appends an output to the file named by GITHUB_OUTPUT.
+func SetOutput(name, value string) error {
+	filePath := os.Getenv("GITHUB_OUTPUT")
+	if filePath == "" {
+		_, err := fmt.Fprintf(Out, "::set-output name=%s::%s\n", name, value)
+		return err
+	}
+	f, err := os.OpenFile(filePath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	delimiter := "ghadelimiter_" + randomHex()
+	_, err = fmt.Fprintf(f, "%s<<%s\n%s\n%s\n", name, delimiter, value, delimiter)
+	return err
+}
+
+func randomHex() string {
+	b := make([]byte, 16)
+	if _, err := rand.Read(b); err != nil {
+		return strconv.FormatInt(int64(os.Getpid()), 16)
+	}
+	return hex.EncodeToString(b)
+}
+
+// Debug writes a debug workflow command.
+func Debug(message string) {
+	fmt.Fprintf(Out, "::debug::%s\n", message)
+}
+
+// Info writes an informational message.
+func Info(message string) {
+	fmt.Fprintln(Out, message)
+}
+
+// Warning writes a warning with an optional title.
+func Warning(message string, title string) {
+	if title != "" {
+		fmt.Fprintf(Out, "::warning title=%s::%s\n", title, message)
+		return
+	}
+	fmt.Fprintf(Out, "::warning::%s\n", message)
+}
+
+// Error writes an error workflow command.
+func Error(message string) {
+	fmt.Fprintf(Out, "::error::%s\n", message)
+}
