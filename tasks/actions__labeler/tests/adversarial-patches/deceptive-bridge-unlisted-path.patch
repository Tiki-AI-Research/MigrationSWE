new file mode 100644
index 0000000..5ecba11
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,12 @@
+# Build a static Go binary for the labeler action.
+FROM golang:1.24.0 AS build
+WORKDIR /src
+COPY go.mod go.sum ./
+RUN go mod download
+COPY . .
+RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/labeler ./cmd/labeler
+
+FROM alpine:3.20
+RUN apk add --no-cache ca-certificates
+COPY --from=build /out/labeler /usr/local/bin/labeler
+ENTRYPOINT ["/usr/local/bin/labeler"]
