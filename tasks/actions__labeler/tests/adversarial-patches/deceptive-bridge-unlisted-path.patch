+type runOptions struct {
+	configPath string
+	prNumbers  []int
+	syncLabels bool
+	dot        bool
+	headRef    string
+	baseRef    string
+	token      string
+}
+
+func runLabeler(t *testing.T, f *fakeGitHub, o runOptions) (error, map[string]string, string) {
+	t.Helper()
+	if o.headRef == "" {
+		o.headRef = "head-branch-name"
+	}
+	if o.baseRef == "" {
+		o.baseRef = "base-branch-name"
+	}
+	if o.token == "" {
+		o.token = "foo"
+	}
+	outFile := filepath.Join(t.TempDir(), "output")
+	t.Setenv("GITHUB_OUTPUT", outFile)
+
+	buf := &bytes.Buffer{}
+	prev := core.Out
+	core.Out = buf
+	core.Reset()
+	t.Cleanup(func() { core.Out = prev; core.Reset() })
+
+	srv := httptest.NewServer(f.handler())
+	t.Cleanup(srv.Close)
+
+	client := githubapi.NewClientForTest(o.token, "monalisa", "helloworld", "sha", srv.URL, srv.URL+"/graphql")
+	ev := &event.Payload{PullRequest: &event.PullRequest{
+		Number: 123,
+		Head:   event.Branch{Ref: o.headRef},
+		Base:   event.Branch{Ref: o.baseRef},
+	}}
+	l := &Labeler{Client: client, Event: ev, Inputs: inputs.Inputs{
+		Token:      o.token,
+		ConfigPath: o.configPath,
+		SyncLabels: o.syncLabels,
+		Dot:        o.dot,
+		PRNumbers:  o.prNumbers,
+	}}
+	err := l.Run()
+	return err, readOutputs(t, outFile), buf.String()
+}
+
+func readOutputs(t *testing.T, path string) map[string]string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return map[string]string{}
+	}
+	lines := strings.Split(string(data), "\n")
+	out := map[string]string{}
+	for i := 0; i < len(lines); i++ {
+		line := lines[i]
+		idx := strings.Index(line, "<<")
+		if idx < 0 {
+			continue
+		}
+		name := line[:idx]
+		delim := line[idx+2:]
+		var val []string
+		i++
+		for i < len(lines) && lines[i] != delim {
+			val = append(val, lines[i])
+			i++
+		}
+		out[name] = strings.Join(val, "\n")
+	}
+	return out
+}
