+func exportMarkdown(invocation Invocation) (map[string]any, error) {
+	if invocation.Flag("force") && invocation.Flag("changed") {
+		return nil, fmt.Errorf("--force and --changed cannot be used together")
+	}
+	start := time.Now()
+	exported, skipped, offset := 0, 0, 0
+	for {
+		items, err := ListBookmarks(BookmarkFilters{Limit: 500, Offset: offset})
+		if err != nil {
+			return nil, err
+		}
+		if len(items) == 0 {
+			break
+		}
+		for _, item := range items {
+			date := "undated"
+			value := textField(item, "postedAt")
+			if value == "" {
+				value = textField(item, "bookmarkedAt")
+			}
+			if parsed := ISODate(value); parsed != nil {
+				date = *parsed
+			}
+			author := slug(textField(item, "authorHandle"))
+			if author == "" {
+				author = "unknown"
+			}
+			text := []rune(textField(item, "text"))
+			if len(text) > 50 {
+				text = text[:50]
+			}
+			name := slug(string(text))
+			if name == "" {
+				name = slug(textField(item, "id"))
+			}
+			path := filepath.Join(LibraryDir(), "bookmarks", date+"-"+author+"-"+name+".md")
+			if info, err := os.Stat(path); err == nil && !invocation.Flag("force") {
+				changed := false
+				if invocation.Flag("changed") {
+					for _, field := range []string{"syncedAt", "enrichedAt"} {
+						if parsed, ok := ParseTimestamp(textField(item, field)); ok && parsed.After(info.ModTime()) {
+							changed = true
+						}
+					}
+				}
+				if !changed {
+					skipped++
+					continue
+				}
+			}
+			if err = WriteMarkdown(path, markdownBookmark(item)); err != nil {
+				return nil, err
+			}
+			exported++
+		}
+		offset += len(items)
+	}
+	return map[string]any{"exported": exported, "skipped": skipped, "total": exported + skipped, "elapsed": time.Since(start).Seconds()}, nil
+}
+
+func stripMarkdownFence(content string) string {
+	trimmed := strings.TrimSpace(content)
+	lines := strings.Split(trimmed, "\n")
+	if len(lines) >= 2 && strings.HasPrefix(lines[0], "```") && strings.TrimSpace(lines[len(lines)-1]) == "```" {
+		return strings.Join(lines[1:len(lines)-1], "\n") + "\n"
+	}
+	return content
+}
