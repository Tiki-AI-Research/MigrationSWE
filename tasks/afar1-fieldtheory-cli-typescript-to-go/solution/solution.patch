@@ -0,0 +1,26 @@
+import { readdir } from 'node:fs/promises';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const root = fileURLToPath(new URL('..', import.meta.url));
+
+async function discover(directory) {
+  const entries = await readdir(directory, { withFileTypes: true });
+  const files = [];
+  for (const entry of entries) {
+    const target = path.join(directory, entry.name);
+    if (entry.isDirectory()) files.push(...await discover(target));
+    else if (entry.isFile() && entry.name.endsWith('.test.ts')) files.push(target);
+  }
+  return files.sort();
+}
+
+const files = await discover(path.join(root, 'tests'));
+if (files.length === 0) throw new Error('No TypeScript regression tests found.');
+const result = spawnSync(process.execPath, ['--import', 'tsx', '--test', ...process.argv.slice(2), ...files], {
+  cwd: root,
+  stdio: 'inherit',
+});
+if (result.error) throw result.error;
+process.exitCode = result.status ?? 1;
