+#!/bin/sh
+set -eu
+if command -v go >/dev/null 2>&1; then
+  exec go "$@"
+elif [ -x /usr/local/go/bin/go ]; then
+  exec /usr/local/go/bin/go "$@"
+else
+  echo 'Go 1.23 or newer is required to build Field Theory. Install the toolchain or use a prebuilt ft binary.' >&2
+  exit 1
+fi
