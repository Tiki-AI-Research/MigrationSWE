@@ -0,0 +1,958 @@
+package ft
+
+import (
+	"crypto/rand"
+	_ "embed"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math/big"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"runtime"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+//go:embed frames.json
+var builtInFrames []byte
+
+func nowISO() string { return time.Now().UTC().Format("2006-01-02T15:04:05.000Z") }
+func newID(prefix string) string {
+	content := make([]byte, 8)
+	if _, err := rand.Read(content); err != nil {
+		panic(err)
+	}
+	return prefix + "-" + hex.EncodeToString(content)
+}
+func validID(value string) bool {
+	return regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_-]*$`).MatchString(value)
+}
+func loadObjectList(path, key string) []map[string]any {
+	store := map[string][]map[string]any{}
+	if ReadJSON(path, &store) != nil || store[key] == nil {
+		return []map[string]any{}
+	}
+	return store[key]
+}
+func saveObjectList(path, key string, values []map[string]any) error {
+	return WriteJSON(path, map[string]any{key: values})
+}
+func framesList() []map[string]any {
+	values := []map[string]any{}
+	json.Unmarshal(builtInFrames, &values)
+	return append(values, loadObjectList(filepath.Join(IdeasRoot(), "frames.json"), "frames")...)
+}
+func findFrame(id string) (map[string]any, error) {
+	for _, frame := range framesList() {
+		if frame["id"] == id {
+			return frame, nil
+		}
+	}
+	return nil, fmt.Errorf("Unknown frame: %s. Run ft frames list", id)
+}
+func seedList() []map[string]any {
+	return loadObjectList(filepath.Join(IdeasRoot(), "seeds.json"), "seeds")
+}
+func findSeed(id string) (map[string]any, error) {
+	for _, seed := range seedList() {
+		if seed["id"] == id {
+			return seed, nil
+		}
+	}
+	return nil, fmt.Errorf("Seed not found: %s. Run ft seeds list", id)
+}
+func repoList() []string {
+	store := struct {
+		Repos []string `json:"repos"`
+	}{}
+	ReadJSON(filepath.Join(IdeasRoot(), "repos.json"), &store)
+	if store.Repos == nil {
+		return []string{}
+	}
+	return store.Repos
+}
+func normalizeRepo(value string) (string, error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return "", fmt.Errorf("Repo path cannot be empty")
+	}
+	if value == "~" {
+		value = home()
+	} else if strings.HasPrefix(value, "~/") {
+		value = filepath.Join(home(), value[2:])
+	}
+	return filepath.Abs(value)
+}
+func artifactPath(id string) (string, error) {
+	if !validID(id) {
+		return "", fmt.Errorf("Invalid artifact id: %s", id)
+	}
+	return filepath.Join(IdeasRoot(), "adjacent", "artifacts", id+".md"), nil
+}
+func readArtifact(id string) (map[string]any, error) {
+	path, err := artifactPath(id)
+	if err != nil {
+		return nil, err
+	}
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	parts := strings.SplitN(string(content), "\n---\n", 2)
+	if len(parts) != 2 || !strings.HasPrefix(parts[0], "---\n") {
+		return nil, fmt.Errorf("Invalid artifact frontmatter: %s", id)
+	}
+	value := map[string]any{}
+	if err := json.Unmarshal([]byte(strings.TrimPrefix(parts[0], "---\n")), &value); err != nil {
+		return nil, err
+	}
+	value["content"] = strings.TrimPrefix(parts[1], "\n")
+	return value, nil
+}
+func writeArtifact(kind, content string, metadata map[string]any, inputs []string, engine string) (string, error) {
+	id := newID("artifact")
+	path, _ := artifactPath(id)
+	frontmatter := map[string]any{"id": id, "type": kind, "source": "field_theory", "provenance": map[string]any{"createdAt": nowISO(), "producer": "system", "model": engine, "inputIds": inputs}, "metadata": metadata}
+	encoded, err := json.MarshalIndent(frontmatter, "", "  ")
+	if err != nil {
+		return "", err
+	}
+	return id, WriteMarkdown(path, "---\n"+string(encoded)+"\n---\n\n"+content)
+}
+func stringSlice(value any) []string {
+	result := []string{}
+	switch entries := value.(type) {
+	case []string:
+		return entries
+	case []any:
+		for _, entry := range entries {
+			if text, ok := entry.(string); ok {
+				result = append(result, text)
+			}
+		}
+	}
+	return result
+}
+func persistSeed(seed map[string]any) error {
+	values := seedList()
+	replaced := false
+	for index, existing := range values {
+		if existing["id"] == seed["id"] {
+			values[index], replaced = seed, true
+		}
+	}
+	if !replaced {
+		values = append([]map[string]any{seed}, values...)
+	}
+	if err := saveObjectList(filepath.Join(IdeasRoot(), "seeds.json"), "seeds", values); err != nil {
+		return err
+	}
+	encoded, _ := json.MarshalIndent(seed, "", "  ")
+	content := "---\n" + string(encoded) + "\n---\n\n# " + textField(seed, "title") + "\n\n" + textField(seed, "notes") + "\n\n## Source artifacts\n"
+	for _, id := range stringSlice(seed["artifactIds"]) {
+		content += "- " + id + "\n"
+	}
+	return WriteMarkdown(filepath.Join(IdeasRoot(), "seeds", textField(seed, "createdAt")[:10], textField(seed, "id")+".md"), content)
+}
+func createSeed(invocation Invocation, artifacts []string, text string) (map[string]any, error) {
+	if len(artifacts) == 0 {
+		if strings.TrimSpace(text) == "" {
+			return nil, fmt.Errorf("Seed text or at least one --artifact is required")
+		}
+		id, err := writeArtifact("bookmark", text, map[string]any{"title": invocation.Value("title"), "kind": "ideas-seed-text"}, []string{}, "")
+		if err != nil {
+			return nil, err
+		}
+		artifacts = []string{id}
+	}
+	for _, id := range artifacts {
+		if _, err := readArtifact(id); err != nil {
+			return nil, fmt.Errorf("Artifact not found: %s", id)
+		}
+	}
+	if frame := invocation.Value("frame"); frame != "" {
+		if _, err := findFrame(frame); err != nil {
+			return nil, err
+		}
+	}
+	title := invocation.Value("title")
+	if title == "" {
+		title = shorten(text, 80)
+		if title == "" {
+			title = "Seed from artifacts"
+		}
+	}
+	seed := map[string]any{"id": newID("seed"), "title": title, "sourceType": "artifact", "artifactIds": unique(artifacts), "createdAt": nowISO(), "createdBy": "user"}
+	if invocation.Path == "seeds text" {
+		seed["sourceType"] = "text"
+	}
+	if notes := invocation.Value("notes"); notes != "" {
+		seed["notes"] = notes
+	}
+	if frame := invocation.Value("frame"); frame != "" {
+		seed["frameId"] = frame
+	}
+	return seed, persistSeed(seed)
+}
