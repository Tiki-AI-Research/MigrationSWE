+package ft
+
+import (
+	"strings"
+	"time"
+)
+
+func ParseTimestamp(value string) (time.Time, bool) {
+	value = strings.TrimSpace(value)
+	for _, layout := range []string{time.RFC3339Nano, "2006-01-02T15:04:05.999999999-0700", "2006-01-02T15:04:05.999999999", "2006-01-02 15:04:05.999999999Z07:00", "2006-01-02 15:04:05.999999999", "2006-01-02", time.RubyDate, time.RFC1123Z, time.RFC1123, time.RFC850, time.ANSIC, "Mon Jan 02 15:04:05 -0700 2006", "January 2, 2006", "Jan 2, 2006", "01/02/2006", "2006-01", "2006"} {
+		parsed, err := time.Parse(layout, value)
+		if err == nil {
+			return parsed.UTC(), true
+		}
+	}
+	return time.Time{}, false
+}
+func ISODate(value string) *string {
+	parsed, ok := ParseTimestamp(value)
+	if !ok {
+		return nil
+	}
+	result := parsed.Format("2006-01-02")
+	return &result
+}
+func ISOMonth(value string) *string {
+	parsed, ok := ParseTimestamp(value)
+	if !ok {
+		return nil
+	}
+	result := parsed.Format("2006-01")
+	return &result
+}
+func WeekdayShort(value string) *string {
+	parsed, ok := ParseTimestamp(value)
+	if !ok {
+		return nil
+	}
+	result := parsed.Format("Mon")
+	return &result
+}
+func UTCHour(value string) *int {
+	parsed, ok := ParseTimestamp(value)
+	if !ok {
+		return nil
+	}
+	result := parsed.Hour()
+	return &result
+}
+func YearLabel(value *string) string {
+	if value == nil {
+		return "????"
+	}
+	parsed, ok := ParseTimestamp(*value)
+	if ok {
+		return parsed.Format("2006")
+	}
+	characters := []rune(*value)
+	if len(characters) > 4 {
+		characters = characters[len(characters)-4:]
+	}
+	return string(characters)
+}
+func MonthDayLabel(value *string) string {
+	if value == nil {
+		return " ?? ??"
+	}
+	parsed, ok := ParseTimestamp(*value)
+	if ok {
+		return parsed.Format("Jan 02")
+	}
+	characters := []rune(*value)
+	if len(characters) < 4 {
+		return ""
+	}
+	if len(characters) > 10 {
+		characters = characters[:10]
+	}
+	return string(characters[4:])
+}
