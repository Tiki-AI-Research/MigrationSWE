@@ -0,0 +1,68 @@
+package ft
+
+import "encoding/json"
+
+type BookmarkRecord struct {
+	ID                    string            `json:"id"`
+	TweetID               string            `json:"tweetId"`
+	URL                   string            `json:"url"`
+	Text                  string            `json:"text"`
+	AuthorHandle          *string           `json:"authorHandle,omitempty"`
+	AuthorName            *string           `json:"authorName,omitempty"`
+	AuthorProfileImageURL *string           `json:"authorProfileImageUrl,omitempty"`
+	Author                json.RawMessage   `json:"author,omitempty"`
+	PostedAt              *string           `json:"postedAt,omitempty"`
+	BookmarkedAt          *string           `json:"bookmarkedAt,omitempty"`
+	SortIndex             *string           `json:"sortIndex,omitempty"`
+	SyncedAt              string            `json:"syncedAt"`
+	ConversationID        *string           `json:"conversationId,omitempty"`
+	InReplyToStatusID     *string           `json:"inReplyToStatusId,omitempty"`
+	InReplyToUserID       *string           `json:"inReplyToUserId,omitempty"`
+	QuotedStatusID        *string           `json:"quotedStatusId,omitempty"`
+	QuotedTweet           json.RawMessage   `json:"quotedTweet,omitempty"`
+	ArticleTitle          *string           `json:"articleTitle,omitempty"`
+	ArticleText           *string           `json:"articleText,omitempty"`
+	ArticleSite           *string           `json:"articleSite,omitempty"`
+	EnrichedAt            *string           `json:"enrichedAt,omitempty"`
+	Language              *string           `json:"language,omitempty"`
+	SourceApp             *string           `json:"sourceApp,omitempty"`
+	PossiblySensitive     *bool             `json:"possiblySensitive,omitempty"`
+	Engagement            map[string]*int64 `json:"engagement,omitempty"`
+	Media                 []string          `json:"media,omitempty"`
+	MediaObjects          []json.RawMessage `json:"mediaObjects,omitempty"`
+	Links                 []string          `json:"links,omitempty"`
+	Tags                  []string          `json:"tags,omitempty"`
+	IngestedVia           *string           `json:"ingestedVia,omitempty"`
+	FolderIDs             []string          `json:"folderIds,omitempty"`
+	FolderNames           []string          `json:"folderNames,omitempty"`
+	TextExpandedAt        *string           `json:"textExpandedAt,omitempty"`
+	QuotedTweetFailedAt   *string           `json:"quotedTweetFailedAt,omitempty"`
+}
+
+func stringValue(value *string) string {
+	if value == nil {
+		return ""
+	}
+	return *value
+}
+func jsonArray(value []string) any {
+	if len(value) == 0 {
+		return nil
+	}
+	content, _ := json.Marshal(value)
+	return string(content)
+}
+func parseArray(value any) []string {
+	result := []string{}
+	if text, ok := value.(string); ok {
+		var values []any
+		if json.Unmarshal([]byte(text), &values) == nil {
+			for _, item := range values {
+				if entry, ok := item.(string); ok {
+					result = append(result, entry)
+				}
+			}
+		}
+	}
+	return result
+}
diff --git a/internal/ft/viz.go b/internal/ft/viz.go
new file mode 100644
index 0000000..f4bf192
--- /dev/null
+++ b/internal/ft/viz.go
@@ -0,0 +1,72 @@
+package ft
+
+import (
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+)
+
+func sparkline(values []int) string {
+	blocks := []rune("▁▂▃▄▅▆▇█")
+	maximum := 0
+	for _, value := range values {
+		if value > maximum {
+			maximum = value
+		}
+	}
+	var output strings.Builder
+	for _, value := range values {
+		level := 0
+		if maximum > 0 {
+			level = value * (len(blocks) - 1) / maximum
+		}
+		output.WriteRune(blocks[level])
+	}
+	return output.String()
+}
+
+func renderActivity(output io.Writer) error {
+	database, err := OpenBookmarksDB()
+	if err != nil {
+		return err
+	}
+	defer database.Close()
+	rows, err := queryMaps(database, `SELECT posted_at,media_count,link_count FROM bookmarks`)
+	if err != nil {
+		return err
+	}
+	monthly := map[string]int{}
+	weekdays, hours := make([]int, 7), make([]int, 24)
+	withMedia, withLinks := 0, 0
+	for _, row := range rows {
+		if count, ok := row["media_count"].(int64); ok && count > 0 {
+			withMedia++
+		}
+		if count, ok := row["link_count"].(int64); ok && count > 0 {
+			withLinks++
+		}
+		if posted, ok := row["posted_at"].(string); ok {
+			if parsed, ok := ParseTimestamp(posted); ok {
+				monthly[parsed.Format("2006-01")]++
+				weekdays[int(parsed.Weekday())]++
+				hours[parsed.Hour()]++
+			}
+		}
+	}
+	months := []string{}
+	for month := range monthly {
+		months = append(months, month)
+	}
+	sort.Strings(months)
+	values := []int{}
+	for _, month := range months {
+		values = append(values, monthly[month])
+	}
+	fmt.Fprintln(output, "\nMonthly activity:")
+	if len(months) > 0 {
+		fmt.Fprintf(output, "  %s  %s  %s\n", months[0], sparkline(values), months[len(months)-1])
+	}
+	fmt.Fprintf(output, "\nWeekday activity (UTC):\n  Sun Mon Tue Wed Thu Fri Sat\n  %s\n\nHour activity (UTC):\n  00 %s 23\n\nMedia: %d/%d  Links: %d/%d\n", sparkline(weekdays), sparkline(hours), withMedia, len(rows), withLinks, len(rows))
+	return nil
+}
