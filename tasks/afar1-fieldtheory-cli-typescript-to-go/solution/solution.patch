new file mode 100644
index 0000000..0cb6a5d
--- /dev/null
+++ b/internal/ft/config.go
@@ -0,0 +1,36 @@
+package ft
+
+import (
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+var envAssignment = regexp.MustCompile(`(?m)^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.-]*)\s*=\s*(?:"((?:\\.|[^"\\])*)"|'([^']*)'|([^\r\n]*))`)
+
+func LoadEnv() {
+	working, _ := os.Getwd()
+	data := DataDir()
+	for _, path := range []string{filepath.Join(working, ".env.local"), filepath.Join(working, ".env"), filepath.Join(data, ".env.local"), filepath.Join(data, ".env")} {
+		content, err := os.ReadFile(path)
+		if err != nil {
+			continue
+		}
+		for _, match := range envAssignment.FindAllStringSubmatch(string(content), -1) {
+			if _, present := os.LookupEnv(match[1]); present {
+				continue
+			}
+			value := match[2]
+			rawValue := strings.TrimSpace(strings.SplitN(match[0], "=", 2)[1])
+			if strings.HasPrefix(rawValue, `"`) {
+				value = strings.NewReplacer(`\n`, "\n", `\r`, "\r").Replace(value)
+			} else if strings.HasPrefix(rawValue, "'") {
+				value = match[3]
+			} else {
+				value = strings.TrimSpace(strings.SplitN(match[4], "#", 2)[0])
+			}
+			os.Setenv(match[1], value)
+		}
+	}
+}
