diff --git a/internal/ft/fs.go b/internal/ft/fs.go
new file mode 100644
index 0000000..6710a58
--- /dev/null
+++ b/internal/ft/fs.go
@@ -0,0 +1,114 @@
+package ft
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"runtime"
+)
+
+func syncDirectory(path string) error {
+	directory, err := os.Open(path)
+	if err != nil {
+		if runtime.GOOS == "windows" {
+			return nil
+		}
+		return err
+	}
+	defer directory.Close()
+	err = directory.Sync()
+	if runtime.GOOS == "windows" {
+		return nil
+	}
+	return err
+}
+
+func WriteDurable(path string, content []byte, mode os.FileMode) error {
+	parent := filepath.Dir(path)
+	if err := os.MkdirAll(parent, 0700); err != nil {
+		return err
+	}
+	temporary, err := os.CreateTemp(parent, "."+filepath.Base(path)+"-*.tmp")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(temporary.Name())
+	defer temporary.Close()
+	if err = temporary.Chmod(mode); err != nil {
+		return err
+	}
+	if _, err = temporary.Write(content); err != nil {
+		return err
+	}
+	if err = temporary.Sync(); err != nil {
+		return err
+	}
+	if err = temporary.Close(); err != nil {
+		return err
+	}
+	if err = os.Rename(temporary.Name(), path); err != nil {
+		return err
+	}
+	return syncDirectory(parent)
+}
+
+func WriteJSON(path string, value any) error {
+	content, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+	return WriteDurable(path, append(content, '\n'), 0600)
+}
+
+func ReadJSON(path string, value any) error {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(content, value)
+}
+
+func ReadJSONLines[Record any](path string) []Record {
+	records := []Record{}
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return records
+	}
+	for _, line := range bytes.Split(content, []byte("\n")) {
+		line = bytes.TrimSpace(line)
+		if len(line) == 0 {
+			continue
+		}
+		var record Record
+		if json.Unmarshal(line, &record) != nil {
+			return []Record{}
+		}
+		records = append(records, record)
+	}
+	return records
+}
+
+func WriteJSONLines[Record any](path string, records []Record) error {
+	var content bytes.Buffer
+	encoder := json.NewEncoder(&content)
+	encoder.SetEscapeHTML(false)
+	for _, record := range records {
+		if err := encoder.Encode(record); err != nil {
+			return err
+		}
+	}
+	return WriteDurable(path, content.Bytes(), 0600)
+}
+
+func WriteMarkdown(path, content string) error { return WriteDurable(path, []byte(content), 0644) }
+func LoadPreferences() map[string]any {
+	preferences := map[string]any{}
+	if ReadJSON(PreferencesPath(), &preferences) != nil || preferences == nil {
+		return map[string]any{}
+	}
+	return preferences
+}
+func SavePreferences(preferences map[string]any) error {
+	return WriteJSON(PreferencesPath(), preferences)
+}
