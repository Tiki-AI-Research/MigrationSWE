--- /dev/null
+++ b/main_test.go
@@ -0,0 +1,150 @@
+package main
+
+import (
+	"bytes"
+	"database/sql"
+	"debug/elf"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func TestNativeEntrypoints(test *testing.T) {
+	root := test.TempDir()
+	tool := filepath.Join(runtime.GOROOT(), "bin", "go")
+	names := []string{"ft", "fieldtheory"}
+	for _, name := range names {
+		binary := filepath.Join(root, name)
+		if runtime.GOOS == "windows" {
+			binary += ".exe"
+		}
+		command := exec.Command(tool, "build", "-o", binary, "./cmd/"+name)
+		command.Env = append(os.Environ(), "CGO_ENABLED=0", "GOPROXY=off", "GOSUMDB=off", "GOTOOLCHAIN=local")
+		if output, err := command.CombinedOutput(); err != nil {
+			test.Fatalf("native build failed: %s\n%v", output, err)
+		}
+		if runtime.GOOS == "linux" {
+			image, err := elf.Open(binary)
+			if err != nil {
+				test.Fatal(err)
+			}
+			libraries, err := image.ImportedLibraries()
+			image.Close()
+			if err != nil || len(libraries) != 0 {
+				test.Fatalf("native-library dependency: %v %v", libraries, err)
+			}
+		}
+	}
+	data, library, commands := filepath.Join(root, "data"), filepath.Join(root, "library"), filepath.Join(root, "commands")
+	environment := append(os.Environ(), "HOME="+filepath.Join(root, "home"), "USERPROFILE="+filepath.Join(root, "home"), "FT_DATA_DIR="+data, "FT_LIBRARY_DIR="+library, "FT_COMMANDS_DIR="+commands, "PATH="+filepath.Join(root, "no-runtime"))
+	run := func(name, input string, arguments ...string) (string, string, error) {
+		binary := filepath.Join(root, name)
+		if runtime.GOOS == "windows" {
+			binary += ".exe"
+		}
+		command := exec.Command(binary, arguments...)
+		command.Env = environment
+		command.Stdin = strings.NewReader(input)
+		var output, diagnostics bytes.Buffer
+		command.Stdout, command.Stderr = &output, &diagnostics
+		err := command.Run()
+		return output.String(), diagnostics.String(), err
+	}
+	output, diagnostics, err := run("ft", "")
+	if err != nil || !strings.Contains(output, "Welcome") {
+		test.Fatal(output, diagnostics, err)
+	}
+	if err := os.MkdirAll(data, 0700); err != nil {
+		test.Fatal(err)
+	}
+	cache := `{"id":"local-1","tweetId":"1","url":"https://x.com/example/status/1","text":"Open source search tool","authorHandle":"example","postedAt":"Wed Jan 01 12:00:00 +0000 2025","syncedAt":"2025-01-02T00:00:00Z","folderIds":["work"],"folderNames":["Work"]}` + "\n"
+	if err := os.WriteFile(filepath.Join(data, "bookmarks.jsonl"), []byte(cache), 0600); err != nil {
+		test.Fatal(err)
+	}
+	output, diagnostics, err = run("ft", "", "index", "--json")
+	if err != nil {
+		test.Fatal(output, diagnostics, err)
+	}
+	var index map[string]any
+	if err := json.Unmarshal([]byte(output), &index); err != nil || index["recordCount"] != float64(1) || index["newRecords"] != float64(1) {
+		test.Fatal(output, err)
+	}
+	for _, name := range names {
+		output, diagnostics, err = run(name, "", "bookmarks", "search", "search", "--json")
+		if err != nil {
+			test.Fatal(output, diagnostics, err)
+		}
+		var results []map[string]any
+		if err := json.Unmarshal([]byte(output), &results); err != nil || len(results) != 1 || results[0]["id"] != "local-1" {
+			test.Fatal(output, err)
+		}
+		output, diagnostics, err = run(name, "", "path")
+		if err != nil || strings.TrimSpace(output) != data {
+			test.Fatal(output, diagnostics, err)
+		}
+	}
+	output, diagnostics, err = run("ft", "", "list", "--folder", "Wo", "--json")
+	if err != nil || !strings.Contains(output, "local-1") {
+		test.Fatal(output, diagnostics, err)
+	}
+	output, diagnostics, err = run("ft", "", "search", "nomatches")
+	if err != nil || strings.TrimSpace(output) != "No results found." {
+		test.Fatal(output, diagnostics, err)
+	}
+	if _, diagnostics, err = run("ft", "", "show", "missing"); err == nil || !strings.Contains(diagnostics, "not found") {
+		test.Fatal(diagnostics, err)
+	}
+	if _, diagnostics, err = run("ft", "", "list", "--limit", "bad"); err == nil || !strings.Contains(diagnostics, "--limit") {
+		test.Fatal(diagnostics, err)
+	}
+	output, diagnostics, err = run("ft", "", "classify", "--regex")
+	if err != nil || !strings.Contains(output, "Classified 1/1") {
+		test.Fatal(output, diagnostics, err)
+	}
+	output, diagnostics, err = run("ft", "# Local document\n\nInitial content.\n", "library", "create", "notes/native", "--stdin", "--json")
+	if err != nil {
+		test.Fatal(output, diagnostics, err)
+	}
+	var document struct {
+		Version struct {
+			SHA256 string `json:"sha256"`
+		} `json:"version"`
+	}
+	if err := json.Unmarshal([]byte(output), &document); err != nil || document.Version.SHA256 == "" {
+		test.Fatal(output, err)
+	}
+	output, diagnostics, err = run("ft", "# Local document\n\nEdited content.\n", "library", "update", "notes/native", "--stdin", "--expected-sha256", document.Version.SHA256, "--json")
+	if err != nil || !strings.Contains(output, "Edited content") {
+		test.Fatal(output, diagnostics, err)
+	}
+	if _, diagnostics, err = run("ft", "stale content", "library", "update", "notes/native", "--stdin", "--expected-sha256", document.Version.SHA256); err == nil || !strings.Contains(diagnostics, "changed on disk") {
+		test.Fatal(diagnostics, err)
+	}
+	if _, diagnostics, err = run("ft", "", "commands", "new", "review"); err != nil {
+		test.Fatal(diagnostics, err)
+	}
+	if _, diagnostics, err = run("ft", "# Invalid\n", "commands", "new", "broken", "--stdin"); err != nil {
+		test.Fatal(diagnostics, err)
+	}
+	output, diagnostics, err = run("ft", "", "commands", "validate", "--json")
+	if err == nil {
+		test.Fatal("invalid commands should exit non-zero", output)
+	}
+	var validation []map[string]any
+	if parseErr := json.Unmarshal([]byte(output), &validation); parseErr != nil || len(validation) != 2 {
+		test.Fatal(output, diagnostics, parseErr)
+	}
+	database, err := sql.Open("sqlite", filepath.Join(data, "bookmarks.db"))
+	if err != nil {
+		test.Fatal(err)
+	}
+	defer database.Close()
+	var version string
+	if err := database.QueryRow(`SELECT value FROM meta WHERE key='schema_version'`).Scan(&version); err != nil || version != "6" {
+		test.Fatal(version, err)
+	}
+}
