+package ft
+
+import (
+	_ "embed"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const Version = "1.3.22"
+
+//go:embed surface.json
+var commandSurface []byte
+
+type optionSpec struct {
+	Flags       string `json:"flags"`
+	Description string `json:"description"`
+	Default     any    `json:"default"`
+}
+type commandSpec struct {
+	Path        string       `json:"path"`
+	Description string       `json:"description"`
+	Arguments   []string     `json:"arguments"`
+	Options     []optionSpec `json:"options"`
+	Aliases     []string     `json:"aliases"`
+}
+type Invocation struct {
+	Path    string
+	Args    []string
+	Options map[string]string
+	Help    bool
+}
+
+func (invocation Invocation) Flag(name string) bool    { return invocation.Options[name] == "true" }
+func (invocation Invocation) Value(name string) string { return invocation.Options[name] }
+func (invocation Invocation) Arg(index int) string {
+	if index < len(invocation.Args) {
+		return invocation.Args[index]
+	}
+	return ""
+}
+func (invocation Invocation) Number(name string, fallback int) int {
+	if value := invocation.Value(name); value != "" {
+		number, err := strconv.Atoi(value)
+		if err == nil {
+			return number
+		}
+	}
+	return fallback
+}
+func (invocation Invocation) EngineProfile() EngineProfile {
+	return EngineProfile{Engine: invocation.Value("engine"), Model: invocation.Value("model"), Effort: invocation.Value("effort")}
+}
+func (invocation Invocation) InvokeOptions() InvokeOptions {
+	return InvokeOptions{Timeout: time.Duration(invocation.Number("timeout", 120000)) * time.Millisecond, MaxBuffer: invocation.Number("max-buffer", 1024*1024)}
+}
+
+var optionName = regexp.MustCompile(`--[a-zA-Z][a-zA-Z0-9-]*|(?:^|,\s*)-[a-zA-Z]`)
+
+func commandSpecs() map[string]commandSpec {
+	var values []commandSpec
+	if err := json.Unmarshal(commandSurface, &values); err != nil {
+		panic(err)
+	}
+	result := map[string]commandSpec{}
+	for _, specification := range values {
+		result[specification.Path] = specification
+	}
+	return result
+}
+
+func ParseArgs(arguments []string) (Invocation, error) {
+	invocation := Invocation{Options: map[string]string{}}
+	if len(arguments) > 0 && arguments[0] == "bookmarks" {
+		if len(arguments) < 2 {
+			invocation.Path, invocation.Help = "", true
+			return invocation, nil
+		}
+		allowed := " sync search list show stats viz classify classify-domains categories domains folders model index auth status path sample fetch-media enable "
+		if !strings.Contains(allowed, " "+arguments[1]+" ") {
+			return invocation, fmt.Errorf("unknown bookmarks command %q. Run: ft --help", arguments[1])
+		}
+		arguments = arguments[1:]
+		if arguments[0] == "enable" {
+			arguments = append([]string{"sync"}, arguments[1:]...)
+		}
+	}
+	if len(arguments) > 0 && arguments[0] == "ideas" {
+		arguments = append([]string{"possible"}, arguments[1:]...)
+	}
+	if len(arguments) > 0 && arguments[0] == "state" {
+		arguments = append([]string{"current"}, arguments[1:]...)
+	}
+	if len(arguments) > 2 && arguments[0] == "possible" && arguments[1] == "seed" {
+		arguments = append([]string{"seeds"}, arguments[2:]...)
+	}
+	specifications := commandSpecs()
+	if len(arguments) > 0 && (arguments[0] == "help" || arguments[0] == "--help" || arguments[0] == "-h") {
+		invocation.Help = true
+		if len(arguments) > 1 {
+			invocation.Path = strings.Join(arguments[1:], " ")
+			if _, ok := specifications[invocation.Path]; !ok {
+				return invocation, fmt.Errorf("unknown command %q. Run: ft --help", invocation.Path)
+			}
+		}
+		return invocation, nil
+	}
+	if len(arguments) > 0 && (arguments[0] == "--version" || arguments[0] == "-V") {
+		invocation.Path = "version"
+		return invocation, nil
+	}
+	for len(arguments) > 0 {
+		candidate := strings.TrimSpace(invocation.Path + " " + arguments[0])
+		if _, ok := specifications[candidate]; !ok {
+			break
+		}
+		invocation.Path = candidate
+		arguments = arguments[1:]
+	}
+	if invocation.Path == "" && len(arguments) > 0 {
+		return invocation, fmt.Errorf("unknown command %q. Run: ft --help", arguments[0])
+	}
+	if invocation.Path == "" {
+		return invocation, nil
+	}
+	specification := specifications[invocation.Path]
+	options := map[string]optionSpec{}
+	aliases := map[string]string{}
+	registerOptions := func(specification commandSpec) {
+		for _, option := range specification.Options {
+			names := optionName.FindAllString(option.Flags, -1)
+			canonical := ""
+			for _, name := range names {
+				name = strings.TrimSpace(strings.TrimPrefix(name, ","))
+				if strings.HasPrefix(name, "--") {
+					canonical = strings.TrimPrefix(name, "--")
+				}
+			}
+			if canonical == "" {
+				continue
+			}
+			options[canonical] = option
+			for _, name := range names {
+				aliases[strings.TrimSpace(strings.TrimPrefix(name, ","))] = canonical
+			}
+			if option.Default != nil && invocation.Options[canonical] == "" {
+				invocation.Options[canonical] = fmt.Sprint(option.Default)
+			}
+		}
+	}
+	registerOptions(specification)
+	for _, name := range []string{"json", "help"} {
+		options[name] = optionSpec{Flags: "--" + name}
+		aliases["--"+name] = name
+	}
+	aliases["-h"] = "help"
+	if invocation.Path == "classify" || invocation.Path == "classify-domains" || invocation.Path == "wiki" || invocation.Path == "ask" {
+		for _, name := range []string{"model", "effort", "timeout", "max-buffer"} {
+			options[name] = optionSpec{Flags: "--" + name + " <value>"}
+			aliases["--"+name] = name
+		}
+	}
+	literal := false
+	for index := 0; index < len(arguments); index++ {
+		argument := arguments[index]
+		if !literal && argument == "--" {
+			literal = true
+			continue
+		}
+		if !literal && strings.HasPrefix(argument, "-") && argument != "-" {
+			parts := strings.SplitN(argument, "=", 2)
+			canonical, ok := aliases[parts[0]]
+			if !ok {
+				return invocation, fmt.Errorf("unknown option %s. Run: ft %s --help", parts[0], invocation.Path)
+			}
+			option := options[canonical]
+			if strings.ContainsAny(option.Flags, "<[") {
+				if len(parts) == 2 {
+					invocation.Options[canonical] = parts[1]
+				} else {
+					if index+1 >= len(arguments) || strings.HasPrefix(arguments[index+1], "--") {
+						return invocation, fmt.Errorf("option --%s requires a value. Run: ft %s --help", canonical, invocation.Path)
+					}
+					index++
+					invocation.Options[canonical] = arguments[index]
+					if strings.Contains(option.Flags, "...") {
+						for index+1 < len(arguments) && !strings.HasPrefix(arguments[index+1], "-") {
+							index++
+							invocation.Options[canonical] += " " + arguments[index]
+						}
+					}
+				}
+			} else {
+				if len(parts) == 2 {
+					return invocation, fmt.Errorf("option --%s does not take a value", canonical)
+				}
+				invocation.Options[canonical] = "true"
+			}
+			if canonical == "help" {
+				invocation.Help = true
+			}
+		} else {
+			if child, ok := specifications[invocation.Path+" "+argument]; !literal && ok && len(invocation.Args) == 0 {
+				invocation.Path = child.Path
+				specification = child
+				registerOptions(child)
+				continue
+			}
+			invocation.Args = append(invocation.Args, argument)
+		}
+	}
+	if invocation.Help {
+		return invocation, nil
+	}
+	required, maximum := 0, len(specification.Arguments)
+	for _, argument := range specification.Arguments {
+		if strings.HasPrefix(argument, "<") {
+			required++
+		}
+		if strings.Contains(argument, "...") {
+			maximum = int(^uint(0) >> 1)
+		}
+	}
+	if len(invocation.Args) < required {
+		return invocation, fmt.Errorf("missing required argument %s. Usage: ft %s %s", specification.Arguments[len(invocation.Args)], invocation.Path, strings.Join(specification.Arguments, " "))
+	}
+	if len(invocation.Args) > maximum {
+		return invocation, fmt.Errorf("unexpected argument %q. Run: ft %s --help", invocation.Args[maximum], invocation.Path)
+	}
+	for _, name := range []string{"limit", "offset", "lines", "timeout", "max-buffer", "days", "max-pages", "target-adds", "delay-ms", "max-minutes", "media-max-bytes"} {
+		if value := invocation.Value(name); value != "" {
+			number, err := strconv.Atoi(value)
+			if err != nil || number < 0 || (number == 0 && name != "offset" && name != "delay-ms") {
+				return invocation, fmt.Errorf("--%s must be a %s integer; received %q", name, map[bool]string{true: "non-negative", false: "positive"}[name == "offset" || name == "delay-ms"], value)
+			}
+		}
+	}
+	for _, name := range []string{"after", "before"} {
+		if value := invocation.Value(name); value != "" {
+			if _, ok := ParseTimestamp(value); !ok {
+				return invocation, fmt.Errorf("--%s must be a valid date, e.g. YYYY-MM-DD; received %q", name, value)
+			}
+		}
+	}
+	return invocation, nil
+}
+
+func PrintHelp(output io.Writer, path string) {
+	specifications := commandSpecs()
+	fmt.Fprintf(output, "Field Theory %s — local-first bookmarks, Library, and portable commands\n\n", Version)
+	if path == "" {
+		fmt.Fprintln(output, "Usage: ft <command> [options]\nAlias: fieldtheory\n\nCommands:")
+		names := []string{}
+		for name := range specifications {
+			if !strings.Contains(name, " ") && name != "bookmarks" {
+				names = append(names, name)
+			}
+		}
+		sort.Strings(names)
+		for _, name := range names {
+			fmt.Fprintf(output, "  %-20s %s\n", name, specifications[name].Description)
+		}
+	} else {
+		specification := specifications[path]
+		fmt.Fprintf(output, "Usage: ft %s %s [options]\n\n%s\n", path, strings.Join(specification.Arguments, " "), specification.Description)
+		names := []string{}
+		for name := range specifications {
+			if strings.HasPrefix(name, path+" ") && !strings.Contains(strings.TrimPrefix(name, path+" "), " ") {
+				names = append(names, name)
+			}
+		}
+		sort.Strings(names)
+		for _, name := range names {
+			fmt.Fprintf(output, "  %-20s %s\n", strings.TrimPrefix(name, path+" "), specifications[name].Description)
+		}
+		for _, option := range specification.Options {
+			fmt.Fprintf(output, "  %-30s %s\n", option.Flags, option.Description)
+		}
+	}
+	fmt.Fprintln(output, "\n  -h, --help                     Show help\n  -V, --version                  Show version")
+}
+
+func Main(arguments []string) int {
+	LoadEnv()
+	invocation, err := ParseArgs(arguments)
+	if err == nil {
+		if invocation.Help {
+			PrintHelp(os.Stdout, invocation.Path)
+			return 0
+		}
+		err = Run(invocation, os.Stdout, os.Stderr)
+	}
+	if err == nil {
+		return 0
+	}
+	var failure *ExitError
+	if errors.As(err, &failure) {
+		if failure.Message != "" {
+			fmt.Fprintln(os.Stderr, failure.Message)
+		}
+		return failure.Code
+	}
+	fmt.Fprintln(os.Stderr, "Error:", err)
+	return 1
+}
+
+func printJSON(output io.Writer, value any) error {
+	encoder := json.NewEncoder(output)
+	encoder.SetEscapeHTML(false)
+	encoder.SetIndent("", "  ")
+	return encoder.Encode(value)
+}
+func printValue(output io.Writer, invocation Invocation, value any, human string) error {
+	if invocation.Flag("json") {
+		return printJSON(output, value)
+	}
+	fmt.Fprintln(output, human)
+	return nil
+}
+
+func Run(invocation Invocation, output, diagnostics io.Writer) error {
+	if _, err := MigrateLegacyIdeasData(); err != nil {
+		return err
+	}
+	switch invocation.Path {
+	case "version":
+		fmt.Fprintln(output, Version)
+		return nil
+	case "":
+		return dashboard(output)
+	case "path":
+		fmt.Fprintln(output, DataDir())
+		return nil
+	case "paths":
+		return printValue(output, invocation, PathReport(), fmt.Sprintf("Field Theory paths\n  bookmarks: %s\n  library:   %s\n  commands:  %s\n  media:     %s", DataDir(), LibraryDir(), CommandsDir(), DataDir()+string(os.PathSeparator)+"media"))
+	case "index":
+		if !exists(CachePath()) {
+			return fmt.Errorf("no bookmarks cache found at %s. Import bookmarks.jsonl first", CachePath())
+		}
+		fmt.Fprintln(diagnostics, "Building search index...")
+		result, err := BuildIndex(invocation.Flag("force"))
+		if err != nil {
+			return err
+		}
+		return printValue(output, invocation, result, fmt.Sprintf("Indexed %d bookmarks (%d new) → %s", result.RecordCount, result.NewRecords, result.DBPath))
+	case "search", "list", "sample":
+		filters := BookmarkFilters{Query: invocation.Value("query"), Author: invocation.Value("author"), After: invocation.Value("after"), Before: invocation.Value("before"), Category: invocation.Value("category"), Domain: invocation.Value("domain"), Folder: invocation.Value("folder"), Offset: invocation.Number("offset", 0)}
+		var results []map[string]any
+		var err error
+		if invocation.Path == "search" {
+			filters.Query, filters.Limit = invocation.Arg(0), invocation.Number("limit", 20)
+			results, err = SearchBookmarks(filters)
+		} else {
+			filters.Limit = invocation.Number("limit", 30)
+			if invocation.Path == "sample" {
+				filters.Category = invocation.Arg(0)
+				filters.Limit = invocation.Number("limit", 10)
+				results, err = SampleBookmarks(filters.Category, filters.Limit)
+			} else {
+				results, err = ListBookmarks(filters)
+			}
+		}
+		if err != nil {
+			return err
+		}
+		if invocation.Flag("json") {
+			return printJSON(output, results)
+		}
+		if len(results) == 0 {
+			fmt.Fprintln(output, "No results found.")
+			return nil
+		}
+		for index, result := range results {
+			date := "?"
+			if value, ok := result["postedAt"].(string); ok {
+				date = value
+				if len(date) > 10 {
+					date = date[:10]
+				}
+			}
+			author, _ := result["authorHandle"].(string)
+			if author == "" {
+				author = "unknown"
+			}
+			fmt.Fprintf(output, "%d. [%s] @%s (ID: %v)\n   %s\n   %v\n\n", index+1, date, author, result["id"], shorten(fmt.Sprint(result["text"]), 140), result["url"])
+		}
+		return nil
+	case "show":
+		item, err := GetBookmark(invocation.Arg(0))
+		if err != nil {
+			return err
+		}
+		if invocation.Flag("json") {
+			return printJSON(output, item)
+		}
+		fmt.Fprintf(output, "%v · @%v\n%v\n%v\n", item["id"], item["authorHandle"], item["url"], item["text"])
+		if quoted, ok := item["quotedTweet"].(map[string]any); ok {
+			fmt.Fprintf(output, "\nQuoted @%v:\n%v\n%v\n", quoted["authorHandle"], quoted["text"], quoted["url"])
+		}
+		for _, name := range []string{"links", "categories", "domains", "folderNames", "articleTitle", "articleText"} {
+			fmt.Fprintf(output, "%s: %v\n", name, item[name])
+		}
+		return nil
+	case "stats", "viz":
+		return printStats(invocation, output)
+	case "categories", "domains", "folders":
+		return printDistribution(invocation, output)
+	case "status":
+		return status(invocation, output)
+	case "classify", "classify-domains":
+		if !exists(CachePath()) {
+			return fmt.Errorf("no bookmarks cache found. Import bookmarks.jsonl, then run ft index")
+		}
+		if invocation.Flag("regex") {
+			index, summary, err := ClassifyRegex()
+			if err != nil {
+				return err
+			}
+			if invocation.Flag("json") {
+				return printJSON(output, map[string]any{"index": index, "summary": summary})
+			}
+			fmt.Fprintf(output, "Indexed %d bookmarks → %s\nClassified %d/%d bookmarks (%d unclassified)\n", index.RecordCount, index.DBPath, summary.Classified, summary.Total, summary.Unclassified)
+			printCounts(output, summary.ByCategoryCount)
+			return nil
+		}
+		engine, err := ResolveEngine(invocation.EngineProfile())
+		if err != nil {
+			return err
+		}
+		if !exists(IndexPath()) {
+			if _, err = BuildIndex(false); err != nil {
+				return err
+			}
+		}
+		result, err := ClassifyLLM(engine, invocation.Path == "classify-domains", invocation.Flag("all"), invocation.InvokeOptions())
+		if err != nil {
+			return err
+		}
+		if invocation.Path == "classify" {
+			domains, err := ClassifyLLM(engine, true, false, invocation.InvokeOptions())
+			if err != nil {
+				return err
+			}
+			result["domains"] = domains
+		}
+		return printValue(output, invocation, result, fmt.Sprintf("Engine: %s\nClassified: %v/%v", engine.Label(), result["classified"], result["totalUnclassified"]))
+	case "model":
+		return modelCommand(invocation, output)
+	case "sync", "auth", "fetch-media", "install app", "app open":
+		return fmt.Errorf("%s is outside this local-only Go build. Import an existing bookmarks.jsonl and run ft index; local search and document commands are available", invocation.Path)
+	}
+	if strings.HasPrefix(invocation.Path, "library ") || strings.HasPrefix(invocation.Path, "commands ") {
+		return documentCommand(invocation, output)
+	}
+	if invocation.Path == "library" || invocation.Path == "commands" || invocation.Path == "app" || invocation.Path == "install" || invocation.Path == "codex" {
+		PrintHelp(output, invocation.Path)
+		return nil
+	}
+	if handled, err := navigationCommand(invocation, output); handled {
+		return err
+	}
+	if handled, err := knowledgeCommand(invocation, output); handled {
+		return err
+	}
+	if handled, err := ideasCommand(invocation, output); handled {
+		return err
+	}
+	return fmt.Errorf("unknown command %q. Run: ft --help", invocation.Path)
+}
+
+func shorten(value string, limit int) string {
+	characters := []rune(value)
+	if len(characters) > limit {
+		return string(characters[:limit]) + "..."
+	}
+	return value
+}
+func dashboard(output io.Writer) error {
+	if !exists(CachePath()) {
+		fmt.Fprintln(output, "Welcome to Field Theory\n\nSelf-custody for your X/Twitter bookmarks.\nImport bookmarks.jsonl into "+DataDir()+", then run ft index.\n\nGet started: ft --help\n  ft sync       Sync bookmarks (external network integration)\n  ft search     Search your local bookmarks\n  ft library    Manage Library documents\n  ft commands   Manage portable commands")
+		return nil
+	}
+	fmt.Fprintf(output, "Field Theory — Dashboard\n\nBookmarks: %d\nData: %s\nLibrary: %s\n\nft search <query> · ft stats · ft library list · ft --help\n", len(ReadJSONLines[BookmarkRecord](CachePath())), DataDir(), LibraryDir())
+	return nil
+}
+
+func printStats(invocation Invocation, output io.Writer) error {
+	statistics, err := GetStats()
+	if err != nil {
+		return err
+	}
+	if invocation.Flag("json") {
+		return printJSON(output, statistics)
+	}
+	rangeValue := statistics["dateRange"].(map[string]any)
+	date := func(value any) string {
+		if pointer, ok := value.(*string); ok && pointer != nil {
+			return *pointer
+		}
+		return "?"
+	}
+	fmt.Fprintf(output, "Bookmarks: %v\nUnique authors: %v\nDate range: %s to %s\n\nTop authors:\n", statistics["totalBookmarks"], statistics["uniqueAuthors"], date(rangeValue["earliest"]), date(rangeValue["latest"]))
+	for _, author := range statistics["topAuthors"].([]map[string]any) {
+		fmt.Fprintf(output, "  @%v: %v\n", author["handle"], author["count"])
+	}
+	fmt.Fprintln(output, "\nLanguages:")
+	for _, language := range statistics["languageBreakdown"].([]map[string]any) {
+		fmt.Fprintf(output, "  %v: %v\n", language["language"], language["count"])
+	}
+	if invocation.Path == "viz" {
+		if err := renderActivity(output); err != nil {
+			return err
+		}
+		for _, name := range []string{"categories", "domains"} {
+			fmt.Fprintf(output, "\n%s:\n", name)
+			if err := printDistribution(Invocation{Path: name, Options: map[string]string{}}, output); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func printCounts(output io.Writer, counts map[string]int) {
+	names, total := []string{}, 0
+	for name, count := range counts {
+		names = append(names, name)
+		total += count
+	}
+	sort.SliceStable(names, func(left, right int) bool {
+		if counts[names[left]] == counts[names[right]] {
+			return names[left] < names[right]
+		}
+		return counts[names[left]] > counts[names[right]]
+	})
+	for _, name := range names {
+		percent := float64(0)
+		if total > 0 {
+			percent = float64(counts[name]) * 100 / float64(total)
+		}
+		fmt.Fprintf(output, "  %-24s %5d  (%.1f%%)\n", strings.Map(func(character rune) rune {
+			if character < 32 || character == 127 {
+				return -1
+			}
+			return character
+		}, name), counts[name], percent)
+	}
+}
+
+func printDistribution(invocation Invocation, output io.Writer) error {
+	database, err := OpenBookmarksDB()
+	if err != nil {
+		return err
+	}
+	defer database.Close()
+	if invocation.Path == "folders" {
+		counts, untagged, err := FolderCounts(database)
+		if err != nil {
+			return err
+		}
+		if invocation.Flag("json") {
+			return printJSON(output, map[string]any{"counts": counts, "untagged": untagged})
+		}
+		printCounts(output, counts)
+		fmt.Fprintf(output, "  %-24s %5d\n", "(untagged)", untagged)
+		return nil
+	}
+	column := "primary_category"
+	if invocation.Path == "domains" {
+		column = "primary_domain"
+	}
+	counts, err := Distribution(database, column)
+	if err != nil {
+		return err
+	}
+	if invocation.Flag("json") {
+		return printJSON(output, counts)
+	}
+	if len(counts) == 0 {
+		fmt.Fprintf(output, "No %s found. Run: ft classify\n", invocation.Path)
+	}
+	printCounts(output, counts)
+	return nil
+}
+
+func status(invocation Invocation, output io.Writer) error {
+	metadata := map[string]any{}
+	ReadJSON(MetaPath(), &metadata)
+	count := len(ReadJSONLines[BookmarkRecord](CachePath()))
+	if total, ok := metadata["totalBookmarks"].(float64); ok {
+		count = int(total)
+	}
+	view := map[string]any{"connected": false, "bookmarkCount": count, "classificationTotal": 0, "categoriesDone": 0, "domainsDone": 0, "lastUpdated": nil, "mode": "Local JSONL cache", "cachePath": CachePath()}
+	for _, key := range []string{"lastIncrementalSyncAt", "lastFullSyncAt"} {
+		if value, ok := metadata[key].(string); ok {
+			if view["lastUpdated"] == nil {
+				view["lastUpdated"] = value
+			} else {
+				previous, validPrevious := ParseTimestamp(view["lastUpdated"].(string))
+				parsed, valid := ParseTimestamp(value)
+				if valid && (!validPrevious || parsed.After(previous)) {
+					view["lastUpdated"] = value
+				}
+			}
+		}
+	}
+	if exists(IndexPath()) {
+		database, err := OpenBookmarksDB()
+		if err != nil {
+			return err
+		}
+		defer database.Close()
+		var total, categories, domains int
+		if err = database.QueryRow(`SELECT COUNT(*),COALESCE(SUM(primary_category IS NOT NULL AND primary_category!='' AND primary_category!='unclassified'),0),COALESCE(SUM(primary_domain IS NOT NULL AND primary_domain!=''),0) FROM bookmarks`).Scan(&total, &categories, &domains); err != nil {
+			return err
+		}
+		view["classificationTotal"], view["categoriesDone"], view["domainsDone"] = total, categories, domains
+	}
+	return printValue(output, invocation, map[string]any{"bookmarks": view, "paths": PathReport()}, fmt.Sprintf("Bookmarks\n  bookmarks: %v\n  categories: %v/%v\n  domains: %v/%v\n  last updated: %v\n  cache: %s", count, view["categoriesDone"], view["classificationTotal"], view["domainsDone"], view["classificationTotal"], view["lastUpdated"], CachePath()))
+}
+
+func modelCommand(invocation Invocation, output io.Writer) error {
+	available, preferences := DetectEngines(), LoadPreferences()
+	if name := invocation.Arg(0); name != "" {
+		engine, err := ResolveEngine(EngineProfile{Engine: name})
+		if err != nil {
+			return err
+		}
+		preferences["defaultEngine"] = engine.Name
+		if err := SavePreferences(preferences); err != nil {
+			return err
+		}
+		return printValue(output, invocation, preferences, "Default model set to "+engine.Name)
+	}
+	if invocation.Flag("json") {
+		return printJSON(output, map[string]any{"available": available, "defaultEngine": preferences["defaultEngine"]})
+	}
+	fmt.Fprintln(output, "Available engines:")
+	for _, name := range available {
+		suffix := ""
+		if preferences["defaultEngine"] == name {
+			suffix = " (default)"
+		}
+		fmt.Fprintln(output, "  "+name+suffix)
+	}
+	if len(available) == 0 {
+		fmt.Fprintln(output, "No LLM engines found on PATH. Install claude or codex.")
+		return nil
+	}
+	if isTTY(os.Stdin) {
+		answer := PromptText("Default engine (claude/codex): ", os.Stdin, os.Stderr)
+		if answer.Kind == "interrupt" {
+			return &ExitError{130, "Cancelled"}
+		}
+		if answer.Kind == "answer" && answer.Value != "" {
+			invocation.Args = []string{answer.Value}
+			return modelCommand(invocation, output)
+		}
+	}
+	return nil
+}
+
+func documentCommand(invocation Invocation, output io.Writer) error {
+	store := LibraryStore()
+	if strings.HasPrefix(invocation.Path, "commands ") {
+		store = CommandsStore()
+	}
+	subcommand := strings.Split(invocation.Path, " ")[1]
+	input := DocumentInput{Stdin: invocation.Flag("stdin"), File: invocation.Value("file"), Title: invocation.Value("title"), ExpectedSHA256: invocation.Value("expected-sha256"), Force: invocation.Flag("force")}
+	switch subcommand {
+	case "list", "search":
+		var documents []Document
+		var err error
+		if subcommand == "search" {
+			documents, err = store.Search(invocation.Arg(0), invocation.Number("limit", 20))
+		} else {
+			documents, err = store.List(invocation.Number("limit", 0))
+		}
+		if err != nil {
+			return err
+		}
+		if invocation.Flag("json") {
+			return printJSON(output, documents)
+		}
+		for _, document := range documents {
+			fmt.Fprintf(output, "%s  %s%s\n", document.RelPath, document.Title+document.Name, map[bool]string{true: "\n  " + document.Snippet}[document.Snippet != ""])
+		}
+		return nil
+	case "validate":
+		results, err := store.Validate(invocation.Arg(0))
+		if err != nil {
+			return err
+		}
+		if invocation.Flag("json") {
+			if err = printJSON(output, results); err != nil {
+				return err
+			}
+		} else {
+			for _, result := range results {
+				label := "ok"
+				if !result.OK {
+					label = "issues"
+				}
+				fmt.Fprintf(output, "%s  %s\n", label, result.RelPath)
+				for _, issue := range result.Issues {
+					fmt.Fprintln(output, "  - "+issue)
+				}
+			}
+		}
+		for _, result := range results {
+			if !result.OK {
+				return &ExitError{Code: 1}
+			}
+		}
+		return nil
+	case "delete":
+		result, err := store.Delete(invocation.Arg(0))
+		if err != nil {
+			return err
+		}
+		return printValue(output, invocation, result, "Moved to Trash: "+result["trashPath"])
+	}
+	var document Document
+	var err error
+	switch subcommand {
+	case "create", "new":
+		document, err = store.Create(invocation.Arg(0), input, os.Stdin)
+	case "update":
+		if !input.Stdin && input.File == "" {
+			return fmt.Errorf("Pass --stdin or --file for update content")
+		}
+		document, err = store.Update(invocation.Arg(0), input, os.Stdin)
+	case "rename":
+		document, err = store.Rename(invocation.Arg(0), invocation.Arg(1))
+	case "show", "open":
+		document, err = store.Show(invocation.Arg(0))
+	default:
+		return fmt.Errorf("unknown document operation %s", subcommand)
+	}
+	if err != nil {
+		return err
+	}
+	if subcommand == "open" {
+		return printValue(output, invocation, appTarget(document.Path, store.Commands), document.Path)
+	}
+	if invocation.Flag("json") {
+		return printJSON(output, document)
+	}
+	if subcommand == "show" {
+		fmt.Fprint(output, *document.Content)
+		if !strings.HasSuffix(*document.Content, "\n") {
+			fmt.Fprintln(output)
+		}
+		return nil
+	}
+	fmt.Fprintf(output, "%s: %s\nsha256: %s\n", map[string]string{"create": "Created", "new": "Created", "update": "Updated", "rename": "Renamed"}[subcommand], document.Path, document.Version.SHA256)
+	return nil
+}
