+		return true, printValue(output, invocation, result, answer+"\n\nSources: "+strings.Join(pages, ", "))
+	case "lint":
+		store := DocumentStore{Root: LibraryDir()}
+		documents, err := store.List(0)
+		if err != nil {
+			return true, err
+		}
+		known := map[string]bool{}
+		for _, document := range documents {
+			known[strings.ToLower(strings.TrimSuffix(document.RelPath, filepath.Ext(document.RelPath)))] = true
+			known[strings.ToLower(document.Title)] = true
+			known[strings.ToLower(strings.TrimSuffix(filepath.Base(document.RelPath), filepath.Ext(document.RelPath)))] = true
+		}
+		issues := []map[string]any{}
+		totalLinks := 0
+		for _, document := range documents {
+			raw, err := os.ReadFile(document.Path)
+			if err != nil {
+				return true, err
+			}
+			content := string(raw)
+			clean := stripMarkdownFence(content)
+			if clean != content {
+				issue := map[string]any{"type": "code-fence", "page": document.RelPath, "detail": "Page is wrapped in an LLM code fence", "fixable": true}
+				if invocation.Flag("fix") {
+					if err := WriteMarkdown(document.Path, clean); err != nil {
+						return true, err
+					}
+				} else {
+					issues = append(issues, issue)
+				}
+			}
+			for _, link := range wikiLinkPattern.FindAllStringSubmatch(content, -1) {
+				totalLinks++
+				if !known[strings.ToLower(link[1])] {
+					issues = append(issues, map[string]any{"type": "broken-link", "page": document.RelPath, "detail": "Missing page: " + link[1], "fixable": false})
+				}
+			}
+		}
+		health := 100
+		if totalLinks > 0 {
+			health -= len(issues) * 100 / totalLinks
+			if health < 0 {
+				health = 0
+			}
+		}
+		result := map[string]any{"issues": issues, "stats": map[string]int{"totalPages": len(documents), "totalLinks": totalLinks, "healthScore": health}}
+		if invocation.Flag("json") {
+			return true, printJSON(output, result)
+		}
+		fmt.Fprintf(output, "Pages: %d  Links: %d  Health: %d%%\n", len(documents), totalLinks, health)
+		for _, issue := range issues {
+			fmt.Fprintf(output, "  [%v] %v: %v\n", issue["type"], issue["page"], issue["detail"])
+		}
+		if len(issues) == 0 {
+			fmt.Fprintln(output, "No issues found.")
+		}
+		return true, nil
+	case "skill", "skill show":
+		fmt.Fprint(output, skillMarkdown)
+		return true, nil
+	case "skill install", "skill uninstall":
+		paths := []string{}
+		if exists(filepath.Join(home(), ".claude")) {
+			paths = append(paths, filepath.Join(home(), ".claude", "commands", "fieldtheory.md"))
+		}
+		if exists(filepath.Join(home(), ".codex")) {
+			paths = append(paths, filepath.Join(home(), ".codex", "instructions", "fieldtheory.md"))
+		}
+		if len(paths) == 0 {
+			paths = append(paths, filepath.Join(home(), ".claude", "commands", "fieldtheory.md"))
+		}
+		for _, path := range paths {
+			if invocation.Path == "skill uninstall" {
+				if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+					return true, err
+				}
+				fmt.Fprintln(output, "Removed: "+path)
+				continue
+			}
+			if exists(path) && !invocation.Flag("force") && !invocation.Flag("yes") {
+				if !isTTY(os.Stdin) {
+					return true, fmt.Errorf("Skill already exists: %s. Pass --force to overwrite", path)
+				}
+				answer := PromptText("Overwrite existing skill? (y/n): ", os.Stdin, os.Stderr)
+				if answer.Kind == "interrupt" {
+					return true, &ExitError{130, "Cancelled"}
+				}
+				if answer.Kind != "answer" || !strings.HasPrefix(strings.ToLower(answer.Value), "y") {
+					continue
+				}
+			}
+			if err := WriteMarkdown(path, skillMarkdown); err != nil {
+				return true, err
+			}
+			fmt.Fprintln(output, "Installed: "+path)
+		}
+		return true, nil
+	}
+	return false, nil
+}
