+func markdownBookmark(item map[string]any) string {
+	var content strings.Builder
+	fmt.Fprintf(&content, "---\nauthor: %q\nauthor_name: %q\nsource_url: %s\ntweet_id: %q\n", "@"+textField(item, "authorHandle"), strings.Join(strings.Fields(textField(item, "authorName")), " "), textField(item, "url"), textField(item, "tweetId"))
+	for _, field := range [][2]string{{"postedAt", "posted_at"}, {"bookmarkedAt", "bookmarked_at"}} {
+		if date := ISODate(textField(item, field[0])); date != nil {
+			fmt.Fprintf(&content, "%s: %s\n", field[1], *date)
+		}
+	}
+	for _, field := range [][2]string{{"primaryCategory", "category"}, {"primaryDomain", "domain"}} {
+		if value := textField(item, field[0]); value != "" {
+			fmt.Fprintf(&content, "%s: %s\n", field[1], value)
+		}
+	}
+	for _, field := range []string{"categories", "domains"} {
+		if values, ok := item[field].([]string); ok && len(values) > 0 {
+			encoded, _ := json.Marshal(values)
+			fmt.Fprintf(&content, "%s: %s\n", field, encoded)
+		}
+	}
+	fmt.Fprintf(&content, "---\n\n# @%s\n\n%s\n", textField(item, "authorHandle"), textField(item, "text"))
+	if article := textField(item, "articleText"); article != "" {
+		fmt.Fprintf(&content, "\n## Article\n\n### %s\n\n%s\n\n%s\n", strings.Join(strings.Fields(textField(item, "articleTitle")), " "), strings.Join(strings.Fields(textField(item, "articleSite")), " "), strings.TrimSpace(article))
+	}
+	for _, field := range [][2]string{{"links", "Links"}, {"githubUrls", "GitHub"}} {
+		if values, ok := item[field[0]].([]string); ok && len(values) > 0 {
+			fmt.Fprintf(&content, "\n## %s\n\n", field[1])
+			for _, value := range values {
+				fmt.Fprintf(&content, "- %s\n", value)
+			}
+		}
+	}
+	if quoted, ok := item["quotedTweet"].(map[string]any); ok {
+		fmt.Fprintf(&content, "\n## Quoted tweet\n\n> %s\n\n%s\n", strings.ReplaceAll(textField(quoted, "text"), "\n", "\n> "), textField(quoted, "url"))
+	}
+	content.WriteString("\n## Related\n\n")
+	for _, pair := range [][2]string{{"primaryCategory", "categories"}, {"primaryDomain", "domains"}, {"authorHandle", "entities"}} {
+		if value := textField(item, pair[0]); value != "" && value != "unclassified" {
+			fmt.Fprintf(&content, "- [[%s/%s]]\n", pair[1], slug(value))
+		}
+	}
+	fmt.Fprintf(&content, "\n[Original tweet](%s)\n", textField(item, "url"))
+	return content.String()
+}
