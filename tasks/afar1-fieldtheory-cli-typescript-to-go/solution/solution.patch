+package ft
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+var wikiLinkPattern = regexp.MustCompile(`\[\[([^\]\n|]+)(?:\|[^\]\n]+)?\]\]`)
+var tagPattern = regexp.MustCompile(`(?:^|[\s(])#([A-Za-z][A-Za-z0-9_-]*)\b`)
+
+func slug(value string) string {
+	value = strings.ToLower(value)
+	value = regexp.MustCompile(`[^a-z0-9]+`).ReplaceAllString(value, "-")
+	return strings.Trim(value, "-")
+}
+func appTarget(path string, command bool) map[string]any {
+	if command {
+		return map[string]any{"path": path, "kind": "command", "url": nil, "supported": false, "note": "Field Theory does not expose a command-file deep link yet; open this path in the Commands view."}
+	}
+	return map[string]any{"path": path, "kind": "library", "url": "fieldtheory://wiki/open?file=" + url.QueryEscape(path) + "&immersive=true", "supported": true}
+}
+func appPanelTarget(path string, command bool) map[string]any {
+	kind, target := "wiki", path
+	if command {
+		kind = "command"
+	} else {
+		relative, _ := filepath.Rel(CanonicalLibraryDir(), path)
+		target = filepath.ToSlash(relative)
+	}
+	return map[string]any{"path": path, "url": "fieldtheory://browser-library/open?kind=" + kind + "&path=" + url.QueryEscape(target), "launched": false}
+}
+func appTargetText(target map[string]any) string {
+	if value, ok := target["url"].(string); ok {
+		return value
+	}
+	return fmt.Sprint(target["note"]) + "\n" + fmt.Sprint(target["path"])
+}
+func navigationDocuments() ([]Document, error) {
+	library, err := LibraryStore().List(0)
+	if err != nil {
+		return nil, err
+	}
+	commands, err := CommandsStore().List(0)
+	if err != nil {
+		return nil, err
+	}
+	positions := map[string]int{}
+	for index, document := range library {
+		positions[document.Path] = index
+	}
+	for _, document := range commands {
+		if index, found := positions[document.Path]; found {
+			library[index] = document
+		} else {
+			positions[document.Path] = len(library)
+			library = append(library, document)
+		}
+	}
+	return library, nil
+}
+func resolveNavigation(target string) (Document, DocumentStore, error) {
+	if target == "current" {
+		document, store, err := currentDocument("")
+		return document, store, err
+	}
+	documents, err := navigationDocuments()
+	if err != nil {
+		return Document{}, DocumentStore{}, err
+	}
+	matches := []Document{}
+	for _, document := range documents {
+		if document.Path == target || document.RelPath == target || strings.TrimSuffix(document.RelPath, filepath.Ext(document.RelPath)) == target {
+			matches = []Document{document}
+			break
+		}
+		if strings.EqualFold(document.Title+document.Name, target) || strings.EqualFold(filepath.Base(document.RelPath), target) || strings.EqualFold(strings.TrimSuffix(filepath.Base(document.RelPath), filepath.Ext(document.RelPath)), target) {
+			matches = append(matches, document)
+		}
+	}
+	if len(matches) == 0 {
+		return Document{}, DocumentStore{}, fmt.Errorf("Document not found: %s. Run ft find <query>", target)
+	}
+	if len(matches) > 1 {
+		return Document{}, DocumentStore{}, fmt.Errorf("ambiguous document %q. Use its relative path", target)
+	}
+	store := LibraryStore()
+	argument := matches[0].Path
+	if matches[0].Name != "" {
+		store = CommandsStore()
+		argument = matches[0].RelPath
+	}
+	document, err := store.Show(argument)
+	return document, store, err
+}
+
+func recentContext(repo string, limit int) (map[string]any, error) {
+	if repo == "" {
+		repo, _ = os.Getwd()
+	}
+	repo, _ = filepath.Abs(repo)
+	if info, err := os.Stat(repo); err != nil || !info.IsDir() {
+		return nil, fmt.Errorf("repository directory not found: %s", repo)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, "git", "-C", repo, "ls-files", "-co", "--exclude-standard", "-z")
+	content, commandErr := command.Output()
+	files := []string{}
+	if commandErr == nil {
+		files = strings.Split(string(content), "\x00")
+	} else {
+		filepath.WalkDir(repo, func(path string, entry os.DirEntry, err error) error {
+			if err != nil {
+				return nil
+			}
+			if entry.IsDir() {
+				if path != repo && skipContextDir(entry.Name()) {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			relative, _ := filepath.Rel(repo, path)
+			files = append(files, relative)
+			return nil
+		})
+	}
+	type recentFile struct {
+		path     string
+		modified time.Time
+	}
+	recent := []recentFile{}
+	for _, file := range unique(files) {
+		if file == "" {
+			continue
+		}
+		skip := false
+		for _, part := range strings.Split(filepath.ToSlash(file), "/") {
+			if skipContextDir(part) {
+				skip = true
+			}
+		}
+		if skip || regexp.MustCompile(`(?i)\.(png|jpe?g|gif|webp|avif|mp4|mov|mp3|wav|pdf|zip|tar|gz|wasm|bin)$`).MatchString(file) {
+			continue
+		}
+		path := filepath.Join(repo, file)
+		info, err := os.Stat(path)
+		if err != nil || !info.Mode().IsRegular() {
+			continue
+		}
+		recent = append(recent, recentFile{path, info.ModTime()})
+	}
+	sort.Slice(recent, func(left, right int) bool { return recent[left].modified.After(recent[right].modified) })
+	if limit <= 0 {
+		limit = 10
+	}
+	if len(recent) > limit {
+		recent = recent[:limit]
+	}
+	entries := []map[string]string{}
+	for _, file := range recent {
+		entries = append(entries, map[string]string{"path": file.path, "modifiedAt": file.modified.UTC().Format("2006-01-02T15:04:05.000Z")})
+	}
+	var last any
+	if len(entries) > 0 {
+		last = entries[0]
+	}
+	return map[string]any{"cwd": repo, "lastModifiedFile": last, "recentFiles": entries}, nil
+}
+func skipContextDir(name string) bool {
+	return strings.Contains(" .git node_modules .next dist build out coverage .turbo .cache __pycache__ .venv venv DerivedData ", " "+name+" ")
+}
+
+func currentManifest(explicit string) (map[string]any, string, error) {
+	paths := []string{}
+	if explicit != "" {
+		paths = append(paths, explicit)
+	} else {
+		var sessions []map[string]any
+		ReadJSON(filepath.Join(FieldTheoryDir(), ".codex-context", "session-state.json"), &sessions)
+		for _, session := range sessions {
+			attached, _ := session["attachedContexts"].([]any)
+			for _, item := range attached {
+				if record, ok := item.(map[string]any); ok {
+					if path, ok := record["filePath"].(string); ok && exists(path) {
+						paths = append(paths, path)
+					}
+				}
+			}
+		}
+		if len(paths) == 0 {
+			for _, root := range []string{filepath.Join(FieldTheoryDir(), ".codex-context", "sessions"), filepath.Join(CanonicalLibraryDir(), "Codex Context", "sessions")} {
+				entries, _ := os.ReadDir(root)
+				for _, entry := range entries {
+					path := filepath.Join(root, entry.Name(), "context.json")
+					if entry.IsDir() && exists(path) {
+						paths = append(paths, path)
+					}
+				}
+			}
+		}
+		sort.SliceStable(paths, func(left, right int) bool {
+			leftInfo, leftErr := os.Stat(paths[left])
+			rightInfo, rightErr := os.Stat(paths[right])
+			return leftErr == nil && (rightErr != nil || leftInfo.ModTime().After(rightInfo.ModTime()))
+		})
+	}
+	if len(paths) == 0 {
+		return nil, "", fmt.Errorf("No active Field Theory context found. Open a Field Theory document and attach a Codex terminal first")
+	}
+	manifest := map[string]any{}
+	if err := ReadJSON(paths[0], &manifest); err != nil {
+		return nil, "", err
+	}
+	active, ok := manifest["activeDocument"].(map[string]any)
+	if !ok {
+		return nil, "", fmt.Errorf("Context manifest has no activeDocument object: %s", paths[0])
+	}
+	contentPath, _ := active["contentPath"].(string)
+	root, _ := filepath.Abs(filepath.Dir(paths[0]))
+	absolute, _ := filepath.Abs(contentPath)
+	if contentPath == "" || !inside(root, absolute) {
+		return nil, "", fmt.Errorf("Context manifest contentPath must be inside its session directory")
+	}
+	if resolved, err := filepath.EvalSymlinks(absolute); err == nil {
+		realRoot, _ := filepath.EvalSymlinks(root)
+		if !inside(realRoot, resolved) {
+			return nil, "", fmt.Errorf("Context content path escapes the session directory")
+		}
+	}
+	return manifest, paths[0], nil
+}
+func currentDocument(explicit string) (Document, DocumentStore, error) {
+	manifest, _, err := currentManifest(explicit)
+	if err != nil {
+		return Document{}, DocumentStore{}, err
+	}
+	active := manifest["activeDocument"].(map[string]any)
+	source, _ := active["path"].(string)
+	if !filepath.IsAbs(source) {
+		return Document{}, DocumentStore{}, fmt.Errorf("Active source is not an absolute markdown path")
+	}
+	for _, root := range []string{filepath.Join(FieldTheoryDir(), ".codex-context", "sessions"), filepath.Join(CanonicalLibraryDir(), "Codex Context", "sessions")} {
+		if inside(root, source) {
+			return Document{}, DocumentStore{}, fmt.Errorf("Runtime context snapshots are not editable source documents")
+		}
+	}
+	for _, root := range unique([]string{CanonicalLibraryDir(), filepath.Join(FieldTheoryDir(), "librarian", "artifacts"), filepath.Join(FieldTheoryRoot(), "librarian", "artifacts")}) {
+		store := DocumentStore{Root: root}
+		if inside(root, source) {
+			document, err := store.Show(source)
+			return document, store, err
+		}
+	}
+	return Document{}, DocumentStore{}, fmt.Errorf("Active source is outside the editable Library and librarian artifact roots")
+}
+func currentCommand(invocation Invocation, output io.Writer) error {
+	manifest, manifestPath, err := currentManifest(invocation.Value("manifest"))
+	if err != nil {
+		return err
+	}
+	active := manifest["activeDocument"].(map[string]any)
+	document, store, editableErr := currentDocument(manifestPath)
+	if invocation.Path == "current update" {
+		if len(invocation.Args) > 0 {
+			return fmt.Errorf("ft current update does not accept document content as arguments. Pipe complete Markdown to stdin, then use --stdin --expected-sha256 <version.sha256>")
+		}
+		if editableErr != nil {
+			return fmt.Errorf("the active document is not an editable Library or command file: %w", editableErr)
+		}
+		stdin := invocation.Flag("stdin")
+		if !stdin && invocation.Value("file") == "" {
+			info, _ := os.Stdin.Stat()
+			stdin = info != nil && (info.Mode()&os.ModeNamedPipe != 0 || info.Mode().IsRegular())
+		}
+		if !stdin && invocation.Value("file") == "" {
+			return fmt.Errorf("Pipe complete Markdown to stdin or pass --stdin/--file for update content")
+		}
+		target := document.Path
+		if store.Commands {
+			target = document.RelPath
+		}
+		updated, err := store.Update(target, DocumentInput{Stdin: stdin, File: invocation.Value("file"), Force: invocation.Flag("force"), ExpectedSHA256: invocation.Value("expected-sha256"), AllowEmpty: invocation.Flag("allow-empty")}, os.Stdin)
+		if err != nil {
+			return err
+		}
+		return printValue(output, invocation, updated, "Updated: "+updated.Path+"\nsha256: "+updated.Version.SHA256)
+	}
+	content := ""
+	var version any
+	if editableErr == nil {
+		content = *document.Content
+		version = document.Version
+	} else {
+		path, _ := active["contentPath"].(string)
+		raw, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		content = string(raw)
+	}
+	if invocation.Flag("content-only") {
+		fmt.Fprint(output, content)
+		return nil
+	}
+	var selection any
+	if value, ok := manifest["selection"].(map[string]any); ok {
+		selection = map[string]any{"preview": value["preview"]}
+	}
+	result := map[string]any{"title": active["title"], "kind": active["kind"], "contentMode": active["contentMode"], "sourcePath": active["path"], "editable": editableErr == nil, "version": version, "updateCommand": "ft current update --stdin --expected-sha256 <version.sha256>", "updatedAt": manifest["updatedAt"], "selection": selection, "recent": currentRelatedPages(manifest["recent"]), "includedPages": currentRelatedPages(manifest["includedPages"]), "lineNumbers": currentLineNumbers(active)}
+	if !invocation.Flag("summary") {
+		result["content"] = content
+	}
+	if invocation.Flag("debug-paths") {
+		result["manifestPath"], result["activeDocument"] = manifestPath, active
+		result["selection"], result["recent"], result["includedPages"] = manifest["selection"], manifest["recent"], manifest["includedPages"]
+	}
+	return printValue(output, invocation, result, fmt.Sprintf("Current Field Theory document\ntitle: %v\nsource: %v\nkind: %v\neditable: %t\n", active["title"], active["path"], active["kind"], editableErr == nil))
+}
+
+func currentRelatedPages(value any) []map[string]any {
+	result := []map[string]any{}
+	if entries, ok := value.([]any); ok {
+		for _, entry := range entries {
+			if record, ok := entry.(map[string]any); ok {
+				result = append(result, map[string]any{"title": record["title"], "kind": record["kind"]})
+			}
+		}
+	}
+	return result
+}
+func currentLineNumbers(active map[string]any) map[string]any {
+	result := map[string]any{"activeSurface": active["contentMode"], "activeLineKind": nil, "visibleRowsOnly": false, "instructions": "No line map was attached. Treat content newline numbers as Markdown source lines.", "lines": []any{}}
+	if active["contentMode"] == "markdown" {
+		result["activeLineKind"] = "source"
+	}
+	if mapping, ok := active["lineMapping"].(map[string]any); ok {
+		if value := mapping["contentMode"]; value != nil {
+			result["activeSurface"] = value
+		}
+		for _, key := range []string{"activeLineKind", "visibleRowsOnly", "lines"} {
+			if value, present := mapping[key]; present {
+				result[key] = value
+			}
+		}
+		if mapping["activeLineKind"] == "renderedVisual" {
+			result["instructions"] = "The user is viewing rendered visual lines. Use lineNumbers.lines[].visibleLine for visible line questions; sourceLine maps visible rows back to Markdown. Do not derive visible line numbers by splitting content on newlines."
+		}
+	}
+	return result
+}
+
+func navigationCommand(invocation Invocation, output io.Writer) (bool, error) {
+	switch invocation.Path {
+	case "current", "current update":
+		return true, currentCommand(invocation, output)
+	case "recent", "context":
+		value, err := recentContext(invocation.Value("repo"), invocation.Number("limit", 10))
+		if err != nil {
+			return true, err
+		}
+		if invocation.Flag("json") {
+			return true, printJSON(output, value)
+		}
+		fmt.Fprintf(output, "Repository: %v\nRecent files:\n", value["cwd"])
+		for _, file := range value["recentFiles"].([]map[string]string) {
+			fmt.Fprintf(output, "  %s  %s\n", file["modifiedAt"], file["path"])
+		}
+		return true, nil
+	case "pwd":
+		fmt.Fprintf(output, "library: %s\ncommands: %s\nbookmarks: %s\n", CanonicalLibraryDir(), CommandsDir(), DataDir())
+		return true, nil
+	case "ls", "tree", "find", "grep", "tagged", "tags", "backlinks":
+		if invocation.Path == "ls" && invocation.Arg(0) == "" {
+			places := []map[string]string{}
+			for _, place := range []string{"library", "commands", "briefs", "scratchpad", "wikis", "debates", "recent", "current"} {
+				places = append(places, map[string]string{"name": place})
+			}
+			if invocation.Flag("json") {
+				return true, printJSON(output, places)
+			}
+			for _, place := range places {
+				fmt.Fprintln(output, place["name"])
+			}
+			return true, nil
+		}
+		if invocation.Path == "ls" && (invocation.Arg(0) == "recent" || invocation.Arg(0) == "current") {
+			invocation.Path = invocation.Arg(0)
+			invocation.Args = nil
+			return navigationCommand(invocation, output)
+		}
+		documents, err := navigationDocuments()
+		if err != nil {
+			return true, err
+		}
+		result, tags := []Document{}, map[string]int{}
+		for _, document := range documents {
+			content, err := os.ReadFile(document.Path)
+			if err != nil {
+				return true, err
+			}
+			lower := strings.ToLower(document.RelPath + " " + document.Title + document.Name)
+			match := true
+			switch invocation.Path {
+			case "find":
+				match = strings.Contains(lower, strings.ToLower(invocation.Arg(0)))
+			case "grep":
+				match = strings.Contains(strings.ToLower(string(content)), strings.ToLower(invocation.Arg(0)))
+			case "ls":
+				place := invocation.Arg(0)
+				if place == "commands" {
+					match = document.Name != ""
+				} else if place != "library" {
+					match = strings.HasPrefix(lower, strings.ToLower(place)+"/") || (place == "wikis" && strings.HasPrefix(lower, "wiki/"))
+				} else {
+					match = document.Name == ""
+				}
+			case "tags", "tagged":
+				seen := map[string]bool{}
+				for _, value := range tagPattern.FindAllStringSubmatch(string(content), -1) {
+					if !seen[value[1]] {
+						tags[value[1]]++
+						seen[value[1]] = true
+					}
+				}
+				match = seen[strings.TrimPrefix(invocation.Arg(0), "#")]
+			case "backlinks":
+				target, _, err := resolveNavigation(invocation.Arg(0))
+				if err != nil {
+					return true, err
+				}
+				match = false
+				for _, link := range wikiLinkPattern.FindAllStringSubmatch(string(content), -1) {
+					if strings.EqualFold(link[1], target.Title+target.Name) || link[1] == strings.TrimSuffix(target.RelPath, filepath.Ext(target.RelPath)) {
+						match = true
+					}
+				}
+			}
+			if match {
+				result = append(result, document)
+			}
+		}
+		if invocation.Path == "tags" {
+			values := []map[string]any{}
+			for name, count := range tags {
+				values = append(values, map[string]any{"tag": name, "count": count})
+			}
+			sort.Slice(values, func(left, right int) bool { return values[left]["tag"].(string) < values[right]["tag"].(string) })
+			if invocation.Flag("json") {
+				return true, printJSON(output, values)
+			}
+			for _, value := range values {
+				fmt.Fprintf(output, "#%v  %v\n", value["tag"], value["count"])
+			}
+			return true, nil
+		}
+		if limit := invocation.Number("limit", 0); limit > 0 && len(result) > limit {
+			result = result[:limit]
+		}
+		if invocation.Flag("json") {
+			return true, printJSON(output, result)
+		}
+		for _, document := range result {
+			fmt.Fprintf(output, "%s  %s\n", document.RelPath, document.Title+document.Name)
+		}
+		return true, nil
+	case "new", "note":
+		store := LibraryStore()
+		target := ""
+		input := DocumentInput{Stdin: invocation.Flag("stdin"), File: invocation.Value("file")}
+		if invocation.Path == "note" {
+			target = "Scratchpad/" + time.Now().UTC().Format("2006-01-02") + ".md"
+			text := invocation.Arg(0) + "\n"
+			if existing, err := store.Show(target); err == nil {
+				text = *existing.Content + text
+				input.Content, input.ExpectedSHA256 = &text, existing.Version.SHA256
+				document, err := store.Update(target, input, os.Stdin)
+				return true, printDocumentResult(output, invocation, document, err)
+			}
+			input.Title = invocation.Value("title")
+			if input.Title == "" {
+				input.Title = "Scratchpad " + time.Now().UTC().Format("2006-01-02")
+			}
+			content := "# " + input.Title + "\n\n" + text
+			input.Content = &content
+		} else {
+			kind, title := invocation.Arg(0), invocation.Arg(1)
+			input.Title = title
+			if kind == "command" {
+				store, target = CommandsStore(), slug(title)
+			} else {
+				directory := map[string]string{"brief": "briefs", "scratchpad": "Scratchpad", "wiki": "wikis", "debate": "debates"}[kind]
+				if directory == "" {
+					return true, fmt.Errorf("Unknown Field Theory document type: %s. Choose brief, scratchpad, wiki, debate, or command", kind)
+				}
+				target = directory + "/" + slug(title)
+			}
+		}
+		document, err := store.Create(target, input, os.Stdin)
+		return true, printDocumentResult(output, invocation, document, err)
+	case "cd", "back":
+		path := filepath.Join(CanonicalLibraryDir(), ".ft-navigation-state.json")
+		state := struct {
+			Current   string   `json:"current"`
+			BackStack []string `json:"backStack"`
+		}{Current: "library", BackStack: []string{}}
+		ReadJSON(path, &state)
+		if invocation.Path == "cd" {
+			state.BackStack = append(state.BackStack, state.Current)
+			state.Current = invocation.Arg(0)
+		} else if len(state.BackStack) > 0 {
+			state.Current = state.BackStack[len(state.BackStack)-1]
+			state.BackStack = state.BackStack[:len(state.BackStack)-1]
+		}
+		if err := WriteJSON(path, state); err != nil {
+			return true, err
+		}
+		return true, printValue(output, invocation, state, state.Current)
+	case "cat", "head", "meta", "open", "panel", "codex panel", "tab", "reveal", "app url", "link", "links", "append", "rename":
+		if invocation.Arg(0) == "" && invocation.Value("query") == "" && (invocation.Path == "panel" || invocation.Path == "codex panel" || invocation.Path == "app url") {
+			value := map[string]any{"path": "library", "url": "fieldtheory://browser-library/open?kind=library", "launched": false}
+			return true, printValue(output, invocation, value, appTargetText(value))
+		}
+		target := invocation.Arg(0)
+		if invocation.Value("query") != "" {
+			results, err := LibraryStore().Search(invocation.Value("query"), 2)
+			if err != nil {
+				return true, err
+			}
+			if len(results) != 1 {
+				return true, fmt.Errorf("query must match exactly one document; use ft find to narrow it")
+			}
+			target = results[0].Path
+		}
+		if target == "" {
+			target = "current"
+		}
+		document, store, err := resolveNavigation(target)
+		if err != nil {
+			return true, err
+		}
+		content := *document.Content
+		switch invocation.Path {
+		case "open", "panel", "codex panel", "tab", "reveal", "app url":
+			value := appTarget(document.Path, store.Commands)
+			if invocation.Path == "panel" || invocation.Path == "codex panel" || invocation.Path == "app url" {
+				value = appPanelTarget(document.Path, store.Commands)
+			}
+			if invocation.Path == "tab" || invocation.Path == "reveal" {
+				if link, ok := value["url"].(string); ok {
+					parsed, _ := url.Parse(link)
+					query := parsed.Query()
+					query.Set("action", invocation.Path)
+					parsed.RawQuery = query.Encode()
+					value["url"] = parsed.String()
+				}
+			}
+			return true, printValue(output, invocation, value, appTargetText(value))
+		case "link":
+			label := document.Title + document.Name
+			alias := invocation.Value("alias")
+			if alias != "" {
+				label += "|" + strings.ReplaceAll(alias, "]]", "")
+			}
+			link := "[[" + label + "]]"
+			return true, printValue(output, invocation, map[string]string{"path": document.Path, "label": label, "link": link}, link)
+		case "links":
+			values := []map[string]string{}
+			seen := map[string]bool{}
+			for _, link := range wikiLinkPattern.FindAllStringSubmatch(content, -1) {
+				if !seen[link[1]] {
+					values = append(values, map[string]string{"target": link[1]})
+					seen[link[1]] = true
+				}
+			}
+			if invocation.Flag("json") {
+				return true, printJSON(output, values)
+			}
+			for _, value := range values {
+				fmt.Fprintln(output, value["target"])
+			}
+			return true, nil
+		case "append":
+			text := invocation.Value("content")
+			if text == "" {
+				text = invocation.Arg(1)
+			}
+			appendContent, err := readContentInput(DocumentInput{Stdin: invocation.Flag("stdin"), File: invocation.Value("file")}, os.Stdin, text)
+			if err != nil {
+				return true, err
+			}
+			if appendContent == "" {
+				return true, fmt.Errorf("Append content is required. Pass text, --stdin, or --file")
+			}
+			next := content + appendContent
+			if !strings.HasSuffix(next, "\n") {
+				next += "\n"
+			}
+			target = document.Path
+			if store.Commands {
+				target = document.RelPath
+			}
+			updated, err := store.Update(target, DocumentInput{Content: &next, ExpectedSHA256: document.Version.SHA256}, os.Stdin)
+			return true, printDocumentResult(output, invocation, updated, err)
+		case "rename":
+			next := filepath.Join(filepath.Dir(document.RelPath), slug(invocation.Arg(1)))
+			target = document.Path
+			if store.Commands {
+				target, next = document.RelPath, slug(invocation.Arg(1))
+			}
+			updated, err := store.Rename(target, next)
+			if err != nil {
+				return true, err
+			}
+			retitled := "# " + invocation.Arg(1) + "\n\n" + content
+			if heading := regexp.MustCompile(`(?m)^#\s+.+$`).FindStringIndex(content); heading != nil {
+				retitled = content[:heading[0]] + "# " + invocation.Arg(1) + content[heading[1]:]
+			}
+			argument := updated.Path
+			if store.Commands {
+				argument = updated.RelPath
+			}
+			updated, err = store.Update(argument, DocumentInput{Content: &retitled, ExpectedSHA256: updated.Version.SHA256}, os.Stdin)
+			return true, printDocumentResult(output, invocation, updated, err)
+		case "head":
+			lines := strings.Split(content, "\n")
+			count := invocation.Number("lines", 40)
+			if len(lines) > count {
+				lines = lines[:count]
+			}
+			content = strings.Join(lines, "\n")
+		}
+		if invocation.Flag("json") {
+			if invocation.Path == "head" {
+				document.Content = &content
+			}
+			return true, printJSON(output, document)
+		}
+		if invocation.Path == "meta" {
+			fmt.Fprintf(output, "%s\nsha256: %s\nsize: %d\nupdated: %s\n", document.Path, document.Version.SHA256, document.Size, document.UpdatedAt)
+		} else {
+			fmt.Fprint(output, content)
+		}
+		return true, nil
+	}
+	return false, nil
+}
+
+func printDocumentResult(output io.Writer, invocation Invocation, document Document, err error) error {
+	if err != nil {
+		return err
+	}
+	return printValue(output, invocation, document, document.Path+"\nsha256: "+document.Version.SHA256)
+}
diff --git a/internal/ft/paths.go b/internal/ft/paths.go
new file mode 100644
index 0000000..1787acf
--- /dev/null
+++ b/internal/ft/paths.go
@@ -0,0 +1,171 @@
+package ft
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+func exists(path string) bool { _, err := os.Stat(path); return err == nil }
+func home() string            { value, _ := os.UserHomeDir(); return value }
+func FieldTheoryDir() string  { return filepath.Join(home(), ".fieldtheory") }
+func LegacyDataDir() string   { return filepath.Join(home(), ".ft-bookmarks") }
+func envOr(name, fallback string) string {
+	if value := os.Getenv(name); value != "" {
+		return value
+	}
+	return fallback
+}
+func CanonicalDataDir() string {
+	return envOr("FT_DATA_DIR", filepath.Join(FieldTheoryDir(), "bookmarks"))
+}
+func CanonicalLibraryDir() string {
+	return envOr("FT_LIBRARY_DIR", filepath.Join(FieldTheoryDir(), "library"))
+}
+func CanonicalCommandsDir() string {
+	return envOr("FT_COMMANDS_DIR", filepath.Join(CanonicalLibraryDir(), "Commands"))
+}
+func DataDir() string {
+	canonical := CanonicalDataDir()
+	if os.Getenv("FT_DATA_DIR") != "" || exists(canonical) || !exists(LegacyDataDir()) {
+		return canonical
+	}
+	return LegacyDataDir()
+}
+func LibraryDir() string {
+	if value := os.Getenv("FT_LIBRARY_DIR"); value != "" {
+		return value
+	}
+	if value := os.Getenv("FT_DATA_DIR"); value != "" {
+		return filepath.Join(value, "md")
+	}
+	canonical, legacy := CanonicalLibraryDir(), filepath.Join(LegacyDataDir(), "md")
+	if exists(canonical) || !exists(legacy) {
+		return canonical
+	}
+	return legacy
+}
+func CommandsDir() string {
+	if value := os.Getenv("FT_COMMANDS_DIR"); value != "" {
+		return value
+	}
+	canonical := filepath.Join(LibraryDir(), "Commands")
+	legacy := filepath.Join(FieldTheoryDir(), "commands")
+	if os.Getenv("FT_LIBRARY_DIR") != "" || os.Getenv("FT_DATA_DIR") != "" || exists(canonical) || !exists(legacy) {
+		return canonical
+	}
+	return legacy
+}
+func FieldTheoryRoot() string { return envOr("FT_DATA_DIR", FieldTheoryDir()) }
+func CachePath() string       { return filepath.Join(DataDir(), "bookmarks.jsonl") }
+func IndexPath() string       { return filepath.Join(DataDir(), "bookmarks.db") }
+func MetaPath() string        { return filepath.Join(DataDir(), "bookmarks-meta.json") }
+func PreferencesPath() string { return filepath.Join(DataDir(), ".preferences") }
+func IdeasRoot() string       { return filepath.Join(FieldTheoryRoot(), "ideas") }
+
+func PathReport() map[string]any {
+	environment := map[string]string{}
+	for _, name := range []string{"FT_DATA_DIR", "FT_LIBRARY_DIR", "FT_COMMANDS_DIR"} {
+		if value, ok := os.LookupEnv(name); ok {
+			environment[name] = value
+		}
+	}
+	legacy := LegacyDataDir()
+	return map[string]any{
+		"fieldTheoryDir": FieldTheoryDir(),
+		"active":         map[string]string{"bookmarksDir": DataDir(), "libraryDir": LibraryDir(), "commandsDir": CommandsDir(), "mediaDir": filepath.Join(DataDir(), "media"), "mediaManifestPath": filepath.Join(DataDir(), "media-manifest.json"), "bookmarksCachePath": CachePath(), "bookmarksIndexPath": IndexPath()},
+		"canonical":      map[string]string{"bookmarksDir": CanonicalDataDir(), "libraryDir": CanonicalLibraryDir(), "commandsDir": CanonicalCommandsDir()},
+		"env":            environment,
+		"legacy":         map[string]any{"bookmarksDir": legacy, "exists": exists(legacy), "mdDir": filepath.Join(legacy, "md"), "mdExists": exists(filepath.Join(legacy, "md"))},
+	}
+}
+
+type IdeasMigrationResult struct {
+	Migrated           bool   `json:"migrated"`
+	LegacyIdeasRoot    string `json:"legacyIdeasRoot"`
+	LegacyAdjacentRoot string `json:"legacyAdjacentRoot"`
+	NewRoot            string `json:"newRoot"`
+	Reason             string `json:"reason,omitempty"`
+}
+
+func MigrateLegacyIdeasData() (IdeasMigrationResult, error) {
+	result := IdeasMigrationResult{LegacyIdeasRoot: filepath.Join(DataDir(), "automation", "ideas"), LegacyAdjacentRoot: filepath.Join(DataDir(), "automation", "adjacent"), NewRoot: IdeasRoot()}
+	begin, complete := filepath.Join(result.NewRoot, ".migration-in-progress"), filepath.Join(result.NewRoot, ".migrated-from-ft-bookmarks")
+	if exists(complete) {
+		result.Reason = "already-migrated"
+		return result, nil
+	}
+	recovering := exists(begin)
+	if recovering {
+		if err := os.RemoveAll(result.NewRoot); err != nil {
+			return result, err
+		}
+	}
+	entries, _ := os.ReadDir(result.NewRoot)
+	if len(entries) > 0 {
+		result.Reason = "already-migrated"
+		return result, nil
+	}
+	if !exists(result.LegacyIdeasRoot) && !exists(result.LegacyAdjacentRoot) {
+		result.Reason = "nothing-to-migrate"
+		return result, nil
+	}
+	source, _ := filepath.Abs(result.LegacyIdeasRoot)
+	target, _ := filepath.Abs(result.NewRoot)
+	if source == target {
+		result.Reason = "legacy-equals-new"
+		return result, nil
+	}
+	marker := map[string]string{"startedAt": time.Now().UTC().Format(time.RFC3339Nano), "legacyIdeas": result.LegacyIdeasRoot, "legacyAdjacent": result.LegacyAdjacentRoot}
+	if err := WriteJSON(begin, marker); err != nil {
+		return result, err
+	}
+	for _, pair := range [][2]string{{result.LegacyIdeasRoot, result.NewRoot}, {result.LegacyAdjacentRoot, filepath.Join(result.NewRoot, "adjacent")}} {
+		if exists(pair[0]) {
+			if err := copyTree(pair[0], pair[1]); err != nil {
+				return result, err
+			}
+		}
+	}
+	marker["migratedAt"] = time.Now().UTC().Format(time.RFC3339Nano)
+	if err := WriteJSON(complete, marker); err != nil {
+		return result, err
+	}
+	if err := os.Remove(begin); err != nil {
+		return result, err
+	}
+	result.Migrated = true
+	if recovering {
+		result.Reason = "recovered-partial"
+	}
+	return result, syncDirectory(result.NewRoot)
+}
+
+func copyTree(source, target string) error {
+	return filepath.WalkDir(source, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		relative, err := filepath.Rel(source, path)
+		if err != nil {
+			return err
+		}
+		destination := filepath.Join(target, relative)
+		if entry.Type()&os.ModeSymlink != 0 {
+			return fmt.Errorf("refusing to migrate symlink: %s", path)
+		}
+		if entry.IsDir() {
+			return os.MkdirAll(destination, 0700)
+		}
+		content, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		mode := os.FileMode(0600)
+		if markdownExtension(destination) {
+			mode = 0644
+		}
+		return WriteDurable(destination, content, mode)
+	})
+}
diff --git a/internal/ft/process_unix.go b/internal/ft/process_unix.go
new file mode 100644
index 0000000..dff14d9
--- /dev/null
+++ b/internal/ft/process_unix.go
@@ -0,0 +1,34 @@
+//go:build !windows
+
+package ft
+
+import (
+	"os"
+	"os/exec"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+func executableFile(path string, info os.FileInfo) bool {
+	return info.Mode().IsRegular() && unix.Access(path, unix.X_OK) == nil
+}
+
+func prepareProcess(command *exec.Cmd) { command.SysProcAttr = &syscall.SysProcAttr{Setpgid: true} }
+func terminateProcess(command *exec.Cmd, force bool) {
+	signal := syscall.SIGTERM
+	if force {
+		signal = syscall.SIGKILL
+	}
+	syscall.Kill(-command.Process.Pid, signal)
+}
+func processSignal(state *os.ProcessState) string {
+	if status, ok := state.Sys().(syscall.WaitStatus); ok && status.Signaled() {
+		names := map[syscall.Signal]string{syscall.SIGHUP: "SIGHUP", syscall.SIGINT: "SIGINT", syscall.SIGQUIT: "SIGQUIT", syscall.SIGILL: "SIGILL", syscall.SIGTRAP: "SIGTRAP", syscall.SIGABRT: "SIGABRT", syscall.SIGBUS: "SIGBUS", syscall.SIGFPE: "SIGFPE", syscall.SIGKILL: "SIGKILL", syscall.SIGUSR1: "SIGUSR1", syscall.SIGSEGV: "SIGSEGV", syscall.SIGUSR2: "SIGUSR2", syscall.SIGPIPE: "SIGPIPE", syscall.SIGALRM: "SIGALRM", syscall.SIGTERM: "SIGTERM", syscall.SIGCHLD: "SIGCHLD", syscall.SIGCONT: "SIGCONT", syscall.SIGSTOP: "SIGSTOP", syscall.SIGTSTP: "SIGTSTP", syscall.SIGTTIN: "SIGTTIN", syscall.SIGTTOU: "SIGTTOU", syscall.SIGSYS: "SIGSYS", syscall.SIGWINCH: "SIGWINCH"}
+		if name := names[status.Signal()]; name != "" {
+			return name
+		}
+		return status.Signal().String()
+	}
+	return ""
+}
