+package ft
+
+import (
+	"database/sql"
+	"database/sql/driver"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+
+	"modernc.org/sqlite"
+)
+
+var bookmarkColumns = []string{"id", "tweet_id", "url", "text", "author_handle", "author_name", "author_profile_image_url", "posted_at", "bookmarked_at", "synced_at", "conversation_id", "in_reply_to_status_id", "quoted_status_id", "language", "like_count", "repost_count", "reply_count", "quote_count", "bookmark_count", "view_count", "media_count", "link_count", "links_json", "tags_json", "ingested_via", "categories", "primary_category", "github_urls", "domains", "primary_domain", "quoted_tweet_json", "article_title", "article_text", "article_site", "enriched_at", "folder_ids", "folder_names"}
+
+const ftsSchema = `CREATE VIRTUAL TABLE bookmarks_fts USING fts5(text, author_handle, author_name, article_text, content=bookmarks, content_rowid=rowid, tokenize='porter unicode61')`
+
+func init() {
+	if err := sqlite.RegisterDeterministicScalarFunction("ft_timestamp", 1, func(_ *sqlite.FunctionContext, arguments []driver.Value) (driver.Value, error) {
+		value, _ := arguments[0].(string)
+		if parsed, ok := ParseTimestamp(value); ok {
+			return parsed.UnixMilli(), nil
+		}
+		return nil, nil
+	}); err != nil {
+		panic(err)
+	}
+}
+
+func OpenDB(path string) (*sql.DB, error) {
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return nil, err
+	}
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	file.Close()
+	if err := os.Chmod(path, 0600); err != nil {
+		return nil, err
+	}
+	database, err := sql.Open("sqlite", path)
+	if err != nil {
+		return nil, err
+	}
+	database.SetMaxOpenConns(1)
+	for _, pragma := range []string{"PRAGMA busy_timeout=5000", "PRAGMA synchronous=FULL", "PRAGMA journal_mode=DELETE"} {
+		if _, err := database.Exec(pragma); err != nil {
+			database.Close()
+			return nil, err
+		}
+	}
+	return database, nil
+}
+
+func EnsureSchema(database *sql.DB) error {
+	transaction, err := database.Begin()
+	if err != nil {
+		return err
+	}
+	defer transaction.Rollback()
+	if _, err = transaction.Exec(`CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT)`); err != nil {
+		return err
+	}
+	var table string
+	err = transaction.QueryRow(`SELECT name FROM sqlite_master WHERE name='bookmarks' AND type='table'`).Scan(&table)
+	if err != nil && err != sql.ErrNoRows {
+		return err
+	}
+	if table == "" {
+		definitions := make([]string, len(bookmarkColumns))
+		for index, column := range bookmarkColumns {
+			definition := "TEXT"
+			switch column {
+			case "id":
+				definition = "TEXT PRIMARY KEY"
+			case "tweet_id", "url", "text", "synced_at":
+				definition = "TEXT NOT NULL"
+			case "media_count", "link_count":
+				definition = "INTEGER DEFAULT 0"
+			case "like_count", "repost_count", "reply_count", "quote_count", "bookmark_count", "view_count":
+				definition = "INTEGER"
+			}
+			definitions[index] = column + " " + definition
+		}
+		if _, err = transaction.Exec(`CREATE TABLE bookmarks (` + strings.Join(definitions, ",") + `)`); err != nil {
+			return err
+		}
+	} else {
+		rows, err := transaction.Query(`PRAGMA table_info(bookmarks)`)
+		if err != nil {
+			return err
+		}
+		columns := map[string]bool{}
+		for rows.Next() {
+			var position, notNull, primary int
+			var name, kind string
+			var defaultValue any
+			if err = rows.Scan(&position, &name, &kind, &notNull, &defaultValue, &primary); err != nil {
+				rows.Close()
+				return err
+			}
+			columns[name] = true
+		}
+		if err = rows.Err(); err != nil {
+			rows.Close()
+			return err
+		}
+		rows.Close()
+		for _, column := range bookmarkColumns {
+			if !columns[column] {
+				definition := "TEXT"
+				if strings.HasSuffix(column, "_count") {
+					definition = "INTEGER"
+				}
+				if _, err = transaction.Exec(`ALTER TABLE bookmarks ADD COLUMN ` + column + ` ` + definition); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	for _, index := range [][2]string{{"author", "author_handle"}, {"posted", "posted_at"}, {"language", "language"}, {"category", "primary_category"}, {"domain", "primary_domain"}} {
+		if _, err = transaction.Exec(`CREATE INDEX IF NOT EXISTS idx_bookmarks_` + index[0] + ` ON bookmarks(` + index[1] + `)`); err != nil {
+			return err
+		}
+	}
+	ftsRows, ftsError := transaction.Query(`SELECT article_text FROM bookmarks_fts LIMIT 0`)
+	if ftsError == nil {
+		ftsRows.Close()
+	} else {
+		if _, err = transaction.Exec(`DROP TABLE IF EXISTS bookmarks_fts`); err != nil {
+			return err
+		}
+		if _, err = transaction.Exec(ftsSchema); err != nil {
+			return err
+		}
+		if _, err = transaction.Exec(`INSERT INTO bookmarks_fts(bookmarks_fts) VALUES('rebuild')`); err != nil {
+			return err
+		}
+	}
+	if _, err = transaction.Exec(`INSERT OR REPLACE INTO meta(key,value) VALUES('schema_version','6')`); err != nil {
+		return err
+	}
+	return transaction.Commit()
+}
+
+func OpenBookmarksDB() (*sql.DB, error) {
+	if !exists(IndexPath()) {
+		return nil, fmt.Errorf("no search index found. Run: ft index (after importing bookmarks.jsonl)")
+	}
+	database, err := OpenDB(IndexPath())
+	if err != nil {
+		return nil, err
+	}
+	if err = EnsureSchema(database); err != nil {
+		database.Close()
+		return nil, err
+	}
+	return database, nil
+}
+
+type IndexResult struct {
+	DBPath      string `json:"dbPath"`
+	RecordCount int    `json:"recordCount"`
+	NewRecords  int    `json:"newRecords"`
+}
+
+func BuildIndex(force bool) (IndexResult, error) {
+	result := IndexResult{DBPath: IndexPath()}
+	records := ReadJSONLines[BookmarkRecord](CachePath())
+	database, err := OpenDB(IndexPath())
+	if err != nil {
+		return result, err
+	}
+	defer database.Close()
+	if force {
+		for _, table := range []string{"bookmarks_fts", "bookmarks", "meta"} {
+			if _, err = database.Exec(`DROP TABLE IF EXISTS ` + table); err != nil {
+				return result, err
+			}
+		}
+	}
+	if err = EnsureSchema(database); err != nil {
+		return result, err
+	}
+	transaction, err := database.Begin()
+	if err != nil {
+		return result, err
+	}
+	defer transaction.Rollback()
+	known := map[string]bool{}
+	rows, err := transaction.Query(`SELECT id FROM bookmarks`)
+	if err != nil {
+		return result, err
+	}
+	for rows.Next() {
+		var id string
+		if err = rows.Scan(&id); err != nil {
+			rows.Close()
+			return result, err
+		}
+		known[id] = true
+	}
+	if err = rows.Err(); err != nil {
+		rows.Close()
+		return result, err
+	}
+	rows.Close()
+	updates := []string{}
+	preserved := map[string]bool{"categories": true, "primary_category": true, "github_urls": true, "domains": true, "primary_domain": true, "quoted_tweet_json": true, "article_title": true, "article_text": true, "article_site": true, "enriched_at": true}
+	for _, column := range bookmarkColumns[1:] {
+		value := "excluded." + column
+		if preserved[column] {
+			value = "COALESCE(bookmarks." + column + ",excluded." + column + ")"
+		}
+		if column == "folder_ids" || column == "folder_names" {
+			value = "COALESCE(bookmarks." + column + ",excluded." + column + ")"
+		}
+		updates = append(updates, column+"="+value)
+	}
+	statement, err := transaction.Prepare(`INSERT INTO bookmarks (` + strings.Join(bookmarkColumns, ",") + `) VALUES (` + strings.TrimSuffix(strings.Repeat("?,", len(bookmarkColumns)), ",") + `) ON CONFLICT(id) DO UPDATE SET ` + strings.Join(updates, ","))
+	if err != nil {
+		return result, err
+	}
+	defer statement.Close()
+	for _, record := range records {
+		if !known[record.ID] {
+			result.NewRecords++
+		}
+		classification := ClassifyBookmark(record)
+		var quoted any
+		if len(record.QuotedTweet) > 0 && string(record.QuotedTweet) != "null" {
+			quoted = string(record.QuotedTweet)
+		}
+		values := []any{record.ID, record.TweetID, record.URL, record.Text, record.AuthorHandle, record.AuthorName, record.AuthorProfileImageURL, record.PostedAt, record.BookmarkedAt, record.SyncedAt, record.ConversationID, record.InReplyToStatusID, record.QuotedStatusID, record.Language, record.Engagement["likeCount"], record.Engagement["repostCount"], record.Engagement["replyCount"], record.Engagement["quoteCount"], record.Engagement["bookmarkCount"], record.Engagement["viewCount"], len(record.Media), len(record.Links), jsonArray(record.Links), jsonArray(record.Tags), record.IngestedVia, nil, "unclassified", jsonArray(classification.GithubURLs), nil, nil, quoted, record.ArticleTitle, record.ArticleText, record.ArticleSite, record.EnrichedAt, jsonArray(record.FolderIDs), jsonArray(record.FolderNames)}
+		if _, err = statement.Exec(values...); err != nil {
+			return result, err
+		}
+		known[record.ID] = true
+	}
+	if _, err = transaction.Exec(`INSERT INTO bookmarks_fts(bookmarks_fts) VALUES('rebuild')`); err != nil {
+		return result, err
+	}
+	if err = transaction.QueryRow(`SELECT COUNT(*) FROM bookmarks`).Scan(&result.RecordCount); err != nil {
+		return result, err
+	}
+	if err = transaction.Commit(); err != nil {
+		return result, err
+	}
+	return result, syncDirectory(filepath.Dir(IndexPath()))
+}
+
+func queryMaps(database *sql.DB, query string, arguments ...any) ([]map[string]any, error) {
+	result := []map[string]any{}
+	rows, err := database.Query(query, arguments...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	columns, err := rows.Columns()
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		values, references := make([]any, len(columns)), make([]any, len(columns))
+		for index := range values {
+			references[index] = &values[index]
+		}
+		if err := rows.Scan(references...); err != nil {
+			return nil, err
+		}
+		item := map[string]any{}
+		for index, column := range columns {
+			value := values[index]
+			if content, ok := value.([]byte); ok {
+				value = string(content)
+			}
+			item[column] = value
+		}
+		result = append(result, item)
+	}
+	return result, rows.Err()
+}
+
+func camelCase(value string) string {
+	parts := strings.Split(value, "_")
+	for index := 1; index < len(parts); index++ {
+		parts[index] = strings.ToUpper(parts[index][:1]) + parts[index][1:]
+	}
+	return strings.Join(parts, "")
+}
+func timelineItem(row map[string]any) map[string]any {
+	item := map[string]any{}
+	for _, column := range []string{"id", "tweet_id", "url", "text", "author_handle", "author_name", "author_profile_image_url", "posted_at", "bookmarked_at", "synced_at", "primary_category", "primary_domain", "article_title", "article_text", "article_site", "enriched_at", "quoted_status_id", "media_count", "link_count", "like_count", "repost_count", "reply_count", "quote_count", "bookmark_count", "view_count"} {
+		if row[column] == nil && strings.HasPrefix(column, "author_") {
+			continue
+		}
+		item[camelCase(column)] = row[column]
+	}
+	for column, name := range map[string]string{"links_json": "links", "github_urls": "githubUrls", "folder_ids": "folderIds", "folder_names": "folderNames"} {
+		item[name] = parseArray(row[column])
+	}
+	for _, column := range []string{"categories", "domains"} {
+		values := []string{}
+		if text, ok := row[column].(string); ok {
+			for _, value := range strings.Split(text, ",") {
+				if value = strings.TrimSpace(value); value != "" {
+					values = append(values, value)
+				}
+			}
+		}
+		item[column] = values
+	}
+	var quoted any
+	if text, ok := row["quoted_tweet_json"].(string); ok {
+		json.Unmarshal([]byte(text), &quoted)
+	}
+	item["quotedTweet"] = quoted
+	return item
+}
+
+var ftsOperators = regexp.MustCompile(`[*{}:^"()\\+.-]|(^|\s)-\S|(?i)(^|\s)(AND|OR|NOT|NEAR)(\s|$)`)
+
+func SanitizeFTSQuery(query string) string {
+	if !ftsOperators.MatchString(query) {
+		return query
+	}
+	terms := strings.Fields(query)
+	for index, term := range terms {
+		terms[index] = `"` + strings.ReplaceAll(term, `"`, "") + `"`
+	}
+	return strings.Join(terms, " ")
+}
+
+type BookmarkFilters struct {
+	Query, Author, After, Before, Category, Domain, Folder string
+	Limit, Offset                                          int
+	Ascending                                              bool
+}
+
+func bookmarkWhere(filters BookmarkFilters, search bool) (string, []any) {
+	conditions, arguments := []string{}, []any{}
+	if filters.Query != "" {
+		conditions = append(conditions, `bookmarks_fts MATCH ?`)
+		arguments = append(arguments, SanitizeFTSQuery(filters.Query))
+	}
+	if filters.Author != "" {
+		conditions = append(conditions, `b.author_handle = ? COLLATE NOCASE`)
+		arguments = append(arguments, filters.Author)
+	}
+	dateColumn := "b.posted_at"
+	if !search {
+		dateColumn = "COALESCE(b.posted_at,b.bookmarked_at)"
+	}
+	if filters.After != "" {
+		conditions = append(conditions, `ft_timestamp(`+dateColumn+`) >= ft_timestamp(?)`)
+		arguments = append(arguments, filters.After)
+	}
+	if filters.Before != "" {
+		conditions = append(conditions, `ft_timestamp(`+dateColumn+`) <= ft_timestamp(?)`)
+		arguments = append(arguments, filters.Before)
+	}
+	for _, field := range [][2]string{{"categories", filters.Category}, {"domains", filters.Domain}} {
+		if field[1] != "" {
+			conditions = append(conditions, `b.`+field[0]+` LIKE ?`)
+			arguments = append(arguments, "%"+field[1]+"%")
+		}
+	}
+	if filters.Folder != "" {
+		conditions = append(conditions, `EXISTS(SELECT 1 FROM json_each(b.folder_names) WHERE value = ? COLLATE NOCASE)`)
+		arguments = append(arguments, filters.Folder)
+	}
+	if len(conditions) == 0 {
+		return "", arguments
+	}
+	return " WHERE " + strings.Join(conditions, " AND "), arguments
+}
+
+func SearchBookmarks(filters BookmarkFilters) ([]map[string]any, error) {
+	database, err := OpenBookmarksDB()
+	if err != nil {
+		return nil, err
+	}
+	defer database.Close()
+	if filters.Limit == 0 {
+		filters.Limit = 20
+	}
+	where, arguments := bookmarkWhere(filters, true)
+	query := `SELECT b.id,b.url,b.text,b.author_handle,b.author_name,b.posted_at,0 AS score FROM bookmarks b`
+	order := ` ORDER BY ft_timestamp(b.posted_at) DESC`
+	if filters.Query != "" {
+		query = `SELECT b.id,b.url,b.text,b.author_handle,b.author_name,b.posted_at,bm25(bookmarks_fts,5.0,1.0,1.0,3.0) AS score FROM bookmarks b JOIN bookmarks_fts ON bookmarks_fts.rowid=b.rowid`
+		order = ` ORDER BY bm25(bookmarks_fts,5.0,1.0,1.0,3.0) ASC`
+	}
+	arguments = append(arguments, filters.Limit)
+	rows, err := queryMaps(database, query+where+order+` LIMIT ?`, arguments...)
+	if err != nil {
+		return nil, readableQueryError(err, filters.Query)
+	}
+	for index, row := range rows {
+		item := map[string]any{}
+		for column, value := range row {
+			item[camelCase(column)] = value
+		}
+		rows[index] = item
+	}
+	return rows, nil
+}
+
+func readableQueryError(err error, query string) error {
+	if query != "" && (strings.Contains(err.Error(), "fts5") || strings.Contains(err.Error(), "syntax") || strings.Contains(err.Error(), "MATCH")) {
+		return fmt.Errorf("Invalid search query: %q. Try simpler terms or wrap phrases in double quotes", query)
+	}
+	return err
+}
+
+func ListBookmarks(filters BookmarkFilters) ([]map[string]any, error) {
+	database, err := OpenBookmarksDB()
+	if err != nil {
+		return nil, err
+	}
+	defer database.Close()
+	if filters.Limit == 0 {
+		filters.Limit = 30
+	}
+	if filters.Folder != "" {
+		filters.Folder, err = ResolveFolder(database, filters.Folder)
+		if err != nil {
+			return nil, err
+		}
+	}
+	where, arguments := bookmarkWhere(filters, false)
+	from := ` FROM bookmarks b`
+	if filters.Query != "" {
+		from += ` JOIN bookmarks_fts ON bookmarks_fts.rowid=b.rowid`
+	}
+	direction := "DESC"
+	if filters.Ascending {
+		direction = "ASC"
+	}
+	arguments = append(arguments, filters.Limit, filters.Offset)
+	rows, err := queryMaps(database, `SELECT b.*`+from+where+` ORDER BY ft_timestamp(COALESCE(b.bookmarked_at,b.posted_at)) `+direction+`,CAST(b.tweet_id AS INTEGER) `+direction+` LIMIT ? OFFSET ?`, arguments...)
+	if err != nil {
+		return nil, readableQueryError(err, filters.Query)
+	}
+	for index, row := range rows {
+		rows[index] = timelineItem(row)
+	}
+	return rows, nil
+}
+
+func GetBookmark(id string) (map[string]any, error) {
+	database, err := OpenBookmarksDB()
+	if err != nil {
+		return nil, err
+	}
+	defer database.Close()
+	rows, err := queryMaps(database, `SELECT * FROM bookmarks WHERE id=?`, id)
+	if err != nil {
+		return nil, err
+	}
+	if len(rows) == 0 {
+		return nil, fmt.Errorf("Bookmark not found: %s", id)
+	}
+	return timelineItem(rows[0]), nil
+}
+
+func SampleBookmarks(category string, limit int) ([]map[string]any, error) {
+	database, err := OpenBookmarksDB()
+	if err != nil {
+		return nil, err
+	}
+	defer database.Close()
+	rows, err := queryMaps(database, `SELECT * FROM bookmarks WHERE categories LIKE ? ORDER BY RANDOM() LIMIT ?`, "%"+category+"%", limit)
+	if err != nil {
+		return nil, err
+	}
+	for index, row := range rows {
+		rows[index] = timelineItem(row)
+	}
+	return rows, nil
+}
+
+func GetStats() (map[string]any, error) {
+	database, err := OpenBookmarksDB()
+	if err != nil {
+		return nil, err
+	}
+	defer database.Close()
+	var total, authors int
+	if err = database.QueryRow(`SELECT COUNT(*),COUNT(DISTINCT author_handle) FROM bookmarks`).Scan(&total, &authors); err != nil {
+		return nil, err
+	}
+	dates, err := queryMaps(database, `SELECT posted_at FROM bookmarks WHERE posted_at IS NOT NULL`)
+	if err != nil {
+		return nil, err
+	}
+	var earliest, latest *string
+	var earliestMS, latestMS int64
+	for _, row := range dates {
+		if value, ok := row["posted_at"].(string); ok {
+			if parsed, ok := ParseTimestamp(value); ok {
+				milliseconds := parsed.UnixMilli()
+				if earliest == nil || milliseconds < earliestMS {
+					earliest, earliestMS = ISODate(value), milliseconds
+				}
+				if latest == nil || milliseconds > latestMS {
+					latest, latestMS = ISODate(value), milliseconds
+				}
+			}
+		}
+	}
+	topAuthors, err := queryMaps(database, `SELECT author_handle AS handle,COUNT(*) AS count FROM bookmarks WHERE author_handle IS NOT NULL GROUP BY author_handle ORDER BY count DESC LIMIT 15`)
+	if err != nil {
+		return nil, err
+	}
+	languages, err := queryMaps(database, `SELECT language,COUNT(*) AS count FROM bookmarks WHERE language IS NOT NULL GROUP BY language ORDER BY count DESC LIMIT 10`)
+	if err != nil {
+		return nil, err
+	}
+	return map[string]any{"totalBookmarks": total, "uniqueAuthors": authors, "dateRange": map[string]any{"earliest": earliest, "latest": latest}, "topAuthors": topAuthors, "languageBreakdown": languages}, nil
+}
+
+func Distribution(database *sql.DB, column string) (map[string]int, error) {
+	if column != "primary_category" && column != "primary_domain" {
+		return nil, fmt.Errorf("invalid distribution column")
+	}
+	query := `SELECT ` + column + `,COUNT(*) FROM bookmarks WHERE ` + column + ` IS NOT NULL`
+	if column == "primary_category" {
+		query += ` AND primary_category != 'unclassified'`
+	}
+	rows, err := database.Query(query + ` GROUP BY ` + column + ` ORDER BY COUNT(*) DESC`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	counts := map[string]int{}
+	for rows.Next() {
+		var name string
+		var count int
+		if err := rows.Scan(&name, &count); err != nil {
+			return nil, err
+		}
+		counts[name] = count
+	}
+	return counts, rows.Err()
+}
+
+func FolderCounts(database *sql.DB) (map[string]int, int, error) {
+	rows, err := queryMaps(database, `SELECT folder_names FROM bookmarks`)
+	if err != nil {
+		return nil, 0, err
+	}
+	counts, untagged := map[string]int{}, 0
+	for _, row := range rows {
+		names := parseArray(row["folder_names"])
+		if len(names) == 0 {
+			untagged++
+		}
+		for _, name := range names {
+			counts[name]++
+		}
+	}
+	return counts, untagged, nil
+}
+
+func ResolveFolder(database *sql.DB, query string) (string, error) {
+	counts, _, err := FolderCounts(database)
+	if err != nil {
+		return "", err
+	}
+	matches := []string{}
+	for name := range counts {
+		if strings.EqualFold(name, query) {
+			return name, nil
+		}
+		if strings.HasPrefix(strings.ToLower(name), strings.ToLower(query)) {
+			matches = append(matches, name)
+		}
+	}
+	if len(matches) == 1 {
+		return matches[0], nil
+	}
+	sort.Strings(matches)
+	if len(matches) > 1 {
+		return "", fmt.Errorf("ambiguous folder %q: %s. Use the exact folder name", query, strings.Join(matches, ", "))
+	}
+	return "", fmt.Errorf("folder %q not found in local cache. Run: ft sync --folders", query)
+}
diff --git a/internal/ft/documents.go b/internal/ft/documents.go
new file mode 100644
index 0000000..9e3dfd4
--- /dev/null
+++ b/internal/ft/documents.go
@@ -0,0 +1,482 @@
+package ft
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+type DocumentVersion struct {
+	MtimeMS float64 `json:"mtimeMs"`
+	Size    int64   `json:"size"`
+	SHA256  string  `json:"sha256"`
+}
+type Document struct {
+	Path      string           `json:"path"`
+	RelPath   string           `json:"relPath"`
+	Title     string           `json:"title,omitempty"`
+	Name      string           `json:"name,omitempty"`
+	UpdatedAt string           `json:"updatedAt"`
+	Size      int64            `json:"size"`
+	Content   *string          `json:"content,omitempty"`
+	Version   *DocumentVersion `json:"version,omitempty"`
+	Snippet   string           `json:"snippet,omitempty"`
+}
+type DocumentInput struct {
+	Stdin                 bool
+	File                  string
+	Content               *string
+	Title, ExpectedSHA256 string
+	Force                 bool
+	AllowEmpty            bool
+}
+type DocumentStore struct {
+	Root     string
+	Commands bool
+}
+
+func LibraryStore() DocumentStore  { return DocumentStore{Root: CanonicalLibraryDir()} }
+func CommandsStore() DocumentStore { return DocumentStore{Root: CommandsDir(), Commands: true} }
+func SHA256(value string) string {
+	hash := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(hash[:])
+}
+func inside(root, target string) bool {
+	relative, err := filepath.Rel(root, target)
+	return err == nil && relative != ".." && !strings.HasPrefix(relative, ".."+string(filepath.Separator)) && !filepath.IsAbs(relative)
+}
+func markdownExtension(path string) bool {
+	extension := strings.ToLower(filepath.Ext(path))
+	return extension == ".md" || extension == ".markdown"
+}
+
+func (store DocumentStore) Resolve(target string) (string, error) {
+	raw := strings.TrimSpace(target)
+	invalid := func() (string, error) {
+		kind := "Library path"
+		if store.Commands {
+			kind = "command name"
+		}
+		return "", fmt.Errorf("Invalid %s: %s. Use a markdown path inside the configured root", kind, target)
+	}
+	if raw == "" || strings.ContainsRune(raw, 0) {
+		return invalid()
+	}
+	root, err := filepath.Abs(store.Root)
+	if err != nil {
+		return "", err
+	}
+	if !filepath.IsAbs(raw) {
+		segments := strings.Split(strings.ReplaceAll(raw, `\`, "/"), "/")
+		for index, segment := range segments {
+			segment = strings.TrimSpace(segment)
+			if segment == "" || strings.HasPrefix(segment, ".") || strings.Contains(segment, ":") {
+				return invalid()
+			}
+			segments[index] = segment
+		}
+		raw = filepath.Join(segments...)
+		if !markdownExtension(raw) {
+			raw += ".md"
+		}
+		raw = filepath.Join(root, raw)
+	}
+	path, err := filepath.Abs(raw)
+	if err != nil {
+		return "", err
+	}
+	if !inside(root, path) || path == root || !markdownExtension(path) {
+		return invalid()
+	}
+	if store.Commands {
+		relative, _ := filepath.Rel(root, path)
+		for _, segment := range strings.Split(filepath.ToSlash(relative), "/") {
+			if strings.HasPrefix(segment, ".") || strings.HasPrefix(segment, "_") {
+				return invalid()
+			}
+		}
+	}
+	realRoot := root
+	if resolved, err := filepath.EvalSymlinks(root); err == nil {
+		realRoot = resolved
+	}
+	ancestor := path
+	for !exists(ancestor) {
+		parent := filepath.Dir(ancestor)
+		if parent == ancestor {
+			break
+		}
+		ancestor = parent
+	}
+	resolved, err := filepath.EvalSymlinks(ancestor)
+	if err != nil && !os.IsNotExist(err) {
+		return "", err
+	}
+	if err == nil && exists(root) && !inside(realRoot, resolved) {
+		return invalid()
+	}
+	return path, nil
+}
+
+func (store DocumentStore) read(path string, full bool) (Document, error) {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return Document{}, err
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return Document{}, err
+	}
+	if !info.Mode().IsRegular() {
+		return Document{}, fmt.Errorf("not a file: %s", path)
+	}
+	root, _ := filepath.Abs(store.Root)
+	relative, _ := filepath.Rel(root, path)
+	document := Document{Path: path, RelPath: filepath.ToSlash(relative), UpdatedAt: info.ModTime().UTC().Format("2006-01-02T15:04:05.000Z"), Size: info.Size()}
+	stem := strings.TrimSuffix(filepath.Base(path), filepath.Ext(path))
+	if store.Commands {
+		document.Name = stem
+	} else {
+		document.Title = stem
+		for _, line := range strings.Split(string(content), "\n") {
+			if matched, _ := regexp.MatchString(`^#\s+`, line); matched {
+				document.Title = strings.TrimSpace(strings.TrimLeft(line, "# \t"))
+				break
+			}
+		}
+	}
+	if full {
+		text := string(content)
+		document.Content = &text
+		document.Version = &DocumentVersion{float64(info.ModTime().UnixNano()) / 1e6, info.Size(), SHA256(text)}
+	}
+	return document, nil
+}
+func (store DocumentStore) Show(target string) (Document, error) {
+	path, err := store.Resolve(target)
+	if err != nil {
+		return Document{}, err
+	}
+	return store.read(path, true)
+}
+
+func (store DocumentStore) List(limit int) ([]Document, error) {
+	result := []Document{}
+	root, err := filepath.Abs(store.Root)
+	if err != nil {
+		return nil, err
+	}
+	if !exists(root) {
+		return result, nil
+	}
+	err = filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if path == root {
+			return nil
+		}
+		relative, _ := filepath.Rel(root, path)
+		if entry.IsDir() {
+			if strings.HasPrefix(entry.Name(), ".") || filepath.ToSlash(relative) == "Codex Context/sessions" || store.Commands {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if entry.Type()&os.ModeSymlink != 0 || !entry.Type().IsRegular() || strings.HasPrefix(entry.Name(), ".") || (store.Commands && strings.HasPrefix(entry.Name(), "_")) || !markdownExtension(path) {
+			return nil
+		}
+		if limit > 0 && len(result) >= limit {
+			return fs.SkipAll
+		}
+		document, err := store.read(path, false)
+		if err != nil {
+			return err
+		}
+		result = append(result, document)
+		return nil
+	})
+	return result, err
+}
+func (store DocumentStore) Search(query string, limit int) ([]Document, error) {
+	documents, err := store.List(0)
+	if err != nil {
+		return nil, err
+	}
+	result := []Document{}
+	query = strings.TrimSpace(query)
+	if query == "" {
+		return result, nil
+	}
+	for _, document := range documents {
+		content, err := os.ReadFile(document.Path)
+		if err != nil {
+			return nil, err
+		}
+		if !strings.Contains(strings.ToLower(document.RelPath+"\n"+document.Title+"\n"+string(content)), strings.ToLower(query)) {
+			continue
+		}
+		compact := strings.Join(strings.Fields(string(content)), " ")
+		position := strings.Index(strings.ToLower(compact), strings.ToLower(query))
+		start := position - 70
+		if start < 0 {
+			start = 0
+		}
+		end := position + len(query) + 110
+		if position < 0 {
+			end = 180
+		}
+		if end > len(compact) {
+			end = len(compact)
+		}
+		document.Snippet = compact[start:end]
+		if start > 0 {
+			document.Snippet = "..." + document.Snippet
+		}
+		if end < len(compact) {
+			document.Snippet += "..."
+		}
+		result = append(result, document)
+		if limit > 0 && len(result) >= limit {
+			break
+		}
+	}
+	return result, nil
+}
+
+func readContentInput(input DocumentInput, stdin io.Reader, fallback string) (string, error) {
+	if input.Stdin && input.File != "" {
+		return "", fmt.Errorf("--stdin and --file cannot be used together")
+	}
+	if input.Stdin {
+		content, err := io.ReadAll(stdin)
+		return string(content), err
+	}
+	if input.File != "" {
+		content, err := os.ReadFile(input.File)
+		return string(content), err
+	}
+	if input.Content != nil {
+		return *input.Content, nil
+	}
+	return fallback, nil
+}
+
+func defaultCommand(name string) string {
+	return "# " + name + "\n\nDescribe what this command does in one clear sentence.\n\nUse this when ...\n\n## Steps\n\n1. Do the first concrete thing.\n2. Do the second concrete thing.\n3. Verify the result.\n\n## Guardrails\n\n- Do not include secrets.\n- Ask before destructive actions.\n\n## Verification\n\n- Confirm the intended result is visible or testable.\n"
+}
+
+func (store DocumentStore) Create(target string, input DocumentInput, stdin io.Reader) (Document, error) {
+	if store.Commands {
+		if err := validateCommandName(target); err != nil {
+			return Document{}, err
+		}
+	}
+	path, err := store.Resolve(target)
+	if err != nil {
+		return Document{}, err
+	}
+	if exists(path) {
+		return Document{}, fmt.Errorf("File already exists: %s", path)
+	}
+	fallback := ""
+	if store.Commands {
+		fallback = defaultCommand(strings.TrimSuffix(filepath.Base(path), filepath.Ext(path)))
+	} else if input.Title != "" {
+		fallback = "# " + strings.TrimSpace(input.Title) + "\n"
+	}
+	content, err := readContentInput(input, stdin, fallback)
+	if err != nil {
+		return Document{}, err
+	}
+	if err = os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return Document{}, err
+	}
+	temporary, err := os.CreateTemp(filepath.Dir(path), ".document-*.tmp")
+	if err != nil {
+		return Document{}, err
+	}
+	temporary.Close()
+	defer os.Remove(temporary.Name())
+	if err = WriteMarkdown(temporary.Name(), content); err != nil {
+		return Document{}, err
+	}
+	if err = os.Link(temporary.Name(), path); err != nil {
+		return Document{}, err
+	}
+	if err = syncDirectory(filepath.Dir(path)); err != nil {
+		return Document{}, err
+	}
+	return store.read(path, true)
+}
+
+func (store DocumentStore) Update(target string, input DocumentInput, stdin io.Reader) (Document, error) {
+	path, err := store.Resolve(target)
+	if err != nil {
+		return Document{}, err
+	}
+	content, err := readContentInput(input, stdin, "")
+	if err != nil {
+		return Document{}, err
+	}
+	if strings.TrimSpace(content) == "" && !input.AllowEmpty {
+		return Document{}, fmt.Errorf("Refusing to overwrite with empty content. Pass --stdin or --file with the complete document content")
+	}
+	current, err := store.read(path, true)
+	if err != nil {
+		return Document{}, err
+	}
+	if input.ExpectedSHA256 != "" && input.ExpectedSHA256 != current.Version.SHA256 {
+		return Document{}, fmt.Errorf("File changed on disk. Expected %s, found %s. Read the file again, merge changes, and use the new --expected-sha256", input.ExpectedSHA256, current.Version.SHA256)
+	}
+	if !input.Force && input.ExpectedSHA256 == "" {
+		return Document{}, fmt.Errorf("Refusing to overwrite without --expected-sha256 or --force")
+	}
+	if err = WriteMarkdown(path, content); err != nil {
+		return Document{}, err
+	}
+	return store.read(path, true)
+}
+
+func (store DocumentStore) Rename(target, next string) (Document, error) {
+	if store.Commands {
+		if err := validateCommandName(next); err != nil {
+			return Document{}, err
+		}
+	}
+	oldPath, err := store.Resolve(target)
+	if err != nil {
+		return Document{}, err
+	}
+	newPath, err := store.Resolve(next)
+	if err != nil {
+		return Document{}, err
+	}
+	if !exists(oldPath) {
+		return Document{}, fmt.Errorf("File not found: %s", oldPath)
+	}
+	if exists(newPath) {
+		return Document{}, fmt.Errorf("Target already exists: %s", newPath)
+	}
+	if err = os.MkdirAll(filepath.Dir(newPath), 0700); err != nil {
+		return Document{}, err
+	}
+	if err = os.Link(oldPath, newPath); err != nil {
+		return Document{}, err
+	}
+	if err = os.Remove(oldPath); err != nil {
+		os.Remove(newPath)
+		return Document{}, err
+	}
+	if err = syncDirectory(filepath.Dir(oldPath)); err != nil {
+		return Document{}, err
+	}
+	if err = syncDirectory(filepath.Dir(newPath)); err != nil {
+		return Document{}, err
+	}
+	return store.read(newPath, true)
+}
+
+func validateCommandName(name string) error {
+	name = strings.TrimSpace(name)
+	if name == "" || strings.ContainsAny(name, `/\:`) || filepath.IsAbs(name) || strings.HasPrefix(name, ".") || strings.HasPrefix(name, "_") {
+		return fmt.Errorf("Invalid command name: %s. Use a name without path separators or a leading dot or underscore", name)
+	}
+	return nil
+}
+
+func (store DocumentStore) Delete(target string) (map[string]string, error) {
+	path, err := store.Resolve(target)
+	if err != nil {
+		return nil, err
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("Not a file: %s", path)
+	}
+	trash := filepath.Join(home(), ".Trash")
+	if err = os.MkdirAll(trash, 0700); err != nil {
+		return nil, err
+	}
+	destination := filepath.Join(trash, filepath.Base(path))
+	for exists(destination) {
+		destination = filepath.Join(trash, fmt.Sprintf("%s %d%s", strings.TrimSuffix(filepath.Base(path), filepath.Ext(path)), time.Now().UnixNano(), filepath.Ext(path)))
+	}
+	if err = os.Rename(path, destination); err != nil {
+		content, readErr := os.ReadFile(path)
+		if readErr != nil {
+			return nil, readErr
+		}
+		if err = WriteDurable(destination, content, info.Mode().Perm()); err != nil {
+			return nil, err
+		}
+		if err = os.Remove(path); err != nil {
+			return nil, err
+		}
+	}
+	if err = syncDirectory(trash); err != nil {
+		return nil, err
+	}
+	if err = syncDirectory(filepath.Dir(path)); err != nil {
+		return nil, err
+	}
+	return map[string]string{"originalPath": path, "trashPath": destination}, nil
+}
+
+type CommandValidation struct {
+	Path    string   `json:"path"`
+	RelPath string   `json:"relPath"`
+	OK      bool     `json:"ok"`
+	Issues  []string `json:"issues"`
+}
+
+func ValidateCommandContent(content string) []string {
+	issues := []string{}
+	for _, check := range [][2]string{{`(?m)^#[ \t]+\S`, "Missing top-level heading."}, {`(?i)\bUse this when\b`, `Missing "Use this when" guidance.`}, {`(?im)^##[ \t]+Steps\b`, "Missing ## Steps section."}, {`(?im)^##[ \t]+(Guardrails|Safety)\b`, "Missing ## Guardrails or ## Safety section."}, {`(?i)\b(verify|verification|confirm|test)`, "Missing concrete verification guidance."}} {
+		if !regexp.MustCompile(check[0]).MatchString(content) {
+			issues = append(issues, check[1])
+		}
+	}
+	if regexp.MustCompile(`(?i)["']?(api[ _-]?key|secret|token)["']?\s*[:=]\s*\S+`).MatchString(content) || RedactSecrets(content) != content {
+		issues = append(issues, "Possible secret-like value present.")
+	}
+	return issues
+}
+func (store DocumentStore) Validate(target string) ([]CommandValidation, error) {
+	documents := []Document{}
+	if target == "" {
+		var err error
+		documents, err = store.List(0)
+		if err != nil {
+			return nil, err
+		}
+	} else {
+		document, err := store.Show(target)
+		if err != nil {
+			return nil, err
+		}
+		documents = append(documents, document)
+	}
+	result := []CommandValidation{}
+	for _, document := range documents {
+		content, err := os.ReadFile(document.Path)
+		if err != nil {
+			return nil, err
+		}
+		issues := ValidateCommandContent(string(content))
+		result = append(result, CommandValidation{document.Path, document.RelPath, len(issues) == 0, issues})
+	}
+	sort.Slice(result, func(left, right int) bool { return result[left].RelPath < result[right].RelPath })
+	return result, nil
+}
diff --git a/internal/ft/documents_test.go b/internal/ft/documents_test.go
new file mode 100644
index 0000000..477ebcd
--- /dev/null
+++ b/internal/ft/documents_test.go
@@ -0,0 +1,152 @@
+package ft
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func TestLibraryCRUDVersionProtectionAndTrash(test *testing.T) {
+	isolated(test)
+	store := LibraryStore()
+	content := "# Title\n\nOriginal body.\n"
+	document, err := store.Create("notes/example", DocumentInput{Content: &content}, strings.NewReader(""))
+	if err != nil {
+		test.Fatal(err)
+	}
+	if document.Title != "Title" || document.RelPath != "notes/example.md" || document.Version.SHA256 != SHA256(content) {
+		test.Fatal(document)
+	}
+	if runtime.GOOS != "windows" {
+		info, _ := os.Stat(document.Path)
+		if info.Mode().Perm() != 0644 {
+			test.Fatal(info.Mode())
+		}
+	}
+	if _, err := store.Create("notes/example", DocumentInput{Title: "Conflict"}, strings.NewReader("")); err == nil {
+		test.Fatal("existing file overwritten")
+	}
+	updated := "# Changed\n\nNew body.\n"
+	if _, err := store.Update(document.Path, DocumentInput{Content: &updated}, strings.NewReader("")); err == nil {
+		test.Fatal("unprotected overwrite accepted")
+	}
+	if _, err := store.Update(document.Path, DocumentInput{Content: &updated, ExpectedSHA256: "wrong", Force: true}, strings.NewReader("")); err == nil {
+		test.Fatal("stale hash accepted with force")
+	}
+	if _, err := store.Update(document.Path, DocumentInput{Content: pointer(""), Force: true}, strings.NewReader("")); err == nil {
+		test.Fatal("empty content accepted")
+	}
+	document, err = store.Update(document.Path, DocumentInput{Content: &updated, ExpectedSHA256: document.Version.SHA256}, strings.NewReader(""))
+	if err != nil {
+		test.Fatal(err)
+	}
+	document, err = store.Rename(document.Path, "other/renamed")
+	if err != nil {
+		test.Fatal(err)
+	}
+	if document.RelPath != "other/renamed.md" {
+		test.Fatal(document)
+	}
+	results, err := store.Search("NEW BODY", 20)
+	if err != nil || len(results) != 1 || !strings.Contains(results[0].Snippet, "New body") {
+		test.Fatal(results, err)
+	}
+	trash, err := store.Delete(document.Path)
+	if err != nil {
+		test.Fatal(err)
+	}
+	if exists(document.Path) || !exists(trash["trashPath"]) || !inside(filepath.Join(home(), ".Trash"), trash["trashPath"]) {
+		test.Fatal(trash)
+	}
+}
+
+func TestDocumentTraversalAndInternalDirectories(test *testing.T) {
+	root := isolated(test)
+	store := LibraryStore()
+	for _, target := range []string{"../escape", "notes/../../escape", filepath.Join(root, "outside.md"), ".hidden/file", `..\escape`, "notes/./file", "\x00bad"} {
+		if _, err := store.Resolve(target); err == nil {
+			test.Fatalf("unsafe target accepted: %q", target)
+		}
+	}
+	if err := WriteMarkdown(filepath.Join(store.Root, "visible.md"), "# Visible\n"); err != nil {
+		test.Fatal(err)
+	}
+	for _, target := range []string{".hidden/private.md", "Codex Context/sessions/private.md"} {
+		if err := WriteMarkdown(filepath.Join(store.Root, target), "# Hidden\n"); err != nil {
+			test.Fatal(err)
+		}
+	}
+	documents, err := store.List(0)
+	if err != nil || len(documents) != 1 || documents[0].Title != "Visible" {
+		test.Fatal(documents, err)
+	}
+	if runtime.GOOS != "windows" {
+		outside := filepath.Join(root, "outside")
+		if err := os.Mkdir(outside, 0700); err != nil {
+			test.Fatal(err)
+		}
+		if err := os.Symlink(outside, filepath.Join(store.Root, "escape")); err != nil {
+			test.Fatal(err)
+		}
+		if _, err := store.Resolve("escape/stolen"); err == nil {
+			test.Fatal("symlink traversal accepted")
+		}
+	}
+}
+
+func TestPortableCommandsValidationAndNames(test *testing.T) {
+	isolated(test)
+	store := CommandsStore()
+	for _, name := range []string{"../escape", "folder/name", `folder\name`, ".hidden", "_internal", "/absolute", "C:\\absolute"} {
+		if _, err := store.Create(name, DocumentInput{}, strings.NewReader("")); err == nil {
+			test.Fatalf("invalid command name accepted: %q", name)
+		}
+	}
+	document, err := store.Create("review", DocumentInput{}, strings.NewReader(""))
+	if err != nil {
+		test.Fatal(err)
+	}
+	if document.Name != "review" {
+		test.Fatal(document)
+	}
+	if shown, err := store.Show(document.Path); err != nil || shown.Name != "review" {
+		test.Fatal(shown, err)
+	}
+	if _, err := store.Rename(document.Path, "folder/review"); err == nil {
+		test.Fatal("command rename accepted a path as the new name")
+	}
+	results, err := store.Validate("")
+	if err != nil || len(results) != 1 || !results[0].OK {
+		test.Fatal(results, err)
+	}
+	for _, content := range []string{"no heading", "# Name\nUse this when testing.\n## Steps\n1. Test\n## Safety\nsecret=actual-secret", "# Name\nUse this when testing.\n## Steps\n1. Test\n## Guardrails\nsk-test_012345678901234567890"} {
+		if issues := ValidateCommandContent(content); len(issues) == 0 {
+			test.Fatalf("invalid content passed: %s", content)
+		}
+	}
+	if _, err := store.Update("review", DocumentInput{Content: pointer("# Broken"), ExpectedSHA256: document.Version.SHA256}, strings.NewReader("")); err != nil {
+		test.Fatal(err)
+	}
+	results, err = store.Validate("review")
+	if err != nil || results[0].OK {
+		test.Fatal(results, err)
+	}
+}
+
+func TestNavigationDoesNotDuplicateLibraryCommands(test *testing.T) {
+	isolated(test)
+	test.Setenv("FT_COMMANDS_DIR", "")
+	if _, err := CommandsStore().Create("review", DocumentInput{}, strings.NewReader("")); err != nil {
+		test.Fatal(err)
+	}
+	documents, err := navigationDocuments()
+	if err != nil || len(documents) != 1 {
+		test.Fatal(documents, err)
+	}
+	document, store, err := resolveNavigation("review")
+	if err != nil || !store.Commands || document.Name != "review" {
+		test.Fatal(document, store, err)
+	}
+}
diff --git a/internal/ft/engine.go b/internal/ft/engine.go
new file mode 100644
index 0000000..935c478
--- /dev/null
+++ b/internal/ft/engine.go
@@ -0,0 +1,488 @@
+package ft
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"runtime"
+	"strings"
+	"sync"
+	"time"
+)
+
+var engineOrder = []string{"claude", "codex"}
+
+type EngineProfile struct{ Engine, Override, Model, Effort string }
+type ResolvedEngine struct {
+	Name   string `json:"name"`
+	Model  string `json:"model,omitempty"`
+	Effort string `json:"effort,omitempty"`
+}
+
+func (engine ResolvedEngine) Label() string {
+	label := engine.Name
+	if engine.Model != "" {
+		label += "/" + engine.Model
+	}
+	if engine.Effort != "" {
+		label += "/effort=" + engine.Effort
+	}
+	return label
+}
+func (engine ResolvedEngine) Args(prompt string) []string {
+	arguments := []string{"-p", "--output-format", "text"}
+	if engine.Name == "codex" {
+		arguments = []string{"exec", "--skip-git-repo-check"}
+	}
+	if engine.Model != "" {
+		arguments = append(arguments, "--model", engine.Model)
+	}
+	if engine.Effort != "" {
+		if engine.Name == "codex" {
+			arguments = append(arguments, "--config", `model_reasoning_effort="`+engine.Effort+`"`)
+		} else {
+			arguments = append(arguments, "--effort", engine.Effort)
+		}
+	}
+	return append(arguments, prompt)
+}
+
+func HasCommandOnPath(binary string, environment map[string]string, platform string) bool {
+	delimiter := string(os.PathListSeparator)
+	if platform == "windows" || platform == "win32" {
+		delimiter = ";"
+	}
+	paths := []string{}
+	if strings.ContainsAny(binary, `/\`) {
+		paths = []string{binary}
+	} else {
+		for _, directory := range strings.Split(environment["PATH"], delimiter) {
+			if directory != "" {
+				paths = append(paths, filepath.Join(directory, binary))
+			}
+		}
+	}
+	for _, path := range paths {
+		candidates := []string{path}
+		if platform == "windows" || platform == "win32" {
+			if filepath.Ext(path) == "" {
+				candidates = nil
+				extensions := environment["PATHEXT"]
+				if extensions == "" {
+					extensions = ".EXE;.CMD;.BAT;.COM"
+				}
+				for _, extension := range strings.Split(extensions, ";") {
+					if extension = strings.TrimSpace(extension); extension != "" {
+						candidates = append(candidates, path+extension, path+strings.ToLower(extension))
+					}
+				}
+			}
+		}
+		for _, candidate := range candidates {
+			info, err := os.Stat(candidate)
+			if err == nil && info.Mode().IsRegular() && ((platform == "windows" || platform == "win32") || executableFile(candidate, info)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+func DetectEngines() []string {
+	result := []string{}
+	environment := map[string]string{"PATH": os.Getenv("PATH"), "PATHEXT": os.Getenv("PATHEXT")}
+	for _, name := range engineOrder {
+		if HasCommandOnPath(name, environment, runtime.GOOS) {
+			result = append(result, name)
+		}
+	}
+	return result
+}
+
+type ExitError struct {
+	Code    int
+	Message string
+}
+
+func (failure *ExitError) Error() string { return failure.Message }
+func ResolveEngine(profile EngineProfile) (ResolvedEngine, error) {
+	engine := ResolvedEngine{Model: strings.TrimSpace(profile.Model), Effort: strings.TrimSpace(profile.Effort)}
+	requested := profile.Engine
+	if requested == "" {
+		requested = profile.Override
+	}
+	requested = strings.TrimSpace(requested)
+	available := DetectEngines()
+	if requested != "" {
+		if requested != "claude" && requested != "codex" {
+			return engine, fmt.Errorf("Unknown engine %q. Known engines: claude, codex", requested)
+		}
+		for _, name := range available {
+			if name == requested {
+				engine.Name = name
+				return engine, nil
+			}
+		}
+		return engine, fmt.Errorf("Engine %q is not on PATH. Install it and log in, or pick a different engine", requested)
+	}
+	if len(available) == 0 {
+		return engine, fmt.Errorf("No supported LLM CLI found. Install claude or codex and log in; select it with ft model <engine>")
+	}
+	preferences := LoadPreferences()
+	for _, name := range available {
+		if preferences["defaultEngine"] == name {
+			engine.Name = name
+			return engine, nil
+		}
+	}
+	engine.Name = available[0]
+	if len(available) == 1 || !isTTY(os.Stdin) {
+		return engine, nil
+	}
+	for _, name := range available {
+		answer := PromptText(fmt.Sprintf("  Use %s for classification? (y/n): ", name), os.Stdin, os.Stderr)
+		if answer.Kind == "interrupt" {
+			return engine, &ExitError{130, "Cancelled — no engine selected. Use ft model <engine> or --engine claude / --engine codex"}
+		}
+		if answer.Kind == "close" {
+			return engine, &ExitError{0, "No engine selected. Use ft model <engine> or --engine claude / --engine codex"}
+		}
+		if strings.HasPrefix(strings.ToLower(answer.Value), "y") {
+			engine.Name = name
+			preferences["defaultEngine"] = name
+			if err := SavePreferences(preferences); err != nil {
+				return engine, err
+			}
+			return engine, nil
+		}
+	}
+	return engine, nil
+}
+
+var providerSecret = regexp.MustCompile(`\bsk-[A-Za-z0-9_-]{16,}`)
+var githubSecret = regexp.MustCompile(`\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{16,}`)
+var bearerSecret = regexp.MustCompile(`(?i)\bBearer\s+[A-Za-z0-9._-]{16,}`)
+
+func RedactSecrets(value string) string {
+	value = providerSecret.ReplaceAllString(value, "sk-***REDACTED***")
+	value = githubSecret.ReplaceAllString(value, "${1}_***REDACTED***")
+	return bearerSecret.ReplaceAllString(value, "Bearer ***REDACTED***")
+}
+
+type InvokeOptions struct {
+	Timeout   time.Duration
+	MaxBuffer int
+}
+type EngineInvocationError struct {
+	Engine  string `json:"engine"`
+	Bin     string `json:"bin"`
+	Stderr  string `json:"stderr"`
+	Killed  bool   `json:"killed"`
+	Code    *int   `json:"code"`
+	Signal  string `json:"signal,omitempty"`
+	Reason  string `json:"reason"`
+	timeout time.Duration
+}
+
+func tail(value string, limit int) string {
+	if len(value) > limit {
+		return "…" + strings.ToValidUTF8(value[len(value)-limit:], "")
+	}
+	return value
+}
+func (failure *EngineInvocationError) Error() string {
+	message := failure.Engine + " failed"
+	switch failure.Reason {
+	case "timeout":
+		message = fmt.Sprintf("%s timed out after %s", failure.Engine, failure.timeout)
+	case "maxbuffer":
+		message = failure.Engine + " output exceeded buffer cap"
+	case "spawn":
+		message = failure.Engine + " failed to start"
+	default:
+		if failure.Code != nil {
+			message += fmt.Sprintf(" exit %d", *failure.Code)
+		}
+		if failure.Signal != "" {
+			message += " (signal " + failure.Signal + ")"
+		}
+	}
+	if detail := strings.TrimSpace(tail(failure.Stderr, 500)); detail != "" {
+		message += " — " + detail
+	}
+	return message
+}
+
+type limitedOutput struct {
+	buffer   bytes.Buffer
+	limit    int
+	exceeded chan struct{}
+	once     sync.Once
+}
+
+func (output *limitedOutput) Write(content []byte) (int, error) {
+	remaining := output.limit - output.buffer.Len()
+	if remaining > 0 {
+		count := len(content)
+		if count > remaining {
+			count = remaining
+		}
+		output.buffer.Write(content[:count])
+	}
+	if len(content) > remaining {
+		output.once.Do(func() { close(output.exceeded) })
+	}
+	return len(content), nil
+}
+
+type tailOutput struct {
+	content []byte
+	limit   int
+}
+
+func (output *tailOutput) Write(content []byte) (int, error) {
+	count := len(content)
+	if len(content) >= output.limit {
+		output.content = append(output.content[:0], content[len(content)-output.limit:]...)
+	} else {
+		excess := len(output.content) + len(content) - output.limit
+		if excess > 0 {
+			output.content = output.content[excess:]
+		}
+		output.content = append(output.content, content...)
+	}
+	return count, nil
+}
+
+type streamSecretPattern struct {
+	prefix      string
+	replacement string
+	allowed     func(byte) bool
+}
+
+func asciiAlphaNumeric(value byte) bool {
+	return value >= 'a' && value <= 'z' || value >= 'A' && value <= 'Z' || value >= '0' && value <= '9'
+}
+
+var streamSecretPatterns = []streamSecretPattern{
+	{prefix: "sk-", replacement: "sk-***REDACTED***", allowed: func(value byte) bool { return asciiAlphaNumeric(value) || value == '_' || value == '-' }},
+	{prefix: "ghp_", replacement: "ghp_***REDACTED***", allowed: asciiAlphaNumeric},
+	{prefix: "gho_", replacement: "gho_***REDACTED***", allowed: asciiAlphaNumeric},
+	{prefix: "ghu_", replacement: "ghu_***REDACTED***", allowed: asciiAlphaNumeric},
+	{prefix: "ghs_", replacement: "ghs_***REDACTED***", allowed: asciiAlphaNumeric},
+	{prefix: "ghr_", replacement: "ghr_***REDACTED***", allowed: asciiAlphaNumeric},
+	{prefix: "Bearer ", replacement: "Bearer ***REDACTED***", allowed: func(value byte) bool { return asciiAlphaNumeric(value) || value == '.' || value == '_' || value == '-' }},
+}
+
+type redactingTailOutput struct {
+	target      tailOutput
+	pending     []byte
+	pattern     *streamSecretPattern
+	token       []byte
+	tokenLength int
+	redacted    bool
+}
+
+func (output *redactingTailOutput) emit(content []byte) {
+	_, _ = output.target.Write(content)
+}
+
+func (output *redactingTailOutput) consumeNormal(value byte) {
+	output.pending = append(output.pending, value)
+	for len(output.pending) > 0 {
+		possible := false
+		for index := range streamSecretPatterns {
+			pattern := &streamSecretPatterns[index]
+			if len(output.pending) <= len(pattern.prefix) && strings.EqualFold(string(output.pending), pattern.prefix[:len(output.pending)]) {
+				possible = true
+				if len(output.pending) == len(pattern.prefix) {
+					output.pattern = pattern
+					output.token = append(output.token[:0], output.pending...)
+					output.pending = output.pending[:0]
+					output.tokenLength, output.redacted = 0, false
+				}
+				break
+			}
+		}
+		if possible {
+			return
+		}
+		output.emit(output.pending[:1])
+		output.pending = output.pending[1:]
+	}
+}
+
+func (output *redactingTailOutput) consume(value byte) {
+	if output.pattern == nil {
+		output.consumeNormal(value)
+		return
+	}
+	if output.pattern.allowed(value) {
+		output.tokenLength++
+		if !output.redacted {
+			output.token = append(output.token, value)
+			if output.tokenLength >= 16 {
+				output.emit([]byte(output.pattern.replacement))
+				output.token = output.token[:0]
+				output.redacted = true
+			}
+		}
+		return
+	}
+	if !output.redacted {
+		output.emit(output.token)
+	}
+	output.pattern, output.token, output.tokenLength, output.redacted = nil, output.token[:0], 0, false
+	output.consumeNormal(value)
+}
+
+func (output *redactingTailOutput) Write(content []byte) (int, error) {
+	for _, value := range content {
+		output.consume(value)
+	}
+	return len(content), nil
+}
+
+func (output *redactingTailOutput) Flush() {
+	if output.pattern != nil && !output.redacted {
+		output.emit(output.token)
+	}
+	output.emit(output.pending)
+	output.pattern, output.token, output.pending = nil, nil, nil
+}
+
+type promptOmittingOutput struct {
+	target  *redactingTailOutput
+	prompt  []byte
+	prefix  []int
+	matched int
+}
+
+func newPromptOmittingOutput(target *redactingTailOutput, prompt string) *promptOmittingOutput {
+	output := &promptOmittingOutput{target: target, prompt: []byte(prompt), prefix: make([]int, len(prompt))}
+	for index, matched := 1, 0; index < len(output.prompt); index++ {
+		for matched > 0 && output.prompt[index] != output.prompt[matched] {
+			matched = output.prefix[matched-1]
+		}
+		if output.prompt[index] == output.prompt[matched] {
+			matched++
+		}
+		output.prefix[index] = matched
+	}
+	return output
+}
+
+func (output *promptOmittingOutput) consume(value byte) {
+	if len(output.prompt) == 0 {
+		output.target.consume(value)
+		return
+	}
+	for output.matched > 0 && value != output.prompt[output.matched] {
+		fallback := output.prefix[output.matched-1]
+		for _, pending := range output.prompt[:output.matched-fallback] {
+			output.target.consume(pending)
+		}
+		output.matched = fallback
+	}
+	if value == output.prompt[output.matched] {
+		output.matched++
+		if output.matched == len(output.prompt) {
+			for _, replacement := range []byte("[prompt omitted]") {
+				output.target.consume(replacement)
+			}
+			output.matched = 0
+		}
+		return
+	}
+	output.target.consume(value)
+}
+
+func (output *promptOmittingOutput) Write(content []byte) (int, error) {
+	for _, value := range content {
+		output.consume(value)
+	}
+	return len(content), nil
+}
+
+func (output *promptOmittingOutput) Flush() {
+	for _, pending := range output.prompt[:output.matched] {
+		output.target.consume(pending)
+	}
+	output.matched = 0
+	output.target.Flush()
+}
+
+func InvokeEngine(engine ResolvedEngine, prompt string, options InvokeOptions) (string, error) {
+	if options.Timeout <= 0 {
+		options.Timeout = 120000 * time.Millisecond
+	}
+	if options.MaxBuffer <= 0 {
+		options.MaxBuffer = 1024 * 1024
+	}
+	command := exec.Command(engine.Name, engine.Args(prompt)...)
+	prepareProcess(command)
+	command.Stdin = nil
+	stdout := &limitedOutput{limit: options.MaxBuffer, exceeded: make(chan struct{})}
+	// Redact before retaining the bounded tail so even a token larger than the
+	// tail cannot lose its prefix and expose an unrecognizable secret suffix.
+	secretStderr := &redactingTailOutput{target: tailOutput{limit: 64 * 1024}}
+	stderr := newPromptOmittingOutput(secretStderr, prompt)
+	command.Stdout, command.Stderr = stdout, stderr
+	command.WaitDelay = 2500 * time.Millisecond
+	failure := &EngineInvocationError{Engine: engine.Name, Bin: engine.Name, timeout: options.Timeout}
+	if err := command.Start(); err != nil {
+		failure.Reason = "spawn"
+		failure.Stderr = "Executable could not be started. Check PATH and executable permissions."
+		return "", failure
+	}
+	finished := make(chan error, 1)
+	go func() { finished <- command.Wait() }()
+	timer := time.NewTimer(options.Timeout)
+	defer timer.Stop()
+	var runError error
+	completed := false
+	select {
+	case runError = <-finished:
+		completed = true
+		select {
+		case <-stdout.exceeded:
+			failure.Reason = "maxbuffer"
+			failure.Killed = true
+		default:
+		}
+	case <-timer.C:
+		failure.Reason, failure.Killed = "timeout", true
+	case <-stdout.exceeded:
+		failure.Reason, failure.Killed = "maxbuffer", true
+	}
+	if failure.Killed && !completed {
+		terminateProcess(command, false)
+		grace := time.NewTimer(2 * time.Second)
+		select {
+		case runError = <-finished:
+		case <-grace.C:
+			terminateProcess(command, true)
+			runError = <-finished
+		}
+		grace.Stop()
+	}
+	stderr.Flush()
+	failure.Stderr = tail(RedactSecrets(string(secretStderr.target.content)), 4096)
+	if command.ProcessState != nil {
+		code := command.ProcessState.ExitCode()
+		if code >= 0 {
+			failure.Code = &code
+		}
+		failure.Signal = processSignal(command.ProcessState)
+	}
+	if failure.Reason != "" {
+		return "", failure
+	}
+	if runError != nil {
+		failure.Reason = "exit"
+		return "", failure
+	}
+	return strings.TrimSpace(stdout.buffer.String()), nil
+}
diff --git a/internal/ft/engine_linux_test.go b/internal/ft/engine_linux_test.go
new file mode 100644
index 0000000..951212b
--- /dev/null
+++ b/internal/ft/engine_linux_test.go
@@ -0,0 +1,89 @@
+package ft
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestTTYEngineChoicePersists(test *testing.T) {
+	isolated(test)
+	directory := test.TempDir()
+	for _, name := range []string{"claude", "codex"} {
+		if err := os.WriteFile(filepath.Join(directory, name), []byte("fixture"), 0700); err != nil {
+			test.Fatal(err)
+		}
+	}
+	master, err := os.OpenFile("/dev/ptmx", os.O_RDWR|unix.O_NOCTTY, 0600)
+	if err != nil {
+		test.Fatal(err)
+	}
+	defer master.Close()
+	if err := unix.IoctlSetPointerInt(int(master.Fd()), unix.TIOCSPTLCK, 0); err != nil {
+		test.Fatal(err)
+	}
+	terminal, err := unix.IoctlGetInt(int(master.Fd()), unix.TIOCGPTN)
+	if err != nil {
+		test.Fatal(err)
+	}
+	slave, err := os.OpenFile(fmt.Sprintf("/dev/pts/%d", terminal), os.O_RDWR|unix.O_NOCTTY, 0600)
+	if err != nil {
+		test.Fatal(err)
+	}
+	defer slave.Close()
+	binary, err := os.Executable()
+	if err != nil {
+		test.Fatal(err)
+	}
+	command := exec.Command(binary, "-test.run=^TestTTYEngineHelper$")
+	command.Env = append(os.Environ(), "FT_TTY_ENGINE_HELPER=1", "PATH="+directory)
+	command.Stdin = slave
+	var output, diagnostics bytes.Buffer
+	command.Stdout, command.Stderr = &output, &diagnostics
+	if err := command.Start(); err != nil {
+		test.Fatal(err)
+	}
+	if _, err := master.Write([]byte("n\ny\n")); err != nil {
+		command.Process.Kill()
+		test.Fatal(err)
+	}
+	finished := make(chan error, 1)
+	go func() { finished <- command.Wait() }()
+	select {
+	case err := <-finished:
+		if err != nil {
+			test.Fatal(output.String(), diagnostics.String(), err)
+		}
+	case <-time.After(5 * time.Second):
+		command.Process.Kill()
+		<-finished
+		test.Fatal("interactive engine selection did not complete")
+	}
+	if strings.TrimSpace(output.String()) != "codex" || LoadPreferences()["defaultEngine"] != "codex" {
+		test.Fatal(output.String(), diagnostics.String(), LoadPreferences())
+	}
+	claudePosition, codexPosition := strings.Index(diagnostics.String(), "Use claude"), strings.Index(diagnostics.String(), "Use codex")
+	if claudePosition < 0 || codexPosition <= claudePosition {
+		test.Fatal("wrong prompt preference order", diagnostics.String())
+	}
+}
+
+func TestTTYEngineHelper(test *testing.T) {
+	if os.Getenv("FT_TTY_ENGINE_HELPER") != "1" {
+		return
+	}
+	engine, err := ResolveEngine(EngineProfile{})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	fmt.Fprintln(os.Stdout, engine.Name)
+	os.Exit(0)
+}
diff --git a/internal/ft/engine_test.go b/internal/ft/engine_test.go
new file mode 100644
index 0000000..290a86e
--- /dev/null
+++ b/internal/ft/engine_test.go
@@ -0,0 +1,223 @@
+package ft
+
+import (
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+func shellEngine(test *testing.T, name, body string) string {
+	test.Helper()
+	if runtime.GOOS == "windows" {
+		test.Skip("POSIX shell fixture")
+	}
+	directory := test.TempDir()
+	path := filepath.Join(directory, name)
+	if err := os.WriteFile(path, []byte("#!/bin/sh\n"+body+"\n"), 0700); err != nil {
+		test.Fatal(err)
+	}
+	test.Setenv("PATH", directory+string(os.PathListSeparator)+os.Getenv("PATH"))
+	return path
+}
+
+func TestEngineArgumentsAndLabels(test *testing.T) {
+	cases := []struct {
+		engine   ResolvedEngine
+		expected []string
+		label    string
+	}{
+		{ResolvedEngine{Name: "claude"}, []string{"-p", "--output-format", "text", "PROMPT"}, "claude"},
+		{ResolvedEngine{Name: "claude", Model: "opus", Effort: "medium"}, []string{"-p", "--output-format", "text", "--model", "opus", "--effort", "medium", "PROMPT"}, "claude/opus/effort=medium"},
+		{ResolvedEngine{Name: "codex", Model: "model", Effort: "high"}, []string{"exec", "--skip-git-repo-check", "--model", "model", "--config", `model_reasoning_effort="high"`, "PROMPT"}, "codex/model/effort=high"},
+	}
+	for _, entry := range cases {
+		if actual := entry.engine.Args("PROMPT"); !reflect.DeepEqual(actual, entry.expected) {
+			test.Fatal(actual, entry.expected)
+		}
+		if entry.engine.Label() != entry.label {
+			test.Fatal(entry.engine.Label())
+		}
+	}
+}
+
+func TestEngineDetectionResolutionAndPreferences(test *testing.T) {
+	isolated(test)
+	directory := test.TempDir()
+	test.Setenv("PATH", directory)
+	if _, err := ResolveEngine(EngineProfile{Engine: "unknown"}); err == nil || !strings.Contains(err.Error(), "Unknown engine") {
+		test.Fatal(err)
+	}
+	if _, err := ResolveEngine(EngineProfile{Engine: "claude"}); err == nil || !strings.Contains(err.Error(), "not on PATH") {
+		test.Fatal(err)
+	}
+	if _, err := ResolveEngine(EngineProfile{}); err == nil {
+		test.Fatal("missing engines accepted")
+	}
+	for _, name := range []string{"claude", "codex"} {
+		if runtime.GOOS == "windows" {
+			name += ".EXE"
+		}
+		if err := os.WriteFile(filepath.Join(directory, name), []byte("#!/bin/sh\nexit 0\n"), 0700); err != nil {
+			test.Fatal(err)
+		}
+	}
+	if got := DetectEngines(); !reflect.DeepEqual(got, []string{"claude", "codex"}) {
+		test.Fatal(got)
+	}
+	if err := SavePreferences(map[string]any{"defaultEngine": "codex"}); err != nil {
+		test.Fatal(err)
+	}
+	engine, err := ResolveEngine(EngineProfile{Model: " model ", Effort: " high "})
+	if err != nil || engine.Label() != "codex/model/effort=high" {
+		test.Fatal(engine, err)
+	}
+	engine, err = ResolveEngine(EngineProfile{Override: "claude"})
+	if err != nil || engine.Name != "claude" {
+		test.Fatal(engine, err)
+	}
+	codexName := "codex"
+	if runtime.GOOS == "windows" {
+		codexName += ".EXE"
+	}
+	if err := os.Remove(filepath.Join(directory, codexName)); err != nil {
+		test.Fatal(err)
+	}
+	engine, err = ResolveEngine(EngineProfile{})
+	if err != nil || engine.Name != "claude" {
+		test.Fatal(engine, err)
+	}
+}
+
+func TestEnginePATHEXTDetection(test *testing.T) {
+	directory := test.TempDir()
+	if err := os.WriteFile(filepath.Join(directory, "claude.CMD"), []byte("fixture"), 0600); err != nil {
+		test.Fatal(err)
+	}
+	if !HasCommandOnPath("claude", map[string]string{"PATH": directory, "PATHEXT": ".EXE;.CMD"}, "win32") {
+		test.Fatal("PATHEXT ignored")
+	}
+	if HasCommandOnPath("claude", map[string]string{"PATH": directory, "PATHEXT": ".EXE"}, "win32") {
+		test.Fatal("unlisted extension accepted")
+	}
+}
+
+func TestEngineInvocationEOFTrimAndFailureRedaction(test *testing.T) {
+	shellEngine(test, "claude", `if IFS= read -r value; then echo 'stdin should have EOF' >&2; exit 8; fi
+printf '  trimmed answer\n'`)
+	answer, err := InvokeEngine(ResolvedEngine{Name: "claude"}, "private prompt", InvokeOptions{Timeout: time.Second})
+	if err != nil || answer != "trimmed answer" {
+		test.Fatal(answer, err)
+	}
+	shellEngine(test, "claude", `printf '%s\n' 'sk-abcdefghijklmnopqrstuv12345 ghp_abcdefghijklmnopqrstuv12345 Bearer abcdefghijklmnopqrstuv12345' >&2
+exit 7`)
+	_, err = InvokeEngine(ResolvedEngine{Name: "claude"}, "PRIVATE_PROMPT_MARKER", InvokeOptions{})
+	var failure *EngineInvocationError
+	if !errors.As(err, &failure) {
+		test.Fatalf("not structured: %T %v", err, err)
+	}
+	if failure.Reason != "exit" || failure.Killed || failure.Code == nil || *failure.Code != 7 {
+		test.Fatal(failure)
+	}
+	if strings.Contains(failure.Stderr, "abcdefghijkl") || strings.Contains(err.Error(), "PRIVATE_PROMPT_MARKER") || !strings.Contains(failure.Stderr, "REDACTED") {
+		test.Fatal(failure.Stderr, err)
+	}
+}
+
+func TestEngineInvocationTimeoutEscalationAndMaxbuffer(test *testing.T) {
+	shellEngine(test, "claude", `trap '' TERM
+while :; do sleep 1; done`)
+	start := time.Now()
+	_, err := InvokeEngine(ResolvedEngine{Name: "claude"}, "prompt", InvokeOptions{Timeout: 80 * time.Millisecond})
+	var failure *EngineInvocationError
+	if !errors.As(err, &failure) || failure.Reason != "timeout" || !failure.Killed {
+		test.Fatal(err)
+	}
+	if elapsed := time.Since(start); elapsed < 1900*time.Millisecond || elapsed > 5*time.Second {
+		test.Fatalf("incorrect escalation interval: %s", elapsed)
+	}
+	shellEngine(test, "claude", `while :; do printf '0123456789012345678901234567890123456789'; done`)
+	_, err = InvokeEngine(ResolvedEngine{Name: "claude"}, "prompt", InvokeOptions{Timeout: time.Second, MaxBuffer: 1024})
+	if !errors.As(err, &failure) || failure.Reason != "maxbuffer" || !failure.Killed {
+		test.Fatal(err)
+	}
+	shellEngine(test, "claude", "printf '%s' '"+strings.Repeat("x", 8192)+"'")
+	for attempt := 0; attempt < 5; attempt++ {
+		_, err = InvokeEngine(ResolvedEngine{Name: "claude"}, "prompt", InvokeOptions{Timeout: time.Second, MaxBuffer: 128})
+		if !errors.As(err, &failure) || failure.Reason != "maxbuffer" {
+			test.Fatal(err)
+		}
+	}
+}
+
+func TestEngineInvocationSpawnAndBoundedStderr(test *testing.T) {
+	_, err := InvokeEngine(ResolvedEngine{Name: "fieldtheory-missing-engine"}, "private prompt", InvokeOptions{})
+	var failure *EngineInvocationError
+	if !errors.As(err, &failure) || failure.Reason != "spawn" || failure.Code != nil {
+		test.Fatal(err)
+	}
+	shellEngine(test, "claude", "printf '%s\\n' '"+strings.Repeat("noise", 20000)+" final useful detail ghp_abcdefghijklmnopqrstuv' >&2\nexit 2")
+	_, err = InvokeEngine(ResolvedEngine{Name: "claude"}, "prompt", InvokeOptions{})
+	if !errors.As(err, &failure) || len(failure.Stderr) > 4100 || !strings.Contains(failure.Stderr, "final useful detail") || strings.Contains(failure.Stderr, "abcdefghijkl") {
+		test.Fatal(err)
+	}
+}
+
+func TestPromptAnswerAndClose(test *testing.T) {
+	answer := PromptText("Question: ", io.NopCloser(strings.NewReader("  trimmed answer \n")), io.Discard)
+	if answer.Kind != "answer" || answer.Value != "trimmed answer" {
+		test.Fatal(answer)
+	}
+	closed := PromptText("Question: ", io.NopCloser(strings.NewReader("")), io.Discard)
+	if closed.Kind != "close" {
+		test.Fatal(closed)
+	}
+	input := io.NopCloser(strings.NewReader("n\n y \n"))
+	first := PromptText("First: ", input, io.Discard)
+	second := PromptText("Second: ", input, io.Discard)
+	if first.Value != "n" || second.Value != "y" {
+		test.Fatal(first, second)
+	}
+}
+
+type promptReadyWriter struct{ ready chan struct{} }
+
+func (writer promptReadyWriter) Write(content []byte) (int, error) {
+	close(writer.ready)
+	return len(content), nil
+}
+
+func TestPromptInterruptClosesInput(test *testing.T) {
+	if runtime.GOOS == "windows" {
+		test.Skip("POSIX interrupt delivery")
+	}
+	reader, writer := io.Pipe()
+	defer reader.Close()
+	defer writer.Close()
+	ready, finished := make(chan struct{}), make(chan PromptResult, 1)
+	go func() { finished <- PromptText("Question: ", reader, promptReadyWriter{ready}) }()
+	<-ready
+	process, err := os.FindProcess(os.Getpid())
+	if err != nil {
+		test.Fatal(err)
+	}
+	if err := process.Signal(os.Interrupt); err != nil {
+		test.Fatal(err)
+	}
+	select {
+	case result := <-finished:
+		if result.Kind != "interrupt" {
+			test.Fatal(result)
+		}
+	case <-time.After(time.Second):
+		test.Fatal("SIGINT did not settle the prompt")
+	}
+	if _, err := writer.Write([]byte("late answer")); err == nil {
+		test.Fatal("SIGINT did not close prompt input")
+	}
+}
