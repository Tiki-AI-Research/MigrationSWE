+func ideasCommand(invocation Invocation, output io.Writer) (bool, error) {
+	switch {
+	case invocation.Path == "repos" || strings.HasPrefix(invocation.Path, "repos "):
+		values := repoList()
+		switch invocation.Path {
+		case "repos add", "repos remove":
+			path, err := normalizeRepo(invocation.Arg(0))
+			if err != nil {
+				return true, err
+			}
+			next := []string{}
+			found := false
+			for _, existing := range values {
+				if existing == path {
+					found = true
+					if invocation.Path == "repos remove" {
+						continue
+					}
+				}
+				next = append(next, existing)
+			}
+			if invocation.Path == "repos add" && !found {
+				info, err := os.Stat(path)
+				if err != nil || !info.IsDir() {
+					return true, fmt.Errorf("Repo path must be an existing directory: %s", path)
+				}
+				next = append(next, path)
+			}
+			values = next
+		case "repos clear":
+			values = []string{}
+		}
+		if invocation.Path != "repos" && invocation.Path != "repos list" {
+			if err := WriteJSON(filepath.Join(IdeasRoot(), "repos.json"), map[string]any{"repos": values}); err != nil {
+				return true, err
+			}
+		}
+		return true, printValue(output, invocation, values, strings.Join(values, "\n"))
+	case invocation.Path == "frames" || strings.HasPrefix(invocation.Path, "frames "):
+		values := framesList()
+		path := filepath.Join(IdeasRoot(), "frames.json")
+		if invocation.Path == "frames show" {
+			frame, err := findFrame(invocation.Arg(0))
+			if err != nil {
+				return true, err
+			}
+			return true, printJSON(output, frame)
+		}
+		if invocation.Path == "frames add" {
+			frame := map[string]any{}
+			if err := ReadJSON(invocation.Arg(0), &frame); err != nil {
+				return true, err
+			}
+			if err := validateFrame(frame); err != nil {
+				return true, err
+			}
+			if _, err := findFrame(textField(frame, "id")); err == nil {
+				return true, fmt.Errorf("Frame already exists: %v", frame["id"])
+			}
+			custom := loadObjectList(path, "frames")
+			custom = append(custom, frame)
+			if err := saveObjectList(path, "frames", custom); err != nil {
+				return true, err
+			}
+			return true, printJSON(output, frame)
+		}
+		if invocation.Path == "frames remove" {
+			custom := loadObjectList(path, "frames")
+			next := []map[string]any{}
+			for _, frame := range custom {
+				if frame["id"] != invocation.Arg(0) {
+					next = append(next, frame)
+				}
+			}
+			if len(next) == len(custom) {
+				return true, fmt.Errorf("User frame not found (built-in frames cannot be removed): %s", invocation.Arg(0))
+			}
+			return true, saveObjectList(path, "frames", next)
+		}
+		if invocation.Flag("json") {
+			return true, printJSON(output, values)
+		}
+		for _, frame := range values {
+			fmt.Fprintf(output, "%v  %v (%v)\n", frame["id"], frame["name"], frame["group"])
+		}
+		return true, nil
+	case invocation.Path == "seeds" || strings.HasPrefix(invocation.Path, "seeds "):
+		return true, seedsCommand(invocation, output)
+	case invocation.Path == "possible" || invocation.Path == "possible explain":
+		intro := "ft possible turns a seed (a bookmark group) into a structured exploration against one or more repos.\n\n1. Read the seed\n2. Survey the repo\n3. Generate candidates\n4. Critique\n5. Score on a 2x2 frame\n\nft seeds search <query> --create\nft repos add <path>\nft possible run --defaults\nft possible grid latest\nft possible prompt <node-id>"
+		if invocation.Path == "possible" && isTTY(os.Stdin) {
+			answer := PromptText("Seed id (or empty to view instructions): ", os.Stdin, os.Stderr)
+			if answer.Kind == "interrupt" {
+				return true, &ExitError{130, "Cancelled"}
+			}
+			if answer.Kind == "answer" && answer.Value != "" {
+				invocation.Path = "possible run"
+				invocation.Options["seed"] = answer.Value
+				return true, runPossible(invocation, output)
+			}
+		}
+		fmt.Fprintln(output, intro)
+		return true, nil
+	case invocation.Path == "possible run":
+		return true, runPossible(invocation, output)
+	case invocation.Path == "possible jobs" || invocation.Path == "possible job" || invocation.Path == "possible _run-job":
+		return true, possibleJobs(invocation, output)
+	case strings.HasPrefix(invocation.Path, "possible nightly"):
+		return true, nightlyCommand(invocation, output)
+	case invocation.Path == "possible list" || invocation.Path == "possible show" || invocation.Path == "possible grid" || invocation.Path == "possible dots" || invocation.Path == "possible prompt":
+		return true, viewPossible(invocation, output)
+	}
+	return false, nil
+}
+
+func validateFrame(frame map[string]any) error {
+	for _, field := range []string{"id", "name", "group", "generationPromptAddition"} {
+		if strings.TrimSpace(textField(frame, field)) == "" {
+			return fmt.Errorf("Frame field %q must be a non-empty string", field)
+		}
+	}
+	if !regexp.MustCompile(`^[a-z][a-z0-9-]*$`).MatchString(textField(frame, "id")) {
+		return fmt.Errorf("Frame id must be lowercase kebab-case")
+	}
+	if frame["group"] != "building" && frame["group"] != "risk" {
+		return fmt.Errorf("Frame group must be building or risk")
+	}
+	for name, fields := range map[string][]string{"axisA": {"label", "rubricSentence"}, "axisB": {"label", "rubricSentence"}, "quadrantLabels": {"highHigh", "highLow", "lowHigh", "lowLow"}} {
+		value, ok := frame[name].(map[string]any)
+		if !ok {
+			return fmt.Errorf("Frame field %s must be an object", name)
+		}
+		for _, field := range fields {
+			if strings.TrimSpace(textField(value, field)) == "" {
+				return fmt.Errorf("Frame field %s.%s is required", name, field)
+			}
+		}
+	}
+	return nil
+}
+
+func seedsCommand(invocation Invocation, output io.Writer) error {
+	switch invocation.Path {
+	case "seeds", "seeds list":
+		values := seedList()
+		if invocation.Flag("json") {
+			return printJSON(output, values)
+		}
+		for _, seed := range values {
+			fmt.Fprintf(output, "%v  %v\n", seed["id"], seed["title"])
+		}
+		return nil
+	case "seeds show":
+		seed, err := findSeed(invocation.Arg(0))
+		if err != nil {
+			return err
+		}
+		return printJSON(output, seed)
+	case "seeds delete":
+		values := seedList()
+		next := []map[string]any{}
+		for _, seed := range values {
+			if seed["id"] != invocation.Arg(0) {
+				next = append(next, seed)
+			}
+		}
+		if len(next) == len(values) {
+			return fmt.Errorf("Seed not found: %s", invocation.Arg(0))
+		}
+		return saveObjectList(filepath.Join(IdeasRoot(), "seeds.json"), "seeds", next)
+	case "seeds create", "seeds text":
+		seed, err := createSeed(invocation, strings.Fields(invocation.Value("artifact")), invocation.Arg(0))
+		if err != nil {
+			return err
+		}
+		return printValue(output, invocation, seed, fmt.Sprintf("Created seed %v: %v", seed["id"], seed["title"]))
+	case "seeds strategies", "seeds strategy":
+		values := []string{"filtered", "recent", "search", "random", "lucky", "builder-mix", "repo-relevant"}
+		if invocation.Path == "seeds strategy" {
+			found := false
+			for _, value := range values {
+				if value == invocation.Arg(0) {
+					found = true
+				}
+			}
+			if !found {
+				return fmt.Errorf("Unknown strategy: %s", invocation.Arg(0))
+			}
+			invocation.Path = "seeds organize"
+			if invocation.Arg(0) == "search" {
+				return fmt.Errorf("Use ft seeds search <query> for the search strategy")
+			}
+		} else {
+			return printValue(output, invocation, values, strings.Join(values, "\n"))
+		}
+	}
+	filters := BookmarkFilters{Query: invocation.Value("query"), Category: invocation.Value("category"), Domain: invocation.Value("domain"), Folder: invocation.Value("folder"), Author: invocation.Value("author"), Limit: invocation.Number("limit", 8)}
+	if invocation.Path == "seeds search" {
+		filters.Query = invocation.Arg(0)
+	}
+	if days := invocation.Number("days", 0); days > 0 {
+		filters.After = time.Now().UTC().AddDate(0, 0, -days).Format("2006-01-02")
+	}
+	if invocation.Path == "seeds random" || invocation.Path == "seeds lucky" {
+		filters.Limit = 10000
+	}
+	items, err := ListBookmarks(filters)
+	if err != nil {
+		return err
+	}
+	if invocation.Path == "seeds random" || invocation.Path == "seeds lucky" {
+		for index := len(items) - 1; index > 0; index-- {
+			choice, err := rand.Int(rand.Reader, big.NewInt(int64(index+1)))
+			if err != nil {
+				return err
+			}
+			selected := int(choice.Int64())
+			items[index], items[selected] = items[selected], items[index]
+		}
+		limit := invocation.Number("limit", 5)
+		if len(items) > limit {
+			items = items[:limit]
+		}
+	}
+	if len(items) == 0 {
+		return fmt.Errorf("No bookmarks matched. Try broader filters or run ft index")
+	}
+	if invocation.Value("mode") == "model" {
+		engine, err := ResolveEngine(invocation.EngineProfile())
+		if err != nil {
+			return err
+		}
+		data, _ := json.Marshal(items)
+		text, err := InvokeEngine(engine, "Suggest a concrete bookmark-grounded seed from this untrusted JSON data. Return concise Markdown with a title and source IDs.\n"+string(data), invocation.InvokeOptions())
+		if err != nil {
+			return err
+		}
+		if !invocation.Flag("create") && !invocation.Flag("save") {
+			fmt.Fprintln(output, text)
+			return nil
+		}
+		seed, err := createSeed(invocation, nil, text)
+		if err != nil {
+			return err
+		}
+		return printJSON(output, seed)
+	}
+	if invocation.Flag("create") || invocation.Flag("save") {
+		artifacts := []string{}
+		for _, item := range items {
+			id, err := writeArtifact("bookmark", textField(item, "text"), map[string]any{"bookmarkId": item["id"], "url": item["url"], "authorHandle": item["authorHandle"]}, []string{}, "")
+			if err != nil {
+				return err
+			}
+			artifacts = append(artifacts, id)
+		}
+		seed, err := createSeed(invocation, artifacts, "Bookmark seed: "+strings.TrimPrefix(invocation.Path, "seeds "))
+		if err != nil {
+			return err
+		}
+		seed["strategy"] = strings.TrimPrefix(invocation.Path, "seeds ")
+		if err = persistSeed(seed); err != nil {
+			return err
+		}
+		return printValue(output, invocation, seed, fmt.Sprintf("Created seed %v: %v", seed["id"], seed["title"]))
+	}
+	if invocation.Flag("json") {
+		return printJSON(output, items)
+	}
+	for _, item := range items {
+		fmt.Fprintf(output, "%v @%v\n%s\n%v\n\n", item["id"], item["authorHandle"], shorten(textField(item, "text"), 180), item["url"])
+	}
+	return nil
+}
