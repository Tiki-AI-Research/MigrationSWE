diff --git a/internal/paths/paths.go b/internal/paths/paths.go
new file mode 100644
index 0000000..ac1f4f6
--- /dev/null
+++ b/internal/paths/paths.go
@@ -0,0 +1,185 @@
+package paths
+
+import (
+	"os"
+	"path/filepath"
+)
+
+func homeDir() string {
+	if h, err := os.UserHomeDir(); err == nil && h != "" {
+		return h
+	}
+	if h := os.Getenv("HOME"); h != "" {
+		return h
+	}
+	return ""
+}
+
+func envSet(key string) (string, bool) {
+	v, ok := os.LookupEnv(key)
+	if !ok || v == "" {
+		return "", false
+	}
+	return v, true
+}
+
+func exists(p string) bool {
+	_, err := os.Stat(p)
+	return err == nil
+}
+
+// DataDir mirrors paths.ts dataDir().
+func DataDir() string {
+	if v, ok := envSet("FT_DATA_DIR"); ok {
+		return v
+	}
+	canonical := filepath.Join(homeDir(), ".fieldtheory", "bookmarks")
+	legacy := filepath.Join(homeDir(), ".ft-bookmarks")
+	if exists(canonical) || !exists(legacy) {
+		return canonical
+	}
+	return legacy
+}
+
+// FieldTheoryDir returns ~/.fieldtheory.
+func FieldTheoryDir() string {
+	return filepath.Join(homeDir(), ".fieldtheory")
+}
+
+// LegacyDataDir returns ~/.ft-bookmarks.
+func LegacyDataDir() string {
+	return filepath.Join(homeDir(), ".ft-bookmarks")
+}
+
+// CanonicalDataDir mirrors paths.ts canonicalDataDir().
+func CanonicalDataDir() string {
+	if v, ok := envSet("FT_DATA_DIR"); ok {
+		return v
+	}
+	return filepath.Join(FieldTheoryDir(), "bookmarks")
+}
+
+// CanonicalLibraryDir mirrors paths.ts canonicalLibraryDir().
+func CanonicalLibraryDir() string {
+	if v, ok := envSet("FT_LIBRARY_DIR"); ok {
+		return v
+	}
+	return filepath.Join(FieldTheoryDir(), "library")
+}
+
+// CanonicalCommandsDir mirrors paths.ts canonicalCommandsDir().
+func CanonicalCommandsDir() string {
+	if v, ok := envSet("FT_COMMANDS_DIR"); ok {
+		return v
+	}
+	return filepath.Join(CanonicalLibraryDir(), "Commands")
+}
+
+// LibraryDir mirrors paths.ts libraryDir().
+func LibraryDir() string {
+	if v, ok := envSet("FT_LIBRARY_DIR"); ok {
+		return v
+	}
+	if v, ok := envSet("FT_DATA_DIR"); ok {
+		return filepath.Join(v, "md")
+	}
+	canonical := filepath.Join(homeDir(), ".fieldtheory", "library")
+	legacy := filepath.Join(homeDir(), ".ft-bookmarks", "md")
+	if exists(canonical) || !exists(legacy) {
+		return canonical
+	}
+	return legacy
+}
+
+// CommandsDir mirrors paths.ts commandsDir(). The canonical branch uses
+// CanonicalLibraryDir() (not LibraryDir()): setting only FT_DATA_DIR leaves
+// commands at ~/.fieldtheory/library/Commands while library resolves to
+// <FT_DATA_DIR>/md.
+func CommandsDir() string {
+	if v, ok := envSet("FT_COMMANDS_DIR"); ok {
+		return v
+	}
+	canonical := filepath.Join(CanonicalLibraryDir(), "Commands")
+	if _, ok := envSet("FT_LIBRARY_DIR"); ok {
+		return canonical
+	}
+	legacy := filepath.Join(FieldTheoryDir(), "commands")
+	if exists(canonical) || !exists(legacy) {
+		return canonical
+	}
+	return legacy
+}
+
+// FieldTheoryRoot mirrors paths.ts fieldTheoryRoot().
+func FieldTheoryRoot() string {
+	if v, ok := envSet("FT_DATA_DIR"); ok {
+		return v
+	}
+	return FieldTheoryDir()
+}
+
+// CodexContextSessionsDir mirrors paths.ts codexContextSessionsDir().
+func CodexContextSessionsDir() string {
+	return filepath.Join(CanonicalLibraryDir(), "Codex Context", "sessions")
+}
+
+// EnsureDataDir ensures the data dir exists (0700) and returns it.
+func EnsureDataDir() string {
+	dir := DataDir()
+	ensureDirSync(dir)
+	return dir
+}
+
+func ensureDirSync(dir string) {
+	_ = os.MkdirAll(dir, 0o700)
+}
+
+// CachePath is <dataDir>/bookmarks.jsonl.
+func CachePath() string {
+	return filepath.Join(DataDir(), "bookmarks.jsonl")
+}
+
+// MetaPath is <dataDir>/bookmarks-meta.json.
+func MetaPath() string {
+	return filepath.Join(DataDir(), "bookmarks-meta.json")
+}
+
+// IndexPath is <dataDir>/bookmarks.db.
+func IndexPath() string {
+	return filepath.Join(DataDir(), "bookmarks.db")
+}
+
+// PreferencesPath is <dataDir>/.preferences.
+func PreferencesPath() string {
+	return filepath.Join(DataDir(), ".preferences")
+}
+
+// MediaDir is <dataDir>/media.
+func MediaDir() string {
+	return filepath.Join(DataDir(), "media")
+}
+
+// MediaManifestPath is <dataDir>/media-manifest.json.
+func MediaManifestPath() string {
+	return filepath.Join(DataDir(), "media-manifest.json")
+}
+
+// IsFirstRun reports whether the JSONL cache is absent.
+func IsFirstRun() bool {
+	return !exists(CachePath())
+}
+
+// IdeasRoot is <fieldTheoryRoot>/ideas.
+func IdeasRoot() string {
+	return filepath.Join(FieldTheoryRoot(), "ideas")
+}
+
+// LegacyIdeasRoot is <dataDir>/automation/ideas.
+func LegacyIdeasRoot() string {
+	return filepath.Join(DataDir(), "automation", "ideas")
+}
+
+// LegacyAdjacentRoot is <dataDir>/automation/adjacent.
+func LegacyAdjacentRoot() string {
+	return filepath.Join(DataDir(), "automation", "adjacent")
+}
