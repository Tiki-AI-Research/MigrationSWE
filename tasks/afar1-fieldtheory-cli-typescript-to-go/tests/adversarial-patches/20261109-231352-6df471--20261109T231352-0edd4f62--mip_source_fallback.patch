+package dateutil
+
+import (
+	"strings"
+	"time"
+)
+
+var weekdays = []string{"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"}
+
+var layouts = []string{
+	time.RFC3339Nano,
+	time.RFC3339,
+	"2006-01-02T15:04:05.999-0700",
+	"2006-01-02T15:04:05-0700",
+	"2006-01-02T15:04:05.999Z07:00",
+	"2006-01-02T15:04:05Z07:00",
+	"2006-01-02T15:04:05.999",
+	"2006-01-02T15:04:05",
+	"2006-01-02 15:04:05",
+	"2006-01-02",
+	"Jan 2, 2006",
+	"January 2, 2006",
+	"Mon, 02 Jan 2006 15:04:05 MST",
+}
+
+// ParseTimestampMs parses a timestamp with the formats the existing cache
+// contains, returning milliseconds since epoch in UTC or ok=false.
+func ParseTimestampMs(value *string) (int64, bool) {
+	if value == nil {
+		return 0, false
+	}
+	v := strings.TrimSpace(*value)
+	if v == "" {
+		return 0, false
+	}
+	for _, layout := range layouts {
+		if t, err := time.Parse(layout, v); err == nil {
+			return t.UTC().UnixNano() / int64(time.Millisecond), true
+		}
+	}
+	// RFC1123 style with numeric zone e.g. +0000
+	if t, err := time.Parse(time.RFC1123Z, v); err == nil {
+		return t.UTC().UnixNano() / int64(time.Millisecond), true
+	}
+	if t, err := time.Parse(time.RFC1123, v); err == nil {
+		return t.UTC().UnixNano() / int64(time.Millisecond), true
+	}
+	return 0, false
+}
+
+// ToIsoDate returns YYYY-MM-DD in UTC or nil.
+func ToIsoDate(value *string) *string {
+	ms, ok := ParseTimestampMs(value)
+	if !ok {
+		return nil
+	}
+	s := msToUTC(ms).Format("2006-01-02")
+	return &s
+}
+
+// ToIsoMonth returns YYYY-MM in UTC or nil.
+func ToIsoMonth(value *string) *string {
+	ms, ok := ParseTimestampMs(value)
+	if !ok {
+		return nil
+	}
+	s := msToUTC(ms).Format("2006-01")
+	return &s
+}
+
+// ToWeekdayShort returns the three-letter weekday in UTC or nil.
+func ToWeekdayShort(value *string) *string {
+	ms, ok := ParseTimestampMs(value)
+	if !ok {
+		return nil
+	}
+	idx := int(msToUTC(ms).Weekday())
+	if idx < 0 || idx >= len(weekdays) {
+		return nil
+	}
+	s := weekdays[idx]
+	return &s
+}
+
+// ToUtcHour returns the UTC hour or nil.
+func ToUtcHour(value *string) *int {
+	ms, ok := ParseTimestampMs(value)
+	if !ok {
+		return nil
+	}
+	h := msToUTC(ms).Hour()
+	return &h
+}
+
+// ToYearLabel returns the UTC year, or the last four characters of the raw
+// value, or "????" when unparseable.
+func ToYearLabel(value *string) string {
+	ms, ok := ParseTimestampMs(value)
+	if !ok {
+		if value == nil {
+			return "????"
+		}
+		return sliceFromEnd(*value, 4, "????")
+	}
+	return msToUTC(ms).Format("2006")
+}
+
+// ToMonthDayLabel returns e.g. "Jan 02" in UTC, or the raw value's slice(4,10),
+// or " ?? ??" when unparseable.
+func ToMonthDayLabel(value *string) string {
+	ms, ok := ParseTimestampMs(value)
+	if !ok {
+		if value == nil {
+			return " ?? ??"
+		}
+		return sliceRange(*value, 4, 10, " ?? ??")
+	}
+	return msToUTC(ms).Format("Jan 02")
+}
+
+func msToUTC(ms int64) time.Time {
+	return time.UnixMilli(ms).UTC()
+}
+
+func sliceFromEnd(s string, n int, fallback string) string {
+	if len(s) == 0 {
+		return fallback
+	}
+	if len(s) <= n {
+		return s
+	}
+	return s[len(s)-n:]
+}
+
+func sliceRange(s string, start, end int, fallback string) string {
+	if start >= len(s) {
+		return fallback
+	}
+	if end > len(s) {
+		end = len(s)
+	}
+	return s[start:end]
+}
diff --git a/internal/docops/docops.go b/internal/docops/docops.go
new file mode 100644
index 0000000..8e25361
--- /dev/null
+++ b/internal/docops/docops.go
@@ -0,0 +1,316 @@
+package docops
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+
+	"fieldtheory/internal/fsutil"
+)
+
+// DocumentVersion mirrors document-ops.ts DocumentVersion.
+type DocumentVersion struct {
+	MtimeMs int64  `json:"mtimeMs"`
+	Size    int64  `json:"size"`
+	Sha256  string `json:"sha256"`
+}
+
+// UpdateResult mirrors DocumentUpdateResult.
+type UpdateResult struct {
+	Path    string          `json:"path"`
+	Version DocumentVersion `json:"version"`
+}
+
+// TrashedDocument mirrors TrashedDocument.
+type TrashedDocument struct {
+	OriginalPath string `json:"originalPath"`
+	TrashPath    string `json:"trashPath"`
+}
+
+// Sha256 returns the hex digest of a string.
+func Sha256(value string) string {
+	sum := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(sum[:])
+}
+
+// IsPathInside reports whether childPath is inside parentPath.
+func IsPathInside(parentPath, childPath string) bool {
+	rel, err := filepath.Rel(parentPath, childPath)
+	if err != nil {
+		return false
+	}
+	if rel == "" || rel == "." {
+		return true
+	}
+	if rel == ".." || strings.HasPrefix(rel, ".."+string(os.PathSeparator)) || filepath.IsAbs(rel) {
+		return false
+	}
+	return true
+}
+
+var extRe = regexp.MustCompile(`(?i)\.(md|markdown)$`)
+
+// NormalizeMarkdownFileName mirrors normalizeMarkdownFileName.
+func NormalizeMarkdownFileName(name string, rejectLeadingUnderscore bool) string {
+	trimmed := strings.TrimSpace(name)
+	if trimmed == "" || strings.Contains(trimmed, "\x00") || strings.ContainsAny(trimmed, `/\`) {
+		return ""
+	}
+	withoutExt := strings.TrimSpace(extRe.ReplaceAllString(trimmed, ""))
+	if withoutExt == "" || withoutExt == "." || withoutExt == ".." || strings.HasPrefix(withoutExt, ".") {
+		return ""
+	}
+	if rejectLeadingUnderscore && strings.HasPrefix(withoutExt, "_") {
+		return ""
+	}
+	fileName := trimmed
+	if !extRe.MatchString(trimmed) {
+		fileName = trimmed + ".md"
+	}
+	if filepath.Base(fileName) != fileName {
+		return ""
+	}
+	return fileName
+}
+
+// NormalizeMarkdownRelPath mirrors normalizeMarkdownRelPath.
+func NormalizeMarkdownRelPath(input string, rejectHiddenSegments bool) string {
+	trimmed := strings.TrimSpace(input)
+	if trimmed == "" || strings.Contains(trimmed, "\x00") || filepath.IsAbs(trimmed) {
+		return ""
+	}
+	var parts []string
+	for _, part := range regexp.MustCompile(`[\\/]+`).Split(trimmed, -1) {
+		p := strings.TrimSpace(part)
+		if p != "" {
+			parts = append(parts, p)
+		}
+	}
+	if len(parts) == 0 {
+		return ""
+	}
+	for _, part := range parts {
+		if part == "." || part == ".." || strings.HasPrefix(part, ".") {
+			return ""
+		}
+	}
+	if rejectHiddenSegments {
+		for _, part := range parts {
+			if strings.HasPrefix(part, "_") {
+				return ""
+			}
+		}
+	}
+	last := parts[len(parts)-1]
+	if !extRe.MatchString(last) {
+		parts[len(parts)-1] = last + ".md"
+	}
+	return strings.Join(parts, "/")
+}
+
+// ResolveMarkdownPath mirrors resolveMarkdownPath.
+func ResolveMarkdownPath(rootDir, target string) string {
+	root, err := filepath.Abs(rootDir)
+	if err != nil {
+		return ""
+	}
+	raw := strings.TrimSpace(target)
+	if raw == "" || strings.Contains(raw, "\x00") {
+		return ""
+	}
+	var candidate string
+	if filepath.IsAbs(raw) {
+		candidate, _ = filepath.Abs(raw)
+	} else {
+		rel := NormalizeMarkdownRelPath(raw, false)
+		candidate, _ = filepath.Abs(filepath.Join(root, rel))
+	}
+	if !IsPathInside(root, candidate) {
+		return ""
+	}
+	if !extRe.MatchString(filepath.Base(candidate)) {
+		return ""
+	}
+	return candidate
+}
+
+// RelativeMarkdownPath mirrors relativeMarkdownPath.
+func RelativeMarkdownPath(rootDir, filePath string) string {
+	rel, err := filepath.Rel(rootDir, filePath)
+	if err != nil {
+		return filePath
+	}
+	return strings.ReplaceAll(rel, string(os.PathSeparator), "/")
+}
+
+// ReadDocumentVersion mirrors readDocumentVersion.
+func ReadDocumentVersion(filePath string) (DocumentVersion, error) {
+	content, err := os.ReadFile(filePath)
+	if err != nil {
+		return DocumentVersion{}, err
+	}
+	info, err := os.Stat(filePath)
+	if err != nil {
+		return DocumentVersion{}, err
+	}
+	return DocumentVersion{
+		MtimeMs: info.ModTime().UnixMilli(),
+		Size:    info.Size(),
+		Sha256:  Sha256(string(content)),
+	}, nil
+}
+
+// ReadStdin reads all of stdin.
+func ReadStdin() (string, error) {
+	b, err := io.ReadAll(os.Stdin)
+	if err != nil {
+		return "", err
+	}
+	return string(b), nil
+}
+
+// ContentInput mirrors the readContentInput options.
+type ContentInput struct {
+	Stdin    bool
+	File     string
+	Fallback string
+}
+
+// ReadContentInput mirrors readContentInput.
+func ReadContentInput(options ContentInput) (string, error) {
+	if options.Stdin && options.File != "" {
+		return "", fmt.Errorf("--stdin and --file cannot be used together.")
+	}
+	if options.Stdin {
+		return ReadStdin()
+	}
+	if options.File != "" {
+		b, err := os.ReadFile(options.File)
+		if err != nil {
+			return "", err
+		}
+		return string(b), nil
+	}
+	return options.Fallback, nil
+}
+
+// CreateMarkdownFile mirrors createMarkdownFile.
+func CreateMarkdownFile(filePath, content string) (UpdateResult, error) {
+	if fsutil.PathExists(filePath) {
+		return UpdateResult{}, fmt.Errorf("File already exists: %s", filePath)
+	}
+	if err := fsutil.WriteMd(filePath, content); err != nil {
+		return UpdateResult{}, err
+	}
+	v, err := ReadDocumentVersion(filePath)
+	if err != nil {
+		return UpdateResult{}, err
+	}
+	return UpdateResult{Path: filePath, Version: v}, nil
+}
+
+// UpdateOptions mirrors DocumentUpdateOptions.
+type UpdateOptions struct {
+	ExpectedSha256 string
+	Force          bool
+	AllowEmpty     bool
+}
+
+// UpdateMarkdownFile mirrors updateMarkdownFile.
+func UpdateMarkdownFile(filePath, content string, options UpdateOptions) (UpdateResult, error) {
+	if !fsutil.PathExists(filePath) {
+		return UpdateResult{}, fmt.Errorf("File not found: %s", filePath)
+	}
+	if len(content) == 0 && !options.AllowEmpty {
+		return UpdateResult{}, fmt.Errorf("Refusing to overwrite with empty content. Pipe the complete document content to stdin, or pass --allow-empty to intentionally clear it.")
+	}
+	current, err := ReadDocumentVersion(filePath)
+	if err != nil {
+		return UpdateResult{}, err
+	}
+	if options.ExpectedSha256 != "" && current.Sha256 != options.ExpectedSha256 {
+		return UpdateResult{}, fmt.Errorf("File changed on disk. Expected %s, found %s. To continue editing safely, run ft current --json, merge the requested change into the returned content, then run ft current update --stdin --expected-sha256 %s. Use the sha256 printed after each successful update for the next edit.", options.ExpectedSha256, current.Sha256, current.Sha256)
+	}
+	if !options.Force && options.ExpectedSha256 == "" {
+		return UpdateResult{}, fmt.Errorf("Refusing to overwrite without --expected-sha256 or --force.")
+	}
+	if err := fsutil.WriteMd(filePath, content); err != nil {
+		return UpdateResult{}, err
+	}
+	v, err := ReadDocumentVersion(filePath)
+	if err != nil {
+		return UpdateResult{}, err
+	}
+	return UpdateResult{Path: filePath, Version: v}, nil
+}
+
+// RenameMarkdownFile mirrors renameMarkdownFile.
+func RenameMarkdownFile(oldPath, newPath string) (UpdateResult, error) {
+	if !fsutil.PathExists(oldPath) {
+		return UpdateResult{}, fmt.Errorf("File not found: %s", oldPath)
+	}
+	if fsutil.PathExists(newPath) {
+		return UpdateResult{}, fmt.Errorf("Target already exists: %s", newPath)
+	}
+	if err := fsutil.EnsureDir(filepath.Dir(newPath)); err != nil {
+		return UpdateResult{}, err
+	}
+	if err := os.Rename(oldPath, newPath); err != nil {
+		return UpdateResult{}, err
+	}
+	v, err := ReadDocumentVersion(newPath)
+	if err != nil {
+		return UpdateResult{}, err
+	}
+	return UpdateResult{Path: newPath, Version: v}, nil
+}
+
+// MoveToTrash mirrors moveToTrash.
+func MoveToTrash(filePath string) (TrashedDocument, error) {
+	if !fsutil.PathExists(filePath) {
+		return TrashedDocument{}, fmt.Errorf("File not found: %s", filePath)
+	}
+	info, err := os.Stat(filePath)
+	if err != nil {
+		return TrashedDocument{}, err
+	}
+	if info.IsDir() {
+		return TrashedDocument{}, fmt.Errorf("Not a file: %s", filePath)
+	}
+	home, _ := os.UserHomeDir()
+	trashDir := filepath.Join(home, ".Trash")
+	if err := os.MkdirAll(trashDir, 0o700); err != nil {
+		return TrashedDocument{}, err
+	}
+	trashPath := filepath.Join(trashDir, filepath.Base(filePath))
+	if fsutil.PathExists(trashPath) {
+		ext := filepath.Ext(filePath)
+		name := strings.TrimSuffix(filepath.Base(filePath), ext)
+		trashPath = filepath.Join(trashDir, fmt.Sprintf("%s %d%s", name, nowMillis(), ext))
+	}
+	if err := os.Rename(filePath, trashPath); err != nil {
+		return TrashedDocument{}, err
+	}
+	return TrashedDocument{OriginalPath: filePath, TrashPath: trashPath}, nil
+}
+
+func nowMillis() int64 { return time.Now().UnixMilli() }
+
+// ReadMarkdownDocument mirrors readMarkdownDocument.
+func ReadMarkdownDocument(filePath string) (string, DocumentVersion, error) {
+	content, err := fsutil.ReadMd(filePath)
+	if err != nil {
+		return "", DocumentVersion{}, err
+	}
+	v, err := ReadDocumentVersion(filePath)
+	if err != nil {
+		return "", DocumentVersion{}, err
+	}
+	return content, v, nil
+}
diff --git a/internal/engine/engine.go b/internal/engine/engine.go
new file mode 100644
index 0000000..5ae2b63
--- /dev/null
+++ b/internal/engine/engine.go
@@ -0,0 +1,572 @@
+package engine
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"runtime"
+	"strings"
+	"syscall"
+	"time"
+
+	"fieldtheory/internal/preferences"
+	"fieldtheory/internal/prompt"
+)
+
+// EngineConfig describes an engine binary and argument builder.
+type EngineConfig struct {
+	Bin  string
+	Args func(prompt string, model, effort string) []string
+}
+
+// KnownEngines mirrors engine.ts KNOWN_ENGINES.
+var KnownEngines = map[string]EngineConfig{
+	"claude": {
+		Bin: "claude",
+		Args: func(p string, model, effort string) []string {
+			args := []string{"-p", "--output-format", "text"}
+			if model != "" {
+				args = append(args, "--model", model)
+			}
+			if effort != "" {
+				args = append(args, "--effort", effort)
+			}
+			return append(args, p)
+		},
+	},
+	"codex": {
+		Bin: "codex",
+		Args: func(p string, model, effort string) []string {
+			args := []string{"exec", "--skip-git-repo-check"}
+			if model != "" {
+				args = append(args, "--model", model)
+			}
+			if effort != "" {
+				args = append(args, "--config", fmt.Sprintf("model_reasoning_effort=%q", effort))
+			}
+			return append(args, p)
+		},
+	},
+}
+
+// PreferenceOrder is the auto-detection order.
+var PreferenceOrder = []string{"claude", "codex"}
+
+// HasCommandOnPath mirrors hasCommandOnPath.
+func HasCommandOnPath(bin string, env map[string]string, platform string) bool {
+	if env == nil {
+		env = map[string]string{"PATH": os.Getenv("PATH"), "PATHEXT": os.Getenv("PATHEXT")}
+	}
+	searchPath := env["PATH"]
+	pathDirs := []string{}
+	for _, d := range strings.Split(searchPath, string(os.PathListSeparator)) {
+		if d != "" {
+			pathDirs = append(pathDirs, d)
+		}
+	}
+	pathext := []string{}
+	rawExt := env["PATHEXT"]
+	if rawExt == "" {
+		rawExt = ".EXE;.CMD;.BAT;.COM"
+	}
+	for _, e := range strings.Split(rawExt, ";") {
+		e = strings.TrimSpace(e)
+		if e != "" {
+			pathext = append(pathext, e)
+		}
+	}
+
+	hasSeparator := strings.ContainsAny(bin, `/\`)
+	var baseCandidates []string
+	if hasSeparator {
+		baseCandidates = []string{bin}
+	} else {
+		for _, dir := range pathDirs {
+			baseCandidates = append(baseCandidates, filepath.Join(dir, bin))
+		}
+	}
+
+	var candidates []string
+	if platform == "windows" {
+		for _, c := range baseCandidates {
+			if filepath.Ext(c) != "" {
+				candidates = append(candidates, c)
+				continue
+			}
+			for _, ext := range pathext {
+				candidates = append(candidates, c+ext)
+			}
+		}
+	} else {
+		candidates = baseCandidates
+	}
+
+	for _, c := range candidates {
+		info, err := os.Stat(c)
+		if err != nil {
+			continue
+		}
+		if platform == "windows" {
+			if !info.IsDir() {
+				return true
+			}
+		} else if info.Mode()&0o111 != 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func currentPlatform() string {
+	switch runtime.GOOS {
+	case "windows":
+		return "windows"
+	case "darwin":
+		return "darwin"
+	default:
+		return runtime.GOOS
+	}
+}
+
+// DetectAvailableEngines mirrors detectAvailableEngines.
+func DetectAvailableEngines() []string {
+	out := []string{}
+	for _, name := range PreferenceOrder {
+		if HasCommandOnPath(KnownEngines[name].Bin, nil, currentPlatform()) {
+			out = append(out, name)
+		}
+	}
+	return out
+}
+
+// ResolvedEngine mirrors engine.ts ResolvedEngine.
+type ResolvedEngine struct {
+	Name   string
+	Config EngineConfig
+	Model  string
+	Effort string
+	Label  string
+}
+
+// Args returns the argv for the given prompt.
+func (e ResolvedEngine) Args(p string) []string {
+	return e.Config.Args(p, cleanOptional(e.Model), cleanOptional(e.Effort))
+}
+
+// EngineRunProfile mirrors EngineRunProfile.
+type EngineRunProfile struct {
+	Engine   string
+	Override string
+	Model    string
+	Effort   string
+}
+
+func cleanOptional(v string) string {
+	return strings.TrimSpace(v)
+}
+
+func formatEngineLabel(name, model, effort string) string {
+	parts := []string{name}
+	if m := cleanOptional(model); m != "" {
+		parts = append(parts, m)
+	}
+	if e := cleanOptional(effort); e != "" {
+		parts = append(parts, "effort="+e)
+	}
+	return strings.Join(parts, "/")
+}
+
+func resolve(name string, profile EngineRunProfile) ResolvedEngine {
+	model := cleanOptional(profile.Model)
+	effort := cleanOptional(profile.Effort)
+	return ResolvedEngine{
+		Name:   name,
+		Config: KnownEngines[name],
+		Model:  model,
+		Effort: effort,
+		Label:  formatEngineLabel(name, model, effort),
+	}
+}
+
+// DescribeEngine mirrors describeEngine.
+func DescribeEngine(name, model, effort string) string {
+	return formatEngineLabel(name, model, effort)
+}
+
+func stdinIsTTY() bool {
+	info, err := os.Stdin.Stat()
+	if err != nil {
+		return false
+	}
+	return info.Mode()&os.ModeCharDevice != 0
+}
+
+// ResolveEngine mirrors resolveEngine.
+func ResolveEngine(profile EngineRunProfile) (ResolvedEngine, error) {
+	requested := cleanOptional(profile.Engine)
+	if requested == "" {
+		requested = cleanOptional(profile.Override)
+	}
+
+	if requested != "" {
+		if _, ok := KnownEngines[requested]; !ok {
+			known := strings.Join(knownEngineNames(), ", ")
+			return ResolvedEngine{}, fmt.Errorf("Unknown engine %q. Known engines: %s.", requested, known)
+		}
+		if !HasCommandOnPath(KnownEngines[requested].Bin, nil, currentPlatform()) {
+			avail := DetectAvailableEngines()
+			hint := ""
+			if len(avail) > 0 {
+				hint = fmt.Sprintf(" Available on PATH: %s.", strings.Join(avail, ", "))
+			}
+			return ResolvedEngine{}, fmt.Errorf("Engine %q is not on PATH.%s\nInstall it and log in, or pick a different engine.", requested, hint)
+		}
+		return resolve(requested, profile), nil
+	}
+
+	available := DetectAvailableEngines()
+	if len(available) == 0 {
+		return ResolvedEngine{}, fmt.Errorf("No supported LLM CLI found.\nInstall one of the following and log in:\n  - Claude Code: https://docs.anthropic.com/en/docs/claude-code\n  - Codex CLI:   https://github.com/openai/codex")
+	}
+
+	prefs := preferences.LoadPreferences()
+	if prefs.DefaultEngine != "" && contains(available, prefs.DefaultEngine) {
+		return resolve(prefs.DefaultEngine, profile), nil
+	}
+
+	if len(available) == 1 {
+		return resolve(available[0], profile), nil
+	}
+
+	if !stdinIsTTY() {
+		return resolve(available[0], profile), nil
+	}
+
+	for _, name := range available {
+		yes, err := askYesNo(fmt.Sprintf("  Use %s for classification? (y/n): ", name))
+		if err != nil {
+			return ResolvedEngine{}, err
+		}
+		if yes {
+			prefs.DefaultEngine = name
+			_ = preferences.SavePreferences(prefs)
+			fmt.Fprintf(os.Stderr, "  ✓ %s set as default (change anytime: ft model)\n", name)
+			return resolve(name, profile), nil
+		}
+	}
+
+	fmt.Fprintf(os.Stderr, "  Using %s (no default saved)\n", available[0])
+	return resolve(available[0], profile), nil
+}
+
+func askYesNo(question string) (bool, error) {
+	result := prompt.PromptText(question)
+	switch result.Kind {
+	case prompt.KindInterrupt:
+		return false, &prompt.CancelledError{
+			Message:  "Cancelled — no engine selected. Pick one with `ft model <engine>`, or pass `--engine claude` / `--engine codex`.",
+			ExitCode: 130,
+		}
+	case prompt.KindClose:
+		return false, &prompt.CancelledError{
+			Message:  "No engine selected. Pick one with `ft model <engine>`, or pass `--engine claude` / `--engine codex`.",
+			ExitCode: 0,
+		}
+	}
+	return strings.HasPrefix(strings.ToLower(result.Value), "y"), nil
+}
+
+func knownEngineNames() []string {
+	return []string{"claude", "codex"}
+}
+
+func contains(values []string, v string) bool {
+	for _, x := range values {
+		if x == v {
+			return true
+		}
+	}
+	return false
+}
+
+// Invocation error reasons.
+const (
+	ReasonTimeout = "timeout"
+	ReasonMaxBuf  = "maxbuffer"
+	ReasonExit    = "exit"
+	ReasonSpawn   = "spawn"
+)
+
+const (
+	DefaultTimeout  = 120000
+	DefaultMaxBuf   = 1024 * 1024
+	stderrTailBytes = 4096
+	stderrHardCap   = 64 * 1024
+	sigkillGraceMS  = 2000
+)
+
+// EngineInvocationError mirrors engine.ts EngineInvocationError.
+type EngineInvocationError struct {
+	Engine  string
+	Bin     string
+	Stderr  string
+	Killed  bool
+	Code    *int
+	Signal  string
+	Reason  string
+	Message string
+}
+
+func (e *EngineInvocationError) Error() string { return e.Message }
+
+func tailString(buf []byte, n int) string {
+	if len(buf) <= n {
+		return string(buf)
+	}
+	return "\u2026" + string(buf[len(buf)-n:])
+}
+
+var (
+	skRe     = regexp.MustCompile(`\bsk-[A-Za-z0-9_-]{16,}`)
+	ghRe     = regexp.MustCompile(`\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{16,}`)
+	bearerRe = regexp.MustCompile(`(?i)\bBearer\s+[A-Za-z0-9._-]{16,}`)
+)
+
+// RedactSecrets mirrors redactSecrets.
+func RedactSecrets(s string) string {
+	s = skRe.ReplaceAllString(s, "sk-***REDACTED***")
+	s = ghRe.ReplaceAllString(s, "$1_***REDACTED***")
+	s = bearerRe.ReplaceAllString(s, "Bearer ***REDACTED***")
+	return s
+}
+
+func buildMessage(engineName, reason, stderr string, code *int, signal string, timeoutMs int) string {
+	snippet := strings.TrimSpace(stderr)
+	if len(snippet) > 500 {
+		snippet = snippet[len(snippet)-500:]
+	}
+	detail := ""
+	if snippet != "" {
+		detail = " \u2014 " + snippet
+	}
+	switch reason {
+	case ReasonTimeout:
+		var duration string
+		if timeoutMs < 1000 {
+			duration = fmt.Sprintf("%dms", timeoutMs)
+		} else {
+			duration = fmt.Sprintf("%ds", int(float64(timeoutMs)/1000+0.5))
+		}
+		return fmt.Sprintf("%s timed out after %s%s", engineName, duration, detail)
+	case ReasonMaxBuf:
+		return fmt.Sprintf("%s output exceeded buffer cap%s", engineName, detail)
+	case ReasonSpawn:
+		return fmt.Sprintf("%s failed to start%s", engineName, detail)
+	default:
+		signalPart := ""
+		if signal != "" {
+			signalPart = fmt.Sprintf(" (signal %s)", signal)
+		}
+		codePart := ""
+		if code != nil {
+			codePart = fmt.Sprintf(" exit %d", *code)
+		}
+		return fmt.Sprintf("%s failed%s%s%s", engineName, codePart, signalPart, detail)
+	}
+}
+
+func readCapped(r io.Reader, limit int) (data []byte, over bool) {
+	buf := make([]byte, 32*1024)
+	var out bytes.Buffer
+	total := 0
+	for {
+		n, err := r.Read(buf)
+		if n > 0 {
+			total += n
+			if out.Len() < limit {
+				remaining := limit - out.Len()
+				if n <= remaining {
+					out.Write(buf[:n])
+				} else {
+					out.Write(buf[:remaining])
+				}
+			}
+		}
+		if err != nil {
+			break
+		}
+	}
+	return out.Bytes(), total > limit
+}
+
+func readTail(r io.Reader, capBytes int) []byte {
+	buf := make([]byte, 32*1024)
+	var out bytes.Buffer
+	for {
+		n, err := r.Read(buf)
+		if n > 0 {
+			out.Write(buf[:n])
+			if out.Len() > capBytes {
+				b := out.Bytes()
+				trimmed := make([]byte, capBytes)
+				copy(trimmed, b[len(b)-capBytes:])
+				out.Reset()
+				out.Write(trimmed)
+			}
+		}
+		if err != nil {
+			break
+		}
+	}
+	return out.Bytes()
+}
+
+// InvokeOptions mirrors engine.ts InvokeOptions.
+type InvokeOptions struct {
+	TimeoutMS int
+	MaxBuffer int
+}
+
+// InvokeEngine runs the engine synchronously with stdin closed (EOF), a
+// timeout, and a stdout buffer cap, mirroring invokeEngine/invokeEngineAsync.
+func InvokeEngine(e ResolvedEngine, promptText string, opts InvokeOptions) (string, error) {
+	timeout := opts.TimeoutMS
+	if timeout <= 0 {
+		timeout = DefaultTimeout
+	}
+	maxBuffer := opts.MaxBuffer
+	if maxBuffer <= 0 {
+		maxBuffer = DefaultMaxBuf
+	}
+	bin := e.Config.Bin
+
+	cmd := exec.Command(bin, e.Args(promptText)...)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		return "", spawnError(e, bin, err, timeout)
+	}
+	// Own the output descriptors instead of using cmd.StdoutPipe()/
+	// cmd.StderrPipe(): Wait closes the parent ends of the pipes it owns,
+	// which races the readers below and can capture an empty stream.
+	stdout, stdoutW, err := os.Pipe()
+	if err != nil {
+		return "", spawnError(e, bin, err, timeout)
+	}
+	stderr, stderrW, err := os.Pipe()
+	if err != nil {
+		return "", spawnError(e, bin, err, timeout)
+	}
+	cmd.Stdout = stdoutW
+	cmd.Stderr = stderrW
+	if err := cmd.Start(); err != nil {
+		return "", spawnError(e, bin, err, timeout)
+	}
+	_ = stdin.Close()
+	// Drop the parent write ends so the readers observe EOF once the child
+	// (and any process it spawned) closes its own copies.
+	_ = stdoutW.Close()
+	_ = stderrW.Close()
+
+	stdoutCh := make(chan struct {
+		data []byte
+		over bool
+	}, 1)
+	stderrCh := make(chan []byte, 1)
+	go func() {
+		d, over := readCapped(stdout, maxBuffer)
+		stdoutCh <- struct {
+			data []byte
+			over bool
+		}{d, over}
+	}()
+	go func() { stderrCh <- readTail(stderr, stderrHardCap) }()
+
+	waitCh := make(chan error, 1)
+	go func() { waitCh <- cmd.Wait() }()
+
+	timer := time.NewTimer(time.Duration(timeout) * time.Millisecond)
+	defer timer.Stop()
+
+	timedOut := false
+	select {
+	case <-timer.C:
+		timedOut = true
+		killChild(cmd)
+		<-waitCh
+		// A killed child may leave a descendant holding the write end;
+		// close our read ends so the readers cannot block on it.
+		_ = stdout.Close()
+		_ = stderr.Close()
+	case <-waitCh:
+	}
+
+	outRes := <-stdoutCh
+	stderrBytes := <-stderrCh
+	_ = stdout.Close()
+	_ = stderr.Close()
+	stderrTail := RedactSecrets(tailString(stderrBytes, stderrTailBytes))
+
+	if timedOut {
+		sig := "SIGTERM"
+		return "", &EngineInvocationError{
+			Engine: e.Name, Bin: bin, Stderr: stderrTail,
+			Killed: true, Code: nil, Signal: sig, Reason: ReasonTimeout,
+			Message: buildMessage(e.Name, ReasonTimeout, stderrTail, nil, sig, timeout),
+		}
+	}
+	if outRes.over {
+		return "", &EngineInvocationError{
+			Engine: e.Name, Bin: bin, Stderr: stderrTail,
+			Killed: true, Code: nil, Signal: "", Reason: ReasonMaxBuf,
+			Message: buildMessage(e.Name, ReasonMaxBuf, stderrTail, nil, "", timeout),
+		}
+	}
+
+	code := cmd.ProcessState.ExitCode()
+	var codePtr *int
+	if code >= 0 {
+		codePtr = &code
+	}
+	signalName := ""
+	if ws, ok := cmd.ProcessState.Sys().(syscall.WaitStatus); ok && ws.Signaled() {
+		signalName = ws.Signal().String()
+	}
+
+	if code != 0 {
+		return "", &EngineInvocationError{
+			Engine: e.Name, Bin: bin, Stderr: stderrTail,
+			Killed: false, Code: codePtr, Signal: signalName, Reason: ReasonExit,
+			Message: buildMessage(e.Name, ReasonExit, stderrTail, codePtr, signalName, timeout),
+		}
+	}
+	return strings.TrimSpace(string(outRes.data)), nil
+}
+
+func killChild(cmd *exec.Cmd) {
+	if cmd.Process == nil {
+		return
+	}
+	_ = cmd.Process.Signal(syscall.SIGTERM)
+	go func() {
+		time.Sleep(time.Duration(sigkillGraceMS) * time.Millisecond)
+		_ = cmd.Process.Kill()
+	}()
+}
+
+func spawnError(e ResolvedEngine, bin string, err error, timeout int) error {
+	return &EngineInvocationError{
+		Engine: e.Name, Bin: bin, Stderr: "",
+		Killed: false, Code: nil, Signal: "", Reason: ReasonSpawn,
+		Message: buildMessage(e.Name, ReasonSpawn, err.Error(), nil, "", timeout),
+	}
+}
+
+// InvokeEngineAsync is provided for interface parity; it is implemented
+// synchronously over the same code path.
+func InvokeEngineAsync(e ResolvedEngine, p string, opts InvokeOptions) (string, error) {
+	return InvokeEngine(e, p, opts)
+}
diff --git a/internal/engine/engine_test.go b/internal/engine/engine_test.go
new file mode 100644
index 0000000..9feb3d8
--- /dev/null
+++ b/internal/engine/engine_test.go
@@ -0,0 +1,138 @@
+package engine
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func writeScript(t *testing.T, body string) string {
+	t.Helper()
+	dir := t.TempDir()
+	p := filepath.Join(dir, "fake-engine")
+	script := "#!/bin/sh\n" + body + "\n"
+	if err := os.WriteFile(p, []byte(script), 0o755); err != nil {
+		t.Fatalf("write script: %v", err)
+	}
+	return p
+}
+
+func resolvedFor(bin string) ResolvedEngine {
+	return ResolvedEngine{
+		Name: "fake",
+		Config: EngineConfig{
+			Bin: bin,
+			Args: func(p string, model, effort string) []string {
+				return []string{p}
+			},
+		},
+		Label: "fake",
+	}
+}
+
+func TestInvokeEngineClosesStdinAndTrimsStdout(t *testing.T) {
+	bin := writeScript(t, `cat >/dev/null
+printf '  hello world  \n'`)
+	e := resolvedFor(bin)
+
+	done := make(chan struct{})
+	var out string
+	var err error
+	go func() {
+		out, err = InvokeEngine(e, "prompt", InvokeOptions{TimeoutMS: 5000})
+		close(done)
+	}()
+
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("InvokeEngine blocked: stdin was not closed")
+	}
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if out != "hello world" {
+		t.Fatalf("expected trimmed stdout %q, got %q", "hello world", out)
+	}
+}
+
+func TestInvokeEngineExitReason(t *testing.T) {
+	bin := writeScript(t, `echo "boom" >&2
+exit 3`)
+	e := resolvedFor(bin)
+
+	_, err := InvokeEngine(e, "prompt", InvokeOptions{TimeoutMS: 5000})
+	var ie *EngineInvocationError
+	if !errors.As(err, &ie) {
+		t.Fatalf("expected EngineInvocationError, got %v", err)
+	}
+	if ie.Reason != ReasonExit {
+		t.Fatalf("expected reason %q, got %q", ReasonExit, ie.Reason)
+	}
+	if ie.Code == nil || *ie.Code != 3 {
+		t.Fatalf("expected exit code 3, got %v", ie.Code)
+	}
+}
+
+func TestInvokeEngineTimeoutReason(t *testing.T) {
+	bin := writeScript(t, `sleep 5`)
+	e := resolvedFor(bin)
+
+	start := time.Now()
+	_, err := InvokeEngine(e, "prompt", InvokeOptions{TimeoutMS: 200})
+	if elapsed := time.Since(start); elapsed > 4*time.Second {
+		t.Fatalf("timeout not enforced, took %s", elapsed)
+	}
+	var ie *EngineInvocationError
+	if !errors.As(err, &ie) {
+		t.Fatalf("expected EngineInvocationError, got %v", err)
+	}
+	if ie.Reason != ReasonTimeout {
+		t.Fatalf("expected reason %q, got %q", ReasonTimeout, ie.Reason)
+	}
+	if !ie.Killed {
+		t.Fatalf("expected Killed=true on timeout")
+	}
+}
+
+func TestInvokeEngineMaxBufferReason(t *testing.T) {
+	bin := writeScript(t, `head -c 200000 /dev/zero | tr '\0' 'a'`)
+	e := resolvedFor(bin)
+
+	_, err := InvokeEngine(e, "prompt", InvokeOptions{TimeoutMS: 5000, MaxBuffer: 1024})
+	var ie *EngineInvocationError
+	if !errors.As(err, &ie) {
+		t.Fatalf("expected EngineInvocationError, got %v", err)
+	}
+	if ie.Reason != ReasonMaxBuf {
+		t.Fatalf("expected reason %q, got %q", ReasonMaxBuf, ie.Reason)
+	}
+}
+
+func TestInvokeEngineRedactsSecrets(t *testing.T) {
+	bin := writeScript(t, `echo "token sk-ABCDEFGHIJKLMNOPQRSTUVWX" >&2
+echo "auth ghp_ABCDEFGHIJKLMNOPQRSTUV" >&2
+exit 1`)
+	e := resolvedFor(bin)
+
+	_, err := InvokeEngine(e, "prompt", InvokeOptions{TimeoutMS: 5000})
+	var ie *EngineInvocationError
+	if !errors.As(err, &ie) {
+		t.Fatalf("expected EngineInvocationError, got %v", err)
+	}
+	if strings.Contains(ie.Stderr, "sk-ABCDEFGHIJKLMNOPQRSTUVWX") {
+		t.Fatalf("provider key not redacted: %q", ie.Stderr)
+	}
+	if strings.Contains(ie.Stderr, "ghp_ABCDEFGHIJKLMNOPQRSTUV") {
+		t.Fatalf("github token not redacted: %q", ie.Stderr)
+	}
+	if !strings.Contains(ie.Stderr, "REDACTED") {
+		t.Fatalf("expected redaction marker, got %q", ie.Stderr)
+	}
+	if strings.Contains(ie.Message, "sk-ABCDEFGHIJKLMNOPQRSTUVWX") {
+		t.Fatalf("message leaked secret: %q", ie.Message)
+	}
+}
diff --git a/internal/fsutil/fs.go b/internal/fsutil/fs.go
new file mode 100644
index 0000000..a513fee
--- /dev/null
+++ b/internal/fsutil/fs.go
@@ -0,0 +1,209 @@
+package fsutil
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// EnsureDir creates a directory (recursively).
+func EnsureDir(dir string) error {
+	return os.MkdirAll(dir, 0o700)
+}
+
+// PathExists reports whether a path exists.
+func PathExists(p string) bool {
+	_, err := os.Stat(p)
+	return err == nil
+}
+
+// ListFiles returns directory entries, or an empty slice on error.
+func ListFiles(dir string) []string {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return []string{}
+	}
+	out := make([]string, 0, len(entries))
+	for _, e := range entries {
+		out = append(out, e.Name())
+	}
+	return out
+}
+
+func marshalIndent(v any) ([]byte, error) {
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	enc.SetIndent("", "  ")
+	if err := enc.Encode(v); err != nil {
+		return nil, err
+	}
+	return bytes.TrimRight(buf.Bytes(), "\n"), nil
+}
+
+func marshalCompact(v any) ([]byte, error) {
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	if err := enc.Encode(v); err != nil {
+		return nil, err
+	}
+	return bytes.TrimRight(buf.Bytes(), "\n"), nil
+}
+
+// WriteFileDurable writes content atomically and durably: temp file -> fsync
+// file -> rename -> fsync parent dir.
+func WriteFileDurable(filePath, content string, mode os.FileMode) error {
+	tmp := filePath + ".tmp"
+	f, err := os.OpenFile(tmp, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)
+	if err != nil {
+		return err
+	}
+	if _, err := f.WriteString(content); err != nil {
+		f.Close()
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		f.Close()
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(tmp, filePath); err != nil {
+		return err
+	}
+	syncParent(filePath)
+	return nil
+}
+
+func syncParent(filePath string) {
+	parent := filepath.Dir(filePath)
+	d, err := os.Open(parent)
+	if err != nil {
+		return
+	}
+	defer d.Close()
+	_ = d.Sync()
+}
+
+// WriteJSON writes value as pretty JSON with 0600 (unless overridden).
+func WriteJSON(filePath string, value any, mode ...os.FileMode) error {
+	m := os.FileMode(0o600)
+	if len(mode) > 0 {
+		m = mode[0]
+	}
+	b, err := marshalIndent(value)
+	if err != nil {
+		return err
+	}
+	return WriteFileDurable(filePath, string(b), m)
+}
+
+// ReadJSON reads and parses a JSON file into out.
+func ReadJSON(filePath string, out any) error {
+	raw, err := os.ReadFile(filePath)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(raw, out)
+}
+
+// WriteJSONLines writes one compact JSON record per line with 0600.
+func WriteJSONLines(filePath string, rows []any, mode ...os.FileMode) error {
+	m := os.FileMode(0o600)
+	if len(mode) > 0 {
+		m = mode[0]
+	}
+	var sb strings.Builder
+	for _, row := range rows {
+		b, err := marshalCompact(row)
+		if err != nil {
+			return err
+		}
+		sb.Write(b)
+		sb.WriteByte('\n')
+	}
+	return WriteFileDurable(filePath, sb.String(), m)
+}
+
+// ReadJSONLines reads a JSONL file; a missing or malformed file yields an
+// empty list (matching fs.ts readJsonLines).
+func ReadJSONLines[T any](filePath string) []T {
+	out := []T{}
+	raw, err := os.ReadFile(filePath)
+	if err != nil {
+		return out
+	}
+	lines := strings.Split(string(raw), "\n")
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" {
+			continue
+		}
+		var v T
+		if err := json.Unmarshal([]byte(trimmed), &v); err != nil {
+			return []T{}
+		}
+		out = append(out, v)
+	}
+	return out
+}
+
+// ReadJSONLinesRaw returns the parsed JSON values without forcing a concrete type.
+func ReadJSONLinesRaw(filePath string) ([]map[string]any, error) {
+	raw, err := os.ReadFile(filePath)
+	if err != nil {
+		return nil, err
+	}
+	out := []map[string]any{}
+	for _, line := range strings.Split(string(raw), "\n") {
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" {
+			continue
+		}
+		var v map[string]any
+		if err := json.Unmarshal([]byte(trimmed), &v); err != nil {
+			return nil, err
+		}
+		out = append(out, v)
+	}
+	return out, nil
+}
+
+// WriteMd writes markdown content with 0644.
+func WriteMd(filePath, content string) error {
+	if err := os.MkdirAll(filepath.Dir(filePath), 0o700); err != nil {
+		return err
+	}
+	return WriteFileDurable(filePath, content, 0o644)
+}
+
+// ReadMd reads a markdown file as UTF-8 text.
+func ReadMd(filePath string) (string, error) {
+	b, err := os.ReadFile(filePath)
+	if err != nil {
+		return "", err
+	}
+	return string(b), nil
+}
+
+// AppendLine appends a line (ensuring a trailing newline).
+func AppendLine(filePath, line string) error {
+	if err := os.MkdirAll(filepath.Dir(filePath), 0o700); err != nil {
+		return err
+	}
+	nl := line
+	if !strings.HasSuffix(nl, "\n") {
+		nl += "\n"
+	}
+	f, err := os.OpenFile(filePath, os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0o600)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	_, err = f.WriteString(nl)
+	return err
+}
diff --git a/internal/ideas/migrate.go b/internal/ideas/migrate.go
new file mode 100644
index 0000000..5f09ce3
--- /dev/null
+++ b/internal/ideas/migrate.go
@@ -0,0 +1,189 @@
+package ideas
+
+import (
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"fieldtheory/internal/paths"
+)
+
+const (
+	completeMarker = ".migrated-from-ft-bookmarks"
+	beginMarker    = ".migration-in-progress"
+)
+
+// MigrationResult mirrors paths.ts IdeasMigrationResult.
+type MigrationResult struct {
+	Migrated           bool
+	LegacyIdeasRoot    string
+	LegacyAdjacentRoot string
+	NewRoot            string
+	Reason             string
+}
+
+func exists(p string) bool {
+	_, err := os.Stat(p)
+	return err == nil
+}
+
+func safeReadDir(dir string) []string {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return []string{}
+	}
+	names := make([]string, 0, len(entries))
+	for _, e := range entries {
+		names = append(names, e.Name())
+	}
+	sort.Strings(names)
+	return names
+}
+
+func copyRecursive(src, dst string) error {
+	info, err := os.Stat(src)
+	if err != nil {
+		return err
+	}
+	if info.IsDir() {
+		if err := os.MkdirAll(dst, 0o700); err != nil {
+			return err
+		}
+		entries, err := os.ReadDir(src)
+		if err != nil {
+			return err
+		}
+		for _, e := range entries {
+			if err := copyRecursive(filepath.Join(src, e.Name()), filepath.Join(dst, e.Name())); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := os.MkdirAll(filepath.Dir(dst), 0o700); err != nil {
+		return err
+	}
+	in, err := os.Open(src)
+	if err != nil {
+		return err
+	}
+	defer in.Close()
+	out, err := os.OpenFile(dst, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, info.Mode().Perm())
+	if err != nil {
+		return err
+	}
+	defer out.Close()
+	_, err = io.Copy(out, in)
+	return err
+}
+
+func writeMarker(path string, payload map[string]any) error {
+	b, err := json.MarshalIndent(payload, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(path, b, 0o600)
+}
+
+func nowISO() string { return time.Now().UTC().Format("2006-01-02T15:04:05.000Z") }
+
+// MigrateLegacyIdeasData mirrors paths.ts migrateLegacyIdeasData.
+func MigrateLegacyIdeasData() MigrationResult {
+	newRoot := paths.IdeasRoot()
+	legacyIdeas := paths.LegacyIdeasRoot()
+	legacyAdjacent := paths.LegacyAdjacentRoot()
+
+	result := MigrationResult{
+		Migrated:           false,
+		LegacyIdeasRoot:    legacyIdeas,
+		LegacyAdjacentRoot: legacyAdjacent,
+		NewRoot:            newRoot,
+	}
+
+	if exists(filepath.Join(newRoot, completeMarker)) {
+		result.Reason = "already-migrated"
+		return result
+	}
+
+	recoveringFromPartial := false
+	if exists(filepath.Join(newRoot, beginMarker)) {
+		_ = os.RemoveAll(newRoot)
+		recoveringFromPartial = true
+	}
+
+	if !recoveringFromPartial && exists(newRoot) {
+		contents := []string{}
+		for _, name := range safeReadDir(newRoot) {
+			if !strings.HasPrefix(name, ".") {
+				contents = append(contents, name)
+			}
+		}
+		if len(contents) > 0 {
+			result.Reason = "already-migrated"
+			return result
+		}
+	}
+
+	legacyIdeasExists := exists(legacyIdeas)
+	legacyAdjacentExists := exists(legacyAdjacent)
+	if !legacyIdeasExists && !legacyAdjacentExists {
+		result.Reason = "nothing-to-migrate"
+		return result
+	}
+
+	resolvedLegacy, _ := filepath.Abs(legacyIdeas)
+	resolvedNew, _ := filepath.Abs(newRoot)
+	if resolvedLegacy == resolvedNew {
+		result.Reason = "legacy-equals-new"
+		return result
+	}
+
+	if err := os.MkdirAll(newRoot, 0o700); err != nil {
+		result.Reason = "nothing-to-migrate"
+		return result
+	}
+	_ = writeMarker(filepath.Join(newRoot, beginMarker), map[string]any{
+		"startedAt":      nowISO(),
+		"legacyIdeas":    legacyIdeas,
+		"legacyAdjacent": legacyAdjacent,
+	})
+
+	if legacyIdeasExists {
+		for _, entry := range safeReadDir(legacyIdeas) {
+			src := filepath.Join(legacyIdeas, entry)
+			dst := filepath.Join(newRoot, entry)
+			if err := copyRecursive(src, dst); err != nil {
+				return result
+			}
+		}
+	}
+
+	if legacyAdjacentExists {
+		dstAdjacent := filepath.Join(newRoot, "adjacent")
+		_ = os.MkdirAll(dstAdjacent, 0o700)
+		for _, entry := range safeReadDir(legacyAdjacent) {
+			src := filepath.Join(legacyAdjacent, entry)
+			dst := filepath.Join(dstAdjacent, entry)
+			if err := copyRecursive(src, dst); err != nil {
+				return result
+			}
+		}
+	}
+
+	_ = writeMarker(filepath.Join(newRoot, completeMarker), map[string]any{
+		"migratedAt":     nowISO(),
+		"legacyIdeas":    legacyIdeas,
+		"legacyAdjacent": legacyAdjacent,
+	})
+	_ = os.Remove(filepath.Join(newRoot, beginMarker))
+
+	result.Migrated = true
+	if recoveringFromPartial {
+		result.Reason = "recovered-partial"
+	}
+	return result
+}
diff --git a/internal/library/library.go b/internal/library/library.go
new file mode 100644
index 0000000..0604e68
--- /dev/null
+++ b/internal/library/library.go
@@ -0,0 +1,388 @@
+package library
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"fieldtheory/internal/docops"
+	"fieldtheory/internal/paths"
+)
+
+// DocumentSummary mirrors LibraryDocumentSummary.
+type DocumentSummary struct {
+	Path      string `json:"path"`
+	RelPath   string `json:"relPath"`
+	Title     string `json:"title"`
+	UpdatedAt string `json:"updatedAt"`
+	Size      int64  `json:"size"`
+}
+
+// SearchResult mirrors LibrarySearchResult.
+type SearchResult struct {
+	DocumentSummary
+	Snippet string `json:"snippet"`
+}
+
+// Document mirrors LibraryDocument.
+type Document struct {
+	DocumentSummary
+	Content string                 `json:"content"`
+	Version docops.DocumentVersion `json:"version"`
+}
+
+// WriteInput mirrors LibraryWriteInput.
+type WriteInput struct {
+	Stdin   bool
+	File    string
+	Content *string
+	Title   string
+}
+
+// UpdateInput mirrors LibraryUpdateInput.
+type UpdateInput struct {
+	WriteInput
+	ExpectedSha256 string
+	Force          bool
+	AllowEmpty     bool
+}
+
+// ListOptions mirrors LibraryListOptions.
+type ListOptions struct {
+	Limit                  int
+	IncludeRelPathPrefixes []string
+	ExcludeDirs            []string
+	IncludeInternal        bool
+}
+
+func libraryRoot() string { return paths.CanonicalLibraryDir() }
+
+func titleFromContent(filePath, content string) string {
+	for _, line := range strings.Split(content, "\n") {
+		if strings.HasPrefix(line, "# ") {
+			return strings.TrimSpace(strings.TrimPrefix(line, "# "))
+		}
+	}
+	base := filepath.Base(filePath)
+	return strings.TrimSuffix(base, filepath.Ext(base))
+}
+
+func summaryForFile(filePath, content string) DocumentSummary {
+	if content == "" {
+		if b, err := os.ReadFile(filePath); err == nil {
+			content = string(b)
+		}
+	}
+	info, _ := os.Stat(filePath)
+	var size int64
+	var mod time.Time
+	if info != nil {
+		size = info.Size()
+		mod = info.ModTime()
+	}
+	return DocumentSummary{
+		Path:      filePath,
+		RelPath:   docops.RelativeMarkdownPath(libraryRoot(), filePath),
+		Title:     titleFromContent(filePath, content),
+		UpdatedAt: mod.UTC().Format("2006-01-02T15:04:05.000Z"),
+		Size:      size,
+	}
+}
+
+func normalizedRelPathPrefix(prefix string) string {
+	p := strings.ReplaceAll(prefix, "\\", "/")
+	return strings.TrimLeft(p, "/")
+}
+
+func excludedDirsFor(options ListOptions) []string {
+	explicit := options.ExcludeDirs
+	if options.IncludeInternal {
+		return explicit
+	}
+	return append([]string{paths.CodexContextSessionsDir()}, explicit...)
+}
+
+func shouldSkipDir(dirPath string, excludedDirs []string) bool {
+	resolved, _ := filepath.Abs(dirPath)
+	for _, excludedDir := range excludedDirs {
+		excluded, _ := filepath.Abs(excludedDir)
+		if resolved == excluded || docops.IsPathInside(excluded, resolved) {
+			return true
+		}
+	}
+	return false
+}
+
+func matchesRelPathPrefix(filePath, root string, prefixes []string) bool {
+	if len(prefixes) == 0 {
+		return true
+	}
+	relPath := docops.RelativeMarkdownPath(root, filePath)
+	for _, prefix := range prefixes {
+		if strings.HasPrefix(relPath, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+var mdExt = []string{".md", ".markdown"}
+
+func walkMarkdownFiles(dirPath string, options ListOptions) []string {
+	files := []string{}
+	if !pathExists(dirPath) {
+		return files
+	}
+	root, _ := filepath.Abs(dirPath)
+	includePrefixes := []string{}
+	for _, p := range options.IncludeRelPathPrefixes {
+		includePrefixes = append(includePrefixes, normalizedRelPathPrefix(p))
+	}
+	excludedDirs := excludedDirsFor(options)
+	limit := 0
+	if options.Limit > 0 {
+		limit = options.Limit
+	}
+
+	var walk func(current string)
+	walk = func(current string) {
+		if limit > 0 && len(files) >= limit {
+			return
+		}
+		entries, err := os.ReadDir(current)
+		if err != nil {
+			return
+		}
+		sort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })
+		for _, entry := range entries {
+			if limit > 0 && len(files) >= limit {
+				break
+			}
+			absPath := filepath.Join(current, entry.Name())
+			if entry.IsDir() {
+				if strings.HasPrefix(entry.Name(), ".") || shouldSkipDir(absPath, excludedDirs) {
+					continue
+				}
+				walk(absPath)
+			} else {
+				name := entry.Name()
+				if strings.HasPrefix(name, ".") || !hasMdExt(name) {
+					continue
+				}
+				if !matchesRelPathPrefix(absPath, root, includePrefixes) {
+					continue
+				}
+				files = append(files, absPath)
+			}
+		}
+	}
+	walk(dirPath)
+	return files
+}
+
+func pathExists(p string) bool {
+	_, err := os.Stat(p)
+	return err == nil
+}
+
+func hasMdExt(name string) bool {
+	lower := strings.ToLower(name)
+	return strings.HasSuffix(lower, ".md") || strings.HasSuffix(lower, ".markdown")
+}
+
+func snippetFor(content, query string) string {
+	compact := strings.Join(strings.Fields(content), " ")
+	idx := strings.Index(strings.ToLower(compact), strings.ToLower(query))
+	if idx < 0 {
+		return sliceStr(compact, 0, 180)
+	}
+	start := idx - 70
+	if start < 0 {
+		start = 0
+	}
+	end := idx + len(query) + 110
+	if end > len(compact) {
+		end = len(compact)
+	}
+	prefix := ""
+	if start > 0 {
+		prefix = "..."
+	}
+	suffix := ""
+	if end < len(compact) {
+		suffix = "..."
+	}
+	return prefix + sliceStr(compact, start, end) + suffix
+}
+
+func sliceStr(s string, start, end int) string {
+	if start < 0 {
+		start = 0
+	}
+	if start > len(s) {
+		return ""
+	}
+	if end > len(s) {
+		end = len(s)
+	}
+	return s[start:end]
+}
+
+func resolveLibraryPath(target string) (string, error) {
+	resolved := docops.ResolveMarkdownPath(libraryRoot(), target)
+	if resolved == "" {
+		return "", fmt.Errorf("Invalid Library path: %s", target)
+	}
+	return resolved, nil
+}
+
+func defaultContent(targetPath string, input WriteInput) string {
+	if input.Content != nil {
+		return *input.Content
+	}
+	if input.Title == "" {
+		return ""
+	}
+	title := strings.TrimSpace(input.Title)
+	if title == "" {
+		base := filepath.Base(targetPath)
+		title = strings.TrimSuffix(base, filepath.Ext(base))
+	}
+	return "# " + title + "\n"
+}
+
+// ListLibraryDocuments mirrors listLibraryDocuments.
+func ListLibraryDocuments(options ListOptions) []DocumentSummary {
+	files := walkMarkdownFiles(libraryRoot(), options)
+	out := make([]DocumentSummary, 0, len(files))
+	for _, f := range files {
+		out = append(out, summaryForFile(f, ""))
+	}
+	return out
+}
+
+// SearchLibraryDocuments mirrors searchLibraryDocuments.
+func SearchLibraryDocuments(query string, options ListOptions) []SearchResult {
+	needle := strings.TrimSpace(query)
+	results := []SearchResult{}
+	if needle == "" {
+		return results
+	}
+	opts := options
+	opts.Limit = 0
+	for _, filePath := range walkMarkdownFiles(libraryRoot(), opts) {
+		b, err := os.ReadFile(filePath)
+		if err != nil {
+			continue
+		}
+		content := string(b)
+		if !strings.Contains(strings.ToLower(content), strings.ToLower(needle)) {
+			continue
+		}
+		results = append(results, SearchResult{
+			DocumentSummary: summaryForFile(filePath, content),
+			Snippet:         snippetFor(content, needle),
+		})
+		limit := options.Limit
+		if limit == 0 {
+			limit = 20
+		}
+		if len(results) >= limit {
+			break
+		}
+	}
+	return results
+}
+
+// ShowLibraryDocument mirrors showLibraryDocument.
+func ShowLibraryDocument(target string) (Document, error) {
+	filePath, err := resolveLibraryPath(target)
+	if err != nil {
+		return Document{}, err
+	}
+	content, version, err := docops.ReadMarkdownDocument(filePath)
+	if err != nil {
+		return Document{}, err
+	}
+	return Document{
+		DocumentSummary: summaryForFile(filePath, content),
+		Content:         content,
+		Version:         version,
+	}, nil
+}
+
+// CreateLibraryDocument mirrors createLibraryDocument.
+func CreateLibraryDocument(target string, input WriteInput) (Document, error) {
+	filePath, err := resolveLibraryPath(target)
+	if err != nil {
+		return Document{}, err
+	}
+	content, err := docops.ReadContentInput(docops.ContentInput{
+		Stdin:    input.Stdin,
+		File:     input.File,
+		Fallback: defaultContent(filePath, input),
+	})
+	if err != nil {
+		return Document{}, err
+	}
+	if _, err := docops.CreateMarkdownFile(filePath, content); err != nil {
+		return Document{}, err
+	}
+	return ShowLibraryDocument(target)
+}
+
+// UpdateLibraryDocument mirrors updateLibraryDocument.
+func UpdateLibraryDocument(target string, input UpdateInput) (Document, error) {
+	filePath, err := resolveLibraryPath(target)
+	if err != nil {
+		return Document{}, err
+	}
+	fallback := ""
+	if input.WriteInput.Content != nil {
+		fallback = *input.WriteInput.Content
+	}
+	content, err := docops.ReadContentInput(docops.ContentInput{
+		Stdin:    input.Stdin,
+		File:     input.File,
+		Fallback: fallback,
+	})
+	if err != nil {
+		return Document{}, err
+	}
+	if _, err := docops.UpdateMarkdownFile(filePath, content, docops.UpdateOptions{
+		ExpectedSha256: input.ExpectedSha256,
+		Force:          input.Force,
+		AllowEmpty:     input.AllowEmpty,
+	}); err != nil {
+		return Document{}, err
+	}
+	return ShowLibraryDocument(target)
+}
+
+// RenameLibraryDocument mirrors renameLibraryDocument.
+func RenameLibraryDocument(target, nextTarget string) (Document, error) {
+	oldPath, err := resolveLibraryPath(target)
+	if err != nil {
+		return Document{}, err
+	}
+	newPath, err := resolveLibraryPath(nextTarget)
+	if err != nil {
+		return Document{}, err
+	}
+	if _, err := docops.RenameMarkdownFile(oldPath, newPath); err != nil {
+		return Document{}, err
+	}
+	return ShowLibraryDocument(nextTarget)
+}
+
+// DeleteLibraryDocument mirrors deleteLibraryDocument.
+func DeleteLibraryDocument(target string) (docops.TrashedDocument, error) {
+	filePath, err := resolveLibraryPath(target)
+	if err != nil {
+		return docops.TrashedDocument{}, err
+	}
+	return docops.MoveToTrash(filePath)
+}
