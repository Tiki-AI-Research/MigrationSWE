@@ -0,0 +1,53 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"fieldtheory/internal/cliapp"
+	"fieldtheory/internal/config"
+	"fieldtheory/internal/ideas"
+	"fieldtheory/internal/paths"
+)
+
+func main() {
+	args := os.Args[1:]
+
+	if len(args) == 0 {
+		if paths.IsFirstRun() {
+			cliapp.ShowWelcome()
+		} else {
+			cliapp.ShowDashboard()
+		}
+		return
+	}
+
+	config.LoadEnv()
+
+	// One-time ideas data migration, best-effort.
+	func() {
+		defer func() { _ = recover() }()
+		result := ideas.MigrateLegacyIdeasData()
+		if result.Migrated {
+			fmt.Fprintf(os.Stderr, "  Migrated ideas data → %s\n", result.NewRoot)
+			fmt.Fprintf(os.Stderr, "  Legacy copies left intact at %s and %s.\n", result.LegacyIdeasRoot, result.LegacyAdjacentRoot)
+		}
+	}()
+
+	root := cliapp.BuildRoot()
+	root.SetArgs(args)
+
+	if err := root.Execute(); err != nil {
+		var ee *cliapp.ExitError
+		if errors.As(err, &ee) {
+			if !ee.Quiet {
+				fmt.Fprintln(os.Stderr, err)
+			}
+			os.Exit(ee.Code)
+		}
+		fmt.Fprintln(os.Stderr, err)
+		_ = root.Usage()
+		os.Exit(1)
+	}
+}
