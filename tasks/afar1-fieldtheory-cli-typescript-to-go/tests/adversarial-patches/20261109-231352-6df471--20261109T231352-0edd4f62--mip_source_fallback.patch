index 0000000..c65a2c1
--- /dev/null
+++ b/internal/cliapp/app.go
@@ -0,0 +1,927 @@
+package cliapp
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/spf13/cobra"
+
+	"fieldtheory/internal/classify"
+	"fieldtheory/internal/engine"
+	"fieldtheory/internal/model"
+	"fieldtheory/internal/paths"
+	"fieldtheory/internal/preferences"
+	"fieldtheory/internal/prompt"
+	"fieldtheory/internal/store"
+)
+
+// Version is the CLI version reported by --version and the logo.
+const Version = "1.3.22"
+
+// ExitError carries a desired process exit code.
+type ExitError struct {
+	Code    int
+	Quiet   bool
+	Message string
+}
+
+func (e *ExitError) Error() string {
+	if e.Message != "" {
+		return e.Message
+	}
+	return fmt.Sprintf("exit %d", e.Code)
+}
+
+func printJSON(value any) {
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	enc.SetIndent("", "  ")
+	if err := enc.Encode(value); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		return
+	}
+	fmt.Print(strings.TrimRight(buf.String(), "\n") + "\n")
+}
+
+func safeAction(fn func(cmd *cobra.Command, args []string) error) func(*cobra.Command, []string) error {
+	return func(cmd *cobra.Command, args []string) error {
+		err := fn(cmd, args)
+		if err == nil {
+			return nil
+		}
+		var pc *prompt.CancelledError
+		if errors.As(err, &pc) {
+			fmt.Printf("\n  %s\n\n", pc.Message)
+			return &ExitError{Code: pc.ExitCode, Quiet: true}
+		}
+		var ee *ExitError
+		if errors.As(err, &ee) {
+			return ee
+		}
+		fmt.Fprintf(os.Stderr, "\n  Error: %s\n\n", err.Error())
+		return &ExitError{Code: 1, Quiet: true}
+	}
+}
