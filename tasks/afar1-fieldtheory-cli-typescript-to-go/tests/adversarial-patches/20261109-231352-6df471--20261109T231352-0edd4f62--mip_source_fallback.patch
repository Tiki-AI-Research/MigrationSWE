+
+func writeBookmarksCache(t *testing.T, dataDir string) {
+	t.Helper()
+	line := `{"id":"b1","tweetId":"1","url":"https://x.com/a/status/1","text":"a handy cli tool we built","authorHandle":"alice","syncedAt":"2024-01-01T00:00:00.000Z"}` + "\n"
+	if err := os.WriteFile(filepath.Join(dataDir, "bookmarks.jsonl"), []byte(line), 0o600); err != nil {
+		t.Fatalf("write cache: %v", err)
+	}
+}
+
+func writeFakeEngine(t *testing.T, dir, name, body string) {
+	t.Helper()
+	p := filepath.Join(dir, name)
+	if err := os.WriteFile(p, []byte("#!/bin/sh\n"+body+"\n"), 0o755); err != nil {
+		t.Fatalf("write fake engine: %v", err)
+	}
+}
+
+func claudeEngine() engine.ResolvedEngine {
+	return engine.ResolvedEngine{Name: "claude", Config: engine.KnownEngines["claude"], Label: "claude"}
+}
+
+func TestClassifyWithLlmUsesEngineBridge(t *testing.T) {
+	dataDir := t.TempDir()
+	t.Setenv("FT_DATA_DIR", dataDir)
+	writeBookmarksCache(t, dataDir)
+	if _, _, _, err := store.BuildIndex(false); err != nil {
+		t.Fatalf("build index: %v", err)
+	}
+
+	binDir := t.TempDir()
+	writeFakeEngine(t, binDir, "claude", `cat >/dev/null
+printf '[{"id":"b1","categories":["tool"],"primary":"tool"}]'`)
+	t.Setenv("PATH", binDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+
+	res, err := classifyWithLlm(claudeEngine(), nil)
+	if err != nil {
+		t.Fatalf("classifyWithLlm: %v", err)
+	}
+	if res.TotalUnclassified != 1 || res.Classified != 1 {
+		t.Fatalf("unexpected result: %+v", res)
+	}
+
+	item, err := store.GetBookmarkByID("b1")
+	if err != nil {
+		t.Fatalf("get bookmark: %v", err)
+	}
+	if item == nil || item.PrimaryCategory == nil || *item.PrimaryCategory != "tool" {
+		t.Fatalf("expected primary_category=tool, got %+v", item)
+	}
+}
+
+func TestClassifyDomainsWithLlmUsesEngineBridge(t *testing.T) {
+	dataDir := t.TempDir()
+	t.Setenv("FT_DATA_DIR", dataDir)
+	writeBookmarksCache(t, dataDir)
+	if _, _, _, err := store.BuildIndex(false); err != nil {
+		t.Fatalf("build index: %v", err)
+	}
+
+	binDir := t.TempDir()
+	writeFakeEngine(t, binDir, "claude", `cat >/dev/null
+printf '[{"id":"b1","domains":["ai"],"primary":"ai"}]'`)
+	t.Setenv("PATH", binDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+
+	res, err := classifyDomainsWithLlm(claudeEngine(), false, nil)
+	if err != nil {
+		t.Fatalf("classifyDomainsWithLlm: %v", err)
+	}
+	if res.TotalUnclassified != 1 || res.Classified != 1 {
+		t.Fatalf("unexpected result: %+v", res)
+	}
+
+	item, err := store.GetBookmarkByID("b1")
+	if err != nil {
+		t.Fatalf("get bookmark: %v", err)
+	}
+	if item == nil || item.PrimaryDomain == nil || *item.PrimaryDomain != "ai" {
+		t.Fatalf("expected primary_domain=ai, got %+v", item)
+	}
+}
+
+func TestParseLLMResponseExtractsJSONArray(t *testing.T) {
+	out, err := parseLLMResponse("here you go:\n```json\n[{\"id\":\"a\",\"categories\":[\"tool\",\"ai\"],\"primary\":\"tool\"}]\n```", map[string]bool{"a": true})
+	if err != nil {
+		t.Fatalf("parseLLMResponse: %v", err)
+	}
+	if len(out) != 1 || out[0].ID != "a" || out[0].Primary != "tool" {
+		b, _ := json.Marshal(out)
+		t.Fatalf("unexpected parse output: %s", b)
+	}
+}
