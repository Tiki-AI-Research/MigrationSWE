+func formatQuotedTweetLines(q *model.QuotedTweetSnapshot) string {
+	author := "quoted tweet"
+	if q.AuthorHandle != "" {
+		author = "@" + q.AuthorHandle
+	} else if q.AuthorName != "" {
+		author = q.AuthorName
+	}
+	date := ""
+	if q.PostedAt != nil && len(*q.PostedAt) >= 10 {
+		date = " · " + (*q.PostedAt)[:10]
+	}
+	lines := []string{"", "quoted tweet", "  | " + sanitizeForDisplay(author) + date}
+	for _, line := range strings.Split(q.Text, "\n") {
+		line = strings.TrimSuffix(line, "\r")
+		lines = append(lines, "  | "+sanitizeForDisplay(line))
+	}
+	lines = append(lines, "  | "+q.URL)
+	return strings.Join(lines, "\n")
+}
