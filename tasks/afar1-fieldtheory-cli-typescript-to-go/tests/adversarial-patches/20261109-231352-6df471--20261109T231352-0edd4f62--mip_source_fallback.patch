+func resolveFolder(names []string, query string) (string, error) {
+	lower := strings.ToLower(strings.TrimSpace(query))
+	for _, name := range names {
+		if strings.ToLower(strings.TrimSpace(name)) == lower {
+			return name, nil
+		}
+	}
+	prefix := []string{}
+	for _, name := range names {
+		if strings.HasPrefix(strings.ToLower(strings.TrimSpace(name)), lower) {
+			prefix = append(prefix, name)
+		}
+	}
+	if len(prefix) == 1 {
+		return prefix[0], nil
+	}
+	if len(prefix) > 1 {
+		return "", fmt.Errorf("Multiple folders match %q: %s. Be more specific.", query, strings.Join(prefix, ", "))
+	}
+	available := strings.Join(names, ", ")
+	if available == "" {
+		available = "(none)"
+	}
+	return "", fmt.Errorf("No folder matches %q. Available: %s", query, available)
+}
+
+func containsStr(values []string, v string) bool {
+	for _, x := range values {
+		if x == v {
+			return true
+		}
+	}
+	return false
+}
+
+func stdinIsTTY() bool {
+	info, err := os.Stdin.Stat()
+	if err != nil {
+		return false
+	}
+	return info.Mode()&os.ModeCharDevice != 0
+}
+
+func notImplemented(name string) error {
+	fmt.Fprintf(os.Stderr, "  ft %s is not available in this build (out of scope for the Go migration).\n", name)
+	return &ExitError{Code: 1, Quiet: true}
+}
+
+func min(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
