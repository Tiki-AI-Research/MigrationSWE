+func parseIntOpt(value string, fallback int) int {
+	if strings.TrimSpace(value) == "" {
+		return fallback
+	}
+	n, err := strconv.Atoi(strings.TrimSpace(value))
+	if err != nil {
+		return fallback
+	}
+	return n
+}
+
+func sanitizeForDisplay(value string) string {
+	var b strings.Builder
+	for _, r := range value {
+		if r == 0 || (r >= 0x00 && r <= 0x1f) || (r >= 0x7f && r <= 0x9f) {
+			b.WriteByte('?')
+			continue
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
