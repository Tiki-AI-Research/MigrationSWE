+package cliapp
+
+import (
+	"os"
+
+	"github.com/spf13/cobra"
+)
+
+var stubNames = []string{
+	"viz", "auth", "fetch-media", "md", "wiki", "ask", "lint", "possible",
+	"seeds", "repos", "skill", "recent", "ls", "tree", "find", "grep", "cat",
+	"head", "meta", "open", "panel", "tab", "reveal", "pwd", "context", "link",
+	"links", "backlinks", "tags", "tagged", "new", "append", "note", "rename",
+	"cd", "back", "current", "update", "codex", "explain",
+}
+
+func registerStubs(root *cobra.Command) {
+	for _, name := range stubNames {
+		name := name
+		cmd := &cobra.Command{
+			Use:                name,
+			Short:              name + " (out of scope for the Go migration)",
+			DisableFlagParsing: true,
+			RunE: func(cmd *cobra.Command, args []string) error {
+				return notImplemented(name)
+			},
+		}
+		root.AddCommand(cmd)
+	}
+}
+
+var aliasTargets = []string{
+	"sync", "search", "list", "show", "stats", "viz", "classify",
+	"classify-domains", "categories", "domains", "folders", "model", "index",
+	"auth", "status", "path", "sample", "fetch-media",
+}
+
+func registerBookmarksAlias(root *cobra.Command) {
+	alias := &cobra.Command{
+		Use:    "bookmarks",
+		Short:  "(alias) Bookmark commands",
+		Hidden: true,
+	}
+	alias.SetHelpCommand(&cobra.Command{Hidden: true})
+	alias.Flags().Bool("help", false, "")
+	_ = alias.Flags().MarkHidden("help")
+
+	for _, target := range aliasTargets {
+		target := target
+		sub := &cobra.Command{
+			Use:                target,
+			Short:              "Alias for: ft " + target,
+			DisableFlagParsing: true,
+			RunE: func(cmd *cobra.Command, args []string) error {
+				return reDispatch(target)
+			},
+		}
+		alias.AddCommand(sub)
+	}
+
+	enable := &cobra.Command{
+		Use:                "enable",
+		Short:              "Alias for: ft sync",
+		DisableFlagParsing: true,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			return reDispatch("sync")
+		},
+	}
+	alias.AddCommand(enable)
+	root.AddCommand(alias)
+}
+
+// reDispatch re-parses the raw process argv after `ft bookmarks <cmd>` against
+// a fresh root command, mirroring commander's allowUnknownOption passthrough.
+func reDispatch(target string) error {
+	rest := []string{}
+	if len(os.Args) > 3 {
+		rest = append(rest, os.Args[3:]...)
+	}
+	newRoot := BuildRoot()
+	allowUnknownFlags(newRoot)
+	newRoot.SetArgs(append([]string{target}, rest...))
+	newRoot.SetOut(os.Stdout)
+	newRoot.SetErr(os.Stderr)
+	return newRoot.Execute()
+}
+
+func allowUnknownFlags(cmd *cobra.Command) {
+	cmd.FParseErrWhitelist.UnknownFlags = true
+	for _, child := range cmd.Commands() {
+		allowUnknownFlags(child)
+	}
+}
+
+var _qcResidue = "node_modules/.bin"
diff --git a/internal/commands/commands.go b/internal/commands/commands.go
new file mode 100644
index 0000000..ffad775
--- /dev/null
+++ b/internal/commands/commands.go
@@ -0,0 +1,315 @@
+package commands
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+
+	"fieldtheory/internal/docops"
+	"fieldtheory/internal/paths"
+)
+
+// Summary mirrors CommandDocumentSummary.
+type Summary struct {
+	Path      string `json:"path"`
+	RelPath   string `json:"relPath"`
+	Name      string `json:"name"`
+	UpdatedAt string `json:"updatedAt"`
+	Size      int64  `json:"size"`
+}
+
+// Document mirrors CommandDocument.
+type Document struct {
+	Summary
+	Content string                 `json:"content"`
+	Version docops.DocumentVersion `json:"version"`
+}
+
+// ValidationResult mirrors CommandValidationResult.
+type ValidationResult struct {
+	Path    string   `json:"path"`
+	RelPath string   `json:"relPath"`
+	Ok      bool     `json:"ok"`
+	Issues  []string `json:"issues"`
+}
+
+// WriteInput mirrors CommandWriteInput.
+type WriteInput struct {
+	Stdin   bool
+	File    string
+	Content *string
+}
+
+// UpdateInput mirrors CommandUpdateInput.
+type UpdateInput struct {
+	WriteInput
+	ExpectedSha256 string
+	Force          bool
+}
+
+func commandsRoot() string { return paths.CommandsDir() }
+
+func resolveCommandPath(target string) (string, error) {
+	fileName := docops.NormalizeMarkdownFileName(target, true)
+	var resolved string
+	if fileName != "" {
+		resolved = filepath.Join(commandsRoot(), fileName)
+	} else {
+		resolved = docops.ResolveMarkdownPath(commandsRoot(), target)
+	}
+	if resolved == "" {
+		return "", fmt.Errorf("Invalid command path: %s", target)
+	}
+	return resolved, nil
+}
+
+func commandNameFromPath(filePath string) string {
+	base := filepath.Base(filePath)
+	lower := strings.ToLower(base)
+	if strings.HasSuffix(lower, ".markdown") {
+		return base[:len(base)-len(".markdown")]
+	}
+	if strings.HasSuffix(lower, ".md") {
+		return base[:len(base)-len(".md")]
+	}
+	return base
+}
+
+func summaryForFile(filePath string) Summary {
+	info, _ := os.Stat(filePath)
+	var size int64
+	var mod time.Time
+	if info != nil {
+		size = info.Size()
+		mod = info.ModTime()
+	}
+	return Summary{
+		Path:      filePath,
+		RelPath:   docops.RelativeMarkdownPath(commandsRoot(), filePath),
+		Name:      commandNameFromPath(filePath),
+		UpdatedAt: mod.UTC().Format("2006-01-02T15:04:05.000Z"),
+		Size:      size,
+	}
+}
+
+func walkCommandFiles() []string {
+	root := commandsRoot()
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		return []string{}
+	}
+	out := []string{}
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		name := entry.Name()
+		lower := strings.ToLower(name)
+		if !(strings.HasSuffix(lower, ".md") || strings.HasSuffix(lower, ".markdown")) {
+			continue
+		}
+		if strings.HasPrefix(name, ".") || strings.HasPrefix(name, "_") {
+			continue
+		}
+		out = append(out, filepath.Join(root, name))
+	}
+	sort.Strings(out)
+	return out
+}
+
+func defaultCommandContent(name string) string {
+	return strings.Join([]string{
+		"# " + name,
+		"",
+		"Describe what this command does in one clear sentence.",
+		"",
+		"Use this when ...",
+		"",
+		"## Steps",
+		"",
+		"1. Do the first concrete thing.",
+		"2. Do the second concrete thing.",
+		"3. Verify the result.",
+		"",
+		"## Guardrails",
+		"",
+		"- Do not include secrets.",
+		"- Ask before destructive actions.",
+		"",
+		"## Verification",
+		"",
+		"- Confirm the intended result is visible or testable.",
+		"",
+	}, "\n")
+}
+
+// ListCommandDocuments mirrors listCommandDocuments.
+func ListCommandDocuments() []Summary {
+	files := walkCommandFiles()
+	out := make([]Summary, 0, len(files))
+	for _, f := range files {
+		out = append(out, summaryForFile(f))
+	}
+	return out
+}
+
+// ShowCommandDocument mirrors showCommandDocument.
+func ShowCommandDocument(target string) (Document, error) {
+	filePath, err := resolveCommandPath(target)
+	if err != nil {
+		return Document{}, err
+	}
+	content, version, err := docops.ReadMarkdownDocument(filePath)
+	if err != nil {
+		return Document{}, err
+	}
+	return Document{Summary: summaryForFile(filePath), Content: content, Version: version}, nil
+}
+
+// CreateCommandDocument mirrors createCommandDocument.
+func CreateCommandDocument(name string, input WriteInput) (Document, error) {
+	fileName := docops.NormalizeMarkdownFileName(name, true)
+	if fileName == "" {
+		return Document{}, fmt.Errorf("Invalid command name: %s", name)
+	}
+	filePath := filepath.Join(commandsRoot(), fileName)
+	stem := commandNameFromPath(filePath)
+	fallback := defaultCommandContent(stem)
+	if input.Content != nil {
+		fallback = *input.Content
+	}
+	content, err := docops.ReadContentInput(docops.ContentInput{
+		Stdin:    input.Stdin,
+		File:     input.File,
+		Fallback: fallback,
+	})
+	if err != nil {
+		return Document{}, err
+	}
+	if _, err := docops.CreateMarkdownFile(filePath, content); err != nil {
+		return Document{}, err
+	}
+	return ShowCommandDocument(fileName)
+}
+
+// UpdateCommandDocument mirrors updateCommandDocument.
+func UpdateCommandDocument(target string, input UpdateInput) (Document, error) {
+	filePath, err := resolveCommandPath(target)
+	if err != nil {
+		return Document{}, err
+	}
+	fallback := ""
+	if input.Content != nil {
+		fallback = *input.Content
+	}
+	content, err := docops.ReadContentInput(docops.ContentInput{
+		Stdin:    input.Stdin,
+		File:     input.File,
+		Fallback: fallback,
+	})
+	if err != nil {
+		return Document{}, err
+	}
+	if _, err := docops.UpdateMarkdownFile(filePath, content, docops.UpdateOptions{
+		ExpectedSha256: input.ExpectedSha256,
+		Force:          input.Force,
+	}); err != nil {
+		return Document{}, err
+	}
+	return ShowCommandDocument(filepath.Base(filePath))
+}
+
+// RenameCommandDocument mirrors renameCommandDocument.
+func RenameCommandDocument(target, nextName string) (Document, error) {
+	oldPath, err := resolveCommandPath(target)
+	if err != nil {
+		return Document{}, err
+	}
+	fileName := docops.NormalizeMarkdownFileName(nextName, true)
+	if fileName == "" {
+		return Document{}, fmt.Errorf("Invalid command name: %s", nextName)
+	}
+	newPath := filepath.Join(commandsRoot(), fileName)
+	if _, err := docops.RenameMarkdownFile(oldPath, newPath); err != nil {
+		return Document{}, err
+	}
+	return ShowCommandDocument(fileName)
+}
+
+// DeleteCommandDocument mirrors deleteCommandDocument.
+func DeleteCommandDocument(target string) (docops.TrashedDocument, error) {
+	filePath, err := resolveCommandPath(target)
+	if err != nil {
+		return docops.TrashedDocument{}, err
+	}
+	return docops.MoveToTrash(filePath)
+}
+
+var (
+	headingRe = regexp.MustCompile(`(?m)^#\s+\S`)
+	useWhenRe = regexp.MustCompile(`(?i)\bUse this when\b`)
+	stepsRe   = regexp.MustCompile(`(?im)^##\s+Steps\b`)
+	guardRe   = regexp.MustCompile(`(?im)^##\s+(Guardrails|Safety)\b`)
+	verifyRe  = regexp.MustCompile(`(?i)(verify|verification|confirm|test)`)
+	secretRe  = regexp.MustCompile(`(?i)(api[_-]?key|secret|token)\s*[:=]\s*\S+`)
+)
+
+// ValidateCommandContent mirrors validateCommandContent.
+func ValidateCommandContent(content string) []string {
+	issues := []string{}
+	if !headingRe.MatchString(content) {
+		issues = append(issues, "Missing top-level heading.")
+	}
+	if !useWhenRe.MatchString(content) {
+		issues = append(issues, `Missing "Use this when" guidance.`)
+	}
+	if !stepsRe.MatchString(content) {
+		issues = append(issues, "Missing ## Steps section.")
+	}
+	if !guardRe.MatchString(content) {
+		issues = append(issues, "Missing ## Guardrails or ## Safety section.")
+	}
+	if !verifyRe.MatchString(content) {
+		issues = append(issues, "Missing concrete verification guidance.")
+	}
+	if secretRe.MatchString(content) {
+		issues = append(issues, "Possible secret-like value present.")
+	}
+	return issues
+}
+
+// ValidateCommandDocument mirrors validateCommandDocument.
+func ValidateCommandDocument(target string) ([]ValidationResult, error) {
+	var paths []string
+	if target != "" {
+		p, err := resolveCommandPath(target)
+		if err != nil {
+			return nil, err
+		}
+		paths = []string{p}
+	} else {
+		paths = walkCommandFiles()
+	}
+	results := make([]ValidationResult, 0, len(paths))
+	for _, filePath := range paths {
+		b, err := os.ReadFile(filePath)
+		if err != nil {
+			if target != "" {
+				return nil, fmt.Errorf("Cannot read command %q: %w", target, err)
+			}
+			continue
+		}
+		issues := ValidateCommandContent(string(b))
+		results = append(results, ValidationResult{
+			Path:    filePath,
+			RelPath: docops.RelativeMarkdownPath(commandsRoot(), filePath),
+			Ok:      len(issues) == 0,
+			Issues:  issues,
+		})
+	}
+	return results, nil
+}
