+func buildStatusView() statusView {
+	view := statusView{
+		Connected: false,
+		Mode:      "Incremental by default (GraphQL)",
+		CachePath: paths.CachePath(),
+	}
+	if stats, err := store.GetStats(); err == nil {
+		view.BookmarkCount = stats.TotalBookmarks
+	}
+	view.ClassificationTotal = view.BookmarkCount
+	if db, err := store.OpenDB(paths.IndexPath()); err == nil {
+		defer db.Close()
+		var total, catsDone, domainsDone int
+		_ = db.QueryRow(`SELECT
+       COUNT(*),
+       SUM(CASE WHEN primary_category IS NOT NULL AND primary_category <> '' AND primary_category <> 'unclassified' THEN 1 ELSE 0 END),
+       SUM(CASE WHEN primary_domain IS NOT NULL AND primary_domain <> '' THEN 1 ELSE 0 END)
+     FROM bookmarks`).Scan(&total, &catsDone, &domainsDone)
+		view.ClassificationTotal = total
+		view.CategoriesDone = catsDone
+		view.DomainsDone = domainsDone
+	}
+	return view
