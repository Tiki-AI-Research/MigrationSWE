index 0000000..e247819
--- /dev/null
+++ b/internal/classify/classify.go
@@ -0,0 +1,320 @@
+package classify
+
+import (
+	"fmt"
+	"net/url"
+	"regexp"
+	"sort"
+	"strings"
+
+	"fieldtheory/internal/model"
+)
+
+// BookmarkCategory names (non-exclusive).
+var categoryOrder = []string{"security", "tool", "technique", "launch", "research", "opinion", "commerce"}
+
+func mustCompile(patterns ...string) []*regexp.Regexp {
+	out := make([]*regexp.Regexp, 0, len(patterns))
+	for _, p := range patterns {
+		out = append(out, regexp.MustCompile("(?i)"+p))
+	}
+	return out
+}
+
+var toolPatterns = mustCompile(
+	`github\.com/[\w-]+/[\w-]+`,
+	`\bnpm\s+(install|i)\b`,
+	`\bpip\s+install\b`,
+	`\bcargo\s+add\b`,
+	`\bbrew\s+install\b`,
+	`\bopen[\s-]?source\b`,
+	`\bcli\b.*\btool\b`,
+	`\btool\b.*\bcli\b`,
+	`\brust\s+crate\b`,
+	`\bvscode\s+extension\b`,
+	`\bnpx\s+`,
+	`\brepo\b.*\bgithub\b`,
+	`\bgithub\b.*\brepo\b`,
+	`\bself[\s-]?hosted\b`,
+	`\bopen[\s-]?sourced?\b`,
+)
+
+var securityPatterns = mustCompile(
+	`\bcve[-\s]?\d{4}`,
+	`\bvulnerabilit`,
+	`\bexploit`,
+	`\bmalware\b`,
+	`\bransomware\b`,
+	`\bsupply[\s-]?chain\s+attack`,
+	`\bsecurity\s+(flaw|bug|issue|patch|advisory|update|breach)`,
+	`\bbreach\b`,
+	`\bbackdoor\b`,
+	`\bzero[\s-]?day\b`,
+	`\bremote\s+code\s+execution\b`,
+	`\brce\b`,
+	`\bprivilege\s+escalation\b`,
+	`\bcompromised?\b`,
+)
+
+var techniquePatterns = mustCompile(
+	`\bhow\s+(i|we|to)\b`,
+	`\btutorial\b`,
+	`\bwalkthrough\b`,
+	`\bstep[\s-]?by[\s-]?step\b`,
+	`\bbuilt\s+(with|using|this|a|an|my)\b`,
+	`\bhere'?s?\s+how\b`,
+	`\bcode\s+(pattern|example|snippet|sample)\b`,
+	`\barchitecture\b.*\b(of|for|behind)\b`,
+	`\bimplemented?\b.*\bfrom\s+scratch\b`,
+	`\bunder\s+the\s+hood\b`,
+	`\bdeep[\s-]?dive\b`,
+	`\btechnique\b`,
+	`\bpattern\b.*\b(for|in|to)\b`,
+)
+
+var launchPatterns = mustCompile(
+	`\bjust\s+(launched|shipped|released|dropped|published)\b`,
+	`\bwe('re|\s+are)\s+(launching|shipping|releasing)\b`,
+	`\bannouncing\b`,
+	`\bintroduc(ing|es?)\b`,
+	`\bnow\s+(available|live|in\s+beta)\b`,
+	`\bv\d+\.\d+`,
+	`\b(alpha|beta)\s+(release|launch|is\s+here)\b`,
+	`\bproduct\s+hunt\b`,
+	`🚀.*\b(launch|ship|live)\b`,
+	`\bcheck\s+it\s+out\b`,
+)
+
+var researchPatterns = mustCompile(
+	`arxiv\.org`,
+	`\bpaper\b.*\b(new|our|this|the)\b`,
+	`\b(new|our|this)\b.*\bpaper\b`,
+	`\bstudy\b.*\b(finds?|shows?|reveals?)\b`,
+	`\bfindings?\b`,
+	`\bpeer[\s-]?review`,
+	`\bpreprint\b`,
+	`\bresearch\b.*\b(from|by|at|shows?)\b`,
+	`\bpublished\s+in\b`,
+	`\bjournal\b`,
+	`\bstate[\s-]?of[\s-]?the[\s-]?art\b`,
+)
+
+var opinionPatterns = mustCompile(
+	`\bthread\b.*👇`,
+	`\bunpopular\s+opinion\b`,
+	`\bhot\s+take\b`,
+	`\bhere'?s?\s+(why|what|my\s+take)\b`,
+	`\bi\s+think\b.*\b(about|that)\b`,
+	`\bcontroversial\b`,
+	`\boverrated\b`,
+	`\bunderrated\b`,
+	`\blessons?\s+(learned|from)\b`,
+	`\bmistakes?\s+(i|we)\b`,
+)
+
+var commercePatterns = mustCompile(
+	`\bamazon\.com\b`,
+	`\bshop\s+(here|now)\b`,
+	`\bbuy\s+(now|here|this)\b`,
+	`\bdiscount\b`,
+	`\bcoupon\b`,
+	`\baffiliate\b`,
+	`\bgeni\.us\b`,
+	`\ba\.co/`,
+	`\$\d+(\.\d{2})?\s*(off|usd|discount)`,
+)
+
+var (
+	githubURLRe = regexp.MustCompile(`(?i)github\.com/[\w.-]+/[\w.-]+`)
+	urlRe       = regexp.MustCompile(`(?i)https?://[^\s)>\]\]]+`)
+	tcoRe       = regexp.MustCompile(`(?i)https?://t\.co/\w+`)
+)
+
+var toolDomains = map[string]bool{
+	"github.com": true, "gitlab.com": true, "huggingface.co": true,
+	"npmjs.com": true, "pypi.org": true, "crates.io": true, "pkg.go.dev": true,
+}
+
+var researchDomains = map[string]bool{
+	"arxiv.org": true, "scholar.google.com": true, "semanticscholar.org": true,
+	"biorxiv.org": true, "medrxiv.org": true, "nature.com": true, "science.org": true,
+}
+
+var commerceDomains = map[string]bool{
+	"amazon.com": true, "www.amazon.com": true, "a.co": true,
+	"store.steampowered.com": true, "geni.us": true, "ebay.com": true,
+}
+
+// Result mirrors bookmark-classify.ts ClassifyResult.
+type Result struct {
+	Categories    []string
+	Primary       string
+	ExtractedURLs []string
+	GithubURLs    []string
+}
+
+func matchesAny(patterns []*regexp.Regexp, text string) bool {
+	for _, p := range patterns {
+		if p.MatchString(text) {
+			return true
+		}
+	}
+	return false
+}
+
+func uniquePreserve(values []string) []string {
+	seen := map[string]bool{}
+	out := []string{}
+	for _, v := range values {
+		if v == "" || seen[v] {
+			continue
+		}
+		seen[v] = true
+		out = append(out, v)
+	}
+	return out
+}
+
+// ClassifyBookmark mirrors classifyBookmark.
+func ClassifyBookmark(b model.BookmarkRecord) Result {
+	text := b.Text
+	allLinks := append([]string{}, b.Links...)
+
+	textURLs := []string{}
+	for _, m := range urlRe.FindAllString(text, -1) {
+		if !tcoRe.MatchString(m) {
+			textURLs = append(textURLs, m)
+		}
+	}
+	extractedURLs := uniquePreserve(append(append([]string{}, allLinks...), textURLs...))
+
+	githubMatches := githubURLRe.FindAllString(text, -1)
+	githubFromLinks := []string{}
+	for _, l := range allLinks {
+		if regexp.MustCompile(`(?i)github\.com`).MatchString(l) {
+			githubFromLinks = append(githubFromLinks, l)
+		}
+	}
+	githubURLs := uniquePreserve(append(prefixEach(githubMatches, "https://"), githubFromLinks...))
+
+	domains := []string{}
+	for _, u := range extractedURLs {
+		parsed, err := url.Parse(u)
+		if err != nil || parsed.Hostname() == "" {
+			continue
+		}
+		domains = append(domains, strings.TrimPrefix(parsed.Hostname(), "www."))
+	}
+
+	categories := []string{}
+	domainIn := func(set map[string]bool) bool {
+		for _, d := range domains {
+			if set[d] {
+				return true
+			}
+		}
+		return false
+	}
+
+	if matchesAny(securityPatterns, text) {
+		categories = append(categories, "security")
+	}
+	if matchesAny(toolPatterns, text) || len(githubURLs) > 0 || domainIn(toolDomains) {
+		categories = append(categories, "tool")
+	}
+	if matchesAny(techniquePatterns, text) {
+		categories = append(categories, "technique")
+	}
+	if matchesAny(launchPatterns, text) {
+		categories = append(categories, "launch")
+	}
+	if matchesAny(researchPatterns, text) || domainIn(researchDomains) {
+		categories = append(categories, "research")
+	}
+	if matchesAny(opinionPatterns, text) {
+		categories = append(categories, "opinion")
+	}
+	if matchesAny(commercePatterns, text) || domainIn(commerceDomains) {
+		categories = append(categories, "commerce")
+	}
+
+	primary := "unclassified"
+	if len(categories) > 0 {
+		primary = categories[0]
+	}
+
+	return Result{
+		Categories:    categories,
+		Primary:       primary,
+		ExtractedURLs: extractedURLs,
+		GithubURLs:    githubURLs,
+	}
+}
+
+func prefixEach(values []string, prefix string) []string {
+	out := make([]string, 0, len(values))
+	for _, v := range values {
+		out = append(out, prefix+v)
+	}
+	return out
+}
+
+// Summary mirrors ClassificationSummary.
+type Summary struct {
+	Total           int
+	Classified      int
+	Unclassified    int
+	ByCategoryCount map[string]int
+}
+
+// ClassifyCorpus mirrors classifyCorpus.
+func ClassifyCorpus(bookmarks []model.BookmarkRecord) (map[string]Result, Summary) {
+	results := map[string]Result{}
+	counts := map[string]int{}
+	unclassified := 0
+	for _, b := range bookmarks {
+		r := ClassifyBookmark(b)
+		results[b.ID] = r
+		if len(r.Categories) == 0 {
+			unclassified++
+		}
+		for _, c := range r.Categories {
+			counts[c]++
+		}
+	}
+	return results, Summary{
+		Total:           len(bookmarks),
+		Classified:      len(bookmarks) - unclassified,
+		Unclassified:    unclassified,
+		ByCategoryCount: counts,
+	}
+}
+
+// FormatClassificationSummary mirrors formatClassificationSummary.
+func FormatClassificationSummary(s Summary) string {
+	lines := []string{
+		fmt.Sprintf("Classified %d/%d bookmarks (%d unclassified)", s.Classified, s.Total, s.Unclassified),
+		"",
+	}
+	type kv struct {
+		k string
+		v int
+	}
+	items := make([]kv, 0, len(s.ByCategoryCount))
+	for k, v := range s.ByCategoryCount {
+		items = append(items, kv{k, v})
+	}
+	sort.SliceStable(items, func(i, j int) bool { return items[i].v > items[j].v })
+	for _, it := range items {
+		pct := "0.0"
+		if s.Total > 0 {
+			pct = fmt.Sprintf("%.1f", float64(it.v)/float64(s.Total)*100)
+		}
+		padded := it.k
+		for len(padded) < 12 {
+			padded += " "
+		}
+		lines = append(lines, fmt.Sprintf("  %s %5d  (%s%%)", padded, it.v, pct))
+	}
+	return strings.Join(lines, "\n")
+}
diff --git a/internal/cliapp/app.go b/internal/cliapp/app.go
