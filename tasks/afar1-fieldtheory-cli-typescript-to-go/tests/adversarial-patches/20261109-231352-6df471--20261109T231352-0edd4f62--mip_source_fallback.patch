index 0000000..33048bf
--- /dev/null
+++ b/internal/store/store.go
@@ -0,0 +1,536 @@
+package store
+
+import (
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"regexp"
+	"strings"
+
+	"fieldtheory/internal/classify"
+	"fieldtheory/internal/fsutil"
+	"fieldtheory/internal/model"
+	"fieldtheory/internal/paths"
+
+	_ "modernc.org/sqlite"
+)
+
+// SchemaVersion is the protected schema version.
+const SchemaVersion = 6
+
+// ColumnNames is the canonical column order (37 columns).
+var ColumnNames = []string{
+	"id", "tweet_id", "url", "text", "author_handle", "author_name",
+	"author_profile_image_url", "posted_at", "bookmarked_at", "synced_at",
+	"conversation_id", "in_reply_to_status_id", "quoted_status_id", "language",
+	"like_count", "repost_count", "reply_count", "quote_count", "bookmark_count",
+	"view_count", "media_count", "link_count", "links_json", "tags_json",
+	"ingested_via", "categories", "primary_category", "github_urls", "domains",
+	"primary_domain", "quoted_tweet_json", "article_title", "article_text",
+	"article_site", "enriched_at", "folder_ids", "folder_names",
+}
+
+var githubInlineRe = regexp.MustCompile(`(?i)github\.com/[\w.-]+/[\w.-]+`)
+
+// OpenDB opens (creating if needed) the bookmarks database file.
+func OpenDB(dbPath string) (*sql.DB, error) {
+	db, err := sql.Open("sqlite", dbPath)
+	if err != nil {
+		return nil, err
+	}
+	db.SetMaxOpenConns(1)
+	return db, nil
+}
+
+// InitSchema mirrors initSchema().
+func InitSchema(db *sql.DB) error {
+	stmts := []string{
+		`CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT)`,
+		`CREATE TABLE IF NOT EXISTS bookmarks (
+    id TEXT PRIMARY KEY,
+    tweet_id TEXT NOT NULL,
+    url TEXT NOT NULL,
+    text TEXT NOT NULL,
+    author_handle TEXT,
+    author_name TEXT,
+    author_profile_image_url TEXT,
+    posted_at TEXT,
+    bookmarked_at TEXT,
+    synced_at TEXT NOT NULL,
+    conversation_id TEXT,
+    in_reply_to_status_id TEXT,
+    quoted_status_id TEXT,
+    language TEXT,
+    like_count INTEGER,
+    repost_count INTEGER,
+    reply_count INTEGER,
+    quote_count INTEGER,
+    bookmark_count INTEGER,
+    view_count INTEGER,
+    media_count INTEGER DEFAULT 0,
+    link_count INTEGER DEFAULT 0,
+    links_json TEXT,
+    tags_json TEXT,
+    ingested_via TEXT,
+    categories TEXT,
+    primary_category TEXT,
+    github_urls TEXT,
+    domains TEXT,
+    primary_domain TEXT,
+    quoted_tweet_json TEXT,
+    article_title TEXT,
+    article_text TEXT,
+    article_site TEXT,
+    enriched_at TEXT,
+    folder_ids TEXT,
+    folder_names TEXT
+  )`,
+		`CREATE INDEX IF NOT EXISTS idx_bookmarks_author ON bookmarks(author_handle)`,
+		`CREATE INDEX IF NOT EXISTS idx_bookmarks_posted ON bookmarks(posted_at)`,
+		`CREATE INDEX IF NOT EXISTS idx_bookmarks_language ON bookmarks(language)`,
+		`CREATE INDEX IF NOT EXISTS idx_bookmarks_category ON bookmarks(primary_category)`,
+		`CREATE INDEX IF NOT EXISTS idx_bookmarks_domain ON bookmarks(primary_domain)`,
+		`CREATE VIRTUAL TABLE IF NOT EXISTS bookmarks_fts USING fts5(
+    text,
+    author_handle,
+    author_name,
+    article_text,
+    content=bookmarks,
+    content_rowid=rowid,
+    tokenize='porter unicode61'
+  )`,
+	}
+	for _, s := range stmts {
+		if _, err := db.Exec(s); err != nil {
+			return err
+		}
+	}
+	_, err := db.Exec("REPLACE INTO meta VALUES ('schema_version', ?)", fmt.Sprintf("%d", SchemaVersion))
+	return err
+}
+
+func columnExists(db *sql.DB, table, column string) bool {
+	rows, err := db.Query(fmt.Sprintf("PRAGMA table_info(%s)", table))
+	if err != nil {
+		return false
+	}
+	defer rows.Close()
+	cols, err := rows.Columns()
+	if err != nil {
+		return false
+	}
+	nameIdx := -1
+	for i, c := range cols {
+		if c == "name" {
+			nameIdx = i
+		}
+	}
+	if nameIdx < 0 {
+		return false
+	}
+	for rows.Next() {
+		vals := make([]any, len(cols))
+		ptrs := make([]any, len(cols))
+		for i := range vals {
+			ptrs[i] = &vals[i]
+		}
+		if err := rows.Scan(ptrs...); err != nil {
+			return false
+		}
+		if v, ok := vals[nameIdx].([]byte); ok && string(v) == column {
+			return true
+		}
+		if v, ok := vals[nameIdx].(string); ok && v == column {
+			return true
+		}
+	}
+	return false
+}
+
+func ensureColumn(db *sql.DB, table, column, definition string) error {
+	if columnExists(db, table, column) {
+		return nil
+	}
+	_, err := db.Exec(fmt.Sprintf("ALTER TABLE %s ADD COLUMN %s %s", table, column, definition))
+	return err
+}
+
+func ftsHasColumn(db *sql.DB, column string) bool {
+	_, err := db.Exec(fmt.Sprintf("SELECT %s FROM bookmarks_fts LIMIT 0", column))
+	return err == nil
+}
+
+// EnsureMigrations mirrors ensureMigrations().
+func EnsureMigrations(db *sql.DB) error {
+	if _, err := db.Exec("CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT)"); err != nil {
+		return err
+	}
+
+	var name string
+	err := db.QueryRow("SELECT name FROM sqlite_master WHERE type='table' AND name='bookmarks'").Scan(&name)
+	hasBookmarksTable := err == nil && name == "bookmarks"
+
+	if hasBookmarksTable {
+		for _, col := range [][2]string{
+			{"domains", "TEXT"}, {"primary_domain", "TEXT"},
+		} {
+			if err := ensureColumn(db, "bookmarks", col[0], col[1]); err != nil {
+				return err
+			}
+		}
+		if _, err := db.Exec("CREATE INDEX IF NOT EXISTS idx_bookmarks_domain ON bookmarks(primary_domain)"); err != nil {
+			return err
+		}
+		for _, col := range []string{"quoted_tweet_json", "article_title", "article_text", "article_site", "enriched_at", "folder_ids", "folder_names"} {
+			if err := ensureColumn(db, "bookmarks", col, "TEXT"); err != nil {
+				return err
+			}
+		}
+		if !ftsHasColumn(db, "article_text") {
+			if _, err := db.Exec("DROP TABLE IF EXISTS bookmarks_fts"); err != nil {
+				return err
+			}
+			if _, err := db.Exec(`CREATE VIRTUAL TABLE IF NOT EXISTS bookmarks_fts USING fts5(
+        text, author_handle, author_name, article_text,
+        content=bookmarks, content_rowid=rowid,
+        tokenize='porter unicode61'
+      )`); err != nil {
+				return err
+			}
+			if _, err := db.Exec("INSERT INTO bookmarks_fts(bookmarks_fts) VALUES('rebuild')"); err != nil {
+				return err
+			}
+		}
+	}
+
+	_, err = db.Exec("REPLACE INTO meta VALUES ('schema_version', ?)", fmt.Sprintf("%d", SchemaVersion))
+	return err
+}
+
+type preservedFields struct {
+	categories      *string
+	primaryCategory *string
+	githubURLs      *string
+	domains         *string
+	primaryDomain   *string
+	quotedTweetJSON *string
+	articleTitle    *string
+	articleText     *string
+	articleSite     *string
+	enrichedAt      *string
+	folderIDs       *string
+	folderNames     *string
+}
+
+type execFunc func(query string, args ...any) (sql.Result, error)
+
+func strPtrOrNil(s string) any {
+	if s == "" {
+		return nil
+	}
+	return s
+}
+
+func jsonArrayOrNil(values []string) any {
+	if len(values) == 0 {
+		return nil
+	}
+	b, err := json.Marshal(values)
+	if err != nil {
+		return nil
+	}
+	return string(b)
+}
+
+func derefString(p *string) any {
+	if p == nil {
+		return nil
+	}
+	return *p
+}
+
+func derefInt(p *int) any {
+	if p == nil {
+		return nil
+	}
+	return *p
+}
+
+func insertRecord(e execFunc, r model.BookmarkRecord, preserved *preservedFields) error {
+	text := r.Text
+	githubMatches := githubInlineRe.FindAllString(text, -1)
+	githubFromLinks := []string{}
+	for _, l := range r.Links {
+		if githubInlineRe.MatchString(l) {
+			githubFromLinks = append(githubFromLinks, l)
+		}
+	}
+	githubURLs := []string{}
+	seen := map[string]bool{}
+	for _, m := range githubMatches {
+		u := "https://" + m
+		if !seen[u] {
+			seen[u] = true
+			githubURLs = append(githubURLs, u)
+		}
+	}
+	for _, l := range githubFromLinks {
+		if !seen[l] {
+			seen[l] = true
+			githubURLs = append(githubURLs, l)
+		}
+	}
+
+	var like, repost, reply, quote, bm, view any
+	if r.Engagement != nil {
+		like = derefInt(r.Engagement.LikeCount)
+		repost = derefInt(r.Engagement.RepostCount)
+		reply = derefInt(r.Engagement.ReplyCount)
+		quote = derefInt(r.Engagement.QuoteCount)
+		bm = derefInt(r.Engagement.BookmarkCount)
+		view = derefInt(r.Engagement.ViewCount)
+	}
+
+	quotedJSON := any(nil)
+	if r.QuotedTweet != nil {
+		if b, err := json.Marshal(r.QuotedTweet); err == nil {
+			quotedJSON = string(b)
+		}
+	} else if preserved != nil {
+		quotedJSON = preserved.quotedTweetJSON
+	}
+
+	primaryCategory := any("unclassified")
+	categories := any(nil)
+	githubCol := jsonArrayOrNil(githubURLs)
+	domains := any(nil)
+	primaryDomain := any(nil)
+	articleTitle := any(nil)
+	articleText := any(nil)
+	articleSite := any(nil)
+	enrichedAt := any(nil)
+	folderIDs := jsonArrayOrNil(r.FolderIDs)
+	folderNames := jsonArrayOrNil(r.FolderNames)
+
+	if preserved != nil {
+		if preserved.categories != nil {
+			categories = *preserved.categories
+		}
+		if preserved.primaryCategory != nil {
+			primaryCategory = *preserved.primaryCategory
+		}
+		if preserved.githubURLs != nil {
+			githubCol = *preserved.githubURLs
+		}
+		if preserved.domains != nil {
+			domains = *preserved.domains
+		}
+		if preserved.primaryDomain != nil {
+			primaryDomain = *preserved.primaryDomain
+		}
+		if preserved.articleTitle != nil {
+			articleTitle = *preserved.articleTitle
+		}
+		if preserved.articleText != nil {
+			articleText = *preserved.articleText
+		}
+		if preserved.articleSite != nil {
+			articleSite = *preserved.articleSite
+		}
+		if preserved.enrichedAt != nil {
+			enrichedAt = *preserved.enrichedAt
+		}
+		if folderIDs == nil && preserved.folderIDs != nil {
+			folderIDs = *preserved.folderIDs
+		}
+		if folderNames == nil && preserved.folderNames != nil {
+			folderNames = *preserved.folderNames
+		}
+	}
+
+	placeholders := strings.TrimSuffix(strings.Repeat("?,", len(ColumnNames)), ",")
+	query := fmt.Sprintf("INSERT OR REPLACE INTO bookmarks VALUES (%s)", placeholders)
+	_, err := e(query,
+		r.ID,
+		r.TweetID,
+		r.URL,
+		r.Text,
+		strPtrOrNil(r.AuthorHandle),
+		strPtrOrNil(r.AuthorName),
+		strPtrOrNil(r.AuthorProfileImageURL),
+		derefString(r.PostedAt),
+		derefString(r.BookmarkedAt),
+		r.SyncedAt,
+		strPtrOrNil(r.ConversationID),
+		strPtrOrNil(r.InReplyToStatusID),
+		strPtrOrNil(r.QuotedStatusID),
+		strPtrOrNil(r.Language),
+		like, repost, reply, quote, bm, view,
+		len(r.Media),
+		len(r.Links),
+		jsonArrayOrNil(r.Links),
+		jsonArrayOrNil(r.Tags),
+		strPtrOrNil(r.IngestedVia),
+		categories,
+		primaryCategory,
+		githubCol,
+		domains,
+		primaryDomain,
+		quotedJSON,
+		articleTitle,
+		articleText,
+		articleSite,
+		enrichedAt,
+		folderIDs,
+		folderNames,
+	)
+	return err
+}
+
+// BuildIndex mirrors buildIndex().
+func BuildIndex(force bool) (dbPath string, recordCount int, newRecords int, err error) {
+	cachePath := paths.CachePath()
+	dbPath = paths.IndexPath()
+	records := fsutil.ReadJSONLines[model.BookmarkRecord](cachePath)
+
+	db, err := OpenDB(dbPath)
+	if err != nil {
+		return dbPath, 0, 0, err
+	}
+	defer db.Close()
+
+	if force {
+		for _, t := range []string{"bookmarks_fts", "bookmarks", "meta"} {
+			if _, err := db.Exec("DROP TABLE IF EXISTS " + t); err != nil {
+				return dbPath, 0, 0, err
+			}
+		}
+	}
+
+	if err := InitSchema(db); err != nil {
+		return dbPath, 0, 0, err
+	}
+	if err := EnsureMigrations(db); err != nil {
+		return dbPath, 0, 0, err
+	}
+
+	existingRows := map[string]*preservedFields{}
+	if rows, qerr := db.Query(`SELECT id, categories, primary_category, github_urls, domains, primary_domain,
+        quoted_tweet_json, article_title, article_text, article_site, enriched_at,
+        folder_ids, folder_names FROM bookmarks`); qerr == nil {
+		for rows.Next() {
+			var id string
+			var cats, pc, gh, dom, pd, qtj, at, atx, as, ea, fi, fn sql.NullString
+			if err := rows.Scan(&id, &cats, &pc, &gh, &dom, &pd, &qtj, &at, &atx, &as, &ea, &fi, &fn); err != nil {
+				break
+			}
+			existingRows[id] = &preservedFields{
+				categories:      nullStrPtr(cats),
+				primaryCategory: nullStrPtr(pc),
+				githubURLs:      nullStrPtr(gh),
+				domains:         nullStrPtr(dom),
+				primaryDomain:   nullStrPtr(pd),
+				quotedTweetJSON: nullStrPtr(qtj),
+				articleTitle:    nullStrPtr(at),
+				articleText:     nullStrPtr(atx),
+				articleSite:     nullStrPtr(as),
+				enrichedAt:      nullStrPtr(ea),
+				folderIDs:       nullStrPtr(fi),
+				folderNames:     nullStrPtr(fn),
+			}
+		}
+		rows.Close()
+	}
+
+	newCount := 0
+	for _, r := range records {
+		if _, ok := existingRows[r.ID]; !ok {
+			newCount++
+		}
+	}
+
+	if len(records) > 0 {
+		tx, terr := db.Begin()
+		if terr != nil {
+			return dbPath, 0, 0, terr
+		}
+		stmt, perr := tx.Prepare(fmt.Sprintf("INSERT OR REPLACE INTO bookmarks VALUES (%s)", placeholders()))
+		if perr != nil {
+			tx.Rollback()
+			return dbPath, 0, 0, perr
+		}
+		for _, r := range records {
+			if err := insertRecord(func(q string, a ...any) (sql.Result, error) { return stmt.Exec(a...) }, r, existingRows[r.ID]); err != nil {
+				stmt.Close()
+				tx.Rollback()
+				return dbPath, 0, 0, err
+			}
+		}
+		stmt.Close()
+		if err := tx.Commit(); err != nil {
+			return dbPath, 0, 0, err
+		}
+	}
+
+	if _, err := db.Exec("INSERT INTO bookmarks_fts(bookmarks_fts) VALUES('rebuild')"); err != nil {
+		return dbPath, 0, 0, err
+	}
+
+	var total int
+	if err := db.QueryRow("SELECT COUNT(*) FROM bookmarks").Scan(&total); err != nil {
+		return dbPath, 0, 0, err
+	}
+	return dbPath, total, newCount, nil
+}
+
+func placeholders() string {
+	return strings.TrimSuffix(strings.Repeat("?,", len(ColumnNames)), ",")
+}
+
+func nullStrPtr(n sql.NullString) *string {
+	if !n.Valid {
+		return nil
+	}
+	v := n.String
+	return &v
+}
+
+// ClassifyAndRebuild mirrors classifyAndRebuild().
+func ClassifyAndRebuild() (string, int, classify.Summary, error) {
+	cachePath := paths.CachePath()
+	dbPath := paths.IndexPath()
+	records := fsutil.ReadJSONLines[model.BookmarkRecord](cachePath)
+	results, summary := classify.ClassifyCorpus(records)
+
+	_, recordCount, _, err := BuildIndex(false)
+	if err != nil {
+		return dbPath, 0, summary, err
+	}
+	db, err := OpenDB(dbPath)
+	if err != nil {
+		return dbPath, recordCount, summary, err
+	}
+	defer db.Close()
+	if err := EnsureMigrations(db); err != nil {
+		return dbPath, recordCount, summary, err
+	}
+	stmt, err := db.Prepare(`UPDATE bookmarks SET categories = ?, primary_category = ?, github_urls = ? WHERE id = ? AND (primary_category = 'unclassified' OR primary_category IS NULL)`)
+	if err != nil {
+		return dbPath, recordCount, summary, err
+	}
+	for id, r := range results {
+		if len(r.Categories) > 0 {
+			var gh any
+			if len(r.GithubURLs) > 0 {
+				b, _ := json.Marshal(r.GithubURLs)
+				gh = string(b)
+			}
+			if _, err := stmt.Exec(strings.Join(r.Categories, ","), r.Primary, gh, id); err != nil {
+				stmt.Close()
+				return dbPath, recordCount, summary, err
+			}
+		}
+	}
+	stmt.Close()
+	return dbPath, recordCount, summary, nil
+}
