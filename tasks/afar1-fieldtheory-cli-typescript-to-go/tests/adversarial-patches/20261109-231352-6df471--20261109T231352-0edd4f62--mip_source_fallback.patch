+		fmt.Sprintf("  bookmarks: %d", view.BookmarkCount),
+		fmt.Sprintf("  categories: %d/%d", view.CategoriesDone, total),
+		fmt.Sprintf("  domains: %d/%d", view.DomainsDone, total),
+		fmt.Sprintf("  last updated: %s", last),
+		fmt.Sprintf("  sync mode: %s", view.Mode),
+		fmt.Sprintf("  cache: %s", view.CachePath),
+	}, "\n")
