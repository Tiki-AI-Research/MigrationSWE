+package preferences
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+
+	"fieldtheory/internal/fsutil"
+	"fieldtheory/internal/paths"
+)
+
+// Preferences mirrors preferences.ts Preferences.
+type Preferences struct {
+	DefaultEngine string `json:"defaultEngine,omitempty"`
+}
+
+// LoadPreferences returns an empty value when the file is missing or invalid.
+func LoadPreferences() Preferences {
+	var prefs Preferences
+	if err := fsutil.ReadJSON(paths.PreferencesPath(), &prefs); err != nil {
+		return Preferences{}
+	}
+	return prefs
+}
+
+// SavePreferences creates the data directory and writes the file 0600.
+func SavePreferences(prefs Preferences) error {
+	paths.EnsureDataDir()
+	filePath := paths.PreferencesPath()
+	tmpPath := filePath + ".tmp"
+	content, err := marshalPrefs(prefs)
+	if err != nil {
+		return err
+	}
+	if err := os.WriteFile(tmpPath, []byte(content), 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmpPath, filePath)
+}
+
+func marshalPrefs(prefs Preferences) (string, error) {
+	// Match JSON.stringify(prefs, null, 2) + "\n".
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	enc.SetIndent("", "  ")
+	if err := enc.Encode(prefs); err != nil {
+		return "", err
+	}
+	return buf.String(), nil
+}
diff --git a/internal/prompt/prompt.go b/internal/prompt/prompt.go
new file mode 100644
index 0000000..63aa097
--- /dev/null
+++ b/internal/prompt/prompt.go
@@ -0,0 +1,79 @@
+package prompt
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"os/signal"
+	"strings"
+	"syscall"
+)
+
+// Kind enumerates PromptResult kinds.
+type Kind string
+
+const (
+	KindAnswer    Kind = "answer"
+	KindClose     Kind = "close"
+	KindInterrupt Kind = "interrupt"
+)
+
+// Result mirrors prompt.ts PromptResult.
+type Result struct {
+	Kind  Kind
+	Value string
+}
+
+// CancelledError mirrors prompt.ts PromptCancelledError.
+type CancelledError struct {
+	Message  string
+	ExitCode int
+}
+
+func (e *CancelledError) Error() string { return e.Message }
+
+// PromptText reads a line from stdin. It resolves to a trimmed answer, to
+// close on EOF, and to interrupt on SIGINT (closing the reader).
+func PromptText(question string) Result {
+	fmt.Fprint(os.Stderr, question)
+
+	lineCh := make(chan string, 1)
+	errCh := make(chan error, 1)
+	go func() {
+		reader := bufio.NewReader(os.Stdin)
+		line, err := reader.ReadString('\n')
+		if err != nil && line == "" {
+			errCh <- err
+			return
+		}
+		lineCh <- line
+	}()
+
+	sigCh := make(chan os.Signal, 1)
+	signal.Notify(sigCh, syscall.SIGINT)
+	defer signal.Stop(sigCh)
+
+	select {
+	case line := <-lineCh:
+		return Result{Kind: KindAnswer, Value: strings.TrimSpace(line)}
+	case <-errCh:
+		return Result{Kind: KindClose}
+	case <-sigCh:
+		return Result{Kind: KindInterrupt}
+	}
+}
+
+// WithFunc is a minimal interface compatible with a line-oriented prompt.
+type WithFunc func(question string, callback func(answer string)) func()
+
+// PromptWithFunc adapts a callback-style prompt to a Result.
+func PromptWithFunc(question string, f WithFunc) Result {
+	done := make(chan Result, 1)
+	closeFn := f(question, func(answer string) {
+		done <- Result{Kind: KindAnswer, Value: strings.TrimSpace(answer)}
+	})
+	if closeFn != nil {
+		go closeFn()
+	}
+	return <-done
+}
diff --git a/internal/store/query.go b/internal/store/query.go
new file mode 100644
index 0000000..0c5ab4b
--- /dev/null
+++ b/internal/store/query.go
@@ -0,0 +1,752 @@
+package store
+
+import (
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"fieldtheory/internal/dateutil"
+	"fieldtheory/internal/model"
+	"fieldtheory/internal/paths"
+	"regexp"
+)
+
+var ftsOperatorRe = regexp.MustCompile(`[*{}:^"()\\+]`)
+var leadingMinusRe = regexp.MustCompile(`(^|\s)-\S`)
+var keywordRe = regexp.MustCompile(`(?i)(^|\s)(AND|OR|NOT|NEAR)(\s|$)`)
+
+// SanitizeFTSQuery escapes FTS5 operators into literal terms.
+func SanitizeFTSQuery(query string) string {
+	hasOperator := ftsOperatorRe.MatchString(query) || leadingMinusRe.MatchString(query) || keywordRe.MatchString(query)
+	if !hasOperator {
+		return query
+	}
+	terms := strings.Fields(query)
+	out := make([]string, 0, len(terms))
+	for _, term := range terms {
+		cleaned := strings.ReplaceAll(term, `"`, "")
+		out = append(out, `"`+cleaned+`"`)
+	}
+	return strings.Join(out, " ")
+}
+
+// SearchOptions mirrors bookmarks-db.ts SearchOptions.
+type SearchOptions struct {
+	Query  string
+	Author string
+	Limit  int
+	Before string
+	After  string
+	Folder string
+}
+
+// InvalidSearchQueryError mirrors the "Invalid search query" failure.
+type InvalidSearchQueryError struct {
+	Query string
+}
+
+func (e *InvalidSearchQueryError) Error() string {
+	return fmt.Sprintf("Invalid search query: %q. Try simpler terms or wrap phrases in double quotes.", e.Query)
+}
+
+// SearchBookmarks mirrors searchBookmarks().
+func SearchBookmarks(options SearchOptions) ([]model.SearchResult, error) {
+	dbPath := paths.IndexPath()
+	db, err := OpenDB(dbPath)
+	if err != nil {
+		return nil, err
+	}
+	defer db.Close()
+	if err := EnsureMigrations(db); err != nil {
+		return nil, err
+	}
+	limit := options.Limit
+	if limit == 0 {
+		limit = 20
+	}
+
+	var conditions []string
+	var params []any
+	if options.Query != "" {
+		conditions = append(conditions, `b.rowid IN (SELECT rowid FROM bookmarks_fts WHERE bookmarks_fts MATCH ?)`)
+		params = append(params, SanitizeFTSQuery(options.Query))
+	}
+	if options.Author != "" {
+		conditions = append(conditions, `b.author_handle = ? COLLATE NOCASE`)
+		params = append(params, options.Author)
+	}
+	if options.After != "" {
+		conditions = append(conditions, `b.posted_at >= ?`)
+		params = append(params, options.After)
+	}
+	if options.Before != "" {
+		conditions = append(conditions, `b.posted_at <= ?`)
+		params = append(params, options.Before)
+	}
+	where := ""
+	if len(conditions) > 0 {
+		where = "WHERE " + strings.Join(conditions, " AND ")
+	}
+
+	var sqlStr string
+	if options.Query != "" {
+		sqlStr = `
+        SELECT b.id, b.url, b.text, b.author_handle, b.author_name, b.posted_at,
+               bm25(bookmarks_fts, 5.0, 1.0, 1.0, 3.0) as score
+        FROM bookmarks b
+        JOIN bookmarks_fts ON bookmarks_fts.rowid = b.rowid
+        ` + where + `
+        ORDER BY bm25(bookmarks_fts, 5.0, 1.0, 1.0, 3.0) ASC
+        LIMIT ?`
+	} else {
+		sqlStr = `
+        SELECT b.id, b.url, b.text, b.author_handle, b.author_name, b.posted_at,
+               0 as score
+        FROM bookmarks b
+        ` + where + `
+        ORDER BY b.posted_at DESC
+        LIMIT ?`
+	}
+	params = append(params, limit)
+
+	rows, qerr := db.Query(sqlStr, params...)
+	if qerr != nil {
+		msg := strings.ToLower(qerr.Error())
+		if strings.Contains(msg, "fts5") || strings.Contains(msg, "match") || strings.Contains(msg, "syntax") {
+			return nil, &InvalidSearchQueryError{Query: options.Query}
+		}
+		return nil, qerr
+	}
+	defer rows.Close()
+
+	results := []model.SearchResult{}
+	for rows.Next() {
+		var r model.SearchResult
+		var authorHandle, authorName, postedAt sql.NullString
+		if err := rows.Scan(&r.ID, &r.URL, &r.Text, &authorHandle, &authorName, &postedAt, &r.Score); err != nil {
+			return nil, err
+		}
+		if authorHandle.Valid {
+			r.AuthorHandle = authorHandle.String
+		}
+		if authorName.Valid {
+			r.AuthorName = authorName.String
+		}
+		if postedAt.Valid {
+			v := postedAt.String
+			r.PostedAt = &v
+		}
+		results = append(results, r)
+	}
+	return results, rows.Err()
+}
+
+// FormatSearchResults mirrors formatSearchResults().
+func FormatSearchResults(results []model.SearchResult) string {
+	if len(results) == 0 {
+		return "No results found."
+	}
+	parts := make([]string, 0, len(results))
+	for i, r := range results {
+		author := "unknown"
+		if r.AuthorHandle != "" {
+			author = "@" + r.AuthorHandle
+		}
+		date := "?"
+		if r.PostedAt != nil {
+			date = sliceString(*r.PostedAt, 0, 10)
+		}
+		text := r.Text
+		if len(text) > 140 {
+			text = sliceString(text, 0, 140) + "..."
+		}
+		parts = append(parts, fmt.Sprintf("%d. [%s] %s (ID: %s)\n   %s\n   %s", i+1, date, author, r.ID, text, r.URL))
+	}
+	return strings.Join(parts, "\n\n")
+}
+
+func sliceString(s string, start, end int) string {
+	if start >= len(s) {
+		return ""
+	}
+	if end > len(s) {
+		end = len(s)
+	}
+	return s[start:end]
+}
+
+// TimelineFilters mirrors bookmarks-db.ts BookmarkTimelineFilters.
+type TimelineFilters struct {
+	Query    string
+	Author   string
+	After    string
+	Before   string
+	Category string
+	Domain   string
+	Folder   string
+	Sort     string
+	Limit    int
+	Offset   int
+}
+
+func parseJSONArray(value sql.NullString) []string {
+	out := []string{}
+	if !value.Valid || strings.TrimSpace(value.String) == "" {
+		return out
+	}
+	var parsed []any
+	if err := json.Unmarshal([]byte(value.String), &parsed); err != nil {
+		return out
+	}
+	for _, e := range parsed {
+		if s, ok := e.(string); ok {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+func parseCsv(value sql.NullString) []string {
+	out := []string{}
+	if !value.Valid || strings.TrimSpace(value.String) == "" {
+		return out
+	}
+	for _, part := range strings.Split(value.String, ",") {
+		t := strings.TrimSpace(part)
+		if t != "" {
+			out = append(out, t)
+		}
+	}
+	return out
+}
+
+func parseQuotedTweet(value sql.NullString) *model.QuotedTweetSnapshot {
+	if !value.Valid || strings.TrimSpace(value.String) == "" {
+		return nil
+	}
+	var q model.QuotedTweetSnapshot
+	if err := json.Unmarshal([]byte(value.String), &q); err != nil {
+		return nil
+	}
+	if q.ID == "" || q.Text == "" || q.URL == "" {
+		return nil
+	}
+	return &q
+}
+
+func buildBookmarkWhereClause(f TimelineFilters) (string, []any) {
+	var conditions []string
+	var params []any
+	if f.Query != "" {
+		conditions = append(conditions, `b.rowid IN (SELECT rowid FROM bookmarks_fts WHERE bookmarks_fts MATCH ?)`)
+		params = append(params, f.Query)
+	}
+	if f.Author != "" {
+		conditions = append(conditions, `b.author_handle = ? COLLATE NOCASE`)
+		params = append(params, f.Author)
+	}
+	if f.After != "" {
+		conditions = append(conditions, `COALESCE(b.posted_at, b.bookmarked_at) >= ?`)
+		params = append(params, f.After)
+	}
+	if f.Before != "" {
+		conditions = append(conditions, `COALESCE(b.posted_at, b.bookmarked_at) <= ?`)
+		params = append(params, f.Before)
+	}
+	if f.Category != "" {
+		conditions = append(conditions, `b.categories LIKE ?`)
+		params = append(params, "%"+f.Category+"%")
+	}
+	if f.Domain != "" {
+		conditions = append(conditions, `b.domains LIKE ?`)
+		params = append(params, "%"+f.Domain+"%")
+	}
+	if f.Folder != "" {
+		conditions = append(conditions, `EXISTS (SELECT 1 FROM json_each(b.folder_names) WHERE json_each.value = ? COLLATE NOCASE)`)
+		params = append(params, f.Folder)
+	}
+	if len(conditions) == 0 {
+		return "", params
+	}
+	return "WHERE " + strings.Join(conditions, " AND "), params
+}
+
+func bookmarkSortClause(direction string) string {
+	normalized := "DESC"
+	if direction == "asc" {
+		normalized = "ASC"
+	}
+	return fmt.Sprintf(`
+    ORDER BY
+      CASE
+        WHEN b.bookmarked_at GLOB '____-__-__*' THEN b.bookmarked_at
+        WHEN b.posted_at GLOB '____-__-__*' THEN b.posted_at
+        ELSE ''
+      END %s,
+      CAST(b.tweet_id AS INTEGER) %s
+  `, normalized, normalized)
+}
+
+const timelineSelect = `
+      SELECT
+        b.id,
+        b.tweet_id,
+        b.url,
+        b.text,
+        b.author_handle,
+        b.author_name,
+        b.author_profile_image_url,
+        b.posted_at,
+        b.bookmarked_at,
+        b.categories,
+        b.primary_category,
+        b.domains,
+        b.primary_domain,
+        b.github_urls,
+        b.links_json,
+        b.media_count,
+        b.link_count,
+        b.like_count,
+        b.repost_count,
+        b.reply_count,
+        b.quote_count,
+        b.bookmark_count,
+        b.view_count,
+        b.folder_ids,
+        b.folder_names,
+        b.article_title,
+        b.article_text,
+        b.article_site,
+        b.synced_at,
+        b.enriched_at,
+        b.quoted_status_id,
+        b.quoted_tweet_json
+      FROM bookmarks b
+  `
+
+func mapTimelineRow(rows *sql.Rows) (model.BookmarkTimelineItem, error) {
+	var it model.BookmarkTimelineItem
+	var authorHandle, authorName, authorProfile, postedAt, bookmarkedAt sql.NullString
+	var categories, primaryCategory, domains, primaryDomain sql.NullString
+	var githubURLs, linksJSON sql.NullString
+	var mediaCount, linkCount sql.NullInt64
+	var like, repost, reply, quote, bookmark, view sql.NullInt64
+	var folderIDs, folderNames sql.NullString
+	var articleTitle, articleText, articleSite sql.NullString
+	var syncedAt, enrichedAt, quotedStatusID, quotedTweetJSON sql.NullString
+
+	err := rows.Scan(
+		&it.ID, &it.TweetID, &it.URL, &it.Text,
+		&authorHandle, &authorName, &authorProfile,
+		&postedAt, &bookmarkedAt,
+		&categories, &primaryCategory, &domains, &primaryDomain,
+		&githubURLs, &linksJSON,
+		&mediaCount, &linkCount,
+		&like, &repost, &reply, &quote, &bookmark, &view,
+		&folderIDs, &folderNames,
+		&articleTitle, &articleText, &articleSite,
+		&syncedAt, &enrichedAt, &quotedStatusID, &quotedTweetJSON,
+	)
+	if err != nil {
+		return it, err
+	}
+	it.AuthorHandle = nullString(authorHandle)
+	it.AuthorName = nullString(authorName)
+	it.AuthorProfileImageURL = nullString(authorProfile)
+	it.PostedAt = nullStringPtr(postedAt)
+	it.BookmarkedAt = nullStringPtr(bookmarkedAt)
+	it.Categories = parseCsv(categories)
+	it.PrimaryCategory = nullStringPtr(primaryCategory)
+	it.Domains = parseCsv(domains)
+	it.PrimaryDomain = nullStringPtr(primaryDomain)
+	it.GithubURLs = parseJSONArray(githubURLs)
+	it.Links = parseJSONArray(linksJSON)
+	it.MediaCount = int(nullInt(mediaCount))
+	it.LinkCount = int(nullInt(linkCount))
+	it.LikeCount = nullIntPtr(like)
+	it.RepostCount = nullIntPtr(repost)
+	it.ReplyCount = nullIntPtr(reply)
+	it.QuoteCount = nullIntPtr(quote)
+	it.BookmarkCount = nullIntPtr(bookmark)
+	it.ViewCount = nullIntPtr(view)
+	it.FolderIDs = parseJSONArray(folderIDs)
+	it.FolderNames = parseJSONArray(folderNames)
+	it.ArticleTitle = nullStringPtr(articleTitle)
+	it.ArticleText = nullStringPtr(articleText)
+	it.ArticleSite = nullStringPtr(articleSite)
+	it.SyncedAt = nullStringPtr(syncedAt)
+	it.EnrichedAt = nullStringPtr(enrichedAt)
+	it.QuotedStatusID = nullStringPtr(quotedStatusID)
+	it.QuotedTweet = parseQuotedTweet(quotedTweetJSON)
+	return it, nil
+}
+
+func nullString(n sql.NullString) string {
+	if n.Valid {
+		return n.String
+	}
+	return ""
+}
+
+func nullStringPtr(n sql.NullString) *string {
+	if !n.Valid {
+		return nil
+	}
+	v := n.String
+	return &v
+}
+
+func nullInt(n sql.NullInt64) int64 {
+	if n.Valid {
+		return n.Int64
+	}
+	return 0
+}
+
+func nullIntPtr(n sql.NullInt64) *int {
+	if !n.Valid {
+		return nil
+	}
+	v := int(n.Int64)
+	return &v
+}
+
+// ListBookmarks mirrors listBookmarks().
+func ListBookmarks(filters TimelineFilters) ([]model.BookmarkTimelineItem, error) {
+	db, err := OpenDB(paths.IndexPath())
+	if err != nil {
+		return nil, err
+	}
+	defer db.Close()
+	if err := EnsureMigrations(db); err != nil {
+		return nil, err
+	}
+	limit := filters.Limit
+	if limit == 0 {
+		limit = 30
+	}
+	offset := filters.Offset
+
+	where, params := buildBookmarkWhereClause(filters)
+	sortDir := filters.Sort
+	if sortDir == "" {
+		sortDir = "desc"
+	}
+	sqlStr := timelineSelect + " " + where + " " + bookmarkSortClause(sortDir) + " LIMIT ? OFFSET ?"
+	params = append(params, limit, offset)
+
+	rows, err := db.Query(sqlStr, params...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []model.BookmarkTimelineItem{}
+	for rows.Next() {
+		it, err := mapTimelineRow(rows)
+		if err != nil {
+			return nil, err
+		}
+		items = append(items, it)
+	}
+	return items, rows.Err()
+}
+
+// GetBookmarkByID mirrors getBookmarkById().
+func GetBookmarkByID(id string) (*model.BookmarkTimelineItem, error) {
+	db, err := OpenDB(paths.IndexPath())
+	if err != nil {
+		return nil, err
+	}
+	defer db.Close()
+	if err := EnsureMigrations(db); err != nil {
+		return nil, err
+	}
+	rows, err := db.Query(timelineSelect+" WHERE b.id = ? LIMIT 1", id)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	if !rows.Next() {
+		return nil, nil
+	}
+	it, err := mapTimelineRow(rows)
+	if err != nil {
+		return nil, err
+	}
+	return &it, nil
+}
+
+// Stats mirrors getStats().
+type Stats struct {
+	TotalBookmarks    int             `json:"totalBookmarks"`
+	UniqueAuthors     int             `json:"uniqueAuthors"`
+	DateRange         DateRange       `json:"dateRange"`
+	TopAuthors        []AuthorCount   `json:"topAuthors"`
+	LanguageBreakdown []LanguageCount `json:"languageBreakdown"`
+}
+
+// DateRange mirrors the stats date range.
+type DateRange struct {
+	Earliest *string `json:"earliest"`
+	Latest   *string `json:"latest"`
+}
+
+// AuthorCount is a handle/count pair.
+type AuthorCount struct {
+	Handle string `json:"handle"`
+	Count  int    `json:"count"`
+}
+
+// LanguageCount is a language/count pair.
+type LanguageCount struct {
+	Language string `json:"language"`
+	Count    int    `json:"count"`
+}
+
+func chronologicalDateRange(values []string) DateRange {
+	var earliestMs int64 = 1<<63 - 1
+	var latestMs int64 = -(1 << 63)
+	var earliest *string
+	var latest *string
+	for _, v := range values {
+		vv := v
+		ms, ok := dateutil.ParseTimestampMs(&vv)
+		if !ok {
+			continue
+		}
+		iso := dateutil.ToIsoDate(&vv)
+		if iso == nil {
+			continue
+		}
+		if ms < earliestMs {
+			earliestMs = ms
+			earliest = iso
+		}
+		if ms > latestMs {
+			latestMs = ms
+			latest = iso
+		}
+	}
+	return DateRange{Earliest: earliest, Latest: latest}
+}
+
+// GetStats mirrors getStats().
+func GetStats() (Stats, error) {
+	db, err := OpenDB(paths.IndexPath())
+	if err != nil {
+		return Stats{}, err
+	}
+	defer db.Close()
+
+	var total, authors int
+	if err := db.QueryRow("SELECT COUNT(*) FROM bookmarks").Scan(&total); err != nil {
+		total = 0
+	}
+	if err := db.QueryRow("SELECT COUNT(DISTINCT author_handle) FROM bookmarks").Scan(&authors); err != nil {
+		authors = 0
+	}
+
+	var postedAt []string
+	if rows, err := db.Query("SELECT posted_at FROM bookmarks WHERE posted_at IS NOT NULL"); err == nil {
+		for rows.Next() {
+			var v sql.NullString
+			if err := rows.Scan(&v); err == nil && v.Valid {
+				postedAt = append(postedAt, v.String)
+			}
+		}
+		rows.Close()
+	}
+	rangeVal := chronologicalDateRange(postedAt)
+
+	topAuthors := []AuthorCount{}
+	if rows, err := db.Query(`SELECT author_handle, COUNT(*) as c FROM bookmarks
+       WHERE author_handle IS NOT NULL
+       GROUP BY author_handle ORDER BY c DESC LIMIT 15`); err == nil {
+		for rows.Next() {
+			var a AuthorCount
+			if err := rows.Scan(&a.Handle, &a.Count); err == nil {
+				topAuthors = append(topAuthors, a)
+			}
+		}
+		rows.Close()
+	}
+
+	langs := []LanguageCount{}
+	if rows, err := db.Query(`SELECT language, COUNT(*) as c FROM bookmarks
+       WHERE language IS NOT NULL
+       GROUP BY language ORDER BY c DESC LIMIT 10`); err == nil {
+		for rows.Next() {
+			var l LanguageCount
+			if err := rows.Scan(&l.Language, &l.Count); err == nil {
+				langs = append(langs, l)
+			}
+		}
+		rows.Close()
+	}
+
+	return Stats{
+		TotalBookmarks:    total,
+		UniqueAuthors:     authors,
+		DateRange:         rangeVal,
+		TopAuthors:        topAuthors,
+		LanguageBreakdown: langs,
+	}, nil
+}
+
+// GetCategoryCounts mirrors getCategoryCounts (excludes 'unclassified').
+func GetCategoryCounts() (map[string]int, error) {
+	db, err := OpenDB(paths.IndexPath())
+	if err != nil {
+		return nil, err
+	}
+	defer db.Close()
+	if err := EnsureMigrations(db); err != nil {
+		return nil, err
+	}
+	counts := map[string]int{}
+	rows, err := db.Query(`SELECT primary_category, COUNT(*) as c FROM bookmarks
+       WHERE primary_category IS NOT NULL AND primary_category != 'unclassified'
+       GROUP BY primary_category ORDER BY c DESC`)
+	if err != nil {
+		return counts, nil
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var k string
+		var c int
+		if err := rows.Scan(&k, &c); err == nil {
+			counts[k] = c
+		}
+	}
+	return counts, nil
+}
+
+// GetDomainCounts mirrors getDomainCounts.
+func GetDomainCounts() (map[string]int, error) {
+	db, err := OpenDB(paths.IndexPath())
+	if err != nil {
+		return nil, err
+	}
+	defer db.Close()
+	if err := EnsureMigrations(db); err != nil {
+		return nil, err
+	}
+	counts := map[string]int{}
+	rows, err := db.Query(`SELECT primary_domain, COUNT(*) as c FROM bookmarks
+       WHERE primary_domain IS NOT NULL
+       GROUP BY primary_domain ORDER BY c DESC`)
+	if err != nil {
+		return counts, nil
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var k string
+		var c int
+		if err := rows.Scan(&k, &c); err == nil {
+			counts[k] = c
+		}
+	}
+	return counts, nil
+}
+
+// FolderCounts mirrors getFolderCounts.
+type FolderCounts struct {
+	Counts   map[string]int `json:"counts"`
+	Untagged int            `json:"untagged"`
+}
+
+// CategorySample mirrors bookmarks-db.ts CategorySample.
+type CategorySample struct {
+	ID           string `json:"id"`
+	URL          string `json:"url"`
+	Text         string `json:"text"`
+	AuthorHandle string `json:"authorHandle,omitempty"`
+	Categories   string `json:"categories"`
+	GithubURLs   string `json:"githubUrls,omitempty"`
+	Links        string `json:"links,omitempty"`
+}
+
+// SampleByCategory mirrors sampleByCategory().
+func SampleByCategory(category string, limit int) ([]CategorySample, error) {
+	db, err := OpenDB(paths.IndexPath())
+	if err != nil {
+		return nil, err
+	}
+	defer db.Close()
+	if err := EnsureMigrations(db); err != nil {
+		return nil, err
+	}
+	rows, err := db.Query(`SELECT id, url, text, author_handle, categories, github_urls, links_json
+       FROM bookmarks
+       WHERE categories LIKE ?
+       ORDER BY RANDOM()
+       LIMIT ?`, "%"+category+"%", limit)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []CategorySample{}
+	for rows.Next() {
+		var s CategorySample
+		var author, cats, gh, links sql.NullString
+		if err := rows.Scan(&s.ID, &s.URL, &s.Text, &author, &cats, &gh, &links); err != nil {
+			return nil, err
+		}
+		if author.Valid {
+			s.AuthorHandle = author.String
+		}
+		if cats.Valid {
+			s.Categories = cats.String
+		}
+		if gh.Valid {
+			s.GithubURLs = gh.String
+		}
+		if links.Valid {
+			s.Links = links.String
+		}
+		out = append(out, s)
+	}
+	return out, rows.Err()
+}
+
+// GetFolderCounts mirrors getFolderCounts.
+func GetFolderCounts() (FolderCounts, error) {
+	db, err := OpenDB(paths.IndexPath())
+	if err != nil {
+		return FolderCounts{}, err
+	}
+	defer db.Close()
+	if err := EnsureMigrations(db); err != nil {
+		return FolderCounts{}, err
+	}
+	counts := map[string]int{}
+	tagged := 0
+	rows, err := db.Query(`SELECT folder_names FROM bookmarks WHERE folder_names IS NOT NULL AND folder_names != ''`)
+	if err == nil {
+		for rows.Next() {
+			var v sql.NullString
+			if err := rows.Scan(&v); err != nil {
+				continue
+			}
+			names := parseJSONArray(v)
+			if len(names) == 0 {
+				continue
+			}
+			tagged++
+			for _, name := range names {
+				counts[name]++
+			}
+		}
+		rows.Close()
+	}
+	var total int
+	if err := db.QueryRow("SELECT COUNT(*) FROM bookmarks").Scan(&total); err != nil {
+		total = 0
+	}
+	untagged := total - tagged
+	if untagged < 0 {
+		untagged = 0
+	}
+	return FolderCounts{Counts: counts, Untagged: untagged}, nil
+}
diff --git a/internal/store/schema_test.go b/internal/store/schema_test.go
new file mode 100644
index 0000000..6813a08
--- /dev/null
+++ b/internal/store/schema_test.go
@@ -0,0 +1,174 @@
+package store
+
+import (
+	"database/sql"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"fieldtheory/internal/model"
+)
+
+func jsonMarshal(v any) ([]byte, error) { return json.Marshal(v) }
+
+func writeCorpus(t *testing.T, records []model.BookmarkRecord) string {
+	t.Helper()
+	dir := t.TempDir()
+	t.Setenv("FT_DATA_DIR", dir)
+	path := filepath.Join(dir, "bookmarks.jsonl")
+	var sb strings.Builder
+	for _, r := range records {
+		b, err := jsonMarshal(r)
+		if err != nil {
+			t.Fatal(err)
+		}
+		sb.Write(b)
+		sb.WriteByte('\n')
+	}
+	if err := os.WriteFile(path, []byte(sb.String()), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return dir
+}
+
+func record(id, text, author string) model.BookmarkRecord {
+	posted := "2024-01-0" + id + "T10:00:00.000Z"
+	return model.BookmarkRecord{
+		ID: id, TweetID: "10" + id, URL: "https://x.com/" + author + "/status/" + id,
+		Text: text, AuthorHandle: author, AuthorName: author,
+		PostedAt: &posted, SyncedAt: "2024-02-01T00:00:00.000Z", Language: "en",
+	}
+}
+
+func TestSchemaContract(t *testing.T) {
+	writeCorpus(t, []model.BookmarkRecord{record("1", "machine learning tutorial", "alice")})
+	if _, _, _, err := BuildIndex(false); err != nil {
+		t.Fatal(err)
+	}
+	db, err := OpenDB(filepath.Join(os.Getenv("FT_DATA_DIR"), "bookmarks.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	var version string
+	if err := db.QueryRow("SELECT value FROM meta WHERE key='schema_version'").Scan(&version); err != nil {
+		t.Fatal(err)
+	}
+	if version != "6" {
+		t.Fatalf("schema_version = %q, want 6", version)
+	}
+
+	rows, err := db.Query("PRAGMA table_info(bookmarks)")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols := map[string]bool{}
+	count := 0
+	for rows.Next() {
+		var cid, notnull, pk int
+		var name, typ string
+		var dflt sql.NullString
+		if err := rows.Scan(&cid, &name, &typ, &notnull, &dflt, &pk); err != nil {
+			t.Fatal(err)
+		}
+		cols[name] = true
+		count++
+	}
+	rows.Close()
+	if count != 37 {
+		t.Fatalf("bookmarks has %d columns, want 37", count)
+	}
+	for _, c := range ColumnNames {
+		if !cols[c] {
+			t.Fatalf("missing column %s", c)
+		}
+	}
+
+	for _, idx := range []string{"idx_bookmarks_author", "idx_bookmarks_posted", "idx_bookmarks_language", "idx_bookmarks_category", "idx_bookmarks_domain"} {
+		var n string
+		if err := db.QueryRow("SELECT name FROM sqlite_master WHERE type='index' AND name=?", idx).Scan(&n); err != nil {
+			t.Fatalf("missing index %s: %v", idx, err)
+		}
+	}
+
+	var createSQL string
+	if err := db.QueryRow("SELECT sql FROM sqlite_master WHERE type='table' AND name='bookmarks_fts'").Scan(&createSQL); err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"content=", "content_rowid=rowid", "porter unicode61", "article_text"} {
+		if !strings.Contains(createSQL, want) {
+			t.Fatalf("fts create statement missing %q: %s", want, createSQL)
+		}
+	}
+}
+
+func TestBM25Ordering(t *testing.T) {
+	writeCorpus(t, []model.BookmarkRecord{
+		record("1", "machine learning machine learning machine learning", "alice"),
+		record("2", "machine learning tutorial", "bob"),
+		record("3", "unrelated content here", "carol"),
+	})
+	if _, _, _, err := BuildIndex(false); err != nil {
+		t.Fatal(err)
+	}
+	results, err := SearchBookmarks(SearchOptions{Query: "machine learning"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(results) < 2 {
+		t.Fatalf("expected at least 2 results, got %d", len(results))
+	}
+	for i := 1; i < len(results); i++ {
+		if results[i-1].Score > results[i].Score {
+			t.Fatalf("bm25 scores not ascending: %v", results)
+		}
+	}
+	if results[0].ID != "1" && results[0].ID != "2" {
+		t.Fatalf("unexpected top result: %v", results[0])
+	}
+}
+
+func TestPreserveClassificationOnRefresh(t *testing.T) {
+	recs := []model.BookmarkRecord{record("1", "hello world", "alice")}
+	writeCorpus(t, recs)
+	if _, _, _, err := BuildIndex(false); err != nil {
+		t.Fatal(err)
+	}
+	db, err := OpenDB(filepath.Join(os.Getenv("FT_DATA_DIR"), "bookmarks.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec("UPDATE bookmarks SET categories='tool', primary_category='tool' WHERE id='1'"); err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+
+	if _, _, _, err := BuildIndex(false); err != nil {
+		t.Fatal(err)
+	}
+	db, _ = OpenDB(filepath.Join(os.Getenv("FT_DATA_DIR"), "bookmarks.db"))
+	var primary string
+	if err := db.QueryRow("SELECT primary_category FROM bookmarks WHERE id='1'").Scan(&primary); err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+	if primary != "tool" {
+		t.Fatalf("classification not preserved on refresh: %q", primary)
+	}
+
+	if _, _, _, err := BuildIndex(true); err != nil {
+		t.Fatal(err)
+	}
+	db, _ = OpenDB(filepath.Join(os.Getenv("FT_DATA_DIR"), "bookmarks.db"))
+	err = db.QueryRow("SELECT primary_category FROM bookmarks WHERE id='1'").Scan(&primary)
+	db.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if primary != "unclassified" {
+		t.Fatalf("force rebuild should reset primary_category, got %q", primary)
+	}
+}
