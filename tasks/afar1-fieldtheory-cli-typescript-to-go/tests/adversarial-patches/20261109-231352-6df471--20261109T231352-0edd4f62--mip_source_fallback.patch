new file mode 100644
index 0000000..d2f99f4
--- /dev/null
+++ b/internal/config/config.go
@@ -0,0 +1,77 @@
+package config
+
+import (
+	"bufio"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"fieldtheory/internal/paths"
+)
+
+// LoadEnv mirrors config.ts loadEnv(): read .env.local then .env from cwd,
+// then .env.local then .env from the data dir, without overriding values
+// already present in the environment.
+func LoadEnv() {
+	dir := paths.DataDir()
+	candidates := []string{
+		filepath.Join(mustGetwd(), ".env.local"),
+		filepath.Join(mustGetwd(), ".env"),
+		filepath.Join(dir, ".env.local"),
+		filepath.Join(dir, ".env"),
+	}
+	for _, p := range candidates {
+		loadDotenvFile(p)
+	}
+}
+
+func mustGetwd() string {
+	wd, err := os.Getwd()
+	if err != nil {
+		return "."
+	}
+	return wd
+}
+
+// loadDotenvFile parses a dotenv file and sets variables that are not already
+// present in the environment ("quiet" + no-override behavior of dotenv).
+func loadDotenvFile(path string) {
+	f, err := os.Open(path)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+
+	scanner := bufio.NewScanner(f)
+	scanner.Buffer(make([]byte, 0, 64*1024), 1024*1024)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		line = strings.TrimPrefix(line, "export ")
+		eq := strings.IndexByte(line, '=')
+		if eq <= 0 {
+			continue
+		}
+		key := strings.TrimSpace(line[:eq])
+		if key == "" {
+			continue
+		}
+		value := strings.TrimSpace(line[eq+1:])
+		value = unquote(value)
+		if _, exists := os.LookupEnv(key); exists {
+			continue
+		}
+		_ = os.Setenv(key, value)
+	}
+}
+
+func unquote(v string) string {
+	if len(v) >= 2 {
+		if (v[0] == '"' && v[len(v)-1] == '"') || (v[0] == '\'' && v[len(v)-1] == '\'') {
+			return v[1 : len(v)-1]
+		}
+	}
+	return v
+}
