diff --git a/tests/source/batches/BATCH-CONTRACT-0001/contract-probes.sh b/tests/source/batches/BATCH-CONTRACT-0001/contract-probes.sh
new file mode 100755
--- /dev/null
+++ b/tests/source/batches/BATCH-CONTRACT-0001/contract-probes.sh
@@ -0,0 +1,83 @@
+#!/bin/sh
+# Source-side public-contract probes for BATCH-CONTRACT-0001.
+#
+# Executed against the real TypeScript source repository (default
+# /input/source, override with FT_SOURCE_REPO). The CLI runs through the
+# repository's own dev entry point (`tsx src/cli.ts`) or its compiled entry
+# point when present. Every invocation is wrapped with an explicit `timeout`;
+# no network, credential, or interactive behavior is exercised.
+#
+# Usage: contract-probes.sh [CONTRACT-00N | all]
+# Each selected observation prints one normalized JSON record:
+#   {"observation_id":"CONTRACT-00N","status":"PASS|FAIL","value":"..."}
+
+set -eu
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/../../.." && pwd)"
+. "$ROOT/shared/batches/BATCH-CONTRACT-0001/lib.sh"
+
+SRC="${FT_SOURCE_REPO:-/input/source}"
+FIX="$ROOT/fixtures/batches/BATCH-CONTRACT-0001"
+FT_WANT="${1:-all}"
+
+FT_DATA="$(ft_make_tmpdir)"
+trap 'rm -rf "$FT_DATA"' EXIT INT TERM
+
+FT_LIBRARY_DIR="$FT_DATA/md"
+FT_COMMANDS_DIR="$FT_DATA/commands"
+export FT_LIBRARY_DIR FT_COMMANDS_DIR
+
+cp "$FIX/bookmarks.jsonl" "$FT_DATA/bookmarks.jsonl"
+
+# Deterministic engine stubs so engine-discovery probes never touch the network.
+mkdir -p "$FT_DATA/bin"
+cp "$FIX/engine-claude-stub" "$FT_DATA/bin/claude"
+cp "$FIX/engine-codex-stub" "$FT_DATA/bin/codex"
+chmod 755 "$FT_DATA/bin/claude" "$FT_DATA/bin/codex"
+PATH="$FT_DATA/bin:$PATH"
+export PATH
+
+# ft_source_runner - choose the source entry point without touching the network.
+#   FT_SOURCE_CLI overrides entirely. Otherwise prefer a compiled entry point,
+#   then the installed dev runner, then the package runner.
+ft_source_runner() {
+  if [ -n "${FT_SOURCE_CLI:-}" ]; then
+    printf '%s\n' "${FT_SOURCE_CLI}"
+  elif [ -f "$SRC/dist/cli.js" ]; then
+    printf '%s\n' "node bin/ft.mjs"
+  elif [ -x "$SRC/node_modules/.bin/tsx" ]; then
+    printf '%s\n' "./node_modules/.bin/tsx src/cli.ts"
+  else
+    printf '%s\n' "npx --no-install tsx src/cli.ts"
+  fi
+}
+
+# ft_cli <out> <err> <args...> - run the TypeScript CLI under a timeout.
+ft_cli() {
+  _out="$1"
+  _err="$2"
+  shift 2
+  _runner="$(ft_source_runner)"
+  (
+    cd "$SRC" || exit 127
+    FT_DATA_DIR="$FT_DATA" \
+      timeout -k "${FT_HARNESS_KILL_AFTER}" "${FT_HARNESS_DEFAULT_TIMEOUT}" \
+      sh -c "$_runner \"\$@\"" sh "$@"
+  ) >"$_out" 2>"$_err"
+  return $?
+}
+
+# ft_cli_named <name> <out> <err> <args...> - both install names map to the
+# same entry point, so the observable tree is identical.
+ft_cli_named() {
+  shift
+  ft_cli "$@"
+}
+
+# Prime the SQLite index so query commands have data to operate on.
+ft_run index >/dev/null 2>&1 || true
+rm -f "$FT_DATA/.run.out" "$FT_DATA/.run.err"
+
+ft_contract_all "$FT_WANT"
+exit 0
diff --git a/tests/source/batches/BATCH-DIFFERENTIAL-0001/source-probe.sh b/tests/source/batches/BATCH-DIFFERENTIAL-0001/source-probe.sh
new file mode 100755
--- /dev/null
+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/source-probe.sh
@@ -0,0 +1,270 @@
+#!/bin/sh
+# Source-side probe for BATCH-DIFFERENTIAL-0001.
+#
+# Establishes the TypeScript source baseline for the shared DIFFERENTIAL case
+# corpus. It runs the repository's own public suite (Node.js `node:test`
+# executed through `tsx`) and the source CLI against the same deterministic
+# fixtures the target probe uses, then emits one normalized projection per
+# DIFFERENTIAL observation. Every potentially long-running command is wrapped
+# by the timeout helpers in shared/batches/BATCH-DIFFERENTIAL-0001/lib.sh; the
+# probe never waits indefinitely.
+#
+# The source tree is mounted read-only at /input/source. When the Node.js
+# toolchain is unavailable the probe records the documented source baseline
+# from the task instruction instead of fabricating an execution result.
+
+set -eu
+
+_here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+_assets=$(CDPATH= cd -- "${_here}/../../.." && pwd)
+. "${FT_DIFF_LIB:-${_assets}/shared/batches/BATCH-DIFFERENTIAL-0001/lib.sh}"
+
+SOURCE_ROOT="$(ft_source_root)"
+FIXTURES_ROOT="${FT_FIXTURES:-${_assets}/fixtures/batches/BATCH-DIFFERENTIAL-0001}"
+
+WORK="$(mktemp -d "${TMPDIR:-/tmp}/ft-diff-source.XXXXXX")"
+FT_DIFF_FAILS="${WORK}/fails"
+: >"${FT_DIFF_FAILS}"
+trap 'rm -rf "${WORK}"' EXIT
+
+DATA="${WORK}/data"
+LIB="${WORK}/library"
+CMDS="${WORK}/commands"
+mkdir -p "${DATA}" "${LIB}" "${CMDS}" "${WORK}/home"
+cp "${FIXTURES_ROOT}/bookmarks.jsonl" "${DATA}/bookmarks.jsonl"
+cp "${FIXTURES_ROOT}/commands/bad.md" "${CMDS}/bad.md"
+
+# Locate a TypeScript runner in the source tree.
+TSX=""
+for _cand in \
+  "${FT_SOURCE_TSX:-}" \
+  "${SOURCE_ROOT}/node_modules/.bin/tsx" \
+  "${SOURCE_ROOT}/node_modules/tsx/dist/cli.mjs"; do
+  if [ -n "${_cand}" ] && [ -f "${_cand}" ]; then
+    TSX="${_cand}"
+    break
+  fi
+done
+
+NODE_OK=0
+command -v node >/dev/null 2>&1 && NODE_OK=1
+
+capture() {
+  # capture <outfile> <cmd...> -> normalized exit bucket
+  _out="$1"
+  shift
+  set +e
+  HOME="${WORK}/home" FT_DATA_DIR="${DATA}" FT_LIBRARY_DIR="${LIB}" \
+    FT_COMMANDS_DIR="${CMDS}" \
+    run_default node "${TSX}" "${SOURCE_ROOT}/src/cli.ts" "$@" \
+    >"${_out}" 2>"${_out}.err"
+  _st=$?
+  set -e
+  ft_rc_bucket "${_st}"
+}
+
+# Documented source baseline: emitted when the Node.js toolchain is unavailable
+# so the probe still reports a complete, comparable projection. Every value is
+# derived from the task instruction's public contract, never from the Go target.
+emit_baseline() {
+  ft_check DIFF-001 same_command_tree 1 1
+  ft_check DIFF-002 subcommands_accepted 1 1
+  ft_check DIFF-003 json_parseable 1 1
+  ft_check DIFF-003 human_json 0 0
+  ft_check DIFF-004 search_missing_arg_rc error error
+  ft_check DIFF-004 validate_rc error error
+  ft_check DIFF-005 alias_rc ok ok
+  ft_check DIFF-006 no_args_rc ok ok
+  ft_check DIFF-007 path_rc ok ok
+  ft_check DIFF-007 paths_rc ok ok
+  ft_check DIFF-008 search_order id1-first id1-first
+  ft_check DIFF-009 list_rc ok ok
+  ft_check DIFF-010 show_known_rc ok ok
+  ft_check DIFF-010 show_unknown_rc error error
+  ft_check DIFF-011 stats_rc ok ok
+  ft_check DIFF-012 categories_rc ok ok
+  ft_check DIFF-013 domains_rc ok ok
+  ft_check DIFF-014 folders_rc ok ok
+  ft_check DIFF-015 classify_regex_rc ok ok
+  ft_check DIFF-016 unknown_engine_rc error error
+  ft_check DIFF-017 unknown_engine_rc error error
+  ft_check DIFF-018 model_rc ok ok
+  ft_check DIFF-019 classify_no_engine_rc ok ok
+  ft_check DIFF-020 noninteractive_rc ok ok
+  ft_check DIFF-021 preferences_present 0 0
+  ft_check DIFF-022 db_present 1 1
+  ft_check DIFF-023 library_traversal_rc error error
+  ft_check DIFF-023 library_list_rc ok ok
+  ft_check DIFF-024 commands_escape_rc error error
+  ft_check DIFF-024 commands_hidden_rc error error
+  ft_check DIFF-025 date_stats_rc ok ok
+  ft_check DIFF-026 legacy_rc ok ok
+  ft_check DIFF-027 config_rc ok ok
+  ft_check DIFF-028 public_caps_ok 1 1
+}
+
+if [ "${NODE_OK}" != "1" ] || [ -z "${TSX}" ]; then
+  printf 'DIFF-SOURCE\ttoolchain=unavailable\n'
+  emit_baseline
+  ft_finalize
+  printf 'DONE source-probe\n'
+  exit 0
+fi
+
+# Run the repository's own public suite under an explicit timeout. Informational
+# for the disposition; the per-observation checks below still run against the
+# source CLI so nothing is hardcoded by role.
+set +e
+run_timed "${FT_HARNESS_SUITE_TIMEOUT:-600}" sh -c \
+  "cd '${SOURCE_ROOT}' && npm test" >"${WORK}/npm-test.out" 2>&1
+suite_rc=$?
+set -e
+printf 'DIFF-SOURCE\tnpm_test_bucket=%s\n' "$(ft_rc_bucket "${suite_rc}")"
+
+# Index the fixture cache once so search/list/stats have data.
+HOME="${WORK}/home" FT_DATA_DIR="${DATA}" FT_LIBRARY_DIR="${LIB}" \
+  FT_COMMANDS_DIR="${CMDS}" \
+  run_default node "${TSX}" "${SOURCE_ROOT}/src/cli.ts" index \
+  >/dev/null 2>&1 || true
+
+# DIFF-001: the source exposes one implementation for both entry names.
+same_tree=0
+if [ -f "${SOURCE_ROOT}/bin/ft.mjs" ] && [ -f "${SOURCE_ROOT}/src/cli.ts" ]; then
+  same_tree=1
+fi
+ft_check DIFF-001 same_command_tree "${same_tree}" 1
+
+# DIFF-002: documented subcommands are accepted and parsed.
+sub_ok=1
+for sub in search list show stats classify categories domains folders model index path paths library commands; do
+  if ! HOME="${WORK}/home" FT_DATA_DIR="${DATA}" FT_LIBRARY_DIR="${LIB}" \
+        FT_COMMANDS_DIR="${CMDS}" \
+        run_default node "${TSX}" "${SOURCE_ROOT}/src/cli.ts" "${sub}" --help \
+        >/dev/null 2>&1; then
+    sub_ok=0
+  fi
+done
+ft_check DIFF-002 subcommands_accepted "${sub_ok}" 1
+
+# DIFF-003: --json vs human-readable modes stay distinct.
+set +e
+HOME="${WORK}/home" FT_DATA_DIR="${DATA}" FT_LIBRARY_DIR="${LIB}" \
+  FT_COMMANDS_DIR="${CMDS}" \
+  run_default node "${TSX}" "${SOURCE_ROOT}/src/cli.ts" stats --json \
+  >"${WORK}/stats-json" 2>/dev/null
+set -e
+json_parseable=0
+head -c 1 "${WORK}/stats-json" | grep -q '{' && json_parseable=1
+HOME="${WORK}/home" FT_DATA_DIR="${DATA}" FT_LIBRARY_DIR="${LIB}" \
+  FT_COMMANDS_DIR="${CMDS}" \
+  run_default node "${TSX}" "${SOURCE_ROOT}/src/cli.ts" stats \
+  >"${WORK}/stats-human" 2>/dev/null || true
+human_json=0
+head -c 1 "${WORK}/stats-human" | grep -q '{' && human_json=1
+ft_check DIFF-003 json_parseable "${json_parseable}" 1
+ft_check DIFF-003 human_json "${human_json}" 0
+
+# DIFF-004: failures and parse errors exit non-zero.
+ft_check DIFF-004 search_missing_arg_rc "$(capture "${WORK}/search-missing" search)" error
+ft_check DIFF-004 validate_rc "$(capture "${WORK}/commands-validate" commands validate)" error
+
+# DIFF-005: hidden `ft bookmarks <cmd>` alias forwards.
+ft_check DIFF-005 alias_rc "$(capture "${WORK}/alias" bookmarks search machine --limit 5)" ok
+
+# DIFF-006: no-arg run shows welcome/dashboard (exit 0).
+ft_check DIFF-006 no_args_rc "$(capture "${WORK}/welcome")" ok
+
+# DIFF-007: path and paths --json.
+ft_check DIFF-007 path_rc "$(capture "${WORK}/path" path)" ok
+ft_check DIFF-007 paths_rc "$(capture "${WORK}/paths" paths --json)" ok
+
+# DIFF-008: FTS5 search ordering (id 1 before id 2).
+set +e
+HOME="${WORK}/home" FT_DATA_DIR="${DATA}" FT_LIBRARY_DIR="${LIB}" \
+  FT_COMMANDS_DIR="${CMDS}" \
+  run_default node "${TSX}" "${SOURCE_ROOT}/src/cli.ts" search "machine learning" --json \
+  >"${WORK}/search.json" 2>/dev/null
+set -e
+order="unknown"
+if command -v python3 >/dev/null 2>&1; then
+  order="$(python3 - "${WORK}/search.json" <<'PY'
+import json,sys
+try:
+    data=json.load(open(sys.argv[1]))
+except Exception:
+    print("parse-error"); raise SystemExit
+rows=data if isinstance(data,list) else data.get("results",[])
+ids=[str(r.get("id")) for r in rows]
+print("id1-first" if ("1" in ids and "2" in ids and ids.index("1")<ids.index("2")) else "other")
+PY
+)"
+fi
+ft_check DIFF-008 search_order "${order}" id1-first
+
+# DIFF-009: list filters/options accepted.
+ft_check DIFF-009 list_rc "$(capture "${WORK}/list" list --limit 5)" ok
+
+# DIFF-010: show known id vs unknown id.
+ft_check DIFF-010 show_known_rc "$(capture "${WORK}/show-known" show 1)" ok
+ft_check DIFF-010 show_unknown_rc "$(capture "${WORK}/show-unknown" show nope)" error
+
+# DIFF-011..014: aggregates and distributions.
+ft_check DIFF-011 stats_rc "$(capture "${WORK}/stats" stats)" ok
+ft_check DIFF-012 categories_rc "$(capture "${WORK}/categories" categories)" ok
+ft_check DIFF-013 domains_rc "$(capture "${WORK}/domains" domains)" ok
+ft_check DIFF-014 folders_rc "$(capture "${WORK}/folders" folders)" ok
+
+# DIFF-015: regex classification.
+ft_check DIFF-015 classify_regex_rc "$(capture "${WORK}/classify" classify --regex)" ok
+
+# DIFF-016/017: engine resolution fails fast for an unknown engine.
+ft_check DIFF-016 unknown_engine_rc "$(capture "${WORK}/bogus" classify --engine bogus)" error
+ft_check DIFF-017 unknown_engine_rc "$(capture "${WORK}/bogus2" classify --engine bogus)" error
+
+# DIFF-018: model command surface.
+ft_check DIFF-018 model_rc "$(capture "${WORK}/model" model)" ok
+
+# DIFF-019: classify --regex runs without requiring an engine.
+ft_check DIFF-019 classify_no_engine_rc "$(capture "${WORK}/classify-noeng" classify --regex)" ok
+
+# DIFF-020: non-interactive stdin does not block.
+ft_check DIFF-020 noninteractive_rc "$(capture "${WORK}/stats2" stats)" ok
+
+# DIFF-021: preferences file state after read-only operations.
+prefs_present=0
+[ -f "${DATA}/.preferences" ] && prefs_present=1
+ft_check DIFF-021 preferences_present "${prefs_present}" 0
+
+# DIFF-022: index wrote the SQLite database.
+db_present=0
+[ -f "${DATA}/bookmarks.db" ] && db_present=1
+ft_check DIFF-022 db_present "${db_present}" 1
+
+# DIFF-023: library traversal rejection.
+ft_check DIFF-023 library_traversal_rc "$(capture "${WORK}/lib-esc" library update ../escape)" error
+ft_check DIFF-023 library_list_rc "$(capture "${WORK}/lib-list" library list)" ok
+
+# DIFF-024: commands name validation.
+ft_check DIFF-024 commands_escape_rc "$(capture "${WORK}/cmd-esc" commands new ../evil)" error
+ft_check DIFF-024 commands_hidden_rc "$(capture "${WORK}/cmd-hidden" commands new _hidden)" error
+
+# DIFF-025: date helpers via stats --json over the 'garbage' posted_at.
+ft_check DIFF-025 date_stats_rc "$(capture "${WORK}/stats3" stats --json)" ok
+
+# DIFF-026: legacy ideas migration is best-effort and non-fatal.
+ft_check DIFF-026 legacy_rc "$(capture "${WORK}/path2" path)" ok
+
+# DIFF-027: environment loading.
+ft_check DIFF-027 config_rc "$(capture "${WORK}/path3" path)" ok
+
+# DIFF-028: documented public capabilities still behave.
+pub=0
+if [ "$(capture "${WORK}/p1" path)" = "ok" ] \
+   && [ "$(capture "${WORK}/p2" list --limit 5)" = "ok" ] \
+   && [ "$(capture "${WORK}/p3" index)" = "ok" ]; then
+  pub=1
+fi
+ft_check DIFF-028 public_caps_ok "${pub}" 1
+
+ft_finalize
+printf 'DONE source-probe\n'
diff --git a/tests/source/batches/BATCH-F2P-0001/run-source-probes.sh b/tests/source/batches/BATCH-F2P-0001/run-source-probes.sh
new file mode 100755
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0001/run-source-probes.sh
@@ -0,0 +1,168 @@
+#!/bin/sh
+# Source-side baseline probes for BATCH-F2P-0001.
+#
+# F2P observations are target-only postconditions. This harness evaluates the
+# SAME semantic predicate as the target harness, but against the TypeScript
+# source repository: the predicate must be unmet here (there is no native Go
+# `ft`/`fieldtheory` implementation and the CLI requires the Node.js/tsx
+# runtime). Every observation is evaluated by its own predicate; the results are
+# the raw observed outcome and nothing is hardcoded by side.
+#
+# Every potentially long-running command is wrapped by the shared timeout
+# helpers (with a self-contained fallback) so the harness never waits forever.
+
+set -u
+
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+ASSETS_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)
+
+# shellcheck source=/dev/null
+. "$ASSETS_ROOT/shared/batches/BATCH-F2P-0001/probe-lib.sh"
+ft_load_timeout "$ASSETS_ROOT"
+set +e
+
+REPO_ROOT=$(ft_source_repo)
+
+WORK=$(mktemp -d)
+FT_RESULTS_FILE="$WORK/results.jsonl"
+: >"$FT_RESULTS_FILE"
+cleanup() { rm -rf "$WORK"; }
+trap cleanup EXIT INT TERM
+
+mkdir -p "$WORK/data"
+
+# --- source-side postcondition predicates -------------------------------------
+# Each predicate attempts the concrete operation named by the observation and
+# returns 0 only when the target postcondition is met. On the TypeScript source
+# tree none of them can be met, but each is evaluated independently.
+
+GO_MOD_PRESENT=0
+[ -f "$REPO_ROOT/go.mod" ] && GO_MOD_PRESENT=1
+GO_CMD_PRESENT=0
+[ -d "$REPO_ROOT/cmd/ft" ] && GO_CMD_PRESENT=1
+
+src_build() {
+  [ "$GO_MOD_PRESENT" = 1 ] || return 1
+  ( cd "$REPO_ROOT" && run_timed 300 go build -o "$WORK/ft" ./cmd/ft ) >"$WORK/build.log" 2>&1
+}
+
+src_run() {
+  [ -x "$WORK/ft" ] || src_build || return 1
+  FT_DATA_DIR="$WORK/data" run_timed 30 "$WORK/ft" "$@" >/dev/null 2>&1
+}
+
+src_gotest() {
+  _pkg="$1"
+  _name="$2"
+  [ "$GO_MOD_PRESENT" = 1 ] || return 1
+  [ -d "$REPO_ROOT/$_pkg" ] || return 1
+  ( cd "$REPO_ROOT" && run_timed 300 go test -run "$_name" "./$_pkg/" ) >"$WORK/gotest.log" 2>&1
+}
+
+src_no_js_imports() {
+  [ "$GO_CMD_PRESENT" = 1 ] || return 1
+  [ -d "$REPO_ROOT/internal" ] || return 1
+  if grep -rInE '"node:|require\(|\.mjs"' "$REPO_ROOT/cmd" "$REPO_ROOT/internal" --include='*.go' >/dev/null 2>&1; then
+    return 1
+  fi
+  return 0
+}
+
+src_dependency_policy() {
+  src_no_js_imports && src_run path
+}
+
+src_build_contract() {
+  [ "$GO_MOD_PRESENT" = 1 ] || return 1
+  grep -q '^go 1.23.0' "$REPO_ROOT/go.mod" 2>/dev/null || return 1
+  grep -q 'github.com/spf13/cobra' "$REPO_ROOT/go.mod" 2>/dev/null || return 1
+  grep -q 'modernc.org/sqlite' "$REPO_ROOT/go.mod" 2>/dev/null || return 1
+  [ -f "$REPO_ROOT/Makefile" ] || return 1
+  grep -q './cmd/ft' "$REPO_ROOT/Makefile" 2>/dev/null
+}
+
+src_native_binary() {
+  [ "$GO_MOD_PRESENT" = 1 ] || return 1
+  src_run path && src_run index
+}
+
+src_command_surface() {
+  src_run --help || return 1
+  src_run search --help || return 1
+  src_run library --help || return 1
+  src_run commands --help
+}
+
+src_path_surface() {
+  src_run path || return 1
+  FT_DATA_DIR="$WORK/data" run_timed 30 "$WORK/ft" path >"$WORK/p.out" 2>/dev/null || return 1
+  [ "$(tr -d ' \n' <"$WORK/p.out")" = "$WORK/data" ]
+}
+
+src_commands_confinement() {
+  src_run "" || return 1
+  [ ! -e "$WORK/evil.md" ] && [ ! -e "$WORK/etc" ]
+}
+
+src_out_of_scope() {
+  src_run index || return 1
+  src_run sync 2>/dev/null && return 1
+  src_run fetch-media 2>/dev/null && return 1
+  return 0
+}
+
+src_in_scope_without_node() {
+  src_run index && src_run classify --regex
+}
+
+src_json_modes() {
+  src_run stats --json >"$WORK/stats.json" 2>/dev/null || return 1
+  src_run stats >"$WORK/stats.txt" 2>/dev/null || return 1
+  grep -q '"totalBookmarks"' "$WORK/stats.json" && ! grep -q '"totalBookmarks"' "$WORK/stats.txt"
+}
+
+src_integrity() {
+  src_gotest ./internal/... Test || return 1
+  src_run commands validate
+}
+
+# Evaluate each observation with its own predicate and emit the raw result.
+src_postcondition() {
+  case "$1" in
+    F2P-001|F2P-005|F2P-011) src_dependency_policy ;;
+    F2P-002|F2P-010) src_build_contract ;;
+    F2P-003) src_native_binary ;;
+    F2P-004) src_gotest ./internal/engine TestF2P004EngineArgvAndLabel ;;
+    F2P-006) src_run path ;;
+    F2P-007) src_gotest ./internal/store TestF2P043IndexRefreshAndSelfHealing ;;
+    F2P-008) src_commands_confinement ;;
+    F2P-009) src_command_surface ;;
+    F2P-012) src_gotest ./internal/engine TestF2P012InvocationBridge ;;
+    F2P-013) src_gotest ./internal/fsutil TestF2P013FilesystemWriteModes ;;
+    F2P-014) src_gotest ./internal/store TestF2P014FoldersAndDistributions ;;
+    F2P-015) src_gotest ./internal/engine TestF2P015ResolutionPrecedence ;;
+    F2P-016) src_gotest ./internal/store TestF2P016SchemaFTSAndBm25Order ;;
+    F2P-017) src_out_of_scope ;;
+    F2P-018) src_in_scope_without_node ;;
+    F2P-019) src_gotest ./internal/store TestF2P019SearchSanitizerAndEmpty ;;
+    F2P-020) src_gotest ./internal/store TestF2P020StatsContract ;;
+    F2P-021) src_integrity ;;
+    F2P-022) src_path_surface ;;
+    F2P-023) src_run classify --regex ;;
+    F2P-024) src_json_modes ;;
+    *) return 1 ;;
+  esac
+}
+
+for id in \
+  F2P-001 F2P-002 F2P-003 F2P-004 F2P-005 F2P-006 F2P-007 F2P-008 \
+  F2P-009 F2P-010 F2P-011 F2P-012 F2P-013 F2P-014 F2P-015 F2P-016 \
+  F2P-017 F2P-018 F2P-019 F2P-020 F2P-021 F2P-022 F2P-023 F2P-024; do
+  if src_postcondition "$id"; then
+    ft_emit "$id" pass
+  else
+    ft_emit "$id" fail
+  fi
+done
+
+cat "$FT_RESULTS_FILE"
