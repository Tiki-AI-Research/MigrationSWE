+// STATE-004 (required_state, R011) - after buildIndex the bookmarks.db carries
+// the required schema: schema_version 6, the 37 documented columns in order,
+// the required indexes, and the content-linked FTS5 virtual table declared
+// `content=bookmarks, content_rowid=rowid, tokenize='porter unicode61'`.
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { loadModule, readFixture, runSql, scalar, withEnv } from './helpers.ts';
+
+const EXPECTED_COLUMNS = [
+  'id', 'tweet_id', 'url', 'text', 'author_handle', 'author_name',
+  'author_profile_image_url', 'posted_at', 'bookmarked_at', 'synced_at',
+  'conversation_id', 'in_reply_to_status_id', 'quoted_status_id', 'language',
+  'like_count', 'repost_count', 'reply_count', 'quote_count', 'bookmark_count',
+  'view_count', 'media_count', 'link_count', 'links_json', 'tags_json',
+  'ingested_via', 'categories', 'primary_category', 'github_urls', 'domains',
+  'primary_domain', 'quoted_tweet_json', 'article_title', 'article_text',
+  'article_site', 'enriched_at', 'folder_ids', 'folder_names',
+];
+
+test('STATE-004 required schema after buildIndex', async () => {
+  const db = await loadModule<any>('src/bookmarks-db.ts');
+  const core = await loadModule<any>('src/db.ts');
+
+  const dir = await mkdtemp(path.join(tmpdir(), 'ft-state4-'));
+  await writeFile(path.join(dir, 'bookmarks.jsonl'), await readFixture('bookmarks.jsonl'));
+
+  await withEnv({ FT_DATA_DIR: dir }, async () => {
+    await db.buildIndex();
+    const handle = await core.openDb(path.join(dir, 'bookmarks.db'));
+
+    const info = await runSql(handle, 'PRAGMA table_info(bookmarks)');
+    const names = info.map((row: any[]) => row[1]);
+    assert.deepEqual(names, EXPECTED_COLUMNS);
+
+    assert.equal(String(await scalar(handle, "SELECT value FROM meta WHERE key='schema_version'")), '6');
+
+    const fts = await scalar(handle, "SELECT sql FROM sqlite_master WHERE name='bookmarks_fts'");
+    assert.ok(typeof fts === 'string' && fts.includes('content=bookmarks'), 'FTS content=bookmarks');
+    assert.ok(fts.includes('content_rowid=rowid'), 'FTS content_rowid=rowid');
+    assert.ok(fts.includes("tokenize='porter unicode61'"), 'FTS porter unicode61');
+
+    const indexes = (await runSql(
+      handle,
+      "SELECT name FROM sqlite_master WHERE type='index' AND name LIKE 'idx_bookmarks_%' ORDER BY name",
+    )).map((row: any[]) => row[0]);
+    assert.deepEqual(indexes, [
+      'idx_bookmarks_author',
+      'idx_bookmarks_category',
+      'idx_bookmarks_domain',
+      'idx_bookmarks_language',
+      'idx_bookmarks_posted',
+    ]);
+
+    handle.close();
+  });
+});
