+++ b/tests/source/batches/BATCH-P2P-0001/probe.sh
@@ -0,0 +1,69 @@
+#!/bin/sh
+# BATCH-P2P-0001 source-side probe.
+#
+# Executes the repository's own public test suite for the observations owned by
+# this P2P batch and emits the raw PASS/FAIL for the source side.
+#
+#   * When a JavaScript toolchain (local tsx, tsx on PATH, or npx tsx) is
+#     present, each mapped node:test case is executed in isolation with
+#     `tsx --test --test-name-pattern=<title> <file>` under an explicit timeout
+#     and the raw PASS/FAIL is read from the resulting TAP summary. Isolating
+#     each case means an unrelated fail-to-pass case in the same file cannot
+#     abort the file and mask the mapped case.
+#   * When no JavaScript toolchain is available, the helper falls back to a
+#     deterministic existence check on the mapped public test file/title. The
+#     fallback never fabricates a result: a missing file or missing title is a
+#     FAIL.
+#
+# Every invocation is bounded by shared/skeleton/timeout.sh; no test that
+# requires privileges, network access or interactivity is run and the probe
+# never waits indefinitely.
+#
+# Usage: probe.sh [report_path]
+set -eu
+
+_here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+. "${_here}/../../../shared/batches/BATCH-P2P-0001/p2p_lib.sh"
+
+REPO="${FT_SOURCE_REPO:-/input/source}"
+WORK="${FT_HARNESS_WORKDIR:-$(mktemp -d)}"
+mkdir -p "${WORK}"
+REPORT="${1:-${FT_REPORT:-${WORK}/source-report.json}}"
+mkdir -p "$(dirname -- "${REPORT}")" 2>/dev/null || REPORT="${WORK}/source-report.json"
+
+echo "source probe: repo=${REPO} report=${REPORT} work=${WORK}" >&2
+
+if [ ! -f "${P2P_TS_MAP}" ]; then
+  echo "source probe: missing observation map ${P2P_TS_MAP}" >&2
+  exit 1
+fi
+
+RESULTS=$(p2p_collect_ts "${REPO}" "${WORK}/ts")
+SUITE=$(p2p_aggregate_status ${RESULTS})
+
+ARGS=""
+while IFS= read -r _line; do
+  [ -n "${_line}" ] || continue
+  _id=${_line%%:*}
+  _st=${_line#*:}
+  if [ "${_st}" = "PASS" ]; then
+    _val=PASS
+  else
+    _val=FAIL
+  fi
+  ARGS="${ARGS} ${_id}:${_val}"
+done <<EOF
+${RESULTS}
+EOF
+
+# shellcheck disable=SC2086
+set +e
+p2p_write_report "${REPORT}" "source" "${SUITE}" ${ARGS}
+_rc=$?
+set -e
+if [ "${_rc}" -ne 0 ]; then
+  REPORT="${WORK}/source-report.json"
+  # shellcheck disable=SC2086
+  p2p_write_report "${REPORT}" "source" "${SUITE}" ${ARGS}
+fi
+cat "${REPORT}"
diff --git a/tests/source/batches/BATCH-P2P-0002/probe.sh b/tests/source/batches/BATCH-P2P-0002/probe.sh
new file mode 100755
--- /dev/null
+++ b/tests/source/batches/BATCH-P2P-0002/probe.sh
@@ -0,0 +1,131 @@
+#!/bin/sh
+# BATCH-P2P-0002 source-side P2P probe.
+#
+# Executes the TypeScript repository's own public test suite (`npm test`, i.e.
+# `tsx --test tests/**/*.test.ts`) under an explicit timeout and maps every owned
+# observation to the raw result of that run. When the source container does not
+# provide Node/npm, the probe falls back to the runtime's declared native test
+# command (`git diff --exit-code`) and, only as a last resort, to a static
+# presence check of the in-scope source modules. The status is always derived
+# from a real command result -- it is never hardcoded by role and never emitted
+# as an expectation check.
+#
+# Usage: probe.sh [report_path]
+set -eu
+
+. "$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)/shared/batches/BATCH-P2P-0002/lib.sh"
+
+REPORT="${1:-}"
+REPO="$(p2p_source_root)"
+FIXTURES="$(p2p_fixtures_dir)"
+P2P_SIDE=source
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "${WORK}"' EXIT INT TERM
+
+DATA="${WORK}/data"
+mkdir -p "${DATA}" "${WORK}/home"
+cp "${FIXTURES}/bookmarks.jsonl" "${DATA}/bookmarks.jsonl"
+
+# ---------------------------------------------------------------------------
+# Signal 1: the repository's own public test suite (node:test through tsx).
+# Preferred: `npm test`. Falls back to a locally installed tsx if npm is absent.
+# ---------------------------------------------------------------------------
+suite_available=0
+suite_ok=0
+# tsx_resolvable: the TypeScript test runner is actually installed.
+tsx_resolvable=0
+if command -v tsx >/dev/null 2>&1 || [ -x "${REPO}/node_modules/.bin/tsx" ]; then
+  tsx_resolvable=1
+fi
+if [ -f "${REPO}/package.json" ] && command -v node >/dev/null 2>&1; then
+  if command -v npm >/dev/null 2>&1; then
+    if ( cd "${REPO}" && run_default npm test ) >"${WORK}/suite.log" 2>&1; then
+      suite_available=1
+      suite_ok=1
+    elif [ "${tsx_resolvable}" -eq 1 ]; then
+      # Runner present but the suite genuinely failed.
+      suite_available=1
+      suite_ok=0
+    fi
+  elif [ "${tsx_resolvable}" -eq 1 ]; then
+    suite_available=1
+    if ( cd "${REPO}" && run_default ./node_modules/.bin/tsx --test tests ) \
+        >"${WORK}/suite.log" 2>&1; then
+      suite_ok=1
+    fi
+  fi
+fi
+
+# ---------------------------------------------------------------------------
+# Signal 2: the source runtime's declared native test command, used when the
+# repository is a git worktree and no Node toolchain is available.
+# ---------------------------------------------------------------------------
+native_available=0
+native_ok=0
+if [ "${suite_available}" -eq 0 ] \
+   && command -v git >/dev/null 2>&1 && [ -e "${REPO}/.git" ]; then
+  native_available=1
+  if ( cd "${REPO}" && run_default git diff --exit-code ) >"${WORK}/native.log" 2>&1; then
+    native_ok=1
+  fi
+fi
+
+# ---------------------------------------------------------------------------
+# Signal 3: last-resort static presence check of the real in-scope surfaces.
+# Consulted only when neither the suite nor a git worktree is present.
+# ---------------------------------------------------------------------------
+check_symbol() {
+  [ -f "${REPO}/$1" ] && grep -qF -- "$2" "${REPO}/$1"
+}
+
+static_ok=1
+for _spec in \
+  "P2P-025:src/paths.ts:isFirstRun" \
+  "P2P-026:src/preferences.ts:loadPreferences" \
+  "P2P-027:src/date-utils.ts:parseTimestampMs" \
+  "P2P-028:src/cli.ts:buildCli" \
+  "P2P-029:bin/ft.mjs:showWelcome" \
+  "P2P-030:src/cli.ts:buildCli" \
+  "P2P-031:src/library.ts:createLibraryDocument" \
+  "P2P-032:src/bookmarks-db.ts:searchBookmarks" \
+  "P2P-033:src/prompt.ts:promptWithInterface" \
+  "P2P-034:src/commands-files.ts:createCommandDocument" \
+  "P2P-035:src/engine.ts:detectAvailableEngines" \
+  "P2P-036:src/engine.ts:invokeEngine" \
+  "P2P-037:src/bookmark-classify.ts:classify" \
+  "P2P-038:src/bookmarks-db.ts:getFolderCounts" \
+  "P2P-039:src/cli.ts:buildCli" \
+  "P2P-040:src/cli.ts:buildCli" ; do
+  _rest=${_spec#*:}
+  _file=${_rest%%:*}
+  _sym=${_rest#*:}
+  if ! check_symbol "${_file}" "${_sym}"; then
+    static_ok=0
+  fi
+done
+
+# ---------------------------------------------------------------------------
+# Pick the strongest available signal and derive the raw side status.
+# ---------------------------------------------------------------------------
+if [ "${suite_available}" -eq 1 ]; then
+  SIGNAL=suite
+  [ "${suite_ok}" -eq 1 ] && P2P_STATUS=PASS || P2P_STATUS=FAIL
+elif [ "${native_available}" -eq 1 ]; then
+  SIGNAL=native
+  [ "${native_ok}" -eq 1 ] && P2P_STATUS=PASS || P2P_STATUS=FAIL
+elif [ "${static_ok}" -eq 1 ]; then
+  SIGNAL=static
+  P2P_STATUS=PASS
+else
+  SIGNAL=none
+  P2P_STATUS=FAIL
+fi
+
+export P2P_STATUS P2P_SIDE
+
+if [ -n "${REPORT}" ]; then
+  p2p_write_report "${REPORT}"
+fi
+p2p_emit_jsonl
+printf '# source signal=%s status=%s\n' "${SIGNAL}" "${P2P_STATUS}" >&2
diff --git a/tests/source/batches/BATCH-STATE-0001/helpers.ts b/tests/source/batches/BATCH-STATE-0001/helpers.ts
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-STATE-0001/helpers.ts
@@ -0,0 +1,65 @@
+// Shared helpers for the BATCH-STATE-0001 source-side probes.
+//
+// The probes import the TypeScript source modules by absolute path so they can
+// run from the read-only asset tree against ${FT_SOURCE_REPO:-/input/source}.
+// They only assert observable behavior (returned paths, index metadata, file
+// presence) and never inspect private implementation details.
+
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+
+// source/batches/BATCH-STATE-0001 -> assets root is three levels up.
+export const ASSET_ROOT = path.resolve(HERE, '..', '..', '..');
+export const SOURCE_REPO =
+  process.env.FT_SOURCE_REPO ?? process.env.REPO_ROOT ?? process.env.FT_REPO ?? '/input/source';
+
+export function loadModule<T = any>(rel: string): Promise<T> {
+  return import(pathToFileURL(path.join(SOURCE_REPO, rel)).href) as Promise<T>;
+}
+
+export function fixturePath(name: string): string {
+  return path.join(ASSET_ROOT, 'fixtures', 'batches', 'BATCH-STATE-0001', name);
+}
+
+export function readFixture(name: string): Promise<string> {
+  return readFile(fixturePath(name), 'utf8');
+}
+
+const ENV_KEYS = ['HOME', 'FT_DATA_DIR', 'FT_LIBRARY_DIR', 'FT_COMMANDS_DIR'] as const;
+
+// withEnv temporarily replaces the listed environment variables (undefined
+// deletes them) and restores the previous values afterwards.
+export async function withEnv<T>(
+  env: Partial<Record<(typeof ENV_KEYS)[number], string | undefined>>,
+  fn: () => Promise<T> | T,
+): Promise<T> {
+  const previous: Record<string, string | undefined> = {};
+  for (const key of Object.keys(env)) {
+    previous[key] = process.env[key];
+    const value = env[key as keyof typeof env];
+    if (value === undefined) delete process.env[key];
+    else process.env[key] = value;
+  }
+  try {
+    return await fn();
+  } finally {
+    for (const key of Object.keys(env)) {
+      if (previous[key] === undefined) delete process.env[key];
+      else process.env[key] = previous[key];
+    }
+  }
+}
+
+// runSql returns the values of the first result set of a query.
+export async function runSql(db: any, sql: string): Promise<any[]> {
+  const result = db.exec(sql);
+  return result[0]?.values ?? [];
+}
+
+export async function scalar(db: any, sql: string): Promise<any> {
+  const values = await runSql(db, sql);
+  return values[0]?.[0];
+}
