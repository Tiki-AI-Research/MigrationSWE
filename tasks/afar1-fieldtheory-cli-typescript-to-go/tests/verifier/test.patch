+#!/bin/sh
+# BATCH-STATE-0001 source probe driver.
+#
+# Runs the TypeScript source-side probes against ${REPO_ROOT:-/input/source}
+# with the repository's own test runner (`tsx --test`, matching `npm test`).
+# Each probe prints `STATE-00N<TAB>pass|fail`; the driver exits non-zero if any
+# probe fails. Every invocation is wrapped with the shared timeout helpers.
+
+set -eu
+
+HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+# shellcheck source=/dev/null
+. "$HERE/../../../shared/batches/BATCH-STATE-0001/lib.sh"
+
+: "${FT_BUILD_TIMEOUT:=300}"
+
+# Report an explicit result for every owned observation so the runtime report is
+# always complete, even when a toolchain precondition fails.
+report_all_fail() {
+  for obs in STATE-001 STATE-002 STATE-003 STATE-004; do
+    printf '%s\tfail\n' "$obs"
+  done
+}
+
+repo=$(ft_source_repo)
+if [ ! -d "$repo" ]; then
+  printf '  error: source repository not found: %s\n' "$repo" >&2
+  report_all_fail
+  exit 1
+fi
+
+tsx=""
+if [ -x "$repo/node_modules/.bin/tsx" ]; then
+  tsx="$repo/node_modules/.bin/tsx"
+elif command -v npx >/dev/null 2>&1; then
+  tsx="npx --no-install tsx"
+elif command -v tsx >/dev/null 2>&1; then
+  tsx="tsx"
+fi
+if [ -z "$tsx" ]; then
+  printf '  error: tsx runner not available for %s\n' "$repo" >&2
+  report_all_fail
+  exit 1
+fi
+
+export REPO_ROOT="$repo"
+export REPO_ROOT="$repo"
+
+status=0
+for obs in STATE-001 STATE-002 STATE-003 STATE-004; do
+  file="$HERE/$(printf '%s' "$obs" | tr 'A-Z' 'a-z').test.ts"
+  # shellcheck disable=SC2086
+  if run_timed "$FT_BUILD_TIMEOUT" $tsx --test "$file" >/dev/null 2>&1; then
+    printf '%s\tpass\n' "$obs"
+  else
+    printf '%s\tfail\n' "$obs"
+    status=1
+  fi
+done
+
+exit "$status"
