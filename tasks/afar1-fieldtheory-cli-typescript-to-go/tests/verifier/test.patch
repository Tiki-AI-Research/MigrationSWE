diff --git a/tests/shared/skeleton/README.md b/tests/shared/skeleton/README.md
new file mode 100644
--- /dev/null
+++ b/tests/shared/skeleton/README.md
@@ -0,0 +1,27 @@
+# Migration test-asset skeleton
+
+Shared scaffolding for the TypeScript (`source`) -> Go (`target`) migration test
+assets. This directory is owned by `BATCH-SKELETON-0001` and contains no
+observations or gates of its own: later batches add probes under
+`source/skeleton`, `target/skeleton`, and `fixtures/skeleton`.
+
+## Layout
+
+- `shared/skeleton/` - helpers shared by the source and target probes.
+- `source/skeleton/` - probes executed against the TypeScript source tree.
+- `target/skeleton/` - probes executed against the Go reference target.
+- `fixtures/skeleton/` - deterministic inputs used by both sides.
+- `fragments/` - one fragment file per authoring batch.
+
+## Harness rules
+
+- `source/runner` and `target/runner` are created by the INTEGRATION batch only;
+  no other batch creates, copies, or declares those paths.
+- Every potentially long-running command (`go test`, `npm test`, `cargo test`,
+  ...) MUST be wrapped by an explicit `timeout` via `shared/skeleton/timeout.sh`.
+  The harness never waits indefinitely.
+- Cases that require privileges, network access, or that can block forever are
+  excluded from the harness.
+- Probes assert observable behavior only: process exit codes, structured error
+  types/codes, JSON structure/field/ordering, presence checks, and normalized
+  numeric/boolean values.
diff --git a/tests/shared/skeleton/timeout.sh b/tests/shared/skeleton/timeout.sh
new file mode 100644
--- /dev/null
+++ b/tests/shared/skeleton/timeout.sh
@@ -0,0 +1,53 @@
+#!/bin/sh
+# Shared timeout helpers for migration test-asset probes.
+#
+# Every potentially long-running command MUST go through one of these helpers so
+# that the harness can never block indefinitely. Commands that need privileges
+# or that are expected to block (interactive TTY prompts, watchers, servers)
+# MUST NOT be invoked here.
+
+set -eu
+
+# Wall-clock budget for a single probe command, in seconds.
+: "${FT_HARNESS_DEFAULT_TIMEOUT:=120}"
+# Grace period between SIGTERM and SIGKILL, in seconds.
+: "${FT_HARNESS_KILL_AFTER:=5}"
+
+# run_timed <timeout_seconds> <command> [args...]
+#   Runs <command> under `timeout`, escalating to SIGKILL after the grace period.
+run_timed() {
+  _ft_timeout="$1"
+  shift
+  timeout -k "${FT_HARNESS_KILL_AFTER}" "${_ft_timeout}" "$@"
+}
+
+# run_default <command> [args...]
+#   Runs <command> under the default wall-clock budget.
+run_default() {
+  run_timed "${FT_HARNESS_DEFAULT_TIMEOUT}" "$@"
+}
+
+# run_capture <timeout_seconds> <stdout_file> <stderr_file> <command> [args...]
+#   Runs <command> under `timeout`, capturing stdout/stderr to files. Returns the
+#   command exit status; exit status 124/137 indicates the timeout fired.
+run_capture() {
+  _ft_timeout="$1"
+  _ft_stdout="$2"
+  _ft_stderr="$3"
+  shift 3
+  set +e
+  timeout -k "${FT_HARNESS_KILL_AFTER}" "${_ft_timeout}" "$@" \
+    >"${_ft_stdout}" 2>"${_ft_stderr}"
+  _ft_status=$?
+  set -e
+  return "${_ft_status}"
+}
+
+# ft_repo_root - absolute repository working tree.
+ft_repo_root() {
+  if [ -n "${FT_REPO:-}" ]; then
+    printf '%s\n' "${FT_REPO}"
+  else
+    printf '%s\n' "/workspace/repo"
+  fi
+}
