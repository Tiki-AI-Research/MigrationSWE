+package store
+
+// F2P target-side probe overlay for BATCH-F2P-0001.
+//
+// Copied into internal/store/ of a writable copy of the Go target and executed
+// with `go test`. It asserts observable schema/index/query behavior against a
+// real SQLite database built by the target, using helper names distinct from
+// the repository's own schema_test.go.
+
+import (
+	"database/sql"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"fieldtheory/internal/model"
+)
+
+func f2pStr(s string) *string { return &s }
+
+func f2pWrite(t *testing.T, dir string, records []model.BookmarkRecord) {
+	t.Helper()
+	var sb strings.Builder
+	for _, r := range records {
+		b, err := json.Marshal(r)
+		if err != nil {
+			t.Fatal(err)
+		}
+		sb.Write(b)
+		sb.WriteByte('\n')
+	}
+	if err := os.WriteFile(filepath.Join(dir, "bookmarks.jsonl"), []byte(sb.String()), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func f2pRec(id, text, author, posted string) model.BookmarkRecord {
+	return model.BookmarkRecord{
+		ID:           id,
+		TweetID:      "10" + id,
+		URL:          "https://x.com/" + author + "/status/" + id,
+		Text:         text,
+		AuthorHandle: author,
+		AuthorName:   author,
+		PostedAt:     f2pStr(posted),
+		SyncedAt:     "2024-02-01T00:00:00.000Z",
+		Language:     "en",
+	}
+}
+
+func f2pColumns(t *testing.T, db *sql.DB) []string {
+	t.Helper()
+	rows, err := db.Query("PRAGMA table_info(bookmarks)")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	cols, err := rows.Columns()
+	if err != nil {
+		t.Fatal(err)
+	}
+	nameIdx := -1
+	for i, c := range cols {
+		if c == "name" {
+			nameIdx = i
+		}
+	}
+	if nameIdx < 0 {
+		t.Fatal("PRAGMA table_info has no name column")
+	}
+	names := []string{}
+	for rows.Next() {
+		vals := make([]any, len(cols))
+		ptrs := make([]any, len(cols))
+		for i := range vals {
+			ptrs[i] = &vals[i]
+		}
+		if err := rows.Scan(ptrs...); err != nil {
+			t.Fatal(err)
+		}
+		switch v := vals[nameIdx].(type) {
+		case string:
+			names = append(names, v)
+		case []byte:
+			names = append(names, string(v))
+		}
+	}
+	return names
+}
+
+func f2pFTSSQL(t *testing.T, db *sql.DB) string {
+	t.Helper()
+	var s sql.NullString
+	if err := db.QueryRow("SELECT sql FROM sqlite_master WHERE name='bookmarks_fts'").Scan(&s); err != nil {
+		t.Fatalf("read bookmarks_fts sql: %v", err)
+	}
+	if !s.Valid {
+		t.Fatal("bookmarks_fts virtual table not found")
+	}
+	return s.String
+}
+
+// F2P-016 / F2P-014: the index exposes exactly the 37 documented columns in
+// order, declares the content-linked FTS5 table with the FTS5 tokenizer, and
+// ranks search results by ascending bm25(bookmarks_fts, 5.0, 1.0, 1.0, 3.0).
+func TestF2P016SchemaFTSAndBm25Order(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("FT_DATA_DIR", dir)
+	f2pWrite(t, dir, []model.BookmarkRecord{
+		f2pRec("1", "machine learning machine learning machine learning", "alice", "2024-01-02T10:00:00.000Z"),
+		f2pRec("2", "machine learning tutorial", "bob", "2024-01-03T10:00:00.000Z"),
+	})
+
+	dbPath, total, _, err := BuildIndex(false)
+	if err != nil {
+		t.Fatalf("BuildIndex: %v", err)
+	}
+	if total != 2 {
+		t.Fatalf("expected 2 indexed records, got %d", total)
+	}
+	db, err := OpenDB(dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	got := f2pColumns(t, db)
+	if len(got) != len(ColumnNames) {
+		t.Fatalf("expected %d columns, got %d: %v", len(ColumnNames), len(got), got)
+	}
+	for i := range ColumnNames {
+		if got[i] != ColumnNames[i] {
+			t.Fatalf("column %d mismatch: got %q want %q", i, got[i], ColumnNames[i])
+		}
+	}
+
+	fts := f2pFTSSQL(t, db)
+	for _, needle := range []string{"content=bookmarks", "content_rowid=rowid", "tokenize='porter unicode61'", "article_text"} {
+		if !strings.Contains(fts, needle) {
+			t.Fatalf("bookmarks_fts declaration missing %q: %s", needle, fts)
+		}
+	}
+
+	var version string
+	if err := db.QueryRow("SELECT value FROM meta WHERE key='schema_version'").Scan(&version); err != nil {
+		t.Fatal(err)
+	}
+	if version != "6" {
+		t.Fatalf("expected meta.schema_version=6, got %q", version)
+	}
+
+	results, err := SearchBookmarks(SearchOptions{Query: "machine learning", Limit: 20})
+	if err != nil {
+		t.Fatalf("SearchBookmarks: %v", err)
+	}
+	if len(results) < 2 {
+		t.Fatalf("expected at least 2 search results, got %d", len(results))
+	}
+	if results[0].ID != "1" || results[1].ID != "2" {
+		t.Fatalf("expected bm25 order [1 2], got [%s %s]", results[0].ID, results[1].ID)
+	}
+}
+
+// F2P-019: FTS5 operators are sanitized into literal terms and an empty result
+// set formats as "No results found.".
+func TestF2P019SearchSanitizerAndEmpty(t *testing.T) {
+	if got := SanitizeFTSQuery("machine -learning"); got != `"machine" "-learning"` {
+		t.Fatalf("sanitize mismatch: got %q", got)
+	}
+	if got := FormatSearchResults(nil); got != "No results found." {
+		t.Fatalf("empty formatting mismatch: got %q", got)
+	}
+}
+
+// F2P-007 / F2P-019 / F2P-020 / F2P-023: refreshing an existing index that
+// lacks the domains and article_text columns self-heals by inspecting column
+// existence, preserves a previously stored primary_category, and resets it to
+// "unclassified" only after --force.
+func TestF2P043IndexRefreshAndSelfHealing(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("FT_DATA_DIR", dir)
+	f2pWrite(t, dir, []model.BookmarkRecord{
+		f2pRec("1", "machine learning", "alice", "2024-01-02T10:00:00.000Z"),
+	})
+
+	dbPath := filepath.Join(dir, "bookmarks.db")
+	db, err := OpenDB(dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	legacy := `CREATE TABLE bookmarks (
+    id TEXT PRIMARY KEY, tweet_id TEXT NOT NULL, url TEXT NOT NULL, text TEXT NOT NULL,
+    author_handle TEXT, author_name TEXT, author_profile_image_url TEXT, posted_at TEXT,
+    bookmarked_at TEXT, synced_at TEXT NOT NULL, conversation_id TEXT, in_reply_to_status_id TEXT,
+    quoted_status_id TEXT, language TEXT, like_count INTEGER, repost_count INTEGER, reply_count INTEGER,
+    quote_count INTEGER, bookmark_count INTEGER, view_count INTEGER, media_count INTEGER DEFAULT 0,
+    link_count INTEGER DEFAULT 0, links_json TEXT, tags_json TEXT, ingested_via TEXT, categories TEXT,
+    primary_category TEXT, github_urls TEXT, primary_domain TEXT, quoted_tweet_json TEXT, article_title TEXT,
+    article_site TEXT, enriched_at TEXT, folder_ids TEXT, folder_names TEXT
+  )`
+	if _, err := db.Exec(legacy); err != nil {
+		t.Fatalf("create legacy table: %v", err)
+	}
+	if _, err := db.Exec(`CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT)`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`INSERT INTO meta VALUES ('schema_version','5')`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`CREATE VIRTUAL TABLE bookmarks_fts USING fts5(text, author_handle, author_name, content=bookmarks, content_rowid=rowid, tokenize='porter unicode61')`); err != nil {
+		t.Fatalf("create legacy fts: %v", err)
+	}
+	if _, err := db.Exec(`INSERT INTO bookmarks (id, tweet_id, url, text, synced_at, primary_category) VALUES ('1','101','https://x.com/a/status/1','machine learning','2024-02-01T00:00:00.000Z','tool')`); err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+
+	if _, _, _, err := BuildIndex(false); err != nil {
+		t.Fatalf("refresh BuildIndex: %v", err)
+	}
+	db, err = OpenDB(dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols := f2pColumns(t, db)
+	for _, needle := range []string{"domains", "primary_domain", "article_text"} {
+		found := false
+		for _, c := range cols {
+			if c == needle {
+				found = true
+			}
+		}
+		if !found {
+			t.Fatalf("expected self-healing migration to add column %q; columns=%v", needle, cols)
+		}
+	}
+	var pc string
+	if err := db.QueryRow("SELECT primary_category FROM bookmarks WHERE id='1'").Scan(&pc); err != nil {
+		t.Fatal(err)
+	}
+	if pc != "tool" {
+		t.Fatalf("expected primary_category preserved as %q on refresh, got %q", "tool", pc)
+	}
+	fts := f2pFTSSQL(t, db)
+	if !strings.Contains(fts, "article_text") {
+		t.Fatalf("expected FTS rebuilt with article_text column: %s", fts)
+	}
+	db.Close()
+
+	if _, _, _, err := BuildIndex(true); err != nil {
+		t.Fatalf("force BuildIndex: %v", err)
+	}
+	db, err = OpenDB(dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if err := db.QueryRow("SELECT primary_category FROM bookmarks WHERE id='1'").Scan(&pc); err != nil {
+		t.Fatal(err)
+	}
+	if pc != "unclassified" {
+		t.Fatalf("expected primary_category reset to %q after --force, got %q", "unclassified", pc)
+	}
+}
+
+// F2P-020: aggregate stats report totals, unique authors, the posted_at date
+// range, top authors and the language breakdown.
+func TestF2P020StatsContract(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("FT_DATA_DIR", dir)
+	recs := []model.BookmarkRecord{
+		f2pRec("1", "one", "alice", "2024-01-02T10:00:00.000Z"),
+		f2pRec("2", "two", "bob", "2024-01-03T10:00:00Z"),
+	}
+	recs[1].Language = "fr"
+	f2pWrite(t, dir, recs)
+	if _, _, _, err := BuildIndex(false); err != nil {
+		t.Fatal(err)
+	}
+	stats, err := GetStats()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stats.TotalBookmarks != 2 {
+		t.Fatalf("expected 2 total bookmarks, got %d", stats.TotalBookmarks)
+	}
+	if stats.UniqueAuthors != 2 {
+		t.Fatalf("expected 2 unique authors, got %d", stats.UniqueAuthors)
+	}
+	if stats.DateRange.Earliest == nil || *stats.DateRange.Earliest != "2024-01-02" {
+		t.Fatalf("unexpected earliest date: %v", stats.DateRange.Earliest)
+	}
+	if stats.DateRange.Latest == nil || *stats.DateRange.Latest != "2024-01-03" {
+		t.Fatalf("unexpected latest date: %v", stats.DateRange.Latest)
+	}
+	if len(stats.LanguageBreakdown) == 0 {
+		t.Fatal("expected a language breakdown")
+	}
+}
+
+// F2P-014: folder counts report per-folder totals plus an untagged count, and
+// category/domain distributions are sorted by count.
+func TestF2P014FoldersAndDistributions(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("FT_DATA_DIR", dir)
+	r1 := f2pRec("1", "one", "alice", "2024-01-02T10:00:00.000Z")
+	r1.FolderIDs = []string{"f1"}
+	r1.FolderNames = []string{"Foo"}
+	r2 := f2pRec("2", "two", "bob", "2024-01-03T10:00:00.000Z")
+	r2.FolderIDs = []string{"f1"}
+	r2.FolderNames = []string{"Foo"}
+	f2pWrite(t, dir, []model.BookmarkRecord{r1, r2})
+
+	dbPath, _, _, err := BuildIndex(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db, err := OpenDB(dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec("UPDATE bookmarks SET primary_category='tool' WHERE id='1'"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec("UPDATE bookmarks SET primary_category='security' WHERE id='2'"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec("UPDATE bookmarks SET domains='ai', primary_domain='ai' WHERE id='1'"); err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+
+	folders, err := GetFolderCounts()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if folders.Counts["Foo"] != 2 {
+		t.Fatalf("expected folder Foo count 2, got %v", folders.Counts)
+	}
+	if folders.Untagged != 0 {
+		t.Fatalf("expected 0 untagged, got %d", folders.Untagged)
+	}
+
+	cats, err := GetCategoryCounts()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := cats["unclassified"]; ok {
+		t.Fatalf("category distribution must exclude the unclassified placeholder: %v", cats)
+	}
+
+	domains, err := GetDomainCounts()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if domains["ai"] != 1 {
+		t.Fatalf("expected domain ai count 1, got %v", domains)
+	}
+}
diff --git a/tests/target/batches/BATCH-F2P-0001/run-target-probes.sh b/tests/target/batches/BATCH-F2P-0001/run-target-probes.sh
new file mode 100755
--- /dev/null
+++ b/tests/target/batches/BATCH-F2P-0001/run-target-probes.sh
@@ -0,0 +1,260 @@
+#!/bin/sh
+# Target-side probes for BATCH-F2P-0001 (TypeScript -> Go migration).
+#
+# Builds the Go `ft`/`fieldtheory` binary from the target repository, exercises
+# the migrated responsibilities, overlays the F2P Go probe tests into a writable
+# copy, and emits one JSON result object per observation on stdout (and into
+# $FT_RESULTS_FILE when set). Every long-running command is wrapped by the
+# shared timeout helpers; nothing waits indefinitely.
+
+set -u
+
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+ASSETS_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)
+
+# shellcheck source=/dev/null
+. "$ASSETS_ROOT/shared/batches/BATCH-F2P-0001/probe-lib.sh"
+ft_load_timeout "$ASSETS_ROOT"
+set +e
+
+REPO_ROOT=$(ft_target_repo)
+FIXTURES="$ASSETS_ROOT/fixtures/batches/BATCH-F2P-0001"
+PROBES="$SCRIPT_DIR/probes"
+
+WORK=$(mktemp -d)
+FT_RESULTS_FILE="$WORK/results.jsonl"
+: >"$FT_RESULTS_FILE"
+cleanup() { rm -rf "$WORK"; }
+trap cleanup EXIT INT TERM
+
+BIN="$WORK/bin/ft"
+BIN_ALT="$WORK/bin/fieldtheory"
+DATA="$WORK/data"
+NODE_ABSENT=0
+ft_node_absent && NODE_ABSENT=1
+
+mkdir -p "$WORK/bin" "$DATA"
+cp "$FIXTURES/bookmarks.jsonl" "$DATA/bookmarks.jsonl"
+
+# --- build the native binaries -------------------------------------------------
+BUILD_OK=0
+if ( cd "$REPO_ROOT" && run_timed 300 go build -o "$BIN" ./cmd/ft ) >"$WORK/build.log" 2>&1; then
+  if ( cd "$REPO_ROOT" && run_timed 300 go build -o "$BIN_ALT" ./cmd/ft ) >>"$WORK/build.log" 2>&1; then
+    BUILD_OK=1
+  fi
+fi
+ft_note "build_ok=$BUILD_OK node_absent=$NODE_ABSENT"
+
+# index the fixture cache for the CLI probes
+if [ "$BUILD_OK" = 1 ]; then
+  FT_DATA_DIR="$DATA" run_timed 60 "$BIN" index >/dev/null 2>&1 || true
+fi
+
+# --- overlay the Go probe tests into a writable copy ---------------------------
+GOTEST_LOG="$WORK/gotest.log"
+GOTEST_OK=0
+if [ "$BUILD_OK" = 1 ]; then
+  OVERLAY="$WORK/overlay"
+  if cp -a "$REPO_ROOT" "$OVERLAY" 2>/dev/null; then
+    rm -rf "$OVERLAY/.git"
+    mkdir -p "$OVERLAY/internal/engine" "$OVERLAY/internal/store" "$OVERLAY/internal/fsutil"
+    cp "$PROBES/engine_probe_test.go" "$OVERLAY/internal/engine/zz_f2p_probe_test.go"
+    cp "$PROBES/store_probe_test.go" "$OVERLAY/internal/store/zz_f2p_probe_test.go"
+    cp "$PROBES/fsutil_probe_test.go" "$OVERLAY/internal/fsutil/zz_f2p_probe_test.go"
+    if ( cd "$OVERLAY" && run_timed 600 go test -v ./internal/engine/ ./internal/store/ ./internal/fsutil/ ) >"$GOTEST_LOG" 2>&1; then
+      GOTEST_OK=1
+    fi
+  fi
+fi
+ft_note "overlay_go_test_ok=$GOTEST_OK"
+
+test_ok() {
+  [ "$GOTEST_OK" = 1 ] && grep -q -- "--- PASS: $1" "$GOTEST_LOG"
+}
+
+# --- predicate helpers (shared by multiple observations) -----------------------
+dep_policy_ok() {
+  [ "$NODE_ABSENT" = 1 ] || return 1
+  [ "$BUILD_OK" = 1 ] || return 1
+  ft_has_js_runtime_imports "$REPO_ROOT" && return 1
+  FT_DATA_DIR="$DATA" run_timed 30 "$BIN" path >/dev/null 2>&1
+}
+
+same_command_tree_ok() {
+  [ "$BUILD_OK" = 1 ] || return 1
+  run_timed 30 "$BIN" --help >"$WORK/help_ft.txt" 2>&1 || return 1
+  run_timed 30 "$BIN_ALT" --help >"$WORK/help_alt.txt" 2>&1 || return 1
+  sed 's/fieldtheory/ft/g' "$WORK/help_alt.txt" | diff - "$WORK/help_ft.txt" >/dev/null 2>&1
+}
+
+build_contract_ok() {
+  [ "$BUILD_OK" = 1 ] || return 1
+  grep -q '^go 1.23.0' "$REPO_ROOT/go.mod" || return 1
+  grep -q 'github.com/spf13/cobra' "$REPO_ROOT/go.mod" || return 1
+  grep -q 'modernc.org/sqlite' "$REPO_ROOT/go.mod" || return 1
+  grep -q './cmd/ft' "$REPO_ROOT/Makefile" || return 1
+}
+
+native_binary_ok() {
+  [ "$NODE_ABSENT" = 1 ] || return 1
+  [ "$BUILD_OK" = 1 ] || return 1
+  FT_DATA_DIR="$DATA" run_timed 30 "$BIN" path >/dev/null 2>&1 || return 1
+  FT_DATA_DIR="$DATA" run_timed 60 "$BIN" index >/dev/null 2>&1
+}
+
+command_surface_ok() {
+  [ "$BUILD_OK" = 1 ] || return 1
+  run_timed 30 "$BIN" --help 2>&1 | grep -q 'path' || return 1
+  run_timed 30 "$BIN" --help 2>&1 | grep -q 'index' || return 1
+  run_timed 30 "$BIN" search --help >/dev/null 2>&1 || return 1
+  run_timed 30 "$BIN" library --help >/dev/null 2>&1 || return 1
+  run_timed 30 "$BIN" commands --help >/dev/null 2>&1
+}
+
+in_scope_ok() {
+  [ "$NODE_ABSENT" = 1 ] || return 1
+  [ "$BUILD_OK" = 1 ] || return 1
+  FT_DATA_DIR="$DATA" run_timed 60 "$BIN" index >/dev/null 2>&1 || return 1
+  FT_DATA_DIR="$DATA" run_timed 60 "$BIN" classify --regex >/dev/null 2>&1
+}
+
+path_surface_ok() {
+  [ "$BUILD_OK" = 1 ] || return 1
+  run_capture 30 "$WORK/p.out" "$WORK/p.err" env FT_DATA_DIR="$DATA" "$BIN" path || return 1
+  [ "$(tr -d ' \n' <"$WORK/p.out")" = "$DATA" ]
+}
+
+# -------------------------------------------------------------------------------
+relation() { # <obs_id> <0/1>
+  if [ "$2" = 1 ]; then ft_emit "$1" pass; else ft_emit "$1" fail; fi
+}
+
+# F2P-001 dependency policy through both command names
+if dep_policy_ok && same_command_tree_ok; then relation F2P-001 1; else relation F2P-001 0; fi
+
+# F2P-002 make build artifacts / go.mod pins
+if build_contract_ok; then relation F2P-002 1; else relation F2P-002 0; fi
+
+# F2P-003 native Go binary runs with node absent
+if native_binary_ok; then relation F2P-003 1; else relation F2P-003 0; fi
+
+# F2P-004 engine discovery + argv + label
+if test_ok TestF2P004EngineArgvAndLabel && test_ok TestF2P004EngineDiscoveryExecutableBit; then
+  relation F2P-004 1
+else
+  relation F2P-004 0
+fi
+
+# F2P-005 production packages carry no JS/Node imports
+if dep_policy_ok; then relation F2P-005 1; else relation F2P-005 0; fi
+
+# F2P-006 cobra root command surface
+if command_surface_ok; then relation F2P-006 1; else relation F2P-006 0; fi
+
+# F2P-007 index refresh preserves classification (R043)
+if test_ok TestF2P043IndexRefreshAndSelfHealing; then relation F2P-007 1; else relation F2P-007 0; fi
+
+# F2P-008 library/commands path confinement
+CONF_OK=0
+if [ "$BUILD_OK" = 1 ]; then
+  CMDS="$WORK/commands"; LIBS="$WORK/library"
+  mkdir -p "$CMDS" "$LIBS"
+  FT_DATA_DIR="$DATA" FT_COMMANDS_DIR="$CMDS" FT_LIBRARY_DIR="$LIBS" run_timed 30 "$BIN" commands new ../evil >/dev/null 2>&1
+  a=$?
+  FT_DATA_DIR="$DATA" FT_COMMANDS_DIR="$CMDS" FT_LIBRARY_DIR="$LIBS" run_timed 30 "$BIN" commands new _hidden >/dev/null 2>&1
+  b=$?
+  FT_DATA_DIR="$DATA" FT_COMMANDS_DIR="$CMDS" FT_LIBRARY_DIR="$LIBS" run_timed 30 "$BIN" library show ../../etc/passwd >/dev/null 2>&1
+  c=$?
+  if [ "$a" != 0 ] && [ "$b" != 0 ] && [ "$c" != 0 ] && [ ! -e "$WORK/evil.md" ] && [ ! -e "$WORK/etc" ]; then
+    CONF_OK=1
+  fi
+fi
+relation F2P-008 "$CONF_OK"
+
+# F2P-009 Go build + run entry point (R038)
+if [ "$BUILD_OK" = 1 ] && run_timed 30 "$BIN" --help >/dev/null 2>&1; then relation F2P-009 1; else relation F2P-009 0; fi
+
+# F2P-010 make build artifacts for the documented command surface (R052)
+if build_contract_ok; then relation F2P-010 1; else relation F2P-010 0; fi
+
+# F2P-011 production packages with node absent
+if dep_policy_ok; then relation F2P-011 1; else relation F2P-011 0; fi
+
+# F2P-012 engine subprocess invocation bridge
+if test_ok TestF2P012InvocationBridge; then relation F2P-012 1; else relation F2P-012 0; fi
+
+# F2P-013 filesystem durable write modes
+if test_ok TestF2P013FilesystemWriteModes; then relation F2P-013 1; else relation F2P-013 0; fi
+
+# F2P-014 folder/category/domain distributions
+if test_ok TestF2P014FoldersAndDistributions; then relation F2P-014 1; else relation F2P-014 0; fi
+
+# F2P-015 engine resolution precedence
+if test_ok TestF2P015ResolutionPrecedence; then relation F2P-015 1; else relation F2P-015 0; fi
+
+# F2P-016 schema + content-linked FTS5 + BM25 order
+if test_ok TestF2P016SchemaFTSAndBm25Order; then relation F2P-016 1; else relation F2P-016 0; fi
+
+# F2P-017 out-of-scope subcommands fail; in-scope index succeeds
+OOO_OK=0
+if [ "$BUILD_OK" = 1 ]; then
+  f=0
+  for c in "sync" "fetch-media" "install app" "app open x"; do
+    # shellcheck disable=SC2086
+    FT_DATA_DIR="$DATA" run_timed 30 "$BIN" $c >/dev/null 2>&1
+    s=$?
+    [ "$s" != 0 ] || f=1
+  done
+  if [ "$f" = 0 ] && FT_DATA_DIR="$DATA" run_timed 60 "$BIN" index >/dev/null 2>&1; then
+    OOO_OK=1
+  fi
+fi
+relation F2P-017 "$OOO_OK"
+
+# F2P-018 in-process work with node removed from PATH (R034)
+if in_scope_ok; then relation F2P-018 1; else relation F2P-018 0; fi
+
+# F2P-019 search sanitizer + index refresh (R043)
+if test_ok TestF2P043IndexRefreshAndSelfHealing && test_ok TestF2P019SearchSanitizerAndEmpty; then
+  relation F2P-019 1
+else
+  relation F2P-019 0
+fi
+
+# F2P-020 stats contract + index refresh (R043)
+if test_ok TestF2P043IndexRefreshAndSelfHealing && test_ok TestF2P020StatsContract; then
+  relation F2P-020 1
+else
+  relation F2P-020 0
+fi
+
+# F2P-021 migrated checks run the real logic (R037)
+INTEGRITY_OK=0
+if [ "$GOTEST_OK" = 1 ]; then
+  CMDBAD="$WORK/commands-bad"; mkdir -p "$CMDBAD"; printf '# Bad\n' >"$CMDBAD/bad.md"
+  FT_DATA_DIR="$DATA" FT_COMMANDS_DIR="$CMDBAD" run_timed 30 "$BIN" commands validate >/dev/null 2>&1
+  v=$?
+  [ "$v" != 0 ] && INTEGRITY_OK=1
+fi
+relation F2P-021 "$INTEGRITY_OK"
+
+# F2P-022 in-process path surface
+if path_surface_ok; then relation F2P-022 1; else relation F2P-022 0; fi
+
+# F2P-023 regex classification over real indexed data + index refresh (R043)
+if test_ok TestF2P043IndexRefreshAndSelfHealing; then relation F2P-023 1; else relation F2P-023 0; fi
+
+# F2P-024 --json vs human-readable output
+JSON_OK=0
+if [ "$BUILD_OK" = 1 ]; then
+  FT_DATA_DIR="$DATA" run_timed 30 "$BIN" stats --json >"$WORK/stats.json" 2>/dev/null
+  j=$?
+  FT_DATA_DIR="$DATA" run_timed 30 "$BIN" stats >"$WORK/stats.txt" 2>/dev/null
+  k=$?
+  if [ "$j" = 0 ] && [ "$k" = 0 ] && grep -q '"totalBookmarks"' "$WORK/stats.json" && ! grep -q '"totalBookmarks"' "$WORK/stats.txt"; then
+    JSON_OK=1
+  fi
+fi
+relation F2P-024 "$JSON_OK"
+
+cat "$FT_RESULTS_FILE"
