+# Target-side F2P probes
+
+Probes in this directory run the F2P predicates against the Go reference target
+(`FT_REPO=/input/target`, or `/workspace/repo` after migration). Each probe
+actually executes the target technology and asserts observable behavior:
+process exit codes, SQLite schema/columns, FTS5 BM25 result order, classification
+columns, JSON structure, and Go error types.
+
+Each script sets `FT_SIDE=target` before sourcing the shared `lib.sh`. When
+`FT_REPO` is not exported the helpers prefer the migrated working tree at
+`/workspace/repo` (when it is a Go repository) and otherwise fall back to the
+read-only authoring reference at `/input/target`, so the probes still execute
+during authoring.
+
+Engine-invocation, engine-argv, and prompt probes have no CLI surface; they copy
+the module into a writable temporary tree, inject `gotest/f2p_probe_test.go`,
+and run `go test ./.f2pprobe/ -run <TestF2P...>` under an explicit timeout.
+
+These probes were executed against `/input/target` during authoring and all 24
+report `PASS`.
diff --git a/tests/target/batches/BATCH-F2P-0002/gotest/f2p_probe_test.go b/tests/target/batches/BATCH-F2P-0002/gotest/f2p_probe_test.go
new file mode 100644
--- /dev/null
+++ b/tests/target/batches/BATCH-F2P-0002/gotest/f2p_probe_test.go
@@ -0,0 +1,121 @@
+package f2pprobe
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"fieldtheory/internal/engine"
+	"fieldtheory/internal/prompt"
+)
+
+func TestF2PEngineArgvAndLabel(t *testing.T) {
+	claude := engine.KnownEngines["claude"].Args("PROMPT", "m", "e")
+	wantClaude := []string{"-p", "--output-format", "text", "--model", "m", "--effort", "e", "PROMPT"}
+	if strings.Join(claude, "\x00") != strings.Join(wantClaude, "\x00") {
+		t.Fatalf("claude argv=%q want %q", claude, wantClaude)
+	}
+	codex := engine.KnownEngines["codex"].Args("PROMPT", "m", "e")
+	wantCodex := []string{"exec", "--skip-git-repo-check", "--model", "m", "--config", `model_reasoning_effort="e"`, "PROMPT"}
+	if strings.Join(codex, "\x00") != strings.Join(wantCodex, "\x00") {
+		t.Fatalf("codex argv=%q want %q", codex, wantCodex)
+	}
+	if got := engine.DescribeEngine("claude", "m", "e"); got != "claude/m/effort=e" {
+		t.Fatalf("claude label=%q", got)
+	}
+	if got := engine.DescribeEngine("codex", "m", "e"); got != "codex/m/effort=e" {
+		t.Fatalf("codex label=%q", got)
+	}
+}
+
+func stubEngine(t *testing.T, dir, name, body string) engine.ResolvedEngine {
+	t.Helper()
+	p := filepath.Join(dir, name)
+	if err := os.WriteFile(p, []byte(body), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return engine.ResolvedEngine{Name: name, Config: engine.EngineConfig{
+		Bin:  p,
+		Args: func(string, string, string) []string { return nil },
+	}}
+}
+
+func TestF2PEngineInvocation(t *testing.T) {
+	dir := t.TempDir()
+
+	trim := stubEngine(t, dir, "trim", "#!/bin/sh\ncat >/dev/null\nprintf '  hi  '\n")
+	out, err := engine.InvokeEngine(trim, "PROMPT", engine.InvokeOptions{TimeoutMS: 5000})
+	if err != nil || out != "hi" {
+		t.Fatalf("trim stdout=%q err=%v", out, err)
+	}
+
+	sleepy := stubEngine(t, dir, "sleepy", "#!/bin/sh\ncat >/dev/null\nsleep 5\n")
+	start := time.Now()
+	_, err = engine.InvokeEngine(sleepy, "PROMPT", engine.InvokeOptions{TimeoutMS: 300})
+	if time.Since(start) > 4*time.Second {
+		t.Fatal("timeout did not terminate the child promptly")
+	}
+	ie, ok := err.(*engine.EngineInvocationError)
+	if !ok || ie.Reason != engine.ReasonTimeout || !ie.Killed {
+		t.Fatalf("timeout error=%#v", err)
+	}
+
+	big := stubEngine(t, dir, "big", "#!/bin/sh\ncat >/dev/null\nhead -c 200000 /dev/zero\n")
+	_, err = engine.InvokeEngine(big, "PROMPT", engine.InvokeOptions{TimeoutMS: 5000, MaxBuffer: 1024})
+	ie, ok = err.(*engine.EngineInvocationError)
+	if !ok || ie.Reason != engine.ReasonMaxBuf {
+		t.Fatalf("maxbuffer error=%#v", err)
+	}
+
+	exit3 := stubEngine(t, dir, "exit3", "#!/bin/sh\ncat >/dev/null\nprintf 'sk-ABCDEFGHIJKLMNOPQRSTUVWX\\n' >&2\nexit 3\n")
+	_, err = engine.InvokeEngine(exit3, "PROMPT", engine.InvokeOptions{TimeoutMS: 5000})
+	ie, ok = err.(*engine.EngineInvocationError)
+	if !ok || ie.Reason != engine.ReasonExit || ie.Code == nil || *ie.Code != 3 {
+		t.Fatalf("exit error=%#v", err)
+	}
+	if strings.Contains(ie.Stderr, "ABCDEFGHIJKLMNOPQRSTUVWX") || !strings.Contains(ie.Stderr, "REDACTED") {
+		t.Fatalf("secret not redacted: %q", ie.Stderr)
+	}
+}
+
+func TestF2PPromptCloseOnEOF(t *testing.T) {
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := os.Stdin
+	os.Stdin = r
+	defer func() { os.Stdin = old; _ = r.Close(); _ = w.Close() }()
+	_ = w.Close()
+	res := prompt.PromptText("q")
+	if res.Kind != prompt.KindClose {
+		t.Fatalf("kind=%v want close", res.Kind)
+	}
+}
+
+func TestF2PPromptInterruptOnSIGINT(t *testing.T) {
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := os.Stdin
+	os.Stdin = r
+	defer func() { os.Stdin = old; _ = r.Close(); _ = w.Close() }()
+
+	done := make(chan prompt.Result, 1)
+	go func() { done <- prompt.PromptText("q") }()
+	time.Sleep(300 * time.Millisecond)
+	_ = syscall.Kill(os.Getpid(), syscall.SIGINT)
+
+	select {
+	case res := <-done:
+		if res.Kind != prompt.KindInterrupt {
+			t.Fatalf("kind=%v want interrupt", res.Kind)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("prompt did not resolve on SIGINT")
+	}
+}
diff --git a/tests/target/batches/BATCH-F2P-0003/run-target-probes.sh b/tests/target/batches/BATCH-F2P-0003/run-target-probes.sh
new file mode 100755
--- /dev/null
+++ b/tests/target/batches/BATCH-F2P-0003/run-target-probes.sh
@@ -0,0 +1,320 @@
+#!/bin/sh
+# Target-side F2P probes for BATCH-F2P-0003.
+#
+# Builds the Go reference implementation from the target repository and
+# exercises the observable behavior of the `ft` / `fieldtheory` executable plus
+# the in-scope internal packages. Every long-running command goes through the
+# shared timeout helpers. Interactive/TTY, network and privileged operations are
+# never used.
+#
+# Emits one `OBS <observation_id> <status>` line per observation and, when a
+# report path is supplied, a JSON report consumed by the integration entry
+# point.
+#
+# Usage: run-target-probes.sh [report.json]
+
+set -eu
+
+HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+FT_ASSETS_ROOT="${FT_ASSETS_ROOT:-$(CDPATH= cd -- "$HERE/../../.." && pwd)}"
+FT_BATCH_DIR="$FT_ASSETS_ROOT/target/batches/BATCH-F2P-0003"
+FT_FIXTURES_DIR="$FT_ASSETS_ROOT/fixtures/batches/BATCH-F2P-0003"
+FT_REPORT="${1:-${FT_REPORT:-}}"
+export FT_ASSETS_ROOT FT_BATCH_DIR FT_FIXTURES_DIR FT_REPORT
+
+# shellcheck disable=SC1091
+. "$FT_ASSETS_ROOT/shared/batches/BATCH-F2P-0003/probe_lib.sh"
+
+REPO_ROOT="$(ft_resolve_repo "${REPO_ROOT:-}" cmd/ft/main.go)"
+TMP="$(ft_mktempdir)"
+trap 'rm -rf "$TMP"' EXIT INT TERM
+
+DATA_DIR="$TMP/data"
+HOME_DIR="$TMP/home"
+LIB_DIR="$TMP/lib"
+CMD_DIR="$TMP/cmd"
+mkdir -p "$DATA_DIR" "$HOME_DIR" "$LIB_DIR" "$CMD_DIR"
+cp "$FT_FIXTURES_DIR/bookmarks.jsonl" "$DATA_DIR/bookmarks.jsonl"
+
+# ---------------------------------------------------------------------------
+# Build the Go binary and a second entry-point copy.
+# ---------------------------------------------------------------------------
+BUILD_OK=0
+set +e
+( cd "$REPO_ROOT" && run_timed "$FT_BUILD_TIMEOUT" go build -o "$TMP/ft" ./cmd/ft ) \
+  >"$TMP/build.out" 2>"$TMP/build.err"
+BUILD_STATUS=$?
+set -e
+if [ "$BUILD_STATUS" -eq 0 ] && [ -x "$TMP/ft" ]; then
+  BUILD_OK=1
+  cp "$TMP/ft" "$TMP/fieldtheory"
+fi
+
+# Run the built binary against the isolated data directory. The CLI invocation
+# is bounded by the shared timeout helper so a prompt or watcher can never hang.
+ft_run() {
+  FT_DATA_DIR="$DATA_DIR" HOME="$HOME_DIR" \
+  FT_LIBRARY_DIR="$LIB_DIR" FT_COMMANDS_DIR="$CMD_DIR" \
+  run_timed "$FT_CMD_TIMEOUT" "$TMP/ft" "$@"
+}
+
+# Run with node/tsx removed from PATH (still timeout-bounded).
+ft_run_nonode() {
+  FT_DATA_DIR="$DATA_DIR" HOME="$HOME_DIR" \
+  FT_LIBRARY_DIR="$LIB_DIR" FT_COMMANDS_DIR="$CMD_DIR" \
+  PATH="/usr/bin:/bin" run_timed "$FT_CMD_TIMEOUT" "$TMP/fieldtheory" "$@"
+}
+
+# Extract the primaryCategory for a given id from `ft list --json` on stdin.
+f2p_primary_for() {
+  awk -v want="$1" '
+    /"id":/            { gsub(/[",]/, "", $2); cur=$2 }
+    /"primaryCategory":/ { gsub(/[",]/, "", $2); if (cur==want) print $2 }
+  '
+}
+
+# ===========================================================================
+# F2P-052 (R052): make build artifacts + pinned module dependencies.
+# ===========================================================================
+probe_052() {
+  if [ "$BUILD_OK" -ne 1 ]; then
+    ft_emit F2P-052 INFRA_ERROR
+    return
+  fi
+  status=PASS
+  grep -q 'go 1.23.0' "$REPO_ROOT/go.mod" || status=FAIL
+  grep -q 'spf13/cobra' "$REPO_ROOT/go.mod" || status=FAIL
+  grep -q 'modernc.org/sqlite' "$REPO_ROOT/go.mod" || status=FAIL
+  grep -q 'node\|tsx' "$REPO_ROOT/go.mod" && status=FAIL
+  [ -x "$TMP/ft" ] || status=FAIL
+  [ -x "$TMP/fieldtheory" ] || status=FAIL
+  ft_emit F2P-052 "$status"
+}
+
+# ===========================================================================
+# F2P-050 (R001): `fieldtheory path` in-process without node/tsx.
+# ===========================================================================
+probe_050() {
+  [ "$BUILD_OK" -eq 1 ] || { ft_emit F2P-050 INFRA_ERROR; return; }
+  set +e
+  out="$(ft_run_nonode path 2>"$TMP/e050")"
+  status=$?
+  set -e
+  if [ "$status" -ne 0 ]; then
+    ft_emit F2P-050 FAIL
+    return
+  fi
+  if [ "$out" = "$DATA_DIR" ]; then
+    ft_emit F2P-050 PASS
+  else
+    ft_emit F2P-050 FAIL
+  fi
+}
+
+# ===========================================================================
+# F2P-057 / F2P-062 (R034): migrated work runs with node absent.
+# ===========================================================================
+probe_057() {
+  [ "$BUILD_OK" -eq 1 ] || { ft_emit F2P-057 INFRA_ERROR; return; }
+  set +e
+  ft_run_nonode index >"$TMP/o057" 2>&1
+  a=$?
+  ft_run_nonode classify --regex >"$TMP/o057b" 2>&1
+  b=$?
+  set -e
+  if [ "$a" -eq 0 ] && [ "$b" -eq 0 ]; then ft_emit F2P-057 PASS; else ft_emit F2P-057 FAIL; fi
+}
+
+probe_062() {
+  [ "$BUILD_OK" -eq 1 ] || { ft_emit F2P-062 INFRA_ERROR; return; }
+  set +e
+  ft_run_nonode path >"$TMP/o062a" 2>&1
+  a=$?
+  ft_run_nonode index >"$TMP/o062b" 2>&1
+  b=$?
+  set -e
+  if [ "$a" -eq 0 ] && [ "$b" -eq 0 ]; then ft_emit F2P-062 PASS; else ft_emit F2P-062 FAIL; fi
+}
+
+# ===========================================================================
+# F2P-051 (R043): index refresh preserves rows; --force rebuilds.
+# ===========================================================================
+probe_051() {
+  [ "$BUILD_OK" -eq 1 ] || { ft_emit F2P-051 INFRA_ERROR; return; }
+  set +e
+  ft_run index >"$TMP/o051a" 2>&1
+  a=$?
+  ft_run index >"$TMP/o051b" 2>&1
+  b=$?
+  ft_run index --force >"$TMP/o051c" 2>&1
+  c=$?
+  set -e
+  if [ "$a" -ne 0 ] || [ "$b" -ne 0 ] || [ "$c" -ne 0 ]; then
+    ft_emit F2P-051 FAIL
+    return
+  fi
+  # Second (non-force) refresh must add zero new records.
+  if grep -q '0 new' "$TMP/o051b"; then ft_emit F2P-051 PASS; else ft_emit F2P-051 FAIL; fi
+}
+
+# ===========================================================================
+# F2P-053 (R041): `ft search --json` disables HTML escaping + camelCase keys.
+# ===========================================================================
+probe_053() {
+  [ "$BUILD_OK" -eq 1 ] || { ft_emit F2P-053 INFRA_ERROR; return; }
+  ft_run index >/dev/null 2>&1 || true
+  set +e
+  out="$(ft_run search b --json 2>"$TMP/e053")"
+  status=$?
+  set -e
+  if [ "$status" -ne 0 ]; then ft_emit F2P-053 FAIL; return; fi
+  ok=1
+  printf '%s' "$out" | grep -q '"text": "a<b>&c"' || ok=0
+  printf '%s' "$out" | grep -q 'authorHandle' || ok=0
+  printf '%s' "$out" | grep -q 'postedAt' || ok=0
+  printf '%s' "$out" | grep -q '\\u003c' && ok=0
+  printf '%s' "$out" | grep -q '\\u0026' && ok=0
+  [ "$ok" -eq 1 ] && ft_emit F2P-053 PASS || ft_emit F2P-053 FAIL
+}
+
+# ===========================================================================
+# F2P-056 (R045): `ft classify --regex` fixed priority categories.
+# ===========================================================================
+probe_056() {
+  [ "$BUILD_OK" -eq 1 ] || { ft_emit F2P-056 INFRA_ERROR; return; }
+  ft_run index >/dev/null 2>&1 || true
+  set +e
+  ft_run classify --regex >"$TMP/o056" 2>&1
+  cls=$?
+  list="$(ft_run list --json 2>"$TMP/e056")"
+  set -e
+  if [ "$cls" -ne 0 ]; then ft_emit F2P-056 FAIL; return; fi
+  sec="$(printf '%s\n' "$list" | f2p_primary_for 4)"
+  com="$(printf '%s\n' "$list" | f2p_primary_for 5)"
+  if [ "$sec" = "security" ] && [ "$com" = "commerce" ]; then
+    ft_emit F2P-056 PASS
+  else
+    ft_emit F2P-056 FAIL
+  fi
+}
+
+# ===========================================================================
+# F2P-064 (R051): hidden bookmarks alias ignores unknown flags.
+# ===========================================================================
+probe_064() {
+  [ "$BUILD_OK" -eq 1 ] || { ft_emit F2P-064 INFRA_ERROR; return; }
+  ft_run index >/dev/null 2>&1 || true
+  set +e
+  ft_run bookmarks search machine --limit 5 --unknown-flag >"$TMP/o064" 2>&1
+  status=$?
+  set -e
+  if [ "$status" -eq 0 ] && grep -q 'machine learning' "$TMP/o064"; then
+    ft_emit F2P-064 PASS
+  else
+    ft_emit F2P-064 FAIL
+  fi
+}
+
+# ===========================================================================
+# F2P-058 / F2P-061 / F2P-068 / F2P-069 (R049): traversal rejection.
+# ===========================================================================
+probe_traversal() {
+  id="$1"
+  [ "$BUILD_OK" -eq 1 ] || { ft_emit "$id" INFRA_ERROR; return; }
+  outside="$TMP/outside-evil"
+  rm -f "$outside"
+  set +e
+  ft_run commands new ../evil >"$TMP/tr1" 2>&1; r1=$?
+  ft_run commands new _hidden >"$TMP/tr2" 2>&1; r2=$?
+  ft_run library show ../../etc/passwd >"$TMP/tr3" 2>&1; r3=$?
+  set -e
+  if [ "$r1" -ne 0 ] && [ "$r2" -ne 0 ] && [ "$r3" -ne 0 ] && [ ! -e "$outside" ] && [ ! -e "$TMP/evil" ] && [ ! -e "$LIB_DIR/../../etc/passwd" ]; then
+    ft_emit "$id" PASS
+  else
+    ft_emit "$id" FAIL
+  fi
+}
+
+# ===========================================================================
+# F2P-059 (R049): library content/traversal guards.
+# ===========================================================================
+probe_059() {
+  [ "$BUILD_OK" -eq 1 ] || { ft_emit F2P-059 INFRA_ERROR; return; }
+  printf 'seed content' | ft_run library create seed --stdin >/dev/null 2>&1 || true
+  set +e
+  printf '' | ft_run library update seed --stdin >"$TMP/o059a" 2>&1; a=$?
+  printf 'changed' | ft_run library update seed --stdin >"$TMP/o059b" 2>&1; b=$?
+  printf 'changed' | ft_run library update seed --stdin --expected-sha256 deadbeef >"$TMP/o059c" 2>&1; c=$?
+  ft_run library show ../../etc/passwd >"$TMP/o059d" 2>&1; d=$?
+  ft_run library update ../escape --stdin >"$TMP/o059e" 2>&1 < /dev/null; e=$?
+  set -e
+  if [ "$a" -ne 0 ] && [ "$b" -ne 0 ] && [ "$c" -ne 0 ] && [ "$d" -ne 0 ] && [ "$e" -ne 0 ]; then
+    ft_emit F2P-059 PASS
+  else
+    ft_emit F2P-059 FAIL
+  fi
+}
+
+# ===========================================================================
+# Go-package probes (transplanted into a private working copy).
+# Covers F2P-049, 054, 055, 060, 063, 065, 066, 067, 070, 071, 072.
+# ===========================================================================
+GO_PROBE_IDS="F2P-049 F2P-054 F2P-055 F2P-060 F2P-063 F2P-065 F2P-066 F2P-067 F2P-070 F2P-071 F2P-072"
+
+run_go_probes() {
+  [ "$BUILD_OK" -eq 1 ] || {
+    for id in $GO_PROBE_IDS; do
+      ft_emit "$id" INFRA_ERROR
+    done
+    return
+  }
+  WORK="$TMP/gowork"
+  cp -a "$REPO_ROOT" "$WORK"
+  rm -rf "$WORK/.git"
+  cp "$FT_FIXTURES_DIR/go/engine_probe_test.go"      "$WORK/internal/engine/f2p_probe_test.go"
+  cp "$FT_FIXTURES_DIR/go/config_probe_test.go"      "$WORK/internal/config/f2p_probe_test.go"
+  cp "$FT_FIXTURES_DIR/go/preferences_probe_test.go" "$WORK/internal/preferences/f2p_probe_test.go"
+  cp "$FT_FIXTURES_DIR/go/dateutil_probe_test.go"    "$WORK/internal/dateutil/f2p_probe_test.go"
+  cp "$FT_FIXTURES_DIR/go/prompt_probe_test.go"      "$WORK/internal/prompt/f2p_probe_test.go"
+  cp "$FT_FIXTURES_DIR/go/cliapp_probe_test.go"      "$WORK/internal/cliapp/f2p_probe_test.go"
+
+  set +e
+  ( cd "$WORK" && run_timed "$FT_TEST_TIMEOUT" go test -count=1 -run 'TestF2P' -v \
+      ./internal/engine ./internal/config ./internal/preferences \
+      ./internal/dateutil ./internal/prompt ./internal/cliapp ) \
+    >"$TMP/gotest.out" 2>&1
+  gt=$?
+  set -e
+
+  for id in $GO_PROBE_IDS; do
+    testname="Test$(printf '%s' "$id" | tr -d '-')"
+    if grep -q -- "--- PASS: ${testname}" "$TMP/gotest.out"; then
+      ft_emit "$id" PASS
+    elif grep -q -- "--- FAIL: ${testname}" "$TMP/gotest.out"; then
+      ft_emit "$id" FAIL
+    elif [ "$gt" -eq 124 ] || [ "$gt" -eq 137 ] || [ "$gt" -eq 127 ]; then
+      ft_emit "$id" INFRA_ERROR
+    else
+      ft_emit "$id" FAIL
+    fi
+  done
+}
+
+probe_052
+probe_050
+probe_057
+probe_062
+probe_051
+probe_053
+probe_056
+probe_064
+probe_traversal F2P-058
+probe_traversal F2P-061
+probe_traversal F2P-068
+probe_traversal F2P-069
+probe_059
+run_go_probes
+
+ft_write_report target BATCH-F2P-0003 "$FT_REPORT"
+
+echo "target probes complete"
diff --git a/tests/target/batches/BATCH-P2P-0001/probe.sh b/tests/target/batches/BATCH-P2P-0001/probe.sh
new file mode 100755
--- /dev/null
+++ b/tests/target/batches/BATCH-P2P-0001/probe.sh
@@ -0,0 +1,101 @@
+#!/bin/sh
+# BATCH-P2P-0001 target-side probe.
+#
+# Executes the repository's own test suites against the Go reference target:
+#   1. `go test -v ./...` for the migrated Go packages (the target runtime's
+#      native test entry point), under an explicit timeout;
+#   2. the preserved public TypeScript suite (node:test through tsx), each
+#      mapped case executed in isolation, when a JavaScript toolchain is
+#      available.
+#
+# Each observation resolves to the matching Go test when one is mapped,
+# otherwise to the mapped public test case when the JavaScript toolchain is
+# available, otherwise to the overall Go suite result. The emitted value is the
+# same stable status wrapper used by the source probe so both sides normalize
+# to an identical value.
+#
+# Every invocation is bounded by shared/skeleton/timeout.sh; the probe never
+# waits indefinitely and never relies on privileges or network access.
+#
+# Usage: probe.sh [report_path]
+set -eu
+
+_here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+. "${_here}/../../../shared/batches/BATCH-P2P-0001/p2p_lib.sh"
+
+REPO="${FT_TARGET_REPO:-/input/target}"
+WORK="${FT_HARNESS_WORKDIR:-$(mktemp -d)}"
+mkdir -p "${WORK}"
+REPORT="${1:-${FT_REPORT:-${WORK}/target-report.json}}"
+mkdir -p "$(dirname -- "${REPORT}")" 2>/dev/null || REPORT="${WORK}/target-report.json"
+
+echo "target probe: repo=${REPO} report=${REPORT} work=${WORK}" >&2
+
+if [ ! -f "${P2P_TS_MAP}" ]; then
+  echo "target probe: missing observation map ${P2P_TS_MAP}" >&2
+  exit 1
+fi
+
+# 1. Go suite (the target runtime's native test entry point).
+set +e
+( cd "${REPO}" && run_timed 600 go test -v ./... ) > "${WORK}/go.log" 2>&1
+_go_exit=$?
+set -e
+if [ "${_go_exit}" -eq 0 ]; then
+  GO_SUITE=PASS
+else
+  GO_SUITE=FAIL
+fi
+
+# 2. Preserved public TypeScript suite, resolved per mapped case (only when a
+#    JavaScript toolchain is actually available).
+TS_RESULTS=""
+if p2p_have_js "${REPO}"; then
+  TS_RESULTS=$(p2p_collect_ts "${REPO}" "${WORK}/ts")
+fi
+
+# Per-observation status: prefer a mapped Go test, otherwise the mapped
+# TypeScript case, otherwise the overall Go suite.
+awk -F'	' '!seen[$1]++{print $1}' "${P2P_TS_MAP}" | while IFS= read -r _id; do
+  _val=""
+  _go_names=$(awk -F'	' -v id="${_id}" '$1==id{print $2}' "${P2P_GO_MAP}")
+  if [ -n "${_go_names}" ]; then
+    _val=$(p2p_go_status "${WORK}/go.log" ${_go_names})
+    [ "${_val}" = "SKIP" ] && _val=FAIL
+  fi
+  if [ -z "${_val}" ] && [ -n "${TS_RESULTS}" ]; then
+    _val=$(printf '%s\n' "${TS_RESULTS}" | grep "^${_id}:" | head -n 1 | cut -d: -f2)
+  fi
+  if [ -z "${_val}" ]; then
+    _val="${GO_SUITE}"
+  fi
+  printf '%s:%s\n' "${_id}" "${_val}"
+done > "${WORK}/target_results.txt"
+
+RESULTS=$(cat "${WORK}/target_results.txt")
+SUITE=$(p2p_aggregate_status ${RESULTS})
+
+ARGS=""
+while IFS= read -r _line; do
+  [ -n "${_line}" ] || continue
+  _id=${_line%%:*}
+  _st=${_line#*:}
+  if [ "${_st}" = "PASS" ]; then
+    _val=PASS
+  else
+    _val=FAIL
+  fi
+  ARGS="${ARGS} ${_id}:${_val}"
+done < "${WORK}/target_results.txt"
+
+# shellcheck disable=SC2086
+set +e
+p2p_write_report "${REPORT}" "target" "${SUITE}" ${ARGS}
+_rc=$?
+set -e
+if [ "${_rc}" -ne 0 ]; then
+  REPORT="${WORK}/target-report.json"
+  # shellcheck disable=SC2086
+  p2p_write_report "${REPORT}" "target" "${SUITE}" ${ARGS}
+fi
+cat "${REPORT}"
diff --git a/tests/target/batches/BATCH-P2P-0002/probe.sh b/tests/target/batches/BATCH-P2P-0002/probe.sh
new file mode 100755
--- /dev/null
+++ b/tests/target/batches/BATCH-P2P-0002/probe.sh
