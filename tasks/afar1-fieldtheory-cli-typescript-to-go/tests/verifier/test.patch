+# Source-side F2P baselines
+
+Probes in this directory run the F2P predicates against the TypeScript source
+tree (`FT_REPO=/input/source`). For every observation the source side must
+report `FAIL`: the source has no Go entry point (`cmd/ft`), no `go.mod`, and no
+in-process Go FTS5/schema/engine implementation, so the target-only
+postcondition does not hold. This establishes the F2P baseline; it is not a
+pass/fail comparison against the expectation.
+
+Each script sets `FT_SIDE=source` before sourcing the shared `lib.sh` so the
+TypeScript origin is selected even when the integration runner does not export
+`FT_REPO`.
diff --git a/tests/source/batches/BATCH-F2P-0003/run-source-probes.sh b/tests/source/batches/BATCH-F2P-0003/run-source-probes.sh
new file mode 100755
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0003/run-source-probes.sh
@@ -0,0 +1,116 @@
+#!/bin/sh
+# Source-side F2P probes for BATCH-F2P-0003.
+#
+# F2P observations are target-only post-conditions: the predicate requires the
+# Go 1.23.0 implementation to be in effect on the specific entry's
+# execution/load path. This script evaluates that same predicate against the
+# real legacy source tree, once per observation, using that observation's own
+# projected entry (its concrete legacy scope file and the concrete target
+# implementation artifact that must replace it).
+#
+# The status is derived from the projection itself - whether the required Go
+# target artifact is present and backed by Go on the entry's path - never from
+# the side or from a hardcoded value. On the TypeScript tree no such Go
+# artifact exists, so the raw observation is FAIL. An unresolvable scope
+# (missing legacy entry) is reported as INFRA_ERROR rather than being disguised
+# as a valid F2P failure.
+#
+# No probe requires root, network access or interactivity, and no command can
+# block: every external command is wrapped by the skeleton timeout helpers and
+# the probes run no long-lived process at all.
+#
+# Usage: run-source-probes.sh [report.json]
+
+set -eu
+
+HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+FT_ASSETS_ROOT="${FT_ASSETS_ROOT:-$(CDPATH= cd -- "$HERE/../../.." && pwd)}"
+FT_BATCH_DIR="$FT_ASSETS_ROOT/source/batches/BATCH-F2P-0003"
+FT_FIXTURES_DIR="$FT_ASSETS_ROOT/fixtures/batches/BATCH-F2P-0003"
+FT_REPORT="${1:-${FT_REPORT:-}}"
+export FT_ASSETS_ROOT FT_BATCH_DIR FT_FIXTURES_DIR FT_REPORT
+
+# shellcheck disable=SC1091
+. "$FT_ASSETS_ROOT/shared/batches/BATCH-F2P-0003/probe_lib.sh"
+
+REPO_ROOT="$(ft_resolve_repo "${REPO_ROOT:-}" src/engine.ts)"
+
+# Observation -> "<legacy scope file>|<legacy marker>|<target Go artifact>".
+# Each entry names its own concrete legacy entry and the concrete Go artifact
+# that the migration must put on that entry's execution/load path.
+source_projection() {
+  case "$1" in
+    F2P-049) printf 'src/engine.ts|child_process|internal/engine/engine.go' ;;
+    F2P-050) printf 'bin/ft.mjs|/usr/bin/env node|cmd/ft/main.go' ;;
+    F2P-051) printf 'src/cli.ts|commander|internal/store/store.go' ;;
+    F2P-052) printf 'bin/ft.mjs|/usr/bin/env node|go.mod' ;;
+    F2P-053) printf 'src/preferences.ts|writeFileSync|internal/store/query.go' ;;
+    F2P-054) printf 'src/preferences.ts|writeFileSync|internal/preferences/preferences.go' ;;
+    F2P-055) printf 'src/engine.ts|child_process|internal/engine/engine.go' ;;
+    F2P-056) printf 'src/bookmark-classify.ts|RegExp|internal/classify/classify.go' ;;
+    F2P-057) printf 'src/cli.ts|commander|cmd/ft/main.go' ;;
+    F2P-058) printf 'src/commands-files.ts|commandsDir|internal/commands/commands.go' ;;
+    F2P-059) printf 'src/library.ts|canonicalLibraryDir|internal/library/library.go' ;;
+    F2P-060) printf 'src/bookmark-classify-llm.ts|claude -p|internal/engine/engine.go' ;;
+    F2P-061) printf 'src/document-ops.ts|node:crypto|internal/docops/docops.go' ;;
+    F2P-062) printf 'src/cli.ts|commander|internal/cliapp/app.go' ;;
+    F2P-063) printf 'src/date-utils.ts|Date.parse|internal/dateutil/date.go' ;;
+    F2P-064) printf 'src/cli.ts|commander|internal/cliapp/app.go' ;;
+    F2P-065) printf 'src/fs.ts|node:fs/promises|internal/fsutil/fs.go' ;;
+    F2P-066) printf 'src/config.ts|dotenv|internal/config/config.go' ;;
+    F2P-067) printf 'src/config.ts|dotenv|internal/config/config.go' ;;
+    F2P-068) printf 'src/document-ops.ts|node:crypto|internal/docops/docops.go' ;;
+    F2P-069) printf 'src/companion-cli.ts|commander|internal/commands/commands.go' ;;
+    F2P-070) printf 'src/prompt.ts|node:readline|internal/prompt/prompt.go' ;;
+    F2P-071) printf 'src/date-utils.ts|Date.parse|internal/dateutil/date.go' ;;
+    F2P-072) printf 'src/config.ts|dotenv|internal/config/config.go' ;;
+    *) printf '||' ;;
+  esac
+}
+
+# Is the given Go target artifact present and backed by Go on this tree?
+# This is the target-technology predicate; it is true on the migrated tree and
+# false on the legacy tree regardless of which side is being evaluated.
+target_tech_active() {
+  _impl="$1"
+  [ -n "$_impl" ] || return 1
+  [ -f "$REPO_ROOT/$_impl" ] || return 1
+  case "$_impl" in
+    go.mod)
+      run_timed 10 grep -q 'go 1\.23\.0' "$REPO_ROOT/$_impl" 2>/dev/null
+      ;;
+    *)
+      run_timed 10 grep -qE '^[[:space:]]*package[[:space:]]+[A-Za-z_][A-Za-z0-9_]*' "$REPO_ROOT/$_impl" 2>/dev/null
+      ;;
+  esac
+}
+
+for id in $FT_OBS_LIST; do
+  proj="$(source_projection "$id")"
+  scope="${proj%%|*}"
+  rest="${proj#*|}"
+  marker="${rest%%|*}"
+  impl="${rest##*|}"
+  if [ -z "$scope" ] || [ ! -f "$REPO_ROOT/$scope" ]; then
+    # Setup/scope unresolvable: report an infrastructure error, not a failure.
+    ft_emit "$id" INFRA_ERROR
+    continue
+  fi
+  if [ -n "$marker" ] && ! run_timed 10 grep -qF -- "$marker" "$REPO_ROOT/$scope" 2>/dev/null; then
+    # The legacy entry does not carry its expected marker: the projection into
+    # this case cannot be evaluated reliably.
+    ft_emit "$id" INFRA_ERROR
+    continue
+  fi
+  if target_tech_active "$impl"; then
+    # The Go target technology is present on this entry's path.
+    ft_emit "$id" PASS
+  else
+    # Legacy TypeScript/Node entry: the required Go target projection is absent.
+    ft_emit "$id" FAIL
+  fi
+done
+
+ft_write_report source BATCH-F2P-0003 "$FT_REPORT"
+
+echo "source probes complete"
