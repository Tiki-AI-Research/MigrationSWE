+#!/bin/sh
+# BATCH-P2P-0002 target-side P2P probe.
+#
+# Builds the Go reference target, runs its own `go test ./...` suite, and
+# exercises the built `fieldtheory`/`ft` binary against the deterministic
+# fixture. Every owned observation is mapped to the raw result of these real
+# commands under an explicit timeout; the status is derived from observable exit
+# codes and JSON structure and is never hardcoded by role.
+#
+# Usage: probe.sh [report_path]
+set -eu
+
+. "$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)/shared/batches/BATCH-P2P-0002/lib.sh"
+
+REPORT="${1:-}"
+REPO="$(p2p_target_root)"
+FIXTURES="$(p2p_fixtures_dir)"
+P2P_SIDE=target
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "${WORK}"' EXIT INT TERM
+
+DATA="${WORK}/data"
+mkdir -p "${DATA}" "${WORK}/home"
+
+# ---------------------------------------------------------------------------
+# Real repository signals.
+# ---------------------------------------------------------------------------
+
+# Build the native Go binary. Fails if the entry point still needs Node.
+build_ok=0
+if [ -f "${REPO}/go.mod" ] \
+   && ( cd "${REPO}" && run_default go build -o "${WORK}/ft" ./cmd/ft ) \
+        >"${WORK}/build.log" 2>&1; then
+  build_ok=1
+fi
+FT_BIN="${WORK}/ft"
+
+# The repository's own Go test suite (target runtime native_test_commands).
+test_ok=0
+if [ -f "${REPO}/go.mod" ] \
+   && ( cd "${REPO}" && run_default go test ./... ) >"${WORK}/gotest.log" 2>&1; then
+  test_ok=1
+fi
+
+# ---------------------------------------------------------------------------
+# Behavioral smoke checks against the built binary. Bounded work only; every
+# invocation gets stdin from /dev/null and an explicit timeout.
+# ---------------------------------------------------------------------------
+run_ft() {
+  _p="$1"
+  shift
+  set +e
+  run_timed "${FT_P2P_SMOKE_TIMEOUT}" env FT_DATA_DIR="${DATA}" HOME="${WORK}/home" \
+    "${FT_BIN}" "$@" >"${WORK}/${_p}.out" 2>"${WORK}/${_p}.err"
+  _rc=$?
+  set -e
+  printf '%s' "${_rc}"
+}
+
+# json_valid <file> - true when <file> is a JSON document. Uses python3/jq when
+# present and otherwise falls back to a dependency-free structural check, so the
+# probe never depends on a toolchain that the target container may lack.
+json_valid() {
+  if command -v python3 >/dev/null 2>&1; then
+    python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$1" 2>/dev/null
+    return $?
+  fi
+  if command -v jq >/dev/null 2>&1; then
+    jq -e . "$1" >/dev/null 2>&1
+    return $?
+  fi
+  _first=$(tr -d ' \t\r\n' <"$1" | cut -c1)
+  _last=$(tr -d ' \t\r\n' <"$1" | rev | cut -c1)
+  [ -s "$1" ] && { [ "${_first}" = "{" ] || [ "${_first}" = "[" ]; } \
+    && { [ "${_last}" = "}" ] || [ "${_last}" = "]" ]; }
+}
+
+path_rc=1; index_rc=1; search_rc=1; stats_rc=1; stats_human_rc=1; folders_rc=1
+classify_rc=1; list_rc=1; searchhelp_rc=1; badname_rc=0; noargs_rc=1
+search_json_ok=0; stats_json_ok=0; stats_modes_distinct=0
+
+if [ "${build_ok}" -eq 1 ]; then
+  cp "${FIXTURES}/bookmarks.jsonl" "${DATA}/bookmarks.jsonl"
+
+  path_rc=$(run_ft path path)
+  index_rc=$(run_ft index index)
+  search_rc=$(run_ft search search "machine learning" --json)
+  stats_rc=$(run_ft stats stats --json)
+  stats_human_rc=$(run_ft statshuman stats)
+  folders_rc=$(run_ft folders folders)
+  classify_rc=$(run_ft classify classify --regex)
+  list_rc=$(run_ft list list --limit 5)
+  searchhelp_rc=$(run_ft searchhelp search --help)
+  badname_rc=$(run_ft badname commands new ../evil)
+
+  # `ft` with no arguments must succeed (welcome first-run / dashboard).
+  noargs_rc=1
+  if ( cd "${REPO}" && run_timed "${FT_P2P_SMOKE_TIMEOUT}" env FT_DATA_DIR="${DATA}" \
+        HOME="${WORK}/home" "${FT_BIN}" ) >"${WORK}/noargs.out" 2>&1; then
+    noargs_rc=0
+  fi
+
+  # `search --json` must be parseable JSON.
+  if [ "${search_rc}" -eq 0 ] && json_valid "${WORK}/search.out"; then
+    search_json_ok=1
+  fi
+  # `stats --json` must be a JSON document distinct from the human-readable mode.
+  if [ "${stats_rc}" -eq 0 ] && json_valid "${WORK}/stats.out"; then
+    stats_json_ok=1
+  fi
+  if [ "${stats_human_rc}" -eq 0 ] && ! json_valid "${WORK}/statshuman.out" \
+     && [ "${stats_rc}" -eq 0 ] && ! cmp -s "${WORK}/stats.out" "${WORK}/statshuman.out"; then
+    stats_modes_distinct=1
+  fi
+fi
+
+# ---------------------------------------------------------------------------
+# Derive the raw side status from the real signals.
+# ---------------------------------------------------------------------------
+if [ "${build_ok}" -eq 1 ] && [ "${test_ok}" -eq 1 ] \
+   && [ "${path_rc}" -eq 0 ] && [ "${index_rc}" -eq 0 ] && [ "${noargs_rc}" -eq 0 ] \
+   && [ "${search_json_ok}" -eq 1 ] && [ "${stats_json_ok}" -eq 1 ] \
+   && [ "${stats_human_rc}" -eq 0 ] && [ "${stats_modes_distinct}" -eq 1 ] \
+   && [ "${folders_rc}" -eq 0 ] && [ "${classify_rc}" -eq 0 ] \
+   && [ "${list_rc}" -eq 0 ] && [ "${searchhelp_rc}" -eq 0 ] && [ "${badname_rc}" -ne 0 ]; then
+  P2P_STATUS=PASS
+else
+  P2P_STATUS=FAIL
+fi
+
+export P2P_STATUS P2P_SIDE
+
+if [ -n "${REPORT}" ]; then
+  p2p_write_report "${REPORT}"
+fi
+p2p_emit_jsonl
+printf '# target build=%s test=%s status=%s\n' "${build_ok}" "${test_ok}" "${P2P_STATUS}" >&2
diff --git a/tests/target/batches/BATCH-STATE-0001/run.sh b/tests/target/batches/BATCH-STATE-0001/run.sh
new file mode 100755
--- /dev/null
+++ b/tests/target/batches/BATCH-STATE-0001/run.sh
@@ -0,0 +1,79 @@
+#!/bin/sh
+# BATCH-STATE-0001 target probe driver.
+#
+# Builds the `ft`/`fieldtheory` entry point from the repository under test
+# (${REPO_ROOT:-/workspace/repo}) plus the small SQLite inspection helper, then
+# runs one probe per STATE observation. Each probe prints:
+#
+#   STATE-00N<TAB>pass|fail
+#
+# The driver exits non-zero if any probe fails. All long-running commands are
+# wrapped with the shared timeout helpers so the harness can never block.
+
+set -eu
+
+HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+# shellcheck source=/dev/null
+. "$HERE/../../../shared/batches/BATCH-STATE-0001/lib.sh"
+
+: "${FT_BUILD_TIMEOUT:=300}"
+: "${FT_CMD_TIMEOUT:=60}"
+
+# Report an explicit result for every owned observation so the runtime report is
+# always complete, even when a toolchain precondition fails.
+report_all_fail() {
+  for obs in STATE-001 STATE-002 STATE-003 STATE-004; do
+    printf '%s\tfail\n' "$obs"
+  done
+}
+
+repo=$(ft_target_repo)
+if [ ! -d "$repo" ]; then
+  printf '  error: target repository not found: %s\n' "$repo" >&2
+  report_all_fail
+  exit 1
+fi
+
+work=$(ft_mk_workdir)
+trap 'rm -rf "$work"' EXIT INT TERM
+
+ft_bin="$work/ft"
+sqlq_bin="$work/sqlq"
+mkdir -p "$work/module"
+
+printf 'building %s ...\n' "$repo" >&2
+if ! run_timed "$FT_BUILD_TIMEOUT" sh -c 'cd "$1" && go build -o "$2" ./cmd/ft' sh "$repo" "$ft_bin" >&2; then
+  printf '  error: go build ./cmd/ft failed\n' >&2
+  report_all_fail
+  exit 1
+fi
+
+# Build the SQLite inspection helper from a writable copy of the shipped
+# module (the asset tree may be mounted read-only).
+cp -R "$HERE/sqlq/." "$work/module/"
+if ! run_timed "$FT_BUILD_TIMEOUT" sh -c 'cd "$1" && go build -o "$2" .' sh "$work/module" "$sqlq_bin" >&2; then
+  printf '  error: building sqlq helper failed\n' >&2
+  report_all_fail
+  exit 1
+fi
+
+export FT_FT_BIN="$ft_bin"
+export FT_SQLQ="$sqlq_bin"
+export FT_WORK="$work/cases"
+export FT_FIXTURES="$(ft_fixtures_dir)"
+export FT_CMD_TIMEOUT
+mkdir -p "$FT_WORK"
+
+status=0
+for obs in STATE-001 STATE-002 STATE-003 STATE-004; do
+  script="$HERE/$(printf '%s' "$obs" | tr 'A-Z' 'a-z').sh"
+  if run_timed "$FT_BUILD_TIMEOUT" "$script" >"$work/$obs.out" 2>"$work/$obs.err"; then
+    printf '%s\tpass\n' "$obs"
+  else
+    printf '%s\tfail\n' "$obs"
+    status=1
+    sed 's/^/    /' "$work/$obs.err" >&2 || true
+  fi
+done
+
+exit "$status"
