+// STATE-003 (critical_data, R011) - `ft index` (buildIndex) sets
+// schema_version 6, a refresh preserves stored classification / enrichment
+// columns, --force drops and rebuilds, and schema migrations add missing
+// columns based on actual column existence.
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { loadModule, readFixture, runSql, scalar, withEnv } from './helpers.ts';
+
+async function setupDataDir(prefix: string): Promise<string> {
+  const dir = await mkdtemp(path.join(tmpdir(), prefix));
+  await writeFile(path.join(dir, 'bookmarks.jsonl'), await readFixture('bookmarks.jsonl'));
+  return dir;
+}
+
+test('STATE-003 refresh preserves, --force resets, migration self-heals', async () => {
+  const db = await loadModule<any>('src/bookmarks-db.ts');
+  const core = await loadModule<any>('src/db.ts');
+
+  const dir = await setupDataDir('ft-state3-');
+  const dbPath = path.join(dir, 'bookmarks.db');
+
+  await withEnv({ FT_DATA_DIR: dir }, async () => {
+    const first = await db.buildIndex();
+    assert.equal(first.recordCount, 2);
+    assert.equal(first.newRecords, 2);
+
+    const second = await db.buildIndex();
+    assert.equal(second.newRecords, 0, 'refresh must not report existing rows as new');
+
+    let handle = await core.openDb(dbPath);
+    assert.equal(String(await scalar(handle, "SELECT value FROM meta WHERE key='schema_version'")), '6');
+    handle.run(
+      "UPDATE bookmarks SET primary_category='tool', categories='tool,custom', article_text='stored article', enriched_at='2024-03-01T00:00:00.000Z' WHERE id='1'",
+    );
+    core.saveDb(handle, dbPath);
+    handle.close();
+
+    await db.buildIndex();
+    handle = await core.openDb(dbPath);
+    assert.equal(await scalar(handle, "SELECT primary_category FROM bookmarks WHERE id='1'"), 'tool');
+    assert.equal(await scalar(handle, "SELECT categories FROM bookmarks WHERE id='1'"), 'tool,custom');
+    assert.equal(await scalar(handle, "SELECT article_text FROM bookmarks WHERE id='1'"), 'stored article');
+    assert.equal(
+      await scalar(handle, "SELECT enriched_at FROM bookmarks WHERE id='1'"),
+      '2024-03-01T00:00:00.000Z',
+    );
+    handle.close();
+
+    await db.buildIndex({ force: true });
+    handle = await core.openDb(dbPath);
+    assert.equal(await scalar(handle, "SELECT primary_category FROM bookmarks WHERE id='1'"), 'unclassified');
+    assert.equal(await scalar(handle, "SELECT categories FROM bookmarks WHERE id='1'"), null);
+    assert.equal(await scalar(handle, "SELECT article_text FROM bookmarks WHERE id='1'"), null);
+    handle.close();
+  });
+
+  // Self-healing migration: a legacy DB missing domains and article_text gains
+  // them and keeps its stored primary_category on a non-force refresh.
+  const migDir = await setupDataDir('ft-state3-mig-');
+  const legacySql = await readFixture('legacy-bookmarks.schema.sql');
+  const legacy = await core.createDb();
+  legacy.exec(legacySql);
+  core.saveDb(legacy, path.join(migDir, 'bookmarks.db'));
+  legacy.close();
+
+  await withEnv({ FT_DATA_DIR: migDir }, async () => {
+    await db.buildIndex();
+    const handle = await core.openDb(path.join(migDir, 'bookmarks.db'));
+    const info = await runSql(handle, 'PRAGMA table_info(bookmarks)');
+    const names = info.map((row: any[]) => row[1]);
+    assert.ok(names.includes('domains'), 'domains column must be added');
+    assert.ok(names.includes('article_text'), 'article_text column must be added');
+    assert.equal(await scalar(handle, "SELECT primary_category FROM bookmarks WHERE id='1'"), 'tool');
+    assert.equal(String(await scalar(handle, "SELECT value FROM meta WHERE key='schema_version'")), '6');
+    handle.close();
+  });
+});
