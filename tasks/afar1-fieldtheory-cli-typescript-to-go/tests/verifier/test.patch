+idx=$(run_timed "$FT_CMD_TIMEOUT" "$FT_SQLQ" "$db" query \
+  "SELECT name FROM sqlite_master WHERE type='index' AND name LIKE 'idx_bookmarks_%' ORDER BY name" \
+  | tr '\n' ',' | sed 's/,$//')
+ft_assert_eq "idx_bookmarks_author,idx_bookmarks_category,idx_bookmarks_domain,idx_bookmarks_language,idx_bookmarks_posted" "$idx" "required indexes"
+
+exit 0
