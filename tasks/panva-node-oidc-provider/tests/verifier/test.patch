+
+// F2P-030 / F2P-032 / F2P-036 / F2P-038 — per-profile CORS exposed headers on
+// the Fastify path.
+async function cors(path, method = 'GET') {
+  return async () => {
+    const { request, close } = await boot();
+    const res = await request(method, path, { headers: { Origin: 'https://rp.example' } });
