+    { id: 'F2P-007', requirement: 'S009', entry: { method: 'GET', route: '/auth' }, predicate: (c) => c.sessionPersistence() },
+    { id: 'F2P-008', requirement: 'S014', entry: { method: 'DELETE', route: '/reg/client' }, predicate: (c) => c.providerIdentity() },
