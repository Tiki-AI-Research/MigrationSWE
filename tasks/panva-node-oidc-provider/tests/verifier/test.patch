@@ -0,0 +1,14 @@
+import { writeFileSync } from 'node:fs';
+
+import { run } from '../../../shared/batches/BATCH-DIFFERENTIAL-0001/runner.mjs';
+
+const root = process.env.OIDC_REPO_ROOT ?? '/input/target';
+
+const result = await run(root);
+const serialized = `${JSON.stringify(result, null, 2)}\n`;
+
+if (process.argv[2]) {
+  writeFileSync(process.argv[2], serialized);
+} else {
+  process.stdout.write(serialized);
+}
diff --git a/tests/target/batches/BATCH-F2P-0001/run.mjs b/tests/target/batches/BATCH-F2P-0001/run.mjs
new file mode 100644
--- /dev/null
+++ b/tests/target/batches/BATCH-F2P-0001/run.mjs
@@ -0,0 +1,32 @@
+// Target-side runner for BATCH-F2P-0001.
+//
+// Runs every observation of this batch against the migrated repository and
+// requires the target postcondition to hold *and* the request path to be owned
+// by Fastify. Every observation must observe PASS here; a FAIL is a genuine
+// missing target capability.
+
+import { writeFile } from 'node:fs/promises';
+import { run, OBSERVATION_IDS } from '../../../shared/batches/BATCH-F2P-0001/harness.mjs';
+
+const repo = process.env.REPO_ROOT || process.argv[2] || '/workspace/repo';
+const reportPath = process.env.REPORT || process.argv[3];
+
+const { results } = await run(repo);
+const observations = results.map((result) => ({
+  observation_id: result.id,
+  requirement_ids: [result.requirement],
+  entry: result.entry,
+  behavior: result.behavior,
+  fastify: result.fastify,
+  status: result.behavior && result.fastify ? 'PASS' : 'FAIL',
+  detail: result.detail,
+}));
+
+const report = { side: 'target', repo, observation_ids: OBSERVATION_IDS, observations };
+if (reportPath) await writeFile(reportPath, JSON.stringify(report, null, 2));
+
+const failed = observations.filter((observation) => observation.status !== 'PASS');
+for (const observation of observations) {
+  console.log(`${observation.status} ${observation.observation_id} behavior=${observation.behavior} fastify=${observation.fastify}${observation.detail ? ` (${observation.detail})` : ''}`);
+}
+process.exit(failed.length ? 1 : 0);
diff --git a/tests/target/batches/BATCH-F2P-0002/probe.mjs b/tests/target/batches/BATCH-F2P-0002/probe.mjs
new file mode 100644
--- /dev/null
+++ b/tests/target/batches/BATCH-F2P-0002/probe.mjs
@@ -0,0 +1,19 @@
+// Target-side entry for the BATCH-F2P-0002 F2P observations.
+//
+// Run with the shared loader so the executed module graph can be observed:
+//   BATCH_F2P_0002_TRACE_OUT=<file> node --experimental-loader \
+//     ../../../shared/batches/BATCH-F2P-0002/hooks.mjs ./probe.mjs <target-root>
+//
+// Every F2P observation must report PASS on the Fastify target tree; the shared
+// predicate in ../../../shared/batches/BATCH-F2P-0002/probe.mjs is evaluated
+// identically on both sides.
+import { pathToFileURL } from 'node:url';
+import { runAll } from '../../../shared/batches/BATCH-F2P-0002/probe.mjs';
+
+if (process.argv[1] && pathToFileURL(process.argv[1]).href === import.meta.url) {
+  const report = await runAll();
+  process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+  process.exit(0);
+}
+
+export { runAll };
