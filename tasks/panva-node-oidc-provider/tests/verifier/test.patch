new file mode 100644
--- /dev/null
+++ b/tests/source/runner
@@ -0,0 +1,10 @@
+#!/bin/sh
+# Source-side integration entry point.
+#
+# Invoked as: {assets}/source/runner {report}
+# The repository under observation is selected through MIGRATION_REPO_ROOT /
+# MIGRATION_REPO / REPO_ROOT / REPO (default /workspace/repo). All results are
+# raw, side-specific observations; nothing is pre-declared PASS or FAIL.
+set -eu
+SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+exec node "$SELF_DIR/../shared/integration/entry.mjs" source "$@"
diff --git a/tests/target/batches/BATCH-DIFFERENTIAL-0001/probe.mjs b/tests/target/batches/BATCH-DIFFERENTIAL-0001/probe.mjs
