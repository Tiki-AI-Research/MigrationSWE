diff --git a/tests/source/batches/BATCH-F2P-0001/run.mjs b/tests/source/batches/BATCH-F2P-0001/run.mjs
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0001/run.mjs
@@ -0,0 +1,33 @@
+// Source-side runner for BATCH-F2P-0001.
+//
+// The very same semantic predicates are executed against the source repository
+// (Koa, migration.source). F2P is a target-only postcondition, so every
+// observation must observe FAIL here: either the postcondition does not hold
+// under the source technology, or the request path is not owned by Fastify.
+// A PASS here would mean the observation has no discriminating power.
+
+import { writeFile } from 'node:fs/promises';
+import { run, OBSERVATION_IDS } from '../../../shared/batches/BATCH-F2P-0001/harness.mjs';
+
+const repo = process.env.REPO_ROOT || process.argv[2] || '/input/source';
+const reportPath = process.env.REPORT || process.argv[3];
+
+const { results } = await run(repo);
+const observations = results.map((result) => ({
+  observation_id: result.id,
+  requirement_ids: [result.requirement],
+  entry: result.entry,
+  behavior: result.behavior,
+  fastify: result.fastify,
+  status: result.behavior && result.fastify ? 'PASS' : 'FAIL',
+  detail: result.detail,
+}));
+
+const report = { side: 'source', repo, observation_ids: OBSERVATION_IDS, observations };
+if (reportPath) await writeFile(reportPath, JSON.stringify(report, null, 2));
+
+const notFailing = observations.filter((observation) => observation.status !== 'FAIL');
+for (const observation of observations) {
+  console.log(`${observation.status} ${observation.observation_id} behavior=${observation.behavior} fastify=${observation.fastify}${observation.detail ? ` (${observation.detail})` : ''}`);
+}
+process.exit(notFailing.length ? 1 : 0);
