+++ b/tests/shared/batches/BATCH-DIFFERENTIAL-0001/corpus.mjs
@@ -0,0 +1,132 @@
+import { createServer } from 'node:http';
+import { request as httpRequest } from 'node:http';
+import { generateKeyPair, exportJWK } from 'jose';
+
+export const OBSERVATION_IDS = [
+  'DIFF-001', 'DIFF-002', 'DIFF-003', 'DIFF-004', 'DIFF-005', 'DIFF-006',
+  'DIFF-007', 'DIFF-008', 'DIFF-009', 'DIFF-010', 'DIFF-011', 'DIFF-012',
+  'DIFF-013', 'DIFF-014', 'DIFF-015', 'DIFF-016', 'DIFF-017', 'DIFF-018',
+  'DIFF-019', 'DIFF-020', 'DIFF-021', 'DIFF-022', 'DIFF-023', 'DIFF-024',
+  'DIFF-025', 'DIFF-026', 'DIFF-027', 'DIFF-028', 'DIFF-029',
+];
+
+export const CLIENT = {
+  client_id: 'client',
+  client_secret: 'secret',
+  redirect_uris: ['https://client.example.com/cb'],
+  grant_types: ['authorization_code', 'refresh_token'],
+  response_types: ['code'],
+  token_endpoint_auth_method: 'client_secret_basic',
+};
+
+const BASIC = `Basic ${Buffer.from('client:secret').toString('base64')}`;
+const FORM = 'application/x-www-form-urlencoded';
+
+async function mainJwks() {
+  const { privateKey } = await generateKeyPair('RS256', { extractable: true });
+  const jwk = await exportJWK(privateKey);
+  jwk.kid = 'main';
+  jwk.alg = 'RS256';
+  jwk.use = 'sig';
+  return { keys: [jwk] };
+}
+
+export function makeProvider(Provider, MemoryAdapter, jwks, extra = {}) {
+  return new Provider('http://127.0.0.1', {
+    jwks,
+    adapter: MemoryAdapter,
+    findAccount: (_ctx, id) => ({ accountId: id, claims: () => ({ sub: id }) }),
+    clients: [CLIENT],
+    features: { devInteractions: { enabled: false } },
+    ...extra,
+  });
+}
+
+export function createHttp() {
+  return function send(port, { method = 'GET', path = '/', headers = {}, body } = {}) {
+    return new Promise((resolve, reject) => {
+      const req = httpRequest({ host: '127.0.0.1', port, method, path, headers }, (res) => {
+        const chunks = [];
+        res.on('data', (c) => chunks.push(c));
+        res.on('end', () => resolve({
+          status: res.statusCode,
+          headers: res.headers,
+          setCookie: res.headers['set-cookie'] ?? [],
+          body: Buffer.concat(chunks).toString('utf8'),
+        }));
+      });
+      req.on('error', reject);
+      if (body !== undefined) req.write(body);
+      req.end();
+    });
+  };
+}
+
+export function listen(server) {
+  return new Promise((resolve) => server.listen(0, '127.0.0.1', () => resolve(server.address().port)));
+}
+
+export function close(server) {
+  return new Promise((resolve) => server.close(resolve));
+}
+
+export function createServerFor(provider) {
+  return createServer(provider.callback());
+}
+
+const OVERSIZE = `grant_type=authorization_code&code=${'a'.repeat(60 * 1024)}`;
+
+export const CASES = [
+  { name: 'discovery', provider: 'default', req: { path: '/.well-known/openid-configuration' } },
+  { name: 'discovery_oauth', provider: 'default', req: { path: '/.well-known/oauth-authorization-server' } },
+  { name: 'jwks', provider: 'default', req: { path: '/jwks' } },
+  { name: 'jwks_head', provider: 'default', req: { method: 'HEAD', path: '/jwks' } },
+  { name: 'not_found', provider: 'default', req: { path: '/definitely-not-a-route' } },
+  { name: 'me_unauth', provider: 'default', req: { path: '/me' } },
+  { name: 'token_empty', provider: 'default', req: { method: 'POST', path: '/token', headers: { 'content-type': FORM } } },
+  { name: 'token_no_dup', provider: 'default', req: { method: 'POST', path: '/token', headers: { 'content-type': FORM, authorization: BASIC }, body: 'grant_type=bogus' } },
+  { name: 'token_invalid_client', provider: 'default', req: { method: 'POST', path: '/token', headers: { 'content-type': FORM, authorization: BASIC }, body: 'grant_type=authorization_code&client_id=unknown' } },
+  { name: 'token_xml', provider: 'default', req: { method: 'POST', path: '/token', headers: { 'content-type': 'application/xml' }, body: '<x/>' } },
+  { name: 'token_json', provider: 'default', req: { method: 'POST', path: '/token', headers: { 'content-type': 'application/json' }, body: '{}' } },
+  { name: 'token_badescape', provider: 'default', req: { method: 'POST', path: '/token', headers: { 'content-type': FORM, authorization: BASIC }, body: 'grant_type=authorization_code&code=%ZZ' } },
+  { name: 'token_oversize', provider: 'default', req: { method: 'POST', path: '/token', headers: { 'content-type': FORM, authorization: BASIC }, body: OVERSIZE } },
+  { name: 'token_upper', provider: 'default', req: { method: 'POST', path: '/TOKEN', headers: { 'content-type': FORM, authorization: BASIC }, body: '' } },
+  { name: 'token_slash', provider: 'default', req: { method: 'POST', path: '/token/', headers: { 'content-type': FORM, authorization: BASIC }, body: '' } },
+  { name: 'options_token', provider: 'default', req: { method: 'OPTIONS', path: '/token', headers: { origin: 'https://rp.example', 'access-control-request-method': 'POST' } } },
+  { name: 'options_me', provider: 'default', req: { method: 'OPTIONS', path: '/me', headers: { origin: 'https://rp.example', 'access-control-request-method': 'GET' } } },
+  { name: 'me_cors', provider: 'default', req: { path: '/me', headers: { origin: 'https://rp.example' } } },
+  { name: 'auth_noparams', provider: 'default', req: { path: '/auth' } },
+  { name: 'auth_interaction_cookie', provider: 'default', req: { path: '/auth?client_id=client&redirect_uri=https%3A%2F%2Fclient.example.com%2Fcb&response_type=code&scope=openid&state=xyz' } },
+  { name: 'head_auth', provider: 'default', req: { method: 'HEAD', path: '/auth' } },
+  { name: 'registration_wrong_ct', provider: 'default', req: { method: 'POST', path: '/reg', headers: { 'content-type': 'text/plain' }, body: 'x' } },
+  { name: 'session_end', provider: 'default', req: { path: '/session/end' } },
+  { name: 'device_authorization_get', provider: 'default', req: { path: '/device/auth' } },
+  { name: 'proxy_discovery', provider: 'proxy', req: { path: '/.well-known/openid-configuration', headers: { 'x-forwarded-proto': 'https' } } },
+  { name: 'proxy_me', provider: 'proxy', req: { path: '/me', headers: { 'x-forwarded-proto': 'https' } } },
+];
+
+export function normalize(res, { port }) {
+  const substitute = (value) => {
+    if (typeof value !== 'string') return value;
+    return value
+      .split(`:${port}`).join(':{{PORT}}')
+      .replace(/127\.0\.0\.1:\d+/g, '127.0.0.1:{{PORT}}');
+  };
+  let body = substitute(res.body);
+  body = body.replace(/"n":"[^"]*"/g, '"n":"{{N}}"').replace(/"e":"[^"]*"/g, '"e":"{{E}}"');
+  body = body.replace(/&state=[^&"]*/g, '&state={{STATE}}');
+  body = body.replace(/\/interaction\/[A-Za-z0-9_-]{16,}/g, '/interaction/{{UID}}');
+  body = body.replace(/value="[0-9a-f]{32,}"/g, 'value="{{XSRF}}"');
+  const cookieNames = [...new Set((res.setCookie ?? []).map((c) => c.split('=')[0]))];
+  return {
+    status: res.status,
+    'content-type': substitute(res.headers['content-type'] ?? null),
+    'www-authenticate': substitute(res.headers['www-authenticate'] ?? null),
+    'access-control-allow-origin': substitute(res.headers['access-control-allow-origin'] ?? null),
+    'access-control-allow-methods': substitute(res.headers['access-control-allow-methods'] ?? null),
+    'access-control-expose-headers': substitute(res.headers['access-control-expose-headers'] ?? null),
+    'access-control-max-age': substitute(res.headers['access-control-max-age'] ?? null),
+    'set-cookie-names': cookieNames,
+    body: body.slice(0, 600),
+  };
+}
diff --git a/tests/shared/batches/BATCH-DIFFERENTIAL-0001/runner.mjs b/tests/shared/batches/BATCH-DIFFERENTIAL-0001/runner.mjs
new file mode 100644
--- /dev/null
+++ b/tests/shared/batches/BATCH-DIFFERENTIAL-0001/runner.mjs
@@ -0,0 +1,102 @@
+import { pathToFileURL } from 'node:url';
+
+import {
+  CASES,
+  normalize,
+  makeProvider,
+  createHttp,
+  listen,
+  close,
+  createServerFor,
+} from './corpus.mjs';
+
+async function principal(root) {
+  const { default: Provider } = await import(`${root}/lib/index.js`);
+  const { default: MemoryAdapter } = await import(`${root}/lib/adapters/memory_adapter.js`);
+  const { generateKeyPair, exportJWK } = await import('jose');
+  const { privateKey } = await generateKeyPair('RS256', { extractable: true });
+  const jwk = await exportJWK(privateKey);
+  jwk.kid = 'main';
+  jwk.alg = 'RS256';
+  jwk.use = 'sig';
+  return { Provider, MemoryAdapter, jwks: { keys: [jwk] } };
+}
+
+async function identity(root) {
+  const mod = await import(`${root}/lib/index.js`);
+  const Provider = mod.default;
+  const provider = new Provider('http://127.0.0.1', {
+    adapter: (await import(`${root}/lib/adapters/memory_adapter.js`)).default,
+    findAccount: (_ctx, id) => ({ accountId: id, claims: () => ({ sub: id }) }),
+    clients: [{
+      client_id: 'client',
+      client_secret: 'secret',
+      redirect_uris: ['https://client.example.com/cb'],
+      grant_types: ['authorization_code'],
+      response_types: ['code'],
+      token_endpoint_auth_method: 'client_secret_basic',
+    }],
+  });
+  return {
+    exports: Object.keys(mod).sort(),
+    eventEmitter: provider instanceof (await import('node:events')).EventEmitter,
+    callback: typeof provider.callback,
+    listen: typeof provider.listen,
+    createContext: typeof provider.createContext,
+    use: typeof provider.use,
+    hasMiddleware: 'middleware' in provider,
+    hasKeys: 'keys' in provider,
+    hasApp: 'app' in provider,
+    hasMountPath: 'mountPath' in provider,
+    outOfScopeSurfaceKept: typeof provider.use === 'function'
+      && typeof provider.createContext === 'function'
+      && 'middleware' in provider
+      && 'keys' in provider
+      && 'app' in provider,
+  };
+}
+
+export async function run(root) {
+  const { Provider, MemoryAdapter, jwks } = await principal(root);
+  const send = createHttp();
+
+  const servers = [];
+  function start(provider) {
+    const server = createServerFor(provider);
+    servers.push(server);
+    return listen(server);
+  }
+
+  const defaultProvider = makeProvider(Provider, MemoryAdapter, jwks);
+  const proxyProvider = makeProvider(Provider, MemoryAdapter, jwks, { proxy: true });
+  const defaultPort = await start(defaultProvider);
+  const proxyPort = await start(proxyProvider);
+
+  const result = {};
+
+  for (const c of CASES) {
+    try {
+      const port = c.provider === 'proxy' ? proxyPort : defaultPort;
+      const res = await send(port, c.req);
+      result[c.name] = normalize(res, { port });
+    } catch (error) {
+      result[c.name] = { error: String(error && error.message) };
+    }
+  }
+
+  try {
+    result.identity = await identity(root);
+  } catch (error) {
+    result.identity = { error: String(error && error.message) };
+  }
+
+  await Promise.all(servers.map(close));
+  return result;
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? '').href) {
+  const root = process.argv[2] ?? process.env.OIDC_REPO_ROOT ?? '/workspace/repo';
+  run(root).then((result) => {
+    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
+  });
+}
diff --git a/tests/shared/batches/BATCH-F2P-0001/harness.mjs b/tests/shared/batches/BATCH-F2P-0001/harness.mjs
new file mode 100644
--- /dev/null
+++ b/tests/shared/batches/BATCH-F2P-0001/harness.mjs
@@ -0,0 +1,468 @@
+// Shared F2P harness for BATCH-F2P-0001.
+//
+// Every observation of this batch is run by the *same* semantic predicate on
+// both sides. The predicate is a target postcondition; it is paired with a
+// runtime probe that proves the request path is owned by the required target
+// technology (Fastify, migration.target) and not by the source technology
+// (Koa, migration.source). `run(repo)` therefore returns, for each observation,
+// the raw observation of this side plus the technology that served it.
+//
+// The harness never hardcodes PASS/FAIL by role: `behavior` is the raw result of
+// the predicate and `fastify` is the raw result of the technology probe. F2P is
+// a target-only postcondition, so the caller derives PASS only when both are
+// observed on the target side.
+
+import { createServer } from 'node:http';
+import { once } from 'node:events';
+import { createRequire } from 'node:module';
+import { pathToFileURL } from 'node:url';
+import path from 'node:path';
+
+import { dependencyPolicy } from '../../integration/dependency-policy.mjs';
+
+export const OBSERVATION_IDS = [
+  'F2P-001', 'F2P-002', 'F2P-003', 'F2P-004', 'F2P-005', 'F2P-006',
+  'F2P-007', 'F2P-008', 'F2P-009', 'F2P-010', 'F2P-011', 'F2P-012',
+  'F2P-013', 'F2P-014', 'F2P-015', 'F2P-016', 'F2P-017', 'F2P-018',
+  'F2P-019', 'F2P-020', 'F2P-021', 'F2P-022', 'F2P-023', 'F2P-024',
+];
+
+const GENERIC_ERROR = 'oops! something went wrong';
+
+function repoModules(repo) {
+  const require = createRequire(path.join(repo, 'package.json'));
+  const resolve = (name) => pathToFileURL(require.resolve(name)).href;
+  return { require, resolve };
+}
+
+// ---------------------------------------------------------------------------
+// minimal provider materialization (no dependency on the repo's test helpers)
+// ---------------------------------------------------------------------------
+
+const storage = new Map();
+const upserts = new Map();
+
+class MemoryAdapter {
+  constructor(name) { this.name = name; }
+
+  key(id) { return `${this.name}:${id}`; }
+
+  async upsert(id, payload, expiresIn) {
+    upserts.set(this.name, (upserts.get(this.name) || 0) + 1);
+    storage.set(this.key(id), { payload, expiresIn });
+  }
+
+  async find(id) { return storage.get(this.key(id))?.payload; }
+
+  async findByUserCode(code) {
+    return [...storage.values()].map((x) => x.payload).find((p) => p.userCode === code);
+  }
+
+  async findByUid(uid) {
+    return [...storage.values()].map((x) => x.payload).find((p) => p.uid === uid);
+  }
+
+  async consume(id) {
+    const entry = storage.get(this.key(id));
+    if (entry) entry.payload.consumed = Math.floor(Date.now() / 1000);
+  }
+
+  async destroy(id) { storage.delete(this.key(id)); }
+
+  async revokeByGrantId(gid) {
+    for (const [key, value] of storage) if (value.payload.grantId === gid) storage.delete(key);
+  }
+}
+
+function testClient(extraGrantTypes = []) {
+  return {
+    client_id: 'client',
+    client_secret: 'secret',
+    redirect_uris: ['https://rp.example/cb'],
+    response_types: ['code'],
+    grant_types: ['authorization_code', 'refresh_token', ...extraGrantTypes],
+    token_endpoint_auth_method: 'client_secret_basic',
+  };
+}
+
+const FEATURES = {
+  dPoP: { nonceSecret: Buffer.alloc(32) },
+  deviceFlow: { enabled: true },
+  revocation: { enabled: true },
+  introspection: { enabled: true },
+  registration: { enabled: true },
+  registrationManagement: { enabled: true },
+  pushedAuthorizationRequests: { enabled: true },
+  ciba: { enabled: true },
+};
+
+function baseConfig(jose, keys, extra) {
+  return {
+    clients: [testClient()],
+    jwks: { keys },
+    adapter: MemoryAdapter,
+    cookies: { long: { sameSite: 'none' } },
+    features: FEATURES,
+    enableHttpPostMethods: true,
+    findAccount: (_ctx, id) => ({ accountId: id, claims: () => ({ sub: id }) }),
+    ...extra,
+  };
+}
+
+async function makeKeys(jose) {
+  const keys = [];
+  for (const alg of ['RS256', 'ES256']) {
+    const kp = await jose.generateKeyPair(alg, { extractable: true });
+    keys.push(await jose.exportJWK(kp.privateKey));
+  }
+  return keys;
+}
+
+// ---------------------------------------------------------------------------
+// technology probe: observe whether the live request path is owned by Fastify
+// ---------------------------------------------------------------------------
+
+function installTechProbe(repo) {
+  const state = { fastify: false };
+  // Observe Fastify before importing the provider. createContext is an
+  // out-of-scope extension API; its argument layout is not an HTTP contract.
+  // The cached CommonJS export is also Fastify's ESM default export.
+  const { require } = repoModules(repo);
+  const modulePath = require.resolve('fastify');
+  const original = require(modulePath);
+  const wrapped = new Proxy(original, {
+    get(factory, key, receiver) {
+      if (key === 'fastify' || key === 'default') return wrapped;
+      return Reflect.get(factory, key, receiver);
+    },
+    apply(factory, receiver, args) {
+      const app = Reflect.apply(factory, receiver, args);
+      app.addHook('onSend', (request, reply, payload, done) => {
+        // Raw responses sent after reply.hijack() do not run this hook.
+        if (reply.request === request && request.raw && reply.raw) state.fastify = true;
+        done(null, payload);
+      });
+      return app;
+    },
+  });
+  require.cache[modulePath].exports = wrapped;
+  return state;
+}
+
+// ---------------------------------------------------------------------------
+// request helpers
+// ---------------------------------------------------------------------------
+
+async function call(origin, route, options = {}) {
+  const response = await fetch(origin + route, options);
+  const text = await response.text();
+  const headers = Object.fromEntries(response.headers.entries());
+  return { status: response.status, headers, text };
+}
+
+function json(text) {
+  try { return JSON.parse(text); } catch { return undefined; }
+}
+
+// ---------------------------------------------------------------------------
+// observation predicates
+// ---------------------------------------------------------------------------
+
+function makeContext(repo, Provider, tech) {
+  let provider;
+  let origin;
+  let close;
+
+  async function boot({ proxy = true, extra = {} } = {}) {
+    const { resolve } = repoModules(repo);
+    const jose = await import(resolve('jose'));
+    const keys = await makeKeys(jose);
+    provider = new Provider('http://127.0.0.1', baseConfig(jose, keys, extra));
+    provider.proxy = proxy;
+    const server = createServer(provider.callback());
+    server.listen(0);
+    await once(server, 'listening');
+    origin = `http://127.0.0.1:${server.address().port}`;
+    close = () => new Promise((r) => server.close(r));
+    return { provider, origin };
+  }
+
+  async function corsProfiles() {
+    const me = await call(origin, '/me', {
+      headers: { Origin: 'https://rp.example', Authorization: 'Bearer x' },
+    });
+    const jwks = await call(origin, '/jwks', { headers: { Origin: 'https://rp.example' } });
+    const meExpose = me.headers['access-control-expose-headers'] || '';
+    const jwksExpose = jwks.headers['access-control-expose-headers'] || '';
+    return meExpose.includes('DPoP-Nonce')
+      && meExpose.includes('WWW-Authenticate')
+      && !meExpose.includes('OAuth-Client-Attestation-Challenge')
+      && meExpose !== jwksExpose;
+  }
+
+  async function proxyDiscovery() {
+    const body = await call(origin, '/.well-known/openid-configuration', {
+      headers: { 'X-Forwarded-Proto': 'https' },
+    });
+    const document = json(body.text);
+    return Boolean(document)
+      && String(document.authorization_endpoint || '').startsWith('https://')
+      && String(document.token_endpoint || '').startsWith('https://');
+  }
+
+  async function bootstrapImmediate(route) {
+    const { resolve } = repoModules(repo);
+    const jose = await import(resolve('jose'));
+    const keys = await makeKeys(jose);
+    const p = new Provider('http://127.0.0.1', baseConfig(jose, keys, {}));
+    const server = createServer(p.callback());
+    server.listen(0);
+    await once(server, 'listening');
+    try {
+      const probe = await call(`http://127.0.0.1:${server.address().port}`, route);
+      return probe.status === 200 || probe.status === 401 || probe.status === 400;
+    } finally {
+      await new Promise((r) => server.close(r));
+    }
+  }
+
+  async function notFound() {
+    const response = await call(origin, '/definitely-not-a-route');
+    // No provider endpoint is registered here. Preserve non-dispatch (404),
+    // without inventing a contract for the fallback body's spelling or type.
+    return response.status === 404;
+  }
+
+  async function routeEquivalence() {
+    const opts = {
+      method: 'POST',
+      headers: { 'content-type': 'application/x-www-form-urlencoded' },
+      body: 'grant_type=authorization_code',
+    };
+    const canonical = await call(origin, '/token', opts);
+    const upper = await call(origin, '/TOKEN', opts);
+    const slash = await call(origin, '/token/', opts);
+    return canonical.status === 400
+      && upper.status === canonical.status
+      && upper.text === canonical.text
+      && slash.status === canonical.status
+      && slash.text === canonical.text;
+  }
+
+  async function unsupportedContentType() {
+    const response = await call(origin, '/token', {
+      method: 'POST',
+      headers: { 'content-type': 'application/xml' },
+      body: 'a=b',
+    });
+    const body = json(response.text) || {};
+    return response.status === 400
+      && body.error_description === 'only application/x-www-form-urlencoded content-type bodies are supported on POST /token';
+  }
+
+  async function bodySizeCap() {
+    const payload = `grant_type=authorization_code&junk=${'x'.repeat(60 * 1024)}`;
+    const response = await call(origin, '/token', {
+      method: 'POST',
+      headers: { 'content-type': 'application/x-www-form-urlencoded' },
+      body: payload,
+    });
+    const body = json(response.text) || {};
+    return response.status === 400 && body.error_description === 'failed to parse the request body';
+  }
+
+  async function sessionPersistence() {
+    const session = new provider.Session({
+      jti: 'session-persist-probe',
+      loginTs: Math.floor(Date.now() / 1000),
+      accountId: 'account-1',
+    });
+    session.authorizations = {};
+    await session.save(3600);
+    const before = upserts.get('Session') || 0;
+    await call(origin, `/auth?client_id=client&response_type=code&scope=openid&redirect_uri=${encodeURIComponent('https://rp.example/cb')}`, {
+      headers: { cookie: '_session=session-persist-probe' },
+      redirect: 'manual',
+    });
+    await new Promise((r) => setTimeout(r, 100));
+    const after = upserts.get('Session') || 0;
+    return after - before === 1;
+  }
+
+  async function providerIdentity() {
+    const { resolve } = repoModules(repo);
+    const { default: EventEmitter } = await import('node:events');
+    let Koa;
+    try {
+      Koa = (await import(resolve('koa'))).default;
