+  const found = [];
+  for (const entry of readdirSync(dir)) {
+    const full = join(dir, entry);
+    if (statSync(full).isDirectory()) found.push(...productionFiles(full));
+    else if (extname(entry) === '.js') found.push(full);
+  }
+  return found;
+}
