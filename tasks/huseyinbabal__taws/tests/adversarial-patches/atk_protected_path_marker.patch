diff --git a/internal/resource/protocol_test.go b/internal/resource/protocol_test.go
new file mode 100644
index 0000000..413f37e
--- /dev/null
+++ b/internal/resource/protocol_test.go
@@ -0,0 +1,66 @@
+package resource
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestAPIProtocolDeserialize(t *testing.T) {
+	cases := map[string]APIProtocol{
+		`"query"`:     ProtocolQuery,
+		`"json"`:      ProtocolJSON,
+		`"rest-json"`: ProtocolRestJSON,
+		`"rest-xml"`:  ProtocolRestXML,
+	}
+	for input, want := range cases {
+		var protocol APIProtocol
+		if err := json.Unmarshal([]byte(input), &protocol); err != nil {
+			t.Fatalf("unmarshal %s: %v", input, err)
+		}
+		if protocol != want {
+			t.Fatalf("protocol %s = %q, want %q", input, protocol, want)
+		}
+	}
+}
+
+func TestFieldMappingDeserialize(t *testing.T) {
+	var mapping FieldMapping
+	if err := json.Unmarshal([]byte(`{"source": "/instanceId"}`), &mapping); err != nil {
+		t.Fatal(err)
+	}
+	if mapping.Source != "/instanceId" {
+		t.Fatalf("source = %q", mapping.Source)
+	}
+	if mapping.Default != nil {
+		t.Fatalf("default = %v, want nil", *mapping.Default)
+	}
+
+	var withDefault FieldMapping
+	if err := json.Unmarshal([]byte(`{"source": "/ipAddress", "default": "-"}`), &withDefault); err != nil {
+		t.Fatal(err)
+	}
+	if withDefault.Source != "/ipAddress" {
+		t.Fatalf("source = %q", withDefault.Source)
+	}
+	if withDefault.Default == nil || *withDefault.Default != "-" {
+		t.Fatalf("default = %v, want -", withDefault.Default)
+	}
+}
+
+func TestAPIConfigDeserialize(t *testing.T) {
+	var config APIConfig
+	input := `{
+        "protocol": "query",
+        "action": "DescribeInstances",
+        "response_root": "/DescribeInstancesResponse/reservationSet"
+    }`
+	if err := json.Unmarshal([]byte(input), &config); err != nil {
+		t.Fatal(err)
+	}
+	if config.Protocol != ProtocolQuery {
+		t.Fatalf("protocol = %q", config.Protocol)
+	}
+	if config.Action == nil || *config.Action != "DescribeInstances" {
+		t.Fatalf("action = %v", config.Action)
+	}
+}
diff --git a/internal/resource/registry.go b/internal/resource/registry.go
new file mode 100644
index 0000000..c4818b1
--- /dev/null
+++ b/internal/resource/registry.go
@@ -0,0 +1,209 @@
+package resource
+
+import (
+	"encoding/json"
+	"fmt"
+	"io/fs"
+	"sort"
+	"sync"
+
+	"github.com/huseyinbabal/taws/src"
+)
+
+// ColorDef is a single value/color entry from a color map.
+type ColorDef struct {
+	Value string   `json:"value"`
+	Color [3]uint8 `json:"color"`
+}
+
+// ColumnDef describes a table column.
+type ColumnDef struct {
+	Header   string  `json:"header"`
+	JSONPath string  `json:"json_path"`
+	Width    uint16  `json:"width"`
+	ColorMap *string `json:"color_map"`
+}
+
+// SubResourceDef describes a nested resource navigable from a parent.
+type SubResourceDef struct {
+	ResourceKey   string `json:"resource_key"`
+	DisplayName   string `json:"display_name"`
+	Shortcut      string `json:"shortcut"`
+	ParentIDField string `json:"parent_id_field"`
+	FilterParam   string `json:"filter_param"`
+	FilterType    string `json:"filter_type"`
+}
+
+// ConfirmConfig is the confirmation dialog configuration for an action.
+type ConfirmConfig struct {
+	Message     *string `json:"message"`
+	DefaultYes  bool    `json:"default_yes"`
+	Destructive bool    `json:"destructive"`
+}
+
+// FiltersConfig describes API-side filtering support for a resource.
+type FiltersConfig struct {
+	Enabled bool    `json:"enabled"`
+	Hint    *string `json:"hint"`
+}
+
+// ActionDef is a resource action definition.
+type ActionDef struct {
+	Key          string         `json:"key"`
+	DisplayName  string         `json:"display_name"`
+	Shortcut     *string        `json:"shortcut"`
+	SDKMethod    string         `json:"sdk_method"`
+	IDParam      *string        `json:"id_param"`
+	NeedsConfirm bool           `json:"needs_confirm"`
+	Confirm      *ConfirmConfig `json:"confirm"`
+	ShowResult   bool           `json:"show_result"`
+}
+
+// RequiresConfirm reports whether the action needs a confirmation dialog.
+func (a *ActionDef) RequiresConfirm() bool {
+	return a.Confirm != nil || a.NeedsConfirm
+}
+
+// GetConfirmConfig returns the confirmation config, applying legacy defaults.
+func (a *ActionDef) GetConfirmConfig() *ConfirmConfig {
+	if a.Confirm != nil {
+		cfg := *a.Confirm
+		return &cfg
+	}
+	if a.NeedsConfirm {
+		msg := a.DisplayName
+		return &ConfirmConfig{Message: &msg}
+	}
+	return nil
+}
+
+// ResourceDef is a single resource definition from the catalog.
+type ResourceDef struct {
+	DisplayName           string           `json:"display_name"`
+	Service               string           `json:"service"`
+	SDKMethod             string           `json:"sdk_method"`
+	SDKMethodParams       any              `json:"sdk_method_params"`
+	ResponsePath          string           `json:"response_path"`
+	IDField               string           `json:"id_field"`
+	NameField             string           `json:"name_field"`
+	IsGlobal              bool             `json:"is_global"`
+	Columns               []ColumnDef      `json:"columns"`
+	SubResources          []SubResourceDef `json:"sub_resources"`
+	Actions               []ActionDef      `json:"actions"`
+	DetailSDKMethod       *string          `json:"detail_sdk_method"`
+	DetailSDKMethodParams any              `json:"detail_sdk_method_params"`
+
+	APIConfig      *APIConfig              `json:"api_config"`
+	FieldMappings  map[string]FieldMapping `json:"field_mappings"`
+	ActionConfigs  map[string]ActionConfig `json:"action_configs"`
+	DescribeConfig *DescribeConfig         `json:"describe_config"`
+	FiltersConfig  *FiltersConfig          `json:"filters_config"`
+	RequiresParent bool                    `json:"requires_parent"`
+	SortField      *string                 `json:"sort_field"`
+	SortOrder      *string                 `json:"sort_order"`
+	PreserveOrder  bool                    `json:"preserve_order"`
+}
+
+// HasAPIConfig reports whether data-driven dispatch is configured.
+func (r *ResourceDef) HasAPIConfig() bool {
+	return r.APIConfig != nil && len(r.FieldMappings) > 0
+}
+
+// SupportsFilters reports whether the resource supports AWS API filtering.
+func (r *ResourceDef) SupportsFilters() bool {
+	return r.FiltersConfig != nil && r.FiltersConfig.Enabled
+}
+
+// FiltersHint returns the filter hint text, if any.
+func (r *ResourceDef) FiltersHint() string {
+	if r.FiltersConfig == nil || r.FiltersConfig.Hint == nil {
+		return ""
+	}
+	return *r.FiltersConfig.Hint
+}
+
+// ResourceConfig is the root structure of a resources/*.json file.
+type ResourceConfig struct {
+	ColorMaps map[string][]ColorDef   `json:"color_maps"`
+	Resources map[string]*ResourceDef `json:"resources"`
+}
+
+var (
+	registryOnce sync.Once
+	registry     *ResourceConfig
+)
+
+// GetRegistry loads and returns the merged resource registry.
+func GetRegistry() *ResourceConfig {
+	registryOnce.Do(func() {
+		finalConfig := &ResourceConfig{
+			ColorMaps: map[string][]ColorDef{},
+			Resources: map[string]*ResourceDef{},
+		}
+
+		entries, err := fs.ReadDir(assets.ResourceFiles, "resources")
+		if err != nil {
+			panic(fmt.Sprintf("failed to read embedded resource directory: %v", err))
+		}
+		names := make([]string, 0, len(entries))
+		for _, e := range entries {
+			if !e.IsDir() {
+				names = append(names, e.Name())
+			}
+		}
+		sort.Strings(names)
+
+		for _, name := range names {
+			content, err := assets.ResourceFiles.ReadFile("resources/" + name)
+			if err != nil {
+				panic(fmt.Sprintf("failed to read embedded resource file %s: %v", name, err))
+			}
+			var partial ResourceConfig
+			if err := json.Unmarshal(content, &partial); err != nil {
+				panic(fmt.Sprintf("failed to parse embedded resource JSON %s: %v", name, err))
+			}
+			for k, v := range partial.ColorMaps {
+				finalConfig.ColorMaps[k] = v
+			}
+			for k, v := range partial.Resources {
+				finalConfig.Resources[k] = v
+			}
+		}
+
+		registry = finalConfig
+	})
+	return registry
+}
+
+// GetResource returns a resource definition by key.
+func GetResource(key string) *ResourceDef {
+	return GetRegistry().Resources[key]
+}
+
+// GetAllResourceKeys returns directly addressable resource keys, excluding
+// resources that require a parent context.
+func GetAllResourceKeys() []string {
+	keys := make([]string, 0, len(GetRegistry().Resources))
+	for key, def := range GetRegistry().Resources {
+		if !def.RequiresParent {
+			keys = append(keys, key)
+		}
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// GetColorMap returns a color map by name.
+func GetColorMap(name string) []ColorDef {
+	return GetRegistry().ColorMaps[name]
+}
+
+// GetColorForValue returns the color for a value in a color map.
+func GetColorForValue(colorMapName, value string) ([3]uint8, bool) {
+	for _, c := range GetColorMap(colorMapName) {
+		if c.Value == value {
+			return c.Color, true
+		}
+	}
+	return [3]uint8{}, false
+}
