+		t.Fatalf("display_name = %q", resource.DisplayName)
+	}
+	if !resource.RequiresParent {
+		t.Fatal("Outputs should require a parent stack")
+	}
+	headers := map[string]bool{}
+	for _, col := range resource.Columns {
+		headers[col.Header] = true
+	}
+	for _, want := range []string{"KEY", "VALUE"} {
+		if !headers[want] {
+			t.Fatalf("Outputs should have %s column", want)
+		}
+	}
+}
+
+func TestCFNStateColorsExist(t *testing.T) {
+	cases := []struct {
+		value string
+		want  [3]uint8
+	}{
+		{"CREATE_COMPLETE", [3]uint8{0, 255, 0}},
+		{"CREATE_FAILED", [3]uint8{255, 0, 0}},
+		{"CREATE_IN_PROGRESS", [3]uint8{255, 255, 0}},
+		{"DELETE_COMPLETE", [3]uint8{128, 128, 128}},
+	}
+	for _, tc := range cases {
+		got, ok := GetColorForValue("state", tc.value)
+		if !ok || got != tc.want {
+			t.Fatalf("color for %s = %v (ok=%v), want %v", tc.value, got, ok, tc.want)
+		}
+	}
+}
+
+func hasSubResource(resource *ResourceDef, key string) bool {
+	return findSubResource(resource, key) != nil
+}
+
+func findSubResource(resource *ResourceDef, key string) *SubResourceDef {
+	for i := range resource.SubResources {
+		if resource.SubResources[i].ResourceKey == key {
+			return &resource.SubResources[i]
+		}
+	}
+	return nil
+}
+
+func hasAction(resource *ResourceDef, sdkMethod string) bool {
+	for i := range resource.Actions {
+		if resource.Actions[i].SDKMethod == sdkMethod {
+			return true
+		}
+	}
+	return false
+}
+
+func containsString(values []string, want string) bool {
+	for _, v := range values {
+		if v == want {
+			return true
+		}
+	}
+	return false
+}
