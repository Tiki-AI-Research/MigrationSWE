+package resource
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/huseyinbabal/taws/internal/aws"
+)
+
+func TestFetchResourcesPaginatedJSONProtocol(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-Amz-Target") != "DynamoDB_20120810.ListTables" {
+			t.Errorf("X-Amz-Target = %q", r.Header.Get("X-Amz-Target"))
+		}
+		w.Header().Set("Content-Type", "application/x-amz-json-1.0")
+		w.Write([]byte(`{"TableNames":["beta","alpha"]}`))
+	}))
+	defer server.Close()
+
+	endpoint := server.URL
+	client := aws.NewHTTPClient(aws.Credentials{AccessKeyID: "AKID", SecretAccessKey: "secret"}, "us-east-1", &endpoint)
+	clients := &aws.AwsClients{HTTP: client, Region: "us-east-1", Profile: "default"}
+
+	result, err := FetchResourcesPaginated("dynamodb-tables", clients, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(result.Items) != 2 {
+		t.Fatalf("len = %d", len(result.Items))
+	}
+	first := result.Items[0].(map[string]any)
+	second := result.Items[1].(map[string]any)
+	if first["TableName"] != "alpha" || second["TableName"] != "beta" {
+		t.Fatalf("items not sorted: %v, %v", first, second)
+	}
+	if result.NextToken != nil {
+		t.Fatalf("nextToken = %v", result.NextToken)
+	}
+}
