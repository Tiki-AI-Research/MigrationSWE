+package resource
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestReadOnlyBlocksMutatingActions(t *testing.T) {
+	SetReadOnly(true)
+	defer SetReadOnly(false)
+
+	err := ExecuteAction("ec2", "start_instance", nil, "i-123")
+	if err == nil {
+		t.Fatal("expected mutating action to be blocked in read-only mode")
+	}
+	if !strings.Contains(err.Error(), "read-only") {
+		t.Fatalf("error = %q", err.Error())
+	}
+}
+
+func TestUnknownResourceHasNoAPIConfig(t *testing.T) {
+	if GetResource("nonexistent-resource") != nil {
+		t.Fatal("nonexistent resource should be nil")
+	}
+}
+
+func TestResourceHasAPIConfig(t *testing.T) {
+	for _, key := range []string{"dynamodb-tables", "ec2-instances", "lambda-functions", "iam-users", "redshift-clusters"} {
+		resource := GetResource(key)
+		if resource == nil {
+			t.Fatalf("%s should exist", key)
+		}
+		if !resource.HasAPIConfig() {
+			t.Fatalf("%s should have api_config", key)
+		}
+	}
+}
+
+func TestResolveStaticParamTemplateReplacesAllPlaceholders(t *testing.T) {
+	out := ResolveStaticParamTemplate("taws-{resource_id}-{timestamp}", "test-cluster", "20260309T143000")
+	if out != "taws-test-cluster-20260309T143000" {
+		t.Fatalf("got %q", out)
+	}
+}
+
+func TestResolveStaticParamTemplateKeepsPlainText(t *testing.T) {
+	out := ResolveStaticParamTemplate("fixed-value", "x", "y")
+	if out != "fixed-value" {
+		t.Fatalf("got %q", out)
+	}
+}
+
+func TestExtractParamVariants(t *testing.T) {
+	paramsStr := map[string]any{"bucket": "my-bucket"}
+	if got := ExtractParam(paramsStr, "bucket"); got != "my-bucket" {
+		t.Fatalf("string = %q", got)
+	}
+	paramsSingleArr := map[string]any{"bucket": []any{"only-bucket"}}
+	if got := ExtractParam(paramsSingleArr, "bucket"); got != "only-bucket" {
+		t.Fatalf("single array = %q", got)
+	}
+	paramsArr := map[string]any{"bucket": []any{"first-bucket", "second-bucket"}}
+	if got := ExtractParam(paramsArr, "bucket"); got != "first-bucket" {
+		t.Fatalf("array = %q", got)
+	}
+	if got := ExtractParam(paramsStr, "nonexistent"); got != "" {
+		t.Fatalf("missing = %q", got)
+	}
+}
diff --git a/internal/resource/fetcher.go b/internal/resource/fetcher.go
new file mode 100644
index 0000000..e63bcc5
--- /dev/null
+++ b/internal/resource/fetcher.go
@@ -0,0 +1,202 @@
+package resource
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/huseyinbabal/taws/internal/aws"
+)
+
+// ResourceFilter filters sub-resource listings.
+type ResourceFilter struct {
+	Name       string
+	Values     []string
+	FilterType string
+}
+
+// NewResourceFilter creates a scalar filter.
+func NewResourceFilter(name string, values []string) ResourceFilter {
+	return ResourceFilter{Name: name, Values: values, FilterType: "scalar"}
+}
+
+// WithFilterType creates a filter with an explicit type.
+func WithFilterType(name string, values []string, filterType string) ResourceFilter {
+	return ResourceFilter{Name: name, Values: values, FilterType: filterType}
+}
+
+// PaginatedResult holds a page of items and an optional next token.
+type PaginatedResult struct {
+	Items     []any
+	NextToken *string
+}
+
+// FetchResourcesPaginated fetches a page of resources using JSON configuration.
+func FetchResourcesPaginated(resourceKey string, clients *aws.AwsClients, filters []ResourceFilter, pageToken *string) (*PaginatedResult, error) {
+	resourceDef := GetResource(resourceKey)
+	if resourceDef == nil {
+		return nil, fmt.Errorf("Unknown resource: %s", resourceKey)
+	}
+
+	params := map[string]any{}
+	if existing, ok := resourceDef.SDKMethodParams.(map[string]any); ok {
+		for k, v := range existing {
+			params[k] = v
+		}
+	}
+
+	for _, filter := range filters {
+		switch filter.FilterType {
+		case "ec2_filter":
+			values := make([]any, 0, len(filter.Values))
+			for _, v := range filter.Values {
+				values = append(values, v)
+			}
+			params["filter:"+filter.Name] = values
+		default:
+			if len(filter.Values) == 1 {
+				params[filter.Name] = filter.Values[0]
+			} else {
+				values := make([]any, 0, len(filter.Values))
+				for _, v := range filter.Values {
+					values = append(values, v)
+				}
+				params[filter.Name] = values
+			}
+		}
+	}
+
+	if pageToken != nil {
+		params["_page_token"] = *pageToken
+	}
+
+	var response any
+	var err error
+	if resourceDef.HasAPIConfig() {
+		response, err = InvokeList(resourceKey, clients, params)
+	} else {
+		response, err = InvokeSDK(resourceDef.Service, resourceDef.SDKMethod, clients, params)
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	items, err := extractItems(response, resourceDef.ResponsePath)
+	if err != nil {
+		return nil, err
+	}
+	if items == nil {
+		items = []any{}
+	}
+
+	if !resourceDef.PreserveOrder {
+		sortField := resourceDef.NameField
+		if resourceDef.SortField != nil {
+			sortField = *resourceDef.SortField
+		}
+		descending := resourceDef.SortOrder != nil && *resourceDef.SortOrder == "desc"
+		sort.SliceStable(items, func(i, j int) bool {
+			aVal := stringAt(items[i], sortField)
+			bVal := stringAt(items[j], sortField)
+			if descending {
+				return bVal < aVal
+			}
+			return aVal < bVal
+		})
+	}
+
+	var nextToken *string
+	if m, ok := response.(map[string]any); ok {
+		if token, ok := m["_next_token"].(string); ok {
+			nextToken = &token
+		}
+	}
+
+	return &PaginatedResult{Items: items, NextToken: nextToken}, nil
+}
+
+func extractItems(response any, path string) ([]any, error) {
+	parts := strings.Split(path, ".")
+	current := response
+	for _, part := range parts {
+		m, ok := current.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("Path '%s' not found in response", path)
+		}
+		next, ok := m[part]
+		if !ok {
+			return nil, fmt.Errorf("Path '%s' not found in response", path)
+		}
+		current = next
+	}
+	if arr, ok := current.([]any); ok {
+		return arr, nil
+	}
+	return nil, fmt.Errorf("Expected array at path '%s'", path)
+}
+
+func stringAt(item any, field string) string {
+	m, ok := item.(map[string]any)
+	if !ok {
+		return ""
+	}
+	if s, ok := m[field].(string); ok {
+		return s
+	}
+	return ""
+}
+
+// ExtractJSONValue extracts a value using dot notation, including Tags.Name.
+func ExtractJSONValue(item any, path string) string {
+	parts := strings.Split(path, ".")
+	current := item
+
+	for _, part := range parts {
+		m, ok := current.(map[string]any)
+		if ok {
+			if part == "Name" {
+				if _, hasTags := m["Tags"]; hasTags {
+					if tags, ok := m["Tags"].(map[string]any); ok {
+						if name, ok := tags["Name"].(string); ok {
+							return name
+						}
+					}
+				}
+			}
+			if v, ok := m[part]; ok {
+				current = v
+			} else {
+				current = nil
+			}
+			continue
+		}
+		if arr, ok := current.([]any); ok {
+			if part == "length" {
+				return strconv.Itoa(len(arr))
+			}
+			idx, err := strconv.Atoi(part)
+			if err == nil && idx >= 0 && idx < len(arr) {
+				current = arr[idx]
+			} else {
+				current = nil
+			}
+			continue
+		}
+		current = nil
+	}
+
+	switch v := current.(type) {
+	case string:
+		return v
+	case float64:
+		return strconv.FormatFloat(v, 'f', -1, 64)
+	case bool:
+		if v {
+			return "Yes"
+		}
+		return "No"
+	default:
+		return "-"
+	}
+}
diff --git a/internal/resource/field_mapper.go b/internal/resource/field_mapper.go
new file mode 100644
index 0000000..c070d56
--- /dev/null
+++ b/internal/resource/field_mapper.go
@@ -0,0 +1,335 @@
+package resource
+
+import (
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// ApplyFieldMappings transforms a raw API response item into normalized output.
+func ApplyFieldMappings(item any, mappings map[string]FieldMapping) any {
+	result := make(map[string]any, len(mappings))
+	for targetField, mapping := range mappings {
+		var value any
+		if mapping.Source == "" || mapping.Source == "/" {
+			value = item
+		} else {
+			value = ExtractByPath(item, mapping.Source)
+		}
+
+		if mapping.Transform != nil {
+			value = ApplyTransform(value, *mapping.Transform)
+		}
+
+		if value == nil {
+			if mapping.Default != nil {
+				value = *mapping.Default
+			} else {
+				value = "-"
+			}
+		} else {
+			switch v := value.(type) {
+			case string:
+				value = v
+			case json.Number:
+				value = v.String()
+			case float64:
+				value = strconv.FormatFloat(v, 'f', -1, 64)
+			case int:
+				value = strconv.Itoa(v)
+			case int64:
+				value = strconv.FormatInt(v, 10)
+			case bool:
+				if v {
+					value = "Yes"
+				} else {
+					value = "No"
+				}
+			case []any, map[string]any:
+				// keep complex types as-is
+			case nil:
+				value = "-"
+			default:
+				value = fmt.Sprintf("%v", v)
+			}
+		}
+
+		result[targetField] = value
+	}
+	return result
+}
+
+// ApplyTransform applies a named transformation to a value.
+func ApplyTransform(value any, transform string) any {
+	switch transform {
+	case "tags_to_map":
+		return TransformTagsToMap(value)
+	case "format_bytes":
+		return TransformFormatBytes(value)
+	case "format_epoch_millis":
+		return TransformFormatEpochMillis(value)
+	case "bool_to_yes_no":
+		return TransformBoolToYesNo(value)
+	case "array_to_csv":
+		return TransformArrayToCSV(value)
+	case "first_item":
+		return TransformFirstItem(value)
+	case "private_zone_to_type":
+		return TransformPrivateZoneToType(value)
+	case "route53_record_value":
+		return TransformRoute53RecordValue(value)
+	case "route53_record_id":
+		return TransformRoute53RecordID(value)
+	default:
+		return value
+	}
+}
+
+// TransformRoute53RecordID creates the Name#Type unique identifier.
+func TransformRoute53RecordID(value any) any {
+	m, _ := value.(map[string]any)
+	name := "-"
+	recordType := "-"
+	if m != nil {
+		if s, ok := m["Name"].(string); ok {
+			name = s
+		}
+		if s, ok := m["Type"].(string); ok {
+			recordType = s
+		}
+	}
+	return fmt.Sprintf("%s#%s", name, recordType)
+}
+
+// TransformPrivateZoneToType converts a private-zone boolean to Public/Private.
+func TransformPrivateZoneToType(value any) any {
+	switch v := value.(type) {
+	case bool:
+		if v {
+			return "Private"
+		}
+		return "Public"
+	case string:
+		if v == "true" || v == "True" || v == "TRUE" {
+			return "Private"
+		}
+		return "Public"
+	default:
+		return "Public"
+	}
+}
+
+// TransformRoute53RecordValue flattens ResourceRecords/AliasTarget to a value.
+func TransformRoute53RecordValue(value any) any {
+	m, _ := value.(map[string]any)
+	if m == nil {
+		return "-"
+	}
+	if aliasTarget, ok := m["AliasTarget"].(map[string]any); ok {
+		if dnsName, ok := aliasTarget["DNSName"].(string); ok {
+			return dnsName
+		}
+		return "-"
+	}
+	if resourceRecords, ok := m["ResourceRecords"].(map[string]any); ok {
+		records, ok := resourceRecords["ResourceRecord"]
+		if !ok {
+			return "-"
+		}
+		var arr []any
+		switch v := records.(type) {
+		case []any:
+			arr = v
+		case map[string]any:
+			arr = []any{v}
+		default:
+			return "-"
+		}
+		values := make([]string, 0, len(arr))
+		for _, itemEntry := range arr {
+			itemMap, ok := itemEntry.(map[string]any)
+			if !ok {
+				continue
+			}
+			if s, ok := itemMap["Value"].(string); ok {
+				values = append(values, s)
+			} else if s, ok := itemMap["value"].(string); ok {
+				values = append(values, s)
+			}
+		}
+		if len(values) > 0 {
+			return strings.Join(values, ", ")
+		}
+	}
+	return "-"
+}
+
+// TransformTagsToMap converts an AWS tag array into a key/value map.
+func TransformTagsToMap(value any) any {
+	tags := map[string]any{}
+	var items []any
+	switch v := value.(type) {
+	case []any:
+		items = v
+	case map[string]any:
+		items = []any{v}
+	default:
+		return tags
+	}
+	for _, tagEntry := range items {
+		tag, ok := tagEntry.(map[string]any)
+		if !ok {
+			continue
+		}
+		key, ok := stringField(tag, "key", "Key")
+		if !ok {
+			continue
+		}
+		val, ok := stringField(tag, "value", "Value")
+		if !ok {
+			continue
+		}
+		tags[key] = val
+	}
+	return tags
+}
+
+func stringField(m map[string]any, keys ...string) (string, bool) {
+	for _, k := range keys {
+		if s, ok := m[k].(string); ok {
+			return s, true
+		}
+	}
+	return "", false
+}
+
+// TransformFormatBytes formats a byte count into a human-readable string.
+func TransformFormatBytes(value any) any {
+	var bytes uint64
+	switch v := value.(type) {
+	case json.Number:
+		bytes, _ = strconv.ParseUint(v.String(), 10, 64)
+	case float64:
+		bytes = uint64(v)
+	case int:
+		bytes = uint64(v)
+	case int64:
+		bytes = uint64(v)
+	case string:
+		bytes, _ = strconv.ParseUint(v, 10, 64)
+	default:
+		return "-"
+	}
+
+	const (
+		kb = uint64(1024)
+		mb = kb * 1024
+		gb = mb * 1024
+		tb = gb * 1024
+	)
+
+	switch {
+	case bytes >= tb:
+		return fmt.Sprintf("%.1f TB", float64(bytes)/float64(tb))
+	case bytes >= gb:
+		return fmt.Sprintf("%.1f GB", float64(bytes)/float64(gb))
+	case bytes >= mb:
+		return fmt.Sprintf("%.1f MB", float64(bytes)/float64(mb))
+	case bytes >= kb:
+		return fmt.Sprintf("%.1f KB", float64(bytes)/float64(kb))
+	default:
+		return fmt.Sprintf("%d B", bytes)
+	}
+}
+
+// TransformFormatEpochMillis formats a seconds or milliseconds epoch timestamp.
+func TransformFormatEpochMillis(value any) any {
+	var raw float64
+	switch v := value.(type) {
+	case json.Number:
+		f, err := v.Float64()
+		if err != nil {
+			return "-"
+		}
+		raw = f
+	case float64:
+		raw = v
+	case int:
+		raw = float64(v)
+	case int64:
+		raw = float64(v)
+	case string:
+		f, err := strconv.ParseFloat(v, 64)
+		if err != nil {
+			return "-"
+		}
+		raw = f
+	default:
+		return "-"
+	}
+	if raw <= 0 {
+		return "-"
+	}
+	secs := int64(raw)
+	if raw >= 1e11 {
+		secs = int64(raw / 1000.0)
+	}
+	return time.Unix(secs, 0).UTC().Format("2006-01-02 15:04:05")
+}
+
+// TransformBoolToYesNo converts booleans and boolean strings to Yes/No.
+func TransformBoolToYesNo(value any) any {
+	switch v := value.(type) {
+	case bool:
+		if v {
+			return "Yes"
+		}
+		return "No"
+	case string:
+		if v == "true" || v == "True" || v == "TRUE" || v == "yes" || v == "Yes" {
+			return "Yes"
+		}
+		return "No"
+	default:
+		return "-"
+	}
+}
+
+// TransformArrayToCSV joins array elements with commas.
+func TransformArrayToCSV(value any) any {
+	arr, ok := value.([]any)
+	if !ok {
+		return value
+	}
+	parts := make([]string, 0, len(arr))
+	for _, v := range arr {
+		parts = append(parts, ValueToString(v, ""))
+	}
+	return strings.Join(parts, ", ")
+}
+
+// TransformFirstItem returns the first element of an array.
+func TransformFirstItem(value any) any {
+	arr, ok := value.([]any)
+	if !ok {
+		return value
+	}
+	if len(arr) == 0 {
+		return nil
+	}
+	return arr[0]
+}
+
+// BuildResponse builds a normalized response with items under responseKey.
+func BuildResponse(items []any, responseKey string, nextToken *string) any {
+	if items == nil {
+		items = []any{}
+	}
+	response := map[string]any{responseKey: items}
+	if nextToken != nil {
+		response["_next_token"] = *nextToken
+	}
+	return response
+}
diff --git a/internal/resource/field_mapper_test.go b/internal/resource/field_mapper_test.go
new file mode 100644
index 0000000..f21fbb5
--- /dev/null
+++ b/internal/resource/field_mapper_test.go
@@ -0,0 +1,184 @@
+package resource
+
+import (
+	"testing"
+)
+
+func TestApplyFieldMappings(t *testing.T) {
+	item := map[string]any{
+		"instanceId": "i-123",
+		"instanceState": map[string]any{
+			"name": "running",
+		},
+	}
+	mappings := map[string]FieldMapping{
+		"InstanceId": {Source: "/instanceId"},
+		"State":      {Source: "/instanceState/name"},
+	}
+	result := ApplyFieldMappings(item, mappings).(map[string]any)
+	if result["InstanceId"] != "i-123" {
+		t.Fatalf("InstanceId = %v", result["InstanceId"])
+	}
+	if result["State"] != "running" {
+		t.Fatalf("State = %v", result["State"])
+	}
+}
+
+func TestApplyFieldMappingsWithDefault(t *testing.T) {
+	item := map[string]any{"instanceId": "i-123"}
+	def := "N/A"
+	mappings := map[string]FieldMapping{
+		"PublicIp": {Source: "/publicIp", Default: &def},
+	}
+	result := ApplyFieldMappings(item, mappings).(map[string]any)
+	if result["PublicIp"] != "N/A" {
+		t.Fatalf("PublicIp = %v", result["PublicIp"])
+	}
+}
+
+func TestTransformTagsToMap(t *testing.T) {
+	tags := []any{
+		map[string]any{"key": "Name", "value": "MyInstance"},
+		map[string]any{"key": "Env", "value": "prod"},
+	}
+	result := TransformTagsToMap(tags).(map[string]any)
+	if result["Name"] != "MyInstance" {
+		t.Fatalf("Name = %v", result["Name"])
+	}
+	if result["Env"] != "prod" {
+		t.Fatalf("Env = %v", result["Env"])
+	}
+}
+
+func TestTransformTagsCapitalCase(t *testing.T) {
+	tags := []any{map[string]any{"Key": "Name", "Value": "MyInstance"}}
+	result := TransformTagsToMap(tags).(map[string]any)
+	if result["Name"] != "MyInstance" {
+		t.Fatalf("Name = %v", result["Name"])
+	}
+}
+
+func TestTransformFormatBytes(t *testing.T) {
+	cases := map[float64]string{
+		0:          "0 B",
+		1024:       "1.0 KB",
+		1048576:    "1.0 MB",
+		1073741824: "1.0 GB",
+	}
+	for input, want := range cases {
+		if got := TransformFormatBytes(input); got != want {
+			t.Fatalf("format bytes %v = %v, want %v", input, got, want)
+		}
+	}
+}
+
+func TestTransformBoolToYesNo(t *testing.T) {
+	if got := TransformBoolToYesNo(true); got != "Yes" {
+		t.Fatalf("true = %v", got)
+	}
+	if got := TransformBoolToYesNo(false); got != "No" {
+		t.Fatalf("false = %v", got)
+	}
+	if got := TransformBoolToYesNo("true"); got != "Yes" {
+		t.Fatalf("\"true\" = %v", got)
+	}
+	if got := TransformBoolToYesNo("false"); got != "No" {
+		t.Fatalf("\"false\" = %v", got)
+	}
+}
+
+func TestBuildResponse(t *testing.T) {
+	items := []any{map[string]any{"id": "1"}, map[string]any{"id": "2"}}
+	token := "token123"
+	response := BuildResponse(items, "instances", &token).(map[string]any)
+	if len(response["instances"].([]any)) != 2 {
+		t.Fatalf("instances len = %d", len(response["instances"].([]any)))
+	}
+	if response["_next_token"] != "token123" {
+		t.Fatalf("next token = %v", response["_next_token"])
+	}
+}
+
+func TestTransformRoute53RecordValueWithSingleResourceRecord(t *testing.T) {
+	record := map[string]any{
+		"ResourceRecords": map[string]any{
+			"ResourceRecord": map[string]any{"Value": "192.0.2.1"},
+		},
+	}
+	if got := TransformRoute53RecordValue(record); got != "192.0.2.1" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestTransformRoute53RecordValueWithMultipleResourceRecords(t *testing.T) {
+	record := map[string]any{
+		"ResourceRecords": map[string]any{
+			"ResourceRecord": []any{
+				map[string]any{"Value": "192.0.2.1"},
+				map[string]any{"Value": "192.0.2.2"},
+				map[string]any{"Value": "192.0.2.3"},
+			},
+		},
+	}
+	if got := TransformRoute53RecordValue(record); got != "192.0.2.1, 192.0.2.2, 192.0.2.3" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestTransformRoute53RecordValueWithAliasTarget(t *testing.T) {
+	record := map[string]any{
+		"AliasTarget": map[string]any{
+			"DNSName":              "elb-123.us-east-1.elb.amazonaws.com",
+			"HostedZoneId":         "Z35SXDOTRQ7X7K",
+			"EvaluateTargetHealth": "false",
+		},
+	}
+	if got := TransformRoute53RecordValue(record); got != "elb-123.us-east-1.elb.amazonaws.com" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestTransformRoute53RecordValueWithEmptyRecords(t *testing.T) {
+	record := map[string]any{
+		"ResourceRecords": map[string]any{"ResourceRecord": []any{}},
+	}
+	if got := TransformRoute53RecordValue(record); got != "-" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestTransformRoute53RecordValueWithNoValue(t *testing.T) {
+	if got := TransformRoute53RecordValue(map[string]any{}); got != "-" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestTransformRoute53RecordID(t *testing.T) {
+	record := map[string]any{"Name": "example.com.", "Type": "A"}
+	if got := TransformRoute53RecordID(record); got != "example.com.#A" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestTransformRoute53RecordIDWithDifferentTypes(t *testing.T) {
+	cases := []struct {
+		recordType string
+		want       string
+	}{
+		{"A", "example.com.#A"},
+		{"AAAA", "example.com.#AAAA"},
+		{"MX", "example.com.#MX"},
+	}
+	for _, tc := range cases {
+		record := map[string]any{"Name": "example.com.", "Type": tc.recordType}
+		if got := TransformRoute53RecordID(record); got != tc.want {
+			t.Fatalf("type %s = %v, want %v", tc.recordType, got, tc.want)
+		}
+	}
+}
+
+func TestTransformRoute53RecordIDWithMissingFields(t *testing.T) {
+	if got := TransformRoute53RecordID(map[string]any{}); got != "-#-" {
+		t.Fatalf("got %v", got)
+	}
+}
diff --git a/internal/resource/handlers.go b/internal/resource/handlers.go
new file mode 100644
index 0000000..a23770e
--- /dev/null
+++ b/internal/resource/handlers.go
@@ -0,0 +1,357 @@
+package resource
+
+import (
+	"fmt"
+	"net/url"
+	"strconv"
+
+	"github.com/huseyinbabal/taws/internal/aws"
+)
+
+// UnifiedProtocolHandler dispatches protocol-specific request building and
+// response parsing.
+type UnifiedProtocolHandler struct {
+	Protocol APIProtocol
+}
+
+// GetProtocolHandler returns a handler for the given protocol.
+func GetProtocolHandler(protocol APIProtocol) *UnifiedProtocolHandler {
+	return &UnifiedProtocolHandler{Protocol: protocol.effective()}
+}
+
+// Execute builds and sends the list request for the handler's protocol.
+func (h *UnifiedProtocolHandler) Execute(clients *aws.AwsClients, service string, config *APIConfig, params any) (string, error) {
+	switch h.Protocol {
+	case ProtocolQuery:
+		return executeQueryList(clients, service, config, params)
+	case ProtocolJSON:
+		return executeJSONList(clients, service, config, params)
+	case ProtocolRestJSON:
+		return executeRESTJSONList(clients, service, config, params)
+	case ProtocolRestXML:
+		return executeRESTXMLList(clients, service, config, params)
+	default:
+		return "", fmt.Errorf("unsupported protocol: %s", h.Protocol)
+	}
+}
+
+// ParseItems parses a raw response into items and an optional next token.
+func (h *UnifiedProtocolHandler) ParseItems(response string, config *APIConfig) ([]any, *string, error) {
+	switch h.Protocol {
+	case ProtocolQuery:
+		jsonVal, err := aws.XMLToJSON(response)
+		if err != nil {
+			return nil, nil, err
+		}
+		return parseItemsFromJSON(jsonVal, config, false), nextToken(jsonVal, config), nil
+	case ProtocolJSON, ProtocolRestJSON:
+		jsonVal, err := parseJSON(response)
+		if err != nil {
+			return nil, nil, err
+		}
+		return parseItemsFromJSON(jsonVal, config, true), nextToken(jsonVal, config), nil
+	case ProtocolRestXML:
+		jsonVal, err := aws.XMLToJSON(response)
+		if err != nil {
+			return nil, nil, err
+		}
+		return parseItemsFromJSON(jsonVal, config, false), nextToken(jsonVal, config), nil
+	default:
+		return nil, nil, fmt.Errorf("unsupported protocol: %s", h.Protocol)
+	}
+}
+
+// Invoke runs the full pipeline: execute, parse, and apply field mappings.
+func (h *UnifiedProtocolHandler) Invoke(clients *aws.AwsClients, service string, config *APIConfig, params any, fieldMappings map[string]FieldMapping) (*ParsedResponse, error) {
+	response, err := h.Execute(clients, service, config, params)
+	if err != nil {
+		return nil, err
+	}
+	items, nextToken, err := h.ParseItems(response, config)
+	if err != nil {
+		return nil, err
+	}
+	mapped := items
+	if len(fieldMappings) > 0 {
+		mapped = make([]any, 0, len(items))
+		for _, item := range items {
+			mapped = append(mapped, ApplyFieldMappings(item, fieldMappings))
+		}
+	}
+	return &ParsedResponse{Items: mapped, NextToken: nextToken}, nil
+}
+
+func parseItemsFromJSON(jsonVal any, config *APIConfig, allowBare bool) []any {
+	if config.ResponseRoot != nil {
+		return ExtractList(jsonVal, *config.ResponseRoot)
+	}
+	if allowBare {
+		if arr, ok := jsonVal.([]any); ok {
+			return arr
+		}
+		return []any{jsonVal}
+	}
+	return []any{}
+}
+
+func nextToken(jsonVal any, config *APIConfig) *string {
+	if config.Pagination == nil || config.Pagination.OutputToken == nil {
+		return nil
+	}
+	token := ExtractByPath(jsonVal, *config.Pagination.OutputToken)
+	if s, ok := token.(string); ok {
+		return &s
+	}
+	return nil
+}
+
+// ---- Query protocol ----
+
+func executeQueryList(clients *aws.AwsClients, service string, config *APIConfig, params any) (string, error) {
+	if config.Action == nil {
+		return "", fmt.Errorf("Query protocol requires 'action' field")
+	}
+
+	paramMap, _ := params.(map[string]any)
+	hasOwnerFilter := false
+	for k := range paramMap {
+		if len(k) >= 6 && k[:6] == "owner:" {
+			hasOwnerFilter = true
+			break
+		}
+	}
+
+	queryParams := [][2]string{}
+
+	for key, value := range config.StaticParams {
+		if hasOwnerFilter && len(key) >= 6 && key[:6] == "Owner." {
+			continue
+		}
+		if s, ok := value.(string); ok {
+			queryParams = append(queryParams, [2]string{key, s})
+		}
+	}
+
+	if config.Pagination != nil {
+		if config.Pagination.MaxResultsParam != nil {
+			maxValue := uint32(100)
+			if config.Pagination.MaxResults != nil {
+				maxValue = *config.Pagination.MaxResults
+			}
+			queryParams = append(queryParams, [2]string{*config.Pagination.MaxResultsParam, strconv.FormatUint(uint64(maxValue), 10)})
+		}
+		if token, ok := paramMap["_page_token"].(string); ok {
+			if config.Pagination.InputToken != nil {
+				queryParams = append(queryParams, [2]string{*config.Pagination.InputToken, token})
+			}
+		}
+	}
+
+	filterIndex := 1
+	ownerIndex := 1
+
+	for key, value := range paramMap {
+		if len(key) > 0 && key[0] == '_' {
+			continue
+		}
+		if len(key) >= 4 && key[:4] == "tag:" {
+			if arr, ok := value.([]any); ok {
+				queryParams = append(queryParams, [2]string{fmt.Sprintf("Filter.%d.Name", filterIndex), key})
+				for i, item := range arr {
+					if s, ok := item.(string); ok {
+						queryParams = append(queryParams, [2]string{fmt.Sprintf("Filter.%d.Value.%d", filterIndex, i+1), s})
+					}
+				}
+				filterIndex++
+			}
+			continue
+		}
+		if len(key) >= 6 && key[:6] == "owner:" {
+			if arr, ok := value.([]any); ok {
+				for _, item := range arr {
+					if s, ok := item.(string); ok {
+						queryParams = append(queryParams, [2]string{fmt.Sprintf("Owner.%d", ownerIndex), s})
+						ownerIndex++
+					}
+				}
+			}
+			continue
+		}
+		if len(key) >= 7 && key[:7] == "filter:" {
+			filterKey := key[7:]
+			if arr, ok := value.([]any); ok {
+				queryParams = append(queryParams, [2]string{fmt.Sprintf("Filter.%d.Name", filterIndex), filterKey})
+				for i, item := range arr {
+					if s, ok := item.(string); ok {
+						queryParams = append(queryParams, [2]string{fmt.Sprintf("Filter.%d.Value.%d", filterIndex, i+1), s})
+					}
+				}
+				filterIndex++
+			}
+			continue
+		}
+
+		mappedKey := key
+		if mapped, ok := config.ParamMapping[key]; ok {
+			mappedKey = mapped
+		}
+		switch v := value.(type) {
+		case string:
+			queryParams = append(queryParams, [2]string{mappedKey, v})
+		case []any:
+			for i, item := range v {
+				if s, ok := item.(string); ok {
+					queryParams = append(queryParams, [2]string{fmt.Sprintf("%s.%d", mappedKey, i+1), s})
+				}
+			}
+		case float64:
+			queryParams = append(queryParams, [2]string{mappedKey, strconv.FormatFloat(v, 'f', -1, 64)})
+		case bool:
+			queryParams = append(queryParams, [2]string{mappedKey, strconv.FormatBool(v)})
+		}
+	}
+
+	return clients.HTTP.QueryRequest(service, *config.Action, queryParams)
+}
+
+// ---- JSON protocol ----
+
+func executeJSONList(clients *aws.AwsClients, service string, config *APIConfig, params any) (string, error) {
+	if config.Action == nil {
+		return "", fmt.Errorf("JSON protocol requires 'action' field")
+	}
+	body := map[string]any{}
+	for key, value := range config.StaticParams {
+		body[key] = value
+	}
+	if config.Pagination != nil {
+		if config.Pagination.MaxResultsParam != nil {
+			maxValue := uint32(100)
+			if config.Pagination.MaxResults != nil {
+				maxValue = *config.Pagination.MaxResults
+			}
+			body[*config.Pagination.MaxResultsParam] = float64(maxValue)
+		}
+		if token, ok := params.(map[string]any)["_page_token"].(string); ok {
+			if config.Pagination.InputToken != nil {
+				body[*config.Pagination.InputToken] = token
+			}
+		}
+	}
+	for key, value := range asMap(params) {
+		if len(key) > 0 && key[0] == '_' {
+			continue
+		}
+		mappedKey := key
+		if mapped, ok := config.ParamMapping[key]; ok {
+			mappedKey = mapped
+		}
+		body[mappedKey] = unwrapSingle(value)
+	}
+	bodyStr, err := marshalJSON(body)
+	if err != nil {
+		return "", err
+	}
+	return clients.HTTP.JSONRequest(service, *config.Action, bodyStr)
+}
+
+// ---- REST-JSON protocol ----
+
+func executeRESTJSONList(clients *aws.AwsClients, service string, config *APIConfig, params any) (string, error) {
+	method := "GET"
+	if config.Method != nil {
+		method = *config.Method
+	}
+	if config.Path == nil {
+		return "", fmt.Errorf("REST-JSON protocol requires 'path' field")
+	}
+	path := *config.Path
+	for key, value := range asMap(params) {
+		if s, ok := value.(string); ok {
+			path = replaceToken(path, key, s)
+		}
+	}
+
+	if method == "GET" {
+		queryParts := []string{}
+		if token, ok := params.(map[string]any)["_page_token"].(string); ok && config.Pagination != nil && config.Pagination.InputToken != nil {
+			queryParts = append(queryParts, *config.Pagination.InputToken+"="+url.QueryEscape(token))
+		}
+		if config.Pagination != nil && config.Pagination.MaxResultsParam != nil {
+			maxValue := uint32(50)
+			if config.Pagination.MaxResults != nil {
+				maxValue = *config.Pagination.MaxResults
+			}
+			queryParts = append(queryParts, *config.Pagination.MaxResultsParam+"="+strconv.FormatUint(uint64(maxValue), 10))
+		}
+		if len(queryParts) > 0 {
+			if contains(path, "?") {
+				path = path + "&" + join(queryParts, "&")
+			} else {
+				path = path + "?" + join(queryParts, "&")
+			}
+		}
+	}
+
+	var body *string
+	if method != "GET" {
+		bodyMap := map[string]any{}
+		for key, value := range config.StaticParams {
+			bodyMap[key] = value
+		}
+		for key, value := range asMap(params) {
+			if len(key) > 0 && key[0] == '_' {
+				continue
+			}
+			bodyMap[key] = unwrapSingle(value)
+		}
+		if len(bodyMap) > 0 {
+			bodyStr, err := marshalJSON(bodyMap)
+			if err != nil {
+				return "", err
+			}
+			body = &bodyStr
+		}
+	}
+
+	return clients.HTTP.RESTJSONRequest(service, method, path, body)
+}
+
+// ---- REST-XML protocol ----
+
+func executeRESTXMLList(clients *aws.AwsClients, service string, config *APIConfig, params any) (string, error) {
+	method := "GET"
+	if config.Method != nil {
+		method = *config.Method
+	}
+	path := "/"
+	if config.Path != nil {
+		path = *config.Path
+	}
+	for key, value := range asMap(params) {
+		if s, ok := value.(string); ok {
+			path = replaceToken(path, key, s)
+		}
+	}
+
+	queryParts := []string{}
+	if method == "GET" {
+		for key, value := range config.StaticParams {
+			if s, ok := value.(string); ok {
+				queryParts = append(queryParts, key+"="+url.QueryEscape(s))
+			}
+		}
+	}
+	if token, ok := params.(map[string]any)["_page_token"].(string); ok && config.Pagination != nil && config.Pagination.InputToken != nil {
+		queryParts = append(queryParts, *config.Pagination.InputToken+"="+url.QueryEscape(token))
+	}
+	if len(queryParts) > 0 {
+		if contains(path, "?") {
+			path = path + "&" + join(queryParts, "&")
+		} else {
+			path = path + "?" + join(queryParts, "&")
+		}
+	}
+
+	return clients.HTTP.RESTXMLRequest(service, method, path, nil)
+}
