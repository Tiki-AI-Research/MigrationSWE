diff --git a/Cargo.toml b/Cargo.toml
deleted file mode 100644
index e16ba35..0000000
--- a/Cargo.toml
+++ /dev/null
@@ -1,63 +0,0 @@
-[package]
-name = "taws"
-version = "1.3.0-rc.8"
-edition = "2021"
-description = "Terminal UI for AWS - navigate, observe, and manage AWS resources"
-license = "MIT"
-repository = "https://github.com/huseyinbabal/taws"
-homepage = "https://github.com/huseyinbabal/taws"
-readme = "README.md"
-keywords = ["aws", "tui", "terminal", "cloud", "infrastructure"]
-categories = ["command-line-utilities", "development-tools"]
-authors = ["Huseyin Babal"]
-
-[dependencies]
-# TUI
-ratatui = "0.30"
-crossterm = "0.29"
-
-# AWS (lightweight - SigV4 only, no SDK)
-aws-sigv4 = "1.2"
-aws-credential-types = "1.2"
-aws-smithy-runtime-api = "1.2"
-
-# HTTP client (using rustls to avoid OpenSSL cross-compilation issues)
-reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls", "blocking"] }
-url = "2.5"
-urlencoding = "2.1"
-
-# Async runtime
-tokio = { version = "1.52", features = ["full"] }
-
-# Serialization
-serde = { version = "1.0", features = ["derive"] }
-serde_json = "1.0"
-serde_yaml = "0.9"
-
-# XML parsing (for EC2, IAM, RDS Query protocol APIs)
-quick-xml = { version = "0.39", features = ["serialize"] }
-
-# CLI argument parsing
-clap = { version = "4.5", features = ["derive"] }
-clap_complete = "4.6"
-
-# Logging
-tracing = "0.1"
-tracing-subscriber = { version = "0.3", features = ["env-filter"] }
-tracing-appender = "0.2"
-
-# Utils
-anyhow = "1.0"
-thiserror = "2.0"
-dirs = "6.0"
-chrono = { version = "0.4", default-features = false, features = ["std", "clock"] }
-sha1 = "0.11"
-sha2 = "0.11"
-open = "5.3"
-fuzzy-matcher = "0.3.7"
-async-trait = "0.1.89"
-arboard = "3.6"
-
-[dev-dependencies]
-dirs = "6.0"
-tempfile = "3.24.0"
diff --git a/Dockerfile b/Dockerfile
index 2975ee7..f86ba0f 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,42 +1,29 @@
 # Stage 1: Build
-FROM rust:latest AS builder
-
-# Install build dependencies
-RUN apt-get update && apt-get install -y \
-    pkg-config \
-    libssl-dev \
-    && rm -rf /var/lib/apt/lists/*
+FROM golang:1.23 AS builder
 
 WORKDIR /app
 
-# Copy manifests first for better caching
-COPY Cargo.toml Cargo.lock ./
-
-# Create dummy src to build dependencies
-RUN mkdir src && echo "fn main() {}" > src/main.rs
-
-# Build dependencies only
-RUN cargo build --release && rm -rf src
+# Copy module files and vendored dependencies first for better caching
+COPY go.mod go.sum ./
+COPY vendor ./vendor
 
-# Copy actual source code
+# Copy the Go sources and embedded assets
+COPY main.go ./
 COPY src ./src
+COPY internal ./internal
 
-# Build the actual binary
-RUN touch src/main.rs && cargo build --release
+# Build a static binary
+RUN CGO_ENABLED=0 GOFLAGS=-mod=vendor go build -trimpath -ldflags "-s -w -X main.version=$(git describe --tags --always --dirty 2>/dev/null || echo dev)" -o /out/taws .
 
-# Stage 2: Runtime (same base as builder for glibc compatibility)
-FROM debian:trixie-slim
+# Stage 2: Runtime
+FROM debian:bookworm-slim
 
-# Install runtime dependencies for TLS
 RUN apt-get update && apt-get install -y \
     ca-certificates \
-    libssl3t64 \
     && rm -rf /var/lib/apt/lists/*
 
-# Copy binary from builder
-COPY --from=builder /app/target/release/taws /usr/local/bin/taws
+COPY --from=builder /out/taws /usr/local/bin/taws
 
-# Set terminal for TUI
 ENV TERM=xterm-256color
 
 ENTRYPOINT ["taws"]
