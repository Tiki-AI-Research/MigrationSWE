+package config
+
+import (
+	"bytes"
+	"log"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"gopkg.in/yaml.v3"
+)
+
+func TestDefaultConfig(t *testing.T) {
+	var config Config
+	if config.Profile != nil {
+		t.Fatal("profile should be nil")
+	}
+	if config.Region != nil {
+		t.Fatal("region should be nil")
+	}
+}
+
+func TestSerializeDeserialize(t *testing.T) {
+	profile := "my-profile"
+	region := "eu-west-1"
+	lastResource := "ec2-instances"
+	config := Config{
+		Profile:             &profile,
+		Region:              &region,
+		LastResource:        &lastResource,
+		RecentlyUsedRegions: []string{"eu-west-1", "us-east-1"},
+	}
+
+	data, err := yaml.Marshal(&config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var parsed Config
+	if err := yaml.Unmarshal(data, &parsed); err != nil {
+		t.Fatal(err)
+	}
+
+	if !reflect.DeepEqual(parsed.Profile, config.Profile) {
+		t.Fatalf("profile = %v", parsed.Profile)
+	}
+	if !reflect.DeepEqual(parsed.Region, config.Region) {
+		t.Fatalf("region = %v", parsed.Region)
+	}
+	if !reflect.DeepEqual(parsed.LastResource, config.LastResource) {
+		t.Fatalf("last_resource = %v", parsed.LastResource)
+	}
+	if !reflect.DeepEqual(parsed.RecentlyUsedRegions, config.RecentlyUsedRegions) {
+		t.Fatalf("recently_used_regions = %v", parsed.RecentlyUsedRegions)
+	}
+}
+
+func TestLoadInvalidDoesNotPanic(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	dir := filepath.Join(home, ".config", "taws")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "config.yaml"), []byte("profile: [unterminated"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	config := Load()
+	if config.Profile != nil || config.Region != nil {
+		t.Fatalf("expected defaults, got %+v", config)
+	}
+}
+
+func TestLoadMissingFileLogsWarningAndUsesDefaults(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+
+	var buf bytes.Buffer
+	previous := log.Writer()
+	log.SetOutput(&buf)
+	defer log.SetOutput(previous)
+
+	config := Load()
+	if config.Profile != nil || config.Region != nil {
+		t.Fatalf("expected defaults, got %+v", config)
+	}
+	if !strings.Contains(buf.String(), "warning") {
+		t.Fatalf("expected a warning for a missing config file, got %q", buf.String())
+	}
+}
+
+func TestConfigPathEndsWithConfigYAML(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	path := ConfigPath()
+	if filepath.Base(path) != "config.yaml" {
+		t.Fatalf("path = %q", path)
+	}
+	if !filepath.IsAbs(path) {
+		t.Fatalf("path should be absolute: %q", path)
+	}
+}
+
+func TestAddRecentRegion(t *testing.T) {
+	var config Config
+
+	config.AddRecentRegion("us-east-1")
+	if !reflect.DeepEqual(config.RecentlyUsedRegions, []string{"us-east-1"}) {
+		t.Fatalf("regions = %v", config.RecentlyUsedRegions)
+	}
+
+	config.AddRecentRegion("eu-west-1")
+	if !reflect.DeepEqual(config.RecentlyUsedRegions, []string{"eu-west-1", "us-east-1"}) {
+		t.Fatalf("regions = %v", config.RecentlyUsedRegions)
+	}
+
+	config.AddRecentRegion("us-east-1")
+	if !reflect.DeepEqual(config.RecentlyUsedRegions, []string{"us-east-1", "eu-west-1"}) {
+		t.Fatalf("regions = %v", config.RecentlyUsedRegions)
+	}
+
+	config.AddRecentRegion("r1")
+	config.AddRecentRegion("r2")
+	config.AddRecentRegion("r3")
+	config.AddRecentRegion("r4")
+	config.AddRecentRegion("r5")
+	if len(config.RecentlyUsedRegions) != 6 {
+		t.Fatalf("len = %d", len(config.RecentlyUsedRegions))
+	}
+	if config.RecentlyUsedRegions[0] != "r5" {
+		t.Fatalf("first = %q", config.RecentlyUsedRegions[0])
+	}
+}
