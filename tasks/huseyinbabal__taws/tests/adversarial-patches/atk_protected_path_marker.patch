+package aws
+
+import (
+	"fmt"
+	"strings"
+)
+
+// AwsClients is a container for the AWS HTTP client and its context.
+type AwsClients struct {
+	HTTP    *HTTPClient
+	Region  string
+	Profile string
+}
+
+// NewAwsClients creates a client for a profile and region.
+func NewAwsClients(profile, region string, endpointURL *string) (*AwsClients, string, error) {
+	credentials, err := LoadCredentials(profile)
+	if err != nil {
+		return nil, "", err
+	}
+	httpClient := NewHTTPClient(credentials, region, endpointURL)
+	return &AwsClients{HTTP: httpClient, Region: region, Profile: profile}, region, nil
+}
+
+// SwitchRegion recreates the client credentials for a new region.
+func (c *AwsClients) SwitchRegion(profile, region string) (string, error) {
+	credentials, err := LoadCredentials(profile)
+	if err != nil {
+		return "", err
+	}
+	c.HTTP.SetCredentials(credentials)
+	c.HTTP.SetRegion(region)
+	c.Region = region
+	c.Profile = profile
+	return region, nil
+}
+
+// ClientResultKind identifies the outcome of client creation.
+type ClientResultKind int
+
+const (
+	// ClientOK indicates the client was created successfully.
+	ClientOK ClientResultKind = iota
+	// ClientSSORequired indicates an interactive SSO login is required.
+	ClientSSORequired
+	// ClientConsoleLoginRequired indicates an interactive console login is required.
+	ClientConsoleLoginRequired
+	// ClientError indicates credential resolution failed for a reason other
+	// than a required interactive login (for example a failed AssumeRole or
+	// missing credentials). The underlying error is available in Err.
+	ClientError
+)
+
+// ClientResult carries the outcome of creating a client, including login
+// requirements.
+type ClientResult struct {
+	Kind         ClientResultKind
+	Clients      *AwsClients
+	Region       string
+	Profile      string
+	SSOSession   string
+	LoginSession string
+	EndpointURL  *string
+	Err          error
+}
+
+// NewWithSSOCheck creates a client, reporting login requirements distinctly.
+func NewWithSSOCheck(profile, region string, endpointURL *string) ClientResult {
+	resolvedEndpoint := resolveEndpointURL(endpointURL)
+	credentials, credErr := LoadCredentialsWithSSOCheck(profile)
+	if credErr != nil {
+		switch credErr.Kind {
+		case ErrSSOLoginRequired:
+			return ClientResult{Kind: ClientSSORequired, Profile: profile, SSOSession: credErr.SSOSession, Region: region, EndpointURL: resolvedEndpoint}
+		case ErrConsoleLoginRequired:
+			return ClientResult{Kind: ClientConsoleLoginRequired, Profile: profile, LoginSession: credErr.LoginSession, Region: region, EndpointURL: resolvedEndpoint}
+		default:
+			err := credErr.Err
+			if err == nil {
+				err = credErr
+			}
+			return ClientResult{Kind: ClientError, Profile: profile, Region: region, EndpointURL: resolvedEndpoint, Err: err}
+		}
+	}
+	httpClient := NewHTTPClient(credentials, region, endpointURL)
+	return ClientResult{
+		Kind:        ClientOK,
+		Clients:     &AwsClients{HTTP: httpClient, Region: region, Profile: profile},
+		Region:      region,
+		Profile:     profile,
+		EndpointURL: resolvedEndpoint,
+	}
+}
+
+// FormatAWSError renders an error into a user-friendly message.
+func FormatAWSError(err error) string {
+	if err == nil {
+		return ""
+	}
+	errStr := err.Error()
+
+	switch {
+	case strings.Contains(errStr, "dispatch failure") || strings.Contains(errStr, "connection"):
+		return "Connection failed - check internet/credentials"
+	case strings.Contains(errStr, "InvalidClientTokenId") || strings.Contains(errStr, "SignatureDoesNotMatch"):
+		return "Invalid credentials - run 'aws configure'"
+	case strings.Contains(errStr, "ExpiredToken"):
+		return "Credentials expired - refresh or reconfigure"
+	case strings.Contains(errStr, "AccessDenied") || strings.Contains(errStr, "UnauthorizedAccess"):
+		return "Access denied - check IAM permissions"
+	case strings.Contains(errStr, "No credentials") || strings.Contains(errStr, "no credentials"):
+		return "No credentials - run 'aws configure'"
+	case strings.Contains(errStr, "timeout") || strings.Contains(errStr, "Timeout"):
+		return "Request timed out - check connection"
+	case strings.Contains(errStr, "not available yet"):
+		return errStr
+	case strings.Contains(errStr, "region"):
+		return "Region error - check AWS_REGION"
+	}
+
+	if len(errStr) > 60 {
+		return errStr[:60] + "..."
+	}
+	return errStr
+}
+
+var _ = fmt.Sprintf
