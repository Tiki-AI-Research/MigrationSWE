diff --git a/internal/aws/sso.go b/internal/aws/sso.go
new file mode 100644
index 0000000..ca1eba7
--- /dev/null
+++ b/internal/aws/sso.go
@@ -0,0 +1,199 @@
+package aws
+
+import (
+	"crypto/sha1"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// SsoConfig is the parsed SSO configuration for a profile.
+type SsoConfig struct {
+	SSOSession   string
+	SSOAccountID string
+	SSORoleName  string
+	SSOStartURL  string
+	SSORegion    string
+}
+
+type cachedToken struct {
+	AccessToken string  `json:"accessToken"`
+	ExpiresAt   string  `json:"expiresAt"`
+	Region      *string `json:"region"`
+	StartURL    string  `json:"startUrl"`
+}
+
+// GetSSOConfig returns the SSO configuration for a profile, if any.
+func GetSSOConfig(profile string) *SsoConfig {
+	configPath, err := GetAWSConfigFilePath()
+	if err != nil {
+		return nil
+	}
+	data, err := os.ReadFile(configPath)
+	if err != nil {
+		return nil
+	}
+	config, err := parseSSOConfigFromContent(profile, string(data))
+	if err != nil {
+		return nil
+	}
+	return config
+}
+
+func parseSSOConfigFromContent(profile, content string) (*SsoConfig, error) {
+	sections := ParseINIFile(content)
+
+	profileSection, ok := sections[profile]
+	if !ok {
+		return nil, fmt.Errorf("Profile '%s' not found", profile)
+	}
+
+	accountID, ok := profileSection["sso_account_id"]
+	if !ok {
+		return nil, fmt.Errorf("No sso_account_id in profile")
+	}
+	roleName, ok := profileSection["sso_role_name"]
+	if !ok {
+		return nil, fmt.Errorf("No sso_role_name in profile")
+	}
+
+	if ssoSession, ok := profileSection["sso_session"]; ok {
+		sessionKey := "sso-session " + ssoSession
+		sessionSection, ok := sections[sessionKey]
+		if !ok {
+			return nil, fmt.Errorf("SSO session '%s' not found", ssoSession)
+		}
+		startURL, ok := sessionSection["sso_start_url"]
+		if !ok {
+			return nil, fmt.Errorf("No sso_start_url in session")
+		}
+		region, ok := sessionSection["sso_region"]
+		if !ok {
+			return nil, fmt.Errorf("No sso_region in session")
+		}
+		return &SsoConfig{
+			SSOSession:   ssoSession,
+			SSOAccountID: accountID,
+			SSORoleName:  roleName,
+			SSOStartURL:  startURL,
+			SSORegion:    region,
+		}, nil
+	}
+
+	startURL, ok := profileSection["sso_start_url"]
+	if !ok {
+		return nil, fmt.Errorf("No sso_start_url or sso_session in profile")
+	}
+	region, ok := profileSection["sso_region"]
+	if !ok {
+		return nil, fmt.Errorf("No sso_region in profile")
+	}
+	return &SsoConfig{
+		SSOSession:   profile,
+		SSOAccountID: accountID,
+		SSORoleName:  roleName,
+		SSOStartURL:  startURL,
+		SSORegion:    region,
+	}, nil
+}
+
+// ReadCachedToken reads a valid cached SSO token for the given config.
+func ReadCachedToken(config *SsoConfig) *string {
+	configDir, err := AwsConfigDir()
+	if err != nil {
+		return nil
+	}
+	cacheDir := filepath.Join(configDir, "sso", "cache")
+
+	sessionSum := sha1.Sum([]byte(config.SSOSession))
+	v2Path := filepath.Join(cacheDir, hex.EncodeToString(sessionSum[:])+".json")
+	if token := tryReadTokenFile(v2Path); token != nil {
+		return token
+	}
+
+	startSum := sha1.Sum([]byte(config.SSOStartURL))
+	legacyPath := filepath.Join(cacheDir, hex.EncodeToString(startSum[:])+".json")
+	if token := tryReadTokenFile(legacyPath); token != nil {
+		return token
+	}
+	return nil
+}
+
+func tryReadTokenFile(path string) *string {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	var token cachedToken
+	if err := json.Unmarshal(data, &token); err != nil {
+		return nil
+	}
+	if token.ExpiresAt != "" {
+		if expiresAt, err := time.Parse(time.RFC3339, token.ExpiresAt); err == nil {
+			if !expiresAt.After(time.Now()) {
+				return nil
+			}
+		}
+	}
+	return &token.AccessToken
+}
+
+// GetRoleCredentials exchanges an SSO access token for role credentials.
+func GetRoleCredentials(config *SsoConfig, accessToken string) (Credentials, error) {
+	client, _ := CreateBlockingClientWithTimeout(10 * time.Second)
+
+	values := url.Values{}
+	values.Set("account_id", config.SSOAccountID)
+	values.Set("role_name", config.SSORoleName)
+	rawurl := fmt.Sprintf("https://portal.sso.%s.amazonaws.com/federation/credentials?%s", config.SSORegion, values.Encode())
+
+	req, err := http.NewRequest("GET", rawurl, nil)
+	if err != nil {
+		return Credentials{}, err
+	}
+	req.Header.Set("x-amz-sso_bearer_token", accessToken)
+	resp, err := client.Do(req)
+	if err != nil {
+		return Credentials{}, err
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(resp.Body)
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return Credentials{}, fmt.Errorf("GetRoleCredentials failed (%d): %s", resp.StatusCode, string(body))
+	}
+
+	var jsonData map[string]any
+	if err := json.Unmarshal(body, &jsonData); err != nil {
+		return Credentials{}, err
+	}
+	roleCreds, ok := jsonData["roleCredentials"].(map[string]any)
+	if !ok {
+		return Credentials{}, fmt.Errorf("roleCredentials not found")
+	}
+	accessKeyID, ok := roleCreds["accessKeyId"].(string)
+	if !ok {
+		return Credentials{}, fmt.Errorf("accessKeyId not found")
+	}
+	secretAccessKey, ok := roleCreds["secretAccessKey"].(string)
+	if !ok {
+		return Credentials{}, fmt.Errorf("secretAccessKey not found")
+	}
+	var sessionToken *string
+	if v, ok := roleCreds["sessionToken"].(string); ok {
+		sessionToken = &v
+	}
+	return Credentials{AccessKeyID: accessKeyID, SecretAccessKey: secretAccessKey, SessionToken: sessionToken}, nil
+}
+
+// FormatSSOLoginHint returns the CLI hint for an SSO session.
+func FormatSSOLoginHint(profile, ssoSession string) string {
+	return strings.TrimSpace(fmt.Sprintf("Run 'aws sso login --profile %s' (session: %s)", profile, ssoSession))
+}
diff --git a/internal/aws/tls.go b/internal/aws/tls.go
new file mode 100644
index 0000000..fda9a99
--- /dev/null
+++ b/internal/aws/tls.go
@@ -0,0 +1,115 @@
+package aws
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"sync"
+	"time"
+)
+
+// Default TLS and request timeouts.
+const (
+	DefaultConnectTimeout = 10 * time.Second
+	DefaultRequestTimeout = 30 * time.Second
+)
+
+var (
+	caBundleOnce sync.Once
+	caBundle     []*x509.Certificate
+)
+
+// LoadCACertificates loads and caches CA certificates from AWS_CA_BUNDLE or
+// SSL_CERT_FILE. It returns nil when neither is configured or parsing fails.
+func LoadCACertificates() []*x509.Certificate {
+	caBundleOnce.Do(func() {
+		path := os.Getenv("AWS_CA_BUNDLE")
+		if path == "" {
+			path = os.Getenv("SSL_CERT_FILE")
+		}
+		if path == "" {
+			return
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return
+		}
+		certs := ParsePEMCertificates(data)
+		if len(certs) == 0 {
+			return
+		}
+		caBundle = certs
+	})
+	return caBundle
+}
+
+// ParsePEMCertificates parses each certificate block from PEM data.
+func ParsePEMCertificates(pemData []byte) []*x509.Certificate {
+	var certs []*x509.Certificate
+	rest := pemData
+	for {
+		var block *pem.Block
+		block, rest = pem.Decode(rest)
+		if block == nil {
+			break
+		}
+		if block.Type != "CERTIFICATE" {
+			continue
+		}
+		cert, err := x509.ParseCertificate(block.Bytes)
+		if err != nil {
+			continue
+		}
+		certs = append(certs, cert)
+	}
+	return certs
+}
+
+func rootPool() *x509.CertPool {
+	pool, err := x509.SystemCertPool()
+	if err != nil || pool == nil {
+		pool = x509.NewCertPool()
+	}
+	for _, cert := range LoadCACertificates() {
+		pool.AddCert(cert)
+	}
+	return pool
+}
+
+// ConfigureTLS returns a transport configured with custom CA roots and timeouts.
+func ConfigureTLS() *http.Transport {
+	return &http.Transport{
+		Proxy: http.ProxyFromEnvironment,
+		TLSClientConfig: &tls.Config{
+			RootCAs: rootPool(),
+		},
+		DialContext: (&net.Dialer{
+			Timeout: DefaultConnectTimeout,
+		}).DialContext,
+	}
+}
+
+// CreateAsyncClient returns an HTTP client with custom CA roots and timeouts.
+func CreateAsyncClient() (*http.Client, error) {
+	return &http.Client{
+		Transport: ConfigureTLS(),
+		Timeout:   DefaultRequestTimeout,
+	}, nil
+}
+
+// CreateBlockingClientWithTimeout returns an HTTP client with the given timeout.
+func CreateBlockingClientWithTimeout(timeout time.Duration) (*http.Client, error) {
+	return &http.Client{
+		Transport: ConfigureTLS(),
+		Timeout:   timeout,
+	}, nil
+}
+
+// FormatCAError is a small helper retained for parity with the Rust layer.
+func FormatCAError(err error) string {
+	return fmt.Sprintf("Failed to configure TLS: %v", err)
+}
