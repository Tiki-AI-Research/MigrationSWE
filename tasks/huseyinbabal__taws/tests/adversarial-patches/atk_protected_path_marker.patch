+	if !strings.Contains(ssoMsg, "sso-profile") {
+		t.Fatalf("SSO error should contain profile name: %s", ssoMsg)
+	}
+	if !strings.Contains(ssoMsg, "my-sso-session") {
+		t.Fatalf("SSO error should contain session name: %s", ssoMsg)
+	}
+
+	consoleMsg := consoleError.Error()
+	if !strings.Contains(consoleMsg, "aws login") {
+		t.Fatalf("Console error should suggest 'aws login': %s", consoleMsg)
+	}
+	if strings.Contains(consoleMsg, "sso") {
+		t.Fatalf("Console error should NOT mention 'sso': %s", consoleMsg)
+	}
+	if !strings.Contains(consoleMsg, "console-profile") {
+		t.Fatalf("Console error should contain profile name: %s", consoleMsg)
+	}
+	if !strings.Contains(consoleMsg, "123456789012") {
+		t.Fatalf("Console error should contain login session: %s", consoleMsg)
+	}
+}
+
+func TestCredentialsErrorMatching(t *testing.T) {
+	testCases := []*CredentialsError{
+		{Kind: ErrSSOLoginRequired, Profile: "sso", SSOSession: "session"},
+		{Kind: ErrConsoleLoginRequired, Profile: "console", LoginSession: "arn"},
+		{Kind: ErrOther, Err: os.ErrNotExist},
+	}
+
+	for _, e := range testCases {
+		switch e.Kind {
+		case ErrSSOLoginRequired:
+			if e.Profile != "sso" {
+				t.Fatalf("profile = %q", e.Profile)
+			}
+		case ErrConsoleLoginRequired:
+			if e.Profile != "console" {
+				t.Fatalf("profile = %q", e.Profile)
+			}
+		case ErrOther:
+			if e.Err == nil {
+				t.Fatal("expected wrapped error")
+			}
+		}
+	}
+}
diff --git a/internal/aws/http.go b/internal/aws/http.go
new file mode 100644
index 0000000..f3c4f68
--- /dev/null
+++ b/internal/aws/http.go
@@ -0,0 +1,519 @@
+package aws
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+)
+
+const euscPrefix = "eusc-"
+
+// HTTPClient is a lightweight AWS HTTP client with SigV4 request signing.
+type HTTPClient struct {
+	client      *http.Client
+	credentials Credentials
+	region      string
+	endpointURL *string
+	mu          sync.RWMutex
+}
+
+// NewHTTPClient creates a new AWS HTTP client.
+//
+// The endpoint is resolved through resolveEndpointURL so that an explicit
+// --endpoint-url value takes precedence and AWS_ENDPOINT_URL is honored when
+// no explicit endpoint was provided.
+func NewHTTPClient(credentials Credentials, region string, endpointURL *string) *HTTPClient {
+	httpClient, err := CreateAsyncClient()
+	if err != nil {
+		httpClient = &http.Client{Timeout: DefaultRequestTimeout}
+	}
+	return &HTTPClient{
+		client:      httpClient,
+		credentials: credentials,
+		region:      region,
+		endpointURL: resolveEndpointURL(endpointURL),
+	}
+}
+
+// resolveEndpointURL returns the explicit endpoint when set, otherwise the
+// AWS_ENDPOINT_URL environment override, otherwise nil.
+func resolveEndpointURL(endpointURL *string) *string {
+	if endpointURL != nil && *endpointURL != "" {
+		return endpointURL
+	}
+	if v := os.Getenv("AWS_ENDPOINT_URL"); v != "" {
+		resolved := v
+		return &resolved
+	}
+	return nil
+}
+
+// SetRegion updates the client region.
+func (c *HTTPClient) SetRegion(region string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.region = region
+}
+
+// SetCredentials updates the client credentials.
+func (c *HTTPClient) SetCredentials(credentials Credentials) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.credentials = credentials
+}
+
+func (c *HTTPClient) currentRegion() string {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return c.region
+}
+
+func (c *HTTPClient) currentCredentials() Credentials {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return c.credentials
+}
+
+// EffectiveRegion returns the region used for a service, mirroring global-service
+// behavior.
+func (c *HTTPClient) EffectiveRegion(service ServiceDefinition) string {
+	region := c.currentRegion()
+	if service.IsGlobal {
+		if strings.HasPrefix(region, euscPrefix) {
+			return region
+		}
+		return "us-east-1"
+	}
+	return region
+}
+
+// GetEndpoint resolves the service endpoint, honoring endpoint overrides.
+func (c *HTTPClient) GetEndpoint(service ServiceDefinition) (string, error) {
+	if c.endpointURL != nil {
+		return *c.endpointURL, nil
+	}
+
+	region := c.EffectiveRegion(service)
+	selfRegion := c.currentRegion()
+	domain := endpointDomain(selfRegion)
+	if !service.IsGlobal {
+		domain = endpointDomain(region)
+	}
+
+	if service.SigningName == "s3" {
+		return fmt.Sprintf("https://s3.%s.%s", region, domain), nil
+	}
+
+	if service.IsGlobal {
+		switch service.SigningName {
+		case "iam":
+			if domain == "amazonaws.eu" {
+				return fmt.Sprintf("https://iam.%s.%s", selfRegion, domain), nil
+			}
+			return "https://iam.amazonaws.com", nil
+		case "cloudfront":
+			if strings.HasPrefix(selfRegion, euscPrefix) {
+				return "", fmt.Errorf("Service 'cloudfront' is not available yet in ESC regions")
+			}
+			return fmt.Sprintf("https://cloudfront.%s", domain), nil
+		case "route53":
+			return fmt.Sprintf("https://route53.%s", domain), nil
+		default:
+			return fmt.Sprintf("https://%s.%s", service.EndpointPrefix, domain), nil
+		}
+	}
+
+	return fmt.Sprintf("https://%s.%s.%s", service.EndpointPrefix, region, domain), nil
+}
+
+func endpointDomain(region string) string {
+	if strings.HasPrefix(region, euscPrefix) {
+		return "amazonaws.eu"
+	}
+	return "amazonaws.com"
+}
+
+// QueryRequest performs a Query-protocol request (EC2, IAM, RDS, ...).
+func (c *HTTPClient) QueryRequest(serviceName, action string, params [][2]string) (string, error) {
+	service, ok := GetService(serviceName)
+	if !ok {
+		return "", fmt.Errorf("Unknown service: %s", serviceName)
+	}
+	endpoint, err := c.GetEndpoint(service)
+	if err != nil {
+		return "", err
+	}
+
+	queryParams := make([][2]string, 0, len(params)+2)
+	queryParams = append(queryParams, [2]string{"Action", action}, [2]string{"Version", service.APIVersion})
+	queryParams = append(queryParams, params...)
+
+	parts := make([]string, 0, len(queryParams))
+	for _, kv := range queryParams {
+		parts = append(parts, url.QueryEscape(kv[0])+"="+url.QueryEscape(kv[1]))
+	}
+	queryString := strings.Join(parts, "&")
+
+	rawurl := fmt.Sprintf("%s/?%s", endpoint, queryString)
+	return c.signedRequest(service, "POST", rawurl, "", nil)
+}
+
+// JSONRequest performs a JSON-protocol request (DynamoDB, ECS, Logs, ...).
+func (c *HTTPClient) JSONRequest(serviceName, target, body string) (string, error) {
+	service, ok := GetService(serviceName)
+	if !ok {
+		return "", fmt.Errorf("Unknown service: %s", serviceName)
+	}
+	endpoint, err := c.GetEndpoint(service)
+	if err != nil {
+		return "", err
+	}
+
+	rawurl := fmt.Sprintf("%s/", endpoint)
+	targetPrefix := service.SigningName
+	if service.TargetPrefix != "" {
+		targetPrefix = service.TargetPrefix
+	}
+	headers := map[string]string{
+		"X-Amz-Target": fmt.Sprintf("%s.%s", targetPrefix, target),
+		"Content-Type": fmt.Sprintf("application/x-amz-json-%s", service.JSONVersion),
+	}
+	return c.signedRequest(service, "POST", rawurl, body, headers)
+}
+
+// RESTJSONRequest performs a REST-JSON request (Lambda, API Gateway, EKS, ...).
+func (c *HTTPClient) RESTJSONRequest(serviceName, method, path string, body *string) (string, error) {
+	service, ok := GetService(serviceName)
+	if !ok {
+		return "", fmt.Errorf("Unknown service: %s", serviceName)
+	}
+	endpoint, err := c.GetEndpoint(service)
+	if err != nil {
+		return "", err
+	}
+
+	rawurl := endpoint + path
+	headers := map[string]string{}
+	if body != nil {
+		headers["Content-Type"] = "application/json"
+	}
+	bodyStr := ""
+	if body != nil {
+		bodyStr = *body
+	}
+	return c.signedRequest(service, method, rawurl, bodyStr, headers)
+}
+
+// RESTXMLRequest performs a REST-XML request (S3, Route53, CloudFront).
+func (c *HTTPClient) RESTXMLRequest(serviceName, method, path string, body *string) (string, error) {
+	service, ok := GetService(serviceName)
+	if !ok {
+		return "", fmt.Errorf("Unknown service: %s", serviceName)
+	}
+	endpoint, err := c.GetEndpoint(service)
+	if err != nil {
+		return "", err
+	}
+	rawurl := endpoint + path
+	bodyStr := ""
+	if body != nil {
+		bodyStr = *body
+	}
+	return c.signedRequest(service, method, rawurl, bodyStr, nil)
+}
+
+// RESTXMLRequestS3Bucket performs a REST-XML request against a specific S3
+// bucket region.
+func (c *HTTPClient) RESTXMLRequestS3Bucket(method, bucket, path string, body *string, bucketRegion string) (string, error) {
+	service, ok := GetService("s3")
+	if !ok {
+		return "", fmt.Errorf("Unknown service: s3")
+	}
+	domain := endpointDomain(bucketRegion)
+	endpoint := fmt.Sprintf("https://%s.s3.%s.%s", bucket, bucketRegion, domain)
+	rawurl := endpoint + path
+	bodyStr := ""
+	if body != nil {
+		bodyStr = *body
+	}
+	return c.signedRequestWithRegion(service, method, rawurl, bodyStr, nil, bucketRegion)
+}
+
+// GetBucketRegion resolves an S3 bucket region via a HEAD probe.
+func (c *HTTPClient) GetBucketRegion(bucket string) (string, error) {
+	region := c.currentRegion()
+	domains := []string{"amazonaws.com"}
+	if strings.HasPrefix(region, euscPrefix) {
+		domains = append([]string{"amazonaws.eu"}, domains...)
+	}
+
+	for _, domain := range domains {
+		rawurl := fmt.Sprintf("https://%s.s3.%s/", bucket, domain)
+		req, err := http.NewRequest("HEAD", rawurl, nil)
+		if err != nil {
+			continue
+		}
+		resp, err := c.client.Do(req)
+		if err != nil {
+			continue
+		}
+		if regionHeader := resp.Header.Get("x-amz-bucket-region"); regionHeader != "" {
+			io.Copy(io.Discard, resp.Body)
+			resp.Body.Close()
+			return regionHeader, nil
+		}
+		if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+			io.Copy(io.Discard, resp.Body)
+			resp.Body.Close()
+			return region, nil
+		}
+		if resp.StatusCode == http.StatusMovedPermanently {
+			if location := resp.Header.Get("location"); location != "" {
+				if extracted := extractRegionFromS3URL(location); extracted != "" {
+					io.Copy(io.Discard, resp.Body)
+					resp.Body.Close()
+					return extracted, nil
+				}
+			}
+		}
+		io.Copy(io.Discard, resp.Body)
+		resp.Body.Close()
+	}
+
+	if strings.HasPrefix(region, euscPrefix) {
+		return region, nil
+	}
+	return "us-east-1", nil
+}
+
+func extractRegionFromS3URL(rawurl string) string {
+	lower := strings.ToLower(rawurl)
+	for _, prefix := range []string{"s3.", "s3-"} {
+		pos := strings.Index(lower, prefix)
+		if pos < 0 {
+			continue
+		}
+		after := lower[pos+len(prefix):]
+		end := strings.Index(after, ".amazonaws.")
+		if end < 0 {
+			continue
+		}
+		region := after[:end]
+		if strings.Contains(region, "-") && len(region) > 0 && region[len(region)-1] >= '0' && region[len(region)-1] <= '9' {
+			return region
+		}
+	}
+	return ""
+}
+
+func (c *HTTPClient) signedRequest(service ServiceDefinition, method, rawurl, body string, extraHeaders map[string]string) (string, error) {
+	region := c.EffectiveRegion(service)
+	return c.signedRequestWithRegion(service, method, rawurl, body, extraHeaders, region)
+}
+
+func (c *HTTPClient) signedRequestWithRegion(service ServiceDefinition, method, rawurl, body string, extraHeaders map[string]string, region string) (string, error) {
+	unsignedPayload := service.SigningName == "s3" && body == "" && (method == "GET" || method == "DELETE")
+
+	signingHeaders, err := SignV4(method, rawurl, body, extraHeaders, c.currentCredentials(), region, service.SigningName, unsignedPayload)
+	if err != nil {
+		return "", err
+	}
+
+	var reader io.Reader
+	if body != "" {
+		reader = strings.NewReader(body)
+	}
+	req, err := http.NewRequest(method, rawurl, reader)
+	if err != nil {
+		return "", err
+	}
+
+	for k, v := range extraHeaders {
+		req.Header.Set(k, v)
+	}
+	for k, v := range signingHeaders {
+		req.Header.Set(k, v)
+	}
+	if unsignedPayload {
+		req.Header.Set("X-Amz-Content-Sha256", "UNSIGNED-PAYLOAD")
+	}
+
+	resp, err := c.client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	respBody, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return "", err
+	}
+	text := string(respBody)
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		snippet := text
+		if len(snippet) > 500 {
+			snippet = snippet[:500]
+		}
+		return "", fmt.Errorf("AWS request failed (%s): %s", resp.Status, snippet)
+	}
+	return text, nil
+}
+
+// SignV4 signs an AWS request and returns the headers that must be applied.
+func SignV4(method, rawurl, body string, extraHeaders map[string]string, creds Credentials, region, service string, unsignedPayload bool) (map[string]string, error) {
+	return signV4At(method, rawurl, body, extraHeaders, creds, region, service, unsignedPayload, time.Now().UTC())
+}
+
+func signV4At(method, rawurl, body string, extraHeaders map[string]string, creds Credentials, region, service string, unsignedPayload bool, now time.Time) (map[string]string, error) {
+	parsed, err := url.Parse(rawurl)
+	if err != nil {
+		return nil, err
+	}
+	host := parsed.Host
+	if host == "" {
+		return nil, fmt.Errorf("Invalid URL: %s", rawurl)
+	}
+
+	amzDate := now.Format("20060102T150405Z")
+	dateStamp := now.Format("20060102")
+
+	payloadHash := hex.EncodeToString(sha256sum([]byte(body)))
+	if unsignedPayload {
+		payloadHash = "UNSIGNED-PAYLOAD"
+	}
+
+	canonicalURI := awsURIEncode(parsed.Path, false)
+	if canonicalURI == "" {
+		canonicalURI = "/"
+	}
+	canonicalQuery := canonicalQueryString(parsed.RawQuery)
+
+	headerMap := map[string]string{"host": host, "x-amz-date": amzDate}
+	if creds.SessionToken != nil {
+		headerMap["x-amz-security-token"] = *creds.SessionToken
+	}
+	for k, v := range extraHeaders {
+		headerMap[strings.ToLower(k)] = strings.TrimSpace(v)
+	}
+
+	names := make([]string, 0, len(headerMap))
+	for k := range headerMap {
+		names = append(names, k)
+	}
+	sort.Strings(names)
+	var canonicalHeaders strings.Builder
+	for _, k := range names {
+		canonicalHeaders.WriteString(k)
+		canonicalHeaders.WriteString(":")
+		canonicalHeaders.WriteString(headerMap[k])
+		canonicalHeaders.WriteString("\n")
+	}
+	signedHeaders := strings.Join(names, ";")
+
+	canonicalRequest := strings.Join([]string{
+		method,
+		canonicalURI,
+		canonicalQuery,
+		canonicalHeaders.String(),
+		signedHeaders,
+		payloadHash,
+	}, "\n")
+
+	scope := fmt.Sprintf("%s/%s/%s/aws4_request", dateStamp, region, service)
+	stringToSign := strings.Join([]string{
+		"AWS4-HMAC-SHA256",
+		amzDate,
+		scope,
+		hex.EncodeToString(sha256sum([]byte(canonicalRequest))),
+	}, "\n")
+
+	signingKey := hmacSHA256([]byte("AWS4"+creds.SecretAccessKey), []byte(dateStamp))
+	signingKey = hmacSHA256(signingKey, []byte(region))
+	signingKey = hmacSHA256(signingKey, []byte(service))
+	signingKey = hmacSHA256(signingKey, []byte("aws4_request"))
+	signature := hex.EncodeToString(hmacSHA256(signingKey, []byte(stringToSign)))
+
+	authz := fmt.Sprintf(
+		"AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, Signature=%s",
+		creds.AccessKeyID, scope, signedHeaders, signature,
+	)
+
+	result := map[string]string{
+		"Authorization": authz,
+		"X-Amz-Date":    amzDate,
+	}
+	if creds.SessionToken != nil {
+		result["X-Amz-Security-Token"] = *creds.SessionToken
+	}
+	return result, nil
+}
+
+func canonicalQueryString(rawQuery string) string {
+	if rawQuery == "" {
+		return ""
+	}
+	values, err := url.ParseQuery(rawQuery)
+	if err != nil {
+		return rawQuery
+	}
+	keys := make([]string, 0, len(values))
+	for k := range values {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+
+	parts := make([]string, 0, len(keys))
+	for _, k := range keys {
+		vals := values[k]
+		sort.Strings(vals)
+		for _, v := range vals {
+			parts = append(parts, awsURIEncode(k, true)+"="+awsURIEncode(v, true))
+		}
+	}
+	return strings.Join(parts, "&")
+}
+
+func awsURIEncode(s string, encodeSlash bool) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+			c == '-' || c == '_' || c == '.' || c == '~':
+			b.WriteByte(c)
+		case c == '/' && !encodeSlash:
+			b.WriteByte(c)
+		default:
+			b.WriteString(fmt.Sprintf("%%%02X", c))
+		}
+	}
+	return b.String()
+}
+
+func sha256sum(data []byte) []byte {
+	sum := sha256.Sum256(data)
+	return sum[:]
+}
+
+func hmacSHA256(key, data []byte) []byte {
+	h := hmac.New(sha256.New, key)
+	h.Write(data)
+	return h.Sum(nil)
+}
+
+// MaskCredential masks a credential value for logging.
+func MaskCredential(value string) string {
+	if len(value) <= 8 {
+		return strings.Repeat("*", len(value))
+	}
+	return value[:4] + "..." + value[len(value)-4:]
+}
diff --git a/internal/aws/http_test.go b/internal/aws/http_test.go
new file mode 100644
index 0000000..ea758eb
--- /dev/null
+++ b/internal/aws/http_test.go
@@ -0,0 +1,193 @@
+package aws
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestSignV4KnownVector(t *testing.T) {
+	creds := Credentials{
+		AccessKeyID:     "AKIDEXAMPLE",
+		SecretAccessKey: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
+	}
+	now := time.Date(2015, 8, 30, 12, 36, 0, 0, time.UTC)
+	headers, err := signV4At("GET", "https://example.amazonaws.com/", "", nil, creds, "us-east-1", "service", false, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/service/aws4_request, SignedHeaders=host;x-amz-date, Signature=5fa00fa31553b73ebf1942676e86291e8372ff2a2260956d9b8aae1d763fbf31"
+	if headers["Authorization"] != want {
+		t.Fatalf("Authorization =\n%s\nwant\n%s", headers["Authorization"], want)
+	}
+}
+
+func TestQueryRequestAgainstMockServer(t *testing.T) {
+	var captured *http.Request
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		captured = r
+		w.Write([]byte(`<ok/>`))
+	}))
+	defer server.Close()
+
+	endpoint := server.URL
+	client := NewHTTPClient(Credentials{AccessKeyID: "AKIDEXAMPLE", SecretAccessKey: "secret"}, "us-east-1", &endpoint)
+	if _, err := client.QueryRequest("ec2", "DescribeInstances", [][2]string{{"MaxResults", "10"}}); err != nil {
+		t.Fatal(err)
+	}
+	if captured.Method != "POST" {
+		t.Fatalf("method = %s", captured.Method)
+	}
+	query := captured.URL.Query()
+	if query.Get("Action") != "DescribeInstances" {
+		t.Fatalf("Action = %q", query.Get("Action"))
+	}
+	if query.Get("Version") != "2016-11-15" {
+		t.Fatalf("Version = %q", query.Get("Version"))
+	}
+	if query.Get("MaxResults") != "10" {
+		t.Fatalf("MaxResults = %q", query.Get("MaxResults"))
+	}
+	authz := captured.Header.Get("Authorization")
+	if !strings.HasPrefix(authz, "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/") {
+		t.Fatalf("Authorization = %q", authz)
+	}
+	if !strings.Contains(authz, "SignedHeaders=host;x-amz-date") {
+		t.Fatalf("Authorization = %q", authz)
+	}
+	if captured.Header.Get("X-Amz-Date") == "" {
+		t.Fatal("missing X-Amz-Date")
+	}
+}
+
+func TestJSONRequestSetsTargetHeaders(t *testing.T) {
+	var captured *http.Request
+	var body string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		captured = r
+		buf := make([]byte, r.ContentLength)
+		r.Body.Read(buf)
+		body = string(buf)
+		w.Write([]byte(`{"TableNames":[]}`))
+	}))
+	defer server.Close()
+
+	endpoint := server.URL
+	client := NewHTTPClient(Credentials{AccessKeyID: "AKIDEXAMPLE", SecretAccessKey: "secret"}, "us-east-1", &endpoint)
+	if _, err := client.JSONRequest("dynamodb", "ListTables", `{"Limit":5}`); err != nil {
+		t.Fatal(err)
+	}
+	if captured.Header.Get("X-Amz-Target") != "DynamoDB_20120810.ListTables" {
+		t.Fatalf("X-Amz-Target = %q", captured.Header.Get("X-Amz-Target"))
+	}
+	if captured.Header.Get("Content-Type") != "application/x-amz-json-1.0" {
+		t.Fatalf("Content-Type = %q", captured.Header.Get("Content-Type"))
+	}
+	if body != `{"Limit":5}` {
+		t.Fatalf("body = %q", body)
+	}
+}
+
+func TestS3UnsignedPayloadHeader(t *testing.T) {
+	var captured *http.Request
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		captured = r
+		w.Write([]byte(`<ok/>`))
+	}))
+	defer server.Close()
+
+	endpoint := server.URL
+	client := NewHTTPClient(Credentials{AccessKeyID: "AKIDEXAMPLE", SecretAccessKey: "secret"}, "us-east-1", &endpoint)
+	if _, err := client.RESTXMLRequest("s3", "GET", "/", nil); err != nil {
+		t.Fatal(err)
+	}
+	if captured.Header.Get("X-Amz-Content-Sha256") != "UNSIGNED-PAYLOAD" {
+		t.Fatalf("X-Amz-Content-Sha256 = %q", captured.Header.Get("X-Amz-Content-Sha256"))
+	}
+	if captured.Header.Get("Authorization") == "" {
+		t.Fatal("missing Authorization header")
+	}
+}
+
+func testClient(region string) *HTTPClient {
+	token := "TESTTOKEN"
+	return NewHTTPClient(Credentials{
+		AccessKeyID:     "TESTACCESSKEY",
+		SecretAccessKey: "TESTSECRETKEY",
+		SessionToken:    &token,
+	}, region, nil)
+}
+
+func TestRoute53UsesPartitionDomainInESC(t *testing.T) {
+	client := testClient("eusc-de-east-1")
+	service, _ := GetService("route53")
+	endpoint, err := client.GetEndpoint(service)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if endpoint != "https://route53.amazonaws.eu" {
+		t.Fatalf("endpoint = %q", endpoint)
+	}
+}
+
+func TestRoute53UsesStandardDomainElsewhere(t *testing.T) {
+	client := testClient("us-west-2")
+	service, _ := GetService("route53")
+	endpoint, err := client.GetEndpoint(service)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if endpoint != "https://route53.amazonaws.com" {
+		t.Fatalf("endpoint = %q", endpoint)
+	}
+}
+
+func TestIAMIncludesRegionForESC(t *testing.T) {
+	client := testClient("eusc-de-east-1")
+	service, _ := GetService("iam")
+	endpoint, err := client.GetEndpoint(service)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if endpoint != "https://iam.eusc-de-east-1.amazonaws.eu" {
+		t.Fatalf("endpoint = %q", endpoint)
+	}
+}
+
+func TestIAMUsesClassicEndpointForStandardRegions(t *testing.T) {
+	client := testClient("us-west-2")
+	service, _ := GetService("iam")
+	endpoint, err := client.GetEndpoint(service)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if endpoint != "https://iam.amazonaws.com" {
+		t.Fatalf("endpoint = %q", endpoint)
+	}
+}
+
+func TestCloudFrontReturnsNotAvailableErrorInESC(t *testing.T) {
+	client := testClient("eusc-de-east-1")
+	service, _ := GetService("cloudfront")
+	_, err := client.GetEndpoint(service)
+	if err == nil {
+		t.Fatal("cloudfront should error in esc")
+	}
+	if err.Error() != "Service 'cloudfront' is not available yet in ESC regions" {
+		t.Fatalf("error = %q", err.Error())
+	}
+}
+
+func TestCloudFrontWorksInStandardRegions(t *testing.T) {
+	client := testClient("us-east-1")
+	service, _ := GetService("cloudfront")
+	endpoint, err := client.GetEndpoint(service)
