+package resource
+
+import (
+	"encoding/json"
+	"strings"
+)
+
+func parseJSON(s string) (any, error) {
+	var v any
+	err := json.Unmarshal([]byte(s), &v)
+	return v, err
+}
+
+func marshalJSON(v any) (string, error) {
+	b, err := json.Marshal(v)
+	if err != nil {
+		return "", err
+	}
+	return string(b), nil
+}
+
+func asMap(params any) map[string]any {
+	if m, ok := params.(map[string]any); ok {
+		return m
+	}
+	return map[string]any{}
+}
+
+func unwrapSingle(value any) any {
+	if arr, ok := value.([]any); ok && len(arr) == 1 {
+		return arr[0]
+	}
+	return value
+}
+
+func replaceToken(path, key, value string) string {
+	return strings.ReplaceAll(path, "{"+key+"}", value)
+}
+
+func contains(s, sub string) bool {
+	return strings.Contains(s, sub)
+}
+
+func join(parts []string, sep string) string {
+	return strings.Join(parts, sep)
+}
diff --git a/main.go b/main.go
new file mode 100644
index 0000000..d454d3e
--- /dev/null
+++ b/main.go
@@ -0,0 +1,196 @@
+// Command taws is a terminal tool for browsing and managing AWS resources.
+package main
+
+import (
+	"fmt"
+	"log"
+	"os"
+	"os/exec"
+	"path/filepath"
+
+	"github.com/spf13/cobra"
+
+	"github.com/huseyinbabal/taws/internal/aws"
+	"github.com/huseyinbabal/taws/internal/completion"
+	"github.com/huseyinbabal/taws/internal/resource"
+)
+
+// version is injected at build time via -ldflags "-X main.version=...".
+var version = "1.3.0-rc.8"
+
+var (
+	flagProfile     string
+	flagRegion      string
+	flagLogLevel    string
+	flagReadonly    bool
+	flagEndpointURL string
+	flagVersion     bool
+)
+
+var validLogLevels = map[string]bool{
+	"off":   true,
+	"error": true,
+	"warn":  true,
+	"info":  true,
+	"debug": true,
+	"trace": true,
+}
+
+func newRootCmd() *cobra.Command {
+	rootCmd := &cobra.Command{
+		Use:           "taws",
+		Short:         "Terminal UI for AWS",
+		Long:          "Terminal UI for AWS - navigate, observe, and manage AWS resources",
+		SilenceUsage:  true,
+		SilenceErrors: true,
+		PersistentPreRunE: func(cmd *cobra.Command, args []string) error {
+			if flagVersion {
+				fmt.Fprintf(cmd.OutOrStdout(), "taws %s\n", version)
+				os.Exit(0)
+			}
+			if !validLogLevels[flagLogLevel] {
+				return fmt.Errorf("invalid value '%s' for '--log-level <LOG_LEVEL>'\n  [possible values: off, error, warn, info, debug, trace]", flagLogLevel)
+			}
+			resource.SetReadOnly(flagReadonly)
+			return nil
+		},
+		RunE: func(cmd *cobra.Command, args []string) error {
+			return cmd.Help()
+		},
+	}
+
+	rootCmd.CompletionOptions.DisableDefaultCmd = true
+
+	rootCmd.PersistentFlags().StringVarP(&flagProfile, "profile", "p", "", "AWS profile to use")
+	rootCmd.PersistentFlags().StringVarP(&flagRegion, "region", "r", "", "AWS region to use")
+	rootCmd.PersistentFlags().StringVar(&flagLogLevel, "log-level", "off", "Log level for debugging")
+	rootCmd.PersistentFlags().BoolVar(&flagReadonly, "readonly", false, "Run in read-only mode (block all write operations)")
+	rootCmd.PersistentFlags().StringVar(&flagEndpointURL, "endpoint-url", "", "Custom AWS endpoint URL (for LocalStack, etc.). Also reads from AWS_ENDPOINT_URL env var.")
+	rootCmd.PersistentFlags().BoolVarP(&flagVersion, "version", "V", false, "Print version")
+
+	rootCmd.AddCommand(newCompletionCmd())
+	rootCmd.AddCommand(newListProfilesCmd())
+	rootCmd.AddCommand(newListRegionsCmd())
+
+	return rootCmd
+}
+
+func newCompletionCmd() *cobra.Command {
+	return &cobra.Command{
+		Use:   "completion <shell>",
+		Short: "Generate shell completion scripts",
+		Args:  cobra.ExactArgs(1),
+		RunE: func(cmd *cobra.Command, args []string) error {
+			fmt.Fprint(cmd.OutOrStdout(), completion.Generate(args[0]))
+			return nil
+		},
+	}
+}
+
+func newListProfilesCmd() *cobra.Command {
+	return &cobra.Command{
+		Use:    "list-profiles",
+		Short:  "List available AWS profiles (for shell completion)",
+		Hidden: true,
+		Args:   cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			profiles, err := aws.ListProfiles()
+			if err != nil {
+				return nil
+			}
+			for _, profile := range profiles {
+				fmt.Fprintln(cmd.OutOrStdout(), profile)
+			}
+			return nil
+		},
+	}
+}
+
+func newListRegionsCmd() *cobra.Command {
+	return &cobra.Command{
+		Use:    "list-regions",
+		Short:  "List available AWS regions (for shell completion)",
+		Hidden: true,
+		Args:   cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			for _, region := range aws.ListRegions() {
+				fmt.Fprintln(cmd.OutOrStdout(), region)
+			}
+			return nil
+		},
+	}
+}
+
+// LogLevelToTracing maps a log level to its enabled state.
+func LogLevelToTracing(level string) bool {
+	return level != "off"
+}
+
+func getLogPath() string {
+	if configDir, err := os.UserConfigDir(); err == nil {
+		return filepath.Join(configDir, "taws", "taws.log")
+	}
+	if home, err := os.UserHomeDir(); err == nil {
+		return filepath.Join(home, ".taws", "taws.log")
+	}
+	return "taws.log"
+}
+
+func setupLogging(level string) {
+	if !LogLevelToTracing(level) {
+		return
+	}
+	logPath := getLogPath()
+	if parent := filepath.Dir(logPath); parent != "" {
+		_ = os.MkdirAll(parent, 0o755)
+	}
+	file, err := os.OpenFile(logPath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)
+	if err != nil {
+		return
+	}
+	log.SetOutput(file)
+	log.Printf("taws started with log level: %s", level)
+	log.Printf("Log file: %s", logPath)
+}
+
+// reportSSMExit prints the exit code of an `aws ssm start-session` subprocess,
+// indicating the common 254 (not connected to SSM Agent) case.
+func reportSSMExit(exitCode int) {
+	fmt.Printf("\nSSM session exited with code: %d\n", exitCode)
+	if exitCode == 254 {
+		fmt.Println("This usually means the instance is not connected to SSM.")
+		fmt.Println("Check that SSM Agent is installed and running on the instance.")
+	}
+}
+
+// executeSSMConnect runs `aws ssm start-session` and reports the exit status.
+func executeSSMConnect(instanceID, region, profile string) error {
+	fmt.Printf(">>> Connecting to %s via SSM...\n", instanceID)
+	cmd := exec.Command("aws", "ssm", "start-session",
+		"--target", instanceID,
+		"--region", region,
+		"--profile", profile,
+	)
+	cmd.Stdout = os.Stdout
+	cmd.Stderr = os.Stderr
+	cmd.Stdin = os.Stdin
+	err := cmd.Run()
+	if exitErr, ok := err.(*exec.ExitError); ok {
+		reportSSMExit(exitErr.ExitCode())
+		return nil
+	}
+	if err != nil {
+		fmt.Printf("\nFailed to start SSM session: %v\n", err)
+		return err
+	}
+	return nil
+}
+
+func main() {
+	rootCmd := newRootCmd()
+	if err := rootCmd.Execute(); err != nil {
+		fmt.Fprintln(os.Stderr, "Error:", err)
+		os.Exit(2)
+	}
+	setupLogging(flagLogLevel)
+}
