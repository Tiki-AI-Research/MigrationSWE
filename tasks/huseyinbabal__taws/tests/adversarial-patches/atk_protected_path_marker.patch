diff --git a/internal/aws/xml.go b/internal/aws/xml.go
new file mode 100644
index 0000000..fa7b7d6
--- /dev/null
+++ b/internal/aws/xml.go
@@ -0,0 +1,89 @@
+package aws
+
+import (
+	"encoding/xml"
+	"fmt"
+	"io"
+	"strings"
+)
+
+// XMLToJSON converts an AWS XML response into a generic JSON value, matching the
+// baseline's handling of duplicate keys (arrays) and text/empty elements.
+func XMLToJSON(xmlData string) (any, error) {
+	dec := xml.NewDecoder(strings.NewReader(xmlData))
+
+	root := map[string]any{}
+	for {
+		tok, err := dec.Token()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return nil, fmt.Errorf("XML parse error: %w", err)
+		}
+		if start, ok := tok.(xml.StartElement); ok {
+			child, err := parseXMLElement(dec)
+			if err != nil {
+				return nil, err
+			}
+			root[start.Name.Local] = child
+		}
+	}
+	return root, nil
+}
+
+func parseXMLElement(dec *xml.Decoder) (any, error) {
+	m := map[string]any{}
+	currentText := ""
+
+	for {
+		tok, err := dec.Token()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return nil, fmt.Errorf("XML parse error: %w", err)
+		}
+		switch t := tok.(type) {
+		case xml.StartElement:
+			child, err := parseXMLElement(dec)
+			if err != nil {
+				return nil, err
+			}
+			addXMLChild(m, t.Name.Local, child)
+		case xml.CharData:
+			text := strings.TrimSpace(string(t))
+			if text != "" {
+				currentText = text
+			}
+		case xml.EndElement:
+			if len(m) == 0 && currentText != "" {
+				return currentText, nil
+			}
+			if len(m) == 0 {
+				return nil, nil
+			}
+			return m, nil
+		}
+	}
+
+	if len(m) == 0 && currentText != "" {
+		return currentText, nil
+	}
+	if len(m) == 0 {
+		return nil, nil
+	}
+	return m, nil
+}
+
+func addXMLChild(m map[string]any, key string, value any) {
+	if existing, ok := m[key]; ok {
+		if arr, ok := existing.([]any); ok {
+			m[key] = append(arr, value)
+		} else {
+			m[key] = []any{existing, value}
+		}
+		return
+	}
+	m[key] = value
+}
diff --git a/internal/aws/xml_test.go b/internal/aws/xml_test.go
new file mode 100644
index 0000000..6ec0616
--- /dev/null
+++ b/internal/aws/xml_test.go
@@ -0,0 +1,46 @@
+package aws
+
+import "testing"
+
+func TestXMLToJSONDuplicateKeysBecomeArrays(t *testing.T) {
+	xmlData := `<ListAllMyBucketsResult>
+        <Buckets>
+            <Bucket><Name>bucket1</Name></Bucket>
+            <Bucket><Name>bucket2</Name></Bucket>
+        </Buckets>
+    </ListAllMyBucketsResult>`
+	jsonVal, err := XMLToJSON(xmlData)
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := jsonVal.(map[string]any)
+	buckets := root["ListAllMyBucketsResult"].(map[string]any)["Buckets"].(map[string]any)
+	arr, ok := buckets["Bucket"].([]any)
+	if !ok {
+		t.Fatalf("Bucket was not an array: %T", buckets["Bucket"])
+	}
+	if len(arr) != 2 {
+		t.Fatalf("len = %d", len(arr))
+	}
+	if arr[0].(map[string]any)["Name"] != "bucket1" {
+		t.Fatalf("first bucket = %v", arr[0])
+	}
+}
+
+func TestXMLToJSONTextAndEmptyElements(t *testing.T) {
+	xmlData := `<Response><Name>running</Name><Empty/><Flag>false</Flag></Response>`
+	jsonVal, err := XMLToJSON(xmlData)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response := jsonVal.(map[string]any)["Response"].(map[string]any)
+	if response["Name"] != "running" {
+		t.Fatalf("Name = %v", response["Name"])
+	}
+	if response["Flag"] != "false" {
+		t.Fatalf("Flag = %v", response["Flag"])
+	}
+	if response["Empty"] != nil {
+		t.Fatalf("Empty = %v, want nil", response["Empty"])
+	}
+}
diff --git a/internal/completion/completion.go b/internal/completion/completion.go
new file mode 100644
index 0000000..f0abfbd
--- /dev/null
+++ b/internal/completion/completion.go
@@ -0,0 +1,326 @@
+// Package completion generates shell completion scripts with dynamic
+// profile/region completion.
+package completion
+
+// Generate returns the completion script for the given shell, falling back to
+// the default script for unrecognized values.
+func Generate(shell string) string {
+	switch shell {
+	case "bash":
+		return GenerateBash()
+	case "zsh":
+		return GenerateZsh()
+	case "fish":
+		return GenerateFish()
+	case "powershell":
+		return GeneratePowerShell()
+	default:
+		return Default()
+	}
+}
+
+// Default returns the fallback completion script.
+func Default() string {
+	return GenerateBash()
+}
+
+// GenerateBash generates the bash completion script.
+func GenerateBash() string {
+	return `_taws() {
+    local i cur prev opts cmd
+    COMPREPLY=()
+    cur="${COMP_WORDS[COMP_CWORD]}"
+    prev="${COMP_WORDS[COMP_CWORD-1]}"
+    cmd=""
+    opts=""
+
+    # Handle --profile completion
+    if [[ ${prev} == "-p" || ${prev} == "--profile" ]]; then
+        local profiles
+        profiles=$(taws list-profiles 2>/dev/null)
+        COMPREPLY=( $(compgen -W "${profiles}" -- "${cur}") )
+        return 0
+    fi
+
+    # Handle --region completion
+    if [[ ${prev} == "-r" || ${prev} == "--region" ]]; then
+        local regions
+        regions=$(taws list-regions 2>/dev/null)
+        COMPREPLY=( $(compgen -W "${regions}" -- "${cur}") )
+        return 0
+    fi
+
+    # Handle --log-level completion
+    if [[ ${prev} == "--log-level" ]]; then
+        COMPREPLY=( $(compgen -W "off error warn info debug trace" -- "${cur}") )
+        return 0
+    fi
+
+    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"; do
+        case "${cmd},${i}" in
+            ",$1")
+                cmd="taws"
+                ;;
+            taws,completion)
+                cmd="taws__completion"
+                ;;
+            taws,help)
+                cmd="taws__help"
+                ;;
+            *)
+                ;;
+        esac
+    done
+
+    case "${cmd}" in
+        taws)
+            opts="-p -r -h -V --profile --region --log-level --readonly --endpoint-url --help --version completion help"
+            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]]; then
+                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
+                return 0
+            fi
+            ;;
+        taws__completion)
+            opts="-h --help bash zsh fish powershell elvish"
+            if [[ ${cur} == -* ]]; then
+                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
+                return 0
+            fi
+            COMPREPLY=( $(compgen -W "bash zsh fish powershell elvish" -- "${cur}") )
+            return 0
+            ;;
+        taws__help)
+            opts="completion help"
+            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
+            return 0
+            ;;
+    esac
+}
+
+if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
+    complete -F _taws -o nosort -o bashdefault -o default taws
+else
+    complete -F _taws -o bashdefault -o default taws
+fi
+`
+}
+
+// GenerateZsh generates the zsh completion script.
+func GenerateZsh() string {
+	return `#compdef taws
+
+autoload -U is-at-least
+
+_taws_profiles() {
+    local profiles
+    profiles=(${(f)"$(taws list-profiles 2>/dev/null)"})
+    _describe -t profiles 'AWS profiles' profiles
+}
+
+_taws_regions() {
+    local regions
+    regions=(${(f)"$(taws list-regions 2>/dev/null)"})
+    _describe -t regions 'AWS regions' regions
+}
+
+_taws() {
+    typeset -A opt_args
+    typeset -a _arguments_options
+    local ret=1
+
+    if is-at-least 5.2; then
+        _arguments_options=(-s -S -C)
+    else
+        _arguments_options=(-s -C)
+    fi
+
+    local context curcontext="$curcontext" state line
+    _arguments "${_arguments_options[@]}" : \
+        '-p+[AWS profile to use]:PROFILE:_taws_profiles' \
+        '--profile=[AWS profile to use]:PROFILE:_taws_profiles' \
+        '-r+[AWS region to use]:REGION:_taws_regions' \
+        '--region=[AWS region to use]:REGION:_taws_regions' \
+        '--log-level=[Log level for debugging]:LOG_LEVEL:(off error warn info debug trace)' \
+        '--endpoint-url=[Custom AWS endpoint URL]:ENDPOINT_URL:_default' \
+        '--readonly[Run in read-only mode]' \
+        '-h[Print help]' \
+        '--help[Print help]' \
+        '-V[Print version]' \
+        '--version[Print version]' \
+        ":: :_taws_commands" \
+        "*::: :->taws" \
+        && ret=0
+
+    case $state in
+    (taws)
+        words=($line[1] "${words[@]}")
+        (( CURRENT += 1 ))
+        curcontext="${curcontext%:*:*}:taws-command-$line[1]:"
+        case $line[1] in
+            (completion)
+                _arguments "${_arguments_options[@]}" : \
+                    '-h[Print help]' \
+                    '--help[Print help]' \
+                    ':shell:(bash zsh fish powershell elvish)' \
+                    && ret=0
+                ;;
+            (help)
+                _arguments "${_arguments_options[@]}" : \
+                    ":: :_taws_help_commands" \
+                    "*::: :->help" \
+                    && ret=0
+                ;;
+        esac
+        ;;
+    esac
+
+    return ret
+}
+
+_taws_commands() {
+    local commands; commands=(
+        'completion:Generate shell completion scripts'
+        'help:Print help for the given subcommand(s)'
+    )
+    _describe -t commands 'taws commands' commands "$@"
+}
+
+_taws_help_commands() {
+    local commands; commands=(
+        'completion:Generate shell completion scripts'
+        'help:Print help for the given subcommand(s)'
+    )
+    _describe -t commands 'taws help commands' commands "$@"
+}
+
+if [ "$funcstack[1]" = "_taws" ]; then
+    _taws "$@"
+else
+    compdef _taws taws
+fi
+`
+}
+
+// GenerateFish generates the fish completion script.
+func GenerateFish() string {
+	return `# Fish completion for taws
+
+# Disable file completion by default
+complete -c taws -f
+
+# Dynamic profile completion
+complete -c taws -n "__fish_seen_subcommand_from -p --profile" -xa "(taws list-profiles 2>/dev/null)"
+complete -c taws -s p -l profile -d 'AWS profile to use' -xa "(taws list-profiles 2>/dev/null)"
+
+# Dynamic region completion
+complete -c taws -n "__fish_seen_subcommand_from -r --region" -xa "(taws list-regions 2>/dev/null)"
+complete -c taws -s r -l region -d 'AWS region to use' -xa "(taws list-regions 2>/dev/null)"
+
+# Log level completion
+complete -c taws -l log-level -d 'Log level for debugging' -xa "off error warn info debug trace"
+
+# Other options
+complete -c taws -l readonly -d 'Run in read-only mode'
+complete -c taws -l endpoint-url -d 'Custom AWS endpoint URL'
+complete -c taws -s h -l help -d 'Print help'
+complete -c taws -s V -l version -d 'Print version'
+
+# Subcommands
+complete -c taws -n "__fish_use_subcommand" -a "completion" -d 'Generate shell completion scripts'
+complete -c taws -n "__fish_use_subcommand" -a "help" -d 'Print help for subcommand(s)'
+
+# Completion subcommand
+complete -c taws -n "__fish_seen_subcommand_from completion" -xa "bash zsh fish powershell elvish"
+`
+}
+
+// GeneratePowerShell generates the PowerShell completion script.
+func GeneratePowerShell() string {
+	return `using namespace System.Management.Automation
+using namespace System.Management.Automation.Language
+
+Register-ArgumentCompleter -Native -CommandName 'taws' -ScriptBlock {
+    param($wordToComplete, $commandAst, $cursorPosition)
+
+    $commandElements = $commandAst.CommandElements
+    $command = @(
+        'taws'
+        for ($i = 1; $i -lt $commandElements.Count; $i++) {
+            $element = $commandElements[$i]
+            if ($element -isnot [StringConstantExpressionAst] -or
+                $element.StringConstantType -ne [StringConstantType]::BareWord -or
+                $element.Value.StartsWith('-') -or
+                $element.Value -eq $wordToComplete) {
+                break
+            }
+            $element.Value
+        }
+    ) -join ';'
+
+    $completions = @()
+
+    # Check if we're completing --profile or -p value
+    $lastArg = $commandElements[-2].Value
+    if ($lastArg -eq '--profile' -or $lastArg -eq '-p') {
+        $profiles = taws list-profiles 2>$null
+        if ($profiles) {
+            $profiles | ForEach-Object {
+                if ($_ -like "$wordToComplete*") {
+                    $completions += [CompletionResult]::new($_, $_, 'ParameterValue', $_)
+                }
+            }
+        }
+        return $completions
+    }
+
+    # Check if we're completing --region or -r value
+    if ($lastArg -eq '--region' -or $lastArg -eq '-r') {
+        $regions = taws list-regions 2>$null
+        if ($regions) {
+            $regions | ForEach-Object {
+                if ($_ -like "$wordToComplete*") {
+                    $completions += [CompletionResult]::new($_, $_, 'ParameterValue', $_)
+                }
+            }
+        }
+        return $completions
+    }
+
+    # Check if we're completing --log-level value
+    if ($lastArg -eq '--log-level') {
+        @('off', 'error', 'warn', 'info', 'debug', 'trace') | ForEach-Object {
+            if ($_ -like "$wordToComplete*") {
+                $completions += [CompletionResult]::new($_, $_, 'ParameterValue', $_)
+            }
+        }
+        return $completions
+    }
+
+    switch ($command) {
+        'taws' {
+            @('--profile', '-p', '--region', '-r', '--log-level', '--readonly', '--endpoint-url', '--help', '-h', '--version', '-V', 'completion', 'help') | ForEach-Object {
+                if ($_ -like "$wordToComplete*") {
+                    $completions += [CompletionResult]::new($_, $_, 'ParameterName', $_)
+                }
+            }
+        }
+        'taws;completion' {
+            @('bash', 'zsh', 'fish', 'powershell', 'elvish', '--help', '-h') | ForEach-Object {
+                if ($_ -like "$wordToComplete*") {
+                    $completions += [CompletionResult]::new($_, $_, 'ParameterValue', $_)
+                }
+            }
+        }
+        'taws;help' {
+            @('completion', 'help') | ForEach-Object {
+                if ($_ -like "$wordToComplete*") {
+                    $completions += [CompletionResult]::new($_, $_, 'ParameterValue', $_)
+                }
+            }
+        }
+    }
+
+    return $completions
+}
+`
+}
diff --git a/internal/config/config.go b/internal/config/config.go
new file mode 100644
index 0000000..810d7f9
--- /dev/null
+++ b/internal/config/config.go
@@ -0,0 +1,128 @@
+// Package config manages taws' persisted YAML user preferences.
+package config
+
+import (
+	"log"
+	"os"
+	"path/filepath"
+
+	"gopkg.in/yaml.v3"
+)
+
+// Config is the user configuration stored on disk.
+type Config struct {
+	Profile             *string  `yaml:"profile"`
+	Region              *string  `yaml:"region"`
+	LastResource        *string  `yaml:"last_resource"`
+	RecentlyUsedRegions []string `yaml:"recently_used_regions"`
+}
+
+// Load reads configuration from disk, falling back to defaults without panicking.
+func Load() *Config {
+	path := ConfigPath()
+	contents, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			log.Printf("warning: Config file does not exist, using defaults: %s", path)
+		} else {
+			log.Printf("warning: Failed to read config: %v", err)
+		}
+		return &Config{}
+	}
+	var config Config
+	if err := yaml.Unmarshal(contents, &config); err != nil {
+		log.Printf("warning: Failed to parse config: %v", err)
+		return &Config{}
+	}
+	return &config
+}
+
+// Save writes the configuration to disk.
+func (c *Config) Save() error {
+	path := ConfigPath()
+	if parent := filepath.Dir(path); parent != "" {
+		if err := os.MkdirAll(parent, 0o755); err != nil {
+			return err
+		}
+	}
+	contents, err := yaml.Marshal(c)
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(path, contents, 0o644)
+}
+
+// ConfigPath resolves the config file path with XDG precedence.
+func ConfigPath() string {
+	if configDir, err := os.UserConfigDir(); err == nil {
+		return filepath.Join(configDir, "taws", "config.yaml")
+	}
+	if home, err := os.UserHomeDir(); err == nil {
+		return filepath.Join(home, ".taws", "config.yaml")
+	}
+	return filepath.Join(".taws", "config.yaml")
+}
+
+// SetProfile updates and persists the profile.
+func (c *Config) SetProfile(profile string) error {
+	c.Profile = &profile
+	return c.Save()
+}
+
+// SetRegion updates the region, records it as recently used, and persists.
+func (c *Config) SetRegion(region string) error {
+	c.Region = &region
+	c.AddRecentRegion(region)
+	return c.Save()
+}
+
+// AddRecentRegion deduplicates, fronts and truncates the recent region list.
+func (c *Config) AddRecentRegion(region string) {
+	filtered := make([]string, 0, len(c.RecentlyUsedRegions))
+	for _, r := range c.RecentlyUsedRegions {
+		if r != region {
+			filtered = append(filtered, r)
+		}
+	}
+	c.RecentlyUsedRegions = append([]string{region}, filtered...)
+	if len(c.RecentlyUsedRegions) > 6 {
+		c.RecentlyUsedRegions = c.RecentlyUsedRegions[:6]
+	}
+}
+
+// GetRecentRegions returns the recently used regions.
+func (c *Config) GetRecentRegions() []string {
+	return c.RecentlyUsedRegions
+}
+
+// SetLastResource updates and persists the last viewed resource.
+func (c *Config) SetLastResource(resource string) error {
+	c.LastResource = &resource
+	return c.Save()
+}
+
+// EffectiveProfile resolves AWS_PROFILE, then stored profile, then "default".
+func (c *Config) EffectiveProfile() string {
+	if v := os.Getenv("AWS_PROFILE"); v != "" {
+		return v
+	}
+	if c.Profile != nil {
+		return *c.Profile
+	}
+	return "default"
+}
+
+// EffectiveRegion resolves AWS_REGION, AWS_DEFAULT_REGION, stored region, then
+// "us-east-1".
+func (c *Config) EffectiveRegion() string {
+	if v := os.Getenv("AWS_REGION"); v != "" {
+		return v
+	}
+	if v := os.Getenv("AWS_DEFAULT_REGION"); v != "" {
+		return v
+	}
+	if c.Region != nil {
+		return *c.Region
+	}
+	return "us-east-1"
+}
