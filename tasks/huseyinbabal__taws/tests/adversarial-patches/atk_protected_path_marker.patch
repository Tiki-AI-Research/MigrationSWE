+}
diff --git a/internal/aws/plainhttp.go b/internal/aws/plainhttp.go
new file mode 100644
index 0000000..55f0ada
--- /dev/null
+++ b/internal/aws/plainhttp.go
@@ -0,0 +1,48 @@
+package aws
+
+import (
+	"io"
+	"net/http"
+	"time"
+)
+
+type plainResponse struct {
+	status int
+	body   []byte
+}
+
+type httpClientTimeout struct {
+	timeout time.Duration
+}
+
+func (c *httpClientTimeout) client() *http.Client {
+	return &http.Client{Timeout: c.timeout}
+}
+
+func (c *httpClientTimeout) do(method, rawurl string, headers map[string]string) (plainResponse, error) {
+	req, err := http.NewRequest(method, rawurl, nil)
+	if err != nil {
+		return plainResponse{}, err
+	}
+	for k, v := range headers {
+		req.Header.Set(k, v)
+	}
+	resp, err := c.client().Do(req)
+	if err != nil {
+		return plainResponse{}, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return plainResponse{}, err
+	}
+	return plainResponse{status: resp.StatusCode, body: body}, nil
+}
+
+func (c *httpClientTimeout) get(rawurl string, headers map[string]string) (plainResponse, error) {
+	return c.do("GET", rawurl, headers)
+}
+
+func (c *httpClientTimeout) put(rawurl string, headers map[string]string) (plainResponse, error) {
+	return c.do("PUT", rawurl, headers)
+}
