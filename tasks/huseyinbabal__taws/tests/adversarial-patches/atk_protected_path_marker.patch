+package resource
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestExtractSimplePath(t *testing.T) {
+	jsonVal := map[string]any{"name": "test", "value": float64(42)}
+
+	if got := ExtractByPath(jsonVal, "/name"); got != "test" {
+		t.Fatalf("name = %v", got)
+	}
+	if got := ExtractByPath(jsonVal, "/value"); got != float64(42) {
+		t.Fatalf("value = %v", got)
+	}
+	if got := ExtractByPath(jsonVal, "/missing"); got != nil {
+		t.Fatalf("missing = %v", got)
+	}
+}
+
+func TestExtractNestedPath(t *testing.T) {
+	jsonVal := map[string]any{
+		"instance": map[string]any{
+			"state": map[string]any{"name": "running"},
+		},
+	}
+	if got := ExtractByPath(jsonVal, "/instance/state/name"); got != "running" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestExtractFromArray(t *testing.T) {
+	jsonVal := map[string]any{
+		"items": []any{
+			map[string]any{"id": "1", "name": "first"},
+			map[string]any{"id": "2", "name": "second"},
+		},
+	}
+	result := ExtractByPath(jsonVal, "/items/name")
+	want := []any{"first", "second"}
+	if !reflect.DeepEqual(result, want) {
+		t.Fatalf("got %v, want %v", result, want)
+	}
+}
+
+func TestExtractListArray(t *testing.T) {
+	jsonVal := map[string]any{
+		"items": []any{map[string]any{"id": "1"}, map[string]any{"id": "2"}},
+	}
+	if got := ExtractList(jsonVal, "/items"); len(got) != 2 {
+		t.Fatalf("len = %d", len(got))
+	}
+}
+
+func TestExtractListSingleObject(t *testing.T) {
+	jsonVal := map[string]any{"items": map[string]any{"id": "1"}}
+	list := ExtractList(jsonVal, "/items")
+	if len(list) != 1 {
+		t.Fatalf("len = %d", len(list))
+	}
+	item := list[0].(map[string]any)
+	if item["id"] != "1" {
+		t.Fatalf("id = %v", item["id"])
+	}
+}
+
+func TestExtractString(t *testing.T) {
+	jsonVal := map[string]any{"name": "test", "count": float64(42)}
+	if got := ExtractString(jsonVal, "/name", "-"); got != "test" {
+		t.Fatalf("name = %q", got)
+	}
+	if got := ExtractString(jsonVal, "/count", "-"); got != "42" {
+		t.Fatalf("count = %q", got)
+	}
+	if got := ExtractString(jsonVal, "/missing", "-"); got != "-" {
+		t.Fatalf("missing = %q", got)
+	}
+}
+
+func TestValueToStringBool(t *testing.T) {
+	if got := ValueToString(true, "-"); got != "Yes" {
+		t.Fatalf("true = %q", got)
+	}
+	if got := ValueToString(false, "-"); got != "No" {
+		t.Fatalf("false = %q", got)
+	}
+}
+
+func TestEC2StyleResponse(t *testing.T) {
+	jsonVal := map[string]any{
+		"DescribeInstancesResponse": map[string]any{
+			"reservationSet": map[string]any{
+				"item": []any{
+					map[string]any{
+						"instancesSet": map[string]any{
+							"item": map[string]any{
+								"instanceId":    "i-123",
+								"instanceState": map[string]any{"name": "running"},
+							},
+						},
+					},
+				},
+			},
+		},
+	}
+	items := ExtractList(jsonVal, "/DescribeInstancesResponse/reservationSet/item/instancesSet/item")
+	if len(items) != 1 {
+		t.Fatalf("len = %d", len(items))
+	}
+	item := items[0].(map[string]any)
+	if item["instanceId"] != "i-123" {
+		t.Fatalf("instanceId = %v", item["instanceId"])
+	}
+}
diff --git a/internal/resource/protocol.go b/internal/resource/protocol.go
new file mode 100644
index 0000000..4358dc5
--- /dev/null
+++ b/internal/resource/protocol.go
@@ -0,0 +1,130 @@
+// Package resource implements the JSON-driven AWS resource registry and the
+// protocol handlers used to list, describe and act on resources.
+package resource
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+// APIProtocol identifies the wire protocol used for an AWS API call.
+type APIProtocol string
+
+const (
+	ProtocolQuery    APIProtocol = "query"
+	ProtocolJSON     APIProtocol = "json"
+	ProtocolRestJSON APIProtocol = "rest-json"
+	ProtocolRestXML  APIProtocol = "rest-xml"
+)
+
+// UnmarshalJSON decodes the kebab-case protocol names used in resources/*.json.
+func (p *APIProtocol) UnmarshalJSON(data []byte) error {
+	var s string
+	if err := json.Unmarshal(data, &s); err != nil {
+		return err
+	}
+	switch s {
+	case "query":
+		*p = ProtocolQuery
+	case "json":
+		*p = ProtocolJSON
+	case "rest-json":
+		*p = ProtocolRestJSON
+	case "rest-xml":
+		*p = ProtocolRestXML
+	default:
+		return fmt.Errorf("unknown api protocol: %q", s)
+	}
+	return nil
+}
+
+// effective returns the protocol, treating the zero value as the query default.
+func (p APIProtocol) effective() APIProtocol {
+	if p == "" {
+		return ProtocolQuery
+	}
+	return p
+}
+
+// PaginationConfig describes how to page through a list API.
+type PaginationConfig struct {
+	InputToken      *string `json:"input_token"`
+	OutputToken     *string `json:"output_token"`
+	MaxResultsParam *string `json:"max_results_param"`
+	MaxResults      *uint32 `json:"max_results"`
+}
+
+// CompositeOperation is a single step of a composite API call.
+type CompositeOperation struct {
+	Action  string         `json:"action"`
+	StoreAs *string        `json:"store_as"`
+	Input   map[string]any `json:"input"`
+}
+
+// APIConfig is the data-driven configuration for a list operation.
+type APIConfig struct {
+	Protocol     APIProtocol          `json:"protocol"`
+	ServiceName  *string              `json:"service_name"`
+	Action       *string              `json:"action"`
+	Method       *string              `json:"method"`
+	Path         *string              `json:"path"`
+	ResponseRoot *string              `json:"response_root"`
+	ItemsPath    *string              `json:"items_path"`
+	StaticParams map[string]any       `json:"static_params"`
+	ParamMapping map[string]string    `json:"param_mapping"`
+	Pagination   *PaginationConfig    `json:"pagination"`
+	PreHooks     []string             `json:"pre_hooks"`
+	Composite    bool                 `json:"composite"`
+	Operations   []CompositeOperation `json:"operations"`
+}
+
+// FieldMapping maps a source path in the raw response to a normalized field.
+type FieldMapping struct {
+	Source        string  `json:"source"`
+	Default       *string `json:"default"`
+	Transform     *string `json:"transform"`
