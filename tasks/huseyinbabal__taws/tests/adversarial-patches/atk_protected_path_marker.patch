index 0000000..1807c7e
--- /dev/null
+++ b/internal/aws/credentials.go
@@ -0,0 +1,1085 @@
+package aws
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Credentials holds a resolved AWS access key pair.
+type Credentials struct {
+	AccessKeyID     string
+	SecretAccessKey string
+	SessionToken    *string
+}
+
+// CredentialsErrorKind identifies the class of a credential resolution failure.
+type CredentialsErrorKind int
+
+const (
+	// ErrSSOLoginRequired indicates an interactive `aws sso login` is needed.
+	ErrSSOLoginRequired CredentialsErrorKind = iota
+	// ErrConsoleLoginRequired indicates an interactive `aws login` is needed.
+	ErrConsoleLoginRequired
+	// ErrOther is any other credential resolution failure.
+	ErrOther
+)
+
+// CredentialsError distinguishes SSO and console-login authentication failures.
+type CredentialsError struct {
+	Kind         CredentialsErrorKind
+	Profile      string
+	SSOSession   string
+	LoginSession string
+	Err          error
+}
+
+// Error implements the error interface with baseline-compatible messages.
+func (e *CredentialsError) Error() string {
+	switch e.Kind {
+	case ErrSSOLoginRequired:
+		return fmt.Sprintf("SSO login required for profile '%s' (session: %s). Run 'aws sso login --profile %s'", e.Profile, e.SSOSession, e.Profile)
+	case ErrConsoleLoginRequired:
+		return fmt.Sprintf("Console login required for profile '%s' (session: %s). Run 'aws login --profile %s'", e.Profile, e.LoginSession, e.Profile)
+	default:
+		if e.Err != nil {
+			return e.Err.Error()
+		}
+		return "unknown credentials error"
+	}
+}
+
+// Unwrap exposes the wrapped error for errors.Is/As.
+func (e *CredentialsError) Unwrap() error { return e.Err }
+
+type cachedCreds struct {
+	credentials Credentials
+	expiration  time.Time
+}
+
+var (
+	imdsCacheMu sync.Mutex
+	imdsCache   *cachedCreds
+
+	ssoCacheMu sync.Mutex
+	ssoCache   = map[string]cachedCreds{}
+
+	processCacheMu sync.Mutex
+	processCache   = map[string]cachedCreds{}
+
+	assumeRoleCacheMu sync.Mutex
+	assumeRoleCache   = map[string]cachedCreds{}
+
+	ecsCacheMu sync.Mutex
+	ecsCache   *cachedCreds
+
+	consoleLoginCacheMu sync.Mutex
+	consoleLoginCache   = map[string]cachedCreds{}
+)
+
+const (
+	ecsCredentialsEndpoint = "http://169.254.170.2"
+	imdsEndpoint           = "http://169.254.169.254"
+	imdsTokenTTL           = 21600
+	imdsTimeout            = 2 * time.Second
+	credentialRefreshBuf   = 300 * time.Second
+)
+
+// LoadCredentials loads credentials for a profile, flattening specific login
+// errors into the baseline's generic messages.
+func LoadCredentials(profile string) (Credentials, error) {
+	creds, err := loadCredentialsInner(profile)
+	if err != nil {
+		return Credentials{}, err
+	}
+	return creds, nil
+}
+
+// LoadCredentialsWithSSOCheck loads credentials with detailed login errors.
+func LoadCredentialsWithSSOCheck(profile string) (Credentials, *CredentialsError) {
+	return loadCredentialsInner(profile)
+}
+
+func loadCredentialsInner(profile string) (Credentials, *CredentialsError) {
+	if profile == "default" {
+		if creds, err := loadFromEnv(); err == nil {
+			return creds, nil
+		}
+	}
+
+	if ssoConfig := GetSSOConfig(profile); ssoConfig != nil {
+		creds, err := loadFromSSO(profile)
+		if err == nil {
+			return creds, nil
+		}
+		return Credentials{}, &CredentialsError{Kind: ErrSSOLoginRequired, Profile: profile, SSOSession: ssoConfig.SSOSession}
+	}
+
+	if loginSession, ok := getLoginSessionConfig(profile); ok {
+		creds, err := loadFromConsoleLogin(profile, loginSession)
+		if err == nil {
+			return creds, nil
+		}
+		return Credentials{}, &CredentialsError{Kind: ErrConsoleLoginRequired, Profile: profile, LoginSession: loginSession}
+	}
+
+	if assumeRoleConfig := getAssumeRoleConfig(profile); assumeRoleConfig != nil {
+		if creds, err := loadFromCLICache(profile, assumeRoleConfig.RoleArn); err == nil {
+			return creds, nil
+		}
+		creds, err := loadFromAssumeRole(profile, assumeRoleConfig)
+		if err == nil {
+			return creds, nil
+		}
+		return Credentials{}, &CredentialsError{Kind: ErrOther, Err: err}
+	}
+
+	if creds, err := loadFromCredentialsFile(profile); err == nil {
+		return creds, nil
+	}
+
+	if creds, err := loadFromConfigFile(profile); err == nil {
+		return creds, nil
+	}
+
+	if profile == "default" {
+		if creds, err := loadFromIMDS(); err == nil {
+			return creds, nil
+		}
+	}
+
+	return Credentials{}, &CredentialsError{Kind: ErrOther, Err: fmt.Errorf(
+		"No credentials found for profile '%s'. Run 'aws configure', 'aws sso login --profile %s', 'aws login --profile %s', or set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY",
+		profile, profile, profile)}
+}
+
+func loadFromEnv() (Credentials, error) {
+	accessKeyID, ok := os.LookupEnv("AWS_ACCESS_KEY_ID")
+	if !ok {
+		return Credentials{}, fmt.Errorf("AWS_ACCESS_KEY_ID not set")
+	}
+	secretAccessKey, ok := os.LookupEnv("AWS_SECRET_ACCESS_KEY")
+	if !ok {
+		return Credentials{}, fmt.Errorf("AWS_SECRET_ACCESS_KEY not set")
+	}
+	var sessionToken *string
+	if v, ok := os.LookupEnv("AWS_SESSION_TOKEN"); ok {
+		sessionToken = &v
+	}
+	return Credentials{AccessKeyID: accessKeyID, SecretAccessKey: secretAccessKey, SessionToken: sessionToken}, nil
+}
+
+// AwsConfigDir returns the AWS configuration directory.
+func AwsConfigDir() (string, error) {
+	if path := os.Getenv("AWS_CONFIG_FILE"); path != "" {
+		return filepath.Dir(path), nil
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return "", fmt.Errorf("Could not find home directory")
+	}
+	return filepath.Join(home, ".aws"), nil
+}
+
+// GetAWSConfigFilePath returns the AWS config file path, honoring AWS_CONFIG_FILE.
+func GetAWSConfigFilePath() (string, error) {
+	if path := os.Getenv("AWS_CONFIG_FILE"); path != "" {
+		return path, nil
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return "", fmt.Errorf("Could not find home directory")
+	}
+	return filepath.Join(home, ".aws", "config"), nil
+}
+
+// ParseINIFile parses an INI-style AWS config/credentials file into sections.
+func ParseINIFile(content string) map[string]map[string]string {
+	sections := map[string]map[string]string{}
+	currentSection := ""
+
+	for _, rawLine := range strings.Split(content, "\n") {
+		line := strings.TrimSpace(rawLine)
+		if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, ";") {
+			continue
+		}
+		if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
+			currentSection = strings.TrimSpace(line[1 : len(line)-1])
+			if strings.HasPrefix(currentSection, "profile ") {
+				currentSection = currentSection[len("profile "):]
+			}
+			if _, ok := sections[currentSection]; !ok {
+				sections[currentSection] = map[string]string{}
+			}
+			continue
+		}
+		if idx := strings.Index(line, "="); idx >= 0 {
+			if currentSection != "" {
+				key := strings.TrimSpace(line[:idx])
+				value := strings.TrimSpace(line[idx+1:])
+				if sections[currentSection] == nil {
+					sections[currentSection] = map[string]string{}
+				}
+				sections[currentSection][key] = value
+			}
+		}
+	}
+	return sections
+}
+
+func loadFromCredentialsFile(profile string) (Credentials, error) {
+	var credsPath string
+	if path := os.Getenv("AWS_SHARED_CREDENTIALS_FILE"); path != "" {
+		credsPath = path
+	} else {
+		dir, err := AwsConfigDir()
+		if err != nil {
+			return Credentials{}, err
+		}
+		credsPath = filepath.Join(dir, "credentials")
+	}
+	data, err := os.ReadFile(credsPath)
+	if err != nil {
+		return Credentials{}, fmt.Errorf("Could not read %s", credsPath)
+	}
+	sections := ParseINIFile(string(data))
+	section, ok := sections[profile]
+	if !ok {
+		return Credentials{}, fmt.Errorf("Profile '%s' not found in credentials file", profile)
+	}
+	if command, ok := section["credential_process"]; ok {
+		return loadFromProcess(profile, command)
+	}
+	accessKeyID, ok := section["aws_access_key_id"]
+	if !ok {
+		return Credentials{}, fmt.Errorf("aws_access_key_id not found for profile '%s'", profile)
+	}
+	secretAccessKey, ok := section["aws_secret_access_key"]
+	if !ok {
+		return Credentials{}, fmt.Errorf("aws_secret_access_key not found for profile '%s'", profile)
+	}
+	var sessionToken *string
+	if v, ok := section["aws_session_token"]; ok {
+		sessionToken = &v
+	}
+	return Credentials{AccessKeyID: accessKeyID, SecretAccessKey: secretAccessKey, SessionToken: sessionToken}, nil
+}
+
+func loadFromConfigFile(profile string) (Credentials, error) {
+	configPath, err := GetAWSConfigFilePath()
+	if err != nil {
+		return Credentials{}, err
+	}
+	data, err := os.ReadFile(configPath)
+	if err != nil {
+		return Credentials{}, fmt.Errorf("Could not read %s", configPath)
+	}
+	sections := ParseINIFile(string(data))
+	section, ok := sections[profile]
+	if !ok {
+		return Credentials{}, fmt.Errorf("Profile '%s' not found in config file", profile)
+	}
+	if command, ok := section["credential_process"]; ok {
+		return loadFromProcess(profile, command)
+	}
+	accessKey, hasAccess := section["aws_access_key_id"]
+	secretKey, hasSecret := section["aws_secret_access_key"]
+	if hasAccess && hasSecret {
+		var sessionToken *string
+		if v, ok := section["aws_session_token"]; ok {
+			sessionToken = &v
+		}
+		return Credentials{AccessKeyID: accessKey, SecretAccessKey: secretKey, SessionToken: sessionToken}, nil
+	}
+	return Credentials{}, fmt.Errorf("No direct credentials found in config for profile '%s'", profile)
+}
+
+func loadFromSSO(profile string) (Credentials, error) {
+	ssoCacheMu.Lock()
+	if cached, ok := ssoCache[profile]; ok && cached.expiration.After(time.Now().Add(credentialRefreshBuf)) {
+		ssoCacheMu.Unlock()
+		return cached.credentials, nil
+	}
+	ssoCacheMu.Unlock()
+
+	ssoConfig := GetSSOConfig(profile)
+	if ssoConfig == nil {
+		return Credentials{}, fmt.Errorf("Profile '%s' does not have SSO configured", profile)
+	}
+	accessToken := ReadCachedToken(ssoConfig)
+	if accessToken == nil {
+		return Credentials{}, fmt.Errorf("SSO token not found or expired for profile '%s'. Interactive login required.", profile)
+	}
+	credentials, err := GetRoleCredentials(ssoConfig, *accessToken)
+	if err != nil {
+		return Credentials{}, err
+	}
+	expiration := time.Now().Add(3600 * time.Second)
+	ssoCacheMu.Lock()
+	ssoCache[profile] = cachedCreds{credentials: credentials, expiration: expiration}
+	ssoCacheMu.Unlock()
+	return credentials, nil
+}
+
+func getLoginSessionConfig(profile string) (string, bool) {
+	configPath, err := GetAWSConfigFilePath()
+	if err != nil {
+		return "", false
+	}
+	data, err := os.ReadFile(configPath)
+	if err != nil {
+		return "", false
+	}
+	sections := ParseINIFile(string(data))
+	section, ok := sections[profile]
+	if !ok {
+		return "", false
+	}
+	v, ok := section["login_session"]
+	return v, ok
+}
+
+func getLoginCacheDir() (string, error) {
+	if dir := os.Getenv("AWS_LOGIN_CACHE_DIRECTORY"); dir != "" {
+		return dir, nil
+	}
+	configDir, err := AwsConfigDir()
+	if err != nil {
+		return "", err
+	}
+	return filepath.Join(configDir, "login", "cache"), nil
+}
+
+func loadFromConsoleLogin(profile, loginSession string) (Credentials, error) {
+	consoleLoginCacheMu.Lock()
+	if cached, ok := consoleLoginCache[profile]; ok && cached.expiration.After(time.Now().Add(credentialRefreshBuf)) {
+		consoleLoginCacheMu.Unlock()
+		return cached.credentials, nil
+	}
+	consoleLoginCacheMu.Unlock()
+
+	cacheDir, err := getLoginCacheDir()
+	if err != nil {
+		return Credentials{}, err
+	}
+	if info, err := os.Stat(cacheDir); err != nil || !info.IsDir() {
+		return Credentials{}, fmt.Errorf("Console login cache directory not found. Run 'aws login'")
+	}
+
+	sum := sha256.Sum256([]byte(strings.TrimSpace(loginSession)))
+	cacheFilename := hex.EncodeToString(sum[:]) + ".json"
+	cacheFile := filepath.Join(cacheDir, cacheFilename)
+	if _, err := os.Stat(cacheFile); err != nil {
+		return Credentials{}, fmt.Errorf("No login cache file found for profile '%s'. Run 'aws login --profile %s'", profile, profile)
+	}
+
+	data, err := os.ReadFile(cacheFile)
+	if err != nil {
+		return Credentials{}, fmt.Errorf("Failed to read login cache: %v", err)
+	}
+	var cacheData map[string]any
+	if err := json.Unmarshal(data, &cacheData); err != nil {
+		return Credentials{}, fmt.Errorf("Failed to parse login cache: %v", err)
+	}
+	accessToken, ok := cacheData["accessToken"].(map[string]any)
+	if !ok {
+		return Credentials{}, fmt.Errorf("accessToken not found in login cache")
+	}
+	accessKeyID, ok := accessToken["accessKeyId"].(string)
+	if !ok {
+		return Credentials{}, fmt.Errorf("accessKeyId not found in login cache")
+	}
+	secretAccessKey, ok := accessToken["secretAccessKey"].(string)
+	if !ok {
+		return Credentials{}, fmt.Errorf("secretAccessKey not found in login cache")
+	}
+	var sessionToken *string
+	if v, ok := accessToken["sessionToken"].(string); ok {
+		sessionToken = &v
+	}
+
+	var expiration time.Time
+	if expStr, ok := accessToken["expiresAt"].(string); ok {
+		if parsed, err := time.Parse(time.RFC3339, expStr); err == nil {
+			if !parsed.After(time.Now()) {
+				return Credentials{}, fmt.Errorf("Console login credentials expired. Run 'aws login --profile %s'", profile)
+			}
+			expiration = parsed
+		} else {
+			expiration = time.Now().Add(3600 * time.Second)
+		}
+	} else {
+		expiration = time.Now().Add(3600 * time.Second)
+	}
+
+	credentials := Credentials{AccessKeyID: accessKeyID, SecretAccessKey: secretAccessKey, SessionToken: sessionToken}
+	consoleLoginCacheMu.Lock()
+	consoleLoginCache[profile] = cachedCreds{credentials: credentials, expiration: expiration}
+	consoleLoginCacheMu.Unlock()
+	return credentials, nil
+}
+
+func loadFromCLICache(profile, roleArn string) (Credentials, error) {
+	configDir, err := AwsConfigDir()
+	if err != nil {
+		return Credentials{}, err
+	}
+	cacheDir := filepath.Join(configDir, "cli", "cache")
+	entries, err := os.ReadDir(cacheDir)
+	if err != nil {
+		return Credentials{}, fmt.Errorf("AWS CLI cache directory not found")
+	}
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		path := filepath.Join(cacheDir, entry.Name())
+		if filepath.Ext(path) != ".json" {
+			continue
+		}
+		if creds, ok := tryReadCLICacheFile(path, roleArn); ok {
+			return creds, nil
+		}
+	}
+	return Credentials{}, fmt.Errorf("No valid cached credentials found for profile '%s'", profile)
+}
+
+func tryReadCLICacheFile(path, roleArn string) (Credentials, bool) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return Credentials{}, false
+	}
+	var cacheData map[string]any
+	if err := json.Unmarshal(data, &cacheData); err != nil {
+		return Credentials{}, false
+	}
+	assumedRoleUser, ok := cacheData["AssumedRoleUser"].(map[string]any)
+	if !ok {
+		return Credentials{}, false
+	}
+	assumedRoleArn, ok := assumedRoleUser["Arn"].(string)
+	if !ok {
+		return Credentials{}, false
+	}
+
+	cacheParts := strings.Split(assumedRoleArn, ":")
+	configParts := strings.Split(roleArn, ":")
+	if len(cacheParts) <= 4 || len(configParts) <= 4 || cacheParts[4] != configParts[4] {
+		return Credentials{}, false
+	}
+
+	cacheRoleParts := strings.Split(assumedRoleArn, "/")
+	if len(cacheRoleParts) < 2 {
+		return Credentials{}, false
+	}
+	cacheRoleName := cacheRoleParts[1]
+	configRoleParts := strings.Split(roleArn, "/")
+	configRoleName := configRoleParts[len(configRoleParts)-1]
+	if cacheRoleName != configRoleName {
+		return Credentials{}, false
+	}
+
+	credsRaw, ok := cacheData["Credentials"].(map[string]any)
+	if !ok {
+		return Credentials{}, false
+	}
+	accessKeyID, ok := credsRaw["AccessKeyId"].(string)
+	if !ok {
+		return Credentials{}, false
+	}
+	secretAccessKey, ok := credsRaw["SecretAccessKey"].(string)
+	if !ok {
+		return Credentials{}, false
+	}
+	var sessionToken *string
+	if v, ok := credsRaw["SessionToken"].(string); ok {
+		sessionToken = &v
+	}
+	if expStr, ok := credsRaw["Expiration"].(string); ok {
+		if expiration, err := time.Parse(time.RFC3339, expStr); err == nil {
+			if !expiration.After(time.Now()) {
+				return Credentials{}, false
+			}
+		}
+	}
+	return Credentials{AccessKeyID: accessKeyID, SecretAccessKey: secretAccessKey, SessionToken: sessionToken}, true
+}
+
+func loadFromProcess(profile, command string) (Credentials, error) {
+	processCacheMu.Lock()
+	if cached, ok := processCache[profile]; ok && cached.expiration.After(time.Now().Add(credentialRefreshBuf)) {
+		processCacheMu.Unlock()
+		return cached.credentials, nil
+	}
+	processCacheMu.Unlock()
+
+	credentials, exp, err := executeCredentialProcess(command)
+	if err != nil {
+		return Credentials{}, err
+	}
+	cacheExpiration := time.Now().Add(time.Duration(365*24) * time.Hour)
+	if exp != nil {
+		cacheExpiration = *exp
+	}
+	processCacheMu.Lock()
+	processCache[profile] = cachedCreds{credentials: credentials, expiration: cacheExpiration}
+	processCacheMu.Unlock()
+	return credentials, nil
+}
+
+func executeCredentialProcess(command string) (Credentials, *time.Time, error) {
+	var cmd *exec.Cmd
+	if runtime.GOOS == "windows" {
+		cmd = exec.Command("cmd", "/C", command)
+	} else {
+		cmd = exec.Command("sh", "-c", command)
+	}
+	output, err := cmd.Output()
+	if err != nil {
+		stderr := ""
+		if ee, ok := err.(*exec.ExitError); ok {
+			stderr = string(ee.Stderr)
+		}
+		return Credentials{}, nil, fmt.Errorf("credential_process failed: %v: %s", err, stderr)
+	}
+	var jsonData map[string]any
+	if err := json.Unmarshal(output, &jsonData); err != nil {
+		return Credentials{}, nil, fmt.Errorf("Failed to parse credential_process output: %v", err)
+	}
+	if version, ok := jsonData["Version"].(float64); ok && int(version) != 1 {
+		return Credentials{}, nil, fmt.Errorf("Unsupported credential_process version: %d", int(version))
+	}
+	accessKeyID, ok := jsonData["AccessKeyId"].(string)
+	if !ok {
+		return Credentials{}, nil, fmt.Errorf("AccessKeyId missing in credential_process output")
+	}
+	secretAccessKey, ok := jsonData["SecretAccessKey"].(string)
+	if !ok {
+		return Credentials{}, nil, fmt.Errorf("SecretAccessKey missing in credential_process output")
+	}
+	var sessionToken *string
+	if v, ok := jsonData["SessionToken"].(string); ok {
+		sessionToken = &v
+	}
+	var expiration *time.Time
+	if expStr, ok := jsonData["Expiration"].(string); ok {
+		expiration = parseExpiration(expStr)
+	}
+	return Credentials{AccessKeyID: accessKeyID, SecretAccessKey: secretAccessKey, SessionToken: sessionToken}, expiration, nil
+}
+
+// GetProfileRegion returns the configured region for a profile.
+func GetProfileRegion(profile string) *string {
+	if region := os.Getenv("AWS_REGION"); region != "" {
+		return &region
+	}
+	if region := os.Getenv("AWS_DEFAULT_REGION"); region != "" {
+		return &region
+	}
+	configPath, err := GetAWSConfigFilePath()
+	if err != nil {
+		return nil
+	}
+	data, err := os.ReadFile(configPath)
+	if err != nil {
+		return nil
+	}
+	sections := ParseINIFile(string(data))
+	if section, ok := sections[profile]; ok {
+		if region, ok := section["region"]; ok {
+			return &region
+		}
+	}
+	return nil
+}
+
+// AssumeRoleConfig configures IAM role assumption for a profile.
+type AssumeRoleConfig struct {
+	RoleArn          string
+	SourceProfile    *string
+	CredentialSource *CredentialSource
+	ExternalID       *string
+	RoleSessionName  *string
+	DurationSeconds  *uint32
+	Region           *string
+}
+
+// CredentialSource identifies where role-assumption source credentials come from.
+type CredentialSource int
+
+const (
+	SourceEnvironment CredentialSource = iota
+	SourceEc2InstanceMetadata
+	SourceEcsContainer
+)
+
+func getAssumeRoleConfig(profile string) *AssumeRoleConfig {
+	var configPath string
+	if path := os.Getenv("AWS_CONFIG_FILE"); path != "" {
+		configPath = path
+	} else {
+		dir, err := AwsConfigDir()
+		if err != nil {
+			return nil
+		}
+		configPath = filepath.Join(dir, "config")
+	}
+	data, err := os.ReadFile(configPath)
+	if err != nil {
+		return nil
+	}
+	sections := ParseINIFile(string(data))
+	section, ok := sections[profile]
+	if !ok {
+		return nil
+	}
+	roleArn, ok := section["role_arn"]
+	if !ok {
+		return nil
+	}
+
+	var sourceProfile *string
+	if v, ok := section["source_profile"]; ok {
+		sourceProfile = &v
+	}
+	var credentialSource *CredentialSource
+	if v, ok := section["credential_source"]; ok {
+		credentialSource = parseCredentialSource(v)
+	}
+	if sourceProfile != nil && credentialSource != nil {
+		return nil
+	}
+	if sourceProfile == nil && credentialSource == nil {
+		return nil
+	}
+
+	cfg := &AssumeRoleConfig{
+		RoleArn:          roleArn,
+		SourceProfile:    sourceProfile,
+		CredentialSource: credentialSource,
+	}
+	if v, ok := section["external_id"]; ok {
+		cfg.ExternalID = &v
+	}
+	if v, ok := section["role_session_name"]; ok {
+		cfg.RoleSessionName = &v
+	}
+	if v, ok := section["duration_seconds"]; ok {
+		if n, err := strconv.ParseUint(v, 10, 32); err == nil {
+			d := uint32(n)
+			cfg.DurationSeconds = &d
+		}
+	}
+	if v, ok := section["region"]; ok {
+		cfg.Region = &v
+	}
+	return cfg
+}
+
+func parseCredentialSource(value string) *CredentialSource {
+	switch value {
+	case "Environment":
+		s := SourceEnvironment
+		return &s
+	case "Ec2InstanceMetadata":
+		s := SourceEc2InstanceMetadata
+		return &s
+	case "EcsContainer":
+		s := SourceEcsContainer
+		return &s
+	default:
+		return nil
+	}
+}
+
+func loadFromAssumeRole(profile string, config *AssumeRoleConfig) (Credentials, error) {
+	assumeRoleCacheMu.Lock()
+	if cached, ok := assumeRoleCache[profile]; ok && cached.expiration.After(time.Now().Add(credentialRefreshBuf)) {
+		assumeRoleCacheMu.Unlock()
+		return cached.credentials, nil
+	}
+	assumeRoleCacheMu.Unlock()
+
+	var sourceCreds Credentials
+	var err error
+	if config.SourceProfile != nil {
+		sourceCreds, err = LoadCredentials(*config.SourceProfile)
+		if err != nil {
+			return Credentials{}, fmt.Errorf("Failed to load source credentials from profile '%s': %v", *config.SourceProfile, err)
+		}
+	} else if config.CredentialSource != nil {
+		sourceCreds, err = loadFromCredentialSource(*config.CredentialSource)
+		if err != nil {
+			return Credentials{}, err
+		}
+	} else {
+		return Credentials{}, fmt.Errorf("Profile '%s' has role_arn but no source_profile or credential_source", profile)
+	}
+
+	region := "us-east-1"
+	if config.Region != nil {
+		region = *config.Region
+	} else if config.SourceProfile != nil {
+		if r := GetProfileRegion(*config.SourceProfile); r != nil {
+			region = *r
+		}
+	}
+
+	credentials, expiration, err := callSTSAssumeRole(config, sourceCreds, region)
+	if err != nil {
+		return Credentials{}, err
+	}
+	assumeRoleCacheMu.Lock()
+	assumeRoleCache[profile] = cachedCreds{credentials: credentials, expiration: expiration}
+	assumeRoleCacheMu.Unlock()
+	return credentials, nil
+}
+
+func loadFromCredentialSource(source CredentialSource) (Credentials, error) {
+	switch source {
+	case SourceEnvironment:
+		return loadFromEnv()
+	case SourceEc2InstanceMetadata:
+		return loadFromIMDS()
+	case SourceEcsContainer:
+		return loadFromECSContainer()
+	default:
+		return Credentials{}, fmt.Errorf("Unknown credential source")
+	}
+}
+
+func callSTSAssumeRole(config *AssumeRoleConfig, sourceCreds Credentials, region string) (Credentials, time.Time, error) {
+	roleSessionName := "taws-session"
+	if config.RoleSessionName != nil {
+		roleSessionName = *config.RoleSessionName
+	}
+	durationSeconds := uint32(3600)
+	if config.DurationSeconds != nil {
+		durationSeconds = *config.DurationSeconds
+	}
+
+	stsEndpoint := os.Getenv("TAWS_STS_ENDPOINT")
+	if stsEndpoint == "" {
+		stsEndpoint = os.Getenv("AWS_ENDPOINT_URL")
+	}
+	if stsEndpoint == "" {
+		stsEndpoint = fmt.Sprintf("https://sts.%s.amazonaws.com", region)
+	}
+
+	params := [][2]string{
+		{"Action", "AssumeRole"},
+		{"Version", "2011-06-15"},
+		{"RoleArn", config.RoleArn},
+		{"RoleSessionName", roleSessionName},
+		{"DurationSeconds", strconv.FormatUint(uint64(durationSeconds), 10)},
+	}
+	if config.ExternalID != nil {
+		params = append(params, [2]string{"ExternalId", *config.ExternalID})
+	}
+	parts := make([]string, 0, len(params))
+	for _, kv := range params {
+		parts = append(parts, url.QueryEscape(kv[0])+"="+url.QueryEscape(kv[1]))
+	}
+	base := strings.TrimRight(stsEndpoint, "/")
+	rawurl := base + "/?" + strings.Join(parts, "&")
+
+	signingHeaders, err := SignV4("POST", rawurl, "", nil, sourceCreds, region, "sts", false)
+	if err != nil {
+		return Credentials{}, time.Time{}, err
+	}
+
+	client, _ := CreateBlockingClientWithTimeout(30 * time.Second)
+	req, err := http.NewRequest("POST", rawurl, nil)
+	if err != nil {
+		return Credentials{}, time.Time{}, err
+	}
+	for k, v := range signingHeaders {
+		req.Header.Set(k, v)
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return Credentials{}, time.Time{}, err
+	}
+	defer resp.Body.Close()
+	bodyBytes, _ := io.ReadAll(resp.Body)
+	text := string(bodyBytes)
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		errorMsg := parseSTSError(text)
+		if errorMsg == "" {
+			errorMsg = text
+		}
+		return Credentials{}, time.Time{}, fmt.Errorf("STS AssumeRole failed (%d): %s", resp.StatusCode, errorMsg)
+	}
+	return parseAssumeRoleResponse(text)
+}
+
+func parseSTSError(xmlData string) string {
+	codeStart := strings.Index(xmlData, "<Code>")
+	codeEnd := strings.Index(xmlData, "</Code>")
+	if codeStart < 0 || codeEnd < 0 {
+		return ""
+	}
+	msgStart := strings.Index(xmlData, "<Message>")
+	msgEnd := strings.Index(xmlData, "</Message>")
+	if msgStart < 0 || msgEnd < 0 {
+		return ""
+	}
+	code := xmlData[codeStart+len("<Code>") : codeEnd]
+	message := xmlData[msgStart+len("<Message>") : msgEnd]
+	return fmt.Sprintf("%s: %s", code, message)
+}
+
+func parseAssumeRoleResponse(xmlData string) (Credentials, time.Time, error) {
+	extractValue := func(tag string) (string, bool) {
+		startTag := "<" + tag + ">"
+		endTag := "</" + tag + ">"
+		start := strings.Index(xmlData, startTag)
+		if start < 0 {
+			return "", false
+		}
+		start += len(startTag)
+		end := strings.Index(xmlData, endTag)
+		if end < 0 || start >= end {
+			return "", false
+		}
+		return xmlData[start:end], true
+	}
+
+	accessKeyID, ok := extractValue("AccessKeyId")
+	if !ok {
+		return Credentials{}, time.Time{}, fmt.Errorf("AccessKeyId not found in AssumeRole response")
+	}
+	secretAccessKey, ok := extractValue("SecretAccessKey")
+	if !ok {
+		return Credentials{}, time.Time{}, fmt.Errorf("SecretAccessKey not found in AssumeRole response")
+	}
+	sessionToken, ok := extractValue("SessionToken")
+	if !ok {
+		return Credentials{}, time.Time{}, fmt.Errorf("SessionToken not found in AssumeRole response")
+	}
+	expirationStr, ok := extractValue("Expiration")
+	if !ok {
+		return Credentials{}, time.Time{}, fmt.Errorf("Expiration not found in AssumeRole response")
+	}
+	expiration := time.Now().Add(3600 * time.Second)
+	if parsed := parseExpiration(expirationStr); parsed != nil {
+		expiration = *parsed
+	}
+	return Credentials{AccessKeyID: accessKeyID, SecretAccessKey: secretAccessKey, SessionToken: &sessionToken}, expiration, nil
+}
+
+func loadFromIMDS() (Credentials, error) {
+	imdsCacheMu.Lock()
+	if imdsCache != nil && imdsCache.expiration.After(time.Now().Add(credentialRefreshBuf)) {
+		cached := *imdsCache
+		imdsCacheMu.Unlock()
+		return cached.credentials, nil
+	}
+	imdsCacheMu.Unlock()
+	return fetchIMDSCredentials()
+}
+
+func fetchIMDSCredentials() (Credentials, error) {
+	client := &httpClientTimeout{timeout: imdsTimeout}
+
+	tokenURL := imdsEndpoint + "/latest/api/token"
+	tokenResp, err := client.put(tokenURL, map[string]string{"X-aws-ec2-metadata-token-ttl-seconds": strconv.Itoa(imdsTokenTTL)})
+	if err != nil {
+		return Credentials{}, fmt.Errorf("Failed to get IMDS token (not running on EC2?): %v", err)
+	}
+	if tokenResp.status < 200 || tokenResp.status >= 300 {
+		return Credentials{}, fmt.Errorf("IMDS token request failed with status: %d", tokenResp.status)
+	}
+	token := string(tokenResp.body)
+
+	roleURL := imdsEndpoint + "/latest/meta-data/iam/security-credentials/"
+	roleResp, err := client.get(roleURL, map[string]string{"X-aws-ec2-metadata-token": token})
+	if err != nil {
+		return Credentials{}, fmt.Errorf("Failed to get IAM role: %v", err)
+	}
+	if roleResp.status < 200 || roleResp.status >= 300 {
+		return Credentials{}, fmt.Errorf("No IAM role attached to this EC2 instance (status: %d)", roleResp.status)
+	}
+	roleName := ""
+	for _, line := range strings.Split(string(roleResp.body), "\n") {
+		trimmed := strings.TrimSpace(line)
+		if trimmed != "" {
+			roleName = trimmed
+			break
+		}
+	}
+	if roleName == "" {
+		return Credentials{}, fmt.Errorf("No IAM role attached to this EC2 instance")
+	}
+
+	credsURL := imdsEndpoint + "/latest/meta-data/iam/security-credentials/" + roleName
+	credsResp, err := client.get(credsURL, map[string]string{"X-aws-ec2-metadata-token": token})
+	if err != nil {
+		return Credentials{}, fmt.Errorf("Failed to get credentials: %v", err)
+	}
+	if credsResp.status < 200 || credsResp.status >= 300 {
+		return Credentials{}, fmt.Errorf("Failed to get credentials for role '%s' (status: %d)", roleName, credsResp.status)
+	}
+	var credsJSON map[string]any
+	if err := json.Unmarshal(credsResp.body, &credsJSON); err != nil {
+		return Credentials{}, fmt.Errorf("Failed to parse credentials JSON: %v", err)
+	}
+	accessKeyID, ok := credsJSON["AccessKeyId"].(string)
+	if !ok {
+		return Credentials{}, fmt.Errorf("AccessKeyId not found in IMDS response")
+	}
+	secretAccessKey, ok := credsJSON["SecretAccessKey"].(string)
+	if !ok {
+		return Credentials{}, fmt.Errorf("SecretAccessKey not found in IMDS response")
+	}
+	var sessionToken *string
+	if v, ok := credsJSON["Token"].(string); ok {
+		sessionToken = &v
+	}
+	expiration := time.Now().Add(3600 * time.Second)
+	if expStr, ok := credsJSON["Expiration"].(string); ok {
+		if parsed := parseExpiration(expStr); parsed != nil {
+			expiration = *parsed
+		}
+	}
+	credentials := Credentials{AccessKeyID: accessKeyID, SecretAccessKey: secretAccessKey, SessionToken: sessionToken}
+
+	imdsCacheMu.Lock()
+	imdsCache = &cachedCreds{credentials: credentials, expiration: expiration}
+	imdsCacheMu.Unlock()
+	return credentials, nil
+}
+
+func parseExpiration(expStr string) *time.Time {
+	expirationTime, err := time.Parse(time.RFC3339, expStr)
+	if err != nil {
+		return nil
+	}
+	now := time.Now()
+	if !expirationTime.After(now) {
+		return nil
+	}
+	t := now.Add(expirationTime.Sub(now))
+	return &t
+}
+
+// IsIMDSAvailable checks whether the IMDSv2 endpoint responds.
+func IsIMDSAvailable() bool {
+	client := &httpClientTimeout{timeout: imdsTimeout}
+	tokenURL := imdsEndpoint + "/latest/api/token"
+	resp, err := client.put(tokenURL, map[string]string{"X-aws-ec2-metadata-token-ttl-seconds": "21600"})
+	if err != nil {
+		return false
+	}
+	return resp.status >= 200 && resp.status < 300
+}
+
+func loadFromECSContainer() (Credentials, error) {
+	ecsCacheMu.Lock()
+	if ecsCache != nil && ecsCache.expiration.After(time.Now().Add(credentialRefreshBuf)) {
+		cached := *ecsCache
+		ecsCacheMu.Unlock()
+		return cached.credentials, nil
+	}
+	ecsCacheMu.Unlock()
+
+	credentials, expiration, err := fetchECSContainerCredentials()
+	if err != nil {
+		return Credentials{}, err
+	}
+	ecsCacheMu.Lock()
+	ecsCache = &cachedCreds{credentials: credentials, expiration: expiration}
+	ecsCacheMu.Unlock()
+	return credentials, nil
+}
+
+func fetchECSContainerCredentials() (Credentials, time.Time, error) {
+	var rawurl string
+	var authToken *string
+	if fullURI := os.Getenv("AWS_CONTAINER_CREDENTIALS_FULL_URI"); fullURI != "" {
+		rawurl = fullURI
+		if v := os.Getenv("AWS_CONTAINER_AUTHORIZATION_TOKEN"); v != "" {
+			authToken = &v
+		}
+	} else if relativeURI := os.Getenv("AWS_CONTAINER_CREDENTIALS_RELATIVE_URI"); relativeURI != "" {
+		rawurl = ecsCredentialsEndpoint + relativeURI
+	} else {
+		return Credentials{}, time.Time{}, fmt.Errorf(
+			"ECS container credentials not available: neither AWS_CONTAINER_CREDENTIALS_FULL_URI nor AWS_CONTAINER_CREDENTIALS_RELATIVE_URI is set")
+	}
+
+	client := &httpClientTimeout{timeout: 5 * time.Second}
+	headers := map[string]string{}
+	if authToken != nil {
+		headers["Authorization"] = *authToken
+	}
+	resp, err := client.get(rawurl, headers)
+	if err != nil {
+		return Credentials{}, time.Time{}, fmt.Errorf("Failed to fetch ECS container credentials: %v", err)
+	}
+	if resp.status < 200 || resp.status >= 300 {
+		return Credentials{}, time.Time{}, fmt.Errorf("ECS container credentials request failed with status: %d", resp.status)
+	}
+	var credsJSON map[string]any
+	if err := json.Unmarshal(resp.body, &credsJSON); err != nil {
+		return Credentials{}, time.Time{}, fmt.Errorf("Failed to parse ECS credentials JSON: %v", err)
+	}
+	accessKeyID, ok := credsJSON["AccessKeyId"].(string)
+	if !ok {
+		return Credentials{}, time.Time{}, fmt.Errorf("AccessKeyId not found in ECS credentials response")
+	}
+	secretAccessKey, ok := credsJSON["SecretAccessKey"].(string)
+	if !ok {
+		return Credentials{}, time.Time{}, fmt.Errorf("SecretAccessKey not found in ECS credentials response")
+	}
+	var sessionToken *string
+	if v, ok := credsJSON["Token"].(string); ok {
+		sessionToken = &v
+	}
+	expiration := time.Now().Add(3600 * time.Second)
+	if expStr, ok := credsJSON["Expiration"].(string); ok {
+		if parsed := parseExpiration(expStr); parsed != nil {
+			expiration = *parsed
+		}
+	}
+	return Credentials{AccessKeyID: accessKeyID, SecretAccessKey: secretAccessKey, SessionToken: sessionToken}, expiration, nil
+}
+
+// ListProfilesInFiles lists profiles parsed from the credentials and config files.
+func ListProfilesInFiles() []string {
+	seen := map[string]bool{}
+	configDir, err := AwsConfigDir()
+	if err != nil {
+		return []string{}
+	}
+	if data, err := os.ReadFile(filepath.Join(configDir, "credentials")); err == nil {
+		for key := range ParseINIFile(string(data)) {
+			seen[key] = true
+		}
+	}
+	if data, err := os.ReadFile(filepath.Join(configDir, "config")); err == nil {
+		for key := range ParseINIFile(string(data)) {
+			seen[key] = true
+		}
+	}
+	profiles := make([]string, 0, len(seen))
+	for key := range seen {
+		profiles = append(profiles, key)
+	}
+	sort.Strings(profiles)
+	return profiles
+}
