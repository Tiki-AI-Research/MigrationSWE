@@ -0,0 +1,725 @@
+package resource
+
+import (
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/huseyinbabal/taws/internal/aws"
+)
+
+// ReadOnly, when set, prevents mutating actions from being sent to AWS.
+var ReadOnly bool
+
+// SetReadOnly updates the global read-only mode.
+func SetReadOnly(readonly bool) {
+	ReadOnly = readonly
+}
+
+// ExtractParam extracts a single string parameter from a params map.
+func ExtractParam(params any, key string) string {
+	m, ok := params.(map[string]any)
+	if !ok {
+		return ""
+	}
+	v, ok := m[key]
+	if !ok {
+		return ""
+	}
+	switch val := v.(type) {
+	case string:
+		return val
+	case []any:
+		if len(val) > 0 {
+			if s, ok := val[0].(string); ok {
+				return s
+			}
+		}
+	}
+	return ""
+}
+
+func formatBytes(bytes uint64) string {
+	const (
+		kb = uint64(1024)
+		mb = kb * 1024
+		gb = mb * 1024
+		tb = gb * 1024
+	)
+	switch {
+	case bytes >= tb:
+		return fmt.Sprintf("%.1f TB", float64(bytes)/float64(tb))
+	case bytes >= gb:
+		return fmt.Sprintf("%.1f GB", float64(bytes)/float64(gb))
+	case bytes >= mb:
+		return fmt.Sprintf("%.1f MB", float64(bytes)/float64(mb))
+	case bytes >= kb:
+		return fmt.Sprintf("%.1f KB", float64(bytes)/float64(kb))
+	default:
+		return fmt.Sprintf("%d B", bytes)
+	}
+}
+
+func formatEpochMillis(millis int64) string {
+	if millis <= 0 {
+		return "-"
+	}
+	return time.UnixMilli(millis).UTC().Format("2006-01-02 15:04:05")
+}
+
+// FormatLogTimestamp formats an epoch-millis timestamp for display.
+func FormatLogTimestamp(millis int64) string {
+	return formatEpochMillis(millis)
+}
+
+// ResolveStaticParamTemplate replaces {resource_id} and {timestamp} placeholders.
+func ResolveStaticParamTemplate(template, resourceID, timestamp string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(template, "{resource_id}", resourceID), "{timestamp}", timestamp)
+}
+
+// InvokeList invokes a list API using JSON configuration.
+func InvokeList(resourceKey string, clients *aws.AwsClients, params any) (any, error) {
+	resourceDef := GetResource(resourceKey)
+	if resourceDef == nil {
+		return nil, fmt.Errorf("Unknown resource: %s", resourceKey)
+	}
+	if resourceDef.APIConfig == nil {
+		return nil, fmt.Errorf("Resource %s does not have api_config", resourceKey)
+	}
+	apiConfig := resourceDef.APIConfig
+	handler := GetProtocolHandler(apiConfig.Protocol)
+
+	service := resourceDef.Service
+	if apiConfig.ServiceName != nil {
+		service = *apiConfig.ServiceName
+	}
+
+	parsed, err := handler.Invoke(clients, service, apiConfig, params, resourceDef.FieldMappings)
+	if err != nil {
+		return nil, err
+	}
+	return BuildResponse(parsed.Items, resourceDef.ResponsePath, parsed.NextToken), nil
+}
+
+// InvokeSDK handles legacy/special-case list operations.
+func InvokeSDK(service, method string, clients *aws.AwsClients, params any) (any, error) {
+	switch service + "/" + method {
+	case "s3/list_objects_v2":
+		bucket := ExtractParam(params, "bucket_names")
+		if bucket == "" {
+			return nil, fmt.Errorf("Bucket name required")
+		}
+		prefix := ""
+		if m, ok := params.(map[string]any); ok {
+			switch v := m["prefix"].(type) {
+			case string:
+				prefix = v
+			case []any:
+				if len(v) > 0 {
+					prefix, _ = v[0].(string)
+				}
+			}
+		}
+
+		bucketRegion, err := clients.HTTP.GetBucketRegion(bucket)
+		if err != nil {
+			return nil, err
+		}
+
+		path := "?list-type=2&delimiter=/"
+		if prefix != "" {
+			path = "?list-type=2&delimiter=/&prefix=" + awsPercentEncode(prefix)
+		}
+
+		xmlStr, err := clients.HTTP.RESTXMLRequestS3Bucket("GET", bucket, path, nil, bucketRegion)
+		if err != nil {
+			return nil, err
+		}
+		jsonVal, err := aws.XMLToJSON(xmlStr)
+		if err != nil {
+			return nil, err
+		}
+
+		objects := []any{}
+
+		if prefixes, ok := jsonPointer(jsonVal, "/ListBucketResult/CommonPrefixes"); ok {
+			for _, p := range asSlice(prefixes) {
+				prefixVal := ""
+				if s, ok := jsonPointer(p, "/Prefix"); ok {
+					prefixVal, _ = s.(string)
+				}
+				displayName := prefixVal
+				if trimmed := strings.TrimRight(prefixVal, "/"); trimmed != "" {
+					parts := strings.Split(trimmed, "/")
+					displayName = parts[len(parts)-1]
+				}
+				objects = append(objects, map[string]any{
+					"Key":          prefixVal,
+					"DisplayName":  displayName + "/",
+					"Size":         "-",
+					"LastModified": "-",
+					"StorageClass": "FOLDER",
+					"IsFolder":     true,
+				})
+			}
+		}
+
+		if contents, ok := jsonPointer(jsonVal, "/ListBucketResult/Contents"); ok {
+			for _, obj := range asSlice(contents) {
+				keyVal, _ := jsonPointer(obj, "/Key")
+				key, _ := keyVal.(string)
+				if key == prefix {
+					continue
+				}
+				parts := strings.Split(key, "/")
+				displayName := parts[len(parts)-1]
+				sizeVal, _ := jsonPointer(obj, "/Size")
+				sizeStr, _ := sizeVal.(string)
+				sizeNum, _ := strconv.ParseUint(sizeStr, 10, 64)
+				lastModified, _ := jsonPointer(obj, "/LastModified")
+				lastModifiedStr, _ := lastModified.(string)
+				storageClass, _ := jsonPointer(obj, "/StorageClass")
+				storageClassStr, _ := storageClass.(string)
+				if storageClassStr == "" {
+					storageClassStr = "STANDARD"
+				}
+				objects = append(objects, map[string]any{
+					"Key":          key,
+					"DisplayName":  displayName,
+					"Size":         formatBytes(sizeNum),
+					"LastModified": lastModifiedStr,
+					"StorageClass": storageClassStr,
+					"IsFolder":     false,
+				})
+			}
+		}
+
+		return map[string]any{"objects": objects}, nil
+
+	case "sts/get_caller_identity":
+		xmlStr, err := clients.HTTP.QueryRequest("sts", "GetCallerIdentity", nil)
+		if err != nil {
+			return nil, err
+		}
+		jsonVal, err := aws.XMLToJSON(xmlStr)
+		if err != nil {
+			return nil, err
+		}
+		account := "-"
+		userID := "-"
+		arn := "-"
+		if result, ok := jsonPointer(jsonVal, "/GetCallerIdentityResponse/GetCallerIdentityResult"); ok {
+			if v, ok := jsonPointer(result, "/Account"); ok {
+				if s, ok := v.(string); ok {
+					account = s
+				}
+			}
+			if v, ok := jsonPointer(result, "/UserId"); ok {
+				if s, ok := v.(string); ok {
+					userID = s
+				}
+			}
+			if v, ok := jsonPointer(result, "/Arn"); ok {
+				if s, ok := v.(string); ok {
+					arn = s
+				}
+			}
+		}
+		return map[string]any{"identity": []any{map[string]any{"Account": account, "UserId": userID, "Arn": arn}}}, nil
+
+	case "cloudwatchlogs/tail_logs":
+		logGroup := ExtractParam(params, "log_group_name")
+		logStream := ExtractParam(params, "log_stream_name")
+		if logGroup == "" || logStream == "" {
+			return nil, fmt.Errorf("Log group and stream names required")
+		}
+		requestBody := map[string]any{
+			"logGroupName":  logGroup,
+			"logStreamName": logStream,
+			"startFromHead": false,
+			"limit":         100,
+		}
+		bodyStr, _ := marshalJSON(requestBody)
+		response, err := clients.HTTP.JSONRequest("logs", "GetLogEvents", bodyStr)
+		if err != nil {
+			return nil, err
+		}
+		jsonVal, err := parseJSON(response)
+		if err != nil {
+			return nil, err
+		}
+		events, _ := jsonPointer(jsonVal, "/events")
+		result := []any{}
+		for _, e := range asSlice(events) {
+			tsVal, _ := jsonPointer(e, "/timestamp")
+			ts := int64(0)
+			switch v := tsVal.(type) {
+			case float64:
+				ts = int64(v)
+			case string:
+				ts, _ = strconv.ParseInt(v, 10, 64)
+			}
+			msgVal, _ := jsonPointer(e, "/message")
+			msg, _ := msgVal.(string)
+			if msg == "" {
+				msg = "-"
+			}
+			result = append(result, map[string]any{"timestamp": formatEpochMillis(ts), "message": msg})
+		}
+		return map[string]any{"events": result}, nil
+
+	case "cloudwatchlogs/get_log_events":
+		logGroup := ExtractParam(params, "log_group_name")
+		logStream := ExtractParam(params, "log_stream_name")
+		if logGroup == "" || logStream == "" {
+			return nil, fmt.Errorf("Log group and stream names required")
+		}
+		request := map[string]any{
+			"logGroupName":  logGroup,
+			"logStreamName": logStream,
+			"startFromHead": false,
+			"limit":         100,
+		}
+		if m, ok := params.(map[string]any); ok {
+			if token, ok := m["next_forward_token"].(string); ok {
+				request["nextToken"] = token
+			}
+		}
+		bodyStr, _ := marshalJSON(request)
+		response, err := clients.HTTP.JSONRequest("logs", "GetLogEvents", bodyStr)
+		if err != nil {
+			return nil, err
+		}
+		return parseJSON(response)
+	default:
+		return nil, fmt.Errorf("Operation not handled: service='%s', method='%s'. Configure it in the resource JSON.", service, method)
+	}
+}
+
+// ExecuteAction executes a write action on a resource.
+func ExecuteAction(service, action string, clients *aws.AwsClients, resourceID string) error {
+	if ReadOnly {
+		return fmt.Errorf("This operation is not supported in read-only mode")
+	}
+	resourceKey, _ := findResourceWithAction(service, action)
+	if resourceKey == "" {
+		return fmt.Errorf("Action '%s' not configured for service '%s'. Add action_configs to the resource JSON.", action, service)
+	}
+	return invokeAction(resourceKey, action, clients, resourceID)
+}
+
+// ExecuteActionWithResult executes an action that returns displayable data.
+func ExecuteActionWithResult(service, action string, clients *aws.AwsClients, resourceID string) (any, error) {
+	switch service + "/" + action {
+	case "secretsmanager/get_secret_value":
+		body, _ := marshalJSON(map[string]any{"SecretId": resourceID})
+		response, err := clients.HTTP.JSONRequest("secretsmanager", "GetSecretValue", body)
+		if err != nil {
+			return nil, err
+		}
+		return parseJSON(response)
+
+	case "ssm/get_parameter":
+		body, _ := marshalJSON(map[string]any{"Name": resourceID, "WithDecryption": true})
+		response, err := clients.HTTP.JSONRequest("ssm", "GetParameter", body)
+		if err != nil {
+			return nil, err
+		}
+		return parseJSON(response)
+
+	default:
+		return nil, fmt.Errorf("Unknown action with result: %s.%s", service, action)
+	}
+}
+
+func findResourceWithAction(service, actionID string) (string, *ResourceDef) {
+	for key, resource := range GetRegistry().Resources {
+		if resource.Service == service {
+			if _, ok := resource.ActionConfigs[actionID]; ok {
+				return key, resource
+			}
+		}
+	}
+	return "", nil
+}
+
+func invokeAction(resourceKey, actionID string, clients *aws.AwsClients, resourceID string) error {
+	resourceDef := GetResource(resourceKey)
+	if resourceDef == nil {
+		return fmt.Errorf("Unknown resource: %s", resourceKey)
+	}
+	actionConfig, ok := resourceDef.ActionConfigs[actionID]
+	if !ok {
+		return fmt.Errorf("Action '%s' not configured for %s", actionID, resourceKey)
+	}
+	service := resourceDef.Service
+	if actionConfig.ServiceName != nil {
+		service = *actionConfig.ServiceName
+	}
+
+	switch actionConfig.Protocol.effective() {
+	case ProtocolQuery:
+		if actionConfig.Action == nil {
+			return fmt.Errorf("Query action requires 'action' field")
+		}
+		paramsOwned := [][2]string{}
+		if actionConfig.SpecialHandling != nil && *actionConfig.SpecialHandling == "parse_pipe_format_tg_target" {
+			parts := strings.Split(resourceID, "|")
+			if len(parts) != 2 {
+				return fmt.Errorf("Invalid target format, expected target_group_arn|target_id")
+			}
+			paramsOwned = append(paramsOwned, [2]string{"TargetGroupArn", parts[0]})
+			paramsOwned = append(paramsOwned, [2]string{"Targets.member.1.Id", parts[1]})
+		} else if actionConfig.IDParam != nil {
+			paramsOwned = append(paramsOwned, [2]string{*actionConfig.IDParam, resourceID})
+		}
+
+		currentTimestamp := time.Now().UTC().Format("20060102T150405")
+		for key, value := range actionConfig.StaticParams {
+			if template, ok := value.(string); ok {
+				paramsOwned = append(paramsOwned, [2]string{key, ResolveStaticParamTemplate(template, resourceID, currentTimestamp)})
+			}
+		}
+		_, err := clients.HTTP.QueryRequest(service, *actionConfig.Action, paramsOwned)
+		return err
+
+	case ProtocolJSON:
+		if actionConfig.Action == nil {
+			return fmt.Errorf("JSON action requires 'action' field")
+		}
+		var body string
+		if actionConfig.BodyTemplate != nil {
+			actualID := resourceID
+			if actionConfig.SpecialHandling != nil && *actionConfig.SpecialHandling == "parse_arn_for_cluster" {
+				parts := strings.Split(resourceID, "/")
+				if len(parts) >= 2 {
+					actualID = parts[len(parts)-2]
+				}
+			}
+			cluster := resourceID
+			parts := strings.Split(resourceID, "/")
+			if len(parts) >= 2 {
+				cluster = parts[len(parts)-2]
+			}
+			body = strings.ReplaceAll(strings.ReplaceAll(*actionConfig.BodyTemplate, "{resource_id}", actualID), "{cluster}", cluster)
+		} else {
+			idParam := "id"
+			if actionConfig.IDParam != nil {
+				idParam = *actionConfig.IDParam
+			}
+			body, _ = marshalJSON(map[string]any{idParam: resourceID})
+		}
+		_, err := clients.HTTP.JSONRequest(service, *actionConfig.Action, body)
+		return err
+
+	case ProtocolRestJSON:
+		method := "DELETE"
+		if actionConfig.Method != nil {
+			method = *actionConfig.Method
+		}
+		if actionConfig.Path == nil {
+			return fmt.Errorf("REST-JSON action requires 'path' field")
+		}
+		path := strings.ReplaceAll(*actionConfig.Path, "{resource_id}", resourceID)
+		var body *string
+		if actionConfig.BodyTemplate != nil {
+			body = actionConfig.BodyTemplate
+		}
+		_, err := clients.HTTP.RESTJSONRequest(service, method, path, body)
+		return err
+
+	case ProtocolRestXML:
+		method := "DELETE"
+		if actionConfig.Method != nil {
+			method = *actionConfig.Method
+		}
+		if actionConfig.Path == nil {
+			return fmt.Errorf("REST-XML action requires 'path' field")
+		}
+		path := strings.ReplaceAll(*actionConfig.Path, "{resource_id}", resourceID)
+		_, err := clients.HTTP.RESTXMLRequest(service, method, path, nil)
+		return err
+	}
+	return fmt.Errorf("Unsupported action protocol")
+}
+
+// DescribeResource fetches full details for a single resource.
+func DescribeResource(resourceKey string, clients *aws.AwsClients, resourceID string) (any, error) {
+	if resourceKey == "s3-buckets" {
+		return describeS3Bucket(clients, resourceID)
+	}
+	resource := GetResource(resourceKey)
+	if resource == nil {
+		return nil, fmt.Errorf("Unknown resource: %s", resourceKey)
+	}
+	if resource.DescribeConfig == nil {
+		return nil, fmt.Errorf("Describe not configured for '%s'. Add describe_config to the resource JSON.", resourceKey)
+	}
+	return invokeDescribe(resourceKey, clients, resourceID)
+}
+
+func invokeDescribe(resourceKey string, clients *aws.AwsClients, resourceID string) (any, error) {
+	resourceDef := GetResource(resourceKey)
+	describeConfig := resourceDef.DescribeConfig
+	service := resourceDef.Service
+	if describeConfig.ServiceName != nil {
+		service = *describeConfig.ServiceName
+	}
+
+	var result any
+	var err error
+
+	switch describeConfig.Protocol.effective() {
+	case ProtocolQuery:
+		if describeConfig.Action == nil {
+			return nil, fmt.Errorf("Query describe requires 'action' field")
+		}
+		idParam := "Id"
+		if describeConfig.IDParam != nil {
+			idParam = *describeConfig.IDParam
+		}
+		var xmlStr string
+		xmlStr, err = clients.HTTP.QueryRequest(service, *describeConfig.Action, [][2]string{{idParam, resourceID}})
+		if err != nil {
+			return nil, err
+		}
+		jsonVal, jerr := aws.XMLToJSON(xmlStr)
+		if jerr != nil {
+			return nil, jerr
+		}
+		if describeConfig.ResponsePath != nil {
+			result, err = extractSingleItem(jsonVal, *describeConfig.ResponsePath)
+			if err != nil {
+				return nil, err
+			}
+		} else {
+			result = jsonVal
+		}
+
+	case ProtocolJSON:
+		if describeConfig.Action == nil {
+			return nil, fmt.Errorf("JSON describe requires 'action' field")
+		}
+		var body string
+		if describeConfig.BodyTemplate != nil {
+			body = strings.ReplaceAll(*describeConfig.BodyTemplate, "{resource_id}", resourceID)
+		} else {
+			idParam := "id"
+			if describeConfig.IDParam != nil {
+				idParam = *describeConfig.IDParam
+			}
+			body, _ = marshalJSON(map[string]any{idParam: resourceID})
+		}
+		var response string
+		response, err = clients.HTTP.JSONRequest(service, *describeConfig.Action, body)
+		if err != nil {
+			return nil, err
+		}
+		jsonVal, jerr := parseJSON(response)
+		if jerr != nil {
+			return nil, jerr
+		}
+		if describeConfig.ResponsePath != nil {
+			if v, ok := jsonPointer(jsonVal, *describeConfig.ResponsePath); ok {
+				result = v
+			} else {
+				result = jsonVal
+			}
+		} else {
+			result = jsonVal
+		}
+
+	case ProtocolRestJSON:
+		method := "GET"
+		if describeConfig.Method != nil {
+			method = *describeConfig.Method
+		}
+		if describeConfig.Path == nil {
+			return nil, fmt.Errorf("REST-JSON describe requires 'path' field")
+		}
+		path := strings.ReplaceAll(*describeConfig.Path, "{resource_id}", resourceID)
+		var response string
+		response, err = clients.HTTP.RESTJSONRequest(service, method, path, nil)
+		if err != nil {
+			return nil, err
+		}
+		jsonVal, jerr := parseJSON(response)
+		if jerr != nil {
+			return nil, jerr
+		}
+		if describeConfig.ResponsePath != nil {
+			if v, ok := jsonPointer(jsonVal, *describeConfig.ResponsePath); ok {
+				result = v
+			} else {
+				result = jsonVal
+			}
+		} else {
+			result = jsonVal
+		}
+
+	case ProtocolRestXML:
+		method := "GET"
+		if describeConfig.Method != nil {
+			method = *describeConfig.Method
+		}
+		if describeConfig.Path == nil {
+			return nil, fmt.Errorf("REST-XML describe requires 'path' field")
+		}
+		path := strings.ReplaceAll(*describeConfig.Path, "{resource_id}", resourceID)
+		var xmlStr string
+		xmlStr, err = clients.HTTP.RESTXMLRequest(service, method, path, nil)
+		if err != nil {
+			return nil, err
+		}
+		jsonVal, jerr := aws.XMLToJSON(xmlStr)
+		if jerr != nil {
+			return nil, jerr
+		}
+		if describeConfig.ResponsePath != nil {
+			if v, ok := jsonPointer(jsonVal, *describeConfig.ResponsePath); ok {
+				result = v
+			} else {
+				result = jsonVal
+			}
+		} else {
+			result = jsonVal
+		}
+	}
+
+	for _, enrich := range describeConfig.EnrichCalls {
+		value, eerr := executeEnrichCall(clients, service, resourceID, enrich, describeConfig.Protocol)
+		if eerr == nil {
+			if m, ok := result.(map[string]any); ok {
+				m[enrich.ResultField] = value
+			}
+		} else if enrich.DefaultValue != nil {
+			if m, ok := result.(map[string]any); ok {
+				m[enrich.ResultField] = *enrich.DefaultValue
+			}
+		}
+	}
+
+	return result, nil
+}
+
+func executeEnrichCall(clients *aws.AwsClients, service, resourceID string, enrich EnrichCall, _ APIProtocol) (any, error) {
+	if enrich.Path == nil {
+		return nil, fmt.Errorf("Enrich call requires path")
+	}
+	path := strings.ReplaceAll(*enrich.Path, "{resource_id}", resourceID)
+	method := "GET"
+	if enrich.Method != nil {
+		method = *enrich.Method
+	}
+	xmlStr, err := clients.HTTP.RESTXMLRequest(service, method, path, nil)
+	if err != nil {
+		return nil, err
+	}
+	jsonVal, err := aws.XMLToJSON(xmlStr)
+	if err != nil {
+		return nil, err
+	}
+	if enrich.ExtractPath != nil {
+		if v, ok := jsonPointer(jsonVal, *enrich.ExtractPath); ok {
+			return v, nil
+		}
+		return nil, nil
+	}
+	return jsonVal, nil
+}
+
+func extractSingleItem(jsonVal any, path string) (any, error) {
+	value, ok := jsonPointer(jsonVal, path)
+	if !ok {
+		return nil, fmt.Errorf("Response path not found: %s", path)
+	}
+	switch v := value.(type) {
+	case []any:
+		if len(v) == 0 {
+			return nil, fmt.Errorf("Empty response")
+		}
+		return v[0], nil
+	default:
+		return value, nil
+	}
+}
+
+func describeS3Bucket(clients *aws.AwsClients, bucketName string) (any, error) {
+	result := map[string]any{"BucketName": bucketName}
+
+	bucketRegion, err := clients.HTTP.GetBucketRegion(bucketName)
+	if err != nil {
+		bucketRegion = "us-east-1"
+	}
+	result["Region"] = bucketRegion
+
+	if xmlStr, err := clients.HTTP.RESTXMLRequestS3Bucket("GET", bucketName, "?versioning", nil, bucketRegion); err == nil {
+		if jsonVal, err := aws.XMLToJSON(xmlStr); err == nil {
+			status := "Disabled"
+			if v, ok := jsonPointer(jsonVal, "/VersioningConfiguration/Status"); ok {
+				if s, ok := v.(string); ok {
+					status = s
+				}
+			}
+			result["Versioning"] = status
+		}
+	}
+
+	if xmlStr, err := clients.HTTP.RESTXMLRequestS3Bucket("GET", bucketName, "?encryption", nil, bucketRegion); err == nil {
+		if jsonVal, err := aws.XMLToJSON(xmlStr); err == nil {
+			if rules, ok := jsonPointer(jsonVal, "/ServerSideEncryptionConfiguration/Rule"); ok {
+				result["Encryption"] = rules
+			}
+		}
+	} else {
+		result["Encryption"] = "None"
+	}
+
+	return result, nil
+}
+
+func awsPercentEncode(s string) string {
+	return strings.ReplaceAll(url.QueryEscape(s), "+", "%20")
+}
+
+func asSlice(v any) []any {
+	if arr, ok := v.([]any); ok {
+		return arr
+	}
+	if v == nil {
+		return []any{}
+	}
+	return []any{v}
+}
+
+func jsonPointer(jsonVal any, pointer string) (any, bool) {
+	if pointer == "" {
+		return jsonVal, true
+	}
+	parts := strings.Split(strings.TrimPrefix(pointer, "/"), "/")
+	current := jsonVal
+	for _, part := range parts {
+		if part == "" {
+			continue
+		}
+		switch v := current.(type) {
+		case map[string]any:
+			next, ok := v[part]
+			if !ok {
+				return nil, false
+			}
+			current = next
+		case []any:
+			idx, err := strconv.Atoi(part)
+			if err != nil || idx < 0 || idx >= len(v) {
+				return nil, false
+			}
+			current = v[idx]
+		default:
+			return nil, false
+		}
+	}
+	return current, true
+}
