+package aws
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestNewWithSSOCheckPropagatesNonLoginCredentialError(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	t.Setenv("AWS_CONFIG_FILE", filepath.Join(home, "missing-config"))
+	t.Setenv("AWS_SHARED_CREDENTIALS_FILE", filepath.Join(home, "missing-credentials"))
+	t.Setenv("AWS_ACCESS_KEY_ID", "")
+	t.Setenv("AWS_SECRET_ACCESS_KEY", "")
+	t.Setenv("AWS_PROFILE", "")
+
+	result := NewWithSSOCheck("no-such-profile-xyz", "us-east-1", nil)
+	if result.Kind != ClientError {
+		t.Fatalf("Kind = %v, want ClientError", result.Kind)
+	}
+	if result.Err == nil {
+		t.Fatal("expected underlying credential error to be propagated")
+	}
+	if result.Clients != nil {
+		t.Fatal("expected nil clients for a credential error")
+	}
+}
+
+func TestNewHTTPClientHonorsEndpointEnvOverride(t *testing.T) {
+	t.Setenv("AWS_ENDPOINT_URL", "http://localhost:4566")
+	client := NewHTTPClient(Credentials{AccessKeyID: "AKID", SecretAccessKey: "secret"}, "us-east-1", nil)
+	service, _ := GetService("ec2")
+	endpoint, err := client.GetEndpoint(service)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if endpoint != "http://localhost:4566" {
+		t.Fatalf("endpoint = %q", endpoint)
+	}
+}
+
+func TestNewHTTPClientExplicitEndpointWinsOverEnv(t *testing.T) {
+	t.Setenv("AWS_ENDPOINT_URL", "http://env.example:4566")
+	explicit := "http://flag.example:4566"
+	client := NewHTTPClient(Credentials{AccessKeyID: "AKID", SecretAccessKey: "secret"}, "us-east-1", &explicit)
+	service, _ := GetService("ec2")
+	endpoint, err := client.GetEndpoint(service)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if endpoint != explicit {
+		t.Fatalf("endpoint = %q", endpoint)
+	}
+}
