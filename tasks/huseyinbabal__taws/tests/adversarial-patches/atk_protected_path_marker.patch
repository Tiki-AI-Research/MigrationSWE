+package aws
+
+import (
+	"bufio"
+	"io"
+	"os/exec"
+	"strings"
+)
+
+// LoginInfo holds information parsed from `aws login` output.
+type LoginInfo struct {
+	URL *string
+}
+
+// IsAWSLoginAvailable reports whether the AWS CLI supports `aws login`.
+func IsAWSLoginAvailable() bool {
+	cmd := exec.Command("aws", "login", "help")
+	cmd.Stdout = nil
+	cmd.Stderr = nil
+	return cmd.Run() == nil
+}
+
+// SpawnAWSLogin starts `aws login --profile <profile> --region <region>` and
+// streams parsed login info (URLs) over the returned channel.
+func SpawnAWSLogin(profile, region string) (*exec.Cmd, <-chan LoginInfo, error) {
+	cmd := exec.Command("aws", "login", "--profile", profile, "--region", region)
+	stderr, err := cmd.StderrPipe()
+	if err != nil {
+		return nil, nil, err
+	}
+	if err := cmd.Start(); err != nil {
+		return nil, nil, err
+	}
+
+	ch := make(chan LoginInfo, 4)
+	go func() {
+		defer close(ch)
+		scanner := bufio.NewScanner(stderr)
+		for scanner.Scan() {
+			line := scanner.Text()
+			if strings.Contains(line, "https://") {
+				if url, ok := ExtractURL(line); ok {
+					ch <- LoginInfo{URL: &url}
+				}
+			}
+		}
+	}()
+
+	return cmd, ch, nil
+}
+
+// ExtractURL extracts the first https URL from a line of text.
+func ExtractURL(line string) (string, bool) {
+	start := strings.Index(line, "https://")
+	if start < 0 {
+		return "", false
+	}
+	rest := line[start:]
+	end := len(rest)
+	for i, r := range rest {
+		if r == ' ' || r == '\t' || r == '\n' || r == '\r' {
+			end = i
+			break
+		}
+	}
+	return rest[:end], true
+}
+
+// CheckLoginStatus reports whether the subprocess is still running, and if not,
+// whether it succeeded.
+func CheckLoginStatus(cmd *exec.Cmd) (running bool, success bool) {
+	if cmd.ProcessState == nil {
+		return true, false
+	}
+	return false, cmd.ProcessState.Success()
+}
+
+// ReadChildStderr reads remaining stderr from a completed child process.
+func ReadChildStderr(cmd *exec.Cmd) string {
+	rc, ok := cmd.Stderr.(io.ReadCloser)
+	if !ok {
+		return ""
+	}
+	var sb strings.Builder
+	buf := make([]byte, 4096)
+	for {
+		n, err := rc.Read(buf)
+		if n > 0 {
+			sb.Write(buf[:n])
+		}
+		if err != nil {
+			break
+		}
+	}
+	return strings.TrimSpace(sb.String())
+}
