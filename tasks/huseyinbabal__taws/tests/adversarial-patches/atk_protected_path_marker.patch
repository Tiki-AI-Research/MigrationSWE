diff --git a/internal/resource/path_extractor.go b/internal/resource/path_extractor.go
new file mode 100644
index 0000000..1dda71a
--- /dev/null
+++ b/internal/resource/path_extractor.go
@@ -0,0 +1,171 @@
+package resource
+
+import (
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// ExtractByPath extracts a value from JSON using a slash-separated path with
+// array flattening, mirroring the baseline path extractor.
+func ExtractByPath(jsonVal any, path string) any {
+	if path == "" || path == "/" {
+		return jsonVal
+	}
+	raw := strings.Split(strings.TrimPrefix(path, "/"), "/")
+	parts := make([]string, 0, len(raw))
+	for _, p := range raw {
+		if p != "" {
+			parts = append(parts, p)
+		}
+	}
+	return extractByParts(jsonVal, parts)
+}
+
+func extractByParts(jsonVal any, parts []string) any {
+	if len(parts) == 0 {
+		return jsonVal
+	}
+	part := parts[0]
+	remaining := parts[1:]
+
+	switch v := jsonVal.(type) {
+	case map[string]any:
+		if child, ok := v[part]; ok {
+			return extractByParts(child, remaining)
+		}
+		return nil
+	case []any:
+		results := make([]any, 0, len(v))
+		for _, item := range v {
+			r := extractByParts(item, parts)
+			if r != nil {
+				results = append(results, r)
+			}
+		}
+		if len(results) == 0 {
+			return nil
+		}
+		if len(results) == 1 {
+			return results[0]
+		}
+		return results
+	default:
+		return nil
+	}
+}
+
+// ExtractList extracts a list of items from JSON, wrapping a single object in a
+// one-element slice (matching the XML-to-JSON quirk).
+func ExtractList(jsonVal any, path string) []any {
+	extracted := ExtractByPath(jsonVal, path)
+	switch v := extracted.(type) {
+	case []any:
+		return v
+	case map[string]any:
+		return []any{v}
+	case nil:
+		return []any{}
+	default:
+		return []any{v}
+	}
+}
+
+// ExtractString extracts a string with a default.
+func ExtractString(jsonVal any, path, def string) string {
+	return ValueToString(ExtractByPath(jsonVal, path), def)
+}
+
+// ValueToString converts a JSON value to a string representation.
+func ValueToString(value any, def string) string {
+	switch v := value.(type) {
+	case string:
+		return v
+	case json.Number:
+		return v.String()
+	case float64:
+		return strconv.FormatFloat(v, 'f', -1, 64)
+	case int:
+		return strconv.Itoa(v)
+	case int64:
+		return strconv.FormatInt(v, 10)
+	case bool:
+		if v {
+			return "Yes"
+		}
+		return "No"
+	case nil:
+		return def
+	case []any:
+		parts := make([]string, 0, len(v))
+		for _, item := range v {
+			parts = append(parts, ValueToString(item, def))
+		}
+		return strings.Join(parts, ", ")
+	case map[string]any:
+		return def
+	default:
+		return fmt.Sprintf("%v", v)
+	}
+}
+
+// ExtractAWSList navigates common AWS response structures.
+func ExtractAWSList(jsonVal any, responseWrapper *string, listKey, itemKey string) []any {
+	current := jsonVal
+	if responseWrapper != nil {
+		if inner, ok := navigateResponseWrapper(current); ok {
+			current = inner
+		}
+	}
+	if list, ok := indexAny(current, listKey); ok {
+		current = list
+	} else {
+		return []any{}
+	}
+	if items, ok := indexAny(current, itemKey); ok {
+		switch v := items.(type) {
+		case []any:
+			return v
+		case map[string]any:
+			return []any{v}
+		default:
+			return []any{}
+		}
+	}
+	switch v := current.(type) {
+	case []any:
+		return v
+	case map[string]any:
+		return []any{v}
+	default:
+		return []any{}
+	}
+}
+
+func navigateResponseWrapper(jsonVal any) (any, bool) {
+	m, ok := jsonVal.(map[string]any)
+	if !ok {
+		return nil, false
+	}
+	for _, responseValue := range m {
+		if inner, ok := responseValue.(map[string]any); ok {
+			for key, value := range inner {
+				if strings.HasSuffix(key, "Result") {
+					return value, true
+				}
+			}
+			return responseValue, true
+		}
+	}
+	return nil, false
+}
+
+func indexAny(jsonVal any, key string) (any, bool) {
+	m, ok := jsonVal.(map[string]any)
+	if !ok {
+		return nil, false
+	}
+	v, ok := m[key]
+	return v, ok
+}
