+package completion
+
+// Hidden target-side probe authored by BATCH-F2P-0003.
+
+import (
+	"strings"
+	"testing"
+)
+
+// F2P-059 / R035: Generate produces the Rust-style dynamic completion script
+// and falls back to the default script for unrecognized shells.
+func TestProbeF2P059CompletionGenerate(t *testing.T) {
+	bash := Generate("bash")
+	if !strings.Contains(bash, "_taws()") {
+		t.Fatalf("bash completion does not define _taws():\n%s", bash)
+	}
+	if !strings.Contains(bash, "taws list-profiles") {
+		t.Fatalf("bash completion does not shell out to 'taws list-profiles'")
+	}
+	if !strings.Contains(bash, "taws list-regions") {
+		t.Fatalf("bash completion does not shell out to 'taws list-regions'")
+	}
+	if Generate("elvish") != Default() {
+		t.Fatal("Generate(elvish) must fall back to the default script")
+	}
+	if Default() != GenerateBash() {
+		t.Fatal("Default() must be the bash script")
+	}
+}
