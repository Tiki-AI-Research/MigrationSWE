+++ b/tests/target/batches/BATCH-F2P-0002/root/f2p_probe_test.go
@@ -0,0 +1,72 @@
+package main
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"strings"
+	"testing"
+)
+
+// F2P-033: the root command validates --log-level and rejects unknown flags.
+func TestF2PInvalidLogLevelRejected(t *testing.T) {
+	cmd := newRootCmd()
+	cmd.SetArgs([]string{"--log-level", "bogus"})
+	cmd.SetOut(io.Discard)
+	cmd.SetErr(io.Discard)
+	err := cmd.Execute()
+	if err == nil {
+		t.Fatal("expected error for --log-level bogus")
+	}
+	normalized := strings.Join(strings.Fields(err.Error()), " ")
+	if !strings.Contains(normalized, "[possible values: off, error, warn, info, debug, trace]") {
+		t.Fatalf("error = %q", normalized)
+	}
+}
+
+func TestF2PUnknownFlagRejected(t *testing.T) {
+	cmd := newRootCmd()
+	cmd.SetArgs([]string{"--definitely-not-a-flag"})
+	cmd.SetOut(io.Discard)
+	cmd.SetErr(io.Discard)
+	if err := cmd.Execute(); err == nil {
+		t.Fatal("expected error for unknown flag")
+	}
+}
+
+// F2P-032 / F2P-045: SSM exit reporting includes the code and the 254 hint.
+func captureStdout(t *testing.T, fn func()) string {
+	t.Helper()
+	orig := os.Stdout
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	os.Stdout = w
+	defer func() { os.Stdout = orig }()
+	fn()
+	_ = w.Close()
+	var buf bytes.Buffer
+	_, _ = io.Copy(&buf, r)
+	return buf.String()
+}
+
+func TestF2PReportSSMExitCode254(t *testing.T) {
+	out := captureStdout(t, func() { reportSSMExit(254) })
+	if !strings.Contains(out, "SSM session exited with code: 254") {
+		t.Fatalf("missing exit-code line in:\n%s", out)
+	}
+	if !strings.Contains(strings.ToLower(out), "not connected to ssm") {
+		t.Fatalf("missing 254 hint in:\n%s", out)
+	}
+}
+
+func TestF2PReportSSMExitCode1HasNoHint(t *testing.T) {
+	out := captureStdout(t, func() { reportSSMExit(1) })
+	if !strings.Contains(out, "SSM session exited with code: 1") {
+		t.Fatalf("missing exit-code line in:\n%s", out)
+	}
+	if strings.Contains(strings.ToLower(out), "not connected to ssm") {
+		t.Fatalf("unexpected 254 hint in:\n%s", out)
+	}
+}
diff --git a/tests/target/batches/BATCH-F2P-0002/run_target_probe.sh b/tests/target/batches/BATCH-F2P-0002/run_target_probe.sh
new file mode 100755
--- /dev/null
+++ b/tests/target/batches/BATCH-F2P-0002/run_target_probe.sh
@@ -0,0 +1,109 @@
+#!/bin/sh
+# Target-side F2P probe for BATCH-F2P-0002.
+#
+# Usage: run_target_probe.sh [target-repo]
+#
+# Copies the reference taws Go module, drops the behavior probes into the
+# matching packages and runs them with an explicit timeout.  Every potentially
+# long-running command is wrapped in `timeout`; no network or privileged
+# operation is required.
+set -eu
+
+REPO="${1:-/input/target}"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+
+cp -a "$REPO/." "$WORK/repo"
+cd "$WORK/repo"
+
+mkdir -p internal/aws internal/config internal/resource
+cp "$HERE/aws/f2p_probe_test.go" internal/aws/f2p_probe_test.go
+cp "$HERE/config/f2p_probe_test.go" internal/config/f2p_probe_test.go
+cp "$HERE/resource/f2p_probe_test.go" internal/resource/f2p_probe_test.go
+cp "$HERE/root/f2p_probe_test.go" f2p_probe_test.go
+
+emit() { printf 'OBSERVATION %s %s\n' "$1" "$2"; }
+
+# --- behavior probes -------------------------------------------------------
+TESTS_OUT="$WORK/tests.out"
+set +e
+CGO_ENABLED=0 GOFLAGS=-mod=vendor timeout 300s go test -count=1 -v \
+  ./internal/aws/ ./internal/config/ ./internal/resource/ . >"$TESTS_OUT" 2>&1
+TESTS_RC=$?
+set -e
+
+passed() { grep -q -- "--- PASS: $1" "$TESTS_OUT"; }
+
+mark() { # mark <obs-id> <test-name>
+  if passed "$2"; then emit "$1" PASS; else emit "$1" FAIL; fi
+}
+
+mark F2P-025 TestF2PXMLToJSONRepeatedItemsAndEmptyLeaf
+mark F2P-030 TestF2PResourceKeysExcludeRequiresParent
+mark F2P-047 TestF2PXMLToJSONRepeatedItemsAndEmptyLeaf
+mark F2P-037 TestF2PReportSSMExitCode254
+mark F2P-026 TestF2PConfigSnakeCaseRoundTrip
+mark F2P-028 TestF2PConfigInvalidYAMLFallback
+mark F2P-040 TestF2PConfigInvalidYAMLFallback
+mark F2P-043 TestF2PEmbeddedRegistryAndColor
+mark F2P-029 TestF2PReadOnlyBlocksAction
+mark F2P-048 TestF2PSignV4KnownVector
+mark F2P-038 TestF2PQueryRequestAddsActionAndVersion
+mark F2P-031 TestF2PQueryRequestAddsActionAndVersion
+mark F2P-041 TestF2PJSONRequestHeaders
+mark F2P-036 TestF2PEndpointOverridePrecedence
+mark F2P-042 TestF2PEndpointOverridePrecedence
+mark F2P-033 TestF2PInvalidLogLevelRejected
+mark F2P-032 TestF2PReportSSMExitCode254
+mark F2P-045 TestF2PReportSSMExitCode254
+
+if [ "$TESTS_RC" -eq 0 ]; then
+  emit F2P-035 PASS
+else
+  emit F2P-035 FAIL
+fi
+
+# --- version surface -------------------------------------------------------
+set +e
+VERSION_OUT="$(CGO_ENABLED=0 GOFLAGS=-mod=vendor timeout 120s go run . --version 2>/dev/null)"
+set -e
+if [ "$VERSION_OUT" = "taws 1.3.0-rc.8" ]; then
+  emit F2P-032 PASS
+else
+  emit F2P-032 FAIL
+fi
+
+# --- dependency / policy probes -------------------------------------------
+if [ -f go.mod ] && grep -q '^module github.com/huseyinbabal/taws' go.mod \
+   && grep -q 'github.com/spf13/cobra v1.8.1' go.mod \
+   && [ -f vendor/modules.txt ]; then
+  emit F2P-046 PASS
+else
+  emit F2P-046 FAIL
+fi
+
+if [ -d src/resources ] \
+   && [ "$(find src/resources -name '*.json' | wc -l)" -ge 30 ] \
+   && git rev-parse --git-dir >/dev/null 2>&1 \
+   && git diff --quiet HEAD -- src/resources; then
+  emit F2P-044 PASS
+else
+  emit F2P-044 FAIL
+fi
+
+if git rev-parse --git-dir >/dev/null 2>&1; then
+  CHANGED="$(git diff --name-only HEAD)"
+  BAD="$(printf '%s\n' "$CHANGED" | grep -E '^(src/ui/|src/app\.rs$|src/event\.rs$|tests/|grader-spec\.json$|hardgate\.py$|verifier\.py$)' || true)"
+  if [ -z "$BAD" ]; then emit F2P-034 PASS; else emit F2P-034 FAIL; fi
+  if [ -z "$BAD" ]; then emit F2P-027 PASS; else emit F2P-027 FAIL; fi
+else
+  emit F2P-034 FAIL
+  emit F2P-027 FAIL
+fi
+
+if grep -rIn --include='*.go' -E 'ratatui|crossterm|src/ui|app\.rs|event\.rs' main.go internal >/dev/null 2>&1; then
+  emit F2P-039 FAIL
+else
+  emit F2P-039 PASS
+fi
