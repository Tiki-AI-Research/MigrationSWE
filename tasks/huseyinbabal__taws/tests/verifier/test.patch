diff --git a/tests/shared/integration/normalization.json b/tests/shared/integration/normalization.json
new file mode 100644
--- /dev/null
+++ b/tests/shared/integration/normalization.json
@@ -0,0 +1,44 @@
+{
+  "schema_version": "migration-normalization:v1",
+  "batch_id": "BATCH-INTEGRATION-0001",
+  "relation": "equal_after_normalization",
+  "description": "Normalization applied to source and target observation values before the integration harness compares them. Only process-observable facts are normalized.",
+  "rules": [
+    {
+      "id": "BATCH-INTEGRATION-0001-NORM-R01",
+      "applies_to": "process_output",
+      "operation": "strip_trailing_whitespace_per_line",
+      "note": "Trailing spaces/tabs are not part of the contract."
+    },
+    {
+      "id": "BATCH-INTEGRATION-0001-NORM-R02",
+      "applies_to": "process_output",
+      "operation": "collapse_blank_lines",
+      "note": "Repeated blank lines collapse to a single blank line."
+    },
+    {
+      "id": "BATCH-INTEGRATION-0001-NORM-R03",
+      "applies_to": "message_text",
+      "operation": "collapse_whitespace",
+      "note": "Human-readable messages are compared only after whitespace/newline collapsing and containment; never matched whole."
+    },
+    {
+      "id": "BATCH-INTEGRATION-0001-NORM-R04",
+      "applies_to": "numbers",
+      "operation": "numeric_normalize",
+      "note": "Integers and floats denoting the same value compare equal."
+    },
+    {
+      "id": "BATCH-INTEGRATION-0001-NORM-R05",
+      "applies_to": "completion_scripts",
+      "operation": "existence_only",
+      "note": "Shell completion script bodies are compared for existence and shell markers only."
+    },
+    {
+      "id": "BATCH-INTEGRATION-0001-NORM-R06",
+      "applies_to": "errors",
+      "operation": "prefer_code_over_message",
+      "note": "Errors compare by exit code / error kind first; message text only after whitespace normalization."
+    }
+  ]
+}
