+		t.Fatalf("XMLToJSON: %v", err)
+	}
+	root, ok := val.(map[string]any)
+	if !ok {
+		t.Fatalf("root type = %T", val)
+	}
+	response, ok := root["Response"].(map[string]any)
+	if !ok {
+		t.Fatalf("Response type = %T", root["Response"])
+	}
+	items, ok := response["Item"].([]any)
+	if !ok {
+		t.Fatalf("Item type = %T, want []any", response["Item"])
+	}
+	if len(items) != 2 {
+		t.Fatalf("len(Item) = %d, want 2", len(items))
+	}
+	first, _ := items[0].(map[string]any)
+	second, _ := items[1].(map[string]any)
+	if first["Name"] != "a" || second["Name"] != "b" {
+		t.Fatalf("items = %v", items)
+	}
+
+	emptyVal, err := XMLToJSON("<Response><Empty/></Response>")
+	if err != nil {
+		t.Fatalf("XMLToJSON: %v", err)
+	}
+	emptyRoot, _ := emptyVal.(map[string]any)
+	emptyResponse, _ := emptyRoot["Response"].(map[string]any)
+	if v, ok := emptyResponse["Empty"]; !ok || v != nil {
+		t.Fatalf("empty leaf = %v (present=%v), want nil", v, ok)
+	}
+}
+
+// F2P-055 / R028: no production Go package imports, binds to, or invokes the
+// retained Rust TUI.
+func TestProbeF2P055NoRustTUIReferences(t *testing.T) {
+	root := probeRepoRoot(t)
+	forbidden := []string{"app.rs", "event.rs", "src/ui", "ratatui", "crossterm"}
+	_ = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {
+		if err != nil || info == nil || info.IsDir() {
+			return nil
+		}
+		if !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		if strings.Contains(path, string(filepath.Separator)+"vendor"+string(filepath.Separator)) {
+			return nil
+		}
+		data, rerr := os.ReadFile(path)
+		if rerr != nil {
+			return nil
+		}
+		lower := strings.ToLower(string(data))
+		for _, bad := range forbidden {
+			if strings.Contains(lower, bad) {
+				rel, _ := filepath.Rel(root, path)
+				t.Errorf("production file %s references retained Rust TUI token %q", rel, bad)
+			}
+		}
+		return nil
+	})
+}
diff --git a/tests/target/batches/BATCH-F2P-0003/probes/internal/cli_probe/f2p0003_cli_probe_test.go b/tests/target/batches/BATCH-F2P-0003/probes/internal/cli_probe/f2p0003_cli_probe_test.go
new file mode 100644
