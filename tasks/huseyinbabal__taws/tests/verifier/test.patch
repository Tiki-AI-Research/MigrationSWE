+{
+  "batch_id": "BATCH-F2P-0001",
+  "kind": "F2P",
+  "role": "shared-observation-probes",
+  "schema_version": "migration-asset-probes:v2",
+  "migration": {
+    "category": "language",
+    "source": {"name": "Rust", "version": "2021"},
+    "target": {"name": "Go", "version": "1.23.0"}
+  },
+  "invocation": {
+    "entrypoint": "shared/batches/BATCH-F2P-0001/harness.sh",
+    "usage": "harness.sh <repo-root> <report-path>",
+    "timeout_policy": "every probe command is wrapped in an explicit `timeout`; the harness never waits unbounded",
+    "default_timeout_sec": 900,
+    "network": "disabled; all probes use loopback mock servers or pure computation"
+  },
+  "notes": [
+    "The same semantic predicate is executed against source and target; results are computed from the observation, never hardcoded per role.",
+    "Source (Rust) must fail each Go target-postcondition; target (Go 1.23.0) must satisfy it.",
+    "The harness emits exactly one record per owned observation id (24 total)."
+  ],
+  "probes": [
+    {
+      "observation_id": "F2P-001",
+      "requirement_ids": ["R001", "R034"],
+      "surface": "src/main.rs::runtime entry",
+      "semantic_predicate": "the declared runtime entry is the Go taws CLI and its migrated subsystems run in-process",
+      "target_technology_assertion": "execution path is Go 1.23.0 built by `go build ./...`; binary prints `taws 1.3.0-rc.8`",
+      "steps": [
+        {"timeout_sec": 900, "cmd": "cd {repo} && go build ./...", "expect": {"exit_code": 0}},
+        {"timeout_sec": 900, "cmd": "cd {repo} && go build -o /tmp/batch-f2p-taws .", "expect": {"exit_code": 0}},
+        {"timeout_sec": 30, "cmd": "/tmp/batch-f2p-taws --version", "expect": {"exit_code": 0, "stdout_equals": "taws 1.3.0-rc.8\n"}}
+      ]
+    },
+    {
+      "observation_id": "F2P-002",
+      "requirement_ids": ["R041"],
+      "surface": "src/resource/handlers::request construction",
+      "semantic_predicate": "QueryRequest issues a POST adding Action and Version query parameters",
+      "target_technology_assertion": "request built in-process by Go internal/aws against a loopback mock server",
+      "steps": [
+        {"timeout_sec": 600, "cmd": "cd {repo} && go test -count=1 -v -run 'TestQueryRequestAgainstMockServer|TestQueryRequest' ./internal/aws/...", "expect": {"exit_code": 0, "stdout_contains": "--- PASS"}}
+      ]
+    },
+    {
+      "observation_id": "F2P-003",
+      "requirement_ids": ["R031"],
+      "surface": "hidden evaluation asset paths",
+      "semantic_predicate": "the Go migration working tree contains no path under a hidden evaluation/verifier asset directory",
+      "target_technology_assertion": "migration implemented in Go without touching hidden evaluation assets",
+      "steps": [
+        {"timeout_sec": 60, "cmd": "test -f {repo}/go.mod", "expect": {"exit_code": 0}},
+        {"timeout_sec": 120, "cmd": "cd {repo} && git status --porcelain", "expect": {"exit_code": 0, "stdout_not_matches": "(^|/)(tests|verifier)/|verifier"}}
+      ]
+    },
+    {
+      "observation_id": "F2P-004",
+      "requirement_ids": ["R032"],
+      "surface": "repository working tree vs baseline commit",
+      "semantic_predicate": "migration additions/deletions are present as uncommitted working-tree changes",
+      "target_technology_assertion": "the Go migration exists in the working tree rather than committed elsewhere",
+      "steps": [
+        {"timeout_sec": 60, "cmd": "test -f {repo}/go.mod", "expect": {"exit_code": 0}},
+        {"timeout_sec": 120, "cmd": "cd {repo} && git status --porcelain", "expect": {"exit_code": 0, "stdout_nonempty": true}}
+      ]
+    },
+    {
+      "observation_id": "F2P-005",
+      "requirement_ids": ["R048"],
+      "surface": "src/aws/http.rs::endpoint override resolution",
+      "semantic_predicate": "NewHTTPClient honors AWS_ENDPOINT_URL and an explicit endpoint argument wins",
+      "target_technology_assertion": "endpoint resolution performed in-process by Go internal/aws",
+      "steps": [
