+++ b/tests/target/batches/BATCH-F2P-0003/probes/internal/cli_probe/f2p0003_cli_probe_test.go
@@ -0,0 +1,210 @@
+package cli_probe
+
+// Hidden target-side CLI probes authored by BATCH-F2P-0003.
+//
+// The probes build the migrated binary and exercise observable behavior:
+// process exit codes and stdout structure. Every potentially long-running
+// command is bounded by an explicit context timeout.
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+var (
+	buildOnce sync.Once
+	buildPath string
+	buildErr  error
+)
+
+func repoRoot(t *testing.T) string {
+	t.Helper()
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("runtime.Caller failed")
+	}
+	dir := filepath.Dir(file)
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatal("go.mod not found above probe file")
+		}
+		dir = parent
+	}
+}
+
+func buildBinary(t *testing.T) string {
+	t.Helper()
+	buildOnce.Do(func() {
+		root, err := findRoot()
+		if err != nil {
+			buildErr = err
+			return
+		}
+		dir, err := os.MkdirTemp("", "taws-f2p0003-")
+		if err != nil {
+			buildErr = err
+			return
+		}
+		bin := filepath.Join(dir, "taws")
+		ctx, cancel := context.WithTimeout(context.Background(), 300*time.Second)
+		defer cancel()
+		cmd := exec.CommandContext(ctx, "go", "build", "-o", bin, ".")
+		cmd.Dir = root
+		if out, err := cmd.CombinedOutput(); err != nil {
+			buildErr = &buildFailure{err: err, output: string(out)}
+			return
+		}
+		buildPath = bin
+	})
+	if buildErr != nil {
+		t.Fatalf("building taws failed: %v", buildErr)
+	}
+	return buildPath
+}
+
+type buildFailure struct {
+	err    error
+	output string
+}
+
+func (e *buildFailure) Error() string { return e.err.Error() + "\n" + e.output }
+
+func findRoot() (string, error) {
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		return "", os.ErrNotExist
+	}
+	dir := filepath.Dir(file)
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir, nil
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "", os.ErrNotExist
+		}
+		dir = parent
+	}
+}
+
+func runBinary(t *testing.T, args ...string) (stdout, stderr string, exitCode int) {
+	t.Helper()
+	bin := buildBinary(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+
+	home := t.TempDir()
+	cmd := exec.CommandContext(ctx, bin, args...)
+	cmd.Env = append(os.Environ(),
+		"HOME="+home,
+		"XDG_CONFIG_HOME="+filepath.Join(home, ".config"),
+		"AWS_ACCESS_KEY_ID=",
+		"AWS_SECRET_ACCESS_KEY=",
+		"AWS_PROFILE=",
+	)
+	var outBuf, errBuf strings.Builder
+	cmd.Stdout = &outBuf
+	cmd.Stderr = &errBuf
+	err := cmd.Run()
+	code := 0
+	if err != nil {
+		if ee, ok := err.(*exec.ExitError); ok {
+			code = ee.ExitCode()
+		} else {
+			t.Fatalf("running %v: %v", args, err)
+		}
+	}
+	return outBuf.String(), errBuf.String(), code
+}
+
+// F2P-057 / F2P-067 / F2P-068 / R001: build produces the taws binary and the
+// migrated subsystems run in-process.
+func TestProbeF2P001BuildAndSubsystems(t *testing.T) {
+	if _, _, code := runBinary(t, "--version"); code != 0 {
+		t.Fatalf("taws --version exit code = %d", code)
+	}
+	stdout, _, code := runBinary(t, "--version")
+	if code != 0 {
+		t.Fatalf("taws --version exit code = %d", code)
+	}
+	if stdout != "taws 1.3.0-rc.8\n" {
+		t.Fatalf("--version stdout = %q", stdout)
+	}
+
+	stdoutV, _, codeV := runBinary(t, "-V")
+	if codeV != 0 || stdoutV != "taws 1.3.0-rc.8\n" {
+		t.Fatalf("-V stdout = %q exit = %d", stdoutV, codeV)
+	}
+
+	completionOut, _, completionCode := runBinary(t, "completion", "bash")
+	if completionCode != 0 {
+		t.Fatalf("completion bash exit = %d", completionCode)
+	}
+	if !strings.Contains(completionOut, "_taws") {
+		t.Fatalf("completion bash does not look like a bash completion script")
+	}
+
+	regionsOut, _, regionsCode := runBinary(t, "list-regions")
+	if regionsCode != 0 {
+		t.Fatalf("list-regions exit = %d", regionsCode)
+	}
+	lines := strings.Split(strings.TrimRight(regionsOut, "\n"), "\n")
+	if len(lines) < 20 {
+		t.Fatalf("list-regions produced %d lines", len(lines))
+	}
+	if lines[0] != "us-east-1" {
+		t.Fatalf("first region = %q", lines[0])
+	}
+
+	// The catalog must be served from go:embed and the build must not depend on
+	// a Cargo/Rust artifact.
+	root := repoRoot(t)
+	embed, err := os.ReadFile(filepath.Join(root, "src", "embed.go"))
+	if err != nil {
+		t.Fatalf("read src/embed.go: %v", err)
+	}
+	if !strings.Contains(string(embed), "//go:embed resources/*.json") {
+		t.Fatalf("resource catalog is not served from go:embed")
+	}
+	if _, err := os.Stat(filepath.Join(root, "Cargo.toml")); err == nil {
+		t.Fatal("Cargo.toml must not be part of the migrated Go module")
+	}
+}
+
+// F2P-053 / R033: invalid --log-level is rejected with exit code 2.
+func TestProbeF2P033InvalidLogLevelRejected(t *testing.T) {
+	_, stderr, code := runBinary(t, "--log-level", "bogus")
+	if code != 2 {
+		t.Fatalf("exit code = %d, want 2", code)
+	}
+	normalized := strings.Join(strings.Fields(stderr), " ")
+	if !strings.Contains(normalized, "invalid value 'bogus' for '--log-level <LOG_LEVEL>'") {
+		t.Fatalf("stderr = %q", stderr)
+	}
+	if !strings.Contains(normalized, "[possible values: off, error, warn, info, debug, trace]") {
+		t.Fatalf("stderr = %q", stderr)
+	}
+}
+
+// F2P-067 / F2P-068 / R001: the migrated Go unit tests pass.
+func TestProbeF2P001GoUnitTestsPass(t *testing.T) {
+	root := repoRoot(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 600*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "go", "test", "./internal/aws/...", "./internal/resource/...")
+	cmd.Dir = root
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("go test failed: %v\n%s", err, out)
+	}
+}
