+)
+
+func probeConfigHome(t *testing.T) string {
+	t.Helper()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	return home
+}
+
+// F2P-049 / R036: saving and loading preserves values and emits snake_case keys.
+func TestProbeF2P049ConfigRoundTripSnakeCase(t *testing.T) {
+	probeConfigHome(t)
+
+	profile := "dev"
+	region := "eu-west-1"
+	lastResource := "ec2-instances"
+	cfg := &Config{
+		Profile:             &profile,
+		Region:              &region,
+		LastResource:        &lastResource,
+		RecentlyUsedRegions: []string{"eu-west-1"},
+	}
+	if err := cfg.Save(); err != nil {
+		t.Fatalf("Save: %v", err)
+	}
+	data, err := os.ReadFile(ConfigPath())
+	if err != nil {
+		t.Fatalf("ReadFile: %v", err)
+	}
+	text := string(data)
+	for _, key := range []string{"profile:", "region:", "last_resource:", "recently_used_regions:"} {
+		if !strings.Contains(text, key) {
+			t.Fatalf("serialized YAML missing snake_case key %q:\n%s", key, text)
+		}
+	}
+
+	loaded := Load()
+	if loaded.Profile == nil || *loaded.Profile != profile {
+		t.Fatalf("profile = %v", loaded.Profile)
+	}
+	if loaded.Region == nil || *loaded.Region != region {
+		t.Fatalf("region = %v", loaded.Region)
+	}
+	if loaded.LastResource == nil || *loaded.LastResource != lastResource {
+		t.Fatalf("last_resource = %v", loaded.LastResource)
+	}
+	if !reflect.DeepEqual(loaded.RecentlyUsedRegions, []string{"eu-west-1"}) {
+		t.Fatalf("recently_used_regions = %v", loaded.RecentlyUsedRegions)
+	}
+}
+
+// F2P-049 / R036: AddRecentRegion dedupes, fronts and truncates to six.
+func TestProbeF2P049AddRecentRegionOrdering(t *testing.T) {
+	cfg := &Config{RecentlyUsedRegions: []string{"eu-west-1", "us-east-1"}}
+	cfg.AddRecentRegion("us-east-1")
+	if !reflect.DeepEqual(cfg.RecentlyUsedRegions, []string{"us-east-1", "eu-west-1"}) {
+		t.Fatalf("after dedupe = %v", cfg.RecentlyUsedRegions)
+	}
+	for _, r := range []string{"r1", "r2", "r3", "r4", "r5", "r6"} {
+		cfg.AddRecentRegion(r)
+	}
+	if len(cfg.RecentlyUsedRegions) != 6 {
+		t.Fatalf("len = %d, want 6", len(cfg.RecentlyUsedRegions))
+	}
+	if cfg.RecentlyUsedRegions[0] != "r6" {
+		t.Fatalf("newest region = %q, want r6", cfg.RecentlyUsedRegions[0])
+	}
+}
+
+// F2P-065 / R037: invalid YAML yields a zero-value config without panicking and
+// logs a warning.
+func TestProbeF2P065InvalidYAMLWarnsAndDefaults(t *testing.T) {
+	home := probeConfigHome(t)
+	dir := filepath.Join(home, ".config", "taws")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "config.yaml"), []byte(": [unterminated"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	var buf bytes.Buffer
+	previous := log.Writer()
+	log.SetOutput(&buf)
+	defer log.SetOutput(previous)
+
+	cfg := Load()
+	if cfg == nil {
+		t.Fatal("Load returned nil")
+	}
+	if cfg.Profile != nil || cfg.Region != nil || cfg.LastResource != nil || len(cfg.RecentlyUsedRegions) != 0 {
+		t.Fatalf("expected zero-value config, got %+v", cfg)
+	}
+	normalized := strings.Join(strings.Fields(buf.String()), " ")
+	if !strings.Contains(normalized, "warning: Failed to parse config") {
+		t.Fatalf("expected parse warning, got %q", buf.String())
+	}
+}
