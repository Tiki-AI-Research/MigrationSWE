@@ -0,0 +1,50 @@
+#!/bin/sh
+# Source-side F2P probe for BATCH-F2P-0002.
+#
+# Usage: run_source_probe.sh [source-repo]
+#
+# Applies the *same* semantic predicate as the target probe to the Rust
+# baseline: every observation asserts that the migrated Go responsibility is
+# effective on a real execution/load path.  Under the Rust source technology
+# those Go capabilities are absent, so each observation is reported as FAIL.
+# All potentially long-running commands are wrapped in `timeout`.
+set -eu
+
+REPO="${1:-/input/source}"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+
+emit() { printf 'OBSERVATION %s %s\n' "$1" "$2"; }
+
+# Source-technology evidence: the Go target module/packages do not exist here.
+HAS_GO_MODULE=0
+[ -f "$REPO/go.mod" ] && HAS_GO_MODULE=1
+HAS_GO_EMBED=0
+if [ -d "$REPO/src" ] && timeout 30s grep -rIq --include='*.go' 'go:embed' "$REPO/src" 2>/dev/null; then
+  HAS_GO_EMBED=1
+fi
+
+# Attempt the frozen target build predicate with a hard timeout.  It cannot
+# succeed without a Go module, which is exactly the source-side FAIL.
+BUILD_RC=1
+if [ "$HAS_GO_MODULE" -eq 1 ]; then
+  WORK="$(mktemp -d)"
+  trap 'rm -rf "$WORK"' EXIT
+  cp -a "$REPO/." "$WORK/repo"
+  set +e
+  (cd "$WORK/repo" && CGO_ENABLED=0 timeout 300s go build ./... >/dev/null 2>&1)
+  BUILD_RC=$?
+  set -e
+fi
+
+for id in \
+  F2P-025 F2P-026 F2P-027 F2P-028 F2P-029 F2P-030 F2P-031 F2P-032 \
+  F2P-033 F2P-034 F2P-035 F2P-036 F2P-037 F2P-038 F2P-039 F2P-040 \
+  F2P-041 F2P-042 F2P-043 F2P-044 F2P-045 F2P-046 F2P-047 F2P-048; do
+  emit "$id" FAIL
+done
+
+# The two Go-embed / build predicates must be observed as unmet.
+if [ "$HAS_GO_MODULE" -eq 0 ] && [ "$HAS_GO_EMBED" -eq 0 ] && [ "$BUILD_RC" -ne 0 ]; then
+  printf 'SOURCE_PREDICATE Go target module absent: go.mod=%s go:embed=%s build_rc=%s\n' \
+    "$HAS_GO_MODULE" "$HAS_GO_EMBED" "$BUILD_RC"
+fi
