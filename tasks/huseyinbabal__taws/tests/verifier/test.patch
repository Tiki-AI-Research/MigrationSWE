+  emit_obs F2P-055 TestProbeF2P055NoRustTUIReferences
+  emit_obs F2P-057 TestProbeF2P001BuildAndSubsystems
+  printf '\n  ]\n'
+  printf '}\n'
+} > "${REPORT:-/dev/stdout}"
