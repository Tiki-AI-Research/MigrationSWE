+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/source_probes.json
@@ -0,0 +1,39 @@
+{
+  "batch_id": "BATCH-DIFFERENTIAL-0001",
+  "scope": "source",
+  "technology": {
+    "language": "Rust",
+    "edition": "2021",
+    "build_command": "cargo build --locked",
+    "test_command": "cargo test --locked"
+  },
+  "execution": {
+    "runtime": "rust-cargo",
+    "requires_toolchain": "rustc/cargo",
+    "timeout_sec": 900,
+    "note": "All commands MUST be wrapped with an explicit timeout by the runner. No command may block indefinitely."
+  },
+  "probes": [
+    {"observation_id": "DIFF-001", "kind": "cli", "command": "taws --log-level off --readonly --help", "expected": "exit 0 and all documented flags parse; unknown flag exits non-zero"},
+    {"observation_id": "DIFF-002", "kind": "cli", "command": "taws completion <shell>", "expected": "shell scripts for bash/zsh/fish/powershell; elvish falls back to default; list-profiles/list-regions hidden, one per line"},
+    {"observation_id": "DIFF-003", "kind": "unit", "command": "cargo test config", "expected": "profile/region/last_resource/recently_used_regions keys load with the declared types"},
+    {"observation_id": "DIFF-004", "kind": "unit", "command": "cargo test config", "expected": "invalid YAML returns defaults and logs a parse warning without panicking; missing file logs and returns defaults"},
+    {"observation_id": "DIFF-005", "kind": "unit", "command": "cargo test config", "expected": "dedupe, move-to-front, truncate to 6"},
