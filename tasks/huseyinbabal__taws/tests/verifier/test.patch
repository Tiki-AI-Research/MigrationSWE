@@ -0,0 +1,75 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// F2P-026: save/load round-trips and emits snake_case YAML keys.
+func TestF2PConfigSnakeCaseRoundTrip(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("XDG_CONFIG_HOME", dir)
+
+	cfg := &Config{}
+	profile := "dev"
+	region := "eu-west-1"
+	cfg.Profile = &profile
+	cfg.Region = &region
+	cfg.RecentlyUsedRegions = []string{"eu-west-1"}
+	if err := cfg.Save(); err != nil {
+		t.Fatalf("Save error: %v", err)
+	}
+
+	raw, err := os.ReadFile(filepath.Join(dir, "taws", "config.yaml"))
+	if err != nil {
+		t.Fatalf("read config: %v", err)
+	}
+	text := string(raw)
+	for _, key := range []string{"profile:", "region:", "last_resource:", "recently_used_regions:"} {
+		if !strings.Contains(text, key) {
+			t.Fatalf("missing snake_case key %q in:\n%s", key, text)
+		}
+	}
+	for _, bad := range []string{"Profile:", "Region:", "RecentlyUsedRegions:"} {
+		if strings.Contains(text, bad) {
+			t.Fatalf("capitalized key %q leaked in:\n%s", bad, text)
+		}
+	}
+
+	loaded := Load()
+	if loaded.Profile == nil || *loaded.Profile != "dev" {
+		t.Fatalf("Profile = %v", loaded.Profile)
+	}
+	if loaded.Region == nil || *loaded.Region != "eu-west-1" {
+		t.Fatalf("Region = %v", loaded.Region)
+	}
+	if len(loaded.RecentlyUsedRegions) != 1 || loaded.RecentlyUsedRegions[0] != "eu-west-1" {
+		t.Fatalf("RecentlyUsedRegions = %v", loaded.RecentlyUsedRegions)
+	}
+}
+
+// F2P-028 / F2P-040: invalid YAML falls back to a zero config without panicking.
+func TestF2PConfigInvalidYAMLFallback(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("XDG_CONFIG_HOME", dir)
+	parent := filepath.Join(dir, "taws")
+	if err := os.MkdirAll(parent, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(parent, "config.yaml"), []byte(": [unterminated"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	loaded := Load()
+	if loaded == nil {
+		t.Fatal("Load returned nil")
+	}
+	if loaded.Profile != nil || loaded.Region != nil || loaded.LastResource != nil {
+		t.Fatalf("expected zero config, got %#v", loaded)
+	}
+	if len(loaded.RecentlyUsedRegions) != 0 {
+		t.Fatalf("RecentlyUsedRegions = %v, want empty", loaded.RecentlyUsedRegions)
+	}
+}
