@@ -0,0 +1,26 @@
+#!/bin/sh
+# Documents the exact semantic predicate shared by the source and target sides
+# of BATCH-F2P-0002.  The predicate is intentionally technology-bound:
+#
+#   The observed responsibility is fulfilled in-process by the frozen target
+#   technology (Go, main module github.com/huseyinbabal/taws) and the same
+#   postcondition does not hold in the Rust source technology.
+#
+# The source side must report FAIL for every observation because the Go module,
+# Go packages and go:embed catalog do not exist in the Rust repository.
+set -eu
+
+REPO="${1:-/input/source}"
+
+fail=0
+[ -f "$REPO/go.mod" ] || fail=1
+[ -d "$REPO/internal" ] || fail=1
+[ -f "$REPO/internal/aws/xml.go" ] || fail=1
+[ -f "$REPO/src/embed.go" ] || fail=1
+[ -f "$REPO/Cargo.toml" ] || fail=1
+
+if [ "$fail" -ne 0 ]; then
+  printf 'F2P_SOURCE_RESULT FAIL (target Go technology absent; Rust source present)\n'
+  exit 0
+fi
+printf 'F2P_SOURCE_RESULT PASS (unexpected: target Go technology present in source)\n'
