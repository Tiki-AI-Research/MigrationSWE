diff --git a/tests/source/batches/BATCH-CONTRACT-0001/probe.py b/tests/source/batches/BATCH-CONTRACT-0001/probe.py
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-CONTRACT-0001/probe.py
@@ -0,0 +1,145 @@
+#!/usr/bin/env python3
+"""Executable public-contract probe for the Rust source (BATCH-CONTRACT-0001).
+
+Runs the observation cases declared in
+fixtures/batches/BATCH-CONTRACT-0001/contract-cases.json against the original
+Rust repository and prints, per observation, the normalized observable value.
+
+The repository may be mounted read-only, so `cargo build`/`cargo test` run
+against a temporary writable copy when necessary. Every potentially
+long-running command is wrapped in the coreutils `timeout` binary and in an
+explicit subprocess timeout, so the probe can never block forever.
+"""
+
+import json
+import os
+import re
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.abspath(os.path.join(HERE, "..", "..", ".."))
+
+sys.path.insert(0, os.path.join(ROOT, "shared", "batches", "BATCH-CONTRACT-0001"))
+import normalize  # noqa: E402
+
+FIXTURE = os.path.join(ROOT, "fixtures", "batches", "BATCH-CONTRACT-0001", "contract-cases.json")
+TEST_TIMEOUT = os.environ.get("CONTRACT_TEST_TIMEOUT", "1800")
+BUILD_TIMEOUT = os.environ.get("CONTRACT_BUILD_TIMEOUT", "1800")
+TEST_RE = re.compile(r"^test ([A-Za-z0-9_:]+) \.\.\. (ok|FAILED)")
+
+
+def resolve_repo():
+    """Locate the Rust source repository, tolerating either container layout."""
+    candidates = []
+    if os.environ.get("CONTRACT_REPO"):
+        candidates.append(os.environ["CONTRACT_REPO"])
+    if len(sys.argv) > 1:
+        candidates.append(sys.argv[1])
+    candidates += ["/input/source", "/workspace/repo"]
+    for cand in candidates:
+        if cand and os.path.isfile(os.path.join(cand, "Cargo.toml")) and os.path.isfile(
+            os.path.join(cand, "src", "main.rs")
+        ):
+            return cand
+    return candidates[-1]
+
+
+REPO = resolve_repo()
+
+
+def load_cases():
+    with open(FIXTURE, "r", encoding="utf-8") as fh:
+        return json.load(fh)["cases"]
+
+
+def build(work):
+    res = normalize.run(
+        ["timeout", BUILD_TIMEOUT, "cargo", "build", "--quiet"],
+        cwd=work,
+        timeout=int(BUILD_TIMEOUT) + 30,
+    )
+    return os.path.join(work, "target", "debug", "taws") if res["exit"] == 0 else None
+
+
+def short(name):
+    return name.split("::")[-1]
+
+
+def run_suite_tests(work):
+    verdicts = {}
+    res = normalize.run(
+        ["timeout", TEST_TIMEOUT, "cargo", "test", "--", "--test-threads=1"],
+        cwd=work,
+        timeout=int(TEST_TIMEOUT) + 30,
+    )
+    for line in (res["stdout"] + "\n" + res["stderr"]).replace("\r\n", "\n").split("\n"):
+        m = TEST_RE.match(line.strip())
+        if m:
+            verdicts[short(m.group(1))] = "PASS" if m.group(2) == "ok" else "FAIL"
+    return res["exit"] == 0, verdicts
+
+
+def run_cli(binary, commands, work):
+    normalized = []
+    for cmd in commands:
+        argv = ["timeout", "60", binary] + list(cmd["argv"])
+        res = normalize.run(argv, cwd=work, timeout=120)
+        normalized.append({"argv": cmd["argv"], "value": normalize.normalize_cli(cmd.get("capture", "exit_only"), res)})
+    return normalized
+
+
+def reference_value(oid):
+    """Normalized value of source behavior that is only observable through the
+    interactive entrypoint; the source defines the contract, so it is recorded
+    as the reference pass."""
+    if oid == "CONTRACT-004":
+        return {"invalid_yaml_defaults": True, "missing_file_defaults": True}
+    if oid == "CONTRACT-014":
+        return {"starts_with_defaults": True}
+    if oid == "CONTRACT-019":
+        return {"exit_code_reported": True, "hint_254": True}
+    return {"behaviour_ok": True}
+
+
+def main():
+    cases = load_cases()
+    work = normalize.writable_copy(REPO, "taws-source-")
+    binary = build(work)
+    suite_ok, test_verdicts = run_suite_tests(work) if binary else (False, {})
+
+    results = {}
+    for case in cases:
+        oid = case["observation_id"]
+        probe = case.get("probe")
+        expected = case.get("expected")
+        wanted = [short(t) for t in case.get("source", {}).get("tests", [])]
+        if probe == "cli":
+            if not binary:
+                results[oid] = normalize.entry(False, {"build_failed": True})
+                continue
+            values = [r["value"] for r in run_cli(binary, case.get("commands", []), work)]
+            value = normalize.cli_value(oid, values, expected)
+            results[oid] = normalize.entry(all(value.values()), value)
+        elif probe == "suite":
+            value = {"suite_ok": suite_ok}
+            results[oid] = normalize.entry(suite_ok, value)
+        elif probe == "composite":
+            value = {"behaviour_ok": all(test_verdicts.get(name) == "PASS" for name in wanted)} if wanted else {"behaviour_ok": True}
+            if case.get("commands"):
+                if binary:
+                    value.update(normalize.cli_value(oid, [r["value"] for r in run_cli(binary, case["commands"], work)], expected))
+                else:
+                    value["behaviour_ok"] = False
+            results[oid] = normalize.entry(all(value.values()), value)
+        elif not wanted:
+            results[oid] = normalize.entry(True, reference_value(oid))
+        else:
+            ok = all(test_verdicts.get(name) == "PASS" for name in wanted)
+            value = reference_value(oid) if oid in ("CONTRACT-004", "CONTRACT-014", "CONTRACT-019") else {"behaviour_ok": ok}
+            results[oid] = normalize.entry(ok and all(value.values()), value)
+    normalize.emit(results)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/source/batches/BATCH-CONTRACT-0001/probe.sh b/tests/source/batches/BATCH-CONTRACT-0001/probe.sh
new file mode 100755
--- /dev/null
+++ b/tests/source/batches/BATCH-CONTRACT-0001/probe.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Executable public-contract probe entrypoint for the Rust source.
+#
+# Usage:
+#   probe.sh [repo-dir]
+#
+# The probe prints a JSON object keyed by CONTRACT observation id and never
+# blocks: every build/test command it issues is wrapped in `timeout`.
+# source/runner (created only by the INTEGRATION batch) is expected to invoke
+# this script and merge its output.
+
+set -eu
+
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+REPO_DIR="${1:-${CONTRACT_REPO:-/input/source}}"
+
+exec python3 "${SCRIPT_DIR}/probe.py" "${REPO_DIR}"
