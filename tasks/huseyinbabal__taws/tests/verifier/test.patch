diff --git a/tests/target/batches/BATCH-F2P-0002/aws/f2p_probe_test.go b/tests/target/batches/BATCH-F2P-0002/aws/f2p_probe_test.go
new file mode 100644
--- /dev/null
+++ b/tests/target/batches/BATCH-F2P-0002/aws/f2p_probe_test.go
@@ -0,0 +1,134 @@
+package aws
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+)
+
+// F2P-025 / F2P-030 / F2P-037 / F2P-047: repeated XML elements become a JSON
+// array; empty leaf elements become nil.
+func TestF2PXMLToJSONRepeatedItemsAndEmptyLeaf(t *testing.T) {
+	got, err := XMLToJSON("<Response><Item><Name>a</Name></Item><Item><Name>b</Name></Item></Response>")
+	if err != nil {
+		t.Fatalf("XMLToJSON error: %v", err)
+	}
+	top, ok := got.(map[string]any)
+	if !ok {
+		t.Fatalf("top-level type = %T, want map", got)
+	}
+	response, ok := top["Response"].(map[string]any)
+	if !ok {
+		t.Fatalf("Response type = %T, want map", top["Response"])
+	}
+	items, ok := response["Item"].([]any)
+	if !ok {
+		t.Fatalf("Item type = %T, want []any (duplicate elements must be preserved)", response["Item"])
+	}
+	if len(items) != 2 {
+		t.Fatalf("len(Item) = %d, want 2", len(items))
+	}
+
+	empty, err := XMLToJSON("<Response><Item><Name></Name></Item></Response>")
+	if err != nil {
+		t.Fatalf("XMLToJSON error: %v", err)
+	}
+	emptyResp := empty.(map[string]any)["Response"].(map[string]any)
+	emptyItem := emptyResp["Item"].(map[string]any)
+	if v, present := emptyItem["Name"]; present && v != nil {
+		t.Fatalf("empty leaf Name = %#v, want nil", v)
+	}
+}
+
+// F2P-048: SigV4 over a fixed timestamp must match the known AWS vector.
+func TestF2PSignV4KnownVector(t *testing.T) {
+	creds := Credentials{
+		AccessKeyID:     "AKIDEXAMPLE",
+		SecretAccessKey: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
+	}
+	now := time.Date(2015, 8, 30, 12, 36, 0, 0, time.UTC)
+	headers, err := signV4At("GET", "https://example.amazonaws.com/", "", nil, creds, "us-east-1", "service", false, now)
+	if err != nil {
+		t.Fatalf("signV4At error: %v", err)
+	}
+	const want = "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/service/aws4_request, SignedHeaders=host;x-amz-date, Signature=5fa00fa31553b73ebf1942676e86291e8372ff2a2260956d9b8aae1d763fbf31"
+	if got := headers["Authorization"]; got != want {
+		t.Fatalf("Authorization =\n%q\nwant\n%q", got, want)
+	}
+}
+
+// F2P-038 / F2P-031: Query requests carry Action, Version and caller params.
+func TestF2PQueryRequestAddsActionAndVersion(t *testing.T) {
+	var gotMethod, gotQuery string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotMethod = r.Method
+		gotQuery = r.URL.RawQuery
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("<Response/>"))
+	}))
+	defer srv.Close()
+
+	u := srv.URL
+	client := NewHTTPClient(Credentials{AccessKeyID: "AK", SecretAccessKey: "SK"}, "us-east-1", &u)
+	if _, err := client.QueryRequest("ec2", "DescribeInstances", [][2]string{{"MaxResults", "10"}}); err != nil {
+		t.Fatalf("QueryRequest error: %v", err)
+	}
+	if gotMethod != http.MethodPost {
+		t.Fatalf("method = %q, want POST", gotMethod)
+	}
+	q, err := url.ParseQuery(gotQuery)
+	if err != nil {
+		t.Fatalf("parse query: %v", err)
+	}
+	if q.Get("Action") != "DescribeInstances" {
+		t.Fatalf("Action = %q", q.Get("Action"))
+	}
+	if q.Get("Version") != "2016-11-15" {
+		t.Fatalf("Version = %q", q.Get("Version"))
+	}
+	if q.Get("MaxResults") != "10" {
+		t.Fatalf("MaxResults = %q", q.Get("MaxResults"))
+	}
+}
+
+// F2P-041: JSON requests send the X-Amz-Target and JSON content-type headers.
+func TestF2PJSONRequestHeaders(t *testing.T) {
+	var gotHeaders http.Header
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotHeaders = r.Header.Clone()
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("{}"))
+	}))
+	defer srv.Close()
+
+	u := srv.URL
+	client := NewHTTPClient(Credentials{AccessKeyID: "AK", SecretAccessKey: "SK"}, "us-east-1", &u)
+	if _, err := client.JSONRequest("dynamodb", "ListTables", "{}"); err != nil {
+		t.Fatalf("JSONRequest error: %v", err)
+	}
+	if got := gotHeaders.Get("X-Amz-Target"); got != "DynamoDB_20120810.ListTables" {
+		t.Fatalf("X-Amz-Target = %q", got)
+	}
+	if got := gotHeaders.Get("Content-Type"); got != "application/x-amz-json-1.0" {
+		t.Fatalf("Content-Type = %q", got)
+	}
+}
+
+// F2P-036 / F2P-042: AWS_ENDPOINT_URL is honored, explicit endpoint wins.
+func TestF2PEndpointOverridePrecedence(t *testing.T) {
+	t.Setenv("AWS_ENDPOINT_URL", "http://localhost:4566")
+	service, _ := GetService("ec2")
+
+	fromEnv := NewHTTPClient(Credentials{}, "us-east-1", nil)
+	if ep, err := fromEnv.GetEndpoint(service); err != nil || ep != "http://localhost:4566" {
+		t.Fatalf("env endpoint = %q, %v", ep, err)
+	}
+
+	explicit := "http://explicit.example.test"
+	fromFlag := NewHTTPClient(Credentials{}, "us-east-1", &explicit)
+	if ep, err := fromFlag.GetEndpoint(service); err != nil || ep != explicit {
+		t.Fatalf("explicit endpoint = %q, %v", ep, err)
+	}
+}
diff --git a/tests/target/batches/BATCH-F2P-0002/config/f2p_probe_test.go b/tests/target/batches/BATCH-F2P-0002/config/f2p_probe_test.go
