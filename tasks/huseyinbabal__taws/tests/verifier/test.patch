+		envHits++
+		_, _ = w.Write([]byte(`<ok/>`))
+	}))
+	defer envServer.Close()
+	explicitServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		explicitHits++
+		_, _ = w.Write([]byte(`<ok/>`))
+	}))
+	defer explicitServer.Close()
+
+	t.Setenv("AWS_ENDPOINT_URL", envServer.URL)
+	explicit := explicitServer.URL
+	client := NewHTTPClient(Credentials{AccessKeyID: "AKIDEXAMPLE", SecretAccessKey: "secret"}, "us-east-1", &explicit)
+	if _, err := client.QueryRequest("ec2", "DescribeInstances", nil); err != nil {
