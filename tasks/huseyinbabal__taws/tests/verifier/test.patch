new file mode 100755
--- /dev/null
+++ b/tests/target/batches/BATCH-F2P-0003/run_probes.sh
@@ -0,0 +1,142 @@
+#!/bin/sh
+# BATCH-F2P-0003 target-side probe harness.
+#
+# Copies the authored Go probes into the migrated module, runs them with an
+# explicit wall-clock bound, and always cleans up. Every invocation of go is
+# wrapped in `timeout`; the harness can never wait forever.
+#
+# Usage: run_probes.sh [REPO_DIR] [REPORT_JSON]
+#   REPO_DIR defaults to /workspace/repo (the migrated Go module).
+#   REPORT_JSON, when given, receives the JSON observation report; otherwise
+#   the report is written to stdout (logs always go to stderr).
+#
+# The report contains every observation ID owned by this batch with its real
+# observed status, so an integration runner can aggregate without guessing.
+#
+# Exit codes: 0 all probes pass, 1 a probe failed, 2 harness/setup error.
+
+set -eu
+
+REPO_DIR="${1:-/workspace/repo}"
+REPORT="${2:-}"
+PROBE_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/probes"
+
+if [ ! -f "${REPO_DIR}/go.mod" ]; then
+  echo "run_probes.sh: no go.mod in ${REPO_DIR}" >&2
+  exit 2
+fi
+
+COPIED=""
+MKDIRS=""
+cleanup() {
+  for f in $COPIED; do
+    rm -f "$f"
+  done
+  for d in $MKDIRS; do
+    rmdir "$d" 2>/dev/null || true
+  done
+}
+trap cleanup EXIT INT TERM
+
+copy_probe() {
+  src="$1"
+  rel="${src#"${PROBE_ROOT}/"}"
+  dst="${REPO_DIR}/${rel}"
+  dir="$(dirname -- "$dst")"
+  if [ ! -d "$dir" ]; then
+    mkdir -p "$dir"
+    MKDIRS="${MKDIRS} ${dir}"
+  fi
+  cp "$src" "$dst"
+  COPIED="${COPIED} ${dst}"
+}
+
+for src in \
+  "${PROBE_ROOT}/internal/aws/f2p0003_probe_test.go" \
+  "${PROBE_ROOT}/internal/resource/f2p0003_probe_test.go" \
+  "${PROBE_ROOT}/internal/config/f2p0003_probe_test.go" \
+  "${PROBE_ROOT}/internal/completion/f2p0003_probe_test.go" \
+  "${PROBE_ROOT}/internal/cli_probe/f2p0003_cli_probe_test.go"
+do
+  copy_probe "$src"
+done
+
+TESTLOG="$(mktemp)"
+trap 'cleanup; rm -f "$TESTLOG"' EXIT INT TERM
+
+cd "$REPO_DIR"
+echo "run_probes.sh: running BATCH-F2P-0003 target probes (bounded)" >&2
+set +e
+timeout 900 go test -v -count=1 -run TestProbe ./internal/... >"$TESTLOG" 2>&1
+status=$?
+set -e
+cat "$TESTLOG" >&2
+
+# test_status <TestName> -> PASS when go test reported "--- PASS: <TestName> (".
+test_status() {
+  if grep -q -- "--- PASS: $1 (" "$TESTLOG"; then
+    printf 'PASS'
+  else
+    printf 'FAIL'
+  fi
+}
+
+# For each observation: evaluate every bound test. PASS only if all PASS.
+obs_report() {
+  obs_id="$1"; shift
+  overall="PASS"
+  tests=""
+  for t in "$@"; do
+    st="$(test_status "$t")"
+    if [ "$st" != "PASS" ]; then overall="FAIL"; fi
+    if [ -n "$tests" ]; then tests="${tests},${t}:${st}"; else tests="${t}:${st}"; fi
+  done
+  printf '    {"observation_id": "%s", "status": "%s", "evidence": "target tests %s"}' \
+    "$obs_id" "$overall" "$tests"
+}
+
+{
