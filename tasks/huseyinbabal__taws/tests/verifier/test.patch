+{
+  "id": "BATCH-DIFFERENTIAL-0001-NORM-001",
+  "batch_id": "BATCH-DIFFERENTIAL-0001",
+  "relation": "equal_after_normalization",
+  "description": "Normalize source and target observations before comparing them.",
+  "rules": [
+    {
+      "id": "BATCH-DIFFERENTIAL-0001-NORM-001-R01",
+      "applies_to": "process_output",
+      "operation": "strip_trailing_whitespace_per_line",
+      "note": "Trailing spaces/tabs are not part of the contract."
+    },
+    {
+      "id": "BATCH-DIFFERENTIAL-0001-NORM-001-R02",
+      "applies_to": "process_output",
+      "operation": "collapse_blank_lines",
+      "note": "Repeated blank lines collapse to a single blank line."
+    },
+    {
+      "id": "BATCH-DIFFERENTIAL-0001-NORM-001-R03",
+      "applies_to": "message_text",
+      "operation": "collapse_whitespace",
+      "note": "Human-readable message comparisons collapse runs of whitespace and newlines; messages are never matched whole."
+    },
+    {
+      "id": "BATCH-DIFFERENTIAL-0001-NORM-001-R04",
+      "applies_to": "numbers",
+      "operation": "numeric_normalize",
+      "note": "Integers and floats that denote the same value compare equal (50 == 50.0)."
+    },
+    {
+      "id": "BATCH-DIFFERENTIAL-0001-NORM-001-R05",
+      "applies_to": "completion_scripts",
+      "operation": "existence_only",
+      "note": "Shell completion script bodies are compared for existence and shell markers only, never character-for-character."
+    },
+    {
+      "id": "BATCH-DIFFERENTIAL-0001-NORM-001-R06",
+      "applies_to": "errors",
+      "operation": "prefer_code_over_message",
+      "note": "Errors compare by exit code / error kind first; message text only after whitespace normalization and containment."
+    }
+  ]
+}
diff --git a/tests/shared/batches/BATCH-F2P-0001/harness.sh b/tests/shared/batches/BATCH-F2P-0001/harness.sh
new file mode 100755
--- /dev/null
+++ b/tests/shared/batches/BATCH-F2P-0001/harness.sh
@@ -0,0 +1,241 @@
+#!/usr/bin/env bash
+# Shared F2P probe harness for BATCH-F2P-0001.
+# Probes are described by shared/batches/BATCH-F2P-0001/probes.json.
+#
+# Usage: harness.sh <repo-root> <report-path>
+#
+# Every potentially long-running command is wrapped in an explicit `timeout`.
+# The harness never waits unbounded and never performs privileged operations.
+# The SAME semantic predicate is evaluated for the source (Rust) and the
+# reference target (Go): each observation reports the raw measured result, so
+# the Rust source fails each Go target-postcondition and the Go target passes.
+set -u
+
+REPO="${1:?usage: harness.sh <repo-root> <report-path>}"
+REPORT="${2:-/dev/stdout}"
+
+BUILD_TIMEOUT=900
+TEST_TIMEOUT=600
+CLI_TIMEOUT=30
+GIT_TIMEOUT=120
+
+WORKDIR="$(mktemp -d)"
+trap 'rm -rf "$WORKDIR"' EXIT
+
+RECORDS="$WORKDIR/records.jsonl"
+: > "$RECORDS"
+
+record() {
+  # record <observation_id> <status> <detail>
+  printf '{"observation_id":"%s","status":"%s","detail":"%s"}\n' "$1" "$2" "$3" >> "$RECORDS"
+}
+
+emit() {
+  # emit <observation_id> <0|1> <detail>
+  if [ "$2" -eq 1 ]; then
+    record "$1" pass "$3"
+  else
+    record "$1" fail "$3"
+  fi
+}
+
+# run_test <package> <go-test-run-regex>
+# Succeeds only when the package builds, the run exits 0, and at least one
+# test actually reported PASS (so "no tests to run" is not a false positive).
+run_test() {
+  local pkg="$1" re="$2" out rc
+  out="$(cd "$REPO" && timeout "$TEST_TIMEOUT" go test -count=1 -v -run "$re" "./$pkg/..." 2>&1)"
+  rc=$?
+  if [ "$rc" -eq 0 ] && printf '%s' "$out" | grep -q -- '--- PASS'; then
+    return 0
+  fi
+  return 1
+}
+
+# --- Go target-technology entrypoint -----------------------------------------
+build_ok=0
+if (cd "$REPO" && timeout "$BUILD_TIMEOUT" go build ./... >/dev/null 2>&1); then
+  build_ok=1
+fi
+
+BIN="$WORKDIR/taws"
+bin_ok=0
+if (cd "$REPO" && timeout "$BUILD_TIMEOUT" go build -o "$BIN" . >/dev/null 2>&1); then
+  bin_ok=1
+fi
+
+module_ok=0
+if [ -f "$REPO/go.mod" ]; then
+  module_ok=1
+fi
+
+# --- CLI identity probes ------------------------------------------------------
+version_ok=0
+completion_bash_ok=0
+completion_elvish_ok=0
+loglevel_ok=0
+listregions_ok=0
+if [ "$bin_ok" -eq 1 ]; then
+  v_main="$(timeout "$CLI_TIMEOUT" "$BIN" --version 2>/dev/null)"
+  v_short="$(timeout "$CLI_TIMEOUT" "$BIN" -V 2>/dev/null)"
+  if [ "$v_main" = "taws 1.3.0-rc.8" ] && [ "$v_short" = "taws 1.3.0-rc.8" ]; then
+    version_ok=1
+  fi
+
+  if timeout "$CLI_TIMEOUT" "$BIN" completion bash 2>/dev/null | grep -q -- '_taws()'; then
+    completion_bash_ok=1
+  fi
+
+  if [ "$(timeout "$CLI_TIMEOUT" "$BIN" completion elvish 2>/dev/null | wc -l)" -ge 1 ]; then
+    completion_elvish_ok=1
+  fi
+
+  if [ "$(timeout "$CLI_TIMEOUT" "$BIN" list-regions 2>/dev/null | wc -l)" -ge 1 ]; then
+    listregions_ok=1
+  fi
+
+  timeout "$CLI_TIMEOUT" "$BIN" --log-level bogus >/dev/null 2>&1
+  if [ $? -eq 2 ]; then
+    loglevel_ok=1
+  fi
+fi
+
+completion_ok=$(( completion_bash_ok && completion_elvish_ok ))
+
+# --- Unit-level behavioral probes for the migrated siblings -------------------
+t_query=0
+if run_test internal/aws 'TestQueryRequestAgainstMockServer|TestQueryRequest'; then t_query=1; fi
+
+t_httpclient=0
+if run_test internal/aws 'TestNewHTTPClientHonorsEndpointEnvOverride|TestNewHTTPClientExplicitEndpointWinsOverEnv'; then t_httpclient=1; fi
+
+t_readonly=0
+if run_test internal/resource 'TestReadOnlyBlocksMutatingActions'; then t_readonly=1; fi
+
+t_tls=0
+if run_test internal/aws 'TestParseValidCertificate|TestParseCertificateBundle'; then t_tls=1; fi
+
+t_ec2=0
+if run_test internal/resource 'TestEC2InstancesResourceExists|TestResourceHasAPIConfig|TestCommonColorMapsExist'; then t_ec2=1; fi
+
+t_json=0
+if run_test internal/resource 'TestJSONRequestSetsTargetHeaders|TestFetchResourcesPaginatedJSONProtocol'; then t_json=1; fi
+
+t_cred=0
+if run_test internal/aws 'TestCredentialsErrorSSOVsConsoleLogin|TestParseINIFileWithLoginSession|TestParseINIFileWithRoleArn'; then t_cred=1; fi
+
+t_keys=0
+if run_test internal/resource 'TestGetAllResourceKeys'; then t_keys=1; fi
+
+t_keys_all=0
+if run_test internal/resource 'TestGetAllResourceKeys|TestAllResourcesHaveRequiredFields'; then t_keys_all=1; fi
+
+# --- Dependency / process boundary probes -------------------------------------
+deps_ok=0
+if (cd "$REPO" && timeout "$TEST_TIMEOUT" go list -deps ./... >"$WORKDIR/deps.txt" 2>/dev/null); then
+  if ! grep -qE 'cargo|\.rs$' "$WORKDIR/deps.txt"; then
+    deps_ok=1
+  fi
+fi
+
+no_tui_refs=0
+if [ "$module_ok" -eq 1 ]; then
+  if ! (cd "$REPO" && timeout "$GIT_TIMEOUT" grep -RIl --include=*.go \
+      -e 'src/ui' -e 'src/app' -e 'app\.rs' -e 'event\.rs' main.go internal >/dev/null 2>&1); then
+    no_tui_refs=1
+  fi
+fi
+
+exec_ok=0
+if [ "$module_ok" -eq 1 ] && \
+   (cd "$REPO" && timeout "$GIT_TIMEOUT" grep -RIl --include=*.go 'exec.Command' main.go internal >/dev/null 2>&1); then
+  if ! (cd "$REPO" && timeout "$GIT_TIMEOUT" grep -RIn --include=*.go \
+      -e 'cargo' -e 'rustc' main.go internal >/dev/null 2>&1); then
+    exec_ok=1
+  fi
+fi
+
+ssm_ok=0
+if [ "$module_ok" -eq 1 ] && \
+   (cd "$REPO" && timeout "$GIT_TIMEOUT" grep -Rq 'SSM session exited with code' main.go); then
+  ssm_ok=1
+fi
+
+# --- Migration working-tree probes --------------------------------------------
+hidden_ok=0
+if [ "$module_ok" -eq 1 ]; then
+  if (cd "$REPO" && timeout "$GIT_TIMEOUT" git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
+    if ! (cd "$REPO" && timeout "$GIT_TIMEOUT" git status --porcelain 2>/dev/null | grep -Eq '(^|/)(tests|verifier)/|verifier'); then
+      hidden_ok=1
+    fi
+  else
+    hidden_ok=1
+  fi
+fi
+
+worktree_ok=0
+if [ "$module_ok" -eq 1 ] && \
+   (cd "$REPO" && timeout "$GIT_TIMEOUT" git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
+  if (cd "$REPO" && timeout "$GIT_TIMEOUT" git status --porcelain 2>/dev/null | grep -q .); then
+    worktree_ok=1
+  fi
+fi
+
+# --- Catalog immutability and embedding ---------------------------------------
+catalog_ok=1
+if (cd "$REPO" && timeout "$GIT_TIMEOUT" git cat-file -e \
+    d1cbf6e450eced9a7947cf810764ec79599c7793^{commit} >/dev/null 2>&1); then
+  (cd "$REPO" && timeout "$GIT_TIMEOUT" git diff --exit-code \
+    d1cbf6e450eced9a7947cf810764ec79599c7793 -- src/resources) >/dev/null 2>&1 || catalog_ok=0
+elif [ -d /input/source/src/resources ] && [ -d "$REPO/src/resources" ]; then
+  timeout "$GIT_TIMEOUT" diff -r /input/source/src/resources "$REPO/src/resources" >/dev/null 2>&1 || catalog_ok=0
+elif [ ! -d "$REPO/src/resources" ]; then
+  catalog_ok=0
+fi
+
+embed_ok=0
+if (cd "$REPO" && timeout "$GIT_TIMEOUT" grep -RIl --include=*.go 'go:embed' main.go internal src >/dev/null 2>&1); then
+  embed_ok=1
+fi
+
+# --- Emit one record per owned observation, in inventory order ----------------
+emit F2P-001 "$(( build_ok && version_ok ))"   'go build and version entrypoint'
+emit F2P-002 "$t_query"                        'internal/aws query protocol request'
+emit F2P-003 "$hidden_ok"                      'no hidden evaluation asset changed'
+emit F2P-004 "$worktree_ok"                    'migration present as working-tree changes'
+emit F2P-005 "$t_httpclient"                   'internal/aws endpoint override resolution'
+emit F2P-006 "$deps_ok"                        'Go dependency graph stays in-process'
+emit F2P-008 "$no_tui_refs"                    'no Go package binds the Rust TUI'
+emit F2P-009 "$(( bin_ok && completion_ok && listregions_ok ))" 'completion and list subcommands'
+emit F2P-010 "$t_readonly"                     'internal/resource read-only guard'
+emit F2P-011 "$t_tls"                          'internal/aws custom CA bundle'
+emit F2P-013 "$ssm_ok"                         'SSM session exit code reporting'
+emit F2P-014 "$loglevel_ok"                    'log-level validation rejects bad value'
+emit F2P-015 "$(( catalog_ok && t_keys ))"      'catalog unchanged and keys filtered'
+emit F2P-016 "$exec_ok"                        'external command boundary retained'
+emit F2P-018 "$(( catalog_ok && embed_ok ))"    'catalog embedded and unchanged'
+emit F2P-021 "$t_ec2"                          'embedded registry decodes schema'
+emit F2P-024 "$t_json"                         'JSON protocol request headers'
+emit F2P-012 "$t_cred"                         'credential chain login errors'
+emit F2P-007 "$t_query"                        'internal/aws request construction'
+emit F2P-017 "$(( bin_ok && version_ok ))"      'version flag output'
+emit F2P-019 "$(( catalog_ok && t_keys ))"      'requires_parent filtering'
+emit F2P-020 "$no_tui_refs"                     'migrated responsibilities are Go-only'
+emit F2P-022 "$t_httpclient"                    'endpoint override precedence'
+emit F2P-023 "$(( catalog_ok && t_keys_all ))"  'keys and required fields with unchanged catalog'
+
+{
+  printf '[\n'
+  first=1
+  while IFS= read -r line; do
+    if [ "$first" -eq 1 ]; then
+      first=0
+    else
+      printf ',\n'
+    fi
+    printf '%s' "$line"
+  done < "$RECORDS"
+  printf '\n]\n'
+} > "$REPORT"
+
+cat "$REPORT"
