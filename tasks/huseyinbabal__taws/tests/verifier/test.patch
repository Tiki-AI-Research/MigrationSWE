+package resource
+
+import "testing"
+
+// F2P-043: catalog is embedded and color maps are loaded.
+func TestF2PEmbeddedRegistryAndColor(t *testing.T) {
+	def := GetResource("ec2-instances")
+	if def == nil {
+		t.Fatal("GetResource(ec2-instances) = nil")
+	}
+	if def.Service != "ec2" {
+		t.Fatalf("Service = %q, want ec2", def.Service)
+	}
+	color, ok := GetColorForValue("state", "running")
+	if !ok {
+		t.Fatal("GetColorForValue(state, running) not found")
+	}
+	if color != [3]uint8{0, 255, 0} {
+		t.Fatalf("color = %v, want [0 255 0]", color)
+	}
+}
+
+// F2P-030: directly addressable keys exclude requires_parent resources.
+func TestF2PResourceKeysExcludeRequiresParent(t *testing.T) {
+	keys := GetAllResourceKeys()
+	if len(keys) < 30 {
+		t.Fatalf("len(GetAllResourceKeys()) = %d, want >= 30", len(keys))
+	}
+	set := make(map[string]bool, len(keys))
+	for _, k := range keys {
+		set[k] = true
+	}
+	for _, want := range []string{"ec2-instances", "lambda-functions", "s3-buckets"} {
+		if !set[want] {
+			t.Fatalf("missing directly addressable key %q", want)
+		}
+	}
+	if set["iam-user-policies"] {
+		t.Fatal("requires_parent resource iam-user-policies exposed as addressable")
+	}
+}
+
+// F2P-029: read-only mode blocks mutating actions.
+func TestF2PReadOnlyBlocksAction(t *testing.T) {
+	SetReadOnly(true)
+	defer SetReadOnly(false)
+	if err := ExecuteAction("ec2", "terminate-instance", nil, "i-0123456789"); err == nil {
+		t.Fatal("ExecuteAction in read-only mode returned nil error")
+	}
+}
