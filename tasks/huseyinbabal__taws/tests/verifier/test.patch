+
+// F2P-052 / R044: ParseItems honors the configured response_root and
+// output_token for JSON-protocol responses.
+func TestProbeF2P052ParseItemsOutputToken(t *testing.T) {
+	handler := GetProtocolHandler(ProtocolJSON)
+	root := "TableNames"
+	outputToken := "LastEvaluatedTableName"
+	config := &APIConfig{
+		Protocol:     ProtocolJSON,
+		ResponseRoot: &root,
+		Pagination:   &PaginationConfig{OutputToken: &outputToken},
+	}
+
+	items, nextToken, err := handler.ParseItems(`{"TableNames":["a","b"],"LastEvaluatedTableName":"b"}`, config)
+	if err != nil {
+		t.Fatalf("ParseItems: %v", err)
+	}
+	if len(items) != 2 {
+		t.Fatalf("len(items) = %d, want 2", len(items))
+	}
+	if items[0] != "a" || items[1] != "b" {
+		t.Fatalf("items = %v", items)
+	}
+	if nextToken == nil || *nextToken != "b" {
+		t.Fatalf("nextToken = %v, want b", nextToken)
+	}
+
+	// When the output token is absent the continuation must be nil.
+	items2, nextToken2, err := handler.ParseItems(`{"TableNames":["a","b"]}`, config)
+	if err != nil {
+		t.Fatalf("ParseItems: %v", err)
+	}
+	if len(items2) != 2 {
+		t.Fatalf("len(items2) = %d, want 2", len(items2))
+	}
+	if nextToken2 != nil {
+		t.Fatalf("nextToken2 = %v, want nil", *nextToken2)
+	}
+}
+
+// F2P-066 / R039: GetAllResourceKeys excludes requires_parent sub-resources.
+func TestProbeF2P066ResourceKeysExcludeRequiresParent(t *testing.T) {
+	keys := GetAllResourceKeys()
+	set := map[string]bool{}
+	for _, k := range keys {
+		set[k] = true
+	}
+	for _, want := range []string{"ec2-instances", "s3-buckets", "lambda-functions"} {
+		if !set[want] {
+			t.Fatalf("GetAllResourceKeys missing %q", want)
+		}
+	}
+	if set["iam-user-policies"] {
+		t.Fatal("GetAllResourceKeys must not expose iam-user-policies (requires_parent)")
+	}
+	for key, def := range GetRegistry().Resources {
+		if def.RequiresParent && set[key] {
+			t.Fatalf("requires_parent resource %q must not be directly addressable", key)
+		}
+	}
+}
+
+// F2P-069 / F2P-070 / R045: named field transforms are ported and reachable
+// through FieldMapping.Transform.
+func TestProbeF2P069FieldTransforms(t *testing.T) {
+	if got := TransformBoolToYesNo(true); got != "Yes" {
+		t.Fatalf("TransformBoolToYesNo(true) = %v", got)
+	}
+	if got := TransformFormatBytes(2048); got != "2.0 KB" {
+		t.Fatalf("TransformFormatBytes(2048) = %v", got)
+	}
+	if got := TransformRoute53RecordID(map[string]any{"Name": "a.example.", "Type": "A"}); got != "a.example.#A" {
+		t.Fatalf("TransformRoute53RecordID = %v", got)
+	}
+
+	transform := "route53_record_id"
+	mappings := map[string]FieldMapping{
+		"id": {Source: "/", Transform: &transform},
+	}
+	mapped, ok := ApplyFieldMappings(map[string]any{"Name": "a.example.", "Type": "A"}, mappings).(map[string]any)
+	if !ok {
+		t.Fatalf("ApplyFieldMappings returned %T", mapped)
+	}
+	if mapped["id"] != "a.example.#A" {
+		t.Fatalf("mapped id = %v", mapped["id"])
+	}
+}
+
+// F2P-072 / R046: read-only mode blocks mutating actions before any request.
+func TestProbeF2P072ReadOnlyBlocksWrites(t *testing.T) {
+	var hits int
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits++
+		_, _ = w.Write([]byte(`<ok/>`))
+	}))
+	defer server.Close()
+
+	endpoint := server.URL
+	clients := &aws.AwsClients{
+		HTTP:    aws.NewHTTPClient(aws.Credentials{AccessKeyID: "AKIDEXAMPLE", SecretAccessKey: "secret"}, "us-east-1", &endpoint),
+		Region:  "us-east-1",
+		Profile: "default",
+	}
+
+	SetReadOnly(true)
+	defer SetReadOnly(false)
+
+	err := ExecuteAction("ec2", "terminate-instance", clients, "i-0123456789abcdef0")
+	if err == nil {
+		t.Fatal("read-only mode must reject a mutating action")
+	}
+	if hits != 0 {
+		t.Fatalf("read-only mode must not issue any HTTP request, hits = %d", hits)
+	}
+}
