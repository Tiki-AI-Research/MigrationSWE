+// F2P-050 / F2P-060 / F2P-061 / F2P-062 / F2P-071 / R029: the only external
+// commands in production Go code are SSM connect, console login and
+// credential_process. None may reference the retained Rust implementation.
+func TestProbeF2P029ExecCommandSitesLimited(t *testing.T) {
+	root := probeRepoRoot(t)
+	allowed := []string{
+		`exec.Command("aws", "ssm", "start-session"`,
+		`exec.Command("aws", "login"`,
+		`exec.Command("sh", "-c"`,
+		`exec.Command("cmd", "/C"`,
+	}
+	forbidden := []string{"cargo", "rustc", "taws.rs", "target/debug", "target/release"}
+
+	_ = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {
+		if err != nil || info == nil || info.IsDir() {
+			return nil
+		}
+		if !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		if strings.Contains(path, string(filepath.Separator)+"vendor"+string(filepath.Separator)) {
+			return nil
+		}
+		data, rerr := os.ReadFile(path)
+		if rerr != nil {
+			return nil
+		}
+		lines := strings.Split(string(data), "\n")
+		for i, line := range lines {
+			if !strings.Contains(line, "exec.Command(") {
+				continue
+			}
+			ok := false
+			for _, a := range allowed {
+				if strings.Contains(line, a) {
+					ok = true
+					break
+				}
+			}
+			if !ok {
+				rel, _ := filepath.Rel(root, path)
+				t.Errorf("unexpected exec.Command site %s:%d: %s", rel, i+1, strings.TrimSpace(line))
+			}
+		}
+		for _, bad := range forbidden {
+			if strings.Contains(strings.ToLower(string(data)), bad) {
+				rel, _ := filepath.Rel(root, path)
+				t.Errorf("production file %s references forbidden implementation token %q", rel, bad)
+			}
+		}
+		return nil
+	})
+}
