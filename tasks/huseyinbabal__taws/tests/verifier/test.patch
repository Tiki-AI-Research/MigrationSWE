+	t.Setenv("AWS_ENDPOINT_URL", server.URL)
+	client := NewHTTPClient(Credentials{AccessKeyID: "AKIDEXAMPLE", SecretAccessKey: "secret"}, "us-east-1", nil)
+	if _, err := client.QueryRequest("ec2", "DescribeInstances", nil); err != nil {
+		t.Fatalf("QueryRequest: %v", err)
+	}
+	if hits != 1 {
+		t.Fatalf("AWS_ENDPOINT_URL not honored, hits = %d", hits)
+	}
