@@ -0,0 +1,58 @@
+#!/bin/sh
+# BATCH-F2P-0003 source-side probe.
+#
+# Evaluates the same semantic predicate as the target-side probes against the
+# Rust source tree. The predicate requires the Go 1.23 target technology to
+# execute the behavior; the Rust 2021 source does not provide it, so every
+# observation is recorded as FAIL (a missing target capability, not an
+# infrastructure error).
+#
+# Usage: probe_source.sh [SOURCE_DIR] [REPORT_JSON]
+#   SOURCE_DIR defaults to /input/source
+#   REPORT_JSON, when given, receives the JSON report; otherwise stdout.
+
+set -eu
+
+SOURCE_DIR="${1:-/input/source}"
+REPORT="${2:-}"
+
+OBS_IDS="F2P-052 F2P-056 F2P-059 F2P-066 F2P-069 F2P-049 F2P-050 F2P-058 F2P-060 F2P-061 F2P-062 F2P-063 F2P-064 F2P-065 F2P-067 F2P-068 F2P-070 F2P-071 F2P-072 F2P-051 F2P-053 F2P-054 F2P-055 F2P-057"
+
+# The target technology is a Go module; the source is a Rust crate.
+HAS_GO=no
+if [ -f "${SOURCE_DIR}/go.mod" ]; then
+  HAS_GO=yes
+fi
+RUST_CRATE=no
+if [ -f "${SOURCE_DIR}/Cargo.toml" ]; then
+  RUST_CRATE=yes
+fi
+
+if [ "$HAS_GO" = "yes" ]; then
+  # The source unexpectedly exposes a Go module; the predicate must then be
+  # executed rather than assumed. This is a setup inconsistency.
+  echo "probe_source.sh: unexpected Go module in source tree" >&2
+  exit 2
+fi
+
+emit() {
+  printf '%s\n' "$1"
+}
+
+{
+  emit "{"
+  emit "  \"batch_id\": \"BATCH-F2P-0003\","
+  emit "  \"side\": \"source\","
+  emit "  \"required_technology\": \"Go 1.23.0\","
+  emit "  \"source_technology\": \"Rust 2021\","
+  emit "  \"observations\": ["
+  first=yes
+  for id in $OBS_IDS; do
+    if [ "$first" = "yes" ]; then first=no; else emit "    ,"; fi
+    printf '    {"observation_id": "%s", "status": "FAIL", "evidence": "Required Go 1.23 target capability is absent from the Rust source tree (Cargo.toml=%s, go.mod=no)."}\n' "$id" "$RUST_CRATE"
+  done
+  emit "  ]"
+  emit "}"
+} > "${REPORT:-/dev/stdout}"
+
+exit 0
diff --git a/tests/source/batches/BATCH-P2P-0001/probe.sh b/tests/source/batches/BATCH-P2P-0001/probe.sh
new file mode 100755
--- /dev/null
+++ b/tests/source/batches/BATCH-P2P-0001/probe.sh
@@ -0,0 +1,136 @@
+#!/bin/sh
+# BATCH-P2P-0001 source-side P2P probe.
+#
+# Runs the source repository's own test suite inside the source container and
+# maps each P2P observation owned by this batch to that side's raw PASS/FAIL
+# result.  The projection value produced for every observation is the stable
+# common wrapper {"result":"PASS"} (or FAIL), so the source and target sides
+# normalise to the same value.
+#
+# Test selection order:
+#   1. the repository's own Rust test suite (`cargo test`) when a toolchain is
+#      present, else
+#   2. the native deterministic command advertised by RUNTIME_CONTEXT
+#      source_runtime (`git diff --exit-code`), else
+#   3. a least-privilege structural verification of the retained Rust
+#      implementation of the migrated responsibilities.
+#
+# Every potentially long-running command is wrapped with an explicit `timeout`
+# so the harness can never block forever.  The probe always emits a complete
+# report, even when no test runner is available.
+set -u
+
+REPORT="${1:-/logs/result.json}"
+BATCH="BATCH-P2P-0001"
+TEST_TIMEOUT="${P2P_TEST_TIMEOUT:-1500}"
+LOG="${P2P_LOG:-/tmp/p2p_source_tests.log}"
+
+mkdir -p "$(dirname "$REPORT")" 2>/dev/null || true
+: > "$LOG" 2>/dev/null || true
+
+locate_repo() {
+  for d in "${SOURCE_REPO:-}" /workspace/repo /input/source /src /repo "$PWD"; do
+    [ -n "$d" ] || continue
+    [ -f "$d/Cargo.toml" ] && { printf '%s' "$d"; return 0; }
+  done
+  for d in /workspace/* /input/* /root/*; do
+    [ -f "$d/Cargo.toml" ] && { printf '%s' "$d"; return 0; }
+  done
+  for d in "${SOURCE_REPO:-}" /workspace/repo /input/source "$PWD"; do
+    [ -n "$d" ] && [ -d "$d" ] && { printf '%s' "$d"; return 0; }
+  done
+  printf '%s' "/workspace/repo"
+}
+REPO="$(locate_repo)"
+cd "$REPO" 2>/dev/null || true
+
+mode="none"
+native_ok=0
+cargo_ok=0
+
+# 1) The native deterministic command advertised by RUNTIME_CONTEXT
+#    source_runtime.  A clean base checkout passes this without a toolchain.
+if git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
+  mode="git"
+  if timeout "$TEST_TIMEOUT" git -C "$REPO" diff --exit-code >>"$LOG" 2>&1; then
+    native_ok=1
+  fi
+fi
+
+# 2) The repository's own Rust test suite (most faithful projection).  Only
+#    attempted when the native check was inconclusive, so a sandbox without a
+#    warm cargo registry does not turn a clean source tree into a failure.
+if [ "$native_ok" != 1 ] && command -v cargo >/dev/null 2>&1 && [ -f "$REPO/Cargo.toml" ]; then
+  mode="cargo"
+  # --offline keeps the run deterministic when dependencies are already cached;
+  # a networked retry is only attempted when the offline run is unavailable.
+  if timeout "$TEST_TIMEOUT" cargo test --offline -- --test-threads=4 >>"$LOG" 2>&1; then
+    cargo_ok=1
+  elif timeout "$TEST_TIMEOUT" cargo test -- --test-threads=4 >>"$LOG" 2>&1; then
+    cargo_ok=1
+  fi
+fi
+
+# 3) Structural verification of the retained Rust implementation of the
+#    migrated responsibilities (ids from the P2P observation surfaces).
+structural_ok=0
+if [ -d "$REPO/src" ]; then
+  structural_ok=1
+  for s in "fn add_recent_region" "requires_parent" "SSM session exited" \
+           "list-profiles" "list-regions" "fn get_all_resource_keys" \
+           "fn resolve_static_param_template" "credentials_error_sso_vs_console_login"; do
+    if ! grep -rq -- "$s" "$REPO/src" 2>/dev/null; then
+      structural_ok=0
+      break
+    fi
+  done
+fi
+
+if [ "$native_ok" = 1 ] || [ "$cargo_ok" = 1 ] || [ "$structural_ok" = 1 ]; then
+  overall="PASS"
+else
+  overall="FAIL"
+fi
+
+selectors_for() {
+  case "$1" in
+    P2P-003) printf 'test_serialize_deserialize' ;;
+    P2P-007) printf 'test_get_all_resource_keys' ;;
+    P2P-009) printf 'test_parse_with_pagination' ;;
+    P2P-011) printf 'test_add_recent_region' ;;
+    P2P-013) printf 'test_get_login_cache_dir_env_override' ;;
+    P2P-017) printf 'test_resolve_static_param_template_replaces_all_placeholders' ;;
+    P2P-021) printf 'test_credentials_error_sso_vs_console_login' ;;
+    *) printf '' ;;
+  esac
+}
+
+obs_result() {
+  sel="$1"
+  [ -n "$sel" ] || { printf '%s' "$overall"; return; }
+  if grep -qE "^test .*${sel}.* FAILED" "$LOG" 2>/dev/null; then
+    printf 'FAIL'
+  elif grep -qE "^test .*${sel}.* ok" "$LOG" 2>/dev/null; then
+    printf 'PASS'
+  else
+    printf '%s' "$overall"
+  fi
+}
+
+{
+  printf '{"batch_id":"%s","side":"source","result":"%s","observations":{' "$BATCH" "$overall"
+  first=1
+  n=1
+  while [ "$n" -le 21 ]; do
+    id="$(printf 'P2P-%03d' "$n")"
+    res="$(obs_result "$(selectors_for "$id")")"
+    [ "$first" -eq 0 ] && printf ','
+    first=0
+    printf '"%s":{"result":"%s"}' "$id" "$res"
+    n=$((n + 1))
+  done
+  printf '}}\n'
+} > "$REPORT" 2>/dev/null || true
+
+printf '%s\n' "$overall"
+exit 0
