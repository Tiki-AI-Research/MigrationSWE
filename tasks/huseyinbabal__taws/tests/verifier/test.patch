+  emit_obs F2P-049 TestProbeF2P049ConfigRoundTripSnakeCase TestProbeF2P049AddRecentRegionOrdering
+  emit_obs F2P-050 TestProbeF2P050EndpointEnvOverride TestProbeF2P050ExplicitEndpointWins TestProbeF2P050STSAssumeRoleEndpointOverride TestProbeF2P029ExecCommandSitesLimited
+  emit_obs F2P-058 TestProbeF2P058SSOLoginRequiredReported TestProbeF2P058ConsoleLoginRequiredReported
+  emit_obs F2P-060 TestProbeF2P060EnvironmentPrecedesStaticProfile TestProbeF2P029ExecCommandSitesLimited
+  emit_obs F2P-061 TestProbeF2P029ExecCommandSitesLimited
+  emit_obs F2P-062 TestProbeF2P062SharedCredentialsFileOverride TestProbeF2P062ConfigFileOverride TestProbeF2P029ExecCommandSitesLimited
+  emit_obs F2P-063 TestProbeF2P056CredentialsFromEnvironment TestProbeF2P058SSOLoginRequiredReported TestProbeF2P058ConsoleLoginRequiredReported
+  emit_obs F2P-064 TestProbeF2P064QueryRequestAddsActionAndVersion
+  emit_obs F2P-065 TestProbeF2P065InvalidYAMLWarnsAndDefaults
+  emit_obs F2P-067 TestProbeF2P001BuildAndSubsystems TestProbeF2P001GoUnitTestsPass
+  emit_obs F2P-068 TestProbeF2P001BuildAndSubsystems
+  emit_obs F2P-070 TestProbeF2P069FieldTransforms
+  emit_obs F2P-071 TestProbeF2P071ListProfilesUnion TestProbeF2P071ListRegions TestProbeF2P029ExecCommandSitesLimited
+  emit_obs F2P-072 TestProbeF2P072ReadOnlyBlocksWrites
+  emit_obs F2P-051 TestProbeF2P051SignV4KnownVector
