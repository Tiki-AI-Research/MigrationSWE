  "verdict_rule": "source and target must each report status PASS and their normalized values must be equal",
  "cases": [
    {
      "observation_id": "CONTRACT-001",
      "requirement_ids": ["R002"],
      "surface": "taws root command flag set",
      "probe": "cli",
      "commands": [
        {"argv": ["--log-level", "off", "--readonly", "--help"], "capture": "exit_only"},
        {"argv": ["--bogus"], "capture": "exit_only"},
        {"argv": ["--log-level", "bogus"], "capture": "exit_only"}
      ],
      "expected": {"help_exits": 0, "unknown_flag_exits_nonzero": true, "invalid_log_level_exits_nonzero": true}
    },
    {
      "observation_id": "CONTRACT-002",
      "requirement_ids": ["R003"],
      "surface": "taws subcommand tree (completion, list-profiles, list-regions)",
      "probe": "cli",
      "commands": [
        {"argv": ["completion", "bash"], "capture": "exit_only"},
        {"argv": ["completion", "zsh"], "capture": "exit_only"},
        {"argv": ["completion", "fish"], "capture": "exit_only"},
        {"argv": ["completion", "powershell"], "capture": "exit_only"},
        {"argv": ["completion", "elvish"], "capture": "exit_and_stdout_nonempty"},
        {"argv": ["list-regions"], "capture": "line_count"},
        {"argv": ["list-profiles"], "capture": "line_count"}
      ],
      "expected": {
        "completion_shells_ok": ["bash", "fish", "powershell", "zsh"],
        "completion_fallback_ok": true,
        "list_regions_nonempty": true,
        "list_profiles_nonempty": true
      }
    },
