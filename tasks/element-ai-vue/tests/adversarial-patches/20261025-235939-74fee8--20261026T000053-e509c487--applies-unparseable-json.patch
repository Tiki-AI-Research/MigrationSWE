+import type MarkdownIt from 'markdown-it'
+
+export interface MarkdownItHtmlOptions {
+  allowDangerousHtml?: boolean
+}
+
+export const markdownItHtmlPassthrough = (
+  md: MarkdownIt,
+  options?: MarkdownItHtmlOptions
+) => {
+  if (options && options.allowDangerousHtml === false) {
+    md.set({ html: false })
+  } else {
+    md.set({ html: true })
+  }
+}
diff --git a/packages/utils/markdown-parse/models/markdownItMath.ts b/packages/utils/markdown-parse/models/markdownItMath.ts
