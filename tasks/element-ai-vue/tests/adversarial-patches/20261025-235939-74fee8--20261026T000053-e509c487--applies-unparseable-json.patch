+import type MarkdownIt from 'markdown-it'
+
+const definitionPattern = /^\*\[([^\]]+)\]:[ \t]*(.+?)\s*$/
+
+const escapeRegExp = (value: string) =>
+  value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
