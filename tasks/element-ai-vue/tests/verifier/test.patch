@@ -0,0 +1,27 @@
+import {
+  OBSERVATION_IDS,
+  runAll,
+} from '../../../shared/batches/BATCH-F2P-0002/checks.mjs'
+
+const mod = await import('../../../packages/utils/markdown-parse/index.ts')
+const results = await runAll(mod)
+const failed = results.filter((result) => result.status !== 'PASS')
+const passed = results.filter((result) => result.status === 'PASS')
+
+const report = {
+  batch_id: 'BATCH-F2P-0002',
+  side: 'source',
+  expected: 'FAIL',
+  observation_ids: OBSERVATION_IDS,
+  failed: failed.map((result) => result.observation_id),
+  unexpected_passed: passed.map((result) => ({
+    observation_id: result.observation_id,
+    checks: result.checks,
+  })),
+}
+
+console.log(JSON.stringify(report, null, 2))
+
+if (passed.length > 0) {
+  process.exitCode = 1
+}
