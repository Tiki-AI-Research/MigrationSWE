diff --git a/test/fastify-smoke.js b/test/fastify-smoke.js
new file mode 100644
index 0000000..3c20c70
--- /dev/null
+++ b/test/fastify-smoke.js
@@ -0,0 +1,34 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const appModule = require('../bin/app');
+
+async function runSmoke() {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'sharing-fastify-'));
+    let app;
+    try {
+        fs.writeFileSync(path.join(root, 'hello.txt'), 'hello world', 'utf8');
+        app = appModule.buildApp({ sharePath: root });
+        assert.strictEqual(typeof app.inject, 'function', 'app.inject should be a function');
+        assert.strictEqual(typeof app.ready, 'function', 'app.ready should be a function');
+        assert.strictEqual(typeof app.close, 'function', 'app.close should be a function');
+        await app.ready();
+        const response = await app.inject({ method: 'GET', url: '/share/hello.txt' });
+        assert.strictEqual(response.statusCode, 200, 'Expected status code 200');
+        assert.strictEqual(response.body, 'hello world', 'Expected body to be "hello world"');
+        console.log('fastify inject smoke passed');
+    } finally {
+        if (app) {
+            try { await app.close(); } catch (e) { /* best-effort close */ }
+        }
+        try { fs.rmSync(root, { recursive: true, force: true }); } catch (e) { /* best-effort cleanup */ }
+    }
+}
+
+runSmoke().catch((err) => {
+    console.error('Fastify smoke test failed:', err);
+    process.exitCode = 1;
+});
