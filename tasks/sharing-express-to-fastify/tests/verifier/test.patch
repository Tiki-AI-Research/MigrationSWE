diff --git a/suite/p2p/P42-conditional-get.js b/suite/p2p/P42-conditional-get.js
new file mode 100644
index 0000000..7a26fa1
--- /dev/null
+++ b/suite/p2p/P42-conditional-get.js
@@ -0,0 +1,59 @@
+'use strict';
+
+const { assert, fs, path, removeDir, tempDir, runFeature, withServer, request } = require('../_harness');
+
+runFeature('P42 shared files preserve ETag conditional request semantics', async () => {
+    const dir = tempDir();
+    try {
+        fs.writeFileSync(path.join(dir, 'etag.txt'), 'etag payload', 'utf8');
+        await withServer({ sharePath: dir }, async (server) => {
+            const first = await request(server.base, '/share/etag.txt');
+            assert.strictEqual(first.status, 200);
+            const etag = String(first.headers.etag || '');
+            assert.ok(etag.length > 0);
+            const cached = await request(server.base, '/share/etag.txt', {
+                headers: { 'if-none-match': etag },
+            });
+            assert.strictEqual(cached.status, 304);
+            assert.strictEqual(cached.text, '');
+            const head = await request(server.base, '/share/etag.txt', { method: 'HEAD' });
+            assert.strictEqual(head.status, 200);
+            assert.strictEqual(String(head.headers.etag || ''), etag);
+        });
+        // Express res.send() also supported conditional GET/HEAD on generated
+        // pages and clipboard downloads. Only checking static files misses it.
+        await withServer({
+            sharePath: dir, receive: true, clipboardText: true,
+            shareAddress: 'http://localhost/share/',
+            postUploadRedirectUrl: 'http://localhost/receive',
+            getClipboardData: () => ({ isPath: false, text: 'conditional clipboard' }),
+        }, async (server) => {
+            for (const route of ['/qr', '/receive', '/', '/clipboard', '/clipboard.txt']) {
+                const first = await request(server.base, route);
+                assert.strictEqual(first.status, 200, route);
+                const etag = String(first.headers.etag || '');
+                assert.ok(etag, route + ' validator');
+                for (const method of ['GET', 'HEAD']) {
+                    for (const validator of ['*', etag, '"unrelated", ' + etag.replace(/^W\//, '')]) {
+                        const cached = await request(server.base, route, {
+                            method, headers: { 'if-none-match': validator },
+                        });
+                        assert.strictEqual(cached.status, 304, method + ' ' + route);
+                        assert.strictEqual(cached.text, '', route);
+                    }
+                }
+                for (const headers of [
+                    { 'if-none-match': '"different"' },
+                    { 'if-none-match': etag, 'cache-control': 'no-cache' },
+                    { 'if-none-match': etag, 'if-modified-since': 'Wed, 01 Jan 2031 00:00:00 GMT' },
+                ]) {
+                    const fresh = await request(server.base, route, { headers });
+                    assert.strictEqual(fresh.status, 200, route);
+                    assert.strictEqual(fresh.text, first.text, route);
+                }
+            }
+        });
+    } finally {
+        removeDir(dir);
+    }
+});
diff --git a/suite/p2p/P43-text-parser-errors.js b/suite/p2p/P43-text-parser-errors.js
new file mode 100644
index 0000000..dea47f9
--- /dev/null
+++ b/suite/p2p/P43-text-parser-errors.js
@@ -0,0 +1,153 @@
+'use strict';
+
+const { assert, fs, path, removeDir, tempDir, runFeature, withServer, request } = require('../_harness');
+
+runFeature('P43 text route preserves parser and URL-encoded semantics', async () => {
+    const dir = tempDir();
+    try {
+        await withServer({ sharePath: dir, receive: true }, async (server) => {
+            const malformed = await request(server.base, '/text', {
+                method: 'POST',
+                headers: { 'content-type': 'application/json' },
+                body: '{"text":',
+            });
+            assert.strictEqual(malformed.status, 400);
+            const boundary = 'sharing-p43-boundary';
+            const multipartHeaders = { 'content-type': 'multipart/form-data; boundary=' + boundary };
+            const jsonField = (value) => '--' + boundary + '\r\n' +
+                'Content-Disposition: form-data; name="text"\r\n' +
+                'Content-Type: application/json\r\n\r\n' + value + '\r\n';
+            const uploadFile = (filename) => '--' + boundary + '\r\n' +
+                'Content-Disposition: form-data; name="selected"; filename="' + filename + '"\r\n' +
+                'Content-Type: application/octet-stream\r\n\r\npayload\r\n';
+            const endMultipart = '--' + boundary + '--\r\n';
+            // Receiving used app-wide multipart middleware. Parse failures
+            // preceded route dispatch, including unknown routes and the share
+            // mount; multipart/mixed was eligible but unsupported (500).
+            fs.writeFileSync(path.join(dir, 'parser-probe.txt'), 'static payload');
+            for (const route of ['/upload', '/text', '/receive', '/missing', '/share/parser-probe.txt', '/qr']) {
+                for (const [type, body] of [
+                    ['multipart/form-data; boundary=' + boundary, 'not a multipart form'],
+                    ['multipart/mixed; boundary=' + boundary, uploadFile('must-not-save.txt') + endMultipart],
+                ]) {
+                    const response = await request(server.base, route, {
+                        method: 'POST', headers: { 'content-type': type }, body,
+                    });
+                    assert.strictEqual(response.status, 500, route + ' ' + type);
+                }
+            }
+            assert.ok(!fs.existsSync(path.join(dir, 'must-not-save.txt')));
+            // Without a semicolon the old middleware did not consider this a
+            // multipart request, so the route's ordinary response still wins.
+            for (const [route, status] of [['/upload', 400], ['/text', 400], ['/missing', 404], ['/share/parser-probe.txt', 200]]) {
+                const response = await request(server.base, route, {
+                    method: 'POST', headers: { 'content-type': 'multipart/form-data' }, body: 'ignored',
+                });
+                assert.strictEqual(response.status, status, route + ' unparsed type');
+            }
+            const emptyField = '--' + boundary + '\r\n' +
+                'Content-Disposition: form-data; name="text"\r\n\r\n\r\n';
+            const repeatedEmpty = await request(server.base, '/text', {
+                method: 'POST', headers: multipartHeaders,
+                body: emptyField + emptyField + endMultipart,
+            });
+            assert.strictEqual(repeatedEmpty.status, 400);
+            // Header controls must fail before a file can be written. Ordinary
+            // text values retain their independent terminal sanitization rules.
+            const unsafeName = 'control\x01.txt';
+            for (const route of ['/upload', '/text']) {
+                const unsafe = await request(server.base, route, {
+                    method: 'POST', headers: multipartHeaders,
+                    body: uploadFile(unsafeName) + endMultipart,
+                });
+                assert.strictEqual(unsafe.status, 500, route + ' malformed part header');
+                assert.ok(!fs.existsSync(path.join(dir, unsafeName)));
+            }
+            const delayedHeaderError = await request(server.base, '/upload', {
+                method: 'POST', headers: multipartHeaders,
+                body: uploadFile('first-before-invalid.txt') + uploadFile(unsafeName) + endMultipart,
+            });
+            assert.strictEqual(delayedHeaderError.status, 500);
+            assert.ok(!fs.existsSync(path.join(dir, 'first-before-invalid.txt')));
+            assert.ok(!fs.existsSync(path.join(dir, unsafeName)));
+            for (const value of ['{bad', '"quoted"']) {
+                const body = jsonField(value) + endMultipart;
+                const textResult = await request(server.base, '/text', {
+                    method: 'POST', headers: multipartHeaders, body,
+                });
+                assert.strictEqual(textResult.status, 200, value);
+                assert.strictEqual(textResult.text, 'Text received.');
+                const uploadResult = await request(server.base, '/upload', {
+                    method: 'POST', headers: multipartHeaders, body,
+                });
+                assert.strictEqual(uploadResult.status, 400, value);
+            }
+            for (const [index, fieldFirst] of [true, false].entries()) {
+                const filename = 'multipart-json-' + index + '.txt';
+                const field = jsonField('{bad');
+                const file = uploadFile(filename);
+                const body = (fieldFirst ? field + file : file + field) + endMultipart;
+                const uploadResult = await request(server.base, '/upload', {
+                    method: 'POST', headers: multipartHeaders, body,
+                });
+                assert.strictEqual(uploadResult.status, 200, filename);
+                assert.strictEqual(fs.readFileSync(path.join(dir, filename), 'utf8'), 'payload');
+            }
+            const form = await request(server.base, '/text', {
+                method: 'POST',
+                headers: { 'content-type': 'application/x-www-form-urlencoded' },
+                body: 'text=hello+from+form',
+            });
+            assert.strictEqual(form.status, 200);
+            assert.strictEqual(form.text, 'Text received.');
+            const empty = await request(server.base, '/text', {
+                method: 'POST',
+                headers: { 'content-type': 'application/x-www-form-urlencoded' },
+                body: 'text=',
+            });
+            assert.strictEqual(empty.status, 400);
+            const formBody = (count) => 'text=hello&' + Array.from(
+                { length: count - 1 }, (_, index) => 'field' + index + '=value'
+            ).join('&');
+            const atLimit = await request(server.base, '/text', {
+                method: 'POST',
+                headers: { 'content-type': 'application/x-www-form-urlencoded' },
+                body: formBody(1000),
+            });
+            assert.strictEqual(atLimit.status, 200);
+            const overLimit = await request(server.base, '/text', {
+                method: 'POST',
+                headers: { 'content-type': 'application/x-www-form-urlencoded' },
+                body: formBody(1001),
+            });
+            assert.strictEqual(overLimit.status, 413);
+            for (const url of ['/text/', '/TEXT/?source=form']) {
+                for (const [count, status] of [[1000, 200], [1001, 413]]) {
+                    const response = await request(server.base, url, {
+                        method: 'POST',
+                        headers: { 'content-type': 'application/x-www-form-urlencoded' },
+                        body: formBody(count),
+                    });
+                    assert.strictEqual(response.status, status, url + ' parameters=' + count);
+                }
+            }
+            const zlib = require('zlib');
+            for (const [encoding, compress] of [['gzip', zlib.gzipSync], ['deflate', zlib.deflateSync]]) {
+                for (const [type, body] of [
+                    ['application/json', JSON.stringify({ text: 'compressed text' })],
+                    ['application/x-www-form-urlencoded', 'text=compressed+text'],
+                ]) {
+                    const response = await request(server.base, '/text', {
+                        method: 'POST',
+                        headers: { 'content-type': type, 'content-encoding': encoding },
+                        body: compress(Buffer.from(body)),
+                    });
+                    assert.strictEqual(response.status, 200, type + ' ' + encoding);
+                    assert.strictEqual(response.text, 'Text received.');
+                }
+            }
+        });
+    } finally {
+        removeDir(dir);
+    }
+});
diff --git a/suite/p2p/P44-malformed-basic-auth.js b/suite/p2p/P44-malformed-basic-auth.js
new file mode 100644
index 0000000..66f50d4
--- /dev/null
+++ b/suite/p2p/P44-malformed-basic-auth.js
@@ -0,0 +1,51 @@
+'use strict';
+
+const { assert, removeDir, tempDir, runFeature, request, startServer } = require('../_harness');
+
+runFeature('P44 malformed basic credentials fail closed', async () => {
+    const dir = tempDir();
+    let running;
+    try {
+        running = await startServer({
+            sharePath: dir,
+            auth: { username: 'auth-user', password: 'auth-pass' },
+        });
+        const malformed = [
+            'Bearer token',
+            'Basic !!!',
+            'Basic ' + Buffer.from('missing-colon').toString('base64'),
+            'Basic ' + Buffer.from('auth-user:wrong').toString('base64'),
+            'Basic ' + Buffer.from(':auth-pass').toString('base64'),
+        ];
+        for (const authorization of malformed) {
+            const response = await request(running.base, '/share/', {
+                headers: { authorization },
+            });
+            assert.strictEqual(response.status, 401, authorization);
+            assert.match(String(response.headers['www-authenticate'] || ''), /^Basic /i);
+        }
+        const valid = 'Basic ' + Buffer.from('auth-user:auth-pass').toString('base64');
+        for (const authorization of [valid, valid.replace(/=+$/, '')]) {
+            const response = await request(running.base, '/share/', {
+                headers: { authorization },
+            });
+            assert.strictEqual(response.status, 200, 'valid credentials: ' + authorization);
+        }
+        for (const [url, authorizedStatus] of [['/share/%', 500], ['/missing/%', 404]]) {
+            for (const authorization of [null, malformed[3]]) {
+                const response = await request(running.base, url, {
+                    headers: authorization ? { authorization } : {},
+                });
+                assert.strictEqual(response.status, 401, url);
+                assert.match(String(response.headers['www-authenticate'] || ''), /^Basic /i);
+            }
+            const response = await request(running.base, url, {
+                headers: { authorization: valid },
+            });
+            assert.strictEqual(response.status, authorizedStatus, url);
+        }
+    } finally {
+        if (running) await running.close();
+        removeDir(dir);
+    }
+});
diff --git a/suite/p2p/P45-zero-byte-upload.js b/suite/p2p/P45-zero-byte-upload.js
new file mode 100644
index 0000000..b71676f
--- /dev/null
+++ b/suite/p2p/P45-zero-byte-upload.js
@@ -0,0 +1,35 @@
+
+const { assert, fs, path, removeDir, tempDir, runFeature, withServer, postMultipart } = require('../_harness');
+
+runFeature('P45 uploads preserve zero-byte files and ignore unrelated fields', async () => {
+    const dir = tempDir();
+    try {
+        await withServer({ sharePath: dir, receive: true }, async (server) => {
+            const zero = await postMultipart(server.base, '/upload', [
+                { field: 'selected', filename: 'empty.bin', content: '' },
+            ]);
+            assert.strictEqual(zero.status, 200);
+            assert.strictEqual(fs.statSync(path.join(dir, 'empty.bin')).size, 0);
+            // The original uploader accepted ordinary files larger than the
+            // text parser's independent 5 MiB limit; migration must preserve it.
+            const largeBytes = Buffer.alloc(5 * 1024 * 1024 + 1, 0x61);
+            const large = await postMultipart(server.base, '/upload', [
+                { field: 'selected', filename: 'large.bin', content: largeBytes },
+            ]);
+            assert.strictEqual(large.status, 200);
+            assert.deepStrictEqual(fs.readFileSync(path.join(dir, 'large.bin')), largeBytes);
+            const mixed = await postMultipart(server.base, '/upload', [
+                { field: 'other', filename: 'ignored.bin', content: 'ignore me' },
+                { field: 'selected', filename: 'kept.bin', content: 'keep me' },
+            ]);
+            assert.strictEqual(mixed.status, 200);
+            assert.ok(!fs.existsSync(path.join(dir, 'ignored.bin')));
+            assert.strictEqual(
+                fs.readFileSync(path.join(dir, 'kept.bin'), 'utf8'),
+                'keep me'
+            );
+        });
+    } finally {
+        removeDir(dir);
+    }
+});
diff --git a/suite/p2p/P46-auth-token-composition.js b/suite/p2p/P46-auth-token-composition.js
new file mode 100644
index 0000000..c351a50
--- /dev/null
+++ b/suite/p2p/P46-auth-token-composition.js
@@ -0,0 +1,36 @@
+'use strict';
+
+const { assert, fs, path, removeDir, tempDir, runFeature, request, startServer } = require('../_harness');
+
+runFeature('P46 basic authentication composes with capability tokens', async () => {
+    const dir = tempDir();
+    let running;
+    try {
+        fs.writeFileSync(path.join(dir, 'secret.txt'), 'combined secret', 'utf8');
+        running = await startServer({
+            sharePath: dir,
+            token: 'capability',
+            auth: { username: 'combo-user', password: 'combo-pass' },
+        });
+        const correct = 'Basic ' + Buffer.from('combo-user:combo-pass').toString('base64');
+        const wrong = 'Basic ' + Buffer.from('combo-user:wrong').toString('base64');
+        const noAuth = await request(running.base, '/share/capability/secret.txt');
+        assert.strictEqual(noAuth.status, 401);
+        const wrongAuth = await request(running.base, '/share/capability/secret.txt', {
+            headers: { authorization: wrong },
+        });
+        assert.strictEqual(wrongAuth.status, 401);
+        const wrongToken = await request(running.base, '/share/secret.txt', {
+            headers: { authorization: correct },
+        });
+        assert.strictEqual(wrongToken.status, 404);
+        const allowed = await request(running.base, '/share/capability/secret.txt', {
+            headers: { authorization: correct },
+        });
+        assert.strictEqual(allowed.status, 200);
+        assert.strictEqual(allowed.text, 'combined secret');
+    } finally {
+        if (running) await running.close();
+        removeDir(dir);
+    }
+});
diff --git a/suite/p2p/P47-once-invalid-upload-keeps-server.js b/suite/p2p/P47-once-invalid-upload-keeps-server.js
new file mode 100644
index 0000000..4809c68
--- /dev/null
+++ b/suite/p2p/P47-once-invalid-upload-keeps-server.js
@@ -0,0 +1,43 @@
+'use strict';
+
+const { assert, fs, path, removeDir, tempDir, runFeature, verifyOnceSequence } = require('../_harness');
+
+runFeature('P47 once mode ignores an invalid upload and closes after a valid one', async () => {
+    const dir = tempDir();
+    const boundary = '----sharing-once-valid-after-empty';
+    const valid = Buffer.concat([
+        Buffer.from('--' + boundary + '\r\n'),
+        Buffer.from(
+            'Content-Disposition: form-data; name="selected"; filename="after-empty.txt"\r\n' +
+            'Content-Type: application/octet-stream\r\n\r\n'
+        ),
+        Buffer.from('valid after empty upload'),
+        Buffer.from('\r\n--' + boundary + '--\r\n'),
+    ]);
+    try {
+        const result = await verifyOnceSequence(
+            { sharePath: dir, receive: true },
+            [
+                {
+                    method: 'POST',
+                    path: '/upload',
+                    headers: { 'content-type': 'application/x-www-form-urlencoded' },
+                    bodyBase64: Buffer.from('').toString('base64'),
+                },
+                {
+                    method: 'POST',
+                    path: '/upload',
+                    headers: { 'content-type': 'multipart/form-data; boundary=' + boundary },
+                    bodyBase64: valid.toString('base64'),
+                    waitMs: 250,
+                },
+            ]
+        );
+        assert.strictEqual(result.responses[0].status, 400);
+        assert.strictEqual(result.responses[1].status, 200);
+        assert.strictEqual(fs.readFileSync(path.join(dir, 'after-empty.txt'), 'utf8'), 'valid after empty upload');
+        assert.strictEqual(result.listening, false);
+    } finally {
+        removeDir(dir);
+    }
+});
