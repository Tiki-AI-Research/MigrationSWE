new file mode 100644
index 0000000..46c434d
--- /dev/null
+++ b/suite/p2p/P07-receive-form.js
@@ -0,0 +1,31 @@
+'use strict';
+const { assert, removeDir, tempDir, runFeature, withServer, request } = require('../_harness');
+runFeature('P07 receive form exposes upload controls', async () => {
+    const dir = tempDir();
+    try {
+        await withServer({ sharePath: dir, receive: true }, async (server) => {
+            const response = await request(server.base, '/receive');
+            assert.strictEqual(response.status, 200);
+            assert.match(response.text, /uploadForm/);
+            assert.match(response.text, /progress-bar/);
+            assert.match(response.text, /progress-text/);
+            const unregistered = await request(server.base, '/receive;ignored');
+            assert.strictEqual(unregistered.status, 404);
+            // Express automatically answered OPTIONS for registered routes.
+            for (const [route, methods] of [
+                ['/qr', ['GET', 'HEAD']], ['/receive', ['GET', 'HEAD']],
+                ['/upload', ['POST']], ['/text', ['POST']],
+            ]) {
+                const options = await request(server.base, route, { method: 'OPTIONS' });
+                assert.strictEqual(options.status, 200, 'OPTIONS ' + route);
+                assert.strictEqual(options.text, methods.join(','), route);
+                assert.deepStrictEqual(String(options.headers.allow).split(/\s*,\s*/).sort(), methods.sort(), route);
+            }
+            for (const route of ['/receive/', '/RECEIVE']) {
+                const equivalent = await request(server.base, route);
+                assert.strictEqual(equivalent.status, 200, route);
+                assert.strictEqual(equivalent.text, response.text, route);
+            }
+        });
+    } finally { removeDir(dir); }
+});
