+// Compare RFC 6266 disposition and the effective download filename. RFC 5987
+// filename* takes precedence over its optional legacy fallback filename.
+function contentDispositionMeaning(header) {
+    assert.strictEqual(typeof header, 'string', 'Content-Disposition must be present');
+    const parts = header.match(/(?:[^;"\r\n]|"(?:\\.|[^"\\\r\n])*")+/g);
+    assert.ok(parts && parts.join(';') === header, 'malformed Content-Disposition');
+    const type = parts.shift().trim().toLowerCase();
+    assert.match(type, /^[!#$%&'*+.^_`|~0-9a-z-]+$/);
+    const parameters = Object.create(null);
+    for (const part of parts) {
+        const match = /^\s*([!#$%&'*+.^_`|~0-9A-Za-z-]+)\s*=\s*(?:"((?:[\t\x20-\x21\x23-\x5b\x5d-\x7e\x80-\xff]|\\[\t\x20-\x7e\x80-\xff])*)"|([!#$%&'*+.^_`|~0-9A-Za-z-]+))\s*$/.exec(part);
