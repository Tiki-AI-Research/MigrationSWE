index 0000000..3bab869
--- /dev/null
+++ b/suite/p2p/P09-upload-existing-collision.js
@@ -0,0 +1,40 @@
+'use strict';
+const { assert, fs, path, removeDir, tempDir, runFeature, withServer, postMultipart } = require('../_harness');
+runFeature('P09 upload preserves an existing same-named file', async () => {
+    const dir = tempDir();
+    try {
+        fs.writeFileSync(path.join(dir, 'a.txt'), 'existing');
+        await withServer({ sharePath: dir, receive: true }, async (server) => {
+            const response = await postMultipart(server.base, '/upload', [
+                { field: 'selected', filename: 'a.txt', content: 'new-a' },
+            ]);
+            assert.strictEqual(response.status, 200);
+            assert.strictEqual(fs.readFileSync(path.join(dir, 'a.txt'), 'utf8'), 'existing');
+            assert.strictEqual(fs.readFileSync(path.join(dir, 'a (1).txt'), 'utf8'), 'new-a');
+            const ignored = await postMultipart(server.base, '/upload', [
+                { field: 'other', filename: 'ignored.txt', content: 'must not save' },
+            ]);
+            assert.strictEqual(ignored.status, 400);
+            assert.ok(!fs.existsSync(path.join(dir, 'ignored.txt')));
+            // The former upload middleware truncated names before the route's
+            // filename-safety/collision logic, rather than rejecting ENAMETOOLONG.
+            const longName = 'x'.repeat(260) + '.txt';
+            const longUpload = await postMultipart(server.base, '/upload', [
+                { field: 'selected', filename: longName, content: 'long-name payload' },
+            ]);
+            assert.strictEqual(longUpload.status, 200);
+            assert.strictEqual(fs.readFileSync(path.join(dir, longName.slice(0, 255)), 'utf8'), 'long-name payload');
+            // An unnamed octet-stream with data was a real upload; an empty
+            // unused file input remains covered separately by P45.
+            const before = new Set(fs.readdirSync(dir));
+            const unnamed = await postMultipart(server.base, '/upload', [
