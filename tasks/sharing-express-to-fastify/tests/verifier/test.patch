+'use strict';
+const { assert, removeDir, tempDir, runFeature, request, startServer } = require('../_harness');
+runFeature('P22 configured basic auth protects routes', async () => {
+    const dir = tempDir();
+    let running;
+    try {
+        running = await startServer({
+            sharePath: dir,
+            auth: { username: 'feature-user', password: 'feature-pass' },
+        });
+        const denied = await request(running.base, '/share/');
+        assert.strictEqual(denied.status, 401);
+        const token = Buffer.from('feature-user:feature-pass').toString('base64');
+        for (const scheme of ['Basic', 'basic', 'BASIC']) {
+            const allowed = await request(running.base, '/share/', {
+                headers: { Authorization: scheme + ' ' + token },
+            });
+            assert.strictEqual(allowed.status, 200, scheme);
+        }
+    } finally {
+        if (running) await running.close();
+    }
+});
