+'use strict';
+
+const { assert, removeDir, tempDir, runFeature, request, startServer } = require('../_harness');
+
+runFeature('P40 basic auth protects every public route', async () => {
+    const dir = tempDir();
+    let running;
+    try {
+        running = await startServer({
+            sharePath: dir,
+            receive: true,
+            allowZip: true,
+            auth: { username: 'matrix-user', password: 'matrix-pass' },
+        });
+        for (const route of ['/qr', '/receive', '/share/', '/zip']) {
+            const denied = await request(running.base, route);
+            assert.strictEqual(denied.status, 401, route);
