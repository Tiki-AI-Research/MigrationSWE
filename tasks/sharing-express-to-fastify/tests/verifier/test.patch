+            },
+            {
+                id: 'C14', method: 'POST', path: '/upload',
+                ...multipart([{ field: 'other', filename: 'ignored.txt', content: 'must not save' }]),
+            },
+            // Express ignored these bodies; the routes returned missing-data 400,
+            // rather than a framework-level unsupported-media-type 415.
+            {
+                id: 'C15', method: 'POST', path: '/upload',
+                headers: { 'content-type': 'application/octet-stream' },
+                body: 'unparsed binary payload',
+            },
+            {
+                id: 'C16', method: 'POST', path: '/text',
+                headers: { 'content-type': 'application/octet-stream' },
+                body: 'unparsed binary payload',
+            },
+        ];
+
+        for (const item of corpus) {
+            const requestOptions = { ...options, ...(item.options || {}) };
+            const baseResponse = await isolatedHttpAtRepo(BASE_REPO, requestOptions, item, false);
+            const candidateResponse = await isolatedHttpAtRepo(REPO, requestOptions, item, true);
+            assert.strictEqual(candidateResponse.status, baseResponse.status, item.id + ' status');
+            const baseType = contentType(baseResponse);
+            const candidateType = contentType(candidateResponse);
+            if (baseType && candidateType) {
+                assert.ok(
+                    (baseType.startsWith('text/') && candidateType.startsWith('text/')) ||
+                    baseType === candidateType,
+                    item.id + ' content type'
+                );
+            }
+            if (item.exactBody) assert.strictEqual(candidateResponse.text, baseResponse.text, item.id);
+            if (item.contains) assert.match(candidateResponse.text, new RegExp(item.contains), item.id);
+            if (item.expectedBody) assert.strictEqual(candidateResponse.text, item.expectedBody, item.id);
+            for (const header of item.headersToCompare || []) {
+                const meaning = header.toLowerCase() === 'content-disposition' ? contentDispositionMeaning : (value) => value;
+                assert.deepStrictEqual(meaning(candidateResponse.headers[header]), meaning(baseResponse.headers[header]), item.id + ' ' + header);
+            }
+        }
+    } finally {
+        removeDir(sharePath);
+    }
+});
