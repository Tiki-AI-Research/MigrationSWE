diff --git a/suite/p2p/P12-zip-download.js b/suite/p2p/P12-zip-download.js
new file mode 100644
index 0000000..64e6270
--- /dev/null
+++ b/suite/p2p/P12-zip-download.js
@@ -0,0 +1,36 @@
+'use strict';
+const { assert, contentDispositionMeaning, fs, path, removeDir, tempDir, runFeature, withServer, request } = require('../_harness');
+runFeature('P12 zip download streams an archive', async () => {
+    const dir = tempDir();
+    try {
+        fs.writeFileSync(path.join(dir, 'inside.txt'), 'inside');
+        const special = path.join(dir, 'quote"目录');
+        fs.mkdirSync(special);
+        fs.writeFileSync(path.join(special, 'inside.txt'), 'special');
+        await withServer({ sharePath: dir, allowZip: true }, async (server) => {
+            const options = await request(server.base, '/zip', { method: 'OPTIONS' });
+            assert.strictEqual(options.status, 200);
+            assert.strictEqual(options.text, 'GET,HEAD');
+            assert.deepStrictEqual(String(options.headers.allow).split(/\s*,\s*/).sort(), ['GET', 'HEAD']);
+            // Express's extended query parser distinguished arrays and objects.
+            // Ignoring bracketed keys silently archives the entire share root.
+            const objectPath = await request(server.base, '/zip?path%5Bx%5D=missing');
+            assert.strictEqual(objectPath.status, 404);
+            const arrayPath = await request(server.base, '/zip?path%5B%5D=' + encodeURIComponent('quote"目录'));
+            assert.strictEqual(arrayPath.status, 200);
+            assert.deepStrictEqual(contentDispositionMeaning(String(arrayPath.headers['content-disposition'] || '')), {
+                type: 'attachment', filename: 'quote"目录.zip',
+            });
+            const archive = await request(server.base, '/zip');
+            assert.strictEqual(archive.status, 200);
+            assert.strictEqual(archive.body.slice(0, 2).toString('latin1'), 'PK');
+            const specialArchive = await request(server.base, '/zip?path=' + encodeURIComponent('quote"目录'));
+            assert.strictEqual(specialArchive.status, 200);
+            assert.strictEqual(specialArchive.body.slice(0, 2).toString('latin1'), 'PK');
+            const disposition = String(specialArchive.headers['content-disposition'] || '');
+            assert.deepStrictEqual(contentDispositionMeaning(disposition), {
+                type: 'attachment', filename: 'quote"目录.zip',
+            });
+        });
+    } finally { removeDir(dir); }
+});
