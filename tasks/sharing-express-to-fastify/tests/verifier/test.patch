+        const token = Buffer.from('matrix-user:matrix-pass').toString('base64');
+        const allowed = await request(running.base, '/receive', {
+            headers: { authorization: 'Basic ' + token },
+        });
+        assert.strictEqual(allowed.status, 200);
+    } finally {
+        if (running) await running.close();
+        removeDir(dir);
