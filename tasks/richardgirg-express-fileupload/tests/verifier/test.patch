+
+const WATCHDOG = setTimeout(() => {
+  console.error(`CASE_WATCHDOG_TIMEOUT ${process.argv[2]}`);
+  process.exit(3);
+}, CASE_TIMEOUT_MS + 5000);
+
+async function main() {
+  const name = process.argv[2];
+  if (name === '--list') {
+    process.stdout.write(JSON.stringify(Object.keys(cases)));
+    clearTimeout(WATCHDOG);
+    process.exit(0);
+  }
+  if (!Object.prototype.hasOwnProperty.call(cases, name)) {
+    console.error(`UNKNOWN_CASE ${name}`);
+    process.exit(4);
+  }
+  await cases[name]();
+  clearTimeout(WATCHDOG);
+  process.stdout.write(JSON.stringify({ node: name, status: 'pass' }) + '\n');
+  process.exit(0);
+}
+
+main().catch((err) => {
+  clearTimeout(WATCHDOG);
+  console.error(`CASE_FAILED ${process.argv[2]}: ${err && err.message}`);
+  if (err && err.stack) console.error(err.stack);
+  process.exit(1);
+});
