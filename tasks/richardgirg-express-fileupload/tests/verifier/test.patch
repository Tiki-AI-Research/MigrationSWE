+async function checkLimitStopsParsing() {
+  const boundary = 'limit-stop-verification-boundary';
+  const payload = Buffer.from(
+    `--${boundary}\r\nContent-Disposition: form-data; name="first"; filename="first.txt"\r\n`
+    + 'Content-Type: text/plain\r\n\r\n123456789\r\n'
+    + `--${boundary}\r\nContent-Disposition: form-data; name="later"\r\n\r\nshould not parse\r\n`
+    + `--${boundary}\r\nContent-Disposition: form-data; name="second"; filename="second.txt"\r\n`
+    + 'Content-Type: text/plain\r\n\r\nABCDEFGHI\r\n'
+    + `--${boundary}--\r\n`
+  );
+  for (const withHandler of [false, true]) {
