+'use strict';
+
+/**
+ * Hidden F2P payload for the express-fileupload -> Koa 2 middleware migration.
+ *
+ * Every case is executed in its own Node process (see verifier.py) and targets
+ * one migration capability. A case passes only when the observable Koa mode
+ * behaviour matches the frozen contract; the process exit code is the verdict.
+ */
+
+const assert = require('assert');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const http = require('http');
+const { Socket } = require('net');
+const vm = require('vm');
+const { createRequire } = require('module');
+const { Readable, PassThrough, Duplex } = require('stream');
+const temporaryResourceDispatch = { observer: null, native: {} };
+for (const method of ['open', 'openSync', 'close', 'closeSync', 'write', 'writev', 'writeSync']) {
+  const original = fs[method];
+  temporaryResourceDispatch.native[method] = original;
+  const dispatched = function (...argumentsList) {
+    const observer = temporaryResourceDispatch.observer;
+    const implementation = observer && observer[method];
+    return (implementation || original).apply(this, argumentsList);
+  };
+  Object.defineProperties(dispatched, Object.getOwnPropertyDescriptors(original));
+  fs[method] = dispatched;
+}
+temporaryResourceDispatch.native.promiseOpen = fs.promises.open;
+const dispatchPromiseOpen = function (...argumentsList) {
+  const observer = temporaryResourceDispatch.observer;
+  const implementation = observer && observer.promiseOpen;
+  return (implementation || temporaryResourceDispatch.native.promiseOpen).apply(this, argumentsList);
+};
+Object.defineProperties(dispatchPromiseOpen, Object.getOwnPropertyDescriptors(fs.promises.open));
+fs.promises.open = dispatchPromiseOpen;
+const applicationOpenSync = fs.openSync;
+const Koa = require('koa');
+const request = require('supertest');
+const fileUpload = require('../lib/index');
+
+const CASE_TIMEOUT_MS = Number(process.env.KOA_CASE_TIMEOUT_MS || 15000);
+
+function mkTmp(prefix) {
+  return fs.mkdtempSync(path.join(os.tmpdir(), prefix));
+}
+
+function readDir(dir) {
+  try {
+    return fs.readdirSync(dir);
+  } catch (err) {
+    return ['<unreadable>'];
+  }
+}
+
+function writeFixture(dir, name, content) {
+  const target = path.join(dir, name);
+  fs.writeFileSync(target, content);
+  return target;
+}
+
+function wait(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function withTimeout(promise, message) {
+  let timer;
+  const timeout = new Promise((resolve, reject) => {
+    timer = setTimeout(() => reject(new Error(message)), 4000);
+  });
+  return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
+}
+
+function createApp(options, options2) {
+  const app = new Koa();
+  const errors = [];
+  app.on('error', (err) => errors.push(err));
+  const middleware = fileUpload(options);
+  return { app, errors, middleware };
+}
+
+// Build a Koa context with a stream-backed request, as in a live HTTP request.
+// Koa's createContext accepts a plain object, but that object lacks req.pipe()
+// and can incorrectly send a valid Koa middleware down its Express path.
+function koaContext(app, method, url) {
+  const req = Readable.from([]);
+  req.headers = {};
+  req.method = method || 'GET';
+  req.url = url || '/';
+  req.socket = new Socket();
+  const res = {};
+  const ctx = app.createContext(req, res);
+  ctx.method = method || 'GET';
+  return ctx;
+}
+
+function multipartContext(includeField = true) {
+  const boundary = 'streamed-verification-boundary';
+  let payload = `--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="limited.txt"\r\n`
+    + 'Content-Type: text/plain\r\n\r\nHello World 1\r\n';
+  if (includeField) {
+    payload += `--${boundary}\r\nContent-Disposition: form-data; name="later"\r\n\r\ncontinued\r\n`;
+  }
+  const buffer = Buffer.from(`${payload}--${boundary}--\r\n`);
+  const req = Readable.from([buffer]);
+  req.method = 'POST';
+  req.url = '/';
+  req.headers = { 'content-type': `multipart/form-data; boundary=${boundary}`, 'content-length': String(buffer.length) };
+  req.socket = new Socket();
+  req.complete = true;
+  return new Koa().createContext(req, new http.ServerResponse(req));
+}
+
+function multipartHeaderPayload(boundary) {
+  const parts = ['Alice', 'Bob'].map((value) =>
+    `--${boundary}\r\nContent-Disposition: form-data; name="user[name]"\r\n\r\n${value}\r\n`);
+  for (const [index, content] of ['first upload café', 'second upload'].entries()) {
+    parts.push(`--${boundary}\r\nContent-Disposition: form-data; name="user[avatar]"; filename="avatar${index}.txt"\r\n`
+      + `Content-Type: text/plain\r\n\r\n${content}\r\n`);
+  }
+  return Buffer.from(parts.join('') + `--${boundary}--\r\n`);
+}
+
+const FROZEN_EXPRESS_CONTENT_TYPE = /^multipart\/[\w'"()+-_?/:=,.]+(?:; ?[\w'"()+-_?/:=,.]*)+$/i;
+const FROZEN_EXPRESS_BYPASS_METHODS = new Set(['GET', 'HEAD', 'DELETE', 'OPTIONS', 'CONNECT', 'TRACE']);
+
+function frozenExpressEligible(headers, method = 'POST') {
+  try {
+    const hasBody = ('transfer-encoding' in headers) ||
+      ('content-length' in headers && headers['content-length'] !== '0');
+    const contentType = headers['content-type'];
+    return hasBody && !FROZEN_EXPRESS_BYPASS_METHODS.has(method) &&
+      contentType.includes('boundary=') && FROZEN_EXPRESS_CONTENT_TYPE.test(contentType);
+  } catch {
+    return false;
+  }
+}
+
+function assertMultipartHeaderBypass(result, label) {
+  assert.strictEqual(result.error, undefined, label);
+  assert.strictEqual(result.errorCalls, 0, label);
+  assert.strictEqual(result.downstreamCalls, 1, label);
+  assert.strictEqual(result.pipeCalls, 0, `${label}: a frozen bypass must not enter multipart parsing`);
+  assert.strictEqual(result.observation.body, result.sentinelBody, label);
+  assert.strictEqual(result.observation.files, result.sentinelFiles, label);
+  assert.deepStrictEqual(result.temporaryFiles, [], label);
+}
+
+async function inspectMultipartHeaderRequest(mode, headers, payload, options, method = 'POST', forbidParsing = false) {
+  const compose = require('koa-compose');
+  const express = createRequire(require.resolve('../lib/index'))('express');
+  const tempDir = mkTmp('multipart-header-case-');
+  const originalCreate = fs.createWriteStream;
+  const streams = [];
+  const closed = [];
+  fs.createWriteStream = function (filename, writeOptions) {
+    const stream = originalCreate.call(fs, filename, writeOptions);
+    if (filename.startsWith(`${tempDir}${path.sep}`)) {
+      streams.push(stream);
+      closed.push(new Promise((resolve) => stream.once('close', resolve)));
+    }
+    return stream;
+  };
+  const req = Readable.from([payload]);
+  req.method = method;
+  req.url = '/';
+  req.headers = headers;
+  req.complete = true;
+  const originalContentType = headers['content-type'];
+  const sentinelBody = { previous: 'body' };
+  const sentinelFiles = { previous: 'files' };
+  let pipeCalls = 0;
+  if (forbidParsing) {
+    req.body = sentinelBody;
+    req.files = sentinelFiles;
+    req.pipe = () => { pipeCalls += 1; throw new Error('a bypassed request must not enter multipart parsing'); };
+  }
+  const socket = new PassThrough();
+  socket.resume();
+  req.socket = socket;
+  const res = new http.ServerResponse(req);
+  res.assignSocket(socket);
+  let downstreamCalls = 0;
+  let errorCalls = 0;
+  let observation;
+  let error;
+  const observe = (body, files) => {
+    downstreamCalls += 1;
+    const uploaded = options.parseNested ? files && files.user && files.user.avatar
+      : files && files['user[avatar]'];
+    observation = { body, files, temporaryFiles: readDir(tempDir), contents: (uploaded || []).map((file) => ({
+      name: file.name, size: file.size, md5: file.md5, truncated: file.truncated,
+      content: (options.useTempFiles ? fs.readFileSync(file.tempFilePath) : file.data).toString(),
+      dataIsBuffer: Buffer.isBuffer(file.data), dataLength: file.data.length,
+      tempFilePath: file.tempFilePath
+    })), bodyAlias: body === req.body, filesAlias: files === req.files };
+  };
+  try {
+    const middleware = fileUpload({ ...options, tempFileDir: tempDir });
+    if (mode === 'koa') {
+      const ctx = new Koa().createContext(req, res);
+      if (forbidParsing) { ctx.request.body = sentinelBody; ctx.request.files = sentinelFiles; }
+      try {
+        await withTimeout(compose([middleware, async () => {
+          observe(ctx.request.body, ctx.request.files);
+          await Promise.resolve();
+        }])(ctx), 'header request did not settle');
+      } catch (caught) { error = caught; errorCalls += 1; }
+    } else {
+      const application = express();
+      let resolveDone;
+      const done = new Promise((resolve) => { resolveDone = resolve; });
+      application.post('/', middleware, (request, response) => {
+        observe(request.body, request.files);
+        resolveDone();
+      });
+      application.use((caught, request, response, next) => {
+        error = caught; errorCalls += 1; resolveDone();
+      });
+      if (method !== 'POST') {
+        application.use(middleware, (request, response) => {
+          observe(request.body, request.files); resolveDone();
+        });
+      }
+      application.handle(req, res, () => {});
+      await withTimeout(done, 'Express header request did not settle');
+    }
+    return { downstreamCalls, errorCalls, error, observation, pipeCalls, sentinelBody, sentinelFiles,
+      headersUnchanged: req.headers === headers && headers['content-type'] === originalContentType,
+      temporaryFiles: readDir(tempDir) };
+  } finally {
+    req.destroy();
+    for (const stream of streams) {
+      if (!stream.writableEnded && !stream.destroyed) stream.destroy();
+    }
+    await withTimeout(Promise.all(closed), 'header fixture streams did not close');
+    fs.createWriteStream = originalCreate;
+    socket.destroy();
+    fs.rmSync(tempDir, { recursive: true, force: true });
+  }
+}
+
+async function checkMultipartHeaderVariants() {
+  const Busboy = createRequire(require.resolve('../lib/index'))('busboy');
+  const { createHash } = require('crypto');
+  const variants = [
+    ['canonical', 'TokenBoundary', (boundary) => `multipart/form-data; boundary=${boundary}`],
+    ['uppercase_type', 'MixedCaseBoundary', (boundary) => `MULTIPART/FORM-DATA; boundary=${boundary}`],
+    ['uppercase_parameter', 'MixedCaseBoundary', (boundary) => `multipart/form-data; BOUNDARY=${boundary}`],
+    ['mixedcase_parameter', 'MixedCaseBoundary', (boundary) => `multipart/form-data; Boundary=${boundary}`],
+    ['tab', 'MixedCaseBoundary', (boundary) => `multipart/form-data;\tboundary=${boundary}`],
+    ['spaces', 'MixedCaseBoundary', (boundary) => `multipart/form-data;  boundary=${boundary}`],
+    ['no_space', 'MixedCaseBoundary', (boundary) => `multipart/form-data;boundary=${boundary}`],
+    ['before_semicolon', 'MixedCaseBoundary', (boundary) => `multipart/form-data \t; BOUNDARY=${boundary}`],
+    ['quoted', 'MixedCaseBoundary', (boundary) => `multipart/form-data; BOUNDARY=${JSON.stringify(boundary)}`],
+    ['preceding_parameter', 'MixedCaseBoundary', (boundary) => `multipart/form-data; charset=UTF-8; BOUNDARY=${boundary}`],
+    ['following_parameter', 'MixedCaseBoundary', (boundary) => `multipart/form-data; BOUNDARY=${boundary}; charset="UTF-8"`],
+    ['quoted_spaces', 'Boundary With Spaces', (boundary) => `multipart/form-data; BOUNDARY=${JSON.stringify(boundary)}`],
+    ['quoted_semicolon', 'Boundary;Semicolon', (boundary) => `multipart/form-data; BOUNDARY=${JSON.stringify(boundary)}`],
+    ['quoted_quote', 'Boundary"Quoted', (boundary) => `multipart/form-data; BOUNDARY=${JSON.stringify(boundary)}`],
+    ['quoted_backslash', 'Boundary\\Backslash', (boundary) => `multipart/form-data; BOUNDARY=${JSON.stringify(boundary)}`],
+    ['lookalike_parameter', 'MixedCaseBoundary', (boundary) => `multipart/form-data; note="boundary=wrong"; BOUNDARY=${boundary}`],
+    ['duplicate_parameter', 'MixedCaseBoundary', (boundary) => `multipart/form-data; BOUNDARY=${boundary}; boundary=wrong`],
+    ['trailing_whitespace', 'MixedCaseBoundary', (boundary) => `multipart/form-data; BOUNDARY=${boundary}\t `]
+  ];
+  for (const [name, boundary, format] of variants) {
+    const contentType = format(boundary);
+    const payload = multipartHeaderPayload(boundary);
+    const parser = Busboy({ headers: { 'content-type': contentType } });
+    const fields = [];
+    const contents = [];
+    const parsed = new Promise((resolve, reject) => {
+      parser.on('field', (field, value) => fields.push([field, value]));
+      parser.on('file', (field, stream) => {
+        const chunks = [];
+        stream.on('data', (chunk) => chunks.push(chunk));
+        stream.on('end', () => contents.push(Buffer.concat(chunks).toString()));
+        stream.on('error', reject);
+      });
+      parser.on('error', reject);
+      parser.on('finish', resolve);
+    });
+    Readable.from([payload]).pipe(parser);
+    await withTimeout(parsed, `${name}: native Busboy did not parse`);
+    assert.deepStrictEqual(fields, [['user[name]', 'Alice'], ['user[name]', 'Bob']], name);
+    assert.deepStrictEqual(contents, ['first upload café', 'second upload'], name);
+    for (const mode of ['koa', 'express']) {
+      for (const useTempFiles of [false, true]) {
+        for (const parseNested of [false, true]) {
+          for (const framing of ['length', 'chunked']) {
+            const label = `${name}/${mode}/${useTempFiles}/${parseNested}/${framing}`;
+            const headers = { 'content-type': contentType };
+            if (framing === 'length') headers['content-length'] = String(payload.length);
+            else headers['transfer-encoding'] = 'chunked';
+            const bypass = mode === 'express' && !frozenExpressEligible(headers);
+            const result = await inspectMultipartHeaderRequest(mode, headers, payload,
+              { useTempFiles, parseNested }, 'POST', bypass);
+            if (bypass) {
+              assertMultipartHeaderBypass(result, label);
+              continue;
+            }
+            assert.strictEqual(result.error, undefined, label);
+            assert.strictEqual(result.downstreamCalls, 1, label);
+            assert.strictEqual(result.errorCalls, 0, label);
+            const observed = result.observation;
+            assert(observed.bodyAlias && observed.filesAlias, label);
+            const values = parseNested ? observed.body && observed.body.user && observed.body.user.name
+              : observed.body && observed.body['user[name]'];
+            assert.deepStrictEqual(values, ['Alice', 'Bob'], `${label}: fields must parse and accumulate`);
+            assert.strictEqual(observed.contents.length, 2, `${label}: files must parse and accumulate`);
+            for (const [index, file] of observed.contents.entries()) {
+              const expected = contents[index];
+              assert.strictEqual(file.name, `avatar${index}.txt`, label);
+              assert.strictEqual(file.content, expected, `${label}: persistence must precede downstream`);
+              assert.strictEqual(file.size, Buffer.byteLength(expected), label);
+              assert.strictEqual(file.md5, createHash('md5').update(expected).digest('hex'), label);
+              assert.strictEqual(file.truncated, false, label);
+              assert.strictEqual(file.dataIsBuffer, true, label);
+              assert.strictEqual(file.dataLength, useTempFiles ? 0 : Buffer.byteLength(expected), label);
+              assert.strictEqual(Boolean(file.tempFilePath), useTempFiles, label);
+            }
+            // Persistence is required at downstream entry; ordinary post-downstream cleanup is allowed.
+            assert.strictEqual(observed.temporaryFiles.length, useTempFiles ? 2 : 0, label);
+          }
+        }
+      }
+    }
+  }
+}
+
+async function checkMultipartHeaderBypassGuards() {
+  await checkEmptyMultipartBoundary();
+  const boundary = 'GuardMixedCaseBoundary';
+  const payload = multipartHeaderPayload(boundary);
+  const types = [`multipart/form-data; boundary=${boundary}`, `multipart/form-data; BOUNDARY=${boundary}`,
+    `multipart/form-data;\tBoundary=${boundary}`, `multipart/form-data;  BOUNDARY="${boundary}"`];
+  const cases = [];
+  for (const contentType of types) {
+    for (const method of ['GET', 'HEAD', 'DELETE', 'OPTIONS', 'CONNECT', 'TRACE']) {
+      for (const framing of ['length', 'chunked']) cases.push({ contentType, method, framing });
+    }
+    for (const framing of ['missing', 'zero']) cases.push({ contentType, method: 'POST', framing });
+  }
+  for (const contentType of [undefined, 'application/json', 'application/x-www-form-urlencoded',
+    'text/plain; boundary=wrong', 'multipart/form-data']) {
+    for (const framing of ['length', 'chunked']) cases.push({ contentType, method: 'POST', framing });
+  }
+  for (const scenario of cases) {
+    for (const mode of ['koa', 'express']) {
+      for (const useTempFiles of [false, true]) {
+        const headers = {};
+        if (scenario.contentType !== undefined) headers['content-type'] = scenario.contentType;
+        if (scenario.framing === 'length') headers['content-length'] = String(payload.length);
+        if (scenario.framing === 'zero') headers['content-length'] = '0';
+        if (scenario.framing === 'chunked') headers['transfer-encoding'] = 'chunked';
+        const result = await inspectMultipartHeaderRequest(mode, headers, payload, { useTempFiles }, scenario.method, true);
+        const label = `${mode}/${useTempFiles}/${JSON.stringify(scenario)}`;
+        assert.strictEqual(result.error, undefined, label);
+        assert.strictEqual(result.downstreamCalls, 1, label);
+        assert.strictEqual(result.pipeCalls, 0, `${label}: invalid upload candidates must not be parsed`);
+        assert.strictEqual(result.observation.body, result.sentinelBody, label);
+        assert.strictEqual(result.observation.files, result.sentinelFiles, label);
+        assert.deepStrictEqual(result.temporaryFiles, [], label);
+      }
+    }
+  }
+  // Koa requires a positive length or chunked transfer coding before either
+  // multipart-header eligibility branch; Express retains its frozen guard.
+  for (const framing of [
+    { 'content-length': '-1' },
+    { 'content-length': 'invalid' },
+    { 'transfer-encoding': 'gzip' },
+    { 'transfer-encoding': 'identity' }
+  ]) {
+    for (const useTempFiles of [false, true]) {
+      const headers = { 'content-type': `multipart/form-data; boundary=${boundary}`, ...framing };
+      const result = await inspectMultipartHeaderRequest('koa', headers, payload,
+        { useTempFiles }, 'POST', true);
+      assertMultipartHeaderBypass(result, `koa/invalid-framing/${JSON.stringify(framing)}/${useTempFiles}`);
+    }
+  }
+  for (const contentType of ['multipart/form-data; boundary=', 'multipart/form-data; boundary=""',
+    'multipart/form-data; BOUNDARY=""', 'multipart/form-data; note="boundary=wrong"']) {
+    for (const mode of ['koa', 'express']) {
+      for (const useTempFiles of [false, true]) {
+        for (const framing of ['length', 'chunked']) {
+          const headers = { 'content-type': contentType };
+          if (framing === 'length') headers['content-length'] = String(payload.length);
+          else headers['transfer-encoding'] = 'chunked';
+          const bypass = mode === 'express' && !frozenExpressEligible(headers);
+          const result = await inspectMultipartHeaderRequest(mode, headers, payload, { useTempFiles }, 'POST', bypass);
+          if (bypass) {
+            assertMultipartHeaderBypass(result, `${mode}/${contentType}/${useTempFiles}/${framing}`);
+            continue;
+          }
+          assert(result.error instanceof Error, contentType);
+          assert.strictEqual(result.errorCalls, 1, contentType);
+          assert.strictEqual(result.downstreamCalls, 0, contentType);
+          assert.deepStrictEqual(result.temporaryFiles, [], contentType);
+        }
+      }
+    }
+  }
+}
+
+async function checkEmptyMultipartBoundary(kinds = ['fields', 'files', 'mixed']) {
+  // Busboy 1.6 accepts an empty quoted boundary when the body uses the matching
+  // separators. A body with a different boundary only tests accidental parse
+  // failure and cannot prove the Koa empty-boundary contract.
+  const formats = [
+    (boundary) => `multipart/form-data; boundary="${boundary}"`,
+    (boundary) => `multipart/form-data; BOUNDARY="${boundary}"`,
+    (boundary) => `multipart/form-data;\tBoundary="${boundary}"`
+  ];
+  for (const boundary of ['', 'EmptyBoundaryControl']) {
+    for (const kind of kinds) {
+      const parts = [];
+      if (kind !== 'files') {
+        for (const value of ['Alice', 'Bob']) {
+          parts.push(`--${boundary}\r\nContent-Disposition: form-data; name="user[name]"\r\n\r\n${value}\r\n`);
+        }
+      }
+      if (kind !== 'fields') {
+        for (const [index, content] of ['first upload', 'second upload'].entries()) {
+          parts.push(`--${boundary}\r\nContent-Disposition: form-data; name="user[avatar]"; filename="avatar${index}.txt"\r\n`
+            + `Content-Type: text/plain\r\n\r\n${content}\r\n`);
+        }
+      }
+      const payload = Buffer.from(parts.join('') + `--${boundary}--\r\n`);
+      for (const format of formats) for (const framing of ['length', 'chunked']) {
+        for (const mode of ['koa', 'express']) for (const useTempFiles of [false, true]) {
+          for (const parseNested of [false, true]) {
+            const headers = { 'content-type': format(boundary) };
+            if (framing === 'length') headers['content-length'] = String(payload.length);
+            else headers['transfer-encoding'] = 'chunked';
+            const bypass = mode === 'express' && !frozenExpressEligible(headers);
+            const result = await inspectMultipartHeaderRequest(mode, headers, payload,
+              { useTempFiles, parseNested }, 'POST', bypass);
+            const label = `${mode}/${JSON.stringify(boundary)}/${kind}/${framing}/${useTempFiles}/${parseNested}/${headers['content-type']}`;
+            if (bypass) {
+              assertMultipartHeaderBypass(result, label);
+            } else if (mode === 'koa' && boundary === '') {
+              assert(result.error instanceof Error, `${label}: empty boundary must reject even with a matching body`);
+              assert.strictEqual(result.errorCalls, 1, label);
+              assert.strictEqual(result.downstreamCalls, 0, label);
+              assert.deepStrictEqual(result.temporaryFiles, [], `${label}: rejected upload leaked temporary files`);
+            } else {
+              // Express keeps its frozen eligibility and Busboy behavior. A Koa
+              // validation guard must not change the compatible Express path.
+              assert.strictEqual(result.error, undefined, label);
+              assert.strictEqual(result.errorCalls, 0, label);
+              assert.strictEqual(result.downstreamCalls, 1, label);
+              assert(result.observation.bodyAlias && result.observation.filesAlias, label);
+              if (kind !== 'files') {
+                const body = result.observation.body;
+                assert.deepStrictEqual(parseNested ? body.user.name : body['user[name]'], ['Alice', 'Bob'], label);
+              }
+              assert.deepStrictEqual(result.observation.contents.map((file) => file.content),
+                kind === 'fields' ? [] : ['first upload', 'second upload'], label);
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+async function checkMultipartHeaderErrorCleanup() {
+  for (const [cause, format] of [
+    ['abort', (value) => value.replace('boundary=', 'BOUNDARY=')],
+    ['write_failure', (value) => value.replace('; ', ';  ')],
+    ['handler_error', (value) => value.replace('; boundary=', ';\tBoundary=')]
+  ]) {
+    await checkNativeTempDescriptorCleanup(cause, (value, mode) => mode === 'express' ? value : format(value));
+  }
+}
