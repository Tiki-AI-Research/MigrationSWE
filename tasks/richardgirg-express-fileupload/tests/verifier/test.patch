+        }
+        if (scenario === 'moved') {
+          assert(fs.existsSync(destination), `${label}: moved destination must survive cleanup`);
+          assert.strictEqual(fs.readFileSync(destination, 'utf8'), contents[0], label);
+        }
+        if (applicationOwnsDescriptors) {
+          assert.strictEqual(applicationDescriptors.length, style === 'none' ? 1 : 3, label);
+          applicationDescriptors.forEach((descriptor) => assert(fs.fstatSync(descriptor).isFile(),
+            `${label}: middleware must not close application-owned descriptors`));
+        }
+      } finally {
+        releaseNext();
+        releaseCloses();
+        req.destroy();
+        req.socket.destroy();
+        await tracker.finish();
+        applicationDescriptors.forEach((descriptor) => fs.closeSync(descriptor));
+        await wait(10);
+        fs.rmSync(tempDir, { recursive: true, force: true });
+        fs.rmSync(destinationDir, { recursive: true, force: true });
+      }
+    }
+  }
+}
