+              assert.deepStrictEqual(filesAtError, [], `${label}: temporary files were not cleaned`);
+            } finally {
+              ctx.req.destroy();
+              fs.rmSync(tempDir, { recursive: true, force: true });
+            }
+          }
+        }
+      }
+    }
+  }
