+        for (const abortOnLimit of [false, true]) {
+          for (const outcome of ['throw', 'reject']) {
+            const label = `${kind}/${mode}/${useTempFiles}/${abortOnLimit}/${outcome}`;
+            const tempDir = mkTmp('opaque-handler-error-');
+            const ctx = multipartContext();
+            const primitives = { null: null, undefined: undefined, zero: 0, false: false };
+            const value = Object.prototype.hasOwnProperty.call(primitives, kind)
+              ? primitives[kind] : callbackErrorValue(kind, 'status').value;
+            let handlerFinished = false;
+            let downstreamCalls = 0;
+            const failHandler = () => {
+              handlerFinished = true;
+              if (outcome === 'throw') throw value;
+              return Promise.reject(value);
+            };
+            const limitHandler = mode === 'koa2'
+              ? (context, next) => failHandler()
+              : (req, res, next) => failHandler();
+            const middleware = fileUpload({
+              useTempFiles, tempFileDir: tempDir, abortOnLimit, limits: { fileSize: 5 }, limitHandler
+            });
+            let actualError;
+            let filesAtError;
+            try {
+              if (mode === 'express') {
+                let notifyNext;
+                const nextDone = new Promise((resolve) => { notifyNext = resolve; });
+                let nextCalls = 0;
+                middleware(ctx.req, ctx.res, (error) => {
+                  nextCalls += 1;
+                  actualError = error;
+                  filesAtError = readDir(tempDir);
+                  if (!error) downstreamCalls += 1;
+                  notifyNext();
+                });
+                await withTimeout(nextDone, `${label}: Express error did not settle`);
+                assert.strictEqual(nextCalls, 1, label);
+              } else {
+                await withTimeout(middleware(ctx, () => { downstreamCalls += 1; }), `${label}: Koa error did not settle`)
+                  .then(() => { throw new Error(`${label}: opaque handler error was swallowed`); }, (error) => {
+                    actualError = error;
+                    filesAtError = readDir(tempDir);
+                  });
+              }
+              if (kind === 'foreign-error') {
