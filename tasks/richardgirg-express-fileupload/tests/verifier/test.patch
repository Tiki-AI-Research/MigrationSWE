+async function checkKoaLimitedTempSettlement(scenarios = ['ordinary', 'limited', 'moved', 'downstream_error', 'application_descriptors', 'cached_application_descriptors']) {
+  for (const scenario of scenarios) {
+    for (const style of ['none', 'koa', 'legacy']) {
+      const label = `${scenario}/${style}`;
+      const limited = scenario !== 'ordinary';
+      const tempDir = mkTmp('koa-limited-settlement-');
+      const destinationDir = mkTmp('koa-limited-moved-');
+      const sentinel = writeFixture(tempDir, 'other-request.tmp', 'another request');
+      const destination = path.join(destinationDir, 'kept.txt');
+      const boundary = 'koa-limited-settlement-boundary';
+      const originals = ['123456789', 'xy', 'abcdefghi'];
+      const contents = originals.map((value) => limited ? value.slice(0, 5) : value);
+      const parts = originals.map((value, index) =>
+        `--${boundary}\r\nContent-Disposition: form-data; name="upload"; filename="file${index}.txt"\r\n`
+        + `Content-Type: text/plain\r\n\r\n${value}\r\n`);
+      parts.push(`--${boundary}\r\nContent-Disposition: form-data; name="later"\r\n\r\ncontinued\r\n`);
+      const payload = Buffer.from(parts.join('') + `--${boundary}--\r\n`);
+      const req = Readable.from([payload]);
+      req.method = 'POST';
+      req.url = '/';
+      req.complete = true;
+      req.headers = { 'content-type': `multipart/form-data; boundary=${boundary}`, 'content-length': String(payload.length) };
+      req.socket = new Socket();
+      const ctx = new Koa().createContext(req, new http.ServerResponse(req));
+      const expectedError = new Error('limited downstream original error');
+      const applicationDescriptors = [];
+      const applicationOwnsDescriptors = scenario === 'application_descriptors' || scenario === 'cached_application_descriptors';
+      const openApplicationFile = scenario === 'cached_application_descriptors' ? applicationOpenSync : fs.openSync;
+      let closeReleaseTimer;
+      let notifyWriter;
+      const writerCreated = new Promise((resolve) => { notifyWriter = resolve; });
+      const tracker = trackTemporaryResources(tempDir, { holdCloses: true, excluded: ['other-request.tmp'],
+        onResource: (entries) => { if (entries.length) notifyWriter(); },
+        onClose: () => { if (!closeReleaseTimer) closeReleaseTimer = setTimeout(releaseCloses, 200); } });
+      const resources = tracker.resources;
+      let releaseNext;
+      const nextGate = new Promise((resolve) => { releaseNext = resolve; });
+      let notifyNext;
+      const nextEntered = new Promise((resolve) => { notifyNext = resolve; });
+      let settled = false;
+      let downstreamCalls = 0;
+      let handlerFinished = 0;
+      let uploaded = [];
+      const releaseCloses = () => {
+        clearTimeout(closeReleaseTimer);
+        tracker.releaseCloses();
+      };
+      try {
+        const options = { useTempFiles: true, tempFileDir: tempDir, abortOnLimit: false };
+        if (limited) options.limits = { fileSize: 5 };
+        const handleLimit = async (noopNext) => {
+          if (applicationOwnsDescriptors) {
+            await withTimeout(writerCreated, label);
+            await withTimeout(tracker.resources[0].opened.promise, label);
+            applicationDescriptors.push(openApplicationFile(tracker.resources[0].filename, 'r'));
+          }
+          await noopNext();
+          await wait(5);
+          handlerFinished += 1;
+        };
+        if (style === 'koa') options.limitHandler = (context, noopNext) => handleLimit(noopNext);
+        if (style === 'legacy') options.limitHandler = (request, response, noopNext) => handleLimit(noopNext);
+        if (options.limitHandler) options.limitHandler = tracker.application(options.limitHandler);
+        const upload = Promise.resolve(fileUpload(options)(ctx, tracker.application(async () => {
+          downstreamCalls += 1;
+          assert.strictEqual(ctx.request.files, req.files, label);
+          assert.strictEqual(ctx.request.body, req.body, label);
+          assert.strictEqual(ctx.request.body.later, 'continued', label);
+          assert.strictEqual(handlerFinished, limited && style !== 'none' ? 2 : 0, label);
