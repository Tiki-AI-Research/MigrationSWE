+        }
+        releaseCloses();
+        const result = await withTimeout(upload, `${label}: middleware did not settle after close`);
+        if (scenario === 'downstream_error') {
+          assert.strictEqual(result.error, expectedError, `${label}: downstream original error must propagate`);
+        } else {
+          assert.ifError(result.error);
+        }
+        assert.strictEqual(downstreamCalls, 1, label);
+        assert(fs.existsSync(sentinel), `${label}: other request temporary file must be preserved`);
+        assert.strictEqual(fs.readFileSync(sentinel, 'utf8'), 'another request', label);
+        if (limited) {
+          assert.deepStrictEqual(readDir(tempDir), ['other-request.tmp'],
