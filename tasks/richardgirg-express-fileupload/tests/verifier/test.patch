+async function checkRepeatedEmptyFields() {
+  for (const parseNested of [false, true]) {
+    for (const values of [['', 'next'], ['', ''], ['', 'next', 'last'], ['first', '']]) {
+      const boundary = 'repeated-empty-field-boundary';
+      const key = parseNested ? 'user[tag]' : 'tag';
+      const payload = Buffer.from(values.map(value =>
+        `--${boundary}\r\nContent-Disposition: form-data; name="${key}"\r\n\r\n${value}\r\n`
+      ).join('') + `--${boundary}--\r\n`);
+      const req = Readable.from([payload]);
+      req.method = 'POST';
+      req.url = '/';
+      req.complete = true;
+      req.headers = { 'content-type': `multipart/form-data; boundary=${boundary}`,
+        'content-length': String(payload.length) };
+      req.socket = new Socket();
+      const ctx = new Koa().createContext(req, new http.ServerResponse(req));
+      let downstreamCalls = 0;
+      try {
+        await withTimeout(fileUpload({ parseNested })(ctx, async () => {
+          downstreamCalls += 1;
+          const actual = parseNested ? ctx.request.body.user.tag : ctx.request.body.tag;
+          assert.deepStrictEqual(actual, values, 'same-name fields must retain empty values and order');
+          assert.strictEqual(ctx.request.body, ctx.req.body);
+          assert.strictEqual(ctx.request.files, null);
+          assert.strictEqual(ctx.req.files, null);
+        }), 'repeated empty fields must complete');
+        assert.strictEqual(downstreamCalls, 1);
+      } finally {
+        req.destroy();
+        req.socket.destroy();
+      }
+    }
+  }
+}
