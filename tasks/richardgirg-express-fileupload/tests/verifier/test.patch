+async function checkExpressRoutingControl() {
+  const express = createRequire(require.resolve('../lib/index'))('express');
+  const continuingScenarios = [
+    'routing-sync', 'routing-await', 'routing-duplicates', 'routing-multifile',
+    'callback-error', 'routing-callback-error', 'routing-reject',
+    'throw-string', 'reject-string', 'normal-next'
+  ];
+  const abortingScenarios = continuingScenarios.filter((scenario) => {
+    return scenario !== 'routing-multifile' && scenario !== 'normal-next';
+  });
+  for (const command of ['route', 'router']) {
+    for (const useTempFiles of [false, true]) {
+      for (const abortOnLimit of [false, true]) {
+        for (const scenario of abortOnLimit ? abortingScenarios : continuingScenarios) {
+          const label = `${command}/${useTempFiles}/${abortOnLimit}/${scenario}`;
+          const tempDir = mkTmp('express-routing-');
+          const boundary = 'routing-verification-boundary';
+          const part = (filename) => `--${boundary}\r\n`
+            + `Content-Disposition: form-data; name="bundle[file]"; filename="${filename}"\r\n`
+            + 'Content-Type: text/plain\r\n\r\n123456789';
+          const fileCount = scenario === 'routing-multifile' ? 3 : 1;
+          const head = Buffer.from(part('first.txt'));
+          const tail = Buffer.from('\r\n'
+            + (fileCount === 3 ? `${part('second.txt')}\r\n${part('third.txt')}\r\n` : '')
+            + `--${boundary}\r\nContent-Disposition: form-data; name="meta[later]"\r\n\r\nparsed\r\n`
+            + `--${boundary}--\r\n`);
+          const req = new Readable({ read() {} });
+          req.method = 'POST';
+          req.url = '/area/upload';
+          req.headers = {
+            'content-type': `multipart/form-data; boundary=${boundary}`,
+            'content-length': String(head.length + tail.length)
+          };
+          req.complete = false;
+          req.push(head);
+          const socket = new PassThrough();
+          socket.resume();
+          req.socket = socket;
+          const res = new http.ServerResponse(req);
+          res.assignSocket(socket);
+          const expectedError = new Error(`routing handler failed: ${label}`);
+          const laterError = new Error('a later callback cannot replace the first error');
+          const otherCommand = command === 'route' ? 'router' : 'route';
+          let releaseHandler;
+          let notifyEntered;
+          let notifyResponse;
+          const handlerGate = new Promise((resolve) => { releaseHandler = resolve; });
+          const entered = new Promise((resolve) => { notifyEntered = resolve; });
+          const responseFinished = new Promise((resolve) => { notifyResponse = resolve; });
+          res.once('finish', notifyResponse);
+          let handlerCalls = 0;
+          let handlersFinished = 0;
+          const forwarded = [];
+          const visits = [];
+          const errors = [];
+          const middleware = fileUpload({
+            abortOnLimit, useTempFiles, tempFileDir: tempDir, parseNested: true,
+            limits: { fileSize: 5 },
+            limitHandler: (request, response, next) => {
+              handlerCalls += 1;
+              notifyEntered();
+              assert.strictEqual(request, req, label);
+              assert.strictEqual(response, res, label);
+              const send = (value) => {
+                const result = next(value);
+                if (result && typeof result.catch === 'function') result.catch(() => {});
+                return result;
+              };
+              if (scenario === 'throw-string') {
+                handlersFinished += 1;
+                throw command;
+              }
+              if (scenario === 'callback-error') {
+                send(expectedError);
+                send(command);
+                send(laterError);
+                send();
+              } else if (scenario === 'normal-next' || scenario === 'routing-duplicates') {
+                for (const value of [undefined, null, false, 0, '']) send(value);
+                if (scenario === 'routing-duplicates') {
+                  send(command);
+                  send(otherCommand);
+                  send();
+                }
+              } else if (scenario !== 'reject-string') {
+                send(scenario === 'routing-multifile' && handlerCalls > 1 ? otherCommand : command);
+              }
+              if (scenario === 'routing-sync') {
+                handlersFinished += 1;
+                return;
+              }
+              return handlerGate.then(() => {
+                handlersFinished += 1;
+                if (scenario === 'routing-callback-error') {
+                  send(expectedError);
+                  send(laterError);
+                  send(otherCommand);
+                  send();
+                }
+                if (scenario === 'routing-reject') throw expectedError;
+                if (scenario === 'reject-string') throw command;
+                if (scenario === 'routing-await') return send(command);
+              });
+            }
+          });
+          const application = express();
+          const observe = (name) => (request, response) => {
+            const files = request.files && request.files.bundle && request.files.bundle.file;
+            visits.push({
+              name,
+              handlersFinished,
+              complete: request.complete,
+              later: request.body && request.body.meta && request.body.meta.later,
+              files: [].concat(files || []).map((file) => ({
+                truncated: file.truncated,
+                size: file.size,
+                contents: (useTempFiles ? fs.readFileSync(file.tempFilePath) : file.data).toString()
+              }))
+            });
+            response.status(200).end(name);
+          };
+          const router = express.Router();
+          router.post('/upload', (request, response, next) => {
+            middleware(request, response, (argument) => {
+              forwarded.push(argument);
+              next(argument);
+            });
+          }, observe('same-route'));
+          router.post('/upload', observe('route-fallback'));
+          application.use('/area', router);
+          application.post('/area/upload', observe('router-fallback'));
+          application.use((error, request, response, next) => {
+            errors.push({ error, handlersFinished, tempFiles: readDir(tempDir) });
+            response.status(500).end('error');
+          });
+          try {
+            application.handle(req, res);
+            await withTimeout(entered, `${label}: limit handler did not run`);
+            const deferred = scenario !== 'routing-sync' && scenario !== 'throw-string';
+            await wait(2);
+            if (deferred || !abortOnLimit && scenario === 'routing-sync') {
+              assert.deepStrictEqual(forwarded, [], `${label}: callback forwarded before completion`);
+              assert.deepStrictEqual(visits, [], label);
+              assert.deepStrictEqual(errors, [], label);
+            }
+            const finishUpload = () => {
+              req.complete = true;
+              req.push(tail);
+              req.push(null);
+            };
+            if (scenario === 'routing-duplicates' || scenario === 'routing-multifile') {
+              releaseHandler();
+              await wait(2);
+              assert.deepStrictEqual(forwarded, [], `${label}: parsing was still pending`);
+              finishUpload();
+            } else {
+              finishUpload();
+              await wait(2);
+              if (deferred) assert.deepStrictEqual(forwarded, [], `${label}: handler was still pending`);
+              releaseHandler();
+            }
+            await withTimeout(responseFinished, `${label}: Express did not complete`);
+            await wait(2);
+            const isError = scenario.includes('error') || scenario.includes('reject') || scenario === 'throw-string';
+            assert.strictEqual(handlerCalls, fileCount, label);
+            assert.strictEqual(handlersFinished, fileCount, label);
+            if (isError) {
+              assert.strictEqual(forwarded.length, 1, label);
+              assert.strictEqual(errors.length, 1, label);
+              assert.deepStrictEqual(visits, [], label);
+              assert.strictEqual(res.statusCode, 500, label);
+              const error = errors[0].error;
+              if (scenario === 'throw-string' || scenario === 'reject-string') {
+                assert(error instanceof Error, label);
+                assert.strictEqual(error.message, command, label);
+              } else {
+                assert.strictEqual(error, expectedError, label);
+              }
+              assert.strictEqual(errors[0].handlersFinished, fileCount, label);
+              assert.deepStrictEqual(errors[0].tempFiles, [], `${label}: files were not cleaned before error`);
+            } else if (abortOnLimit) {
+              assert.deepStrictEqual(forwarded, [], `${label}: abort must not dispatch routing controls`);
+              assert.deepStrictEqual(visits, [], label);
+              assert.deepStrictEqual(errors, [], label);
+              assert.strictEqual(res.statusCode, 413, label);
+              assert.deepStrictEqual(readDir(tempDir), [], label);
+            } else {
+              assert.deepStrictEqual(forwarded, [scenario === 'normal-next' ? undefined : command], label);
+              assert.deepStrictEqual(errors, [], label);
+              assert.strictEqual(res.statusCode, 200, label);
+              assert.deepStrictEqual(visits, [{
+                name: scenario === 'normal-next' ? 'same-route' : `${command}-fallback`,
+                handlersFinished: fileCount,
+                complete: true,
+                later: 'parsed',
