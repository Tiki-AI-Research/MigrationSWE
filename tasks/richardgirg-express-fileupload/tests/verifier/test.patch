+async function checkExpressAsyncLimitHandler() {
+  const ctx = multipartContext();
+  let handlerCalls = 0;
+  let handlerFinished = false;
+  let nextCalls = 0;
+  let handlerFinishedAtNext = false;
+  const middleware = fileUpload({
+    limits: { fileSize: 5 },
+    abortOnLimit: false,
+    limitHandler: async () => {
+      handlerCalls += 1;
+      await wait(75);
+      handlerFinished = true;
+    }
+  });
+  const nextFinished = new Promise((resolve, reject) => {
+    try {
+      const result = middleware(ctx.req, ctx.res, (err) => {
+        nextCalls += 1;
+        handlerFinishedAtNext = handlerFinished;
+        if (err) reject(err);
+        else resolve();
+      });
+      if (result && typeof result.then === 'function') Promise.resolve(result).catch(reject);
+    } catch (err) {
+      reject(err);
+    }
+  });
+  await withTimeout(nextFinished, 'Express middleware did not call next');
+  await wait(100);
+  assert.strictEqual(handlerCalls, 1);
+  assert.strictEqual(handlerFinishedAtNext, true, 'Express next must wait for the limit handler Promise');
+  assert.strictEqual(nextCalls, 1);
+}
+
+async function checkExpressLimitHandlerCallsNext() {
+  for (const useTempFiles of [false, true]) {
+    for (const awaitNext of [false, true]) {
+      const ctx = multipartContext();
+      const tempDir = mkTmp('express-limit-next-');
+      let handlerCalls = 0;
+      let handlerFinished = false;
+      let handlerFinishedAtNext = false;
+      let nextCalls = 0;
+      let fileAtNext;
+      let contentsAtNext;
+      let readError;
+      try {
+        const middleware = fileUpload({
+          useTempFiles,
+          tempFileDir: tempDir,
+          limits: { fileSize: 5 },
+          abortOnLimit: false,
+          limitHandler: async (req, res, next) => {
+            handlerCalls += 1;
+            if (awaitNext) await next();
+            else next();
+            await wait(75);
+            handlerFinished = true;
+          }
+        });
+        const nextFinished = new Promise((resolve, reject) => {
+          try {
+            const result = middleware(ctx.req, ctx.res, (err) => {
+              nextCalls += 1;
+              if (nextCalls === 1) {
+                handlerFinishedAtNext = handlerFinished;
+                fileAtNext = ctx.req.files && ctx.req.files.file;
+                if (fileAtNext) {
+                  try {
+                    contentsAtNext = useTempFiles ? fs.readFileSync(fileAtNext.tempFilePath) : fileAtNext.data;
+                  } catch (error) {
+                    readError = error;
+                  }
+                }
+              }
+              if (err) reject(err);
+              else resolve();
+            });
+            if (result && typeof result.then === 'function') Promise.resolve(result).catch(reject);
+          } catch (err) {
+            reject(err);
+          }
+        });
+        await withTimeout(nextFinished, 'Express limit handler next did not finish');
+        await wait(100);
+        assert.strictEqual(handlerCalls, 1);
+        assert.strictEqual(handlerFinishedAtNext, true, 'Express next must wait for the handler Promise');
+        assert.strictEqual(nextCalls, 1, 'Express next must run exactly once');
+        assert(fileAtNext && fileAtNext.truncated, 'the truncated file must be available at next');
+        assert.ifError(readError);
+        assert.strictEqual(contentsAtNext.toString(), 'Hello', 'the file must be flushed before next');
+      } finally {
+        ctx.req.destroy();
+        fs.rmSync(tempDir, { recursive: true, force: true });
+      }
+    }
+  }
