+async function checkInterruptedTempCleanup(interruption) {
+  const boundary = 'interrupted-temp-boundary';
+  const tempDir = mkTmp('koa-interrupted-open-');
+  const originalOpen = fs.open;
+  const req = new Readable({ read() {} });
+  const socket = new PassThrough();
+  socket.resume();
+  req.method = 'POST';
+  req.url = '/';
+  req.headers = { 'content-type': `multipart/form-data; boundary=${boundary}`, 'transfer-encoding': 'chunked' };
+  req.socket = socket;
+  req.complete = false;
+  const res = new http.ServerResponse(req);
+  res.statusCode = 404;
+  const ctx = new Koa().createContext(req, res);
+  let downstreamCalls = 0;
+  let settled = false;
+  fs.open = function (file, ...args) {
+    if (typeof file === 'string' && file.startsWith(`${tempDir}${path.sep}`)) {
+      setTimeout(() => originalOpen.call(fs, file, ...args), 200);
+      return;
+    }
+    return originalOpen.call(fs, file, ...args);
+  };
+  try {
+    const uploadTimeout = interruption === 'timeout' ? 80 : 10000;
+    const middleware = fileUpload({ useTempFiles: true, tempFileDir: tempDir, uploadTimeout });
+    const upload = Promise.resolve(middleware(ctx, async () => { downstreamCalls += 1; })).then(
+      () => { settled = true; return { error: null }; },
+      (error) => { settled = true; return { error }; }
+    );
+    req.push(`--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="partial.txt"\r\n`
+      + 'Content-Type: text/plain\r\n\r\npartial data');
+    await wait(30);
+    assert.strictEqual(settled, false, 'an incomplete upload must not settle before interruption');
+    if (interruption === 'abort') {
+      req.aborted = true;
+      req.destroy();
+      req.emit('aborted');
+      socket.destroy();
+    }
+    const result = await withTimeout(upload, `${interruption} upload did not settle`);
+    const filesAtSettlement = readDir(tempDir);
+    await wait(250);
+    assert.strictEqual(downstreamCalls, 0, 'downstream must not run after an interrupted upload');
+    if (interruption === 'timeout') {
+      assert(result.error instanceof Error && /^Upload timeout for /.test(result.error.message),
+        'upload timeout must reject with the documented error');
+    }
+    assert.deepStrictEqual(filesAtSettlement, [], `${interruption} must remove temporary files before settling`);
+    assert.deepStrictEqual(readDir(tempDir), [], `${interruption} must not leave a delayed temporary file`);
+  } finally {
+    fs.open = originalOpen;
+    req.destroy();
+    socket.destroy();
+  }
+}
