+async function checkExpressRequestErrorInterruption() {
+  for (const useTempFiles of [false, true]) {
+    for (const owner of [0, 1]) {
+      for (const interruption of ['error', 'abort', 'timeout']) {
+        const label = `${useTempFiles}/${owner}/${interruption}`;
+        const boundary = 'request-error-interruption-boundary';
+        const tempDir = mkTmp('express-request-error-interruption-');
+        const req = new Readable({ read() {} });
+        req.method = 'POST';
+        req.url = '/';
+        req.headers = { 'content-type': `multipart/form-data; boundary=${boundary}`, 'transfer-encoding': 'chunked' };
+        req.complete = false;
+        const socket = new PassThrough();
+        socket.resume();
+        req.socket = socket;
+        const res = new http.ServerResponse(req);
+        res.assignSocket(socket);
+        const callbackGates = [requestErrorGate(), requestErrorGate()];
+        const callbackDone = [requestErrorGate(), requestErrorGate()];
+        const completionGates = [requestErrorGate(), requestErrorGate()];
+        const completionDone = [requestErrorGate(), requestErrorGate()];
+        const entered = requestErrorGate();
+        const nextDone = requestErrorGate();
+        const finished = [false, false];
+        const callbacks = [];
+        const requestError = new Error('raw request error must interrupt a pending callback error');
+        let handlerCalls = 0;
+        const middleware = fileUpload({
+          limits: { fileSize: 5 }, abortOnLimit: false, useTempFiles, tempFileDir: tempDir,
+          uploadTimeout: interruption === 'timeout' ? 100 : 10000,
+          limitHandler: async (request, response, next) => {
+            const invocation = handlerCalls++;
+            assert(invocation < 2, label);
+            if (handlerCalls === 2) entered.release();
+            await callbackGates[invocation].promise;
+            next(new Error(`callback error from file ${invocation}`));
+            callbackDone[invocation].release();
+            await completionGates[invocation].promise;
+            finished[invocation] = true;
+            completionDone[invocation].release();
+          }
+        });
+        try {
+          middleware(req, res, (error) => {
+            callbacks.push({ error, ownerFinished: finished[owner], files: readDir(tempDir) });
+            nextDone.release();
+          });
+          for (const filename of ['first.txt', 'second.txt']) {
+            req.push(`--${boundary}\r\nContent-Disposition: form-data; name="files"; filename="${filename}"\r\n`
+              + 'Content-Type: text/plain\r\n\r\n123456789\r\n');
+          }
+          req.push(`--${boundary}\r\nContent-Disposition: form-data; name="pending"; filename="pending.txt"\r\n`
+            + 'Content-Type: text/plain\r\n\r\nabc');
+          await withTimeout(entered.promise, `${label}: both handlers did not start`);
+          for (const invocation of [owner, 1 - owner]) {
+            callbackGates[invocation].release();
+            await withTimeout(callbackDone[invocation].promise, `${label}: callback did not run`);
+          }
+          completionGates[1 - owner].release();
+          await withTimeout(completionDone[1 - owner].promise, `${label}: later handler did not finish`);
+          await new Promise((resolve) => setImmediate(resolve));
+          assert.deepStrictEqual(callbacks, [], `${label}: first error must remain pending`);
+          if (interruption === 'error') req.emit('error', requestError);
+          if (interruption === 'abort') {
+            req.aborted = true;
+            req.emit('aborted');
+          }
+          await withTimeout(nextDone.promise, `${label}: interruption waited for the pending handler`);
+          assert.strictEqual(callbacks.length, 1, label);
+          assert.strictEqual(callbacks[0].ownerFinished, false, `${label}: request termination must not await the handler`);
+          assert.deepStrictEqual(callbacks[0].files, [], `${label}: interruption must clean all temporary files`);
+          if (interruption === 'error') assert.strictEqual(callbacks[0].error, requestError, label);
+          else {
+            assert(callbacks[0].error instanceof Error, label);
+            if (interruption === 'timeout') assert.match(callbacks[0].error.message, /^Upload timeout for /, label);
+          }
+          completionGates[owner].release();
+          await withTimeout(completionDone[owner].promise, `${label}: pending handler did not finish`);
+          await new Promise((resolve) => setImmediate(resolve));
+          assert.strictEqual(callbacks.length, 1, `${label}: a late handler must not propagate again`);
+          assert.deepStrictEqual(readDir(tempDir), [], label);
+        } finally {
+          callbackGates.forEach((gate) => gate.release());
+          completionGates.forEach((gate) => gate.release());
+          req.destroy();
+          socket.destroy();
+          fs.rmSync(tempDir, { recursive: true, force: true });
+        }
+      }
+    }
+  }
