+async function checkCompletedUploadRequestInterruption(abortOnLimit = false) {
+  // EOF completes the parser, but not the handler or the middleware. Neither
+  // parser finish nor persistence may retire the request's error boundary.
+  for (const mode of ['express', 'koa2', 'koa3']) {
+    for (const useTempFiles of [false, true]) {
+      for (const committed of [false, true]) {
+        for (const interruption of ['error', 'abort']) {
+          for (const timing of mode === 'express' ? ['before_eof', 'after_eof'] : ['none']) {
+            for (const handlerRejects of [false, true]) {
+              const label = `${mode}/${useTempFiles}/${committed}/${abortOnLimit}/${interruption}/${timing}/${handlerRejects}`;
+              const tempDir = mkTmp('completed-upload-interruption-');
+              const tracker = trackTemporaryResources(tempDir);
+              const { req, res, socket, prefix, suffix } = lateCallbackRequest('chunked', false);
+              const entered = requestErrorGate();
+              const completion = requestErrorGate();
+              const handlerDone = requestErrorGate();
+              const ended = requestErrorGate();
+              const forwarded = requestErrorGate();
+              const callbackError = new Error('pending handler callback error');
+              const terminalError = new Error('request error after multipart EOF');
+              const laterError = new Error('later handler rejection');
+              const callbacks = [];
+              let downstreamCalls = 0;
+              let handlerStarted = false;
+              let handlerFinished = false;
+              let capturedNext;
+              req.on('end', ended.release);
+              // An external listener must not substitute for the middleware's
+              // own terminal-event handling, nor make an emitted error uncaught.
+              req.on('error', () => {});
+              const handleLimit = async (next) => {
+                handlerStarted = true;
+                capturedNext = next;
+                if (mode === 'express' && timing === 'before_eof') next(callbackError);
+                entered.release();
+                await completion.promise;
+                handlerFinished = true;
+                handlerDone.release();
+                if (handlerRejects) throw laterError;
+              };
+              const limitHandler = mode === 'koa2'
+                ? (ctx, next) => handleLimit(next)
+                : (request, response, next) => handleLimit(next);
+              const middleware = fileUpload({
+                useTempFiles, tempFileDir: tempDir, uploadTimeout: 10000,
+                limits: { fileSize: 5 }, abortOnLimit,
+                limitHandler: tracker.application(limitHandler)
+              });
+              const record = (error) => {
+                callbacks.push({ error, handlerFinished, paths: readDir(tempDir), descriptors: tracker.remaining() });
+                forwarded.release();
+              };
+              try {
+                if (committed) res.writeHead(202, { 'content-type': 'text/plain' });
+                if (mode === 'express') {
+                  const returned = middleware(req, res, (error) => {
+                    if (!error) downstreamCalls += 1;
+                    record(error);
+                  });
+                  // Express return values do not replace its callback contract.
+                  if (returned && typeof returned.catch === 'function') returned.catch(() => {});
+                } else {
+                  const ctx = new Koa().createContext(req, res);
+                  Promise.resolve(middleware(ctx, async () => { downstreamCalls += 1; }))
+                    .then(() => record(undefined), record);
+                }
+                req.push(prefix);
+                await withTimeout(entered.promise, `${label}: handler did not start`);
+                req.complete = true;
+                req.push(suffix);
+                req.push(null);
+                await withTimeout(ended.promise, `${label}: request did not reach EOF`);
+                await new Promise((resolve) => setImmediate(resolve));
+                if (mode === 'express' && timing === 'after_eof') capturedNext(callbackError);
+                assert.deepStrictEqual(callbacks, [], `${label}: unfinished handler must still be awaited`);
+                if (interruption === 'error') req.emit('error', terminalError);
+                else { req.aborted = true; req.emit('aborted'); }
+                await withTimeout(forwarded.promise, `${label}: EOF must not disable request interruption`);
+                assert.strictEqual(callbacks.length, 1, label);
+                const observed = callbacks[0];
+                assert.strictEqual(observed.handlerFinished, false, `${label}: terminal event must interrupt the handler wait`);
+                if (interruption === 'error') assert.strictEqual(observed.error, terminalError, label);
+                else assert(observed.error instanceof Error && observed.error !== callbackError && observed.error !== laterError, label);
+                assert.strictEqual(downstreamCalls, 0, label);
+                assert.deepStrictEqual(observed.paths, [], `${label}: cleanup must precede propagation`);
+                assert.deepStrictEqual(observed.descriptors, [], `${label}: release resources before propagation`);
+                if (committed) assert.strictEqual(res.statusCode, 202, label);
+                completion.release();
+                await withTimeout(handlerDone.promise, `${label}: handler teardown did not finish`);
+                await new Promise((resolve) => setImmediate(resolve));
+                assert.strictEqual(callbacks.length, 1, `${label}: late handler settlement must not dispatch again`);
+              } finally {
+                completion.release();
+                if (handlerStarted) await withTimeout(handlerDone.promise, `${label}: handler teardown`);
+                req.destroy();
+                await tracker.finish();
+                socket.destroy();
+                fs.rmSync(tempDir, { recursive: true, force: true });
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+}
