+    await checkNativeTempDescriptorCleanup('write_failure');
+    const fixtures = mkTmp('koa-wf-');
+    const file = writeFixture(fixtures, 'data.txt', 'write me');
+    // The temporary directory is unreachable for every uid: a child path of a
+    // regular file can never exist (ENOTDIR), so the write failure no longer
+    // depends on file permissions or on the effective user of the evaluator.
+    const notADir = writeFixture(fixtures, 'not-a-dir', 'plain file');
+    const badDir = path.join(notADir, 'nested');
+    const { app, errors } = createApp();
+    app.use(fileUpload({ useTempFiles: true, tempFileDir: badDir }));
+    let downstreamRan = false;
+    app.use((ctx) => {
+      downstreamRan = true;
+      ctx.body = 'ok';
+    });
+
+    try {
+      await request(app.callback()).post('/').attach('file', file);
+    } catch (err) {
+      // connection errors are tolerated; the propagation signal is the app error
+    }
+    for (let i = 0; i < 30 && errors.length === 0; i += 1) {
+      await wait(100);
+    }
+
+    assert(errors.length > 0, 'a write failure must surface as a Koa error');
+    const message = String(errors[0] && errors[0].message);
+    assert(/ENOENT|EACCES|EPERM|ENOTDIR|no such file|not a directory|permission/i.test(message), `unexpected error: ${message}`);
+    assert.strictEqual(downstreamRan, false, 'downstream must not run after a write failure');
+  },
+
+  // 13. Non-multipart GET bypasses parsing and continues the pipeline.
+  koa_bypass: async () => {
+    await checkMultipartHeaderBypassGuards();
+    await checkKoaBypassErrorPromise();
+    const app = new Koa();
+    const middleware = fileUpload();
+    let observed = null;
+    app.use(middleware);
+    app.use((ctx) => {
+      observed = { method: ctx.method, files: ctx.request.files };
+      ctx.body = { handled: true };
+    });
+
+    const returned = middleware(koaContext(app, 'GET', '/'), () => Promise.resolve());
+    assert(returned && typeof returned.then === 'function', 'Koa middleware must return a Promise');
+    await returned;
+
+    const res = await request(app.callback()).get('/');
+    assert.strictEqual(res.status, 200, `expected 200, got ${res.status}`);
+    assert.deepStrictEqual(res.body, { handled: true });
+    assert.deepStrictEqual(observed, { method: 'GET', files: undefined });
+  },
+
+  // 14. Empty-filename zero-byte submissions yield no file objects or temp files.
+  koa_empty_and_zero_byte: async () => {
+    const tempDir = mkTmp('koa-empty-store-');
+    const { app } = createApp();
+    app.use(fileUpload({ useTempFiles: true, tempFileDir: tempDir }));
+    app.use((ctx) => {
+      ctx.body = { filesIsNull: ctx.request.files === null };
+    });
+
+    const res = await request(app.callback()).post('/').attach('file', Buffer.from(''), '');
+    assert.strictEqual(res.status, 200, `expected 200, got ${res.status}`);
+    assert.strictEqual(res.body.filesIsNull, true, 'empty submission must not create a file object');
+    await wait(200);
+    assert.deepStrictEqual(readDir(tempDir), [], 'empty submission must not leave temp artifacts');
+  },
+
+  // 15. HEAD/DELETE/OPTIONS bypass multipart processing in Koa mode.
+  koa_bypass_methods: async () => {
+    const app = new Koa();
+    const middleware = fileUpload();
+    const bypassed = [];
+    app.use(middleware);
+    app.use((ctx) => {
+      bypassed.push(ctx.method);
+      ctx.body = { handled: true };
+    });
+
+    const headRes = await request(app.callback()).head('/');
+    assert.strictEqual(headRes.status, 200);
+    const deleteRes = await request(app.callback()).delete('/');
+    assert.strictEqual(deleteRes.status, 200);
+    const optionsRes = await request(app.callback()).options('/');
+    assert.strictEqual(optionsRes.status, 200);
+    assert.deepStrictEqual(bypassed, ['HEAD', 'DELETE', 'OPTIONS']);
+
+    const returned = middleware(koaContext(app, 'DELETE', '/'), () => Promise.resolve());
+    assert(returned && typeof returned.then === 'function', 'bypass path must still return a Promise');
+    await returned;
+  },
+
+  // 16. Chunked multipart requests (no Content-Length) are parsed.
+  koa_missing_content_length: async () => {
+    await checkMultipartHeaderVariants();
+    await checkMultipartHeaderErrorCleanup();
+    const fixtures = mkTmp('koa-cl-');
+    const file = writeFixture(fixtures, 'chunked.txt', 'chunked body');
+    const boundary = '----koaChunkedBoundary';
+    const raw = Buffer.concat([
+      Buffer.from(`--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="chunked.txt"\r\nContent-Type: text/plain\r\n\r\n`),
+      Buffer.from('chunked body'),
+      Buffer.from(`\r\n--${boundary}--\r\n`)
+    ]);
+
+    const app = new Koa();
+    app.use(fileUpload());
+    app.use((ctx) => {
+      ctx.body = { name: ctx.request.files && ctx.request.files.file.name, data: ctx.request.files && ctx.request.files.file.data.toString() };
+    });
+    const server = app.listen(0);
+    const port = server.address().port;
+
+    const response = await new Promise((resolve, reject) => {
+      const req = http.request({
+        port,
+        method: 'POST',
+        path: '/',
+        headers: {
+          'content-type': `multipart/form-data; boundary=${boundary}`,
+          'transfer-encoding': 'chunked'
+        }
+      }, (res) => {
+        let text = '';
+        res.setEncoding('utf8');
+        res.on('data', (chunk) => { text += chunk; });
+        res.on('end', () => resolve({ status: res.statusCode, text }));
+      });
+      req.on('error', reject);
+      req.write(raw.subarray(0, 10));
+      setTimeout(() => { req.write(raw.subarray(10)); req.end(); }, 20);
+    });
+
+    server.close();
+    assert.strictEqual(response.status, 200, `expected 200, got ${response.status}`);
+    assert.deepStrictEqual(JSON.parse(response.text), { name: 'chunked.txt', data: 'chunked body' });
+    assert(file.length > 0);
+  },
+
+  // 17. abortOnLimit=false truncates, continues parsing and reaches downstream.
+  koa_limit_continue: async () => {
+    await checkExpressRoutingControl();
+    await checkCommittedResponseContinuation();
+    await checkMultiFileLimitLifecycle();
+    await checkExpressAsyncLimitHandler();
+    await checkExpressLimitHandlerCallsNext();
+    const fixtures = mkTmp('koa-continue-');
+    const file = writeFixture(fixtures, 'limited.txt', 'Hello World 1');
+    const app = new Koa();
+    let downstreamRan = false;
+    app.use(fileUpload({ limits: { fileSize: 5 } }));
+    app.use((ctx) => {
+      downstreamRan = true;
+      const uploaded = ctx.request.files.file;
+      ctx.body = { truncated: uploaded.truncated, size: uploaded.size, data: uploaded.data.toString() };
+    });
+
+    const res = await request(app.callback()).post('/').attach('file', file);
+    assert.strictEqual(res.status, 200, `expected 200, got ${res.status}`);
+    assert.deepStrictEqual(res.body, { truncated: true, size: 5, data: 'Hello' });
+    assert.strictEqual(downstreamRan, true);
+    await checkLimitContinuationWithResponse();
+    await checkLegacyNonAbortingLimitHandler();
+  },
+
+  // 18. Legacy 3-parameter limitHandler receives (req, res, next).
+  koa_legacy_limit_handler: async () => {
+    const fixtures = mkTmp('koa-legacy-');
+    const file = writeFixture(fixtures, 'legacy.txt', 'w'.repeat(4096));
+    const app = new Koa();
+    const seen = { calls: 0, gotNodeReq: false, resHasSetHeader: false, nextIsFn: false };
+    app.use(fileUpload({
+      limits: { fileSize: 8 },
+      abortOnLimit: true,
+      limitHandler: function (req, res, next) {
+        seen.calls += 1;
+        seen.gotNodeReq = Boolean(req && req.headers && typeof req.method === 'string');
+        seen.resHasSetHeader = Boolean(res && typeof res.setHeader === 'function');
+        seen.nextIsFn = typeof next === 'function';
+        res.statusCode = 413;
+        res.setHeader('content-type', 'text/plain');
+        res.end('legacy limit handler');
+        next();
+      }
+    }));
+    let downstreamRan = false;
+    app.use((ctx) => {
+      downstreamRan = true;
+      ctx.body = 'downstream';
+    });
+
+    const res = await request(app.callback()).post('/').attach('file', file);
+    assert.strictEqual(res.status, 413, `expected 413, got ${res.status}`);
+    assert.strictEqual(res.text, 'legacy limit handler');
+    assert.deepStrictEqual(seen, { calls: 1, gotNodeReq: true, resHasSetHeader: true, nextIsFn: true });
+    assert.strictEqual(downstreamRan, false, 'guarded next must not run the real downstream');
+  },
+
+  // 19. Errors thrown by limitHandler propagate to the caller.
+  koa_limit_handler_throws: async () => {
+    await checkExpressLateCallbackErrors();
+    await checkExpressLateCallbackPriority();
+    await checkExpressLateCallbackHttp();
+    await checkNativeTempDescriptorCleanup('handler_error');
+    await checkExpressRequestErrorPriority();
+    await checkExpressRequestErrorInterruption();
+    await checkCompletedUploadRequestInterruption();
+    await checkCompletedUploadRequestInterruption(true);
+    await checkExpressCallbackValues();
+    await checkOpaqueHandlerErrors();
+    await checkExpressAbortingLimitHandler();
+    await checkExpressNonAbortingCallbackError();
+    await checkNonAbortingLimitHandlerError();
+    const fixtures = mkTmp('koa-lht-');
+    const file = writeFixture(fixtures, 'boom.txt', 'v'.repeat(4096));
+    const app = new Koa();
+    const errors = [];
+    app.on('error', (err) => errors.push(err));
+    app.use(fileUpload({
+      limits: { fileSize: 8 },
+      abortOnLimit: true,
+      limitHandler: async () => {
+        throw new Error('limit handler exploded');
+      }
+    }));
+    let downstreamRan = false;
+    app.use((ctx) => {
+      downstreamRan = true;
+      ctx.body = 'downstream';
+    });
+
+    try {
+      await request(app.callback()).post('/').attach('file', file);
+    } catch (err) {
+      // connection level errors are tolerated
+    }
+    await wait(200);
+
+    const matched = errors.find((err) => err && String(err.message).includes('limit handler exploded'));
+    assert(matched, `limit handler error must propagate, saw: ${errors.map((e) => e && e.message).join(', ')}`);
+    assert.strictEqual(downstreamRan, false);
+  },
+
+  // 20. Already-sent headers must not be overwritten and must not hang.
+  koa_limit_handler_sent_headers: async () => {
+    await checkNullBodyPreserved();
+    await checkUncommittedInitialStatus();
+    const fixtures = mkTmp('koa-sent-');
+    const file = writeFixture(fixtures, 'sent.txt', 'u'.repeat(4096));
+    const app = new Koa();
+    app.use(async (ctx, next) => {
+      ctx.res.writeHead(200, { 'content-type': 'text/plain' });
+      ctx.res.write('early-');
+      await next();
+    });
+    app.use(fileUpload({ limits: { fileSize: 8 }, abortOnLimit: true, responseOnLimit: 'SHOULD_NOT_APPEAR' }));
+    app.use((ctx) => {
+      ctx.body = 'downstream';
+    });
+
+    const res = await request(app.callback()).post('/').attach('file', file);
+    assert.strictEqual(res.status, 200, `expected committed 200, got ${res.status}`);
+    assert(!res.text.includes('SHOULD_NOT_APPEAR'), 'committed response must not be overwritten');
+    assert(res.text.startsWith('early-'), `committed payload must survive, got ${JSON.stringify(res.text)}`);
+
+    // An upstream body assignment also commits the response before headers are sent.
+    for (const withHandler of [false, true]) {
+      const presetApp = new Koa();
+      let downstreamRan = false;
+      let handlerCalls = 0;
+      presetApp.use(async (ctx, next) => {
+        ctx.body = 'early body';
+        await next();
+      });
+      const options = {
+        limits: { fileSize: 8 },
+        abortOnLimit: true,
+        responseOnLimit: 'SHOULD_NOT_APPEAR'
+      };
+      if (withHandler) {
+        options.limitHandler = async function (ctxArg, noopNext) {
+          handlerCalls += 1;
+          assert(ctxArg && ctxArg.request, 'limitHandler must receive the Koa context');
+          assert.strictEqual(typeof noopNext, 'function');
+        };
+      }
+      presetApp.use(fileUpload(options));
+      presetApp.use(() => { downstreamRan = true; });
+      const presetRes = await request(presetApp.callback()).post('/').attach('file', file);
+      assert.strictEqual(presetRes.status, 200, 'preassigned status must be preserved');
+      assert.strictEqual(presetRes.text, 'early body', 'preassigned body must not be overwritten');
+      assert.strictEqual(downstreamRan, false, 'downstream must not run after limit');
+      assert.strictEqual(handlerCalls, withHandler ? 1 : 0);
+    }
+  },
+
+  // 21. Downstream errors propagate and temporary files are cleaned up.
+  koa_downstream_next_throws: async () => {
