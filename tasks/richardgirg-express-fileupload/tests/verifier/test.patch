+          return { error: undefined };
+        }, (error) => {
+          settled = true;
+          return { error };
+        });
+        await withTimeout(Promise.race([nextEntered, upload]), `${label}: downstream did not start`);
+        assert.strictEqual(downstreamCalls, 1, label);
+        assert.strictEqual(settled, false, `${label}: middleware must await downstream`);
+        assert.strictEqual(resources.length, 3, label);
+        if (!limited) releaseCloses();
+        releaseNext();
+        await wait(25);
