+async function checkOpaqueHandlerErrors() {
+  for (const kind of ['null-object', 'coercion-trap', 'prototype-trap', 'foreign-error', 'null', 'undefined', 'zero', 'false']) {
+    for (const mode of ['express', 'koa2', 'koa3']) {
