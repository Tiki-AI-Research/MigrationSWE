+async function checkKoaBypassErrorPromise() {
+  for (const scenario of ['method', 'media_type', 'framing']) {
+    const ctx = koaContext(new Koa(), scenario === 'method' ? 'GET' : 'POST', '/');
+    ctx.req.headers = scenario === 'framing' ? { 'content-type': 'multipart/form-data; boundary=bypass' }
+      : { 'content-type': scenario === 'media_type' ? 'application/json' : 'multipart/form-data; boundary=bypass',
+        'content-length': '10' };
+    const expected = new Error(`bypass downstream failure: ${scenario}`);
+    let calls = 0;
+    let returned;
+    try {
+      assert.doesNotThrow(() => {
+        returned = fileUpload()(ctx, () => { calls += 1; throw expected; });
+      }, `${scenario}: Koa must return a rejected Promise for downstream errors`);
+      assert(returned && typeof returned.then === 'function', scenario);
+      await assert.rejects(returned, (error) => error === expected);
+      assert.strictEqual(calls, 1, scenario);
+    } finally {
+      ctx.req.destroy();
+      ctx.req.socket.destroy();
+    }
+  }
+}
