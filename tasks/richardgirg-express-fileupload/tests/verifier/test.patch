+async function checkCommittedResponseContinuation() {
+  const scenarios = [
+    { response: 'upstream_headers', limited: false, handler: 'none' },
+    { response: 'upstream_end', limited: false, handler: 'none' },
+    { response: 'upstream_headers', limited: true, handler: 'none' },
+    { response: 'upstream_end', limited: true, handler: 'none' },
+    { response: 'handler_headers', limited: true, handler: 'resolve' },
+    { response: 'handler_end', limited: true, handler: 'resolve' },
+    { response: 'handler_headers', limited: true, handler: 'next' },
+    { response: 'handler_end', limited: true, handler: 'next' },
+    { response: 'handler_headers', limited: true, handler: 'reject' },
+    { response: 'handler_end', limited: true, handler: 'reject' },
+    { response: 'handler_headers', limited: true, handler: 'callback_error' },
+    { response: 'handler_end', limited: true, handler: 'callback_error' }
+  ];
+  for (const mode of ['koa2', 'koa3', 'express']) {
+    for (const useTempFiles of [false, true]) {
+      for (const scenario of scenarios) {
+        if (mode !== 'express' && scenario.handler === 'callback_error') continue;
+        const label = `${mode}/${useTempFiles ? 'temp' : 'memory'}/${scenario.response}/${scenario.handler}/${scenario.limited}`;
+        const ctx = multipartContext();
+        const socket = new PassThrough();
+        socket.resume();
+        ctx.req.socket = socket;
+        ctx.res.assignSocket(socket);
+        const tempDir = mkTmp('committed-response-continue-');
+        const expected = new Error('committed response limit handler failed');
+        const callbacks = [];
+        let handlerCalls = 0;
+        let handlerFinished = false;
+        let resolveNext;
+        const nextDone = new Promise((resolve) => { resolveNext = resolve; });
+        const commitResponse = () => {
+          ctx.res.writeHead(202, { 'content-type': 'text/plain' });
+          if (scenario.response.endsWith('_end')) ctx.res.end('committed response');
+        };
+        const handleLimit = async (req, res, next) => {
+          handlerCalls += 1;
+          assert.strictEqual(req, ctx.req);
+          assert.strictEqual(res, ctx.res);
+          commitResponse();
+          if (scenario.handler === 'callback_error') {
+            try {
+              await next(expected);
+            } catch (err) {
+              assert.strictEqual(err, expected);
+            }
+            next(new Error('a later committed-response callback must not replace the first error'));
+          } else if (scenario.handler === 'next') {
+            await next();
+            await next();
+          }
+          await wait(10);
+          handlerFinished = true;
+          if (scenario.handler === 'reject') throw expected;
+        };
+        const observeNext = (err) => {
+          const file = ctx.req.files && ctx.req.files.file;
+          const observed = { err, handlerFinished, file, files: readDir(tempDir) };
+          if (!err && file) {
+            try {
+              observed.contents = useTempFiles ? fs.readFileSync(file.tempFilePath) : file.data;
+            } catch (readError) {
+              observed.readError = readError;
+            }
+          }
+          callbacks.push(observed);
+          resolveNext();
+        };
+        try {
+          const options = { abortOnLimit: false, useTempFiles, tempFileDir: tempDir };
+          if (scenario.limited) options.limits = { fileSize: 5 };
+          if (scenario.handler !== 'none') {
+            options.limitHandler = mode === 'koa2' ? async (context, next) => {
+              assert.strictEqual(context, ctx);
+              return handleLimit(context.req, context.res, next);
+            } : handleLimit;
+          }
+          if (scenario.response.startsWith('upstream_')) commitResponse();
+          const middleware = fileUpload(options);
+          let observedError;
+          if (mode === 'express') {
+            middleware(ctx.req, ctx.res, observeNext);
+            await withTimeout(nextDone, `${label}: committed response must not suppress Express next`);
+            observedError = callbacks[0].err;
+          } else {
+            const upload = middleware(ctx, async () => { observeNext(); });
+            assert(upload && typeof upload.then === 'function', `${label}: Koa must return a Promise`);
+            try {
+              await withTimeout(upload, `${label}: Koa upload did not finish`);
+            } catch (err) {
+              observedError = err;
+            }
+            assert.strictEqual(ctx.request.body, ctx.req.body, label);
+            assert.strictEqual(ctx.request.files, ctx.req.files, label);
+          }
+          await wait(5);
+          const errorOutcome = scenario.handler === 'reject' || scenario.handler === 'callback_error';
+          assert.strictEqual(handlerCalls, scenario.handler === 'none' ? 0 : 1, label);
+          assert.strictEqual(ctx.res.statusCode, 202, `${label}: committed status must be preserved`);
+          assert.strictEqual(ctx.res.writableEnded, scenario.response.endsWith('_end'), label);
+          assert.strictEqual(ctx.req.body.later, 'continued', `${label}: parsing must complete`);
+          if (errorOutcome) {
+            assert.strictEqual(observedError, expected, `${label}: original error must propagate`);
+            assert.strictEqual(handlerFinished, true, label);
+            assert.strictEqual(callbacks.length, mode === 'express' ? 1 : 0, label);
+            if (mode === 'express') {
+              assert.strictEqual(callbacks[0].handlerFinished, true, label);
+              assert.deepStrictEqual(callbacks[0].files, [], `${label}: cleanup must precede error propagation`);
+            }
+            assert.deepStrictEqual(readDir(tempDir), [], label);
+          } else {
+            assert.strictEqual(observedError, undefined, label);
+            assert.strictEqual(callbacks.length, 1, `${label}: downstream must run exactly once`);
+            const observed = callbacks[0];
+            assert.strictEqual(observed.handlerFinished, scenario.handler !== 'none', label);
+            assert.strictEqual(observed.readError, undefined, `${label}: successful file must remain readable`);
+            assert(observed.file, `${label}: successful file must exist`);
+            assert.strictEqual(observed.file.truncated, scenario.limited, label);
+            const expectedContents = scenario.limited ? 'Hello' : 'Hello World 1';
+            assert.strictEqual(observed.file.size, Buffer.byteLength(expectedContents), label);
+            assert.strictEqual(observed.contents.toString(), expectedContents, label);
+            assert.strictEqual(observed.files.length, useTempFiles ? 1 : 0, `${label}: successful temporary file must not be deleted`);
+            if (mode !== 'express' && scenario.limited) {
+              assert.deepStrictEqual(readDir(tempDir), [], `${label}: limited temporary files must be removed before settlement`);
+            }
+          }
+        } finally {
+          ctx.req.destroy();
+          socket.destroy();
+          fs.rmSync(tempDir, { recursive: true, force: true });
+        }
+      }
+    }
+  }
+}
