+async function checkLimitedUploadTimeout() {
+  for (const useTempFiles of [false, true]) {
+    for (const keepSending of [false, true]) {
+      const boundary = 'limited-timeout-boundary';
+      const tempDir = mkTmp('koa-limited-timeout-');
+      const req = new Readable({ read() {} });
+      const socket = new PassThrough();
+      socket.resume();
+      req.method = 'POST';
+      req.url = '/';
+      req.headers = { 'content-type': `multipart/form-data; boundary=${boundary}`, 'transfer-encoding': 'chunked' };
+      req.socket = socket;
+      req.complete = false;
+      const res = new http.ServerResponse(req);
+      res.statusCode = 404;
+      const ctx = new Koa().createContext(req, res);
+      let handlerCalls = 0;
+      let downstreamCalls = 0;
+      let contentsAtNext;
+      try {
+        const middleware = fileUpload({
+          useTempFiles,
+          tempFileDir: tempDir,
+          limits: { fileSize: 5 },
+          abortOnLimit: false,
+          uploadTimeout: 200,
+          limitHandler: () => { handlerCalls += 1; }
+        });
+        const upload = Promise.resolve(middleware(ctx, async () => {
+          downstreamCalls += 1;
+          const file = ctx.request.files.file;
+          contentsAtNext = (useTempFiles ? fs.readFileSync(file.tempFilePath) : file.data).toString();
+        })).then(
+          () => ({ error: null }),
+          (error) => ({ error })
+        );
+        req.push(`--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="limited.txt"\r\n`
+          + 'Content-Type: text/plain\r\n\r\n123456789');
+        if (keepSending) {
+          for (let chunk = 0; chunk < 6; chunk += 1) {
+            await wait(60);
+            req.push('more data');
+          }
+          req.complete = true;
+          req.push(`\r\n--${boundary}--\r\n`);
+          req.push(null);
+        }
+        const result = await withTimeout(upload, 'limited upload did not settle');
+        assert.strictEqual(handlerCalls, 1);
+        if (keepSending) {
+          assert.ifError(result.error);
+          assert.strictEqual(downstreamCalls, 1, 'active limited uploads must reach downstream once');
+          const file = ctx.request.files.file;
+          assert.strictEqual(file.truncated, true);
+          assert.strictEqual(file.size, 5);
+          assert.strictEqual(contentsAtNext, '12345', 'limited files must be readable in downstream');
+          assert.deepStrictEqual(readDir(tempDir), [], 'limited temporary files must be removed before settlement');
+          await wait(250);
+          assert.strictEqual(downstreamCalls, 1, 'a completed upload must not later time out');
+          assert.deepStrictEqual(readDir(tempDir), [], 'limited uploads must not leave delayed temporary files');
+        } else {
+          assert(result.error instanceof Error && /^Upload timeout for /.test(result.error.message),
+            'a stalled limited upload must reject with the documented timeout error');
+          assert.strictEqual(downstreamCalls, 0);
+          assert.deepStrictEqual(readDir(tempDir), [], 'timeout must remove temporary files before settling');
+          await wait(80);
+          assert.deepStrictEqual(readDir(tempDir), [], 'timeout must not leave delayed temporary files');
+        }
+      } finally {
+        req.destroy();
+        socket.destroy();
+        fs.rmSync(tempDir, { recursive: true, force: true });
+      }
+    }
+  }
+}
