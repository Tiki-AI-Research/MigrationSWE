+async function checkLimitedFileThenStalledField() {
+  for (const mode of ['koa', 'express']) {
+    for (const useTempFiles of [false, true]) {
+      const label = `${mode}/${useTempFiles}/stalled-field-after-limited-file`;
+      const directory = mkTmp('limited-file-stalled-field-');
+      const boundary = 'limited-file-stalled-field-boundary';
+      const req = new Readable({ read() {} });
+      req.method = 'POST';
+      req.url = '/';
+      req.complete = false;
+      req.headers = { 'content-type': `multipart/form-data; boundary=${boundary}`,
+        'transfer-encoding': 'chunked' };
+      const socket = new PassThrough();
+      socket.resume();
+      req.socket = socket;
+      const ctx = new Koa().createContext(req, new http.ServerResponse(req));
+      let downstreamCalls = 0;
+      let boundaryCalls = 0;
+      let notifyResult;
+      const result = new Promise(resolve => { notifyResult = resolve; });
+      const record = error => {
+        boundaryCalls += 1;
+        notifyResult({ error, temporaryFiles: readDir(directory) });
+      };
+      try {
+        const middleware = fileUpload({ useTempFiles, tempFileDir: directory,
+          limits: { fileSize: 5 }, abortOnLimit: false, uploadTimeout: 200 });
+        if (mode === 'koa') {
+          Promise.resolve(middleware(ctx, async () => { downstreamCalls += 1; }))
+            .then(() => record(undefined), record);
+        } else {
+          const returned = middleware(req, ctx.res, error => {
+            if (!error) downstreamCalls += 1;
+            record(error);
+          });
+          if (returned && typeof returned.catch === 'function') returned.catch(() => {});
+        }
+        // The next part's boundary ends the file, but not the multipart request.
+        req.push(`--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="limited.txt"\r\n`
+          + `Content-Type: text/plain\r\n\r\n123456789\r\n--${boundary}\r\n`
+          + 'Content-Disposition: form-data; name="later"\r\n\r\nunfinished');
+        const observed = await withTimeout(result, `${label}: incomplete request lost its upload timeout`);
+        assert(observed.error instanceof Error && /^Upload timeout for /.test(observed.error.message), label);
+        assert.strictEqual(downstreamCalls, 0, label);
+        assert.strictEqual(boundaryCalls, 1, label);
+        assert.deepStrictEqual(observed.temporaryFiles, [], `${label}: cleanup must precede timeout propagation`);
+      } finally {
+        req.destroy();
+        await withTimeout(result, `${label}: teardown did not settle`);
+        socket.destroy();
+        fs.rmSync(directory, { recursive: true, force: true });
+      }
+    }
+  }
+}
