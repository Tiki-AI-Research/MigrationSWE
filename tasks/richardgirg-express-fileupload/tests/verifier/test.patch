+                }
+                next();
+                next(new Error('a later callback error must not replace the first'));
+                startHandler();
+                await handlerRelease;
+                handlerFinished = true;
+              } finally {
+                finishHandler();
+              }
+            }
+          });
+          middleware(ctx.req, ctx.res, (err) => {
+            callbacks.push({ err, handlerFinished, files: readDir(tempDir) });
+            finishNext();
+          });
+          await withTimeout(handlerStarted, 'non-aborting Express limit handler did not start');
+          await wait(25);
+          assert.strictEqual(callbacks.length, 0, 'next(err) must wait for the limit handler Promise');
+          releaseHandler();
+          await withTimeout(nextDone, 'non-aborting Express callback error did not propagate');
+          await withTimeout(handlerDone, 'non-aborting Express limit handler did not finish');
+          await wait(5);
+          assert.strictEqual(handlerCalls, 1);
+          assert.strictEqual(callbacks.length, 1, 'a callback error must never run successful downstream');
+          assert.strictEqual(callbacks[0].err, expected, 'the original callback error must propagate');
+          assert.strictEqual(callbacks[0].handlerFinished, true, 'the handler must finish before the error callback');
+          assert.deepStrictEqual(callbacks[0].files, [], 'temporary files must be cleaned before the error callback');
+        } finally {
+          releaseHandler();
+          if (handlerCalls) await withTimeout(handlerDone, 'failed callback check left the handler pending');
+          ctx.req.destroy();
+          fs.rmSync(tempDir, { recursive: true, force: true });
+        }
+      }
+    }
+  }
+}
