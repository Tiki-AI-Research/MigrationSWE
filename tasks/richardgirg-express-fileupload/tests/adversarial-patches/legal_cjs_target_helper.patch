+'use strict';
+
+// Legitimate Koa-era helper module written with a non-standard extension.
+// It contains no deprecated Node API and no source-framework reference, so the
+// migration-scope completeness check must NOT flag it.
+function isMultipartForm(ctx) {
+  const type = ctx.get ? ctx.get('content-type') : '';
+  return typeof type === 'string' && type.toLowerCase().startsWith('multipart/');
+}
+
+function normalizeFieldName(name) {
+  return String(name || '').replace(/\s+/g, ' ').trim();
+}
+
+module.exports = { isMultipartForm, normalizeFieldName };
