+	b.ReconstructHistory("", nil)
+	if len(b.MoveHistory) != 0 || len(b.PositionHistory) != 1 {
+		t.Fatal("empty input should leave board untouched")
+	}
+}
+
+func TestReconstructHistoryResetsFirst(t *testing.T) {
+	b := NewGameBoard()
+	b.ExecuteShakmatyMove(chesslib.E2, chesslib.E4)
+	b.ReconstructHistory("d2d4 d7d5", nil)
+	if len(b.MoveHistory) != 2 || len(b.PositionHistory) != 3 {
+		t.Fatal("reconstruct should reset")
+	}
+	if b.GetRoleAtSquareMust(chesslib.D4) != chesslib.Pawn {
+		t.Fatal("pawn should be on d4")
+	}
+	if b.IsSquareOccupied(chesslib.E4) {
+		t.Fatal("e4 should be empty")
+	}
+}
+
+func TestMoveToSAN(t *testing.T) {
+	b := NewGameBoard()
+	b.ReconstructHistory("e2e4 e7e5 g1f3", nil)
+	if got := b.MoveToSAN(0); got != "e4" {
+		t.Fatalf("san0 = %q", got)
+	}
+	if got := b.MoveToSAN(1); got != "e5" {
+		t.Fatalf("san1 = %q", got)
+	}
+	if got := b.MoveToSAN(2); got != "Nf3" {
+		t.Fatalf("san2 = %q", got)
+	}
+	if got := b.MoveToSAN(99); got != "" {
+		t.Fatalf("out of bounds = %q", got)
+	}
+}
+
+func TestMoveToSANCapture(t *testing.T) {
+	b := NewGameBoard()
+	b.ReconstructHistory("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 f3e5", nil)
+	if got := b.MoveToSAN(6); got != "Nxe5" {
+		t.Fatalf("san6 = %q", got)
+	}
+}
+
+func contains(squares []chesslib.Square, target chesslib.Square) bool {
+	for _, s := range squares {
+		if s == target {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/chess/coord.go b/internal/chess/coord.go
new file mode 100644
index 0000000..578e52d
--- /dev/null
+++ b/internal/chess/coord.go
@@ -0,0 +1,88 @@
+// Package chess ports the chess board model and coordinate helpers.
+package chess
+
+import (
+	chesslib "github.com/notnil/chess"
+)
+
+// MoveDirection is a board navigation direction.
+type MoveDirection int
+
+const (
+	// Up moves towards rank 8.
+	Up MoveDirection = iota
+	// Down moves towards rank 1.
+	Down
+	// Left moves towards file a.
+	Left
+	// Right moves towards file h.
+	Right
+)
+
+// Coord is a board coordinate in (row, col) form where row 0 is rank 8 and
+// col 0 is file a. It is always clamped to 0..7.
+type Coord struct {
+	Row uint8
+	Col uint8
+}
+
+// NewCoord builds a coordinate, clamping both components to 0..7.
+func NewCoord(row, col uint8) Coord {
+	if row > 7 {
+		row = 7
+	}
+	if col > 7 {
+		col = 7
+	}
+	return Coord{Row: row, Col: col}
+}
+
+// FromSquare converts a library square into a coordinate.
+func FromSquare(sq chesslib.Square) Coord {
+	index := uint8(sq)
+	rank := index / 8
+	file := index % 8
+	return Coord{Row: 7 - rank, Col: file}
+}
+
+// Square converts the coordinate back into a library square.
+func (c Coord) Square() chesslib.Square {
+	row := c.Row
+	col := c.Col
+	if row > 7 {
+		row = 7
+	}
+	if col > 7 {
+		col = 7
+	}
+	rank := 7 - row
+	index := (rank * 8) + col
+	return chesslib.Square(index)
+}
+
+// MoveTo advances the coordinate one step in the given direction.
+func (c *Coord) MoveTo(direction MoveDirection) {
+	switch direction {
+	case Up:
+		if c.Row > 0 {
+			c.Row--
+		}
+	case Down:
+		if c.Row < 7 {
+			c.Row++
+		}
+	case Left:
+		if c.Col > 0 {
+			c.Col--
+		}
+	case Right:
+		if c.Col < 7 {
+			c.Col++
+		}
+	}
+}
+
+// Reverse flips the coordinate across the board centre.
+func (c Coord) Reverse() Coord {
+	return Coord{Row: 7 - c.Row, Col: 7 - c.Col}
+}
diff --git a/internal/config/cli.go b/internal/config/cli.go
new file mode 100644
index 0000000..b64eadd
--- /dev/null
+++ b/internal/config/cli.go
@@ -0,0 +1,125 @@
+// Package config handles CLI arguments and the persisted config.toml file.
+package config
+
+import (
+	"flag"
+	"io"
+	"strconv"
+	"strings"
+)
+
+// Args mirrors the Rust clap `Args` struct: the nine CLI options.
+type Args struct {
+	EnginePath   string
+	Depth        *uint8
+	Difficulty   *string
+	LichessToken *string
+	NoSound      bool
+	Skin         *string
+	UpdateSkins  bool
+	Pgn          *string
+}
+
+type uint8Flag struct {
+	value *uint8
+	set   *bool
+}
+
+func (u uint8Flag) String() string {
+	if u.value == nil {
+		return ""
+	}
+	return strconv.FormatUint(uint64(*u.value), 10)
+}
+
+func (u uint8Flag) Set(s string) error {
+	v, err := strconv.ParseUint(s, 10, 8)
+	if err != nil {
+		return err
+	}
+	*u.value = uint8(v)
+	*u.set = true
+	return nil
+}
+
+// ParseArgs parses the supported CLI options. It accepts both the short and
+// long spellings, matching the Rust clap surface.
+func ParseArgs(arguments []string) (*Args, error) {
+	args := &Args{}
+
+	var depth uint8
+	var depthSet bool
+
+	fs := flag.NewFlagSet("chess-tui", flag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+
+	fs.StringVar(&args.EnginePath, "e", "", "Path for the chess engine")
+	fs.StringVar(&args.EnginePath, "engine-path", "", "Path for the chess engine")
+
+	fs.Var(uint8Flag{value: &depth, set: &depthSet}, "d", "Bot thinking depth (1-255)")
+	fs.Var(uint8Flag{value: &depth, set: &depthSet}, "depth", "Bot thinking depth (1-255)")
+
+	var difficulty string
+	var difficultySet bool
+	fs.Func("difficulty", "Bot difficulty: easy, medium, hard, or magnus", func(s string) error {
+		difficulty = s
+		difficultySet = true
+		return nil
+	})
+
+	var token string
+	var tokenSet bool
+	fs.Func("l", "Lichess API token", func(s string) error { token = s; tokenSet = true; return nil })
+	fs.Func("lichess-token", "Lichess API token", func(s string) error { token = s; tokenSet = true; return nil })
+
+	fs.BoolVar(&args.NoSound, "no-sound", false, "Disable sound effects")
+
+	var skin string
+	var skinSet bool
+	fs.Func("skin", "Skin/theme name", func(s string) error { skin = s; skinSet = true; return nil })
+
+	fs.BoolVar(&args.UpdateSkins, "update-skins", false, "Update skins.json with the built-in default")
+
+	var pgn string
+	var pgnSet bool
+	fs.Func("p", "Open a PGN file or directory of .pgn files", func(s string) error { pgn = s; pgnSet = true; return nil })
+	fs.Func("pgn", "Open a PGN file or directory of .pgn files", func(s string) error { pgn = s; pgnSet = true; return nil })
+
+	if err := fs.Parse(arguments); err != nil {
+		return nil, err
+	}
+
+	if depthSet {
+		args.Depth = &depth
+	}
+	if difficultySet {
+		args.Difficulty = &difficulty
+	}
+	if tokenSet {
+		args.LichessToken = &token
+	}
+	if skinSet {
+		args.Skin = &skin
+	}
+	if pgnSet {
+		args.Pgn = &pgn
+	}
+	return args, nil
+}
+
+// ParseDifficulty maps a difficulty name (case-insensitively) to its preset
+// index. An unrecognized value reports false and leaves the difficulty alone.
+func ParseDifficulty(name string) (uint8, bool) {
+	switch strings.ToLower(name) {
+	case "easy":
+		return 0, true
+	case "medium":
+		return 1, true
+	case "hard":
+		return 2, true
+	case "magnus":
+		return 3, true
+	default:
+		return 0, false
+	}
+}
diff --git a/internal/config/config.go b/internal/config/config.go
new file mode 100644
index 0000000..d953706
--- /dev/null
+++ b/internal/config/config.go
@@ -0,0 +1,263 @@
+package config
+
+import (
+	"errors"
+	"io/fs"
+	"log"
+	"os"
+	"path/filepath"
+	"syscall"
+
+	"github.com/BurntSushi/toml"
+)
+
+// Config is the persisted settings loaded from and written to config.toml.
+// Every field is optional; fields with no value are omitted on write.
+type Config struct {
+	EnginePath        *string `toml:"engine_path,omitempty"`
+	DisplayMode       *string `toml:"display_mode,omitempty"`
+	LogLevel          *string `toml:"log_level,omitempty"`
+	BotDepth          *uint8  `toml:"bot_depth,omitempty"`
+	BotDifficulty     *uint8  `toml:"bot_difficulty,omitempty"`
+	SelectedSkinName  *string `toml:"selected_skin_name,omitempty"`
+	LichessToken      *string `toml:"lichess_token,omitempty"`
+	SoundEnabled      *bool   `toml:"sound_enabled,omitempty"`
+	AnimationsEnabled *bool   `toml:"animations_enabled,omitempty"`
+}
+
+func strPtr(s string) *string { return &s }
+func u8Ptr(v uint8) *uint8    { return &v }
+func boolPtr(b bool) *bool    { return &b }
+
+// Default returns the documented fallback configuration.
+func Default() *Config {
+	return &Config{
+		EnginePath:        nil,
+		DisplayMode:       strPtr("DEFAULT"),
+		LogLevel:          strPtr("OFF"),
+		BotDepth:          u8Ptr(10),
+		BotDifficulty:     nil,
+		SelectedSkinName:  strPtr("Default"),
+		LichessToken:      nil,
+		SoundEnabled:      boolPtr(true),
+		AnimationsEnabled: boolPtr(false),
+	}
+}
+
+// withDefaults fills every field that has no value with its documented
+// default, leaving engine_path, bot_difficulty and lichess_token untouched.
+func (c *Config) withDefaults() *Config {
+	if c.DisplayMode == nil {
+		c.DisplayMode = strPtr("DEFAULT")
+	}
+	if c.LogLevel == nil {
+		c.LogLevel = strPtr("OFF")
+	}
+	if c.BotDepth == nil {
+		c.BotDepth = u8Ptr(10)
+	}
+	if c.SelectedSkinName == nil {
+		c.SelectedSkinName = strPtr("Default")
+	}
+	if c.SoundEnabled == nil {
+		c.SoundEnabled = boolPtr(true)
+	}
+	if c.AnimationsEnabled == nil {
+		c.AnimationsEnabled = boolPtr(false)
+	}
+	return c
+}
+
+// Load reads and parses config.toml. A missing, empty or invalid file falls
+// back to the defaults without failing.
+func Load(path string) *Config {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return Default()
+	}
+	if len(trimSpace(content)) == 0 {
+		return Default()
+	}
+	var cfg Config
+	if _, err := toml.Decode(string(content), &cfg); err != nil {
+		return Default()
+	}
+	return cfg.withDefaults()
+}
+
+func trimSpace(b []byte) []byte {
+	start := 0
+	for start < len(b) && isSpace(b[start]) {
+		start++
+	}
+	end := len(b)
+	for end > start && isSpace(b[end-1]) {
+		end--
+	}
+	return b[start:end]
+}
+
+func isSpace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
+}
+
+// IsReadonlyError reports whether an IO error indicates a read-only
+// filesystem (EROFS, errno 30) or a permission problem.
+func IsReadonlyError(err error) bool {
+	if err == nil {
+		return false
+	}
+	if errors.Is(err, fs.ErrPermission) {
+		return true
+	}
+	var pe *os.PathError
+	if errors.As(err, &pe) {
+		if errors.Is(pe.Err, syscall.EROFS) || errors.Is(pe.Err, fs.ErrPermission) {
+			return true
+		}
+	}
+	var le *os.LinkError
+	if errors.As(err, &le) {
+		if errors.Is(le.Err, syscall.EROFS) {
+			return true
+		}
+	}
+	return errors.Is(err, syscall.EROFS)
+}
+
+// HandleWriteError logs a write failure as a warning; it never propagates.
+func HandleWriteError(err error, path string) {
+	if IsReadonlyError(err) {
+		log.Printf("Config file at %s is read-only. Settings changes will not be persisted.", path)
+	} else {
+		log.Printf("Could not write to config file at %s: %v. Settings changes will not be persisted.", path, err)
+	}
+}
+
+// Persist writes the configuration to path. The existing file is re-read
+// first so that fields not tracked by the running state (for example
+// engine_path) are preserved. Write failures are logged, not returned.
+func (c *Config) Persist(path string) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		if IsReadonlyError(err) {
+			HandleWriteError(err, path)
+			return nil
+		}
+		return err
+	}
+
+	merged := *c
+	if existing := loadRaw(path); existing != nil {
+		mergeMissing(&merged, existing)
+	}
+
+	encoded, err := toml.Marshal(&merged)
+	if err != nil {
+		return err
+	}
+
+	if err := os.WriteFile(path, encoded, 0o644); err != nil {
+		HandleWriteError(err, path)
+		return nil
+	}
+	return nil
+}
+
+func loadRaw(path string) *Config {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	var cfg Config
+	if _, err := toml.Decode(string(content), &cfg); err != nil {
+		return nil
+	}
+	return &cfg
+}
+
+func mergeMissing(dst, src *Config) {
+	if dst.EnginePath == nil {
+		dst.EnginePath = src.EnginePath
+	}
+	if dst.DisplayMode == nil {
+		dst.DisplayMode = src.DisplayMode
+	}
+	if dst.LogLevel == nil {
+		dst.LogLevel = src.LogLevel
+	}
+	if dst.BotDepth == nil {
+		dst.BotDepth = src.BotDepth
+	}
+	if dst.BotDifficulty == nil {
+		dst.BotDifficulty = src.BotDifficulty
+	}
+	if dst.SelectedSkinName == nil {
+		dst.SelectedSkinName = src.SelectedSkinName
+	}
+	if dst.LichessToken == nil {
+		dst.LichessToken = src.LichessToken
+	}
+	if dst.SoundEnabled == nil {
+		dst.SoundEnabled = src.SoundEnabled
+	}
+	if dst.AnimationsEnabled == nil {
+		dst.AnimationsEnabled = src.AnimationsEnabled
+	}
+}
+
+// Create merges the CLI args onto any existing config file and persists the
+// result. It tolerates a read-only config: write errors are logged only.
+func Create(args *Args, folderPath, configPath string) error {
+	if err := os.MkdirAll(folderPath, 0o755); err != nil {
+		if IsReadonlyError(err) {
+			HandleWriteError(err, configPath)
+			return nil
+		}
+		return err
+	}
+
+	cfg := loadRaw(configPath)
+	if cfg == nil {
+		cfg = &Config{}
+	}
+	cfg.withDefaults()
+
+	if cfg.EnginePath == nil || *cfg.EnginePath == "" {
+		if args.EnginePath == "" {
+			cfg.EnginePath = strPtr("")
+		} else {
+			cfg.EnginePath = strPtr(args.EnginePath)
+		}
+	}
+	if args.EnginePath != "" {
+		cfg.EnginePath = strPtr(args.EnginePath)
+	}
+	if args.LichessToken != nil {
+		cfg.LichessToken = strPtr(*args.LichessToken)
+	}
+	if args.Depth != nil {
+		cfg.BotDepth = u8Ptr(*args.Depth)
+	}
+	if args.Difficulty != nil {
+		if idx, ok := ParseDifficulty(*args.Difficulty); ok {
+			cfg.BotDifficulty = u8Ptr(idx)
+		}
+	}
+	if args.NoSound {
+		cfg.SoundEnabled = boolPtr(false)
+	}
+
+	// An empty engine path has no value and must be omitted from the file.
+	if cfg.EnginePath != nil && *cfg.EnginePath == "" {
+		cfg.EnginePath = nil
+	}
+
+	encoded, err := toml.Marshal(cfg)
+	if err != nil {
+		return err
+	}
+	if err := os.WriteFile(configPath, encoded, 0o644); err != nil {
+		HandleWriteError(err, configPath)
+	}
+	return nil
+}
diff --git a/internal/config/config_test.go b/internal/config/config_test.go
new file mode 100644
index 0000000..4210ae1
--- /dev/null
+++ b/internal/config/config_test.go
@@ -0,0 +1,229 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/BurntSushi/toml"
+)
+
+func TestDefaultsFromBadInput(t *testing.T) {
+	dir := t.TempDir()
+	cases := map[string]string{
+		"empty":   "",
+		"invalid": "not = = toml",
+		"missing": "",
+	}
+	for name, content := range cases {
+		path := filepath.Join(dir, name+".toml")
+		if name != "missing" {
+			if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+				t.Fatal(err)
+			}
+		}
+		cfg := Load(path)
+		if cfg.DisplayMode == nil || *cfg.DisplayMode != "DEFAULT" {
+			t.Fatalf("%s: display_mode = %v", name, cfg.DisplayMode)
+		}
+		if cfg.LogLevel == nil || *cfg.LogLevel != "OFF" {
+			t.Fatalf("%s: log_level = %v", name, cfg.LogLevel)
+		}
+		if cfg.BotDepth == nil || *cfg.BotDepth != 10 {
+			t.Fatalf("%s: bot_depth = %v", name, cfg.BotDepth)
+		}
+		if cfg.SelectedSkinName == nil || *cfg.SelectedSkinName != "Default" {
+			t.Fatalf("%s: skin = %v", name, cfg.SelectedSkinName)
+		}
+		if cfg.SoundEnabled == nil || !*cfg.SoundEnabled {
+			t.Fatalf("%s: sound = %v", name, cfg.SoundEnabled)
+		}
+		if cfg.AnimationsEnabled == nil || *cfg.AnimationsEnabled {
+			t.Fatalf("%s: animations = %v", name, cfg.AnimationsEnabled)
+		}
+		if cfg.EnginePath != nil {
+			t.Fatalf("%s: engine path should be unset", name)
+		}
+	}
+}
+
+func TestDifficultyMapping(t *testing.T) {
+	cases := map[string]uint8{"easy": 0, "Easy": 0, "MEDIUM": 1, "hard": 2, "Magnus": 3}
+	for in, want := range cases {
+		got, ok := ParseDifficulty(in)
+		if !ok || got != want {
+			t.Fatalf("ParseDifficulty(%q) = %d/%v, want %d", in, got, ok, want)
+		}
+	}
+	if _, ok := ParseDifficulty("grandmaster"); ok {
+		t.Fatal("unknown difficulty should not map")
+	}
+}
+
+func TestBotDepthBounds(t *testing.T) {
+	args, err := ParseArgs([]string{"--depth", "255"})
+	if err != nil || args.Depth == nil || *args.Depth != 255 {
+		t.Fatalf("depth 255 = %v, err %v", args, err)
+	}
+	if _, err := ParseArgs([]string{"--depth", "256"}); err == nil {
+		t.Fatal("depth 256 should fail")
+	}
+	if _, err := ParseArgs([]string{"--depth", "-1"}); err == nil {
+		t.Fatal("negative depth should fail")
+	}
+}
+
+func TestFlagsAccepted(t *testing.T) {
+	args, err := ParseArgs([]string{
+		"-e", "/usr/bin/stockfish", "--depth", "5", "--difficulty", "hard",
+		"-l", "tok", "--no-sound", "--skin", "Matrix", "-p", "game.pgn",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if args.EnginePath != "/usr/bin/stockfish" || args.Depth == nil || *args.Depth != 5 {
+		t.Fatalf("args = %+v", args)
+	}
+	if args.Difficulty == nil || *args.Difficulty != "hard" {
+		t.Fatalf("difficulty = %v", args.Difficulty)
+	}
+	if args.LichessToken == nil || *args.LichessToken != "tok" {
+		t.Fatalf("token = %v", args.LichessToken)
+	}
+	if !args.NoSound || args.Skin == nil || *args.Skin != "Matrix" || args.Pgn == nil || *args.Pgn != "game.pgn" {
+		t.Fatalf("args = %+v", args)
+	}
+}
+
+func TestLengthEqualsLongFlags(t *testing.T) {
+	args, err := ParseArgs([]string{
+		"--engine-path", "/e", "--depth", "3", "--difficulty", "easy",
+		"--lichess-token", "t", "--skin", "ASCII", "--pgn", "x.pgn",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if args.EnginePath != "/e" || *args.Difficulty != "easy" || *args.Skin != "ASCII" {
+		t.Fatalf("args = %+v", args)
+	}
+}
+
+func TestMergePreservesEnginePath(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.toml")
+	if err := os.WriteFile(path, []byte("engine_path = \"/usr/bin/stockfish\"\nbot_depth = 5\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// A fresh config with no engine path, as the running state might build.
+	fresh := &Config{SoundEnabled: boolPtr(false)}
+	if err := fresh.Persist(path); err != nil {
+		t.Fatal(err)
+	}
+
+	var raw map[string]any
+	if _, err := toml.DecodeFile(path, &raw); err != nil {
+		t.Fatal(err)
+	}
+	if raw["engine_path"] != "/usr/bin/stockfish" {
+		t.Fatalf("engine_path = %v, want preserved", raw["engine_path"])
+	}
+	if raw["bot_depth"] != int64(5) {
+		t.Fatalf("bot_depth = %v, want preserved", raw["bot_depth"])
+	}
+}
+
+func TestOptionalFieldsOmitted(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.toml")
+	cfg := Default()
+	cfg.EnginePath = nil
+	cfg.BotDifficulty = nil
+	cfg.LichessToken = nil
+	if err := cfg.Persist(path); err != nil {
+		t.Fatal(err)
+	}
+	var raw map[string]any
+	if _, err := toml.DecodeFile(path, &raw); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{"engine_path", "bot_difficulty", "lichess_token"} {
+		if _, ok := raw[key]; ok {
+			t.Fatalf("%s should be omitted, got %v", key, raw[key])
+		}
+	}
+}
+
+func TestReadonlyTolerated(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("running as root; permission checks are bypassed")
+	}
+	dir := t.TempDir()
+	roDir := filepath.Join(dir, "ro")
+	if err := os.MkdirAll(roDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(roDir, "config.toml")
+	if err := os.WriteFile(path, []byte("bot_depth = 3\n"), 0o444); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(roDir, 0o555); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Chmod(roDir, 0o755)
+
+	cfg := &Config{BotDepth: u8Ptr(7)}
+	if err := cfg.Persist(path); err != nil {
+		t.Fatalf("read-only write should be tolerated, got %v", err)
+	}
+}
+
+func TestCreatePrecedence(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.toml")
+	depth := uint8(9)
+	diff := "magnus"
+	token := "secret"
+	args := &Args{
+		EnginePath:   "/opt/engine --uci",
+		Depth:        &depth,
+		Difficulty:   &diff,
+		LichessToken: &token,
+		NoSound:      true,
+	}
+	if err := Create(args, dir, path); err != nil {
+		t.Fatal(err)
+	}
+	cfg := Load(path)
+	if cfg.EnginePath == nil || *cfg.EnginePath != "/opt/engine --uci" {
+		t.Fatalf("engine path = %v", cfg.EnginePath)
+	}
+	if cfg.BotDepth == nil || *cfg.BotDepth != 9 {
+		t.Fatalf("depth = %v", cfg.BotDepth)
+	}
+	if cfg.BotDifficulty == nil || *cfg.BotDifficulty != 3 {
+		t.Fatalf("difficulty = %v", cfg.BotDifficulty)
+	}
+	if cfg.LichessToken == nil || *cfg.LichessToken != "secret" {
+		t.Fatalf("token = %v", cfg.LichessToken)
+	}
+	if cfg.SoundEnabled == nil || *cfg.SoundEnabled {
+		t.Fatalf("sound = %v", cfg.SoundEnabled)
+	}
+}
+
+func TestUnknownDifficultyIsNoOp(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.toml")
+	if err := os.WriteFile(path, []byte("bot_difficulty = 2\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	bad := "nonsense"
+	if err := Create(&Args{Difficulty: &bad}, dir, path); err != nil {
+		t.Fatal(err)
+	}
+	cfg := Load(path)
+	if cfg.BotDifficulty == nil || *cfg.BotDifficulty != 2 {
+		t.Fatalf("difficulty = %v, want unchanged 2", cfg.BotDifficulty)
+	}
+}
