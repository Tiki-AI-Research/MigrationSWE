diff --git a/internal/skin/skin.go b/internal/skin/skin.go
new file mode 100644
index 0000000..cd5b0bd
--- /dev/null
+++ b/internal/skin/skin.go
@@ -0,0 +1,254 @@
+// Package skin preserves the skins.json format and the --skin/--update-skins
+// behavior without the TUI.
+package skin
+
+import (
+	"bufio"
+	"embed"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/thomas-mauran/chess-tui/internal/constants"
+)
+
+//go:embed default_skins.json
+var defaultFS embed.FS
+
+// DefaultSkins returns the embedded default skins.json content.
+func DefaultSkins() []byte {
+	b, err := defaultFS.ReadFile("default_skins.json")
+	if err != nil {
+		return nil
+	}
+	return b
+}
+
+// Color mirrors ratatui's Color serialization: either a named string or a
+// {"Rgb":[r,g,b]} object.
+type Color struct {
+	Name string
+	Rgb  *[3]uint8
+}
+
+// NamedColor builds a color from a name.
+func NamedColor(name string) Color { return Color{Name: name} }
+
+// RgbColor builds an RGB color.
+func RgbColor(r, g, b uint8) Color { return Color{Rgb: &[3]uint8{r, g, b}} }
+
+// MarshalJSON writes the named or RGB form.
+func (c Color) MarshalJSON() ([]byte, error) {
+	if c.Rgb != nil {
+		return json.Marshal(map[string][3]uint8{"Rgb": *c.Rgb})
+	}
+	return json.Marshal(c.Name)
+}
+
+// UnmarshalJSON reads either the named or RGB form.
+func (c *Color) UnmarshalJSON(data []byte) error {
+	trimmed := strings.TrimSpace(string(data))
+	if strings.HasPrefix(trimmed, "\"") {
+		var name string
+		if err := json.Unmarshal(data, &name); err != nil {
+			return err
+		}
+		c.Name = name
+		c.Rgb = nil
+		return nil
+	}
+	var obj map[string][3]uint8
+	if err := json.Unmarshal(data, &obj); err != nil {
+		return err
+	}
+	if rgb, ok := obj["Rgb"]; ok {
+		v := rgb
+		c.Rgb = &v
+		c.Name = ""
+	}
+	return nil
+}
+
+// Skin is a board/piece color theme.
+type Skin struct {
+	Name            string `json:"name"`
+	PieceStyle      string `json:"piece_style"`
+	BoardWhiteColor Color  `json:"board_white_color"`
+	BoardBlackColor Color  `json:"board_black_color"`
+	PieceWhiteColor Color  `json:"piece_white_color"`
+	PieceBlackColor Color  `json:"piece_black_color"`
+	CursorColor     Color  `json:"cursor_color"`
+	SelectionColor  Color  `json:"selection_color"`
+	LastMoveColor   Color  `json:"last_move_color"`
+}
+
+// PieceStyleSize holds the piece characters for one size.
+type PieceStyleSize struct {
+	Bishop string `json:"bishop"`
+	King   string `json:"king"`
+	Knight string `json:"knight"`
+	Pawn   string `json:"pawn"`
+	Queen  string `json:"queen"`
+	Rook   string `json:"rook"`
+}
+
+// PieceStyle is a named piece style with per-size character sets.
+type PieceStyle struct {
+	Name     string         `json:"name"`
+	Small    PieceStyleSize `json:"small"`
+	Compact  PieceStyleSize `json:"compact"`
+	Extended PieceStyleSize `json:"extended"`
+	Large    PieceStyleSize `json:"large"`
+}
+
+// SkinCollection wraps a list of skins.
+type SkinCollection struct {
+	Skins []Skin `json:"skins"`
+}
+
+// PieceStyleCollection wraps a list of piece styles.
+type PieceStyleCollection struct {
+	PieceStyles []PieceStyle `json:"piece_styles"`
+}
+
+// LoadAllSkins reads the skins list from a skins.json file.
+func LoadAllSkins(path string) ([]Skin, error) {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var collection SkinCollection
+	if err := json.Unmarshal(content, &collection); err != nil {
+		return nil, err
+	}
+	return collection.Skins, nil
+}
+
+// LoadAllPieceStyles reads the piece styles from a skins.json file.
+func LoadAllPieceStyles(path string) ([]PieceStyle, error) {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var collection PieceStyleCollection
+	if err := json.Unmarshal(content, &collection); err != nil {
+		return nil, err
+	}
+	return collection.PieceStyles, nil
+}
+
+// GetSkinByName finds a skin by name.
+func GetSkinByName(skins []Skin, name string) (Skin, bool) {
+	for _, s := range skins {
+		if s.Name == name {
+			return s, true
+		}
+	}
+	return Skin{}, false
+}
+
+// ASCII returns the built-in ASCII skin entry.
+func ASCII() Skin {
+	return Skin{
+		Name:            "ASCII",
+		PieceStyle:      "ASCII",
+		BoardWhiteColor: RgbColor(160, 160, 160),
+		BoardBlackColor: RgbColor(128, 95, 69),
+		PieceWhiteColor: NamedColor("White"),
+		PieceBlackColor: NamedColor("Black"),
+		CursorColor:     NamedColor("LightBlue"),
+		SelectionColor:  NamedColor("LightGreen"),
+		LastMoveColor:   NamedColor("LightGreen"),
+	}
+}
+
+// Default returns the built-in default skin entry.
+func Default() Skin {
+	return Skin{
+		Name:            "Default",
+		PieceStyle:      "DEFAULT",
+		BoardWhiteColor: RgbColor(160, 160, 160),
+		BoardBlackColor: RgbColor(128, 95, 69),
+		PieceWhiteColor: NamedColor("White"),
+		PieceBlackColor: NamedColor("Black"),
+		CursorColor:     NamedColor("LightBlue"),
+		SelectionColor:  NamedColor("LightGreen"),
+		LastMoveColor:   NamedColor("LightGreen"),
+	}
+}
+
+// CreateDefaultSkinsFile writes the embedded default skins.json to path.
+func CreateDefaultSkinsFile(path string) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	return os.WriteFile(path, DefaultSkins(), 0o644)
+}
+
+// SkinsPath returns CONFIG_DIR/chess-tui/skins.json.
+func SkinsPath() (string, error) {
+	dir, err := constants.ConfigDir()
+	if err != nil {
+		return "", err
+	}
+	return filepath.Join(dir, "chess-tui", "skins.json"), nil
+}
+
+// RunUpdateSkins implements --update-skins: confirm, archive, overwrite.
+func RunUpdateSkins(in *bufio.Reader, out *os.File) error {
+	configDir, err := constants.ConfigDir()
+	if err != nil {
+		return err
+	}
+	skinsDir := filepath.Join(configDir, "chess-tui")
+	skinsPath := filepath.Join(skinsDir, "skins.json")
+
+	if err := os.MkdirAll(skinsDir, 0o755); err != nil {
+		return err
+	}
+
+	if _, err := os.Stat(skinsPath); os.IsNotExist(err) {
+		if err := os.WriteFile(skinsPath, DefaultSkins(), 0o644); err != nil {
+			return err
+		}
+		fmt.Fprintf(out, "Created skins.json with default content at %s\n", skinsPath)
+		return nil
+	}
+
+	fmt.Fprint(out, "This will replace your skins config with the default. Your current file will be archived in the same folder. Continue? (y/n): ")
+	line, _ := in.ReadString('\n')
+	answer := strings.ToLower(strings.TrimSpace(line))
+	if answer != "y" && answer != "yes" {
+		fmt.Fprintln(out, "Aborted.")
+		return nil
+	}
+
+	timestamp := time.Now().Format("2006-01-02_15-04-05")
+	archivePath := filepath.Join(skinsDir, fmt.Sprintf("skins_%s.json", timestamp))
+
+	content, err := os.ReadFile(skinsPath)
+	if err != nil {
+		return err
+	}
+	if err := os.WriteFile(archivePath, content, 0o644); err != nil {
+		return err
+	}
+	if err := os.WriteFile(skinsPath, DefaultSkins(), 0o644); err != nil {
+		return err
+	}
+
+	fmt.Fprintf(out, "Archived previous config to %s and updated skins.json with default.\n", archivePath)
+	return nil
+}
+
+// sortedSkins is a helper retained for deterministic iteration.
+func sortedSkins(skins []Skin) []Skin {
+	out := make([]Skin, len(skins))
+	copy(out, skins)
+	sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
+	return out
+}
diff --git a/internal/skin/skin_test.go b/internal/skin/skin_test.go
new file mode 100644
index 0000000..ac28ec5
--- /dev/null
+++ b/internal/skin/skin_test.go
@@ -0,0 +1,91 @@
+package skin
+
+import (
+	"bufio"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestColorRoundTrip(t *testing.T) {
+	cases := []string{
+		`"LightBlue"`,
+		`{"Rgb":[160,160,160]}`,
+	}
+	for _, raw := range cases {
+		var c Color
+		if err := json.Unmarshal([]byte(raw), &c); err != nil {
+			t.Fatalf("unmarshal %s: %v", raw, err)
+		}
+		out, err := json.Marshal(c)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var normalized any
+		if err := json.Unmarshal([]byte(raw), &normalized); err != nil {
+			t.Fatal(err)
+		}
+		want, _ := json.Marshal(normalized)
+		if string(out) != string(want) {
+			t.Fatalf("round-trip %s -> %s, want %s", raw, out, want)
+		}
+	}
+}
+
+func TestLoadDefaultSkins(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "skins.json")
+	if err := CreateDefaultSkinsFile(path); err != nil {
+		t.Fatal(err)
+	}
+	skins, err := LoadAllSkins(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := GetSkinByName(skins, "Default"); !ok {
+		t.Fatal("default skins should contain a Default entry")
+	}
+	styles, err := LoadAllPieceStyles(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(styles) == 0 {
+		t.Fatal("expected piece styles")
+	}
+}
+
+func TestRunUpdateSkinsCreatesFile(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("XDG_CONFIG_HOME", dir)
+	var out strings.Builder
+	if err := runUpdateSkinsTo(&out, ""); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "chess-tui", "skins.json")); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out.String(), "Created skins.json") {
+		t.Fatalf("output = %q", out.String())
+	}
+}
+
+// runUpdateSkinsTo is a small test shim around RunUpdateSkins.
+func runUpdateSkinsTo(out *strings.Builder, answer string) error {
+	tmp, err := os.CreateTemp("", "skins-out-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(tmp.Name())
+	if err := RunUpdateSkins(bufio.NewReader(strings.NewReader(answer)), tmp); err != nil {
+		return err
+	}
+	if _, err := tmp.Seek(0, 0); err != nil {
+		return err
+	}
+	buf := make([]byte, 4096)
+	n, _ := tmp.Read(buf)
+	out.Write(buf[:n])
+	return nil
+}
diff --git a/internal/tcp/opponent.go b/internal/tcp/opponent.go
new file mode 100644
index 0000000..e33b8c4
--- /dev/null
+++ b/internal/tcp/opponent.go
@@ -0,0 +1,191 @@
+// Package tcp ports the TCP multiplayer opponent client and server.
+package tcp
+
+import (
+	"fmt"
+	"net"
+	"time"
+
+	chesslib "github.com/notnil/chess"
+	"github.com/thomas-mauran/chess-tui/internal/constants"
+)
+
+// Opponent is a TCP peer connection.
+type Opponent struct {
+	conn             net.Conn
+	OpponentWillMove bool
+	Color            chesslib.Color
+	GameStarted      bool
+	InitialMoveCount int
+	MovesReceived    int
+}
+
+// New connects to addr (retrying five times) and returns an opponent. When
+// color is nil the color token is read from the stream.
+func New(addr string, color *chesslib.Color) (*Opponent, error) {
+	var conn net.Conn
+	var err error
+	for attempt := 1; attempt <= 5; attempt++ {
+		conn, err = net.DialTimeout("tcp", addr, 2*time.Second)
+		if err == nil {
+			break
+		}
+	}
+	if conn == nil {
+		return nil, fmt.Errorf("Failed to connect to the server after 5 attempts to the following address %s", addr)
+	}
+
+	resolved := chesslib.Black
+	if color != nil {
+		resolved = *color
+	} else {
+		c, err := GetColorFromStream(conn)
+		if err != nil {
+			_ = conn.Close()
+			return nil, err
+		}
+		resolved = c
+	}
+
+	return &Opponent{
+		conn:             conn,
+		OpponentWillMove: resolved == chesslib.White,
+		Color:            resolved,
+	}, nil
+}
+
+// Conn returns the underlying connection.
+func (o *Opponent) Conn() net.Conn { return o.conn }
+
+// Close closes the underlying connection.
+func (o *Opponent) Close() error {
+	if o.conn == nil {
+		return nil
+	}
+	return o.conn.Close()
+}
+
+// SendEndGameToServer writes the ended token.
+func (o *Opponent) SendEndGameToServer() {
+	if o.conn == nil {
+		return
+	}
+	_, _ = o.conn.Write([]byte("ended"))
+}
+
+// SendMoveToServer sends a move as from+to plus an optional promotion suffix.
+func (o *Opponent) SendMoveToServer(from, to chesslib.Square, promotion chesslib.PieceType) {
+	if o.conn == nil {
+		return
+	}
+	moveStr := SquareString(from) + SquareString(to) + PromotionSuffix(promotion)
+	_, _ = o.conn.Write([]byte(moveStr))
+}
+
+// ReadStream performs a non-blocking read, returning "" when no data is ready.
+// A peer that disconnects or sends the ended token surfaces as an error.
+func (o *Opponent) ReadStream() (string, error) {
+	if o.conn == nil {
+		return "", nil
+	}
+	buf := make([]byte, constants.NetworkBufferSize)
+	_ = o.conn.SetReadDeadline(time.Now())
+	n, err := o.conn.Read(buf)
+	if err != nil {
+		if ne, ok := err.(net.Error); ok && ne.Timeout() {
+			return "", nil
+		}
+		return "", nil
+	}
+	if n == 0 {
+		return "", nil
+	}
+	response := string(buf[:n])
+	if trimSpace(response) == "ended" || trimSpace(response) == "" {
+		return "", fmt.Errorf("Game ended by the other opponent")
+	}
+	return response, nil
+}
+
+// GetColorFromStream reads a w/b color token from the stream.
+func GetColorFromStream(conn net.Conn) (chesslib.Color, error) {
+	buf := make([]byte, constants.NetworkBufferSize)
+	n, err := conn.Read(buf)
+	if err != nil {
+		return chesslib.NoColor, fmt.Errorf("Failed to read color from stream: %v", err)
+	}
+	switch string(buf[:n]) {
+	case "w":
+		return chesslib.White, nil
+	case "b":
+		return chesslib.Black, nil
+	default:
+		return chesslib.NoColor, fmt.Errorf("Failed to get color from stream")
+	}
+}
+
+// WaitForGameStart performs a non-blocking read and accepts only the start
+// token "s".
+func WaitForGameStart(o *Opponent) (bool, error) {
+	if o.conn == nil {
+		return false, fmt.Errorf("No opponent connected")
+	}
+	buf := make([]byte, constants.NetworkBufferSize)
+	_ = o.conn.SetReadDeadline(time.Now())
+	n, err := o.conn.Read(buf)
+	if err != nil {
+		if ne, ok := err.(net.Error); ok && ne.Timeout() {
+			return false, nil
+		}
+		return false, fmt.Errorf("Failed to read start signal from stream: %v", err)
+	}
+	if n == 0 {
+		return false, nil
+	}
+	switch string(buf[:n]) {
+	case "s":
+		return true, nil
+	default:
+		return false, fmt.Errorf("Failed to get start signal from stream")
+	}
+}
+
+// SquareString renders a square in algebraic form.
+func SquareString(sq chesslib.Square) string {
+	if sq == chesslib.NoSquare {
+		return ""
+	}
+	return sq.String()
+}
+
+// PromotionSuffix maps a promotion piece to its wire suffix.
+func PromotionSuffix(promotion chesslib.PieceType) string {
+	switch promotion {
+	case chesslib.Queen:
+		return "q"
+	case chesslib.Rook:
+		return "r"
+	case chesslib.Bishop:
+		return "b"
+	case chesslib.Knight:
+		return "n"
+	default:
+		return ""
+	}
+}
+
+func trimSpace(s string) string {
+	start := 0
+	for start < len(s) && isSpace(s[start]) {
+		start++
+	}
+	end := len(s)
+	for end > start && isSpace(s[end-1]) {
+		end--
+	}
+	return s[start:end]
+}
+
+func isSpace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
+}
diff --git a/internal/tcp/protocol_test.go b/internal/tcp/protocol_test.go
new file mode 100644
index 0000000..9855011
--- /dev/null
+++ b/internal/tcp/protocol_test.go
@@ -0,0 +1,128 @@
+package tcp
+
+import (
+	"net"
+	"testing"
+	"time"
+)
+
+func startServer(t *testing.T, hostWhite bool) (string, *GameServer) {
+	t.Helper()
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := NewGameServer(hostWhite)
+	go server.Serve(lis)
+	t.Cleanup(server.Stop)
+	return lis.Addr().String(), server
+}
+
+func dial(t *testing.T, addr string) net.Conn {
+	t.Helper()
+	conn, err := net.Dial("tcp", addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	return conn
+}
+
+func readN(t *testing.T, conn net.Conn, n int) string {
+	t.Helper()
+	buf := make([]byte, n)
+	_ = conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+	got, err := conn.Read(buf)
+	if err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	return string(buf[:got])
+}
+
+func TestJoinColorAndStart(t *testing.T) {
+	addr, _ := startServer(t, true)
+	host := dial(t, addr)
+	time.Sleep(50 * time.Millisecond)
+	joiner := dial(t, addr)
+
+	if got := readN(t, joiner, 1); got != "w" {
+		t.Fatalf("joiner color = %q, want w", got)
+	}
+	if got := readN(t, host, 1); got != "s" {
+		t.Fatalf("host start = %q, want s", got)
+	}
+}
+
+func TestThirdClientRejected(t *testing.T) {
+	addr, _ := startServer(t, true)
+	_ = dial(t, addr)
+	time.Sleep(50 * time.Millisecond)
+	_ = dial(t, addr)
+	time.Sleep(50 * time.Millisecond)
+	third := dial(t, addr)
+
+	buf := make([]byte, 64)
+	_ = third.SetReadDeadline(time.Now().Add(2 * time.Second))
+	n, err := third.Read(buf)
+	if err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	if string(buf[:n]) != "Game is already full" {
+		t.Fatalf("third client = %q", string(buf[:n]))
+	}
+}
+
+func TestRelayWithoutEcho(t *testing.T) {
+	addr, _ := startServer(t, true)
+	host := dial(t, addr)
+	time.Sleep(50 * time.Millisecond)
+	joiner := dial(t, addr)
+	readN(t, joiner, 1) // color
+	readN(t, host, 1)   // start
+
+	if _, err := host.Write([]byte("e2e4")); err != nil {
+		t.Fatal(err)
+	}
+	if got := readN(t, joiner, 5); got != "e2e4" {
+		t.Fatalf("relayed = %q", got)
+	}
+
+	// The sender must not receive its own message back.
+	_ = host.SetReadDeadline(time.Now().Add(300 * time.Millisecond))
+	buf := make([]byte, 5)
+	if _, err := host.Read(buf); err == nil {
+		t.Fatal("sender should not receive an echo")
+	}
+}
+
+func TestEndedBroadcast(t *testing.T) {
+	addr, _ := startServer(t, true)
+	host := dial(t, addr)
+	time.Sleep(50 * time.Millisecond)
+	joiner := dial(t, addr)
+	readN(t, joiner, 1)
+	readN(t, host, 1)
+
+	if _, err := host.Write([]byte("ended")); err != nil {
+		t.Fatal(err)
+	}
+	if got := readN(t, joiner, 5); got != "ended" {
+		t.Fatalf("broadcast = %q, want ended", got)
+	}
+}
+
+func TestMoveFraming(t *testing.T) {
+	addr, _ := startServer(t, true)
+	host := dial(t, addr)
+	time.Sleep(50 * time.Millisecond)
+	joiner := dial(t, addr)
+	readN(t, joiner, 1)
+	readN(t, host, 1)
+
+	if _, err := joiner.Write([]byte("e7e8q")); err != nil {
+		t.Fatal(err)
+	}
+	if got := readN(t, host, 5); got != "e7e8q" {
+		t.Fatalf("framed = %q", got)
+	}
+}
diff --git a/internal/tcp/server.go b/internal/tcp/server.go
new file mode 100644
index 0000000..60a32a9
--- /dev/null
+++ b/internal/tcp/server.go
@@ -0,0 +1,214 @@
+package tcp
+
+import (
+	"fmt"
+	"net"
+	"sync"
+	"time"
+
+	chesslib "github.com/notnil/chess"
+	"github.com/thomas-mauran/chess-tui/internal/constants"
+)
+
+type client struct {
+	addr string
+	conn net.Conn
+}
+
+// GameServer is the TCP multiplayer server.
+type GameServer struct {
+	mu          sync.Mutex
+	clients     []*client
+	IsHostWhite bool
+
+	stopOnce sync.Once
+	stop     chan struct{}
+	listener net.Listener
+}
+
+// NewGameServer creates a server for the given host color.
+func NewGameServer(isHostWhite bool) *GameServer {
+	return &GameServer{
+		IsHostWhite: isHostWhite,
+		stop:        make(chan struct{}),
+	}
+}
+
+// Run binds 0.0.0.0:2308 and serves until Stop is called.
+func (s *GameServer) Run() {
+	listener, err := net.Listen("tcp", fmt.Sprintf("0.0.0.0:%d", constants.NetworkPort))
+	if err != nil {
+		return
+	}
+	s.mu.Lock()
+	s.listener = listener
+	s.mu.Unlock()
+	s.serve(listener)
+}
+
+// Serve accepts connections from an existing listener.
+func (s *GameServer) Serve(listener net.Listener) {
+	s.mu.Lock()
+	s.listener = listener
+	s.mu.Unlock()
+	s.serve(listener)
+}
+
+func (s *GameServer) serve(listener net.Listener) {
+	done := make(chan struct{})
+	go func() {
+		select {
+		case <-s.stop:
+		case <-done:
+		}
+		_ = listener.Close()
+	}()
+
+	for {
+		conn, err := listener.Accept()
+		if err != nil {
+			select {
+			case <-s.stop:
+				close(done)
+				return
+			default:
+			}
+			if ne, ok := err.(net.Error); ok && ne.Timeout() {
+				time.Sleep(constants.SleepDurationLongMs * time.Millisecond)
+				continue
+			}
+			close(done)
+			return
+		}
+		go s.handleJoin(conn)
+	}
+}
+
+func (s *GameServer) handleJoin(conn net.Conn) {
+	s.mu.Lock()
+	switch {
+	case len(s.clients) == 1:
+		color := "w"
+		if !s.IsHostWhite {
+			color = "b"
+		}
+		_, _ = conn.Write([]byte(color))
+		other := s.clients[0]
+		_, _ = other.conn.Write([]byte("s"))
+	case len(s.clients) >= 2:
+		_, _ = conn.Write([]byte("Game is already full"))
+		s.mu.Unlock()
+		_ = conn.Close()
+		return
+	}
+	s.clients = append(s.clients, &client{addr: conn.RemoteAddr().String(), conn: conn})
+	s.mu.Unlock()
+
+	s.HandleClient(conn)
+}
+
+// HandleClient relays messages from conn to the other client without echoing,
+// broadcasting the ended token on disconnect or the ended token.
+func (s *GameServer) HandleClient(conn net.Conn) {
+	addr := conn.RemoteAddr().String()
+	buf := make([]byte, constants.NetworkBufferSize)
+
+	for {
+		select {
+		case <-s.stop:
+			return
+		default:
+		}
+
+		_ = conn.SetReadDeadline(time.Now().Add(constants.SleepDurationShortMs * time.Millisecond))
+		n, err := conn.Read(buf)
+		if err != nil {
+			if ne, ok := err.(net.Error); ok && ne.Timeout() {
+				continue
+			}
+			s.BroadcastMessage("ended", conn)
+			s.RemoveClient(addr)
+			s.Stop()
+			return
+		}
+		if n == 0 {
+			s.BroadcastMessage("ended", conn)
+			s.RemoveClient(addr)
+			s.Stop()
+			return
+		}
+
+		request := string(buf[:n])
+		s.BroadcastMessage(request, conn)
+
+		if trimSpace(request) == "ended" {
+			s.RemoveClient(addr)
+			s.Stop()
+			return
+		}
+	}
+}
+
+// BroadcastMessage sends a message to every client except sender.
+func (s *GameServer) BroadcastMessage(message string, sender net.Conn) {
+	s.mu.Lock()
+	clients := make([]*client, len(s.clients))
+	copy(clients, s.clients)
+	s.mu.Unlock()
+
+	for _, c := range clients {
+		if c.conn == sender {
+			continue
+		}
+		_ = c.conn.SetWriteDeadline(time.Now().Add(time.Second))
+		_, _ = c.conn.Write([]byte(message))
+	}
+}
+
+// RemoveClient drops a client from the roster.
+func (s *GameServer) RemoveClient(addr string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for i, c := range s.clients {
+		if c.addr == addr {
+			s.clients = append(s.clients[:i], s.clients[i+1:]...)
+			return
+		}
+	}
+}
+
+// Stop shuts the server down and closes remaining connections.
+func (s *GameServer) Stop() {
+	s.stopOnce.Do(func() {
+		close(s.stop)
+		s.mu.Lock()
+		clients := make([]*client, len(s.clients))
+		copy(clients, s.clients)
+		s.mu.Unlock()
+		for _, c := range clients {
+			_ = c.conn.Close()
+		}
+	})
+}
+
+// SetupGameServer starts a server for the given host color in the background.
+func SetupGameServer(hostColor chesslib.Color) *GameServer {
+	server := NewGameServer(hostColor == chesslib.White)
+	go server.Run()
+	time.Sleep(constants.SleepDurationLongMs * time.Millisecond)
+	return server
+}
+
+// GetHostIP returns the machine's outbound IP address, if discoverable.
+func GetHostIP() (net.IP, error) {
+	conn, err := net.Dial("udp", "8.8.8.8:80")
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	local := conn.LocalAddr()
+	if udp, ok := local.(*net.UDPAddr); ok {
+		return udp.IP, nil
+	}
+	return nil, fmt.Errorf("Failed to determine host IP")
+}
diff --git a/internal/uci/bot.go b/internal/uci/bot.go
new file mode 100644
index 0000000..82fb2ff
--- /dev/null
+++ b/internal/uci/bot.go
@@ -0,0 +1,180 @@
+// Package uci ports the UCI chess engine client.
+package uci
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"os/exec"
+	"strings"
+
+	chesslib "github.com/notnil/chess"
+	"github.com/thomas-mauran/chess-tui/internal/constants"
+)
+
+// Bot is a UCI engine wrapper with difficulty configuration.
+type Bot struct {
+	EnginePath    string
+	BotWillMove   bool
+	IsBotStarting bool
+	// Depth is the base depth used when difficulty is off.
+	Depth uint8
+	// Difficulty preset index: nil = off (full strength), 0..3 otherwise.
+	Difficulty *uint8
+}
+
+// New creates a bot.
+func New(enginePath string, isBotStarting bool, depth uint8, difficulty *uint8) *Bot {
+	return &Bot{
+		EnginePath:    enginePath,
+		IsBotStarting: isBotStarting,
+		Depth:         depth,
+		Difficulty:    difficulty,
+	}
+}
+
+// EffectiveDepth returns the preset depth when a difficulty is set, else the
+// base depth.
+func (b *Bot) EffectiveDepth() uint8 {
+	if b.Difficulty != nil {
+		idx := int(*b.Difficulty)
+		if idx >= 0 && idx < len(constants.BotDifficultyDepth) {
+			return constants.BotDifficultyDepth[idx]
+		}
+	}
+	return b.Depth
+}
+
+// MovetimeMs returns the preset movetime in milliseconds when a difficulty is
+// set.
+func (b *Bot) MovetimeMs() (int, bool) {
+	if b.Difficulty != nil {
+		idx := int(*b.Difficulty)
+		if idx >= 0 && idx < len(constants.BotDifficultyMovetimeMs) {
+			return constants.BotDifficultyMovetimeMs[idx], true
+		}
+	}
+	return 0, false
+}
+
+// Elo returns the preset ELO when a difficulty is set.
+func (b *Bot) Elo() (uint16, bool) {
+	if b.Difficulty != nil {
+		idx := int(*b.Difficulty)
+		if idx >= 0 && idx < len(constants.BotDifficultyElo) {
+			return constants.BotDifficultyElo[idx], true
+		}
+	}
+	return 0, false
+}
+
+// GetMove spawns the engine, performs the UCI handshake, sends the position
+// and search parameters, and returns the engine's best move.
+func (b *Bot) GetMove(fen string) (string, error) {
+	if _, err := chesslib.FEN(fen); err != nil {
+		return "", fmt.Errorf("Failed to parse FEN '%s': %v", fen, err)
+	}
+
+	parts := strings.Fields(b.EnginePath)
+	var cmd *exec.Cmd
+	if len(parts) == 0 {
+		cmd = exec.Command(b.EnginePath)
+	} else {
+		cmd = exec.Command(parts[0], parts[1:]...)
+	}
+
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		return "", fmt.Errorf("Failed to initialize engine: %v", err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return "", fmt.Errorf("Failed to initialize engine: %v", err)
+	}
+
+	if err := cmd.Start(); err != nil {
+		return "", fmt.Errorf("Failed to spawn engine process: %v", err)
+	}
+	defer func() {
+		_ = stdin.Close()
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+	}()
+
+	reader := bufio.NewReader(stdout)
+
+	if err := sendLine(stdin, "uci"); err != nil {
+		return "", fmt.Errorf("Failed UCI handshake: %v", err)
+	}
+	if err := waitFor(reader, "uciok"); err != nil {
+		return "", fmt.Errorf("Failed UCI handshake: %v", err)
+	}
+
+	if elo, ok := b.Elo(); ok {
+		if err := sendLine(stdin, "setoption name UCI_LimitStrength value true"); err != nil {
+			return "", fmt.Errorf("Failed to set UCI_LimitStrength: %v", err)
+		}
+		if err := sendLine(stdin, fmt.Sprintf("setoption name UCI_Elo value %d", elo)); err != nil {
+			return "", fmt.Errorf("Failed to set UCI_Elo: %v", err)
+		}
+	}
+
+	if err := sendLine(stdin, "position fen "+fen); err != nil {
+		return "", fmt.Errorf("Failed to send position to engine: %v", err)
+	}
+
+	depth := b.EffectiveDepth()
+	goCmd := fmt.Sprintf("go depth %d", depth)
+	if ms, ok := b.MovetimeMs(); ok {
+		goCmd += fmt.Sprintf(" movetime %d", ms)
+	}
+	if err := sendLine(stdin, goCmd); err != nil {
+		return "", fmt.Errorf("Engine failed to compute move: %v", err)
+	}
+
+	for {
+		line, err := reader.ReadString('\n')
+		trimmed := strings.TrimSpace(line)
+		if strings.HasPrefix(trimmed, "bestmove") {
+			fields := strings.Fields(trimmed)
+			if len(fields) < 2 {
+				return "", fmt.Errorf("Engine returned non-normal move")
+			}
+			move := fields[1]
+			if move == "0000" || move == "(none)" || move == "null" {
+				return "", fmt.Errorf("Engine returned non-normal move")
+			}
+			return move, nil
+		}
+		if err != nil {
+			if err == io.EOF {
+				return "", fmt.Errorf("Engine failed to compute move: engine exited without bestmove")
+			}
+			return "", fmt.Errorf("Engine failed to compute move: %v", err)
+		}
+	}
+}
+
+func sendLine(w io.Writer, line string) error {
+	_, err := io.WriteString(w, line+"\n")
+	return err
+}
+
+func waitFor(reader *bufio.Reader, target string) error {
+	for {
+		line, err := reader.ReadString('\n')
+		trimmed := strings.TrimSpace(line)
+		if target != "" && trimmed == target {
+			return nil
+		}
+		if strings.HasPrefix(trimmed, target) {
+			return nil
+		}
+		if err != nil {
+			if err == io.EOF {
+				return fmt.Errorf("engine closed the connection")
+			}
+			return err
+		}
+	}
+}
diff --git a/internal/uci/bot_test.go b/internal/uci/bot_test.go
new file mode 100644
index 0000000..d29b7c7
--- /dev/null
+++ b/internal/uci/bot_test.go
@@ -0,0 +1,160 @@
+package uci
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+)
+
+// TestHelperProcess is not a real test: it acts as a stub UCI engine when
+// re-executed by the test binary.
+func TestHelperProcess(t *testing.T) {
+	if os.Getenv("GO_WANT_HELPER_PROCESS") != "1" {
+		return
+	}
+	logPath := os.Getenv("STUB_LOG")
+	scanner := bufio.NewScanner(os.Stdin)
+	for scanner.Scan() {
+		line := scanner.Text()
+		if logPath != "" {
+			if f, err := os.OpenFile(logPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644); err == nil {
+				fmt.Fprintln(f, line)
+				f.Close()
+			}
+		}
+		switch {
+		case line == "uci":
+			fmt.Println("id name StubEngine")
+			fmt.Println("uciok")
+		case strings.HasPrefix(line, "go"):
+			fmt.Println("info depth 1 score cp 0")
+			fmt.Println("bestmove e2e4")
+		}
+	}
+	os.Exit(0)
+}
+
+func stubEngine(t *testing.T) (string, string) {
+	t.Helper()
+	logPath := t.TempDir() + "/stub.log"
+	enginePath := os.Args[0] + " -test.run=TestHelperProcess"
+	return enginePath, logPath
+}
+
+func configureStub(t *testing.T, logPath string) {
+	t.Setenv("GO_WANT_HELPER_PROCESS", "1")
+	t.Setenv("STUB_LOG", logPath)
+}
+
+func readCommands(t *testing.T, path string) []string {
+	t.Helper()
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	return strings.Split(strings.TrimSpace(string(content)), "\n")
+}
+
+const startFEN = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
+
+func TestHandshakeOrder(t *testing.T) {
+	enginePath, logPath := stubEngine(t)
+	configureStub(t, logPath)
+
+	bot := New(enginePath, false, 6, nil)
+	move, err := bot.GetMove(startFEN)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if move != "e2e4" {
+		t.Fatalf("move = %q", move)
+	}
+	cmds := readCommands(t, logPath)
+	idx := func(prefix string) int {
+		for i, c := range cmds {
+			if strings.HasPrefix(c, prefix) {
+				return i
+			}
+		}
+		return -1
+	}
+	if uci, pos, goIdx := idx("uci"), idx("position"), idx("go "); !(uci >= 0 && pos > uci && goIdx > pos) {
+		t.Fatalf("handshake order wrong: %v", cmds)
+	}
+	if strings.Contains(strings.Join(cmds, "\n"), "go depth 6") == false {
+		t.Fatalf("expected 'go depth 6': %v", cmds)
+	}
+}
+
+func TestLimitStrengthElo(t *testing.T) {
+	enginePath, logPath := stubEngine(t)
+	configureStub(t, logPath)
+
+	diff := uint8(0)
+	bot := New(enginePath, false, 10, &diff)
+	if _, err := bot.GetMove(startFEN); err != nil {
+		t.Fatal(err)
+	}
+	joined := strings.Join(readCommands(t, logPath), "\n")
+	if !strings.Contains(joined, "setoption name UCI_LimitStrength value true") {
+		t.Fatalf("missing UCI_LimitStrength: %s", joined)
+	}
+	if !strings.Contains(joined, "setoption name UCI_Elo value 400") {
+		t.Fatalf("missing UCI_Elo: %s", joined)
+	}
+	if !strings.Contains(joined, "go depth 1 movetime 25") {
+		t.Fatalf("expected preset go params: %s", joined)
+	}
+}
+
+func TestGoParamsFullStrength(t *testing.T) {
+	enginePath, logPath := stubEngine(t)
+	configureStub(t, logPath)
+
+	bot := New(enginePath, false, 12, nil)
+	if _, err := bot.GetMove(startFEN); err != nil {
+		t.Fatal(err)
+	}
+	joined := strings.Join(readCommands(t, logPath), "\n")
+	if !strings.Contains(joined, "go depth 12") {
+		t.Fatalf("expected 'go depth 12': %s", joined)
+	}
+	if strings.Contains(joined, "movetime") {
+		t.Fatalf("full strength should have no movetime: %s", joined)
+	}
+	if strings.Contains(joined, "UCI_LimitStrength") {
+		t.Fatalf("full strength should not set limit strength: %s", joined)
+	}
+}
+
+func TestPositionFen(t *testing.T) {
+	enginePath, logPath := stubEngine(t)
+	configureStub(t, logPath)
+
+	bot := New(enginePath, false, 5, nil)
+	if _, err := bot.GetMove(startFEN); err != nil {
+		t.Fatal(err)
+	}
+	joined := strings.Join(readCommands(t, logPath), "\n")
+	if !strings.Contains(joined, "position fen "+startFEN) {
+		t.Fatalf("expected position fen: %s", joined)
+	}
+}
+
+func TestSpawnError(t *testing.T) {
+	bot := New("/nonexistent/engine-binary-does-not-exist", false, 5, nil)
+	_, err := bot.GetMove(startFEN)
+	if err == nil || !strings.Contains(err.Error(), "Failed to spawn engine process") {
+		t.Fatalf("err = %v", err)
+	}
+}
+
+func TestInvalidFEN(t *testing.T) {
+	bot := New("/nonexistent/engine", false, 5, nil)
+	_, err := bot.GetMove("not-a-fen")
+	if err == nil || !strings.HasPrefix(err.Error(), "Failed to parse FEN") {
+		t.Fatalf("err = %v", err)
+	}
+}
diff --git a/main.go b/main.go
new file mode 100644
index 0000000..9f690ac
--- /dev/null
+++ b/main.go
@@ -0,0 +1,198 @@
+package main
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/thomas-mauran/chess-tui/internal/config"
+	"github.com/thomas-mauran/chess-tui/internal/constants"
+	"github.com/thomas-mauran/chess-tui/internal/pgn"
+	"github.com/thomas-mauran/chess-tui/internal/skin"
+)
+
+// settings holds the effective runtime settings after applying CLI-over-config
+// precedence.
+type settings struct {
+	EnginePath   string
+	Depth        uint8
+	Difficulty   *uint8
+	LichessToken *string
+	SoundEnabled bool
+	Skin         string
+}
+
+func main() {
+	os.Exit(run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr))
+}
+
+// run executes the CLI and returns the process exit code.
+func run(arguments []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	args, err := config.ParseArgs(arguments)
+	if err != nil {
+		fmt.Fprintf(stderr, "Failed to parse arguments: %v\n", err)
+		return 1
+	}
+
+	// --update-skins is dispatched before any other work.
+	if args.UpdateSkins {
+		if err := skin.RunUpdateSkins(bufio.NewReader(stdin), fileWriter(stdout)); err != nil {
+			fmt.Fprintf(stderr, "Failed to update skins: %v\n", err)
+			return 1
+		}
+		return 0
+	}
+
+	configDir, err := constants.ConfigDir()
+	if err != nil {
+		fmt.Fprintf(stderr, "Failed to determine config directory: %v\n", err)
+		return 1
+	}
+	folderPath := filepath.Join(configDir, "chess-tui")
+	configPath := filepath.Join(folderPath, "config.toml")
+
+	if err := config.Create(args, folderPath, configPath); err != nil {
+		fmt.Fprintf(stderr, "Failed to create config: %v\n", err)
+		return 1
+	}
+
+	cfg := config.Load(configPath)
+	effective := resolveSettings(args, cfg)
+
+	// Ensure skins.json exists and load the available skins/piece styles.
+	skinsPath := filepath.Join(folderPath, "skins.json")
+	if _, err := os.Stat(skinsPath); os.IsNotExist(err) {
+		if err := skin.CreateDefaultSkinsFile(skinsPath); err != nil {
+			fmt.Fprintf(stderr, "Failed to create default skins.json: %v\n", err)
+		}
+	}
+	availableSkins := []skin.Skin{skin.Default(), skin.ASCII()}
+	if custom, err := skin.LoadAllSkins(skinsPath); err == nil {
+		for _, s := range custom {
+			if s.Name != constants.SkinNameDefault && s.Name != constants.SkinNameASCII {
+				availableSkins = append(availableSkins, s)
+			}
+		}
+	}
+	if _, ok := skin.GetSkinByName(availableSkins, effective.Skin); !ok {
+		effective.Skin = availableSkins[0].Name
+	}
+
+	if args.Pgn != nil {
+		games, err := loadPGN(*args.Pgn, stderr)
+		if err != nil {
+			fmt.Fprintf(stderr, "Failed to load PGN '%s': %v\n", *args.Pgn, err)
+			return 1
+		}
+		_ = games
+	}
+
+	_ = effective
+	return 0
+}
+
+// resolveSettings applies CLI values on top of the persisted config.
+func resolveSettings(args *config.Args, cfg *config.Config) settings {
+	s := settings{
+		Depth:        10,
+		SoundEnabled: true,
+		Skin:         "Default",
+	}
+	if cfg != nil {
+		if cfg.EnginePath != nil {
+			s.EnginePath = *cfg.EnginePath
+		}
+		if cfg.BotDepth != nil {
+			s.Depth = *cfg.BotDepth
+		}
+		if cfg.BotDifficulty != nil {
+			d := *cfg.BotDifficulty
+			s.Difficulty = &d
+		}
+		if cfg.LichessToken != nil {
+			t := *cfg.LichessToken
+			s.LichessToken = &t
+		}
+		if cfg.SoundEnabled != nil {
+			s.SoundEnabled = *cfg.SoundEnabled
+		}
+		if cfg.SelectedSkinName != nil {
+			s.Skin = *cfg.SelectedSkinName
+		}
+	}
+
+	if args.EnginePath != "" {
+		s.EnginePath = args.EnginePath
+	}
+	if args.Depth != nil {
+		s.Depth = *args.Depth
+	}
+	if args.Difficulty != nil {
+		if idx, ok := config.ParseDifficulty(*args.Difficulty); ok {
+			s.Difficulty = &idx
+		}
+	}
+	if args.LichessToken != nil {
+		t := *args.LichessToken
+		s.LichessToken = &t
+	}
+	if args.NoSound {
+		s.SoundEnabled = false
+	}
+	if args.Skin != nil {
+		s.Skin = *args.Skin
+	}
+	return s
+}
+
+// loadPGN loads a PGN file or every .pgn file in a directory (sorted).
+func loadPGN(path string, stderr io.Writer) ([]*pgn.Viewer, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() {
+		return pgn.FromFile(path)
+	}
+
+	entries, err := os.ReadDir(path)
+	if err != nil {
+		return nil, err
+	}
+	var files []string
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		if strings.EqualFold(filepath.Ext(e.Name()), ".pgn") {
+			files = append(files, filepath.Join(path, e.Name()))
+		}
+	}
+	sort.Strings(files)
+
+	var all []*pgn.Viewer
+	for _, f := range files {
+		games, err := pgn.FromFile(f)
+		if err != nil {
+			fmt.Fprintf(stderr, "Skipping %s: %v\n", f, err)
+			continue
+		}
+		all = append(all, games...)
+	}
+	if len(all) == 0 {
+		return nil, fmt.Errorf("No valid .pgn files found in '%s'", path)
+	}
+	return all, nil
+}
+
+// fileWriter adapts an io.Writer to the *os.File expected by RunUpdateSkins.
+func fileWriter(w io.Writer) *os.File {
+	if f, ok := w.(*os.File); ok {
+		return f
+	}
+	return os.Stdout
+}
diff --git a/main_test.go b/main_test.go
new file mode 100644
index 0000000..95fcb25
--- /dev/null
+++ b/main_test.go
@@ -0,0 +1,120 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/thomas-mauran/chess-tui/internal/config"
+)
+
+const simplePGN = `[Event "%s"]
+[White "W"]
+[Black "B"]
+[Result "1-0"]
+
+1. e4 e5 2. Nf3 1-0
+`
+
+func TestFlagsAcceptedMain(t *testing.T) {
