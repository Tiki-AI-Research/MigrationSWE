diff --git a/internal/lichess/game.go b/internal/lichess/game.go
new file mode 100644
index 0000000..8c41bff
--- /dev/null
+++ b/internal/lichess/game.go
@@ -0,0 +1,309 @@
+package lichess
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	chesslib "github.com/notnil/chess"
+)
+
+// GetGameInfo fetches the turn count and last move for a game.
+func (c *Client) GetGameInfo(gameID string) (int, *string, error) {
+	url := c.baseURL() + "/stream/game/" + gameID
+	req, err := c.newRequest(http.MethodGet, url, nil)
+	if err != nil {
+		return 0, nil, err
+	}
+	resp, err := c.httpClient().Do(req)
+	if err != nil {
+		return 0, nil, err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return 0, nil, fmt.Errorf("Failed to get game info: %s", resp.Status)
+	}
+
+	reader := bufio.NewReader(resp.Body)
+	line, err := reader.ReadString('\n')
+	if err != nil && err != io.EOF {
+		return 0, nil, fmt.Errorf("Failed to get game info: %v", err)
+	}
+	if strings.TrimSpace(line) == "" {
+		return 0, nil, fmt.Errorf("Empty response from stream")
+	}
+
+	var payload struct {
+		Turns    *uint64 `json:"turns"`
+		LastMove *string `json:"lastMove"`
+	}
+	if err := json.Unmarshal([]byte(line), &payload); err != nil {
+		return 0, nil, fmt.Errorf("Failed to parse JSON from stream")
+	}
+	turns := 0
+	if payload.Turns != nil {
+		turns = int(*payload.Turns)
+	}
+	return turns, payload.LastMove, nil
+}
+
+// MakeMove posts a move for a game.
+func (c *Client) MakeMove(gameID, move string) error {
+	url := c.baseURL() + "/board/game/" + gameID + "/move/" + move
+	req, err := c.newRequest(http.MethodPost, url, nil)
+	if err != nil {
+		return err
+	}
+	resp, err := c.httpClient().Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("Failed to make move: %s", resp.Status)
+	}
+	return nil
+}
+
+// ResignGame resigns a game.
+func (c *Client) ResignGame(gameID string) error {
+	url := c.baseURL() + "/board/game/" + gameID + "/resign"
+	req, err := c.newRequest(http.MethodPost, url, nil)
+	if err != nil {
+		return err
+	}
+	resp, err := c.httpClient().Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		body, _ := io.ReadAll(resp.Body)
+		return fmt.Errorf("Failed to resign game: %s - %s", resp.Status, string(body))
+	}
+	return nil
+}
+
+// SeekGame requests a game pairing, opening the event stream first.
+func (c *Client) SeekGame(timeMs, increment uint32, cancel *atomic.Bool) (string, chesslib.Color, error) {
+	initial := map[string]struct{}{}
+	if games, err := c.GetOngoingGames(); err == nil {
+		for _, g := range games {
+			initial[g.GameID] = struct{}{}
+		}
+	}
+
+	found := make(chan GameFound, 1)
+	c.SpawnEventStream(initial, cancel, found)
+
+	time.Sleep(500 * time.Millisecond)
+
+	form := url.Values{}
+	form.Set("rated", "true")
+	form.Set("variant", "standard")
+	form.Set("ratingRange", "")
+	form.Set("color", "random")
+	correspondence := timeMs == 0 && increment == 0
+	if correspondence {
+		form.Set("days", "3")
+	} else {
+		form.Set("time", fmt.Sprintf("%d", timeMs))
+		form.Set("increment", fmt.Sprintf("%d", increment))
+	}
+
+	seekURL := c.baseURL() + "/board/seek"
+	req, err := c.newRequest(http.MethodPost, seekURL, strings.NewReader(form.Encode()))
+	if err != nil {
+		return "", chesslib.NoColor, err
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+
+	resp, err := c.httpClient().Do(req)
+	if err != nil {
+		return "", chesslib.NoColor, err
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		body, _ := io.ReadAll(resp.Body)
+		resp.Body.Close()
+		return "", chesslib.NoColor, seekError(resp.StatusCode, string(body))
+	}
+
+	if correspondence {
+		_, _ = io.ReadAll(resp.Body)
+		resp.Body.Close()
+	} else {
+		// Keep the connection open while polling for the event stream result.
+		go func() {
+			_, _ = io.Copy(io.Discard, resp.Body)
+			resp.Body.Close()
+		}()
+	}
+
+	maxWait := 10
+	if correspondence {
+		maxWait = 300
+	}
+	for i := 0; i < maxWait; i++ {
+		if cancel != nil && cancel.Load() {
+			return "", chesslib.NoColor, fmt.Errorf("Seek cancelled")
+		}
+		select {
+		case res := <-found:
+			if res.Err != nil {
+				return "", chesslib.NoColor, res.Err
+			}
+			return res.GameID, res.Color, nil
+		case <-time.After(time.Second):
+		}
+	}
+	return "", chesslib.NoColor, fmt.Errorf("Seek timed out. No game started.")
+}
+
+func seekError(status int, body string) error {
+	switch status {
+	case http.StatusForbidden:
+		return fmt.Errorf("Token missing permissions. Please generate a new token with 'board:play' scope enabled.")
+	case http.StatusTooManyRequests:
+		return fmt.Errorf("Rate limit exceeded. Please wait a minute before trying again.")
+	case http.StatusUnauthorized:
+		return fmt.Errorf("Invalid token. Please check your token or generate a new one.")
+	case http.StatusBadRequest:
+		return fmt.Errorf("Invalid seek parameters: %s", body)
+	default:
+		return fmt.Errorf("Failed to seek game: %d - %s", status, body)
+	}
+}
+
+// JoinGame joins a game, preferring the color from the player's ongoing games.
+func (c *Client) JoinGame(gameID, myID string) (string, chesslib.Color, error) {
+	if games, err := c.GetOngoingGames(); err == nil {
+		for _, g := range games {
+			if g.GameID == gameID {
+				return gameID, ParseGameColor(g.Color), nil
+			}
+		}
+	}
+
+	acceptURL := c.baseURL() + "/challenge/" + gameID + "/accept"
+	req, err := c.newRequest(http.MethodPost, acceptURL, nil)
+	if err == nil {
+		if resp, err := c.httpClient().Do(req); err == nil {
+			_ = resp.Body.Close()
+			if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+				time.Sleep(time.Second)
+			}
+		}
+	}
+
+	const maxPollAttempts = 30
+	const pollInterval = time.Second
+
+	for attempt := 0; attempt < maxPollAttempts; attempt++ {
+		if games, err := c.GetOngoingGames(); err == nil {
+			for _, g := range games {
+				if g.GameID == gameID {
+					return gameID, ParseGameColor(g.Color), nil
+				}
+			}
+		}
+
+		streamURL := c.baseURL() + "/board/game/" + gameID + "/stream"
+		sreq, err := c.newRequest(http.MethodGet, streamURL, nil)
+		if err != nil {
+			return "", chesslib.NoColor, err
+		}
+		resp, err := c.httpClient().Do(sreq)
+		if err != nil {
+			if attempt < maxPollAttempts-1 {
+				time.Sleep(pollInterval)
+				continue
+			}
+			return "", chesslib.NoColor, fmt.Errorf("Failed to connect to game stream: %v", err)
+		}
+
+		if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+			status := resp.StatusCode
+			resp.Body.Close()
+			switch status {
+			case http.StatusNotFound:
+				if attempt < maxPollAttempts-1 {
+					time.Sleep(pollInterval)
+					continue
+				}
+				return "", chesslib.NoColor, fmt.Errorf("Game not found or hasn't started yet. Make sure the challenge has been accepted by your opponent.")
+			case http.StatusForbidden:
+				return "", chesslib.NoColor, fmt.Errorf("Cannot join this game. You may not be a participant.")
+			case http.StatusUnauthorized:
+				return "", chesslib.NoColor, fmt.Errorf("Invalid token. Please check your token or generate a new one.")
+			default:
+				return "", chesslib.NoColor, fmt.Errorf("Failed to join game: %d", status)
+			}
+		}
+
+		reader := bufio.NewReader(resp.Body)
+		lineCount := 0
+		for {
+			line, err := reader.ReadString('\n')
+			if err != nil && err != io.EOF {
+				break
+			}
+			lineCount++
+			if lineCount > 100 {
+				break
+			}
+			trimmed := strings.TrimSpace(line)
+			if trimmed == "" {
+				if err == io.EOF {
+					break
+				}
+				continue
+			}
+			var event GameEvent
+			if jsonErr := json.Unmarshal([]byte(trimmed), &event); jsonErr == nil {
+				if event.Type == "gameFull" {
+					var color chesslib.Color
+					switch {
+					case event.White.ID != "" && event.White.ID == myID:
+						color = chesslib.White
+					case event.Black.ID != "" && event.Black.ID == myID:
+						color = chesslib.Black
+					default:
+						resp.Body.Close()
+						return "", chesslib.NoColor, fmt.Errorf("You are not a participant in this game.")
+					}
+					resp.Body.Close()
+					return event.ID, color, nil
+				}
+				if event.Type == "gameState" {
+					if games, gerr := c.GetOngoingGames(); gerr == nil {
+						for _, g := range games {
+							if g.GameID == gameID {
+								resp.Body.Close()
+								return gameID, ParseGameColor(g.Color), nil
+							}
+						}
+					}
+					break
+				}
+			}
+			if err == io.EOF {
+				break
+			}
+		}
+		resp.Body.Close()
+
+		if attempt < maxPollAttempts-1 {
+			time.Sleep(pollInterval)
+		}
+	}
+
+	return "", chesslib.NoColor, fmt.Errorf("Game not started yet or failed to join. If you created a challenge, make sure your opponent has accepted it. Otherwise, try using 'My Ongoing Games' to join.")
+}
diff --git a/internal/lichess/lichess_test.go b/internal/lichess/lichess_test.go
