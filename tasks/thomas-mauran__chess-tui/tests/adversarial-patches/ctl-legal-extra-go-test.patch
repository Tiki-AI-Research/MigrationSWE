+package chess
+
+import (
+	"log"
+	"strings"
+
+	chesslib "github.com/notnil/chess"
+)
+
+// GameBoard is the pure board model: move/position history plus derived draw,
+// check and navigation state.
+type GameBoard struct {
+	// MoveHistory holds the moves that produced each position.
+	MoveHistory []*chesslib.Move
+	// PositionHistory holds the past states; the last one is the current
+	// position unless navigating.
+	PositionHistory []*chesslib.Position
+	// ConsecutiveNonPawnOrCapture counts half-moves since the last pawn move
+	// or capture.
+	ConsecutiveNonPawnOrCapture int
+	// TakenPieces stores captured pieces.
+	TakenPieces []chesslib.Piece
+	// IsFlipped tracks whether the board is displayed flipped.
+	IsFlipped bool
+	// HistoryPositionIndex is the current index when navigating history;
+	// nil means viewing the latest position.
+	HistoryPositionIndex *int
+	// OriginalFlipState stores the flip state before navigating history.
+	OriginalFlipState *bool
+}
+
+// NewGameBoard returns a board in the standard starting position.
+func NewGameBoard() *GameBoard {
+	return &GameBoard{
+		PositionHistory: []*chesslib.Position{chesslib.StartingPosition()},
+	}
+}
+
+// Reset restores the board to the standard starting position.
+func (b *GameBoard) Reset() {
+	b.MoveHistory = nil
+	b.PositionHistory = []*chesslib.Position{chesslib.StartingPosition()}
+	b.ConsecutiveNonPawnOrCapture = 0
+	b.IsFlipped = false
+	b.HistoryPositionIndex = nil
+	b.OriginalFlipState = nil
+}
+
+// CurrentPosition returns the position currently shown, or nil if history is
+// empty.
+func (b *GameBoard) CurrentPosition() *chesslib.Position {
+	if b.HistoryPositionIndex != nil {
+		idx := *b.HistoryPositionIndex
+		if idx >= 0 && idx < len(b.PositionHistory) {
+			return b.PositionHistory[idx]
+		}
+		return nil
+	}
+	if len(b.PositionHistory) == 0 {
+		return nil
+	}
+	return b.PositionHistory[len(b.PositionHistory)-1]
+}
+
+// PositionRef returns the current position; it panics if the board was not
+// initialized.
+func (b *GameBoard) PositionRef() *chesslib.Position {
+	pos := b.CurrentPosition()
+	if pos == nil {
+		panic("Position history is empty: board was not initialized correctly")
+	}
+	return pos
+}
+
+// GetRoleAtSquare returns the piece type at a square.
+func (b *GameBoard) GetRoleAtSquare(sq chesslib.Square) (chesslib.PieceType, bool) {
+	p := b.PositionRef().Board().Piece(sq)
+	if p == chesslib.NoPiece {
+		return chesslib.NoPieceType, false
+	}
+	return p.Type(), true
+}
+
+// IsSquareOccupied reports whether a square holds a piece.
+func (b *GameBoard) IsSquareOccupied(sq chesslib.Square) bool {
+	return b.PositionRef().Board().Piece(sq) != chesslib.NoPiece
+}
+
+// GetPieceColorAtSquare returns the color of the piece on a square.
+func (b *GameBoard) GetPieceColorAtSquare(sq chesslib.Square) (chesslib.Color, bool) {
+	p := b.PositionRef().Board().Piece(sq)
+	if p == chesslib.NoPiece {
+		return chesslib.NoColor, false
+	}
+	return p.Color(), true
+}
+
+// GetAuthorizedPositions returns the legal destinations for the piece on the
+// given square, when it is the player's turn.
+func (b *GameBoard) GetAuthorizedPositions(playerTurn chesslib.Color, sq chesslib.Square) []chesslib.Square {
+	piece := b.PositionRef().Board().Piece(sq)
+	if piece == chesslib.NoPiece || piece.Color() != playerTurn {
+		return []chesslib.Square{}
+	}
+	var moves []chesslib.Square
+	for _, m := range b.PositionRef().ValidMoves() {
+		if m.S1() == sq {
+			moves = append(moves, m.S2())
+		}
+	}
+	return moves
+}
+
+// IsGettingChecked reports whether the given color's king is in check.
+func (b *GameBoard) IsGettingChecked(playerTurn chesslib.Color) bool {
+	pos := b.PositionRef()
+	return inCheck(pos) && pos.Turn() == playerTurn
+}
+
+// IsCheckmate reports whether the current position is checkmate.
+func (b *GameBoard) IsCheckmate() bool {
+	return b.PositionRef().Status() == chesslib.Checkmate
+}
+
+// IsDraw reports draw by stalemate, the fifty-move rule, repetition or
+// insufficient material.
+func (b *GameBoard) IsDraw() bool {
+	pos := b.PositionRef()
+	if pos.Status() == chesslib.Stalemate {
+		return true
+	}
+	if b.ConsecutiveNonPawnOrCapture == 50 {
+		return true
+	}
+	if b.IsDrawByRepetition() {
+		return true
+	}
+	return insufficientMaterial(pos)
+}
+
+// IsDrawByRepetition reports whether some position occurred three times.
+func (b *GameBoard) IsDrawByRepetition() bool {
+	counts := map[string]int{}
+	for _, pos := range b.PositionHistory {
+		key := positionKey(pos)
+		counts[key]++
+		if counts[key] >= 3 {
+			return true
+		}
+	}
+	return false
+}
+
+// FEN returns the current position in Forsyth-Edwards Notation.
+func (b *GameBoard) FEN() string {
+	return b.PositionRef().String()
+}
+
+// IncrementConsecutiveNonPawnOrCapture updates the fifty-move counter.
+func (b *GameBoard) IncrementConsecutiveNonPawnOrCapture(roleFrom chesslib.PieceType, roleTo *chesslib.PieceType) {
+	if roleFrom == chesslib.Pawn || roleTo != nil {
+		b.ConsecutiveNonPawnOrCapture = 0
+		return
+	}
+	b.ConsecutiveNonPawnOrCapture++
+}
+
+// BlackTakenPieces returns the captured black pieces.
+func (b *GameBoard) BlackTakenPieces() []chesslib.PieceType {
+	return b.takenPiecesFor(chesslib.Black)
+}
+
+// WhiteTakenPieces returns the captured white pieces.
+func (b *GameBoard) WhiteTakenPieces() []chesslib.PieceType {
+	return b.takenPiecesFor(chesslib.White)
+}
+
+func (b *GameBoard) takenPiecesFor(color chesslib.Color) []chesslib.PieceType {
+	var roles []chesslib.PieceType
+	for _, p := range b.TakenPieces {
+		if p.Color() == color {
+			roles = append(roles, p.Type())
+		}
+	}
+	return roles
+}
+
+// GetKingCoordinates returns the king's board coordinate.
+func (b *GameBoard) GetKingCoordinates(color chesslib.Color) (Coord, bool) {
+	for sq, p := range b.PositionRef().Board().SquareMap() {
+		if p.Type() == chesslib.King && p.Color() == color {
+			coord := FromSquare(sq)
+			if b.IsFlipped {
+				coord = coord.Reverse()
+			}
+			return coord, true
+		}
+	}
+	return Coord{}, false
+}
+
+// FlipTheBoard toggles the display orientation.
+func (b *GameBoard) FlipTheBoard() {
+	b.IsFlipped = !b.IsFlipped
+}
+
+// ExecuteMove plays the legal move from -> to, optionally promoting. It
+// appends the resulting position to the history and returns the move, or nil
+// if the move is illegal.
+func (b *GameBoard) ExecuteMove(from, to chesslib.Square, promotion chesslib.PieceType) *chesslib.Move {
+	pos := b.PositionRef()
+	legal := pos.ValidMoves()
+
+	matching := findMove(legal, from, to, promotion)
+
+	// Castling fallback: a UI may send the king to the rook file.
+	if matching == nil && isPotentialCastling(pos, from, to) {
+		for _, m := range legal {
+			if m.S1() == from && (m.HasTag(chesslib.KingSideCastle) || m.HasTag(chesslib.QueenSideCastle)) {
+				matching = m
+				break
+			}
+		}
+	}
+
+	if matching == nil {
+		return nil
+	}
+
+	b.recordCapture(pos, matching)
+
+	next := pos.Update(matching)
+	b.PositionHistory = append(b.PositionHistory, next)
+	b.HistoryPositionIndex = nil
+	b.OriginalFlipState = nil
+	return matching
+}
+
+// ExecuteShakmatyMove plays a move without specifying a promotion piece.
+func (b *GameBoard) ExecuteShakmatyMove(from, to chesslib.Square) *chesslib.Move {
+	return b.ExecuteMove(from, to, chesslib.NoPieceType)
+}
+
+// ExecuteShakmatyMoveWithPromotion plays a move with a promotion piece and
+// reports whether it succeeded.
+func (b *GameBoard) ExecuteShakmatyMoveWithPromotion(from, to chesslib.Square, promotion chesslib.PieceType) bool {
+	return b.ExecuteMove(from, to, promotion) != nil
+}
+
+// ReconstructHistory rebuilds the board from space-separated UCI moves.
+func (b *GameBoard) ReconstructHistory(movesStr string, expectedFEN *string) {
+	if strings.TrimSpace(movesStr) == "" {
+		return
+	}
+
+	b.Reset()
+
+	current := b.PositionHistory[0]
+	fields := strings.Fields(movesStr)
+	applied, failed := 0, 0
+
+	for i, raw := range fields {
+		mv, err := chesslib.UCINotation{}.Decode(current, raw)
+		if err != nil {
+			log.Printf("Failed to parse UCI move %d: %s - %v. Skipping.", i+1, raw, err)
+			failed++
+			continue
+		}
+		if !isLegal(current, mv) {
+			log.Printf("Illegal move %d: %s. Stopping history reconstruction.", i+1, raw)
+			failed++
+			break
+		}
+		b.recordCapture(current, mv)
+		next := current.Update(mv)
+		b.MoveHistory = append(b.MoveHistory, mv)
+		b.PositionHistory = append(b.PositionHistory, next)
+		current = next
+		applied++
+	}
+
+	if failed > 0 {
+		log.Printf("Failed to apply %d out of %d moves. History may be incomplete.", failed, len(fields))
+	}
+	_ = applied
+
+	if expectedFEN != nil && len(b.PositionHistory) > 0 {
+		finalFEN := b.PositionHistory[len(b.PositionHistory)-1].String()
+		if !fenPositionsMatch(finalFEN, *expectedFEN) {
+			log.Printf("Final position from moves doesn't match FEN. Final: %s, Expected: %s", finalFEN, *expectedFEN)
+			if fn, err := chesslib.FEN(*expectedFEN); err == nil {
+				g := chesslib.NewGame(fn)
+				if len(b.PositionHistory) > 0 {
+					b.PositionHistory[len(b.PositionHistory)-1] = g.Position()
+				}
+			}
+		}
+	}
+}
+
+// MoveToSAN returns the standard algebraic notation for the move at index.
+func (b *GameBoard) MoveToSAN(moveIndex int) string {
+	if moveIndex < 0 || moveIndex >= len(b.MoveHistory) || moveIndex >= len(b.PositionHistory) {
+		return ""
+	}
+	pos := b.PositionHistory[moveIndex]
+	mv := b.MoveHistory[moveIndex]
+	return chesslib.AlgebraicNotation{}.Encode(pos, mv)
+}
+
+// NavigateHistoryNext moves one position forward in history.
+func (b *GameBoard) NavigateHistoryNext(isSoloMode bool) bool {
+	if len(b.PositionHistory) == 0 {
+		return false
+	}
+	maxIndex := len(b.PositionHistory) - 1
+
+	if b.HistoryPositionIndex == nil {
+		return false
+	}
+	index := *b.HistoryPositionIndex
+	if index < maxIndex {
+		newIndex := index + 1
+		b.HistoryPositionIndex = &newIndex
+		b.IsFlipped = b.flipStateForIndex(newIndex, isSoloMode)
+		return true
+	}
+	// Reached the latest position.
+	b.HistoryPositionIndex = nil
+	if b.OriginalFlipState != nil {
+		b.IsFlipped = *b.OriginalFlipState
+		b.OriginalFlipState = nil
+	} else {
+		b.IsFlipped = b.flipStateForIndex(maxIndex, isSoloMode)
+	}
+	return true
+}
+
+// NavigateHistoryPrevious moves one position backward in history.
+func (b *GameBoard) NavigateHistoryPrevious(isSoloMode bool) bool {
+	if len(b.PositionHistory) == 0 {
+		return false
+	}
+	if b.HistoryPositionIndex == nil {
+		if len(b.PositionHistory) > 1 {
+			original := b.IsFlipped
+			b.OriginalFlipState = &original
+			prev := len(b.PositionHistory) - 2
+			b.HistoryPositionIndex = &prev
+			b.IsFlipped = b.flipStateForIndex(prev, isSoloMode)
+			return true
+		}
+		return false
+	}
+	index := *b.HistoryPositionIndex
+	if index > 0 {
+		newIndex := index - 1
+		b.HistoryPositionIndex = &newIndex
+		b.IsFlipped = b.flipStateForIndex(newIndex, isSoloMode)
+		return true
+	}
+	return false
+}
+
+// ResetHistoryNavigation returns to viewing the latest position.
+func (b *GameBoard) ResetHistoryNavigation(isSoloMode bool) {
+	if b.HistoryPositionIndex != nil {
+		b.HistoryPositionIndex = nil
+		if b.OriginalFlipState != nil {
+			b.IsFlipped = *b.OriginalFlipState
+			b.OriginalFlipState = nil
+		} else {
+			maxIndex := len(b.PositionHistory) - 1
+			if maxIndex < 0 {
+				maxIndex = 0
+			}
+			b.IsFlipped = b.flipStateForIndex(maxIndex, isSoloMode)
+		}
+	}
+}
+
+// TruncateHistoryAt removes all moves and positions after index.
+func (b *GameBoard) TruncateHistoryAt(index int) {
+	if index >= len(b.PositionHistory) {
+		return
+	}
+	newLen := index + 1
+	if newLen < len(b.PositionHistory) {
+		b.PositionHistory = b.PositionHistory[:newLen]
+	}
+	if index < len(b.MoveHistory) {
+		b.MoveHistory = b.MoveHistory[:index]
+	}
+	b.HistoryPositionIndex = nil
+	b.OriginalFlipState = nil
+}
+
+func (b *GameBoard) flipStateForIndex(index int, isSoloMode bool) bool {
+	if !isSoloMode {
+		return b.IsFlipped
+	}
+	return index%2 == 1
+}
+
+func (b *GameBoard) recordCapture(pos *chesslib.Position, mv *chesslib.Move) {
+	if mv.HasTag(chesslib.EnPassant) {
+		from := mv.S1()
+		to := mv.S2()
+		capturedSquare := chesslib.NewSquare(to.File(), from.Rank())
+		if p := pos.Board().Piece(capturedSquare); p != chesslib.NoPiece {
+			b.TakenPieces = append(b.TakenPieces, p)
+		}
+		return
+	}
+	if mv.HasTag(chesslib.Capture) {
+		if p := pos.Board().Piece(mv.S2()); p != chesslib.NoPiece {
+			b.TakenPieces = append(b.TakenPieces, p)
+		}
+	}
+}
+
+func findMove(legal []*chesslib.Move, from, to chesslib.Square, promotion chesslib.PieceType) *chesslib.Move {
+	for _, m := range legal {
+		if m.S1() != from || m.S2() != to {
+			continue
+		}
+		if promotion == chesslib.NoPieceType {
+			return m
+		}
+		if m.Promo() == promotion {
+			return m
+		}
+	}
+	return nil
+}
+
+func isLegal(pos *chesslib.Position, mv *chesslib.Move) bool {
+	target := mv.String()
+	for _, m := range pos.ValidMoves() {
+		if m.String() == target {
+			return true
+		}
+	}
+	return false
+}
+
+func isPotentialCastling(pos *chesslib.Position, from, to chesslib.Square) bool {
+	p := pos.Board().Piece(from)
+	if p == chesslib.NoPiece || p.Type() != chesslib.King || p.Color() != pos.Turn() {
+		return false
+	}
+	df := int(to.File()) - int(from.File())
+	dr := int(to.Rank()) - int(from.Rank())
+	if dr != 0 {
+		return false
+	}
+	return df == 2 || df == -2
+}
+
+// positionKey identifies a position ignoring move counters, matching the
+// threefold-repetition rule.
+func positionKey(pos *chesslib.Position) string {
+	sq := "-"
+	if pos.EnPassantSquare() != chesslib.NoSquare {
+		sq = pos.EnPassantSquare().String()
+	}
+	return pos.Board().String() + " " + pos.Turn().String() + " " + pos.CastleRights().String() + " " + sq
+}
+
+func fenPositionsMatch(a, b string) bool {
+	ap := strings.Fields(a)
+	bp := strings.Fields(b)
+	if len(ap) < 4 || len(bp) < 4 {
+		return false
+	}
+	for i := 0; i < 4; i++ {
+		if ap[i] != bp[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func kingSquare(pos *chesslib.Position, color chesslib.Color) (chesslib.Square, bool) {
+	for sq, p := range pos.Board().SquareMap() {
+		if p.Type() == chesslib.King && p.Color() == color {
+			return sq, true
+		}
+	}
+	return chesslib.NoSquare, false
+}
+
+func inCheck(pos *chesslib.Position) bool {
+	sq, ok := kingSquare(pos, pos.Turn())
+	if !ok {
+		return false
+	}
+	return isSquareAttacked(pos, sq, pos.Turn().Other())
+}
+
+func isSquareAttacked(pos *chesslib.Position, sq chesslib.Square, by chesslib.Color) bool {
+	board := pos.Board()
+	file, rank := int(sq.File()), int(sq.Rank())
+
+	// Pawns.
+	pawnDir := 1
+	if by == chesslib.Black {
+		pawnDir = -1
+	}
+	for _, df := range []int{-1, 1} {
+		f := file + df
+		r := rank - pawnDir
+		if f >= 0 && f < 8 && r >= 0 && r < 8 {
+			p := board.Piece(chesslib.NewSquare(chesslib.File(f), chesslib.Rank(r)))
+			if p != chesslib.NoPiece && p.Type() == chesslib.Pawn && p.Color() == by {
+				return true
+			}
+		}
+	}
+
+	// Knights.
+	knightOffsets := [][2]int{{1, 2}, {2, 1}, {2, -1}, {1, -2}, {-1, -2}, {-2, -1}, {-2, 1}, {-1, 2}}
+	for _, o := range knightOffsets {
+		f, r := file+o[0], rank+o[1]
+		if !onBoard(f, r) {
+			continue
+		}
+		p := board.Piece(chesslib.NewSquare(chesslib.File(f), chesslib.Rank(r)))
+		if p != chesslib.NoPiece && p.Type() == chesslib.Knight && p.Color() == by {
+			return true
+		}
+	}
+
+	// King.
+	for df := -1; df <= 1; df++ {
+		for dr := -1; dr <= 1; dr++ {
+			if df == 0 && dr == 0 {
+				continue
+			}
+			f, r := file+df, rank+dr
+			if !onBoard(f, r) {
+				continue
+			}
+			p := board.Piece(chesslib.NewSquare(chesslib.File(f), chesslib.Rank(r)))
+			if p != chesslib.NoPiece && p.Type() == chesslib.King && p.Color() == by {
+				return true
+			}
+		}
+	}
+
+	// Sliding pieces.
+	if rayAttacked(board, file, rank, by, [][2]int{{1, 0}, {-1, 0}, {0, 1}, {0, -1}}, chesslib.Rook) {
+		return true
+	}
+	if rayAttacked(board, file, rank, by, [][2]int{{1, 1}, {1, -1}, {-1, 1}, {-1, -1}}, chesslib.Bishop) {
+		return true
+	}
+	return false
+}
+
+func rayAttacked(board *chesslib.Board, file, rank int, by chesslib.Color, dirs [][2]int, slider chesslib.PieceType) bool {
+	for _, d := range dirs {
+		f, r := file+d[0], rank+d[1]
+		for onBoard(f, r) {
+			p := board.Piece(chesslib.NewSquare(chesslib.File(f), chesslib.Rank(r)))
+			if p != chesslib.NoPiece {
+				if p.Color() == by && (p.Type() == slider || p.Type() == chesslib.Queen) {
+					return true
+				}
+				break
+			}
+			f += d[0]
+			r += d[1]
+		}
+	}
+	return false
+}
+
+func onBoard(file, rank int) bool {
+	return file >= 0 && file < 8 && rank >= 0 && rank < 8
+}
+
+func insufficientMaterial(pos *chesslib.Position) bool {
+	var pawns, rooksQueens, minorCount int
+	sameColorBishops := true
+	var bishopColor int = -1
+	for sq, p := range pos.Board().SquareMap() {
+		switch p.Type() {
+		case chesslib.Pawn:
+			pawns++
+		case chesslib.Rook, chesslib.Queen:
+			rooksQueens++
+		case chesslib.Bishop:
+			minorCount++
+			c := (int(sq.File()) + int(sq.Rank())) % 2
+			if bishopColor == -1 {
+				bishopColor = c
+			} else if bishopColor != c {
+				sameColorBishops = false
+			}
+		case chesslib.Knight:
+			minorCount++
+		}
+	}
+	if pawns > 0 || rooksQueens > 0 {
+		return false
+	}
+	if minorCount == 0 {
+		return true
+	}
+	if minorCount == 1 {
+		return true
+	}
+	// Two or more minor pieces: only draw when all are bishops of one color
+	// (K+B+B same shade) or a single bishop pair of identical shade.
+	return sameColorBishops
+}
diff --git a/internal/chess/board_test.go b/internal/chess/board_test.go
