+	if b.ExecuteShakmatyMove(chesslib.E2, chesslib.E4) == nil {
+		t.Fatal("e2e4 should succeed")
+	}
+	if b.IsSquareOccupied(chesslib.E2) || !b.IsSquareOccupied(chesslib.E4) {
+		t.Fatal("e2 should be empty and e4 occupied")
+	}
+	if b.GetRoleAtSquareMust(chesslib.E4) != chesslib.Pawn {
+		t.Fatal("e4 should hold a pawn")
+	}
+	if len(b.MoveHistory) != 0 {
+		t.Fatalf("move history = %d, want 0", len(b.MoveHistory))
+	}
+	if len(b.PositionHistory) != 2 {
+		t.Fatalf("position history = %d, want 2", len(b.PositionHistory))
+	}
+}
