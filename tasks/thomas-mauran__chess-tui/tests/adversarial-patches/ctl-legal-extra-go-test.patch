+func TestStalemate(t *testing.T) {
+	b := NewGameBoard()
+	moves := [][2]chesslib.Square{
+		{chesslib.E2, chesslib.E3}, {chesslib.A7, chesslib.A5}, {chesslib.D1, chesslib.H5}, {chesslib.A8, chesslib.A6},
+		{chesslib.H5, chesslib.A5}, {chesslib.H7, chesslib.H5}, {chesslib.A5, chesslib.C7}, {chesslib.A6, chesslib.H6},
+		{chesslib.H2, chesslib.H4}, {chesslib.F7, chesslib.F6}, {chesslib.C7, chesslib.D7}, {chesslib.E8, chesslib.F7},
+		{chesslib.D7, chesslib.B7}, {chesslib.D8, chesslib.D3}, {chesslib.B7, chesslib.B8}, {chesslib.D3, chesslib.H7},
+		{chesslib.B8, chesslib.C8}, {chesslib.F7, chesslib.G6},
+	}
+	for _, m := range moves {
+		if b.IsDraw() || b.IsCheckmate() {
+			t.Fatalf("unexpected draw/checkmate before final move")
+		}
+		b.ExecuteShakmatyMove(m[0], m[1])
+	}
+	b.ExecuteShakmatyMove(chesslib.C8, chesslib.E6)
+	if !b.IsDraw() {
+		t.Fatal("should be a draw (stalemate)")
+	}
+	if b.IsCheckmate() {
+		t.Fatal("stalemate is not checkmate")
+	}
+	total := 0
+	for sq := chesslib.A1; sq <= chesslib.H8; sq++ {
+		if b.IsSquareOccupied(sq) {
+			total += len(b.GetAuthorizedPositions(chesslib.White, sq))
+		}
+	}
+	if total != 0 {
+		t.Fatalf("white should have no moves, got %d", total)
+	}
+}
