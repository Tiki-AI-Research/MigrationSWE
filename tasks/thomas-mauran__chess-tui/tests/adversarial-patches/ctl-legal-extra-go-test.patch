+// Package constants holds shared constants and the config directory lookup.
+package constants
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+)
+
+// NetworkPort is the TCP port for peer-to-peer multiplayer connections.
+const NetworkPort uint16 = 2308
+
+// NetworkBufferSize is the byte length of the move message exchanged over TCP.
+const NetworkBufferSize = 5
+
+// LichessAPIURL is the base URL for all Lichess REST API requests.
+const LichessAPIURL = "https://lichess.org/api"
+
+// LichessUserAgent is the User-Agent sent with every Lichess request.
+const LichessUserAgent = "chess-tui (https://github.com/thomas-mauran/chess-tui)"
+
+// Short poll interval used when waiting for network events.
+const SleepDurationShortMs = 50
+
+// Longer poll interval used for less time-sensitive waits.
+const SleepDurationLongMs = 100
+
+// Wait after sending a resign to Lichess before continuing.
+const SleepDurationResignMs = 500
+
+// Name of the built-in default skin entry.
+const SkinNameDefault = "Default"
+
+// Name of the built-in ASCII skin entry.
+const SkinNameASCII = "ASCII"
+
+// BotDifficultyNames are the display labels for the four bot difficulty presets.
+var BotDifficultyNames = [4]string{"Easy (400)", "Medium (900)", "Hard (1500)", "Magnus (2700)"}
+
+// BotDifficultyElo are the UCI_Elo values passed to the engine per preset.
+var BotDifficultyElo = [4]uint16{400, 900, 1500, 2700}
+
+// BotDifficultyDepth is the engine search depth per preset.
+var BotDifficultyDepth = [4]uint8{1, 4, 8, 20}
+
+// BotDifficultyMovetimeMs is the engine think time in milliseconds per preset.
+var BotDifficultyMovetimeMs = [4]int{25, 120, 500, 12000}
+
+// BotDifficultyCount is the number of bot difficulty presets.
+const BotDifficultyCount = 4
+
+// ConfigDir returns the user's configuration directory, equivalent to
+// dirs::config_dir in the Rust implementation.
+func ConfigDir() (string, error) {
+	switch runtime.GOOS {
+	case "windows":
+		if dir := os.Getenv("APPDATA"); dir != "" {
+			return dir, nil
+		}
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return "", err
+		}
+		return filepath.Join(home, "AppData", "Roaming"), nil
+	case "darwin":
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return "", err
+		}
+		return filepath.Join(home, "Library", "Application Support"), nil
+	default:
+		if dir := os.Getenv("XDG_CONFIG_HOME"); dir != "" {
+			return dir, nil
+		}
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return "", err
+		}
+		if home == "" {
+			return "", errors.New("Could not get config directory")
+		}
+		return filepath.Join(home, ".config"), nil
+	}
+}
