@@ -0,0 +1,546 @@
+package chess
+
+import (
+	"strings"
+	"testing"
+
+	chesslib "github.com/notnil/chess"
+)
+
+func TestNewGameBoard(t *testing.T) {
+	b := NewGameBoard()
+	if len(b.MoveHistory) != 0 {
+		t.Fatalf("move history = %d, want 0", len(b.MoveHistory))
+	}
+	if len(b.PositionHistory) != 1 {
+		t.Fatalf("position history = %d, want 1", len(b.PositionHistory))
+	}
+	if b.ConsecutiveNonPawnOrCapture != 0 {
+		t.Fatalf("counter = %d, want 0", b.ConsecutiveNonPawnOrCapture)
+	}
+	if b.IsFlipped {
+		t.Fatal("board should not be flipped")
+	}
+
+	checks := map[chesslib.Square]chesslib.PieceType{
+		chesslib.A1: chesslib.Rook, chesslib.B1: chesslib.Knight, chesslib.C1: chesslib.Bishop,
+		chesslib.D1: chesslib.Queen, chesslib.E1: chesslib.King, chesslib.F1: chesslib.Bishop,
+		chesslib.G1: chesslib.Knight, chesslib.H1: chesslib.Rook,
+		chesslib.A2: chesslib.Pawn, chesslib.B2: chesslib.Pawn, chesslib.C2: chesslib.Pawn,
+		chesslib.D2: chesslib.Pawn, chesslib.E2: chesslib.Pawn, chesslib.F2: chesslib.Pawn,
+		chesslib.G2: chesslib.Pawn, chesslib.H2: chesslib.Pawn,
+		chesslib.A8: chesslib.Rook, chesslib.E8: chesslib.King,
+	}
+	for sq, want := range checks {
+		got, ok := b.GetRoleAtSquare(sq)
+		if !ok || got != want {
+			t.Fatalf("%v = %v/%v, want %v", sq, got, ok, want)
+		}
+	}
+	if b.IsSquareOccupied(chesslib.E4) || b.IsSquareOccupied(chesslib.D5) {
+		t.Fatal("middle of board should be empty")
+	}
+	if fen := b.FEN(); fen != "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1" {
+		t.Fatalf("fen = %q", fen)
+	}
+}
+
+func TestExecuteMove(t *testing.T) {
+	b := NewGameBoard()
+	if !b.IsSquareOccupied(chesslib.E2) {
