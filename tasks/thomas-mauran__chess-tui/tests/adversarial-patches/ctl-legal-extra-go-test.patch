+func TestPgnDirectorySorted(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "b.pgn"), []byte(strings.Replace(simplePGN, "%s", "Second", 1)), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "a.pgn"), []byte(strings.Replace(simplePGN, "%s", "First", 1)), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "ignore.txt"), []byte("not pgn"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	var stderr bytes.Buffer
+	games, err := loadPGN(dir, &stderr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(games) != 2 {
+		t.Fatalf("games = %d, want 2", len(games))
+	}
+	if games[0].Title != "First" || games[1].Title != "Second" {
+		t.Fatalf("order = %q, %q", games[0].Title, games[1].Title)
+	}
+}
