+func TestCliOverridesConfig(t *testing.T) {
+	engine := "/from/config"
+	sound := true
+	cfg := &config.Config{EnginePath: &engine, SoundEnabled: &sound}
+	depth := uint8(3)
+	engineCLI := "/from/cli"
+	args := &config.Args{EnginePath: engineCLI, Depth: &depth, NoSound: true}
+
+	s := resolveSettings(args, cfg)
+	if s.EnginePath != "/from/cli" {
+		t.Fatalf("engine path = %q", s.EnginePath)
+	}
+	if s.Depth != 3 {
+		t.Fatalf("depth = %d", s.Depth)
+	}
+	if s.SoundEnabled {
+		t.Fatal("--no-sound should win over config")
+	}
+}
