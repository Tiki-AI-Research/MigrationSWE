+++ b/internal/lichess/lichess_test.go
@@ -0,0 +1,234 @@
+package lichess
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestRequestHeadersAndOngoingGames(t *testing.T) {
+	var gotUA, gotAuth string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotUA = r.Header.Get("User-Agent")
+		gotAuth = r.Header.Get("Authorization")
+		if r.URL.Path != "/account/playing" {
+			t.Errorf("path = %s", r.URL.Path)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{"nowPlaying":[{"gameId":"abc","fullId":"abcfull","color":"white","fen":"startpos","opponent":{"id":"u","username":"bob","rating":1200},"isMyTurn":true}]}`)
+	}))
+	defer srv.Close()
+
+	c := NewClient("token123")
+	c.BaseURL = srv.URL
+	games, err := c.GetOngoingGames()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gotUA != "chess-tui (https://github.com/thomas-mauran/chess-tui)" {
+		t.Fatalf("user-agent = %q", gotUA)
+	}
+	if gotAuth != "Bearer token123" {
+		t.Fatalf("auth = %q", gotAuth)
+	}
+	if len(games) != 1 || games[0].GameID != "abc" || games[0].Color != "white" || !games[0].IsMyTurn {
+		t.Fatalf("games = %+v", games)
+	}
+}
+
+func TestSeekErrorMapping(t *testing.T) {
+	cases := []struct {
+		status int
+		want   string
+	}{
+		{403, "Token missing permissions. Please generate a new token with 'board:play' scope enabled."},
+		{429, "Rate limit exceeded. Please wait a minute before trying again."},
+		{401, "Invalid token. Please check your token or generate a new one."},
+	}
+	for _, tc := range cases {
+		err := seekError(tc.status, "")
+		if err == nil || err.Error() != tc.want {
+			t.Fatalf("status %d = %v, want %q", tc.status, err, tc.want)
+		}
+	}
+	err := seekError(400, "bad body")
+	if err == nil || err.Error() != "Invalid seek parameters: bad body" {
+		t.Fatalf("400 = %v", err)
+	}
+}
+
+func TestJoinErrorMapping(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.URL.Path == "/account/playing":
+			fmt.Fprint(w, `{"nowPlaying":[]}`)
+		case r.URL.Path == "/challenge/g1/accept":
+			w.WriteHeader(http.StatusNotFound)
+		case r.URL.Path == "/board/game/g1/stream":
+			w.WriteHeader(http.StatusForbidden)
+		default:
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	defer srv.Close()
+
+	c := NewClient("token")
+	c.BaseURL = srv.URL
+	_, _, err := c.JoinGame("g1", "me")
+	if err == nil || err.Error() != "Cannot join this game. You may not be a participant." {
+		t.Fatalf("err = %v", err)
+	}
+}
+
+func TestJoinUnauthorized(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.URL.Path == "/account/playing":
+			fmt.Fprint(w, `{"nowPlaying":[]}`)
+		case r.URL.Path == "/challenge/g1/accept":
+			w.WriteHeader(http.StatusNotFound)
+		case r.URL.Path == "/board/game/g1/stream":
+			w.WriteHeader(http.StatusUnauthorized)
+		default:
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	defer srv.Close()
+
+	c := NewClient("token")
+	c.BaseURL = srv.URL
+	_, _, err := c.JoinGame("g1", "me")
+	if err == nil || err.Error() != "Invalid token. Please check your token or generate a new one." {
+		t.Fatalf("err = %v", err)
+	}
+}
+
+func TestMakeMoveAndResignErrors(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/board/game/g1/resign" {
+			w.WriteHeader(http.StatusBadRequest)
+			fmt.Fprint(w, "nope")
+			return
+		}
+		w.WriteHeader(http.StatusTeapot)
+	}))
+	defer srv.Close()
+
+	c := NewClient("t")
+	c.BaseURL = srv.URL
+	if err := c.MakeMove("g1", "e2e4"); err == nil || err.Error() != "Failed to make move: 418 I'm a teapot" {
+		t.Fatalf("move err = %v", err)
+	}
+	if err := c.ResignGame("g1"); err == nil || err.Error() != "Failed to resign game: 400 Bad Request - nope" {
+		t.Fatalf("resign err = %v", err)
+	}
+}
+
+func TestBoardStreamParsing(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/x-ndjson")
+		flusher, _ := w.(http.Flusher)
+		fmt.Fprint(w, `{"type":"gameFull","id":"g1","white":{"id":"me"},"black":{"id":"op"},"state":{"moves":"e2e4 e7e5","status":"started"}}`+"\n")
+		fmt.Fprint(w, `{"type":"gameState","moves":"e2e4 e7e5 g1f3","status":"started"}`+"\n")
+		fmt.Fprint(w, `{"type":"gameState","moves":"e2e4 e7e5 g1f3","status":"mate"}`+"\n")
+		if flusher != nil {
+			flusher.Flush()
+		}
+	}))
+	defer srv.Close()
+
+	c := NewClient("t")
+	c.BaseURL = srv.URL
+	ch := make(chan string, 16)
+	if err := c.StreamGame("g1", ch, nil); err != nil {
+		t.Fatal(err)
+	}
+
+	got := collect(t, ch, 4)
+	want := []string{"e7e5", "INIT_MOVES:2", "g1f3", "GAME_STATUS:checkmate"}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("message %d = %q, want %q (all=%v)", i, got[i], want[i], got)
+		}
+	}
+}
+
+func TestBoardStream404Stops(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+	}))
+	defer srv.Close()
+
+	c := NewClient("t")
+	c.BaseURL = srv.URL
+	ch := make(chan string, 4)
+	if err := c.StreamGame("g1", ch, nil); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case msg := <-ch:
+		t.Fatalf("unexpected message %q", msg)
+	case <-time.After(300 * time.Millisecond):
+	}
+}
+
+func TestEventStreamParsing(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/x-ndjson")
+		fmt.Fprint(w, "\n")
+		fmt.Fprint(w, `{"type":"gameStart","game":{"gameId":"newgame","color":"black"}}`+"\n")
+	}))
+	defer srv.Close()
+
+	c := NewClient("t")
+	c.BaseURL = srv.URL
+	cancel := &atomic.Bool{}
+	found := make(chan GameFound, 1)
+	c.SpawnEventStream(map[string]struct{}{"old": {}}, cancel, found)
+
+	select {
+	case res := <-found:
+		if res.Err != nil || res.GameID != "newgame" {
+			t.Fatalf("found = %+v", res)
+		}
+		if res.Color != ParseGameColor("black") {
+			t.Fatalf("color = %v", res.Color)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for game start")
+	}
+}
+
+func TestGetGameInfo(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprint(w, `{"turns":7,"lastMove":"e2e4"}`+"\n")
+	}))
+	defer srv.Close()
+
+	c := NewClient("t")
+	c.BaseURL = srv.URL
+	turns, last, err := c.GetGameInfo("g1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if turns != 7 || last == nil || *last != "e2e4" {
+		t.Fatalf("turns=%d last=%v", turns, last)
+	}
+}
+
+func collect(t *testing.T, ch <-chan string, n int) []string {
+	t.Helper()
+	var out []string
+	for i := 0; i < n; i++ {
+		select {
+		case msg := <-ch:
+			out = append(out, msg)
+		case <-time.After(2 * time.Second):
+			t.Fatalf("timed out after %d messages: %v", len(out), out)
+		}
+	}
+	return out
+}
diff --git a/internal/lichess/models.go b/internal/lichess/models.go
new file mode 100644
index 0000000..3f3d25f
--- /dev/null
+++ b/internal/lichess/models.go
@@ -0,0 +1,163 @@
+// Package lichess ports the Lichess REST/SSE client.
+package lichess
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	chesslib "github.com/notnil/chess"
+	"github.com/thomas-mauran/chess-tui/internal/constants"
+)
+
+// Client is the Lichess HTTP client.
+type Client struct {
+	Token   string
+	BaseURL string
+	HTTP    *http.Client
+}
+
+// NewClient creates a client with the given bearer token.
+func NewClient(token string) *Client {
+	return &Client{
+		Token:   token,
+		BaseURL: constants.LichessAPIURL,
+		HTTP: &http.Client{
+			Timeout: 10 * time.Second,
+		},
+	}
+}
+
+// Player is a game participant.
+type Player struct {
+	ID       string  `json:"id"`
+	Username string  `json:"username"`
+	Rating   *uint16 `json:"rating"`
+}
+
+// GameState mirrors the Lichess board game state.
+type GameState struct {
+	Moves  string `json:"moves"`
+	Status string `json:"status"`
+}
+
+// GameEvent is a board stream event (gameFull / gameState / chatLine).
+type GameEvent struct {
+	Type   string     `json:"type"`
+	ID     string     `json:"id"`
+	White  Player     `json:"white"`
+	Black  Player     `json:"black"`
+	State  *GameState `json:"state"`
+	Moves  string     `json:"moves"`
+	Status string     `json:"status"`
+}
+
+// EventStreamGame is the game payload of an event stream event.
+type EventStreamGame struct {
+	GameID string `json:"gameId"`
+	Color  string `json:"color"`
+}
+
+// EventStreamEvent is an event stream event.
+type EventStreamEvent struct {
+	Type string           `json:"type"`
+	Game *EventStreamGame `json:"game"`
+}
+
+// OpponentInfo describes an ongoing game opponent.
+type OpponentInfo struct {
+	ID       string  `json:"id"`
+	Username string  `json:"username"`
+	Rating   *uint16 `json:"rating"`
+}
+
+// OngoingGame is a game currently being played.
+type OngoingGame struct {
+	GameID   string       `json:"gameId"`
+	FullID   string       `json:"fullId"`
+	Color    string       `json:"color"`
+	FEN      string       `json:"fen"`
+	Opponent OpponentInfo `json:"opponent"`
+	IsMyTurn bool         `json:"isMyTurn"`
+}
+
+// OngoingGamesResponse wraps the ongoing games list.
+type OngoingGamesResponse struct {
+	NowPlaying []OngoingGame `json:"nowPlaying"`
+}
+
+func (c *Client) baseURL() string {
+	if c.BaseURL != "" {
+		return c.BaseURL
+	}
+	return constants.LichessAPIURL
+}
+
+func (c *Client) httpClient() *http.Client {
+	if c.HTTP != nil {
+		return c.HTTP
+	}
+	return http.DefaultClient
+}
+
+func (c *Client) newRequest(method, url string, body io.Reader) (*http.Request, error) {
+	req, err := http.NewRequest(method, url, body)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("User-Agent", constants.LichessUserAgent)
+	if c.Token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.Token)
+	}
+	return req, nil
+}
+
+// GetOngoingGames fetches the player's ongoing games.
+func (c *Client) GetOngoingGames() ([]OngoingGame, error) {
+	url := c.baseURL() + "/account/playing"
+	req, err := c.newRequest(http.MethodGet, url, nil)
+	if err != nil {
+		return nil, err
+	}
+	resp, err := c.httpClient().Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		if resp.StatusCode == http.StatusUnauthorized {
+			return nil, fmt.Errorf("Invalid token. Please check your token or generate a new one.")
+		}
+		return nil, fmt.Errorf("Failed to fetch ongoing games: %s", resp.Status)
+	}
+
+	var out OngoingGamesResponse
+	if err := json.NewDecoder(resp.Body).Decode(&out); err != nil {
+		return nil, err
+	}
+	return out.NowPlaying, nil
+}
+
+// ParseGameColor converts a Lichess color string into a chess color.
+func ParseGameColor(colorStr string) chesslib.Color {
+	if colorStr == "white" {
+		return chesslib.White
+	}
+	return chesslib.Black
+}
+
+// StatusName normalizes a status that may be nested as {"name": ...}.
+func normalizeStatus(status string) string {
+	status = strings.TrimSpace(status)
+	var m struct {
+		Name string `json:"name"`
+	}
+	if json.Unmarshal([]byte(status), &m) == nil && m.Name != "" {
+		return m.Name
+	}
+	return status
+}
diff --git a/internal/lichess/stream.go b/internal/lichess/stream.go
new file mode 100644
index 0000000..b41ba30
--- /dev/null
+++ b/internal/lichess/stream.go
@@ -0,0 +1,262 @@
+package lichess
+
+import (
+	"bufio"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	chesslib "github.com/notnil/chess"
+)
+
+// GameFound reports a game detected on the event stream.
+type GameFound struct {
+	GameID string
+	Color  chesslib.Color
+	Err    error
+}
+
+// SendStatusMessage maps a Lichess game status into a GAME_STATUS message.
+func SendStatusMessage(status string, moveTx chan<- string) {
+	var msg string
+	switch status {
+	case "mate", "checkmate":
+		msg = "GAME_STATUS:checkmate"
+	case "draw", "stalemate", "repetition", "insufficient", "fifty":
+		msg = "GAME_STATUS:draw"
+	case "resign":
+		msg = "GAME_STATUS:resign"
+	case "aborted":
+		msg = "GAME_STATUS:aborted"
+	default:
+		return
+	}
+	moveTx <- msg
+}
+
+// SpawnEventStream opens the event stream, looking for a gameStart whose id
+// was not present before the seek.
+func (c *Client) SpawnEventStream(initial map[string]struct{}, cancel *atomic.Bool, gameFound chan<- GameFound) {
+	go func() {
+		url := c.baseURL() + "/stream/event"
+		for {
+			if cancel != nil && cancel.Load() {
+				return
+			}
+
+			req, err := c.newRequest(http.MethodGet, url, nil)
+			if err != nil {
+				time.Sleep(5 * time.Second)
+				continue
+			}
+			resp, err := c.httpClient().Do(req)
+			if err != nil {
+				time.Sleep(5 * time.Second)
+				continue
+			}
+			if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+				resp.Body.Close()
+				time.Sleep(5 * time.Second)
+				continue
+			}
+
+			scanner := bufio.NewScanner(resp.Body)
+			scanner.Buffer(make([]byte, 0, 64*1024), 1024*1024)
+			for scanner.Scan() {
+				if cancel != nil && cancel.Load() {
+					resp.Body.Close()
+					return
+				}
+				line := strings.TrimSpace(scanner.Text())
+				if line == "" {
+					continue
+				}
+				var event EventStreamEvent
+				if err := json.Unmarshal([]byte(line), &event); err != nil {
+					continue
+				}
+				if event.Type == "gameStart" && event.Game != nil {
+					if _, seen := initial[event.Game.GameID]; !seen {
+						resp.Body.Close()
+						gameFound <- GameFound{GameID: event.Game.GameID, Color: ParseGameColor(event.Game.Color)}
+						return
+					}
+				}
+			}
+			resp.Body.Close()
+			time.Sleep(5 * time.Second)
+		}
+	}()
+}
+
+// SpawnGameStream opens the board game stream and emits only newly arrived
+// moves on moveTx.
+func (c *Client) SpawnGameStream(gameID string, moveTx chan<- string, playerColor *chesslib.Color) {
+	go func() {
+		url := c.baseURL() + "/board/game/stream/" + gameID
+
+		var lastTurns *int
+		var lastMoveSeen string
+		var lastStatus string
+
+		for {
+			req, err := c.newRequest(http.MethodGet, url, nil)
+			if err != nil {
+				time.Sleep(5 * time.Second)
+				continue
+			}
+			resp, err := c.httpClient().Do(req)
+			if err != nil {
+				time.Sleep(5 * time.Second)
+				continue
+			}
+			if resp.StatusCode == http.StatusNotFound {
+				resp.Body.Close()
+				return
+			}
+			if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+				resp.Body.Close()
+				time.Sleep(5 * time.Second)
+				continue
+			}
+
+			scanner := bufio.NewScanner(resp.Body)
+			scanner.Buffer(make([]byte, 0, 64*1024), 1024*1024)
+			for scanner.Scan() {
+				line := strings.TrimSpace(scanner.Text())
+				if line == "" {
+					continue
+				}
+				var event GameEvent
+				if err := json.Unmarshal([]byte(line), &event); err != nil {
+					handleRawGameEvent(line, moveTx, &lastTurns, &lastMoveSeen, &lastStatus)
+					continue
+				}
+				switch event.Type {
+				case "gameFull":
+					if lastTurns == nil {
+						state := event.State
+						if state == nil {
+							continue
+						}
+						turns := len(strings.Fields(state.Moves))
+						lastTurns = &turns
+						if turns > 0 {
+							last := lastField(state.Moves)
+							if last != "" {
+								moveTx <- last
+								lastMoveSeen = last
+							}
+						}
+						moveTx <- "INIT_MOVES:" + itoa(turns)
+					}
+				case "gameState":
+					current := len(strings.Fields(event.Moves))
+					if lastStatus != event.Status {
+						SendStatusMessage(event.Status, moveTx)
+						lastStatus = event.Status
+					}
+					if lastTurns == nil {
+						lastTurns = &current
+						if current > 0 {
+							last := lastField(event.Moves)
+							if last != "" {
+								moveTx <- last
+								lastMoveSeen = last
+							}
+						}
+						moveTx <- "INIT_MOVES:" + itoa(current)
+					} else if current > *lastTurns {
+						last := lastField(event.Moves)
+						if last != "" && last != lastMoveSeen {
+							moveTx <- last
+							lastMoveSeen = last
+							lastTurns = &current
+						}
+					}
+				case "chatLine":
+					continue
+				}
+			}
+			resp.Body.Close()
+			time.Sleep(5 * time.Second)
+		}
+	}()
+}
+
+func handleRawGameEvent(line string, moveTx chan<- string, lastTurns **int, lastMoveSeen *string, lastStatus *string) {
+	var payload struct {
+		FEN      string          `json:"fen"`
+		Turns    *uint64         `json:"turns"`
+		LastMove string          `json:"lastMove"`
+		Status   json.RawMessage `json:"status"`
+	}
+	if err := json.Unmarshal([]byte(line), &payload); err != nil {
+		return
+	}
+	if payload.FEN == "" || payload.Turns == nil {
+		return
+	}
+	if *lastTurns == nil {
+		turns := int(*payload.Turns)
+		*lastTurns = &turns
+		if turns > 0 && payload.LastMove != "" {
+			moveTx <- payload.LastMove
+			*lastMoveSeen = payload.LastMove
+		}
+		moveTx <- "INIT_MOVES:" + itoa(turns)
+	} else if payload.LastMove != "" && payload.LastMove != *lastMoveSeen {
+		moveTx <- payload.LastMove
+		*lastMoveSeen = payload.LastMove
+		turns := int(*payload.Turns)
+		*lastTurns = &turns
+	}
+	if len(payload.Status) > 0 {
+		status := normalizeStatus(string(payload.Status))
+		if status != "" && status != *lastStatus {
+			SendStatusMessage(status, moveTx)
+			*lastStatus = status
+		}
+	}
+}
+
+// StreamGame starts streaming a board game into moveTx.
+func (c *Client) StreamGame(gameID string, moveTx chan<- string, playerColor *chesslib.Color) error {
+	if gameID == "" {
+		return nil
+	}
+	c.SpawnGameStream(gameID, moveTx, playerColor)
+	return nil
+}
+
+func lastField(s string) string {
+	fields := strings.Fields(s)
+	if len(fields) == 0 {
+		return ""
+	}
+	return fields[len(fields)-1]
+}
+
+func itoa(n int) string {
+	if n == 0 {
+		return "0"
+	}
+	neg := n < 0
+	if neg {
+		n = -n
+	}
+	var buf [20]byte
+	i := len(buf)
+	for n > 0 {
+		i--
+		buf[i] = byte('0' + n%10)
+		n /= 10
+	}
+	if neg {
+		i--
+		buf[i] = '-'
+	}
+	return string(buf[i:])
+}
diff --git a/internal/pgn/pgn.go b/internal/pgn/pgn.go
new file mode 100644
index 0000000..6b0996c
--- /dev/null
+++ b/internal/pgn/pgn.go
@@ -0,0 +1,389 @@
+// Package pgn ports PGN parsing, navigation and auto-play.
+package pgn
+
+import (
+	"os"
+	"strings"
+
+	chesslib "github.com/notnil/chess"
+)
+
+// Speed is one auto-play rate multiplier.
+type Speed struct {
+	Rate  float32
+	Label string
+}
+
+// Speeds are the auto-play rate multipliers.
+var Speeds = []Speed{
+	{0.5, "0.5x"},
+	{1.0, "1x"},
+	{1.5, "1.5x"},
+	{2.0, "2x"},
+	{2.5, "2.5x"},
+	{3.0, "3x"},
+	{4.0, "4x"},
+}
+
+// DefaultSpeedIdx selects the 1x speed.
+const DefaultSpeedIdx = 1
+
+// Viewer is a parsed PGN game with navigation and auto-play state.
+type Viewer struct {
+	// Positions[i] is the position after Moves[i-1]; Positions[0] is the start.
+	Positions []*chesslib.Position
+	Moves     []*chesslib.Move
+	SANs      []string
+	// CurrentPly is the currently shown ply (0 = start).
+	CurrentPly int
+	// Auto-play state.
+	AutoPlay      bool
+	SpeedIdx      int
+	AutoPlayAccum float32
+	// EndBannerDismissed is set when the end-of-game banner is hidden.
+	EndBannerDismissed bool
+	// Metadata from the PGN headers.
+	Title       string
+	White       string
+	Black       string
+	Result      string
+	Termination string
+}
+
+// FromFile loads all games from a PGN file.
+func FromFile(path string) ([]*Viewer, error) {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil, &readError{path: path, err: err}
+	}
+	return FromPGNString(string(content))
+}
+
+// FromPGNString parses one or more games from a PGN string.
+func FromPGNString(pgn string) ([]*Viewer, error) {
+	var viewers []*Viewer
+	for _, gameText := range splitPGNGames(pgn) {
+		if v, err := parseSingleGame(gameText); err == nil {
+			viewers = append(viewers, v)
+		}
+	}
+	if len(viewers) == 0 {
+		return nil, &parseError{msg: "No valid games found in PGN"}
+	}
+	return viewers, nil
+}
+
+type readError struct {
+	path string
+	err  error
+}
+
+func (e *readError) Error() string {
+	return "Cannot read '" + e.path + "': " + e.err.Error()
+}
+
+type parseError struct {
+	msg string
+}
+
+func (e *parseError) Error() string { return e.msg }
+
+// CurrentPosition returns the board position at the current ply.
+func (v *Viewer) CurrentPosition() *chesslib.Position {
+	return v.Positions[v.CurrentPly]
+}
+
+// LastMove returns the move that led to the current ply.
+func (v *Viewer) LastMove() *chesslib.Move {
+	if v.CurrentPly > 0 && v.CurrentPly-1 < len(v.Moves) {
+		return v.Moves[v.CurrentPly-1]
+	}
+	return nil
+}
+
+// Next advances one ply forward, clamped at the final position.
+func (v *Viewer) Next() {
+	if v.CurrentPly < len(v.Moves) {
+		v.CurrentPly++
+	}
+}
+
+// Prev steps one ply back and clears the end-banner-dismissed flag.
+func (v *Viewer) Prev() {
+	if v.CurrentPly > 0 {
+		v.CurrentPly--
+		v.EndBannerDismissed = false
+	}
+}
+
+// GotoStart jumps to the starting position.
+func (v *Viewer) GotoStart() {
+	v.CurrentPly = 0
+	v.EndBannerDismissed = false
+}
+
+// GotoEnd jumps to the final position.
+func (v *Viewer) GotoEnd() {
+	v.CurrentPly = len(v.Moves)
+}
+
+// TotalPlies returns the number of half-moves in the game.
+func (v *Viewer) TotalPlies() int {
+	return len(v.Moves)
+}
+
+// IsAtEnd reports whether the viewer is on the final position.
+func (v *Viewer) IsAtEnd() bool {
+	return len(v.Moves) > 0 && v.CurrentPly == len(v.Moves)
+}
+
+// ResultSummary returns the human-readable result string.
+func (v *Viewer) ResultSummary() string {
+	switch v.Result {
+	case "1-0":
+		return v.White + " (White) won"
+	case "0-1":
+		return v.Black + " (Black) won"
+	case "1/2-1/2":
+		return "Draw"
+	default:
+		return v.Result
+	}
+}
+
+// Tick advances auto-play when enabled (called on each 250ms tick).
+func (v *Viewer) Tick() {
+	if !v.AutoPlay {
+		return
+	}
+	rate := Speeds[v.SpeedIdx].Rate
+	v.AutoPlayAccum += rate * 0.25
+	for v.AutoPlayAccum >= 1.0 {
+		v.AutoPlayAccum -= 1.0
+		if v.CurrentPly < len(v.Moves) {
+			v.CurrentPly++
+		} else {
+			v.AutoPlay = false
+			v.AutoPlayAccum = 0
+			break
+		}
+	}
+}
+
+// SpeedLabel returns the current auto-play speed label.
+func (v *Viewer) SpeedLabel() string {
+	return Speeds[v.SpeedIdx].Label
+}
+
+// SpeedUp increases the auto-play speed, clamped at the maximum.
+func (v *Viewer) SpeedUp() {
+	if v.SpeedIdx+1 < len(Speeds) {
+		v.SpeedIdx++
+	}
+}
+
+// SpeedDown decreases the auto-play speed, clamped at the minimum.
+func (v *Viewer) SpeedDown() {
+	if v.SpeedIdx > 0 {
+		v.SpeedIdx--
+	}
+}
+
+func splitPGNGames(pgn string) []string {
+	var games []string
+	var current strings.Builder
+	hasMovetext := false
+
+	lines := strings.Split(pgn, "\n")
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		if strings.HasPrefix(trimmed, "[") && hasMovetext {
+			if strings.TrimSpace(current.String()) != "" {
+				games = append(games, current.String())
+				current.Reset()
+			}
+			hasMovetext = false
+		}
+		if trimmed != "" && !strings.HasPrefix(trimmed, "[") {
+			hasMovetext = true
+		}
+		current.WriteString(line)
+		current.WriteString("\n")
+	}
+	if strings.TrimSpace(current.String()) != "" {
+		games = append(games, current.String())
+	}
+	if len(games) == 0 && strings.TrimSpace(pgn) != "" {
+		games = append(games, pgn)
+	}
+	return games
+}
+
+func parseSingleGame(pgn string) (*Viewer, error) {
+	title := "?"
+	white := "?"
+	black := "?"
+	result := "*"
+	termination := ""
+
+	for _, line := range strings.Split(pgn, "\n") {
+		t := strings.TrimSpace(line)
+		if !strings.HasPrefix(t, "[") {
+			continue
+		}
+		val, ok := extractHeaderValue(t)
+		if !ok {
+			continue
+		}
+		lower := strings.ToLower(t)
+		switch {
+		case strings.HasPrefix(lower, "[event"):
+			title = val
+		case strings.HasPrefix(lower, "[white ") || strings.HasPrefix(lower, "[white\""):
+			white = val
+		case strings.HasPrefix(lower, "[black ") || strings.HasPrefix(lower, "[black\""):
+			black = val
+		case strings.HasPrefix(lower, "[result"):
+			result = val
+		case strings.HasPrefix(lower, "[termination"):
+			termination = val
+		}
+	}
+
+	var movetext strings.Builder
+	pastHeaders := false
+	for _, line := range strings.Split(pgn, "\n") {
+		t := strings.TrimSpace(line)
+		if !strings.HasPrefix(t, "[") {
+			pastHeaders = true
+		}
+		if pastHeaders {
+			movetext.WriteString(line)
+			movetext.WriteString(" ")
+		}
+	}
+
+	sanStrings := extractSANTokens(movetext.String())
+
+	positions := []*chesslib.Position{chesslib.StartingPosition()}
+	var moves []*chesslib.Move
+	var sans []string
+	pos := chesslib.StartingPosition()
+
+	for _, sanStr := range sanStrings {
+		clean := strings.TrimRight(sanStr, "+#")
+		mv, err := chesslib.AlgebraicNotation{}.Decode(pos, clean)
+		if err != nil {
+			break
+		}
+		next := pos.Update(mv)
+		moves = append(moves, mv)
+		sans = append(sans, sanStr)
+		pos = next
+		positions = append(positions, pos)
+	}
+
+	if len(moves) == 0 {
+		return nil, &parseError{msg: "No moves parsed from game '" + title + "'"}
+	}
+
+	return &Viewer{
+		Positions:   positions,
+		Moves:       moves,
+		SANs:        sans,
+		CurrentPly:  0,
+		SpeedIdx:    DefaultSpeedIdx,
+		Title:       title,
+		White:       white,
+		Black:       black,
+		Result:      result,
+		Termination: termination,
+	}, nil
+}
+
+func extractHeaderValue(line string) (string, bool) {
+	start := strings.Index(line, "\"")
+	end := strings.LastIndex(line, "\"")
+	if start < 0 || end <= start {
+		return "", false
+	}
+	return line[start+1 : end], true
+}
+
+func extractSANTokens(movetext string) []string {
+	text := movetext
+
+	for {
+		s := strings.Index(text, "{")
+		e := strings.Index(text, "}")
+		if s >= 0 && e > s {
+			text = text[:s] + " " + text[e+1:]
+			continue
+		}
+		break
+	}
+
+	for {
+		found := false
+		runes := []rune(text)
+		depth := 0
+		openIdx := -1
+		for ci, c := range runes {
+			switch c {
+			case '(':
+				if depth == 0 {
+					openIdx = ci
+				}
+				depth++
+			case ')':
+				if depth > 0 {
+					depth--
+					if depth == 0 && openIdx >= 0 {
+						byteStart := len(string(runes[:openIdx]))
+						byteEnd := len(string(runes[:ci+1]))
+						text = text[:byteStart] + " " + text[byteEnd:]
+						found = true
+					}
+				}
+			}
+			if found {
+				break
+			}
+		}
+		if !found {
+			break
+		}
+	}
+
+	var result []string
+	for _, token := range strings.Fields(text) {
+		if isMoveNumber(token) {
+			continue
+		}
+		if strings.HasPrefix(token, "$") {
+			continue
+		}
+		switch token {
+		case "1-0", "0-1", "1/2-1/2", "*":
+			continue
+		}
+		clean := strings.TrimRight(token, "!?")
+		if clean != "" {
+			result = append(result, clean)
+		}
+	}
+	return result
+}
+
+func isMoveNumber(token string) bool {
+	trimmed := strings.TrimRight(token, ".")
+	if trimmed == "" {
+		return false
+	}
+	for _, c := range trimmed {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/pgn/pgn_test.go b/internal/pgn/pgn_test.go
new file mode 100644
index 0000000..204c358
--- /dev/null
+++ b/internal/pgn/pgn_test.go
@@ -0,0 +1,164 @@
+package pgn
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const checkmatePGN = `[Event "Live"]
+[White "A"]
+[Black "B"]
+[Result "0-1"]
+[Termination "B won by checkmate"]
+
+1. e4 e5 2. Qh5 Nc6 3. Bc4 Nf6 4. Qxf7# 0-1
+`
+
+func TestParseHeadersAndTermination(t *testing.T) {
+	games, err := FromPGNString(checkmatePGN)
+	if err != nil {
+		t.Fatal(err)
+	}
+	v := games[0]
+	if v.White != "A" || v.Black != "B" || v.Result != "0-1" || v.Termination != "B won by checkmate" {
+		t.Fatalf("headers = %+v", v)
+	}
+	if v.ResultSummary() != "B (Black) won" {
+		t.Fatalf("summary = %q", v.ResultSummary())
+	}
+}
+
+func TestNavigateBackFromFinal(t *testing.T) {
+	games, _ := FromPGNString(checkmatePGN)
+	v := games[0]
+	v.GotoEnd()
+	if !v.IsAtEnd() {
+		t.Fatal("should be at end")
+	}
+	endPly := v.CurrentPly
+	v.Prev()
+	if v.CurrentPly != endPly-1 {
+		t.Fatalf("ply = %d, want %d", v.CurrentPly, endPly-1)
+	}
+	if v.IsAtEnd() {
+		t.Fatal("should no longer be at end")
+	}
+}
+
+func TestSpeedClamped(t *testing.T) {
+	games, _ := FromPGNString(checkmatePGN)
+	v := games[0]
+	if v.SpeedLabel() != "1x" {
+		t.Fatalf("initial speed = %q", v.SpeedLabel())
+	}
+	for i := 0; i < 20; i++ {
+		v.SpeedUp()
+	}
+	if v.SpeedIdx != len(Speeds)-1 || v.SpeedLabel() != "4x" {
+		t.Fatalf("max speed = %q", v.SpeedLabel())
+	}
+	for i := 0; i < 20; i++ {
+		v.SpeedDown()
+	}
+	if v.SpeedIdx != 0 || v.SpeedLabel() != "0.5x" {
+		t.Fatalf("min speed = %q", v.SpeedLabel())
+	}
+}
+
+func TestPrevClearsEndBanner(t *testing.T) {
+	games, _ := FromPGNString(checkmatePGN)
+	v := games[0]
+	v.GotoEnd()
+	v.EndBannerDismissed = true
+	v.Prev()
+	if v.EndBannerDismissed {
+		t.Fatal("banner should be cleared")
+	}
+}
+
+func TestSamplePgn(t *testing.T) {
+	path := filepath.Join("..", "..", "examples", "sample.pgn")
+	if _, err := os.Stat(path); err != nil {
+		t.Skipf("sample.pgn not found: %v", err)
+	}
+	games, err := FromFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(games) != 1 {
+		t.Fatalf("games = %d, want 1", len(games))
+	}
+	v := games[0]
+	if v.Title != "Live Chess" || v.White != "Player A" || v.Black != "Player B" || v.Result != "0-1" {
+		t.Fatalf("headers = %+v", v)
+	}
+	if v.Termination != "Player B won by checkmate" {
+		t.Fatalf("termination = %q", v.Termination)
+	}
+	if v.TotalPlies() == 0 {
+		t.Fatal("expected moves")
+	}
+}
+
+func TestReadError(t *testing.T) {
+	_, err := FromFile("/no/such/file.pgn")
+	if err == nil || !strings.HasPrefix(err.Error(), "Cannot read '/no/such/file.pgn':") {
+		t.Fatalf("err = %v", err)
+	}
+}
+
+func TestNoValidGames(t *testing.T) {
+	_, err := FromPGNString("this is not a pgn")
+	if err == nil || err.Error() != "No valid games found in PGN" {
+		t.Fatalf("err = %v", err)
+	}
+}
+
+func TestStopOnIllegalMove(t *testing.T) {
+	pgn := `[Event "X"]
+
+1. e4 e5 2. Ke2 Ke7 3. Qh5 Nc6 4. Qxf7# 0-1
+`
+	games, err := FromPGNString(pgn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	v := games[0]
+	// The illegal/parsable stop should leave the game valid but shorter than
+	// the full seven moves.
+	if v.TotalPlies() == 0 {
+		t.Fatal("expected some valid moves")
+	}
+	if v.TotalPlies() >= 7 {
+		t.Fatalf("expected stop on illegal move, got %d plies", v.TotalPlies())
+	}
+}
+
+func TestSplitMultipleGames(t *testing.T) {
+	multi := `[Event "One"]
+[White "A"]
+[Black "B"]
+[Result "1-0"]
+
+1. e4 e5 2. Nf3 1-0
+
+[Event "Two"]
+[White "C"]
+[Black "D"]
+[Result "0-1"]
+
+1. d4 d5 2. c4 0-1
+`
+	games, err := FromPGNString(multi)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(games) != 2 {
+		t.Fatalf("games = %d, want 2", len(games))
+	}
+	if games[0].Title != "One" || games[1].Title != "Two" {
+		t.Fatalf("titles = %q, %q", games[0].Title, games[1].Title)
+	}
+}
