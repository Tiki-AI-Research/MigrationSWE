+++ b/tests/source/batches/BATCH-F2P-0002/f2p_source_probe.py
@@ -0,0 +1,165 @@
+#!/usr/bin/env python3
+"""F2P-0002 source/target probe driver.
+
+Evaluates one target-technology semantic predicate per fail-to-pass
+observation against a checked-out repository tree. The same predicate is used
+in both environments: on the Go target every observation PASSes, while on the
+Rust source tree (migration.source) every observation FAILs because the
+required Go capability is absent.
+
+Usage: f2p_source_probe.py <repo-path>
+Output: JSON object mapping observation id -> {"status": "PASS"|"FAIL", "detail": str}
+"""
+import json
+import os
+import re
+import sys
+
+
+def read_go(repo):
+    """Return concatenated Go source plus a per-path map (Rust src excluded)."""
+    blobs = {}
+    for root, dirs, files in os.walk(repo):
+        dirs[:] = [d for d in dirs if d not in (".git", "node_modules", "website")]
+        for name in files:
+            if not name.endswith(".go"):
+                continue
+            path = os.path.join(root, name)
+            rel = os.path.relpath(path, repo)
+            if rel.startswith("src" + os.sep) or rel == "src":
+                # preserved Rust implementation is intentionally out of scope
+                continue
+            try:
+                with open(path, "r", encoding="utf-8", errors="replace") as fh:
+                    blobs[rel] = fh.read()
+            except OSError:
+                pass
+    return blobs
+
+
+def has(blobs, needle):
+    return any(needle in text for text in blobs.values())
+
+
+def has_all(blobs, needles):
+    return all(has(blobs, n) for n in needles)
+
+
+def read_text(repo, rel):
+    try:
+        with open(os.path.join(repo, rel), "r", encoding="utf-8", errors="replace") as fh:
+            return fh.read()
+    except OSError:
+        return ""
+
+
+def go_mod_ok(repo):
+    text = read_text(repo, "go.mod")
+    if "module github.com/thomas-mauran/chess-tui" not in text:
+        return False
+    return "github.com/BurntSushi/toml" in text and "github.com/notnil/chess" in text
+
+
+def build_predicates(repo, blobs):
+    def p025():
+        return go_mod_ok(repo) and "edition = \"2024\"" in read_text(repo, "Cargo.toml")
+
+    def p027():
+        return has_all(blobs, ["func ConfigDir", "XDG_CONFIG_HOME", ".config"])
+
+    def p032():
+        return has_all(blobs, ["BotDifficultyDepth", "BotDifficultyElo", "BotDifficultyMovetimeMs"])
+
+    def p038():
+        return has_all(blobs, ["/account/playing", "User-Agent", "Authorization", "Bearer"])
+
+    def p040():
+        return has_all(blobs, ["func FromPGNString", "func Load("])
+
+    def p026():
+        return has_all(blobs, ["0.0.0.0", "NetworkPort", "Game is already full"])
+
+    def p028():
+        return has(blobs, "func run(") and has(blobs, "--pgn") and not has(blobs, "ratatui::") and not has(blobs, "crossterm::")
+
+    def p029():
+        return has_all(blobs, ["func (c *Config) Persist", "omitempty"])
+
+    def p031():
+        return has_all(blobs, ["MarshalJSON", "UnmarshalJSON"]) and has(blobs, "Rgb")
+
+    def p034():
+        return has(blobs, '"https://lichess.org/api"') and has(blobs, "chess-tui (https://github.com/thomas-mauran/chess-tui)")
+
+    def p037():
+        return has_all(blobs, ["func loadPGN", "No valid .pgn files found"])
+
+    def p042():
+        return has_all(blobs, ["func WaitForGameStart", "SetReadDeadline", "Game ended by the other opponent"])
+
+    def p044():
+        return has_all(blobs, ["func FromPGNString", "No moves parsed from game"])
+
+    def p046():
+        return has_all(blobs, ["NetworkBufferSize = 5", "PromotionSuffix"])
+
+    def p043():
+        return has_all(blobs, ["GAME_STATUS:checkmate", "INIT_MOVES:", "chatLine"])
+
+    def p033():
+        return has_all(blobs, ["gameStart", "GameFound"])
+
+    def p035():
+        return has_all(blobs, ["UCI_LimitStrength", "UCI_Elo", "movetime"])
+
+    def p036():
+        return has_all(blobs, [
+            "Token missing permissions. Please generate a new token with 'board:play' scope enabled.",
+            "Rate limit exceeded. Please wait a minute before trying again.",
+            "Invalid seek parameters:",
+        ])
+
+    def p041():
+        return has(blobs, "func (c *Client) GetOngoingGames") and has(blobs, "Bearer")
+
+    def p045():
+        return has_all(blobs, ["Failed to spawn engine process", "position fen "])
+
+    def p048():
+        return has_all(blobs, ["func ParseArgs", "ParseUint"])
+
+    return {
+        "F2P-025": p025, "F2P-027": p027, "F2P-032": p032, "F2P-038": p038,
+        "F2P-040": p040, "F2P-026": p026, "F2P-028": p028, "F2P-029": p029,
+        "F2P-031": p031, "F2P-034": p034, "F2P-037": p037, "F2P-042": p042,
+        "F2P-044": p044, "F2P-046": p046, "F2P-030": p037, "F2P-039": p037,
+        "F2P-043": p043, "F2P-033": p033, "F2P-035": p035, "F2P-036": p036,
+        "F2P-041": p041, "F2P-045": p045, "F2P-047": p028, "F2P-048": p048,
+    }
+
+
+def main():
+    if len(sys.argv) != 2:
+        print("usage: f2p_source_probe.py <repo-path>", file=sys.stderr)
+        return 2
+    repo = sys.argv[1]
+    blobs = read_go(repo)
+    predicates = build_predicates(repo, blobs)
+    results = {}
+    for obs, predicate in predicates.items():
+        try:
+            ok = bool(predicate())
+        except Exception as exc:  # pragma: no cover - defensive
+            ok = False
+            results[obs] = {"status": "INFRA_ERROR", "detail": str(exc)}
+            continue
+        results[obs] = {
+            "status": "PASS" if ok else "FAIL",
+            "detail": "target Go capability present" if ok else "target Go capability absent",
+        }
+    print(json.dumps(results, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
