+	if !strings.Contains(text, "module github.com/thomas-mauran/chess-tui") {
+		t.Fatalf("module line missing:\n%s", text)
+	}
+	for _, dep := range []string{"github.com/BurntSushi/toml", "github.com/notnil/chess"} {
+		if !strings.Contains(text, dep) {
+			t.Fatalf("missing dependency %s:\n%s", dep, text)
+		}
+	}
+	requireCount := 0
+	inRequire := false
+	for _, line := range strings.Split(text, "\n") {
+		trimmed := strings.TrimSpace(line)
+		if strings.HasPrefix(trimmed, "require (") {
+			inRequire = true
+			continue
+		}
+		if inRequire && trimmed == ")" {
+			inRequire = false
+			continue
+		}
+		if inRequire && trimmed != "" && !strings.HasPrefix(trimmed, "//") {
+			requireCount++
+		}
+	}
+	if requireCount != 2 {
+		t.Fatalf("expected exactly 2 requirements, got %d:\n%s", requireCount, text)
+	}
