+//! Source (Rust) oracle for BATCH-DIFFERENTIAL-0001.
+//!
+//! This integration test replays the shared differential case corpus against
+//! the Rust source crate and asserts the canonical, normalized results that
+//! the migrated Go target is required to reproduce. Each test name carries the
+//! observation id it proves.
+//!
+//! The runtime-executable source harness for the full 32-case inventory is
+//! `probe_source.sh` (declared as `probes.source` in the shared corpus); this
+//! file is the Rust-language oracle for the subset of cases that can be
+//! expressed directly against the crate's public API. It deliberately touches
+//! only public source surfaces so that it can be compiled as a `tests/`
+//! integration test against the `chess-tui` crate.
+
+use chess_tui::config::Config;
+use chess_tui::constants;
+use chess_tui::game_logic::game_board::GameBoard;
+use chess_tui::pgn_viewer::{PgnViewer, SPEEDS};
+
+#[test]
+fn diff_001_public_surface_reachable() {
+    let board = GameBoard::default();
+    assert_eq!(
+        board.fen_position(),
+        "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
+    );
+    assert_eq!(constants::BOT_DIFFICULTY_COUNT, 4);
+    assert_eq!(constants::LICHESS_API_URL, "https://lichess.org/api");
+    assert_eq!(constants::NETWORK_PORT, 2308);
+    assert_eq!(constants::NETWORK_BUFFER_SIZE, 5);
+}
+
+#[test]
+fn diff_003_config_defaults() {
+    let cfg = Config::default();
+    assert_eq!(cfg.display_mode.as_deref(), Some("DEFAULT"));
+    assert_eq!(cfg.log_level.as_deref(), Some("OFF"));
+    assert_eq!(cfg.bot_depth, Some(10));
+    assert_eq!(cfg.selected_skin_name.as_deref(), Some("Default"));
+    assert_eq!(cfg.sound_enabled, Some(true));
+    assert_eq!(cfg.animations_enabled, Some(false));
+    assert!(cfg.engine_path.is_none());
+    assert!(cfg.bot_difficulty.is_none());
+    assert!(cfg.lichess_token.is_none());
+}
+
+#[test]
+fn diff_008_bot_difficulty_tables() {
+    assert_eq!(constants::BOT_DIFFICULTY_DEPTH, [1, 4, 8, 20]);
+    assert_eq!(constants::BOT_DIFFICULTY_ELO, [400, 900, 1500, 2700]);
+    assert_eq!(constants::BOT_DIFFICULTY_MOVETIME_MS, [25, 120, 500, 12_000]);
+}
+
+#[test]
+fn diff_010_load_errors_and_splitting() {
+    let err = PgnViewer::from_file("/nonexistent/x.pgn").unwrap_err();
+    assert!(err.starts_with("Cannot read '"));
+
+    let multi = "[Event \"A\"]\n[White \"w\"]\n[Black \"b\"]\n[Result \"1-0\"]\n\n1. e4 e5 2. Nf3 1-0\n\n[Event \"B\"]\n[White \"x\"]\n[Black \"y\"]\n[Result \"0-1\"]\n\n1. d4 d5 0-1\n";
+    let games = PgnViewer::from_pgn_str(multi).unwrap();
+    assert_eq!(games.len(), 2);
+
+    assert_eq!(
+        PgnViewer::from_pgn_str("no game here").unwrap_err(),
+        "No valid games found in PGN"
+    );
+}
+
+#[test]
+fn diff_011_header_extraction() {
+    let games = PgnViewer::from_pgn_str("[Event \"Only\"]\n\n1. e4 e5\n").unwrap();
+    let v = &games[0];
+    assert_eq!(v.title, "Only");
+    assert_eq!(v.white, "?");
+    assert_eq!(v.black, "?");
+    assert_eq!(v.result, "*");
+}
+
+#[test]
+fn diff_012_movetext_cleaning() {
+    let raw = "[Event \"Clean\"]\n[White \"w\"]\n[Black \"b\"]\n[Result \"1-0\"]\n\n1. e4 {a comment} e5 (1... c5 2. Nf3) 2. Nf3 $1 Nc6 3. Bb5 a6 4. Ba4 Nf6 5. O-O Be7 1-0\n";
+    let games = PgnViewer::from_pgn_str(raw).unwrap();
+    let v = &games[0];
+    assert_eq!(v.total_plies(), 10);
+    assert_eq!(v.sans.last().map(String::as_str), Some("Be7"));
+
+    assert!(PgnViewer::from_pgn_str("[Event \"Empty\"]\n\n*\n").is_err());
+}
+
+#[test]
+fn diff_013_navigation_state() {
+    let games = PgnViewer::from_pgn_str("[Event \"Nav\"]\n\n1. e4 e5 2. Nf3\n").unwrap();
+    let mut v = games.into_iter().next().unwrap();
+    v.goto_end();
+    assert!(v.is_at_end());
+    v.next();
+    assert_eq!(v.current_ply, v.total_plies());
+    v.prev();
+    assert_eq!(v.current_ply, v.total_plies() - 1);
+    assert!(!v.end_banner_dismissed);
+    v.goto_start();
+    assert_eq!(v.current_ply, 0);
+    assert!(!v.end_banner_dismissed);
+}
+
+#[test]
+fn diff_014_result_summary_mapping() {
+    let base = "[White \"Alice\"]\n[Black \"Bob\"]\n";
+    let cases = [
+        ("1-0", "Alice (White) won"),
+        ("0-1", "Bob (Black) won"),
+        ("1/2-1/2", "Draw"),
+        ("*", "*"),
+    ];
+    for (result, want) in cases {
+        let raw = format!("[Event \"R\"]\n{base}[Result \"{result}\"]\n\n1. e4 e5\n");
+        let games = PgnViewer::from_pgn_str(&raw).unwrap();
+        assert_eq!(games[0].result_summary(), want, "result {result}");
+    }
+}
+
+#[test]
+fn diff_015_auto_play_speeds_and_tick() {
+    let want = [0.5_f32, 1.0, 1.5, 2.0, 2.5, 3.0, 4.0];
+    assert_eq!(SPEEDS.len(), want.len());
+    for (i, rate) in want.iter().enumerate() {
+        assert_eq!(SPEEDS[i].0, *rate);
+    }
+    let games = PgnViewer::from_pgn_str("[Event \"AP\"]\n\n1. e4 e5 2. Nf3 Nc6\n").unwrap();
+    let mut v = games.into_iter().next().unwrap();
+    v.speed_idx = 0;
+    v.auto_play = true;
+    for _ in 0..8 {
+        v.tick();
+    }
+    assert_eq!(v.current_ply, 1);
+    v.speed_down();
+    assert_eq!(v.speed_idx, 0);
+    for _ in 0..20 {
+        v.speed_up();
+    }
+    assert_eq!(v.speed_idx, SPEEDS.len() - 1);
+}
+
+#[test]
+fn diff_016_listen_address_constant() {
+    assert_eq!(constants::NETWORK_PORT, 2308);
+}
+
+#[test]
+fn diff_018_wire_format_and_buffer() {
+    assert_eq!(constants::NETWORK_BUFFER_SIZE, 5);
+}
