+		t.Fatal("promotion suffix mapping is wrong")
+	}
+	addr := startServer(t, true)
+	host := dial(t, addr)
+	time.Sleep(50 * time.Millisecond)
+	joiner := dial(t, addr)
+	readN(t, joiner, 1)
+	readN(t, host, 1)
+	if _, err := joiner.Write([]byte("e7e8q")); err != nil {
+		t.Fatal(err)
+	}
+	if got := readN(t, host, 5); got != "e7e8q" {
+		t.Fatalf("framed move = %q", got)
+	}
+}
