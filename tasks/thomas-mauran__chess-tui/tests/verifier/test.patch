@@ -0,0 +1,52 @@
+#!/bin/sh
+# DIFFERENTIAL source probe: observation DIFF-033, requirement R037.
+# Executed on the source repository (/input/source during authoring).
+#
+# The source side is the control: its collected state MUST stay equal
+# (after normalization) to the target side. It asserts that the task
+# baseline revision is intact and that the checkout was not reset.
+#
+# Usage (all forms accepted):
+#   probe.sh [repo_path]
+#   probe.sh --repo <repo_path> [--root <root>] [--side source] [--out <file>]
+set -u
+
+REPO="${REPO:-/input/source}"
+OUT=""
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    --repo|-r) REPO="$2"; shift 2 ;;
+    --root)    shift 2 ;;
+    --side)    shift 2 ;;
+    --out|-o)  OUT="$2"; shift 2 ;;
+    -h|--help) shift ;;
+    -*)        shift ;;
+    *)         REPO="$1"; shift ;;
+  esac
+done
+
+OBS="DIFF-033"
+CASE="baseline-manifests-intact"
+ARTIFACTS="Cargo.toml Cargo.lock src/lib.rs src/main.rs examples/sample.pgn"
+
+status="PASS"
+detail="baseline-intact"
+for a in $ARTIFACTS; do
+  if [ ! -e "$REPO/$a" ]; then
+    status="FAIL"
+    detail="missing-baseline-artifact:$a"
+    break
+  fi
+done
+
+if [ "$status" = "PASS" ] && [ -d "$REPO/.git" ]; then
+  if ! ( cd "$REPO" && git diff --quiet --exit-code && git diff --cached --quiet --exit-code ); then
+    status="FAIL"
+    detail="baseline-tree-dirty"
+  fi
+fi
+
+json=$(printf '{"observation_id":"%s","case":"%s","requirement_id":"R037","result":"%s","detail":"%s"}' \
+  "$OBS" "$CASE" "$status" "$detail")
+printf '%s\n' "$json"
+if [ -n "$OUT" ]; then printf '%s\n' "$json" > "$OUT"; fi
