+++ b/tests/target/runner
@@ -0,0 +1,18 @@
+#!/usr/bin/env python3
+"""Target-side integration entry point.
+
+Dispatches every observation owned by the integration batch against the
+repository under test and prints a ``migration-observations:v6`` report.
+"""
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(ROOT, "shared", "integration"))
+
+import runner_lib  # noqa: E402
+
+if __name__ == "__main__":
+    sys.exit(runner_lib.main(["--side", "target", "--root", ROOT] + sys.argv[1:]))
