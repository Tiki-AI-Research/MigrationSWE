new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe_source.sh
@@ -0,0 +1,361 @@
+#!/bin/sh
+# Source-side runtime harness for BATCH-DIFFERENTIAL-0001.
+#
+# Usage: probe_source.sh [SRC] [REPORT]
+#
+#   SRC     source checkout to probe (default /input/source, read-only mount)
+#   REPORT  optional path; when given a JSON report mapping every DIFFERENTIAL
+#           observation id to its real source-side result is written there.
+#
+# The harness replays the shared differential case corpus against the Rust
+# baseline and emits one line per observation id (`DIFF-XXX PASS|FAIL`). It is
+# deliberately dependency-free: it only needs a POSIX shell and grep so it can
+# run in the source runtime, which has no Rust toolchain. Exit status is 0 when
+# every observation that the source side owns passes.
+set -u
+
+SRC="${1:-/input/source}"
+REPORT="${2:-}"
+
+FAILED=0
+RESULTS_FILE="$(mktemp 2>/dev/null || echo /tmp/diff0001_source_results.$$)"
+: > "$RESULTS_FILE"
+
+cleanup() {
+    rm -f "$RESULTS_FILE"
+}
+trap cleanup EXIT HUP INT TERM
+
+record() {
+    printf '%s\t%s\n' "$1" "$2" >> "$RESULTS_FILE"
+}
+
+pass() {
+    record "$1" PASS
+    printf '%s PASS\n' "$1"
+}
+
+fail() {
+    record "$1" FAIL
+    printf '%s FAIL: %s\n' "$1" "$2"
+    FAILED=1
+}
+
+# check <id> <description> <shell command>
+# The command is evaluated with `sh -c`; exit 0 means the observation passed.
+check() {
+    _id="$1"
+    _desc="$2"
+    shift 2
+    if sh -c "$*" >/dev/null 2>&1; then
+        pass "$_id"
+    else
+        fail "$_id" "$_desc"
+    fi
+}
+
+[ -d "$SRC" ] || { echo "source checkout not found at $SRC" >&2; exit 2; }
+SRC="${SRC%/}"
+
+# --------------------------------------------------------------------------
+# DIFF-001  migrated responsibilities are declared natively by the crate
+# --------------------------------------------------------------------------
