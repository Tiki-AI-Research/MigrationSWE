+#!/bin/sh
+# Source-side F2P dispatcher for BATCH-F2P-0003.
+#
+# Usage:
+#   run_probe.sh [repo_dir] [observation_id]
+#
+# repo_dir defaults to /input/source. The source tree is the pre-migration
+# TypeScript implementation: it contains no Go module, so the target-technology
+# postconditions are genuinely unsatisfied and every observation is observed as
+# FAIL. The dispatcher still executes the same predicate path as the target side
+# (see shared/batches/BATCH-F2P-0003/probe_common.sh) instead of hardcoding the
+# result; the shared helper emits FAIL only after confirming the absence of the
+# Go implementation. Long-running commands are bounded with `timeout`.
+#
+# POSIX `sh` compatible: the previous revision used bash arrays and BASH_SOURCE,
+# which made /bin/sh (dash) fail with `Syntax error: "(" unexpected`.
+
+set -u
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+PROBE_ASSET_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
+export PROBE_ASSET_ROOT
+# shellcheck source=/dev/null
+. "$SCRIPT_DIR/../../../shared/batches/BATCH-F2P-0003/probe_common.sh"
+
+REPO_DIR="${1:-/input/source}"
+OBSERVATION="${2:-}"
+
+run_one() {
+  observation_id="$1"
+  probe_run "$REPO_DIR" "$observation_id"
+  LAST_STATUS=$?
+}
+
+LAST_STATUS=0
+if [ -n "$OBSERVATION" ]; then
+  run_one "$OBSERVATION"
+  if [ "$LAST_STATUS" -eq 0 ]; then
+    exit 0
+  fi
+  exit 1
+fi
+
+OVERALL=0
+for observation_id in $PROBE_OBSERVATIONS; do
+  run_one "$observation_id"
+  if [ "$LAST_STATUS" -ne 0 ]; then
+    OVERALL=1
+  fi
+done
+exit "$OVERALL"
