+func TestF2P030(t *testing.T) {
+	inputs := f2pLoad(t, map[string]string{"generateReleaseNotesPreviousTag": "v1.0.0"}, nil, f2pContext(), nil)
+	if inputs.GenerateReleaseNotesPreviousTag == nil || *inputs.GenerateReleaseNotesPreviousTag != "v1.0.0" {
+		t.Fatalf("previous tag = %v", inputs.GenerateReleaseNotesPreviousTag)
+	}
