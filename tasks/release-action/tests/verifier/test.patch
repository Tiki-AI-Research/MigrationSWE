+
+// ---------------------------------------------------------------------------
+// F2P-032 (R039) action.yml docker entry and REST endpoint mapping.
+// ---------------------------------------------------------------------------
+
+func TestF2P032(t *testing.T) {
+	action := f2pRead(t, "action.yml")
+	if !strings.Contains(action, "using: 'docker'") && !strings.Contains(action, "using: docker") {
+		t.Fatal("action.yml runs.using is not docker")
+	}
+
+	releases := f2pRead(t, "releases.go")
+	for _, segment := range []string{`"releases"`, `"tags"`, `"generate-notes"`, `"assets"`} {
+		if !strings.Contains(releases, segment) {
+			t.Fatalf("releases.go is missing REST segment %s", segment)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-033 (R003) action entry point launches the compiled Go binary.
+// ---------------------------------------------------------------------------
+
+func TestF2P033(t *testing.T) {
+	action := f2pRead(t, "action.yml")
+	if strings.Contains(action, "node24") || strings.Contains(action, "dist/index.js") {
+		t.Fatal("action.yml still launches the Node entry point")
+	}
+	if !strings.Contains(action, "using: 'docker'") && !strings.Contains(action, "using: docker") {
+		t.Fatal("action.yml does not launch the Go binary through Docker")
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-036 (R033) repo defaults to the workflow context.
+// ---------------------------------------------------------------------------
+
+func TestF2P036(t *testing.T) {
+	inputs := f2pLoad(t, nil, nil, f2pContext(), nil)
+	if inputs.Repo != "context-repo" {
+		t.Fatalf("repo = %q, want the context repo", inputs.Repo)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-037 (R037) artifacts fallback and artifactContentType default.
+// ---------------------------------------------------------------------------
+
+func TestF2P037(t *testing.T) {
+	globber := &f2pRecordGlobber{result: []Artifact{}}
+	_ = f2pLoad(t, map[string]string{"artifact": "dist/app.bin"}, nil, f2pContext(), globber)
+	if globber.artifact != "dist/app.bin" {
+		t.Fatalf("artifact fallback = %q", globber.artifact)
+	}
+	if globber.contentType != "raw" {
+		t.Fatalf("content type = %q, want raw", globber.contentType)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-038 (R033) updatedDraft and omitDraftDuringUpdate.
+// ---------------------------------------------------------------------------
+
+func TestF2P038(t *testing.T) {
+	inputs := f2pLoad(t, map[string]string{"draft": "true"}, nil, f2pContext(), nil)
+	if inputs.UpdatedDraft == nil || !*inputs.UpdatedDraft {
+		t.Fatalf("updated draft = %v, want true", inputs.UpdatedDraft)
+	}
+
+	omitted := f2pLoad(t, map[string]string{"draft": "true", "omitDraftDuringUpdate": "true"}, nil, f2pContext(), nil)
+	if omitted.UpdatedDraft != nil {
+		t.Fatalf("updated draft should be omitted, got %v", *omitted.UpdatedDraft)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-040 (R033) directories are filtered out and warned about.
+// ---------------------------------------------------------------------------
+
+func TestF2P040(t *testing.T) {
+	dir := t.TempDir()
+	sub := filepath.Join(dir, "sub")
+	if err := os.Mkdir(sub, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	warnings := []string{}
+	original := logWarning
+	logWarning = func(message string) { warnings = append(warnings, message) }
+	defer func() { logWarning = original }()
+
+	validator := NewArtifactPathValidator(false, []string{sub}, "**")
+	result, err := validator.Validate()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(result) != 0 {
+		t.Fatalf("directory was not filtered out: %v", result)
+	}
+	if len(warnings) == 0 {
+		t.Fatal("expected a warning for the directory path")
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-041 (R033) tag input resolution.
+// ---------------------------------------------------------------------------
+
+func TestF2P041(t *testing.T) {
+	inputs := f2pLoad(t, map[string]string{"tag": "v9"}, nil, f2pContext(), nil)
+	if inputs.Tag != "v9" {
+		t.Fatalf("tag = %q", inputs.Tag)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-043 (R047) immutableCreate request sequence.
+// ---------------------------------------------------------------------------
+
+func TestF2P043(t *testing.T) {
+	releases := &f2pReleases{}
+	outputs := &f2pOutputs{}
+	inputs := &Inputs{Tag: "v1", ImmutableCreate: true, CreatedDraft: false}
+	action := NewAction(inputs, outputs, releases, &f2pUploader{}, &f2pDestroyer{}, &f2pSkipper{})
+	if err := action.Perform(); err != nil {
+		t.Fatal(err)
+	}
+
+	if len(releases.createCalls) != 1 || releases.createCalls[0].draft == nil || !*releases.createCalls[0].draft {
+		t.Fatalf("expected a draft create first, got %+v", releases.createCalls)
+	}
+	if len(releases.updateCalls) != 1 {
+		t.Fatalf("expected one publish update, got %+v", releases.updateCalls)
+	}
+	update := releases.updateCalls[0]
+	if update.body != nil || update.commit != nil || update.draft == nil || *update.draft {
+		t.Fatalf("publish update should omit body/commit and set draft=false: %+v", update)
+	}
+	if outputs.release == nil || outputs.release.ID != update.id {
+		t.Fatalf("outputs were not taken from the publish response: %+v", outputs.release)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-044 (R033) GithubErrorDetail documentation URL rendering.
+// ---------------------------------------------------------------------------
+
+func TestF2P044(t *testing.T) {
+	detail := GithubErrorDetail{Code: "custom", Message: "foo", DocumentationURL: "https://api.example.com"}
+	if got := detail.String(); got != "foo\nPlease see https://api.example.com." {
+		t.Fatalf("detail = %q", got)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-045 (R033) relative paths are left unchanged.
+// ---------------------------------------------------------------------------
+
+func TestF2P045(t *testing.T) {
+	if got := expandTilde("relative/path"); got != "relative/path" {
+		t.Fatalf("relative path changed to %q", got)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-046 (R033) explicit repo input wins over the context.
+// ---------------------------------------------------------------------------
+
+func TestF2P046(t *testing.T) {
+	inputs := f2pLoad(t, map[string]string{"repo": "explicit-repo"}, nil, f2pContext(), nil)
+	if inputs.Repo != "explicit-repo" {
+		t.Fatalf("repo = %q", inputs.Repo)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-048 (R033) GithubError exposes its HTTP status.
+// ---------------------------------------------------------------------------
+
+func TestF2P048(t *testing.T) {
+	githubErr := &GithubError{Status: 422, Message: "validation failed"}
+	if githubErr.StatusCode() != 422 {
+		t.Fatalf("status = %d", githubErr.StatusCode())
+	}
+	var asError error = githubErr
+	if asError.Error() == "" {
+		t.Fatal("empty error string")
+	}
+}
