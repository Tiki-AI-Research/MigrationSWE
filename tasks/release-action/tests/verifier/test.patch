@@ -0,0 +1,98 @@
+#!/bin/sh
+# BATCH-P2P-0002 -- source-side (pre-migration TypeScript) P2P probe.
+#
+# Runs the repository's own vitest suite on the pre-migration TypeScript
+# implementation and emits the raw per-observation PASS/FAIL projection.
+#
+# Every potentially long-running command is wrapped in an explicit `timeout`.
+# The script never waits indefinitely and never needs privileges.
+#
+# Usage: probe.sh [output.json]
+#   REPO  override the repository root (default /input/source, else /workspace/repo)
+#   TMO   per-command timeout in seconds (default 600)
+set -u
+
+OUT="${1:-}"
+TMO="${TMO:-600}"
+
+if [ -n "${REPO:-}" ]; then
+  :
+elif [ -d /input/source ]; then
+  REPO="/input/source"
+else
+  REPO="/workspace/repo"
+fi
+
+cd "$REPO" || { echo "source repo not found: $REPO" >&2; exit 2; }
+
+if [ -x node_modules/.bin/vitest ]; then
+  VITEST="node_modules/.bin/vitest"
+else
+  VITEST="npx --no-install vitest"
+fi
+
+RESULTS=""
+ANY_FAIL=0
+
+run_src() {
+  obs="$1"
+  file="$2"
+  name="$3"
+  rc=0
+  if [ -n "$file" ]; then
+    if [ -n "$name" ]; then
+      timeout "$TMO" $VITEST run "$file" -t "$name" >/dev/null 2>&1 || rc=$?
+    else
+      timeout "$TMO" $VITEST run "$file" >/dev/null 2>&1 || rc=$?
+    fi
+  else
+    timeout "$TMO" $VITEST run >/dev/null 2>&1 || rc=$?
+  fi
+  if [ "$rc" -eq 0 ]; then
+    r=PASS
+  else
+    r=FAIL
+    ANY_FAIL=1
+  fi
+  RESULTS="${RESULTS}${obs}	${r}
+"
+}
+
+run_src P2P-040 "__tests__/ArtifactUploader.test.ts" "throws error from replace"
+run_src P2P-031 "__tests__/Inputs.test.ts" "returns token"
+run_src P2P-025 "__tests__/ArtifactPathValidator.test.ts" ""
+run_src P2P-026 "__tests__/Outputs.test.ts" ""
+run_src P2P-027 "__tests__/ReleaseValidator.test.ts" ""
+run_src P2P-028 "__tests__/ArtifactGlobber.test.ts" ""
+run_src P2P-029 "__tests__/Action.test.ts" "creates release if no release exists to update"
+run_src P2P-030 "__tests__/ArtifactUploader.test.ts" "abort when upload failed with 5xx response after 3 attempts"
+run_src P2P-032 "__tests__/Action.test.ts" "publishes immutable release when immutableCreate is true and createdDraft is false"
+run_src P2P-033 "__tests__/Inputs.test.ts" ""
+run_src P2P-034 "__tests__/Integration.test.ts" ""
+run_src P2P-035 "__tests__/Action.test.ts" "updates release with static body when generateReleaseNotes is true but omitBodyDuringUpdate is true"
+run_src P2P-036 "__tests__/Integration.test.ts" ""
+run_src P2P-037 "__tests__/Inputs.test.ts" "returns owner from context"
+run_src P2P-038 "" ""
+run_src P2P-039 "__tests__/Action.test.ts" "creates release with combined body and generated release notes"
+
+print_json() {
+  printf '{\n  "batch_id": "BATCH-P2P-0002",\n  "side": "source",\n  "observations": {\n'
+  n=0
+  printf '%s' "$RESULTS" | while IFS='	' read -r obs r; do
+    [ -z "$obs" ] && continue
+    if [ "$n" -gt 0 ]; then
+      printf ',\n'
+    fi
+    printf '    "%s": {"result": "%s"}' "$obs" "$r"
+    n=$((n + 1))
+  done
+  printf '\n  }\n}\n'
+}
+
+JSON="$(print_json)"
+if [ -n "$OUT" ]; then
+  printf '%s' "$JSON" >"$OUT"
+fi
+printf '%s' "$JSON"
+
+exit "$ANY_FAIL"
