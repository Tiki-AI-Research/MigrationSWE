+
+func TestF2P035(t *testing.T) {
+	inputs, err := LoadInputs(
+		&f2pInputGetter{values: map[string]string{"token": "t", "tag": "v1"}, bools: map[string]bool{"skipIfReleaseExists": true}},
+		&f2pRecordGlobber{}, f2pContext(),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !inputs.SkipIfReleaseExists {
