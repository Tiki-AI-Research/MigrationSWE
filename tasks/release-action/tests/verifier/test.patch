@@ -0,0 +1,235 @@
+#!/usr/bin/env python3
+"""Source-side P2P probe for BATCH-P2P-0001 (pre-migration TypeScript).
+
+Executable projection
+---------------------
+Every observation owned by this batch is bound to a concrete, executed
+repository artefact:
+
+1. **Vitest JSON run (primary).**  The repository's own Vitest suite is run
+   exactly once with the machine-readable JSON reporter.  Each observation is
+   then bound to the assertion results of its ``source.file``: it is ``PASS``
+   only when the mapped ``source.test`` name resolves to at least one assertion
+   (exact title, containing describe block, or unambiguous name prefix) and
+   every matching assertion passed.  A missing or vacuous match is ``FAIL``.
+   Running the whole suite once avoids the mock-state leakage that makes
+   ``vitest run -t <name>`` report spurious failures for partially filtered
+   subsets.
+2. **Static interface checks.**  Observations mapped to the protected
+   ``action.yml`` interface are checked directly (input / output names and the
+   REST operation mapping in ``src/Releases.ts``).
+3. **Declared native command fallback.**  When no Node.js toolchain is present,
+   the source runtime's declared native test command (``git diff --exit-code``)
+   is executed and every observation additionally requires its mapped test
+   title to be present in its mapped file.  A missing match is ``FAIL``.
+
+Every external command is wrapped in an explicit ``timeout`` and a
+subprocess-level backstop, so the probe can never wait indefinitely.
+"""
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+BATCH_DIR = os.path.dirname(os.path.abspath(__file__))
+ASSET_ROOT = os.path.abspath(os.path.join(BATCH_DIR, "..", "..", ".."))
+MAP_PATH = os.path.join(
+    ASSET_ROOT, "shared", "batches", "BATCH-P2P-0001", "observation-map.json"
+)
+
+REPO_ROOT = os.environ.get("REPO_ROOT", "/input/source")
+TEST_TIMEOUT = int(os.environ.get("P2P_SOURCE_TEST_TIMEOUT", "600"))
+CHECK_TIMEOUT = int(os.environ.get("P2P_SOURCE_CHECK_TIMEOUT", "60"))
+
+NATIVE_TEST_COMMANDS = [["git", "diff", "--exit-code"]]
+
+INPUT_NAMES = [
+    "allowUpdates", "artifactErrorsFailBuild", "artifact", "artifacts",
+    "artifactContentType", "body", "bodyFile", "commit", "discussionCategory",
+    "draft", "generateReleaseNotes", "generateReleaseNotesPreviousTag",
+    "immutableCreate", "makeLatest", "name", "omitBody", "omitBodyDuringUpdate",
+    "omitDraftDuringUpdate", "omitName", "omitNameDuringUpdate",
+    "omitPrereleaseDuringUpdate", "owner", "prerelease", "removeArtifacts",
+    "replacesArtifacts", "repo", "skipIfReleaseExists", "tag", "token",
+    "updateOnlyUnreleased",
+]
+OUTPUT_NAMES = [
+    "id", "html_url", "upload_url", "tarball_url", "zipball_url", "assets",
+]
+REST_OPERATIONS = [
+    "createRelease", "updateRelease", "getReleaseByTag", "generateReleaseNotes",
+    "listReleases", "listReleaseAssets", "deleteReleaseAsset",
+    "uploadReleaseAsset",
+]
+
+
+def run(argv, cwd, timeout_s):
+    """Run argv through `timeout`, additionally bounded at the process level."""
+    wrapped = ["timeout", "%ds" % timeout_s] + argv
+    try:
+        proc = subprocess.run(
+            wrapped,
+            cwd=cwd,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            timeout=timeout_s + 15,
+        )
+        return proc.returncode, proc.stdout.decode("utf-8", "replace")
+    except subprocess.TimeoutExpired:
+        return 124, ""
+    except (FileNotFoundError, NotADirectoryError):
+        return 127, ""
+
+
+def read_text(repo, rel_path):
+    try:
+        with open(os.path.join(repo, rel_path), "r", encoding="utf-8", errors="replace") as handle:
+            return handle.read()
+    except OSError:
+        return None
+
+
+def node_runner(repo):
+    if not os.path.exists(os.path.join(repo, "package.json")):
+        return None
+    if shutil.which("pnpm"):
+        return ["pnpm", "exec", "vitest", "run"]
+    if shutil.which("npx"):
+        return ["npx", "--no-install", "vitest", "run"]
+    return None
+
+
+def collect_vitest(repo, runner):
+    """Run the whole Vitest suite once; return {relative file: [assertions]}."""
+    fd, out_path = tempfile.mkstemp(prefix="p2p-vitest-", suffix=".json")
+    os.close(fd)
+    try:
+        run(
+            runner + ["--reporter=json", "--outputFile=" + out_path],
+            cwd=repo,
+            timeout_s=TEST_TIMEOUT,
+        )
+        if not os.path.exists(out_path) or os.path.getsize(out_path) == 0:
+            return None
+        with open(out_path, "r", encoding="utf-8") as handle:
+            data = json.load(handle)
+    except (ValueError, OSError):
+        return None
+    finally:
+        try:
+            os.remove(out_path)
+        except OSError:
+            pass
+
+    by_file = {}
+    for suite in data.get("testResults", []) or []:
+        raw = suite.get("name", "") or ""
+        if os.path.isabs(raw):
+            raw = os.path.relpath(raw, repo)
+        key = raw.replace(os.sep, "/")
+        by_file.setdefault(key, []).extend(suite.get("assertionResults", []) or [])
+    return by_file
+
+
+def _normalize(value):
+    value = re.sub(r"[^0-9A-Za-z]+", " ", value or "")
+    return re.sub(r"\s+", " ", value).strip().lower()
+
+
+def test_projection(assertions, test_name):
+    wanted = _normalize(test_name)
+    if not wanted:
+        return False
+    matched = []
+    for assertion in assertions:
+        candidates = [
+            _normalize(assertion.get("title", "")),
+            _normalize(assertion.get("fullName", "")),
+        ]
+        candidates.extend(
+            _normalize(ancestor) for ancestor in (assertion.get("ancestorTitles") or [])
+        )
+        if any(candidate and (candidate == wanted or candidate.startswith(wanted))
+               for candidate in candidates):
+            matched.append(assertion)
+    if not matched:
+        return False
+    return all(assertion.get("status") == "passed" for assertion in matched)
+
+
+def action_yml_interface(repo):
+    text = read_text(repo, "action.yml")
+    if text is None:
+        return False
+    if not re.search(r"(?m)^inputs:", text) or not re.search(r"(?m)^outputs:", text):
+        return False
+    for name in INPUT_NAMES + OUTPUT_NAMES:
+        if not re.search(r"(?m)^  %s:" % re.escape(name), text):
+            return False
+    return True
+
+
+def rest_mapping(repo):
+    text = read_text(repo, "src/Releases.ts")
+    if text is None:
+        return False
+    return all(operation in text for operation in REST_OPERATIONS)
+
+
+def static_projection(repo, rel_file, test_name):
+    if rel_file == "action.yml":
+        ok = action_yml_interface(repo)
+        lowered = (test_name or "").lower()
+        if any(word in lowered for word in ("rest", "mapping", "definitions")):
+            ok = ok and rest_mapping(repo)
+        return ok
+    text = read_text(repo, rel_file)
+    if text is None or not test_name:
+        return False
+    return test_name in text
+
+
+def native_command_ok(repo):
+    for command in NATIVE_TEST_COMMANDS:
+        if not shutil.which(command[0]):
+            continue
+        rc, _ = run(command, cwd=repo, timeout_s=CHECK_TIMEOUT)
+        if rc == 129:  # "not a git repository"; treated as unavailable.
+            continue
+        if rc != 0:
+            return False
+    return True
+
+
+def main():
+    with open(MAP_PATH, "r", encoding="utf-8") as handle:
+        mapping = json.load(handle)
+
+    repo = REPO_ROOT
+    runner = node_runner(repo)
+    vitest_results = collect_vitest(repo, runner) if runner is not None else None
+    native_ok = native_command_ok(repo)
+
+    for observation in mapping["observations"]:
+        oid = observation["id"]
+        source = observation.get("source", {})
+        rel_file = source.get("file", "")
+        test_name = source.get("test", "")
+
+        if rel_file == "action.yml":
+            result = static_projection(repo, rel_file, test_name)
+        elif vitest_results is not None:
+            result = test_projection(vitest_results.get(rel_file, []), test_name)
+        else:
+            result = native_ok and static_projection(repo, rel_file, test_name)
+
+        print(json.dumps({"observation_id": oid, "result": "PASS" if result else "FAIL"}))
+    return 0
+
