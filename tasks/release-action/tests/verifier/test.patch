+#!/usr/bin/env python3
+"""Source probe for BATCH-DIFFERENTIAL-0001.
+
+Drives the pre-migration TypeScript implementation (``/input/source`` by
+default, overridable with ``SOURCE_REPO``) through the shared differential
+corpus using the packaged Node entry point ``dist/index.js``.
+
+The TypeScript runtime is only available in environments that ship Node.js.
+When Node.js is missing the probe reports ``unavailable`` and never fabricates
+a PASS observation; the lasting differential evidence is produced by re-running
+this probe in an environment that provides Node.js.
+
+Every subprocess is bounded by an explicit timeout.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+BATCH_ID = "BATCH-DIFFERENTIAL-0001"
+ASSET_ROOT = os.path.abspath(os.path.join(HERE, "..", "..", ".."))
+SHARED = os.path.join(ASSET_ROOT, "shared", "batches", BATCH_ID)
+sys.path.insert(0, os.path.join(SHARED, "lib"))
+
+import harness  # noqa: E402
+
+CASE_TIMEOUT = 60
+
+
+def node_command(source_repo: str) -> list[str]:
+    entry = os.path.join(source_repo, "dist", "index.js")
+    return [os.environ.get("NODE_BIN", "node"), entry]
+
+
+def run(source_repo: str, report_path: str) -> dict:
+    cases = harness.load_cases(os.path.join(SHARED, "corpus", "cases.json"))
+    node = os.environ.get("NODE_BIN", "node")
+
+    if shutil.which(node) is None or not os.path.exists(os.path.join(source_repo, "dist", "index.js")):
+        report = {
+            "schema_version": "migration-differential-report:v1",
+            "batch_id": BATCH_ID,
+            "runtime": "source",
+            "status": "unavailable",
+            "reason": "Node.js runtime or dist/index.js not present in this environment",
+            "cases": {},
+            "observations": {},
+        }
+    else:
+        results = {}
+        for case in cases:
+            results[case["id"]] = harness.evaluate_case(
+                case, node_command(source_repo), source_repo, timeout=CASE_TIMEOUT
+            )
+        report = {
+            "schema_version": "migration-differential-report:v1",
+            "batch_id": BATCH_ID,
+            "runtime": "source",
+            "status": "executed",
+            "cases": results,
+            "observations": harness.results_by_observation(cases, results),
+        }
+
+    os.makedirs(os.path.dirname(report_path), exist_ok=True)
+    with open(report_path, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, sort_keys=True)
+    return report
+
+
+def main() -> int:
+    source_repo = os.environ.get("SOURCE_REPO", "/input/source")
+    report_path = sys.argv[1] if len(sys.argv) > 1 else "/tmp/diff-source-report.json"
+    report = run(source_repo, report_path)
+    print(f"source probe: status={report['status']} cases={len(report['cases'])} on {source_repo}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
