+#!/bin/sh
+# Source-side probe for BATCH-F2P-0001.
+#
+# Runs the shared fail-to-pass predicates against the pre-migration TypeScript
+# repository.  The predicate logic lives in
+# shared/batches/BATCH-F2P-0001/f2p_checks.py and is byte-for-byte the same
+# predicate the target probe runs; this wrapper only selects the repository
+# root.  It never asserts PASS/FAIL itself and never hardcodes a side result.
+#
+# Long-running commands (go build / go test) are wrapped in explicit timeouts
+# by the shared engine.  This is NOT a harness entry point: source/runner is
+# owned by the INTEGRATION batch.
+set -eu
+
+DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+ROOT=$(CDPATH= cd -- "$DIR/../../.." && pwd)
+SHARED="$ROOT/shared/batches/BATCH-F2P-0001/f2p_checks.py"
+
+REPO="${1:-/input/source}"
+REPORT="${2:-/logs/result.json}"
+
+exec timeout 3600 python3 "$SHARED" --repo "$REPO" --batch BATCH-F2P-0001 --out "$REPORT"
