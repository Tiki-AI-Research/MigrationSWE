+        const custom = new GithubErrorDetail({ code: "custom", message: customMessage })
+        const customWithDocs = new GithubErrorDetail({ code: "custom", message: customMessage, documentation_url: docs })
+        expect(custom.toString()).toBe(customMessage)
+        expect(customWithDocs.toString().includes(docs)).toBe(true)
+        expect(customWithDocs.toString().length).toBeGreaterThan(custom.toString().length)
+    })
+
+    it("CONTRACT-028 capability set preserved", async () => {
+        const releases = makeReleases()
+        expect(Object.keys(releases).sort()).toEqual(
+            ["create", "deleteArtifact", "generateReleaseNotes", "getByTag", "listArtifactsForRelease", "listReleases", "update", "uploadArtifact"].sort(),
+        )
+    })
+
+    it("CONTRACT-029 action.yml definitions unchanged except runs", async () => {
+        const text = readFileSync(new URL("../action.yml", import.meta.url), "utf-8")
+        const normalized = text.replace(/runs:\n(?:.*\n)*?branding:/, "branding:")
+        expect(normalized).not.toContain("using: 'node24'")
+        expect(sectionKeys(text, "inputs").length).toBe(30)
+        expect(sectionKeys(text, "outputs").length).toBe(6)
+        expect(text).toContain("branding:\n  icon: 'tag'\n  color: 'gray-dark'")
+    })
+
+    it("CONTRACT-030 test integrity", async () => {
+        const testsDir = new URL("./", import.meta.url)
+        expect(existsSync(testsDir)).toBe(true)
+        const files = readdirSync(testsDir).filter((name) => name.endsWith(".test.ts"))
+        expect(files.length).toBeGreaterThan(0)
+        for (const file of files) {
+            const content = readFileSync(new URL(file, testsDir), "utf-8")
+            expect(content).not.toMatch(/it\.skip\(|describe\.skip\(|test\.skip\(/)
+            expect(content).not.toMatch(/\.todo\(/)
+        }
+    })
+
+    it("CONTRACT-031 action.yml interface consistent with implementation", async () => {
+        const text = readFileSync(new URL("../action.yml", import.meta.url), "utf-8")
+        const inputs = sectionKeys(text, "inputs")
+        const values: Record<string, string> = { token: "t", tag: "v1", skipIfReleaseExists: "false", makeLatest: "legacy" }
+        for (const name of inputs) {
+            if (!(name in values)) values[name] = ""
+        }
+        setInputs(values)
+        expect(() => new CoreInputs(emptyGlobber(), makeContext("", "o", "r"))).not.toThrow()
+        const outputs = new CoreOutputs()
+        outputs.applyReleaseData({ id: 1, html_url: "h", upload_url: "u", tarball_url: "", zipball_url: "" })
+        outputs.applyAssetUrls({})
+        const written = mockSetOutput.mock.calls.map((call) => call[0]).sort()
+        expect(written).toEqual(sectionKeys(text, "outputs").sort())
+    })
+})
+
+function sectionKeys(text: string, section: string): string[] {
+    const keys: string[] = []
+    let inSection = false
+    for (const line of text.split("\n")) {
+        if (line.startsWith(`${section}:`)) {
+            inSection = true
+            continue
+        }
+        if (/^[A-Za-z]/.test(line)) {
+            inSection = false
+            continue
+        }
+        if (inSection && /^ {2}\S/.test(line) && !/^ {4}/.test(line) && line.trimEnd().endsWith(":")) {
+            keys.push(line.trim().replace(/:$/, ""))
+        }
+    }
+    return keys
+}
