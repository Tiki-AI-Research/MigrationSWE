+// Contract probe for BATCH-CONTRACT-0001 (pre-migration TypeScript side).
+//
+// The INTEGRATION runner copies this file into the source repository's
+// __tests__/ directory so that the ../src/*.js imports resolve, then runs it
+// with an explicit timeout. @actions/core is replaced by the repository manual
+// mock, so no credentials, network access or GitHub API calls occur.
+
+import * as core from "@actions/core"
+import { existsSync, mkdtempSync, readdirSync, readFileSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { beforeEach, describe, expect, it, vi } from "vitest"
+
+vi.mock("@actions/core")
+
+import { Action } from "../src/Action.js"
+import { Artifact } from "../src/Artifact.js"
+import { FileArtifactGlobber } from "../src/ArtifactGlobber.js"
+import { GithubError } from "../src/GithubError.js"
+import { GithubErrorDetail } from "../src/GithubErrorDetail.js"
+import { CoreInputs } from "../src/Inputs.js"
+import { CoreOutputs } from "../src/Outputs.js"
+import { PathNormalizer } from "../src/PathNormalizer.js"
+import { expandTilde } from "../src/PathExpander.js"
+import { GithubReleases } from "../src/Releases.js"
+import { ReleaseValidator } from "../src/ReleaseValidator.js"
+import { ReleaseActionSkipper } from "../src/ActionSkipper.js"
+
+const mockGetInput = vi.mocked(core.getInput)
+const mockGetBooleanInput = vi.mocked(core.getBooleanInput)
+const mockSetOutput = vi.mocked(core.setOutput)
+const mockNotice = vi.mocked(core.notice)
+
+const ORIGINAL_ENV = { ...process.env }
+
+function makeContext(ref = "", owner = "ctxowner", repo = "ctxrepo"): any {
+    return { ref, repo: { owner, repo } }
+}
+
+function setInputs(values: Record<string, string>) {
+    mockGetInput.mockImplementation((name: string, options?: { required?: boolean }) => {
+        const value = (values[name] ?? "").trim()
+        if (options?.required && value === "") {
+            throw new Error(`Input required and not supplied: ${name}`)
+        }
+        return value
+    })
+    mockGetBooleanInput.mockImplementation((name: string) => {
+        const raw = (values[name] ?? "").trim()
+        if (raw === "true" || raw === "True" || raw === "TRUE") return true
+        if (raw === "false" || raw === "False" || raw === "FALSE") return false
+        throw new Error(`Input does not meet YAML 1.2 "Core Schema" specification: ${name}`)
+    })
+}
+
+function emptyGlobber(): any {
+    return { globArtifactString: vi.fn(() => []) }
+}
+
+function makeInputs(overrides: Record<string, unknown> = {}): any {
+    return Object.assign(
