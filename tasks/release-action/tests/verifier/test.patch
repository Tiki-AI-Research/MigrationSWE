+		t.Fatal("expected a non-404 lookup error to propagate")
+	}
+}
+
+// ---------------------------------------------------------------------------
+// F2P-029 / F2P-035 (R037) skipIfReleaseExists workflow boolean literals.
+// ---------------------------------------------------------------------------
+
+func TestF2P029(t *testing.T) {
+	t.Setenv("INPUT_SKIPIFRELEASEEXISTS", "TRUE")
+	value, err := EnvInputGetter{}.GetBooleanInput("skipIfReleaseExists")
+	if err != nil || !value {
+		t.Fatalf("TRUE -> value=%v err=%v, want true/nil", value, err)
+	}
+
+	t.Setenv("INPUT_SKIPIFRELEASEEXISTS", "yes")
+	if _, err := (EnvInputGetter{}).GetBooleanInput("skipIfReleaseExists"); err == nil {
+		t.Fatal("expected a non-workflow boolean literal to fail")
