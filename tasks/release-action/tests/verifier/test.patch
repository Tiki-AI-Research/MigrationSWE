+
+	t.Run("CONTRACT-006", func(t *testing.T) {
+		globber := NewFileArtifactGlobber()
+		getter := cpInputGetter{values: map[string]string{"token": "t"}}
+		inputs, err := LoadInputs(getter, globber, ActionContext{Ref: "refs/tags/v1.2.3"})
