+    def release(self, **fields):
+        result = {"id": 42, "tag_name": "ctx-tag", "draft": False, "prerelease": False,
+                  "html_url": "https://example.test/release/42",
+                  "upload_url": self.url + "/upload{?name,label}",
+                  "tarball_url": None, "zipball_url": None}
