+
+	t.Run("does not publish immutable when created draft", func(t *testing.T) {
+		releases := newTestReleases()
+		updateCalled := false
+		releases.updateFn = func(id int64, tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+			updateCalled = true
