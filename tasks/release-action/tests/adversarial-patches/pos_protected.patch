+	createdDraft                bool
+	updatedReleaseBody          *string
+	generateReleaseNotesPrevTag *string
+}
+
+func defaultActionConfig() actionConfig {
+	return actionConfig{
+		allowUpdates:         false,
+		hasArtifact:          false,
+		removeArtifacts:      false,
+		generateReleaseNotes: true,
+		omitBodyDuringUpdate: false,
+		createdReleaseBody:   strPtr(testCreateBody),
+		immutableCreate:      true,
+		createdDraft:         true,
+		updatedReleaseBody:   strPtr(testUpdateBody),
+	}
+}
+
+func buildInputs(config actionConfig) *Inputs {
+	artifacts := []Artifact{}
+	if config.hasArtifact {
+		artifacts = testArtifactList()
+	}
+	commit := testCommit
+	category := testCategory
+	makeLatest := "legacy"
+	updatedDraft := false
+	updatedPrerelease := false
+	createdPrerelease := true
+
+	return &Inputs{
+		AllowUpdates:                    config.allowUpdates,
+		ArtifactErrorsFailBuild:         true,
+		Artifacts:                       artifacts,
+		Commit:                          &commit,
+		CreatedDraft:                    config.createdDraft,
+		CreatedPrerelease:               createdPrerelease,
+		CreatedReleaseBody:              config.createdReleaseBody,
+		CreatedReleaseName:              strPtr(testCreateName),
+		DiscussionCategory:              &category,
+		GenerateReleaseNotes:            config.generateReleaseNotes,
+		GenerateReleaseNotesPreviousTag: config.generateReleaseNotesPrevTag,
+		ImmutableCreate:                 config.immutableCreate,
+		MakeLatest:                      &makeLatest,
+		OmitBodyDuringUpdate:            config.omitBodyDuringUpdate,
+		Owner:                           "owner",
+		RemoveArtifacts:                 config.removeArtifacts,
+		ReplacesArtifacts:               true,
+		Repo:                            "repo",
+		SkipIfReleaseExists:             false,
+		Tag:                             testTag,
+		Token:                           "token",
+		UpdatedDraft:                    &updatedDraft,
+		UpdatedPrerelease:               &updatedPrerelease,
+		UpdatedReleaseBody:              config.updatedReleaseBody,
+		UpdatedReleaseName:              strPtr(testUpdateName),
+		UpdateOnlyUnreleased:            false,
+	}
+}
+
+func newTestReleases() *fakeReleases {
+	return &fakeReleases{
+		createFn: func(tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+			return testReleaseData(testReleaseId), nil
+		},
+		updateFn: func(id int64, tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+			return testReleaseData(testReleaseId), nil
+		},
+		getByTagFn: func(tag string) (*ReleaseData, error) {
+			return &ReleaseData{ID: testExistingId}, nil
+		},
+		genNotesFn: func(tag string, previousTag *string, targetCommitish *string) (GenerateReleaseNotesResponse, error) {
+			return GenerateReleaseNotesResponse{Body: testGeneratedNotes}, nil
+		},
+		listFn: func() (*ListReleasesResponse, error) {
+			empty := []ReleaseData{}
+			return &ListReleasesResponse{Data: &empty}, nil
+		},
+	}
+}
+
+func newTestAction(t *testing.T, config actionConfig, releases *fakeReleases, outputs *fakeOutputs, uploader *fakeUploader, destroyer *fakeDestroyer, skipper *fakeSkipper) *Action {
+	t.Helper()
+	if releases == nil {
+		releases = newTestReleases()
+	}
+	if outputs == nil {
+		outputs = &fakeOutputs{}
+	}
+	if uploader == nil {
+		uploader = &fakeUploader{fn: func([]Artifact, int64, string) (map[string]string, error) {
+			return testAssetURLs(), nil
+		}}
+	}
+	if destroyer == nil {
+		destroyer = &fakeDestroyer{}
+	}
+	if skipper == nil {
+		skipper = &fakeSkipper{}
+	}
+	return NewAction(buildInputs(config), outputs, releases, uploader, destroyer, skipper)
+}
+
+func TestAction(t *testing.T) {
+	t.Run("creates release with generated release notes", func(t *testing.T) {
+		releases := newTestReleases()
+		var gotGenTag string
+		var gotGenPrev, gotGenCommit *string
+		releases.genNotesFn = func(tag string, previousTag *string, targetCommitish *string) (GenerateReleaseNotesResponse, error) {
+			gotGenTag, gotGenPrev, gotGenCommit = tag, previousTag, targetCommitish
+			return GenerateReleaseNotesResponse{Body: testGeneratedNotes}, nil
+		}
+		var gotCreateBody *string
+		releases.createFn = func(tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+			gotCreateBody = body
+			return testReleaseData(testReleaseId), nil
+		}
+		outputs := &fakeOutputs{}
+		config := defaultActionConfig()
+		config.hasArtifact = false
+		config.createdReleaseBody = strPtr("")
+		action := newTestAction(t, config, releases, outputs, nil, nil, nil)
+
+		if err := action.Perform(); err != nil {
+			t.Fatal(err)
+		}
+		if gotGenTag != testTag || gotGenPrev != nil || gotGenCommit == nil || *gotGenCommit != testCommit {
+			t.Fatalf("gen notes args: %q %v %v", gotGenTag, gotGenPrev, gotGenCommit)
+		}
+		if gotCreateBody == nil || *gotCreateBody != testGeneratedNotes {
+			t.Fatalf("create body = %v", gotCreateBody)
+		}
+		assertReleaseOutput(t, outputs, testReleaseId)
+		if len(outputs.assetUrls) != 0 {
+			t.Fatalf("asset urls = %v", outputs.assetUrls)
+		}
+	})
+
+	t.Run("creates release with static body", func(t *testing.T) {
+		releases := newTestReleases()
+		genCalled := false
+		releases.genNotesFn = func(string, *string, *string) (GenerateReleaseNotesResponse, error) {
+			genCalled = true
+			return GenerateReleaseNotesResponse{Body: testGeneratedNotes}, nil
+		}
+		config := defaultActionConfig()
+		config.generateReleaseNotes = false
+		config.createdReleaseBody = strPtr("static body")
+		action := newTestAction(t, config, releases, nil, nil, nil, nil)
+
+		if err := action.Perform(); err != nil {
+			t.Fatal(err)
+		}
+		if genCalled {
+			t.Fatal("did not expect generate notes")
+		}
+	})
+
+	t.Run("combines body and generated notes", func(t *testing.T) {
+		releases := newTestReleases()
+		var gotCreateBody *string
+		releases.createFn = func(tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+			gotCreateBody = body
+			return testReleaseData(testReleaseId), nil
+		}
+		action := newTestAction(t, defaultActionConfig(), releases, nil, nil, nil, nil)
+		if err := action.Perform(); err != nil {
+			t.Fatal(err)
+		}
+		want := testCreateBody + "\n" + testGeneratedNotes
+		if gotCreateBody == nil || *gotCreateBody != want {
+			t.Fatalf("create body = %v", gotCreateBody)
+		}
+	})
+
+	t.Run("creates release and uploads artifacts with response upload url", func(t *testing.T) {
+		releases := newTestReleases()
+		var uploadUrl string
+		var uploadArtifacts []Artifact
+		uploader := &fakeUploader{fn: func(artifacts []Artifact, releaseId int64, url string) (map[string]string, error) {
+			uploadArtifacts = artifacts
+			uploadUrl = url
+			return testAssetURLs(), nil
+		}}
+		config := defaultActionConfig()
+		config.hasArtifact = true
+		outputs := &fakeOutputs{}
