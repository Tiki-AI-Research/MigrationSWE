+
+	t.Run("globs simple path", func(t *testing.T) {
+		dir := t.TempDir()
+		file1 := filepath.Join(dir, "file1")
+		writeFile(t, file1)
+		globber := &stubGlobber{result: []string{file1}}
+		artifactGlobber := NewFileArtifactGlobberWith(globber)
+
+		artifacts, err := artifactGlobber.GlobArtifactString("path", "raw", false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if globber.lastPattern != "path" || len(artifacts) != 1 {
+			t.Fatalf("pattern=%q artifacts=%d", globber.lastPattern, len(artifacts))
+		}
+	})
+
+	t.Run("splits on comma", func(t *testing.T) {
+		dir := t.TempDir()
+		file1 := filepath.Join(dir, "file1")
+		writeFile(t, file1)
+
+		var patterns []string
+		globber := &stubGlobber{result: []string{file1}}
+		patternRecorder := &recordingGlobberAdapter{stub: globber, patterns: &patterns}
+		artifactGlobber := NewFileArtifactGlobberWith(patternRecorder)
+
+		artifacts, err := artifactGlobber.GlobArtifactString("path1,path2", "raw", false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(patterns) != 2 || patterns[0] != "path1" || patterns[1] != "path2" {
+			t.Fatalf("patterns = %v", patterns)
+		}
+		if len(artifacts) != 2 {
+			t.Fatalf("artifacts = %d", len(artifacts))
