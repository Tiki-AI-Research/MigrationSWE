+package main
+
+import (
+	"fmt"
+	"strings"
+)
+
+// GithubErrorDetail is a single entry in a GitHub API error response.
+type GithubErrorDetail struct {
+	Code             string `json:"code"`
+	Resource         string `json:"resource"`
+	Field            string `json:"field"`
+	Message          string `json:"message"`
+	DocumentationURL string `json:"documentation_url"`
+}
+
+// CodeValue exposes the error code, mirroring the baseline detail.code getter.
+func (d GithubErrorDetail) CodeValue() string {
+	return d.Code
+}
+
+func (d GithubErrorDetail) String() string {
+	switch d.Code {
+	case "missing":
+		return fmt.Sprintf("%s does not exist.", d.Resource)
+	case "missing_field":
+		return fmt.Sprintf("The %s field on %s is missing.", d.Field, d.Resource)
+	case "invalid":
+		return fmt.Sprintf("The %s field on %s is an invalid format.", d.Field, d.Resource)
+	case "already_exists":
+		return fmt.Sprintf("%s already exists.", d.Resource)
+	default:
+		if d.DocumentationURL != "" {
+			return fmt.Sprintf("%s\nPlease see %s.", d.Message, d.DocumentationURL)
+		}
+		return d.Message
+	}
+}
+
+// GithubError formats a GitHub API error and also carries the HTTP status so
+// callers can branch on it (for example 404 handling and 5xx retries).
+type GithubError struct {
+	Status  int
+	Message string
+	Errors  []GithubErrorDetail
+}
+
+func (e *GithubError) Error() string {
+	return e.String()
+}
+
+// ErrorMessage returns the raw message without the surrounding formatting.
+func (e *GithubError) ErrorMessage() string {
+	return e.Message
+}
+
+// StatusCode implements the status carrying error contract used by the
+// uploader and the action.
+func (e *GithubError) StatusCode() int {
+	return e.Status
+}
+
+func (e *GithubError) HasErrorWithCode(code string) bool {
+	for _, detail := range e.Errors {
+		if detail.Code == code {
+			return true
+		}
+	}
+	return false
+}
+
+func (e *GithubError) String() string {
+	if len(e.Errors) > 0 {
+		return fmt.Sprintf("Error %d: %s\nErrors:\n%s%s", e.Status, e.Message, e.errorBulletedList(), e.remediation())
+	}
+	return fmt.Sprintf("Error %d: %s%s", e.Status, e.Message, e.remediation())
+}
+
+func (e *GithubError) errorBulletedList() string {
+	lines := make([]string, 0, len(e.Errors))
+	for _, detail := range e.Errors {
+		lines = append(lines, fmt.Sprintf("- %s", detail.String()))
+	}
+	return strings.Join(lines, "\n")
+}
+
+func (e *GithubError) remediation() string {
+	if e.Status == 404 {
+		return "\nMake sure your github token has access to the repo and has permission to author releases"
+	}
+	return ""
+}
