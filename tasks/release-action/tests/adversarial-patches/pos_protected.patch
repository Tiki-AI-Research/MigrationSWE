+func TestArtifactUploader(t *testing.T) {
+	const releaseId = 100
+	const url = "http://api.example.com"
+	const contentLength = 4
+
+	t.Run("returns asset urls when upload succeeds", func(t *testing.T) {
+		artifacts := uploaderArtifacts(t, contentLength)
+		uploadCount := 0
+		releases := &fakeReleases{
+			uploadFn: func(assetUrl string, length int64, contentType string, file io.Reader, name string, id int64) (UploadArtifactResponse, error) {
+				uploadCount++
+				return UploadArtifactResponse{BrowserDownloadURL: "https://github.com/octocat/Hello-World/releases/download/v1.0.0/" + name}, nil
+			},
+		}
+		uploader := NewGithubArtifactUploader(releases, true, false)
+
+		result, err := uploader.UploadArtifacts(artifacts, releaseId, url)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := map[string]string{
+			"art1": "https://github.com/octocat/Hello-World/releases/download/v1.0.0/art1",
+			"art2": "https://github.com/octocat/Hello-World/releases/download/v1.0.0/art2",
+		}
+		if !reflect.DeepEqual(result, want) {
+			t.Fatalf("result = %v", result)
+		}
+		if uploadCount != 2 {
+			t.Fatalf("uploadCount = %d", uploadCount)
+		}
+	})
+
+	t.Run("returns empty object when no artifacts", func(t *testing.T) {
+		uploadCount := 0
+		releases := &fakeReleases{uploadFn: func(string, int64, string, io.Reader, string, int64) (UploadArtifactResponse, error) {
+			uploadCount++
+			return UploadArtifactResponse{}, nil
+		}}
+		uploader := NewGithubArtifactUploader(releases, true, false)
+		result, err := uploader.UploadArtifacts([]Artifact{}, releaseId, url)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(result) != 0 || uploadCount != 0 {
+			t.Fatalf("result=%v uploadCount=%d", result, uploadCount)
+		}
+	})
+
+	t.Run("excludes failed uploads", func(t *testing.T) {
+		artifacts := uploaderArtifacts(t, contentLength)
+		uploadCount := 0
+		releases := &fakeReleases{uploadFn: func(string, int64, string, io.Reader, string, int64) (UploadArtifactResponse, error) {
+			uploadCount++
+			return UploadArtifactResponse{}, testUploadError{message: "error", status: 401}
+		}}
+		uploader := NewGithubArtifactUploader(releases, true, false)
+
+		result, err := uploader.UploadArtifacts(artifacts, releaseId, url)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(result) != 0 || uploadCount != 2 {
+			t.Fatalf("result=%v uploadCount=%d", result, uploadCount)
+		}
+	})
+
+	t.Run("aborts after 3 retries on 5xx", func(t *testing.T) {
+		artifacts := uploaderArtifacts(t, contentLength)
+		remainingFailures := 4
+		uploadCount := 0
+		releases := &fakeReleases{uploadFn: func(string, int64, string, io.Reader, string, int64) (UploadArtifactResponse, error) {
+			uploadCount++
+			if remainingFailures > 0 {
+				remainingFailures--
+				return UploadArtifactResponse{}, testUploadError{message: "HTTP 500", status: 500}
+			}
+			return UploadArtifactResponse{}, testUploadError{message: "HTTP 401", status: 401}
+		}}
+		uploader := NewGithubArtifactUploader(releases, true, false)
+
+		result, err := uploader.UploadArtifacts(artifacts, releaseId, url)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(result) != 0 || uploadCount != 5 {
+			t.Fatalf("result=%v uploadCount=%d", result, uploadCount)
+		}
+	})
+
+	t.Run("replaces all artifacts", func(t *testing.T) {
+		artifacts := uploaderArtifacts(t, contentLength)
+		deleted := []int64{}
+		releases := &fakeReleases{
+			listAssetsFn: func(int64) ([]ReleaseAsset, error) {
+				return []ReleaseAsset{{Name: "art1", ID: 1}, {Name: "art2", ID: 2}}, nil
+			},
+			deleteFn: func(id int64) error {
+				deleted = append(deleted, id)
+				return nil
+			},
+			uploadFn: func(assetUrl string, length int64, contentType string, file io.Reader, name string, id int64) (UploadArtifactResponse, error) {
+				return UploadArtifactResponse{BrowserDownloadURL: "url/" + name}, nil
+			},
+		}
+		uploader := NewGithubArtifactUploader(releases, true, false)
+		if _, err := uploader.UploadArtifacts(artifacts, releaseId, url); err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(deleted, []int64{1, 2}) {
+			t.Fatalf("deleted = %v", deleted)
+		}
+	})
+
+	t.Run("replaces no artifacts when list empty", func(t *testing.T) {
+		artifacts := uploaderArtifacts(t, contentLength)
+		deleted := 0
+		releases := &fakeReleases{
+			listAssetsFn: func(int64) ([]ReleaseAsset, error) { return []ReleaseAsset{}, nil },
+			deleteFn:     func(int64) error { deleted++; return nil },
+			uploadFn: func(assetUrl string, length int64, contentType string, file io.Reader, name string, id int64) (UploadArtifactResponse, error) {
+				return UploadArtifactResponse{BrowserDownloadURL: "url/" + name}, nil
+			},
+		}
+		uploader := NewGithubArtifactUploader(releases, true, false)
+		if _, err := uploader.UploadArtifacts(artifacts, releaseId, url); err != nil {
+			t.Fatal(err)
+		}
+		if deleted != 0 {
+			t.Fatalf("deleted = %d", deleted)
+		}
+	})
+
+	t.Run("retries 5xx once then succeeds per artifact", func(t *testing.T) {
+		artifacts := uploaderArtifacts(t, contentLength)
+		remainingFailures := 2
+		uploadCount := 0
+		releases := &fakeReleases{uploadFn: func(string, int64, string, io.Reader, string, int64) (UploadArtifactResponse, error) {
+			uploadCount++
+			if remainingFailures > 0 {
+				remainingFailures--
+				return UploadArtifactResponse{}, testUploadError{message: "HTTP 500", status: 500}
+			}
+			return UploadArtifactResponse{BrowserDownloadURL: "url"}, nil
+		}}
+		uploader := NewGithubArtifactUploader(releases, true, false)
+		result, err := uploader.UploadArtifacts(artifacts, releaseId, url)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(result) != 2 || uploadCount != 4 {
+			t.Fatalf("result=%v uploadCount=%d", result, uploadCount)
+		}
+	})
+
+	t.Run("throws upload error when enabled", func(t *testing.T) {
+		artifacts := uploaderArtifacts(t, contentLength)
+		releases := &fakeReleases{uploadFn: func(string, int64, string, io.Reader, string, int64) (UploadArtifactResponse, error) {
+			return UploadArtifactResponse{}, testUploadError{message: "error", status: 502}
+		}}
+		uploader := NewGithubArtifactUploader(releases, true, true)
+		_, err := uploader.UploadArtifacts(artifacts, releaseId, url)
+		if err == nil || err.Error() != "Failed to upload artifact art1. error." {
+			t.Fatalf("err = %v", err)
+		}
