+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// Outputs reports action outputs.
+type Outputs interface {
+	ApplyReleaseData(releaseData ReleaseData)
+	ApplyAssetUrls(assetUrls map[string]string)
+}
+
+// SetOutputFunc writes a single action output.
+type SetOutputFunc func(name string, value string)
+
+// CoreOutputs writes outputs through the GITHUB_OUTPUT mechanism.
+type CoreOutputs struct {
+	setOutput SetOutputFunc
+}
+
+func NewCoreOutputs() *CoreOutputs {
+	return &CoreOutputs{setOutput: envSetOutput}
+}
+
+func NewCoreOutputsWith(setOutput SetOutputFunc) *CoreOutputs {
+	return &CoreOutputs{setOutput: setOutput}
+}
+
+func (o *CoreOutputs) ApplyReleaseData(releaseData ReleaseData) {
+	o.setOutput("id", strconv.FormatInt(releaseData.ID, 10))
+	o.setOutput("html_url", releaseData.HTMLURL)
+	o.setOutput("upload_url", releaseData.UploadURL)
+	o.setOutput("tarball_url", derefString(releaseData.TarballURL))
+	o.setOutput("zipball_url", derefString(releaseData.ZipballURL))
+}
+
+func (o *CoreOutputs) ApplyAssetUrls(assetUrls map[string]string) {
+	var buffer bytes.Buffer
+	encoder := json.NewEncoder(&buffer)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(assetUrls); err != nil {
+		buffer.Reset()
+		buffer.WriteString("{}")
+	}
+	o.setOutput("assets", strings.TrimRight(buffer.String(), "\n"))
+}
+
+func derefString(value *string) string {
+	if value == nil {
+		return ""
+	}
+	return *value
+}
+
+func envSetOutput(name string, value string) {
+	if path := os.Getenv("GITHUB_OUTPUT"); path != "" {
+		file, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+		if err == nil {
+			defer file.Close()
+			delimiter := fmt.Sprintf("ghadelimiter_%d", os.Getpid())
+			fmt.Fprintf(file, "%s<<%s\n%s\n%s\n", name, delimiter, value, delimiter)
+			return
+		}
+	}
+	fmt.Fprintf(os.Stdout, "%s=%s\n", name, value)
+}
