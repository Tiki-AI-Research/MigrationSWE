+	file := filepath.Join(dir, "file")
+	writeFile(t, file)
+	subdir := filepath.Join(dir, "subdir")
+	if err := os.Mkdir(subdir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	t.Run("warns and filters directories", func(t *testing.T) {
+		warnings := captureWarnings(t)
+		validator := NewArtifactPathValidator(false, []string{subdir, file}, "pattern")
+		result, err := validator.Validate()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(*warnings) == 0 {
+			t.Fatal("expected warning")
+		}
+		if !reflect.DeepEqual(result, []string{file}) {
+			t.Fatalf("result = %v", result)
+		}
+	})
+
+	t.Run("warns when empty and errors should not throw", func(t *testing.T) {
+		warnings := captureWarnings(t)
+		validator := NewArtifactPathValidator(false, []string{}, "pattern")
+		if _, err := validator.Validate(); err != nil {
+			t.Fatal(err)
+		}
+		if len(*warnings) == 0 {
+			t.Fatal("expected warning")
+		}
+	})
+
+	t.Run("throws when empty and errors should throw", func(t *testing.T) {
+		validator := NewArtifactPathValidator(true, []string{}, "pattern")
+		if _, err := validator.Validate(); err == nil {
+			t.Fatal("expected error")
+		}
+	})
+
+	t.Run("throws when path is a directory", func(t *testing.T) {
+		validator := NewArtifactPathValidator(true, []string{subdir, file}, "pattern")
+		if _, err := validator.Validate(); err == nil {
+			t.Fatal("expected error")
+		}
+	})
+}
