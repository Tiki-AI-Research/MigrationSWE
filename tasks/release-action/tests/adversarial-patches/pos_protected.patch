+			t.Fatalf("err = %v", err)
+		}
+	})
+
+	t.Run("updates existing release", func(t *testing.T) {
+		releases := newTestReleases()
+		var updatedId int64
+		releases.updateFn = func(id int64, tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+			updatedId = id
+			return testReleaseData(testReleaseId), nil
+		}
+		config := defaultActionConfig()
+		config.allowUpdates = true
+		outputs := &fakeOutputs{}
+		action := newTestAction(t, config, releases, outputs, nil, nil, nil)
+
+		if err := action.Perform(); err != nil {
+			t.Fatal(err)
+		}
+		if updatedId != testExistingId {
+			t.Fatalf("updated id = %d", updatedId)
+		}
+		assertReleaseOutput(t, outputs, testReleaseId)
+	})
+
+	t.Run("omits body/commit on immutable publish", func(t *testing.T) {
+		releases := newTestReleases()
+		var publishBody, publishCommit *string
+		var publishDraft *bool
+		callCount := 0
+		releases.updateFn = func(id int64, tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+			callCount++
+			publishBody = body
+			publishCommit = commitHash
+			publishDraft = draft
+			return testReleaseData(testReleaseId), nil
+		}
+		config := defaultActionConfig()
+		config.immutableCreate = true
+		config.createdDraft = false
+		outputs := &fakeOutputs{}
+		action := newTestAction(t, config, releases, outputs, nil, nil, nil)
