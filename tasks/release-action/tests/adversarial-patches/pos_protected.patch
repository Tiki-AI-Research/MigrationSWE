+		releases.createFn = func(tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+			created = true
+			return testReleaseData(testReleaseId), nil
+		}
+		config := defaultActionConfig()
+		config.allowUpdates = true
+		config.hasArtifact = true
+		action := newTestAction(t, config, releases, nil, nil, nil, nil)
+
+		if err := action.Perform(); err != nil {
+			t.Fatal(err)
+		}
+		if !created {
+			t.Fatal("expected create")
+		}
+	})
+
+	t.Run("updates draft release when 404 and draft exists", func(t *testing.T) {
+		releases := newTestReleases()
+		releases.getByTagFn = func(string) (*ReleaseData, error) {
+			return nil, &GithubError{Status: 404, Message: "not found"}
+		}
+		draftId := int64(123)
+		releases.listFn = func() (*ListReleasesResponse, error) {
+			data := []ReleaseData{
+				{ID: 999, Draft: false, TagName: testTag},
+				{ID: draftId, Draft: true, TagName: testTag},
+			}
+			return &ListReleasesResponse{Data: &data}, nil
+		}
+		var updatedId int64
+		releases.updateFn = func(id int64, tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
