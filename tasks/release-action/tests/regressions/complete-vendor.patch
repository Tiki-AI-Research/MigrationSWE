index 0000000..ccc8235
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,10 @@
+FROM golang:1.23 AS build
+WORKDIR /src
+COPY go.mod go.sum ./
+RUN go mod download
+COPY . .
+RUN CGO_ENABLED=0 go build -o /release-action ./cmd/release
+
+FROM gcr.io/distroless/static-debian12:nonroot
+COPY --from=build /release-action /release-action
+ENTRYPOINT ["/release-action"]
