+package main
+
+import "fmt"
+
+// ArtifactDestroyer removes existing release assets.
+type ArtifactDestroyer interface {
+	DestroyArtifacts(releaseId int64) error
+}
+
+// GithubArtifactDestroyer implements ArtifactDestroyer against Releases.
+type GithubArtifactDestroyer struct {
+	releases Releases
+}
+
+func NewGithubArtifactDestroyer(releases Releases) *GithubArtifactDestroyer {
+	return &GithubArtifactDestroyer{releases: releases}
+}
+
+func (d *GithubArtifactDestroyer) DestroyArtifacts(releaseId int64) error {
+	releaseAssets, err := d.releases.ListArtifactsForRelease(releaseId)
+	if err != nil {
+		return err
+	}
+
+	for _, artifact := range releaseAssets {
+		logDebug(fmt.Sprintf("Deleting existing artifact %s...", artifact.Name))
+		if err := d.releases.DeleteArtifact(artifact.ID); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/cmd/release/artifact_globber.go b/cmd/release/artifact_globber.go
new file mode 100644
index 0000000..1717971
--- /dev/null
+++ b/cmd/release/artifact_globber.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"strings"
+	"unicode"
+
+	"github.com/bmatcuk/doublestar/v4"
+)
+
+// Globber resolves a glob pattern to a list of paths. It mirrors the Node glob
+// package's mark behaviour by returning directories as-is; the artifact
+// validator filters them out.
+type Globber interface {
+	Glob(pattern string) ([]string, error)
+}
+
+// FileGlobber is the filesystem backed Globber. It matches dotfiles the same
+// way as the Node glob default (dot: false) by ignoring hidden files.
+type FileGlobber struct{}
+
+func (FileGlobber) Glob(pattern string) ([]string, error) {
+	return doublestar.FilepathGlob(pattern, doublestar.WithNoHidden())
+}
+
+// ArtifactGlobber expands an artifact input string into artifacts.
+type ArtifactGlobber interface {
+	GlobArtifactString(artifact string, contentType string, errorsFailBuild bool) ([]Artifact, error)
+}
+
+var artifactSplitPattern = regexp.MustCompile(`[,\n]`)
+
+// FileArtifactGlobber splits, normalizes, expands and globs artifact strings.
+type FileArtifactGlobber struct {
+	globber Globber
+}
+
+func NewFileArtifactGlobber() *FileArtifactGlobber {
+	return &FileArtifactGlobber{globber: FileGlobber{}}
+}
+
+func NewFileArtifactGlobberWith(globber Globber) *FileArtifactGlobber {
+	return &FileArtifactGlobber{globber: globber}
+}
+
+func (g *FileArtifactGlobber) GlobArtifactString(artifact string, contentType string, errorsFailBuild bool) ([]Artifact, error) {
+	result := []Artifact{}
+
+	for _, raw := range artifactSplitPattern.Split(artifact, -1) {
+		path := strings.TrimLeftFunc(raw, unicode.IsSpace)
+		path = normalizePath(path)
+		path = expandTilde(path)
+
+		paths, err := g.globPattern(path, errorsFailBuild)
+		if err != nil {
+			return nil, err
+		}
+
+		validated, err := validateArtifactPattern(errorsFailBuild, paths, path)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, matched := range validated {
+			result = append(result, NewArtifact(matched, contentType))
+		}
+	}
+
+	return result, nil
+}
+
+func (g *FileArtifactGlobber) globPattern(pattern string, errorsFailBuild bool) ([]string, error) {
+	paths, err := g.globber.Glob(pattern)
+	if err != nil {
+		return nil, err
+	}
+
+	if len(paths) == 0 {
+		message := fmt.Sprintf("Artifact pattern :%s did not match any files", pattern)
+		if errorsFailBuild {
+			return nil, errors.New(message)
+		}
+		logWarning(message)
+	}
+
+	return paths, nil
+}
+
+func validateArtifactPattern(errorsFailBuild bool, paths []string, pattern string) ([]string, error) {
+	validator := &ArtifactPathValidator{
+		errorsFailBuild: errorsFailBuild,
+		paths:           paths,
+		pattern:         pattern,
+	}
+	return validator.Validate()
+}
diff --git a/cmd/release/artifact_path_validator.go b/cmd/release/artifact_path_validator.go
new file mode 100644
index 0000000..2d88101
--- /dev/null
+++ b/cmd/release/artifact_path_validator.go
@@ -0,0 +1,68 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+)
+
+// ArtifactPathValidator fails or warns on empty glob results and filters out
+// paths that point at directories.
+type ArtifactPathValidator struct {
+	errorsFailBuild bool
+	paths           []string
+	pattern         string
+}
+
+func NewArtifactPathValidator(errorsFailBuild bool, paths []string, pattern string) *ArtifactPathValidator {
+	return &ArtifactPathValidator{
+		errorsFailBuild: errorsFailBuild,
+		paths:           paths,
+		pattern:         pattern,
+	}
+}
+
+func (v *ArtifactPathValidator) Validate() ([]string, error) {
+	if err := v.verifyPathsNotEmpty(); err != nil {
+		return nil, err
+	}
+
+	result := []string{}
+	for _, path := range v.paths {
+		isDirectory, err := v.verifyNotDirectory(path)
+		if err != nil {
+			return nil, err
+		}
+		if !isDirectory {
+			result = append(result, path)
+		}
+	}
+	return result, nil
+}
+
+func (v *ArtifactPathValidator) verifyPathsNotEmpty() error {
+	if len(v.paths) == 0 {
+		return v.reportError(fmt.Sprintf("Artifact pattern:%s did not match any files", v.pattern))
+	}
+	return nil
+}
+
+func (v *ArtifactPathValidator) verifyNotDirectory(path string) (bool, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		return false, err
+	}
+
+	if info.IsDir() {
+		return true, v.reportError(fmt.Sprintf("Artifact is a directory:%s. Directories can not be uploaded to a release.", path))
+	}
+	return false, nil
+}
+
+func (v *ArtifactPathValidator) reportError(message string) error {
+	if v.errorsFailBuild {
+		return errors.New(message)
+	}
+	logWarning(message)
+	return nil
+}
