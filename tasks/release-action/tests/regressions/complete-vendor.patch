+func TestMigratedArtifactGlobber(t *testing.T) {
+	home, _ := os.UserHomeDir()
+
+	t.Run("expands leading tilde", func(t *testing.T) {
+		warnings := captureWarnings(t)
+		dir := t.TempDir()
+		file1 := filepath.Join(dir, "file1")
+		file2 := filepath.Join(dir, "file2")
+		writeFile(t, file1)
+		writeFile(t, file2)
+
+		globber := &stubGlobber{result: []string{file1, file2}}
+		artifactGlobber := NewFileArtifactGlobberWith(globber)
+
+		artifacts, err := artifactGlobber.GlobArtifactString("~/path", "raw", false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if globber.lastPattern != filepath.Join(home, "path") {
+			t.Fatalf("pattern = %q", globber.lastPattern)
+		}
+		if len(artifacts) != 2 {
+			t.Fatalf("expected 2 artifacts, got %d", len(artifacts))
+		}
+		if len(*warnings) != 0 {
+			t.Fatalf("unexpected warnings: %v", *warnings)
+		}
+	})
+
+	t.Run("globs simple path", func(t *testing.T) {
+		dir := t.TempDir()
+		file1 := filepath.Join(dir, "file1")
+		writeFile(t, file1)
+		globber := &stubGlobber{result: []string{file1}}
+		artifactGlobber := NewFileArtifactGlobberWith(globber)
+
+		artifacts, err := artifactGlobber.GlobArtifactString("path", "raw", false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if globber.lastPattern != "path" || len(artifacts) != 1 {
+			t.Fatalf("pattern=%q artifacts=%d", globber.lastPattern, len(artifacts))
+		}
+	})
+
+	t.Run("splits on comma", func(t *testing.T) {
+		dir := t.TempDir()
+		file1 := filepath.Join(dir, "file1")
+		writeFile(t, file1)
+
+		var patterns []string
+		globber := &stubGlobber{result: []string{file1}}
+		patternRecorder := &recordingGlobberAdapter{stub: globber, patterns: &patterns}
+		artifactGlobber := NewFileArtifactGlobberWith(patternRecorder)
+
+		artifacts, err := artifactGlobber.GlobArtifactString("path1,path2", "raw", false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(patterns) != 2 || patterns[0] != "path1" || patterns[1] != "path2" {
+			t.Fatalf("patterns = %v", patterns)
+		}
+		if len(artifacts) != 2 {
+			t.Fatalf("artifacts = %d", len(artifacts))
+		}
+	})
+
+	t.Run("splits on newline and trims start", func(t *testing.T) {
+		dir := t.TempDir()
+		file1 := filepath.Join(dir, "file1")
+		writeFile(t, file1)
+
+		var patterns []string
+		patternRecorder := &recordingGlobberAdapter{stub: &stubGlobber{result: []string{file1}}, patterns: &patterns}
+		artifactGlobber := NewFileArtifactGlobberWith(patternRecorder)
+
+		if _, err := artifactGlobber.GlobArtifactString("path1\n  path2", "raw", false); err != nil {
+			t.Fatal(err)
+		}
+		if len(patterns) != 2 || patterns[0] != "path1" || patterns[1] != "path2" {
+			t.Fatalf("patterns = %v", patterns)
+		}
+	})
+
+	t.Run("warns when no results and errors should not throw", func(t *testing.T) {
+		warnings := captureWarnings(t)
+		artifactGlobber := NewFileArtifactGlobberWith(&stubGlobber{result: []string{}})
+		artifacts, err := artifactGlobber.GlobArtifactString("path", "raw", false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(artifacts) != 0 {
+			t.Fatalf("expected none, got %d", len(artifacts))
+		}
+		if len(*warnings) == 0 {
+			t.Fatal("expected a warning")
+		}
+	})
+
+	t.Run("throws when no results and errors should throw", func(t *testing.T) {
+		artifactGlobber := NewFileArtifactGlobberWith(&stubGlobber{result: []string{}})
+		if _, err := artifactGlobber.GlobArtifactString("path", "raw", true); err == nil {
+			t.Fatal("expected error")
+		}
+	})
+}
+
+type recordingGlobberAdapter struct {
+	stub     *stubGlobber
+	patterns *[]string
+}
+
+func (g *recordingGlobberAdapter) Glob(pattern string) ([]string, error) {
+	*g.patterns = append(*g.patterns, pattern)
+	return g.stub.Glob(pattern)
+}
