@@ -0,0 +1,37 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// normalizePath replaces the platform path separator with "/". On platforms
+// where the separator is already "/", the value is returned unchanged.
+func normalizePath(pathString string) string {
+	return strings.ReplaceAll(pathString, string(filepath.Separator), "/")
+}
+
+// expandTilde expands a leading "~" that is followed by "/", "\" or the end of
+// the string to the current user's home directory. "~user" patterns and
+// mid-path tildes are left unchanged.
+func expandTilde(path string) string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		home = ""
+	}
+	return expandTildeWithHome(path, home)
+}
+
+func expandTildeWithHome(path, home string) string {
+	if !strings.HasPrefix(path, "~") {
+		return path
+	}
+
+	rest := path[1:]
+	if rest == "" || strings.HasPrefix(rest, "/") || strings.HasPrefix(rest, "\\") {
+		return home + rest
+	}
+
+	return path
+}
