index 0000000000000000000000000000000000000000..2c3e01ac6940251410b84e7d33105704286774e5
--- /dev/null
+++ b/cmd/release/action_skipper.go
@@ -0,0 +1,40 @@
+package main
+
+// ActionSkipper decides whether the action should be skipped.
+type ActionSkipper interface {
+	ShouldSkip() (bool, error)
+}
+
+// ReleaseActionSkipper skips when a non-draft release already exists for the
+// tag and the skip flag is enabled. Any lookup failure continues the action.
+type ReleaseActionSkipper struct {
+	skipIfReleaseExists bool
+	releases            Releases
+	tag                 string
+}
+
+func NewReleaseActionSkipper(skipIfReleaseExists bool, releases Releases, tag string) *ReleaseActionSkipper {
+	return &ReleaseActionSkipper{
+		skipIfReleaseExists: skipIfReleaseExists,
+		releases:            releases,
+		tag:                 tag,
+	}
+}
+
+func (s *ReleaseActionSkipper) ShouldSkip() (bool, error) {
+	if !s.skipIfReleaseExists {
+		return false, nil
+	}
+
+	release, err := s.releases.GetByTag(s.tag)
+	if err != nil {
+		// There is either no release or something else went wrong. Either way,
+		// run the action.
+		return false, nil
+	}
+	if release == nil {
+		return false, nil
+	}
+
+	return !release.Draft, nil
+}
diff --git a/cmd/release/artifact.go b/cmd/release/artifact.go
new file mode 100644
index 0000000000000000000000000000000000000000..358ae2147de8f7ef6d10cb60fb14cfd9cde0f040
--- /dev/null
+++ b/cmd/release/artifact.go
@@ -0,0 +1,41 @@
+package main
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+)
+
+// Artifact describes a single file to upload to a release.
+type Artifact struct {
+	ContentType string
+	Name        string
+	Path        string
+}
+
+// NewArtifact derives an artifact's name from its path and defaults an empty
+// content type to "raw".
+func NewArtifact(path string, contentType string) Artifact {
+	if contentType == "" {
+		contentType = "raw"
+	}
+	return Artifact{
+		Path:        path,
+		Name:        filepath.Base(path),
+		ContentType: contentType,
+	}
+}
+
+// ContentLength returns the size of the artifact in bytes.
+func (a Artifact) ContentLength() (int64, error) {
+	info, err := os.Stat(a.Path)
+	if err != nil {
+		return 0, err
+	}
+	return info.Size(), nil
+}
+
+// ReadFile opens the artifact for reading.
+func (a Artifact) ReadFile() (io.ReadCloser, error) {
+	return os.Open(a.Path)
+}
diff --git a/cmd/release/artifact_destroyer.go b/cmd/release/artifact_destroyer.go
new file mode 100644
index 0000000000000000000000000000000000000000..a9cede3eeee3b93d8e1840eb640c0c69ea86f506
--- /dev/null
+++ b/cmd/release/artifact_destroyer.go
@@ -0,0 +1,32 @@
+package main
+
+import "fmt"
+
+// ArtifactDestroyer removes existing release assets.
+type ArtifactDestroyer interface {
+	DestroyArtifacts(releaseId int64) error
+}
+
+// GithubArtifactDestroyer implements ArtifactDestroyer against Releases.
+type GithubArtifactDestroyer struct {
+	releases Releases
+}
+
+func NewGithubArtifactDestroyer(releases Releases) *GithubArtifactDestroyer {
+	return &GithubArtifactDestroyer{releases: releases}
+}
+
+func (d *GithubArtifactDestroyer) DestroyArtifacts(releaseId int64) error {
+	releaseAssets, err := d.releases.ListArtifactsForRelease(releaseId)
+	if err != nil {
+		return err
+	}
+
+	for _, artifact := range releaseAssets {
+		logDebug(fmt.Sprintf("Deleting existing artifact %s...", artifact.Name))
+		if err := d.releases.DeleteArtifact(artifact.ID); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/cmd/release/artifact_globber.go b/cmd/release/artifact_globber.go
new file mode 100644
index 0000000000000000000000000000000000000000..1717971225df8be92b8103daefdfa6c75aba1c15
--- /dev/null
+++ b/cmd/release/artifact_globber.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"strings"
+	"unicode"
+
+	"github.com/bmatcuk/doublestar/v4"
+)
+
+// Globber resolves a glob pattern to a list of paths. It mirrors the Node glob
+// package's mark behaviour by returning directories as-is; the artifact
+// validator filters them out.
+type Globber interface {
+	Glob(pattern string) ([]string, error)
+}
+
+// FileGlobber is the filesystem backed Globber. It matches dotfiles the same
+// way as the Node glob default (dot: false) by ignoring hidden files.
+type FileGlobber struct{}
+
+func (FileGlobber) Glob(pattern string) ([]string, error) {
+	return doublestar.FilepathGlob(pattern, doublestar.WithNoHidden())
+}
+
+// ArtifactGlobber expands an artifact input string into artifacts.
+type ArtifactGlobber interface {
+	GlobArtifactString(artifact string, contentType string, errorsFailBuild bool) ([]Artifact, error)
+}
+
+var artifactSplitPattern = regexp.MustCompile(`[,\n]`)
+
+// FileArtifactGlobber splits, normalizes, expands and globs artifact strings.
+type FileArtifactGlobber struct {
+	globber Globber
+}
+
+func NewFileArtifactGlobber() *FileArtifactGlobber {
+	return &FileArtifactGlobber{globber: FileGlobber{}}
+}
+
+func NewFileArtifactGlobberWith(globber Globber) *FileArtifactGlobber {
+	return &FileArtifactGlobber{globber: globber}
+}
+
+func (g *FileArtifactGlobber) GlobArtifactString(artifact string, contentType string, errorsFailBuild bool) ([]Artifact, error) {
+	result := []Artifact{}
+
+	for _, raw := range artifactSplitPattern.Split(artifact, -1) {
+		path := strings.TrimLeftFunc(raw, unicode.IsSpace)
+		path = normalizePath(path)
+		path = expandTilde(path)
+
+		paths, err := g.globPattern(path, errorsFailBuild)
+		if err != nil {
+			return nil, err
+		}
+
+		validated, err := validateArtifactPattern(errorsFailBuild, paths, path)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, matched := range validated {
+			result = append(result, NewArtifact(matched, contentType))
+		}
+	}
+
+	return result, nil
+}
+
+func (g *FileArtifactGlobber) globPattern(pattern string, errorsFailBuild bool) ([]string, error) {
+	paths, err := g.globber.Glob(pattern)
+	if err != nil {
+		return nil, err
+	}
+
+	if len(paths) == 0 {
+		message := fmt.Sprintf("Artifact pattern :%s did not match any files", pattern)
+		if errorsFailBuild {
+			return nil, errors.New(message)
+		}
+		logWarning(message)
+	}
+
+	return paths, nil
+}
+
+func validateArtifactPattern(errorsFailBuild bool, paths []string, pattern string) ([]string, error) {
+	validator := &ArtifactPathValidator{
+		errorsFailBuild: errorsFailBuild,
+		paths:           paths,
+		pattern:         pattern,
+	}
+	return validator.Validate()
+}
diff --git a/cmd/release/artifact_path_validator.go b/cmd/release/artifact_path_validator.go
new file mode 100644
index 0000000000000000000000000000000000000000..2d881014a6219a46df6c342c4496fbeecaa62150
--- /dev/null
+++ b/cmd/release/artifact_path_validator.go
@@ -0,0 +1,68 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+)
+
+// ArtifactPathValidator fails or warns on empty glob results and filters out
+// paths that point at directories.
+type ArtifactPathValidator struct {
+	errorsFailBuild bool
+	paths           []string
+	pattern         string
+}
+
+func NewArtifactPathValidator(errorsFailBuild bool, paths []string, pattern string) *ArtifactPathValidator {
+	return &ArtifactPathValidator{
+		errorsFailBuild: errorsFailBuild,
+		paths:           paths,
+		pattern:         pattern,
+	}
+}
+
+func (v *ArtifactPathValidator) Validate() ([]string, error) {
+	if err := v.verifyPathsNotEmpty(); err != nil {
+		return nil, err
+	}
+
+	result := []string{}
+	for _, path := range v.paths {
+		isDirectory, err := v.verifyNotDirectory(path)
+		if err != nil {
+			return nil, err
+		}
+		if !isDirectory {
+			result = append(result, path)
+		}
+	}
+	return result, nil
+}
+
+func (v *ArtifactPathValidator) verifyPathsNotEmpty() error {
+	if len(v.paths) == 0 {
+		return v.reportError(fmt.Sprintf("Artifact pattern:%s did not match any files", v.pattern))
+	}
+	return nil
+}
+
+func (v *ArtifactPathValidator) verifyNotDirectory(path string) (bool, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		return false, err
+	}
+
+	if info.IsDir() {
+		return true, v.reportError(fmt.Sprintf("Artifact is a directory:%s. Directories can not be uploaded to a release.", path))
+	}
+	return false, nil
+}
+
+func (v *ArtifactPathValidator) reportError(message string) error {
+	if v.errorsFailBuild {
+		return errors.New(message)
+	}
+	logWarning(message)
+	return nil
+}
diff --git a/cmd/release/artifact_uploader.go b/cmd/release/artifact_uploader.go
new file mode 100644
index 0000000000000000000000000000000000000000..dd67999f0f2ab22677cf51aff51e4eacaa496e71
--- /dev/null
+++ b/cmd/release/artifact_uploader.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"fmt"
+)
+
+// ArtifactUploader uploads artifacts to a release.
+type ArtifactUploader interface {
+	UploadArtifacts(artifacts []Artifact, releaseId int64, uploadUrl string) (map[string]string, error)
+}
+
+// GithubArtifactUploader implements ArtifactUploader against Releases.
+type GithubArtifactUploader struct {
+	releases                  Releases
+	replacesExistingArtifacts bool
+	throwsUploadErrors        bool
+}
+
+func NewGithubArtifactUploader(releases Releases, replacesExistingArtifacts bool, throwsUploadErrors bool) *GithubArtifactUploader {
+	return &GithubArtifactUploader{
+		releases:                  releases,
+		replacesExistingArtifacts: replacesExistingArtifacts,
+		throwsUploadErrors:        throwsUploadErrors,
+	}
+}
+
+func (u *GithubArtifactUploader) UploadArtifacts(artifacts []Artifact, releaseId int64, uploadUrl string) (map[string]string, error) {
+	if u.replacesExistingArtifacts {
+		if err := u.deleteUpdatedArtifacts(artifacts, releaseId); err != nil {
+			return nil, err
+		}
+	}
+
+	assetUrls := map[string]string{}
+	for _, artifact := range artifacts {
+		assetUrl, uploaded, err := u.uploadArtifact(artifact, releaseId, uploadUrl, 3)
+		if err != nil {
+			return nil, err
+		}
+		if uploaded {
+			assetUrls[artifact.Name] = assetUrl
+		}
+	}
+	return assetUrls, nil
+}
+
+func (u *GithubArtifactUploader) uploadArtifact(artifact Artifact, releaseId int64, uploadUrl string, retry int) (string, bool, error) {
+	logDebug(fmt.Sprintf("Uploading artifact %s...", artifact.Name))
+
+	contentLength, err := artifact.ContentLength()
+	if err != nil {
+		return "", false, err
+	}
+
+	file, err := artifact.ReadFile()
+	if err != nil {
+		return "", false, err
+	}
+	defer file.Close()
+
+	response, err := u.releases.UploadArtifact(uploadUrl, contentLength, artifact.ContentType, file, artifact.Name, releaseId)
+	if err != nil {
+		status, hasStatus := statusCodeOf(err)
+		if hasStatus && status >= 500 && retry > 0 {
+			logWarning(fmt.Sprintf("Failed to upload artifact %s. %s. Retrying...", artifact.Name, errorMessageOf(err)))
+			return u.uploadArtifact(artifact, releaseId, uploadUrl, retry-1)
+		}
+
+		if u.throwsUploadErrors {
+			return "", false, fmt.Errorf("Failed to upload artifact %s. %s.", artifact.Name, errorMessageOf(err))
+		}
+
+		logWarning(fmt.Sprintf("Failed to upload artifact %s. %s.", artifact.Name, errorMessageOf(err)))
+		return "", false, nil
+	}
+
+	return response.BrowserDownloadURL, true, nil
+}
+
+func (u *GithubArtifactUploader) deleteUpdatedArtifacts(artifacts []Artifact, releaseId int64) error {
+	releaseAssets, err := u.releases.ListArtifactsForRelease(releaseId)
+	if err != nil {
+		return err
+	}
+
+	assetByName := map[string]ReleaseAsset{}
+	for _, asset := range releaseAssets {
+		assetByName[asset.Name] = asset
+	}
+
+	for _, artifact := range artifacts {
+		asset, ok := assetByName[artifact.Name]
+		if !ok {
+			continue
+		}
+		logDebug(fmt.Sprintf("Deleting existing artifact %s...", artifact.Name))
+		if err := u.releases.DeleteArtifact(asset.ID); err != nil {
+			return err
+		}
+	}
+	return nil
+}
