+	var decoded map[string]string
+	if err := json.Unmarshal([]byte(outputs["assets"]), &decoded); err != nil {
+		t.Fatalf("assets not valid json: %v", err)
+	}
+	if !reflect.DeepEqual(decoded, assetUrls) {
+		t.Fatalf("assets = %v", decoded)
+	}
+
+	coreOutputs.ApplyAssetUrls(map[string]string{})
+	if outputs["assets"] != "{}" {
+		t.Fatalf("expected {}, got %q", outputs["assets"])
+	}
+}
