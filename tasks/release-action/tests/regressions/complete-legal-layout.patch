+			gotGenTag, gotGenPrev, gotGenCommit = tag, previousTag, targetCommitish
+			return GenerateReleaseNotesResponse{Body: testGeneratedNotes}, nil
+		}
+		var gotCreateBody *string
+		releases.createFn = func(tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+			gotCreateBody = body
+			return testReleaseData(testReleaseId), nil
+		}
+		outputs := &fakeOutputs{}
+		config := defaultActionConfig()
