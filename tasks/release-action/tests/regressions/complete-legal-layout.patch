+		{"/home/~user/documents", "/home/~user/documents"},
+		{"~username/documents", "~username/documents"},
+		{"/absolute/path", "/absolute/path"},
+		{"relative/path", "relative/path"},
+	}
+	for _, testCase := range cases {
+		if got := expandTilde(testCase.input); got != testCase.want {
+			t.Fatalf("expandTilde(%q) = %q, want %q", testCase.input, got, testCase.want)
+		}
+	}
+}
