+
+		var patterns []string
+		globber := &stubGlobber{result: []string{file1}}
+		patternRecorder := &recordingGlobberAdapter{stub: globber, patterns: &patterns}
+		artifactGlobber := NewFileArtifactGlobberWith(patternRecorder)
