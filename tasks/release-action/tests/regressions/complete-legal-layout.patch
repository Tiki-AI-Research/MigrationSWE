+func uploaderArtifacts(t *testing.T, contentLength int) []Artifact {
+	t.Helper()
+	dir := t.TempDir()
+	aDir := filepath.Join(dir, "a")
+	bDir := filepath.Join(dir, "b")
+	if err := os.MkdirAll(aDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(bDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	art1 := filepath.Join(aDir, "art1")
+	art2 := filepath.Join(bDir, "art2")
+	if err := os.WriteFile(art1, make([]byte, contentLength), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(art2, make([]byte, contentLength), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return []Artifact{
+		NewArtifact(art1, "raw"),
+		NewArtifact(art2, "raw"),
+	}
+}
