+		action := newTestAction(t, config, releases, outputs, nil, nil, nil)
+
+		if err := action.Perform(); err != nil {
+			t.Fatal(err)
+		}
+		if gotGenTag != testTag || gotGenPrev != nil || gotGenCommit == nil || *gotGenCommit != testCommit {
+			t.Fatalf("gen notes args: %q %v %v", gotGenTag, gotGenPrev, gotGenCommit)
+		}
+		if gotCreateBody == nil || *gotCreateBody != testGeneratedNotes {
+			t.Fatalf("create body = %v", gotCreateBody)
+		}
+		assertReleaseOutput(t, outputs, testReleaseId)
