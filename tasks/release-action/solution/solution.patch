@@ -0,0 +1,41 @@
+package main
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+)
+
+// Artifact describes a single file to upload to a release.
+type Artifact struct {
+	ContentType string
+	Name        string
+	Path        string
+}
+
+// NewArtifact derives an artifact's name from its path and defaults an empty
+// content type to "raw".
+func NewArtifact(path string, contentType string) Artifact {
+	if contentType == "" {
+		contentType = "raw"
+	}
+	return Artifact{
+		Path:        path,
+		Name:        filepath.Base(path),
+		ContentType: contentType,
+	}
+}
+
+// ContentLength returns the size of the artifact in bytes.
+func (a Artifact) ContentLength() (int64, error) {
+	info, err := os.Stat(a.Path)
+	if err != nil {
+		return 0, err
+	}
+	return info.Size(), nil
+}
+
+// ReadFile opens the artifact for reading.
+func (a Artifact) ReadFile() (io.ReadCloser, error) {
+	return os.Open(a.Path)
+}
diff --git a/artifact_destroyer.go b/artifact_destroyer.go
new file mode 100644
index 0000000..a9cede3
--- /dev/null
+++ b/artifact_destroyer.go
@@ -0,0 +1,32 @@
+package main
+
+import "fmt"
+
+// ArtifactDestroyer removes existing release assets.
+type ArtifactDestroyer interface {
+	DestroyArtifacts(releaseId int64) error
+}
+
+// GithubArtifactDestroyer implements ArtifactDestroyer against Releases.
+type GithubArtifactDestroyer struct {
+	releases Releases
+}
+
+func NewGithubArtifactDestroyer(releases Releases) *GithubArtifactDestroyer {
+	return &GithubArtifactDestroyer{releases: releases}
+}
+
+func (d *GithubArtifactDestroyer) DestroyArtifacts(releaseId int64) error {
+	releaseAssets, err := d.releases.ListArtifactsForRelease(releaseId)
+	if err != nil {
+		return err
+	}
+
+	for _, artifact := range releaseAssets {
+		logDebug(fmt.Sprintf("Deleting existing artifact %s...", artifact.Name))
+		if err := d.releases.DeleteArtifact(artifact.ID); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/artifact_globber.go b/artifact_globber.go
new file mode 100644
index 0000000..4a83158
--- /dev/null
+++ b/artifact_globber.go
@@ -0,0 +1,366 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"unicode"
+
+	"github.com/bmatcuk/doublestar/v4"
+)
+
+// Globber resolves a glob pattern to a list of paths. It mirrors the Node glob
+// package's mark behaviour by returning directories as-is; the artifact
+// validator filters them out.
+type Globber interface {
+	Glob(pattern string) ([]string, error)
+}
+
+// FileGlobber is the filesystem backed Globber. It matches dotfiles the same
+// way as the Node glob default (dot: false) by ignoring hidden files.
+type FileGlobber struct{}
+
+func (FileGlobber) Glob(pattern string) ([]string, error) {
+	// Bracket expressions also need minimatch range and mixed-class semantics.
+	if strings.ContainsAny(pattern, "([{") {
+		return minimatchGlob(pattern)
+	}
+	paths, err := doublestar.FilepathGlob(translatePosixClasses(pattern), doublestar.WithNoHidden())
+	if errors.Is(err, doublestar.ErrBadPattern) {
+		// minimatch treats unfinished/empty bracket expressions as literals.
+		// Preserve that syntax instead of turning a valid artifact name or
+		// an ordinary no-match warning into an unconditional action failure.
+		return minimatchGlob(pattern)
+	}
+	return paths, err
+}
+
+// ArtifactGlobber expands an artifact input string into artifacts.
+type ArtifactGlobber interface {
+	GlobArtifactString(artifact string, contentType string, errorsFailBuild bool) ([]Artifact, error)
+}
+
+var artifactSplitPattern = regexp.MustCompile(`[,\n]`)
+
+// FileArtifactGlobber splits, normalizes, expands and globs artifact strings.
+type FileArtifactGlobber struct {
+	globber Globber
+}
+
+func NewFileArtifactGlobber() *FileArtifactGlobber {
+	return &FileArtifactGlobber{globber: FileGlobber{}}
+}
+
+func NewFileArtifactGlobberWith(globber Globber) *FileArtifactGlobber {
+	return &FileArtifactGlobber{globber: globber}
+}
+
+func (g *FileArtifactGlobber) GlobArtifactString(artifact string, contentType string, errorsFailBuild bool) ([]Artifact, error) {
+	result := []Artifact{}
+
+	for _, raw := range artifactSplitPattern.Split(artifact, -1) {
+		path := strings.TrimLeftFunc(raw, unicode.IsSpace)
+		path = normalizePath(path)
+		path = expandTilde(path)
+
+		paths, err := g.globPattern(path, errorsFailBuild)
+		if err != nil {
+			return nil, err
+		}
+
+		validated, err := validateArtifactPattern(errorsFailBuild, paths, path)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, matched := range validated {
+			result = append(result, NewArtifact(matched, contentType))
+		}
+	}
+
+	return result, nil
+}
+
+func (g *FileArtifactGlobber) globPattern(pattern string, errorsFailBuild bool) ([]string, error) {
+	paths, err := g.globber.Glob(pattern)
+	if err != nil {
+		return nil, err
+	}
+
+	if len(paths) == 0 {
+		message := fmt.Sprintf("Artifact pattern :%s did not match any files", pattern)
+		if errorsFailBuild {
+			return nil, errors.New(message)
+		}
+		logWarning(message)
+	}
+
+	return paths, nil
+}
+
+func validateArtifactPattern(errorsFailBuild bool, paths []string, pattern string) ([]string, error) {
+	validator := &ArtifactPathValidator{
+		errorsFailBuild: errorsFailBuild,
+		paths:           paths,
+		pattern:         pattern,
+	}
+	return validator.Validate()
+}
+
+// runeRange is an inclusive rune interval used to render a doublestar
+// character class from a POSIX named class.
+type runeRange struct {
+	lo rune
+	hi rune
+}
+
+func rangesOf(tables ...*unicode.RangeTable) []runeRange {
+	var ranges []runeRange
+	for _, table := range tables {
+		if table == nil {
+			continue
+		}
+		for _, item := range table.R16 {
+			ranges = appendRange(ranges, rune(item.Lo), rune(item.Hi), rune(item.Stride))
+		}
+		for _, item := range table.R32 {
+			ranges = appendRange(ranges, rune(item.Lo), rune(item.Hi), rune(item.Stride))
+		}
+	}
+	return normalizeRanges(ranges)
+}
+
+// appendRange expands one unicode table entry. Go's tables use a non-1 Stride
+// to compact sparse sets (for example Zs is [0x20,0xA0] with stride 0x80), so
+// the stride must be honoured or the set would wrongly include the runes in
+// between.
+func appendRange(ranges []runeRange, lo, hi, stride rune) []runeRange {
+	if stride <= 1 {
+		return append(ranges, runeRange{lo, hi})
+	}
+	for value := lo; value <= hi; value += stride {
+		ranges = append(ranges, runeRange{value, value})
+	}
+	return ranges
+}
+
+func literalRanges(runes ...rune) []runeRange {
+	ranges := make([]runeRange, 0, len(runes))
+	for _, item := range runes {
+		ranges = append(ranges, runeRange{item, item})
+	}
+	return normalizeRanges(ranges)
+}
+
+func unionRanges(parts ...[]runeRange) []runeRange {
+	var all []runeRange
+	for _, part := range parts {
+		all = append(all, part...)
+	}
+	return normalizeRanges(all)
+}
+
+func normalizeRanges(ranges []runeRange) []runeRange {
+	if len(ranges) == 0 {
+		return nil
+	}
+	sorted := append([]runeRange(nil), ranges...)
+	sort.Slice(sorted, func(i, j int) bool {
+		if sorted[i].lo == sorted[j].lo {
+			return sorted[i].hi < sorted[j].hi
+		}
+		return sorted[i].lo < sorted[j].lo
+	})
+	result := []runeRange{sorted[0]}
+	for _, item := range sorted[1:] {
+		last := &result[len(result)-1]
+		if item.lo <= last.hi+1 {
+			if item.hi > last.hi {
+				last.hi = item.hi
+			}
+			continue
+		}
+		result = append(result, item)
+	}
+	return result
+}
+
+// complementRanges returns every Unicode code point outside ranges.
+func complementRanges(ranges []runeRange) []runeRange {
+	normalized := normalizeRanges(ranges)
+	var result []runeRange
+	next := rune(0)
+	for _, item := range normalized {
+		if item.lo > next {
+			result = append(result, runeRange{next, item.lo - 1})
+		}
+		if item.hi+1 > next {
+			next = item.hi + 1
+		}
+	}
+	if next <= unicode.MaxRune {
+		result = append(result, runeRange{next, unicode.MaxRune})
+	}
+	return result
+}
+
+func isClassSpecial(r rune) bool {
+	switch r {
+	case '\\', ']', '-', '^', '[', '!':
+		return true
+	}
+	return false
+}
+
+func escapeClassRune(r rune) string {
+	if isClassSpecial(r) {
+		return "\\" + string(r)
+	}
+	return string(r)
+}
+
+func renderClassBody(ranges []runeRange) string {
+	var builder strings.Builder
+	for _, item := range ranges {
+		for x := item.lo; x <= item.hi; {
+			if isClassSpecial(x) {
+				builder.WriteString(escapeClassRune(x))
+				if x == item.hi {
+					break
+				}
+				x++
+				continue
+			}
+			start := x
+			for x <= item.hi && !isClassSpecial(x) {
+				x++
+			}
+			end := x - 1
+			if start == end {
+				builder.WriteRune(start)
+			} else {
+				builder.WriteRune(start)
+				builder.WriteByte('-')
+				builder.WriteRune(end)
+			}
+		}
+	}
+	return builder.String()
+}
+
+// posixClassRanges reproduces the Unicode-property translation minimatch uses
+// for POSIX named classes. A returned factory yields the rune ranges that make
+// up the class so the pattern can be rewritten to an equivalent doublestar
+// character class.
+var posixClassRanges = map[string]func() []runeRange{
+	"alnum": func() []runeRange { return rangesOf(unicode.L, unicode.Nl, unicode.Nd) },
+	"alpha": func() []runeRange { return rangesOf(unicode.L, unicode.Nl) },
+	"ascii": func() []runeRange { return []runeRange{{0x00, 0x7f}} },
+	"blank": func() []runeRange { return unionRanges(rangesOf(unicode.Zs), literalRanges('\t')) },
+	"cntrl": func() []runeRange { return rangesOf(unicode.Cc) },
+	"digit": func() []runeRange { return rangesOf(unicode.Nd) },
+	"graph": func() []runeRange { return complementRanges(unionRanges(rangesOf(unicode.Z), rangesOf(unicode.C))) },
+	"lower": func() []runeRange { return rangesOf(unicode.Ll) },
+	// minimatch (v10.2.5) translates [:print:] to the bare \p{C} property
+	// *without* the negated flag, so its observable behaviour is "matches
+	// Other/control" rather than the POSIX complement. Preserve that quirk.
+	"print": func() []runeRange { return rangesOf(unicode.C) },
+	"punct": func() []runeRange { return rangesOf(unicode.P) },
+	"space": func() []runeRange {
+		return unionRanges(rangesOf(unicode.Z), literalRanges('\t', '\n', '\v', '\f', '\r'))
+	},
+	"upper":  func() []runeRange { return rangesOf(unicode.Lu) },
+	"word":   func() []runeRange { return rangesOf(unicode.L, unicode.Nl, unicode.Nd, unicode.Pc) },
+	"xdigit": func() []runeRange { return []runeRange{{'0', '9'}, {'A', 'F'}, {'a', 'f'}} },
+}
+
+func expandPosixClass(name string) (string, bool) {
+	factory, ok := posixClassRanges[name]
+	if !ok {
+		return "", false
+	}
+	return renderClassBody(factory()), true
+}
+
+// translatePosixClasses rewrites every POSIX named class (for example
+// “[[:digit:]]“ or “[![:alpha:]]“) into an equivalent doublestar
+// character class so path matching preserves the minimatch public behavior.
+// Patterns without a POSIX class are returned unchanged.
+func translatePosixClasses(pattern string) string {
+	if !strings.Contains(pattern, "[:") {
+		return pattern
+	}
+	return rewriteBracketClasses(pattern)
+}
+
+func rewriteBracketClasses(pattern string) string {
+	var out strings.Builder
+	for i := 0; i < len(pattern); {
+		if pattern[i] != '[' {
+			out.WriteByte(pattern[i])
+			i++
+			continue
+		}
+		j := i + 1
+		if j < len(pattern) && (pattern[j] == '!' || pattern[j] == '^') {
+			j++
+		}
+		start := j
+		if j < len(pattern) && pattern[j] == ']' {
+			j++
+		}
+		for j < len(pattern) {
+			if strings.HasPrefix(pattern[j:], "[:") {
+				if end := strings.Index(pattern[j+2:], ":]"); end >= 0 {
+					j = j + 2 + end + 2
+					continue
+				}
+			}
+			if pattern[j] == ']' {
+				break
+			}
+			j++
+		}
+		if j >= len(pattern) {
+			out.WriteByte(pattern[i])
+			i++
+			continue
+		}
+		rewritten, changed := rewriteClassContent(pattern[start:j])
+		if !changed {
+			out.WriteString(pattern[i : j+1])
+		} else {
+			out.WriteByte('[')
+			if start > i+1 {
+				out.WriteByte(pattern[i+1])
+			}
+			out.WriteString(rewritten)
+			out.WriteByte(']')
+		}
+		i = j + 1
+	}
+	return out.String()
+}
+
+func rewriteClassContent(content string) (string, bool) {
+	var out strings.Builder
+	changed := false
+	for k := 0; k < len(content); {
+		if strings.HasPrefix(content[k:], "[:") {
+			if end := strings.Index(content[k+2:], ":]"); end >= 0 {
+				name := content[k+2 : k+2+end]
+				if body, ok := expandPosixClass(name); ok {
+					out.WriteString(body)
+					k = k + 2 + end + 2
+					changed = true
+					continue
+				}
+			}
+		}
+		out.WriteByte(content[k])
+		k++
+	}
+	return out.String(), changed
+}
