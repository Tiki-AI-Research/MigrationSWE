+		releases = newTestReleases()
+	}
+	if outputs == nil {
+		outputs = &fakeOutputs{}
+	}
+	if uploader == nil {
+		uploader = &fakeUploader{fn: func([]Artifact, int64, string) (map[string]string, error) {
+			return testAssetURLs(), nil
+		}}
+	}
+	if destroyer == nil {
+		destroyer = &fakeDestroyer{}
+	}
+	if skipper == nil {
+		skipper = &fakeSkipper{}
+	}
+	return NewAction(buildInputs(config), outputs, releases, uploader, destroyer, skipper)
+}
