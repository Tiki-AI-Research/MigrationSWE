new file mode 100644
index 0000000..4e6a31a
--- /dev/null
+++ b/inputs.go
@@ -0,0 +1,311 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+)
+
+const tagRefPrefix = "refs/tags/"
+
+// InputGetter reads action inputs. It mirrors @actions/core.
+type InputGetter interface {
+	GetInput(name string) string
+	GetBooleanInput(name string) (bool, error)
+}
+
+// EnvInputGetter reads inputs from INPUT_* environment variables.
+type EnvInputGetter struct{}
+
+func envInputName(name string) string {
+	return "INPUT_" + strings.ToUpper(strings.ReplaceAll(name, " ", "_"))
+}
+
+func (EnvInputGetter) GetInput(name string) string {
+	return strings.TrimSpace(os.Getenv(envInputName(name)))
+}
+
+func (EnvInputGetter) GetBooleanInput(name string) (bool, error) {
+	value := strings.TrimSpace(os.Getenv(envInputName(name)))
+	switch value {
+	case "true", "True", "TRUE":
+		return true, nil
+	case "false", "False", "FALSE":
+		return false, nil
+	}
+	return false, fmt.Errorf("Input does not meet YAML 1.2 \"Core Schema\" specification: %s", name)
+}
+
+// ActionContext carries the workflow context the inputs resolve against.
+type ActionContext struct {
+	Ref   string
+	Owner string
+	Repo  string
+}
+
+// LoadContext derives the context from GITHUB_REF and GITHUB_REPOSITORY.
+func LoadContext() ActionContext {
+	ref := os.Getenv("GITHUB_REF")
+
+	full := os.Getenv("GITHUB_REPOSITORY")
+	owner := ""
+	repo := ""
+	if idx := strings.Index(full, "/"); idx >= 0 {
+		owner = full[:idx]
+		repo = full[idx+1:]
+	} else {
+		owner = full
+	}
+
+	return ActionContext{Ref: ref, Owner: owner, Repo: repo}
+}
+
+// Inputs is the fully resolved input set consumed by the action.
+type Inputs struct {
+	AllowUpdates                    bool
+	ArtifactErrorsFailBuild         bool
+	Artifacts                       []Artifact
+	Commit                          *string
+	CreatedDraft                    bool
+	CreatedPrerelease               bool
+	CreatedReleaseBody              *string
+	CreatedReleaseName              *string
+	DiscussionCategory              *string
+	GenerateReleaseNotes            bool
+	GenerateReleaseNotesPreviousTag *string
+	ImmutableCreate                 bool
+	MakeLatest                      *string
+	OmitBodyDuringUpdate            bool
+	Owner                           string
+	RemoveArtifacts                 bool
+	ReplacesArtifacts               bool
+	Repo                            string
+	SkipIfReleaseExists             bool
+	Tag                             string
+	Token                           string
+	UpdatedDraft                    *bool
+	UpdatedPrerelease               *bool
+	UpdatedReleaseBody              *string
+	UpdatedReleaseName              *string
+	UpdateOnlyUnreleased            bool
+
+	// File inputs are evaluated only when the selected operation needs them.
+	prepareBody      func(isUpdate bool) error
+	prepareArtifacts func() error
+}
+
+// LoadInputs eagerly resolves inputs for callers that need a snapshot.
+func LoadInputs(getter InputGetter, globber ArtifactGlobber, context ActionContext) (*Inputs, error) {
+	return loadActionInputs(getter, globber, context, false)
+}
+
+// The action defers file reads/globbing until after skipping and release
+// selection, just as the original lazy input getters do.
+func loadActionInputs(getter InputGetter, globber ArtifactGlobber, context ActionContext, deferFiles bool) (*Inputs, error) {
+	inputs := &Inputs{}
+
+	inputs.AllowUpdates = getter.GetInput("allowUpdates") == "true"
+	inputs.ArtifactErrorsFailBuild = getter.GetInput("artifactErrorsFailBuild") == "true"
+	inputs.CreatedDraft = getter.GetInput("draft") == "true"
+	inputs.CreatedPrerelease = getter.GetInput("prerelease") == "true"
+	inputs.GenerateReleaseNotes = getter.GetInput("generateReleaseNotes") == "true"
+	inputs.ImmutableCreate = getter.GetInput("immutableCreate") == "true"
+	inputs.RemoveArtifacts = getter.GetInput("removeArtifacts") == "true"
+	inputs.ReplacesArtifacts = getter.GetInput("replacesArtifacts") == "true"
+	inputs.UpdateOnlyUnreleased = getter.GetInput("updateOnlyUnreleased") == "true"
+	inputs.OmitBodyDuringUpdate = getter.GetInput("omitBodyDuringUpdate") == "true"
+
+	tag, err := resolveTag(getter, context)
+	if err != nil {
+		return nil, err
+	}
+	inputs.Tag = tag
+
+	name := getter.GetInput("name")
+	if name == "" {
+		name = tag
+	}
+
+	var body *string
+	if !deferFiles {
+		body, err = resolveBody(getter)
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	omitBody := getter.GetInput("omitBody") == "true"
+	omitName := getter.GetInput("omitName") == "true"
+	omitBodyDuringUpdate := getter.GetInput("omitBodyDuringUpdate") == "true"
+	omitNameDuringUpdate := getter.GetInput("omitNameDuringUpdate") == "true"
+	omitDraftDuringUpdate := getter.GetInput("omitDraftDuringUpdate") == "true"
+	omitPrereleaseDuringUpdate := getter.GetInput("omitPrereleaseDuringUpdate") == "true"
+
+	inputs.CreatedReleaseBody = body
+	if omitBody {
+		inputs.CreatedReleaseBody = nil
+	}
+
+	createdReleaseName := name
+	inputs.CreatedReleaseName = &createdReleaseName
+	if omitName {
+		inputs.CreatedReleaseName = nil
+	}
+
+	inputs.UpdatedReleaseBody = body
+	if omitBody || omitBodyDuringUpdate {
+		inputs.UpdatedReleaseBody = nil
+	}
+
+	updatedReleaseName := name
+	inputs.UpdatedReleaseName = &updatedReleaseName
+	if omitName || omitNameDuringUpdate {
+		inputs.UpdatedReleaseName = nil
+	}
+
+	createdDraft := inputs.CreatedDraft
+	inputs.UpdatedDraft = &createdDraft
+	if omitDraftDuringUpdate {
+		inputs.UpdatedDraft = nil
+	}
+
+	createdPrerelease := inputs.CreatedPrerelease
+	inputs.UpdatedPrerelease = &createdPrerelease
+	if omitPrereleaseDuringUpdate {
+		inputs.UpdatedPrerelease = nil
+	}
+
+	inputs.Commit = optionalInput(getter, "commit")
+	inputs.DiscussionCategory = optionalInput(getter, "discussionCategory")
+	inputs.GenerateReleaseNotesPreviousTag = optionalInput(getter, "generateReleaseNotesPreviousTag")
+	inputs.MakeLatest = makeLatestInput(getter)
+
+	owner := getter.GetInput("owner")
+	if owner == "" {
+		owner = context.Owner
+	}
+	inputs.Owner = owner
+
+	repo := getter.GetInput("repo")
+	if repo == "" {
+		repo = context.Repo
+	}
+	inputs.Repo = repo
+
+	skip, err := getter.GetBooleanInput("skipIfReleaseExists")
+	if err != nil {
+		return nil, err
+	}
+	inputs.SkipIfReleaseExists = skip
+
+	token := getter.GetInput("token")
+	if token == "" {
+		return nil, errors.New("Input required and not supplied: token")
+	}
+	inputs.Token = token
+
+	if deferFiles {
+		inputs.prepareBody = func(isUpdate bool) error {
+			if omitBody || (isUpdate && omitBodyDuringUpdate) {
+				return nil
+			}
+			resolved, err := resolveBody(getter)
+			if err != nil {
+				return err
+			}
+			if isUpdate {
+				inputs.UpdatedReleaseBody = resolved
+			} else {
+				inputs.CreatedReleaseBody = resolved
+			}
+			return nil
+		}
+		inputs.prepareArtifacts = func() error {
+			artifacts, err := resolveArtifacts(getter, globber, inputs.ArtifactErrorsFailBuild)
+			if err != nil {
+				return err
+			}
+			inputs.Artifacts = artifacts
+			return nil
+		}
+		return inputs, nil
+	}
+
+	artifacts, err := resolveArtifacts(getter, globber, inputs.ArtifactErrorsFailBuild)
+	if err != nil {
+		return nil, err
+	}
+	inputs.Artifacts = artifacts
+
+	return inputs, nil
+}
+
+func resolveTag(getter InputGetter, context ActionContext) (string, error) {
+	tag := getter.GetInput("tag")
+	if tag != "" {
+		return tag, nil
+	}
+
+	if strings.HasPrefix(context.Ref, tagRefPrefix) && len(context.Ref) > len(tagRefPrefix) {
+		return context.Ref[len(tagRefPrefix):], nil
+	}
+
+	return "", errors.New("No tag found in ref or input!")
+}
+
+func resolveBody(getter InputGetter) (*string, error) {
+	body := getter.GetInput("body")
+	if body != "" {
+		return &body, nil
+	}
+
+	bodyFile := getter.GetInput("bodyFile")
+	if bodyFile != "" {
+		data, err := os.ReadFile(bodyFile)
+		if err != nil {
+			return nil, err
+		}
+		contents := string(data)
+		return &contents, nil
+	}
+
+	empty := ""
+	return &empty, nil
+}
+
+func resolveArtifacts(getter InputGetter, globber ArtifactGlobber, errorsFailBuild bool) ([]Artifact, error) {
+	artifacts := getter.GetInput("artifacts")
+	if artifacts == "" {
+		artifacts = getter.GetInput("artifact")
+	}
+
+	if artifacts == "" {
+		return []Artifact{}, nil
+	}
+
+	contentType := getter.GetInput("artifactContentType")
+	if contentType == "" {
+		contentType = "raw"
+	}
+
+	return globber.GlobArtifactString(artifacts, contentType, errorsFailBuild)
+}
+
+func optionalInput(getter InputGetter, name string) *string {
+	value := getter.GetInput(name)
+	if value == "" {
+		return nil
+	}
+	return &value
+}
+
+func makeLatestInput(getter InputGetter) *string {
+	value := getter.GetInput("makeLatest")
+	switch value {
+	case "legacy", "true", "false":
+		return &value
+	default:
+		return nil
+	}
+}
diff --git a/logger.go b/logger.go
new file mode 100644
index 0000000..2c3281b
--- /dev/null
+++ b/logger.go
@@ -0,0 +1,21 @@
+package main
+
+import (
+	"fmt"
+	"os"
+)
+
+// Workflow command loggers. They mirror the @actions/core functions so the
+// migrated action keeps emitting the same diagnostics. They are variables so
+// tests can capture output.
+var (
+	logDebug = func(message string) {
+		fmt.Fprintf(os.Stderr, "::debug::%s\n", message)
+	}
+	logWarning = func(message string) {
+		fmt.Fprintf(os.Stderr, "::warning::%s\n", message)
+	}
+	logNotice = func(message string) {
+		fmt.Fprintf(os.Stderr, "::notice::%s\n", message)
+	}
+)
