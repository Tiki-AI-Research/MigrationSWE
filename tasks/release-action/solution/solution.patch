+package main
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"testing"
+)
+
+func TestExtendedArtifactGlob(t *testing.T) {
+	dir := t.TempDir()
+	for _, name := range []string{"a.zip", "ab.zip", "b.zip", "é.zip", "1.zip", "2.zip", "3.zip", ".hidden.zip"} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(name), 0600); err != nil {
+			t.Fatal(err)
+		}
