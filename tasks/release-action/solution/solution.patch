+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// ReleaseData is the subset of a GitHub release used by the action.
+type ReleaseData struct {
+	ID         int64   `json:"id"`
+	HTMLURL    string  `json:"html_url"`
+	UploadURL  string  `json:"upload_url"`
+	TarballURL *string `json:"tarball_url"`
+	ZipballURL *string `json:"zipball_url"`
+	Draft      bool    `json:"draft"`
+	Prerelease bool    `json:"prerelease"`
+	Name       *string `json:"name"`
+	TagName    string  `json:"tag_name"`
+}
+
+// ReleaseAsset is the subset of a release asset used by the action.
+type ReleaseAsset struct {
+	ID                 int64  `json:"id"`
+	Name               string `json:"name"`
+	BrowserDownloadURL string `json:"browser_download_url"`
+}
+
+// GenerateReleaseNotesResponse carries generated release notes.
+type GenerateReleaseNotesResponse struct {
+	Body string `json:"body"`
+}
+
+// ListReleasesResponse distinguishes an absent data field from an empty list,
+// matching the baseline "No releases found" check.
+type ListReleasesResponse struct {
+	Data *[]ReleaseData `json:"data,omitempty"`
+}
+
+// UploadArtifactResponse carries the uploaded asset location.
+type UploadArtifactResponse struct {
+	BrowserDownloadURL string `json:"browser_download_url"`
+}
+
+// Releases is the GitHub REST client contract used by the action.
+type Releases interface {
+	Create(tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error)
+	Update(id int64, tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error)
+	GetByTag(tag string) (*ReleaseData, error)
+	GenerateReleaseNotes(tag string, previousTag *string, targetCommitish *string) (GenerateReleaseNotesResponse, error)
+	ListReleases() (*ListReleasesResponse, error)
+	ListArtifactsForRelease(releaseId int64) ([]ReleaseAsset, error)
+	DeleteArtifact(assetId int64) error
+	UploadArtifact(assetUrl string, contentLength int64, contentType string, file io.Reader, name string, releaseId int64) (UploadArtifactResponse, error)
+}
+
+// GithubReleases implements Releases against the GitHub REST API.
+type GithubReleases struct {
+	owner   string
+	repo    string
+	token   string
+	baseURL string
+	client  *http.Client
+}
+
+func NewGithubReleases(inputs *Inputs) *GithubReleases {
+	return NewGithubReleasesWithClient(inputs, http.DefaultClient)
+}
+
+func NewGithubReleasesWithClient(inputs *Inputs, client *http.Client) *GithubReleases {
+	baseURL := os.Getenv("GITHUB_API_URL")
+	if baseURL == "" {
+		baseURL = "https://api.github.com"
+	}
+	baseURL = strings.TrimRight(baseURL, "/")
+
+	return &GithubReleases{
+		owner:   inputs.Owner,
+		repo:    inputs.Repo,
+		token:   inputs.Token,
+		baseURL: baseURL,
+		client:  client,
+	}
+}
+
+func (g *GithubReleases) Create(tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+	payload := releasePayload(tag, body, commitHash, discussionCategory, draft, makeLatest, name, prerelease)
+	var release ReleaseData
+	err := g.request(http.MethodPost, g.repoURL("releases"), payload, &release)
+	return release, err
+}
+
+func (g *GithubReleases) Update(id int64, tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) (ReleaseData, error) {
+	payload := releasePayload(tag, body, commitHash, discussionCategory, draft, makeLatest, name, prerelease)
+	var release ReleaseData
+	err := g.request(http.MethodPatch, g.repoURL("releases", strconv.FormatInt(id, 10)), payload, &release)
+	return release, err
+}
+
+func (g *GithubReleases) GetByTag(tag string) (*ReleaseData, error) {
+	var release ReleaseData
+	err := g.request(http.MethodGet, g.repoURL("releases", "tags", url.PathEscape(tag)), nil, &release)
+	if err != nil {
+		return nil, err
+	}
+	return &release, nil
+}
+
+func (g *GithubReleases) GenerateReleaseNotes(tag string, previousTag *string, targetCommitish *string) (GenerateReleaseNotesResponse, error) {
+	payload := map[string]any{"tag_name": tag}
+	if previousTag != nil {
+		payload["previous_tag_name"] = *previousTag
+	}
+	if targetCommitish != nil {
+		payload["target_commitish"] = *targetCommitish
+	}
+
+	var response GenerateReleaseNotesResponse
+	err := g.request(http.MethodPost, g.repoURL("releases", "generate-notes"), payload, &response)
+	return response, err
+}
+
+func (g *GithubReleases) ListReleases() (*ListReleasesResponse, error) {
+	var releases []ReleaseData
+	err := g.request(http.MethodGet, g.repoURL("releases"), nil, &releases)
+	if err != nil {
+		return nil, err
+	}
+	return &ListReleasesResponse{Data: &releases}, nil
+}
+
+func (g *GithubReleases) ListArtifactsForRelease(releaseId int64) ([]ReleaseAsset, error) {
+	const perPage = 100
+	assets := []ReleaseAsset{}
+	for page := 1; ; page++ {
+		query := url.Values{}
+		query.Set("per_page", strconv.Itoa(perPage))
+		query.Set("page", strconv.Itoa(page))
+
+		var pageAssets []ReleaseAsset
+		path := g.repoURL("releases", strconv.FormatInt(releaseId, 10), "assets") + "?" + query.Encode()
+		if err := g.request(http.MethodGet, path, nil, &pageAssets); err != nil {
+			return nil, err
+		}
+		assets = append(assets, pageAssets...)
+		if len(pageAssets) < perPage {
+			break
+		}
+	}
+	return assets, nil
+}
+
+func (g *GithubReleases) DeleteArtifact(assetId int64) error {
+	return g.request(http.MethodDelete, g.repoURL("releases", "assets", strconv.FormatInt(assetId, 10)), nil, nil)
+}
+
+func (g *GithubReleases) UploadArtifact(assetUrl string, contentLength int64, contentType string, file io.Reader, name string, releaseId int64) (UploadArtifactResponse, error) {
+	requestURL := assetUploadURL(assetUrl, name)
+
+	req, err := http.NewRequest(http.MethodPost, requestURL, file)
+	if err != nil {
+		return UploadArtifactResponse{}, err
+	}
+	g.applyHeaders(req)
+	req.Header.Set("content-type", contentType)
+	req.ContentLength = contentLength
+	if contentLength == 0 {
+		// A non-nil body with length zero means unknown length to net/http.
+		// Use NoBody so empty artifacts carry Content-Length: 0 on the wire.
+		req.Body = http.NoBody
+	}
+
+	resp, err := g.client.Do(req)
+	if err != nil {
+		return UploadArtifactResponse{}, err
+	}
+	defer resp.Body.Close()
+
+	data, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return UploadArtifactResponse{}, err
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return UploadArtifactResponse{}, parseGithubError(resp.StatusCode, data)
+	}
+
+	var uploaded UploadArtifactResponse
+	if len(data) > 0 {
+		if err := json.Unmarshal(data, &uploaded); err != nil {
+			return UploadArtifactResponse{}, err
+		}
+	}
+	return uploaded, nil
+}
+
+func (g *GithubReleases) repoURL(segments ...string) string {
+	parts := append([]string{g.baseURL, "repos", g.owner, g.repo}, segments...)
+	return strings.Join(parts, "/")
+}
+
+func (g *GithubReleases) request(method string, requestURL string, payload any, out any) error {
+	var body io.Reader
+	if payload != nil {
+		encoded, err := json.Marshal(payload)
+		if err != nil {
+			return err
+		}
+		body = bytes.NewReader(encoded)
+	}
+
+	req, err := http.NewRequest(method, requestURL, body)
+	if err != nil {
+		return err
+	}
+	g.applyHeaders(req)
+	if payload != nil {
+		req.Header.Set("content-type", "application/json")
+	}
+
+	resp, err := g.client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+
+	data, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return err
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return parseGithubError(resp.StatusCode, data)
+	}
+
+	if out != nil && len(data) > 0 {
+		if err := json.Unmarshal(data, out); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (g *GithubReleases) applyHeaders(req *http.Request) {
+	req.Header.Set("authorization", "token "+g.token)
+	req.Header.Set("accept", "application/vnd.github+json")
+	req.Header.Set("x-github-api-version", "2022-11-28")
+	req.Header.Set("user-agent", "release-action")
+}
+
+func releasePayload(tag string, body *string, commitHash *string, discussionCategory *string, draft *bool, makeLatest *string, name *string, prerelease *bool) map[string]any {
+	payload := map[string]any{"tag_name": tag}
+	if body != nil {
+		payload["body"] = *body
+	}
+	if commitHash != nil {
+		payload["target_commitish"] = *commitHash
+	}
+	if discussionCategory != nil {
+		payload["discussion_category_name"] = *discussionCategory
+	}
+	if draft != nil {
+		payload["draft"] = *draft
+	}
+	if makeLatest != nil {
+		payload["make_latest"] = *makeLatest
+	}
+	if name != nil {
+		payload["name"] = *name
+	}
+	if prerelease != nil {
+		payload["prerelease"] = *prerelease
+	}
+	return payload
+}
+
+func assetUploadURL(assetUrl string, name string) string {
+	base := assetUrl
+	if idx := strings.Index(base, "{"); idx >= 0 {
+		base = base[:idx]
+	}
+
+	parsed, err := url.Parse(base)
+	if err != nil {
+		return base
+	}
+
+	query := parsed.Query()
+	query.Set("name", name)
+	parsed.RawQuery = query.Encode()
+	return parsed.String()
+}
+
+func parseGithubError(status int, data []byte) *GithubError {
+	var payload struct {
+		Message          string              `json:"message"`
+		Errors           []GithubErrorDetail `json:"errors"`
+		DocumentationURL string              `json:"documentation_url"`
+	}
+	if len(data) > 0 {
+		_ = json.Unmarshal(data, &payload)
+	}
+
+	return &GithubError{
+		Status:  status,
+		Message: payload.Message,
+		Errors:  payload.Errors,
+	}
+}
+
+// statusCodeOf reports whether an error carries an HTTP status.
+func statusCodeOf(err error) (int, bool) {
+	var sc interface{ StatusCode() int }
+	if errors.As(err, &sc) {
+		return sc.StatusCode(), true
+	}
+	return 0, false
+}
+
+// errorMessageOf returns the raw message of a status error when available.
+func errorMessageOf(err error) string {
+	var m interface{ ErrorMessage() string }
+	if errors.As(err, &m) {
+		return m.ErrorMessage()
+	}
+	return err.Error()
+}
