+func TestOutputs(t *testing.T) {
+	outputs := map[string]string{}
+	setOutput := func(name, value string) { outputs[name] = value }
+
+	coreOutputs := NewCoreOutputsWith(setOutput)
+	releaseData := ReleaseData{
+		ID:         1,
+		HTMLURL:    "https://api.example.com/assets",
+		UploadURL:  "https://api.example.com",
+		TarballURL: strPtr("https://api.example.com/tarball"),
+		ZipballURL: strPtr("https://api.example.com/zipball"),
+	}
+	coreOutputs.ApplyReleaseData(releaseData)
+
+	if outputs["id"] != "1" {
+		t.Fatalf("id = %q", outputs["id"])
+	}
+	if outputs["html_url"] != releaseData.HTMLURL || outputs["upload_url"] != releaseData.UploadURL {
+		t.Fatalf("urls = %+v", outputs)
+	}
+	if outputs["tarball_url"] != *releaseData.TarballURL || outputs["zipball_url"] != *releaseData.ZipballURL {
+		t.Fatalf("ball urls = %+v", outputs)
+	}
+
+	coreOutputs.ApplyReleaseData(ReleaseData{ID: 2, TarballURL: nil, ZipballURL: nil})
+	if outputs["tarball_url"] != "" || outputs["zipball_url"] != "" {
+		t.Fatalf("expected empty fallbacks, got %+v", outputs)
+	}
+
+	assetUrls := map[string]string{
+		"example.zip":    "https://github.com/owner/repo/releases/download/v1.0.0/example.zip",
+		"example.tar.gz": "https://github.com/owner/repo/releases/download/v1.0.0/example.tar.gz",
+	}
+	coreOutputs.ApplyAssetUrls(assetUrls)
+
+	var decoded map[string]string
+	if err := json.Unmarshal([]byte(outputs["assets"]), &decoded); err != nil {
+		t.Fatalf("assets not valid json: %v", err)
+	}
+	if !reflect.DeepEqual(decoded, assetUrls) {
+		t.Fatalf("assets = %v", decoded)
+	}
+
+	coreOutputs.ApplyAssetUrls(map[string]string{})
+	if outputs["assets"] != "{}" {
+		t.Fatalf("expected {}, got %q", outputs["assets"])
+	}
+}
