+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+// ---------------------------------------------------------------------------
+// Test helpers
+// ---------------------------------------------------------------------------
+
+type mapInputGetter struct {
+	values  map[string]string
+	bools   map[string]bool
+	boolErr map[string]error
+}
+
+func (m *mapInputGetter) GetInput(name string) string {
+	return m.values[name]
+}
+
+func (m *mapInputGetter) GetBooleanInput(name string) (bool, error) {
+	if err, ok := m.boolErr[name]; ok {
+		return false, err
+	}
+	return m.bools[name], nil
+}
+
+type globCall struct {
+	artifact        string
+	contentType     string
+	errorsFailBuild bool
+}
+
+type recordingGlobber struct {
+	calls  []globCall
+	result []Artifact
+	err    error
+}
+
+func (g *recordingGlobber) GlobArtifactString(artifact string, contentType string, errorsFailBuild bool) ([]Artifact, error) {
+	g.calls = append(g.calls, globCall{artifact, contentType, errorsFailBuild})
+	return g.result, g.err
+}
+
+type stubGlobber struct {
+	result      []string
+	err         error
+	lastPattern string
+}
+
+func (g *stubGlobber) Glob(pattern string) ([]string, error) {
+	g.lastPattern = pattern
+	return g.result, g.err
+}
+
+func captureWarnings(t *testing.T) *[]string {
+	t.Helper()
+	messages := &[]string{}
+	original := logWarning
+	logWarning = func(message string) {
+		*messages = append(*messages, message)
+	}
+	t.Cleanup(func() { logWarning = original })
+	return messages
+}
+
+func captureNotices(t *testing.T) *[]string {
+	t.Helper()
+	messages := &[]string{}
+	original := logNotice
+	logNotice = func(message string) {
+		*messages = append(*messages, message)
+	}
+	t.Cleanup(func() { logNotice = original })
+	return messages
+}
+
+func strPtr(value string) *string { return &value }
+func boolPtr(value bool) *bool    { return &value }
+
+func loadInputs(t *testing.T, values map[string]string, bools map[string]bool, context ActionContext, globber ArtifactGlobber) (*Inputs, error) {
+	t.Helper()
+	if globber == nil {
+		globber = &recordingGlobber{result: []Artifact{}}
+	}
+	merged := map[string]string{"token": "token"}
+	for key, value := range values {
+		merged[key] = value
+	}
+	return LoadInputs(&mapInputGetter{values: merged, bools: bools}, globber, context)
+}
+
+func mustLoadInputs(t *testing.T, values map[string]string, context ActionContext, globber ArtifactGlobber) *Inputs {
+	t.Helper()
+	inputs, err := loadInputs(t, values, nil, context, globber)
+	if err != nil {
+		t.Fatalf("LoadInputs returned error: %v", err)
+	}
+	return inputs
+}
+
+func defaultContext() ActionContext {
+	return ActionContext{Ref: "refs/tags/sha-tag", Owner: "contextOwner", Repo: "contextRepo"}
+}
+
+// ---------------------------------------------------------------------------
+// Inputs
+// ---------------------------------------------------------------------------
+
+func TestInputsTag(t *testing.T) {
+	t.Run("returns input tag", func(t *testing.T) {
+		inputs := mustLoadInputs(t, map[string]string{"tag": "tag"}, defaultContext(), nil)
+		if inputs.Tag != "tag" {
+			t.Fatalf("got %q", inputs.Tag)
+		}
+	})
+
+	t.Run("returns context tag when input empty", func(t *testing.T) {
+		inputs := mustLoadInputs(t, map[string]string{}, defaultContext(), nil)
+		if inputs.Tag != "sha-tag" {
+			t.Fatalf("got %q", inputs.Tag)
+		}
+	})
+
+	t.Run("throws if no tag", func(t *testing.T) {
+		_, err := loadInputs(t, map[string]string{}, nil, ActionContext{}, nil)
+		if err == nil || err.Error() != "No tag found in ref or input!" {
+			t.Fatalf("got err %v", err)
+		}
+	})
+}
+
+func TestInputsToken(t *testing.T) {
+	_, err := LoadInputs(&mapInputGetter{values: map[string]string{}}, &recordingGlobber{}, defaultContext())
+	if err == nil {
+		t.Fatal("expected required token error")
+	}
+}
+
+func TestInputsCommit(t *testing.T) {
+	inputs := mustLoadInputs(t, map[string]string{"commit": "commit"}, defaultContext(), nil)
+	if inputs.Commit == nil || *inputs.Commit != "commit" {
+		t.Fatalf("got %v", inputs.Commit)
+	}
+
+	inputs = mustLoadInputs(t, map[string]string{}, defaultContext(), nil)
+	if inputs.Commit != nil {
+		t.Fatalf("expected nil, got %v", *inputs.Commit)
+	}
+}
+
+func TestInputsBooleans(t *testing.T) {
+	allTrue := map[string]string{
+		"allowUpdates":            "true",
+		"artifactErrorsFailBuild": "true",
+		"draft":                   "true",
+		"prerelease":              "true",
+		"generateReleaseNotes":    "true",
+		"immutableCreate":         "true",
+		"removeArtifacts":         "true",
+		"replacesArtifacts":       "true",
+		"updateOnlyUnreleased":    "true",
+		"omitBodyDuringUpdate":    "true",
+	}
+	inputs := mustLoadInputs(t, allTrue, defaultContext(), nil)
+	if !inputs.AllowUpdates || !inputs.ArtifactErrorsFailBuild || !inputs.CreatedDraft || !inputs.CreatedPrerelease ||
+		!inputs.GenerateReleaseNotes || !inputs.ImmutableCreate || !inputs.RemoveArtifacts || !inputs.ReplacesArtifacts ||
+		!inputs.UpdateOnlyUnreleased || !inputs.OmitBodyDuringUpdate {
+		t.Fatalf("expected all boolean inputs true: %+v", inputs)
+	}
+
+	inputs = mustLoadInputs(t, map[string]string{}, defaultContext(), nil)
+	if inputs.AllowUpdates || inputs.ArtifactErrorsFailBuild || inputs.CreatedDraft || inputs.CreatedPrerelease ||
+		inputs.GenerateReleaseNotes || inputs.ImmutableCreate || inputs.RemoveArtifacts || inputs.ReplacesArtifacts ||
+		inputs.UpdateOnlyUnreleased || inputs.OmitBodyDuringUpdate {
+		t.Fatalf("expected all boolean inputs false: %+v", inputs)
+	}
+}
+
+func TestInputsArtifacts(t *testing.T) {
+	t.Run("globs artifacts input", func(t *testing.T) {
+		globber := &recordingGlobber{result: []Artifact{NewArtifact("a", "contentType")}}
+		inputs := mustLoadInputs(t, map[string]string{
+			"artifacts":               "art1",
+			"artifactContentType":     "contentType",
+			"artifactErrorsFailBuild": "true",
+		}, defaultContext(), globber)
+
+		if len(inputs.Artifacts) != 1 {
+			t.Fatalf("expected one artifact, got %d", len(inputs.Artifacts))
+		}
+		if len(globber.calls) != 1 {
+			t.Fatalf("expected one glob call, got %d", len(globber.calls))
+		}
+		if globber.calls[0] != (globCall{"art1", "contentType", true}) {
+			t.Fatalf("unexpected glob call: %+v", globber.calls[0])
+		}
+	})
+
+	t.Run("returns empty artifacts", func(t *testing.T) {
+		globber := &recordingGlobber{result: []Artifact{}}
+		inputs := mustLoadInputs(t, map[string]string{}, defaultContext(), globber)
+		if len(inputs.Artifacts) != 0 {
+			t.Fatalf("expected empty artifacts, got %d", len(inputs.Artifacts))
+		}
+		if len(globber.calls) != 0 {
+			t.Fatalf("expected no glob calls, got %d", len(globber.calls))
+		}
+	})
+
+	t.Run("defaults content type to raw", func(t *testing.T) {
+		globber := &recordingGlobber{result: []Artifact{}}
+		mustLoadInputs(t, map[string]string{"artifacts": "art1"}, defaultContext(), globber)
+		if globber.calls[0].contentType != "raw" {
+			t.Fatalf("expected raw, got %q", globber.calls[0].contentType)
+		}
+	})
+
+	t.Run("falls back to artifact input", func(t *testing.T) {
+		globber := &recordingGlobber{result: []Artifact{}}
+		mustLoadInputs(t, map[string]string{"artifact": "art2", "artifactContentType": "contentType"}, defaultContext(), globber)
+		if len(globber.calls) != 1 || globber.calls[0].artifact != "art2" {
+			t.Fatalf("unexpected calls: %+v", globber.calls)
+		}
+	})
