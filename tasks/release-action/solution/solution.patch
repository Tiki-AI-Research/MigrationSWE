index 0000000..59e62a5
--- /dev/null
+++ b/artifact_uploader.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"fmt"
+)
+
+// ArtifactUploader uploads artifacts to a release.
+type ArtifactUploader interface {
+	UploadArtifacts(artifacts []Artifact, releaseId int64, uploadUrl string) (map[string]string, error)
+}
+
+// GithubArtifactUploader implements ArtifactUploader against Releases.
+type GithubArtifactUploader struct {
+	releases                  Releases
+	replacesExistingArtifacts bool
+	throwsUploadErrors        bool
+}
+
+func NewGithubArtifactUploader(releases Releases, replacesExistingArtifacts bool, throwsUploadErrors bool) *GithubArtifactUploader {
+	return &GithubArtifactUploader{
+		releases:                  releases,
+		replacesExistingArtifacts: replacesExistingArtifacts,
+		throwsUploadErrors:        throwsUploadErrors,
+	}
+}
+
+func (u *GithubArtifactUploader) UploadArtifacts(artifacts []Artifact, releaseId int64, uploadUrl string) (map[string]string, error) {
+	if u.replacesExistingArtifacts {
+		if err := u.deleteUpdatedArtifacts(artifacts, releaseId); err != nil {
+			return nil, err
+		}
+	}
+
+	assetUrls := map[string]string{}
+	for _, artifact := range artifacts {
+		assetUrl, uploaded, err := u.uploadArtifact(artifact, releaseId, uploadUrl, 3)
+		if err != nil {
+			return nil, err
+		}
+		if uploaded {
+			assetUrls[artifact.Name] = assetUrl
+		}
+	}
+	return assetUrls, nil
+}
+
+func (u *GithubArtifactUploader) uploadArtifact(artifact Artifact, releaseId int64, uploadUrl string, retry int) (string, bool, error) {
+	logDebug(fmt.Sprintf("Uploading artifact %s...", artifact.Name))
+
+	contentLength, err := artifact.ContentLength()
+	if err != nil {
+		return "", false, err
+	}
+
+	file, err := artifact.ReadFile()
+	if err != nil {
+		return "", false, err
+	}
+	defer file.Close()
+
+	response, err := u.releases.UploadArtifact(uploadUrl, contentLength, artifact.ContentType, file, artifact.Name, releaseId)
+	if err != nil {
+		status, hasStatus := statusCodeOf(err)
+		if hasStatus && status >= 500 && status < 600 && retry > 0 {
+			logWarning(fmt.Sprintf("Failed to upload artifact %s. %s. Retrying...", artifact.Name, errorMessageOf(err)))
+			return u.uploadArtifact(artifact, releaseId, uploadUrl, retry-1)
+		}
+
+		if u.throwsUploadErrors {
+			return "", false, fmt.Errorf("Failed to upload artifact %s. %s.", artifact.Name, errorMessageOf(err))
+		}
+
+		logWarning(fmt.Sprintf("Failed to upload artifact %s. %s.", artifact.Name, errorMessageOf(err)))
+		return "", false, nil
+	}
+
+	return response.BrowserDownloadURL, true, nil
+}
+
+func (u *GithubArtifactUploader) deleteUpdatedArtifacts(artifacts []Artifact, releaseId int64) error {
+	releaseAssets, err := u.releases.ListArtifactsForRelease(releaseId)
+	if err != nil {
+		return err
+	}
+
+	assetByName := map[string]ReleaseAsset{}
+	for _, asset := range releaseAssets {
+		assetByName[asset.Name] = asset
+	}
+
+	for _, artifact := range artifacts {
+		asset, ok := assetByName[artifact.Name]
+		if !ok {
+			continue
+		}
+		logDebug(fmt.Sprintf("Deleting existing artifact %s...", artifact.Name))
+		if err := u.releases.DeleteArtifact(asset.ID); err != nil {
+			return err
+		}
+	}
+	return nil
+}
