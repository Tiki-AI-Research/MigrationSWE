+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+)
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, "::error::"+formatActionError(err))
+		os.Exit(1)
+	}
+}
+
+func run() error {
+	getter := EnvInputGetter{}
+	context := LoadContext()
+	globber := NewFileArtifactGlobber()
+
+	inputs, err := loadActionInputs(getter, globber, context, true)
+	if err != nil {
+		return err
+	}
+
+	releases := NewGithubReleases(inputs)
+	outputs := NewCoreOutputs()
+	skipper := NewReleaseActionSkipper(inputs.SkipIfReleaseExists, releases, inputs.Tag)
+	uploader := NewGithubArtifactUploader(releases, inputs.ReplacesArtifacts, inputs.ArtifactErrorsFailBuild)
+	destroyer := NewGithubArtifactDestroyer(releases)
+
+	action := NewAction(inputs, outputs, releases, uploader, destroyer, skipper)
+	return action.Perform()
+}
+
+func formatActionError(err error) string {
+	var githubError *GithubError
+	if errors.As(err, &githubError) {
+		return githubError.String()
+	}
+	return err.Error()
+}
diff --git a/minimatch_glob.go b/minimatch_glob.go
new file mode 100644
index 0000000..44eb589
--- /dev/null
+++ b/minimatch_glob.go
@@ -0,0 +1,610 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// minimatchGlob implements glob's default case-sensitive, non-dotfile matching. Globstar
+// does not follow directory symlinks; explicitly named directories may be links.
+func minimatchGlob(pattern string) ([]string, error) {
+	found := map[string]bool{}
+	for _, expanded := range expandBraces(pattern) {
+		if expanded == "" {
+			continue
+		}
+		root := "."
+		if strings.HasPrefix(expanded, "/") {
+			root = "/"
+		}
+		segments := strings.Split(strings.Trim(expanded, "/"), "/")
+		directoryOnly := strings.HasSuffix(expanded, "/")
+		var visit func(string, int)
+		visit = func(base string, index int) {
+			if index == len(segments) {
+				info, err := os.Stat(base)
+				if err != nil || (directoryOnly && !info.IsDir()) {
+					return
+				}
+				path := filepath.ToSlash(base)
+				if info.IsDir() && !strings.HasSuffix(path, "/") {
+					path += "/"
+				}
+				found[path] = true
+				return
+			}
+			segment := segments[index]
+			if segment == "" || segment == "." {
+				visit(base, index+1)
+				return
+			}
+			if segment == ".." {
+				visit(filepath.Join(base, ".."), index+1)
+				return
+			}
+			if segment == "**" {
+				visit(base, index+1)
+				entries, err := os.ReadDir(base)
+				if err != nil {
+					return
+				}
+				for _, entry := range entries {
+					if strings.HasPrefix(entry.Name(), ".") {
+						continue
+					}
+					child := filepath.Join(base, entry.Name())
+					if index == len(segments)-1 {
+						visit(child, index+1)
+					}
+					if entry.IsDir() {
+						visit(child, index)
+					}
+				}
+				return
+			}
+			entries, err := os.ReadDir(base)
+			if err != nil {
+				return
+			}
+			tokens := parseTokens([]rune(segment))
+			for _, entry := range entries {
+				name := entry.Name()
+				if matchTokens(tokens, []rune(name), 0)[len([]rune(name))] {
+					visit(filepath.Join(base, name), index+1)
+				}
+			}
+		}
+		visit(root, 0)
+	}
+	paths := make([]string, 0, len(found))
+	for path := range found {
+		paths = append(paths, path)
+	}
+	sort.Strings(paths)
+	return paths, nil
+}
+
+type globToken struct {
+	kind          rune
+	literal       rune
+	class         *globClass
+	choices       [][]globToken
+	prefixChoices [][]globToken
+}
+
+func parseTokens(pattern []rune) []globToken {
+	var tokens []globToken
+	for i := 0; i < len(pattern); i++ {
+		c := pattern[i]
+		if c == '\\' && i+1 < len(pattern) {
+			i++
+			tokens = append(tokens, globToken{kind: 'l', literal: pattern[i]})
+			continue
+		}
+		if strings.ContainsRune("@+?!*", c) && i+1 < len(pattern) && pattern[i+1] == '(' {
+			if end := groupEnd(pattern, i+1); end >= 0 {
+				token := globToken{kind: c}
+				syntactic := splitChoices(pattern[i+2:end], false)
+				for _, choice := range syntactic {
+					// minimatch emits an escaped pipe as regex alternation
+					// inside a choice. Unlike syntactic alternatives, only
+					// its final branch receives a negative group's suffix.
+					parts := splitChoices(choice, true)
+					for partIndex, part := range parts {
+						parsed := parseTokens(part)
+						if token.kind == '!' && partIndex < len(parts)-1 {
+							token.prefixChoices = append(token.prefixChoices, parsed)
+						} else {
+							token.choices = append(token.choices, parsed)
+						}
+					}
+				}
+				// Collapsing depends on syntax, before escaped pipes become
+				// regex alternatives: !(a\|) differs from !(a|).
+				if token.kind == '!' {
+					last := parseTokens(syntactic[len(syntactic)-1])
+					if len(last) == 0 || last[len(last)-1].choices != nil {
+						token.kind = 'n'
+						token.choices = nil
+						token.prefixChoices = nil
+					}
+				}
+				tokens = append(tokens, token)
+				i = end
+				continue
+			}
+		}
+		if c == '[' {
+			if end, class := parseClass(pattern, i); end >= 0 {
+				tokens = append(tokens, globToken{kind: '[', class: class})
+				i = end
+				continue
+			}
+		}
+		switch c {
+		case '*', '?':
+			tokens = append(tokens, globToken{kind: c})
+		default:
+			tokens = append(tokens, globToken{kind: 'l', literal: c})
+		}
+	}
+	return tokens
+}
+
+func groupEnd(pattern []rune, start int) int {
+	depth := 1
+	for i := start + 1; i < len(pattern); i++ {
+		if pattern[i] == '\\' && i+1 < len(pattern) {
+			i++
+			continue
+		}
+		if pattern[i] == '[' {
+			if end, _ := parseClass(pattern, i); end >= 0 {
+				i = end
+				continue
+			}
+		}
+		if pattern[i] == '(' {
+			depth++
+		}
+		if pattern[i] == ')' {
+			depth--
+			if depth == 0 {
+				return i
+			}
+		}
+	}
+	return -1
+}
+func splitChoices(pattern []rune, escapedPipes bool) [][]rune {
+	var choices [][]rune
+	start := 0
+	for i := 0; i < len(pattern); i++ {
+		if pattern[i] == '\\' && i+1 < len(pattern) {
+			if escapedPipes && pattern[i+1] == '|' {
+				choices = append(choices, pattern[start:i])
+				start = i + 2
+			}
+			i++
+			continue
+		}
+		if pattern[i] == '[' {
+			if end, _ := parseClass(pattern, i); end >= 0 {
+				i = end
+				continue
+			}
+		}
+		if pattern[i] == '(' {
+			if end := groupEnd(pattern, i); end >= 0 {
+				i = end
+				continue
+			}
+		}
+		if pattern[i] == '|' {
+			choices = append(choices, pattern[start:i])
+			start = i + 1
+		}
+	}
+	return append(choices, pattern[start:])
+}
+
+// Named classes deliberately use Unicode properties, matching minimatch rather
+// than Go's ASCII-only regexp POSIX classes (notably for [[:alpha:]]).
+var posixClasses = map[string]string{
+	"alnum": `\p{L}\p{Nl}\p{Nd}`, "alpha": `\p{L}\p{Nl}`, "ascii": `\x00-\x7f`,
+	"blank": `\p{Zs}\t`, "cntrl": `\p{Cc}`, "digit": `\p{Nd}`,
+	"graph": `^\p{Z}\p{C}`, "lower": `\p{Ll}`,
+	"print": `\p{C}`, "punct": `\p{P}`,
+	"space": `\p{Z}\t\r\n\v\f`, "upper": `\p{Lu}`, "word": `\p{L}\p{Nl}\p{Nd}\p{Pc}`, "xdigit": `a-fA-F0-9`,
+}
+
+// globClass retains the two character-class buckets used by minimatch:
+// ordinary members and internally complemented POSIX classes such as graph.
+// Outer negation applies to each bucket before their alternatives are joined.
+// In particular [![:graph:]a] is [^a]|[\p{Z}\p{C}], not the complement of
+// the union of graph and a.
+type globClass struct {
+	expression       *regexp.Regexp
+	invalid          bool
+	allowsLeadingDot bool
+}
+
+func (c *globClass) MatchString(s string) bool {
+	return !c.invalid && c.expression.MatchString(s)
+}
+
+func quoteClassRune(value rune) string {
+	if strings.ContainsRune(`\[]-^`, value) {
+		return "\\" + string(value)
+	}
+	return string(value)
+}
+
+func parseClass(pattern []rune, start int) (int, *globClass) {
+	var ordinary, complemented []string
+	i := start + 1
+	negate := false
+	if i < len(pattern) && (pattern[i] == '!' || pattern[i] == '^') {
+		negate = true
+		i++
+	}
+	seen, escaped, pendingRange := false, false, false
+	var rangeStart rune
+	for ; i < len(pattern); i++ {
+		value := pattern[i]
+		if value == ']' && seen && !escaped {
+			if len(ordinary) == 0 && len(complemented) == 0 {
+				return i, &globClass{invalid: true}
+			}
+			var alternatives []string
+			if len(ordinary) > 0 {
+				prefix := ""
+				if negate {
+					prefix = "^"
+				}
+				alternatives = append(alternatives, "["+prefix+strings.Join(ordinary, "")+"]")
+			}
+			if len(complemented) > 0 {
+				prefix := "^"
+				if negate {
+					prefix = ""
+				}
+				alternatives = append(alternatives, "["+prefix+strings.Join(complemented, "")+"]")
+			}
+			expression, err := regexp.Compile("^(?:" + strings.Join(alternatives, "|") + ")$")
+			return i, &globClass{
+				expression: expression,
+				invalid: err != nil,
+				allowsLeadingDot: !negate && len(complemented) == 0 && len(ordinary) == 1 && ordinary[0] == ".",
+			}
+		}
+		seen = true
+		if value == '\\' && !escaped {
+			escaped = true
+			continue
+		}
+		if value == '[' && !escaped && i+1 < len(pattern) && pattern[i+1] == ':' {
+			end := i + 2
+			for end+1 < len(pattern) && !(pattern[end] == ':' && pattern[end+1] == ']') {
+				end++
+			}
+			if end+1 < len(pattern) {
+				if replacement, ok := posixClasses[string(pattern[i+2:end])]; ok {
+					if pendingRange {
+						return len(pattern) - 1, &globClass{invalid: true}
+					}
+					if strings.HasPrefix(replacement, "^") {
+						complemented = append(complemented, replacement[1:])
+					} else {
+						ordinary = append(ordinary, replacement)
+					}
+					i = end + 1
+					continue
+				}
+			}
+		}
+		escaped = false
+		if pendingRange {
+			// Like minimatch, discard a descending range while retaining
+			// any other class members; [z-aa] still matches a.
+			if value > rangeStart {
+				ordinary = append(ordinary, quoteClassRune(rangeStart)+"-"+quoteClassRune(value))
+			} else if value == rangeStart {
+				ordinary = append(ordinary, quoteClassRune(value))
+			}
+			pendingRange = false
+			continue
+		}
+		if i+2 < len(pattern) && pattern[i+1] == '-' && pattern[i+2] == ']' {
+			ordinary = append(ordinary, quoteClassRune(value)+`\-`)
+			i++
+			continue
+		}
+		if i+1 < len(pattern) && pattern[i+1] == '-' {
+			rangeStart, pendingRange = value, true
+			i++
+			continue
+		}
+		ordinary = append(ordinary, quoteClassRune(value))
+	}
+	return -1, nil
+}
+
+// Each token advances a set of possible rune offsets. This also supports
+// negative extglobs without regexp lookahead or byte-based Unicode matching.
+func matchTokens(tokens []globToken, text []rune, start int) map[int]bool {
+	return matchTokensWithSuffix(tokens, nil, text, start)
+}
+
+// suffix supplies the containing groups' continuation to negative
+// lookaheads without consuming it while matching an alternative.
+func matchTokensWithSuffix(tokens, suffix []globToken, text []rune, start int) map[int]bool {
+	positions := map[int]bool{start: true}
+	for tokenIndex, token := range tokens {
+		continuation := append(append([]globToken{}, tokens[tokenIndex+1:]...), suffix...)
+		next := map[int]bool{}
+		for pos := range positions {
+			if pos == 0 && len(text) > 0 && text[0] == '.' && !tokenAllowsLeadingDot(token) {
+				continue
+			}
+			if token.choices != nil {
+				options := func(at int) map[int]bool {
+					ends := map[int]bool{}
+					for _, choice := range token.choices {
+						for end := range matchTokensWithSuffix(choice, continuation, text, at) {
+							ends[end] = true
+						}
+					}
+					return ends
+				}
+				ends := options(pos)
+				switch token.kind {
+				case '!':
+					// Escaped-pipe prefixes are bare regex alternatives; a
+					// prefix match excludes the path without an end anchor.
+					excluded := false
+					for _, choice := range token.prefixChoices {
+						if len(matchTokens(choice, text, pos)) > 0 {
+							excluded = true
+							break
+						}
+					}
+					// Ordinary alternatives include the remaining suffix.
+					for _, choice := range token.choices {
+						whole := append(append([]globToken{}, choice...), continuation...)
+						if matchTokens(whole, text, pos)[len(text)] {
+							excluded = true
+							break
+						}
+					}
+					if !excluded {
+						for end := pos; end <= len(text); end++ {
+							next[end] = true
+						}
+					}
+				case '@':
+					for end := range ends {
+						next[end] = true
+					}
+				case '?':
+					next[pos] = true
+					for end := range ends {
+						next[end] = true
+					}
+				case '*', '+':
+					seen := map[int]bool{}
+					queue := []int{}
+					if token.kind == '*' {
+						ends[pos] = true
+					}
+					for end := range ends {
+						seen[end] = true
+						queue = append(queue, end)
+					}
+					for len(queue) > 0 {
+						at := queue[0]
+						queue = queue[1:]
+						next[at] = true
+						for end := range options(at) {
+							if !seen[end] {
+								seen[end] = true
+								queue = append(queue, end)
+							}
+						}
+					}
+				}
+			} else {
+				switch token.kind {
+				case 'n':
+					for end := pos + 1; end <= len(text); end++ {
+						next[end] = true
+					}
+				case '*':
+					for end := pos; end <= len(text); end++ {
+						next[end] = true
+					}
+				case '?':
+					if pos < len(text) {
+						next[pos+1] = true
+					}
+				case '[':
+					if pos < len(text) && token.class.MatchString(string(text[pos])) {
+						next[pos+1] = true
+					}
+				case 'l':
+					if pos < len(text) && text[pos] == token.literal {
+						next[pos+1] = true
+					}
+				}
+			}
+		}
+		positions = next
+		if len(positions) == 0 {
+			break
+		}
+	}
+	return positions
+}
+
+// Wildcards do not implicitly match a leading dot. An explicit dot in an
+// extglob alternative does; optional/repeated groups may leave a dot suffix.
+func tokenAllowsLeadingDot(token globToken) bool {
+	if token.kind == 'l' {
+		return token.literal == '.'
+	}
+	if token.choices == nil {
+		return token.kind == '[' && token.class.allowsLeadingDot
+	}
+	if token.kind == '?' || token.kind == '*' {
+		return true
+	}
+	if token.kind == '@' || token.kind == '+' {
+		for _, choice := range token.choices {
+			if len(choice) == 0 || tokenAllowsLeadingDot(choice[0]) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+var numericRange = regexp.MustCompile(`^(-?[0-9]+)\.\.(-?[0-9]+)(?:\.\.(-?[0-9]+))?$`)
+var alphaRange = regexp.MustCompile(`^([a-zA-Z])\.\.([a-zA-Z])(?:\.\.(-?[0-9]+))?$`)
+
+func expandBraces(pattern string) []string {
+	for start := 0; start < len(pattern); start++ {
+		if pattern[start] == '\\' && start+1 < len(pattern) {
+			start++
+			continue
+		}
+		if pattern[start] != '{' {
+			continue
+		}
+		depth, end := 1, start+1
+		for ; end < len(pattern); end++ {
+			if pattern[end] == '\\' && end+1 < len(pattern) {
+				end++
+				continue
+			}
+			if pattern[end] == '{' {
+				depth++
+			}
+			if pattern[end] == '}' {
+				depth--
+				if depth == 0 {
+					break
+				}
+			}
+		}
+		if depth != 0 {
+			continue
+		}
+		// brace-expansion escapes a leading empty pair before expanding
+		// the remaining pattern ({} followed by a range is still useful).
+		if start == 0 && end == 1 {
+			start = end
+			continue
+		}
+		// brace-expansion preserves a balanced ${...} expression literally,
+		// including any nested braces. Later groups may still expand.
+		if start > 0 && pattern[start-1] == '$' {
+			start = end
+			continue
+		}
+		inner := pattern[start+1 : end]
+		choices := []string{}
+		part, nested := 0, 0
+		for i := 0; i < len(inner); i++ {
+			if inner[i] == '\\' && i+1 < len(inner) {
+				i++
+				continue
+			}
+			c := inner[i]
+			if c == '{' {
+				nested++
+			}
+			if c == '}' {
+				nested--
+			}
+			if c == ',' && nested == 0 {
+				choices = append(choices, inner[part:i])
+				part = i + 1
+			}
+		}
+		if len(choices) > 0 {
+			choices = append(choices, inner[part:])
+		} else {
+			match := numericRange.FindStringSubmatch(inner)
+			alpha := false
+			if match == nil {
+				match = alphaRange.FindStringSubmatch(inner)
+				alpha = true
+			}
+			if match != nil {
+				var first, last int
+				width := 0
+				if alpha {
+					first, last = int(match[1][0]), int(match[2][0])
+				} else {
+					first, _ = strconv.Atoi(match[1])
+					last, _ = strconv.Atoi(match[2])
+					a, b := strings.TrimPrefix(match[1], "-"), strings.TrimPrefix(match[2], "-")
+					if (len(a) > 1 && a[0] == '0') || (len(b) > 1 && b[0] == '0') {
+						width = len(a)
+						if len(b) > width {
+							width = len(b)
+						}
+					}
+				}
+				step := 1
+				if match[3] != "" {
+					step, _ = strconv.Atoi(match[3])
+					if step < 0 {
+						step = -step
+					}
+					if step == 0 {
+						step = 1
+					}
+				}
+				if first > last {
+					step = -step
+				}
+				for value := first; (step > 0 && value <= last) || (step < 0 && value >= last); value += step {
+					choice := strconv.Itoa(value)
+					if alpha {
+						choice = string(rune(value))
+					} else if width > 0 {
+						if value < 0 {
+							choice = "-" + fmtPadded(-value, width)
+						} else {
+							choice = fmtPadded(value, width)
+						}
+					}
+					choices = append(choices, choice)
+				}
+			}
+		}
+		if len(choices) == 0 {
+			// Without a range or alternatives brace-expansion returns the
+			// entire pattern unchanged, including nested/subsequent groups.
+			return []string{pattern}
+		}
+		var results []string
+		for _, choice := range choices {
+			results = append(results, expandBraces(pattern[:start]+choice+pattern[end+1:])...)
+		}
+		return results
+	}
+	return []string{pattern}
+}
+func fmtPadded(n, width int) string {
+	s := strconv.Itoa(n)
+	if len(s) < width {
+		return strings.Repeat("0", width-len(s)) + s
+	}
+	return s
+}
