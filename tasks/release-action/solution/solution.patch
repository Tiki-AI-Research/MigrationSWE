+func TestArtifact(t *testing.T) {
+	if artifact := NewArtifact("", ""); artifact.ContentType != "raw" {
+		t.Fatalf("content type = %q", artifact.ContentType)
+	}
+	if artifact := NewArtifact("some/artifact", "raw"); artifact.Name != "artifact" {
+		t.Fatalf("name = %q", artifact.Name)
+	}
+	if artifact := NewArtifact("some/artifact", "raw"); artifact.Path != "some/artifact" {
+		t.Fatalf("path = %q", artifact.Path)
+	}
+
+	path := filepath.Join(t.TempDir(), "artifact")
+	if err := os.WriteFile(path, []byte("hello world!"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	artifact := NewArtifact(path, "raw")
+	length, err := artifact.ContentLength()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if length != 12 {
+		t.Fatalf("length = %d", length)
+	}
+
+	reader, err := artifact.ReadFile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	content, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(content) != "hello world!" {
+		t.Fatalf("content = %q", string(content))
+	}
+}
