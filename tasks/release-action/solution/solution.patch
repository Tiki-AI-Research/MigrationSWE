+func TestReleaseValidator(t *testing.T) {
+	notEnabled := NewReleaseValidator(false)
+	if err := notEnabled.ValidateReleaseUpdate(ReleaseData{Name: strPtr("Name")}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	enabled := NewReleaseValidator(true)
+	if err := enabled.ValidateReleaseUpdate(ReleaseData{Draft: false, Prerelease: false, Name: strPtr("Name")}); err == nil {
+		t.Fatal("expected error")
+	}
+	if err := enabled.ValidateReleaseUpdate(ReleaseData{Draft: true, Prerelease: false, Name: strPtr("Name")}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if err := enabled.ValidateReleaseUpdate(ReleaseData{Draft: false, Prerelease: true, Name: strPtr("Name")}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if err := enabled.ValidateReleaseUpdate(ReleaseData{Draft: true, Prerelease: true, Name: strPtr("Name")}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	err := enabled.ValidateReleaseUpdate(ReleaseData{Draft: false, Prerelease: false})
+	want := `Tried to update "release" which is neither a draft or prerelease. (updateOnlyUnreleased is on)`
+	if err == nil || err.Error() != want {
+		t.Fatalf("err = %v", err)
+	}
+}
