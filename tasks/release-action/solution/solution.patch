diff --git a/action.go b/action.go
new file mode 100644
index 0000000..092eb23
--- /dev/null
+++ b/action.go
@@ -0,0 +1,253 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// Action orchestrates release creation/update, artifacts and outputs.
+type Action struct {
+	inputs            *Inputs
+	outputs           Outputs
+	releases          Releases
+	uploader          ArtifactUploader
+	artifactDestroyer ArtifactDestroyer
+	skipper           ActionSkipper
+	releaseValidator  *ReleaseValidator
+}
+
+func NewAction(inputs *Inputs, outputs Outputs, releases Releases, uploader ArtifactUploader, artifactDestroyer ArtifactDestroyer, skipper ActionSkipper) *Action {
+	return &Action{
+		inputs:            inputs,
+		outputs:           outputs,
+		releases:          releases,
+		uploader:          uploader,
+		artifactDestroyer: artifactDestroyer,
+		skipper:           skipper,
+		releaseValidator:  NewReleaseValidator(inputs.UpdateOnlyUnreleased),
+	}
+}
+
+func (a *Action) Perform() error {
+	skip, err := a.skipper.ShouldSkip()
+	if err != nil {
+		return err
+	}
+	if skip {
+		logNotice("Skipping action, release already exists and skipIfReleaseExists is enabled.")
+		return nil
+	}
+
+	return a.createOrUpdateRelease()
+}
+
+func (a *Action) createOrUpdateRelease() error {
+	if a.inputs.AllowUpdates {
+		getResponse, err := a.releases.GetByTag(a.inputs.Tag)
+		if err != nil {
+			return a.checkForMissingReleaseError(err)
+		}
+
+		// Fail if this isn't an unreleased release & updateOnlyUnreleased is enabled.
+		if err := a.releaseValidator.ValidateReleaseUpdate(*getResponse); err != nil {
+			return err
+		}
+
+		return a.updateRelease(getResponse.ID)
+	}
+
+	return a.createRelease()
+}
+
+func (a *Action) checkForMissingReleaseError(err error) error {
+	status, hasStatus := statusCodeOf(err)
+	if hasStatus && status == 404 {
+		return a.updateDraftOrCreateRelease()
+	}
+	return err
+}
+
+func (a *Action) updateDraftOrCreateRelease() error {
+	draftReleaseId, found, err := a.findMatchingDraftReleaseId()
+	if err != nil {
+		return err
+	}
+	if found {
+		return a.updateRelease(draftReleaseId)
+	}
+	return a.createRelease()
+}
+
+func (a *Action) findMatchingDraftReleaseId() (int64, bool, error) {
+	tag := a.inputs.Tag
+	response, err := a.releases.ListReleases()
+	if err != nil {
+		return 0, false, err
+	}
+	if response == nil || response.Data == nil {
+		encoded, _ := json.Marshal(response)
+		return 0, false, fmt.Errorf("No releases found. Response: %s", string(encoded))
+	}
+
+	for _, release := range *response.Data {
+		if release.Draft && release.TagName == tag {
+			return release.ID, true, nil
+		}
+	}
+	return 0, false, nil
+}
+
+func (a *Action) updateRelease(id int64) error {
+	if a.inputs.prepareBody != nil {
+		if err := a.inputs.prepareBody(true); err != nil {
+			return err
+		}
+	}
+	releaseBody, err := a.combineBodyWithReleaseNotes(a.inputs.UpdatedReleaseBody, true)
+	if err != nil {
+		return err
+	}
+
+	releaseResponse, err := a.releases.Update(
+		id,
+		a.inputs.Tag,
+		releaseBody,
+		a.inputs.Commit,
+		a.inputs.DiscussionCategory,
+		a.inputs.UpdatedDraft,
+		a.inputs.MakeLatest,
+		a.inputs.UpdatedReleaseName,
+		a.inputs.UpdatedPrerelease,
+	)
+	if err != nil {
+		return err
+	}
+
+	return a.processReleaseArtifactsAndOutputs(releaseResponse, false)
+}
+
+func (a *Action) createRelease() error {
+	if a.inputs.prepareBody != nil {
+		if err := a.inputs.prepareBody(false); err != nil {
+			return err
+		}
+	}
+	releaseBody, err := a.combineBodyWithReleaseNotes(a.inputs.CreatedReleaseBody, false)
+	if err != nil {
+		return err
+	}
+
+	// If immutableCreate is enabled we need to start with a draft release.
+	draft := a.inputs.CreatedDraft || a.inputs.ImmutableCreate
+	prerelease := a.inputs.CreatedPrerelease
+
+	releaseResponse, err := a.releases.Create(
+		a.inputs.Tag,
+		releaseBody,
+		a.inputs.Commit,
+		a.inputs.DiscussionCategory,
+		&draft,
+		a.inputs.MakeLatest,
+		a.inputs.CreatedReleaseName,
+		&prerelease,
+	)
+	if err != nil {
+		return err
+	}
+
+	return a.processReleaseArtifactsAndOutputs(releaseResponse, true)
+}
+
+func (a *Action) processReleaseArtifactsAndOutputs(releaseData ReleaseData, wasCreated bool) error {
+	releaseId := releaseData.ID
+	uploadUrl := releaseData.UploadURL
+
+	if a.inputs.RemoveArtifacts {
+		if err := a.artifactDestroyer.DestroyArtifacts(releaseId); err != nil {
+			return err
+		}
+	}
+
+	if a.inputs.prepareArtifacts != nil {
+		if err := a.inputs.prepareArtifacts(); err != nil {
+			return err
+		}
+	}
+
+	assetUrls := map[string]string{}
+	if len(a.inputs.Artifacts) > 0 {
+		urls, err := a.uploader.UploadArtifacts(a.inputs.Artifacts, releaseId, uploadUrl)
+		if err != nil {
+			return err
+		}
+		assetUrls = urls
+	}
+
+	if wasCreated {
+		immutableRelease, err := a.publishImmutableRelease(releaseId)
+		if err != nil {
+			return err
+		}
+		if immutableRelease != nil {
+			a.setOutputs(*immutableRelease, assetUrls)
+			return nil
+		}
+	}
+
+	a.setOutputs(releaseData, assetUrls)
+	return nil
+}
+
+func (a *Action) publishImmutableRelease(releaseId int64) (*ReleaseData, error) {
+	// Check if immutableCreate is on and createdDraft is off.
+	if !a.inputs.ImmutableCreate || a.inputs.CreatedDraft {
+		return nil, nil
+	}
+
+	draft := false
+	release, err := a.releases.Update(
+		releaseId,
+		a.inputs.Tag,
+		nil, // body is omitted
+		nil, // commit is omitted
+		a.inputs.DiscussionCategory,
+		&draft,
+		a.inputs.MakeLatest,
+		a.inputs.CreatedReleaseName,
+		&a.inputs.CreatedPrerelease,
+	)
+	if err != nil {
+		return nil, err
+	}
+	return &release, nil
+}
+
+func (a *Action) combineBodyWithReleaseNotes(body *string, isUpdate bool) (*string, error) {
+	shouldGenerateReleaseNotes := a.inputs.GenerateReleaseNotes
+	if isUpdate {
+		shouldGenerateReleaseNotes = shouldGenerateReleaseNotes && !a.inputs.OmitBodyDuringUpdate
+	}
+
+	if !shouldGenerateReleaseNotes {
+		return body, nil
+	}
+
+	response, err := a.releases.GenerateReleaseNotes(a.inputs.Tag, a.inputs.GenerateReleaseNotesPreviousTag, a.inputs.Commit)
+	if err != nil {
+		return nil, err
+	}
+	releaseNotes := response.Body
+
+	if body == nil || strings.TrimSpace(*body) == "" {
+		return &releaseNotes, nil
+	}
+
+	combined := *body + "\n" + releaseNotes
+	return &combined, nil
+}
+
+func (a *Action) setOutputs(releaseData ReleaseData, assetUrls map[string]string) {
+	a.outputs.ApplyReleaseData(releaseData)
+	a.outputs.ApplyAssetUrls(assetUrls)
+}
