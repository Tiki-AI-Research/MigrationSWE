+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+)
+
+// Inspect the received HTTP request, including the zero-byte artifact case.
+func TestUploadArtifactWireLength(t *testing.T) {
+	for _, contents := range []string{"", "artifact contents"} {
+		t.Run(strconv.Itoa(len(contents))+"_bytes", func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "asset.bin")
+			if err := os.WriteFile(path, []byte(contents), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			file, err := os.Open(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer file.Close()
+			received := make(chan struct{}, 1)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				received <- struct{}{}
+				data, err := io.ReadAll(r.Body)
+				if err != nil || string(data) != contents {
+					t.Errorf("upload body = %q, error = %v, want %q", data, err, contents)
+				}
+				wantLength := int64(len(contents))
+				if r.ContentLength != wantLength || r.Header.Get("Content-Length") != strconv.FormatInt(wantLength, 10) {
+					t.Errorf("upload length = %d, header = %q, want %d", r.ContentLength, r.Header.Get("Content-Length"), wantLength)
+				}
+				if len(r.TransferEncoding) != 0 {
+					t.Errorf("unexpected transfer encoding: %v", r.TransferEncoding)
+				}
+				if r.Method != http.MethodPost || r.URL.Path != "/upload" || r.URL.Query().Get("name") != "asset.bin" {
+					t.Errorf("unexpected upload request: %s %s", r.Method, r.URL)
+				}
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(http.StatusCreated)
+				_, _ = io.WriteString(w, `{"browser_download_url":"https://download.test/asset.bin"}`)
+			}))
+			defer server.Close()
+			releases := NewGithubReleasesWithClient(&Inputs{}, server.Client())
+			response, err := releases.UploadArtifact(server.URL+"/upload{?name,label}", int64(len(contents)), "raw", file, "asset.bin", 42)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if response.BrowserDownloadURL != "https://download.test/asset.bin" {
+				t.Fatalf("unexpected upload response: %+v", response)
+			}
+			select {
+			case <-received:
+			default:
+				t.Fatal("upload did not reach the HTTP server")
+			}
+		})
+	}
+}
