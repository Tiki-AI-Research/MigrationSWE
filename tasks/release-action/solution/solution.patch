+func TestGithubError(t *testing.T) {
+	errorWithDetails := &GithubError{
+		Status:  422,
+		Message: "something bad happened",
+		Errors: []GithubErrorDetail{
+			{Code: "missing", Resource: "release"},
+			{Code: "already_exists", Resource: "release"},
+		},
+	}
+
+	if errorWithDetails.HasErrorWithCode("missing_field") {
+		t.Fatal("did not expect missing_field")
+	}
+	if !errorWithDetails.HasErrorWithCode("missing") {
+		t.Fatal("expected missing")
+	}
+
+	got := errorWithDetails.String()
+	want := "Error 422: something bad happened\nErrors:\n- release does not exist.\n- release already exists."
+	if got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+
+	notFound := &GithubError{Status: 404, Message: "message"}
+	got = notFound.String()
+	want = "Error 404: message\nMake sure your github token has access to the repo and has permission to author releases"
+	if got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+
+	notFoundWithDetails := &GithubError{
+		Status:  404,
+		Message: "message",
+		Errors:  []GithubErrorDetail{{Code: "missing", Resource: "release"}},
+	}
+	got = notFoundWithDetails.String()
+	want = "Error 404: message\nErrors:\n- release does not exist.\nMake sure your github token has access to the repo and has permission to author releases"
+	if got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+
+	plain := &GithubError{Status: 422, Message: "something bad happened"}
+	if plain.String() != "Error 422: something bad happened" {
+		t.Fatalf("got %q", plain.String())
+	}
+
+	statusOnly := &GithubError{Status: 404}
+	if statusOnly.StatusCode() != 404 {
+		t.Fatalf("got %d", statusOnly.StatusCode())
+	}
+}
+
+func TestGithubErrorDetail(t *testing.T) {
+	cases := []struct {
+		name  string
+		error GithubErrorDetail
+		want  string
+	}{
+		{"missing", GithubErrorDetail{Code: "missing", Resource: "release"}, "release does not exist."},
+		{"missing_field", GithubErrorDetail{Code: "missing_field", Field: "body", Resource: "release"}, "The body field on release is missing."},
+		{"invalid", GithubErrorDetail{Code: "invalid", Field: "body", Resource: "release"}, "The body field on release is an invalid format."},
+		{"already_exists", GithubErrorDetail{Code: "already_exists", Resource: "release"}, "release already exists."},
+		{"custom with doc", GithubErrorDetail{Code: "custom", Message: "foo", DocumentationURL: "https://api.example.com"}, "foo\nPlease see https://api.example.com."},
+		{"custom without doc", GithubErrorDetail{Code: "custom", Message: "foo"}, "foo"},
+	}
+	for _, testCase := range cases {
+		t.Run(testCase.name, func(t *testing.T) {
+			if got := testCase.error.String(); got != testCase.want {
+				t.Fatalf("got %q want %q", got, testCase.want)
+			}
+		})
+	}
+
+	if detail := (GithubErrorDetail{Code: "missing"}).CodeValue(); detail != "missing" {
+		t.Fatalf("got %q", detail)
+	}
+}
