+func TestCLIArgoCDInstaller(t *testing.T) {
+	directory := t.TempDir()
+	logPath := filepath.Join(directory, "kubectl.log")
+	script := "#!/bin/sh\nprintf '%s|%s\\n' \"$KUBECONFIG\" \"$*\" >> \"$ARKADE_COMMAND_LOG\"\nif [ \"$1\" = get ]; then printf amd64; fi\n"
+	if err := os.WriteFile(filepath.Join(directory, "kubectl"), []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", directory+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("ARKADE_COMMAND_LOG", logPath)
+	stdout, stderr, err := invokeCLI(t, "", "i", "--kubeconfig", "cluster.yaml", "argocd", "--wait")
+	if err != nil || stderr != "" || !strings.Contains(stdout, "ArgoCD has been installed") {
+		t.Fatalf("%v %s %s", err, stdout, stderr)
+	}
+	data, err := os.ReadFile(logPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected := []string{
+		"cluster.yaml|get nodes --output jsonpath={range $.items[0]}{.status.nodeInfo.architecture}",
+		"cluster.yaml|create ns argocd",
+		"cluster.yaml|apply --server-side -k https://github.com/argoproj/argo-cd/manifests/crds?ref=stable -n argocd",
+		"cluster.yaml|apply -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml -n argocd",
+	}
+	if !reflect.DeepEqual(strings.Split(strings.TrimSpace(string(data)), "\n"), expected) {
+		t.Fatalf("kubectl side effects changed:\n%s", data)
+	}
+}
