+func TestCatalogRemainsReachable(t *testing.T) {
+	root := rootCommand()
+	for _, command := range root.Children {
+		if command.Use == "install" {
+			actual := map[string]bool{}
+			for _, app := range command.Children {
+				actual[strings.Fields(app.Use)[0]] = true
+			}
+			for name, app := range cmd.GetApps() {
+				if !actual[strings.Fields(app.Installer().Use)[0]] {
+					t.Errorf("missing installer from catalog: %s", name)
+				}
+			}
+			if len(actual) != len(cmd.GetApps())+1 {
+				t.Error("app catalog changed")
+			}
+		}
+	}
+}
