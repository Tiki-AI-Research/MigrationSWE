+	"github.com/alexellis/arkade/internal/cli"
+	"github.com/alexellis/arkade/pkg/env"
+	"github.com/alexellis/arkade/pkg/get"
+)
+
+func TestCLIHelperProcess(t *testing.T) {
+	if os.Getenv("ARKADE_CLI_TEST") != "1" {
+		return
+	}
+	for index, arg := range os.Args {
+		if arg == "--" {
+			os.Args = append([]string{"arkade"}, os.Args[index+1:]...)
+			main()
+			os.Exit(0)
+		}
+	}
+	os.Exit(99)
+}
+
+func invokeCLI(t *testing.T, input string, args ...string) (string, string, error) {
+	t.Helper()
+	command := exec.Command(os.Args[0], append([]string{"-test.run=^TestCLIHelperProcess$", "--"}, args...)...)
+	command.Env = append(os.Environ(), "ARKADE_CLI_TEST=1")
+	command.Stdin = strings.NewReader(input)
+	var stdout, stderr bytes.Buffer
+	command.Stdout = &stdout
+	command.Stderr = &stderr
+	err := command.Run()
+	return stdout.String(), stderr.String(), err
+}
+
+func TestCLIOutputAndErrors(t *testing.T) {
+	cases := []struct {
+		args           []string
+		stdout, stderr string
+	}{
+		{nil, "Open Source Marketplace For Developer Tools", ""},
+		{[]string{"help"}, "Usage: arkade", ""},
+		{[]string{"help", "get"}, "The get command downloads", ""},
+		{[]string{"help", "install", "argocd"}, "Install argocd", ""},
+		{[]string{"install"}, "You can install", ""},
+		{[]string{"i", "--print-table"}, "apps that you can install on your cluster.", ""},
+		{[]string{"info"}, "Run arkade info APP_NAME for more", ""},
+		{[]string{"f", "argocd"}, "Info for app: argocd", ""},
+		{[]string{"i", "f", "argocd"}, "Info for app: argocd", ""},
+		{[]string{"uninstall"}, "Apps installed to Kubernetes", ""},
+		{[]string{"delete", "--kubeconfig", "cluster.yaml", "--wait"}, "Apps installed to Kubernetes", ""},
+		{[]string{"completion"}, "Use \"arkade completion SHELL\"", ""},
+		{[]string{"search", "zzzzzz-no-such-tool-zzzzzz"}, "No tools found matching", ""},
+		{[]string{"nonexistent"}, "", "unknown command"},
+		{[]string{"get", "--nonexistent"}, "", "unknown flag"},
+		{[]string{"get", "kind", "-p0"}, "", "--parallel must be at least 1"},
+		{[]string{"get", "kind", "--arch", "invalid", "helm"}, "", "cpu architecture \"invalid\" is not supported"},
+		{[]string{"get", "kind", "--arch", "invalid"}, "", "cpu architecture \"invalid\" is not supported"},
+		{[]string{"get", "kind", "--os", "invalid"}, "", "operating system \"invalid\" is not supported"},
+		{[]string{"get", "zzzzzz-no-tool"}, "", "not found"},
+		{[]string{"get", "kind@v0.1.0", "--version", "v0.2.0"}, "", "version"},
+		{[]string{"install", "helm"}, "", "no such app. helm is available as a tool"},
+		{[]string{"install", "zzzzzz"}, "", "no such app: zzzzzz"},
+		{[]string{"info", "zzzzzz"}, "", "no info available for app: zzzzzz"},
+		{[]string{"info", "argocd", "openfaas"}, "", "exactly one installed app"},
+		{[]string{"search"}, "", "please provide a search query"},
+		{[]string{"completion", "unsupported"}, "", "shell completion not supported"},
+		{[]string{"release", "--major", "--minor"}, "", "mutually exclusive"},
+		{[]string{"release", "one", "two", "three"}, "", "expected at most 2 arguments"},
+		{[]string{"version", "--kubeconfig", "cluster.yaml"}, "", "unknown flag"},
+		{[]string{"install", "--print-table", "argocd"}, "", "unknown flag"},
+		{[]string{"install", "argocd", "--print-table"}, "", "unknown flag"},
+		{[]string{"install", "--print-table", "argocd", "--help"}, "", "unknown flag"},
+	}
+	for _, test := range cases {
+		t.Run(strings.Join(test.args, " "), func(t *testing.T) {
+			stdout, stderr, err := invokeCLI(t, "", test.args...)
+			if test.stderr != "" {
+				if err == nil || !strings.Contains(stderr, test.stderr) {
+					t.Fatalf("want failure containing %q; err=%v stdout=%s stderr=%s", test.stderr, err, stdout, stderr)
+				}
+				if stdout != "" {
+					t.Errorf("invalid invocation wrote stdout: %s", stdout)
+				}
+			} else {
+				if err != nil || stderr != "" || !strings.Contains(stdout, test.stdout) {
+					t.Fatalf("err=%v stdout=%s stderr=%s", err, stdout, stderr)
+				}
+			}
+		})
+	}
+}
+
+func TestCLIGetListingsAndAliases(t *testing.T) {
+	expected := []string{}
+	for _, tool := range get.MakeTools() {
+		expected = append(expected, tool.Name)
+	}
+	sort.Strings(expected)
+	for _, alias := range []string{"get", "g", "d", "download"} {
+		stdout, stderr, err := invokeCLI(t, "", alias, "-o", "list")
+		if err != nil || stderr != "" {
+			t.Fatalf("%s: %v %s", alias, err, stderr)
+		}
+		if actual := strings.Fields(stdout); !reflect.DeepEqual(actual, expected) {
+			t.Fatalf("%s changed the catalog", alias)
+		}
+	}
+	for _, format := range []string{"", "table", "markdown"} {
+		args := []string{"get"}
+		if format != "" {
+			args = append(args, "--format", format)
+		}
+		stdout, stderr, err := invokeCLI(t, "", args...)
+		if err != nil || stderr != "" || !strings.Contains(stdout, fmt.Sprintf("There are %d tools", len(expected))) {
+			t.Fatalf("%s: %v %s %s", format, err, stdout, stderr)
+		}
+	}
+}
+
+func TestCLIVersionJSON(t *testing.T) {
+	for _, args := range [][]string{{"version", "--json"}, {"v", "-j"}} {
+		stdout, stderr, err := invokeCLI(t, "", args...)
+		if err != nil || stderr != "" {
+			t.Fatalf("%v %s", err, stderr)
+		}
+		values := map[string]string{}
+		if err := json.Unmarshal([]byte(stdout), &values); err != nil {
+			t.Fatal(err)
+		}
+		if len(values) != 3 || values["version"] == "" || values["commit"] != "n/a" || values["build_date"] != "n/a" {
+			t.Fatalf("version JSON: %#v", values)
+		}
+	}
+}
+
+func TestCLIHelpForEveryCommandAndAlias(t *testing.T) {
+	var visit func(*cli.Command, []string)
+	visit = func(command *cli.Command, path []string) {
+		if command.Use != "arkade" {
+			path = append(append([]string{}, path...), strings.Fields(command.Use)[0])
+		}
+		args := append(append([]string{}, path...), "--help")
+		stdout, stderr, err := invokeCLI(t, "", args...)
+		if err != nil || stderr != "" || !strings.Contains(stdout, "Usage:") || strings.Contains(stdout, "__default") {
+			t.Errorf("%q: %v stdout=%s stderr=%s", args, err, stdout, stderr)
+		}
+		for _, alias := range command.Aliases {
+			if alias == "d" && strings.HasPrefix(command.Use, "docker") {
+				continue
+			}
+			aliasArgs := append(append(append([]string{}, path[:len(path)-1]...), alias), "--help")
+			stdout, stderr, err := invokeCLI(t, "", aliasArgs...)
+			if err != nil || stderr != "" || !strings.Contains(stdout, command.Short) {
+				t.Errorf("alias %q: %v %s %s", aliasArgs, err, stdout, stderr)
+			}
+		}
+		for _, child := range command.Children {
+			if child.Use != "__complete" {
+				visit(child, path)
+			}
+		}
+	}
+	visit(rootCommand(), nil)
+	stdout, _, _ := invokeCLI(t, "", "--help")
+	if strings.Contains(stdout, "release") || strings.Contains(stdout, "__complete") {
+		t.Errorf("hidden command in root help: %s", stdout)
+	}
+}
+
+func TestKongFlagDefaultsAndScope(t *testing.T) {
+	parser, err := cli.New(rootCommand(), io.Discard, io.Discard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	context, err := parser.Parse([]string{"get"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	arch, operatingSystem := env.GetClientArch()
+	defaults := map[string]any{"progress": true, "format": "", "path": "", "version": "", "arch": arch, "os": operatingSystem, "quiet": false, "verify": true, "parallel": 4}
+	for _, flag := range context.Flags() {
+		if expected, ok := defaults[flag.Name]; ok {
+			if actual := context.FlagValue(flag); !reflect.DeepEqual(actual, expected) {
+				t.Errorf("%s default: got %v, want %v", flag.Name, actual, expected)
+			}
+			delete(defaults, flag.Name)
+		}
+	}
+	if len(defaults) > 0 {
+		t.Errorf("missing flags: %#v", defaults)
+	}
+	for _, args := range [][]string{{"install", "--kubeconfig", "cluster.yaml", "argocd", "--wait"}, {"i", "argocd", "--kubeconfig", "cluster.yaml", "--wait"}, {"install", "traefik2", "--wait"}} {
+		parser, err := cli.New(rootCommand(), io.Discard, io.Discard)
+		if err != nil {
+			t.Fatal(err)
+		}
+		context, err := parser.Parse(args)
+		if err != nil {
+			t.Fatalf("%q: %v", args, err)
+		}
+		found := false
+		for _, flag := range context.Flags() {
+			if flag.Name == "wait" {
+				found = true
+				if context.FlagValue(flag) != true {
+					t.Error("wait was not inherited")
+				}
+			}
+		}
+		if !found {
+			t.Fatal("missing wait flag")
+		}
+	}
+}
