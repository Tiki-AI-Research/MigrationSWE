+
+func TestLeafReceivesKongValuesAndLifecycle(t *testing.T) {
+	command := &cobra.Command{Use: "leaf", Aliases: []string{"alias"}, Args: cobra.ExactArgs(1)}
+	command.Flags().StringArrayP("set", "s", nil, "Overrides")
+	command.Flags().Bool("progress", true, "Progress")
+	command.Flags().IntP("count", "c", 4, "Count")
+	var password string
+	command.Flags().StringVarP(&password, "password", "p", "initial", "Password")
+	events := []string{}
+	expected := errors.New("installer failed")
+	command.PreRunE = func(command *cobra.Command, args []string) error { events = append(events, "pre"); return nil }
+	command.RunE = func(command *cobra.Command, args []string) error {
+		events = append(events, "run")
+		values, _ := command.Flags().GetStringArray("set")
+		if !reflect.DeepEqual(values, []string{"a=1,b=2", "c=3"}) {
+			t.Errorf("repeatable values: %q", values)
+		}
+		progress, _ := command.Flags().GetBool("progress")
+		if progress {
+			t.Error("explicit false lost")
+		}
+		count, _ := command.Flags().GetInt("count")
+		if count != 7 {
+			t.Errorf("count: %d", count)
+		}
+		kubeconfig, _ := command.Flags().GetString("kubeconfig")
+		if kubeconfig != "cluster.yaml" {
+			t.Errorf("inherited kubeconfig: %s", kubeconfig)
+		}
+		wait, _ := command.Flags().GetBool("wait")
+		if !wait {
+			t.Error("inherited wait lost")
+		}
+		if !command.Flags().Changed("progress") || command.Flags().Changed("password") {
+			t.Error("changed status lost")
+		}
+		if password != "initial" {
+			t.Errorf("bound default: %s", password)
+		}
+		return expected
+	}
+	root := &cli.Command{Use: "root", Persistent: &struct {
+		Kubeconfig string
+		Wait       bool
+	}{}, Children: []*cli.Command{Command(command)}}
+	var output bytes.Buffer
+	parser, err := cli.New(root, &output, &output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	context, err := parser.Parse([]string{"--kubeconfig", "cluster.yaml", "alias", "input", "-s", "a=1,b=2", "--set=c=3", "--progress=false", "-c7", "--wait"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := context.Run(); !errors.Is(err, expected) {
+		t.Fatalf("command error: %v", err)
+	}
+	if !reflect.DeepEqual(events, []string{"pre", "run"}) {
+		t.Errorf("lifecycle: %q", events)
+	}
+}
+
+func TestLocalFlagsDoNotLeakToChildren(t *testing.T) {
+	root := &cli.Command{Use: "root", Options: &struct{ Local bool }{}, Children: []*cli.Command{{Use: "leaf", Run: func(*kong.Context, []string) error { t.Fatal("invalid invocation ran"); return nil }}}}
+	for _, args := range [][]string{{"leaf", "--local"}, {"--local", "leaf"}} {
+		var output bytes.Buffer
+		parser, err := cli.New(root, &output, &output)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := parser.Parse(args); err == nil {
+			t.Fatalf("accepted local flag on child: %q", args)
+		}
+	}
+}
+
+func TestRequiredLegacyFlags(t *testing.T) {
+	command := &cobra.Command{Use: "leaf", RunE: func(*cobra.Command, []string) error { return nil }}
+	command.Flags().String("domain", "", "Domain")
+	if err := command.MarkFlagRequired("domain"); err != nil {
+		t.Fatal(err)
+	}
+	var output bytes.Buffer
+	parser, err := cli.New(Command(command), &output, &output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := parser.Parse(nil); err == nil {
+		t.Fatal("missing required flag accepted")
+	}
+	context, err := parser.Parse([]string{"--domain", "example.com"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := context.Run(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDeprecatedFlagWarning(t *testing.T) {
+	command := &cobra.Command{Use: "leaf", RunE: func(*cobra.Command, []string) error { return nil }}
+	command.Flags().Bool("old", false, "Old flag")
+	if err := command.Flags().MarkDeprecated("old", "use the new flag"); err != nil {
+		t.Fatal(err)
+	}
+	var output bytes.Buffer
+	parser, err := cli.New(Command(command), &output, &output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	context, err := parser.Parse([]string{"--old", "--old=false"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := context.Run(); err != nil {
+		t.Fatal(err)
+	}
+	expected := "Flag --old has been deprecated, use the new flag\n"
+	if output.String() != expected+expected {
+		t.Fatalf("deprecation warnings: %q", output.String())
+	}
+}
