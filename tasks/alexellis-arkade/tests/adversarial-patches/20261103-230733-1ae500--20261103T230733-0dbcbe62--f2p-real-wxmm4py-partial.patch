+func TestCLIOCILoginPasswordStdin(t *testing.T) {
+	directory := t.TempDir()
+	t.Setenv("DOCKER_CONFIG", directory)
+	stdout, stderr, err := invokeCLI(t, "secret-password\n", "o", "login", "reg.example.com", "-u", "test-user", "--password-stdin")
+	if err != nil || !strings.Contains(stderr, "Your credentials are stored unencrypted") || !strings.Contains(stdout, "Logged in via") {
+		t.Fatalf("%v %s %s", err, stdout, stderr)
+	}
+	data, err := os.ReadFile(filepath.Join(directory, "config.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var config struct {
+		Auths map[string]struct {
+			Auth string `json:"auth"`
+		} `json:"auths"`
+	}
+	if err := json.Unmarshal(data, &config); err != nil {
+		t.Fatal(err)
+	}
+	auth, err := base64.StdEncoding.DecodeString(config.Auths["reg.example.com"].Auth)
+	if err != nil || string(auth) != "test-user:secret-password" {
+		t.Fatalf("credentials: %s (%v)", auth, err)
+	}
+}
