+func TestCLIReleaseContract(t *testing.T) {
+	directory := t.TempDir()
+	logPath := filepath.Join(directory, "commands.log")
+	ghScript := `#!/bin/sh
+printf 'gh:%s:%s\n' "$GH_TOKEN" "$*" >> "$ARKADE_COMMAND_LOG"
+case "$1:$2:$4" in
+ api:repos/\{owner\}/\{repo\}:.visibility) printf '%s\n' "$ARKADE_TEST_VISIBILITY" ;;
+ api:repos/\{owner\}/\{repo\}/releases:*) printf 'v1.2.3\n' ;;
+ release:create:*) exit "${ARKADE_TEST_GH_EXIT:-0}" ;;
+ *) exit 91 ;;
+esac
+`
+	gitScript := `#!/bin/sh
+printf 'git:%s\n' "$*" >> "$ARKADE_COMMAND_LOG"
+printf 'Commit title\n'
+`
+	for name, script := range map[string]string{"gh": ghScript, "git": gitScript} {
+		if err := os.WriteFile(filepath.Join(directory, name), []byte(script), 0755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Setenv("PATH", directory+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("ARKADE_COMMAND_LOG", logPath)
+	cases := []struct {
+		args                                       []string
+		visibility, tag, title, prerelease, latest string
+	}{
+		{[]string{"release", "--dry-run"}, "PUBLIC", "v1.2.4", "Commit title", "true", "false"},
+		{[]string{"rel", "--dry-run", "--minor"}, "PRIVATE", "v1.3.0", "Commit title", "false", "true"},
+		{[]string{"r", "--dry-run", "--major"}, "INTERNAL", "v2.0.0", "Commit title", "false", "true"},
+		{[]string{"release", "--dry-run", "v2.3.4"}, "PUBLIC", "v2.3.4", "Commit title", "true", "false"},
+		{[]string{"release", "--dry-run", "Custom title"}, "PUBLIC", "v1.2.4", "Custom title", "true", "false"},
+		{[]string{"release", "--dry-run", "v2.3.4", "Explicit title"}, "PUBLIC", "v2.3.4", "Explicit title", "true", "false"},
+		{[]string{"release", "v2.3.4", "--dry-run", "Interspersed title"}, "PUBLIC", "v2.3.4", "Interspersed title", "true", "false"},
+		{[]string{"release", "--dry-run", "--latest"}, "PUBLIC", "v1.2.4", "Commit title", "false", "true"},
+		{[]string{"release", "--dry-run", "--prerelease"}, "PRIVATE", "v1.2.4", "Commit title", "true", "false"},
+		{[]string{"release", "--dry-run", "--latest=false", "--prerelease=false"}, "PRIVATE", "v1.2.4", "Commit title", "false", "false"},
+		{[]string{"release", "--dry-run", "--latest=true", "--prerelease=true"}, "PUBLIC", "v1.2.4", "Commit title", "true", "true"},
+	}
+	for _, test := range cases {
+		t.Run(strings.Join(test.args, " ")+test.visibility, func(t *testing.T) {
+			t.Setenv("ARKADE_TEST_VISIBILITY", test.visibility)
+			if err := os.WriteFile(logPath, nil, 0600); err != nil {
+				t.Fatal(err)
+			}
+			stdout, stderr, err := invokeCLI(t, "", test.args...)
+			if err != nil || stderr != "" {
+				t.Fatalf("%v %s %s", err, stdout, stderr)
+			}
+			for _, line := range []string{"Tag:        " + test.tag, "Title:      " + test.title, "Prerelease: " + test.prerelease, "Latest:     " + test.latest} {
+				if !strings.Contains(stdout, line) {
+					t.Errorf("missing %q in %s", line, stdout)
+				}
+			}
+			data, err := os.ReadFile(logPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(string(data), "release create") {
+				t.Fatal("dry-run created a release")
+			}
+		})
+	}
+	t.Setenv("ARKADE_TEST_VISIBILITY", "PRIVATE")
+	stdout, stderr, err := invokeCLI(t, "", "release", "v2.0.0", "Release title", "--token", "test-token")
+	if err != nil || stderr != "" || !strings.Contains(stdout, "Created release: v2.0.0") {
+		t.Fatalf("%v %s %s", err, stdout, stderr)
+	}
+	data, err := os.ReadFile(logPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), "gh:test-token:release create v2.0.0 --title Release title --notes  --latest") {
+		t.Fatalf("release command changed: %s", data)
+	}
+	t.Setenv("ARKADE_TEST_GH_EXIT", "7")
+	_, stderr, err = invokeCLI(t, "", "release", "v2.0.0", "Release title")
+	if err == nil || !strings.Contains(stderr, "gh exited with code 7") {
+		t.Fatalf("gh error not propagated: %v %s", err, stderr)
+	}
+}
