@@ -0,0 +1,302 @@
+package cli
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"unicode"
+
+	"github.com/alecthomas/kong"
+)
+
+type Command struct {
+	Use         string
+	Short       string
+	Long        string
+	Example     string
+	Aliases     []string
+	Hidden      bool
+	Passthrough bool
+	Options     any
+	Persistent  any
+	Children    []*Command
+	ValidArgs   []string
+	Vars        kong.Vars
+	Run         func(*kong.Context, []string) error
+}
+
+type invocation struct {
+	command *Command
+}
+
+type dispatcher struct {
+	Grammar     kong.Plugins `embed:""`
+	invocations map[*kong.Node]invocation
+	localFlags  map[*kong.Flag]*kong.Node
+	variadic    map[*kong.Node]*kong.Positional
+}
+
+type Parser struct {
+	*kong.Kong
+	variadic map[*kong.Node]*kong.Positional
+}
+
+func (parser *Parser) Parse(args []string) (*kong.Context, error) {
+	count := max(1, len(args))
+	for node, original := range parser.variadic {
+		node.Positional = make([]*kong.Positional, count)
+		for index := range node.Positional {
+			positional := *original
+			positional.Position = index
+			positional.Target = reflect.New(reflect.TypeOf("")).Elem()
+			positional.DefaultValue = reflect.New(reflect.TypeOf("")).Elem()
+			positional.Mapper = stringMapper{}
+			node.Positional[index] = &positional
+		}
+	}
+	return parser.Kong.Parse(args)
+}
+
+func (dispatch *dispatcher) BeforeReset(context *kong.Context) error {
+	for _, path := range context.Path {
+		if owner := dispatch.localFlags[path.Flag]; owner != nil && owner != context.Selected() && owner.Parent != context.Selected() {
+			return fmt.Errorf("unknown flag --%s", path.Flag.Name)
+		}
+	}
+	return nil
+}
+
+func (dispatch *dispatcher) Run(context *kong.Context) error {
+	selected := context.Selected()
+	if selected == nil {
+		selected = context.Model.Node
+	}
+	invocation := dispatch.invocations[selected]
+	if invocation.command.Run == nil {
+		return context.PrintUsage(false)
+	}
+	var args []string
+	for _, path := range context.Path {
+		if path.Positional != nil {
+			value := context.Value(path)
+			if value.Kind() == reflect.Slice {
+				args = append(args, value.Interface().([]string)...)
+			} else {
+				args = append(args, value.String())
+			}
+		}
+	}
+	return invocation.command.Run(context, args)
+}
+
+type builtCommand struct {
+	command  *Command
+	model    reflect.Value
+	targets  map[string]reflect.Value
+	children []*builtCommand
+}
+
+func attribute(name, value string) string { return name + ":" + strconv.Quote(value) }
+
+func flagName(field reflect.StructField) string {
+	if name := field.Tag.Get("name"); name != "" {
+		return name
+	}
+	var name strings.Builder
+	for index, character := range field.Name {
+		if index > 0 && unicode.IsUpper(character) {
+			name.WriteByte('-')
+		}
+		name.WriteRune(unicode.ToLower(character))
+	}
+	return name.String()
+}
+
+func build(command *Command, inherited map[string]bool) *builtCommand {
+	built := &builtCommand{command: command, targets: map[string]reflect.Value{}}
+	fields := []reflect.StructField{}
+	available := map[string]bool{}
+	for name := range inherited {
+		available[name] = true
+	}
+	appendOptions := func(options any) {
+		if options == nil {
+			return
+		}
+		value := reflect.ValueOf(options).Elem()
+		for index := 0; index < value.NumField(); index++ {
+			field := value.Type().Field(index)
+			name := flagName(field)
+			if available[name] {
+				continue
+			}
+			field.Name = fmt.Sprintf("Flag%d", len(fields))
+			if field.Tag.Get("name") == "" {
+				field.Tag = reflect.StructTag(string(field.Tag) + " " + attribute("name", name))
+			}
+			fields = append(fields, field)
+			available[name] = true
+			built.targets[name] = value.Field(index)
+		}
+	}
+	appendOptions(command.Persistent)
+	if len(command.Children) == 0 {
+		appendOptions(command.Options)
+		tags := `arg:"" optional:"" name:"args"`
+		if command.Passthrough {
+			tags += ` passthrough:"all"`
+		}
+		fields = append(fields, reflect.StructField{Name: "Arguments", Type: reflect.TypeOf([]string{}), Tag: reflect.StructTag(tags)})
+	} else {
+		for _, child := range command.Children {
+			built.children = append(built.children, build(child, available))
+		}
+		fallback := &Command{Use: "__default", Hidden: true, Options: command.Options, Run: command.Run, ValidArgs: command.ValidArgs}
+		built.children = append(built.children, build(fallback, available))
+		for index, child := range built.children {
+			tags := []string{`cmd:""`, attribute("name", strings.Fields(child.command.Use)[0]), attribute("help", child.command.Short)}
+			if len(child.command.Aliases) > 0 {
+				tags = append(tags, attribute("aliases", strings.Join(child.command.Aliases, ",")))
+			}
+			if child.command.Hidden {
+				tags = append(tags, `hidden:""`)
+			}
+			if index == len(built.children)-1 {
+				tags = append(tags, `default:"withargs"`)
+			}
+			fields = append(fields, reflect.StructField{Name: fmt.Sprintf("Command%d", index), Type: child.model.Type().Elem(), Tag: reflect.StructTag(strings.Join(tags, " "))})
+		}
+	}
+	built.model = reflect.New(reflect.StructOf(fields))
+	return built
+}
+
+func (built *builtCommand) bind(node *kong.Node, dispatch *dispatcher) {
+	for _, flag := range node.Flags {
+		if target, ok := built.targets[flag.Name]; ok {
+			flag.Target = target
+		}
+		if node.Name == "__default" {
+			dispatch.localFlags[flag] = node
+		}
+	}
+	node.Detail = built.command.Long
+	if built.command.Example != "" {
+		node.Detail += "\n\nExamples:\n" + built.command.Example
+	}
+	if len(built.children) == 0 {
+		dispatch.invocations[node] = invocation{command: built.command}
+		if !built.command.Passthrough {
+			dispatch.variadic[node] = node.Positional[0]
+		}
+	}
+	for index, child := range built.children {
+		child.bind(node.Children[index], dispatch)
+	}
+}
+
+func New(root *Command, stdout, stderr io.Writer) (*Parser, error) {
+	built := build(root, nil)
+	dispatch := &dispatcher{Grammar: kong.Plugins{built.model.Interface()}, invocations: map[*kong.Node]invocation{}, localFlags: map[*kong.Flag]*kong.Node{}, variadic: map[*kong.Node]*kong.Positional{}}
+	vars := kong.Vars{}
+	var collect func(*Command)
+	collect = func(command *Command) {
+		for name, value := range command.Vars {
+			vars[name] = value
+		}
+		for _, child := range command.Children {
+			collect(child)
+		}
+	}
+	collect(root)
+	parser, err := kong.New(dispatch, vars,
+		kong.Name(strings.Fields(root.Use)[0]),
+		kong.Writers(stdout, stderr),
+		kong.Help(printHelp),
+		kong.HelpOptions{NoExpandSubcommands: true},
+		kong.KindMapper(reflect.Bool, booleanMapper{}),
+		kong.KindMapper(reflect.Int, integerMapper{}),
+		kong.KindMapper(reflect.Int64, integerMapper{}),
+		kong.KindMapper(reflect.String, stringMapper{}),
+	)
+	if err != nil {
+		return nil, err
+	}
+	built.bind(parser.Model.Node, dispatch)
+	return &Parser{Kong: parser, variadic: dispatch.variadic}, nil
+}
+
+func Execute(command *Command, args []string) error {
+	parser, err := New(command, os.Stdout, os.Stderr)
+	if err != nil {
+		return err
+	}
+	context, err := parser.Parse(args)
+	if err != nil {
+		return err
+	}
+	return context.Run()
+}
+
+func HelpCommand() *Command {
+	return &Command{
+		Use: "help [COMMAND ...]", Short: "Help about any command",
+		Run: func(context *kong.Context, args []string) error {
+			_, err := context.Kong.Parse(append(append([]string{}, args...), "--help"))
+			return err
+		},
+	}
+}
+
+func Changed(context *kong.Context, name string) bool {
+	for _, path := range context.Path {
+		if path.Flag != nil && path.Flag.Name == name {
+			return true
+		}
+	}
+	return false
+}
+
+func String(context *kong.Context, name string) string {
+	for _, flag := range context.Flags() {
+		if flag.Name == name {
+			return context.FlagValue(flag).(string)
+		}
+	}
+	return ""
+}
+
+func printHelp(options kong.HelpOptions, context *kong.Context) error {
+	dispatch := context.Model.Target.Addr().Interface().(*dispatcher)
+	positionals := map[*kong.Node][]*kong.Positional{}
+	for node, original := range dispatch.variadic {
+		positionals[node] = node.Positional
+		node.Positional = []*kong.Positional{original}
+	}
+	defer func() {
+		for node, values := range positionals {
+			node.Positional = values
+		}
+	}()
+	copyContext := *context
+	copyContext.Path = nil
+	for _, path := range context.Path {
+		if path.Command != nil && path.Command.Name == "__default" {
+			break
+		}
+		copyContext.Path = append(copyContext.Path, path)
+	}
+	node := copyContext.Selected()
+	if node == nil {
+		node = context.Model.Node
+	}
+	flags := node.Flags
+	if node.DefaultCmd != nil {
+		node.Flags = append(append([]*kong.Flag{}, flags...), node.DefaultCmd.Flags...)
+	}
+	defer func() { node.Flags = flags }()
+	return kong.DefaultHelpPrinter(options, &copyContext)
+}
diff --git a/internal/cli/command_test.go b/internal/cli/command_test.go
new file mode 100644
index 0000000..02bffdb
--- /dev/null
+++ b/internal/cli/command_test.go
@@ -0,0 +1,144 @@
+package cli
+
+import (
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/alecthomas/kong"
+)
+
+func TestBooleanSpellings(t *testing.T) {
+	for _, test := range []struct {
+		value string
+		want  bool
+	}{
+		{"true", true}, {"1", true}, {"t", true}, {"T", true}, {"TRUE", true}, {"True", true},
+		{"false", false}, {"0", false}, {"f", false}, {"F", false}, {"FALSE", false}, {"False", false},
+	} {
+		t.Run(test.value, func(t *testing.T) {
+			options := &struct{ Progress bool }{}
+			parser, err := New(&Command{Use: "root", Options: options}, io.Discard, io.Discard)
+			if err != nil {
+				t.Fatal(err)
+			}
+			context, err := parser.Parse([]string{"--progress=" + test.value})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if options.Progress != test.want || !Changed(context, "progress") {
+				t.Errorf("got progress=%v, want %v, with explicit flag", options.Progress, test.want)
+			}
+		})
+	}
+	for _, value := range []string{"yes", "no", "invalid"} {
+		parser, err := New(&Command{Use: "root", Options: &struct{ Progress bool }{}}, io.Discard, io.Discard)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := parser.Parse([]string{"--progress=" + value}); err == nil {
+			t.Errorf("accepted invalid boolean %q", value)
+		}
+	}
+}
+
+func TestIntegerSpellings(t *testing.T) {
+	for _, test := range []struct {
+		value string
+		want  int
+	}{
+		{"4", 4}, {"-1", -1}, {"010", 8}, {"0x10", 16}, {"0b10", 2}, {"1_000", 1000},
+	} {
+		t.Run(test.value, func(t *testing.T) {
+			options := &struct{ Parallel int }{}
+			parser, err := New(&Command{Use: "root", Options: options}, io.Discard, io.Discard)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := parser.Parse([]string{"--parallel=" + test.value}); err != nil {
+				t.Fatal(err)
+			}
+			if options.Parallel != test.want {
+				t.Errorf("got %d, want %d", options.Parallel, test.want)
+			}
+		})
+	}
+}
+
+func TestFlagValueSyntax(t *testing.T) {
+	for _, test := range []struct {
+		args     []string
+		progress bool
+		parallel int
+		version  string
+		set      []string
+	}{
+		{args: []string{"-q=false"}},
+		{args: []string{"-q=T"}, progress: true},
+		{args: []string{"-p=010"}, parallel: 8},
+		{args: []string{"--parallel", "-1"}, parallel: -1},
+		{args: []string{"-p-2"}, parallel: -2},
+		{args: []string{"-v=latest"}, version: "latest"},
+		{args: []string{"--version", "--literal"}, version: "--literal"},
+		{args: []string{"-v=-literal"}, version: "-literal"},
+		{args: []string{"-s=one,two", "--set", "--literal", "--set="}, set: []string{"one,two", "--literal", ""}},
+	} {
+		t.Run(strings.Join(test.args, " "), func(t *testing.T) {
+			options := &struct {
+				Progress bool     `short:"q"`
+				Parallel int      `short:"p"`
+				Version  string   `short:"v"`
+				Set      []string `short:"s" sep:"none"`
+			}{}
+			parser, err := New(&Command{Use: "root", Options: options}, io.Discard, io.Discard)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := parser.Parse(test.args); err != nil {
+				t.Fatal(err)
+			}
+			if options.Progress != test.progress || options.Parallel != test.parallel || options.Version != test.version || !reflect.DeepEqual(options.Set, test.set) {
+				t.Fatalf("parsed options: %+v; want %+v", options, test)
+			}
+		})
+	}
+}
+
+func TestInterspersedFlagsAndArguments(t *testing.T) {
+	options := &struct {
+		Version  string `short:"v"`
+		Progress bool   `default:"true"`
+	}{}
+	var actual []string
+	command := &Command{Use: "root", Options: options, Run: func(context *kong.Context, args []string) error { actual = append([]string{}, args...); return nil }}
+	parser, err := New(command, io.Discard, io.Discard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	context, err := parser.Parse([]string{"first", "--version", "v1", "second", "--progress=false", "third", "--", "--literal", ""})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := context.Run(); err != nil {
+		t.Fatal(err)
+	}
+	expected := []string{"first", "second", "third", "--literal", ""}
+	if !reflect.DeepEqual(actual, expected) || options.Version != "v1" || options.Progress {
+		t.Fatalf("args=%q options=%+v", actual, options)
+	}
+	words := make([]string, 128)
+	for index := range words {
+		words[index] = "value"
+	}
+	context, err = parser.Parse(words)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := context.Run(); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(actual, words) {
+		t.Fatalf("lost arguments: got %d, want %d", len(actual), len(words))
+	}
+}
diff --git a/internal/cli/completion.go b/internal/cli/completion.go
new file mode 100644
index 0000000..4603c57
--- /dev/null
+++ b/internal/cli/completion.go
@@ -0,0 +1,182 @@
+package cli
+
+import (
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+
+	"github.com/alecthomas/kong"
+)
+
+func Complete(context *kong.Context, words []string) []string {
+	node := context.Model.Node
+	prefix := ""
+	if len(words) > 0 {
+		prefix = words[len(words)-1]
+		words = words[:len(words)-1]
+	}
+	flagsFor := func(node *kong.Node) []*kong.Flag {
+		flags := []*kong.Flag{}
+		for current := node; current != nil; current = current.Parent {
+			flags = append(flags, current.Flags...)
+		}
+		if node.DefaultCmd != nil {
+			flags = append(flags, node.DefaultCmd.Flags...)
+		}
+		return flags
+	}
+	positional := false
+	for index := 0; index < len(words); index++ {
+		word := words[index]
+		if strings.HasPrefix(word, "-") {
+			name, _, hasValue := strings.Cut(word, "=")
+			for _, flag := range flagsFor(node) {
+				if name == "--"+flag.Name || (flag.Short != 0 && name == "-"+string(flag.Short)) {
+					if !flag.IsBool() && !hasValue {
+						index++
+						if index == len(words) {
+							return nil
+						}
+					}
+					break
+				}
+			}
+			continue
+		}
+		var selected *kong.Node
+		for _, child := range node.Children {
+			if child.Name == word {
+				selected = child
+				break
+			}
+			for _, alias := range child.Aliases {
+				if alias == word {
+					selected = child
+					break
+				}
+			}
+			if selected != nil {
+				break
+			}
+		}
+		if selected == nil {
+			positional = true
+			continue
+		}
+		node = selected
+	}
+	candidates := []string{}
+	if strings.HasPrefix(prefix, "-") {
+		for _, flag := range flagsFor(node) {
+			if flag.Hidden {
+				continue
+			}
+			candidates = append(candidates, "--"+flag.Name)
+			if flag.Short != 0 {
+				candidates = append(candidates, "-"+string(flag.Short))
+			}
+		}
+	} else {
+		if !positional {
+			for _, child := range node.Children {
+				if !child.Hidden {
+					candidates = append(candidates, child.Name)
+					candidates = append(candidates, child.Aliases...)
+				}
+			}
+		}
+		dispatch := context.Model.Target.Addr().Interface().(*dispatcher)
+		invocation, ok := dispatch.invocations[node]
+		if !ok && node.DefaultCmd != nil {
+			invocation, ok = dispatch.invocations[node.DefaultCmd]
+		}
+		if ok {
+			candidates = append(candidates, invocation.command.ValidArgs...)
+		}
+	}
+	unique := map[string]bool{}
+	result := []string{}
+	for _, candidate := range candidates {
+		if candidate != "" && strings.HasPrefix(candidate, prefix) && !unique[candidate] {
+			result = append(result, candidate)
+			unique[candidate] = true
+		}
+	}
+	sort.Strings(result)
+	return result
+}
+
+func CompletionCommand() *Command {
+	return &Command{Use: "__complete", Hidden: true, Passthrough: true, Run: func(context *kong.Context, words []string) error {
+		for _, candidate := range Complete(context, words) {
+			fmt.Fprintln(context.Stdout, candidate)
+		}
+		return nil
+	}}
+}
+
+func GenerateCompletion(context *kong.Context, shell string, out io.Writer) error {
+	script, ok := completionScripts[shell]
+	if !ok {
+		return fmt.Errorf("shell completion not supported for shell: %s", shell)
+	}
+	if shell == "zsh" {
+		fmt.Fprintln(out, "#compdef arkade")
+	}
+	fmt.Fprintln(out, "# Completion generated from the Kong command tree.")
+	var catalog func(*kong.Node, string)
+	catalog = func(node *kong.Node, path string) {
+		if node.Hidden {
+			return
+		}
+		fmt.Fprintf(out, "# %s (aliases: %s)\n", path, strings.Join(node.Aliases, ", "))
+		for _, child := range node.Children {
+			catalog(child, path+" "+child.Name)
+		}
+	}
+	catalog(context.Model.Node, context.Model.Name)
+	_, err := io.WriteString(out, script)
+	return err
+}
+
+var completionScripts = map[string]string{
+	"bash": `_arkade() {
+    local current="${COMP_WORDS[COMP_CWORD]}"
+    local -a words=("${COMP_WORDS[@]:1:COMP_CWORD-1}")
+    local candidate
+    COMPREPLY=()
+    while IFS= read -r candidate; do
+        COMPREPLY+=("$candidate")
+    done < <("${COMP_WORDS[0]}" __complete -- "${words[@]}" "$current")
+}
+complete -F _arkade arkade
+`,
+	"zsh": `_arkade() {
+    local -a candidates
+    candidates=("${(@f)$("${words[1]}" __complete -- "${(@)words[2,CURRENT-1]}" "${words[CURRENT]}")}")
+    compadd -- "${candidates[@]}"
+}
+compdef _arkade arkade
+`,
+	"fish": `function __arkade_complete
+    set -l words (commandline -opc)
+    set -l current (commandline -ct)
+    command $words[1] __complete -- $words[2..-1] "$current"
+end
+complete -c arkade -f -a '(__arkade_complete)'
+`,
+	"powershell": `Register-ArgumentCompleter -Native -CommandName arkade -ScriptBlock {
+    param($wordToComplete, $commandAst, $cursorPosition)
+    $words = @()
+    foreach ($element in $commandAst.CommandElements | Select-Object -Skip 1) {
+        if ($element.Extent.EndOffset -lt $cursorPosition) {
+            $words += $element.ToString().Trim([char[]]@('"', "'"))
+        }
+    }
+    & arkade __complete -- @words "$wordToComplete" | ForEach-Object {
+        [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
+    }
+}
+`,
+}
diff --git a/internal/cli/mapper.go b/internal/cli/mapper.go
new file mode 100644
index 0000000..be1b1e5
--- /dev/null
+++ b/internal/cli/mapper.go
@@ -0,0 +1,70 @@
+package cli
+
+import (
+	"reflect"
+	"strconv"
+	"strings"
+
+	"github.com/alecthomas/kong"
+)
+
+type booleanMapper struct{}
+
+func (booleanMapper) IsBool() bool { return true }
+
+func (booleanMapper) Decode(context *kong.DecodeContext, target reflect.Value) error {
+	token := context.Scan.Peek()
+	if token.Type != kong.FlagValueToken && !(token.Type == kong.ShortFlagTailToken && strings.HasPrefix(token.String(), "=")) {
+		target.SetBool(true)
+		return nil
+	}
+	text, err := scalarValue(context, "boolean")
+	if err != nil {
+		return err
+	}
+	value, err := strconv.ParseBool(text)
+	if err != nil {
+		return err
+	}
+	target.SetBool(value)
+	return nil
+}
+
+type integerMapper struct{}
+
+func (integerMapper) Decode(context *kong.DecodeContext, target reflect.Value) error {
+	text, err := scalarValue(context, "integer")
+	if err != nil {
+		return err
+	}
+	value, err := strconv.ParseInt(text, 0, 64)
+	if err != nil {
+		return err
+	}
+	target.SetInt(value)
+	return nil
+}
+
+type stringMapper struct{}
+
+func (stringMapper) Decode(context *kong.DecodeContext, target reflect.Value) error {
+	value, err := scalarValue(context, "string")
+	if err != nil {
+		return err
+	}
+	target.SetString(value)
+	return nil
+}
+
+func scalarValue(context *kong.DecodeContext, kind string) (string, error) {
+	if context.Scan.Peek().IsEOL() {
+		_, err := context.Scan.PopValue(kind)
+		return "", err
+	}
+	token := context.Scan.Pop()
+	value := token.String()
+	if token.Type == kong.ShortFlagTailToken {
+		value = strings.TrimPrefix(value, "=")
+	}
+	return value, nil
+}
diff --git a/internal/legacy/command.go b/internal/legacy/command.go
new file mode 100644
index 0000000..6a021f6
--- /dev/null
+++ b/internal/legacy/command.go
@@ -0,0 +1,121 @@
+package legacy
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+
+	"github.com/alecthomas/kong"
+	"github.com/alexellis/arkade/internal/cli"
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+func Command(command *cobra.Command) *cli.Command {
+	fields := []reflect.StructField{}
+	command.Flags().AddFlagSet(command.PersistentFlags())
+	command.Flags().VisitAll(func(flag *pflag.Flag) {
+		var fieldType reflect.Type
+		switch flag.Value.Type() {
+		case "bool":
+			fieldType = reflect.TypeOf(false)
+		case "int":
+			fieldType = reflect.TypeOf(int(0))
+		case "int64":
+			fieldType = reflect.TypeOf(int64(0))
+		case "string":
+			fieldType = reflect.TypeOf("")
+		case "stringArray":
+			fieldType = reflect.TypeOf([]string{})
+		default:
+			panic(fmt.Sprintf("unsupported legacy flag %s: %s", flag.Name, flag.Value.Type()))
+		}
+		required := flag.Annotations[cobra.BashCompOneRequiredFlag]
+		isRequired := len(required) > 0 && required[0] == "true"
+		tags := []string{"name:" + strconv.Quote(flag.Name), "help:" + strconv.Quote(strings.ReplaceAll(flag.Usage, "${", "$${"))}
+		if flag.Value.Type() == "stringArray" {
+			tags = append(tags, `sep:"none"`)
+		} else if !isRequired {
+			tags = append(tags, "default:"+strconv.Quote(strings.ReplaceAll(flag.DefValue, "${", "$${")))
+		}
+		if flag.Shorthand != "" {
+			tags = append(tags, "short:"+strconv.Quote(flag.Shorthand))
+		}
+		if flag.Hidden {
+			tags = append(tags, `hidden:""`)
+		}
+		if isRequired {
+			tags = append(tags, `required:""`)
+		}
+		fields = append(fields, reflect.StructField{Name: fmt.Sprintf("Flag%d", len(fields)), Type: fieldType, Tag: reflect.StructTag(strings.Join(tags, " "))})
+	})
+	options := reflect.New(reflect.StructOf(fields))
+	return &cli.Command{
+		Use: command.Use, Short: command.Short, Long: command.Long, Example: command.Example, Aliases: command.Aliases, Hidden: command.Hidden,
+		Options: options.Interface(), ValidArgs: command.ValidArgs,
+		Run: func(context *kong.Context, args []string) error {
+			command.SetOut(context.Stdout)
+			command.SetErr(context.Stderr)
+			for _, flag := range context.Flags() {
+				if flag.Name == "help" {
+					continue
+				}
+				existing := command.Flags().Lookup(flag.Name)
+				if existing == nil {
+					switch flag.Target.Kind() {
+					case reflect.Bool:
+						command.Flags().Bool(flag.Name, false, flag.Help)
+					case reflect.String:
+						command.Flags().String(flag.Name, "", flag.Help)
+					default:
+						return fmt.Errorf("unsupported inherited flag: %s", flag.Name)
+					}
+					existing = command.Flags().Lookup(flag.Name)
+				}
+				value := context.FlagValue(flag)
+				if slice, ok := value.([]string); ok {
+					if cli.Changed(context, flag.Name) {
+						if err := existing.Value.(pflag.SliceValue).Replace(slice); err != nil {
+							return err
+						}
+					}
+				} else if err := existing.Value.Set(fmt.Sprint(value)); err != nil {
+					return err
+				}
+				existing.Changed = cli.Changed(context, flag.Name)
+				if existing.Deprecated != "" {
+					for _, path := range context.Path {
+						if path.Flag == flag {
+							fmt.Fprintf(context.Stderr, "Flag --%s has been deprecated, %s\n", existing.Name, existing.Deprecated)
+						}
+					}
+				}
+			}
+			if err := command.ValidateArgs(args); err != nil {
+				return err
+			}
+			if command.PreRunE != nil {
+				if err := command.PreRunE(command, args); err != nil {
+					return err
+				}
+			} else if command.PreRun != nil {
+				command.PreRun(command, args)
+			}
+			if command.RunE != nil {
+				if err := command.RunE(command, args); err != nil {
+					return err
+				}
+			} else if command.Run != nil {
+				command.Run(command, args)
+			}
+			if command.PostRunE != nil {
+				return command.PostRunE(command, args)
+			}
+			if command.PostRun != nil {
+				command.PostRun(command, args)
+			}
+			return nil
+		},
+	}
+}
