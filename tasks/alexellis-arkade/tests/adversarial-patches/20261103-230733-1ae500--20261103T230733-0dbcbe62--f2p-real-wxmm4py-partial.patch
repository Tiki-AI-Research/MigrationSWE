+func TestCLICompletionUsesKongTree(t *testing.T) {
+	for _, shell := range []string{"bash", "zsh", "fish", "powershell"} {
+		stdout, stderr, err := invokeCLI(t, "", "completion", shell)
+		if err != nil || stderr != "" || !strings.Contains(stdout, "__complete") || !strings.Contains(stdout, "system install") || !strings.Contains(stdout, "argocd") || !strings.Contains(stdout, "aliases: g, d, download") {
+			t.Fatalf("%s: %v %s %s", shell, err, stdout, stderr)
+		}
+	}
+	cases := []struct {
+		words            []string
+		expected, absent string
+	}{
+		{[]string{""}, "get", "release"},
+		{[]string{"d", "--p"}, "--parallel", "--kubeconfig"},
+		{[]string{"i", ""}, "argocd", "__default"},
+		{[]string{"o", ""}, "extract", ""},
+		{[]string{"s", "i", ""}, "node", ""},
+		{[]string{"i", "argocd", "--"}, "--kubeconfig", "--print-table"},
+		{[]string{"get", "ku"}, "kubectl", ""},
+	}
+	for _, test := range cases {
+		args := append([]string{"__complete", "--"}, test.words...)
+		stdout, stderr, err := invokeCLI(t, "", args...)
+		if err != nil || stderr != "" || !strings.Contains(stdout, test.expected) || (test.absent != "" && strings.Contains(stdout, test.absent)) {
+			t.Errorf("%q: %v %s %s", args, err, stdout, stderr)
+		}
+	}
+	root := rootCommand()
+	root.Children = append(root.Children, &cli.Command{Use: "new-plugin", Short: "A dynamic command"})
+	parser, err := cli.New(root, io.Discard, io.Discard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	context, err := parser.Parse([]string{"completion", "bash"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var output bytes.Buffer
+	if err := cli.GenerateCompletion(context, "bash", &output); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(output.String(), "new-plugin") {
+		t.Fatal("completion does not reflect the live Kong model")
+	}
+}
