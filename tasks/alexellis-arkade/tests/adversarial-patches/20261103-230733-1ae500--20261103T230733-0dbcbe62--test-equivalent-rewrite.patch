+// InstallApp forwards an install invocation to the catalogue.
+type InstallApp struct {
+	Args []string `arg:"" optional:""`
+}
+
+// installAppCatalogName maps a Kong command name to its catalogue key. Most
+// apps share the same name, but two Cobra commands use a canonical name that
+// differs from the historical catalogue key.
+func installAppCatalogName(name string) string {
+	switch name {
+	case "nfs-subdir-external-provisioner":
+		return "nfs-provisioner"
+	case "sealed-secrets":
+		return "sealed-secret"
+	default:
+		return name
+	}
+}
+
+// Run dispatches the selected app.
+func (a *InstallApp) Run(ctx *kong.Context, install *InstallCLI) error {
+	name := installAppCatalogName(ctx.Selected().Name)
+	return runInstallApp(name, a.Args, install.Kubeconfig, install.Wait)
+}
