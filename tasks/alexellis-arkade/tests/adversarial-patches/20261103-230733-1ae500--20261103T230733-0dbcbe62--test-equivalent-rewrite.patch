+// ArkadeApp describes an app which can be installed by arkade.
+//
+// Install is used by apps migrated to neutral Go handlers. Installer is used
+// by the remaining Cobra-based app handlers.
+type ArkadeApp struct {
+	Name        string
+	Short       string
+	InfoMessage string
+	Install     func(kubeconfig string, wait bool) error
+	Installer   func() *cobra.Command
+}
+
+// NewArkadeApp wraps an existing Cobra-based app installer.
+func NewArkadeApp(cmd func() *cobra.Command, msg string) ArkadeApp {
+	return ArkadeApp{
+		Installer:   cmd,
+		InfoMessage: msg,
+	}
+}
+
+// NewNeutralApp creates an app backed by a neutral install handler.
+func NewNeutralApp(name, short, msg string, install func(kubeconfig string, wait bool) error) ArkadeApp {
+	return ArkadeApp{
+		Name:        name,
+		Short:       short,
+		InfoMessage: msg,
+		Install:     install,
+	}
+}
+
+// ShortText returns the app's short description.
+func (a ArkadeApp) ShortText() string {
+	if a.Short != "" {
+		return a.Short
+	}
+	if a.Installer != nil {
+		if c := a.Installer(); c != nil {
+			return c.Short
+		}
+	}
+	return ""
+}
