+func TestInstallAppAliasesResolveToCatalog(t *testing.T) {
+	tests := []struct {
+		invocation string
+		want       string
+	}{
+		{invocation: "ingress-nginx", want: "ingress-nginx"},
+		{invocation: "nginx-ingress", want: "ingress-nginx"},
+		{invocation: "nfs-subdir-external-provisioner", want: "nfs-provisioner"},
+		{invocation: "nfs-client-provisioner", want: "nfs-provisioner"},
+		{invocation: "nfs-provisioner", want: "nfs-provisioner"},
+		{invocation: "opa-gatekeeper", want: "opa-gatekeeper"},
+		{invocation: "gatekeeper", want: "opa-gatekeeper"},
+		{invocation: "qemu-static", want: "qemu-static"},
+		{invocation: "qemu-user-static", want: "qemu-static"},
+		{invocation: "binfmt", want: "qemu-static"},
+		{invocation: "sealed-secrets", want: "sealed-secret"},
+		{invocation: "sealed-secret", want: "sealed-secret"},
+	}
+
+	apps := GetApps()
+	for _, tc := range tests {
+		t.Run(tc.invocation, func(t *testing.T) {
+			_, parser, err := NewRoot()
+			if err != nil {
+				t.Fatalf("NewRoot: %s", err)
+			}
+
+			ctx, err := parser.Parse([]string{"install", tc.invocation})
+			if err != nil {
+				t.Fatalf("parse install %s: %s", tc.invocation, err)
+			}
+
+			got := installAppCatalogName(ctx.Selected().Name)
+			if got != tc.want {
+				t.Fatalf("catalogue name: want %q, got %q", tc.want, got)
+			}
+			if _, ok := apps[got]; !ok {
+				t.Fatalf("catalogue %q does not contain app %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestAllCobraInstallAppsAreMounted(t *testing.T) {
+	for key, app := range GetApps() {
+		if app.Installer == nil {
+			continue
+		}
+
+		command := app.Installer()
+		names := append([]string{command.Name()}, command.Aliases...)
+		for _, name := range names {
+			t.Run(key+"/"+name, func(t *testing.T) {
+				_, parser, err := NewRoot()
+				if err != nil {
+					t.Fatalf("NewRoot: %s", err)
+				}
+
+				ctx, err := parser.Parse([]string{"install", name})
+				if err != nil {
+					t.Fatalf("parse install %s: %s", name, err)
+				}
+
+				got := installAppCatalogName(ctx.Selected().Name)
+				if got != key {
+					t.Fatalf("catalogue name: want %q, got %q", key, got)
+				}
+			})
+		}
+	}
+}
+
+func TestTranslateInstallErrorPreservesToolHint(t *testing.T) {
+	tests := []struct {
+		name string
+		err  string
+	}{
+		{name: "consul", err: `unexpected argument consul, did you mean "consul-connect"?`},
+		{name: "argo", err: `unexpected argument argo, did you mean one of "argocd", "argo-rollouts"?`},
+		{name: "nats", err: `unexpected argument nats, did you mean "nats-connector"?`},
+		{name: "missing", err: `unexpected argument missing`},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := translateInstallError([]string{"install", tc.name}, errors.New(tc.err))
+			if got == nil {
+				t.Fatalf("expected translated error for %q", tc.name)
+			}
+			want := checkForTool(tc.name, get.MakeTools())
+			if got.Error() != want {
+				t.Fatalf("want %q, got %q", want, got.Error())
+			}
+		})
+	}
+}
+
+func TestBashCompletionUsesWordArray(t *testing.T) {
+	_, parser, err := NewRoot()
+	if err != nil {
+		t.Fatalf("NewRoot: %s", err)
+	}
+
+	var buf bytes.Buffer
+	if err := WriteCompletion(parser, "bash", &buf); err != nil {
+		t.Fatalf("WriteCompletion: %s", err)
+	}
+
+	script := buf.String()
+	if strings.Contains(script, `local words="'`) {
+		t.Fatalf("bash completion contains quoted scalar word list:\n%s", script)
+	}
+	if !strings.Contains(script, "local -a words=(") {
+		t.Fatalf("bash completion does not build a word array:\n%s", script)
+	}
+
+	bash, err := exec.LookPath("bash")
+	if err != nil {
+		t.Skip("bash not available")
+	}
+
+	check := script + `
+COMP_WORDS=(arkade arg)
+COMP_CWORD=1
+_arkade_completion
+printf '%s\n' "${COMPREPLY[@]}"
+`
+	out, err := exec.Command(bash, "-c", check).CombinedOutput()
+	if err != nil {
+		t.Fatalf("running completion: %s\n%s", err, out)
+	}
+	if !strings.Contains(string(out), "argocd") {
+		t.Fatalf("completion for %q did not include argocd:\n%s", "arg", out)
+	}
+}
