+// top-level alias "d" resolves to get.
+type RootCLI struct {
+	Install    InstallCLI      `cmd:"" aliases:"i" help:"Install Kubernetes apps from helm charts or YAML files"`
+	Version    VersionCLI      `cmd:"" aliases:"v" help:"Print the version"`
+	Info       InfoCLI         `cmd:"" aliases:"f" help:"Find info about a Kubernetes app"`
+	Update     UpdateCLI       `cmd:"" aliases:"u" help:"Replace the running binary with an updated version"`
+	Get        GetCLI          `cmd:"" aliases:"g,d,download" help:"The get command downloads a tool"`
+	Uninstall  UninstallCLI    `cmd:"" aliases:"delete" help:"Uninstall apps installed with arkade"`
+	Completion CompletionCLI   `cmd:"" help:"Output shell completion for the given shell (bash or zsh)"`
+	Release    ReleaseCLI      `cmd:"" aliases:"rel,r" hidden:"" help:"Create a GitHub release"`
+	Chart      chart.CLI       `cmd:"" aliases:"c" help:"Chart utilities"`
+	Docker     DockerCLI       `cmd:"" aliases:"d" help:"Docker utilities"`
+	Fstail     konglegacy.Leaf `cmd:"" aliases:"ft" passthrough:"" help:"Tail files with optional string matching"`
+	GHA        GHACLI          `cmd:"" help:"GitHub Actions utilities"`
+	System     system.CLI      `cmd:"" aliases:"s" help:"System apps"`
+	Oci        oci.CLI         `cmd:"" aliases:"o" help:"Install files from OCI/container images"`
+	Search     SearchCLI       `cmd:"" help:"Search for a tool available in arkade get"`
+
+	Root RootDefault `cmd:"" name:"__root" hidden:"" default:"1"`
+}
+
+// RootDefault implements the no-subcommand behaviour of the root command.
+type RootDefault struct{}
+
+// Run prints the ASCII art, build information and root help.
+func (r *RootDefault) Run(ctx *kong.Context) error {
+	PrintArkadeASCIIArt()
+	short := "n/a"
+	if len(pkg.GitCommit) > 12 {
+		short = pkg.GitCommit[:12]
+	} else if len(pkg.GitCommit) > 0 {
+		short = pkg.GitCommit
+	}
+	fmt.Printf("Version: %s (%s)\n\n\n", pkg.BuildString(), short)
+
+	return konglegacy.PrintParentUsage(ctx)
+}
+
+// DockerCLI holds the out-of-scope Cobra docker subcommands.
+type DockerCLI struct {
+	Upgrade konglegacy.Leaf `cmd:"" aliases:"u" passthrough:"" help:"Upgrade images in a Dockerfile to the latest version"`
+	Gen     konglegacy.Leaf `cmd:"" passthrough:"" help:"Generate an arkade.yaml from detected images in a Dockerfile"`
+
+	Default konglegacy.Default `cmd:"" name:"__default" hidden:"" default:"1"`
+}
+
+// Run prints usage when docker is invoked without a subcommand.
+func (d *DockerCLI) Run(ctx *kong.Context) error {
+	if !isOwnDefault(ctx, "docker", d) {
+		return nil
+	}
+	return konglegacy.PrintParentUsage(ctx)
+}
+
+// GHACLI holds the out-of-scope Cobra GitHub Actions subcommands.
+type GHACLI struct {
+	Bump konglegacy.Leaf `cmd:"" aliases:"u" passthrough:"" help:"Upgrade actions in GitHub Actions workflow files to the latest versions"`
+
+	Default konglegacy.Default `cmd:"" name:"__default" hidden:"" default:"1"`
+}
+
+// Run prints usage when gha is invoked without a subcommand.
+func (g *GHACLI) Run(ctx *kong.Context) error {
+	if !isOwnDefault(ctx, "gha", g) {
+		return nil
+	}
+	return konglegacy.PrintParentUsage(ctx)
+}
+
+// NewRoot constructs the Kong parser for the complete arkade command tree.
+func NewRoot() (*RootCLI, *kong.Kong, error) {
+	clientArch, clientOS := env.GetClientArch()
+
+	root := &RootCLI{}
+	parser, err := kong.New(root,
+		kong.Name("arkade"),
+		kong.Description("Open Source Marketplace For Developer Tools"),
+		kong.Vars{
+			"clientArch": clientArch,
+			"clientOS":   clientOS,
+		},
+	)
+	if err != nil {
+		return nil, nil, err
+	}
+	return root, parser, nil
+}
+
+type exitRequest int
+
+// Run parses args with Kong, dispatches the selected command and returns any
+// command error to the caller.
+func Run(args []string) (err error) {
+	_, parser, err := NewRoot()
+	if err != nil {
+		return err
+	}
+
+	// Kong terminates the process for --help. Convert that into a normal
+	// return so the CLI remains testable in-process.
+	parser.Exit = func(code int) { panic(exitRequest(code)) }
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			request, ok := recovered.(exitRequest)
+			if !ok {
+				panic(recovered)
+			}
+			if request != 0 {
+				err = fmt.Errorf("exit status %d", int(request))
+			}
+		}
+	}()
+
+	ctx, err := parser.Parse(args)
+	if err != nil {
+		if translated := translateInstallError(args, err); translated != nil {
+			return translated
+		}
+		return err
+	}
+	return ctx.Run()
+}
+
+// RunCLI is a small helper used by tests to execute a fresh Kong root.
+func RunCLI(args ...string) error {
+	return Run(args)
+}
+
+func isOwnDefault(ctx *kong.Context, name string, target any) bool {
+	selected := ctx.Selected()
+	if selected == nil {
+		return false
+	}
+	if selected.Name == name {
+		return true
+	}
+	if selected.Name != "__default" || selected.Parent == nil {
+		return false
+	}
+	return selected.Parent.Target.Addr().Interface() == target
+}
+
+// translateInstallError maps Kong's "unexpected argument" error for an
+// unknown install app back to the historical arkade error message.
+func translateInstallError(args []string, err error) error {
+	if len(args) == 0 || (args[0] != "install" && args[0] != "i") {
+		return nil
+	}
+	msg := err.Error()
+	const marker = "unexpected argument "
+	idx := strings.Index(msg, marker)
+	if idx < 0 {
+		return nil
+	}
+	rest := strings.TrimSpace(msg[idx+len(marker):])
+	// Kong appends ", did you mean ...?" for near matches, so isolate the
+	// original token before parsing it.
+	rest = strings.TrimSpace(strings.SplitN(rest, ",", 2)[0])
+	parts := strings.Fields(rest)
+	if len(parts) == 0 {
+		return nil
+	}
+	name := strings.Trim(parts[0], "\"'")
+	if name == "" || strings.HasPrefix(name, "-") {
+		return nil
+	}
+	if _, ok := GetApps()[name]; ok {
+		return nil
+	}
+	if name == "info" || name == "f" {
+		return nil
+	}
+	return errors.New(checkForTool(name, get.MakeTools()))
+}
+
+var legacyConstructors map[string]func() *cobra.Command
+
+func init() {
+	RegisterLegacyCommands()
+	konglegacy.SetExecutor(executeLegacy)
+}
+
+// RegisterLegacyCommands registers the out-of-scope Cobra commands that are
+// mounted as passthrough leaf nodes under the Kong root.
+func RegisterLegacyCommands() {
+	legacyConstructors = map[string]func() *cobra.Command{
+		"chart verify":  chart.MakeVerify,
+		"chart upgrade": chart.MakeUpgrade,
+		"chart bump":    chart.MakeBump,
+
+		"docker upgrade": docker.MakeUpgrade,
+		"docker gen":     docker.MakeGen,
+
+		"fstail": fstail.MakeFstail,
+
+		"gha bump": gha.MakeBump,
+
+		"system install go":               system.MakeInstallGo,
+		"system install firecracker":      system.MakeInstallFirecracker,
+		"system install prometheus":       system.MakeInstallPrometheus,
+		"system install cni":              system.MakeInstallCNI,
+		"system install containerd":       system.MakeInstallContainerd,
+		"system install actions-runner":   system.MakeInstallActionsRunner,
+		"system install node":             system.MakeInstallNode,
+		"system install tc-redirect-tap":  system.MakeInstallTCRedirectTap,
+		"system install gitlab-runner":    system.MakeInstallGitLabRunner,
+		"system install buildkitd":        system.MakeInstallBuildkitd,
+		"system install pwsh":             system.MakeInstallPowershell,
+		"system install caddy":            system.MakeInstallCaddyServer,
+		"system install zvol-snapshotter": system.MakeInstallZvolSnapshotter,
+		"system install node_exporter":    system.MakeInstallNodeExporter,
+
+		"oci publish": oci.MakeOciPublish,
+		"oci login":   oci.MakeOciLogin,
+	}
+}
+
+func executeLegacy(path string, args []string) error {
+	make, ok := legacyConstructors[path]
+	if !ok {
+		return fmt.Errorf("unknown legacy command: %s", path)
+	}
+
+	command := make()
+	command.SetArgs(args)
+	command.SetOut(os.Stdout)
+	command.SetErr(os.Stderr)
+	command.SilenceErrors = true
+	return command.Execute()
+}
+
+func runInstallApp(name string, args []string, kubeconfig string, wait bool) error {
+	app, ok := GetApps()[name]
+	if !ok {
+		return fmt.Errorf("no such app: %s, run \"arkade install --help\" for a list of apps", name)
+	}
+
+	if app.Install != nil {
+		kc, waitValue, wantHelp, err := parseNeutralInstallArgs(args, kubeconfig, wait)
+		if err != nil {
+			return err
+		}
+		if wantHelp {
+			fmt.Printf("Usage: arkade install %s [--kubeconfig PATH] [--wait]\n\n%s\n", name, app.ShortText())
+			return nil
+		}
+		return app.Install(kc, waitValue)
+	}
+	if app.Installer == nil {
+		return fmt.Errorf("app %s has no installer", name)
+	}
+
+	command := app.Installer()
+	if command.Flags().Lookup("kubeconfig") == nil {
+		command.Flags().String("kubeconfig", kubeconfig, "Local path for your kubeconfig file")
+	}
+	if command.Flags().Lookup("wait") == nil {
+		command.Flags().Bool("wait", wait, "If we should wait for the resource to be ready before returning (helm3 only, default false)")
+	}
+	command.SetArgs(args)
+	command.SetOut(os.Stdout)
+	command.SetErr(os.Stderr)
+	command.SilenceErrors = true
+	return command.Execute()
+}
+
+// parseNeutralInstallArgs emulates the inherited Cobra flags for the neutral
+// app handlers, rejecting flags unknown to those apps.
+func parseNeutralInstallArgs(args []string, kubeconfig string, wait bool) (string, bool, bool, error) {
+	wantHelp := false
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+		switch {
+		case arg == "--kubeconfig":
+			if i+1 >= len(args) {
+				return "", false, false, fmt.Errorf("flag needs an argument: --kubeconfig")
+			}
+			i++
+			kubeconfig = args[i]
+		case strings.HasPrefix(arg, "--kubeconfig="):
+			kubeconfig = strings.TrimPrefix(arg, "--kubeconfig=")
+		case arg == "--wait":
+			wait = true
+		case strings.HasPrefix(arg, "--wait="):
+			value := strings.TrimPrefix(arg, "--wait=")
+			parsed, err := strconv.ParseBool(value)
+			if err != nil {
+				return "", false, false, fmt.Errorf("invalid boolean value %q for --wait", value)
+			}
+			wait = parsed
+		case arg == "--help" || arg == "-h":
+			wantHelp = true
+		case strings.HasPrefix(arg, "-"):
+			return "", false, false, fmt.Errorf("unknown flag: %s", arg)
+		}
+	}
+	return kubeconfig, wait, wantHelp, nil
+}
