index 0000000..ca6b246
--- /dev/null
+++ b/internal/konglegacy/legacy.go
@@ -0,0 +1,67 @@
+// Copyright (c) arkade author(s) 2022. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+// Package konglegacy provides the neutral boundary used to execute the
+// Cobra-based commands which are outside the scope of the Kong migration.
+package konglegacy
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/alecthomas/kong"
+)
+
+// Executor runs a legacy command identified by its canonical command path.
+type Executor func(path string, args []string) error
+
+var executor Executor
+
+// SetExecutor installs the function used by Leaf to execute legacy commands.
+func SetExecutor(fn Executor) {
+	executor = fn
+}
+
+// Leaf is a Kong leaf command which forwards all remaining arguments to a
+// legacy Cobra command. The command path is derived from the Kong model, so
+// the same type can be reused for every legacy subcommand.
+type Leaf struct {
+	Args []string `arg:"" optional:""`
+}
+
+// Run dispatches the legacy command.
+func (l *Leaf) Run(ctx *kong.Context) error {
+	if executor == nil {
+		return fmt.Errorf("legacy command executor is not configured")
+	}
+	return executor(CanonicalPath(ctx.Selected()), l.Args)
+}
+
+// Default is a hidden no-op command used to let a parent node handle the
+// no-subcommand case while still satisfying Kong's child validation.
+type Default struct{}
+
+// CanonicalPath returns the canonical command path, excluding the application
+// root, alias annotations and hidden default nodes.
+func CanonicalPath(node *kong.Node) string {
+	parts := []string{}
+	for n := node; n != nil; n = n.Parent {
+		if n.Type != kong.CommandNode || n.Name == "__default" {
+			continue
+		}
+		parts = append([]string{n.Name}, parts...)
+	}
+	return strings.Join(parts, " ")
+}
+
+// PrintParentUsage prints help for the parent of the currently selected
+// hidden default command.
+func PrintParentUsage(ctx *kong.Context) error {
+	saved := ctx.Path
+	if len(saved) > 1 {
+		ctx.Path = saved[:len(saved)-1]
+	}
+	err := ctx.PrintUsage(false)
+	ctx.Path = saved
+	return err
+}
