+#!/usr/bin/env python3
+"""Side-agnostic F2P probes for BATCH-F2P-0001.
+
+Usage:
+    probe.py <repo-dir> <arkade-binary> [source|target]
+
+The same predicate is evaluated for both sides.  The optional side argument
+only decides the exit status: source must observe FAIL for every observation
+and target must observe PASS for every observation.
+"""
+
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+IN_SCOPE = [
+    "main.go",
+    "cmd/get.go",
+    "cmd/install.go",
+    "cmd/info.go",
+    "cmd/update.go",
+    "cmd/uninstall.go",
+    "cmd/version.go",
+    "cmd/search.go",
+    "cmd/completion.go",
+    "cmd/release.go",
+    "cmd/chart/chart.go",
+    "cmd/system/system.go",
+    "cmd/system/install.go",
+    "cmd/oci/oci.go",
+    "cmd/oci/install.go",
+    "cmd/apps/argocd_app.go",
+]
+
+KONG_MARKER = "Show context-sensitive help."
+KONG_MODULE_RE = re.compile(r"github\.com/alecthomas/kong\s+v1\.8\.1")
+MSG_TOOL_HINT = 'no such app. kubectl is available as a tool, run "arkade get kubectl" to get it'
+MSG_UNKNOWN_APP = 'no such app: does-not-exist, run "arkade install --help" for a list of apps'
+
+REPO = os.path.abspath(sys.argv[1])
+BIN = os.path.abspath(sys.argv[2])
+SIDE = sys.argv[3] if len(sys.argv) > 3 else None
+HOME = tempfile.mkdtemp(prefix="arkade-f2p-")
+ENV = os.environ.copy()
+ENV["HOME"] = HOME
+ENV["NO_COLOR"] = "1"
+
+
+def run(args, timeout=90, stdin=None):
+    proc = subprocess.run(
+        [BIN] + list(args),
+        input=stdin,
+        capture_output=True,
+        text=True,
+        env=ENV,
+        timeout=timeout,
+    )
+    return proc.returncode, proc.stdout, proc.stderr
+
+
+def read(rel):
+    with open(os.path.join(REPO, rel), "r", encoding="utf-8") as handle:
+        return handle.read()
+
+
+def static_absent(tokens):
+    hits = []
+    for rel in IN_SCOPE:
+        text = read(rel)
+        for token in tokens:
+            if token in text:
+                hits.append("%s:%s" % (rel, token))
+    return hits
+
+
+def kong_linked():
+    proc = subprocess.run(
+        ["go", "version", "-m", BIN],
+        capture_output=True,
+        text=True,
+        cwd=REPO,
+        env=ENV,
+    )
+    return bool(KONG_MODULE_RE.search(proc.stdout))
+
+
+def all_in(text, needles):
+    return all(needle in text for needle in needles)
+
+
+def check_f2p_001():
+    rc1, out1, err1 = run(["install", "kubectl"])
+    rc2, out2, err2 = run(["install", "does-not-exist"])
+    ok = (
+        rc1 != 0
+        and out1.strip() == ""
+        and err1.strip() == MSG_TOOL_HINT
+        and rc2 != 0
+        and out2.strip() == ""
+        and err2.strip() == MSG_UNKNOWN_APP
+        and kong_linked()
+    )
+    return ok, "kubectl=%r/%r does-not-exist=%r/%r kong=%s" % (
+        rc1, err1.strip(), rc2, err2.strip(), kong_linked())
+
+
+def check_f2p_002():
+    rc, out, err = run(["--help"])
+    release_hidden = rc == 0 and "Create a GitHub release" not in out + err
+    rc_r, out_r, _ = run(["r", "--help"])
+    rc_rel, out_rel, _ = run(["rel", "--help"])
+    aliases = (
+        rc_r == 0
+        and rc_rel == 0
+        and "Create a GitHub release" in out_r
+        and "Create a GitHub release" in out_rel
+    )
+    return release_hidden and aliases and KONG_MARKER in out and kong_linked(), \
+        "root_rc=%d hidden=%s r=%d rel=%d kong_marker=%s" % (
+            rc, release_hidden, rc_r, rc_rel, KONG_MARKER in out)
+
+
+def check_f2p_003():
+    rc, out, err = run([])
+    ok = (
+        rc == 0
+        and "Version:" in out
+        and all_in(out, ["install", "get", "completion"])
+        and KONG_MARKER in out
+        and kong_linked()
+    )
+    return ok, "rc=%d version=%s tokens=%s kong_marker=%s" % (
+        rc, "Version:" in out,
+        all_in(out, ["install", "get", "completion"]), KONG_MARKER in out)
+
+
+def check_f2p_004():
+    hits = static_absent(["github.com/spf13/cobra"])
+    kong_import = any("github.com/alecthomas/kong" in read(rel) for rel in IN_SCOPE)
+    ok = not hits and kong_import and kong_linked()
+    return ok, "cobra_hits=%s kong_import=%s" % (hits, kong_import)
+
+
+def check_f2p_005():
+    rc1, out1, _ = run(["get", "--help"])
+    rc2, out2, _ = run(["get", "--format", "list"])
+    ok = (
