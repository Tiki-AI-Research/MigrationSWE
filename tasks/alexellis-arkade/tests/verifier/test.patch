+  case "$1" in
+    *.json) out="$1" ;;
+    *) repo="$1" ;;
+  esac
+fi
+if [ "$#" -ge 2 ]; then
+  out="$2"
+fi
+exec python3 "$shared" --repo "$repo" --out "$out"
