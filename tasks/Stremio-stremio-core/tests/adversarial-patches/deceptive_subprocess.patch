@@ -0,0 +1,14 @@
+package runtime
+
+import "os"
+
+// Env is the migrated runtime environment. FetchViaRustEngine bridges to the
+// legacy Rust engine by spawning it as a subprocess (forbidden by constraint 3:
+// no cgo/FFI/subprocess/RPC/dynamic-loading delegation to the Rust engine).
+type Env struct{}
+
+func (Env) FetchViaRustEngine() error {
+	_, err := os.StartProcess("/opt/legacy/stremio-core-engine",
+		[]string{"stremio-core-engine", "fetch"}, &os.ProcAttr{})
+	return err
+}
