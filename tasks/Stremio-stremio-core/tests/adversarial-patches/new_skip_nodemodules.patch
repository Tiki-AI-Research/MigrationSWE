new file mode 100644
index 0000000..50d7d1b
--- /dev/null
+++ b/deep_links/deep_links.go
@@ -0,0 +1,56 @@
+package deep_links
+
+import (
+	"net/url"
+	"strings"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+// SearchHistoryItemDeepLinks carries the search deep link for a query.
+type SearchHistoryItemDeepLinks struct {
+	Search string
+}
+
+// NewSearchHistoryItemDeepLinks builds the search deep link for a query.
+func NewSearchHistoryItemDeepLinks(query string) SearchHistoryItemDeepLinks {
+	return SearchHistoryItemDeepLinks{Search: "stremio:///search?query=" + pct(query)}
+}
+
+// DiscoverDeepLinks carries the discover deep link for a request.
+type DiscoverDeepLinks struct {
+	Discover string
+}
+
+// NewDiscoverDeepLinks builds the discover deep link for a resource request.
+func NewDiscoverDeepLinks(request types.ResourceRequest) DiscoverDeepLinks {
+	target := "stremio:///discover/" + url.QueryEscape(request.Base) + "/" +
+		request.Path.Type + "/" + request.Path.ID
+	if extra := encodeExtra(request.Path.Extra); extra != "" {
+		target += "?" + extra
+	}
+	return DiscoverDeepLinks{Discover: target}
+}
+
+// MetaItemDeepLinks carries the meta-details deep link for an item.
+type MetaItemDeepLinks struct {
+	MetaDetailsVideos *string
+}
+
+// NewMetaItemDeepLinks builds the meta-details deep link for an item.
+func NewMetaItemDeepLinks(mediaType, id string) MetaItemDeepLinks {
+	value := "stremio:///detail/" + mediaType + "/" + id
+	return MetaItemDeepLinks{MetaDetailsVideos: &value}
+}
+
+func pct(value string) string {
+	return strings.ReplaceAll(url.QueryEscape(value), "+", "%20")
+}
+
+func encodeExtra(values []types.ExtraValue) string {
+	parts := make([]string, 0, len(values))
+	for _, item := range values {
+		parts = append(parts, pct(item.Name)+"="+pct(item.Value))
+	}
+	return strings.Join(parts, "&")
+}
