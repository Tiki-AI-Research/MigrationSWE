@@ -0,0 +1,45 @@
+package analytics
+
+// Event is a single analytics event.
+type Event struct {
+	Name  string
+	Props map[string]any
+}
+
+// Batch is a batch of analytics events.
+type Batch struct {
+	Events []Event
+}
+
+// Analytics is a minimal batching analytics client.
+type Analytics struct {
+	env   any
+	send  func(Batch) error
+	queue []Batch
+}
+
+// New builds an analytics client over an environment and a send callback.
+func New(env any, send func(Batch) error) *Analytics {
+	return &Analytics{env: env, send: send}
+}
+
+// Emit queues an event batch when an auth key is present.
+func (a *Analytics) Emit(name string, props map[string]any, auth string, extra any) {
+	if auth == "" {
+		return
+	}
+	a.queue = append(a.queue, Batch{Events: []Event{{Name: name, Props: props}}})
+}
+
+// QueueLen returns the number of queued batches.
+func (a *Analytics) QueueLen() int { return len(a.queue) }
+
+// Flush sends every queued batch through the callback.
+func (a *Analytics) Flush() {
+	for _, batch := range a.queue {
+		if a.send != nil {
+			_ = a.send(batch)
+		}
+	}
+	a.queue = nil
+}
