+package runtime
+
+import "strconv"
+
+// EnvError is the wire-compatible environment error.
+type EnvError struct {
+	Code    int    `json:"code"`
+	Message string `json:"message"`
+}
+
+func (e *EnvError) Error() string { return e.Message }
+
+func EnvErrorFetch(cause string) *EnvError      { return &EnvError{1, "Failed to fetch: " + cause} }
+func EnvErrorAddonTransport(cause string) *EnvError { return &EnvError{2, "AddonTransport error: " + cause} }
+func EnvErrorSerde(cause string) *EnvError      { return &EnvError{3, "Serde error: " + cause} }
+func EnvErrorStorageUnavailable() *EnvError     { return &EnvError{4, "Storage unavailable"} }
+func EnvErrorStorageSchemaVersionDowngrade(from, to int) *EnvError {
+	return &EnvError{5, "Downgrade storage schema version from " + strconv.Itoa(from) + " to " + strconv.Itoa(to) + " is not allowed"}
+}
+func EnvErrorStorageSchemaVersionUpgrade(cause *EnvError) *EnvError {
+	return &EnvError{6, "Upgrade storage schema version failed: " + cause.Error()}
+}
+func EnvErrorStorageReadError(cause string) *EnvError  { return &EnvError{7, "Storage read error: " + cause} }
+func EnvErrorStorageWriteError(cause string) *EnvError { return &EnvError{8, "Storage write error: " + cause} }
+func EnvErrorOther(cause string) *EnvError             { return &EnvError{1001, "Other error: " + cause} }
