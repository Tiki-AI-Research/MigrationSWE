new file mode 100644
index 0000000..889b05d
--- /dev/null
+++ b/types/query_params_encode.go
@@ -0,0 +1,25 @@
+package types
+
+import (
+	"net/url"
+	"strings"
+)
+
+// QueryPair is a single key/value query parameter.
+type QueryPair struct {
+	Key   string
+	Value string
+}
+
+func pctEncode(value string) string {
+	return strings.ReplaceAll(url.QueryEscape(value), "+", "%20")
+}
+
+// QueryParamsEncode encodes pairs with percent-encoded spaces (never '+').
+func QueryParamsEncode(pairs []QueryPair) string {
+	parts := make([]string, 0, len(pairs))
+	for _, pair := range pairs {
+		parts = append(parts, pctEncode(pair.Key)+"="+pctEncode(pair.Value))
+	}
+	return strings.Join(parts, "&")
+}
