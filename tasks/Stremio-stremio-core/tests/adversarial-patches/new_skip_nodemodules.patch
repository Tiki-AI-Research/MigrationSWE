+package addon_transport
+
+import (
+	"strconv"
+
+	"github.com/stremio/stremio-core/runtime"
+)
+
+// LegacyErrKind enumerates legacy transport error kinds.
+type LegacyErrKind int
+
+// LegacyJSONRPC is the JSON-RPC error kind.
+const LegacyJSONRPC LegacyErrKind = 0
+
+// LegacyErr is a legacy transport error.
+type LegacyErr struct {
+	Kind    LegacyErrKind
+	Code    int
+	Message string
+}
+
+// ToEnvError maps a legacy error onto the runtime EnvError contract.
+func (e *LegacyErr) ToEnvError() *runtime.EnvError {
+	return &runtime.EnvError{
+		Code:    2,
+		Message: "Addon protocol violation: rpc error " + strconv.Itoa(e.Code) + ": " + e.Message,
+	}
+}
