+func (s *StreamingServer) playOnDevice(base, device, source string, time *uint64) runtime.Effects {
+	seconds := uint64(0)
+	if time != nil {
+		seconds = *time
+	}
+	body, _ := json.Marshal(struct {
+		Source string `json:"source"`
+		Time   uint64 `json:"time"`
+	}{Source: source, Time: seconds})
+	url := joinURL(base, "casting/"+device+"/player")
+	return s.request("POST", url, body, func(raw []byte, envErr *runtime.EnvError) *msg.Msg {
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerPlayOnDeviceResult,
+			playOnDeviceResult{Device: device, Err: envErrToError(envErr)}))
+	})
+}
+
+func (s *StreamingServer) getHTTPSEndpoint(base string, authKey types.AuthKey, ipAddress string) runtime.Effects {
+	url := joinURL(base, "get-https?authKey="+string(authKey)+"&ipAddress="+ipAddress)
+	return s.request("GET", url, nil, func(raw []byte, envErr *runtime.EnvError) *msg.Msg {
+		data := getHTTPSResult{URL: base, Err: envErrToError(envErr)}
+		if envErr == nil {
+			var response types.GetHTTPSResponse
+			if err := json.Unmarshal(raw, &response); err != nil {
+				data.Err = runtime.EnvErrorSerde(err.Error())
+			} else {
+				data.Response = &response
+			}
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerGetHTTPSResult, data))
+	})
+}
+
+func (s *StreamingServer) updateRemoteURL(c *ctx.Ctx, settings types.StreamingServerSettings) runtime.Effects {
+	if settings.RemoteHTTPS != nil && *settings.RemoteHTTPS != "" && c != nil {
+		if authKey := c.Profile.GetAuthKey(); authKey != nil {
+			return s.getHTTPSEndpoint(s.serverURL(c), *authKey, *settings.RemoteHTTPS).Unchanged()
+		}
+	}
+	return common.EqUpdate(&s.RemoteURL, (*string)(nil))
+}
+
+func (s *StreamingServer) request(method, url string, body []byte, makeMsg func(raw []byte, envErr *runtime.EnvError) *msg.Msg) runtime.Effects {
+	env := s.Env
+	return runtime.FutureEffectSet(runtime.ConcurrentFuture(func() *msg.Msg {
+		if env == nil {
+			return makeMsg(nil, runtime.EnvErrorOther("no environment"))
+		}
+		raw, envErr := env.Fetch(method, url, map[string]string{"Content-Type": "application/json"}, body)
+		return makeMsg(raw, envErr)
+	}))
+}
+
+// envErrToError avoids storing a typed-nil *EnvError in an error interface.
+func envErrToError(e *runtime.EnvError) error {
+	if e == nil {
+		return nil
+	}
+	return e
+}
+
+func joinURL(base, path string) string {
+	if len(base) > 0 && base[len(base)-1] == '/' {
+		return base + path
+	}
+	return base + "/" + path
+}
+
+func looksLikeURL(source string) bool {
+	return strings.HasPrefix(source, "http://") || strings.HasPrefix(source, "https://")
+}
+
+// parseMagnet extracts the info hash and announce list from a magnet url.
+func parseMagnet(magnet string) (types.InfoHash, []string, error) {
+	var infoHash types.InfoHash
+	query := magnet
+	if idx := strings.Index(magnet, "?"); idx >= 0 {
+		query = magnet[idx+1:]
+	}
+	var btih string
+	var announce []string
+	for _, pair := range strings.Split(query, "&") {
+		parts := strings.SplitN(pair, "=", 2)
+		if len(parts) != 2 {
+			continue
+		}
+		key := parts[0]
+		value := parts[1]
+		switch key {
+		case "xt":
+			if strings.HasPrefix(value, "urn:btih:") {
+				btih = strings.TrimPrefix(value, "urn:btih:")
+			}
+		case "tr":
+			decoded := percentDecode(value)
+			announce = append(announce, decoded)
+		}
+	}
+	if btih == "" {
+		return infoHash, nil, errInvalidMagnet
+	}
+	decoded, err := decodeInfoHash(btih)
+	if err != nil {
+		return infoHash, nil, err
+	}
+	return decoded, announce, nil
+}
+
+var errInvalidMagnet = errString("invalid magnet url")
+
+type errString string
+
+func (e errString) Error() string { return string(e) }
+
+func decodeInfoHash(hash string) (types.InfoHash, error) {
+	var out types.InfoHash
+	trimmed := strings.TrimSpace(hash)
+	switch len(trimmed) {
+	case 32, 52:
+		decoded, err := base32.StdEncoding.WithPadding(base32.NoPadding).DecodeString(strings.ToUpper(trimmed))
+		if err != nil {
+			return out, err
+		}
+		if len(decoded) != 20 {
+			return out, errInvalidMagnet
+		}
+		copy(out[:], decoded)
+	case 40, 64:
+		decoded, err := hex.DecodeString(trimmed)
+		if err != nil {
+			return out, err
+		}
+		if len(decoded) != 20 {
+			return out, errInvalidMagnet
+		}
+		copy(out[:], decoded)
+	default:
+		return out, errInvalidMagnet
+	}
+	return out, nil
+}
+
+func percentDecode(value string) string {
+	if !strings.Contains(value, "%") {
+		return value
+	}
+	var sb strings.Builder
+	for i := 0; i < len(value); i++ {
+		if value[i] == '%' && i+2 < len(value) {
+			if b, err := strconv.ParseUint(value[i+1:i+3], 16, 8); err == nil {
+				sb.WriteByte(byte(b))
+				i += 2
+				continue
+			}
+		}
+		sb.WriteByte(value[i])
+	}
+	return sb.String()
+}
+
+// parseTorrentInfoHash computes the SHA-1 info hash of a bencoded torrent.
+func parseTorrentInfoHash(data []byte) (types.InfoHash, error) {
+	var out types.InfoHash
+	infoBytes, err := bencodeFindValue(data, "info")
+	if err != nil {
+		return out, err
+	}
+	sum := sha1.Sum(infoBytes)
+	copy(out[:], sum[:])
+	return out, nil
+}
+
+// bencodeFindValue returns the raw bencoded bytes of the value stored under key
+// in the top-level dictionary.
+func bencodeFindValue(data []byte, key string) ([]byte, error) {
+	if len(data) == 0 || data[0] != 'd' {
+		return nil, errString("torrent is not a dictionary")
+	}
+	pos := 1
+	for pos < len(data) && data[pos] != 'e' {
+		k, next, err := bencodeReadString(data, pos)
+		if err != nil {
+			return nil, err
+		}
+		valueStart := next
+		valueEnd, err := bencodeSkip(data, next)
+		if err != nil {
+			return nil, err
+		}
+		if string(k) == key {
+			return data[valueStart:valueEnd], nil
+		}
+		pos = valueEnd
+	}
+	return nil, errString("torrent info dictionary missing")
+}
+
+func bencodeReadString(data []byte, pos int) ([]byte, int, error) {
+	colon := pos
+	for colon < len(data) && data[colon] != ':' {
+		colon++
+	}
+	if colon >= len(data) {
+		return nil, 0, errString("invalid bencode string")
+	}
+	length, err := strconv.Atoi(string(data[pos:colon]))
+	if err != nil || colon+1+length > len(data) {
+		return nil, 0, errString("invalid bencode string")
+	}
+	return data[colon+1 : colon+1+length], colon + 1 + length, nil
+}
+
+func bencodeSkip(data []byte, pos int) (int, error) {
+	if pos >= len(data) {
+		return 0, errString("invalid bencode value")
+	}
+	switch data[pos] {
+	case 'i':
+		pos++
+		for pos < len(data) && data[pos] != 'e' {
+			pos++
+		}
+		if pos >= len(data) {
+			return 0, errString("invalid bencode integer")
+		}
+		return pos + 1, nil
+	case 'l':
+		pos++
+		for pos < len(data) && data[pos] != 'e' {
+			next, err := bencodeSkip(data, pos)
+			if err != nil {
+				return 0, err
+			}
+			pos = next
+		}
+		if pos >= len(data) {
+			return 0, errString("invalid bencode list")
+		}
+		return pos + 1, nil
+	case 'd':
+		pos++
+		for pos < len(data) && data[pos] != 'e' {
+			_, keyNext, err := bencodeReadString(data, pos)
+			if err != nil {
+				return 0, err
+			}
+			valueNext, err := bencodeSkip(data, keyNext)
+			if err != nil {
+				return 0, err
+			}
+			pos = valueNext
+		}
+		if pos >= len(data) {
+			return 0, errString("invalid bencode dictionary")
+		}
+		return pos + 1, nil
+	default:
+		_, next, err := bencodeReadString(data, pos)
+		return next, err
+	}
+}
diff --git a/runtime/effects.go b/runtime/effects.go
new file mode 100644
index 0000000..2cba697
--- /dev/null
+++ b/runtime/effects.go
@@ -0,0 +1,105 @@
+// Package runtime implements the single-directional update/effects runtime and
+// the abstractions (Env, Model, Effects, EnvError) it is built upon.
+package runtime
+
+import "github.com/stremio/stremio-core/runtime/msg"
+
+// EffectFuture is a deferred computation that resolves to a message.
+type EffectFuture struct {
+	// Concurrent selects Env::exec_concurrent when true, Env::exec_sequential
+	// otherwise.
+	Concurrent bool
+	// Run resolves the future to a message.
+	Run func() *msg.Msg
+}
+
+// SequentialFuture builds a sequentially scheduled future.
+func SequentialFuture(run func() *msg.Msg) EffectFuture {
+	return EffectFuture{Concurrent: false, Run: run}
+}
+
+// ConcurrentFuture builds a concurrently scheduled future.
+func ConcurrentFuture(run func() *msg.Msg) EffectFuture {
+	return EffectFuture{Concurrent: true, Run: run}
+}
+
+// Effect is either an immediate message or a future.
+type Effect struct {
+	Msg    *msg.Msg
+	Future *EffectFuture
+}
+
+// MsgEffect builds an effect from a message.
+func MsgEffect(m *msg.Msg) Effect { return Effect{Msg: m} }
+
+// FutureEffect builds an effect from a future.
+func FutureEffect(f EffectFuture) Effect { return Effect{Future: &f} }
+
+// Effects is a collection of effects together with a `HasChanged` flag.
+//
+// When HasChanged is true the model field producing the effects is marked as
+// changed, which triggers a RuntimeEvent of type NewState.
+type Effects struct {
+	Effects    []Effect
+	HasChanged bool
+}
+
+// None returns an empty changed effect set.
+func None() Effects { return Effects{Effects: []Effect{}, HasChanged: true} }
+
+// One returns an effect set with a single effect.
+func One(e Effect) Effects { return Effects{Effects: []Effect{e}, HasChanged: true} }
+
+// Many returns an effect set with the given effects.
+func Many(effects []Effect) Effects {
+	if effects == nil {
+		effects = []Effect{}
+	}
+	return Effects{Effects: effects, HasChanged: true}
+}
+
+// MsgEffectSet wraps a message as an effect set.
+func MsgEffectSet(m *msg.Msg) Effects { return One(MsgEffect(m)) }
+
+// FutureEffectSet wraps a future as an effect set.
+func FutureEffectSet(f EffectFuture) Effects { return One(FutureEffect(f)) }
+
+// Msgs wraps multiple messages.
+func Msgs(msgs []*msg.Msg) Effects {
+	effects := make([]Effect, 0, len(msgs))
+	for _, m := range msgs {
+		effects = append(effects, MsgEffect(m))
+	}
+	return Many(effects)
+}
+
+// Futures wraps multiple futures.
+func Futures(futures []EffectFuture) Effects {
+	effects := make([]Effect, 0, len(futures))
+	for i := range futures {
+		effects = append(effects, FutureEffect(futures[i]))
+	}
+	return Many(effects)
+}
+
+// Unchanged marks the effect set as not changing the model.
+func (e Effects) Unchanged() Effects {
+	e.HasChanged = false
+	return e
+}
+
+// Join concatenates two effect sets, OR-ing their HasChanged flags.
+func (e Effects) Join(other Effects) Effects {
+	e.HasChanged = e.HasChanged || other.HasChanged
+	e.Effects = append(e.Effects, other.Effects...)
+	return e
+}
+
+// Len returns the amount of effects.
+func (e Effects) Len() int { return len(e.Effects) }
+
+// IsEmpty reports whether there are any effects.
+func (e Effects) IsEmpty() bool { return len(e.Effects) == 0 }
+
+// Default returns an empty unchanged effect set.
+func Default() Effects { return None().Unchanged() }
diff --git a/runtime/env.go b/runtime/env.go
new file mode 100644
index 0000000..fe12df7
--- /dev/null
+++ b/runtime/env.go
@@ -0,0 +1,512 @@
+package runtime
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/types"
+)
+
+// EnvError codes. They are part of the public wire contract and must not change.
+const (
+	EnvErrorCodeFetch                         = 1
+	EnvErrorCodeAddonTransport                = 2
+	EnvErrorCodeSerde                         = 3
+	EnvErrorCodeStorageUnavailable            = 4
+	EnvErrorCodeStorageSchemaVersionDowngrade = 5
+	EnvErrorCodeStorageSchemaVersionUpgrade   = 6
+	EnvErrorCodeStorageReadError              = 7
+	EnvErrorCodeStorageWriteError             = 8
+	EnvErrorCodeOther                         = 1001
+)
+
+// EnvError is the engine error type. It serializes as
+// `{"code": <integer>, "message": <string>}`.
+type EnvError struct {
+	Code    int
+	Message string
+}
+
+// Error implements the error interface.
+func (e *EnvError) Error() string { return e.Message }
+
+// MarshalJSON implements json.Marshaler preserving the wire contract.
+func (e *EnvError) MarshalJSON() ([]byte, error) {
+	return json.Marshal(struct {
+		Code    int    `json:"code"`
+		Message string `json:"message"`
+	}{Code: e.Code, Message: e.Message})
+}
+
+// UnmarshalJSON implements json.Unmarshaler.
+func (e *EnvError) UnmarshalJSON(data []byte) error {
+	var raw struct {
+		Code    int    `json:"code"`
+		Message string `json:"message"`
+	}
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return err
+	}
+	e.Code = raw.Code
+	e.Message = raw.Message
+	return nil
+}
+
+// EnvErrorFetch builds a fetch error.
+func EnvErrorFetch(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeFetch, Message: fmt.Sprintf("Failed to fetch: %s", message)}
+}
+
+// EnvErrorAddonTransport builds an addon transport error.
+func EnvErrorAddonTransport(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeAddonTransport, Message: fmt.Sprintf("Addon protocol violation: %s", message)}
+}
+
+// EnvErrorSerde builds a serialization error.
+func EnvErrorSerde(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeSerde, Message: fmt.Sprintf("Serialization error: %s", message)}
+}
+
+// EnvErrorStorageUnavailable builds a storage-unavailable error.
+func EnvErrorStorageUnavailable() *EnvError {
+	return &EnvError{Code: EnvErrorCodeStorageUnavailable, Message: "Storage is not available"}
+}
+
+// EnvErrorStorageSchemaVersionDowngrade builds a downgrade error.
+func EnvErrorStorageSchemaVersionDowngrade(from, to uint32) *EnvError {
+	return &EnvError{
+		Code:    EnvErrorCodeStorageSchemaVersionDowngrade,
+		Message: fmt.Sprintf("Downgrade storage schema version from %d to %d is not allowed", from, to),
+	}
+}
+
+// EnvErrorStorageSchemaVersionUpgrade builds an upgrade error.
+func EnvErrorStorageSchemaVersionUpgrade(source *EnvError) *EnvError {
+	msg := ""
+	if source != nil {
+		msg = source.Message
+	}
+	return &EnvError{
+		Code:    EnvErrorCodeStorageSchemaVersionUpgrade,
+		Message: fmt.Sprintf("Upgrade storage schema version failed caused by: %s", msg),
+	}
+}
+
+// EnvErrorStorageReadError builds a storage read error.
+func EnvErrorStorageReadError(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeStorageReadError, Message: fmt.Sprintf("Storage read error: %s", message)}
+}
+
+// EnvErrorStorageWriteError builds a storage write error.
+func EnvErrorStorageWriteError(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeStorageWriteError, Message: fmt.Sprintf("Storage write error: %s", message)}
+}
+
+// EnvErrorOther builds a generic error.
+func EnvErrorOther(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeOther, Message: fmt.Sprintf("Other error: %s", message)}
+}
+
+// AddonTransport is the transport abstraction used by the engine.
+type AddonTransport interface {
+	Resource(path types.ResourcePath) (types.ResourceResponse, *EnvError)
+	Manifest() (types.Manifest, *EnvError)
+}
+
+// Env abstracts the host environment. It is the Go equivalent of the Rust
+// `Env` trait.
+type Env interface {
+	Fetch(method, url string, headers map[string]string, body []byte) ([]byte, *EnvError)
+	GetStorage(key string) (json.RawMessage, bool, *EnvError)
+	SetStorage(key string, value any) *EnvError
+	ExecConcurrent(f func())
+	ExecSequential(f func())
+	Now() time.Time
+	LocalNow() time.Time
+	FlushAnalytics()
+	AnalyticsContext(ctx any, streamingServer any, path string) any
+	Log(message string)
+	AddonTransport(transportURL string) AddonTransport
+	MigrateStorageSchema() *EnvError
+}
+
+// MigrateStorageSchema performs the storage schema migration to the latest
+// version, chaining the v1..v25 migration steps. It returns a downgrade error
+// when the stored version is greater than SCHEMA_VERSION.
+func MigrateStorageSchema(env Env) *EnvError {
+	raw, ok, err := env.GetStorage(core.SCHEMA_VERSION_STORAGE_KEY)
+	if err != nil {
+		return err
+	}
+	var version uint32
+	if ok && len(raw) > 0 {
+		if e := json.Unmarshal(raw, &version); e != nil {
+			return EnvErrorSerde(e.Error())
+		}
+	}
+	if version > core.SCHEMA_VERSION {
+		return EnvErrorStorageSchemaVersionDowngrade(version, core.SCHEMA_VERSION)
+	}
+	steps := []func(Env) *EnvError{
+		migrateStorageSchemaToV1,
+		migrateStorageSchemaToV2,
+		migrateStorageSchemaToV3,
+		migrateStorageSchemaToV4,
+		migrateStorageSchemaToV5,
+		migrateStorageSchemaToV6,
+		migrateStorageSchemaToV7,
+		migrateStorageSchemaToV8,
+		migrateStorageSchemaToV9,
+		migrateStorageSchemaToV10,
+		migrateStorageSchemaToV11,
+		migrateStorageSchemaToV12,
+		migrateStorageSchemaToV13,
+		migrateStorageSchemaToV14,
+		migrateStorageSchemaToV15,
+		migrateStorageSchemaToV16,
+		migrateStorageSchemaToV17,
+		migrateStorageSchemaToV18,
+		migrateStorageSchemaToV19,
+		migrateStorageSchemaToV20,
+		migrateStorageSchemaToV21,
+		migrateStorageSchemaToV22,
+		migrateStorageSchemaToV23,
+		migrateStorageSchemaToV24,
+		migrateStorageSchemaToV25,
+	}
+	for i := uint32(0); i < uint32(len(steps)); i++ {
+		if version != i {
+			continue
+		}
+		if e := steps[i](env); e != nil {
+			return EnvErrorStorageSchemaVersionUpgrade(e)
+		}
+		version = i + 1
+	}
+	if version != core.SCHEMA_VERSION {
+		panic(fmt.Sprintf("Storage schema version must be upgraded from %d to %d", version, core.SCHEMA_VERSION))
+	}
+	return nil
+}
+
+// migrateProfile loads the persisted profile as a generic JSON object. A nil
+// map with a nil error means the profile is absent.
+func migrateProfile(env Env) (map[string]any, *EnvError) {
+	raw, ok, err := env.GetStorage(core.PROFILE_STORAGE_KEY)
+	if err != nil {
+		return nil, err
+	}
+	if !ok || len(raw) == 0 {
+		return nil, nil
+	}
+	var value any
+	if e := json.Unmarshal(raw, &value); e != nil {
+		return nil, EnvErrorSerde(e.Error())
+	}
+	profile, _ := value.(map[string]any)
+	return profile, nil
+}
+
+// migrateSettings returns the profile settings object, or nil when the profile
+// is absent or has no object settings.
+func migrateSettings(profile map[string]any) map[string]any {
+	if profile == nil {
+		return nil
+	}
+	settings, ok := profile["settings"].(map[string]any)
+	if !ok {
+		return nil
+	}
+	return settings
+}
+
+func migrateSetVersion(env Env, version uint32) *EnvError {
+	return env.SetStorage(core.SCHEMA_VERSION_STORAGE_KEY, version)
+}
+
+// migrateSettingsOrDelete applies mutate to the profile settings and writes the
+// profile back. When the settings are missing, it deletes the profile key,
+// matching the Rust `set_storage(key, None)` semantics.
+func migrateSettingsOrDelete(env Env, mutate func(settings map[string]any)) *EnvError {
+	profile, err := migrateProfile(env)
+	if err != nil {
+		return err
+	}
+	settings := migrateSettings(profile)
+	if settings == nil {
+		return env.SetStorage(core.PROFILE_STORAGE_KEY, nil)
+	}
+	mutate(settings)
+	profile["settings"] = settings
+	return env.SetStorage(core.PROFILE_STORAGE_KEY, profile)
+}
+
+func migrateStorageSchemaToV1(env Env) *EnvError {
+	if e := env.SetStorage(core.SCHEMA_VERSION_STORAGE_KEY, uint32(1)); e != nil {
+		return e
+	}
+	for _, key := range []string{
+		core.PROFILE_STORAGE_KEY,
+		core.LIBRARY_RECENT_STORAGE_KEY,
+		core.LIBRARY_STORAGE_KEY,
+	} {
+		if e := env.SetStorage(key, nil); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+
+func migrateStorageSchemaToV2(env Env) *EnvError {
+	if e := migrateSettingsOrDelete(env, func(settings map[string]any) {
+		renames := map[string]string{
+			"interface_language":         "interfaceLanguage",
+			"streaming_server_url":       "streamingServerUrl",
+			"binge_watching":             "bingeWatching",
+			"play_in_background":         "playInBackground",
+			"play_in_external_player":    "playInExternalPlayer",
+			"hardware_decoding":          "hardwareDecoding",
+			"subtitles_language":         "subtitlesLanguage",
+			"subtitles_size":             "subtitlesSize",
+			"subtitles_font":             "subtitlesFont",
+			"subtitles_bold":             "subtitlesBold",
+			"subtitles_offset":           "subtitlesOffset",
+			"subtitles_text_color":       "subtitlesTextColor",
+			"subtitles_background_color": "subtitlesBackgroundColor",
+			"subtitles_outline_color":    "subtitlesOutlineColor",
+		}
+		for from, to := range renames {
+			if value, ok := settings[from]; ok {
+				delete(settings, from)
+				settings[to] = value
+			}
+		}
+	}); e != nil {
+		return e
+	}
+	return migrateSetVersion(env, 2)
+}
+
+func migrateStorageSchemaToV3(env Env) *EnvError {
+	if e := migrateSettingsOrDelete(env, func(settings map[string]any) {
+		settings["streamingServerWarningDismissed"] = nil
+	}); e != nil {
+		return e
+	}
+	return migrateSetVersion(env, 3)
+}
+
+func migrateStorageSchemaToV4(env Env) *EnvError {
+	if e := migrateSettingsOrDelete(env, func(settings map[string]any) {
+		settings["seekTimeDuration"] = 20000
+	}); e != nil {
+		return e
+	}
+	return migrateSetVersion(env, 4)
+}
+
+func migrateStorageSchemaToV5(env Env) *EnvError {
+	if e := migrateSettingsOrDelete(env, func(settings map[string]any) {
+		settings["audioLanguage"] = "eng"
+		settings["audioPassthrough"] = false
+	}); e != nil {
+		return e
+	}
+	return migrateSetVersion(env, 5)
+}
+
+func migrateStorageSchemaToV6(env Env) *EnvError {
+	if e := migrateSettingsOrDelete(env, func(settings map[string]any) {
+		playerType := any(nil)
+		if playInExternal, ok := settings["playInExternalPlayer"]; ok {
+			if b, isBool := playInExternal.(bool); isBool && b {
+				playerType = "external"
+			}
+		}
+		delete(settings, "playInExternalPlayer")
+		settings["playerType"] = playerType
