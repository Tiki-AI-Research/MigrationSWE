+func (s *StreamingServer) createMagnet(base string, infoHash types.InfoHash, announce []string) runtime.Effects {
+	peerSearch := types.PeerSearch{Min: 40, Max: 200, Sources: []string{"dht:" + infoHash.String()}}
+	for _, source := range announce {
+		if !strings.HasPrefix(source, "dht:") && !strings.HasPrefix(source, "tracker:") {
+			source = "tracker:" + source
+		}
+		peerSearch.Sources = append(peerSearch.Sources, source)
+	}
+	body, _ := json.Marshal(struct {
+		PeerSearch *types.PeerSearch `json:"peerSearch,omitempty"`
+	}{PeerSearch: &peerSearch})
+	url := joinURL(base, infoHash.String()+"/create")
+	return s.request("POST", url, body, func(raw []byte, envErr *runtime.EnvError) *msg.Msg {
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerCreateTorrentResult,
+			createTorrentResult{InfoHash: infoHash, Err: envErrToError(envErr)}))
+	})
+}
+
+func (s *StreamingServer) createTorrentRequest(base string, infoHash types.InfoHash, torrent []byte) runtime.Effects {
+	body, _ := json.Marshal(struct {
+		Blob string `json:"blob"`
+	}{Blob: hex.EncodeToString(torrent)})
+	url := joinURL(base, "create")
+	return s.request("POST", url, body, func(raw []byte, envErr *runtime.EnvError) *msg.Msg {
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerCreateTorrentResult,
+			createTorrentResult{InfoHash: infoHash, Err: envErrToError(envErr)}))
+	})
+}
+
+func (s *StreamingServer) getTorrentStatistics(base string, request types.StatisticsRequest) runtime.Effects {
+	url := joinURL(base, request.InfoHash+"/"+strconv.FormatUint(uint64(request.FileIdx), 10)+"/stats.json")
+	return s.request("GET", url, nil,
+		func(raw []byte, envErr *runtime.EnvError) *msg.Msg {
+			data := statisticsResult{URL: base, Request: request, Err: envErrToError(envErr)}
+			if envErr == nil {
+				trimmed := strings.TrimSpace(string(raw))
+				if trimmed == "" || trimmed == "null" {
+					data.Loaded = false
+				} else {
+					var statistics types.Statistics
+					if err := json.Unmarshal(raw, &statistics); err != nil {
+						data.Err = runtime.EnvErrorSerde(err.Error())
+					} else {
+						data.Statistics = &statistics
+						data.Loaded = true
+					}
+				}
+			}
+			return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerStatisticsResult, data))
+		})
+}
