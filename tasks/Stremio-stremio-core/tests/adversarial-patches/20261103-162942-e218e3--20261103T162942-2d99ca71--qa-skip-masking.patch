diff --git a/runtime/env_test.go b/runtime/env_test.go
new file mode 100644
index 0000000..6843e0b
--- /dev/null
+++ b/runtime/env_test.go
@@ -0,0 +1,52 @@
+package runtime_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stremio/stremio-core/runtime"
+)
+
+func TestEnvErrorCodes(t *testing.T) {
+	cases := []struct {
+		err     *runtime.EnvError
+		code    int
+		message string
+	}{
+		{runtime.EnvErrorFetch("x"), 1, "Failed to fetch: x"},
+		{runtime.EnvErrorAddonTransport("x"), 2, "Addon protocol violation: x"},
+		{runtime.EnvErrorSerde("x"), 3, "Serialization error: x"},
+		{runtime.EnvErrorStorageUnavailable(), 4, "Storage is not available"},
+		{runtime.EnvErrorStorageSchemaVersionDowngrade(30, 25), 5, "Downgrade storage schema version from 30 to 25 is not allowed"},
+		{runtime.EnvErrorStorageSchemaVersionUpgrade(runtime.EnvErrorOther("x")), 6, "Upgrade storage schema version failed caused by: Other error: x"},
+		{runtime.EnvErrorStorageReadError("x"), 7, "Storage read error: x"},
+		{runtime.EnvErrorStorageWriteError("x"), 8, "Storage write error: x"},
+		{runtime.EnvErrorOther("x"), 1001, "Other error: x"},
+	}
+	for _, c := range cases {
+		if c.err.Code != c.code {
+			t.Errorf("code = %d, want %d", c.err.Code, c.code)
+		}
+		if c.err.Message != c.message {
+			t.Errorf("message = %q, want %q", c.err.Message, c.message)
+		}
+		b, err := json.Marshal(c.err)
+		if err != nil {
+			t.Fatalf("marshal: %v", err)
+		}
+		want := `{"code":` + itoa(c.code) + `,"message":` + quote(c.message) + `}`
+		if string(b) != want {
+			t.Errorf("wire = %s, want %s", b, want)
+		}
+	}
+}
+
+func itoa(n int) string {
+	b, _ := json.Marshal(n)
+	return string(b)
+}
+
+func quote(s string) string {
+	b, _ := json.Marshal(s)
+	return string(b)
+}
diff --git a/runtime/migration_test.go b/runtime/migration_test.go
new file mode 100644
index 0000000..a914ee9
--- /dev/null
+++ b/runtime/migration_test.go
@@ -0,0 +1,52 @@
+package runtime_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/runtime"
+)
+
+func TestMigrateStorageSchemaRunsEveryStep(t *testing.T) {
+	env := testenv.New()
+	env.Storage[core.SCHEMA_VERSION_STORAGE_KEY] = json.RawMessage(`1`)
+	env.Storage[core.PROFILE_STORAGE_KEY] = json.RawMessage(`{"settings":{"interface_language":"eng","streaming_server_url":"http://127.0.0.1:11470"}}`)
+
+	if err := runtime.MigrateStorageSchema(env); err != nil {
+		t.Fatalf("migrate: %v", err)
+	}
+
+	var version uint32
+	if err := json.Unmarshal(env.Storage[core.SCHEMA_VERSION_STORAGE_KEY], &version); err != nil {
+		t.Fatalf("version: %v", err)
+	}
+	if version != core.SCHEMA_VERSION {
+		t.Fatalf("version = %d, want %d", version, core.SCHEMA_VERSION)
+	}
+
+	var profile struct {
+		Settings map[string]any `json:"settings"`
+	}
+	if err := json.Unmarshal(env.Storage[core.PROFILE_STORAGE_KEY], &profile); err != nil {
+		t.Fatalf("profile: %v", err)
+	}
+	if _, ok := profile.Settings["interfaceLanguage"]; !ok {
+		t.Fatalf("expected interfaceLanguage rename, got %v", profile.Settings)
+	}
+	if _, ok := profile.Settings["gpuVideoProcessing"]; !ok {
+		t.Fatalf("expected gpuVideoProcessing from v25, got %v", profile.Settings)
+	}
+	if _, ok := profile.Settings["interface_language"]; ok {
+		t.Fatalf("legacy interface_language should be removed")
+	}
+}
+
+func TestMigrateStorageSchemaDowngradeFails(t *testing.T) {
+	env := testenv.New()
+	env.Storage[core.SCHEMA_VERSION_STORAGE_KEY] = json.RawMessage(`26`)
+	if err := runtime.MigrateStorageSchema(env); err == nil || err.Code != runtime.EnvErrorCodeStorageSchemaVersionDowngrade {
+		t.Fatalf("expected downgrade error, got %v", err)
+	}
+}
