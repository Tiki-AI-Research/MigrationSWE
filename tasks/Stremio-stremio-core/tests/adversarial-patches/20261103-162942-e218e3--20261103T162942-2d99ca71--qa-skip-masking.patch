+func (p *Player) introOutroUpdate(c *ctx.Ctx) runtime.Effects {
+	skipGapsEffects := p.skipGapsUpdate(c)
+
+	var next *types.IntroOutro
+	if p.SkipGaps != nil && p.SkipGaps.Load.IsReady() && p.LibraryItem != nil && p.LibraryItem.State.Duration > 0 {
+		response := p.SkipGaps.Load.Ready
+		duration := p.LibraryItem.State.Duration
+
+		var outroTime *uint64
+		var closestOutroDuration *uint64
+		var closestOutro *uint64
+		for durationKey, gaps := range response.Gaps {
+			matchDuration, ok := parseDurationKey(durationKey)
+			if !ok || gaps.Outro == nil {
+				continue
+			}
+			if closestOutroDuration == nil || absDiff(matchDuration, duration) < absDiff(*closestOutroDuration, duration) {
+				d := matchDuration
+				o := *gaps.Outro
+				closestOutroDuration = &d
+				closestOutro = &o
+			}
+		}
+		if closestOutroDuration != nil && closestOutro != nil {
+			outroTime = calculateOutro(p.LibraryItem, *closestOutroDuration, *closestOutro)
+		}
+
+		var introTime *types.IntroData
+		var closestIntroDuration *uint64
+		var closestIntroGaps *types.SkipGaps
+		for durationKey, gaps := range response.Gaps {
+			if len(gaps.SeekHistory) == 0 {
+				continue
+			}
+			matchDuration, ok := parseDurationKey(durationKey)
+			if !ok {
+				continue
+			}
+			if closestIntroDuration == nil || absDiff(matchDuration, duration) < absDiff(*closestIntroDuration, duration) {
+				d := matchDuration
+				g := gaps
+				closestIntroDuration = &d
+				closestIntroGaps = &g
+			}
+		}
+		if closestIntroDuration != nil && closestIntroGaps != nil && *closestIntroDuration > 0 {
+			first := closestIntroGaps.SeekHistory[0]
+			durationDiffInSecs := absDiff(duration, *closestIntroDuration) / (1000 * 10) / 10
+			from := (duration * first.From) / *closestIntroDuration
+			to := (duration * first.To) / *closestIntroDuration
+			intro := types.IntroData{From: from, To: to}
+			if durationDiffInSecs > 0 {
+				d := absDiff(first.To, first.From)
+				intro.Duration = &d
+			}
+			introTime = &intro
+		}
+
+		next = &types.IntroOutro{Intro: introTime, Outro: outroTime}
+	}
+
+	return skipGapsEffects.Join(common.EqUpdate(&p.IntroOutro, next))
+}
+
+func (p *Player) seekUpdate(outro *uint64) runtime.Effects {
+	hasSeeksOrOutro := len(p.SeekHistory) > 0 || (outro != nil && *outro > 0)
+	var requestEffects runtime.Effects = runtime.None().Unchanged()
+	if hasSeeksOrOutro && p.Selected != nil && p.VideoParams != nil && p.SeriesInfo != nil &&
+		p.LibraryItem != nil && streamSourceSupported(p.Selected.Stream) &&
+		p.Selected.Stream.Name != nil && p.VideoParams.Hash != nil {
+		request := types.SeekLogRequest{
+			OSHash:         *p.VideoParams.Hash,
+			ItemID:         p.LibraryItem.ID,
+			SeriesInfo:     *p.SeriesInfo,
+			StreamNameHash: streamNameHash(*p.Selected.Stream.Name),
+			Duration:       p.LibraryItem.State.Duration,
+			SeekHistory:    append([]types.SeekLog(nil), p.SeekHistory...),
+		}
+		if outro != nil {
+			request.SkipOutro = []uint64{*outro}
+		} else {
+			request.SkipOutro = []uint64{}
+		}
+		requestCopy := request
+		env := p.Env
+		requestEffects = runtime.FutureEffectSet(runtime.ConcurrentFuture(func() *msg.Msg {
+			_, err := fetchAPI[types.SuccessResponse](env, "seekLog", seekLogAPIRequest{Type: "SeekLog", SeekLogRequest: requestCopy})
+			return msg.InternalMsg(msg.NewInternal(msg.InternalSeekLogsResult, seekLogsResult{Request: requestCopy, Err: err}))
+		})).Unchanged()
+	}
+	return requestEffects.Join(common.EqUpdate(&p.SeekHistory, []types.SeekLog{}))
+}
+
+func (p *Player) sendWatched(authKey types.AuthKey, metaPath types.ResourcePath) runtime.Effects {
+	env := p.Env
+	metaID := metaPath.ID
+	metaType := metaPath.Type
+	return runtime.FutureEffectSet(runtime.ConcurrentFuture(func() *msg.Msg {
+		_, err := sendWatched(env, authKey, metaID, metaType)
+		return msg.InternalMsg(msg.NewInternal(msg.InternalWatchedSendResult, watchedSendResult{MetaID: metaID, Err: err}))
+	})).Unchanged()
+}
+
+func (p *Player) pushToLibrary() runtime.Effects {
+	if p.LibraryItem == nil {
+		return runtime.None().Unchanged()
+	}
+	if p.Env.Now().Sub(p.PushLibraryItemTime) >= pushToLibraryEvery {
+		p.PushLibraryItemTime = p.Env.Now()
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, *p.LibraryItem))).Unchanged()
+	}
+	return runtime.None().Unchanged()
+}
+
+func (p *Player) streamStateFromBucket(c *ctx.Ctx) *types.StreamItemState {
+	if p.Selected == nil || p.Selected.StreamRequest == nil || p.Selected.MetaRequest == nil {
+		return nil
+	}
+	key := types.StreamsItemKey{MetaID: p.Selected.MetaRequest.Path.ID, VideoID: p.Selected.StreamRequest.Path.ID}
+	if item, ok := c.Streams.Items[key]; ok {
+		return item.State
+	}
+	return nil
+}
+
+func (p *Player) metaPreview() *types.MetaItemPreview {
+	if p.MetaItem == nil || p.MetaItem.Content == nil || !p.MetaItem.Content.IsReady() {
+		return nil
+	}
+	preview := p.MetaItem.Content.Ready.MetaItemPreview
+	return &preview
+}
+
+func (p *Player) bingeWatching(c *ctx.Ctx) bool {
+	if c == nil {
+		return false
+	}
+	return c.Profile.Settings.BingeWatching
+}
+
+func (p *Player) analyticsContextOrDefault() types.AnalyticsContext {
+	if p.AnalyticsContext != nil {
+		return *p.AnalyticsContext
+	}
+	return types.AnalyticsContext{}
+}
+
+func (p *Player) updateAnalyticsContext(c *ctx.Ctx) {
+	var context types.AnalyticsContext
+	if p.LibraryItem != nil {
+		id := p.LibraryItem.ID
+		itemType := p.LibraryItem.Type
+		name := p.LibraryItem.Name
+		timeOffset := p.LibraryItem.State.TimeOffset
+		duration := p.LibraryItem.State.Duration
+		context.ID = &id
+		context.Type = &itemType
+		context.Name = &name
+		context.VideoID = p.LibraryItem.State.VideoID
+		context.Time = &timeOffset
+		context.Duration = &duration
+	}
+	if c != nil && p.Env != nil {
+		context.HasTrakt = c.ProfileHasTrakt(p.Env.Now())
+	}
+	p.AnalyticsContext = &context
+}
+
+func metaRequestID(selected *Selected) string {
+	if selected != nil && selected.MetaRequest != nil {
+		return selected.MetaRequest.Path.ID
+	}
+	return ""
+}
+
+func itemStateUpdate(libraryItem **types.LibraryItem, nextVideo *types.Video, markedVideoAsWatched bool) runtime.Effects {
+	if *libraryItem != nil {
+		item := *libraryItem
+		if markedVideoAsWatched ||
+			float64(item.State.TimeOffset) > float64(item.State.Duration)*core.CREDITS_THRESHOLD_COEF {
+			item.State.TimeOffset = 0
+			if nextVideo != nil {
+				item.AdvanceToVideo(nextVideo.ID)
+			}
+		}
+	}
+	return runtime.None().Unchanged()
+}
+
+func libraryItemFromPreview(preview types.MetaItemPreview, existing *types.LibraryItem) types.LibraryItem {
+	if existing != nil {
+		return types.LibraryItem{
+			ID:            preview.ID,
+			Name:          preview.Name,
+			Type:          preview.Type,
+			Poster:        preview.Poster,
+			PosterShape:   preview.PosterShape,
+			BehaviorHints: preview.BehaviorHints,
+			Removed:       existing.Removed,
+			Temp:          existing.Temp,
+			Ctime:         existing.Ctime,
+			Mtime:         existing.Mtime,
+			State:         existing.State,
+		}
+	}
+	now := time.Now().UTC()
+	return types.LibraryItem{
+		ID:            preview.ID,
+		Removed:       true,
+		Temp:          true,
+		Ctime:         &now,
+		Mtime:         now,
+		State:         types.LibraryItemState{LastWatched: &now},
+		Name:          preview.Name,
+		Type:          preview.Type,
+		Poster:        preview.Poster,
+		PosterShape:   preview.PosterShape,
+		BehaviorHints: preview.BehaviorHints,
+	}
+}
+
+func convertMetaItem(r types.ResourceResponse) (types.MetaItem, error) {
+	var envelope struct {
+		Meta json.RawMessage `json:"meta"`
+	}
+	if err := json.Unmarshal(r.Raw, &envelope); err != nil {
+		return types.MetaItem{}, err
+	}
+	if len(envelope.Meta) == 0 {
+		return types.MetaItem{}, common.ResourceError{Kind: common.ResourceErrorUnexpectedResponse, Message: "missing meta"}
+	}
+	var out types.MetaItem
+	if err := json.Unmarshal(envelope.Meta, &out); err != nil {
+		return types.MetaItem{}, err
+	}
+	return out, nil
+}
+
+func convertSubtitles(r types.ResourceResponse) ([]types.Subtitles, error) {
+	var envelope struct {
+		Subtitles []types.Subtitles `json:"subtitles"`
+	}
+	if err := json.Unmarshal(r.Raw, &envelope); err != nil {
+		return nil, err
+	}
+	return envelope.Subtitles, nil
+}
+
+func convertStreams(r types.ResourceResponse) ([]types.Stream, error) {
+	var envelope struct {
+		Streams []types.Stream `json:"streams"`
+	}
+	if err := json.Unmarshal(r.Raw, &envelope); err != nil {
+		return nil, err
+	}
+	return envelope.Streams, nil
+}
+
+func streamSourceSupported(stream types.Stream) bool {
+	return stream.Source.Kind == types.StreamSourceURL || stream.Source.Kind == types.StreamSourceTorrent
+}
+
+func streamNameHash(name string) string {
+	sum := sha256.Sum256([]byte(name))
+	return base64.StdEncoding.EncodeToString(sum[:])
+}
+
+func calculateOutro(libraryItem *types.LibraryItem, closestDuration, closestOutro uint64) *uint64 {
+	if closestOutro == 0 {
+		return nil
+	}
+	duration := libraryItem.State.Duration
+	outro := absDiff(duration, absDiff(closestDuration, closestOutro))
+	if outro > 0 && outro <= duration {
+		return &outro
+	}
+	return nil
+}
+
+func absDiff(a, b uint64) uint64 {
+	if a > b {
+		return a - b
+	}
+	return b - a
+}
+
+func parseDurationKey(key string) (uint64, bool) {
+	var value uint64
+	if err := json.Unmarshal([]byte(key), &value); err == nil {
+		return value, true
+	}
+	return 0, false
+}
