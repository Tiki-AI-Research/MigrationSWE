+package addontransport
+
+import (
+	"encoding/json"
+	"strings"
+
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+// AddonHTTPTransport is the manifest-based HTTP addon transport.
+type AddonHTTPTransport struct {
+	TransportURL string
+	Env          runtime.Env
+}
+
+// NewAddonHTTPTransport builds an HTTP transport.
+func NewAddonHTTPTransport(transportURL string, env runtime.Env) *AddonHTTPTransport {
+	return &AddonHTTPTransport{TransportURL: transportURL, Env: env}
+}
+
+// Resource requests an addon resource.
+func (t *AddonHTTPTransport) Resource(path types.ResourcePath) (types.ResourceResponse, *runtime.EnvError) {
+	if strings.HasSuffix(t.TransportURL, core.ADDON_LEGACY_PATH) {
+		return NewAddonLegacyTransport(t.TransportURL, t.Env).Resource(path)
+	}
+	if !strings.HasSuffix(t.TransportURL, core.ADDON_MANIFEST_PATH) {
+		return types.ResourceResponse{}, runtime.EnvErrorAddonTransport(
+			"addon http transport url must ends with " + core.ADDON_MANIFEST_PATH)
+	}
+	var resourcePath string
+	if len(path.Extra) == 0 {
+		resourcePath = "/" + types.PercentEncode(path.Resource) + "/" +
+			types.PercentEncode(path.Type) + "/" + types.PercentEncode(path.ID) + ".json"
+	} else {
+		pairs := make([]types.QueryPair, 0, len(path.Extra))
+		for _, ev := range path.Extra {
+			pairs = append(pairs, types.QueryPair{Key: ev.Name, Value: ev.Value})
+		}
+		resourcePath = "/" + types.PercentEncode(path.Resource) + "/" +
+			types.PercentEncode(path.Type) + "/" + types.PercentEncode(path.ID) + "/" +
+			types.QueryParamsEncode(pairs) + ".json"
+	}
+	url := strings.Replace(t.TransportURL, core.ADDON_MANIFEST_PATH, resourcePath, 1)
+	if t.Env == nil {
+		return types.ResourceResponse{}, runtime.EnvErrorOther("no environment")
+	}
+	raw, envErr := t.Env.Fetch("GET", url, nil, nil)
+	if envErr != nil {
+		return types.ResourceResponse{}, envErr
+	}
+	return types.ResourceResponse{Raw: raw}, nil
+}
+
+// Manifest fetches the addon manifest.
+func (t *AddonHTTPTransport) Manifest() (types.Manifest, *runtime.EnvError) {
+	if strings.HasSuffix(t.TransportURL, core.ADDON_LEGACY_PATH) {
+		return NewAddonLegacyTransport(t.TransportURL, t.Env).Manifest()
+	}
+	if t.Env == nil {
+		return types.Manifest{}, runtime.EnvErrorOther("no environment")
+	}
+	raw, envErr := t.Env.Fetch("GET", t.TransportURL, nil, nil)
+	if envErr != nil {
+		return types.Manifest{}, envErr
+	}
+	var manifest types.Manifest
+	if err := json.Unmarshal(raw, &manifest); err != nil {
+		return types.Manifest{}, runtime.EnvErrorSerde(err.Error())
+	}
+	return manifest, nil
+}
+
+var _ runtime.AddonTransport = (*AddonHTTPTransport)(nil)
diff --git a/addon_transport/legacy.go b/addon_transport/legacy.go
new file mode 100644
index 0000000..80c7551
--- /dev/null
+++ b/addon_transport/legacy.go
@@ -0,0 +1,242 @@
+package addontransport
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+const (
+	imdbPrefix = "tt"
+	ytPrefix   = "UC"
+
+	// manifestRequestParam is base64 for
+	// {"params":[],"method":"meta","id":1,"jsonrpc":"2.0"}.
+	manifestRequestParam = "eyJwYXJhbXMiOltdLCJtZXRob2QiOiJtZXRhIiwiaWQiOjEsImpzb25ycGMiOiIyLjAifQ=="
+
+	videoHashExtraName     = "videoHash"
+	videoSizeExtraName     = "videoSize"
+	videoFilenameExtraName = "filename"
+)
+
+// LegacyErrKind discriminates legacy transport errors.
+type LegacyErrKind int
+
+const (
+	// LegacyJSONRPC is a JSON-RPC error response.
+	LegacyJSONRPC LegacyErrKind = iota
+	// LegacyUnsupportedResource is an unsupported resource.
+	LegacyUnsupportedResource
+	// LegacyUnsupportedRequest is an unsupported request.
+	LegacyUnsupportedRequest
+)
+
+// LegacyErr is a legacy transport error.
+type LegacyErr struct {
+	Kind    LegacyErrKind
+	Code    int64
+	Message string
+}
+
+// Error implements the error interface.
+func (e *LegacyErr) Error() string {
+	switch e.Kind {
+	case LegacyJSONRPC:
+		return fmt.Sprintf("rpc error %d: %s", e.Code, e.Message)
+	case LegacyUnsupportedResource:
+		return "legacy transport: unsupported resource"
+	default:
+		return "legacy transport: unsupported request"
+	}
+}
+
+// ToEnvError maps a LegacyErr to an addon-transport EnvError.
+func (e *LegacyErr) ToEnvError() *runtime.EnvError {
+	return runtime.EnvErrorAddonTransport(e.Error())
+}
+
+// JSONRPCErr is a JSON-RPC error object.
+type JSONRPCErr struct {
+	Message string `json:"message"`
+	Code    int64  `json:"code"`
+}
+
+// JSONRPCResp is an untagged JSON-RPC response: either a result or an error.
+type JSONRPCResp struct {
+	Result json.RawMessage `json:"result"`
+	Error  *JSONRPCErr     `json:"error"`
+}
+
+// Parse decodes the raw JSON-RPC response, returning the raw result or a
+// LegacyErr.
+func (r JSONRPCResp) Parse() (json.RawMessage, *LegacyErr) {
+	if r.Error != nil {
+		return nil, &LegacyErr{Kind: LegacyJSONRPC, Code: r.Error.Code, Message: r.Error.Message}
+	}
+	return r.Result, nil
+}
+
+// BuildLegacyReq builds the legacy JSON-RPC request URL for a resource path.
+func BuildLegacyReq(transportURL string, path types.ResourcePath) (string, *runtime.EnvError) {
+	typ := path.Type
+	id := path.ID
+	var qJSON any
+	switch path.Resource {
+	case "catalog":
+		query := map[string]any{"type": typ}
+		if genre, ok := path.GetExtraFirstValue("genre"); ok {
+			query["genre"] = genre
+		}
+		var sort any
+		if id != "top" {
+			sort = map[string]any{id: -1, "popularity": -1}
+		}
+		skip := 0
+		if v, ok := path.GetExtraFirstValue("skip"); ok {
+			if n, err := strconv.ParseUint(v, 10, 32); err == nil {
+				skip = int(n)
+			}
+		}
+		qJSON = buildJSONRPC("meta.find", map[string]any{
+			"query": query,
+			"limit": 100,
+			"sort":  sort,
+			"skip":  skip,
+		})
+	case "meta":
+		qJSON = buildJSONRPC("meta.get", map[string]any{"query": queryFromID(id)})
+	case "stream":
+		query, ok := queryFromID(id).(map[string]any)
+		if !ok {
+			return "", runtime.EnvErrorAddonTransport("legacy: stream request without a valid id")
+		}
+		query["type"] = typ
+		qJSON = buildJSONRPC("stream.find", map[string]any{"query": query})
+	case "subtitles":
+		query := map[string]any{"itemHash": strings.ReplaceAll(id, ":", " ")}
+		if v, ok := path.GetExtraFirstValue(videoHashExtraName); ok {
+			query[videoHashExtraName] = v
+		}
+		if v, ok := path.GetExtraFirstValue(videoSizeExtraName); ok {
+			if n, err := strconv.ParseUint(v, 10, 64); err == nil {
+				query[videoSizeExtraName] = n
+			}
+		}
+		if v, ok := path.GetExtraFirstValue(videoFilenameExtraName); ok {
+			query[videoFilenameExtraName] = v
+		}
+		qJSON = buildJSONRPC("subtitles.find", map[string]any{"query": query})
+	default:
+		return "", (&LegacyErr{Kind: LegacyUnsupportedRequest}).ToEnvError()
+	}
+	body, err := json.Marshal(qJSON)
+	if err != nil {
+		return "", runtime.EnvErrorSerde(err.Error())
+	}
+	param := base64.StdEncoding.EncodeToString(body)
+	return fmt.Sprintf("%s/q.json?b=%s", transportURL, param), nil
+}
+
+func buildJSONRPC(method string, params any) map[string]any {
+	return map[string]any{
+		"params":  []any{nil, params},
+		"method":  method,
+		"id":      1,
+		"jsonrpc": "2.0",
+	}
+}
+
+func queryFromID(id string) any {
+	parts := strings.Split(id, ":")
+	if strings.HasPrefix(id, imdbPrefix) {
+		if len(parts) == 3 {
+			season, _ := strconv.ParseUint(parts[1], 10, 16)
+			if season == 0 {
+				season = 1
+			}
+			episode, _ := strconv.ParseUint(parts[2], 10, 16)
+			if episode == 0 {
+				episode = 1
+			}
+			return map[string]any{"imdb_id": parts[0], "season": season, "episode": episode}
+		}
+		return map[string]any{"imdb_id": parts[0]}
+	}
+	if strings.HasPrefix(id, ytPrefix) {
+		if len(parts) == 2 {
+			return map[string]any{"yt_id": parts[0], "video_id": parts[1]}
+		}
+		return map[string]any{"yt_id": parts[0]}
+	}
+	if len(parts) == 3 {
+		return map[string]any{parts[0]: parts[1], "video_id": parts[2]}
+	}
+	if len(parts) == 2 {
+		return map[string]any{parts[0]: parts[1]}
+	}
+	return nil
+}
+
+// AddonLegacyTransport is the legacy JSON-RPC addon transport.
+type AddonLegacyTransport struct {
+	TransportURL string
+	Env          runtime.Env
+}
+
+// NewAddonLegacyTransport builds a legacy transport.
+func NewAddonLegacyTransport(transportURL string, env runtime.Env) *AddonLegacyTransport {
+	return &AddonLegacyTransport{TransportURL: transportURL, Env: env}
+}
+
+// Resource performs a legacy JSON-RPC resource request.
+func (t *AddonLegacyTransport) Resource(path types.ResourcePath) (types.ResourceResponse, *runtime.EnvError) {
+	url, err := BuildLegacyReq(t.TransportURL, path)
+	if err != nil {
+		return types.ResourceResponse{}, err
+	}
+	switch path.Resource {
+	case "catalog", "meta", "stream", "subtitles":
+	default:
+		return types.ResourceResponse{}, (&LegacyErr{Kind: LegacyUnsupportedResource}).ToEnvError()
+	}
+	if t.Env == nil {
+		return types.ResourceResponse{}, runtime.EnvErrorOther("no environment")
+	}
+	raw, envErr := t.Env.Fetch("GET", url, nil, nil)
+	if envErr != nil {
+		return types.ResourceResponse{}, envErr
+	}
+	return types.ResourceResponse{Raw: raw}, nil
+}
+
+// Manifest fetches the legacy addon manifest.
+func (t *AddonLegacyTransport) Manifest() (types.Manifest, *runtime.EnvError) {
+	url := fmt.Sprintf("%s/q.json?b=%s", t.TransportURL, manifestRequestParam)
+	if t.Env == nil {
+		return types.Manifest{}, runtime.EnvErrorOther("no environment")
+	}
+	raw, envErr := t.Env.Fetch("GET", url, nil, nil)
+	if envErr != nil {
+		return types.Manifest{}, envErr
+	}
+	var resp JSONRPCResp
+	if err := json.Unmarshal(raw, &resp); err != nil {
+		return types.Manifest{}, runtime.EnvErrorSerde(err.Error())
+	}
+	result, legacyErr := resp.Parse()
+	if legacyErr != nil {
+		return types.Manifest{}, legacyErr.ToEnvError()
+	}
+	manifest, err := LegacyManifestToManifest(result)
+	if err != nil {
+		return types.Manifest{}, runtime.EnvErrorSerde(err.Error())
+	}
+	return manifest, nil
+}
+
+var _ runtime.AddonTransport = (*AddonLegacyTransport)(nil)
diff --git a/addon_transport/legacy_manifest.go b/addon_transport/legacy_manifest.go
