@@ -0,0 +1,31 @@
+// Package msg defines the message union dispatched through the runtime.
+package msg
+
+// Kind discriminates the message variants.
+type Kind int
+
+const (
+	// KindAction is a message originating from an external dispatcher.
+	KindAction Kind = iota
+	// KindInternal is a message originating from within the engine.
+	KindInternal
+	// KindEvent is a message emitted towards the host application.
+	KindEvent
+)
+
+// Msg is the union of Action, Internal and Event messages.
+type Msg struct {
+	Kind     Kind
+	Action   *Action
+	Internal *Internal
+	Event    *Event
+}
+
+// ActionMsg wraps an action message.
+func ActionMsg(a *Action) *Msg { return &Msg{Kind: KindAction, Action: a} }
+
+// InternalMsg wraps an internal message.
+func InternalMsg(i *Internal) *Msg { return &Msg{Kind: KindInternal, Internal: i} }
+
+// EventMsg wraps an event message.
+func EventMsg(e *Event) *Msg { return &Msg{Kind: KindEvent, Event: e} }
diff --git a/runtime/runtime.go b/runtime/runtime.go
new file mode 100644
index 0000000..0fadc06
--- /dev/null
+++ b/runtime/runtime.go
@@ -0,0 +1,128 @@
+package runtime
+
+import (
+	"encoding/json"
+
+	"github.com/stremio/stremio-core/runtime/msg"
+)
+
+// RuntimeEvent is emitted by the runtime. On the wire it serializes as
+// `{"name": "NewState"|"CoreEvent", "args": ...}`.
+type RuntimeEvent struct {
+	Name string          `json:"name"`
+	Args json.RawMessage `json:"args,omitempty"`
+}
+
+// NewStateEvent builds a NewState runtime event carrying the changed model
+// field list.
+func NewStateEvent(fields []string) RuntimeEvent {
+	if fields == nil {
+		fields = []string{}
+	}
+	b, err := json.Marshal(fields)
+	if err != nil {
+		panic(err)
+	}
+	return RuntimeEvent{Name: "NewState", Args: b}
+}
+
+// CoreEvent builds a CoreEvent runtime event carrying the event.
+func CoreEvent(event *msg.Event) RuntimeEvent {
+	b, err := json.Marshal(event)
+	if err != nil {
+		panic(err)
+	}
+	return RuntimeEvent{Name: "CoreEvent", Args: b}
+}
+
+// RuntimeAction is a dispatch request. A present Field routes to a field-only
+// update, an absent one updates the whole model.
+type RuntimeAction struct {
+	Field  *string
+	Action *msg.Action
+}
+
+// Runtime is the single-directional update/effects scheduler.
+type Runtime struct {
+	model Model
+	tx    chan RuntimeEvent
+	env   Env
+}
+
+// New builds a runtime from a model, an initial effect list and a buffer size,
+// returning the runtime together with a receiver of RuntimeEvent.
+func New(model Model, effects []Effect, buffer int, env Env) (*Runtime, <-chan RuntimeEvent) {
+	if buffer < 0 {
+		buffer = 0
+	}
+	runtime := &Runtime{
+		model: model,
+		tx:    make(chan RuntimeEvent, buffer),
+		env:   env,
+	}
+	runtime.handleEffects(effects, nil)
+	return runtime, runtime.tx
+}
+
+// Model returns the current model.
+func (r *Runtime) Model() Model { return r.model }
+
+// Dispatch applies an action to the model.
+func (r *Runtime) Dispatch(action RuntimeAction) {
+	m := msg.ActionMsg(action.Action)
+	var effects []Effect
+	var fields []string
+	if action.Field != nil {
+		effects, fields = r.model.UpdateField(m, *action.Field)
+	} else {
+		effects, fields = r.model.Update(m)
+	}
+	r.handleEffects(effects, fields)
+}
+
+func (r *Runtime) emit(event RuntimeEvent) {
+	r.tx <- event
+}
+
+func (r *Runtime) handleEffects(effects []Effect, fields []string) {
+	if len(fields) > 0 {
+		r.emit(NewStateEvent(fields))
+	}
+	for i := range effects {
+		effect := effects[i]
+		if effect.Msg != nil {
+			r.handleEffectOutput(effect.Msg)
+			continue
+		}
+		if effect.Future == nil {
+			continue
+		}
+		future := effect.Future
+		run := func() { r.handleEffectOutput(future.Run()) }
+		if future.Concurrent {
+			if r.env != nil {
+				r.env.ExecConcurrent(run)
+			} else {
+				go run()
+			}
+		} else {
+			if r.env != nil {
+				r.env.ExecSequential(run)
+			} else {
+				run()
+			}
+		}
+	}
+}
+
+func (r *Runtime) handleEffectOutput(m *msg.Msg) {
+	switch m.Kind {
+	case msg.KindEvent:
+		r.emit(CoreEvent(m.Event))
+	case msg.KindInternal:
+		effects, fields := r.model.Update(m)
+		r.handleEffects(effects, fields)
+	case msg.KindAction:
+		panic("effects are not allowed to resolve with action")
+	}
+}
