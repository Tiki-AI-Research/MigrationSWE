+package msg
+
+import "encoding/json"
+
+// Action is an externally dispatched action. On the wire it is tagged with
+// `action`/`args`.
+type Action struct {
+	Action string          `json:"action,omitempty"`
+	Args   json.RawMessage `json:"args,omitempty"`
+}
+
+// ActionLoad is an action that loads a model. On the wire it is tagged with
+// `model`/`args`.
+type ActionLoad struct {
+	Model string          `json:"model,omitempty"`
+	Args  json.RawMessage `json:"args,omitempty"`
+}
+
+// Outer action variant names.
+const (
+	ActionNameCtx                = "Ctx"
+	ActionNameLink               = "Link"
+	ActionNameCatalogWithFilters = "CatalogWithFilters"
+	ActionNameCatalogsWithExtra  = "CatalogsWithExtra"
+	ActionNameLibraryByType      = "LibraryByType"
+	ActionNameLibraryWithFilters = "LibraryWithFilters"
+	ActionNameMetaDetails        = "MetaDetails"
+	ActionNameStreamingServer    = "StreamingServer"
+	ActionNamePlayer             = "Player"
+	ActionNameLoad               = "Load"
+	ActionNameSearch             = "Search"
+	ActionNameUnload             = "Unload"
+)
+
+// ActionCtx variant names.
+const (
+	ActionCtxAuthenticate                   = "Authenticate"
+	ActionCtxLogout                         = "Logout"
+	ActionCtxDeleteAccount                  = "DeleteAccount"
+	ActionCtxInstallAddon                   = "InstallAddon"
+	ActionCtxInstallTraktAddon              = "InstallTraktAddon"
+	ActionCtxLogoutTrakt                    = "LogoutTrakt"
+	ActionCtxUpgradeAddon                   = "UpgradeAddon"
+	ActionCtxUninstallAddon                 = "UninstallAddon"
+	ActionCtxUpdateSettings                 = "UpdateSettings"
+	ActionCtxAddToLibrary                   = "AddToLibrary"
+	ActionCtxRemoveFromLibrary              = "RemoveFromLibrary"
+	ActionCtxRewindLibraryItem              = "RewindLibraryItem"
+	ActionCtxLibraryItemMarkAsWatched       = "LibraryItemMarkAsWatched"
+	ActionCtxMetaItemMarkAsWatched          = "MetaItemMarkAsWatched"
+	ActionCtxToggleLibraryItemNotifications = "ToggleLibraryItemNotifications"
+	ActionCtxDismissNotificationItem        = "DismissNotificationItem"
+	ActionCtxClearSearchHistory             = "ClearSearchHistory"
+	ActionCtxPushUserToAPI                  = "PushUserToAPI"
+	ActionCtxPullUserFromAPI                = "PullUserFromAPI"
+	ActionCtxPushAddonsToAPI                = "PushAddonsToAPI"
+	ActionCtxPullAddonsFromAPI              = "PullAddonsFromAPI"
+	ActionCtxSyncLibraryWithAPI             = "SyncLibraryWithAPI"
+	ActionCtxPullNotifications              = "PullNotifications"
+	ActionCtxGetEvents                      = "GetEvents"
+	ActionCtxDismissEvent                   = "DismissEvent"
+	ActionCtxAddServerURL                   = "AddServerUrl"
+	ActionCtxDeleteServerURL                = "DeleteServerUrl"
+)
+
+// ActionPlayer variant names.
+const (
+	ActionPlayerVideoParamsChanged        = "VideoParamsChanged"
+	ActionPlayerStreamStateChanged        = "StreamStateChanged"
+	ActionPlayerSubtitlePreferenceChanged = "SubtitlePreferenceChanged"
+	ActionPlayerVideoScaleChanged         = "VideoScaleChanged"
+	ActionPlayerSeek                      = "Seek"
+	ActionPlayerTimeChanged               = "TimeChanged"
+	ActionPlayerPausedChanged             = "PausedChanged"
+	ActionPlayerNextVideo                 = "NextVideo"
+	ActionPlayerEnded                     = "Ended"
+	ActionPlayerMarkVideoAsWatched        = "MarkVideoAsWatched"
+	ActionPlayerMarkSeasonAsWatched       = "MarkSeasonAsWatched"
+)
+
+// ActionStreamingServer variant names.
+const (
+	ActionStreamingServerReload                 = "Reload"
+	ActionStreamingServerRefreshPlaybackDevices = "RefreshPlaybackDevices"
+	ActionStreamingServerUpdateSettings         = "UpdateSettings"
+	ActionStreamingServerCreateTorrent          = "CreateTorrent"
+	ActionStreamingServerGetStatistics          = "GetStatistics"
+	ActionStreamingServerPlayOnDevice           = "PlayOnDevice"
+)
+
+// Load model names (the `model` tag of ActionLoad).
+const (
+	ModelAddonDetails               = "AddonDetails"
+	ModelCatalogWithFilters         = "CatalogWithFilters"
+	ModelCatalogsWithExtra          = "CatalogsWithExtra"
+	ModelDataExport                 = "DataExport"
+	ModelInstalledAddonsWithFilters = "InstalledAddonsWithFilters"
+	ModelLibraryWithFilters         = "LibraryWithFilters"
+	ModelLibraryByType              = "LibraryByType"
+	ModelCalendar                   = "Calendar"
+	ModelLocalSearch                = "LocalSearch"
+	ModelMetaDetails                = "MetaDetails"
+	ModelPlayer                     = "Player"
+	ModelLink                       = "Link"
+)
+
+// NewAction builds an action with an optional JSON-marshalable argument.
+func NewAction(name string, args any) *Action {
+	a := &Action{Action: name}
+	if args != nil {
+		a.Args = mustMarshal(args)
+	}
+	return a
+}
+
+// LoadAction builds a `Load` action carrying a model selector.
+func LoadAction(model string, args any) *Action {
+	load := ActionLoad{Model: model}
+	if args != nil {
+		load.Args = mustMarshal(args)
+	}
+	return &Action{Action: ActionNameLoad, Args: mustMarshal(load)}
+}
+
+// UnloadAction builds the `Unload` action.
+func UnloadAction() *Action { return &Action{Action: ActionNameUnload} }
+
+// DecodeArgs unmarshals the raw args into v. It is a no-op when Args is empty.
+func (a *Action) DecodeArgs(v any) error {
+	if len(a.Args) == 0 {
+		return nil
+	}
+	return json.Unmarshal(a.Args, v)
+}
+
+// DecodeLoad decodes the action as an ActionLoad.
+func (a *Action) DecodeLoad() (*ActionLoad, error) {
+	var load ActionLoad
+	if err := json.Unmarshal(a.Args, &load); err != nil {
+		return nil, err
+	}
+	return &load, nil
+}
+
+// InnerActionName decodes the nested `action` tag for actions whose argument is
+// itself an internally tagged action (e.g. Ctx, Player, StreamingServer).
+func (a *Action) InnerActionName() string {
+	var inner struct {
+		Action string `json:"action"`
+	}
+	if err := json.Unmarshal(a.Args, &inner); err != nil {
+		return ""
+	}
+	return inner.Action
+}
+
+// InnerArgs returns the raw `args` payload of an internally tagged inner
+// action (e.g. Ctx, Player, StreamingServer).
+func (a *Action) InnerArgs() json.RawMessage {
+	var inner struct {
+		Args json.RawMessage `json:"args"`
+	}
+	if err := json.Unmarshal(a.Args, &inner); err != nil {
+		return nil
+	}
+	return inner.Args
+}
+
+// DecodeInnerArgs unmarshals the inner action `args` payload into v.
+func (a *Action) DecodeInnerArgs(v any) error {
+	return json.Unmarshal(a.InnerArgs(), v)
+}
+
+func mustMarshal(v any) json.RawMessage {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return b
+}
