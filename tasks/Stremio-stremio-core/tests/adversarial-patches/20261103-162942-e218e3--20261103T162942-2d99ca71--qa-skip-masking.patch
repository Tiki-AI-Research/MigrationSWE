+++ b/addon_transport/legacy_manifest.go
@@ -0,0 +1,143 @@
+package addontransport
+
+import (
+	"encoding/json"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+// LegacyIDProperty is either a single id property or several.
+type LegacyIDProperty struct {
+	Values []string
+}
+
+// UnmarshalJSON implements json.Unmarshaler for the untagged union.
+func (p *LegacyIDProperty) UnmarshalJSON(data []byte) error {
+	var one string
+	if err := json.Unmarshal(data, &one); err == nil {
+		p.Values = []string{one}
+		return nil
+	}
+	var many []string
+	if err := json.Unmarshal(data, &many); err != nil {
+		return err
+	}
+	p.Values = many
+	return nil
+}
+
+// LegacySort is a legacy manifest sort entry.
+type LegacySort struct {
+	Name  string   `json:"name"`
+	ID    string   `json:"prop"`
+	Types []string `json:"types"`
+}
+
+// LegacyManifest is the legacy addon manifest shape.
+type LegacyManifest struct {
+	ID           string            `json:"id"`
+	Name         string            `json:"name"`
+	Description  *string           `json:"description"`
+	Logo         *string           `json:"logo"`
+	Background   *string           `json:"background"`
+	Version      string            `json:"version"`
+	Methods      []string          `json:"methods"`
+	Types        []string          `json:"types"`
+	ContactEmail *string           `json:"contactEmail"`
+	IDProperty   *LegacyIDProperty `json:"idProperty"`
+	Sorts        []LegacySort      `json:"sorts"`
+}
+
+// LegacyManifestResp wraps a legacy manifest in the JSON-RPC `manifest` field.
+type LegacyManifestResp struct {
+	Manifest LegacyManifest `json:"manifest"`
+}
+
+// LegacyManifestToManifest converts a raw legacy manifest result into a
+// Manifest.
+func LegacyManifestToManifest(raw json.RawMessage) (types.Manifest, error) {
+	var resp LegacyManifestResp
+	if err := json.Unmarshal(raw, &resp); err != nil {
+		return types.Manifest{}, err
+	}
+	return resp.Manifest.ToManifest(), nil
+}
+
+// ToManifest converts a LegacyManifest to a Manifest.
+func (m LegacyManifest) ToManifest() types.Manifest {
+	typesList := m.Types
+	isFind := false
+	for _, method := range m.Methods {
+		if method == "meta.find" {
+			isFind = true
+			break
+		}
+	}
+	var catalogs []types.Catalog
+	if isFind {
+		if len(m.Sorts) > 0 {
+			for _, sort := range m.Sorts {
+				typesForSort := typesList
+				if len(sort.Types) > 0 {
+					typesForSort = sort.Types
+				}
+				for _, t := range typesForSort {
+					catalogs = append(catalogs, types.Catalog{Type: t, ID: sort.ID, Name: sort.Name})
+				}
+			}
+		} else {
+			for _, t := range typesList {
+				catalogs = append(catalogs, types.Catalog{Type: t, ID: "top"})
+			}
+		}
+	}
+
+	var idPrefixes []string
+	if m.IDProperty != nil {
+		for _, p := range m.IDProperty.Values {
+			switch p {
+			case "imdb_id":
+				idPrefixes = append(idPrefixes, "tt")
+			case "yt_id":
+				idPrefixes = append(idPrefixes, "UC")
+			default:
+				idPrefixes = append(idPrefixes, p+":")
+			}
+		}
+	}
+
+	var resources []types.Resource
+	for _, method := range m.Methods {
+		switch method {
+		case "meta.get":
+			resources = append(resources, types.Resource{Name: "meta"})
+		case "stream.find":
+			resources = append(resources, types.Resource{Name: "stream"})
+		case "subtitles.find":
+			resources = append(resources, types.Resource{Name: "subtitles"})
+		}
+	}
+
+	manifest := types.Manifest{
+		ID:         m.ID,
+		Name:       m.Name,
+		Version:    m.Version,
+		Resources:  resources,
+		Types:      m.Types,
+		Catalogs:   catalogs,
+		IDPrefixes: idPrefixes,
+	}
+	if m.Description != nil {
+		manifest.Description = *m.Description
+	}
+	if m.Logo != nil {
+		manifest.Logo = *m.Logo
+	}
+	if m.Background != nil {
+		manifest.Background = *m.Background
+	}
+	if m.ContactEmail != nil {
+		manifest.ContactEmail = *m.ContactEmail
+	}
+	return manifest
+}
