+package types
+
+// Rating is a user rating for a meta item.
+type Rating string
+
+// Ratings.
+const (
+	RatingWatched Rating = "watched"
+	RatingLiked   Rating = "liked"
+	RatingLoved   Rating = "loved"
+)
+
+// RatingInfo is the rating status of a meta item.
+type RatingInfo struct {
+	MetaID string  `json:"metaId"`
+	Status *Rating `json:"status"`
+}
+
+// RatingGetStatusRequest requests the rating status of a meta item.
+type RatingGetStatusRequest struct {
+	AuthKey      AuthKey `json:"authKey"`
+	MetaItemID   string  `json:"metaItemId"`
+	MetaItemType string  `json:"metaItemType"`
+}
+
+// RatingSendRequest sends a rating for a meta item.
+type RatingSendRequest struct {
+	AuthKey      AuthKey `json:"authKey"`
+	MetaItemID   string  `json:"metaItemId"`
+	MetaItemType string  `json:"metaItemType"`
+	Rating       *Rating `json:"rating"`
+}
+
+// RatingGetStatusResponse is the response of a rating status request.
+type RatingGetStatusResponse struct {
+	Status *Rating `json:"status"`
+}
+
+// RatingSendResponse is the response of a rating send request.
+type RatingSendResponse struct {
+	Message string                    `json:"message"`
+	Rating  *RatingSendResponseRating `json:"rating"`
+	Action  *string                   `json:"action"`
+}
+
+// RatingSendResponseRating wraps the resulting rating status.
+type RatingSendResponseRating struct {
+	Status Rating `json:"status"`
+}
