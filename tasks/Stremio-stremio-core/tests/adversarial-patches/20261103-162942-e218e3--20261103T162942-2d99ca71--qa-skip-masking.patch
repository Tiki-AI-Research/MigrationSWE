+func (p *Player) onInternal(internal *msg.Internal, c *ctx.Ctx) runtime.Effects {
+	if internal == nil {
+		return runtime.Default()
+	}
+	switch internal.Name {
+	case msg.InternalLibraryChanged:
+		libraryItemEffects := p.libraryItemUpdate(c)
+		libraryItemStateEffects := p.libraryItemStateUpdate()
+		watchedEffects := p.watchedUpdate()
+		return libraryItemEffects.Join(libraryItemStateEffects).Join(watchedEffects)
+
+	case msg.InternalStreamsChanged:
+		streamStateEffects := common.EqUpdate(&p.StreamState, p.streamStateFromBucket(c))
+		var videoScaleEffects runtime.Effects = runtime.None().Unchanged()
+		if p.VideoScale == nil && p.StreamState != nil && p.StreamState.VideoScale != nil {
+			videoScale := *p.StreamState.VideoScale
+			videoScaleEffects = common.EqUpdate(&p.VideoScale, &videoScale)
+		}
+		return streamStateEffects.Join(videoScaleEffects)
+
+	case msg.InternalResourceRequestResult:
+		if p.Selected == nil {
+			return runtime.None().Unchanged()
+		}
+		result, ok := internal.Data.(msg.ResourceRequestResult)
+		if !ok {
+			return runtime.Default()
+		}
+		request, ok := result.Request.(types.ResourceRequest)
+		if !ok {
+			return runtime.Default()
+		}
+		resourceResult, _ := result.Value.(common.ResourceResult)
+
+		var metaEffects runtime.Effects = runtime.None().Unchanged()
+		if p.MetaItem != nil && request.Path.Resource == core.META_RESOURCE_NAME {
+			metaEffects = common.ResourceUpdate(p.Env, p.MetaItem, common.ResourceRequestResult(&request, resourceResult), convertMetaItem)
+		}
+
+		var updateStreamsEffects runtime.Effects = runtime.None().Unchanged()
+		if p.Selected != nil && p.Selected.StreamRequest != nil && p.Selected.MetaRequest != nil && request.Path.Resource == core.META_RESOURCE_NAME {
+			data := types.StreamLoadedData{
+				Stream:        p.Selected.Stream,
+				StreamRequest: p.Selected.StreamRequest,
+				MetaRequest:   p.Selected.MetaRequest,
+			}
+			updateStreamsEffects = runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalStreamLoaded, data))).Unchanged()
+		}
+
+		var subtitlesEffects runtime.Effects = runtime.None().Unchanged()
+		if request.Path.Resource == core.SUBTITLES_RESOURCE_NAME {
+			subtitlesEffects = common.ResourcesUpdateWithVectorContent(p.Env, &p.Subtitles,
+				common.ResourceRequestResult(&request, resourceResult), convertSubtitles)
+		}
+
+		var nextStreamsEffects runtime.Effects = runtime.None().Unchanged()
+		if p.NextStreams != nil && request.Path.Resource == core.STREAM_RESOURCE_NAME {
+			nextStreamsEffects = common.ResourceUpdateWithVectorContent(p.Env, p.NextStreams,
+				common.ResourceRequestResult(&request, resourceResult), convertStreams)
+		}
+
+		nextStreamEffects := p.nextStreamUpdate()
+		nextVideoEffects := p.nextVideoUpdate()
+		nextStreamsRequestEffects := p.nextStreamsUpdate()
+		seriesInfoEffects := p.seriesInfoUpdate()
+		libraryItemEffects := p.libraryItemUpdate(c)
+		libraryItemStateEffects := p.libraryItemStateUpdate()
+		watchedEffects := p.watchedUpdate()
+		skipGapsEffects := p.skipGapsUpdate(c)
+		p.updateAnalyticsContext(c)
+
+		return metaEffects.
+			Join(updateStreamsEffects).
+			Join(subtitlesEffects).
+			Join(nextVideoEffects).
+			Join(nextStreamsEffects).
+			Join(nextStreamsRequestEffects).
+			Join(nextStreamEffects).
+			Join(seriesInfoEffects).
+			Join(libraryItemEffects).
+			Join(libraryItemStateEffects).
+			Join(watchedEffects).
+			Join(skipGapsEffects)
+
+	case msg.InternalSkipGapsResult:
+		result, ok := internal.Data.(skipGapsResult)
+		if !ok {
+			return runtime.Default()
+		}
+		var nextState *skipGapsState
+		if result.Err != nil {
+			nextState = &skipGapsState{Request: result.Request, Load: common.Err[types.SkipGapsResponse](result.Err)}
+		} else if result.Response != nil {
+			nextState = &skipGapsState{Request: result.Request, Load: common.Ready(*result.Response)}
+		}
+		skipGapsEffects := common.EqUpdate(&p.SkipGaps, nextState)
+		introOutroEffects := p.introOutroUpdate(c)
+		return skipGapsEffects.Join(introOutroEffects)
+
+	case msg.InternalProfileChanged:
+		if p.AnalyticsContext != nil {
+			p.AnalyticsContext.HasTrakt = c.ProfileHasTrakt(p.Env.Now())
+		}
+		return runtime.None().Unchanged()
+	}
+	return runtime.Default()
+}
