+package ctx_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/models"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func dispatch(t *testing.T, env *testenv.Env, model *models.Model, action *msg.Action) []string {
+	t.Helper()
+	rt, rx := runtime.New(model, nil, 64, env)
+	rt.Dispatch(runtime.RuntimeAction{Action: action})
+	var fields []string
+	for {
+		select {
+		case ev := <-rx:
+			if ev.Name == "NewState" {
+				var f []string
+				_ = json.Unmarshal(ev.Args, &f)
+				fields = append(fields, f...)
+			}
+		default:
+			return fields
+		}
+	}
+}
+
+func TestAddToLibraryPersistsLibrary(t *testing.T) {
+	env := testenv.New()
+	model := models.New(env)
+
+	preview := types.MetaItemPreview{ID: "tt1", Type: "movie", Name: "Movie"}
+	action := msg.NewAction(msg.ActionNameCtx, map[string]any{
+		"action": msg.ActionCtxAddToLibrary,
+		"args":   preview,
+	})
+	fields := dispatch(t, env, model, action)
+	if len(fields) == 0 {
+		t.Fatalf("expected the library to change")
+	}
+	if _, ok := model.Ctx.Library.Items["tt1"]; !ok {
+		t.Fatalf("library item was not added: %+v", model.Ctx.Library.Items)
+	}
+	if _, ok := env.Storage["library_recent"]; !ok {
+		t.Fatalf("library_recent was not persisted: %v", env.Storage)
+	}
+}
+
+func TestUpdateSettingsPersistsProfile(t *testing.T) {
+	env := testenv.New()
+	model := models.New(env)
+
+	settings := types.NewSettings()
+	settings.PlayerType = strp("vlc")
+	action := msg.NewAction(msg.ActionNameCtx, map[string]any{
+		"action": msg.ActionCtxUpdateSettings,
+		"args":   settings,
+	})
+	if fields := dispatch(t, env, model, action); len(fields) == 0 {
+		t.Fatalf("expected the profile to change")
+	}
+	if _, ok := env.Storage["profile"]; !ok {
+		t.Fatalf("profile was not persisted: %v", env.Storage)
+	}
+}
+
+func TestAddServerURLPersistsBucket(t *testing.T) {
+	env := testenv.New()
+	model := models.New(env)
+	action := msg.NewAction(msg.ActionNameCtx, map[string]any{
+		"action": msg.ActionCtxAddServerURL,
+		"args":   "http://127.0.0.1:11470",
+	})
+	dispatch(t, env, model, action)
+	if _, ok := env.Storage["streaming_server_urls"]; !ok {
+		t.Fatalf("streaming_server_urls was not persisted: %v", env.Storage)
+	}
+}
+
+func strp(s string) *string { return &s }
diff --git a/models/ctx/error.go b/models/ctx/error.go
