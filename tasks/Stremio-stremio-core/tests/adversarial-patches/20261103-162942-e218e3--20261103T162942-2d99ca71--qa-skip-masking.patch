+
+// Progress returns the watch progress percentage.
+func (i LibraryItem) Progress() float64 {
+	if i.State.TimeOffset > 0 && i.State.Duration > 0 {
+		return (float64(i.State.TimeOffset) / float64(i.State.Duration)) * 100
+	}
+	return 0
+}
+
+// Watched reports whether the item has been watched.
+func (i LibraryItem) Watched() bool { return i.State.TimesWatched > 0 }
+
+// MarkAsWatched marks the item as watched or not.
+func (i *LibraryItem) MarkAsWatched(now time.Time, isWatched bool) {
+	if isWatched {
+		i.State.TimesWatched++
+		i.State.LastWatched = &now
+	} else {
+		i.State.TimesWatched = 0
+	}
+}
+
+// MarkVideoAsWatched sets the watched state of a single video on the item and
+// persists the resulting watched bitfield.
+func (i *LibraryItem) MarkVideoAsWatched(watched WatchedBitField, video Video, isWatched bool) {
+	watched.SetVideo(video.ID, isWatched)
+	encoded := watched.String()
+	i.State.Watched = &encoded
+
+	if isWatched {
+		switch {
+		case i.State.LastWatched != nil && video.Released != nil && i.State.LastWatched.Before(*video.Released):
+			i.State.LastWatched = video.Released
+		case i.State.LastWatched == nil:
+			i.State.LastWatched = video.Released
+		}
+	}
+}
+
+// MarkVideosAsWatched sets the watched state of a list of videos on the item
+// and persists the resulting watched bitfield.
+func (i *LibraryItem) MarkVideosAsWatched(watched WatchedBitField, videos []Video, isWatched bool) {
+	for _, video := range videos {
+		watched.SetVideo(video.ID, isWatched)
+	}
+	encoded := watched.String()
+	i.State.Watched = &encoded
+
+	if isWatched && len(videos) > 0 {
+		last := videos[len(videos)-1]
+		switch {
+		case i.State.LastWatched != nil && last.Released != nil && i.State.LastWatched.Before(*last.Released):
+			i.State.LastWatched = last.Released
+		case i.State.LastWatched == nil:
+			i.State.LastWatched = last.Released
+		}
+	}
+}
+
+// AdvanceToVideo advances the continue-watching pointer to the given video and
+// resets the playback state.
+func (i *LibraryItem) AdvanceToVideo(videoID string) {
+	i.State.VideoID = &videoID
+	i.State.OverallTimeWatched += i.State.TimeWatched
+	i.State.TimeWatched = 0
+	i.State.FlaggedWatched = 0
+	i.State.TimeOffset = 1
+}
+
+// WatchedBitField builds a WatchedBitField for the given videos, restoring any
+// stored watched state.
+func (s LibraryItemState) WatchedBitField(videos []Video) WatchedBitField {
+	sorted := append([]Video(nil), videos...)
+	sort.SliceStable(sorted, func(a, b int) bool {
+		sa, sb := seriesSeason(sorted[a]), seriesSeason(sorted[b])
+		if sa != sb {
+			return sa < sb
+		}
+		ea, eb := seriesEpisode(sorted[a]), seriesEpisode(sorted[b])
+		if ea != eb {
+			return ea < eb
+		}
+		return releasedMillis(sorted[a]) < releasedMillis(sorted[b])
+	})
+
+	ids := make([]string, len(sorted))
+	for i := range sorted {
+		ids[i] = sorted[i].ID
+	}
+
+	if s.Watched != nil {
+		if wbf, err := WatchedBitFieldConstructAndResize(*s.Watched, ids); err == nil {
+			return wbf
+		}
+	}
+	return WatchedBitFieldFromArray(nil, ids)
+}
+
+func seriesSeason(v Video) int64 {
+	if v.SeriesInfo == nil {
+		return -1 << 63
+	}
+	return int64(v.SeriesInfo.Season)
+}
+
+func seriesEpisode(v Video) int64 {
+	if v.SeriesInfo == nil {
+		return -1 << 63
+	}
+	return int64(v.SeriesInfo.Episode)
+}
+
+func releasedMillis(v Video) int64 {
+	if v.Released == nil {
+		return -1 << 63
+	}
+	return v.Released.UnixMilli()
+}
