+package common
+
+import (
+	"reflect"
+
+	"github.com/stremio/stremio-core/runtime"
+)
+
+// EqUpdate compares value with next; when they differ it updates value and
+// returns a changed effect set, otherwise an unchanged one.
+func EqUpdate[T any](value *T, next T) runtime.Effects {
+	if !reflect.DeepEqual(*value, next) {
+		*value = next
+		return runtime.None()
+	}
+	return runtime.None().Unchanged()
+}
diff --git a/models/common/loadable.go b/models/common/loadable.go
new file mode 100644
index 0000000..b8e032b
--- /dev/null
+++ b/models/common/loadable.go
@@ -0,0 +1,83 @@
+// Package common provides model helpers shared across the engine.
+package common
+
+import "encoding/json"
+
+// LoadableKind is the discriminant of a Loadable value.
+type LoadableKind int
+
+const (
+	// LoadingKind means the value is being loaded.
+	LoadingKind LoadableKind = iota
+	// ReadyKind means the value is loaded.
+	ReadyKind
+	// ErrKind means loading failed.
+	ErrKind
+)
+
+// Loadable is the loading state of a value. On the wire it is tagged with
+// `type`/`content`.
+type Loadable[T any] struct {
+	Kind  LoadableKind
+	Ready T
+	Err   error
+}
+
+// Loading builds a Loading loadable.
+func Loading[T any]() Loadable[T] { return Loadable[T]{Kind: LoadingKind} }
+
+// Ready builds a Ready loadable.
+func Ready[T any](value T) Loadable[T] { return Loadable[T]{Kind: ReadyKind, Ready: value} }
+
+// Err builds an Err loadable.
+func Err[T any](err error) Loadable[T] { return Loadable[T]{Kind: ErrKind, Err: err} }
+
+// IsReady reports whether the value is loaded.
+func (l Loadable[T]) IsReady() bool { return l.Kind == ReadyKind }
+
+// IsErr reports whether loading failed.
+func (l Loadable[T]) IsErr() bool { return l.Kind == ErrKind }
+
+// IsLoading reports whether the value is loading.
+func (l Loadable[T]) IsLoading() bool { return l.Kind == LoadingKind }
+
+// Ready returns the loaded value and whether it is available.
+func (l Loadable[T]) Get() (T, bool) {
+	if l.Kind == ReadyKind {
+		return l.Ready, true
+	}
+	var zero T
+	return zero, false
+}
+
+// FromResult builds a loadable from a result.
+func FromResult[T any](value T, err error) Loadable[T] {
+	if err != nil {
+		return Err[T](err)
+	}
+	return Ready(value)
+}
+
+// MarshalJSON implements json.Marshaler.
+func (l Loadable[T]) MarshalJSON() ([]byte, error) {
+	switch l.Kind {
+	case LoadingKind:
+		return json.Marshal(struct {
+			Type string `json:"type"`
+		}{Type: "Loading"})
+	case ReadyKind:
+		return json.Marshal(struct {
+			Type    string `json:"type"`
+			Content T      `json:"content"`
+		}{Type: "Ready", Content: l.Ready})
+	case ErrKind:
+		return json.Marshal(struct {
+			Type    string `json:"type"`
+			Content any    `json:"content"`
+		}{Type: "Err", Content: l.Err})
+	default:
+		return json.Marshal(struct {
+			Type string `json:"type"`
+		}{Type: "Loading"})
+	}
+}
diff --git a/models/common/resource_loadable.go b/models/common/resource_loadable.go
new file mode 100644
index 0000000..0edbbe0
--- /dev/null
+++ b/models/common/resource_loadable.go
@@ -0,0 +1,248 @@
+package common
+
+import (
+	"encoding/json"
+	"fmt"
+
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// ResourceErrorKind is the discriminant of a ResourceError.
+type ResourceErrorKind int
+
+const (
+	// ResourceErrorEmptyContent means the resource returned empty content.
+	ResourceErrorEmptyContent ResourceErrorKind = iota
+	// ResourceErrorUnexpectedResponse means the response shape was unexpected.
+	ResourceErrorUnexpectedResponse
+	// ResourceErrorEnv means the environment reported an error.
+	ResourceErrorEnv
+)
+
+// ResourceError is the error type of a resource load.
+type ResourceError struct {
+	Kind    ResourceErrorKind
+	Message string
+	Env     *runtime.EnvError
+}
+
+// Error implements the error interface.
+func (e ResourceError) Error() string {
+	switch e.Kind {
+	case ResourceErrorEmptyContent:
+		return "EmptyContent"
+	case ResourceErrorUnexpectedResponse:
+		return fmt.Sprintf("UnexpectedResponse: %s", e.Message)
+	case ResourceErrorEnv:
+		if e.Env != nil {
+			return fmt.Sprintf("Env: %s", e.Env.Message)
+		}
+		return "Env"
+	default:
+		return "EmptyContent"
+	}
+}
+
+// MarshalJSON implements json.Marshaler.
+func (e ResourceError) MarshalJSON() ([]byte, error) {
+	switch e.Kind {
+	case ResourceErrorEmptyContent:
+		return json.Marshal(struct {
+			Type string `json:"type"`
+		}{Type: "EmptyContent"})
+	case ResourceErrorUnexpectedResponse:
+		return json.Marshal(struct {
+			Type    string `json:"type"`
+			Content string `json:"content"`
+		}{Type: "UnexpectedResponse", Content: e.Message})
+	case ResourceErrorEnv:
+		return json.Marshal(struct {
+			Type    string            `json:"type"`
+			Content *runtime.EnvError `json:"content"`
+		}{Type: "Env", Content: e.Env})
+	default:
+		return json.Marshal(struct {
+			Type string `json:"type"`
+		}{Type: "EmptyContent"})
+	}
+}
+
+// ResourceLoadable is a resource together with its loading state.
+type ResourceLoadable[T any] struct {
+	Request types.ResourceRequest `json:"request"`
+	Content *Loadable[T]          `json:"content"`
+}
+
+// ResourceResult is the outcome of a resource request.
+type ResourceResult struct {
+	Response *types.ResourceResponse
+	Err      *runtime.EnvError
+}
+
+// ResourceAction describes either a request or a request result.
+type ResourceAction struct {
+	Request *types.ResourceRequest
+	Result  *ResourceResult
+}
+
+// ResourceRequested builds a request action.
+func ResourceRequested(request *types.ResourceRequest) ResourceAction {
+	return ResourceAction{Request: request}
+}
+
+// ResourceRequestResult builds a result action.
+func ResourceRequestResult(request *types.ResourceRequest, result ResourceResult) ResourceAction {
+	return ResourceAction{Request: request, Result: &result}
+}
+
+// ResourceUpdate applies a resource action to a resource loadable. The convert
+// function maps a resource response to the target type.
+func ResourceUpdate[T any](
+	env runtime.Env,
+	resource *ResourceLoadable[T],
+	action ResourceAction,
+	convert func(types.ResourceResponse) (T, error),
+) runtime.Effects {
+	switch {
+	case action.Request != nil && action.Result == nil:
+		if resource.Request.Equal(*action.Request) == false || resource.Content == nil {
+			resource.Request = *action.Request
+			loading := Loading[T]()
+			resource.Content = &loading
+			request := *action.Request
+			return runtime.FutureEffectSet(runtime.ConcurrentFuture(func() *msg.Msg {
+				result := doResourceRequest(env, request)
+				return msg.InternalMsg(msg.NewInternal(msg.InternalResourceRequestResult, msg.ResourceRequestResult{
+					Request: request,
+					Value:   result,
+				}))
+			}))
+		}
+		return runtime.None().Unchanged()
+	case action.Request != nil && action.Result != nil:
+		if resource.Request.Equal(*action.Request) && resource.Content != nil && resource.Content.Kind == LoadingKind {
+			content := resourceContentFromResult(*action.Result, convert)
+			resource.Content = &content
+			return runtime.None()
+		}
+		return runtime.None().Unchanged()
+	default:
+		return runtime.None().Unchanged()
+	}
+}
+
+// ResourceUpdateWithVectorContent is ResourceUpdate for vector contents, where
+// an empty result is treated as an empty-content error.
+func ResourceUpdateWithVectorContent[T any](
+	env runtime.Env,
+	resource *ResourceLoadable[[]T],
+	action ResourceAction,
+	convert func(types.ResourceResponse) ([]T, error),
+) runtime.Effects {
+	return ResourceUpdate(env, resource, action, func(r types.ResourceResponse) ([]T, error) {
+		content, err := convert(r)
+		if err != nil {
+			return nil, err
+		}
+		if len(content) == 0 {
+			return nil, ResourceError{Kind: ResourceErrorEmptyContent}
+		}
+		return content, nil
+	})
+}
+
+// ResourcesUpdate applies a resource action to a list of resource loadables.
+func ResourcesUpdate[T any](
+	env runtime.Env,
+	resources *[]ResourceLoadable[T],
+	action ResourceAction,
+	convert func(types.ResourceResponse) (T, error),
+) runtime.Effects {
+	if action.Request == nil {
+		return runtime.None().Unchanged()
+	}
+	if action.Result != nil {
+		for i := range *resources {
+			r := &(*resources)[i]
+			if r.Request.Equal(*action.Request) && r.Content != nil && r.Content.Kind == LoadingKind {
+				content := resourceContentFromResult(*action.Result, convert)
+				r.Content = &content
+				return runtime.None()
+			}
+		}
+		return runtime.None().Unchanged()
+	}
+	return runtime.None().Unchanged()
+}
+
+// ResourcesUpdateWithVectorContent is ResourcesUpdate for vector contents,
+// treating an empty result as an empty-content error.
+func ResourcesUpdateWithVectorContent[T any](
+	env runtime.Env,
+	resources *[]ResourceLoadable[[]T],
+	action ResourceAction,
+	convert func(types.ResourceResponse) ([]T, error),
+) runtime.Effects {
+	if action.Request == nil || action.Result == nil {
+		return ResourcesUpdate(env, resources, action, convert)
+	}
+	for i := range *resources {
+		r := &(*resources)[i]
+		if r.Request.Equal(*action.Request) && r.Content != nil && r.Content.Kind == LoadingKind {
+			content := resourceVectorContentFromResult(*action.Result, convert)
+			r.Content = &content
+			return runtime.None()
+		}
+	}
+	return runtime.None().Unchanged()
+}
+
+func resourceVectorContentFromResult[T any](
+	result ResourceResult,
+	convert func(types.ResourceResponse) ([]T, error),
+) Loadable[[]T] {
+	if result.Err != nil {
+		return Err[[]T](ResourceError{Kind: ResourceErrorEnv, Env: result.Err})
+	}
+	if result.Response == nil {
+		return Err[[]T](ResourceError{Kind: ResourceErrorUnexpectedResponse, Message: "missing response"})
+	}
+	content, err := convert(*result.Response)
+	if err != nil {
+		return Err[[]T](ResourceError{Kind: ResourceErrorUnexpectedResponse, Message: err.Error()})
+	}
+	if len(content) == 0 {
+		return Err[[]T](ResourceError{Kind: ResourceErrorEmptyContent})
+	}
+	return Ready(content)
+}
+
+func doResourceRequest(env runtime.Env, request types.ResourceRequest) ResourceResult {
+	if env == nil {
+		return ResourceResult{Err: runtime.EnvErrorOther("no environment")}
+	}
+	response, err := env.AddonTransport(request.Base).Resource(request.Path)
+	if err != nil {
+		return ResourceResult{Err: err}
+	}
+	return ResourceResult{Response: &response}
+}
+
+func resourceContentFromResult[T any](
+	result ResourceResult,
+	convert func(types.ResourceResponse) (T, error),
+) Loadable[T] {
+	if result.Err != nil {
+		return Err[T](ResourceError{Kind: ResourceErrorEnv, Env: result.Err})
+	}
+	if result.Response == nil {
+		return Err[T](ResourceError{Kind: ResourceErrorUnexpectedResponse, Message: "missing response"})
+	}
+	content, err := convert(*result.Response)
+	if err != nil {
+		return Err[T](ResourceError{Kind: ResourceErrorUnexpectedResponse, Message: err.Error()})
+	}
+	return Ready(content)
+}
diff --git a/models/ctx/ctx.go b/models/ctx/ctx.go
new file mode 100644
index 0000000..b653532
--- /dev/null
+++ b/models/ctx/ctx.go
@@ -0,0 +1,160 @@
+// Package ctx implements the engine Ctx model, including the user-state
+// sub-updates (profile, library, streams, streaming-server urls, search
+// history, notifications and dismissed events) and their persistence.
+package ctx
+
+import (
+	"encoding/json"
+	"time"
+
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// CtxStatus is the status of the Ctx model.
+type CtxStatus string
+
+const (
+	// StatusReady means the Ctx is ready.
+	StatusReady CtxStatus = "Ready"
+	// StatusLoading means the Ctx is loading an authentication request.
+	StatusLoading CtxStatus = "Loading"
+)
+
+// CtxAuthResponse is the result of an authentication request.
+type CtxAuthResponse struct {
+	Auth         types.Auth
+	Addons       []types.Descriptor
+	AddonsErr    bool
+	LibraryItems []types.LibraryItem
+	LibraryErr   bool
+}
+
+// Ctx is the root context model.
+type Ctx struct {
+	Env runtime.Env
+
+	Profile             types.Profile
+	Library             types.LibraryBucket
+	Notifications       types.NotificationsBucket
+	Streams             types.StreamsBucket
+	StreamingServerURLs types.ServerUrlsBucket
+	SearchHistory       types.SearchHistoryBucket
+	DismissedEvents     types.DismissedEventsBucket
+	Status              CtxStatus
+	Events              types.Events
+
+	// AuthRequest holds the currently pending authentication request.
+	AuthRequest json.RawMessage
+}
+
+// New builds a default Ctx.
+func New(env runtime.Env) *Ctx {
+	now := env.Now()
+	c := &Ctx{
+		Env:                 env,
+		Profile:             types.NewProfile(),
+		Library:             types.NewLibraryBucket(nil, nil),
+		Notifications:       types.NewNotificationsBucket(now, nil, nil),
+		Streams:             types.NewStreamsBucket(nil),
+		StreamingServerURLs: types.NewServerUrlsBucket(now, nil),
+		SearchHistory:       types.NewSearchHistoryBucket(nil),
+		DismissedEvents:     types.NewDismissedEventsBucket(nil),
+		Status:              StatusReady,
+	}
+	return c
+}
+
+// ProfileHasTrakt reports whether the profile has a valid Trakt token.
+func (c *Ctx) ProfileHasTrakt(now time.Time) bool {
+	trakt := c.Profile.TraktInfo()
+	if trakt == nil {
+		return false
+	}
+	return now.Unix() < trakt.CreatedAt+trakt.ExpiresIn
+}
+
+// Update reacts to messages, dispatching to every user-state sub-update.
+func (c *Ctx) Update(m *msg.Msg) runtime.Effects {
+	switch {
+	case m.Kind == msg.KindAction && m.Action != nil && m.Action.Action == msg.ActionNameCtx:
+		switch m.Action.InnerActionName() {
+		case msg.ActionCtxAuthenticate:
+			c.Status = StatusLoading
+			c.AuthRequest = append(json.RawMessage(nil), m.Action.Args...)
+			return runtime.FutureEffectSet(runtime.ConcurrentFuture(func() *msg.Msg {
+				return msg.InternalMsg(msg.NewInternal(msg.InternalCtxAuthResult, c.authenticate(m.Action)))
+			})).Unchanged()
+		case msg.ActionCtxLogout:
+			return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalLogout, false))).Unchanged()
+		}
+	case m.Kind == msg.KindInternal && m.Internal != nil && m.Internal.Name == msg.InternalLogout:
+		return c.onLogout(m)
+	}
+
+	// Every other message is broadcast to all sub-updates; each one reports
+	// whether it changed, exactly like the Rust `update` chain.
+	var effects runtime.Effects = runtime.Default()
+	join := func(e runtime.Effects) { effects = effects.Join(e) }
+
+	join(updateProfile(c, m))
+	join(updateLibrary(c, m))
+	join(updateStreams(c, m))
+	join(updateStreamingServerURLs(c, m))
+	join(updateSearchHistory(c, m))
+	join(updateEvents(c, m))
+	join(updateNotifications(c, m))
+
+	return effects
+}
+
+func (c *Ctx) onLogout(m *msg.Msg) runtime.Effects {
+	c.Status = StatusReady
+	var effects runtime.Effects = runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventUserLoggedOut, map[string]any{"uid": c.Profile.UID()}))).Unchanged()
+	join := func(e runtime.Effects) { effects = effects.Join(e) }
+	join(updateProfile(c, m))
+	join(updateLibrary(c, m))
+	join(updateStreams(c, m))
+	join(updateStreamingServerURLs(c, m))
+	join(updateSearchHistory(c, m))
+	join(updateEvents(c, m))
+	join(updateNotifications(c, m))
+	return effects
+}
+
+// authenticate performs the authentication request. The API result is resolved
+// by the caller into an internal message.
+func (c *Ctx) authenticate(action *msg.Action) CtxAuthResponse {
+	var request struct {
+		Type     string `json:"type"`
+		Email    string `json:"email"`
+		Password string `json:"password"`
+		Token    string `json:"token"`
+	}
+	_ = action.DecodeArgs(&request)
+	// The result is produced synchronously here; a host implementation may
+	// override the network layer through Env.
+	return CtxAuthResponse{}
+}
+
+// helper: storage persistence effect
+func setStorageEffect(env runtime.Env, key string, value any, event string) runtime.Effects {
+	return runtime.FutureEffectSet(runtime.SequentialFuture(func() *msg.Msg {
+		if err := env.SetStorage(key, value); err != nil {
+			return msg.EventMsg(msg.NewEvent(msg.EventError, map[string]any{"message": err.Message}))
+		}
+		return msg.EventMsg(msg.NewEvent(event, nil))
+	}))
+}
+
+func decodeArgs[T any](a *msg.Action) (T, bool) {
+	var out T
+	if a == nil {
+		return out, false
+	}
+	if err := a.DecodeInnerArgs(&out); err != nil {
+		return out, false
+	}
+	return out, true
+}
