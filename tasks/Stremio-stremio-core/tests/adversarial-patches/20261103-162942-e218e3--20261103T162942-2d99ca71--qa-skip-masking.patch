+// Package addontransport implements the addon transport abstraction and the
+// HTTP / legacy JSON-RPC transports.
+package addontransport
+
+import (
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+// UnsupportedTransport is used for transport URLs with an unsupported scheme.
+type UnsupportedTransport struct {
+	TransportURL string
+}
+
+// NewUnsupportedTransport builds an UnsupportedTransport.
+func NewUnsupportedTransport(transportURL string) *UnsupportedTransport {
+	return &UnsupportedTransport{TransportURL: transportURL}
+}
+
+// Resource always returns an addon transport error.
+func (t *UnsupportedTransport) Resource(path types.ResourcePath) (types.ResourceResponse, *runtime.EnvError) {
+	return types.ResourceResponse{}, runtime.EnvErrorAddonTransport("unsupported transport")
+}
+
+// Manifest always returns an addon transport error.
+func (t *UnsupportedTransport) Manifest() (types.Manifest, *runtime.EnvError) {
+	return types.Manifest{}, runtime.EnvErrorAddonTransport("unsupported transport")
+}
+
+var _ runtime.AddonTransport = (*UnsupportedTransport)(nil)
