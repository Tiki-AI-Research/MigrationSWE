new file mode 100644
index 0000000..3db63db
--- /dev/null
+++ b/models/api.go
@@ -0,0 +1,91 @@
+package models
+
+import (
+	"encoding/json"
+
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+// fetchAPI performs a Stremio API request and unwraps the
+// `{"result": ...}` / `{"error": {...}}` envelope.
+func fetchAPI[T any](env runtime.Env, path string, payload any) (T, error) {
+	var zero T
+	if env == nil {
+		return zero, runtime.EnvErrorOther("no environment")
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return zero, runtime.EnvErrorSerde(err.Error())
+	}
+	endpoint := core.API_URL + "/api/" + path
+	raw, envErr := env.Fetch("POST", endpoint, map[string]string{"Content-Type": "application/json"}, body)
+	if envErr != nil {
+		return zero, envErr
+	}
+	var wrapper struct {
+		Result json.RawMessage `json:"result"`
+		Error  *types.APIError `json:"error"`
+	}
+	if err := json.Unmarshal(raw, &wrapper); err != nil {
+		return zero, runtime.EnvErrorSerde(err.Error())
+	}
+	if wrapper.Error != nil {
+		return zero, ctx.OtherError(wrapper.Error.Message)
+	}
+	var out T
+	if err := json.Unmarshal(wrapper.Result, &out); err != nil {
+		return zero, runtime.EnvErrorSerde(err.Error())
+	}
+	return out, nil
+}
+
+// seekLogAPIRequest is the tagged body of a seek-log API request.
+type seekLogAPIRequest struct {
+	Type string `json:"type"`
+	types.SeekLogRequest
+}
+
+// skipGapsAPIRequest is the tagged body of a skip-gaps API request.
+type skipGapsAPIRequest struct {
+	Type string `json:"type"`
+	types.SkipGapsRequest
+}
+
+// watchedSendBody is the body of a send-watched request to the user-likes API.
+type watchedSendBody struct {
+	AuthToken string        `json:"authToken"`
+	MediaID   string        `json:"mediaId"`
+	MediaType string        `json:"mediaType"`
+	Status    *types.Rating `json:"status"`
+}
+
+// sendWatched submits the watched rating for a meta item.
+func sendWatched(env runtime.Env, authKey types.AuthKey, metaID, metaType string) (types.RatingSendResponse, error) {
+	var zero types.RatingSendResponse
+	if env == nil {
+		return zero, runtime.EnvErrorOther("no environment")
+	}
+	status := types.RatingWatched
+	body, err := json.Marshal(watchedSendBody{
+		AuthToken: string(authKey),
+		MediaID:   metaID,
+		MediaType: metaType,
+		Status:    &status,
+	})
+	if err != nil {
+		return zero, runtime.EnvErrorSerde(err.Error())
+	}
+	endpoint := core.USER_LIKES_API_URL + "/api/send"
+	raw, envErr := env.Fetch("POST", endpoint, map[string]string{"Content-Type": "application/json"}, body)
+	if envErr != nil {
+		return zero, envErr
+	}
+	var out types.RatingSendResponse
+	if err := json.Unmarshal(raw, &out); err != nil {
+		return zero, runtime.EnvErrorSerde(err.Error())
+	}
+	return out, nil
+}
