+)
+
+// PlaybackDevice is a streaming server playback device.
+type PlaybackDevice struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	Type string `json:"type"`
+}
+
+// StreamingServerSelected is the selected streaming server state.
+type StreamingServerSelected struct {
+	TransportURL string                   `json:"transportUrl"`
+	Statistics   *types.StatisticsRequest `json:"statistics,omitempty"`
+}
+
+// torrentState holds the torrent created through the streaming server.
+type torrentState struct {
+	InfoHash types.InfoHash
+	Load     common.Loadable[types.ResourcePath]
+}
+
+// StreamingServer is the streaming server model.
+type StreamingServer struct {
+	Env                       runtime.Env
+	Selected                  StreamingServerSelected
+	BaseURL                   *string
+	RemoteURL                 *string
+	Settings                  common.Loadable[types.StreamingServerSettings]
+	SettingsOptions           []types.SettingsOption
+	PlaybackDevices           common.Loadable[[]PlaybackDevice]
+	PlaybackDevicesGeneration uint64
+	NetworkInfo               common.Loadable[types.NetworkInfo]
+	DeviceInfo                common.Loadable[types.DeviceInfo]
+	Torrent                   *torrentState
+	Statistics                *common.Loadable[types.Statistics]
+}
+
+// NewStreamingServer builds a streaming server model with no selected server.
+func NewStreamingServer(env runtime.Env) *StreamingServer {
+	return &StreamingServer{
+		Env:             env,
+		Settings:        common.Loading[types.StreamingServerSettings](),
+		PlaybackDevices: common.Loading[[]PlaybackDevice](),
+		NetworkInfo:     common.Loading[types.NetworkInfo](),
+		DeviceInfo:      common.Loading[types.DeviceInfo](),
+	}
+}
+
+// NewStreamingServerWithEffects builds a streaming server model seeded from the
+// profile and returns the initial effects.
+func NewStreamingServerWithEffects(env runtime.Env, profile types.Profile) (*StreamingServer, runtime.Effects) {
+	s := NewStreamingServer(env)
+	s.Selected.TransportURL = profile.Settings.StreamingServerURL
+	effects := runtime.Many([]runtime.Effect{}).
+		Join(s.getSettings(profile.Settings.StreamingServerURL)).
+		Join(s.getPlaybackDevices(profile.Settings.StreamingServerURL, 0)).
+		Join(s.getNetworkInfo(profile.Settings.StreamingServerURL)).
+		Join(s.getDeviceInfo(profile.Settings.StreamingServerURL))
+	return s, effects.Unchanged()
+}
+
+// serverURL resolves the configured streaming server url.
+func (s *StreamingServer) serverURL(c *ctx.Ctx) string {
+	if s.Selected.TransportURL != "" {
+		return s.Selected.TransportURL
+	}
+	if c != nil && c.Profile.Settings.StreamingServerURL != "" {
+		return c.Profile.Settings.StreamingServerURL
+	}
+	return types.DefaultSettingStreamingServerURL
+}
+
+// result payloads for internal streaming-server messages.
+type settingsResult struct {
+	URL      string
+	Settings *types.SettingsResponse
+	Err      error
+}
+
+type playbackDevicesResult struct {
+	URL        string
+	Generation uint64
+	Devices    []PlaybackDevice
+	Err        error
+}
+
+type networkInfoResult struct {
+	URL  string
+	Info *types.NetworkInfo
+	Err  error
+}
+
+type deviceInfoResult struct {
+	URL  string
+	Info *types.DeviceInfo
+	Err  error
+}
+
+type updateSettingsResult struct {
+	URL string
+	Err error
+}
+
+type createTorrentResult struct {
+	InfoHash types.InfoHash
+	Err      error
+}
+
+type playOnDeviceResult struct {
+	Device string
+	Err    error
+}
+
+type getHTTPSResult struct {
+	URL      string
+	Response *types.GetHTTPSResponse
+	Err      error
+}
+
+type statisticsResult struct {
+	URL        string
+	Request    types.StatisticsRequest
+	Statistics *types.Statistics
+	Loaded     bool
+	Err        error
+}
+
+// UpdateWithCtx reacts to streaming-server messages.
+func (s *StreamingServer) UpdateWithCtx(m *msg.Msg, c *ctx.Ctx) runtime.Effects {
+	if m.Kind == msg.KindInternal {
+		return s.onInternal(m.Internal, c)
+	}
+	if m.Kind != msg.KindAction || m.Action == nil || m.Action.Action != msg.ActionNameStreamingServer {
+		return runtime.Default()
+	}
+	base := s.serverURL(c)
+	s.Selected.TransportURL = base
+
+	switch m.Action.InnerActionName() {
+	case msg.ActionStreamingServerReload:
+		settingsEffects := common.EqUpdate(&s.Settings, common.Loading[types.StreamingServerSettings]())
+		networkInfoEffects := common.EqUpdate(&s.NetworkInfo, common.Loading[types.NetworkInfo]())
+		deviceInfoEffects := common.EqUpdate(&s.DeviceInfo, common.Loading[types.DeviceInfo]())
+		settingsOptionsEffects := common.EqUpdate(&s.SettingsOptions, []types.SettingsOption(nil))
+		baseURLEffects := common.EqUpdate(&s.BaseURL, (*string)(nil))
+		remoteURLEffects := common.EqUpdate(&s.RemoteURL, (*string)(nil))
+		s.PlaybackDevicesGeneration++
+		return runtime.Many([]runtime.Effect{}).
+			Join(s.getSettings(base)).
+			Join(s.getPlaybackDevices(base, s.PlaybackDevicesGeneration)).
+			Join(s.getNetworkInfo(base)).
+			Join(s.getDeviceInfo(base)).
+			Unchanged().
+			Join(settingsEffects).
+			Join(settingsOptionsEffects).
+			Join(networkInfoEffects).
+			Join(deviceInfoEffects).
+			Join(baseURLEffects).
+			Join(remoteURLEffects)
+
+	case msg.ActionStreamingServerRefreshPlaybackDevices:
+		s.PlaybackDevicesGeneration++
+		return s.getPlaybackDevices(base, s.PlaybackDevicesGeneration).Unchanged()
+
+	case msg.ActionStreamingServerUpdateSettings:
+		if !s.Settings.IsReady() {
+			return runtime.Default()
+		}
+		var settings types.StreamingServerSettings
+		if err := m.Action.DecodeInnerArgs(&settings); err != nil {
+			return runtime.Default()
+		}
+		settingsEffects := common.EqUpdate(&s.Settings, common.Ready(settings))
+		remoteURLEffects := s.updateRemoteURL(c, settings)
+		return s.setSettings(base, settings).
+			Unchanged().
+			Join(settingsEffects).
+			Join(remoteURLEffects)
+
+	case msg.ActionStreamingServerCreateTorrent:
+		return s.onCreateTorrent(m.Action, base)
+
+	case msg.ActionStreamingServerGetStatistics:
+		var request types.StatisticsRequest
+		if err := m.Action.DecodeInnerArgs(&request); err != nil {
+			return runtime.Default()
+		}
+		selectedEffects := common.EqUpdate(&s.Selected.Statistics, &request)
+		isDifferent := s.Selected.Statistics == nil || !s.Selected.Statistics.Equal(request)
+		var statisticsEffects runtime.Effects = runtime.None().Unchanged()
+		if s.Statistics == nil || isDifferent {
+			statisticsEffects = common.EqUpdate(&s.Statistics, &common.Loadable[types.Statistics]{Kind: common.LoadingKind})
+		}
+		return s.getTorrentStatistics(base, request).
+			Unchanged().
+			Join(selectedEffects).
+			Join(statisticsEffects)
+
+	case msg.ActionStreamingServerPlayOnDevice:
+		var args struct {
+			Device string  `json:"device"`
+			Source string  `json:"source"`
+			Time   *uint64 `json:"time"`
+		}
+		if err := m.Action.DecodeInnerArgs(&args); err != nil {
+			return runtime.Default()
+		}
+		if !looksLikeURL(args.Source) {
+			return runtime.None().Unchanged()
+		}
+		if !s.PlaybackDevices.IsReady() {
+			return runtime.None().Unchanged()
+		}
+		for _, device := range s.PlaybackDevices.Ready {
+			if device.ID == args.Device {
+				return s.playOnDevice(base, args.Device, args.Source, args.Time).Unchanged()
+			}
+		}
+		return runtime.None().Unchanged()
+	}
+	return runtime.None().Unchanged()
+}
+
+func (s *StreamingServer) onCreateTorrent(a *msg.Action, base string) runtime.Effects {
+	raw := a.InnerArgs()
+	if len(raw) == 0 {
+		return runtime.Default()
+	}
+
+	// Magnet form: a JSON string.
+	var magnet string
+	if err := json.Unmarshal(raw, &magnet); err == nil {
+		infoHash, announce, err := parseMagnet(magnet)
+		if err != nil {
+			torrentEffects := common.EqUpdate(&s.Torrent, (*torrentState)(nil))
+			eventEffects := runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventError, map[string]any{
+				"error":  map[string]any{"type": "Other", "message": "Failed to parse magnet url"},
+				"source": map[string]any{"event": msg.EventMagnetParsed, "args": map[string]any{"magnet": magnet}},
+			}))).Unchanged()
+			return eventEffects.Join(torrentEffects)
+		}
+		torrentEffects := common.EqUpdate(&s.Torrent, &torrentState{InfoHash: infoHash, Load: common.Loading[types.ResourcePath]()})
+		createEffects := s.createMagnet(base, infoHash, announce)
+		eventEffects := runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventMagnetParsed,
+			map[string]any{"magnet": magnet}))).Unchanged()
+		return createEffects.Join(eventEffects).Unchanged().Join(torrentEffects)
+	}
+
+	// File form: a JSON array of bytes.
+	var torrent []int
+	if err := json.Unmarshal(raw, &torrent); err != nil {
+		return runtime.Default()
+	}
+	blob := make([]byte, len(torrent))
+	for i, b := range torrent {
+		blob[i] = byte(b)
+	}
+	infoHash, err := parseTorrentInfoHash(blob)
+	if err != nil {
+		torrentEffects := common.EqUpdate(&s.Torrent, (*torrentState)(nil))
+		eventEffects := runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventError, map[string]any{
+			"error":  map[string]any{"type": "Other", "message": "Failed to parse stream from file: " + err.Error()},
+			"source": map[string]any{"event": msg.EventTorrentParsed, "args": map[string]any{"torrent": torrent}},
+		}))).Unchanged()
+		return eventEffects.Join(torrentEffects)
+	}
+	torrentEffects := common.EqUpdate(&s.Torrent, &torrentState{InfoHash: infoHash, Load: common.Loading[types.ResourcePath]()})
+	createEffects := s.createTorrentRequest(base, infoHash, blob)
+	eventEffects := runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventTorrentParsed,
+		map[string]any{"torrent": torrent}))).Unchanged()
+	return createEffects.Join(eventEffects).Unchanged().Join(torrentEffects)
+}
+
+func (s *StreamingServer) onInternal(internal *msg.Internal, c *ctx.Ctx) runtime.Effects {
+	if internal == nil {
+		return runtime.Default()
+	}
+	switch internal.Name {
+	case msg.InternalProfileChanged:
+		if c != nil && s.serverURL(c) != c.Profile.Settings.StreamingServerURL {
+			s.Selected = StreamingServerSelected{TransportURL: c.Profile.Settings.StreamingServerURL}
+			s.Settings = common.Loading[types.StreamingServerSettings]()
+			s.SettingsOptions = nil
+			s.NetworkInfo = common.Loading[types.NetworkInfo]()
+			s.DeviceInfo = common.Loading[types.DeviceInfo]()
+			s.BaseURL = nil
+			s.RemoteURL = nil
+			s.Torrent = nil
+			s.Statistics = nil
+			s.PlaybackDevicesGeneration++
+			return runtime.Many([]runtime.Effect{}).
+				Join(s.getSettings(s.Selected.TransportURL)).
+				Join(s.getPlaybackDevices(s.Selected.TransportURL, s.PlaybackDevicesGeneration)).
+				Join(s.getNetworkInfo(s.Selected.TransportURL)).
+				Join(s.getDeviceInfo(s.Selected.TransportURL))
+		}
+		return runtime.None().Unchanged()
+
+	case msg.InternalStreamingServerSettingsResult:
+		data, ok := internal.Data.(settingsResult)
+		if !ok || data.URL != s.Selected.TransportURL || !s.Settings.IsLoading() {
+			return runtime.Default()
+		}
+		if data.Err != nil || data.Settings == nil {
+			err := data.Err
+			if err == nil {
+				err = runtime.EnvErrorOther("missing settings")
+			}
+			return common.EqUpdate(&s.BaseURL, (*string)(nil)).
+				Join(common.EqUpdate(&s.RemoteURL, (*string)(nil))).
+				Join(common.EqUpdate(&s.SettingsOptions, []types.SettingsOption(nil))).
+				Join(common.EqUpdate(&s.PlaybackDevices, common.Err[[]PlaybackDevice](err))).
+				Join(common.EqUpdate(&s.NetworkInfo, common.Err[types.NetworkInfo](err))).
+				Join(common.EqUpdate(&s.DeviceInfo, common.Err[types.DeviceInfo](err))).
+				Join(common.EqUpdate(&s.Settings, common.Err[types.StreamingServerSettings](err))).
+				Join(common.EqUpdate(&s.Torrent, (*torrentState)(nil)))
+		}
+		baseURL := data.Settings.BaseURL
+		settingsEffects := common.EqUpdate(&s.Settings, common.Ready(data.Settings.Values))
+		settingsOptionsEffects := common.EqUpdate(&s.SettingsOptions, data.Settings.Options)
+		baseURLEffects := common.EqUpdate(&s.BaseURL, &baseURL)
+		remoteURLEffects := s.updateRemoteURL(c, data.Settings.Values)
+		return settingsEffects.Join(settingsOptionsEffects).Join(baseURLEffects).Join(remoteURLEffects)
+
+	case msg.InternalStreamingServerPlaybackDevicesResult:
+		data, ok := internal.Data.(playbackDevicesResult)
+		if !ok || data.URL != s.Selected.TransportURL || data.Generation != s.PlaybackDevicesGeneration {
+			return runtime.Default()
+		}
+		if data.Err != nil {
+			if s.PlaybackDevices.IsLoading() {
+				return common.EqUpdate(&s.PlaybackDevices, common.Err[[]PlaybackDevice](data.Err))
+			}
+			return runtime.None().Unchanged()
+		}
+		return common.EqUpdate(&s.PlaybackDevices, common.Ready(data.Devices))
+
+	case msg.InternalStreamingServerNetworkInfoResult:
+		data, ok := internal.Data.(networkInfoResult)
+		if !ok || data.URL != s.Selected.TransportURL || !s.NetworkInfo.IsLoading() {
+			return runtime.Default()
+		}
+		if data.Err != nil {
+			return common.EqUpdate(&s.NetworkInfo, common.Err[types.NetworkInfo](data.Err))
+		}
+		return common.EqUpdate(&s.NetworkInfo, common.Ready(*data.Info))
+
+	case msg.InternalStreamingServerDeviceInfoResult:
+		data, ok := internal.Data.(deviceInfoResult)
+		if !ok || data.URL != s.Selected.TransportURL || !s.DeviceInfo.IsLoading() {
+			return runtime.Default()
+		}
+		if data.Err != nil {
+			return common.EqUpdate(&s.DeviceInfo, common.Err[types.DeviceInfo](data.Err))
+		}
+		return common.EqUpdate(&s.DeviceInfo, common.Ready(*data.Info))
+
+	case msg.InternalStreamingServerUpdateSettingsResult:
+		data, ok := internal.Data.(updateSettingsResult)
+		if !ok || data.URL != s.Selected.TransportURL {
+			return runtime.Default()
+		}
+		if data.Err == nil {
+			return runtime.None().Unchanged()
+		}
+		err := data.Err
+		return common.EqUpdate(&s.BaseURL, (*string)(nil)).
+			Join(common.EqUpdate(&s.RemoteURL, (*string)(nil))).
+			Join(common.EqUpdate(&s.SettingsOptions, []types.SettingsOption(nil))).
+			Join(common.EqUpdate(&s.PlaybackDevices, common.Err[[]PlaybackDevice](err))).
+			Join(common.EqUpdate(&s.NetworkInfo, common.Err[types.NetworkInfo](err))).
+			Join(common.EqUpdate(&s.DeviceInfo, common.Err[types.DeviceInfo](err))).
+			Join(common.EqUpdate(&s.Settings, common.Err[types.StreamingServerSettings](err))).
+			Join(common.EqUpdate(&s.Torrent, (*torrentState)(nil)))
+
+	case msg.InternalStreamingServerStatisticsResult:
+		data, ok := internal.Data.(statisticsResult)
+		if !ok || data.URL != s.Selected.TransportURL || s.Selected.Statistics == nil || !s.Selected.Statistics.Equal(data.Request) {
+			return runtime.Default()
+		}
+		if data.Err != nil {
+			return common.EqUpdate(&s.Statistics, &common.Loadable[types.Statistics]{Kind: common.ErrKind, Err: data.Err})
+		}
+		if !data.Loaded {
+			return runtime.None().Unchanged()
+		}
+		return common.EqUpdate(&s.Statistics, &common.Loadable[types.Statistics]{Kind: common.ReadyKind, Ready: *data.Statistics})
+
+	case msg.InternalStreamingServerPlayOnDeviceResult:
+		data, ok := internal.Data.(playOnDeviceResult)
+		if !ok {
+			return runtime.Default()
+		}
+		if data.Err != nil {
+			return runtime.None().Unchanged()
+		}
+		return runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventPlayingOnDevice,
+			map[string]any{"device": data.Device}))).Unchanged()
+
+	case msg.InternalStreamingServerGetHTTPSResult:
+		data, ok := internal.Data.(getHTTPSResult)
+		if !ok || data.URL != s.Selected.TransportURL {
+			return runtime.Default()
+		}
+		if data.Err != nil || data.Response == nil {
+			return runtime.None().Unchanged()
+		}
+		remoteURL := "https://" + data.Response.Domain + ":" + strconv.Itoa(int(data.Response.Port))
+		return common.EqUpdate(&s.RemoteURL, &remoteURL)
+
+	case msg.InternalStreamingServerCreateTorrentResult:
+		data, ok := internal.Data.(createTorrentResult)
+		if !ok {
+			return runtime.Default()
+		}
+		if s.Torrent == nil || s.Torrent.InfoHash != data.InfoHash || !s.Torrent.Load.IsLoading() {
+			return runtime.None().Unchanged()
+		}
+		if data.Err != nil {
+			s.Torrent.Load = common.Err[types.ResourcePath](data.Err)
+			return runtime.None().Unchanged()
+		}
+		s.Torrent.Load = common.Ready(types.ResourcePath{
+			Resource: core.META_RESOURCE_NAME,
+			Type:     "other",
+			ID:       "bt:" + data.InfoHash.String(),
+		})
+		return runtime.None().Unchanged()
+	}
+	return runtime.Default()
+}
