+	ExternalURL     *string
+	AndroidTVURL    *string
+	TizenURL        *string
+	WebOSURL        *string
+	PlayerFrameURL  string
+	ArchiveURLs     []string
+}
+
+// Stream source kinds.
+const (
+	StreamSourceURL         = "url"
+	StreamSourceYouTube     = "youtube"
+	StreamSourceTorrent     = "torrent"
+	StreamSourceExternal    = "external"
+	StreamSourcePlayerFrame = "playerFrame"
+	StreamSourceRar         = "rar"
+	StreamSourceZip         = "zip"
+	StreamSourceZip7        = "zip7"
+	StreamSourceTgz         = "tgz"
+	StreamSourceTar         = "tar"
+	StreamSourceNzb         = "nzb"
+)
+
+// Stream is an addon stream. On the wire the source fields are flattened into
+// the stream object.
+type Stream struct {
+	Source        StreamSource
+	Name          *string             `json:"name,omitempty"`
+	Description   *string             `json:"description,omitempty"`
+	Thumbnail     *string             `json:"thumbnail,omitempty"`
+	Subtitles     []Subtitles         `json:"subtitles,omitempty"`
+	BehaviorHints StreamBehaviorHints `json:"behaviorHints,omitempty"`
+}
+
+// Youtube builds a YouTube stream from a `yt_id:` video id, if applicable.
+func Youtube(videoID string) (Stream, bool) {
+	if !strings.HasPrefix(videoID, "yt_id:") {
+		return Stream{}, false
+	}
+	parts := strings.Split(videoID, ":")
+	if len(parts) < 3 {
+		return Stream{}, false
+	}
+	return Stream{Source: StreamSource{Kind: StreamSourceYouTube, YtID: parts[2]}}, true
+}
+
+// IsSourceMatch reports whether two streams share the same source.
+func (s Stream) IsSourceMatch(other Stream) bool {
+	return reflect.DeepEqual(s.Source, other.Source)
+}
+
+// IsBingeMatch reports whether two streams belong to the same binge group.
+func (s Stream) IsBingeMatch(other Stream) bool {
+	if s.BehaviorHints.BingeGroup == nil || other.BehaviorHints.BingeGroup == nil {
+		return false
+	}
+	return *s.BehaviorHints.BingeGroup == *other.BehaviorHints.BingeGroup
+}
+
+// Encode zlib-compresses and base64-encodes the stream, mirroring
+// `Stream::encode`.
+func (s Stream) Encode() (string, error) {
+	raw, err := json.Marshal(s)
+	if err != nil {
+		return "", err
+	}
+	var buf bytes.Buffer
+	writer, err := zlib.NewWriterLevel(&buf, zlib.NoCompression)
+	if err != nil {
+		return "", err
+	}
+	if _, err := writer.Write(raw); err != nil {
+		return "", err
+	}
+	if err := writer.Close(); err != nil {
+		return "", err
+	}
+	return base64.StdEncoding.EncodeToString(buf.Bytes()), nil
+}
+
+// Decode reverses Encode.
+func DecodeStream(encoded string) (Stream, error) {
+	data, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return Stream{}, err
+	}
+	reader, err := zlib.NewReader(bytes.NewReader(data))
+	if err != nil {
+		return Stream{}, err
+	}
+	defer reader.Close()
+	var buf bytes.Buffer
+	if _, err := buf.ReadFrom(reader); err != nil {
+		return Stream{}, err
+	}
+	var stream Stream
+	if err := json.Unmarshal(buf.Bytes(), &stream); err != nil {
+		return Stream{}, err
+	}
+	return stream, nil
+}
+
+// MarshalJSON flattens the source fields into the stream object.
+func (s Stream) MarshalJSON() ([]byte, error) {
+	out := map[string]any{}
+	switch s.Source.Kind {
+	case StreamSourceURL:
+		out["url"] = s.Source.URL
+	case StreamSourceYouTube:
+		out["ytId"] = s.Source.YtID
+	case StreamSourceTorrent:
+		out["infoHash"] = s.Source.InfoHash
+		if s.Source.FileIdx != nil {
+			out["fileIdx"] = *s.Source.FileIdx
+		}
+		if len(s.Source.Announce) > 0 {
+			out["announce"] = s.Source.Announce
+		}
+		if len(s.Source.FileMustInclude) > 0 {
+			out["fileMustInclude"] = s.Source.FileMustInclude
+		}
+	case StreamSourceExternal:
+		if s.Source.ExternalURL != nil {
+			out["externalUrl"] = *s.Source.ExternalURL
+		}
+		if s.Source.AndroidTVURL != nil {
+			out["androidTvUrl"] = *s.Source.AndroidTVURL
+		}
+		if s.Source.TizenURL != nil {
+			out["tizenUrl"] = *s.Source.TizenURL
+		}
+		if s.Source.WebOSURL != nil {
+			out["webosUrl"] = *s.Source.WebOSURL
+		}
+	case StreamSourcePlayerFrame:
+		out["playerFrameUrl"] = s.Source.PlayerFrameURL
+	}
+	if s.Name != nil {
+		out["name"] = *s.Name
+	}
+	if s.Description != nil {
+		out["description"] = *s.Description
+	}
+	if s.Thumbnail != nil {
+		out["thumbnail"] = *s.Thumbnail
+	}
+	if len(s.Subtitles) > 0 {
+		out["subtitles"] = s.Subtitles
+	}
+	if !reflect.DeepEqual(s.BehaviorHints, StreamBehaviorHints{}) {
+		out["behaviorHints"] = s.BehaviorHints
+	}
+	return json.Marshal(out)
+}
+
+// UnmarshalJSON parses the flattened stream object.
+func (s *Stream) UnmarshalJSON(data []byte) error {
+	var raw map[string]json.RawMessage
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return err
+	}
+	pick := func(key string, dst any) {
+		if value, ok := raw[key]; ok {
+			_ = json.Unmarshal(value, dst)
+		}
+	}
+	switch {
+	case raw["ytId"] != nil:
+		s.Source.Kind = StreamSourceYouTube
+		pick("ytId", &s.Source.YtID)
+	case raw["infoHash"] != nil:
+		s.Source.Kind = StreamSourceTorrent
+		pick("infoHash", &s.Source.InfoHash)
+		pick("fileIdx", &s.Source.FileIdx)
+		pick("announce", &s.Source.Announce)
+		pick("fileMustInclude", &s.Source.FileMustInclude)
+	case raw["externalUrl"] != nil || raw["androidTvUrl"] != nil || raw["tizenUrl"] != nil || raw["webosUrl"] != nil:
+		s.Source.Kind = StreamSourceExternal
+		pick("externalUrl", &s.Source.ExternalURL)
+		pick("androidTvUrl", &s.Source.AndroidTVURL)
+		pick("tizenUrl", &s.Source.TizenURL)
+		pick("webosUrl", &s.Source.WebOSURL)
+	case raw["playerFrameUrl"] != nil:
+		s.Source.Kind = StreamSourcePlayerFrame
+		pick("playerFrameUrl", &s.Source.PlayerFrameURL)
+	default:
+		s.Source.Kind = StreamSourceURL
+		pick("url", &s.Source.URL)
+	}
+	pick("name", &s.Name)
+	pick("description", &s.Description)
+	if s.Description == nil {
+		pick("title", &s.Description)
+	}
+	pick("thumbnail", &s.Thumbnail)
+	pick("subtitles", &s.Subtitles)
+	pick("behaviorHints", &s.BehaviorHints)
+	return nil
+}
+
+// BuildMagnetURI builds a magnet URI from an info hash and announce list.
+func BuildMagnetURI(infoHash string, announce []string, name *string) string {
+	trackers := make([]string, 0, len(announce))
+	for _, tracker := range announce {
+		tracker = strings.TrimPrefix(tracker, "tracker:")
+		tracker = strings.TrimPrefix(tracker, "dht:")
+		trackers = append(trackers, PercentEncode(tracker))
+	}
+	tr := ""
+	if len(trackers) > 0 {
+		tr = "&tr=" + strings.Join(trackers, "&tr=")
+	}
+	dn := ""
+	if name != nil {
+		dn = "dn=" + PercentEncode(*name) + "&"
+	}
+	return "magnet:?" + dn + "xt=urn:btih:" + infoHash + tr
+}
+
+// MagnetURLFromRaw computes a magnet URI directly from a raw stream source.
+func MagnetURLFromRaw(stream Stream) *string {
+	switch stream.Source.Kind {
+	case StreamSourceURL:
+		if strings.HasPrefix(stream.Source.URL, "magnet:") {
+			return &stream.Source.URL
+		}
+	case StreamSourceTorrent:
+		magnet := BuildMagnetURI(stream.Source.InfoHash, stream.Source.Announce, stream.Name)
+		return &magnet
+	}
+	return nil
+}
+
+// MetaItemBehaviorHints holds meta item behavior hints.
+type MetaItemBehaviorHints struct {
+	DefaultVideoID     *string `json:"defaultVideoId,omitempty"`
+	FeaturedVideoID    *string `json:"featuredVideoId,omitempty"`
+	HasScheduledVideos bool    `json:"hasScheduledVideos,omitempty"`
+}
+
+// Link is an external link of a meta item.
+type Link struct {
+	Name     string `json:"name"`
+	Category string `json:"category"`
+	URL      string `json:"url"`
+}
+
+// SeriesInfo identifies a season/episode.
+type SeriesInfo struct {
+	Season  uint32 `json:"season"`
+	Episode uint32 `json:"episode"`
+}
+
+// Video is an episode or video of a meta item.
+type Video struct {
+	ID             string      `json:"id"`
+	Title          string      `json:"title"`
+	Released       *time.Time  `json:"released,omitempty"`
+	Overview       *string     `json:"overview,omitempty"`
+	Thumbnail      *string     `json:"thumbnail,omitempty"`
+	Streams        []Stream    `json:"streams,omitempty"`
+	SeriesInfo     *SeriesInfo `json:"seriesInfo,omitempty"`
+	TrailerStreams []Stream    `json:"trailerStreams,omitempty"`
+}
+
+// Stream returns the single stream of a video, or a YouTube stream derived from
+// its id.
+func (v Video) Stream() (Stream, bool) {
+	if len(v.Streams) == 1 {
+		return v.Streams[0], true
+	}
+	if len(v.Streams) == 0 {
+		return Youtube(v.ID)
+	}
+	return Stream{}, false
+}
+
+// MetaItemPreview is the preview of a meta item.
+type MetaItemPreview struct {
+	ID             string                `json:"id"`
+	Type           string                `json:"type"`
+	Name           string                `json:"name"`
+	Poster         *string               `json:"poster,omitempty"`
+	Background     *string               `json:"background,omitempty"`
+	Logo           *string               `json:"logo,omitempty"`
+	Description    *string               `json:"description,omitempty"`
+	ReleaseInfo    *string               `json:"releaseInfo,omitempty"`
+	Runtime        *string               `json:"runtime,omitempty"`
+	Released       *time.Time            `json:"released,omitempty"`
+	PosterShape    PosterShape           `json:"posterShape"`
+	Links          []Link                `json:"links"`
+	TrailerStreams []Stream              `json:"trailerStreams"`
+	BehaviorHints  MetaItemBehaviorHints `json:"behaviorHints"`
+}
+
+// MetaItem is a meta item with its videos.
+type MetaItem struct {
+	MetaItemPreview
+	Videos []Video `json:"videos"`
+}
+
+// NextVideo returns the next released video after the given one, without
+// crossing into season 0 specials. Videos without a release date are treated as
+// released.
+func (m MetaItem) NextVideo(videoID string, now time.Time) *Video {
+	pos := -1
+	for i := range m.Videos {
+		if m.Videos[i].ID == videoID {
+			pos = i
+			break
+		}
+	}
+	if pos < 0 || pos+1 >= len(m.Videos) {
+		return nil
+	}
+	current := m.Videos[pos]
+	next := m.Videos[pos+1]
+
+	curSeason := uint32(0)
+	if current.SeriesInfo != nil {
+		curSeason = current.SeriesInfo.Season
+	}
+	nextSeason := uint32(0)
+	if next.SeriesInfo != nil {
+		nextSeason = next.SeriesInfo.Season
+	}
+	released := next.Released == nil || !next.Released.After(now)
+	if (nextSeason != 0 || curSeason == nextSeason) && released {
+		return &next
+	}
+	return nil
+}
+
+// VideosBySeason returns the videos belonging to the given season.
+func (m MetaItem) VideosBySeason(season uint32) []Video {
+	var videos []Video
+	for _, video := range m.Videos {
+		if video.SeriesInfo != nil && video.SeriesInfo.Season == season {
+			videos = append(videos, video)
+		}
+	}
+	return videos
+}
