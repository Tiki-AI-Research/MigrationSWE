+// LibraryRecentCount is the amount of items kept in the recent bucket.
+const LibraryRecentCount = 200
+
+// EqNoMtime reports whether two items are equal ignoring the mtime.
+func (i LibraryItem) EqNoMtime(other LibraryItem) bool {
+	a, _ := json.Marshal(struct {
+		ID            string
+		Removed       bool
+		Temp          bool
+		Ctime         *time.Time
+		State         LibraryItemState
+		Name          string
+		Type          string
+		Poster        *string
+		PosterShape   PosterShape
+		BehaviorHints MetaItemBehaviorHints
+	}{i.ID, i.Removed, i.Temp, i.Ctime, i.State, i.Name, i.Type, i.Poster, i.PosterShape, i.BehaviorHints})
+	b, _ := json.Marshal(struct {
+		ID            string
+		Removed       bool
+		Temp          bool
+		Ctime         *time.Time
+		State         LibraryItemState
+		Name          string
+		Type          string
+		Poster        *string
+		PosterShape   PosterShape
+		BehaviorHints MetaItemBehaviorHints
+	}{other.ID, other.Removed, other.Temp, other.Ctime, other.State, other.Name, other.Type, other.Poster, other.PosterShape, other.BehaviorHints})
+	return string(a) == string(b)
+}
+
+func (b LibraryBucket) sortedItems() []LibraryItem {
+	items := make([]LibraryItem, 0, len(b.Items))
+	for _, item := range b.Items {
+		items = append(items, item)
+	}
+	// sort by mtime descending
+	for i := 0; i < len(items); i++ {
+		for j := i + 1; j < len(items); j++ {
+			if items[j].Mtime.After(items[i].Mtime) {
+				items[i], items[j] = items[j], items[i]
+			}
+		}
+	}
+	return items
+}
+
+// SplitItemsByRecent splits items into recent (by mtime) and the rest.
+func (b LibraryBucket) SplitItemsByRecent() (recent, other []LibraryItem) {
+	sorted := b.sortedItems()
+	recentCount := LibraryRecentCount
+	if recentCount > len(sorted) {
+		recentCount = len(sorted)
+	}
+	return sorted[:recentCount], sorted[recentCount:]
+}
+
+// AreIDsInRecent reports whether all ids are within the recent items.
+func (b LibraryBucket) AreIDsInRecent(ids []string) bool {
+	recent, _ := b.SplitItemsByRecent()
+	recentSet := map[string]bool{}
+	for _, item := range recent {
+		recentSet[item.ID] = true
+	}
+	for _, id := range ids {
+		if !recentSet[id] {
+			return false
+		}
+	}
+	return true
+}
+
+// MergeItems merges items, keeping the newer mtime for duplicates.
+func (b *LibraryBucket) MergeItems(items []LibraryItem) {
+	if b.Items == nil {
+		b.Items = map[string]LibraryItem{}
+	}
+	for _, newItem := range items {
+		item, ok := b.Items[newItem.ID]
+		if !ok || !newItem.Mtime.Before(item.Mtime) {
+			b.Items[newItem.ID] = newItem
+		}
+	}
+}
