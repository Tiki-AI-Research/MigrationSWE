--- /dev/null
+++ b/constants_test.go
@@ -0,0 +1,44 @@
+package stremiocore
+
+import "testing"
+
+func TestProtectedStorageKeys(t *testing.T) {
+	cases := map[string]string{
+		SCHEMA_VERSION_STORAGE_KEY:        "schema_version",
+		PROFILE_STORAGE_KEY:               "profile",
+		LIBRARY_STORAGE_KEY:               "library",
+		LIBRARY_RECENT_STORAGE_KEY:        "library_recent",
+		STREAMS_STORAGE_KEY:               "streams",
+		SEARCH_HISTORY_STORAGE_KEY:        "search_history",
+		STREAMING_SERVER_URLS_STORAGE_KEY: "streaming_server_urls",
+		NOTIFICATIONS_STORAGE_KEY:         "notifications",
+		CALENDAR_STORAGE_KEY:              "calendar",
+		DISMISSED_EVENTS_STORAGE_KEY:      "dismissed_events",
+	}
+	for got, want := range cases {
+		if got != want {
+			t.Errorf("storage key = %q, want %q", got, want)
+		}
+	}
+	if SCHEMA_VERSION != 25 {
+		t.Errorf("SCHEMA_VERSION = %d, want 25", SCHEMA_VERSION)
+	}
+}
+
+func TestURIComponentEncodeSet(t *testing.T) {
+	for _, c := range []byte{'-', '_', '.', '!', '~', '*', '\'', '(', ')'} {
+		if URIComponentEncodeSet[c] {
+			t.Errorf("byte %q should be in the encode set", c)
+		}
+	}
+	for _, c := range []byte{'a', 'Z', '0'} {
+		if URIComponentEncodeSet[c] {
+			t.Errorf("alphanumeric %q should not be encoded", c)
+		}
+	}
+	for _, c := range []byte{' ', ':', '/', '?'} {
+		if !URIComponentEncodeSet[c] {
+			t.Errorf("byte %q should be encoded", c)
+		}
+	}
+}
