+func (p *Player) skipGapsUpdate(c *ctx.Ctx) runtime.Effects {
+	var authKey *types.AuthKey
+	if p.Env != nil && c.Profile.Auth != nil && c.Profile.Auth.User.PremiumExpire != nil &&
+		c.Profile.Auth.User.PremiumExpire.After(p.Env.Now()) {
+		key := c.Profile.Auth.Key
+		authKey = &key
+	}
+	if authKey == nil || p.Selected == nil || p.VideoParams == nil || p.SeriesInfo == nil || p.LibraryItem == nil {
+		return runtime.None().Unchanged()
+	}
+	if !streamSourceSupported(p.Selected.Stream) || p.Selected.Stream.Name == nil || p.VideoParams.Hash == nil {
+		return runtime.None().Unchanged()
+	}
+
+	request := types.SkipGapsRequest{
+		AuthKey:        *authKey,
+		OSHash:         *p.VideoParams.Hash,
+		ItemID:         p.LibraryItem.ID,
+		SeriesInfo:     *p.SeriesInfo,
+		StreamNameHash: streamNameHash(*p.Selected.Stream.Name),
+	}
+
+	if p.SkipGaps == nil || !p.SkipGaps.Request.Equal(request) || p.SkipGaps.Load.IsErr() {
+		requestCopy := request
+		env := p.Env
+		requestEffects := runtime.FutureEffectSet(runtime.ConcurrentFuture(func() *msg.Msg {
+			response, err := fetchAPI[types.SkipGapsResponse](env, "getSkipGaps", skipGapsAPIRequest{Type: "SkipGaps", SkipGapsRequest: requestCopy})
+			if err != nil {
+				return msg.InternalMsg(msg.NewInternal(msg.InternalSkipGapsResult, skipGapsResult{Request: requestCopy, Err: err}))
+			}
+			return msg.InternalMsg(msg.NewInternal(msg.InternalSkipGapsResult, skipGapsResult{Request: requestCopy, Response: &response}))
+		})).Unchanged()
+		state := &skipGapsState{Request: request, Load: common.Loading[types.SkipGapsResponse]()}
+		return requestEffects.Join(common.EqUpdate(&p.SkipGaps, state))
+	}
+	return runtime.None().Unchanged()
+}
