diff --git a/runtime/update.go b/runtime/update.go
new file mode 100644
index 0000000..534b112
--- /dev/null
+++ b/runtime/update.go
@@ -0,0 +1,22 @@
+package runtime
+
+import "github.com/stremio/stremio-core/runtime/msg"
+
+// Model is the runtime model abstraction. Update applies a message to the whole
+// model, while UpdateField applies it to a single field. Both return the
+// effects to schedule and the changed field names.
+type Model interface {
+	Update(m *msg.Msg) ([]Effect, []string)
+	UpdateField(m *msg.Msg, field string) ([]Effect, []string)
+}
+
+// Update is implemented by sub-models that react to messages.
+type Update interface {
+	Update(m *msg.Msg) Effects
+}
+
+// UpdateWithCtx is implemented by sub-models that need read-only access to the
+// root Ctx while updating.
+type UpdateWithCtx[C any] interface {
+	Update(m *msg.Msg, ctx *C) Effects
+}
