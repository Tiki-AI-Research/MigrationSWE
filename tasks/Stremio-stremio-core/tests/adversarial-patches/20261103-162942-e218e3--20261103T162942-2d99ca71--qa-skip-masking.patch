+package types_test
+
+import (
+	"testing"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+func TestWatchedBitFieldDecodesAndRoundTrips(t *testing.T) {
+	videos := []string{
+		"tt2934286:1:1", "tt2934286:1:2", "tt2934286:1:3",
+		"tt2934286:1:4", "tt2934286:1:5", "tt2934286:1:6",
+		"tt2934286:1:7", "tt2934286:1:8", "tt2934286:1:9",
+	}
+	// A watched field produced by the Rust engine.
+	watched := "tt2934286:1:5:5:eJyTZwAAAEAAIA=="
+	wb, err := types.WatchedBitFieldConstructAndResize(watched, videos)
+	if err != nil {
+		t.Fatalf("construct: %v", err)
+	}
+	if !wb.GetVideo("tt2934286:1:5") {
+		t.Fatalf("video 5 should be watched")
+	}
+	if wb.GetVideo("tt2934286:1:6") {
+		t.Fatalf("video 6 should not be watched")
+	}
+	wb.SetVideo("tt2934286:1:6", true)
+
+	// The serialized form must decode back to the same watched bits.
+	reparsed, err := types.WatchedBitFieldConstructAndResize(wb.String(), videos)
+	if err != nil {
+		t.Fatalf("reparse: %v", err)
+	}
+	if !reparsed.GetVideo("tt2934286:1:5") || !reparsed.GetVideo("tt2934286:1:6") {
+		t.Fatalf("reparsed watched bits differ")
+	}
+}
+
+func TestWatchedBitFieldEmptyRoundTrips(t *testing.T) {
+	wb := types.WatchedBitFieldFromArray(nil, nil)
+	reparsed, err := types.WatchedBitFieldConstructAndResize(wb.String(), nil)
+	if err != nil {
+		t.Fatalf("reparse empty: %v", err)
+	}
+	if reparsed.Get(0) {
+		t.Fatalf("empty watched field should have no set bits")
+	}
+}
