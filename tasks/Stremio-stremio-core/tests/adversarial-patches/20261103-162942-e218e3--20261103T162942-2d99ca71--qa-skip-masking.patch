@@ -0,0 +1,56 @@
+package models
+
+import (
+	"strings"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+// planResourceRequests builds one resource request per installed addon whose
+// manifest supports the given resource path.
+func planResourceRequests(path types.ResourcePath, addons []types.Descriptor) []types.ResourceRequest {
+	var requests []types.ResourceRequest
+	for _, addon := range addons {
+		if manifestSupportsResource(addon.Manifest, path) {
+			requests = append(requests, types.ResourceRequest{Base: addon.TransportURL, Path: path})
+		}
+	}
+	return requests
+}
+
+func manifestSupportsResource(manifest types.Manifest, path types.ResourcePath) bool {
+	for _, resource := range manifest.Resources {
+		if resource.Name != path.Resource {
+			continue
+		}
+		resourceTypes := resource.Types
+		if resourceTypes == nil {
+			resourceTypes = manifest.Types
+		}
+		idPrefixes := resource.IDPrefixes
+		if idPrefixes == nil {
+			idPrefixes = manifest.IDPrefixes
+		}
+		if !containsString(resourceTypes, path.Type) {
+			continue
+		}
+		if len(idPrefixes) == 0 {
+			return true
+		}
+		for _, prefix := range idPrefixes {
+			if strings.HasPrefix(path.ID, prefix) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func containsString(values []string, value string) bool {
+	for _, v := range values {
+		if v == value {
+			return true
+		}
+	}
+	return false
+}
