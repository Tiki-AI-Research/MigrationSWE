@@ -0,0 +1,232 @@
+// Package deeplinks builds the stremio:// deep links for each platform surface.
+package deeplinks
+
+import (
+	"fmt"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+// MetaItemDeepLinks are the deep links for a meta item.
+type MetaItemDeepLinks struct {
+	MetaDetailsVideos  *string `json:"metaDetailsVideos"`
+	MetaDetailsStreams *string `json:"metaDetailsStreams"`
+	Player             *string `json:"player"`
+}
+
+// NewMetaItemDeepLinks builds the deep links for a meta item preview.
+func NewMetaItemDeepLinks(typ, id string) MetaItemDeepLinks {
+	videos := fmt.Sprintf("stremio:///detail/%s/%s", types.PercentEncode(typ), types.PercentEncode(id))
+	return MetaItemDeepLinks{MetaDetailsVideos: &videos}
+}
+
+// NewMetaItemDeepLinksWithVideo builds the deep links for a meta item with a
+// default video id.
+func NewMetaItemDeepLinksWithVideo(typ, id, defaultVideoID string) MetaItemDeepLinks {
+	streams := fmt.Sprintf("stremio:///detail/%s/%s/%s",
+		types.PercentEncode(typ), types.PercentEncode(id), types.PercentEncode(defaultVideoID))
+	return MetaItemDeepLinks{MetaDetailsStreams: &streams}
+}
+
+// VideoDeepLinks are the deep links for a video.
+type VideoDeepLinks struct {
+	MetaDetailsVideos  string              `json:"metaDetailsVideos"`
+	MetaDetailsStreams string              `json:"metaDetailsStreams"`
+	Player             *string             `json:"player"`
+	ExternalPlayer     *ExternalPlayerLink `json:"externalPlayer,omitempty"`
+}
+
+// NewVideoDeepLinks builds the deep links for a video.
+func NewVideoDeepLinks(typ, id, videoID string) VideoDeepLinks {
+	videos := fmt.Sprintf("stremio:///detail/%s/%s", types.PercentEncode(typ), types.PercentEncode(id))
+	streams := fmt.Sprintf("stremio:///detail/%s/%s/%s",
+		types.PercentEncode(typ), types.PercentEncode(id), types.PercentEncode(videoID))
+	return VideoDeepLinks{MetaDetailsVideos: videos, MetaDetailsStreams: streams}
+}
+
+// StreamDeepLinks are the deep links for a stream.
+type StreamDeepLinks struct {
+	Player         string             `json:"player"`
+	ExternalPlayer ExternalPlayerLink `json:"externalPlayer"`
+}
+
+// ExternalPlayerLink holds per-platform player links.
+type ExternalPlayerLink struct {
+	Download   *string         `json:"download,omitempty"`
+	Magnet     *string         `json:"magnet,omitempty"`
+	Streaming  *string         `json:"streaming,omitempty"`
+	Playlist   *string         `json:"playlist,omitempty"`
+	FileName   *string         `json:"fileName,omitempty"`
+	OpenPlayer *OpenPlayerLink `json:"openPlayer,omitempty"`
+	Web        *string         `json:"web,omitempty"`
+	AndroidTV  *string         `json:"androidTv,omitempty"`
+	Tizen      *string         `json:"tizen,omitempty"`
+	WebOS      *string         `json:"webos,omitempty"`
+}
+
+// OpenPlayerLink holds player-specific links.
+type OpenPlayerLink struct {
+	IOS      *string `json:"ios,omitempty"`
+	Android  *string `json:"android,omitempty"`
+	Windows  *string `json:"windows,omitempty"`
+	MacOS    *string `json:"macos,omitempty"`
+	Linux    *string `json:"linux,omitempty"`
+	Tizen    *string `json:"tizen,omitempty"`
+	WebOS    *string `json:"webos,omitempty"`
+	ChromeOS *string `json:"chromeos,omitempty"`
+	Roku     *string `json:"roku,omitempty"`
+	VisionOS *string `json:"visionos,omitempty"`
+	TvOS     *string `json:"tvos,omitempty"`
+}
+
+// NewStreamDeepLinks builds the player deep link for an encoded stream.
+func NewStreamDeepLinks(encodedStream string) StreamDeepLinks {
+	player := fmt.Sprintf("stremio:///player/%s", types.PercentEncode(encodedStream))
+	return StreamDeepLinks{Player: player}
+}
+
+// NewStreamDeepLinksFull builds the full player deep link with request context.
+func NewStreamDeepLinksFull(encodedStream, streamBase, metaBase, typ, id, videoID string) StreamDeepLinks {
+	player := fmt.Sprintf("stremio:///player/%s/%s/%s/%s/%s/%s",
+		types.PercentEncode(encodedStream),
+		types.PercentEncode(streamBase),
+		types.PercentEncode(metaBase),
+		types.PercentEncode(typ),
+		types.PercentEncode(id),
+		types.PercentEncode(videoID),
+	)
+	return StreamDeepLinks{Player: player}
+}
+
+// DiscoverDeepLinks is the discover deep link.
+type DiscoverDeepLinks struct {
+	Discover string `json:"discover"`
+}
+
+// NewDiscoverDeepLinks builds the discover deep link from a resource request.
+func NewDiscoverDeepLinks(request types.ResourceRequest) DiscoverDeepLinks {
+	pairs := make([]types.QueryPair, 0, len(request.Path.Extra))
+	for _, ev := range request.Path.Extra {
+		pairs = append(pairs, types.QueryPair{Key: ev.Name, Value: ev.Value})
+	}
+	return DiscoverDeepLinks{
+		Discover: fmt.Sprintf("stremio:///discover/%s/%s/%s?%s",
+			types.PercentEncode(request.Base),
+			types.PercentEncode(request.Path.Type),
+			types.PercentEncode(request.Path.ID),
+			types.QueryParamsEncode(pairs),
+		),
+	}
+}
+
+// AddonsDeepLinks is the addons deep link.
+type AddonsDeepLinks struct {
+	Addons string `json:"addons"`
+}
+
+// NewAddonsDeepLinks builds the addons deep link for a resource request.
+func NewAddonsDeepLinks(request types.ResourceRequest) AddonsDeepLinks {
+	return AddonsDeepLinks{
+		Addons: fmt.Sprintf("stremio:///addons/%s/%s/%s",
+			types.PercentEncode(request.Path.Type),
+			types.PercentEncode(request.Base),
+			types.PercentEncode(request.Path.ID),
+		),
+	}
+}
+
+// NewAddonsDeepLinksByType builds the addons deep link for a type.
+func NewAddonsDeepLinksByType(typ *string) AddonsDeepLinks {
+	if typ != nil {
+		return AddonsDeepLinks{Addons: fmt.Sprintf("stremio:///addons/%s", types.PercentEncode(*typ))}
+	}
+	return AddonsDeepLinks{Addons: "stremio:///addons"}
+}
+
+// LibraryDeepLinks is the library deep link.
+type LibraryDeepLinks struct {
+	Library string `json:"library"`
+}
+
+// NewLibraryDeepLinks builds the library deep link.
+func NewLibraryDeepLinks(root string, typ *string, sort string) LibraryDeepLinks {
+	if typ != nil {
+		return LibraryDeepLinks{Library: fmt.Sprintf("stremio:///%s/%s?%s",
+			root, types.PercentEncode(*typ),
+			types.QueryParamsEncode([]types.QueryPair{{Key: "sort", Value: sort}}))}
+	}
+	return LibraryDeepLinks{Library: fmt.Sprintf("stremio:///%s?%s",
+		root, types.QueryParamsEncode([]types.QueryPair{{Key: "sort", Value: sort}}))}
+}
+
+// CalendarDeepLinks is the calendar deep link.
+type CalendarDeepLinks struct {
+	Calendar string `json:"calendar"`
+}
+
+// NewCalendarDeepLinks builds the calendar deep link.
+func NewCalendarDeepLinks(year, month int) CalendarDeepLinks {
+	return CalendarDeepLinks{Calendar: fmt.Sprintf("stremio:///calendar/%d/%d", year, month)}
+}
+
+// CalendarItemDeepLinks is the calendar item deep link.
+type CalendarItemDeepLinks struct {
+	MetaDetailsStreams string `json:"metaDetailsStreams"`
+}
+
+// NewCalendarItemDeepLinks builds the calendar item deep link.
+func NewCalendarItemDeepLinks(typ, id, videoID string) CalendarItemDeepLinks {
+	return CalendarItemDeepLinks{MetaDetailsStreams: fmt.Sprintf("stremio:///detail/%s/%s/%s",
+		types.PercentEncode(typ), types.PercentEncode(id), types.PercentEncode(videoID))}
+}
+
+// SearchHistoryItemDeepLinks is the search deep link.
+type SearchHistoryItemDeepLinks struct {
+	Search string `json:"search"`
+}
+
+// NewSearchHistoryItemDeepLinks builds the search deep link.
+func NewSearchHistoryItemDeepLinks(query string) SearchHistoryItemDeepLinks {
+	return SearchHistoryItemDeepLinks{Search: fmt.Sprintf("stremio:///search?query=%s", types.PercentEncode(query))}
+}
+
+// LocalSearchItemDeepLinks is the local search deep link.
+type LocalSearchItemDeepLinks struct {
+	Search string `json:"search"`
+}
+
+// NewLocalSearchItemDeepLinks builds the local search deep link.
+func NewLocalSearchItemDeepLinks(query string) LocalSearchItemDeepLinks {
+	return LocalSearchItemDeepLinks{Search: fmt.Sprintf("stremio:///search?query=%s", types.PercentEncode(query))}
+}
+
+// LibraryItemDeepLinks are the deep links for a library item.
+type LibraryItemDeepLinks struct {
+	MetaDetailsVideos  *string             `json:"metaDetailsVideos"`
+	MetaDetailsStreams *string             `json:"metaDetailsStreams"`
+	Player             *string             `json:"player"`
+	ExternalPlayer     *ExternalPlayerLink `json:"externalPlayer,omitempty"`
+}
+
+// NewLibraryItemDeepLinks builds the meta-details deep links for a library item.
+func NewLibraryItemDeepLinks(typ, id string, defaultVideoID *string) LibraryItemDeepLinks {
+	base := fmt.Sprintf("stremio:///detail/%s/%s", types.PercentEncode(typ), types.PercentEncode(id))
+	var streams *string
+	if defaultVideoID != nil {
+		s := fmt.Sprintf("%s/%s", base, types.PercentEncode(*defaultVideoID))
+		streams = &s
+	}
+	return LibraryItemDeepLinks{MetaDetailsVideos: &base, MetaDetailsStreams: streams}
+}
+
+// InfuseOpenPlayerLink builds the Infuse x-callback-url player link.
+func InfuseOpenPlayerLink(streamingURL, callbackURL string, position *uint64) string {
+	encodedCallback := types.PercentEncode(callbackURL)
+	encodedURL := types.PercentEncode(streamingURL)
+	positionPart := ""
+	if position != nil {
+		positionPart = fmt.Sprintf("&position=%d", *position)
+	}
+	return fmt.Sprintf("infuse://x-callback-url/play?x-success=%s&x-error=%s&url=%s%s",
+		encodedCallback, encodedCallback, encodedURL, positionPart)
+}
