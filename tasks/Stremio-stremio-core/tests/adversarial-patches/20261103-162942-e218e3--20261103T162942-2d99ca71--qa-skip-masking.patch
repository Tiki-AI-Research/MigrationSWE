index 0000000..c64f872
--- /dev/null
+++ b/types/torrent.go
@@ -0,0 +1,45 @@
+package types
+
+import (
+	"encoding/hex"
+	"errors"
+)
+
+// InfoHash is a 20-byte BitTorrent info hash. It serializes as a lowercase hex
+// string.
+type InfoHash [20]byte
+
+// ParseInfoHash parses a 40-character hex info hash.
+func ParseInfoHash(s string) (InfoHash, error) {
+	var hash InfoHash
+	decoded, err := hex.DecodeString(s)
+	if err != nil {
+		return hash, err
+	}
+	if len(decoded) != 20 {
+		return hash, errors.New("invalid info hash length")
+	}
+	copy(hash[:], decoded)
+	return hash, nil
+}
+
+// String returns the lowercase hex representation.
+func (h InfoHash) String() string { return hex.EncodeToString(h[:]) }
+
+// MarshalJSON implements json.Marshaler.
+func (h InfoHash) MarshalJSON() ([]byte, error) {
+	return []byte(`"` + h.String() + `"`), nil
+}
+
+// UnmarshalJSON implements json.Unmarshaler.
+func (h *InfoHash) UnmarshalJSON(data []byte) error {
+	if len(data) < 2 || data[0] != '"' || data[len(data)-1] != '"' {
+		return errors.New("invalid info hash")
+	}
+	parsed, err := ParseInfoHash(string(data[1 : len(data)-1]))
+	if err != nil {
+		return err
+	}
+	*h = parsed
+	return nil
+}
diff --git a/types/types.go b/types/types.go
new file mode 100644
index 0000000..f400494
--- /dev/null
+++ b/types/types.go
@@ -0,0 +1,141 @@
+package types
+
+import (
+	"encoding/json"
+	"reflect"
+)
+
+// ExtraValue is a name/value pair used in resource paths.
+type ExtraValue struct {
+	Name  string `json:"name"`
+	Value string `json:"value"`
+}
+
+// ResourcePath identifies a resource.
+type ResourcePath struct {
+	Resource string       `json:"resource"`
+	Type     string       `json:"type"`
+	ID       string       `json:"id"`
+	Extra    []ExtraValue `json:"extra,omitempty"`
+}
+
+// GetExtraFirstValue returns the first value for the named extra.
+func (p ResourcePath) GetExtraFirstValue(name string) (string, bool) {
+	for _, e := range p.Extra {
+		if e.Name == name {
+			return e.Value, true
+		}
+	}
+	return "", false
+}
+
+// ExtendOne replaces the extra value with the given name (options limit 1
+// semantics). A nil value removes it, matching the Rust `ExtraExt::extend_one`.
+func ExtendOne(extra []ExtraValue, name string, value *string) []ExtraValue {
+	others := make([]ExtraValue, 0, len(extra)+1)
+	for _, e := range extra {
+		if e.Name != name {
+			others = append(others, e)
+		}
+	}
+	if value == nil {
+		return others
+	}
+	return append([]ExtraValue{{Name: name, Value: *value}}, others...)
+}
+
+// ResourceRequest is a request to an addon resource.
+type ResourceRequest struct {
+	Base string       `json:"base"`
+	Path ResourcePath `json:"path"`
+}
+
+// Equal reports whether two requests are structurally equal.
+func (r ResourceRequest) Equal(other ResourceRequest) bool {
+	return reflect.DeepEqual(r, other)
+}
+
+// Manifest describes an addon.
+type Manifest struct {
+	ID           string     `json:"id"`
+	Version      string     `json:"version"`
+	Name         string     `json:"name"`
+	Description  string     `json:"description,omitempty"`
+	Logo         string     `json:"logo,omitempty"`
+	Background   string     `json:"background,omitempty"`
+	ContactEmail string     `json:"contactEmail,omitempty"`
+	Resources    []Resource `json:"resources,omitempty"`
+	Types        []string   `json:"types,omitempty"`
+	Catalogs     []Catalog  `json:"catalogs,omitempty"`
+	IDPrefixes   []string   `json:"idPrefixes,omitempty"`
+}
+
+// Resource is a manifest resource entry. On the wire it may be either the
+// short string form (e.g. "catalog") or the long object form.
+type Resource struct {
+	Name       string   `json:"name"`
+	Types      []string `json:"types,omitempty"`
+	IDPrefixes []string `json:"idPrefixes,omitempty"`
+}
+
+// UnmarshalJSON accepts both the short string form and the long object form.
+func (r *Resource) UnmarshalJSON(data []byte) error {
+	var name string
+	if err := json.Unmarshal(data, &name); err == nil {
+		r.Name = name
+		return nil
+	}
+	type resource Resource
+	var long resource
+	if err := json.Unmarshal(data, &long); err != nil {
+		return err
+	}
+	*r = Resource(long)
+	return nil
+}
+
+// Catalog is a manifest catalog entry.
+type Catalog struct {
+	Type  string      `json:"type"`
+	ID    string      `json:"id"`
+	Name  string      `json:"name,omitempty"`
+	Extra []ExtraProp `json:"extra,omitempty"`
+}
+
+// ExtraProp describes a catalog extra property.
+type ExtraProp struct {
+	Name         string       `json:"name"`
+	IsRequired   bool         `json:"isRequired"`
+	Options      []string     `json:"options"`
+	OptionsLimit OptionsLimit `json:"optionsLimit"`
+}
+
+// OptionsLimit is the maximum number of options.
+type OptionsLimit int
+
+// DescriptorFlags records special properties of an addon descriptor.
+type DescriptorFlags struct {
+	Official  bool `json:"official"`
+	Protected bool `json:"protected"`
+}
+
+// Descriptor is an installed addon descriptor.
+type Descriptor struct {
+	TransportURL string          `json:"transportUrl"`
+	Manifest     Manifest        `json:"manifest"`
+	Flags        DescriptorFlags `json:"flags"`
+}
+
+// ResourceResponse is an opaque addon resource response.
+type ResourceResponse struct {
+	Raw []byte
+}
+
+// True is a helper that always serializes to the JSON boolean true.
+type True struct{}
+
+// MarshalJSON implements json.Marshaler.
+func (True) MarshalJSON() ([]byte, error) { return []byte("true"), nil }
+
+// UnmarshalJSON implements json.Unmarshaler.
+func (*True) UnmarshalJSON([]byte) error { return nil }
diff --git a/types/user_state.go b/types/user_state.go
new file mode 100644
index 0000000..ad9da38
--- /dev/null
+++ b/types/user_state.go
@@ -0,0 +1,656 @@
+package types
+
+import (
+	"encoding/json"
+	"sort"
+	"time"
