+package ctx
+
+import "encoding/json"
+
+// CtxError is the error union produced by the Ctx model.
+type CtxError struct {
+	Type    string `json:"type"`
+	Message string `json:"message"`
+}
+
+// Error implements the error interface.
+func (e *CtxError) Error() string { return e.Message }
+
+// MarshalJSON implements json.Marshaler.
+func (e *CtxError) MarshalJSON() ([]byte, error) {
+	return json.Marshal(struct {
+		Type    string `json:"type"`
+		Message string `json:"message"`
+	}{Type: e.Type, Message: e.Message})
+}
+
+// OtherError builds a generic CtxError.
+func OtherError(message string) *CtxError {
+	return &CtxError{Type: "Other", Message: message}
+}
diff --git a/models/ctx/update_events.go b/models/ctx/update_events.go
new file mode 100644
index 0000000..e6b72f3
--- /dev/null
+++ b/models/ctx/update_events.go
@@ -0,0 +1,53 @@
+package ctx
+
+import (
+	"encoding/json"
+
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateEvents(c *Ctx, m *msg.Msg) runtime.Effects {
+	switch {
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalLogout:
+		c.DismissedEvents = types.NewDismissedEventsBucket(nil)
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalDismissedEventsChanged, nil)))
+
+	case m.Kind == msg.KindAction && m.Action != nil && m.Action.InnerActionName() == msg.ActionCtxGetEvents:
+		c.Events.Modal = types.LoadableValue{Type: "Loading"}
+		c.Events.Notification = types.LoadableValue{Type: "Loading"}
+		return runtime.None()
+
+	case m.Kind == msg.KindAction && m.Action != nil && m.Action.InnerActionName() == msg.ActionCtxDismissEvent:
+		id, ok := decodeArgs[string](m.Action)
+		if !ok {
+			return runtime.None().Unchanged()
+		}
+		c.DismissedEvents.Items[id] = c.Env.Now()
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalDismissedEventsChanged, nil)))
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalGetModalResult:
+		result, ok := m.Internal.Data.(json.RawMessage)
+		if !ok || len(result) == 0 || string(result) == "null" {
+			c.Events.Modal = types.LoadableValue{Type: "Ready", Content: json.RawMessage("null")}
+		} else {
+			c.Events.Modal = types.LoadableValue{Type: "Ready", Content: result}
+		}
+		return runtime.None()
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalGetNotificationResult:
+		result, ok := m.Internal.Data.(json.RawMessage)
+		if !ok || len(result) == 0 || string(result) == "null" {
+			c.Events.Notification = types.LoadableValue{Type: "Ready", Content: json.RawMessage("null")}
+		} else {
+			c.Events.Notification = types.LoadableValue{Type: "Ready", Content: result}
+		}
+		return runtime.None()
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalDismissedEventsChanged:
+		return setStorageEffect(c.Env, core.DISMISSED_EVENTS_STORAGE_KEY, c.DismissedEvents, msg.EventDismissedEventsPushedToStorage).Unchanged()
+	}
+	return runtime.None().Unchanged()
+}
diff --git a/models/ctx/update_library.go b/models/ctx/update_library.go
new file mode 100644
index 0000000..b9ff156
--- /dev/null
+++ b/models/ctx/update_library.go
@@ -0,0 +1,192 @@
+package ctx
+
+import (
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateLibrary(c *Ctx, m *msg.Msg) runtime.Effects {
+	switch {
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalLogout:
+		next := types.LibraryBucket{}
+		if len(c.Library.Items) > 0 || c.Library.UID != nil {
+			c.Library = next
+			return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalLibraryChanged, false)))
+		}
+		return runtime.None().Unchanged()
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalUpdateLibraryItem:
+		item, ok := m.Internal.Data.(types.LibraryItem)
+		if !ok {
+			return runtime.None().Unchanged()
+		}
+		prev, exists := c.Library.Items[item.ID]
+		if exists && item.EqNoMtime(prev) {
+			return runtime.None().Unchanged()
+		}
+		item.Mtime = c.Env.Now()
+		c.Library.MergeItems([]types.LibraryItem{item})
+		persist := pushLibraryToStorage(c.Env, &c.Library)
+		return persist.Join(runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalLibraryChanged, true))))
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalLibraryChanged:
+		persisted, _ := m.Internal.Data.(bool)
+		if persisted {
+			return runtime.None().Unchanged()
+		}
+		return pushLibraryToStorage(c.Env, &c.Library)
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalLibraryPullResult:
+		return runtime.None().Unchanged()
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalCtxAuthResult:
+		result, ok := m.Internal.Data.(CtxAuthResponse)
+		if !ok {
+			return runtime.None().Unchanged()
+		}
+		uid := string(result.Auth.User.ID)
+		next := types.NewLibraryBucket(&uid, result.LibraryItems)
+		c.Library = next
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalLibraryChanged, false)))
+	}
+
+	if m.Kind != msg.KindAction || m.Action == nil {
+		return runtime.None().Unchanged()
+	}
+
+	switch m.Action.InnerActionName() {
+	case msg.ActionCtxAddToLibrary:
+		var preview types.MetaItemPreview
+		if err := m.Action.DecodeInnerArgs(&preview); err != nil {
+			return runtime.None().Unchanged()
+		}
+		item, exists := c.Library.Items[preview.ID]
+		if !exists {
+			now := c.Env.Now()
+			item = types.LibraryItem{ID: preview.ID, Ctime: &now, Mtime: now, Removed: true, Temp: true}
+		}
+		item.Name = preview.Name
+		item.Type = preview.Type
+		item.Poster = preview.Poster
+		item.PosterShape = preview.PosterShape
+		item.BehaviorHints = preview.BehaviorHints
+		item.Removed = false
+		item.Temp = false
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, item))).
+			Join(runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventLibraryItemAdded, map[string]any{"id": preview.ID})))).
+			Unchanged()
+
+	case msg.ActionCtxRemoveFromLibrary:
+		id, ok := decodeArgs[string](m.Action)
+		if !ok {
+			return runtime.None().Unchanged()
+		}
+		item, exists := c.Library.Items[id]
+		if !exists {
+			return runtime.MsgEffectSet(errorEvent(msg.EventLibraryItemRemoved)).Unchanged()
+		}
+		item.Removed = true
+		item.Temp = false
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, item))).
+			Join(runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalDismissNotificationItem, id)))).
+			Join(runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventLibraryItemRemoved, map[string]any{"id": id})))).
+			Unchanged()
+
+	case msg.ActionCtxRewindLibraryItem:
+		id, ok := decodeArgs[string](m.Action)
+		if !ok {
+			return runtime.None().Unchanged()
+		}
+		item, exists := c.Library.Items[id]
+		if !exists {
+			return runtime.MsgEffectSet(errorEvent(msg.EventLibraryItemRewinded)).Unchanged()
+		}
+		item.State.TimeOffset = 0
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, item))).
+			Join(runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventLibraryItemRewinded, map[string]any{"id": id})))).
+			Unchanged()
+
+	case msg.ActionCtxLibraryItemMarkAsWatched:
+		var args struct {
+			ID        string `json:"id"`
+			IsWatched bool   `json:"isWatched"`
+		}
+		if err := m.Action.DecodeInnerArgs(&args); err != nil {
+			return runtime.None().Unchanged()
+		}
+		item, exists := c.Library.Items[args.ID]
+		if !exists {
+			return runtime.None().Unchanged()
+		}
+		item.MarkAsWatched(c.Env.Now(), args.IsWatched)
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, item))).Unchanged()
+
+	case msg.ActionCtxMetaItemMarkAsWatched:
+		var args struct {
+			MetaItem  types.MetaItemPreview `json:"metaItem"`
+			IsWatched bool                  `json:"isWatched"`
+		}
+		if err := m.Action.DecodeInnerArgs(&args); err != nil {
+			return runtime.None().Unchanged()
+		}
+		item, exists := c.Library.Items[args.MetaItem.ID]
+		if !exists {
+			if !args.IsWatched {
+				return runtime.None().Unchanged()
+			}
+			now := c.Env.Now()
+			item = types.LibraryItem{ID: args.MetaItem.ID, Ctime: &now, Mtime: now, Removed: true, Temp: true,
+				Name: args.MetaItem.Name, Type: args.MetaItem.Type, Poster: args.MetaItem.Poster,
+				PosterShape: args.MetaItem.PosterShape, BehaviorHints: args.MetaItem.BehaviorHints}
+		}
+		item.MarkAsWatched(c.Env.Now(), args.IsWatched)
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, item))).Unchanged()
+
+	case msg.ActionCtxToggleLibraryItemNotifications:
+		return toggleNotifications(c, m)
+	}
+	return runtime.None().Unchanged()
+}
+
+func toggleNotifications(c *Ctx, m *msg.Msg) runtime.Effects {
+	var args []any
+	if err := m.Action.DecodeInnerArgs(&args); err != nil || len(args) != 2 {
+		return runtime.None().Unchanged()
+	}
+	id, _ := args[0].(string)
+	state, _ := args[1].(bool)
+	item, exists := c.Library.Items[id]
+	if !exists {
+		return runtime.None().Unchanged()
+	}
+	item.State.NoNotif = state
+	effects := runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, item))).
+		Join(runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventLibraryItemNotificationsToggled, map[string]any{"id": id}))))
+	if state {
+		effects = effects.Join(runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalDismissNotificationItem, id))))
+	}
+	return effects.Unchanged()
+}
+
+func pushLibraryToStorage(env runtime.Env, library *types.LibraryBucket) runtime.Effects {
+	recent, other := library.SplitItemsByRecent()
+	recentBucket := types.LibraryBucket{UID: library.UID, Items: map[string]types.LibraryItem{}}
+	for _, item := range recent {
+		recentBucket.Items[item.ID] = item
+	}
+	otherBucket := types.LibraryBucket{UID: library.UID, Items: map[string]types.LibraryItem{}}
+	for _, item := range other {
+		otherBucket.Items[item.ID] = item
+	}
+	return runtime.FutureEffectSet(runtime.SequentialFuture(func() *msg.Msg {
+		if err := env.SetStorage(core.LIBRARY_RECENT_STORAGE_KEY, recentBucket); err != nil {
+			return msg.EventMsg(msg.NewEvent(msg.EventError, map[string]any{"message": err.Message}))
+		}
+		if err := env.SetStorage(core.LIBRARY_STORAGE_KEY, otherBucket); err != nil {
+			return msg.EventMsg(msg.NewEvent(msg.EventError, map[string]any{"message": err.Message}))
+		}
+		return msg.EventMsg(msg.NewEvent(msg.EventLibraryItemsPushedToStorage, nil))
+	}))
+}
diff --git a/models/ctx/update_notifications.go b/models/ctx/update_notifications.go
