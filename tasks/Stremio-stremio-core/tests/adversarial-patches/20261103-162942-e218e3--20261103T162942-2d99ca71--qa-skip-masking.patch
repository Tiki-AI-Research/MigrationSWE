+package ctx
+
+import (
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateStreams(c *Ctx, m *msg.Msg) runtime.Effects {
+	switch {
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalLogout:
+		next := types.NewStreamsBucket(nil)
+		if len(c.Streams.Items) > 0 || c.Streams.UID != nil {
+			c.Streams = next
+			return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalStreamsChanged, false)))
+		}
+		return runtime.None().Unchanged()
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalStreamLoaded:
+		data, ok := m.Internal.Data.(types.StreamLoadedData)
+		if !ok || data.StreamRequest == nil || data.MetaRequest == nil {
+			return runtime.None().Unchanged()
+		}
+		key := types.StreamsItemKey{MetaID: data.MetaRequest.Path.ID, VideoID: data.StreamRequest.Path.ID}
+		c.Streams.Items[key] = types.StreamsItem{
+			Stream:             data.Stream,
+			Type:               data.MetaRequest.Path.Type,
+			MetaID:             data.MetaRequest.Path.ID,
+			VideoID:            data.StreamRequest.Path.ID,
+			MetaTransportURL:   data.MetaRequest.Base,
+			StreamTransportURL: data.StreamRequest.Base,
+			Mtime:              c.Env.Now(),
+		}
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalStreamsChanged, false)))
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalStreamStateChanged:
+		data, ok := m.Internal.Data.(types.StreamStateChangedData)
+		if !ok || data.StreamRequest == nil || data.MetaRequest == nil {
+			return runtime.None().Unchanged()
+		}
+		key := types.StreamsItemKey{MetaID: data.MetaRequest.Path.ID, VideoID: data.StreamRequest.Path.ID}
+		if item, exists := c.Streams.Items[key]; exists {
+			item.State = data.State
+			c.Streams.Items[key] = item
+			return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalStreamsChanged, false)))
+		}
+		return runtime.None().Unchanged()
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalStreamsChanged:
+		persisted, _ := m.Internal.Data.(bool)
+		if persisted {
+			return runtime.None().Unchanged()
+		}
+		return setStorageEffect(c.Env, core.STREAMS_STORAGE_KEY, c.Streams, msg.EventStreamsPushedToStorage).Unchanged()
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalCtxAuthResult:
+		result, ok := m.Internal.Data.(CtxAuthResponse)
+		if !ok {
+			return runtime.None().Unchanged()
+		}
+		uid := string(result.Auth.User.ID)
+		c.Streams = types.NewStreamsBucket(&uid)
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalStreamsChanged, false)))
+	}
+	return runtime.None().Unchanged()
+}
diff --git a/models/model.go b/models/model.go
new file mode 100644
index 0000000..9f3bbbf
--- /dev/null
+++ b/models/model.go
@@ -0,0 +1,84 @@
+package models
+
+import (
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+)
+
+// Field names of the root model. They are emitted in a stable order.
+const (
+	FieldCtx             = "ctx"
+	FieldStreamingServer = "streaming_server"
+	FieldPlayer          = "player"
+)
+
+// fieldOrder is the stable order in which changed fields are reported.
+var fieldOrder = []string{FieldCtx, FieldStreamingServer, FieldPlayer}
+
+// Model is the root runtime model. It mirrors the derive(Model) container from
+// the Rust engine, routing updates to the sub-models and reporting changed
+// fields.
+type Model struct {
+	Ctx             *ctx.Ctx
+	Player          *Player
+	StreamingServer *StreamingServer
+}
+
+// New builds a root model.
+func New(env runtime.Env) *Model {
+	return &Model{
+		Ctx:             ctx.New(env),
+		Player:          NewPlayer(env),
+		StreamingServer: NewStreamingServer(env),
+	}
+}
+
+// Update applies a message to the whole model.
+func (m *Model) Update(message *msg.Msg) ([]runtime.Effect, []string) {
+	return m.update(message, nil)
+}
+
+// UpdateField applies a message to a single field.
+func (m *Model) UpdateField(message *msg.Msg, field string) ([]runtime.Effect, []string) {
+	return m.update(message, &field)
+}
+
+func (m *Model) update(message *msg.Msg, only *string) ([]runtime.Effect, []string) {
+	changedSet := map[string]bool{}
+	var effects runtime.Effects = runtime.Default()
+
+	apply := func(field string, eff runtime.Effects) {
+		if eff.HasChanged {
+			changedSet[field] = true
+		}
+		effects = effects.Join(eff)
+	}
+
+	if only != nil {
+		switch *only {
+		case FieldPlayer:
+			apply(FieldPlayer, m.Player.UpdateWithCtx(message, m.Ctx))
+		case FieldStreamingServer:
+			apply(FieldStreamingServer, m.StreamingServer.UpdateWithCtx(message, m.Ctx))
+		case FieldCtx:
+			apply(FieldCtx, m.Ctx.Update(message))
+		}
+	} else {
+		// Whole-model update mirrors derive(Model): every non-ctx sub-model is
+		// updated with the message (and read-only access to the Ctx), then the
+		// Ctx itself is updated. All sub-models contribute their effects and
+		// changed fields. Routing is reserved for UpdateField.
+		apply(FieldPlayer, m.Player.UpdateWithCtx(message, m.Ctx))
+		apply(FieldStreamingServer, m.StreamingServer.UpdateWithCtx(message, m.Ctx))
+		apply(FieldCtx, m.Ctx.Update(message))
+	}
+
+	changed := make([]string, 0, len(changedSet))
+	for _, field := range fieldOrder {
+		if changedSet[field] {
+			changed = append(changed, field)
+		}
+	}
+	return effects.Effects, changed
+}
diff --git a/models/model_test.go b/models/model_test.go
new file mode 100644
index 0000000..b7a3786
--- /dev/null
+++ b/models/model_test.go
@@ -0,0 +1,64 @@
+package models_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/models"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+)
+
+func TestTwoIdenticalPlayerLoadsEachEmitOneNewState(t *testing.T) {
+	env := testenv.New()
+	model := models.New(env)
+	rt, rx := runtime.New(model, nil, 16, env)
+
+	selected := map[string]any{"stream": map[string]any{"title": "same"}}
+	action := msg.LoadAction(msg.ModelPlayer, selected)
+
+	drain := func() []runtime.RuntimeEvent {
+		var events []runtime.RuntimeEvent
+		for {
+			select {
+			case ev := <-rx:
+				events = append(events, ev)
+			default:
+				return events
+			}
+		}
+	}
+
+	rt.Dispatch(runtime.RuntimeAction{Action: action})
+	first := drain()
+	if len(first) != 1 || first[0].Name != "NewState" {
+		t.Fatalf("first load events = %+v", first)
+	}
+	var fields []string
+	if err := json.Unmarshal(first[0].Args, &fields); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	if len(fields) != 1 || fields[0] != models.FieldPlayer {
+		t.Fatalf("first load fields = %v", fields)
+	}
+
+	rt.Dispatch(runtime.RuntimeAction{Action: action})
+	second := drain()
+	if len(second) != 1 || second[0].Name != "NewState" {
+		t.Fatalf("second identical load events = %+v", second)
+	}
+}
+
+func TestUnloadWithNoSelectionEmitsNoNewState(t *testing.T) {
+	env := testenv.New()
+	model := models.New(env)
+	rt, rx := runtime.New(model, nil, 16, env)
+
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.UnloadAction()})
+	select {
+	case ev := <-rx:
+		t.Fatalf("expected no event, got %+v", ev)
+	default:
+	}
+}
diff --git a/models/player.go b/models/player.go
new file mode 100644
index 0000000..36a215f
--- /dev/null
+++ b/models/player.go
@@ -0,0 +1,1254 @@
+package models
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"strconv"
+	"time"
+
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// pushToLibraryEvery is the interval that must pass before a LibraryItem is
+// pushed to the library again.
+const pushToLibraryEvery = 90 * time.Second
+
+// VideoParams holds the video parameters for the current player session.
+type VideoParams struct {
+	Hash     *string `json:"hash,omitempty"`
+	Size     *uint64 `json:"size,omitempty"`
+	Filename *string `json:"filename,omitempty"`
+}
+
+// Selected is the currently selected player source.
+type Selected struct {
+	Stream        types.Stream           `json:"stream"`
+	StreamRequest *types.ResourceRequest `json:"streamRequest,omitempty"`
+	MetaRequest   *types.ResourceRequest `json:"metaRequest,omitempty"`
+	SubtitlesPath *types.ResourcePath    `json:"subtitlesPath,omitempty"`
+}
+
+// skipGapsState holds the current skip-gaps request and its load state.
+type skipGapsState struct {
+	Request types.SkipGapsRequest
+	Load    common.Loadable[types.SkipGapsResponse]
+}
+
+// seekLogsResult is the result of a seek-log submission.
+type seekLogsResult struct {
+	Request types.SeekLogRequest
+	Err     error
+}
+
+// skipGapsResult is the result of a skip-gaps request.
+type skipGapsResult struct {
+	Request  types.SkipGapsRequest
+	Response *types.SkipGapsResponse
+	Err      error
+}
+
+// watchedSendResult is the result of a watched rating submission.
+type watchedSendResult struct {
+	MetaID string
+	Err    error
+}
+
+// Player is the player model.
+type Player struct {
+	Env                  runtime.Env
+	Selected             *Selected
+	VideoParams          *VideoParams
+	MetaItem             *common.ResourceLoadable[types.MetaItem]
+	Subtitles            []common.ResourceLoadable[[]types.Subtitles]
+	NextVideo            *types.Video
+	NextStreams          *common.ResourceLoadable[[]types.Stream]
+	NextStream           *types.Stream
+	Stream               *common.Loadable[types.Stream]
+	SeriesInfo           *types.SeriesInfo
+	LibraryItem          *types.LibraryItem
+	StreamState          *types.StreamItemState
+	SubtitlePreference   *types.SubtitlePreference
+	VideoScale           *types.VideoScale
+	IntroOutro           *types.IntroOutro
+	Watched              *types.WatchedBitField
+	AnalyticsContext     *types.AnalyticsContext
+	LoadTime             *time.Time
+	PushLibraryItemTime  time.Time
+	Loaded               bool
+	Ended                bool
+	MarkedVideoAsWatched bool
+	Paused               *bool
+	SeekHistory          []types.SeekLog
+	SkipGaps             *skipGapsState
+	CollectSeekLogs      bool
+}
+
+// NewPlayer builds an empty player.
+func NewPlayer(env runtime.Env) *Player {
+	return &Player{Env: env}
+}
+
+// UpdateWithCtx reacts to messages that belong to the player.
+func (p *Player) UpdateWithCtx(m *msg.Msg, c *ctx.Ctx) runtime.Effects {
+	switch m.Kind {
+	case msg.KindAction:
+		switch m.Action.Action {
+		case msg.ActionNameLoad:
+			return p.onLoad(m.Action, c)
+		case msg.ActionNameUnload:
+			return p.onUnload()
+		case msg.ActionNamePlayer:
+			return p.onPlayerAction(m.Action, c)
+		}
+	case msg.KindInternal:
+		return p.onInternal(m.Internal, c)
+	}
+	return runtime.Default()
+}
+
+func (p *Player) onLoad(a *msg.Action, c *ctx.Ctx) runtime.Effects {
+	load, err := a.DecodeLoad()
+	if err != nil || load.Model != msg.ModelPlayer {
+		return runtime.Default()
+	}
+	var selected Selected
+	if err := json.Unmarshal(load.Args, &selected); err != nil {
+		return runtime.Default()
+	}
+
+	// Make sure to send the correct Trakt event if the model hasn't been
+	// unloaded and playback had actually started.
+	var traktEffects runtime.Effects = runtime.None().Unchanged()
+	if p.Selected != nil && p.Loaded {
+		traktEffects = runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventTraktPaused,
+			map[string]any{"context": p.analyticsContextOrDefault()}))).Unchanged()
+	}
+
+	// Advance the previous library item only when the selected meta item
+	// actually changed.
+	previousMetaID := metaRequestID(p.Selected)
+	newMetaID := ""
+	if selected.MetaRequest != nil {
+		newMetaID = selected.MetaRequest.Path.ID
+	}
+	var itemStateEffects runtime.Effects = runtime.None().Unchanged()
+	if previousMetaID != newMetaID {
+		itemStateEffects = itemStateUpdate(&p.LibraryItem, p.NextVideo, p.MarkedVideoAsWatched)
+	}
+
+	// Each player load starts a new observable playback lifecycle, even when the
+	// selected source is structurally identical to the previous one.
+	selectedEffects := common.EqUpdate(&p.Selected, &selected).Join(runtime.None())
+
+	metaEffects := p.updateMetaItem(selected)
+
+	streamStateEffects := common.EqUpdate(&p.StreamState, (*types.StreamItemState)(nil))
+	videoParamsEffects := common.EqUpdate(&p.VideoParams, (*VideoParams)(nil))
+
+	streamEffects := p.streamUpdate(c)
+	subtitlesEffects := p.subtitlesUpdate(c)
+	nextVideoEffects := p.nextVideoUpdate()
+	nextStreamsEffects := p.nextStreamsUpdate()
+	nextStreamEffects := p.nextStreamUpdate()
+
+	var updateStreamsEffects runtime.Effects = runtime.None().Unchanged()
+	if p.Selected != nil && p.Selected.StreamRequest != nil && p.Selected.MetaRequest != nil {
+		data := types.StreamLoadedData{
+			Stream:        p.Selected.Stream,
+			StreamRequest: p.Selected.StreamRequest,
+			MetaRequest:   p.Selected.MetaRequest,
+		}
+		updateStreamsEffects = runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalStreamLoaded, data))).Unchanged()
+	}
+
+	seriesInfoEffects := p.seriesInfoUpdate()
+	libraryItemEffects := p.libraryItemUpdate(c)
+	libraryItemStateEffects := p.libraryItemStateUpdate()
+	watchedEffects := p.watchedUpdate()
+	skipGapsEffects := common.EqUpdate(&p.SkipGaps, (*skipGapsState)(nil))
+	introOutroEffects := p.introOutroUpdate(c)
+
+	var notificationEffects runtime.Effects = runtime.None().Unchanged()
+	if p.LibraryItem != nil {
+		notificationEffects = runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalDismissNotificationItem, p.LibraryItem.ID))).Unchanged()
+	}
+
+	p.updateAnalyticsContext(c)
+	now := p.Env.Now()
+	p.LoadTime = &now
+	p.Loaded = false
+	p.Ended = false
+	p.Paused = nil
+	p.MarkedVideoAsWatched = false
+
+	return traktEffects.
+		Join(itemStateEffects).
+		Join(selectedEffects).
+		Join(metaEffects).
+		Join(streamStateEffects).
+		Join(videoParamsEffects).
+		Join(streamEffects).
+		Join(subtitlesEffects).
+		Join(nextVideoEffects).
+		Join(nextStreamsEffects).
+		Join(nextStreamEffects).
+		Join(updateStreamsEffects).
+		Join(seriesInfoEffects).
+		Join(libraryItemEffects).
+		Join(libraryItemStateEffects).
+		Join(watchedEffects).
+		Join(skipGapsEffects).
+		Join(introOutroEffects).
+		Join(notificationEffects)
+}
+
+func (p *Player) onUnload() runtime.Effects {
+	if p.Selected == nil {
+		return runtime.None().Unchanged()
+	}
+
+	traktEffects := runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventTraktPaused,
+		map[string]any{"context": p.analyticsContextOrDefault()}))).Unchanged()
+
+	var endedEffects runtime.Effects = runtime.None().Unchanged()
+	if !p.Ended {
+		endedEffects = runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventPlayerStopped,
+			map[string]any{"context": p.analyticsContextOrDefault()}))).Unchanged()
+	}
+
+	seekEffects := p.seekUpdate(nil)
+
+	itemStateEffects := itemStateUpdate(&p.LibraryItem, p.NextVideo, p.MarkedVideoAsWatched)
+
+	var pushEffects runtime.Effects = runtime.None().Unchanged()
+	if p.LibraryItem != nil {
+		pushEffects = runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, *p.LibraryItem))).Unchanged()
+	}
+
+	selectedEffects := common.EqUpdate(&p.Selected, (*Selected)(nil))
+	videoParamsEffects := common.EqUpdate(&p.VideoParams, (*VideoParams)(nil))
+	metaEffects := common.EqUpdate(&p.MetaItem, (*common.ResourceLoadable[types.MetaItem])(nil))
+	streamStateEffects := common.EqUpdate(&p.StreamState, (*types.StreamItemState)(nil))
+	subtitlePreferenceEffects := common.EqUpdate(&p.SubtitlePreference, (*types.SubtitlePreference)(nil))
+	videoScaleEffects := common.EqUpdate(&p.VideoScale, (*types.VideoScale)(nil))
+	streamEffects := common.EqUpdate(&p.Stream, (*common.Loadable[types.Stream])(nil))
+	subtitlesEffects := common.EqUpdate(&p.Subtitles, []common.ResourceLoadable[[]types.Subtitles]{})
+	nextVideoEffects := common.EqUpdate(&p.NextVideo, (*types.Video)(nil))
+	nextStreamsEffects := common.EqUpdate(&p.NextStreams, (*common.ResourceLoadable[[]types.Stream])(nil))
+	nextStreamEffects := common.EqUpdate(&p.NextStream, (*types.Stream)(nil))
+	seriesInfoEffects := common.EqUpdate(&p.SeriesInfo, (*types.SeriesInfo)(nil))
+	libraryItemEffects := common.EqUpdate(&p.LibraryItem, (*types.LibraryItem)(nil))
+	watchedEffects := common.EqUpdate(&p.Watched, (*types.WatchedBitField)(nil))
+	skipGapsEffects := common.EqUpdate(&p.SkipGaps, (*skipGapsState)(nil))
+
+	p.AnalyticsContext = nil
+	p.LoadTime = nil
+	p.Loaded = false
+	p.Ended = false
+	p.Paused = nil
+	p.MarkedVideoAsWatched = false
+
+	return traktEffects.
+		Join(seekEffects).
+		Join(itemStateEffects).
+		Join(pushEffects).
+		Join(selectedEffects).
+		Join(videoParamsEffects).
+		Join(streamEffects).
+		Join(metaEffects).
+		Join(streamStateEffects).
+		Join(subtitlePreferenceEffects).
+		Join(videoScaleEffects).
+		Join(subtitlesEffects).
+		Join(nextVideoEffects).
+		Join(nextStreamsEffects).
+		Join(nextStreamEffects).
+		Join(seriesInfoEffects).
+		Join(libraryItemEffects).
+		Join(watchedEffects).
+		Join(skipGapsEffects).
+		Join(endedEffects)
+}
+
+func (p *Player) onPlayerAction(a *msg.Action, c *ctx.Ctx) runtime.Effects {
+	switch a.InnerActionName() {
+	case msg.ActionPlayerVideoParamsChanged:
+		var args struct {
+			VideoParams *VideoParams `json:"videoParams"`
+		}
+		if err := a.DecodeInnerArgs(&args); err != nil {
+			return runtime.Default()
+		}
+		videoParamsEffects := common.EqUpdate(&p.VideoParams, args.VideoParams)
+		subtitlesEffects := p.subtitlesUpdate(c)
+		skipGapsEffects := p.skipGapsUpdate(c)
+		return videoParamsEffects.Join(subtitlesEffects).Join(skipGapsEffects)
+
+	case msg.ActionPlayerStreamStateChanged:
+		var args struct {
+			State types.StreamItemState `json:"state"`
+		}
+		if err := a.DecodeInnerArgs(&args); err != nil {
+			return runtime.Default()
+		}
+		data := types.StreamStateChangedData{State: &args.State}
+		if p.Selected != nil {
+			data.StreamRequest = p.Selected.StreamRequest
+			data.MetaRequest = p.Selected.MetaRequest
+		}
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalStreamStateChanged, data))).Unchanged()
+
+	case msg.ActionPlayerSubtitlePreferenceChanged:
+		var args struct {
+			Preference types.SubtitlePreference `json:"preference"`
+		}
+		if err := a.DecodeInnerArgs(&args); err != nil {
+			return runtime.Default()
+		}
+		if p.Selected != nil {
+			return common.EqUpdate(&p.SubtitlePreference, &args.Preference)
+		}
+		return runtime.None().Unchanged()
+
+	case msg.ActionPlayerVideoScaleChanged:
+		var args struct {
+			VideoScale types.VideoScale `json:"videoScale"`
+		}
+		if err := a.DecodeInnerArgs(&args); err != nil {
+			return runtime.Default()
+		}
+		if p.Selected != nil {
+			return common.EqUpdate(&p.VideoScale, &args.VideoScale)
+		}
+		return runtime.None().Unchanged()
+
+	case msg.ActionPlayerSeek:
+		return p.onSeek(a, c)
+
+	case msg.ActionPlayerTimeChanged:
+		return p.onTimeChanged(a, c)
+
+	case msg.ActionPlayerPausedChanged:
+		return p.onPausedChanged(a)
+
+	case msg.ActionPlayerNextVideo:
+		return p.onNextVideo(c)
+
+	case msg.ActionPlayerEnded:
+		if p.Selected == nil {
+			return runtime.None().Unchanged()
+		}
+		p.Ended = true
+		return runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventPlayerEnded, map[string]any{
+			"context":               p.analyticsContextOrDefault(),
+			"is_binge_enabled":      p.bingeWatching(c),
+			"is_playing_next_video": p.NextVideo != nil,
+		}))).Unchanged()
+
+	case msg.ActionPlayerMarkVideoAsWatched:
+		var args []json.RawMessage
+		if err := a.DecodeInnerArgs(&args); err != nil || len(args) != 2 {
+			return runtime.Default()
+		}
+		var video types.Video
+		if err := json.Unmarshal(args[0], &video); err != nil {
+			return runtime.Default()
+		}
+		var isWatched bool
+		if err := json.Unmarshal(args[1], &isWatched); err != nil {
+			return runtime.Default()
+		}
+		return p.markVideoAsWatched(video, isWatched)
+
+	case msg.ActionPlayerMarkSeasonAsWatched:
+		var args []json.RawMessage
+		if err := a.DecodeInnerArgs(&args); err != nil || len(args) != 2 {
+			return runtime.Default()
+		}
+		var season uint32
+		if err := json.Unmarshal(args[0], &season); err != nil {
+			return runtime.Default()
+		}
+		var isWatched bool
+		if err := json.Unmarshal(args[1], &isWatched); err != nil {
+			return runtime.Default()
+		}
+		return p.markSeasonAsWatched(season, isWatched)
+	}
+	return runtime.Default()
+}
+
+func (p *Player) onSeek(a *msg.Action, c *ctx.Ctx) runtime.Effects {
+	var args struct {
+		Time     uint64 `json:"time"`
+		Duration uint64 `json:"duration"`
+		Device   string `json:"device"`
+	}
+	if err := a.DecodeInnerArgs(&args); err != nil {
+		return runtime.Default()
+	}
+	if p.Selected == nil || p.LibraryItem == nil {
+		return runtime.None().Unchanged()
+	}
+
+	now := p.Env.Now()
+	p.LibraryItem.State.LastWatched = &now
+
+	if p.CollectSeekLogs && p.LibraryItem.Type == "series" && args.Time < core.PLAYER_IGNORE_SEEK_AFTER {
+		p.SeekHistory = append(p.SeekHistory, types.SeekLog{
+			From: p.LibraryItem.State.TimeOffset,
+			To:   args.Time,
+		})
+	}
+	p.LibraryItem.State.TimeOffset = args.Time
+	p.LibraryItem.State.Duration = args.Duration
+
+	if p.AnalyticsContext != nil {
+		p.AnalyticsContext.VideoID = p.LibraryItem.State.VideoID
+		timeOffset := p.LibraryItem.State.TimeOffset
+		duration := p.LibraryItem.State.Duration
+		p.AnalyticsContext.Time = &timeOffset
+		p.AnalyticsContext.Duration = &duration
+		device := args.Device
+		p.AnalyticsContext.DeviceType = &device
+		p.AnalyticsContext.DeviceName = &device
+		playerDuration := args.Duration
+		p.AnalyticsContext.PlayerDuration = &playerDuration
+	}
+
+	var traktEffects runtime.Effects = runtime.Default()
+	if p.Loaded {
+		if p.Paused != nil && *p.Paused {
+			traktEffects = runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventTraktPaused,
+				map[string]any{"context": p.analyticsContextOrDefault()}))).Unchanged()
+		} else if p.Paused != nil {
+			traktEffects = runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventTraktPlaying,
+				map[string]any{"context": p.analyticsContextOrDefault()}))).Unchanged()
+		}
+	}
+
+	pushEffects := p.pushToLibrary()
+	introOutroEffects := p.introOutroUpdate(c)
+
+	return traktEffects.Join(pushEffects).Join(introOutroEffects)
+}
+
+func (p *Player) onTimeChanged(a *msg.Action, c *ctx.Ctx) runtime.Effects {
+	var args struct {
+		Time     uint64 `json:"time"`
+		Duration uint64 `json:"duration"`
+		Device   string `json:"device"`
+	}
+	if err := a.DecodeInnerArgs(&args); err != nil {
+		return runtime.Default()
+	}
+	if p.Selected == nil || p.Selected.StreamRequest == nil || p.LibraryItem == nil {
+		return runtime.None().Unchanged()
+	}
+	videoID := p.Selected.StreamRequest.Path.ID
+
+	now := p.Env.Now()
+	p.LibraryItem.State.LastWatched = &now
+
+	if p.LibraryItem.State.VideoID == nil || *p.LibraryItem.State.VideoID != videoID {
+		p.LibraryItem.State.VideoID = &videoID
+		p.LibraryItem.State.OverallTimeWatched += p.LibraryItem.State.TimeWatched
+		p.LibraryItem.State.TimeWatched = 0
+		p.LibraryItem.State.FlaggedWatched = 0
+	} else {
+		timeWatched := uint64(0)
+		if args.Time > p.LibraryItem.State.TimeOffset {
+			timeWatched = args.Time - p.LibraryItem.State.TimeOffset
+		}
+		p.LibraryItem.State.TimeWatched += timeWatched
+		p.LibraryItem.State.OverallTimeWatched += timeWatched
+	}
+
+	if args.Time > p.LibraryItem.State.TimeOffset {
+		p.LibraryItem.State.TimeOffset = args.Time
+		p.LibraryItem.State.Duration = args.Duration
+	}
+
+	shouldSendWatched := false
+	if p.LibraryItem.State.FlaggedWatched == 0 &&
+		float64(p.LibraryItem.State.TimeWatched) > float64(p.LibraryItem.State.Duration)*core.WATCHED_THRESHOLD_COEF {
+		p.LibraryItem.State.FlaggedWatched = 1
+		p.LibraryItem.State.TimesWatched++
+		if p.Watched != nil {
+			watched := *p.Watched
+			watched.SetVideo(videoID, true)
+			encoded := watched.String()
+			p.LibraryItem.State.Watched = &encoded
+		}
+		shouldSendWatched = true
+	}
+
+	var sendWatchedEffects runtime.Effects = runtime.None().Unchanged()
+	if shouldSendWatched {
+		if authKey := c.Profile.GetAuthKey(); authKey != nil && p.Selected.MetaRequest != nil {
+			sendWatchedEffects = p.sendWatched(*authKey, p.Selected.MetaRequest.Path)
+		}
+	}
+
+	if p.LibraryItem.Temp && p.LibraryItem.State.TimesWatched == 0 {
+		p.LibraryItem.Removed = true
+	}
+	if p.LibraryItem.Removed {
+		p.LibraryItem.Temp = true
+	}
+
+	if p.AnalyticsContext != nil {
+		p.AnalyticsContext.VideoID = p.LibraryItem.State.VideoID
+		timeOffset := p.LibraryItem.State.TimeOffset
+		duration := p.LibraryItem.State.Duration
+		p.AnalyticsContext.Time = &timeOffset
+		p.AnalyticsContext.Duration = &duration
+		device := args.Device
+		p.AnalyticsContext.DeviceType = &device
+		p.AnalyticsContext.DeviceName = &device
+		playerDuration := args.Duration
+		p.AnalyticsContext.PlayerDuration = &playerDuration
+	}
+
+	pushEffects := p.pushToLibrary()
+	introOutroEffects := p.introOutroUpdate(c)
+
+	return sendWatchedEffects.Join(pushEffects).Join(introOutroEffects)
+}
