new file mode 100644
index 0000000..c53f509
--- /dev/null
+++ b/deep_links/external_player.go
@@ -0,0 +1,167 @@
+package deeplinks
+
+import (
+	"encoding/base64"
+	"fmt"
+	"regexp"
+	"strings"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+var httpSchemeRe = regexp.MustCompile(`https?://`)
+
+// ErrorLink builds the `stremio:///error` link for the given message.
+func ErrorLink(message string) string {
+	return fmt.Sprintf("stremio:///error?%s",
+		types.QueryParamsEncode([]types.QueryPair{{Key: "message", Value: message}}))
+}
+
+// buildStreamingURL computes the streaming URL of a raw stream for a running
+// streaming server, mirroring the subset of `Stream::convert` needed by deep
+// links.
+func buildStreamingURL(stream types.Stream, streamingServerURL string) (streaming, download, magnet *string) {
+	server := strings.TrimRight(streamingServerURL, "/")
+	switch stream.Source.Kind {
+	case types.StreamSourceURL:
+		if strings.HasPrefix(stream.Source.URL, "magnet:") {
+			m := stream.Source.URL
+			return nil, nil, &m
+		}
+		s := stream.Source.URL
+		return &s, &s, nil
+	case types.StreamSourceTorrent:
+		m := types.BuildMagnetURI(stream.Source.InfoHash, stream.Source.Announce, stream.Name)
+		path := stream.Source.InfoHash
+		if stream.Source.FileIdx != nil {
+			path = fmt.Sprintf("%s/%d", path, *stream.Source.FileIdx)
+		} else {
+			path = path + "/-1"
+		}
+		query := ""
+		for _, tracker := range stream.Source.Announce {
+			query += "&tr=" + types.PercentEncode(tracker)
+		}
+		streamingURL := server + "/" + path
+		if query != "" {
+			streamingURL += "?" + strings.TrimPrefix(query, "&")
+		}
+		downloadURL := streamingURL + "?external=1&download=1"
+		return &streamingURL, &downloadURL, &m
+	case types.StreamSourceYouTube:
+		s := server + "/yt/" + types.PercentEncode(stream.Source.YtID)
+		d := "https://youtube.com/watch?v=" + types.PercentEncode(stream.Source.YtID)
+		return &s, &d, nil
+	case types.StreamSourceExternal:
+		if stream.Source.ExternalURL != nil {
+			return stream.Source.ExternalURL, stream.Source.ExternalURL, nil
+		}
+	case types.StreamSourcePlayerFrame:
+		if stream.Source.PlayerFrameURL != "" {
+			return &stream.Source.PlayerFrameURL, &stream.Source.PlayerFrameURL, nil
+		}
+	}
+	return nil, nil, nil
+}
+
+func m3uDataURI(streamingURL string) string {
+	content := fmt.Sprintf("#EXTM3U\n#EXTINF:0\n%s", streamingURL)
+	return "data:application/octet-stream;charset=utf-8;base64," + base64.StdEncoding.EncodeToString([]byte(content))
+}
+
+func openPlayerLink(playerType string, streamingURL string, playlist string) *OpenPlayerLink {
+	switch playerType {
+	case "choose":
+		return &OpenPlayerLink{Android: strp(httpSchemeRe.ReplaceAllString(streamingURL, "intent://") + "#Intent;type=video/any;scheme=https;end")}
+	case "vlc":
+		return &OpenPlayerLink{
+			IOS:      strp("vlc-x-callback://x-callback-url/stream?url=" + types.PercentEncode(streamingURL)),
+			VisionOS: strp("vlc-x-callback://x-callback-url/stream?url=" + types.PercentEncode(streamingURL)),
+			Android:  strp(httpSchemeRe.ReplaceAllString(streamingURL, "intent://") + "#Intent;package=org.videolan.vlc;type=video;scheme=https;end"),
+			Windows:  strp("vlc://" + streamingURL),
+		}
+	case "mxplayer":
+		return &OpenPlayerLink{Android: strp(httpSchemeRe.ReplaceAllString(streamingURL, "intent://") + "#Intent;package=com.mxtech.videoplayer.ad;type=video;scheme=https;end")}
+	case "justplayer":
+		return &OpenPlayerLink{Android: strp(httpSchemeRe.ReplaceAllString(streamingURL, "intent://") + "#Intent;package=com.brouken.player;type=video;scheme=https;end")}
+	case "outplayer":
+		return &OpenPlayerLink{
+			IOS:      strp(httpSchemeRe.ReplaceAllString(streamingURL, "outplayer://")),
+			VisionOS: strp(httpSchemeRe.ReplaceAllString(streamingURL, "outplayer://")),
+		}
+	case "infuse":
+		return &OpenPlayerLink{
+			IOS:      strp(infuseOpenPlayerLinkConst(streamingURL)),
+			MacOS:    strp(infuseOpenPlayerLinkConst(streamingURL)),
+			VisionOS: strp(infuseOpenPlayerLinkConst(streamingURL)),
+			TvOS:     strp(infuseOpenPlayerLinkConst(streamingURL)),
+		}
+	case "vidhub":
+		return &OpenPlayerLink{
+			IOS:   strp("open-vidhub://x-callback-url/open?on-success=stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D1&on-failed=stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D0&url=" + types.PercentEncode(streamingURL)),
+			MacOS: strp("open-vidhub://x-callback-url/open?on-success=stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D1&on-failed=stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D0&url=" + types.PercentEncode(streamingURL)),
+		}
+	case "cineultra":
+		return &OpenPlayerLink{VisionOS: strp("cineultra://playback?url=" + types.PercentEncode(streamingURL) + "&on-success=stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D1&on-failed=stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D0")}
+	case "iina":
+		return &OpenPlayerLink{MacOS: strp("iina://weblink?url=" + types.PercentEncode(streamingURL))}
+	case "mpv":
+		return &OpenPlayerLink{MacOS: strp("mpv://" + streamingURL)}
+	case "moonplayer":
+		return &OpenPlayerLink{VisionOS: strp("moonplayer://open?url=" + streamingURL)}
+	case "m3u":
+		return &OpenPlayerLink{Linux: &playlist, Windows: &playlist, MacOS: &playlist, Android: &playlist, IOS: &playlist}
+	}
+	return nil
+}
+
+func infuseOpenPlayerLinkConst(streamingURL string) string {
+	return "infuse://x-callback-url/play?x-success=stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D1&x-error=stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D0&url=" + types.PercentEncode(streamingURL)
+}
+
+// ExternalPlayerLinkFromStream builds an ExternalPlayerLink from a raw stream,
+// the streaming server url (nil when the server is not running) and settings.
+func ExternalPlayerLinkFromStream(stream types.Stream, streamingServerURL *string, settings types.Settings) ExternalPlayerLink {
+	link := ExternalPlayerLink{}
+	if magnet := types.MagnetURLFromRaw(stream); magnet != nil {
+		link.Magnet = magnet
+	}
+
+	if streamingServerURL != nil {
+		streaming, download, _ := buildStreamingURL(stream, *streamingServerURL)
+		link.Streaming = streaming
+		link.Download = download
+		if streaming != nil {
+			playlist := m3uDataURI(*streaming)
+			link.Playlist = &playlist
+			name := "playlist.m3u"
+			link.FileName = &name
+			if settings.PlayerType != nil {
+				link.OpenPlayer = openPlayerLink(*settings.PlayerType, *streaming, playlist)
+			}
+		}
+	}
+
+	if stream.Source.Kind == types.StreamSourceExternal {
+		link.Web = stream.Source.ExternalURL
+		link.AndroidTV = stream.Source.AndroidTVURL
+		link.Tizen = stream.Source.TizenURL
+		link.WebOS = stream.Source.WebOSURL
+	}
+	return link
+}
+
+// StreamDeepLinksFromStream builds the player and external-player links for a
+// raw stream.
+func StreamDeepLinksFromStream(stream types.Stream, streamingServerURL *string, settings types.Settings) StreamDeepLinks {
+	encoded, err := stream.Encode()
+	if err != nil {
+		return StreamDeepLinks{Player: ErrorLink(err.Error())}
+	}
+	return StreamDeepLinks{
+		Player:         fmt.Sprintf("stremio:///player/%s", types.PercentEncode(encoded)),
+		ExternalPlayer: ExternalPlayerLinkFromStream(stream, streamingServerURL, settings),
+	}
+}
+
+func strp(s string) *string { return &s }
