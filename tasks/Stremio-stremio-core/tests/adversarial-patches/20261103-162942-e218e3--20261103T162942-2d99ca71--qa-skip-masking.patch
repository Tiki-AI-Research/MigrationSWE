+package addontransport
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+func TestBuildLegacyReqCatalog(t *testing.T) {
+	transportURL := "https://stremio-mixer.schneider.ax/stremioget/stremio/v1"
+	path := types.ResourcePath{Resource: "catalog", Type: "tv", ID: "popularities.mixer"}
+	got, err := BuildLegacyReq(transportURL, path)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "https://stremio-mixer.schneider.ax/stremioget/stremio/v1/q.json?b=eyJpZCI6MSwianNvbnJwYyI6IjIuMCIsIm1ldGhvZCI6Im1ldGEuZmluZCIsInBhcmFtcyI6W251bGwseyJsaW1pdCI6MTAwLCJxdWVyeSI6eyJ0eXBlIjoidHYifSwic2tpcCI6MCwic29ydCI6eyJwb3B1bGFyaXRpZXMubWl4ZXIiOi0xLCJwb3B1bGFyaXR5IjotMX19XX0="
+	if got != want {
+		t.Fatalf("catalog request mismatch:\n got: %s\nwant: %s", got, want)
+	}
+}
+
+func TestBuildLegacyReqStreamImdb(t *testing.T) {
+	transportURL := "https://legacywatchhub.strem.io/stremio/v1"
+	path := types.ResourcePath{Resource: "stream", Type: "series", ID: "tt0386676:5:1"}
+	got, err := BuildLegacyReq(transportURL, path)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "https://legacywatchhub.strem.io/stremio/v1/q.json?b=eyJpZCI6MSwianNvbnJwYyI6IjIuMCIsIm1ldGhvZCI6InN0cmVhbS5maW5kIiwicGFyYW1zIjpbbnVsbCx7InF1ZXJ5Ijp7ImVwaXNvZGUiOjEsImltZGJfaWQiOiJ0dDAzODY2NzYiLCJzZWFzb24iOjUsInR5cGUiOiJzZXJpZXMifX1dfQ=="
+	if got != want {
+		t.Fatalf("stream request mismatch:\n got: %s\nwant: %s", got, want)
+	}
+}
+
+func TestBuildLegacyReqSubtitlesOnlyID(t *testing.T) {
+	transportURL := "https://legacywatchhub.strem.io/stremio/v1"
+	path := types.ResourcePath{Resource: "subtitles", Type: "series", ID: "tt0386676:5:1"}
+	got, err := BuildLegacyReq(transportURL, path)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "https://legacywatchhub.strem.io/stremio/v1/q.json?b=eyJpZCI6MSwianNvbnJwYyI6IjIuMCIsIm1ldGhvZCI6InN1YnRpdGxlcy5maW5kIiwicGFyYW1zIjpbbnVsbCx7InF1ZXJ5Ijp7Iml0ZW1IYXNoIjoidHQwMzg2Njc2IDUgMSJ9fV19"
+	if got != want {
+		t.Fatalf("subtitles request mismatch:\n got: %s\nwant: %s", got, want)
+	}
+}
+
+func TestBuildLegacyReqSubtitlesWithHash(t *testing.T) {
+	transportURL := "https://legacywatchhub.strem.io/stremio/v1"
+	path := types.ResourcePath{
+		Resource: "subtitles",
+		Type:     "series",
+		ID:       "tt0386676:5:1",
+		Extra: []types.ExtraValue{
+			{Name: "videoHash", Value: "ffffffffff"},
+			{Name: "videoSize", Value: "1000000000"},
+		},
+	}
+	got, err := BuildLegacyReq(transportURL, path)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := "https://legacywatchhub.strem.io/stremio/v1/q.json?b=eyJpZCI6MSwianNvbnJwYyI6IjIuMCIsIm1ldGhvZCI6InN1YnRpdGxlcy5maW5kIiwicGFyYW1zIjpbbnVsbCx7InF1ZXJ5Ijp7Iml0ZW1IYXNoIjoidHQwMzg2Njc2IDUgMSIsInZpZGVvSGFzaCI6ImZmZmZmZmZmZmYiLCJ2aWRlb1NpemUiOjEwMDAwMDAwMDB9fV19"
+	if got != want {
+		t.Fatalf("subtitles request mismatch:\n got: %s\nwant: %s", got, want)
+	}
+}
+
+func TestQueryFromID(t *testing.T) {
+	cases := []struct {
+		id   string
+		want string
+	}{
+		{"tt0386676", `{"imdb_id":"tt0386676"}`},
+		{"UC2312", `{"yt_id":"UC2312"}`},
+		{"custom:test", `{"custom":"test"}`},
+		{"tt0386676:5:2", `{"episode":2,"imdb_id":"tt0386676","season":5}`},
+		{"yt_id:video", `{"yt_id":"video"}`},
+		{"custom:test:vid", `{"custom":"test","video_id":"vid"}`},
+	}
+	for _, c := range cases {
+		got, err := json.Marshal(queryFromID(c.id))
+		if err != nil {
+			t.Fatalf("marshal error: %v", err)
+		}
+		if string(got) != c.want {
+			t.Errorf("queryFromID(%q) = %s, want %s", c.id, got, c.want)
+		}
+	}
+}
+
+func TestLegacyErrorMapping(t *testing.T) {
+	err := (&LegacyErr{Kind: LegacyJSONRPC, Code: 5, Message: "boom"}).ToEnvError()
+	if err.Code != 2 {
+		t.Fatalf("code = %d, want 2", err.Code)
+	}
+	if err.Message != "Addon protocol violation: rpc error 5: boom" {
+		t.Fatalf("message = %q", err.Message)
+	}
+	b, _ := json.Marshal(err)
+	if string(b) != `{"code":2,"message":"Addon protocol violation: rpc error 5: boom"}` {
+		t.Fatalf("wire = %s", b)
+	}
+}
