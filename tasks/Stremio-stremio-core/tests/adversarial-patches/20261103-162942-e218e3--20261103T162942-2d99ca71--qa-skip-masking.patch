+package common_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func TestLoadableMarshal(t *testing.T) {
+	if b, _ := json.Marshal(common.Loading[int]()); string(b) != `{"type":"Loading"}` {
+		t.Fatalf("loading = %s", b)
+	}
+	if b, _ := json.Marshal(common.Ready(5)); string(b) != `{"type":"Ready","content":5}` {
+		t.Fatalf("ready = %s", b)
+	}
+}
+
+func TestEqUpdate(t *testing.T) {
+	v := 1
+	if e := common.EqUpdate(&v, 1); e.HasChanged {
+		t.Fatalf("equal values should not change")
+	}
+	if e := common.EqUpdate(&v, 2); !e.HasChanged {
+		t.Fatalf("different values should change")
+	}
+	if v != 2 {
+		t.Fatalf("value = %d, want 2", v)
+	}
+}
+
+func TestEffectsJoinForcesChanged(t *testing.T) {
+	unchanged := runtime.None().Unchanged()
+	joined := unchanged.Join(runtime.None())
+	if !joined.HasChanged {
+		t.Fatalf("join must force HasChanged to true")
+	}
+	if runtime.Default().HasChanged {
+		t.Fatalf("default must be unchanged")
+	}
+}
+
+func TestResourceLoadableTransitions(t *testing.T) {
+	env := testenv.New()
+	request := types.ResourceRequest{Base: "https://addon/manifest.json", Path: types.ResourcePath{Resource: "meta", Type: "movie", ID: "tt1"}}
+	resource := &common.ResourceLoadable[map[string]any]{}
+
+	effects := common.ResourceUpdate(env, resource, common.ResourceRequested(&request), func(r types.ResourceResponse) (map[string]any, error) {
+		var out map[string]any
+		if err := json.Unmarshal(r.Raw, &out); err != nil {
+			return nil, err
+		}
+		return out, nil
+	})
+	if resource.Content == nil || !resource.Content.IsLoading() {
+		t.Fatalf("expected loading content after request")
+	}
+	if !effects.HasChanged {
+		t.Fatalf("request should mark the field as changed")
+	}
+	future := effects.Effects[0].Future
+	output := future.Run()
+	if output.Kind != msg.KindInternal {
+		t.Fatalf("future should resolve to an internal message")
+	}
+	result := output.Internal.Data.(msg.ResourceRequestResult)
+	value := result.Value.(common.ResourceResult)
+	effects2 := common.ResourceUpdate(env, resource, common.ResourceRequestResult(&request, value), func(r types.ResourceResponse) (map[string]any, error) {
+		var out map[string]any
+		if err := json.Unmarshal(r.Raw, &out); err != nil {
+			return nil, err
+		}
+		return out, nil
+	})
+	if resource.Content == nil || !resource.Content.IsReady() {
+		t.Fatalf("expected ready content after result")
+	}
+	if !effects2.HasChanged {
+		t.Fatalf("resolving a result should mark changed")
+	}
+}
