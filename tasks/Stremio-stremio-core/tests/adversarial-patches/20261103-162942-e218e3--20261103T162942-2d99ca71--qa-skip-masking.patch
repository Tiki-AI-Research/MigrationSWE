+}
+
+// Growler mirrors the streaming server growler options.
+type Growler struct {
+	Flood uint64  `json:"flood"`
+	Pulse *uint64 `json:"pulse"`
+}
+
+// SwarmCap mirrors the streaming server swarm cap options.
+type SwarmCap struct {
+	MaxSpeed *float64 `json:"maxSpeed"`
+	MinPeers *uint64  `json:"minPeers"`
+}
+
+// TorrentOptions mirrors the streaming server torrent options.
+type TorrentOptions struct {
+	Connections      *uint64    `json:"connections"`
+	DHT              bool       `json:"dht"`
+	Growler          Growler    `json:"growler"`
+	HandshakeTimeout *uint64    `json:"handshakeTimeout"`
+	Path             string     `json:"path"`
+	PeerSearch       PeerSearch `json:"peerSearch"`
+	SwarmCap         SwarmCap   `json:"swarmCap"`
+	Timeout          *uint64    `json:"timeout"`
+	Tracker          bool       `json:"tracker"`
+	Virtual          bool       `json:"virtual"`
+}
+
+// StatisticsFile describes a file within a torrent.
+type StatisticsFile struct {
+	Name   string `json:"name"`
+	Path   string `json:"path"`
+	Length uint64 `json:"length"`
+	Offset uint64 `json:"offset"`
+}
+
+// StatisticsSource describes a tracker/DHT source of a torrent.
+type StatisticsSource struct {
+	LastStarted  string `json:"lastStarted"`
+	NumFound     uint64 `json:"numFound"`
+	NumFoundUniq uint64 `json:"numFoundUniq"`
+	NumRequests  uint64 `json:"numRequests"`
+	URL          string `json:"url"`
+}
+
+// Statistics is the streaming server statistics for a torrent.
+type Statistics struct {
+	Name              string             `json:"name"`
+	InfoHash          string             `json:"infoHash"`
+	Files             []StatisticsFile   `json:"files"`
+	Sources           []StatisticsSource `json:"sources"`
+	Opts              TorrentOptions     `json:"opts"`
+	DownloadSpeed     float64            `json:"downloadSpeed"`
+	UploadSpeed       float64            `json:"uploadSpeed"`
+	Downloaded        uint64             `json:"downloaded"`
+	Uploaded          uint64             `json:"uploaded"`
+	Unchoked          uint64             `json:"unchoked"`
+	Peers             uint64             `json:"peers"`
+	Queued            uint64             `json:"queued"`
+	Unique            uint64             `json:"unique"`
+	ConnectionTries   uint64             `json:"connectionTries"`
+	PeerSearchRunning bool               `json:"peerSearchRunning"`
+	StreamLen         uint64             `json:"streamLen"`
+	StreamName        string             `json:"streamName"`
+	StreamProgress    float64            `json:"streamProgress"`
+	SwarmConnections  uint64             `json:"swarmConnections"`
+	SwarmPaused       bool               `json:"swarmPaused"`
+	SwarmSize         uint64             `json:"swarmSize"`
+}
+
+// CreateMagnetRequest creates a torrent from a magnet info hash.
+type CreateMagnetRequest struct {
+	ServerURL string
+	InfoHash  InfoHash
+	Announce  []string
+}
+
+// CreateTorrentBlobRequest creates a torrent from a raw torrent blob.
+type CreateTorrentBlobRequest struct {
+	ServerURL string
+	Torrent   []byte
+}
