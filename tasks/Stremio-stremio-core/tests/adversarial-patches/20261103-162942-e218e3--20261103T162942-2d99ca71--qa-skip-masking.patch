+func (s *StreamingServer) getSettings(base string) runtime.Effects {
+	url := joinURL(base, "settings")
+	return s.request("GET", url, nil, func(raw []byte, envErr *runtime.EnvError) *msg.Msg {
+		data := settingsResult{URL: base, Err: envErrToError(envErr)}
+		if envErr == nil {
+			var settings types.SettingsResponse
+			if err := json.Unmarshal(raw, &settings); err != nil {
+				data.Err = runtime.EnvErrorSerde(err.Error())
+			} else {
+				data.Settings = &settings
+			}
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerSettingsResult, data))
+	})
+}
+
+func (s *StreamingServer) getPlaybackDevices(base string, generation uint64) runtime.Effects {
+	url := joinURL(base, "casting")
+	return s.request("GET", url, nil, func(raw []byte, envErr *runtime.EnvError) *msg.Msg {
+		data := playbackDevicesResult{URL: base, Generation: generation, Err: envErrToError(envErr)}
+		if envErr == nil {
+			var devices []PlaybackDevice
+			if err := json.Unmarshal(raw, &devices); err != nil {
+				data.Err = runtime.EnvErrorSerde(err.Error())
+			} else {
+				data.Devices = devices
+			}
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerPlaybackDevicesResult, data))
+	})
+}
