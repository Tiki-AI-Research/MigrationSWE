+)
+
+// APIError is an error returned by the Stremio API.
+type APIError struct {
+	Message string `json:"message"`
+	Code    uint64 `json:"code"`
+}
+
+// CollectionResponse is the response of an addon collection request.
+type CollectionResponse struct {
+	Addons       []Descriptor `json:"addons"`
+	LastModified time.Time    `json:"lastModified"`
+}
+
+// AuthResponse is the response of an authentication request.
+type AuthResponse struct {
+	Key  AuthKey `json:"authKey"`
+	User User    `json:"user"`
+}
+
+// SuccessResponse indicates a successful API request.
+type SuccessResponse struct {
+	Success True `json:"success"`
+}
+
+// LibraryItemModified is a library item id together with its modification time.
+type LibraryItemModified struct {
+	ID    string
+	Mtime time.Time
+}
+
+// LibraryItemsResponse is a response carrying library items.
+type LibraryItemsResponse []LibraryItem
+
+// DataExportResponse is the response of a data export request.
+type DataExportResponse struct {
+	ExportID string `json:"exportId"`
+}
+
+// LinkCodeResponse is the response of a link create request.
+type LinkCodeResponse struct {
+	Code   string `json:"code"`
+	Link   string `json:"link"`
+	QRCode string `json:"qrcode"`
+}
+
+// LinkAuthKey carries an auth key obtained through the link API.
+type LinkAuthKey struct {
+	AuthKey string `json:"authKey"`
+}
+
+// ModalAddon is an addon advertised by a modal.
+type ModalAddon struct {
+	Name        string `json:"name"`
+	ManifestURL string `json:"manifestUrl"`
+}
+
+// GetModalResponse is a modal event.
+type GetModalResponse struct {
+	ID          string      `json:"id"`
+	Title       string      `json:"title"`
+	Message     string      `json:"message"`
+	ImageURL    string      `json:"imageUrl"`
+	Addon       *ModalAddon `json:"addon"`
+	ExternalURL *string     `json:"externalUrl"`
+}
+
+// GetNotificationResponse is a notification event.
+type GetNotificationResponse struct {
+	ID          string  `json:"id"`
+	Title       string  `json:"title"`
+	Message     string  `json:"message"`
+	ExternalURL *string `json:"externalUrl"`
+}
+
+// DatastoreCommand is a datastore request command.
+type DatastoreCommand struct {
+	Kind    string          `json:"-"`
+	IDs     []string        `json:"ids,omitempty"`
+	All     bool            `json:"all,omitempty"`
+	Changes json.RawMessage `json:"changes,omitempty"`
+}
+
+// DatastoreRequest is a request to the Stremio datastore.
+type DatastoreRequest struct {
+	AuthKey    AuthKey          `json:"authKey"`
+	Collection string           `json:"collection"`
+	Command    DatastoreCommand `json:"command"`
+}
+
+// AuthRequest is an authentication request.
+type AuthRequest struct {
+	Type        string       `json:"type"`
+	Email       string       `json:"email,omitempty"`
+	Password    string       `json:"password,omitempty"`
+	Facebook    bool         `json:"facebook,omitempty"`
+	Token       string       `json:"token,omitempty"`
+	Sub         string       `json:"sub,omitempty"`
+	Name        string       `json:"name,omitempty"`
+	GDPRConsent *GDPRConsent `json:"gdprConsent,omitempty"`
+}
+
+// APIRequest is a serialized Stremio API request.
+type APIRequest struct {
+	Type    string          `json:"type"`
+	Payload json.RawMessage `json:"payload,omitempty"`
+}
