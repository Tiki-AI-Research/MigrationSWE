+package types
+
+import "reflect"
+
+// SubtitleSource is the source of a subtitle track.
+type SubtitleSource string
+
+// Subtitle sources.
+const (
+	SubtitleSourceEmbedded SubtitleSource = "embedded"
+	SubtitleSourceExternal SubtitleSource = "external"
+)
+
+// SubtitlePreference is the subtitle preference of a player session.
+type SubtitlePreference struct {
+	Enabled  bool            `json:"enabled"`
+	Source   *SubtitleSource `json:"source,omitempty"`
+	Language *string         `json:"language,omitempty"`
+}
+
+// IntroData describes an intro segment.
+type IntroData struct {
+	From     uint64  `json:"from"`
+	To       uint64  `json:"to"`
+	Duration *uint64 `json:"duration,omitempty"`
+}
+
+// IntroOutro describes the intro and outro of the current video.
+type IntroOutro struct {
+	Intro *IntroData `json:"intro"`
+	Outro *uint64    `json:"outro"`
+}
+
+// AnalyticsContext carries the analytics metadata of the current playback.
+type AnalyticsContext struct {
+	ID                *string `json:"libItemID"`
+	Type              *string `json:"libItemType"`
+	Name              *string `json:"libItemName"`
+	VideoID           *string `json:"libItemVideoID"`
+	Time              *uint64 `json:"libItemTimeOffset"`
+	Duration          *uint64 `json:"libItemTimeDuration"`
+	DeviceType        *string `json:"deviceType"`
+	DeviceName        *string `json:"deviceName"`
+	PlayerDuration    *uint64 `json:"playerDuration"`
+	PlayerVideoWidth  uint64  `json:"playerVideoWidth"`
+	PlayerVideoHeight uint64  `json:"playerVideoHeight"`
+	HasTrakt          bool    `json:"hasTrakt"`
+}
+
+// SeekLog is a single seek record submitted to the API.
+type SeekLog struct {
+	From uint64 `json:"from"`
+	To   uint64 `json:"to"`
+}
+
+// SeekLogRequest submits the collected seek history for a played stream.
+type SeekLogRequest struct {
+	OSHash         string `json:"osId"`
+	ItemID         string `json:"itemId"`
+	SeriesInfo     `json:",inline"`
+	StreamNameHash string    `json:"stHash"`
+	Duration       uint64    `json:"duration"`
+	SeekHistory    []SeekLog `json:"seekHistory"`
+	SkipOutro      []uint64  `json:"skipOutro"`
+}
+
+// SkipGapsRequest retrieves the intro/outro gaps for a played stream.
+type SkipGapsRequest struct {
+	AuthKey        AuthKey `json:"authKey"`
+	OSHash         string  `json:"osId"`
+	ItemID         string  `json:"itemId"`
+	SeriesInfo     `json:",inline"`
+	StreamNameHash string `json:"stHash"`
+}
+
+// Equal reports whether two skip-gaps requests are structurally equal.
+func (r SkipGapsRequest) Equal(other SkipGapsRequest) bool { return reflect.DeepEqual(r, other) }
+
+// SkipGapsResponse is the response of a get-skip-gaps request.
+type SkipGapsResponse struct {
+	Accuracy string              `json:"accuracy"`
+	Gaps     map[string]SkipGaps `json:"gaps"`
+}
+
+// SkipGaps holds the skip history and outro of a single duration match.
+type SkipGaps struct {
+	SeekHistory []SeekEvent `json:"seekHistory"`
+	Outro       *uint64     `json:"outro"`
+}
+
+// SeekEvent is a single aggregated seek event.
+type SeekEvent struct {
+	Records uint64 `json:"records"`
+	From    uint64 `json:"seekFrom"`
+	To      uint64 `json:"seekTo"`
+}
diff --git a/types/query_params_encode.go b/types/query_params_encode.go
new file mode 100644
index 0000000..b1bbf4c
--- /dev/null
+++ b/types/query_params_encode.go
@@ -0,0 +1,60 @@
+// Package types contains shared wire-level helpers and data types used by the
+// migrated engine.
+package types
+
+import (
+	"fmt"
+	"strings"
+)
+
+// percentEncodeSet mirrors constants.URIComponentEncodeSet: a byte is encoded
+// unless its entry is true. Kept in sync with the root package table.
+var percentEncodeSet = func() [128]bool {
+	var set [128]bool
+	for c := 0; c < 128; c++ {
+		isAlphaNum := (c >= 'a' && c <= 'z') ||
+			(c >= 'A' && c <= 'Z') ||
+			(c >= '0' && c <= '9')
+		set[c] = !isAlphaNum
+	}
+	for _, c := range []byte{'-', '_', '.', '!', '~', '*', '\'', '(', ')'} {
+		set[c] = false
+	}
+	return set
+}()
+
+const upperhex = "0123456789ABCDEF"
+
+// PercentEncode percent-encodes s using the URI component encode set, matching
+// percent_encoding::utf8_percent_encode with the engine's AsciiSet.
+func PercentEncode(s string) string {
+	var b strings.Builder
+	b.Grow(len(s))
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c < 128 && percentEncodeSet[c] {
+			b.WriteByte('%')
+			b.WriteByte(upperhex[c>>4])
+			b.WriteByte(upperhex[c&0xf])
+		} else {
+			b.WriteByte(c)
+		}
+	}
+	return b.String()
+}
+
+// QueryPair is a single key/value query parameter.
+type QueryPair struct {
+	Key   string
+	Value string
+}
+
+// QueryParamsEncode encodes query parameters as `key=value` pairs joined by `&`,
+// percent-encoding both key and value with the URI component encode set.
+func QueryParamsEncode(params []QueryPair) string {
+	parts := make([]string, 0, len(params))
+	for _, p := range params {
+		parts = append(parts, fmt.Sprintf("%s=%s", PercentEncode(p.Key), PercentEncode(p.Value)))
+	}
+	return strings.Join(parts, "&")
+}
