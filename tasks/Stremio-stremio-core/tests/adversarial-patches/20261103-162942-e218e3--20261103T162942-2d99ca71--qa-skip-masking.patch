@@ -0,0 +1,41 @@
+package ctx
+
+import (
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateNotifications(c *Ctx, m *msg.Msg) runtime.Effects {
+	switch {
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalLogout:
+		c.Notifications = types.NewNotificationsBucket(c.Env.Now(), nil, nil)
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalNotificationsChanged, nil)))
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalDismissNotificationItem:
+		id, _ := m.Internal.Data.(string)
+		for metaID := range c.Notifications.Items {
+			if metaID == id {
+				delete(c.Notifications.Items, metaID)
+			}
+		}
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalNotificationsChanged, nil)))
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalNotificationsChanged:
+		return setStorageEffect(c.Env, core.NOTIFICATIONS_STORAGE_KEY, c.Notifications, msg.EventNotificationsPushedToStorage).Unchanged()
+
+	case m.Kind == msg.KindAction && m.Action != nil && m.Action.InnerActionName() == msg.ActionCtxPullNotifications:
+		return runtime.None().Unchanged()
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalCtxAuthResult:
+		result, ok := m.Internal.Data.(CtxAuthResponse)
+		if !ok {
+			return runtime.None().Unchanged()
+		}
+		uid := string(result.Auth.User.ID)
+		c.Notifications = types.NewNotificationsBucket(c.Env.Now(), &uid, nil)
+		return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalNotificationsChanged, nil)))
+	}
+	return runtime.None().Unchanged()
+}
diff --git a/models/ctx/update_profile.go b/models/ctx/update_profile.go
new file mode 100644
index 0000000..923281a
--- /dev/null
+++ b/models/ctx/update_profile.go
@@ -0,0 +1,136 @@
+package ctx
+
+import (
+	"encoding/json"
+
+	core "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateProfile(c *Ctx, m *msg.Msg) runtime.Effects {
+	switch {
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalLogout:
+		next := types.NewProfile()
+		if !profileEqual(c.Profile, next) {
+			c.Profile = next
+			return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalProfileChanged, nil)))
+		}
+		return runtime.None().Unchanged()
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalProfileChanged:
+		return setStorageEffect(c.Env, core.PROFILE_STORAGE_KEY, c.Profile, msg.EventProfilePushedToStorage)
+
+	case m.Kind == msg.KindInternal && m.Internal.Name == msg.InternalCtxAuthResult:
+		result, ok := m.Internal.Data.(CtxAuthResponse)
+		if !ok {
+			return runtime.None().Unchanged()
+		}
+		next := types.Profile{
+			Auth:         &result.Auth,
+			Addons:       result.Addons,
+			AddonsLocked: result.AddonsErr,
+			Settings:     types.NewSettings(),
+		}
+		if result.Addons == nil {
+			next.Addons = types.OfficialAddons()
+		}
+		if !profileEqual(c.Profile, next) {
+			c.Profile = next
+			return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalProfileChanged, nil)))
+		}
+		return runtime.None().Unchanged()
+	}
+
+	if m.Kind != msg.KindAction || m.Action == nil || m.Action.InnerActionName() == "" {
+		return runtime.None().Unchanged()
+	}
+
+	switch m.Action.InnerActionName() {
+	case msg.ActionCtxUpdateSettings:
+		var settings types.Settings
+		if err := m.Action.DecodeInnerArgs(&settings); err != nil {
+			return runtime.None().Unchanged()
+		}
+		if c.Profile.Settings != settings {
+			c.Profile.Settings = settings
+			return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalProfileChanged, nil)))
+		}
+		return runtime.None().Unchanged()
+
+	case msg.ActionCtxInstallAddon, msg.ActionCtxUninstallAddon, msg.ActionCtxUpgradeAddon:
+		return addonAction(c, m)
+
+	case msg.ActionCtxLogoutTrakt:
+		if c.Profile.Auth != nil && c.Profile.Auth.User.Trakt != nil {
+			c.Profile.Auth.User.Trakt = nil
+			return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalProfileChanged, nil)))
+		}
+		return runtime.None().Unchanged()
+
+	case msg.ActionCtxPushUserToAPI, msg.ActionCtxPullUserFromAPI, msg.ActionCtxPushAddonsToAPI,
+		msg.ActionCtxPullAddonsFromAPI, msg.ActionCtxDeleteAccount, msg.ActionCtxSyncLibraryWithAPI,
+		msg.ActionCtxPullNotifications:
+		return runtime.None().Unchanged()
+	}
+	return runtime.None().Unchanged()
+}
+
+func addonAction(c *Ctx, m *msg.Msg) runtime.Effects {
+	var addon types.Descriptor
+	if err := m.Action.DecodeInnerArgs(&addon); err != nil {
+		return runtime.None().Unchanged()
+	}
+	switch m.Action.InnerActionName() {
+	case msg.ActionCtxInstallAddon:
+		if c.Profile.AddonsLocked {
+			return runtime.MsgEffectSet(errorEvent(msg.EventAddonInstalled)).Unchanged()
+		}
+		if findAddon(c.Profile.Addons, addon) >= 0 {
+			return runtime.None().Unchanged()
+		}
+		c.Profile.Addons = append(c.Profile.Addons, addon)
+	case msg.ActionCtxUninstallAddon:
+		idx := findAddon(c.Profile.Addons, addon)
+		if idx < 0 || c.Profile.Addons[idx].Flags.Protected {
+			return runtime.None().Unchanged()
+		}
+		c.Profile.Addons = append(c.Profile.Addons[:idx], c.Profile.Addons[idx+1:]...)
+		// drop streams belonging to the uninstalled addon
+		for key, item := range c.Streams.Items {
+			if item.StreamTransportURL == addon.TransportURL {
+				delete(c.Streams.Items, key)
+			}
+		}
+	case msg.ActionCtxUpgradeAddon:
+		idx := findAddon(c.Profile.Addons, addon)
+		if idx < 0 || c.Profile.Addons[idx].Flags.Protected {
+			return runtime.None().Unchanged()
+		}
+		c.Profile.Addons[idx] = addon
+	}
+	return runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalProfileChanged, nil)))
+}
+
+func findAddon(addons []types.Descriptor, addon types.Descriptor) int {
+	for i := range addons {
+		if addons[i].TransportURL == addon.TransportURL {
+			return i
+		}
+	}
+	return -1
+}
+
+func errorEvent(source string) *msg.Msg {
+	return msg.EventMsg(msg.NewEvent(msg.EventError, map[string]any{
+		"error":  map[string]any{"type": "Other", "message": "addon action failed"},
+		"source": source,
+	}))
+}
+
+func profileEqual(a, b types.Profile) bool {
+	ab, _ := json.Marshal(a)
+	bb, _ := json.Marshal(b)
+	return string(ab) == string(bb)
+}
