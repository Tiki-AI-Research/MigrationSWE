diff --git a/types/persistence_test.go b/types/persistence_test.go
new file mode 100644
index 0000000..02e06e1
--- /dev/null
+++ b/types/persistence_test.go
@@ -0,0 +1,76 @@
+package types_test
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+func assertJSONRoundTrip(t *testing.T, value any, out any) {
+	t.Helper()
+	first, err := json.Marshal(value)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	if err := json.Unmarshal(first, out); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	second, err := json.Marshal(out)
+	if err != nil {
+		t.Fatalf("re-marshal: %v", err)
+	}
+	if string(first) != string(second) {
+		t.Fatalf("round-trip mismatch\n got %s\nwant %s", second, first)
+	}
+}
+
+func TestProfileRoundTrip(t *testing.T) {
+	uid := "user"
+	profile := types.Profile{
+		Auth:     &types.Auth{Key: types.AuthKey("key"), User: types.User{ID: types.UserId(uid), Email: "e@example.com"}},
+		Settings: types.NewSettings(),
+		Addons:   types.OfficialAddons(),
+	}
+	var out types.Profile
+	assertJSONRoundTrip(t, profile, &out)
+	if len(out.Addons) == 0 {
+		t.Fatalf("expected embedded official addons")
+	}
+}
+
+func TestLibraryRoundTrip(t *testing.T) {
+	now := time.Unix(1000, 0).UTC()
+	item := types.LibraryItem{ID: "tt1", Name: "n", Type: "movie", Mtime: now, State: types.LibraryItemState{TimeOffset: 5}}
+	bucket := types.NewLibraryBucket(nil, []types.LibraryItem{item})
+	var out types.LibraryBucket
+	assertJSONRoundTrip(t, bucket, &out)
+}
+
+func TestStreamsBucketRoundTrip(t *testing.T) {
+	now := time.Unix(1000, 0).UTC()
+	bucket := types.NewStreamsBucket(nil)
+	bucket.Items[types.StreamsItemKey{MetaID: "tt1", VideoID: "v1"}] = types.StreamsItem{
+		Stream: types.Stream{Source: types.StreamSource{Kind: types.StreamSourceURL, URL: "http://x"}},
+		MetaID: "tt1", VideoID: "v1", Mtime: now,
+	}
+	var out types.StreamsBucket
+	assertJSONRoundTrip(t, bucket, &out)
+}
+
+func TestSearchHistoryRoundTrip(t *testing.T) {
+	now := time.Unix(1000, 0).UTC()
+	bucket := types.NewSearchHistoryBucket(nil)
+	bucket.Items["query"] = now
+	var out types.SearchHistoryBucket
+	assertJSONRoundTrip(t, bucket, &out)
+}
+
+func TestNotificationsRoundTrip(t *testing.T) {
+	now := time.Unix(1000, 0).UTC()
+	item := types.NotificationItem{MetaID: "tt1", VideoID: "v1", VideoReleased: now}
+	bucket := types.NewNotificationsBucket(now, nil, []types.NotificationItem{item})
+	var out types.NotificationsBucket
+	assertJSONRoundTrip(t, bucket, &out)
+}
