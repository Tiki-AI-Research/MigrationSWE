@@ -0,0 +1,112 @@
+// Package stremiocore is the Go port of the stremio-core Rust engine.
+//
+// It exposes the shared constants of the engine. The protected storage keys,
+// the schema version and the URI component encode set must not change because
+// they are part of the persisted/on-the-wire contract.
+package stremiocore
+
+// SCHEMA_VERSION_STORAGE_KEY is the storage key holding the schema version.
+const SCHEMA_VERSION_STORAGE_KEY = "schema_version"
+
+// Protected storage keys.
+const (
+	PROFILE_STORAGE_KEY               = "profile"
+	LIBRARY_STORAGE_KEY               = "library"
+	LIBRARY_RECENT_STORAGE_KEY        = "library_recent"
+	STREAMS_STORAGE_KEY               = "streams"
+	SEARCH_HISTORY_STORAGE_KEY        = "search_history"
+	STREAMING_SERVER_URLS_STORAGE_KEY = "streaming_server_urls"
+	NOTIFICATIONS_STORAGE_KEY         = "notifications"
+	CALENDAR_STORAGE_KEY              = "calendar"
+	DISMISSED_EVENTS_STORAGE_KEY      = "dismissed_events"
+)
+
+const (
+	LIBRARY_COLLECTION_NAME = "libraryItem"
+	SEARCH_EXTRA_NAME       = "search"
+	META_RESOURCE_NAME      = "meta"
+	STREAM_RESOURCE_NAME    = "stream"
+	CATALOG_RESOURCE_NAME   = "catalog"
+	SUBTITLES_RESOURCE_NAME = "subtitles"
+)
+
+const (
+	ADDON_MANIFEST_PATH = "/manifest.json"
+	ADDON_LEGACY_PATH   = "/stremio/v1"
+)
+
+const (
+	CATALOG_PAGE_SIZE        = 100
+	CATALOG_PREVIEW_SIZE     = 100
+	LIBRARY_RECENT_COUNT     = 200
+	NOTIFICATION_ITEMS_COUNT = 100
+	CALENDAR_ITEMS_COUNT     = 100
+)
+
+// WATCHED_THRESHOLD_COEF is the coefficient above which an item is considered watched.
+const WATCHED_THRESHOLD_COEF = 0.7
+
+// CREDITS_THRESHOLD_COEF is the coefficient for credits.
+const CREDITS_THRESHOLD_COEF = 0.9
+
+// SCHEMA_VERSION is the latest migration schema version.
+const SCHEMA_VERSION uint32 = 25
+
+const (
+	IMDB_LINK_CATEGORY       = "imdb"
+	GENRES_LINK_CATEGORY     = "Genres"
+	CINEMETA_TOP_CATALOG_ID  = "top"
+	CINEMETA_FEED_CATALOG_ID = "feed.json"
+	IMDB_TITLE_PATH          = "title"
+	YOUTUBE_ADDON_ID_PREFIX  = "yt_id:"
+)
+
+// URIComponentEncodeSet is the set of ASCII bytes that must NOT be percent
+// encoded. It mirrors percent_encoding's NON_ALPHANUMERIC minus
+// `-_.!~*'()`.
+//
+// The value is a 128-entry table; true means "safe, do not encode".
+var URIComponentEncodeSet = func() [128]bool {
+	var set [128]bool
+	// NON_ALPHANUMERIC keeps everything that is not [A-Za-z0-9].
+	for c := 0; c < 128; c++ {
+		isAlphaNum := (c >= 'a' && c <= 'z') ||
+			(c >= 'A' && c <= 'Z') ||
+			(c >= '0' && c <= '9')
+		set[c] = !isAlphaNum
+	}
+	for _, c := range []byte{'-', '_', '.', '!', '~', '*', '\'', '(', ')'} {
+		set[c] = false
+	}
+	return set
+}()
+
+// USER_LIKES_SUPPORTED_ID_PREFIXES is the list of supported id prefixes.
+var USER_LIKES_SUPPORTED_ID_PREFIXES = []string{"tt", "tmdb", "kitsu"}
+
+// USER_LIKES_SUPPORTED_TYPES is the list of supported types.
+var USER_LIKES_SUPPORTED_TYPES = []string{"movie", "series"}
+
+// PLAYER_IGNORE_SEEK_AFTER is in milliseconds.
+const PLAYER_IGNORE_SEEK_AFTER uint64 = 600_000
+
+// Static engine URLs.
+const (
+	CINEMETA_CATALOGS_URL = "https://cinemeta-catalogs.strem.io"
+	CINEMETA_URL          = "https://v3-cinemeta.strem.io/manifest.json"
+	USER_LIKES_API_URL    = "https://likes.stremio.com"
+	API_URL               = "https://api.strem.io"
+	LINK_API_URL          = "https://link.stremio.com"
+	STREAMING_SERVER_URL  = "http://127.0.0.1:11470"
+	IMDB_URL              = "https://imdb.com"
+)
+
+// TYPE_PRIORITIES ranks catalog types.
+var TYPE_PRIORITIES = map[string]int{
+	"all":     5,
+	"movie":   4,
+	"series":  3,
+	"channel": 2,
+	"tv":      1,
+	"other":   -1 << 31,
+}
