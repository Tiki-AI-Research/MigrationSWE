@@ -0,0 +1,26 @@
+package types
+
+import (
+	_ "embed"
+	"encoding/json"
+	"sync"
+)
+
+//go:embed official_addons.json
+var officialAddonsJSON []byte
+
+var (
+	officialAddonsOnce sync.Once
+	officialAddons     []Descriptor
+)
+
+// OfficialAddons returns the descriptors of the official addons, mirroring the
+// Rust `OFFICIAL_ADDONS` constant. The result is cached after the first call.
+func OfficialAddons() []Descriptor {
+	officialAddonsOnce.Do(func() {
+		if err := json.Unmarshal(officialAddonsJSON, &officialAddons); err != nil {
+			panic("OFFICIAL_ADDONS parse failed: " + err.Error())
+		}
+	})
+	return officialAddons
+}
