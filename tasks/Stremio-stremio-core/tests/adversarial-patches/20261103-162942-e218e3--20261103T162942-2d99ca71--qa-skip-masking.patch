+++ b/runtime/runtime_test.go
@@ -0,0 +1,128 @@
+package runtime_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+)
+
+type fakeModel struct {
+	effects  []runtime.Effect
+	fields   []string
+	updates  int
+	lastKind msg.Kind
+}
+
+func (m *fakeModel) Update(message *msg.Msg) ([]runtime.Effect, []string) {
+	m.updates++
+	m.lastKind = message.Kind
+	return m.effects, m.fields
+}
+
+func (m *fakeModel) UpdateField(message *msg.Msg, field string) ([]runtime.Effect, []string) {
+	m.updates++
+	m.lastKind = message.Kind
+	return m.effects, m.fields
+}
+
+func TestRuntimeNewStateOnlyOnChange(t *testing.T) {
+	model := &fakeModel{}
+	rt, rx := runtime.New(model, nil, 4, nil)
+
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameUnload, nil)})
+	if len(rx) != 0 {
+		t.Fatalf("expected no events, got %d", len(rx))
+	}
+
+	model.fields = []string{"player"}
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameUnload, nil)})
+	ev := <-rx
+	if ev.Name != "NewState" {
+		t.Fatalf("event name = %s, want NewState", ev.Name)
+	}
+	var fields []string
+	if err := json.Unmarshal(ev.Args, &fields); err != nil {
+		t.Fatalf("unmarshal fields: %v", err)
+	}
+	if len(fields) != 1 || fields[0] != "player" {
+		t.Fatalf("fields = %v", fields)
+	}
+}
+
+func TestRuntimeFieldRouting(t *testing.T) {
+	model := &fakeModel{}
+	rt, _ := runtime.New(model, nil, 4, nil)
+	field := "player"
+	rt.Dispatch(runtime.RuntimeAction{Field: &field, Action: msg.NewAction(msg.ActionNameUnload, nil)})
+	if model.updates != 1 {
+		t.Fatalf("updates = %d", model.updates)
+	}
+
+	model2 := &fakeModel{}
+	rt2, _ := runtime.New(model2, nil, 4, nil)
+	rt2.Dispatch(runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameUnload, nil)})
+	if model2.updates != 1 {
+		t.Fatalf("updates = %d", model2.updates)
+	}
+}
+
+func TestRuntimeEventMessageEmitsCoreEventOnly(t *testing.T) {
+	model := &fakeModel{
+		effects: []runtime.Effect{runtime.MsgEffect(msg.EventMsg(msg.NewEvent("UserLoggedOut", nil)))},
+	}
+	rt, rx := runtime.New(model, nil, 4, nil)
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameUnload, nil)})
+	ev := <-rx
+	if ev.Name != "CoreEvent" {
+		t.Fatalf("event name = %s, want CoreEvent", ev.Name)
+	}
+	if len(rx) != 0 {
+		t.Fatalf("unexpected extra events")
+	}
+}
+
+func TestRuntimeInternalRecurses(t *testing.T) {
+	model := &fakeModel{}
+	rt, rx := runtime.New(model, nil, 4, nil)
+	internal := msg.InternalMsg(msg.NewInternal(msg.InternalProfileChanged, nil))
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameUnload, nil)})
+	_ = rx
+	// feed the internal message through a second runtime to observe recursion
+	model2 := &fakeModel{}
+	rt2, rx2 := runtime.New(model2, []runtime.Effect{runtime.MsgEffect(internal)}, 4, nil)
+	_ = rt2
+	if model2.updates != 1 {
+		t.Fatalf("internal message should update the model once, got %d", model2.updates)
+	}
+	if len(rx2) != 0 {
+		t.Fatalf("expected no events for unchanged internal update")
+	}
+}
+
+func TestRuntimeActionEffectPanics(t *testing.T) {
+	model := &fakeModel{
+		effects: []runtime.Effect{runtime.MsgEffect(msg.ActionMsg(msg.UnloadAction()))},
+	}
+	defer func() {
+		if recover() == nil {
+			t.Fatalf("expected panic when an effect resolves with an action")
+		}
+	}()
+	rt, _ := runtime.New(model, nil, 4, nil)
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameUnload, nil)})
+}
+
+func TestRuntimeEventMarshal(t *testing.T) {
+	ev := runtime.NewStateEvent([]string{"ctx", "player"})
+	b, _ := json.Marshal(ev)
+	if string(b) != `{"name":"NewState","args":["ctx","player"]}` {
+		t.Fatalf("marshal = %s", b)
+	}
+	ce := runtime.CoreEvent(msg.NewEvent("UserLoggedOut", nil))
+	b, _ = json.Marshal(ce)
+	if string(b) != `{"name":"CoreEvent","args":{"event":"UserLoggedOut"}}` {
+		t.Fatalf("marshal = %s", b)
+	}
+}
