+func (p *Player) subtitlesUpdate(c *ctx.Ctx) runtime.Effects {
+	if p.Selected == nil || p.Selected.SubtitlesPath == nil || p.Stream == nil || !p.Stream.IsReady() {
+		return common.EqUpdate(&p.Subtitles, []common.ResourceLoadable[[]types.Subtitles]{})
+	}
+	converted := p.Stream.Ready
+
+	var videoHash *string
+	var videoSize *uint64
+	var videoFilename *string
+	if converted.BehaviorHints.VideoHash != nil {
+		videoHash = converted.BehaviorHints.VideoHash
+	}
+	if converted.BehaviorHints.VideoSize != nil {
+		videoSize = converted.BehaviorHints.VideoSize
+	}
+	if converted.BehaviorHints.Filename != nil {
+		videoFilename = converted.BehaviorHints.Filename
+	}
+	if p.VideoParams != nil {
+		if videoHash == nil {
+			videoHash = p.VideoParams.Hash
+		}
+		if videoSize == nil {
+			videoSize = p.VideoParams.Size
+		}
+		if videoFilename == nil {
+			videoFilename = p.VideoParams.Filename
+		}
+	}
+	if videoHash == nil && videoSize == nil && videoFilename == nil && p.VideoParams == nil {
+		return runtime.None().Unchanged()
+	}
+
+	path := *p.Selected.SubtitlesPath
+	path.Extra = types.ExtendOne(path.Extra, "videoHash", videoHash)
+	if videoSize != nil {
+		size := strconv.FormatUint(*videoSize, 10)
+		path.Extra = types.ExtendOne(path.Extra, "videoSize", &size)
+	} else {
+		path.Extra = types.ExtendOne(path.Extra, "videoSize", nil)
+	}
+	path.Extra = types.ExtendOne(path.Extra, "filename", videoFilename)
+
+	requests := planResourceRequests(path, c.Profile.Addons)
+
+	next := make([]common.ResourceLoadable[[]types.Subtitles], 0, len(requests))
+	var effects runtime.Effects = runtime.None().Unchanged()
+	for _, request := range requests {
+		cached := false
+		for i := range p.Subtitles {
+			if p.Subtitles[i].Request.Equal(request) && p.Subtitles[i].Content != nil {
+				next = append(next, p.Subtitles[i])
+				cached = true
+				break
+			}
+		}
+		if cached {
+			continue
+		}
+		req := request
+		item := common.ResourceLoadable[[]types.Subtitles]{Request: req}
+		effects = effects.Join(common.ResourceUpdateWithVectorContent(p.Env, &item, common.ResourceRequested(&req), convertSubtitles).Unchanged())
+		next = append(next, item)
+	}
+	effects = effects.Join(common.EqUpdate(&p.Subtitles, next))
+	return effects
+}
