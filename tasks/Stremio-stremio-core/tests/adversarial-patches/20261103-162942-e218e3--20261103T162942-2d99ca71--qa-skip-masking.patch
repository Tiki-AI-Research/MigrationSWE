+// Package testenv provides a deterministic Env implementation for tests.
+package testenv
+
+import (
+	"encoding/json"
+	"time"
+
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Env is a synchronous test environment.
+type Env struct {
+	Storage   map[string]json.RawMessage
+	FetchFn   func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError)
+	Transport runtime.AddonTransport
+}
+
+// New builds a test env.
+func New() *Env {
+	return &Env{Storage: map[string]json.RawMessage{}}
+}
+
+// Fetch implements runtime.Env.
+func (e *Env) Fetch(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+	if e.FetchFn != nil {
+		return e.FetchFn(method, url, headers, body)
+	}
+	return []byte("{}"), nil
+}
+
+// GetStorage implements runtime.Env.
+func (e *Env) GetStorage(key string) (json.RawMessage, bool, *runtime.EnvError) {
+	v, ok := e.Storage[key]
+	return v, ok, nil
+}
+
+// SetStorage implements runtime.Env. A nil value deletes the key, matching the
+// Rust `set_storage(key, None)` semantics.
+func (e *Env) SetStorage(key string, value any) *runtime.EnvError {
+	if value == nil {
+		delete(e.Storage, key)
+		return nil
+	}
+	b, err := json.Marshal(value)
+	if err != nil {
+		return runtime.EnvErrorSerde(err.Error())
+	}
+	e.Storage[key] = b
+	return nil
+}
+
+// ExecConcurrent implements runtime.Env.
+func (e *Env) ExecConcurrent(f func()) { f() }
+
+// ExecSequential implements runtime.Env.
+func (e *Env) ExecSequential(f func()) { f() }
+
+// Now implements runtime.Env.
+func (e *Env) Now() time.Time { return time.Unix(0, 0).UTC() }
+
+// LocalNow implements runtime.Env.
+func (e *Env) LocalNow() time.Time { return e.Now() }
+
+// FlushAnalytics implements runtime.Env.
+func (e *Env) FlushAnalytics() {}
+
+// AnalyticsContext implements runtime.Env.
+func (e *Env) AnalyticsContext(ctx any, streamingServer any, path string) any { return nil }
+
+// Log implements runtime.Env.
+func (e *Env) Log(message string) {}
+
+// AddonTransport implements runtime.Env.
+func (e *Env) AddonTransport(transportURL string) runtime.AddonTransport {
+	if e.Transport != nil {
+		return e.Transport
+	}
+	return staticTransport{}
+}
+
+// MigrateStorageSchema implements runtime.Env.
+func (e *Env) MigrateStorageSchema() *runtime.EnvError {
+	return runtime.MigrateStorageSchema(e)
+}
+
+type staticTransport struct{}
+
+func (staticTransport) Resource(path types.ResourcePath) (types.ResourceResponse, *runtime.EnvError) {
+	return types.ResourceResponse{Raw: []byte("{}")}, nil
+}
+
+func (staticTransport) Manifest() (types.Manifest, *runtime.EnvError) {
+	return types.Manifest{}, nil
+}
+
+var _ runtime.Env = (*Env)(nil)
