+func (p *Player) onPausedChanged(a *msg.Action) runtime.Effects {
+	if p.Selected == nil {
+		return runtime.None().Unchanged()
+	}
+	var args struct {
+		Paused bool `json:"paused"`
+	}
+	if err := a.DecodeInnerArgs(&args); err != nil {
+		return runtime.Default()
+	}
+	paused := args.Paused
+	p.Paused = &paused
+
+	var eventEffects runtime.Effects
+	if !p.Loaded {
+		p.Loaded = true
+		loadTime := int64(-1)
+		if p.LoadTime != nil {
+			loadTime = p.Env.Now().UnixMilli() - p.LoadTime.UnixMilli()
+		}
+		eventEffects = runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventPlayerPlaying, map[string]any{
+			"load_time": loadTime,
+			"context":   p.analyticsContextOrDefault(),
+		}))).Unchanged()
+	} else if paused {
+		eventEffects = runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventTraktPaused,
+			map[string]any{"context": p.analyticsContextOrDefault()}))).Unchanged()
+	} else {
+		eventEffects = runtime.MsgEffectSet(msg.EventMsg(msg.NewEvent(msg.EventTraktPlaying,
+			map[string]any{"context": p.analyticsContextOrDefault()}))).Unchanged()
+	}
+
+	var updateLibraryEffects runtime.Effects = runtime.None().Unchanged()
+	if p.LibraryItem != nil {
+		updateLibraryEffects = runtime.MsgEffectSet(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, *p.LibraryItem))).Unchanged()
+	}
+	return eventEffects.Join(updateLibraryEffects)
+}
