@@ -0,0 +1,58 @@
+package addontransport
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestLegacyManifestMapsMethodsToResources(t *testing.T) {
+	raw := json.RawMessage(`{
+		"manifest": {
+			"id": "org.test.legacy",
+			"name": "Test Legacy Addon",
+			"version": "1.0.0",
+			"methods": ["meta.get", "stream.find", "subtitles.find"],
+			"types": ["series"]
+		}
+	}`)
+	manifest, err := LegacyManifestToManifest(raw)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	names := map[string]bool{}
+	for _, r := range manifest.Resources {
+		names[r.Name] = true
+	}
+	for _, want := range []string{"meta", "stream", "subtitles"} {
+		if !names[want] {
+			t.Errorf("resource %q missing from %v", want, names)
+		}
+	}
+	if manifest.ID != "org.test.legacy" {
+		t.Errorf("id = %q", manifest.ID)
+	}
+}
+
+func TestLegacyManifestCatalogs(t *testing.T) {
+	raw := json.RawMessage(`{
+		"manifest": {
+			"id": "org.test.legacy",
+			"name": "Test",
+			"version": "1.0.0",
+			"methods": ["meta.find"],
+			"types": ["movie", "series"]
+		}
+	}`)
+	manifest, err := LegacyManifestToManifest(raw)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(manifest.Catalogs) != 2 {
+		t.Fatalf("catalogs = %v", manifest.Catalogs)
+	}
+	for _, c := range manifest.Catalogs {
+		if c.ID != "top" {
+			t.Errorf("catalog id = %q, want top", c.ID)
+		}
+	}
+}
