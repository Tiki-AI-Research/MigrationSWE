index 0000000..41d97f3
--- /dev/null
+++ b/analytics/analytics.go
@@ -0,0 +1,121 @@
+// Package analytics implements the engine analytics emit/batch/flush surface.
+package analytics
+
+import (
+	"sync"
+	"time"
+
+	"github.com/stremio/stremio-core/runtime"
+)
+
+// Event is a single analytics event.
+type Event struct {
+	Data   map[string]any `json:"-"`
+	Name   string         `json:"eventName"`
+	Time   int64          `json:"eventTime"`
+	Number uint64         `json:"eventNumber"`
+	App    any            `json:"app"`
+}
+
+// Batch is a batch of events sharing an auth key.
+type Batch struct {
+	AuthKey string
+	Events  []Event
+}
+
+type state struct {
+	number  uint64
+	queue   []Batch
+	pending *Batch
+}
+
+// Analytics buffers analytics events and sends them in batches.
+type Analytics struct {
+	mu     sync.Mutex
+	state  *state
+	env    runtime.Env
+	sendFn func(Batch) error
+}
+
+// New builds an Analytics instance.
+func New(env runtime.Env, sendFn func(Batch) error) *Analytics {
+	return &Analytics{state: &state{}, env: env, sendFn: sendFn}
+}
+
+func (s *state) nextNumber() uint64 {
+	s.number++
+	return s.number
+}
+
+// Emit records an analytics event. It is a no-op when authKey is empty.
+func (a *Analytics) Emit(name string, data map[string]any, authKey string, context any) {
+	if authKey == "" {
+		return
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	now := time.Now().UnixMilli()
+	if a.env != nil {
+		now = a.env.Now().UnixMilli()
+	}
+	event := Event{Data: data, Name: name, Number: a.state.nextNumber(), Time: now, App: context}
+	if n := len(a.state.queue); n > 0 && a.state.queue[n-1].AuthKey == authKey {
+		a.state.queue[n-1].Events = append(a.state.queue[n-1].Events, event)
+		return
+	}
+	a.state.queue = append(a.state.queue, Batch{AuthKey: authKey, Events: []Event{event}})
+}
+
+// SendNextBatch attempts to send the next pending batch.
+func (a *Analytics) SendNextBatch() {
+	a.mu.Lock()
+	if a.state.pending != nil {
+		a.mu.Unlock()
+		return
+	}
+	if len(a.state.queue) == 0 {
+		a.mu.Unlock()
+		return
+	}
+	batch := a.state.queue[0]
+	a.state.queue = a.state.queue[1:]
+	a.state.pending = &batch
+	a.mu.Unlock()
+
+	err := error(nil)
+	if a.sendFn != nil {
+		err = a.sendFn(batch)
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.state.pending != nil && a.state.pending.AuthKey == batch.AuthKey {
+		if err == nil {
+			a.state.pending = nil
+		} else {
+			reverted := *a.state.pending
+			a.state.pending = nil
+			a.state.queue = append([]Batch{reverted}, a.state.queue...)
+		}
+	}
+}
+
+// Flush drops the pending batch and sends all queued batches.
+func (a *Analytics) Flush() {
+	a.mu.Lock()
+	a.state.pending = nil
+	batches := a.state.queue
+	a.state.queue = nil
+	a.mu.Unlock()
+	if a.sendFn != nil {
+		for _, b := range batches {
+			_ = a.sendFn(b)
+		}
+	}
+}
+
+// QueueLen returns the number of queued batches; used for testing.
+func (a *Analytics) QueueLen() int {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return len(a.state.queue)
+}
