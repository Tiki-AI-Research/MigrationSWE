+}
+
+// StatisticsRequest requests the statistics of a torrent file.
+type StatisticsRequest struct {
+	InfoHash string `json:"infoHash"`
+	FileIdx  uint16 `json:"fileIdx"`
+}
+
+// Equal reports whether two statistics requests are equal.
+func (r StatisticsRequest) Equal(other StatisticsRequest) bool {
+	return r.InfoHash == other.InfoHash && r.FileIdx == other.FileIdx
+}
+
+// PeerSearch describes the peer search options of a torrent.
+type PeerSearch struct {
+	Max     uint64   `json:"max"`
+	Min     uint64   `json:"min"`
