+
+// BitField8 is a bitfield serialized as a zlib-compressed, base64-encoded byte
+// slice. It mirrors the `stremio-watched-bitfield` crate.
+type BitField8 struct {
+	Length int
+	Values []byte
+}
+
+// NewBitField8 builds a zeroed bitfield of the given bit length.
+func NewBitField8(length int) BitField8 {
+	bytesCount := (length + 7) / 8
+	return BitField8{Length: length, Values: make([]byte, bytesCount)}
+}
+
+// NewBitField8WithValues builds a bitfield from raw bytes and an optional bit
+// length. When length is nil the full byte length is used.
+func NewBitField8WithValues(values []byte, length *int) BitField8 {
+	l := len(values) * 8
+	if length != nil {
+		l = *length
+	}
+	bytesCount := (l + 7) / 8
+	if bytesCount > len(values) {
+		values = append(values, make([]byte, bytesCount-len(values))...)
+	}
+	return BitField8{Length: l, Values: values}
+}
+
+// Get returns the bit at index i.
+func (b BitField8) Get(i int) bool {
+	index := i / 8
+	bit := uint(i % 8)
+	if index < 0 || index >= len(b.Values) {
+		return false
+	}
+	return (b.Values[index]>>bit)&1 != 0
+}
+
+// Set assigns the bit at index i, growing the buffer when needed.
+func (b *BitField8) Set(i int, val bool) {
+	index := i / 8
+	mask := byte(1) << uint(i%8)
+	if index >= len(b.Values) {
+		b.Values = append(b.Values, make([]byte, index-len(b.Values)+1)...)
+		b.Length = len(b.Values) * 8
+	}
+	if val {
+		b.Values[index] |= mask
+	} else {
+		b.Values[index] &^= mask
+	}
+}
+
+// LastIndexOf returns the last index holding val, if any.
+func (b BitField8) LastIndexOf(val bool) (int, bool) {
+	for i := b.Length - 1; i >= 0; i-- {
+		if b.Get(i) == val {
+			return i, true
+		}
+	}
+	return 0, false
+}
+
+func (b BitField8) encode() (string, error) {
+	var buf bytes.Buffer
+	writer, err := zlib.NewWriterLevel(&buf, 6)
+	if err != nil {
+		return "", err
+	}
+	if _, err := writer.Write(b.Values); err != nil {
+		return "", err
+	}
+	if err := writer.Close(); err != nil {
+		return "", err
+	}
+	return base64.StdEncoding.EncodeToString(buf.Bytes()), nil
+}
+
+func decodeBitField8(encoded string, length *int) (BitField8, error) {
+	compressed, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return BitField8{}, err
+	}
+	reader, err := zlib.NewReader(bytes.NewReader(compressed))
+	if err != nil {
+		return BitField8{}, err
+	}
+	defer reader.Close()
+	values, err := io.ReadAll(reader)
+	if err != nil {
+		return BitField8{}, err
+	}
+	return NewBitField8WithValues(values, length), nil
+}
+
+// WatchedField is the serialized compatible form of a WatchedBitField:
+// `{anchor_video}:{anchor_length}:{bitfield}`.
+type WatchedField struct {
+	AnchorVideo  string
+	AnchorLength int
+	Bitfield     BitField8
+}
+
+// ParseWatchedField parses the `{anchor}:{length}:{bitfield}` string form.
+func ParseWatchedField(s string) (WatchedField, error) {
+	components := strings.Split(s, ":")
+	if len(components) < 3 {
+		return WatchedField{}, fmt.Errorf("watched field: not enough components")
+	}
+	bitfieldBuf := components[len(components)-1]
+	components = components[:len(components)-1]
+
+	anchorLength, err := strconv.Atoi(components[len(components)-1])
+	if err != nil {
+		return WatchedField{}, err
+	}
+	components = components[:len(components)-1]
+	anchorVideo := strings.Join(components, ":")
+
+	bitfield, err := decodeBitField8(bitfieldBuf, nil)
+	if err != nil {
+		return WatchedField{}, err
+	}
+	return WatchedField{AnchorVideo: anchorVideo, AnchorLength: anchorLength, Bitfield: bitfield}, nil
+}
+
+// String returns the `{anchor}:{length}:{bitfield}` form.
+func (w WatchedField) String() string {
+	packed, err := w.Bitfield.encode()
+	if err != nil {
+		packed = ""
+	}
+	return fmt.Sprintf("%s:%d:%s", w.AnchorVideo, w.AnchorLength, packed)
+}
+
+// MarshalJSON implements json.Marshaler.
+func (w WatchedField) MarshalJSON() ([]byte, error) { return json.Marshal(w.String()) }
+
+// UnmarshalJSON implements json.Unmarshaler.
+func (w *WatchedField) UnmarshalJSON(data []byte) error {
+	var s string
+	if err := json.Unmarshal(data, &s); err != nil {
+		return err
+	}
+	parsed, err := ParseWatchedField(s)
+	if err != nil {
+		return err
+	}
+	*w = parsed
+	return nil
+}
+
+// WatchedBitField tracks which videos have been watched and the latest one
+// watched.
+type WatchedBitField struct {
+	Bitfield BitField8
+	VideoIDs []string
+}
+
+// NewWatchedBitField builds a watched bitfield from a bitfield and video ids.
+func NewWatchedBitField(bitfield BitField8, videoIDs []string) WatchedBitField {
+	return WatchedBitField{Bitfield: bitfield, VideoIDs: videoIDs}
+}
+
+// WatchedBitFieldFromArray builds a watched bitfield from a bool array.
+func WatchedBitFieldFromArray(arr []bool, videoIDs []string) WatchedBitField {
+	bitfield := NewBitField8(len(videoIDs))
+	for i, val := range arr {
+		bitfield.Set(i, val)
+	}
+	return WatchedBitField{Bitfield: bitfield, VideoIDs: videoIDs}
+}
+
+// WatchedBitFieldConstructWithVideos reconstructs a bitfield, shifting it so the
+// anchor video aligns with the given video ids.
+func WatchedBitFieldConstructWithVideos(field WatchedField, videoIDs []string) WatchedBitField {
+	anchorIdx := -1
+	for i, id := range videoIDs {
+		if id == field.AnchorVideo {
+			anchorIdx = i
+			break
+		}
+	}
+	if anchorIdx < 0 {
+		return WatchedBitField{Bitfield: NewBitField8(len(videoIDs)), VideoIDs: videoIDs}
+	}
+
+	offset := field.AnchorLength - anchorIdx - 1
+	length := len(videoIDs)
+	bitfield := NewBitField8WithValues(append([]byte(nil), field.Bitfield.Values...), &length)
+
+	if offset == 0 {
+		return WatchedBitField{Bitfield: bitfield, VideoIDs: videoIDs}
+	}
+
+	resized := WatchedBitField{Bitfield: NewBitField8(len(videoIDs)), VideoIDs: videoIDs}
+	for i := 0; i < len(videoIDs); i++ {
+		idInPrev := i + offset
+		if idInPrev >= 0 && idInPrev < bitfield.Length {
+			resized.Bitfield.Set(i, bitfield.Get(idInPrev))
+		}
+	}
+	return resized
+}
+
+// WatchedBitFieldConstructAndResize parses a serialized watched field and
+// reconstructs the bitfield against the given video ids.
+func WatchedBitFieldConstructAndResize(serialized string, videoIDs []string) (WatchedBitField, error) {
+	field, err := ParseWatchedField(serialized)
+	if err != nil {
+		return WatchedBitField{}, err
+	}
+	return WatchedBitFieldConstructWithVideos(field, videoIDs), nil
+}
+
+// Get returns the bit at index i.
+func (w WatchedBitField) Get(i int) bool { return w.Bitfield.Get(i) }
+
+// GetVideo reports whether the given video is watched.
+func (w WatchedBitField) GetVideo(videoID string) bool {
+	for i, id := range w.VideoIDs {
+		if id == videoID {
+			return w.Bitfield.Get(i)
+		}
+	}
+	return false
+}
+
+// Set assigns the bit at index i.
+func (w *WatchedBitField) Set(i int, v bool) { w.Bitfield.Set(i, v) }
+
+// SetVideo assigns the watched state of the given video.
+func (w *WatchedBitField) SetVideo(videoID string, v bool) {
+	for i, id := range w.VideoIDs {
+		if id == videoID {
+			w.Bitfield.Set(i, v)
+			return
+		}
+	}
+}
+
+// String serializes the watched bitfield into its `{id}:{len}:{buf}` form.
+func (w WatchedBitField) String() string {
+	packed, err := w.Bitfield.encode()
+	if err != nil {
+		packed = ""
+	}
+	lastID, ok := w.Bitfield.LastIndexOf(true)
+	if !ok {
+		lastID = 0
+	}
+	lastVideoID := "undefined"
+	if lastID < len(w.VideoIDs) {
+		lastVideoID = w.VideoIDs[lastID]
+	}
+	return fmt.Sprintf("%s:%d:%s", lastVideoID, lastID+1, packed)
+}
