+func (s *StreamingServer) setSettings(base string, settings types.StreamingServerSettings) runtime.Effects {
+	remoteHTTPS := settings.RemoteHTTPS
+	if remoteHTTPS != nil && *remoteHTTPS == "" {
+		remoteHTTPS = nil
+	}
+	body, _ := json.Marshal(struct {
+		CacheSize                *float64 `json:"cacheSize"`
+		CacheRoot                string   `json:"cacheRoot"`
+		BTMaxConnections         uint64   `json:"btMaxConnections"`
+		BTHandshakeTimeout       uint64   `json:"btHandshakeTimeout"`
+		BTRequestTimeout         uint64   `json:"btRequestTimeout"`
+		BTDownloadSpeedSoftLimit float64  `json:"btDownloadSpeedSoftLimit"`
+		BTDownloadSpeedHardLimit float64  `json:"btDownloadSpeedHardLimit"`
+		BTMinPeersForStable      uint64   `json:"btMinPeersForStable"`
+		RemoteHTTPS              *string  `json:"remoteHttps"`
+		ProxyStreamsEnabled      bool     `json:"proxyStreamsEnabled"`
+		TranscodeProfile         *string  `json:"transcodeProfile"`
+	}{
+		CacheSize:                settings.CacheSize,
+		CacheRoot:                settings.CacheRoot,
+		BTMaxConnections:         settings.BTMaxConnections,
+		BTHandshakeTimeout:       settings.BTHandshakeTimeout,
+		BTRequestTimeout:         settings.BTRequestTimeout,
+		BTDownloadSpeedSoftLimit: settings.BTDownloadSpeedSoftLimit,
+		BTDownloadSpeedHardLimit: settings.BTDownloadSpeedHardLimit,
+		BTMinPeersForStable:      settings.BTMinPeersForStable,
+		RemoteHTTPS:              remoteHTTPS,
+		ProxyStreamsEnabled:      settings.ProxyStreamsEnabled,
+		TranscodeProfile:         settings.TranscodeProfile,
+	})
+	url := joinURL(base, "settings")
+	return s.request("POST", url, body, func(raw []byte, envErr *runtime.EnvError) *msg.Msg {
+		data := updateSettingsResult{URL: base, Err: envErrToError(envErr)}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerUpdateSettingsResult, data))
+	})
+}
