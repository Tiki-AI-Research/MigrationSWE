+type streamsBucketWire struct {
+	UID   UID                 `json:"uid"`
+	Items [][]json.RawMessage `json:"items"`
+}
+
+// MarshalJSON implements json.Marshaler.
+func (b StreamsBucket) MarshalJSON() ([]byte, error) {
+	items := make([][]json.RawMessage, 0, len(b.Items))
+	for key, value := range b.Items {
+		keyJSON, err := json.Marshal(key)
+		if err != nil {
+			return nil, err
+		}
+		valueJSON, err := json.Marshal(value)
+		if err != nil {
+			return nil, err
+		}
+		items = append(items, []json.RawMessage{keyJSON, valueJSON})
+	}
+	return json.Marshal(streamsBucketWire{UID: b.UID, Items: items})
+}
+
+// UnmarshalJSON implements json.Unmarshaler.
+func (b *StreamsBucket) UnmarshalJSON(data []byte) error {
+	var wire streamsBucketWire
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	b.UID = wire.UID
+	b.Items = map[StreamsItemKey]StreamsItem{}
+	for _, pair := range wire.Items {
+		if len(pair) != 2 {
+			continue
+		}
+		var key StreamsItemKey
+		if err := json.Unmarshal(pair[0], &key); err != nil {
+			return err
+		}
+		var value StreamsItem
+		if err := json.Unmarshal(pair[1], &value); err != nil {
+			return err
+		}
+		b.Items[key] = value
+	}
+	return nil
+}
