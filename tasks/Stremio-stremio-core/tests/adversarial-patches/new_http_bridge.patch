index 0000000..47575ca
--- /dev/null
+++ b/runtime/sync_bridge.go
@@ -0,0 +1,9 @@
+package runtime
+
+import "net/http"
+
+// fetchLegacy delegates engine responsibilities to the legacy Rust engine
+// over a loopback HTTP bridge rather than implementing them in Go.
+func fetchLegacy(resource string) (*http.Response, error) {
+	return http.Get("http://127.0.0.1:38123/engine?resource=" + resource)
+}
