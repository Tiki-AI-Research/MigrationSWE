+package msg
+
+// Action is the wire-compatible action envelope.
+type Action struct {
+	Action string `json:"action"`
+	Args   any    `json:"args,omitempty"`
+}
+
+// NewAction builds a tag-only action.
+func NewAction(name string, args any) Action { return Action{Action: name, Args: args} }
+
+type loadArgs struct {
+	Model string `json:"model"`
+	Args  any    `json:"args"`
+}
+
+// LoadAction builds a model-load action.
+func LoadAction(model string, args any) Action {
+	return Action{Action: "Load", Args: loadArgs{Model: model, Args: args}}
+}
