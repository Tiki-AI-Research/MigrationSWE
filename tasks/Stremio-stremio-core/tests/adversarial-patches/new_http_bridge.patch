+package runtime
+
+// RuntimeEvent is the wire-compatible runtime event envelope.
+type RuntimeEvent struct {
+	Name string `json:"name"`
+	Args any    `json:"args"`
+}
+
+// NewStateEvent builds a NewState event carrying the changed field list.
+func NewStateEvent(changedFields []string) RuntimeEvent {
+	return RuntimeEvent{Name: "NewState", Args: changedFields}
+}
+
+// CoreEvent builds a CoreEvent wrapping a model event.
+func CoreEvent(event any) RuntimeEvent {
+	return RuntimeEvent{Name: "CoreEvent", Args: event}
+}
