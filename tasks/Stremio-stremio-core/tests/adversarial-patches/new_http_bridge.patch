@@ -0,0 +1,52 @@
+package addon_transport
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"strconv"
+	"strings"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+type legacyQuery struct {
+	Episode int    `json:"episode"`
+	ImdbID  string `json:"imdb_id"`
+	Season  int    `json:"season"`
+	Type    string `json:"type"`
+}
+
+type legacyReq struct {
+	ID      int    `json:"id"`
+	JSONRPC string `json:"jsonrpc"`
+	Method  string `json:"method"`
+	Params  []any  `json:"params"`
+}
+
+// BuildLegacyReq builds the legacy JSON-RPC request URL for a resource path.
+func BuildLegacyReq(transportURL string, path types.ResourcePath) (string, error) {
+	parts := strings.Split(path.ID, ":")
+	imdb := ""
+	if len(parts) > 0 {
+		imdb = parts[0]
+	}
+	season, episode := 0, 0
+	if len(parts) > 1 {
+		season, _ = strconv.Atoi(parts[1])
+	}
+	if len(parts) > 2 {
+		episode, _ = strconv.Atoi(parts[2])
+	}
+	query := legacyQuery{Episode: episode, ImdbID: imdb, Season: season, Type: path.Type}
+	body := legacyReq{
+		ID:      1,
+		JSONRPC: "2.0",
+		Method:  path.Resource + ".find",
+		Params:  []any{nil, map[string]any{"query": query}},
+	}
+	raw, err := json.Marshal(body)
+	if err != nil {
+		return "", err
+	}
+	return transportURL + "/q.json?b=" + base64.StdEncoding.EncodeToString(raw), nil
+}
