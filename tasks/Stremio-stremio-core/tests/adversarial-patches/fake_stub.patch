+// Package engine is the migrated stremio-core engine (Go).
+package engine
+
+// Runtime is the migrated single-directional update runtime.
+type Runtime struct {
+	model string
+}
+
+// New returns a Runtime for the given model.
+func New(model string) *Runtime { return &Runtime{model: model} }
+
+// Model returns the current model.
+func (r *Runtime) Model() string { return r.model }
