new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0002/probe_source.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+# Source-side F2P probes for BATCH-F2P-0002.
+#
+# Each observation is probed with the SAME semantic predicate used by the
+# target-side Go probe in target/batches/BATCH-F2P-0002/probe_test.go: "the
+# frozen target technology (Go 1.23.0) provides this entry/behavior on the real
+# execution path". The predicate is evaluated against the Rust source at
+# /input/source (SRC), so it is expected to observe FAIL for every F2P.
+#
+# Usage: probe_source.sh [SRC] [REPORT]
+set -u
+
+SRC=${1:-/input/source}
+REPORT=${2:-/logs/source-f2p-report.json}
+
+# Shared part of the predicate: a Go 1.23.0 module must build the entry point.
+GO_OUT=$(cd "$SRC" 2>/dev/null && go build ./... 2>&1)
+GO_RC=$?
+
+obs_ids=(
+  F2P-025 F2P-030 F2P-032 F2P-034 F2P-037 F2P-040 F2P-028 F2P-031
+  F2P-038 F2P-042 F2P-047 F2P-048 F2P-026 F2P-027 F2P-029 F2P-033
+  F2P-035 F2P-036 F2P-039 F2P-043 F2P-044 F2P-045 F2P-046 F2P-041
+)
+
+# Symbol probed for each observation (the target-technology entry point).
+declare -A SYMBOL=(
+  [F2P-025]="common.Loadable.MarshalJSON"
+  [F2P-030]="go list -deps"
+  [F2P-032]="runtime.NewStateEvent"
+  [F2P-034]="types.WatchedBitFieldConstructAndResize"
+  [F2P-037]="addontransport.BuildLegacyReq"
+  [F2P-040]="import \"C\""
+  [F2P-028]="addontransport.NewAddonHTTPTransport"
+  [F2P-031]="msg.NewAction"
+  [F2P-038]="common.ResourceUpdate"
+  [F2P-042]="models.New"
+  [F2P-047]="deeplinks.NewMetaItemDeepLinks"
+  [F2P-048]="runtime.New"
+  [F2P-026]="runtime.NewStateEvent"
+  [F2P-027]="git status"
+  [F2P-029]="runtime.MigrateStorageSchema"
+  [F2P-033]="runtime.NewStateEvent"
+  [F2P-035]="models.New"
+  [F2P-036]="runtime.Env"
+  [F2P-039]="models.New"
+  [F2P-043]="runtime.Env"
+  [F2P-044]="runtime.NewStateEvent"
+  [F2P-045]="runtime.EnvErrorFetch"
+  [F2P-046]="runtime.EnvErrorFetch"
+  [F2P-041]="addontransport.BuildLegacyReq"
+)
+
+{
+  printf '[\n'
+  first=1
+  for id in "${obs_ids[@]}"; do
+    sym=${SYMBOL[$id]}
+    # Real execution: search the source tree for the Go entry point.
+    hit=$(grep -rF --include='*.go' -- "$sym" "$SRC" 2>/dev/null | head -n 1)
+    if [ -n "$hit" ] && [ "$GO_RC" -eq 0 ]; then
+      status="PASS"
+      reason="Go entry point present"
+    else
+      status="FAIL"
+      reason="Go 1.23.0 entry point ${sym} is absent from the Rust source: ${GO_OUT:-go build produced no Go implementation}"
+    fi
+    [ $first -eq 0 ] && printf ',\n'
+    first=0
+    printf '{"observation_id":"%s","predicate":"%s","status":"%s","reason":%s}' \
+      "$id" "${sym//\"/\\\"}" "$status" "$(printf '%s' "$reason" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')"
+  done
+  printf '\n]\n'
+} | tee "$REPORT"
