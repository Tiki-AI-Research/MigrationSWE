new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0001/source_probe.sh
@@ -0,0 +1,29 @@
+#!/bin/sh
+# BATCH-F2P-0001 source-side probe.
+#
+# Usage: source_probe.sh [source_repo_dir]
+#
+# Runs the SAME semantic predicate as the target dependency/scope probe against
+# the source repository: "the repository is a standalone Go module that builds
+# with CGO disabled and resolves only the module plus the standard library".
+# On the Rust source this postcondition does not hold (there is no Go module),
+# so the probe must report FAIL. It is never hardcoded: it is derived from the
+# source tree itself.
+set -eu
+
+REPO="${1:-/input/source}"
+cd "$REPO"
+
+observed_fail() {
+	echo "F2P-PROBE FAIL: target postcondition not satisfied on source ($1)" >&2
+	exit 1
+}
+
+[ -f go.mod ] || observed_fail "no go.mod: repository is not a Go module"
+grep -q '^module github.com/stremio/stremio-core$' go.mod \
+	|| observed_fail "unexpected module path"
+
+CGO_ENABLED=0 go build ./... || observed_fail "CGO_ENABLED=0 go build ./... failed"
+
+echo "F2P-PROBE PASS: target postcondition unexpectedly holds on source"
+exit 0
