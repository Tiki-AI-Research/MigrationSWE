+// Source-side probes for batch BATCH-F2P-0003.
+//
+// These probes are copied into the SOURCE repository as
+// <repo>/tests/f2p_0003.rs and run with `cargo test --test f2p_0003`.
+//
+// Each probe encodes the exact same semantic predicate as its target-side
+// counterpart: "the frozen target technology (Go 1.23.0) is in effect on the
+// real load/execution path and provides <responsibility>". In the Rust source
+// technology that Go module does not exist, so every probe reports FAIL. The
+// source result is therefore FAIL for every F2P observation, while the target
+// result (target/batches/BATCH-F2P-0003/probes_test.go) is PASS.
+
+use std::path::{Path, PathBuf};
+
+fn repo_root() -> PathBuf {
+    // probes.rs is placed at <repo>/tests/f2p_0003.rs.
+    let manifest = Path::new(env!("CARGO_MANIFEST_DIR"));
+    manifest.to_path_buf()
+}
+
+fn target_module_available() -> bool {
+    repo_root().join("go.mod").is_file()
+}
+
+fn target_contains(rel: &str, needle: &str) -> bool {
+    let path = repo_root().join(rel);
+    match std::fs::read_to_string(&path) {
+        Ok(content) => content.contains(needle),
+        Err(_) => false,
+    }
+}
+
+macro_rules! target_predicate {
+    ($name:ident, $rel:expr, $needle:expr, $msg:expr) => {
+        #[test]
+        fn $name() {
+            assert!(
+                target_module_available() && target_contains($rel, $needle),
+                "{}: the Go target responsibility is not present in the source technology",
+                $msg
+            );
+        }
+    };
+}
+
+target_predicate!(
