@@ -0,0 +1,102 @@
+package common
+
+import (
+	"github.com/stremio/stremio-core/types"
+)
+
+// LoadableState is the state of a Loadable.
+type LoadableState int
+
+const (
+	LoadableLoading LoadableState = iota
+	LoadableReady
+	LoadableErr
+)
+
+// Loadable is a value which is loading, ready or failed to load. It is
+// serialized as `{"type": "Loading"}`, `{"type": "Ready", "content": ...}`
+// or `{"type": "Err", "content": ...}`.
+type Loadable[T any] struct {
+	State   LoadableState
+	Content T
+	Error   error
+}
+
+// Loading returns a loading loadable.
+func Loading[T any]() Loadable[T] {
+	return Loadable[T]{State: LoadableLoading}
+}
+
+// Ready returns a ready loadable with the value.
+func Ready[T any](value T) Loadable[T] {
+	return Loadable[T]{State: LoadableReady, Content: value}
+}
+
+// Err returns a failed loadable with the error.
+func Err[T any](err error) Loadable[T] {
+	return Loadable[T]{State: LoadableErr, Error: err}
+}
+
+// FromResult returns a ready loadable for a nil error, a failed one otherwise.
+func FromResult[T any](value T, err error) Loadable[T] {
+	if err != nil {
+		return Err[T](err)
+	}
+	return Ready(value)
+}
+
+// IsReady reports whether the value is loaded.
+func (l Loadable[T]) IsReady() bool { return l.State == LoadableReady }
+
+// IsErr reports whether loading the value failed.
+func (l Loadable[T]) IsErr() bool { return l.State == LoadableErr }
+
+// IsLoading reports whether the value is loading.
+func (l Loadable[T]) IsLoading() bool { return l.State == LoadableLoading }
+
+// Ready returns the loaded value.
+func (l Loadable[T]) Ready() (T, bool) {
+	if l.State != LoadableReady {
+		var zero T
+		return zero, false
+	}
+	return l.Content, true
+}
+
+// Err returns the error of a failed loadable.
+func (l Loadable[T]) Err() error {
+	if l.State != LoadableErr {
+		return nil
+	}
+	return l.Error
+}
+
+// Equal compares two loadables.
+func (l Loadable[T]) Equal(other Loadable[T]) bool {
+	if l.State != other.State {
+		return false
+	}
+	switch l.State {
+	case LoadableReady:
+		return types.Equal(l.Content, other.Content)
+	case LoadableErr:
+		return types.Equal(l.Error, other.Error)
+	}
+	return true
+}
+
+func (l Loadable[T]) MarshalJSON() ([]byte, error) {
+	switch l.State {
+	case LoadableReady:
+		return types.MarshalJSON(struct {
+			Type    string `json:"type"`
+			Content T      `json:"content"`
+		}{"Ready", l.Content})
+	case LoadableErr:
+		return types.MarshalJSON(struct {
+			Type    string `json:"type"`
+			Content any    `json:"content"`
+		}{"Err", l.Error})
+	}
+	return []byte(`{"type":"Loading"}`), nil
+}
