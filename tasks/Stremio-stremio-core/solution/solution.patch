+func TestStreamingServerUpdateSettingsRequest(t *testing.T) {
+	env, rt, _ := ssLoadedRuntime(t, func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		if method == "POST" && url == ssURL+"settings" {
+			return []byte(`{"success":true}`), nil
+		}
+		return nil, nil
+	})
+	settings := types.StreamingServerSettings{
+		AppPath: "/app", CacheRoot: "/cache", ServerVersion: "4.20.8", RemoteHTTPS: nil,
+		TranscodeProfile: ssPtr("hevc"), CacheSize: ssPtr(2147483648.0), ProxyStreamsEnabled: true,
+		BtMaxConnections: 55, BtHandshakeTimeout: 20000, BtRequestTimeout: 4000,
+		BtDownloadSpeedSoftLimit: 2621440, BtDownloadSpeedHardLimit: 3670016.5, BtMinPeersForStable: 5,
+	}
+	rt.Dispatch(ssAction(msg.ActionStreamingServerUpdateSettings, settings))
+	if len(env.Requests) != 1 {
+		t.Fatalf("requests = %+v", env.Requests)
+	}
+	request := env.Requests[0]
+	// rust: serde_json::to_string(&Body{..}) of set_settings
+	wantBody := `{"cacheSize":2147483648.0,"cacheRoot":"/cache","btMaxConnections":55,"btHandshakeTimeout":20000,` +
+		`"btRequestTimeout":4000,"btDownloadSpeedSoftLimit":2621440.0,"btDownloadSpeedHardLimit":3670016.5,` +
+		`"btMinPeersForStable":5,"remoteHttps":"","proxyStreamsEnabled":true,"transcodeProfile":"hevc"}`
+	if request.Method != "POST" || request.URL != ssURL+"settings" || string(request.Body) != wantBody ||
+		!reflect.DeepEqual(request.Headers, map[string]string{"content-type": "application/json"}) {
+		t.Errorf("request = %s %s %v %s", request.Method, request.URL, request.Headers, request.Body)
+	}
+	server := ssModel(t, rt.Model()).StreamingServer
+	if got, _ := server.Settings.Ready(); !types.Equal(got, settings) {
+		t.Errorf("settings = %+v", got)
+	}
+
+	// settings which are not ready are not updated
+	server.Settings = common.Loading[types.StreamingServerSettings]()
+	env.Requests = nil
+	rt.Dispatch(ssAction(msg.ActionStreamingServerUpdateSettings, settings))
+	if len(env.Requests) != 0 || !server.Settings.IsLoading() {
+		t.Errorf("settings should not be updated while loading: %+v", env.Requests)
+	}
+}
