@@ -0,0 +1,265 @@
+package ctx_test
+
+import (
+	"testing"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Tests of update_streams.rs (StreamLoaded, StreamStateChanged, StreamsChanged).
+
+const (
+	stMetaBase   = "https://meta.addon/manifest.json"
+	stStreamBase = "https://stream.addon/manifest.json"
+)
+
+func stURLStream(url string, bingeGroup *string) types.Stream {
+	stream := types.Stream{Source: types.StreamSource{Kind: types.StreamSourceURL, URL: url}}
+	stream.BehaviorHints.BingeGroup = bingeGroup
+	return stream
+}
+
+func stMetaItem() types.MetaItem {
+	videos := []types.Video{}
+	for _, id := range []string{"tt1:1:1", "tt1:1:2", "tt1:1:3"} {
+		videos = append(videos, types.Video{ID: id, Title: id})
+	}
+	return types.MetaItem{
+		Preview: types.MetaItemPreview{ID: "tt1", Type: "series", Name: "name", PosterShape: types.PosterShapePoster},
+		Videos:  videos,
+	}
+}
+
+func stStreamLoaded(stream types.Stream, videoID string, content common.Loadable[types.MetaItem]) ctx.StreamLoaded {
+	streamRequest := types.NewResourceRequest(stStreamBase, types.NewResourcePath(stremiocore.STREAM_RESOURCE_NAME, "series", videoID))
+	return ctx.StreamLoaded{
+		Stream:        stream,
+		StreamRequest: &streamRequest,
+		MetaItem: common.ResourceLoadable[types.MetaItem]{
+			Request: types.NewResourceRequest(stMetaBase, types.NewResourcePath(stremiocore.META_RESOURCE_NAME, "series", "tt1")),
+			Content: &content,
+		},
+	}
+}
+
+func stState() types.StreamItemState {
+	delay := int64(500)
+	speed := float32(1.5)
+	playerType := "external"
+	return types.StreamItemState{
+		SubtitleTrack: &types.SubtitleTrack{ID: "sub", Embedded: false},
+		SubtitleDelay: &delay,
+		AudioTrack:    &types.AudioTrack{ID: "audio"},
+		AudioDelay:    &delay,
+		PlaybackSpeed: &speed,
+		PlayerType:    &playerType,
+	}
+}
+
+func TestStreamLoadedCreatesStreamsItem(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 1))
+	setRoutes(t, env)
+	h := newHarness(t, env, defaultCtx(env))
+	stream := stURLStream("https://video/1.mp4", nil)
+	h.dispatchInternal(msg.InternalStreamLoaded, stStreamLoaded(stream, "tt1:1:1", common.Ready(stMetaItem())))
+
+	key := types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:1"}
+	expected := types.StreamsItem{
+		Stream:             stream,
+		Type:               "series",
+		MetaID:             "tt1",
+		VideoID:            "tt1:1:1",
+		MetaTransportURL:   stMetaBase,
+		StreamTransportURL: stStreamBase,
+		Mtime:              env.Now(),
+	}
+	assertEqual(t, h.ctx().Streams.Items, map[types.StreamsItemKey]types.StreamsItem{key: expected}, "streams updated in memory")
+	stored, ok := storageValue[types.StreamsBucket](t, env, stremiocore.STREAMS_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("streams pushed to storage")
+	}
+	assertEqual(t, stored, h.ctx().Streams, "streams updated in storage")
+	assertEqual(t, h.coreEventNames(), []string{msg.EventStreamsPushedToStorage}, "events")
+	assertEvent(t, h.findEvent(msg.EventStreamsPushedToStorage), msg.EventStreamsPushedToStorage, `{"uid":null}`, "StreamsPushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+func TestStreamLoadedAdjustsStateOfLastStream(t *testing.T) {
+	bingeGroup := "group"
+	otherGroup := "other"
+	cases := []struct {
+		name     string
+		previous types.Stream
+		next     types.Stream
+		expected func(types.StreamItemState) *types.StreamItemState
+	}{
+		{
+			name:     "same source keeps the whole state",
+			previous: stURLStream("https://video/1.mp4", nil),
+			next:     stURLStream("https://video/1.mp4", nil),
+			expected: func(state types.StreamItemState) *types.StreamItemState { return &state },
+		},
+		{
+			name:     "same binge group drops the delays and addon subtitles",
+			previous: stURLStream("https://video/1.mp4", &bingeGroup),
+			next:     stURLStream("https://video/2.mp4", &bingeGroup),
+			expected: func(state types.StreamItemState) *types.StreamItemState {
+				state.SubtitleTrack = nil
+				state.SubtitleDelay = nil
+				state.AudioDelay = nil
+				return &state
+			},
+		},
+		{
+			name:     "other stream keeps only the playback speed and player type",
+			previous: stURLStream("https://video/1.mp4", &bingeGroup),
+			next:     stURLStream("https://video/2.mp4", &otherGroup),
+			expected: func(state types.StreamItemState) *types.StreamItemState {
+				return &types.StreamItemState{PlaybackSpeed: state.PlaybackSpeed, PlayerType: state.PlayerType}
+			},
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			env := newTestEnv(date(2020, 1, 1))
+			setRoutes(t, env)
+			c := defaultCtx(env)
+			state := stState()
+			previousKey := types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:1"}
+			c.Streams.Items[previousKey] = types.StreamsItem{
+				Stream:             tc.previous,
+				Type:               "series",
+				MetaID:             "tt1",
+				VideoID:            "tt1:1:1",
+				MetaTransportURL:   stMetaBase,
+				StreamTransportURL: stStreamBase,
+				State:              &state,
+				Mtime:              date(2019, 1, 1),
+			}
+			h := newHarness(t, env, c)
+			// the next episode: the last stream item is found among the previous videos
+			h.dispatchInternal(msg.InternalStreamLoaded, stStreamLoaded(tc.next, "tt1:1:2", common.Ready(stMetaItem())))
+			item, ok := h.ctx().Streams.Items[types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:2"}]
+			if !ok {
+				t.Fatalf("streams item for the next video is created")
+			}
+			assertEqual(t, item.State, tc.expected(stState()), "adjusted state")
+			assertEqual(t, item.Stream, tc.next, "stream")
+			if len(h.ctx().Streams.Items) != 2 {
+				t.Errorf("the previous item is kept")
+			}
+		})
+	}
+}
+
+func TestStreamLoadedWithFailedMetaUsesSameVideo(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 1))
+	setRoutes(t, env)
+	c := defaultCtx(env)
+	state := stState()
+	stream := stURLStream("https://video/1.mp4", nil)
+	// an item of another video is not considered when the meta item is not loaded
+	c.Streams.Items[types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:1"}] = types.StreamsItem{
+		Stream: stream, Type: "series", MetaID: "tt1", VideoID: "tt1:1:1",
+		MetaTransportURL: stMetaBase, StreamTransportURL: stStreamBase, State: &state, Mtime: date(2019, 1, 1),
+	}
+	h := newHarness(t, env, c)
+	h.dispatchInternal(msg.InternalStreamLoaded, stStreamLoaded(stream, "tt1:1:2", common.Err[types.MetaItem](&common.ResourceError{Kind: common.ResourceErrorEmptyContent})))
+	item := h.ctx().Streams.Items[types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:2"}]
+	if item.State != nil {
+		t.Errorf("no state for a new video without the meta item, got %s", types.MustMarshalJSON(item.State))
+	}
+	// the same video uses its own state
+	h.dispatchInternal(msg.InternalStreamLoaded, stStreamLoaded(stream, "tt1:1:1", common.Err[types.MetaItem](&common.ResourceError{Kind: common.ResourceErrorEmptyContent})))
+	item = h.ctx().Streams.Items[types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:1"}]
+	assertEqual(t, item.State, &state, "state of the same video")
+	assertEqual(t, item.Mtime, env.Now(), "mtime updated")
+}
+
+func TestStreamLoadedIgnoredWhileMetaIsLoading(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 1))
+	setRoutes(t, env)
+	h := newHarness(t, env, defaultCtx(env))
+	h.dispatchInternal(msg.InternalStreamLoaded, stStreamLoaded(stURLStream("https://video/1.mp4", nil), "tt1:1:1", common.Loading[types.MetaItem]()))
+	loaded := stStreamLoaded(stURLStream("https://video/1.mp4", nil), "tt1:1:1", common.Ready(stMetaItem()))
+	loaded.StreamRequest = nil
+	h.dispatchInternal(msg.InternalStreamLoaded, loaded)
+	if len(h.ctx().Streams.Items) != 0 {
+		t.Errorf("streams not updated")
+	}
+	if _, ok := env.Storage[stremiocore.STREAMS_STORAGE_KEY]; ok {
+		t.Errorf("streams not pushed to storage")
+	}
+	assertEqual(t, h.newStates(), [][]string{}, "no NewState")
+}
+
+func TestStreamStateChanged(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 1))
+	setRoutes(t, env)
+	h := newHarness(t, env, defaultCtx(env))
+	stream := stURLStream("https://video/1.mp4", nil)
+	loaded := stStreamLoaded(stream, "tt1:1:1", common.Ready(stMetaItem()))
+	metaRequest := loaded.MetaItem.Request
+
+	// unknown stream: nothing happens
+	otherRequest := types.NewResourceRequest(stStreamBase, types.NewResourcePath(stremiocore.STREAM_RESOURCE_NAME, "series", "tt1:1:3"))
+	h.dispatchInternal(msg.InternalStreamStateChanged, ctx.StreamStateChanged{State: stState(), StreamRequest: &otherRequest, MetaRequest: &metaRequest})
+	if len(h.ctx().Streams.Items) != 0 {
+		t.Fatalf("no streams item created by a state change")
+	}
+	assertEqual(t, h.newStates(), [][]string{}, "no NewState")
+
+	h.dispatchInternal(msg.InternalStreamLoaded, loaded)
+	h.clearEvents()
+	state := stState()
+	h.dispatchInternal(msg.InternalStreamStateChanged, ctx.StreamStateChanged{State: state, StreamRequest: loaded.StreamRequest, MetaRequest: &metaRequest})
+	item := h.ctx().Streams.Items[types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:1"}]
+	assertEqual(t, item.State, &state, "state updated in memory")
+	stored, _ := storageValue[types.StreamsBucket](t, env, stremiocore.STREAMS_STORAGE_KEY)
+	assertEqual(t, stored, h.ctx().Streams, "state updated in storage")
+	assertEqual(t, h.coreEventNames(), []string{msg.EventStreamsPushedToStorage}, "events")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+
+	// missing requests: ignored
+	h.clearEvents()
+	h.dispatchInternal(msg.InternalStreamStateChanged, ctx.StreamStateChanged{State: types.StreamItemState{}, StreamRequest: loaded.StreamRequest})
+	assertEqual(t, h.ctx().Streams.Items[types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:1"}].State, &state, "state unchanged")
+	assertEqual(t, h.coreEventNames(), []string{}, "no events")
+}
+
+func TestStreamsChangedPersisted(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 1))
+	setRoutes(t, env)
+	h := newHarness(t, env, defaultCtx(env))
+	h.dispatchInternal(msg.InternalStreamsChanged, true)
+	if _, ok := env.Storage[stremiocore.STREAMS_STORAGE_KEY]; ok {
+		t.Errorf("already persisted streams are not pushed")
+	}
+	h.dispatchInternal(msg.InternalStreamsChanged, false)
+	if _, ok := env.Storage[stremiocore.STREAMS_STORAGE_KEY]; !ok {
+		t.Errorf("streams are pushed")
+	}
+	assertEqual(t, h.newStates(), [][]string{}, "no NewState")
+}
+
+func TestLogoutResetsStreams(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 1))
+	setRoutes(t, env)
+	c := defaultCtx(env)
+	c.Streams.Items[types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:1"}] = types.StreamsItem{
+		Stream: stURLStream("https://video/1.mp4", nil), Type: "series", MetaID: "tt1", VideoID: "tt1:1:1",
+		MetaTransportURL: stMetaBase, StreamTransportURL: stStreamBase, Mtime: date(2019, 1, 1),
+	}
+	h := newHarness(t, env, c)
+	h.dispatchCtx(msg.ActionCtxLogout, nil)
+	assertEqual(t, h.ctx().Streams, types.NewStreamsBucket(nil), "streams reset")
+	stored, ok := storageValue[types.StreamsBucket](t, env, stremiocore.STREAMS_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("streams pushed to storage")
+	}
+	assertEqual(t, stored, types.NewStreamsBucket(nil), "streams reset in storage")
+}
diff --git a/models/ctx/sync_library_with_api_test.go b/models/ctx/sync_library_with_api_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..57a037a7ce8daf74ca49590fbec60621238cf623
--- /dev/null
+++ b/models/ctx/sync_library_with_api_test.go
@@ -0,0 +1,187 @@
+package ctx_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of src/unit_tests/ctx/sync_library_with_api.rs
+
+// libSyncItem is a library item of the sync tests.
+func libSyncItem(id, itemType string, removed bool, mtime time.Time) types.LibraryItem {
+	return types.LibraryItem{
+		ID:          id,
+		Type:        itemType,
+		Name:        "name",
+		PosterShape: types.PosterShapePoster,
+		Removed:     removed,
+		Ctime:       timePtr(date(2020, 1, 1)),
+		Mtime:       mtime,
+	}
+}
+
+// libSyncItemJSON is the serde serialization of a libSyncItem.
+func libSyncItemJSON(id, itemType string, removed bool, mtime string) string {
+	return fmt.Sprintf(`{"_id":%q,"name":"name","type":%q,"poster":null,"posterShape":"poster","removed":%t,"temp":false,"_ctime":"2020-01-01T00:00:00Z","_mtime":%q,"state":{"lastWatched":null,"timeWatched":0,"timeOffset":0,"overallTimeWatched":0,"timesWatched":0,"flaggedWatched":0,"duration":0,"video_id":null,"watched":null,"noNotif":false},"behaviorHints":{"defaultVideoId":null,"featuredVideoId":null,"hasScheduledVideos":false}}`,
+		id, itemType, removed, mtime)
+}
+
+func TestActionCtxSyncLibraryWithAPI(t *testing.T) {
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env)
+	h := newHarness(t, env, defaultCtx(env))
+	h.dispatchCtx(msg.ActionCtxSyncLibraryWithAPI, nil)
+
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+	assertEqual(t, h.coreEventNames(), []string{msg.EventError}, "events")
+	assertEvent(t, h.findEvent(msg.EventError), msg.EventError,
+		`{"error":{"type":"Other","code":1,"message":"User is not logged in"},"source":{"event":"LibrarySyncWithAPIPlanned","args":{"uid":null,"plan":[[],[]]}}}`,
+		"Error UserNotLoggedIn")
+	assertEqual(t, h.newStates(), [][]string{}, "NewState")
+}
+
+func TestActionCtxSyncLibraryWithAPIWithUser(t *testing.T) {
+	// rust uses the current time (`Utc::now()`); a fixed time makes the
+	// request bodies deterministic
+	now := datetime(2024, 6, 1, 12, 0, 0)
+	env := newTestEnv(now)
+	jan1 := date(2020, 1, 1)
+	remoteOnlyItem := libSyncItem("id1", "type", false, jan1)
+	localNewerItem := libSyncItem("id2", "type", false, jan1)
+	remoteNewerItem := libSyncItem("id3", "type", false, jan1)
+	localOnlyItem := libSyncItem("id4", "type", false, jan1)
+	localOldRemovedItem := libSyncItem("id5", "type", true, now.Add(-367*24*time.Hour))
+	localNewRemovedItem := libSyncItem("id6", "type", true, now.Add(-3*24*time.Hour))
+	localOtherTypeItem := libSyncItem("id7", "other", false, now)
+	remoteNewerItemLocal := remoteNewerItem
+	remoteNewerItemLocal.Mtime = remoteNewerItem.Mtime.Add(-24 * time.Hour)
+
+	// the Go implementation sorts the pushed items and the pulled ids (rust
+	// iterates HashMaps and the rust handler accepts any order)
+	putBody := `{"authKey":"auth_key","collection":"libraryItem","changes":[` + strings.Join([]string{
+		libSyncItemJSON("id2", "type", false, "2020-01-01T00:00:00Z"),
+		libSyncItemJSON("id4", "type", false, "2020-01-01T00:00:00Z"),
+		libSyncItemJSON("id6", "type", true, "2024-05-29T12:00:00Z"),
+	}, ",") + `]}`
+	setRoutes(t, env,
+		fetchRoute{
+			Method: "POST",
+			URL:    "https://api.strem.io/api/datastoreMeta",
+			Body:   `{"authKey":"auth_key","collection":"libraryItem"}`,
+			// [id, mtime in ms]: id1 2020-01-01, id2 2019-12-31, id3 2020-01-01
+			Response: apiOKRaw(`[["id1",1577836800000],["id2",1577750400000],["id3",1577836800000]]`),
+		},
+		fetchRoute{
+			Method:   "POST",
+			URL:      "https://api.strem.io/api/datastorePut",
+			Body:     putBody,
+			Response: apiSuccess,
+		},
+		fetchRoute{
+			Method:   "POST",
+			URL:      "https://api.strem.io/api/datastoreGet",
+			Body:     `{"authKey":"auth_key","collection":"libraryItem","ids":["id1","id3"],"all":false}`,
+			Response: apiOK([]types.LibraryItem{remoteOnlyItem, remoteNewerItem}),
+		},
+	)
+	h := newHarness(t, env, withProfileAndLibrary(env,
+		loggedInProfile(userFixture(env.Now())),
+		types.NewLibraryBucket(uid("user_id"), []types.LibraryItem{
+			localOnlyItem,
+			localNewerItem,
+			remoteNewerItemLocal,
+			localOldRemovedItem,
+			localNewRemovedItem,
+			localOtherTypeItem,
+		}),
+	))
+	h.dispatchCtx(msg.ActionCtxSyncLibraryWithAPI, nil)
+
+	expectedItems := []types.LibraryItem{
+		localOnlyItem,
+		localNewerItem,
+		remoteNewerItem,
+		remoteOnlyItem,
+		localOldRemovedItem,
+		localNewRemovedItem,
+		localOtherTypeItem,
+	}
+	assertEqual(t, h.ctx().Library, types.NewLibraryBucket(uid("user_id"), expectedItems), "library updated successfully in memory")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Library recent slot updated successfully in storage")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(uid("user_id"), expectedItems), "Library recent slot updated successfully in storage")
+	if _, ok := env.Storage[stremiocore.LIBRARY_STORAGE_KEY]; ok {
+		t.Errorf("Library slot is not in storage (less than LIBRARY_RECENT_COUNT items)")
+	}
+	if len(env.Requests) != 3 {
+		t.Fatalf("Three requests have been sent, got %d: %s", len(env.Requests), describeRequests(env.Requests))
+	}
+	if env.Requests[0].URL != "https://api.strem.io/api/datastoreMeta" {
+		t.Errorf("datastoreMeta request has been sent: %s", env.Requests[0].URL)
+	}
+	if env.Requests[1].URL != "https://api.strem.io/api/datastorePut" {
+		t.Errorf("datastorePut request has been sent: %s", env.Requests[1].URL)
+	}
+	if env.Requests[2].URL != "https://api.strem.io/api/datastoreGet" {
+		t.Errorf("datastoreGet request has been sent: %s", env.Requests[2].URL)
+	}
+	// the events
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventLibrarySyncWithAPIPlanned,
+		msg.EventLibraryItemsPushedToAPI,
+		msg.EventUserLibraryMissing,
+		msg.EventLibraryItemsPulledFromAPI,
+		msg.EventLibraryItemsPushedToStorage,
+	}, "events")
+	assertEvent(t, h.findEvent(msg.EventLibrarySyncWithAPIPlanned), msg.EventLibrarySyncWithAPIPlanned,
+		`{"uid":"user_id","plan":[["id1","id3"],["id2","id4","id6"]]}`, "LibrarySyncWithAPIPlanned")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToAPI), msg.EventLibraryItemsPushedToAPI,
+		`{"ids":["id2","id4","id6"]}`, "LibraryItemsPushedToAPI")
+	assertEvent(t, h.findEvent(msg.EventUserLibraryMissing), msg.EventUserLibraryMissing,
+		`{"library_missing":false}`, "UserLibraryMissing")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPulledFromAPI), msg.EventLibraryItemsPulledFromAPI,
+		`{"ids":["id1","id3"]}`, "LibraryItemsPulledFromAPI")
+	// the pulled items, in the order of the API response
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage,
+		`{"ids":["id1","id3"]}`, "LibraryItemsPushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+func TestActionCtxSyncLibraryWithAPIWithUserEmptyLibrary(t *testing.T) {
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env, fetchRoute{
+		Method:   "POST",
+		URL:      "https://api.strem.io/api/datastoreMeta",
+		Body:     `{"authKey":"auth_key","collection":"libraryItem"}`,
+		Response: apiOKRaw(`[]`),
+	})
+	h := newHarness(t, env, withProfileAndLibrary(env,
+		loggedInProfile(userFixture(env.Now())),
+		types.NewLibraryBucket(nil, nil),
+	))
+	h.dispatchCtx(msg.ActionCtxSyncLibraryWithAPI, nil)
+
+	if len(env.Requests) != 1 {
+		t.Fatalf("One request has been sent, got %d: %s", len(env.Requests), describeRequests(env.Requests))
+	}
+	if env.Requests[0].URL != "https://api.strem.io/api/datastoreMeta" {
+		t.Errorf("datastoreMeta request has been sent: %s", env.Requests[0].URL)
+	}
+	assertEqual(t, h.coreEventNames(), []string{msg.EventLibrarySyncWithAPIPlanned}, "events")
+	assertEvent(t, h.findEvent(msg.EventLibrarySyncWithAPIPlanned), msg.EventLibrarySyncWithAPIPlanned,
+		`{"uid":"user_id","plan":[[],[]]}`, "LibrarySyncWithAPIPlanned")
+	assertEqual(t, h.newStates(), [][]string{}, "NewState")
+	if len(env.Storage) != 0 {
+		t.Errorf("Nothing persisted to storage: %v", env.Storage)
+	}
+}
