+package deeplinks
+
+import "github.com/stremio/stremio-core/types"
+
+// ErrorLink is a deep link to the error screen,
+// `stremio:///error?message={message}`, used in place of a deep link which
+// could not be generated.
+type ErrorLink string
+
+// NewErrorLink creates the error link for the error message.
+func NewErrorLink(err error) ErrorLink {
+	message := ""
+	if err != nil {
+		message = err.Error()
+	}
+	return NewErrorLinkFromMessage(message)
+}
+
+// NewErrorLinkFromMessage creates the error link for the message.
+func NewErrorLinkFromMessage(message string) ErrorLink {
+	return ErrorLink("stremio:///error?" + types.QueryParamsEncode([]types.QueryPair{{Key: "message", Value: message}}))
+}
+
+// String returns the link.
+func (l ErrorLink) String() string {
+	return string(l)
+}
diff --git a/deep_links/external_player.go b/deep_links/external_player.go
new file mode 100644
index 0000000000000000000000000000000000000000..ce4458ac3cb7060fc5ac549f3348069d4d49315b
--- /dev/null
+++ b/deep_links/external_player.go
@@ -0,0 +1,258 @@
+package deeplinks
+
+import (
+	"regexp"
+	"strconv"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+// OpenPlayerLink holds the platform specific links which open the stream in
+// an external player.
+type OpenPlayerLink struct {
+	IOS      *string `json:"ios"`
+	Android  *string `json:"android"`
+	Windows  *string `json:"windows"`
+	MacOS    *string `json:"macos"`
+	Linux    *string `json:"linux"`
+	Tizen    *string `json:"tizen"`
+	WebOS    *string `json:"webos"`
+	ChromeOS *string `json:"chromeos"`
+	Roku     *string `json:"roku"`
+	// VisionOS is omitted from the serialization when unset.
+	VisionOS *string `json:"visionos,omitempty"`
+	TvOS     *string `json:"tvos"`
+}
+
+func (l OpenPlayerLink) MarshalJSON() ([]byte, error) {
+	type openPlayerLink OpenPlayerLink
+	return types.MarshalJSON(openPlayerLink(l))
+}
+
+// ExternalPlayerLink holds the links for playing or downloading a stream
+// outside of the app.
+type ExternalPlayerLink struct {
+	Download  *string `json:"download"`
+	Magnet    *string `json:"magnet"`
+	Streaming *string `json:"streaming"`
+	// Playlist is a m3u data URI.
+	Playlist *string `json:"playlist"`
+	// FileName is the filename of the playlist.
+	FileName   *string         `json:"fileName"`
+	OpenPlayer *OpenPlayerLink `json:"openPlayer"`
+	// Web is the external URL for Web.
+	Web *string `json:"web"`
+	// AndroidTV is the external URI for Android TV.
+	AndroidTV *string `json:"androidTv"`
+	// Tizen is the external payload for Tizen.
+	Tizen *string `json:"tizen"`
+	// WebOS is the external payload for webOS.
+	WebOS *string `json:"webos"`
+}
+
+func (l ExternalPlayerLink) MarshalJSON() ([]byte, error) {
+	type externalPlayerLink ExternalPlayerLink
+	return types.MarshalJSON(externalPlayerLink(l))
+}
+
+var httpRegex = regexp.MustCompile(`https?://`)
+
+// replaceHTTP replaces the first `http(s)://` of the url (`Regex::replace`).
+func replaceHTTP(url, replacement string) string {
+	loc := httpRegex.FindStringIndex(url)
+	if loc == nil {
+		return url
+	}
+	return url[:loc[0]] + replacement + url[loc[1]:]
+}
+
+func strPtr(value string) *string {
+	return &value
+}
+
+func normalizedURLPtr(value *string) *string {
+	if value == nil {
+		return nil
+	}
+	return strPtr(types.NormalizeURL(*value))
+}
+
+// magnetURLFromRaw computes the magnet URI directly from the raw stream
+// source, without a conversion.
+func magnetURLFromRaw(stream types.Stream) *string {
+	source := stream.Source
+	switch {
+	case source.Kind == types.StreamSourceURL && types.URLScheme(source.URL) == "magnet":
+		return strPtr(types.NormalizeURL(source.URL))
+	case source.Kind == types.StreamSourceTorrent:
+		return strPtr(types.BuildMagnetURI(source.InfoHash[:], source.Announce, stream.Name))
+	}
+	return nil
+}
+
+func infuseOpenPlayerLink(streamingURL, callbackURL string, position *uint64) string {
+	callback := types.EncodeURIComponent(callbackURL)
+	positionParam := ""
+	if position != nil {
+		positionParam = "&position=" + strconv.FormatUint(*position, 10)
+	}
+	return "infuse://x-callback-url/play?x-success=" + callback + "&x-error=" + callback +
+		"&url=" + types.EncodeURIComponent(streamingURL) + positionParam
+}
+
+// infuseOpenPlayer creates the Infuse links which return to the callback url.
+func infuseOpenPlayer(streamingURL, callbackURL string, position *uint64) *OpenPlayerLink {
+	link := infuseOpenPlayerLink(streamingURL, callbackURL, position)
+	return &OpenPlayerLink{
+		IOS:      strPtr(link),
+		MacOS:    strPtr(link),
+		VisionOS: strPtr(link),
+		TvOS:     strPtr(link),
+	}
+}
+
+// NewExternalPlayerLink creates the external player link of a raw stream.
+//
+// streamingServerURL is the url of the running streaming server (nil when the
+// server is not running); when set the [types.Settings.StreamingServerURL] is
+// used for the conversion. The [types.Settings.PlayerType] selects the
+// player-specific links.
+func NewExternalPlayerLink(stream types.Stream, streamingServerURL *string, settings types.Settings) ExternalPlayerLink {
+	// use the streaming server url of the settings when the server is reachable
+	var serverURL *string
+	if streamingServerURL != nil {
+		serverURL = strPtr(settings.StreamingServerURL)
+	}
+	converted, err := stream.Convert(serverURL)
+	if err != nil {
+		return ExternalPlayerLink{Magnet: magnetURLFromRaw(stream)}
+	}
+	return NewExternalPlayerLinkFromConverted(converted, serverURL, settings)
+}
+
+// callback urls of the external players
+const (
+	externalPlayerSuccessCallback = "stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D1"
+	externalPlayerErrorCallback   = "stremio%3A%2F%2F%2Fplayer%3FexternalPlayerSuccess%3D0"
+)
+
+// NewExternalPlayerLinkFromConverted creates the external player link of an
+// already converted stream.
+//
+// streamingServerURL is the url of the running streaming server (nil when the
+// server is not running). The [types.Settings.PlayerType] selects the
+// player-specific links.
+func NewExternalPlayerLinkFromConverted(stream types.ConvertedStream, streamingServerURL *string, settings types.Settings) ExternalPlayerLink {
+	streamUrls := types.NewStreamUrls(stream, streamingServerURL)
+	streaming := streamUrls.StreamingURL
+	playlist := streamUrls.M3uDataURI
+	var fileName *string
+	if playlist != nil {
+		fileName = strPtr("playlist.m3u")
+	}
+
+	var openPlayer *OpenPlayerLink
+	if streaming != nil && settings.PlayerType != nil {
+		openPlayer = openPlayerLink(*settings.PlayerType, *streaming, playlist)
+	}
+
+	link := ExternalPlayerLink{
+		Download:   streamUrls.DownloadURL,
+		Magnet:     streamUrls.MagnetURL,
+		Streaming:  streaming,
+		Playlist:   playlist,
+		FileName:   fileName,
+		OpenPlayer: openPlayer,
+	}
+	if stream.Source.Kind == types.StreamSourceExternal {
+		link.Web = normalizedURLPtr(stream.Source.ExternalURL)
+		link.AndroidTV = normalizedURLPtr(stream.Source.AndroidTvURL)
+		if stream.Source.TizenURL != nil {
+			link.Tizen = strPtr(*stream.Source.TizenURL)
+		}
+		if stream.Source.WebosURL != nil {
+			link.WebOS = strPtr(*stream.Source.WebosURL)
+		}
+	}
+	return link
+}
+
+// openPlayerLink returns the links of the player type for the streaming url,
+// or nil for an unknown player type.
+func openPlayerLink(playerType, url string, playlist *string) *OpenPlayerLink {
+	urlEncoded := types.EncodeURIComponent(url)
+	switch playerType {
+	case "choose":
+		return &OpenPlayerLink{
+			Android: strPtr(replaceHTTP(url, "intent://") + "#Intent;type=video/any;scheme=https;end"),
+		}
+	case "vlc":
+		return &OpenPlayerLink{
+			IOS:      strPtr("vlc-x-callback://x-callback-url/stream?url=" + urlEncoded),
+			VisionOS: strPtr("vlc-x-callback://x-callback-url/stream?url=" + urlEncoded),
+			Android:  strPtr(replaceHTTP(url, "intent://") + "#Intent;package=org.videolan.vlc;type=video;scheme=https;end"),
+			Windows:  strPtr("vlc://" + url),
+		}
+	case "mxplayer":
+		return &OpenPlayerLink{
+			Android: strPtr(replaceHTTP(url, "intent://") + "#Intent;package=com.mxtech.videoplayer.ad;type=video;scheme=https;end"),
+		}
+	case "justplayer":
+		return &OpenPlayerLink{
+			Android: strPtr(replaceHTTP(url, "intent://") + "#Intent;package=com.brouken.player;type=video;scheme=https;end"),
+		}
+	case "outplayer":
+		return &OpenPlayerLink{
+			IOS:      strPtr(replaceHTTP(url, "outplayer://")),
+			VisionOS: strPtr(replaceHTTP(url, "outplayer://")),
+		}
+	case "infuse":
+		link := "infuse://x-callback-url/play?x-success=" + externalPlayerSuccessCallback +
+			"&x-error=" + externalPlayerErrorCallback + "&url=" + urlEncoded
+		return &OpenPlayerLink{
+			IOS:      strPtr(link),
+			MacOS:    strPtr(link),
+			VisionOS: strPtr(link),
+			TvOS:     strPtr(link),
+		}
+	case "vidhub":
+		link := "open-vidhub://x-callback-url/open?on-success=" + externalPlayerSuccessCallback +
+			"&on-failed=" + externalPlayerErrorCallback + "&url=" + urlEncoded
+		return &OpenPlayerLink{
+			IOS:   strPtr(link),
+			MacOS: strPtr(link),
+		}
+	case "cineultra":
+		return &OpenPlayerLink{
+			VisionOS: strPtr("cineultra://playback?url=" + urlEncoded + "&on-success=" + externalPlayerSuccessCallback +
+				"&on-failed=" + externalPlayerErrorCallback),
+		}
+	case "iina":
+		return &OpenPlayerLink{
+			MacOS: strPtr("iina://weblink?url=" + urlEncoded),
+		}
+	case "mpv":
+		return &OpenPlayerLink{
+			MacOS: strPtr("mpv://" + url),
+		}
+	case "moonplayer":
+		return &OpenPlayerLink{
+			VisionOS: strPtr("moonplayer://open?url=" + url),
+		}
+	case "m3u":
+		clonePlaylist := func() *string {
+			if playlist == nil {
+				return nil
+			}
+			return strPtr(*playlist)
+		}
+		return &OpenPlayerLink{
+			Linux:   clonePlaylist(),
+			Windows: clonePlaylist(),
+			MacOS:   clonePlaylist(),
+			Android: clonePlaylist(),
+			IOS:     clonePlaylist(),
+		}
+	}
+	return nil
+}
