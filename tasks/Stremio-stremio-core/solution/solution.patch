+func convertErr(message string) error { return &ConvertError{Message: message} }
+
+// FtpFilename returns the last path segment of a ftp(s) url.
+func FtpFilename(rawURL string) (string, error) {
+	if !CanBeABase(rawURL) {
+		return "", convertErr("Ftp(s) filepath is missing in the url")
+	}
+	path := URLPath(rawURL)
+	segments := strings.Split(strings.TrimPrefix(path, "/"), "/")
+	return segments[len(segments)-1], nil
+}
+
+func ftpURLHandler(streamingServerURL *string, rawURL string) (string, error) {
+	scheme := URLScheme(rawURL)
+	if scheme != "ftp" && scheme != "ftps" {
+		return rawURL, nil
+	}
+	if streamingServerURL == nil {
+		return "", convertErr("Can't play Ftp(s) because streaming server is not running")
+	}
+	filename, err := FtpFilename(rawURL)
+	if err != nil {
+		return "", err
+	}
+	base, err := URLJoin(*streamingServerURL, "ftp/")
+	if err != nil {
+		return "", convertErr(err.Error())
+	}
+	streamURL, err := URLJoin(base, filename)
+	if err != nil {
+		return "", convertErr(err.Error())
+	}
+	payload, err := MarshalJSON(struct {
+		FtpURL string `json:"ftpUrl"`
+	}{NormalizeURL(rawURL)})
+	if err != nil {
+		return "", convertErr(err.Error())
+	}
+	return appendQueryPairs(streamURL, []QueryPair{{Key: "lz", Value: LzCompressToEncodedURIComponent(string(payload))}}), nil
+}
+
+// appendQueryPairs appends form-urlencoded pairs to the query of the url
+// (`Url::query_pairs_mut`). The `?` is always added, even with no pairs.
+func appendQueryPairs(rawURL string, pairs []QueryPair) string {
+	base, fragment, hasFragment := strings.Cut(rawURL, "#")
+	encoded := FormURLEncodePairs(pairs)
+	switch {
+	case !strings.Contains(base, "?"):
+		base += "?" + encoded
+	case strings.HasSuffix(base, "?") || encoded == "":
+		base += encoded
+	default:
+		base += "&" + encoded
+	}
+	if hasFragment {
+		base += "#" + fragment
+	}
+	return base
+}
+
+// setQueryPairs replaces the query of the url with the pairs.
+func setQueryPairs(rawURL string, pairs []QueryPair) string {
+	base, fragment, hasFragment := strings.Cut(rawURL, "#")
+	base, _, _ = strings.Cut(base, "?")
+	base += "?" + FormURLEncodePairs(pairs)
+	if hasFragment {
+		base += "#" + fragment
+	}
+	return base
+}
+
+// encodePathSegment percent-encodes a path segment like the WHATWG path
+// segment setter (`/` and `%`-less special chars are encoded).
+func encodePathSegment(segment string) string {
+	var b strings.Builder
+	for i := 0; i < len(segment); i++ {
+		c := segment[i]
+		switch {
+		case c <= 0x20 || c >= 0x7f, c == '"', c == '#', c == '<', c == '>', c == '?', c == '`',
+			c == '{', c == '}', c == '/', c == '\\', c == '%':
+			b.WriteByte('%')
+			b.WriteByte(upperHex[c>>4])
+			b.WriteByte(upperHex[c&15])
+		default:
+			b.WriteByte(c)
+		}
+	}
+	return b.String()
+}
+
+// pushPathSegments appends segments to the path of the url (`path_segments_mut().extend()`).
+func pushPathSegments(rawURL string, segments ...string) (string, error) {
+	if !CanBeABase(rawURL) {
+		return "", convertErr("Streaming server URL cannot be used as a base")
+	}
+	normalized := NormalizeURL(rawURL)
+	base, afterPath := normalized, ""
+	schemeEnd := strings.Index(normalized, "://") + 3
+	if idx := strings.IndexAny(normalized[schemeEnd:], "?#"); idx >= 0 {
+		base, afterPath = normalized[:schemeEnd+idx], normalized[schemeEnd+idx:]
+	}
+	pathStart := schemeEnd + strings.Index(normalized[schemeEnd:], "/")
+	for _, segment := range segments {
+		if segment == "." || segment == ".." {
+			continue
+		}
+		if len(base) > pathStart+1 {
+			base += "/"
+		}
+		base += encodePathSegment(segment)
+	}
+	return base + afterPath, nil
+}
+
+func lzArchiveURL(streamingServerURL, path string, payload any) (string, error) {
+	streamURL, err := URLJoin(streamingServerURL, path)
+	if err != nil {
+		return "", convertErr(err.Error())
+	}
+	data, err := MarshalJSON(payload)
+	if err != nil {
+		return "", convertErr(err.Error())
+	}
+	return appendQueryPairs(streamURL, []QueryPair{{Key: "lz", Value: LzCompressToEncodedURIComponent(string(data))}}), nil
+}
+
+// ArchiveStreamBody is the payload of an archive stream request.
+type ArchiveStreamBody struct {
+	Urls            []ArchiveURL
+	FileIdx         *uint16
+	FileMustInclude []string
+}
+
+func (b ArchiveStreamBody) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(struct {
+		Urls            []ArchiveURL `json:"urls"`
+		FileIdx         *uint16      `json:"fileIdx,omitempty"`
+		FileMustInclude []string     `json:"fileMustInclude,omitempty"`
+	}{nonNilSlice(b.Urls), b.FileIdx, b.FileMustInclude})
+}
+
+var archiveNames = map[string]string{
+	StreamSourceRar:  "Rar",
+	StreamSourceZip:  "Zip",
+	StreamSourceZip7: "7zip",
+	StreamSourceTgz:  "tgz",
+	StreamSourceTar:  "tar",
+}
+
+var archivePaths = map[string]string{
+	StreamSourceRar:  "rar/create",
+	StreamSourceZip:  "zip/create",
+	StreamSourceZip7: "7zip/create",
+	StreamSourceTgz:  "tgz/create",
+	StreamSourceTar:  "tar/create",
+}
+
+// Convert converts the stream source through the streaming server, i.e.
+// creates the streaming urls for archives, torrents, YouTube and proxied streams.
+func (s Stream) Convert(streamingServerURL *string) (ConvertedStream, error) {
+	source := s.Source
+	switch {
+	case source.IsArchive() && streamingServerURL != nil:
+		if len(source.Urls) == 0 {
+			return ConvertedStream{}, convertErr(fmt.Sprintf("No %s URLs provided", archiveNames[source.Kind]))
+		}
+		urls := make([]ArchiveURL, 0, len(source.Urls))
+		for _, archiveURL := range source.Urls {
+			handled, err := ftpURLHandler(streamingServerURL, archiveURL.URL)
+			if err != nil {
+				return ConvertedStream{}, err
+			}
+			urls = append(urls, ArchiveURL{URL: NormalizeURL(handled), Bytes: archiveURL.Bytes})
+		}
+		if !CanBeABase(*streamingServerURL) {
+			return ConvertedStream{}, convertErr("relative URL with a cannot-be-a-base base")
+		}
+		streamURL, err := lzArchiveURL(*streamingServerURL, archivePaths[source.Kind], ArchiveStreamBody{
+			Urls:            urls,
+			FileIdx:         source.FileIdx,
+			FileMustInclude: source.FileMustInclude,
+		})
+		if err != nil {
+			return ConvertedStream{}, err
+		}
+		return s.toConverted(ConvertedStreamSource{Kind: StreamSourceURL, URL: streamURL}), nil
+	case source.Kind == StreamSourceNzb && streamingServerURL != nil:
+		if len(source.Servers) == 0 {
+			return ConvertedStream{}, convertErr("No nzb server URLs provided")
+		}
+		handle := func(values []string) ([]string, error) {
+			result := make([]string, 0, len(values))
+			for _, value := range values {
+				handled, err := ftpURLHandler(streamingServerURL, value)
+				if err != nil {
+					return nil, err
+				}
+				result = append(result, NormalizeURL(handled))
+			}
+			return result, nil
+		}
+		servers, err := handle(source.Servers)
+		if err != nil {
+			return ConvertedStream{}, err
+		}
+		payload := StreamSource{Kind: StreamSourceNzb, Servers: servers}
+		if source.NzbURL != nil {
+			handled, err := ftpURLHandler(streamingServerURL, *source.NzbURL)
+			if err != nil {
+				return ConvertedStream{}, err
+			}
+			handled = NormalizeURL(handled)
+			payload.NzbURL = &handled
+		}
+		if payload.NzbUrls, err = handle(source.NzbUrls); err != nil {
+			return ConvertedStream{}, err
+		}
+		streamURL, err := lzArchiveURL(*streamingServerURL, "nzb/create", payload)
+		if err != nil {
+			return ConvertedStream{}, err
+		}
+		return s.toConverted(ConvertedStreamSource{Kind: StreamSourceURL, URL: streamURL}), nil
+	case (source.IsArchive() || source.Kind == StreamSourceNzb) && streamingServerURL == nil:
+		return ConvertedStream{}, convertErr("Can't play Rar/Zip/Zip7/Tar/Tgz/Nzb because the streaming server is not running")
+	case source.Kind == StreamSourceURL && URLScheme(source.URL) != "magnet":
+		streamURL, err := ftpURLHandler(streamingServerURL, source.URL)
+		if err != nil {
+			return ConvertedStream{}, err
+		}
+		if s.BehaviorHints.ProxyHeaders != nil && streamingServerURL != nil {
+			streamURL, err = proxiedURL(*streamingServerURL, streamURL, *s.BehaviorHints.ProxyHeaders)
+			if err != nil {
+				return ConvertedStream{}, err
+			}
+		}
+		return s.toConverted(ConvertedStreamSource{Kind: StreamSourceURL, URL: NormalizeURL(streamURL)}), nil
+	case source.Kind == StreamSourceURL:
+		return s.toConverted(ConvertedStreamSource{Kind: StreamSourceURL, URL: NormalizeURL(source.URL)}), nil
+	case source.Kind == StreamSourceYouTube && streamingServerURL != nil:
+		streamURL, err := pushPathSegments(*streamingServerURL, "yt", EncodeURIComponent(source.YtID))
+		if err != nil {
+			return ConvertedStream{}, err
+		}
+		return s.toConverted(ConvertedStreamSource{Kind: StreamSourceYouTube, URL: streamURL, YtID: source.YtID}), nil
+	case source.Kind == StreamSourceYouTube:
+		return ConvertedStream{}, convertErr("Can't play Youtube videos because streaming server is not running")
+	case source.Kind == StreamSourceTorrent && streamingServerURL != nil:
+		fileIdx := "-1"
+		if source.FileIdx != nil {
+			fileIdx = strconv.Itoa(int(*source.FileIdx))
+		}
+		streamURL, err := pushPathSegments(*streamingServerURL, source.InfoHash.String(), fileIdx)
+		if err != nil {
+			return ConvertedStream{}, err
+		}
+		pairs := []QueryPair{}
+		for _, tracker := range source.Announce {
+			pairs = append(pairs, QueryPair{Key: "tr", Value: tracker})
+		}
+		for _, include := range source.FileMustInclude {
+			pairs = append(pairs, QueryPair{Key: "f", Value: include})
+		}
+		streamURL = appendQueryPairs(streamURL, pairs)
+		return s.toConverted(ConvertedStreamSource{
+			Kind:            StreamSourceTorrent,
+			URL:             streamURL,
+			InfoHash:        source.InfoHash,
+			FileIdx:         source.FileIdx,
+			Announce:        nonNilSlice(source.Announce),
+			FileMustInclude: source.FileMustInclude,
+		}), nil
+	case source.Kind == StreamSourceTorrent:
+		return ConvertedStream{}, convertErr("Can't play Torrents because streaming server is not running")
+	case source.Kind == StreamSourcePlayerFrame:
+		return s.toConverted(ConvertedStreamSource{Kind: StreamSourcePlayerFrame, PlayerFrameURL: source.PlayerFrameURL}), nil
+	case source.Kind == StreamSourceExternal:
+		return s.toConverted(ConvertedStreamSource{
+			Kind:         StreamSourceExternal,
+			ExternalURL:  source.ExternalURL,
+			AndroidTvURL: source.AndroidTvURL,
+			TizenURL:     source.TizenURL,
+			WebosURL:     source.WebosURL,
+		}), nil
+	}
+	return ConvertedStream{}, convertErr(fmt.Sprintf("Unsupported stream source %q", source.Kind))
+}
+
+func proxiedURL(streamingServerURL, streamURL string, headers StreamProxyHeaders) (string, error) {
+	if !CanBeABase(streamingServerURL) {
+		return "", convertErr("Streaming server URL cannot be used as a base")
+	}
+	normalizedStream := NormalizeURL(streamURL)
+	schemeEnd := strings.Index(normalizedStream, "://") + 3
+	rest := normalizedStream[schemeEnd:]
+	authorityEnd := strings.IndexAny(rest, "/?#")
+	if authorityEnd < 0 {
+		authorityEnd = len(rest)
+	}
+	authority := rest[:authorityEnd]
+	pathAndQuery := rest[authorityEnd:]
+	pathAndQuery, _, _ = strings.Cut(pathAndQuery, "#")
+	path, query, hasQuery := strings.Cut(pathAndQuery, "?")
+	origin := normalizedStream[:schemeEnd] + authority
+
+	pairs := []QueryPair{{Key: "d", Value: origin}}
+	for _, key := range sortedKeys(headers.Request) {
+		pairs = append(pairs, QueryPair{Key: "h", Value: key + ":" + headers.Request[key]})
+	}
+	for _, key := range sortedKeys(headers.Response) {
+		pairs = append(pairs, QueryPair{Key: "r", Value: key + ":" + headers.Response[key]})
+	}
+	server := NormalizeURL(streamingServerURL)
+	server, _, _ = strings.Cut(server, "#")
+	server, _, _ = strings.Cut(server, "?")
+	serverSchemeEnd := strings.Index(server, "://") + 3
+	serverPathStart := serverSchemeEnd + strings.Index(server[serverSchemeEnd:], "/")
+	result := server[:serverPathStart] + "/proxy/" + FormURLEncodePairs(pairs) + "/" + strings.TrimPrefix(path, "/")
+	if hasQuery {
+		result += "?" + query
+	}
+	return result, nil
+}
+
+func sortedKeys(values map[string]string) []string {
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// StreamUrls are the urls generated for a converted stream.
+type StreamUrls struct {
+	MagnetURL    *string
+	DownloadURL  *string
+	StreamingURL *string
+	M3uDataURI   *string
+	// Stream is the stream for which the urls were generated.
+	Stream ConvertedStream
+}
+
+func (u StreamUrls) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(struct {
+		MagnetURL    *string         `json:"magnet_url"`
+		DownloadURL  *string         `json:"download_url"`
+		StreamingURL *string         `json:"streaming_url"`
+		M3uDataURI   *string         `json:"m3u_data_uri"`
+		Stream       ConvertedStream `json:"stream"`
+	}{u.MagnetURL, u.DownloadURL, u.StreamingURL, u.M3uDataURI, u.Stream})
+}
+
+// NewStreamUrls generates the urls of an already converted stream.
+func NewStreamUrls(converted ConvertedStream, streamingServerURL *string) StreamUrls {
+	streamingURL := getStreamingURL(converted)
+	urls := StreamUrls{
+		MagnetURL:    getMagnetURL(converted),
+		DownloadURL:  getDownloadURL(converted, streamingServerURL),
+		StreamingURL: streamingURL,
+		Stream:       converted,
+	}
+	if streamingURL != nil {
+		dataURI := M3uDataURI(*streamingURL)
+		urls.M3uDataURI = &dataURI
+	}
+	return urls
+}
+
+// M3uDataURI returns a playlist data uri for the streaming url.
+func M3uDataURI(streamingURL string) string {
+	return "data:application/octet-stream;charset=utf-8;base64," +
+		base64.StdEncoding.EncodeToString([]byte("#EXTM3U\n#EXTINF:0\n"+streamingURL))
+}
+
+func strPtr(value string) *string { return &value }
+
+func getMagnetURL(converted ConvertedStream) *string {
+	source := converted.Source
+	switch {
+	case source.Kind == StreamSourceURL && URLScheme(source.URL) == "magnet":
+		magnet, err := ParseMagnet(source.URL)
+		if err != nil {
+			return nil
+		}
+		return strPtr(magnet.String())
+	case source.Kind == StreamSourceTorrent:
+		magnet, err := ParseMagnet(BuildMagnetURI(source.InfoHash[:], source.Announce, converted.Name))
+		if err != nil {
+			return nil
+		}
+		return strPtr(magnet.String())
+	}
+	return nil
+}
+
+func getDownloadURL(converted ConvertedStream, streamingServerURL *string) *string {
+	source := converted.Source
+	switch source.Kind {
+	case StreamSourceURL:
+		if URLScheme(source.URL) == "magnet" {
+			return nil
+		}
+		return strPtr(NormalizeURL(source.URL))
+	case StreamSourceTorrent:
+		if streamingServerURL == nil {
+			return nil
+		}
+		return strPtr(setQueryPairs(source.URL, []QueryPair{{Key: "external", Value: "1"}, {Key: "download", Value: "1"}}))
+	case StreamSourceYouTube:
+		return strPtr("https://youtube.com/watch?v=" + EncodeURIComponent(source.YtID))
+	case StreamSourceExternal:
+		if source.ExternalURL == nil {
+			return nil
+		}
+		return strPtr(NormalizeURL(*source.ExternalURL))
+	case StreamSourcePlayerFrame:
+		return strPtr(NormalizeURL(source.PlayerFrameURL))
+	}
+	return nil
+}
+
+func getStreamingURL(converted ConvertedStream) *string {
+	source := converted.Source
+	switch source.Kind {
+	case StreamSourceURL:
+		if URLScheme(source.URL) == "magnet" {
+			return nil
+		}
+		return strPtr(NormalizeURL(source.URL))
+	case StreamSourceTorrent, StreamSourceYouTube:
+		return strPtr(NormalizeURL(source.URL))
+	}
+	return nil
+}
+
+// DownloadURLFromSource generates a download url from the source without a
+// conversion (i.e. when the streaming server is not running).
+func DownloadURLFromSource(stream Stream) *string {
+	source := stream.Source
+	switch source.Kind {
+	case StreamSourceURL:
+		return strPtr(NormalizeURL(source.URL))
+	case StreamSourceTorrent:
+		return strPtr(BuildMagnetURI(source.InfoHash[:], source.Announce, stream.Name))
+	case StreamSourceYouTube:
+		return strPtr("https://youtube.com/watch?v=" + EncodeURIComponent(source.YtID))
+	case StreamSourceExternal:
+		if source.ExternalURL == nil {
+			return nil
+		}
+		return strPtr(NormalizeURL(*source.ExternalURL))
+	case StreamSourcePlayerFrame:
+		return strPtr(NormalizeURL(source.PlayerFrameURL))
+	}
+	return nil
+}
