+		SubtitlesPath: &types.ResourcePath{Resource: stremiocore.SUBTITLES_RESOURCE_NAME, Type: "series", ID: "tt123456:1:1", Extra: []types.ExtraValue{}},
+	}))
+	return rt, m, env, rx
+}
