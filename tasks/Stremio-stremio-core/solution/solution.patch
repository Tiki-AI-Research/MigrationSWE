@@ -0,0 +1,53 @@
+package ctx_test
+
+import (
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of src/unit_tests/ctx/delete_account.rs
+
+func TestActionCtxDeleteAccount(t *testing.T) {
+	env := newTestEnv(time.Time{})
+	const deleteUserURL = "https://api.strem.io/api/deleteUser"
+	const deleteUserBody = `{"type":"DeleteAccount","authKey":"auth_key","password":"password"}`
+	setRoutes(t, env, fetchRoute{
+		Method:   "POST",
+		URL:      deleteUserURL,
+		Body:     deleteUserBody,
+		Response: apiSuccess,
+	})
+	profile := loggedInProfile(userFixture(env.Now()))
+	setStorage(t, env, stremiocore.PROFILE_STORAGE_KEY, profile)
+	h := newHarness(t, env, withProfileAndLibrary(env, profile, types.NewLibraryBucket(nil, nil)))
+	h.dispatchCtx(msg.ActionCtxDeleteAccount, types.Password("password"))
+
+	assertEqual(t, h.ctx().Profile, types.NewProfile(), "profile updated successfully in memory")
+	stored, ok := storageValue[types.Profile](t, env, stremiocore.PROFILE_STORAGE_KEY)
+	if !ok {
+		t.Errorf("profile updated successfully in storage: missing key")
+	}
+	assertEqual(t, stored, types.NewProfile(), "profile updated successfully in storage")
+	if len(env.Requests) != 1 {
+		t.Errorf("One request have been sent, got %d: %s", len(env.Requests), describeRequests(env.Requests))
+	}
+	assertRequests(t, env, fetchRoute{Method: "POST", URL: deleteUserURL, Body: deleteUserBody})
+
+	// the account is deleted: `Logout(true)`, the session is not deleted
+	// and the (default) library is not persisted
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventUserLoggedOut,
+		msg.EventProfilePushedToStorage,
+		msg.EventSearchHistoryPushedToStorage,
+		msg.EventDismissedEventsPushedToStorage,
+	}, "events")
+	assertEvent(t, h.findEvent(msg.EventUserLoggedOut), msg.EventUserLoggedOut, `{"uid":"user_id"}`, "UserLoggedOut")
+	assertEvent(t, h.findEvent(msg.EventProfilePushedToStorage), msg.EventProfilePushedToStorage, `{"uid":null}`, "ProfilePushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventSearchHistoryPushedToStorage), msg.EventSearchHistoryPushedToStorage, `{"uid":null}`, "SearchHistoryPushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventDismissedEventsPushedToStorage), msg.EventDismissedEventsPushedToStorage, `{"uid":null}`, "DismissedEventsPushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
diff --git a/models/ctx/error.go b/models/ctx/error.go
new file mode 100644
index 0000000000000000000000000000000000000000..d1c1040fa350b32cdc8196cf02d89075c2a757cb
--- /dev/null
+++ b/models/ctx/error.go
@@ -0,0 +1,149 @@
+package ctx
+
+import (
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+// CtxError types.
+const (
+	CtxErrorAPI   = "API"
+	CtxErrorEnv   = "Env"
+	CtxErrorOther = "Other"
+)
+
+// CtxError is an error of the Ctx: an API error, an Env error or an other
+// error, serialized with a `type` tag.
+type CtxError struct {
+	Type  string
+	API   *types.APIError
+	Env   *runtime.EnvError
+	Other *OtherError
+}
+
+// NewAPIError wraps an API error.
+func NewAPIError(err *types.APIError) *CtxError {
+	return &CtxError{Type: CtxErrorAPI, API: err}
+}
+
+// NewEnvError wraps an Env error.
+func NewEnvError(err *runtime.EnvError) *CtxError {
+	return &CtxError{Type: CtxErrorEnv, Env: err}
+}
+
+// NewOtherError wraps an other error.
+func NewOtherError(err OtherError) *CtxError {
+	return &CtxError{Type: CtxErrorOther, Other: &err}
+}
+
+func (e *CtxError) Error() string {
+	switch e.Type {
+	case CtxErrorAPI:
+		if e.API != nil {
+			return e.API.Message
+		}
+	case CtxErrorEnv:
+		if e.Env != nil {
+			return e.Env.Message
+		}
+	case CtxErrorOther:
+		if e.Other != nil {
+			return e.Other.Message()
+		}
+	}
+	return e.Type
+}
+
+func (e *CtxError) MarshalJSON() ([]byte, error) {
+	tag := []byte(`{"type":"` + e.Type + `"}`)
+	var content []byte
+	var err error
+	switch e.Type {
+	case CtxErrorAPI:
+		content, err = types.MarshalJSON(e.API)
+	case CtxErrorEnv:
+		content, err = types.MarshalJSON(e.Env)
+	case CtxErrorOther:
+		content, err = types.MarshalJSON(e.Other)
+	}
+	if err != nil {
+		return nil, err
+	}
+	return mergeObjects(tag, content), nil
+}
+
+func mergeObjects(a, b []byte) []byte {
+	if len(b) <= 2 || b[0] != '{' {
+		return a
+	}
+	merged := append([]byte{}, a[:len(a)-1]...)
+	merged = append(merged, ',')
+	return append(merged, b[1:]...)
+}
+
+// OtherError is an error which is neither an API nor an Env error.
+type OtherError int
+
+const (
+	OtherErrorUserNotLoggedIn OtherError = iota + 1
+	OtherErrorLibraryItemNotFound
+	OtherErrorAddonAlreadyInstalled
+	OtherErrorAddonNotInstalled
+	OtherErrorAddonIsProtected
+	OtherErrorAddonConfigurationRequired
+	OtherErrorUserAddonsAreLocked
+	OtherErrorUserLibraryIsMissing
+	OtherErrorInvalidStreamingServerURL
+)
+
+// Code returns the code of the error.
+func (e OtherError) Code() uint64 {
+	return uint64(e)
+}
+
+// Message returns the message of the error.
+func (e OtherError) Message() string {
+	switch e {
+	case OtherErrorUserNotLoggedIn:
+		return "User is not logged in"
+	case OtherErrorLibraryItemNotFound:
+		return "Item is not found in library"
+	case OtherErrorAddonAlreadyInstalled:
+		return "Addon is already installed"
+	case OtherErrorAddonNotInstalled:
+		return "Addon is not installed"
+	case OtherErrorAddonIsProtected:
+		return "Addon is protected"
+	case OtherErrorAddonConfigurationRequired:
+		return "Addon requires configuration"
+	case OtherErrorUserAddonsAreLocked:
+		return "Fetching Addons from the API failed and we have defaulted the addons to the officials ones until the request succeeds"
+	case OtherErrorUserLibraryIsMissing:
+		return "Fetching Library from the API failed and we have defaulted to empty library until the request succeeds"
+	case OtherErrorInvalidStreamingServerURL:
+		return "Streaming server URL must be http or https"
+	}
+	return "Unknown error"
+}
+
+func (e OtherError) Error() string {
+	return e.Message()
+}
+
+func (e OtherError) MarshalJSON() ([]byte, error) {
+	return types.MarshalJSON(struct {
+		Code    uint64 `json:"code"`
+		Message string `json:"message"`
+	}{e.Code(), e.Message()})
+}
+
+// CtxErrorFromAPIResult converts the error of an API request.
+func CtxErrorFromAPIResult(apiErr *types.APIError, envErr *runtime.EnvError) *CtxError {
+	switch {
+	case envErr != nil:
+		return NewEnvError(envErr)
+	case apiErr != nil:
+		return NewAPIError(apiErr)
+	}
+	return nil
+}
diff --git a/models/ctx/harness_test.go b/models/ctx/harness_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..cb54782cacfaf5c62778fdf906ab2fde72cf2f24
--- /dev/null
+++ b/models/ctx/harness_test.go
@@ -0,0 +1,419 @@
+package ctx_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Shared test harness of the Ctx tests: a model wrapping only the Ctx (rust
+// `TestModel { ctx: Ctx }`), helpers to dispatch actions and internal
+// messages, to collect the runtime events and to fake the API.
+
+const fieldCtx = "ctx"
+
+// internalTestAction is a test-only action carrying an internal message to
+// dispatch (the runtime only dispatches actions).
+const internalTestAction = "__TestInternal"
+
+// testModel is the model of the Ctx tests: `{ ctx: Ctx }`.
+type testModel struct {
+	env runtime.Env
+	Ctx *ctx.Ctx
+
+	mu       sync.Mutex
+	internal map[string]*msg.Msg
+	next     int
+}
+
+func (m *testModel) Update(message *msg.Msg) ([]runtime.Effect, []string) {
+	if message.IsAction(internalTestAction) {
+		var id string
+		if err := json.Unmarshal(message.Action.Args, &id); err != nil {
+			panic(err)
+		}
+		m.mu.Lock()
+		message = m.internal[id]
+		delete(m.internal, id)
+		m.mu.Unlock()
+	}
+	effects := m.Ctx.Update(m.env, message)
+	fields := []string{}
+	if effects.HasChanged {
+		fields = append(fields, fieldCtx)
+	}
+	return effects.Effects, fields
+}
+
+func (m *testModel) UpdateField(message *msg.Msg, field string) ([]runtime.Effect, []string) {
+	if field != fieldCtx {
+		return []runtime.Effect{}, []string{}
+	}
+	return m.Update(message)
+}
+
+// harness runs a testModel in a runtime with a testenv.Env.
+type harness struct {
+	t      *testing.T
+	env    *testenv.Env
+	model  *testModel
+	rt     *runtime.Runtime
+	rx     <-chan runtime.RuntimeEvent
+	events []runtime.RuntimeEvent
+}
+
+// newHarness creates the runtime for the Ctx.
+func newHarness(t *testing.T, env *testenv.Env, c *ctx.Ctx) *harness {
+	t.Helper()
+	model := &testModel{env: env, Ctx: c, internal: map[string]*msg.Msg{}}
+	rt, rx := runtime.New(model, nil, 1000, env)
+	return &harness{t: t, env: env, model: model, rt: rt, rx: rx}
+}
+
+// ctx returns the Ctx of the model.
+func (h *harness) ctx() *ctx.Ctx {
+	return h.model.Ctx
+}
+
+// dispatch dispatches the action to the whole model.
+func (h *harness) dispatch(action *msg.Action) {
+	h.rt.Dispatch(runtime.RuntimeAction{Action: action})
+	h.drain()
+}
+
+// dispatchCtx dispatches the `Ctx` action named name with the args (nil for
+// a unit variant), i.e. `Action::Ctx(ActionCtx::<name>(args))`.
+func (h *harness) dispatchCtx(name string, args any) {
+	h.dispatch(msg.NewAction(msg.ActionNameCtx, msg.NewAction(name, args)))
+}
+
+// dispatchInternal dispatches the internal message, e.g.
+// `Msg::Internal(Internal::CatalogsWithExtraSearch { query })`.
+func (h *harness) dispatchInternal(name string, data any) {
+	h.model.mu.Lock()
+	h.model.next++
+	id := strconv.Itoa(h.model.next)
+	h.model.internal[id] = msg.InternalMsg(msg.NewInternal(name, data))
+	h.model.mu.Unlock()
+	h.dispatch(msg.NewAction(internalTestAction, id))
+}
+
+// drain collects the runtime events emitted so far.
+func (h *harness) drain() []runtime.RuntimeEvent {
+	// the testenv runs all the futures before Dispatch returns and the
+	// channel buffer is large enough, so all the events are already there
+	for {
+		select {
+		case event := <-h.rx:
+			h.events = append(h.events, event)
+		default:
+			return h.events
+		}
+	}
+}
+
+// clearEvents forgets the collected events.
+func (h *harness) clearEvents() {
+	h.drain()
+	h.events = nil
+}
+
+// coreEvents returns the collected core events.
+func (h *harness) coreEvents() []*msg.Event {
+	events := []*msg.Event{}
+	for _, event := range h.events {
+		if e := event.Event(); e != nil {
+			events = append(events, e)
+		}
+	}
+	return events
+}
+
+// coreEventNames returns the names of the collected core events.
+func (h *harness) coreEventNames() []string {
+	names := []string{}
+	for _, event := range h.coreEvents() {
+		names = append(names, event.Event)
+	}
+	return names
+}
+
+// newStates returns the fields of the collected `NewState` events.
+func (h *harness) newStates() [][]string {
+	states := [][]string{}
+	for _, event := range h.events {
+		if event.Name == runtime.RuntimeEventNewState {
+			states = append(states, event.Fields())
+		}
+	}
+	return states
+}
+
+// findEvent returns the first collected core event named name.
+func (h *harness) findEvent(name string) *msg.Event {
+	for _, event := range h.coreEvents() {
+		if event.Event == name {
+			return event
+		}
+	}
+	return nil
+}
+
+//
+// Env and fixtures
+//
+
+// newTestEnv creates a test env with the given time (the current time if zero).
+func newTestEnv(now time.Time) *testenv.Env {
+	env := testenv.New()
+	if !now.IsZero() {
+		env.SetNow(now)
+	}
+	return env
+}
+
+// date returns the UTC midnight of the date.
+func date(year int, month time.Month, day int) time.Time {
+	return time.Date(year, month, day, 0, 0, 0, 0, time.UTC)
+}
+
+// datetime returns the UTC time.
+func datetime(year int, month time.Month, day, hour, minute, second int) time.Time {
+	return time.Date(year, month, day, hour, minute, second, 0, time.UTC)
+}
+
+func timePtr(t time.Time) *time.Time {
+	return &t
+}
+
+func strPtr(s string) *string {
+	return &s
+}
+
+func uid(id string) types.UID {
+	return types.NewUID(id)
+}
+
+// newCtx creates the Ctx like rust `Ctx::new`.
+func newCtx(
+	profile types.Profile,
+	library types.LibraryBucket,
+	streams types.StreamsBucket,
+	serverURLs types.ServerUrlsBucket,
+	notifications types.NotificationsBucket,
+	searchHistory types.SearchHistoryBucket,
+	dismissedEvents types.DismissedEventsBucket,
+) *ctx.Ctx {
+	return ctx.New(profile, library, streams, serverURLs, notifications, searchHistory, dismissedEvents)
+}
+
+// defaultCtx is `Ctx::new` with the default buckets of a logged out user
+// (rust `Profile::default()`, `LibraryBucket::default()`, ...,
+// `ServerUrlsBucket::new::<TestEnv>(None)`, `NotificationsBucket::new::<TestEnv>(None, vec![])`).
+func defaultCtx(env runtime.Env) *ctx.Ctx {
+	return withProfileAndLibrary(env, types.NewProfile(), types.NewLibraryBucket(nil, nil))
+}
+
+// withProfileAndLibrary is defaultCtx with the given profile and library.
+func withProfileAndLibrary(env runtime.Env, profile types.Profile, library types.LibraryBucket) *ctx.Ctx {
+	return newCtx(
+		profile,
+		library,
+		types.NewStreamsBucket(nil),
+		types.NewServerUrlsBucket(env.Now(), nil),
+		types.NewNotificationsBucket(env.Now(), nil, nil),
+		types.NewSearchHistoryBucket(nil),
+		types.NewDismissedEventsBucket(nil),
+	)
+}
+
+// userFixture is the test user (id "user_id", email "user_email").
+func userFixture(now time.Time) types.User {
+	return types.User{
+		ID:             "user_id",
+		Email:          "user_email",
+		LastModified:   now,
+		DateRegistered: now,
+		GDPRConsent: types.GDPRConsent{
+			Tos:       true,
+			Privacy:   true,
+			Marketing: true,
+			From:      strPtr("tests"),
+		},
+	}
+}
+
+// loggedInProfile is `Profile { auth: Some(Auth { key: "auth_key", user }), ..Default::default() }`.
+func loggedInProfile(user types.User) types.Profile {
+	profile := types.NewProfile()
+	profile.Auth = &types.Auth{Key: "auth_key", User: user}
+	return profile
+}
+
+//
+// Fake API
+//
+
+// fetchRoute is a request handled by the fake API: method, url and exact body.
+type fetchRoute struct {
+	Method   string
+	URL      string
+	Body     string
+	Response string
+}
+
+// apiOK returns the API response `{"result": value}`.
+func apiOK(value any) string {
+	return `{"result":` + string(types.MustMarshalJSON(value)) + `}`
+}
+
+// apiOKRaw returns the API response `{"result": <raw json>}`.
+func apiOKRaw(raw string) string {
+	return `{"result":` + raw + `}`
+}
+
+// apiError returns the API response `{"error": {"message": ..., "code": ...}}`.
+func apiError(code uint64, message string) string {
+	return `{"error":` + string(types.MustMarshalJSON(types.APIError{Message: message, Code: code})) + `}`
+}
+
+// apiSuccess is the `{"result": {"success": true}}` response.
+const apiSuccess = `{"result":{"success":true}}`
+
+// setRoutes makes the env answer the given requests; any other request
+// fails the test (rust `default_fetch_handler` panics).
+func setRoutes(t *testing.T, env *testenv.Env, routes ...fetchRoute) {
+	t.Helper()
+	env.FetchFn = func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		for _, route := range routes {
+			if route.Method == method && route.URL == url && route.Body == string(body) {
+				return []byte(route.Response), nil
+			}
+		}
+		t.Errorf("Unhandled fetch request: %s %s %s", method, url, body)
+		return nil, runtime.EnvErrorFetch(fmt.Sprintf("Unhandled fetch request: %s %s", method, url))
+	}
+}
+
+// assertRequests checks the sent requests (method, url and exact body).
+func assertRequests(t *testing.T, env *testenv.Env, expected ...fetchRoute) {
+	t.Helper()
+	if len(env.Requests) != len(expected) {
+		t.Errorf("expected %d requests, got %d: %s", len(expected), len(env.Requests), describeRequests(env.Requests))
+		return
+	}
+	for i, request := range env.Requests {
+		if request.Method != expected[i].Method || request.URL != expected[i].URL || string(request.Body) != expected[i].Body {
+			t.Errorf("request %d:\n got: %s %s %s\nwant: %s %s %s", i,
+				request.Method, request.URL, request.Body,
+				expected[i].Method, expected[i].URL, expected[i].Body)
+		}
+	}
+}
+
+func describeRequests(requests []testenv.Request) string {
+	var b bytes.Buffer
+	for _, request := range requests {
+		fmt.Fprintf(&b, "\n  %s %s %s", request.Method, request.URL, request.Body)
+	}
+	return b.String()
+}
+
+//
+// Storage
+//
+
+// storageValue decodes the value stored under the key; it reports whether the key exists.
+func storageValue[T any](t *testing.T, env *testenv.Env, key string) (T, bool) {
+	t.Helper()
+	var value T
+	raw, ok := env.Storage[key]
+	if !ok {
+		return value, false
+	}
+	if err := json.Unmarshal(raw, &value); err != nil {
+		t.Fatalf("storage %s: %v: %s", key, err, raw)
+	}
+	return value, true
+}
+
+// setStorage stores the JSON of the value under the key.
+func setStorage(t *testing.T, env *testenv.Env, key string, value any) {
+	t.Helper()
+	if err := env.SetStorage(key, value); err != nil {
+		t.Fatalf("set storage %s: %v", key, err)
+	}
+}
+
+//
+// Assertions
+//
+
+// assertEqual compares the values with types.Equal (rust `PartialEq`).
+func assertEqual(t *testing.T, got, want any, message string) {
+	t.Helper()
+	if !types.Equal(got, want) {
+		t.Errorf("%s\n got: %s\nwant: %s", message, types.MustMarshalJSON(got), types.MustMarshalJSON(want))
+	}
+}
+
+// assertJSONEqual compares the JSON serializations of the values (as decoded JSON values).
+func assertJSONEqual(t *testing.T, got, want any, message string) {
+	t.Helper()
+	gotJSON, wantJSON := toJSON(t, got), toJSON(t, want)
+	var gotValue, wantValue any
+	if err := json.Unmarshal(gotJSON, &gotValue); err != nil {
+		t.Fatalf("%s: invalid json %s", message, gotJSON)
+	}
+	if err := json.Unmarshal(wantJSON, &wantValue); err != nil {
+		t.Fatalf("%s: invalid json %s", message, wantJSON)
+	}
+	if !reflect.DeepEqual(gotValue, wantValue) {
+		t.Errorf("%s\n got: %s\nwant: %s", message, gotJSON, wantJSON)
+	}
+}
+
+func toJSON(t *testing.T, value any) []byte {
+	t.Helper()
+	switch v := value.(type) {
+	case json.RawMessage:
+		return v
+	case []byte:
+		return v
+	case string:
+		return []byte(v)
+	}
+	data, err := types.MarshalJSON(value)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	return data
+}
+
+// assertEvent checks that the event has the name and the args (compared as JSON).
+func assertEvent(t *testing.T, event *msg.Event, name string, args any, message string) {
+	t.Helper()
+	if event == nil {
+		t.Errorf("%s: missing event %s", message, name)
+		return
+	}
+	if event.Event != name {
+		t.Errorf("%s: got event %s, want %s", message, event.Event, name)
+		return
+	}
+	assertJSONEqual(t, event.Args, args, message)
+}
+
+var _ = stremiocore.SCHEMA_VERSION
