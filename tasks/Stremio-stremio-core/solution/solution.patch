+package types
+
+import (
+	"encoding/json"
+	"errors"
+	"strconv"
+	"strings"
+)
+
+// Manifest is the addon manifest.
+type Manifest struct {
+	ID           string
+	Version      string
+	Name         string
+	ContactEmail *string
+	Description  *string
+	Logo         *string
+	Background   *string
+	// Types are the globally supported types; no types means none are supported.
+	Types     []string
+	Resources []ManifestResource
+	// IDPrefixes are the globally supported id prefixes (`nil` means any).
+	IDPrefixes    []string
+	Catalogs      []ManifestCatalog
+	AddonCatalogs []ManifestCatalog
+	BehaviorHints ManifestBehaviorHints
+}
+
+type manifestJSON struct {
+	ID            string                `json:"id"`
+	Version       string                `json:"version"`
+	Name          string                `json:"name"`
+	ContactEmail  *string               `json:"contactEmail"`
+	Description   *string               `json:"description"`
+	Logo          *string               `json:"logo"`
+	Background    *string               `json:"background"`
+	Types         []string              `json:"types"`
+	Resources     []ManifestResource    `json:"resources"`
+	IDPrefixes    []string              `json:"idPrefixes"`
+	Catalogs      []ManifestCatalog     `json:"catalogs"`
+	AddonCatalogs []ManifestCatalog     `json:"addonCatalogs"`
+	BehaviorHints ManifestBehaviorHints `json:"behaviorHints"`
+}
+
+func (m Manifest) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(manifestJSON{
+		ID:            m.ID,
+		Version:       m.Version,
+		Name:          m.Name,
+		ContactEmail:  m.ContactEmail,
+		Description:   m.Description,
+		Logo:          m.Logo,
+		Background:    m.Background,
+		Types:         nonNilSlice(m.Types),
+		Resources:     nonNilSlice(m.Resources),
+		IDPrefixes:    m.IDPrefixes,
+		Catalogs:      nonNilSlice(m.Catalogs),
+		AddonCatalogs: nonNilSlice(m.AddonCatalogs),
+		BehaviorHints: m.BehaviorHints,
+	})
+}
+
+func (m *Manifest) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		ID            *string                `json:"id"`
+		Version       *string                `json:"version"`
+		Name          *string                `json:"name"`
+		ContactEmail  *string                `json:"contactEmail"`
+		Description   *string                `json:"description"`
+		Logo          json.RawMessage        `json:"logo"`
+		Background    json.RawMessage        `json:"background"`
+		Types         *[]string              `json:"types"`
+		Resources     *[]ManifestResource    `json:"resources"`
+		IDPrefixes    []string               `json:"idPrefixes"`
+		Catalogs      []ManifestCatalog      `json:"catalogs"`
+		AddonCatalogs []ManifestCatalog      `json:"addonCatalogs"`
+		BehaviorHints *ManifestBehaviorHints `json:"behaviorHints"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.ID == nil || wire.Version == nil || wire.Name == nil || wire.Types == nil || wire.Resources == nil {
+		return errors.New("missing field of Manifest")
+	}
+	if _, err := ParseVersion(*wire.Version); err != nil {
+		return err
+	}
+	*m = Manifest{
+		ID:            *wire.ID,
+		Version:       *wire.Version,
+		Name:          *wire.Name,
+		ContactEmail:  wire.ContactEmail,
+		Description:   wire.Description,
+		Logo:          optionalURLDefaultOnError(wire.Logo),
+		Background:    optionalURLDefaultOnError(wire.Background),
+		Types:         *wire.Types,
+		Resources:     *wire.Resources,
+		IDPrefixes:    wire.IDPrefixes,
+		Catalogs:      uniqueCatalogs(wire.Catalogs),
+		AddonCatalogs: uniqueCatalogs(wire.AddonCatalogs),
+	}
+	if wire.BehaviorHints != nil {
+		m.BehaviorHints = *wire.BehaviorHints
+	}
+	return nil
+}
+
+// optionalURLDefaultOnError decodes an `Option<Url>` with
+// `DefaultOnError<NoneAsEmptyString>`: anything invalid becomes `nil`.
+func optionalURLDefaultOnError(data json.RawMessage) *string {
+	if isJSONNull(data) {
+		return nil
+	}
+	var value string
+	if err := json.Unmarshal(data, &value); err != nil {
+		return nil
+	}
+	if value == "" || !IsValidURL(value) {
+		return nil
+	}
+	return &value
+}
+
+func uniqueCatalogs(catalogs []ManifestCatalog) []ManifestCatalog {
+	result := []ManifestCatalog{}
+	seen := map[[2]string]bool{}
+	for _, catalog := range catalogs {
+		key := [2]string{catalog.ID, catalog.Type}
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		result = append(result, catalog)
+	}
+	return result
+}
+
+// IsResourceSupported reports whether the addon supports the resource path.
+func (m Manifest) IsResourceSupported(path ResourcePath) bool {
+	switch path.Resource {
+	case "catalog":
+		for _, catalog := range m.Catalogs {
+			if catalog.Type == path.Type && catalog.ID == path.ID && catalog.IsExtraSupported(path.Extra) {
+				return true
+			}
+		}
+		return false
+	case "addon_catalog":
+		for _, catalog := range m.AddonCatalogs {
+			if catalog.Type == path.Type && catalog.ID == path.ID && catalog.IsExtraSupported(path.Extra) {
+				return true
+			}
+		}
+		return false
+	}
+	var resource *ManifestResource
+	for i := range m.Resources {
+		if m.Resources[i].Name == path.Resource {
+			resource = &m.Resources[i]
+			break
+		}
+	}
+	if resource == nil {
+		return false
+	}
+	types, idPrefixes := m.Types, m.IDPrefixes
+	if resource.Full {
+		types, idPrefixes = resource.Types, resource.IDPrefixes
+	}
+	typeSupported := types != nil && containsString(types, path.Type)
+	return typeSupported && idSupportedByPrefixes(idPrefixes, path.ID)
+}
