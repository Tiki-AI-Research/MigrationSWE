+// NewCalendarDeepLinks creates the deep links of the month of the year.
+func NewCalendarDeepLinks(year, month int) CalendarDeepLinks {
+	return CalendarDeepLinks{
+		Calendar: "stremio:///calendar/" + strconv.Itoa(year) + "/" + strconv.Itoa(month),
+	}
+}
+
+// CalendarItemDeepLinks are the deep links of a calendar item.
+type CalendarItemDeepLinks struct {
