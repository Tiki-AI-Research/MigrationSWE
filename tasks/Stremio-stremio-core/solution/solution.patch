+}
+
+func (m MetaItemPreview) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(m.toJSON())
+}
+
+func (m *MetaItemPreview) UnmarshalJSON(data []byte) error {
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(data, &object); err != nil {
+		return err
+	}
+	if object == nil {
+		return errors.New("invalid type: null, expected struct MetaItemPreview")
+	}
+	preview, err := metaItemPreviewFromLegacy(object)
+	if err != nil {
+		return err
+	}
