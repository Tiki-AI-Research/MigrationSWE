+package ctx
+
+import (
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateProfile(env runtime.Env, profile *types.Profile, streams *types.StreamsBucket, status *CtxStatus, m *msg.Msg) runtime.Effects {
+	if m.IsInternal(msg.InternalLogout) {
+		nextProfile := types.NewProfile()
+		if !types.Equal(*profile, nextProfile) {
+			*profile = nextProfile
+			return profileChangedEffects()
+		}
+		return runtime.NoneEffects().Unchanged()
+	}
+	if action := ctxAction(m); action != nil {
+		return updateProfileWithAction(env, profile, m, action.Action)
+	}
+	if addon, ok := InternalDescriptorData(m, msg.InternalUninstallAddon); ok {
+		return uninstallAddon(env, profile, streams, addon)
+	}
+	if m.IsInternal(msg.InternalProfileChanged) {
+		return runtime.OneEffect(pushProfileToStorage(env, profile)).Unchanged()
+	}
+	if addon, ok := InternalDescriptorData(m, msg.InternalInstallAddon); ok {
+		return installAddon(env, profile, addon)
+	}
+	if result, ok := InternalCtxAuthResultData(m); ok {
+		if !status.IsLoading(result.AuthRequest) || result.Response == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		response := result.Response
+		auth := response.Auth
+		addons := response.Addons
+		if response.AddonsErr != nil {
+			addons = types.OfficialAddons()
+		}
+		nextProfile := types.Profile{
+			Auth:         &auth,
+			Addons:       append([]types.Descriptor{}, addons...),
+			AddonsLocked: response.AddonsErr != nil,
+			Settings:     types.NewSettings(),
+		}
+		if !types.Equal(*profile, nextProfile) {
+			*profile = nextProfile
+			return profileChangedEffects()
+		}
+		return runtime.NoneEffects().Unchanged()
+	}
+	if result, ok := InternalData[AddonsAPIResult](m, msg.InternalAddonsAPIResult); ok {
+		authKey := profile.AuthKey()
+		if result.Request.Type != types.APIRequestAddonCollectionGet || authKey == nil || *authKey != result.Request.AuthKey {
+			return runtime.NoneEffects().Unchanged()
+		}
+		var profileEffects runtime.Effects
+		if result.Err == nil {
+			transportURLs := transportURLsDiff(profile.Addons, result.Addons)
+			profileChanged := runtime.NoneEffects().Unchanged()
+			if !addonsEqual(profile.Addons, result.Addons) {
+				profile.Addons = append([]types.Descriptor{}, result.Addons...)
+				profileChanged = profileChangedEffects()
+			}
+			profileEffects = runtime.MsgEffects(msg.EventMsg(msg.TransportURLsEvent(msg.EventAddonsPulledFromAPI, transportURLs))).
+				Join(profileChanged)
+		} else {
+			profileEffects = errorEffects(result.Err, msg.TransportURLsEvent(msg.EventAddonsPulledFromAPI, nil))
+		}
+		// on successful AddonsApi result, unlock the addons if they have been locked
+		// on failed AddonsApi result, lock the addons
+		profile.AddonsLocked = result.Err != nil
+		addonsLockedEffects := eventEffects(addonsLockedEvent(profile.AddonsLocked))
+		return addonsLockedEffects.Join(profileEffects)
+	}
+	if result, ok := InternalData[UserAPIResult](m, msg.InternalUserAPIResult); ok {
+		authKey := profile.AuthKey()
+		if result.Request.Type != types.APIRequestGetUser ||
+			!(result.Overwritten || (authKey != nil && *authKey == result.Request.AuthKey)) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		if result.Err != nil {
+			sessionExpiredEffects := runtime.NoneEffects().Unchanged()
+			if result.Err.Type == CtxErrorAPI && result.Err.API != nil && result.Err.API.Code == 1 {
+				sessionExpiredEffects = runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalLogout, false))).Unchanged()
+			}
+			return errorEffects(result.Err, msg.UIDEvent(msg.EventUserPulledFromAPI, profile.UID())).
+				Join(sessionExpiredEffects)
+		}
+		if result.User == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		user := *result.User
+		if profile.Auth != nil && !types.Equal(profile.Auth.User, user) {
+			auth := *profile.Auth
+			auth.User = user
+			profile.Auth = &auth
+			return runtime.MsgEffects(msg.EventMsg(msg.UIDEvent(msg.EventUserPulledFromAPI, profile.UID()))).
+				Join(profileChangedEffects())
+		}
+		effects := runtime.MsgEffects(msg.EventMsg(msg.UIDEvent(msg.EventUserPulledFromAPI, profile.UID())))
+		if result.Overwritten {
+			profile.Auth = &types.Auth{Key: result.Request.AuthKey, User: user}
+			return effects.Join(profileChangedEffects())
+		}
+		return effects.Unchanged()
+	}
+	if result, ok := InternalData[DeleteAccountAPIResult](m, msg.InternalDeleteAccountAPIResult); ok {
+		authKey := profile.AuthKey()
+		if result.Request.Type != types.APIRequestDeleteAccount || authKey == nil || *authKey != result.Request.AuthKey {
+			return runtime.NoneEffects().Unchanged()
+		}
+		if result.Err != nil {
+			return errorEffects(result.Err, msg.UIDEvent(msg.EventUserAccountDeleted, profile.UID()))
+		}
+		return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalLogout, true))).Unchanged()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func updateProfileWithAction(env runtime.Env, profile *types.Profile, m *msg.Msg, name string) runtime.Effects {
+	switch name {
+	case msg.ActionCtxDeleteAccount:
+		var password types.Password
+		if !decodeStrictCtxAction(m, name, &password) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		if authKey := profile.AuthKey(); authKey != nil {
+			return runtime.OneEffect(deleteAccount(env, *authKey, password)).Unchanged()
+		}
+		return errorEffects(NewOtherError(OtherErrorUserNotLoggedIn), msg.UIDEvent(msg.EventUserAccountDeleted, profile.UID()))
+	case msg.ActionCtxPushUserToAPI:
+		if profile.Auth != nil {
+			return runtime.OneEffect(pushUserToAPI(env, profile.Auth.User, profile.Auth.Key)).Unchanged()
+		}
+		return errorEffects(NewOtherError(OtherErrorUserNotLoggedIn), msg.UIDEvent(msg.EventUserPushedToAPI, profile.UID()))
+	case msg.ActionCtxPullUserFromAPI:
+		var args struct {
+			Token *types.AuthKey `json:"token"`
+		}
+		if !decodeStrictCtxAction(m, name, &args) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		// the action token will take priority over the profile AuthKey
+		authKey := args.Token
+		if authKey == nil {
+			authKey = profile.AuthKey()
+		}
+		if authKey != nil {
+			return runtime.OneEffect(pullUserFromAPI(env, *authKey, args.Token != nil)).Unchanged()
+		}
+		return errorEffects(NewOtherError(OtherErrorUserNotLoggedIn), msg.UIDEvent(msg.EventUserPulledFromAPI, profile.UID()))
+	case msg.ActionCtxPushAddonsToAPI:
+		if authKey := profile.AuthKey(); authKey != nil {
+			return runtime.OneEffect(pushAddonsToAPI(env, profile.Addons, *authKey)).Unchanged()
+		}
+		return errorEffects(NewOtherError(OtherErrorUserNotLoggedIn),
+			msg.TransportURLsEvent(msg.EventAddonsPushedToAPI, transportURLs(profile.Addons)))
+	case msg.ActionCtxPullAddonsFromAPI:
+		if authKey := profile.AuthKey(); authKey != nil {
+			return runtime.OneEffect(pullAddonsFromAPI(env, *authKey)).Unchanged()
+		}
+		nextAddons := make([]types.Descriptor, 0, len(profile.Addons))
+		for _, profileAddon := range profile.Addons {
+			next := profileAddon
+			for _, officialAddon := range types.OFFICIAL_ADDONS {
+				if officialAddon.Manifest.ID == profileAddon.Manifest.ID &&
+					types.CompareVersions(officialAddon.Manifest.Version, profileAddon.Manifest.Version) > 0 {
+					official := types.Clone(officialAddon)
+					next = types.Descriptor{
+						TransportURL: official.TransportURL,
+						Manifest:     official.Manifest,
+						Flags:        profileAddon.Flags,
+					}
+					break
+				}
+			}
+			nextAddons = append(nextAddons, next)
+		}
+		transportURLs := transportURLsDiff(profile.Addons, nextAddons)
+		event := msg.TransportURLsEvent(msg.EventAddonsPulledFromAPI, transportURLs)
+		if !addonsEqual(profile.Addons, nextAddons) {
+			profile.Addons = nextAddons
+			return runtime.MsgEffects(msg.EventMsg(event)).Join(profileChangedEffects())
+		}
+		return eventEffects(event)
+	case msg.ActionCtxInstallAddon:
+		var addon types.Descriptor
+		if !decodeStrictCtxAction(m, name, &addon) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalInstallAddon, addon))).Unchanged()
+	case msg.ActionCtxUninstallAddon:
+		var addon types.Descriptor
+		if !decodeStrictCtxAction(m, name, &addon) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalUninstallAddon, addon))).Unchanged()
+	case msg.ActionCtxUpgradeAddon:
+		var addon types.Descriptor
+		if !decodeStrictCtxAction(m, name, &addon) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		return upgradeAddon(env, profile, addon)
+	case msg.ActionCtxLogoutTrakt:
+		if profile.Auth == nil {
+			return errorEffects(NewOtherError(OtherErrorUserNotLoggedIn), msg.UIDEvent(msg.EventTraktLoggedOut, profile.UID()))
+		}
+		if profile.Auth.User.Trakt == nil {
+			return eventEffects(msg.UIDEvent(msg.EventTraktLoggedOut, profile.UID()))
+		}
+		auth := *profile.Auth
+		auth.User.Trakt = nil
+		profile.Auth = &auth
+		pushToAPIEffects := runtime.OneEffect(pushUserToAPI(env, profile.Auth.User, profile.Auth.Key))
+		return runtime.MsgEffects(msg.EventMsg(msg.UIDEvent(msg.EventTraktLoggedOut, profile.UID()))).
+			Join(pushToAPIEffects).
+			// first uninstall the trakt addon
+			Join(runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalUninstallTraktAddon, nil)))).
+			Join(profileChangedEffects())
+	case msg.ActionCtxUpdateSettings:
+		var settings types.Settings
+		if !decodeStrictCtxAction(m, name, &settings) || !types.IsValidURL(settings.StreamingServerURL) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		event := msg.NewEvent(msg.EventSettingsUpdated, struct {
+			Settings types.Settings `json:"settings"`
+		}{settings})
+		switch scheme := types.URLScheme(settings.StreamingServerURL); {
+		case scheme != "http" && scheme != "https":
+			return errorEffects(NewOtherError(OtherErrorInvalidStreamingServerURL), event)
+		case !types.Equal(profile.Settings, settings):
+			profile.Settings = settings
+			return runtime.MsgEffects(msg.EventMsg(event)).Join(profileChangedEffects())
+		}
+		return eventEffects(event)
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func upgradeAddon(env runtime.Env, profile *types.Profile, addon types.Descriptor) runtime.Effects {
+	if profile.AddonsLocked {
+		return addonErrorEffects(msg.EventAddonUpgraded, addon, OtherErrorUserAddonsAreLocked)
+	}
+	if containsAddon(profile.Addons, addon) {
+		return addonErrorEffects(msg.EventAddonUpgraded, addon, OtherErrorAddonAlreadyInstalled)
+	}
+	if addon.Manifest.BehaviorHints.ConfigurationRequired {
+		return addonErrorEffects(msg.EventAddonUpgraded, addon, OtherErrorAddonConfigurationRequired)
+	}
+	position := addonPosition(profile.Addons, addon.TransportURL)
+	if position < 0 {
+		return addonErrorEffects(msg.EventAddonUpgraded, addon, OtherErrorAddonNotInstalled)
+	}
+	if addon.Flags.Protected || profile.Addons[position].Flags.Protected {
+		return addonErrorEffects(msg.EventAddonUpgraded, addon, OtherErrorAddonIsProtected)
+	}
+	addons := append([]types.Descriptor{}, profile.Addons...)
+	addons[position] = addon
+	profile.Addons = addons
+	return runtime.MsgEffects(msg.EventMsg(msg.AddonEvent(msg.EventAddonUpgraded, addon.TransportURL, addon.Manifest.ID))).
+		Join(pushAddonsToAPIEffects(env, profile)).
+		Join(profileChangedEffects())
+}
+
+func uninstallAddon(env runtime.Env, profile *types.Profile, streams *types.StreamsBucket, addon types.Descriptor) runtime.Effects {
+	if profile.AddonsLocked {
+		return addonErrorEffects(msg.EventAddonUninstalled, addon, OtherErrorUserAddonsAreLocked)
+	}
+	position := addonPosition(profile.Addons, addon.TransportURL)
+	if position < 0 {
+		return addonErrorEffects(msg.EventAddonUninstalled, addon, OtherErrorAddonNotInstalled)
+	}
+	if profile.Addons[position].Flags.Protected || addon.Flags.Protected {
+		return addonErrorEffects(msg.EventAddonUninstalled, addon, OtherErrorAddonIsProtected)
+	}
+	addons := make([]types.Descriptor, 0, len(profile.Addons)-1)
+	addons = append(addons, profile.Addons[:position]...)
+	addons = append(addons, profile.Addons[position+1:]...)
+	profile.Addons = addons
+	// Remove stream related to this addon from the streams bucket
+	for key, item := range streams.Items {
+		if transportURLEqual(item.StreamTransportURL, addon.TransportURL) {
+			delete(streams.Items, key)
+		}
+	}
+	return runtime.MsgEffects(msg.EventMsg(msg.AddonEvent(msg.EventAddonUninstalled, addon.TransportURL, addon.Manifest.ID))).
+		Join(pushAddonsToAPIEffects(env, profile)).
+		Join(profileChangedEffects())
+}
+
+func installAddon(env runtime.Env, profile *types.Profile, addon types.Descriptor) runtime.Effects {
+	if profile.AddonsLocked {
+		return addonErrorEffects(msg.EventAddonInstalled, addon, OtherErrorUserAddonsAreLocked)
+	}
+	if containsAddon(profile.Addons, addon) {
+		return addonErrorEffects(msg.EventAddonInstalled, addon, OtherErrorAddonAlreadyInstalled)
+	}
+	if addon.Manifest.BehaviorHints.ConfigurationRequired {
+		return addonErrorEffects(msg.EventAddonInstalled, addon, OtherErrorAddonConfigurationRequired)
+	}
+	addons := append([]types.Descriptor{}, profile.Addons...)
+	if position := addonPosition(addons, addon.TransportURL); position >= 0 {
+		addons[position] = addon
+	} else {
+		addons = append(addons, addon)
+	}
+	profile.Addons = addons
+	return runtime.MsgEffects(msg.EventMsg(msg.AddonEvent(msg.EventAddonInstalled, addon.TransportURL, addon.Manifest.ID))).
+		Join(pushAddonsToAPIEffects(env, profile)).
+		Join(profileChangedEffects())
+}
+
+// pushAddonsToAPIEffects pushes the addons to the API when the user is logged in.
+func pushAddonsToAPIEffects(env runtime.Env, profile *types.Profile) runtime.Effects {
+	if authKey := profile.AuthKey(); authKey != nil {
+		return runtime.OneEffect(pushAddonsToAPI(env, profile.Addons, *authKey)).Unchanged()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func addonErrorEffects(eventName string, addon types.Descriptor, err OtherError) runtime.Effects {
+	return errorEffects(NewOtherError(err), msg.AddonEvent(eventName, addon.TransportURL, addon.Manifest.ID))
+}
+
+func addonsLockedEvent(addonsLocked bool) *msg.Event {
+	return msg.NewEvent(msg.EventUserAddonsLocked, struct {
+		AddonsLocked bool `json:"addons_locked"`
+	}{addonsLocked})
+}
+
+func pushAddonsToAPI(env runtime.Env, addons []types.Descriptor, authKey types.AuthKey) runtime.Effect {
+	addons = append([]types.Descriptor{}, addons...)
+	urls := transportURLs(addons)
+	request := types.APIRequest{Type: types.APIRequestAddonCollectionSet, AuthKey: authKey, Addons: addons}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		_, err := fetchAPI[types.SuccessResponse](env, request)
+		return eventResultMsg(err, msg.TransportURLsEvent(msg.EventAddonsPushedToAPI, urls))
+	})
+}
+
+func pullUserFromAPI(env runtime.Env, authKey types.AuthKey, overwritten bool) runtime.Effect {
+	request := types.APIRequest{Type: types.APIRequestGetUser, AuthKey: authKey}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		user, err := fetchAPI[types.User](env, request)
+		result := UserAPIResult{Request: request, Err: err, Overwritten: overwritten}
+		if err == nil {
+			result.User = &user
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalUserAPIResult, result))
+	})
+}
+
+func pushUserToAPI(env runtime.Env, user types.User, authKey types.AuthKey) runtime.Effect {
+	uid := types.NewUID(user.ID)
+	request := types.APIRequest{Type: types.APIRequestSaveUser, AuthKey: authKey, User: user}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		_, err := fetchAPI[types.SuccessResponse](env, request)
+		return eventResultMsg(err, msg.UIDEvent(msg.EventUserPushedToAPI, uid))
+	})
+}
+
+func pullAddonsFromAPI(env runtime.Env, authKey types.AuthKey) runtime.Effect {
+	request := types.APIRequest{Type: types.APIRequestAddonCollectionGet, AuthKey: authKey, Update: true}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		collection, err := fetchAPI[types.CollectionResponse](env, request)
+		result := AddonsAPIResult{Request: request, Err: err}
+		if err == nil {
+			result.Addons = collection.Addons
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalAddonsAPIResult, result))
+	})
+}
+
+func pushProfileToStorage(env runtime.Env, profile *types.Profile) runtime.Effect {
+	return common.StorageFuture(env, stremiocore.PROFILE_STORAGE_KEY, *profile,
+		storageResult(msg.UIDEvent(msg.EventProfilePushedToStorage, profile.UID())))
+}
+
+func deleteAccount(env runtime.Env, authKey types.AuthKey, password types.Password) runtime.Effect {
+	request := types.APIRequest{Type: types.APIRequestDeleteAccount, AuthKey: authKey, Password: password}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		_, err := fetchAPI[types.SuccessResponse](env, request)
+		return msg.InternalMsg(msg.NewInternal(msg.InternalDeleteAccountAPIResult, DeleteAccountAPIResult{Request: request, Err: err}))
+	})
