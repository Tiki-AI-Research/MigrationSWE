+func TestPlayerPlaybackEvents(t *testing.T) {
+	rt, m, _, rx := newPlaybackRuntime(t, nil, nil)
+	drainPlayerEvents(rx)
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerPausedChanged, map[string]any{"paused": false}))
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerPausedChanged, map[string]any{"paused": true}))
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerSeek, map[string]any{"time": 1000, "duration": 2000, "device": "web"}))
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerPausedChanged, map[string]any{"paused": false}))
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerSeek, map[string]any{"time": 1500, "duration": 2000, "device": "web"}))
+	dispatchPlayer(rt, msg.UnloadAction())
+	events := playerCoreEvents(drainPlayerEvents(rx),
+		msg.EventPlayerPlaying, msg.EventTraktPaused, msg.EventTraktPlaying, msg.EventPlayerStopped, msg.EventPlayerEnded)
+	names := []string{}
+	for _, event := range events {
+		names = append(names, event.Event)
+	}
+	expected := []string{
+		msg.EventPlayerPlaying, msg.EventTraktPaused, msg.EventTraktPaused, msg.EventTraktPlaying, msg.EventTraktPlaying,
+		msg.EventTraktPaused, msg.EventPlayerStopped,
+	}
+	if !reflect.DeepEqual(names, expected) {
+		t.Fatalf("unexpected events %v, expected %v", names, expected)
+	}
+	var playing struct {
+		Context  map[string]any `json:"context"`
+		LoadTime *int64         `json:"load_time"`
+	}
+	if err := events[0].DecodeArgs(&playing); err != nil {
+		t.Fatal(err)
+	}
+	if playing.LoadTime == nil || *playing.LoadTime != 0 || playing.Context["libItemID"] != "tt123456" ||
+		playing.Context["hasTrakt"] != false || playing.Context["deviceName"] != nil {
+		t.Fatalf("unexpected PlayerPlaying args: %s", events[0].Args)
+	}
+	var stopped struct {
+		Context map[string]any `json:"context"`
+	}
+	if err := events[len(events)-1].DecodeArgs(&stopped); err != nil {
+		t.Fatal(err)
+	}
+	if stopped.Context["libItemTimeOffset"] != float64(1500) || stopped.Context["playerDuration"] != float64(2000) ||
+		stopped.Context["deviceType"] != "web" {
+		t.Fatalf("unexpected PlayerStopped args: %s", events[len(events)-1].Args)
+	}
+	if m.Player.Selected != nil || m.Player.AnalyticsContext != nil || m.Player.LibraryItem != nil {
+		t.Fatalf("the player should be unloaded")
+	}
+	item := playerLibraryItemOf(t, m)
+	if item.State.TimeOffset != 1500 || item.State.Duration != 2000 {
+		t.Fatalf("the library item should be pushed on unload: %+v", item.State)
+	}
+}
