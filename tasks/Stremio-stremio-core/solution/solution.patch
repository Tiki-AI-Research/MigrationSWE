+// NewAddonsDeepLinks creates the deep links of the addons catalog request.
+func NewAddonsDeepLinks(request types.ResourceRequest) AddonsDeepLinks {
+	return AddonsDeepLinks{
+		Addons: "stremio:///addons/" + enc(request.Path.Type) + "/" + encURL(request.Base) + "/" + enc(request.Path.ID),
+	}
+}
+
+// NewInstalledAddonsDeepLinks creates the deep links of the installed addons
+// of the type (all the installed addons when nil).
+func NewInstalledAddonsDeepLinks(typ *string) AddonsDeepLinks {
+	if typ == nil {
+		return AddonsDeepLinks{Addons: "stremio:///addons"}
+	}
+	return AddonsDeepLinks{Addons: "stremio:///addons/" + enc(*typ)}
+}
+
+//
+// Library
+//
+
+// LibraryDeepLinks are the deep links of the library (or continue watching).
+type LibraryDeepLinks struct {
+	Library string `json:"library"`
+}
+
+func (l LibraryDeepLinks) MarshalJSON() ([]byte, error) {
+	type libraryDeepLinks LibraryDeepLinks
+	return types.MarshalJSON(libraryDeepLinks(l))
+}
+
+// NewLibraryDeepLinks creates the deep links of the library root
+// (e.g. `library` or `continuewatching`) filtered by the type (all types when
+// nil) and sorted by sort (the serialized sort, e.g. `lastwatched`). With an
+// empty sort the link of the root is returned.
+func NewLibraryDeepLinks(root string, typ *string, sort string) LibraryDeepLinks {
+	if sort == "" {
+		return LibraryDeepLinks{Library: "stremio:///" + root}
+	}
+	query := types.QueryParamsEncode([]types.QueryPair{{Key: "sort", Value: sort}})
+	if typ != nil {
+		return LibraryDeepLinks{Library: "stremio:///" + root + "/" + enc(*typ) + "?" + query}
+	}
+	return LibraryDeepLinks{Library: "stremio:///" + root + "?" + query}
+}
