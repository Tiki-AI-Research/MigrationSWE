+
+// addonErrorArgs are the args of the `Error` event of an `OtherError` with
+// the code and the message, caused by the addon event named source.
+func addonErrorArgs(code int, message, source string, addon types.Descriptor) string {
+	return fmt.Sprintf(`{"error":{"type":"Other","code":%d,"message":%q},"source":{"event":%q,"args":%s}}`,
+		code, message, source, addonEventArgs(addon))
