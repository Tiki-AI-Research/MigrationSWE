diff --git a/constants.go b/constants.go
new file mode 100644
index 0000000000000000000000000000000000000000..619b35c4cec9caa76da3c1e4e8f98d8ccbcb4b15
--- /dev/null
+++ b/constants.go
@@ -0,0 +1,94 @@
+// Package stremiocore holds the constants shared by the Stremio core engine.
+//
+// The engine itself lives in the sub-packages: runtime (update/effects loop),
+// runtime/msg (messages), models (Ctx, Player, StreamingServer), types
+// (protocol and persisted data), addon_transport, deep_links and analytics.
+package stremiocore
+
+// Storage keys of the persisted user state.
+const (
+	SCHEMA_VERSION_STORAGE_KEY        = "schema_version"
+	PROFILE_STORAGE_KEY               = "profile"
+	LIBRARY_STORAGE_KEY               = "library"
+	LIBRARY_RECENT_STORAGE_KEY        = "library_recent"
+	STREAMS_STORAGE_KEY               = "streams"
+	SEARCH_HISTORY_STORAGE_KEY        = "search_history"
+	STREAMING_SERVER_URLS_STORAGE_KEY = "streaming_server_urls"
+	NOTIFICATIONS_STORAGE_KEY         = "notifications"
+	CALENDAR_STORAGE_KEY              = "calendar"
+	DISMISSED_EVENTS_STORAGE_KEY      = "dismissed_events"
+)
+
+// SCHEMA_VERSION is the latest migration scheme version.
+const SCHEMA_VERSION = 25
+
+const (
+	LIBRARY_COLLECTION_NAME = "libraryItem"
+	SEARCH_EXTRA_NAME       = "search"
+	// META_RESOURCE_NAME is the `https://{ADDON_URL}/meta/...` resource
+	META_RESOURCE_NAME   = "meta"
+	STREAM_RESOURCE_NAME = "stream"
+	// CATALOG_RESOURCE_NAME is the `https://{ADDON_URL}/catalog/...` resource
+	CATALOG_RESOURCE_NAME    = "catalog"
+	SUBTITLES_RESOURCE_NAME  = "subtitles"
+	ADDON_MANIFEST_PATH      = "/manifest.json"
+	ADDON_LEGACY_PATH        = "/stremio/v1"
+	CATALOG_PAGE_SIZE        = 100
+	CATALOG_PREVIEW_SIZE     = 100
+	LIBRARY_RECENT_COUNT     = 200
+	NOTIFICATION_ITEMS_COUNT = 100
+	// CALENDAR_ITEMS_COUNT is the maximum calendar items to fetch from `calendarIds` resource
+	CALENDAR_ITEMS_COUNT = 100
+)
+
+// NEW_USER_DAYS is the account age in days to be considered a new user.
+const NEW_USER_DAYS = 30
+
+// WATCHED_THRESHOLD_COEF: a LibraryItem is considered watched once we've
+// watched more than `duration * WATCHED_THRESHOLD_COEF`.
+const WATCHED_THRESHOLD_COEF = 0.7
+
+// CREDITS_THRESHOLD_COEF: once `time_offset > duration * CREDITS_THRESHOLD_COEF`
+// the item is rewound (and advanced to the next video, if any).
+const CREDITS_THRESHOLD_COEF = 0.9
+
+const (
+	IMDB_LINK_CATEGORY      = "imdb"
+	GENRES_LINK_CATEGORY    = "Genres"
+	CINEMETA_TOP_CATALOG_ID = "top"
+	// CINEMETA_FEED_CATALOG_ID is only found in Cinemeta catalogs, i.e. CINEMETA_CATALOGS_URL
+	CINEMETA_FEED_CATALOG_ID = "feed.json"
+	IMDB_TITLE_PATH          = "title"
+	YOUTUBE_ADDON_ID_PREFIX  = "yt_id:"
+)
+
+// PLAYER_IGNORE_SEEK_AFTER is in milliseconds.
+const PLAYER_IGNORE_SEEK_AFTER = 600_000
+
+// URLs are kept in their serialized (WHATWG) form, i.e. with a path.
+const (
+	CINEMETA_CATALOGS_URL = "https://cinemeta-catalogs.strem.io/"
+	// CINEMETA_URL is the manifest URL for Cinemeta V3
+	CINEMETA_URL         = "https://v3-cinemeta.strem.io/manifest.json"
+	USER_LIKES_API_URL   = "https://likes.stremio.com/"
+	API_URL              = "https://api.strem.io/"
+	LINK_API_URL         = "https://link.stremio.com/"
+	STREAMING_SERVER_URL = "http://127.0.0.1:11470/"
+	IMDB_URL             = "https://imdb.com/"
+)
+
+// USER_LIKES_SUPPORTED_ID_PREFIXES lists the id prefixes supported by the likes API.
+var USER_LIKES_SUPPORTED_ID_PREFIXES = []string{"tt", "tmdb", "kitsu"}
+
+// USER_LIKES_SUPPORTED_TYPES lists the types supported by the likes API.
+var USER_LIKES_SUPPORTED_TYPES = []string{"movie", "series"}
+
+// TYPE_PRIORITIES orders the content types; "other" always goes last.
+var TYPE_PRIORITIES = map[string]int32{
+	"all":     5,
+	"movie":   4,
+	"series":  3,
+	"channel": 2,
+	"tv":      1,
+	"other":   -2147483648,
+}
diff --git a/deep_links/deep_links.go b/deep_links/deep_links.go
new file mode 100644
index 0000000000000000000000000000000000000000..fe58782c448b86287a6ade4fce810bd8bd22a0d1
--- /dev/null
+++ b/deep_links/deep_links.go
@@ -0,0 +1,438 @@
+// Package deeplinks generates the `stremio:///` deep links of the various
+// items shown by the apps (library items, meta items, videos, streams,
+// catalogs, addons, ...) and the links for the external players.
+package deeplinks
+
+import (
+	"strconv"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+func enc(value string) string {
+	return types.EncodeURIComponent(value)
+}
+
+// encURL percent-encodes the serialized (normalized) form of the url.
+func encURL(url string) string {
+	return types.EncodeURIComponent(types.NormalizeURL(url))
+}
+
+func detailLink(typ, id string) string {
+	return "stremio:///detail/" + enc(typ) + "/" + enc(id)
+}
+
+func detailVideoLink(typ, id, videoID string) string {
+	return "stremio:///detail/" + enc(typ) + "/" + enc(id) + "/" + enc(videoID)
+}
+
+// playerLink returns the link of the player for the encoded stream with the
+// stream and meta transport urls, the meta type and id and the video id.
+func playerLink(encodedStream, streamTransportURL, metaTransportURL, typ, metaID, videoID string) string {
+	return "stremio:///player/" + enc(encodedStream) + "/" + encURL(streamTransportURL) + "/" +
+		encURL(metaTransportURL) + "/" + enc(typ) + "/" + enc(metaID) + "/" + enc(videoID)
+}
+
+//
+// Library item
+//
+
+// LibraryItemDeepLinks are the deep links of a library item.
+type LibraryItemDeepLinks struct {
+	MetaDetailsVideos  *string             `json:"metaDetailsVideos"`
+	MetaDetailsStreams *string             `json:"metaDetailsStreams"`
+	Player             *string             `json:"player"`
+	ExternalPlayer     *ExternalPlayerLink `json:"externalPlayer"`
+}
+
+func (l LibraryItemDeepLinks) MarshalJSON() ([]byte, error) {
+	type libraryItemDeepLinks LibraryItemDeepLinks
+	return types.MarshalJSON(libraryItemDeepLinks(l))
+}
+
+// NewLibraryItemDeepLinks creates the deep links of a library item.
+//
+// streamsItem is the last stream played for the item (if any),
+// streamingServerURL the url of the running streaming server (nil when the
+// server is not running) and settings the user settings, used for the
+// external player links.
+func NewLibraryItemDeepLinks(item types.LibraryItem, streamsItem *types.StreamsItem, streamingServerURL *string, settings types.Settings) LibraryItemDeepLinks {
+	var position *uint64
+	if seconds := item.State.TimeOffset / 1000; seconds > 0 {
+		position = &seconds
+	}
+	defaultVideoID := item.BehaviorHints.DefaultVideoID
+
+	var links LibraryItemDeepLinks
+	if defaultVideoID == nil {
+		links.MetaDetailsVideos = strPtr(detailLink(item.Type, item.ID))
+	}
+
+	var streamsVideoID *string
+	if item.State.VideoID != nil && item.State.TimeOffset > 0 {
+		streamsVideoID = item.State.VideoID
+	} else if defaultVideoID != nil {
+		streamsVideoID = defaultVideoID
+	}
+	if streamsVideoID != nil {
+		links.MetaDetailsStreams = strPtr(detailVideoLink(item.Type, item.ID, *streamsVideoID))
+	}
+
+	if streamsItem != nil {
+		// we have the stream, so use the same logic as in StreamDeepLinks
+		encodedStream, err := streamsItem.Stream.Encode()
+		if err != nil {
+			links.Player = strPtr(NewErrorLink(err).String())
+		} else {
+			player := playerLink(encodedStream, streamsItem.StreamTransportURL, streamsItem.MetaTransportURL,
+				streamsItem.Type, streamsItem.MetaID, streamsItem.VideoID)
+			if position != nil {
+				player += "?position=" + strconv.FormatUint(*position, 10)
+			}
+			links.Player = &player
+		}
+
+		externalPlayer := NewExternalPlayerLink(streamsItem.Stream, streamingServerURL, settings)
+		if isInfuse(settings) && externalPlayer.Streaming != nil {
+			callbackURL := detailVideoLink(streamsItem.Type, streamsItem.MetaID, streamsItem.VideoID)
+			externalPlayer.OpenPlayer = infuseOpenPlayer(*externalPlayer.Streaming, callbackURL, position)
+		}
+		links.ExternalPlayer = &externalPlayer
+	}
+	return links
+}
+
+func isInfuse(settings types.Settings) bool {
+	return settings.PlayerType != nil && *settings.PlayerType == "infuse"
+}
+
+//
+// Meta item
+//
+
+// MetaItemDeepLinks are the deep links of a meta item.
+type MetaItemDeepLinks struct {
+	MetaDetailsVideos  *string `json:"metaDetailsVideos"`
+	MetaDetailsStreams *string `json:"metaDetailsStreams"`
+	Player             *string `json:"player"`
+}
+
+func (l MetaItemDeepLinks) MarshalJSON() ([]byte, error) {
+	type metaItemDeepLinks MetaItemDeepLinks
+	return types.MarshalJSON(metaItemDeepLinks(l))
+}
+
+// NewMetaItemDeepLinks creates the deep links of the meta item with the type
+// and id of a resource path: only the videos link is set.
+func NewMetaItemDeepLinks(typ, id string) MetaItemDeepLinks {
+	return MetaItemDeepLinks{MetaDetailsVideos: strPtr(detailLink(typ, id))}
+}
+
+// NewMetaItemDeepLinksFromPath creates the deep links of the meta item of a
+// resource path (see NewMetaItemDeepLinks).
+func NewMetaItemDeepLinksFromPath(path types.ResourcePath) MetaItemDeepLinks {
+	return NewMetaItemDeepLinks(path.Type, path.ID)
+}
+
+// NewMetaItemDeepLinksWithVideo creates the deep links of a meta item with a
+// default video: the streams link of the video is set instead of the
+// videos link. The player link is not generated (it needs the request of the
+// meta item, see NewMetaItemDeepLinksFromPreview).
+func NewMetaItemDeepLinksWithVideo(typ, id, defaultVideoID string) MetaItemDeepLinks {
+	return MetaItemDeepLinks{MetaDetailsStreams: strPtr(detailVideoLink(typ, id, defaultVideoID))}
+}
+
+// NewMetaItemDeepLinksFromPreview creates the deep links of a meta item
+// returned for the request. With a default video, the streams link of the
+// video is set instead of the videos link, and for YouTube videos the
+// player link is set too.
+func NewMetaItemDeepLinksFromPreview(preview types.MetaItemPreview, request types.ResourceRequest) MetaItemDeepLinks {
+	defaultVideoID := preview.BehaviorHints.DefaultVideoID
+	if defaultVideoID == nil {
+		return NewMetaItemDeepLinks(preview.Type, preview.ID)
+	}
+	links := NewMetaItemDeepLinksWithVideo(preview.Type, preview.ID, *defaultVideoID)
+	if stream := types.YouTubeStream(*defaultVideoID); stream != nil {
+		encodedStream, err := stream.Encode()
+		if err != nil {
+			links.Player = strPtr(NewErrorLink(err).String())
+		} else {
+			links.Player = strPtr(playerLink(encodedStream, request.Base, request.Base, preview.Type, preview.ID, *defaultVideoID))
+		}
+	}
+	return links
+}
+
+// NewMetaItemDeepLinksFromMetaItem creates the deep links of a meta item
+// (see NewMetaItemDeepLinksFromPreview).
+func NewMetaItemDeepLinksFromMetaItem(item types.MetaItem, request types.ResourceRequest) MetaItemDeepLinks {
+	return NewMetaItemDeepLinksFromPreview(item.Preview, request)
+}
+
+//
+// Video
+//
+
+// VideoDeepLinks are the deep links of a video of a meta item.
+type VideoDeepLinks struct {
+	MetaDetailsVideos  string              `json:"metaDetailsVideos"`
+	MetaDetailsStreams string              `json:"metaDetailsStreams"`
+	Player             *string             `json:"player"`
+	ExternalPlayer     *ExternalPlayerLink `json:"externalPlayer"`
+}
+
+func (l VideoDeepLinks) MarshalJSON() ([]byte, error) {
+	type videoDeepLinks VideoDeepLinks
+	return types.MarshalJSON(videoDeepLinks(l))
+}
+
+// NewVideoDeepLinks creates the deep links of a video of the meta item
+// returned for the request. The player links are set when the video has a
+// single stream (or is a YouTube video).
+func NewVideoDeepLinks(video types.Video, request types.ResourceRequest, streamingServerURL *string, settings types.Settings) VideoDeepLinks {
+	return NewVideoDeepLinksWithRequests(video, request, request, streamingServerURL, settings)
+}
+
+// NewVideoDeepLinksWithRequests creates the deep links of a video with the
+// stream request (for the stream transport url of the player link) and the
+// meta request.
+func NewVideoDeepLinksWithRequests(video types.Video, streamRequest, metaRequest types.ResourceRequest, streamingServerURL *string, settings types.Settings) VideoDeepLinks {
+	links := VideoDeepLinks{
+		MetaDetailsVideos:  detailLink(metaRequest.Path.Type, metaRequest.Path.ID),
+		MetaDetailsStreams: detailVideoLink(metaRequest.Path.Type, metaRequest.Path.ID, video.ID),
+	}
+	stream := video.Stream()
+	if stream != nil {
+		encodedStream, err := stream.Encode()
+		if err != nil {
+			links.Player = strPtr(NewErrorLink(err).String())
+		} else {
+			links.Player = strPtr(playerLink(encodedStream, streamRequest.Base, metaRequest.Base,
+				metaRequest.Path.Type, metaRequest.Path.ID, video.ID))
+		}
+		externalPlayer := NewExternalPlayerLink(*stream, streamingServerURL, settings)
+		links.ExternalPlayer = &externalPlayer
+	}
+	return links
+}
+
+//
+// Stream
+//
+
+// StreamDeepLinks are the deep links of a stream.
+type StreamDeepLinks struct {
+	Player         string             `json:"player"`
+	ExternalPlayer ExternalPlayerLink `json:"externalPlayer"`
+}
+
+func (l StreamDeepLinks) MarshalJSON() ([]byte, error) {
+	type streamDeepLinks StreamDeepLinks
+	return types.MarshalJSON(streamDeepLinks(l))
+}
+
+func streamPlayerLink(encodedStream string, err error) string {
+	if err != nil {
+		return NewErrorLink(err).String()
+	}
+	return "stremio:///player/" + enc(encodedStream)
+}
+
+// NewStreamDeepLinks creates the deep links of a stream.
+//
+// streamingServerURL is the url of the running streaming server (nil when the
+// server is not running) and settings the user settings, used for the
+// external player links.
+func NewStreamDeepLinks(stream types.Stream, streamingServerURL *string, settings types.Settings) StreamDeepLinks {
+	return StreamDeepLinks{
+		Player:         streamPlayerLink(stream.Encode()),
+		ExternalPlayer: NewExternalPlayerLink(stream, streamingServerURL, settings),
+	}
+}
+
+// NewConvertedStreamDeepLinks creates the deep links of an already converted
+// stream (see NewStreamDeepLinks).
+func NewConvertedStreamDeepLinks(stream types.ConvertedStream, streamingServerURL *string, settings types.Settings) StreamDeepLinks {
+	return StreamDeepLinks{
+		Player:         streamPlayerLink(stream.Encode()),
+		ExternalPlayer: NewExternalPlayerLinkFromConverted(stream, streamingServerURL, settings),
+	}
+}
+
+// NewStreamDeepLinksWithRequests creates the deep links of a stream returned
+// for the stream request of a video of the meta item of the meta request.
+// The Infuse callbacks return to the streams of the video.
+func NewStreamDeepLinksWithRequests(stream types.Stream, streamRequest, metaRequest types.ResourceRequest, streamingServerURL *string, settings types.Settings) StreamDeepLinks {
+	callbackURL := detailVideoLink(metaRequest.Path.Type, metaRequest.Path.ID, streamRequest.Path.ID)
+	externalPlayer := NewExternalPlayerLink(stream, streamingServerURL, settings)
+	if isInfuse(settings) && externalPlayer.Streaming != nil {
+		externalPlayer.OpenPlayer = infuseOpenPlayer(*externalPlayer.Streaming, callbackURL, nil)
+	}
+
+	var player string
+	if encodedStream, err := stream.Encode(); err != nil {
+		player = NewErrorLink(err).String()
+	} else {
+		player = playerLink(encodedStream, streamRequest.Base, metaRequest.Base,
+			metaRequest.Path.Type, metaRequest.Path.ID, streamRequest.Path.ID)
+	}
+	return StreamDeepLinks{Player: player, ExternalPlayer: externalPlayer}
+}
