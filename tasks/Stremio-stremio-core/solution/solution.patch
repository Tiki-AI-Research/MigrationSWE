+// ManifestResource is a resource supported by the addon, either in the short
+// format (just the name) or the full one (with types and id prefixes).
+type ManifestResource struct {
+	Name string
+	// Full is false for the short format, which serializes as a string.
+	Full bool
+	// Types (full format only); `nil` means the globally supported types are not used.
+	Types []string
+	// IDPrefixes (full format only); `nil` means the manifest id prefixes are used.
+	IDPrefixes []string
+}
