@@ -0,0 +1,96 @@
+package ctx
+
+import (
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateStreams(env runtime.Env, streams *types.StreamsBucket, status *CtxStatus, m *msg.Msg) runtime.Effects {
+	if m.IsInternal(msg.InternalLogout) {
+		nextStreams := types.NewStreamsBucket(nil)
+		if !types.Equal(*streams, nextStreams) {
+			*streams = nextStreams
+			return streamsChangedEffects(false)
+		}
+		return runtime.NoneEffects().Unchanged()
+	}
+	if loaded, ok := InternalStreamLoadedData(m); ok {
+		metaContent := loaded.MetaItem.Content
+		if loaded.StreamRequest == nil || metaContent == nil || metaContent.IsLoading() {
+			return runtime.NoneEffects().Unchanged()
+		}
+		metaRequest := loaded.MetaItem.Request
+		streamRequest := *loaded.StreamRequest
+		metaID := metaRequest.Path.ID
+		videoID := streamRequest.Path.ID
+		key := types.StreamsItemKey{MetaID: metaID, VideoID: videoID}
+		var lastStreamItem *types.StreamsItem
+		if metaItem, ready := metaContent.Ready(); ready {
+			lastStreamItem = streams.LastStreamItem(videoID, metaItem)
+		} else if item, exists := streams.Items[key]; exists {
+			lastStreamItem = &item
+		}
+		var lastStreamState *types.StreamItemState
+		if lastStreamItem != nil {
+			lastStreamState = lastStreamItem.AdjustedState(loaded.Stream)
+		}
+		if streams.Items == nil {
+			streams.Items = map[types.StreamsItemKey]types.StreamsItem{}
+		}
+		streams.Items[key] = types.StreamsItem{
+			Stream:             loaded.Stream,
+			Type:               metaRequest.Path.Type,
+			MetaID:             metaID,
+			VideoID:            videoID,
+			MetaTransportURL:   metaRequest.Base,
+			StreamTransportURL: streamRequest.Base,
+			State:              lastStreamState,
+			Mtime:              env.Now(),
+		}
+		return streamsChangedEffects(false)
+	}
+	if changed, ok := InternalStreamStateChangedData(m); ok {
+		if changed.StreamRequest == nil || changed.MetaRequest == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		key := types.StreamsItemKey{MetaID: changed.MetaRequest.Path.ID, VideoID: changed.StreamRequest.Path.ID}
+		item, exists := streams.Items[key]
+		if !exists {
+			return runtime.NoneEffects().Unchanged()
+		}
+		state := changed.State
+		item.State = &state
+		streams.Items[key] = item
+		return streamsChangedEffects(false)
+	}
+	if persisted, ok := InternalBoolData(m, msg.InternalStreamsChanged); ok {
+		if persisted {
+			return runtime.NoneEffects().Unchanged()
+		}
+		return runtime.OneEffect(pushStreamsToStorage(env, streams)).Unchanged()
+	}
+	if result, ok := InternalCtxAuthResultData(m); ok {
+		if !status.IsLoading(result.AuthRequest) || result.Response == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		nextStreams := types.NewStreamsBucket(types.NewUID(result.Response.Auth.User.ID))
+		if !types.Equal(*streams, nextStreams) {
+			*streams = nextStreams
+			return streamsChangedEffects(false)
+		}
+		return runtime.NoneEffects().Unchanged()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func streamsChangedEffects(persisted bool) runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalStreamsChanged, persisted)))
+}
+
+func pushStreamsToStorage(env runtime.Env, streams *types.StreamsBucket) runtime.Effect {
+	return common.StorageFuture(env, stremiocore.STREAMS_STORAGE_KEY, *streams,
+		storageResult(msg.UIDEvent(msg.EventStreamsPushedToStorage, streams.UID)))
+}
