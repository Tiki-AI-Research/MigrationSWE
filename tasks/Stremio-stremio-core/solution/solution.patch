diff --git a/runtime/effects.go b/runtime/effects.go
new file mode 100644
index 0000000000000000000000000000000000000000..48faee46c7f78fae63dc3e5e81307830ef4015e8
--- /dev/null
+++ b/runtime/effects.go
@@ -0,0 +1,98 @@
+package runtime
+
+import "github.com/stremio/stremio-core/runtime/msg"
+
+// EffectFuture is an asynchronous effect resolving to a message. Concurrent
+// futures may run concurrently, the others run sequentially in order.
+type EffectFuture struct {
+	Concurrent bool
+	Run        func() *msg.Msg
+}
+
+// Effect is either a message, handled synchronously, or a future.
+type Effect struct {
+	Msg    *msg.Msg
+	Future *EffectFuture
+}
+
+// MsgEffect creates an effect handling the message.
+func MsgEffect(m *msg.Msg) Effect {
+	return Effect{Msg: m}
+}
+
+// ConcurrentFuture creates a concurrent future effect.
+func ConcurrentFuture(run func() *msg.Msg) Effect {
+	return Effect{Future: &EffectFuture{Concurrent: true, Run: run}}
+}
+
+// SequentialFuture creates a sequential future effect.
+func SequentialFuture(run func() *msg.Msg) Effect {
+	return Effect{Future: &EffectFuture{Concurrent: false, Run: run}}
+}
+
+// Effects are the effects of an update together with whether the updated
+// model has changed. A changed model field results in a `NewState` event.
+type Effects struct {
+	// Effects to be applied.
+	Effects []Effect
+	// HasChanged marks the model as changed.
+	HasChanged bool
+}
+
+// NoneEffects returns no effects with the model marked as changed.
+func NoneEffects() Effects {
+	return Effects{HasChanged: true}
+}
+
+// OneEffect returns a single effect with the model marked as changed.
+func OneEffect(effect Effect) Effects {
+	return Effects{Effects: []Effect{effect}, HasChanged: true}
+}
+
+// ManyEffects returns the effects with the model marked as changed.
+func ManyEffects(effects ...Effect) Effects {
+	return Effects{Effects: append([]Effect{}, effects...), HasChanged: true}
+}
+
+// MsgEffects returns a message effect with the model marked as changed.
+func MsgEffects(m *msg.Msg) Effects {
+	return OneEffect(MsgEffect(m))
+}
+
+// MsgsEffects returns message effects with the model marked as changed.
+func MsgsEffects(messages ...*msg.Msg) Effects {
+	effects := make([]Effect, 0, len(messages))
+	for _, m := range messages {
+		effects = append(effects, MsgEffect(m))
+	}
+	return Effects{Effects: effects, HasChanged: true}
+}
+
+// FutureEffects returns a future effect with the model marked as changed.
+func FutureEffects(future *EffectFuture) Effects {
+	return OneEffect(Effect{Future: future})
+}
+
+// Unchanged marks the model as not changed.
+func (e Effects) Unchanged() Effects {
+	e.HasChanged = false
+	return e
+}
+
+// Join appends the other effects; the model is changed if either changed it.
+func (e Effects) Join(other Effects) Effects {
+	joined := make([]Effect, 0, len(e.Effects)+len(other.Effects))
+	joined = append(joined, e.Effects...)
+	joined = append(joined, other.Effects...)
+	return Effects{Effects: joined, HasChanged: e.HasChanged || other.HasChanged}
+}
+
+// Len returns the amount of effects.
+func (e Effects) Len() int {
+	return len(e.Effects)
+}
+
+// IsEmpty reports whether there are no effects.
+func (e Effects) IsEmpty() bool {
+	return len(e.Effects) == 0
+}
