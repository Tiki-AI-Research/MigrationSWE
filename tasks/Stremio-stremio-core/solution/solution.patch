+package types
+
+import (
+	_ "embed"
+	"encoding/json"
+	"os"
+)
+
+//go:embed official_addons.json
+var officialAddonsJSON []byte
+
+// OFFICIAL_ADDONS are the addons installed by default. They are empty when
+// the `EMPTY_OFFICIAL_ADDONS` environment variable is set to `1`.
+var OFFICIAL_ADDONS = loadOfficialAddons()
+
+func loadOfficialAddons() []Descriptor {
+	if os.Getenv("EMPTY_OFFICIAL_ADDONS") == "1" {
+		return []Descriptor{}
+	}
+	var addons []Descriptor
+	if err := json.Unmarshal(officialAddonsJSON, &addons); err != nil {
+		panic("OFFICIAL_ADDONS parse failed: " + err.Error())
+	}
+	return addons
+}
+
+// OfficialAddons returns a copy of the official addons.
+func OfficialAddons() []Descriptor {
+	return Clone(OFFICIAL_ADDONS)
+}
+
+// FindOfficialAddon returns the official addon with the given transport url.
+func FindOfficialAddon(transportURL string) *Descriptor {
+	for i := range OFFICIAL_ADDONS {
+		if urlEqual(OFFICIAL_ADDONS[i].TransportURL, transportURL) {
+			addon := Clone(OFFICIAL_ADDONS[i])
+			return &addon
+		}
+	}
+	return nil
+}
