index 0000000000000000000000000000000000000000..82f8ab811b0e7889ba5079911c21f5bdffb058eb
--- /dev/null
+++ b/models/api.go
@@ -0,0 +1,99 @@
+package models
+
+import (
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// FetchAPI sends the request to the API and decodes the result.
+func FetchAPI[T any](env runtime.Env, request types.FetchRequest) (T, *types.APIError, *runtime.EnvError) {
+	return common.FetchAPI[T](env, request)
+}
+
+// SeekLogsResult is the data of the `SeekLogsResult` internal message: the
+// result of sending the seek logs of the player to the API. Response is set
+// on success, Err on failure.
+type SeekLogsResult struct {
+	Request  types.SeekLogRequest
+	Response *types.SuccessResponse
+	Err      *ctx.CtxError
+}
+
+// SkipGapsResult is the data of the `SkipGapsResult` internal message: the
+// skip gaps (intro and outro) retrieved from the API. Response is set on
+// success, Err on failure.
+type SkipGapsResult struct {
+	Request  types.SkipGapsRequest
+	Response *types.SkipGapsResponse
+	Err      *ctx.CtxError
+}
+
+// WatchedSendResult is the data of the `WatchedSendResult` internal message:
+// the result of sending the watched rating of the meta item to the likes
+// API. Response is set on success, Err on failure.
+type WatchedSendResult struct {
+	MetaID   string
+	Response *types.RatingSendResponse
+	Err      *runtime.EnvError
+}
+
+// pushSeekToAPI sends the seek logs to the API.
+func pushSeekToAPI(env runtime.Env, request types.SeekLogRequest) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		response, apiErr, envErr := FetchAPI[types.SuccessResponse](env, types.APIRequest{
+			Type:    types.APIRequestSeekLog,
+			SeekLog: request,
+		})
+		result := SeekLogsResult{Request: request}
+		if err := ctx.CtxErrorFromAPIResult(apiErr, envErr); err != nil {
+			result.Err = err
+		} else {
+			result.Response = &response
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalSeekLogsResult, result))
+	})
+}
+
+// getSkipGaps retrieves the skip gaps of the video from the API.
+func getSkipGaps(env runtime.Env, request types.SkipGapsRequest) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		response, apiErr, envErr := FetchAPI[types.SkipGapsResponse](env, types.APIRequest{
+			Type:     types.APIRequestSkipGaps,
+			SkipGaps: request,
+		})
+		result := SkipGapsResult{Request: request}
+		if err := ctx.CtxErrorFromAPIResult(apiErr, envErr); err != nil {
+			result.Err = err
+		} else {
+			result.Response = &response
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalSkipGapsResult, result))
+	})
+}
+
+// sendWatched sends the watched state of the meta item to the likes API.
+func sendWatched(env runtime.Env, authKey types.AuthKey, metaPath types.ResourcePath) runtime.Effect {
+	metaID := metaPath.ID
+	rating := types.RatingWatched
+	request := types.RatingSendRequest{
+		AuthKey:      authKey,
+		MetaItemID:   metaID,
+		MetaItemType: metaPath.Type,
+		Rating:       &rating,
+	}
+	url := request.URL()
+	body := request.Body()
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		var response types.RatingSendResponse
+		result := WatchedSendResult{MetaID: metaID}
+		if err := runtime.FetchJSON(env, "POST", url, body, &response); err != nil {
+			result.Err = err
+		} else {
+			result.Response = &response
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalWatchedSendResult, result))
+	})
+}
diff --git a/models/common/api.go b/models/common/api.go
new file mode 100644
index 0000000000000000000000000000000000000000..d3046d0d6e0fe087b40a1e843b7ac7a6b0217784
--- /dev/null
+++ b/models/common/api.go
@@ -0,0 +1,72 @@
+package common
+
+import (
+	"encoding/json"
+
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// FetchAPI sends the request to the API and decodes the result: the result
+// on success, the API error when the API returned an error, the Env error
+// when the request failed.
+func FetchAPI[T any](env runtime.Env, request types.FetchRequest) (T, *types.APIError, *runtime.EnvError) {
+	var result T
+	body, err := request.Body()
+	if err != nil {
+		return result, nil, runtime.EnvErrorSerde(err.Error())
+	}
+	response, envErr := env.Fetch(request.Method(), request.URL(), map[string]string{}, body)
+	if envErr != nil {
+		return result, nil, envErr
+	}
+	apiErr, err := types.ParseAPIResult(response, &result)
+	if err != nil {
+		return result, nil, runtime.EnvErrorSerde(err.Error())
+	}
+	return result, apiErr, nil
+}
+
+// FetchJSON sends a request with an optional JSON body and decodes the JSON response.
+func FetchJSON[T any](env runtime.Env, method, url string, headers map[string]string, body any) (T, *runtime.EnvError) {
+	var result T
+	var payload []byte
+	if body != nil {
+		data, err := types.MarshalJSON(body)
+		if err != nil {
+			return result, runtime.EnvErrorSerde(err.Error())
+		}
+		payload = data
+	}
+	if headers == nil {
+		headers = map[string]string{}
+	}
+	response, envErr := env.Fetch(method, url, headers, payload)
+	if envErr != nil {
+		return result, envErr
+	}
+	if err := json.Unmarshal(response, &result); err != nil {
+		return result, runtime.EnvErrorSerde(err.Error())
+	}
+	return result, nil
+}
+
+// StorageFuture is the sequential effect persisting the value under the
+// key. The value is serialized when the effect is created, so later
+// changes of the model are not persisted by it. onResult converts the
+// result to the resulting message.
+func StorageFuture(env runtime.Env, key string, value any, onResult func(*runtime.EnvError) *msg.Msg) runtime.Effect {
+	var snapshot any
+	if value != nil {
+		data, err := types.MarshalJSON(value)
+		if err != nil {
+			serdeErr := runtime.EnvErrorSerde(err.Error())
+			return runtime.SequentialFuture(func() *msg.Msg { return onResult(serdeErr) })
+		}
+		snapshot = json.RawMessage(data)
+	}
+	return runtime.SequentialFuture(func() *msg.Msg {
+		return onResult(env.SetStorage(key, snapshot))
+	})
+}
diff --git a/models/common/descriptor_loadable.go b/models/common/descriptor_loadable.go
new file mode 100644
index 0000000000000000000000000000000000000000..cabe7a5107b7026f68ae3f710230be59ce1f81c4
--- /dev/null
+++ b/models/common/descriptor_loadable.go
@@ -0,0 +1,69 @@
+package common
+
+import (
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// DescriptorLoadable is an addon descriptor loaded from its transport url.
+type DescriptorLoadable struct {
+	TransportURL string
+	Content      Loadable[types.Descriptor]
+}
+
+func (d DescriptorLoadable) MarshalJSON() ([]byte, error) {
+	return types.MarshalJSON(struct {
+		TransportURL string                     `json:"transport_url"`
+		Content      Loadable[types.Descriptor] `json:"content"`
+	}{d.TransportURL, d.Content})
+}
+
+// ManifestRequestResult is the data of the `ManifestRequestResult` internal message.
+type ManifestRequestResult struct {
+	TransportURL string
+	Manifest     *types.Manifest
+	Err          *runtime.EnvError
+}
+
+// DescriptorRequested requests the descriptor of the addon, unless it is
+// already requested for the same transport url.
+func DescriptorRequested(env runtime.Env, descriptor **DescriptorLoadable, transportURL string) runtime.Effects {
+	if *descriptor != nil && (*descriptor).TransportURL == transportURL {
+		return runtime.NoneEffects().Unchanged()
+	}
+	*descriptor = &DescriptorLoadable{TransportURL: transportURL, Content: Loading[types.Descriptor]()}
+	return runtime.OneEffect(runtime.ConcurrentFuture(func() *msg.Msg {
+		manifest, err := AddonTransport(env, transportURL).Manifest()
+		result := ManifestRequestResult{TransportURL: transportURL, Err: err}
+		if err == nil {
+			result.Manifest = &manifest
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalManifestRequestResult, result))
+	}))
+}
+
+// DescriptorManifestResult loads the manifest result into the loading descriptor.
+func DescriptorManifestResult(descriptor **DescriptorLoadable, result ManifestRequestResult) runtime.Effects {
+	current := *descriptor
+	if current == nil || current.TransportURL != result.TransportURL || !current.Content.IsLoading() {
+		return runtime.NoneEffects().Unchanged()
+	}
+	next := &DescriptorLoadable{TransportURL: result.TransportURL}
+	if result.Err != nil || result.Manifest == nil {
+		err := result.Err
+		if err == nil {
+			err = runtime.EnvErrorOther("missing manifest")
+		}
+		next.Content = Err[types.Descriptor](err)
+	} else {
+		flags := types.DescriptorFlags{}
+		if official := types.FindOfficialAddon(result.TransportURL); official != nil {
+			// only official addons have flags
+			flags = official.Flags
+		}
+		next.Content = Ready(types.Descriptor{Manifest: *result.Manifest, TransportURL: result.TransportURL, Flags: flags})
+	}
+	*descriptor = next
+	return runtime.NoneEffects()
+}
