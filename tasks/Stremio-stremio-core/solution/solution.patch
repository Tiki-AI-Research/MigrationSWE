+package ctx_test
+
+import (
+	"testing"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of src/unit_tests/ctx/add_to_library.rs
+
+func TestActionCtxAddToLibrary(t *testing.T) {
+	now := date(2020, 1, 1)
+	env := newTestEnv(now)
+	setRoutes(t, env, fetchRoute{
+		Method:   "POST",
+		URL:      "https://api.strem.io/api/datastorePut",
+		Body:     `{"authKey":"auth_key","collection":"libraryItem","changes":[{"_id":"id","name":"name","type":"type","poster":null,"posterShape":"poster","removed":false,"temp":false,"_ctime":"2020-01-01T00:00:00Z","_mtime":"2020-01-01T00:00:00Z","state":{"lastWatched":"2020-01-01T00:00:00Z","timeWatched":0,"timeOffset":0,"overallTimeWatched":0,"timesWatched":0,"flaggedWatched":0,"duration":0,"video_id":null,"watched":null,"noNotif":false},"behaviorHints":{"defaultVideoId":null,"featuredVideoId":null,"hasScheduledVideos":false}}]}`,
+		Response: apiSuccess,
+	})
+	metaPreview := types.MetaItemPreview{
+		ID:          "id",
+		Type:        "type",
+		Name:        "name",
+		PosterShape: types.PosterShapePoster,
+	}
+	libraryItem := types.LibraryItem{
+		ID:          "id",
+		Name:        "name",
+		Type:        "type",
+		PosterShape: types.PosterShapePoster,
+		Ctime:       timePtr(now),
+		Mtime:       now,
+		State:       types.LibraryItemState{LastWatched: timePtr(now)},
+	}
+	h := newHarness(t, env, withProfileAndLibrary(env,
+		loggedInProfile(userFixture(env.Now())),
+		types.LibraryBucket{UID: uid("id"), Items: map[string]types.LibraryItem{}},
+	))
+	h.dispatchCtx(msg.ActionCtxAddToLibrary, metaPreview)
+
+	library := h.ctx().Library
+	if len(library.Items) != 1 {
+		t.Fatalf("There is one library item in memory, got %d", len(library.Items))
+	}
+	assertEqual(t, library.Items[metaPreview.ID], libraryItem, "Library updated successfully in memory")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Library recent slot updated successfully in storage")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(uid("id"), []types.LibraryItem{libraryItem}), "Library recent slot updated successfully in storage")
+	if _, ok := env.Storage[stremiocore.LIBRARY_STORAGE_KEY]; ok {
+		t.Errorf("Library slot updated successfully in storage")
+	}
+	if len(env.Requests) != 1 {
+		t.Fatalf("One request has been sent, got %d", len(env.Requests))
+	}
+	if env.Requests[0].URL != "https://api.strem.io/api/datastorePut" {
+		t.Errorf("datastorePut request has been sent")
+	}
+	// the events
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventLibraryItemAdded,
+		msg.EventLibraryItemsPushedToAPI,
+		msg.EventLibraryItemsPushedToStorage,
+	}, "events")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemAdded), msg.EventLibraryItemAdded, `{"id":"id"}`, "LibraryItemAdded")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage, `{"ids":["id"]}`, "LibraryItemsPushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToAPI), msg.EventLibraryItemsPushedToAPI, `{"ids":["id"]}`, "LibraryItemsPushedToAPI")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+func TestActionCtxAddToLibraryAlreadyAdded(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 2))
+	setRoutes(t, env)
+	metaPreview := types.MetaItemPreview{
+		ID:          "id",
+		Type:        "type",
+		Name:        "name",
+		Poster:      strPtr("http://poster/"),
+		PosterShape: types.PosterShapeSquare,
+		BehaviorHints: types.MetaItemBehaviorHints{
+			DefaultVideoID: strPtr("video_id2"),
+		},
+	}
+	libraryItem := types.LibraryItem{
+		ID:          "id",
+		Type:        "type",
+		Name:        "name",
+		Poster:      strPtr("http://poster/"),
+		PosterShape: types.PosterShapeSquare,
+		Ctime:       timePtr(date(2020, 1, 1)),
+		Mtime:       date(2020, 1, 2),
+		State:       types.LibraryItemState{VideoID: strPtr("video_id")},
+		BehaviorHints: types.MetaItemBehaviorHints{
+			DefaultVideoID: strPtr("video_id2"),
+		},
+	}
+	h := newHarness(t, env, withProfileAndLibrary(env,
+		types.NewProfile(),
+		types.NewLibraryBucket(nil, []types.LibraryItem{{
+			ID:          "id",
+			Type:        "typename_",
+			Name:        "name_",
+			PosterShape: types.PosterShapePoster,
+			Removed:     true,
+			Temp:        true,
+			Ctime:       timePtr(date(2020, 1, 1)),
+			Mtime:       date(2020, 1, 1),
+			State:       types.LibraryItemState{VideoID: strPtr("video_id")},
+		}}),
+	))
+	h.dispatchCtx(msg.ActionCtxAddToLibrary, metaPreview)
+
+	library := h.ctx().Library
+	if len(library.Items) != 1 {
+		t.Fatalf("There is one library item in memory, got %d", len(library.Items))
+	}
+	assertEqual(t, library.Items[libraryItem.ID], libraryItem, "Library updated successfully in memory")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Library recent slot updated successfully in storage")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(nil, []types.LibraryItem{libraryItem}), "Library recent slot updated successfully in storage")
+	if _, ok := env.Storage[stremiocore.LIBRARY_STORAGE_KEY]; ok {
+		t.Errorf("Library slot updated successfully in storage")
+	}
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+}
diff --git a/models/ctx/authenticate_test.go b/models/ctx/authenticate_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b5132d9727172d60fb944ab1142f5823d941057a
--- /dev/null
+++ b/models/ctx/authenticate_test.go
@@ -0,0 +1,207 @@
+package ctx_test
+
+import (
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of src/unit_tests/ctx/authenticate.rs
+
+const (
+	authAddonCollectionGetURL  = "https://api.strem.io/api/addonCollectionGet"
+	authAddonCollectionGetBody = `{"type":"AddonCollectionGet","authKey":"auth_key","update":true}`
+	authDatastoreGetURL        = "https://api.strem.io/api/datastoreGet"
+	authDatastoreGetBody       = `{"authKey":"auth_key","collection":"libraryItem","ids":[],"all":true}`
+)
+
+// authCollectionResponse is the API response of addonCollectionGet (rust
+// `APIResult::Ok(CollectionResponse { addons, last_modified })`).
+func authCollectionResponse(addons []types.Descriptor, lastModified time.Time) string {
+	if addons == nil {
+		addons = []types.Descriptor{}
+	}
+	return apiOK(struct {
+		Addons       []types.Descriptor `json:"addons"`
+		LastModified types.Time         `json:"lastModified"`
+	}{addons, types.Time(lastModified)})
+}
+
+// authProfileFixture is rust `profile_fixture()`: the logged in user without addons.
+func authProfileFixture(now time.Time) types.Profile {
+	profile := loggedInProfile(userFixture(now))
+	profile.Addons = []types.Descriptor{}
+	return profile
+}
+
+// authTestAuthenticate runs an `Authenticate` test: the auth request (sent
+// to authURL with authBody) is answered with rust `auth_response_fixture()`,
+// the user's addon collection and library are empty. authRequestJSON is the
+// expected serialization of the auth request (the `auth_request` of the
+// `UserAuthenticated` event).
+func authTestAuthenticate(t *testing.T, request types.AuthRequest, authURL, authBody, authRequestJSON string) {
+	t.Helper()
+	env := newTestEnv(time.Time{})
+	now := env.Now()
+	authRoute := fetchRoute{
+		Method:   "POST",
+		URL:      authURL,
+		Body:     authBody,
+		Response: apiOK(types.AuthResponse{Key: "auth_key", User: userFixture(now)}),
+	}
+	collectionRoute := fetchRoute{
+		Method:   "POST",
+		URL:      authAddonCollectionGetURL,
+		Body:     authAddonCollectionGetBody,
+		Response: authCollectionResponse(nil, now),
+	}
+	datastoreRoute := fetchRoute{
+		Method:   "POST",
+		URL:      authDatastoreGetURL,
+		Body:     authDatastoreGetBody,
+		Response: apiOKRaw(`[]`),
+	}
+	setRoutes(t, env, authRoute, collectionRoute, datastoreRoute)
+	h := newHarness(t, env, defaultCtx(env))
+	h.dispatchCtx(msg.ActionCtxAuthenticate, request)
+
+	c := h.ctx()
+	assertEqual(t, c.Profile, authProfileFixture(now), "profile updated successfully in memory")
+	assertEqual(t, c.Library, types.NewLibraryBucket(uid("user_id"), nil), "library updated successfully in memory")
+	if c.Status.Loading != nil {
+		t.Errorf("status is Ready after the authentication, got %s", types.MustMarshalJSON(c.Status))
+	}
+	profile, ok := storageValue[types.Profile](t, env, stremiocore.PROFILE_STORAGE_KEY)
+	if !ok {
+		t.Errorf("profile updated successfully in storage: missing key")
+	}
+	assertEqual(t, profile, authProfileFixture(now), "profile updated successfully in storage")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Errorf("recent library updated successfully in storage: missing key")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(uid("user_id"), nil), "recent library updated successfully in storage")
+	library, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_STORAGE_KEY)
+	if !ok {
+		t.Errorf("library updated successfully in storage: missing key")
+	}
+	assertEqual(t, library, types.NewLibraryBucket(uid("user_id"), nil), "library updated successfully in storage")
+	if len(env.Requests) != 3 {
+		t.Errorf("Three requests have been sent, got %d: %s", len(env.Requests), describeRequests(env.Requests))
+	}
+	assertRequests(t, env,
+		fetchRoute{Method: "POST", URL: authURL, Body: authBody},
+		fetchRoute{Method: "POST", URL: authAddonCollectionGetURL, Body: authAddonCollectionGetBody},
+		fetchRoute{Method: "POST", URL: authDatastoreGetURL, Body: authDatastoreGetBody},
+	)
+
+	// the events: the ctx events of the `CtxAuthResult`, then the storage
+	// futures in the order of the internal messages (profile, library,
+	// streams, server urls, notifications, search history)
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventUserAuthenticated,
+		msg.EventUserAddonsLocked,
+		msg.EventUserLibraryMissing,
+		msg.EventProfilePushedToStorage,
+		msg.EventLibraryItemsPushedToStorage,
+		msg.EventStreamsPushedToStorage,
+		msg.EventStreamingServerUrlsPushedToStorage,
+		msg.EventNotificationsPushedToStorage,
+		msg.EventSearchHistoryPushedToStorage,
+	}, "events")
+	assertEvent(t, h.findEvent(msg.EventUserAuthenticated), msg.EventUserAuthenticated,
+		`{"auth_request":`+authRequestJSON+`}`, "UserAuthenticated")
+	assertEvent(t, h.findEvent(msg.EventUserAddonsLocked), msg.EventUserAddonsLocked,
+		`{"addons_locked":false}`, "UserAddonsLocked")
+	assertEvent(t, h.findEvent(msg.EventUserLibraryMissing), msg.EventUserLibraryMissing,
+		`{"library_missing":false}`, "UserLibraryMissing")
+	assertEvent(t, h.findEvent(msg.EventProfilePushedToStorage), msg.EventProfilePushedToStorage,
+		`{"uid":"user_id"}`, "ProfilePushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage,
+		`{"ids":[]}`, "LibraryItemsPushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventStreamsPushedToStorage), msg.EventStreamsPushedToStorage,
+		`{"uid":"user_id"}`, "StreamsPushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventStreamingServerUrlsPushedToStorage), msg.EventStreamingServerUrlsPushedToStorage,
+		`{"uid":"user_id"}`, "StreamingServerUrlsPushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventNotificationsPushedToStorage), msg.EventNotificationsPushedToStorage,
+		`{"ids":[]}`, "NotificationsPushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventSearchHistoryPushedToStorage), msg.EventSearchHistoryPushedToStorage,
+		`{"uid":"user_id"}`, "SearchHistoryPushedToStorage")
+	// the Authenticate action is unchanged, the CtxAuthResult changes the ctx
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+func TestActionCtxAuthenticateLogin(t *testing.T) {
+	authTestAuthenticate(t,
+		types.AuthRequest{
+			Type:     types.AuthRequestLogin,
+			Email:    "user_email",
+			Password: "user_password",
+			Facebook: false,
+		},
+		"https://api.strem.io/api/login",
+		`{"type":"Auth","type":"Login","email":"user_email","password":"user_password","facebook":false}`,
+		`{"type":"Login","email":"user_email","password":"user_password","facebook":false}`,
+	)
+}
+
+func TestActionCtxAuthenticateLoginWithToken(t *testing.T) {
+	authTestAuthenticate(t,
+		types.AuthRequest{
+			Type:  types.AuthRequestLoginWithToken,
+			Token: "auth_key",
+		},
+		"https://api.strem.io/api/loginWithToken",
+		`{"type":"Auth","type":"LoginWithToken","token":"auth_key"}`,
+		`{"type":"LoginWithToken","token":"auth_key"}`,
+	)
+}
+
+func TestActionCtxAuthenticateFacebook(t *testing.T) {
+	authTestAuthenticate(t,
+		types.AuthRequest{
+			Type:  types.AuthRequestFacebook,
+			Token: "access_token",
+		},
+		"https://api.strem.io/api/authWithFacebook",
+		`{"type":"Auth","type":"Facebook","token":"access_token"}`,
+		`{"type":"Facebook","token":"access_token"}`,
+	)
+}
+
+func TestActionCtxAuthenticateApple(t *testing.T) {
+	authTestAuthenticate(t,
+		types.AuthRequest{
+			Type:  types.AuthRequestApple,
+			Token: "access_token",
+			Sub:   "sub_id",
+			Email: "user_email",
+			Name:  "user_name",
+		},
+		"https://api.strem.io/api/authWithApple",
+		`{"type":"Auth","type":"Apple","token":"access_token","sub":"sub_id","email":"user_email","name":"user_name"}`,
+		`{"type":"Apple","token":"access_token","sub":"sub_id","email":"user_email","name":"user_name"}`,
+	)
+}
+
+func TestActionCtxAuthenticateRegister(t *testing.T) {
+	authTestAuthenticate(t,
+		types.AuthRequest{
+			Type:     types.AuthRequestRegister,
+			Email:    "user_email",
+			Password: "user_password",
+			GDPRConsent: types.GDPRConsent{
+				Tos:       true,
+				Privacy:   true,
+				Marketing: false,
+				From:      strPtr("tests"),
+			},
+		},
+		"https://api.strem.io/api/register",
+		`{"type":"Auth","type":"Register","email":"user_email","password":"user_password","gdpr_consent":{"tos":true,"privacy":true,"marketing":false,"from":"tests"}}`,
+		`{"type":"Register","email":"user_email","password":"user_password","gdpr_consent":{"tos":true,"privacy":true,"marketing":false,"from":"tests"}}`,
+	)
+}
diff --git a/models/ctx/ctx.go b/models/ctx/ctx.go
new file mode 100644
index 0000000000000000000000000000000000000000..fda565ae66c83c062780d59f7a5562835cb2ea1d
--- /dev/null
+++ b/models/ctx/ctx.go
@@ -0,0 +1,397 @@
+// Package ctx implements the Ctx model: the user profile, library,
+// notifications, streams, search history, streaming server urls and
+// dismissed events, their synchronization with the API and their persistence.
+package ctx
+
+import (
+	"encoding/json"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// CtxStatus is the status of the Ctx: ready or loading an authentication.
+type CtxStatus struct {
+	// Loading is the authentication being loaded, nil when ready.
+	Loading *types.AuthRequest
+}
+
+// IsLoading reports whether the given authentication is being loaded.
+func (s CtxStatus) IsLoading(request types.AuthRequest) bool {
+	return s.Loading != nil && types.Equal(*s.Loading, request)
+}
+
+func (s CtxStatus) MarshalJSON() ([]byte, error) {
+	if s.Loading == nil {
+		return []byte(`"Ready"`), nil
+	}
+	return types.MarshalJSON(map[string]types.AuthRequest{"Loading": *s.Loading})
+}
+
+// Events are the modal and notification events of the API.
+type Events struct {
+	Modal        common.Loadable[*types.GetModalResponse]
+	Notification common.Loadable[*types.GetNotificationResponse]
+}
+
+func (e Events) MarshalJSON() ([]byte, error) {
+	return types.MarshalJSON(struct {
+		Modal        common.Loadable[*types.GetModalResponse]        `json:"modal"`
+		Notification common.Loadable[*types.GetNotificationResponse] `json:"notification"`
+	}{e.Modal, e.Notification})
+}
+
+// Ctx is the context of the user shared by all the models.
+type Ctx struct {
+	Profile             types.Profile
+	Library             types.LibraryBucket
+	Notifications       types.NotificationsBucket
+	Streams             types.StreamsBucket
+	StreamingServerURLs types.ServerUrlsBucket
+	SearchHistory       types.SearchHistoryBucket
+	DismissedEvents     types.DismissedEventsBucket
+	Status              CtxStatus
+	// TraktAddon is used only for loading the descriptor, which is then discarded.
+	TraktAddon *common.DescriptorLoadable
+	// NotificationCatalogs are the responses of the addons supporting the
+	// `lastVideosIds` extra.
+	NotificationCatalogs []common.ResourceLoadable[[]types.MetaItem]
+	Events               Events
+}
+
+// New creates the Ctx from the persisted state.
+func New(
+	profile types.Profile,
+	library types.LibraryBucket,
+	streams types.StreamsBucket,
+	streamingServerURLs types.ServerUrlsBucket,
+	notifications types.NotificationsBucket,
+	searchHistory types.SearchHistoryBucket,
+	dismissedEvents types.DismissedEventsBucket,
+) *Ctx {
+	return &Ctx{
+		Profile:              profile,
+		Library:              library,
+		Streams:              streams,
+		StreamingServerURLs:  streamingServerURLs,
+		Notifications:        notifications,
+		SearchHistory:        searchHistory,
+		DismissedEvents:      dismissedEvents,
+		NotificationCatalogs: []common.ResourceLoadable[[]types.MetaItem]{},
+		Events: Events{
+			Modal:        common.Loading[*types.GetModalResponse](),
+			Notification: common.Loading[*types.GetNotificationResponse](),
+		},
+	}
+}
+
+// NewDefault creates the Ctx of a user which is not logged in.
+func NewDefault(env runtime.Env) *Ctx {
+	return New(
+		types.NewProfile(),
+		types.NewLibraryBucket(nil, nil),
+		types.NewStreamsBucket(nil),
+		types.NewServerUrlsBucket(env.Now(), nil),
+		types.NewNotificationsBucket(env.Now(), nil, nil),
+		types.NewSearchHistoryBucket(nil),
+		types.NewDismissedEventsBucket(nil),
+	)
+}
+
+func (c *Ctx) MarshalJSON() ([]byte, error) {
+	return types.MarshalJSON(struct {
+		Profile       types.Profile             `json:"profile"`
+		Notifications types.NotificationsBucket `json:"notifications"`
+		Events        Events                    `json:"events"`
+	}{c.Profile, c.Notifications, c.Events})
+}
+
+// Update handles the message and returns the effects.
+func (c *Ctx) Update(env runtime.Env, m *msg.Msg) runtime.Effects {
+	if action := ctxAction(m); action != nil {
+		switch action.Action {
+		case msg.ActionCtxAuthenticate:
+			var request types.AuthRequest
+			if err := action.DecodeArgs(&request); err != nil {
+				return runtime.NoneEffects().Unchanged()
+			}
+			c.Status = CtxStatus{Loading: &request}
+			return runtime.OneEffect(authenticate(env, request)).Unchanged()
+		case msg.ActionCtxLogout:
+			return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalLogout, false))).Unchanged()
+		}
+	}
+	if deleted, ok := InternalLogoutData(m); ok {
+		uid := c.Profile.UID()
+		sessionEffects := runtime.NoneEffects().Unchanged()
+		if authKey := c.Profile.AuthKey(); authKey != nil && !deleted {
+			sessionEffects = runtime.OneEffect(deleteSession(env, *authKey)).Unchanged()
+		}
+		profileEffects := updateProfile(env, &c.Profile, &c.Streams, &c.Status, m)
+		libraryEffects := updateLibrary(env, &c.Library, &c.Profile, &c.Status, m)
+		streamsEffects := updateStreams(env, &c.Streams, &c.Status, m)
+		serverURLsEffects := updateStreamingServerURLs(env, &c.StreamingServerURLs, &c.Status, m)
+		searchHistoryEffects := updateSearchHistory(env, &c.SearchHistory, &c.Status, m)
+		eventsEffects := updateEvents(env, &c.Events, &c.DismissedEvents, m)
+		traktAddonEffects := updateTraktAddon(env, &c.TraktAddon, &c.Profile, &c.Status, m)
+		notificationsEffects := updateNotifications(env, &c.Notifications, &c.NotificationCatalogs, &c.Profile, &c.Library, &c.Status, m)
+		c.Status = CtxStatus{}
+		return runtime.MsgEffects(msg.EventMsg(msg.UIDEvent(msg.EventUserLoggedOut, uid))).Unchanged().
+			Join(sessionEffects).
+			Join(profileEffects).
+			Join(libraryEffects).
+			Join(streamsEffects).
+			Join(serverURLsEffects).
+			Join(searchHistoryEffects).
+			Join(eventsEffects).
+			Join(traktAddonEffects).
+			Join(notificationsEffects)
+	}
+	if result, ok := InternalCtxAuthResultData(m); ok {
+		profileEffects := updateProfile(env, &c.Profile, &c.Streams, &c.Status, m)
+		libraryEffects := updateLibrary(env, &c.Library, &c.Profile, &c.Status, m)
+		traktAddonEffects := updateTraktAddon(env, &c.TraktAddon, &c.Profile, &c.Status, m)
+		notificationsEffects := updateNotifications(env, &c.Notifications, &c.NotificationCatalogs, &c.Profile, &c.Library, &c.Status, m)
+		streamsEffects := updateStreams(env, &c.Streams, &c.Status, m)
+		serverURLsEffects := updateStreamingServerURLs(env, &c.StreamingServerURLs, &c.Status, m)
+		searchHistoryEffects := updateSearchHistory(env, &c.SearchHistory, &c.Status, m)
+		eventsEffects := updateEvents(env, &c.Events, &c.DismissedEvents, m)
+		ctxEffects := runtime.NoneEffects().Unchanged()
+		if c.Status.IsLoading(result.AuthRequest) {
+			c.Status = CtxStatus{}
+			authenticatedEvent := msg.NewEvent(msg.EventUserAuthenticated, struct {
+				AuthRequest types.AuthRequest `json:"auth_request"`
+			}{result.AuthRequest})
+			if result.Response != nil {
+				addonsLockedEvent := msg.NewEvent(msg.EventUserAddonsLocked, struct {
+					AddonsLocked bool `json:"addons_locked"`
+				}{result.Response.AddonsErr != nil})
+				addonsEffects := runtime.MsgEffects(msg.EventMsg(addonsLockedEvent)).Unchanged()
+				if result.Response.AddonsErr != nil {
+					addonsEffects = runtime.MsgEffects(msg.EventMsg(msg.ErrorEvent(
+						NewOtherError(OtherErrorUserAddonsAreLocked), addonsLockedEvent))).Unchanged()
+				}
+				libraryMissingEvent := msg.NewEvent(msg.EventUserLibraryMissing, struct {
+					LibraryMissing bool `json:"library_missing"`
+				}{result.Response.LibraryItemsErr != nil})
+				libraryMissingEffects := runtime.MsgEffects(msg.EventMsg(libraryMissingEvent)).Unchanged()
+				if result.Response.LibraryItemsErr != nil {
+					libraryMissingEffects = runtime.MsgEffects(msg.EventMsg(msg.ErrorEvent(
+						NewOtherError(OtherErrorUserLibraryIsMissing), libraryMissingEvent))).Unchanged()
+				}
+				ctxEffects = runtime.MsgEffects(msg.EventMsg(authenticatedEvent)).Unchanged().
+					Join(addonsEffects).
+					Join(libraryMissingEffects)
+			} else {
+				ctxEffects = runtime.MsgEffects(msg.EventMsg(msg.ErrorEvent(result.Err, authenticatedEvent))).Unchanged()
+			}
+		}
+		return profileEffects.
+			Join(libraryEffects).
+			Join(streamsEffects).
+			Join(serverURLsEffects).
+			Join(traktAddonEffects).
+			Join(notificationsEffects).
+			Join(searchHistoryEffects).
+			Join(eventsEffects).
+			Join(ctxEffects)
+	}
+	profileEffects := updateProfile(env, &c.Profile, &c.Streams, &c.Status, m)
+	libraryEffects := updateLibrary(env, &c.Library, &c.Profile, &c.Status, m)
+	streamsEffects := updateStreams(env, &c.Streams, &c.Status, m)
+	serverURLsEffects := updateStreamingServerURLs(env, &c.StreamingServerURLs, &c.Status, m)
+	traktAddonEffects := updateTraktAddon(env, &c.TraktAddon, &c.Profile, &c.Status, m)
+	notificationsEffects := updateNotifications(env, &c.Notifications, &c.NotificationCatalogs, &c.Profile, &c.Library, &c.Status, m)
+	searchHistoryEffects := updateSearchHistory(env, &c.SearchHistory, &c.Status, m)
+	eventsEffects := updateEvents(env, &c.Events, &c.DismissedEvents, m)
+	return profileEffects.
+		Join(libraryEffects).
+		Join(streamsEffects).
+		Join(serverURLsEffects).
+		Join(traktAddonEffects).
+		Join(notificationsEffects).
+		Join(searchHistoryEffects).
+		Join(eventsEffects)
+}
+
+// authenticate authenticates with the API and fetches the user's addons
+// collection and library; only a failed authentication is an error.
+func authenticate(env runtime.Env, authRequest types.AuthRequest) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		env.FlushAnalytics()
+		result := CtxAuthResult{AuthRequest: authRequest}
+		authResponse, apiErr, envErr := common.FetchAPI[types.AuthResponse](env, types.APIRequest{Type: types.APIRequestAuth, Auth: authRequest})
+		if err := CtxErrorFromAPIResult(apiErr, envErr); err != nil {
+			result.Err = err
+			return msg.InternalMsg(msg.NewInternal(msg.InternalCtxAuthResult, result))
+		}
+		auth := types.Auth{Key: authResponse.Key, User: authResponse.User}
+		response := &CtxAuthResponse{Auth: auth}
+
+		collection, apiErr, envErr := common.FetchAPI[types.CollectionResponse](env, types.APIRequest{
+			Type:    types.APIRequestAddonCollectionGet,
+			AuthKey: auth.Key,
+			Update:  true,
+		})
+		if err := CtxErrorFromAPIResult(apiErr, envErr); err != nil {
+			response.AddonsErr = err
+			env.Log("Failed to fetch Addon collection from API: " + err.Error())
+		} else {
+			response.Addons = collection.Addons
+		}
+
+		items, apiErr, envErr := common.FetchAPI[types.LibraryItemsResponse](env, types.DatastoreRequest{
+			AuthKey:    auth.Key,
+			Collection: stremiocore.LIBRARY_COLLECTION_NAME,
+			Command:    types.DatastoreCommand{Kind: types.DatastoreCommandGet, IDs: []string{}, All: true},
+		})
+		if err := CtxErrorFromAPIResult(apiErr, envErr); err != nil {
+			response.LibraryItemsErr = err
+			env.Log("Failed to fetch LibraryItems for user from API: " + err.Error())
+		} else {
+			response.LibraryItems = items
+		}
+		result.Response = response
+		return msg.InternalMsg(msg.NewInternal(msg.InternalCtxAuthResult, result))
+	})
+}
+
+func deleteSession(env runtime.Env, authKey types.AuthKey) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		env.FlushAnalytics()
+		_, apiErr, envErr := common.FetchAPI[types.SuccessResponse](env, types.APIRequest{Type: types.APIRequestLogout, AuthKey: authKey})
+		event := msg.NewEvent(msg.EventSessionDeleted, struct {
+			AuthKey types.AuthKey `json:"auth_key"`
+		}{authKey})
+		if err := CtxErrorFromAPIResult(apiErr, envErr); err != nil {
+			return msg.EventMsg(msg.ErrorEvent(err, event))
+		}
+		return msg.EventMsg(event)
+	})
+}
+
+//
+// Message helpers
+//
+
+// ctxAction returns the nested action of a `Ctx` action.
+func ctxAction(m *msg.Msg) *msg.Action {
+	return m.NestedAction(msg.ActionNameCtx)
+}
+
+// ctxActionArgs returns the arguments of the `Ctx` action named name.
+func ctxActionArgs(m *msg.Msg, name string) (json.RawMessage, bool) {
+	action := ctxAction(m)
+	if action == nil || action.Action != name {
+		return nil, false
+	}
+	return action.Args, true
+}
+
+// decodeCtxAction decodes the arguments of the `Ctx` action named name.
+func decodeCtxAction(m *msg.Msg, name string, value any) bool {
+	args, ok := ctxActionArgs(m, name)
+	if !ok {
+		return false
+	}
+	return json.Unmarshal(args, value) == nil
+}
+
+// isCtxAction reports whether the message is the `Ctx` action named name.
+func isCtxAction(m *msg.Msg, name string) bool {
+	_, ok := ctxActionArgs(m, name)
+	return ok
+}
+
+func internalData[T any](m *msg.Msg, name string) (T, bool) {
+	var zero T
+	data, ok := m.InternalData(name)
+	if !ok {
+		return zero, false
+	}
+	switch value := data.(type) {
+	case T:
+		return value, true
+	case *T:
+		if value != nil {
+			return *value, true
+		}
+	}
+	return zero, false
+}
+
+// InternalLogoutData returns whether the session was already deleted, for a `Logout` message.
+func InternalLogoutData(m *msg.Msg) (bool, bool) {
+	if !m.IsInternal(msg.InternalLogout) {
+		return false, false
+	}
+	deleted, _ := m.Internal.Data.(bool)
+	return deleted, true
+}
+
+// InternalCtxAuthResultData returns the data of a `CtxAuthResult` message.
+func InternalCtxAuthResultData(m *msg.Msg) (CtxAuthResult, bool) {
+	return internalData[CtxAuthResult](m, msg.InternalCtxAuthResult)
+}
+
+// InternalBoolData returns the boolean data of an internal message (false if unset).
+func InternalBoolData(m *msg.Msg, name string) (bool, bool) {
+	if !m.IsInternal(name) {
+		return false, false
+	}
+	value, _ := m.Internal.Data.(bool)
+	return value, true
+}
+
+// InternalLibraryItemData returns the item of an `UpdateLibraryItem` message.
+func InternalLibraryItemData(m *msg.Msg) (types.LibraryItem, bool) {
+	return internalData[types.LibraryItem](m, msg.InternalUpdateLibraryItem)
+}
+
+// InternalDescriptorData returns the addon of an `InstallAddon`/`UninstallAddon` message.
+func InternalDescriptorData(m *msg.Msg, name string) (types.Descriptor, bool) {
+	return internalData[types.Descriptor](m, name)
+}
+
+// InternalStringData returns the string data of an internal message.
+func InternalStringData(m *msg.Msg, name string) (string, bool) {
+	return internalData[string](m, name)
+}
+
+// InternalStreamLoadedData returns the data of a `StreamLoaded` message.
+func InternalStreamLoadedData(m *msg.Msg) (StreamLoaded, bool) {
+	return internalData[StreamLoaded](m, msg.InternalStreamLoaded)
+}
+
+// InternalStreamStateChangedData returns the data of a `StreamStateChanged` message.
+func InternalStreamStateChangedData(m *msg.Msg) (StreamStateChanged, bool) {
+	return internalData[StreamStateChanged](m, msg.InternalStreamStateChanged)
+}
+
+// InternalData returns the typed data of an internal message.
+func InternalData[T any](m *msg.Msg, name string) (T, bool) {
+	return internalData[T](m, name)
+}
+
+// profileChangedEffects are the effects of a profile change.
+func profileChangedEffects() runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalProfileChanged, nil)))
+}
+
+// errorEffects returns the unchanged effects emitting an error event.
+func errorEffects(err *CtxError, source *msg.Event) runtime.Effects {
+	return runtime.MsgEffects(msg.EventMsg(msg.ErrorEvent(err, source))).Unchanged()
+}
+
+// eventEffects returns the unchanged effects emitting an event.
+func eventEffects(event *msg.Event) runtime.Effects {
+	return runtime.MsgEffects(msg.EventMsg(event)).Unchanged()
+}
+
+// internalEffects returns the (changed) effects dispatching an internal message.
+func internalEffects(name string, data any) runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(name, data)))
+}
