new file mode 100644
index 0000000000000000000000000000000000000000..f0b52e82b80629f060dc21a4a11c8347d98ad043
--- /dev/null
+++ b/models/ctx/helpers.go
@@ -0,0 +1,204 @@
+package ctx
+
+import (
+	"bytes"
+	"encoding/json"
+	"sort"
+
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Helpers shared by the Ctx update functions.
+
+// decodeStrictCtxAction decodes the arguments of the `Ctx` action named
+// name; missing or `null` arguments are invalid.
+func decodeStrictCtxAction(m *msg.Msg, name string, value any) bool {
+	args, ok := ctxActionArgs(m, name)
+	if !ok || isNullJSON(args) {
+		return false
+	}
+	return json.Unmarshal(args, value) == nil
+}
+
+func isNullJSON(data []byte) bool {
+	trimmed := bytes.TrimSpace(data)
+	return len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null"))
+}
+
+// decodeURLArg decodes the url argument of a `Ctx` action (rust `Url`). The
+// url is kept as given; the buckets compare urls by their normalized form.
+func decodeURLArg(m *msg.Msg, name string) (string, bool) {
+	var url string
+	if !decodeStrictCtxAction(m, name, &url) || !types.IsValidURL(url) {
+		return "", false
+	}
+	return url, true
+}
+
+// fetchAPI sends the API request and converts the errors to a CtxError.
+func fetchAPI[T any](env runtime.Env, request types.FetchRequest) (T, *CtxError) {
+	result, apiErr, envErr := common.FetchAPI[T](env, request)
+	return result, CtxErrorFromAPIResult(apiErr, envErr)
+}
+
+// eventResultMsg returns the event, or an error event with the event as
+// source if err is set.
+func eventResultMsg(err *CtxError, event *msg.Event) *msg.Msg {
+	if err != nil {
+		return msg.EventMsg(msg.ErrorEvent(err, event))
+	}
+	return msg.EventMsg(event)
+}
+
+// storageResult converts the result of persisting to storage to the event
+// (or an error event with the event as source).
+func storageResult(event *msg.Event) func(*runtime.EnvError) *msg.Msg {
+	return func(err *runtime.EnvError) *msg.Msg {
+		if err != nil {
+			return msg.EventMsg(msg.ErrorEvent(NewEnvError(err), event))
+		}
+		return msg.EventMsg(event)
+	}
+}
+
+// storageWrite is a value to persist under a key; a nil value removes the key.
+type storageWrite struct {
+	key   string
+	value any
+}
+
+// storageWritesFuture is the sequential effect persisting all the values
+// (rust `try_join_all` of `set_storage` futures). The values are serialized
+// when the effect is created.
+func storageWritesFuture(env runtime.Env, writes []storageWrite, onResult func(*runtime.EnvError) *msg.Msg) runtime.Effect {
+	snapshots := make([]any, len(writes))
+	for i, write := range writes {
+		if write.value == nil {
+			continue
+		}
+		data, err := types.MarshalJSON(write.value)
+		if err != nil {
+			serdeErr := runtime.EnvErrorSerde(err.Error())
+			return runtime.SequentialFuture(func() *msg.Msg { return onResult(serdeErr) })
+		}
+		snapshots[i] = json.RawMessage(data)
+	}
+	keys := make([]string, len(writes))
+	for i, write := range writes {
+		keys[i] = write.key
+	}
+	return runtime.SequentialFuture(func() *msg.Msg {
+		for i, key := range keys {
+			if err := env.SetStorage(key, snapshots[i]); err != nil {
+				return onResult(err)
+			}
+		}
+		return onResult(nil)
+	})
+}
+
+// transportURLEqual compares two transport urls the way rust compares `Url`s.
+func transportURLEqual(a, b string) bool {
+	return a == b || types.NormalizeURL(a) == types.NormalizeURL(b)
+}
+
+// descriptorEqual compares two addons (rust `Descriptor: PartialEq`).
+func descriptorEqual(a, b types.Descriptor) bool {
+	return transportURLEqual(a.TransportURL, b.TransportURL) &&
+		types.Equal(a.Manifest, b.Manifest) &&
+		a.Flags == b.Flags
+}
+
+// containsAddon reports whether the addon is installed (rust `Vec::contains`).
+func containsAddon(addons []types.Descriptor, addon types.Descriptor) bool {
+	for _, installed := range addons {
+		if descriptorEqual(installed, addon) {
+			return true
+		}
+	}
+	return false
+}
+
+// addonPosition returns the position of the addon with the transport url, or -1.
+func addonPosition(addons []types.Descriptor, transportURL string) int {
+	for i, addon := range addons {
+		if transportURLEqual(addon.TransportURL, transportURL) {
+			return i
+		}
+	}
+	return -1
+}
+
+// addonsEqual compares two lists of addons.
+func addonsEqual(a, b []types.Descriptor) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !descriptorEqual(a[i], b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// transportURLs returns the transport urls of the addons.
+func transportURLs(addons []types.Descriptor) []string {
+	urls := make([]string, 0, len(addons))
+	for _, addon := range addons {
+		urls = append(urls, addon.TransportURL)
+	}
+	return urls
+}
+
+// transportURLsDiff returns the transport urls added in next followed by
+// the ones removed from prev (rust `HashSet` differences, sorted for
+// determinism).
+func transportURLsDiff(prev, next []types.Descriptor) []string {
+	prevSet := map[string]bool{}
+	for _, addon := range prev {
+		prevSet[types.NormalizeURL(addon.TransportURL)] = true
+	}
+	nextSet := map[string]bool{}
+	for _, addon := range next {
+		nextSet[types.NormalizeURL(addon.TransportURL)] = true
+	}
+	added := []string{}
+	seen := map[string]bool{}
+	for _, addon := range next {
+		key := types.NormalizeURL(addon.TransportURL)
+		if !prevSet[key] && !seen[key] {
+			seen[key] = true
+			added = append(added, addon.TransportURL)
+		}
+	}
+	removed := []string{}
+	for _, addon := range prev {
+		key := types.NormalizeURL(addon.TransportURL)
+		if !nextSet[key] && !seen[key] {
+			seen[key] = true
+			removed = append(removed, addon.TransportURL)
+		}
+	}
+	sort.Strings(added)
+	sort.Strings(removed)
+	return append(added, removed...)
+}
+
+// libraryItemEqual compares two library items (rust `LibraryItem: PartialEq`).
+func libraryItemEqual(a, b types.LibraryItem) bool {
+	return a.Mtime.Equal(b.Mtime) && a.EqNoMtime(b)
+}
+
+// sortedKeys returns the sorted keys of the map.
+func sortedKeys[V any](items map[string]V) []string {
+	keys := make([]string, 0, len(items))
+	for key := range items {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
