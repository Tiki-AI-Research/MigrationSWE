+func TestPlayerSerializationMatchesReference(t *testing.T) {
+	data, err := os.ReadFile("testdata/player_serialization.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var reference playerReference
+	if err := json.Unmarshal(data, &reference); err != nil {
+		t.Fatal(err)
+	}
+	inputs := reference.Inputs
+	selected := decodePlayerReferenceValue[Selected](t, inputs.Selected)
+	if got := string(types.MustMarshalJSON(selected)); got != reference.Selected {
+		t.Fatalf("selected:\n got %s\nwant %s", got, reference.Selected)
+	}
+	videoParams := decodePlayerReferenceValue[VideoParams](t, inputs.VideoParams)
+	metaItem := decodePlayerReferenceValue[types.MetaItem](t, inputs.MetaItem)
+	subtitles := decodePlayerReferenceValue[[]types.Subtitles](t, inputs.Subtitles)
+	nextStreams := decodePlayerReferenceValue[[]types.Stream](t, inputs.NextStreams)
+	libraryItem := decodePlayerReferenceValue[types.LibraryItem](t, inputs.LibraryItem)
+	streamState := decodePlayerReferenceValue[types.StreamItemState](t, inputs.StreamState)
+	subtitlePreference := decodePlayerReferenceValue[types.SubtitlePreference](t, inputs.SubtitlePreference)
+	errStream := decodePlayerReferenceValue[types.Stream](t, inputs.ErrStream)
+
+	player := NewPlayer()
+	player.Selected = &selected
+	player.VideoParams = &videoParams
+	metaContent := common.Ready(metaItem)
+	player.MetaItem = &common.ResourceLoadable[types.MetaItem]{Request: *selected.MetaRequest, Content: &metaContent}
+	subtitlesRequest := func(name string) types.ResourceRequest {
+		return types.ResourceRequest{Base: "https://" + name + ".subs/manifest.json", Path: *selected.SubtitlesPath}
+	}
+	subtitlesReady := common.Ready(subtitles)
+	subtitlesLoading := common.Loading[[]types.Subtitles]()
+	subtitlesEmpty := common.Err[[]types.Subtitles](&common.ResourceError{Kind: common.ResourceErrorEmptyContent})
+	subtitlesEnv := common.Err[[]types.Subtitles](&common.ResourceError{Kind: common.ResourceErrorEnv, Env: runtime.EnvErrorFetch("boom")})
+	player.Subtitles = []common.ResourceLoadable[[]types.Subtitles]{
+		{Request: subtitlesRequest("a"), Content: &subtitlesReady},
+		{Request: subtitlesRequest("b"), Content: &subtitlesLoading},
+		{Request: subtitlesRequest("c"), Content: &subtitlesEmpty},
+		{Request: subtitlesRequest("d"), Content: &subtitlesEnv},
+	}
+	nextVideo := metaItem.Videos[1]
+	nextVideo.Streams = []types.Stream{nextStreams[0]}
+	player.NextVideo = &nextVideo
+	nextStreamsRequest := *cloneResourceRequest(selected.StreamRequest)
+	nextStreamsRequest.Path.ID = "tt123456:1:2"
+	nextStreamsContent := common.Ready(nextStreams)
+	player.NextStreams = &common.ResourceLoadable[[]types.Stream]{Request: nextStreamsRequest, Content: &nextStreamsContent}
+	player.NextStream = &nextStreams[0]
+	if effects := streamUpdate(&player.Stream, player.Selected, stremiocore.STREAMING_SERVER_URL); !effects.HasChanged {
+		t.Fatalf("the stream should be converted")
+	}
+	player.SeriesInfo = &types.SeriesInfo{Season: 1, Episode: 1}
+	player.LibraryItem = &libraryItem
+	player.StreamState = &streamState
+	player.SubtitlePreference = &subtitlePreference
+	videoScale := types.VideoScaleFill
+	player.VideoScale = &videoScale
+	player.IntroOutro = &types.IntroOutro{Intro: &types.IntroData{From: 1, To: 2, Duration: playerU64Ptr(1)}, Outro: playerU64Ptr(90)}
+	// not serialized
+	player.Watched = &types.WatchedBitField{}
+	player.AnalyticsContext = &AnalyticsContext{}
+	player.SkipGaps = &SkipGaps{}
+	player.SeekHistory = []types.SeekLog{{From: 1, To: 2}}
+	if got := string(types.MustMarshalJSON(player)); got != reference.Player {
+		t.Fatalf("player:\n got %s\nwant %s", got, reference.Player)
+	}
+
+	errPlayer := NewPlayer()
+	errPlayer.Selected = &Selected{Stream: errStream}
+	streamUpdate(&errPlayer.Stream, errPlayer.Selected, stremiocore.STREAMING_SERVER_URL)
+	loading := common.Loading[types.MetaItem]()
+	errPlayer.MetaItem = &common.ResourceLoadable[types.MetaItem]{Request: *selected.MetaRequest, Content: &loading}
+	if got := string(types.MustMarshalJSON(errPlayer)); got != reference.ErrPlayer {
+		t.Fatalf("err player:\n got %s\nwant %s", got, reference.ErrPlayer)
+	}
+
+	if got := string(types.MustMarshalJSON(NewPlayer())); got != reference.DefaultPlayer {
+		t.Fatalf("default player:\n got %s\nwant %s", got, reference.DefaultPlayer)
+	}
+	if got := string(types.MustMarshalJSON(&Player{})); got != reference.DefaultPlayer {
+		t.Fatalf("zero player:\n got %s\nwant %s", got, reference.DefaultPlayer)
+	}
+}
