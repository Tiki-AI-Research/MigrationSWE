+func TestPlayerIdenticalLoadsAreObservable(t *testing.T) {
+	env := testenv.New()
+	m := New(env)
+	rt, rx := runtime.New(m, nil, 1000, env)
+	selected := Selected{Stream: playerURLStream("https://source_url", nil)}
+	for i := 0; i < 2; i++ {
+		dispatchPlayer(rt, msg.LoadAction(msg.ModelPlayer, selected))
+	}
+	newStates := [][]string{}
+	for _, event := range drainPlayerEvents(rx) {
+		if event.Name == runtime.RuntimeEventNewState {
+			newStates = append(newStates, event.Fields())
+		}
+	}
+	if len(newStates) != 2 {
+		t.Fatalf("expected 2 NewState events, got %d: %v", len(newStates), newStates)
+	}
+	for _, fields := range newStates {
+		if !reflect.DeepEqual(fields, []string{FieldPlayer}) {
+			t.Fatalf("expected the player to be the only changed field, got %v", fields)
+		}
+	}
