+}
+
+func torrentStreamingURL(fileIdx string) string {
+	return fmt.Sprintf("%s/%s/%s?tr=%s", streamingServerStrURL, hex.EncodeToString(testInfoHash[:]), fileIdx,
+		types.EncodeURIComponent("http://bt1.archive.org:6969/announce"))
+}
