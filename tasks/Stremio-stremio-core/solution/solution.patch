+	rt.Dispatch(ssAction(msg.ActionStreamingServerGetStatistics, request))
+	server := ssModel(t, rt.Model()).StreamingServer
+	if server.Statistics == nil || !server.Statistics.IsReady() {
+		t.Fatalf("statistics = %+v", server.Statistics)
