+	}
+	magnet := stream(StreamSource{Kind: StreamSourceURL, URL: "magnet:?xt=urn:btih:0101010101010101010101010101010101010101&dn=x&tr=udp%3A%2F%2Fa"})
+	convertedMagnet, err := magnet.Convert(&server)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := mustJSON(t, NewStreamUrls(convertedMagnet, &server)); got != `{"magnet_url":"magnet:?xt=urn:btih:0101010101010101010101010101010101010101&dn=x&tr=udp%3A%2F%2Fa","download_url":null,"streaming_url":null,"m3u_data_uri":null,"stream":{"url":"magnet:?xt=urn:btih:0101010101010101010101010101010101010101&dn=x&tr=udp%3A%2F%2Fa"}}` {
+		t.Fatalf("magnet urls: %s", got)
+	}
+	bytes := uint64(10)
+	fileIdx1 := uint16(1)
+	rar := stream(StreamSource{Kind: StreamSourceRar, Urls: []ArchiveURL{{URL: "https://example.com/a.rar", Bytes: &bytes}}, FileIdx: &fileIdx1})
+	convertedRar, err := rar.Convert(&server)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := mustJSON(t, convertedRar); got != `{"url":"http://127.0.0.1:11470/rar/create?lz=N4IgrgTgNgziBcBtRIAWAXdAHG8D0eApgB4CGAtllIQHQDGA9uXqTRKRCADQCMADAF0BXEADMAltQCSAE2IIeAXyA"}` {
+		t.Fatalf("rar: %s", got)
+	}
+}
+
+func TestStreamConvertErrors(t *testing.T) {
+	server := "data:text/plain,server"
+	for _, source := range []StreamSource{
+		{Kind: StreamSourceRar, Urls: []ArchiveURL{{URL: "https://example.com/archive.zip"}}},
+		{Kind: StreamSourceZip, Urls: []ArchiveURL{{URL: "https://example.com/archive.zip"}}},
+		{Kind: StreamSourceYouTube, YtID: "video_id"},
+		{Kind: StreamSourceTorrent},
+	} {
+		if _, err := stream(source).Convert(&server); err == nil {
+			t.Fatalf("%s: expected an error", source.Kind)
+		} else if _, ok := err.(*ConvertError); !ok {
+			t.Fatalf("%s: expected a ConvertError, got %T", source.Kind, err)
+		}
+	}
+	if _, err := stream(StreamSource{Kind: StreamSourceTorrent}).Convert(nil); err == nil || err.Error() != "Can't play Torrents because streaming server is not running" {
+		t.Fatalf("unexpected error %v", err)
+	}
+}
+
+func TestStreamSourceDeserialization(t *testing.T) {
+	var streams []Stream
+	data := `[
+		{"url":"https://example.com/a.mp4","title":"description"},
+		{"ytId":"abc"},
+		{"rarUrls":[["https://example-source.com/file.rar",10000],["https://example-source2.com/file2.rar",null]]},
+		{"zipUrls":[["https://example-source3.com/file.rar"]],"fileIdx":1,"fileMustInclude":["includeFile1"]},
+		{"infoHash":"df389295484b3059a4726dc6d8a57f71bb5f4c81","sources":["tracker:udp://x"]},
+		{"playerFrameUrl":"https://frame.com"},
+		{"externalUrl":"https://external.com","name":null,"subtitles":null,"behaviorHints":null},
+		{"nzbUrl":"https://nzb.com/a.nzb","servers":["nntps://news.example.com"]}
+	]`
+	if err := json.Unmarshal([]byte(data), &streams); err != nil {
+		t.Fatal(err)
+	}
+	kinds := []string{StreamSourceURL, StreamSourceYouTube, StreamSourceRar, StreamSourceZip, StreamSourceTorrent, StreamSourcePlayerFrame, StreamSourceExternal, StreamSourceNzb}
+	for i, kind := range kinds {
+		if streams[i].Source.Kind != kind {
+			t.Fatalf("stream %d: got %s, want %s", i, streams[i].Source.Kind, kind)
+		}
+	}
+	if *streams[0].Description != "description" {
+		t.Fatal("title should be an alias of description")
+	}
+	if streams[2].Source.Urls[0].Bytes == nil || *streams[2].Source.Urls[0].Bytes != 10000 || streams[2].Source.Urls[1].Bytes != nil {
+		t.Fatal("unexpected archive urls")
+	}
+	if streams[4].Source.Announce[0] != "tracker:udp://x" {
+		t.Fatal("sources should be an alias of announce")
+	}
+	var invalid Stream
+	if err := json.Unmarshal([]byte(`{"infoHash":"0x"}`), &invalid); err == nil {
+		t.Fatal("expected an error for an invalid info hash")
+	}
+}
