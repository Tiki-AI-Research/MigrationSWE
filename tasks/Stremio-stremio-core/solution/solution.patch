+func TestFlushClearsPending(t *testing.T) {
+	a, _, rec := newTestAnalytics(t)
+	a.Emit("e1", nil, "k1", nil)
+	a.Emit("e2", nil, "k2", nil)
+	release := make(chan struct{})
+	started := make(chan struct{})
+	rec.during = func(batch Batch) {
+		if batch.AuthKey == "k1" {
+			close(started)
+			<-release
+		}
+	}
+	done := make(chan struct{})
+	go func() {
+		a.SendNextBatch()
+		close(done)
+	}()
+	<-started
+	if !a.IsPending() {
+		t.Error("the batch should be pending")
+	}
+	// the lock is not held while sending
+	a.Emit("e3", nil, "k2", nil)
+	a.Flush()
+	if a.IsPending() {
+		t.Error("flush should clear the pending batch")
+	}
+	close(release)
+	<-done
+	sent := rec.sentBatches()
+	assertStrings(t, authKeys(sent), []string{"k1", "k2"})
+	assertStrings(t, eventNames(sent[1]), []string{"e2", "e3"})
+	if a.QueueLen() != 0 {
+		t.Fatalf("queue length %d, want 0", a.QueueLen())
+	}
+}
