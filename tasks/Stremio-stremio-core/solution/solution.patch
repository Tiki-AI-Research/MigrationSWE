@@ -0,0 +1,219 @@
+package ctx_test
+
+import (
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Tests of update_trakt_addon.rs (InstallTraktAddon, ManifestRequestResult,
+// UninstallTraktAddon) and LogoutTrakt of update_profile.rs.
+
+const traktManifestURL = "https://www.strem.io/trakt/addon/user_id/manifest.json"
+
+const traktManifestJSON = `{"id":"org.stremio.trakt","version":"1.0.0","name":"Trakt","types":["movie","series"],"resources":["catalog"]}`
+
+func traktAddonDescriptor(t *testing.T) types.Descriptor {
+	t.Helper()
+	var manifest types.Manifest
+	if err := manifest.UnmarshalJSON([]byte(traktManifestJSON)); err != nil {
+		t.Fatal(err)
+	}
+	return types.Descriptor{Manifest: manifest, TransportURL: traktManifestURL}
+}
+
+func traktProfile(now time.Time, addons []types.Descriptor) types.Profile {
+	user := userFixture(now)
+	user.Trakt = &types.TraktInfo{CreatedAt: now, ExpiresIn: time.Hour, AccessToken: "token"}
+	profile := loggedInProfile(user)
+	profile.Addons = addons
+	return profile
+}
+
+func TestTraktAddonURL(t *testing.T) {
+	assertEqual(t, ctx.TraktAddonURL("user_id"), traktManifestURL, "trakt addon url")
+	assertEqual(t, ctx.TraktAddonURL("a b/c?d"), "https://www.strem.io/trakt/addon/a%20b%2Fc%3Fd/manifest.json", "uid is percent-encoded")
+}
+
+func TestInstallTraktAddonNotLoggedIn(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 1))
+	setRoutes(t, env)
+	h := newHarness(t, env, defaultCtx(env))
+	h.dispatchCtx(msg.ActionCtxInstallTraktAddon, nil)
+	assertEqual(t, h.coreEventNames(), []string{msg.EventError}, "events")
