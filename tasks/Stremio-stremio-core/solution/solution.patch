+package types
+
+import (
+	"bytes"
+	"crypto/sha1"
+	"encoding/base32"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// InfoHash is a torrent info hash, (de)serialized as 40 lowercase hex chars.
+type InfoHash [20]byte
+
+// ParseInfoHash parses a 40 chars hex info hash.
+func ParseInfoHash(value string) (InfoHash, error) {
+	var hash InfoHash
+	if len(value) != 40 {
+		return hash, fmt.Errorf("invalid info hash length %d", len(value))
+	}
+	decoded, err := hex.DecodeString(value)
+	if err != nil {
+		return hash, err
+	}
+	copy(hash[:], decoded)
+	return hash, nil
+}
+
+func (h InfoHash) String() string {
+	return hex.EncodeToString(h[:])
+}
+
+func (h InfoHash) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(h.String())
+}
+
+func (h *InfoHash) UnmarshalJSON(data []byte) error {
+	var value string
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	parsed, err := ParseInfoHash(value)
+	if err != nil {
+		return err
+	}
+	*h = parsed
+	return nil
+}
+
+//
+// Magnet links
+//
+
+// Magnet is a parsed magnet link (`magnet_url::Magnet`).
+type Magnet struct {
+	DisplayName      *string
+	HashType         *string
+	Hash             *string
+	Length           *uint64
+	Source           *string
+	Trackers         []string
+	SearchKeywords   *string
+	WebSeed          *string
+	AcceptableSource *string
+	Manifest         *string
+}
+
+// ErrNotAMagnetURL is returned when the link is not a magnet link.
+var ErrNotAMagnetURL = errors.New("provided link is not a valid magnet URL")
+
+// ParseMagnet parses a magnet link. Values are kept percent-encoded.
+func ParseMagnet(link string) (Magnet, error) {
+	if !strings.HasPrefix(link, "magnet:?") {
+		return Magnet{}, ErrNotAMagnetURL
+	}
+	magnet := Magnet{Trackers: []string{}}
+	set := func(target **string, value string) {
+		v := value
+		*target = &v
+	}
+	for _, param := range strings.Split(strings.TrimPrefix(link, "magnet:?"), "&") {
+		key, value, ok := strings.Cut(param, "=")
+		if !ok {
+			continue
+		}
+		switch key {
+		case "dn":
+			set(&magnet.DisplayName, value)
+		case "xt":
+			if urn, ok := strings.CutPrefix(value, "urn:"); ok {
+				if hashType, hash, ok := strings.Cut(urn, ":"); ok {
+					set(&magnet.HashType, hashType)
+					set(&magnet.Hash, hash)
+				}
+			}
+		case "xl":
+			if length, err := strconv.ParseUint(value, 10, 64); err == nil {
+				magnet.Length = &length
+			}
+		case "tr":
+			magnet.Trackers = append(magnet.Trackers, value)
+		case "kt":
+			set(&magnet.SearchKeywords, value)
+		case "ws":
+			set(&magnet.WebSeed, value)
+		case "xs":
+			set(&magnet.Source, value)
+		case "as":
+			set(&magnet.AcceptableSource, value)
+		case "mt":
+			set(&magnet.Manifest, value)
+		}
+	}
+	return magnet, nil
+}
+
+func (m Magnet) String() string {
+	var b strings.Builder
+	b.WriteString("magnet:?")
+	if m.Hash != nil {
+		b.WriteString("xt=urn:")
+		if m.HashType != nil {
+			b.WriteString(*m.HashType)
+		}
+		b.WriteString(":")
+		b.WriteString(*m.Hash)
+	}
+	add := func(name string, value *string) {
+		if value != nil {
+			b.WriteString("&" + name + "=" + *value)
+		}
+	}
+	add("dn", m.DisplayName)
+	if m.Length != nil {
+		b.WriteString("&xl=" + strconv.FormatUint(*m.Length, 10))
+	}
+	for _, tracker := range m.Trackers {
+		b.WriteString("&tr=" + tracker)
+	}
+	add("ws", m.WebSeed)
+	add("xs", m.Source)
+	add("kt", m.SearchKeywords)
+	add("as", m.AcceptableSource)
+	add("mt", m.Manifest)
+	return b.String()
+}
+
+// BuildMagnetURI builds a magnet link for a torrent.
+func BuildMagnetURI(infoHash []byte, announce []string, name *string) string {
+	trackers := make([]string, 0, len(announce))
+	for _, tracker := range announce {
+		// Mirrors the original behaviour: the `dht:` prefix is only removed
+		// when there is no `tracker:` prefix.
+		stripped := tracker
+		if withoutTracker, ok := strings.CutPrefix(tracker, "tracker:"); ok {
+			if withoutDht, ok := strings.CutPrefix(withoutTracker, "dht:"); ok {
+				stripped = withoutDht
+			}
+		} else if withoutDht, ok := strings.CutPrefix(tracker, "dht:"); ok {
+			stripped = withoutDht
+		}
+		trackers = append(trackers, EncodeURIComponent(stripped))
+	}
+	trackersParam := ""
+	if len(trackers) > 0 {
+		trackersParam = "&tr=" + strings.Join(trackers, "&tr=")
+	}
+	dn := ""
+	if name != nil {
+		dn = "dn=" + EncodeURIComponent(*name) + "&"
+	}
+	return fmt.Sprintf("magnet:?%sxt=urn:btih:%s%s", dn, hex.EncodeToString(infoHash), trackersParam)
+}
+
+// ParseMagnetInfoHash returns the BTIH info hash and the trackers of a magnet link.
+// Base32 (32 chars) and hex (40 chars) hashes are supported.
+func ParseMagnetInfoHash(link string) (InfoHash, []string, error) {
+	var infoHash InfoHash
+	magnet, err := ParseMagnet(link)
+	if err != nil {
+		return infoHash, nil, err
+	}
+	switch {
+	case magnet.HashType == nil && magnet.Hash != nil:
+		return infoHash, nil, errors.New("No hash type in exact topic parameter found")
+	case magnet.HashType != nil && magnet.Hash == nil:
+		return infoHash, nil, errors.New("No hash in exact topic parameter found")
+	case magnet.HashType == nil && magnet.Hash == nil:
+		return infoHash, nil, errors.New("No hash and no hash type provided")
+	case *magnet.HashType != "btih":
+		return infoHash, nil, errors.New("No BTIH hash type in exact topic parameter found")
+	}
+	hash := strings.TrimSpace(*magnet.Hash)
+	var decoded []byte
+	switch len(hash) {
+	case 32, 52:
+		decoded, err = base32.StdEncoding.DecodeString(hash)
+	case 40, 64:
+		decoded, err = hex.DecodeString(hash)
+	default:
+		err = fmt.Errorf("Unrecognized hash format: %s", hash)
+	}
+	if err != nil {
+		return infoHash, nil, err
+	}
+	if len(decoded) != 20 {
+		return infoHash, nil, ErrNotAMagnetURL
+	}
+	copy(infoHash[:], decoded)
+	return infoHash, magnet.Trackers, nil
+}
+
+//
+// Torrent files
+//
+
+// ParseTorrent returns the info hash and the announce list of a `.torrent` file.
+func ParseTorrent(torrent []byte) (InfoHash, []string, error) {
+	var infoHash InfoHash
+	value, rest, err := bdecode(torrent)
+	if err != nil {
+		return infoHash, nil, err
+	}
+	if len(rest) != 0 {
+		return infoHash, nil, errors.New("trailing data after the torrent dictionary")
+	}
+	dict, ok := value.(map[string]any)
+	if !ok {
+		return infoHash, nil, errors.New("invalid type: expected a dictionary")
+	}
+	info, ok := dict["info"]
+	if !ok {
+		return infoHash, nil, errors.New("missing field `info`")
+	}
+	var encoded bytes.Buffer
+	bencode(&encoded, info)
+	infoHash = sha1.Sum(encoded.Bytes())
+
+	announce := []string{}
+	if entry, ok := dict["announce"]; ok {
+		text, ok := entry.(string)
+		if !ok {
+			return infoHash, nil, errors.New("invalid type for `announce`")
+		}
+		announce = append(announce, text)
+	}
+	if lists, ok := dict["announce-list"]; ok {
+		outer, ok := lists.([]any)
+		if !ok {
+			return infoHash, nil, errors.New("invalid type for `announce-list`")
+		}
+		for _, list := range outer {
+			inner, ok := list.([]any)
+			if !ok {
+				return infoHash, nil, errors.New("invalid type for `announce-list`")
+			}
+			for _, entry := range inner {
+				text, ok := entry.(string)
+				if !ok {
+					return infoHash, nil, errors.New("invalid type for `announce-list`")
+				}
+				announce = append(announce, text)
+			}
+		}
+	}
+	// consecutive duplicates are removed (`Vec::dedup`)
+	deduped := []string{}
+	for i, entry := range announce {
+		if i == 0 || announce[i-1] != entry {
+			deduped = append(deduped, entry)
+		}
+	}
+	return infoHash, deduped, nil
+}
+
+// bdecode decodes a bencoded value: strings, integers, lists and dictionaries.
+func bdecode(data []byte) (any, []byte, error) {
+	if len(data) == 0 {
+		return nil, nil, errors.New("unexpected end of bencode input")
+	}
+	switch c := data[0]; {
+	case c == 'i':
+		end := bytes.IndexByte(data, 'e')
+		if end < 0 {
+			return nil, nil, errors.New("unterminated bencode integer")
+		}
+		n, err := strconv.ParseInt(string(data[1:end]), 10, 64)
+		if err != nil {
+			return nil, nil, err
+		}
+		return n, data[end+1:], nil
+	case c == 'l':
+		list := []any{}
+		rest := data[1:]
+		for {
+			if len(rest) == 0 {
+				return nil, nil, errors.New("unterminated bencode list")
+			}
+			if rest[0] == 'e' {
+				return list, rest[1:], nil
+			}
+			item, next, err := bdecode(rest)
+			if err != nil {
+				return nil, nil, err
+			}
+			list = append(list, item)
+			rest = next
+		}
+	case c == 'd':
+		dict := map[string]any{}
+		rest := data[1:]
+		for {
+			if len(rest) == 0 {
+				return nil, nil, errors.New("unterminated bencode dictionary")
+			}
+			if rest[0] == 'e' {
+				return dict, rest[1:], nil
+			}
+			key, next, err := bdecode(rest)
+			if err != nil {
+				return nil, nil, err
+			}
+			keyText, ok := key.(string)
+			if !ok {
+				return nil, nil, errors.New("bencode dictionary key must be a string")
+			}
+			value, next, err := bdecode(next)
+			if err != nil {
+				return nil, nil, err
+			}
+			dict[keyText] = value
+			rest = next
+		}
+	case '0' <= c && c <= '9':
+		colon := bytes.IndexByte(data, ':')
+		if colon < 0 {
+			return nil, nil, errors.New("invalid bencode string")
+		}
+		length, err := strconv.Atoi(string(data[:colon]))
+		if err != nil || length < 0 || colon+1+length > len(data) {
+			return nil, nil, errors.New("invalid bencode string length")
+		}
+		return string(data[colon+1 : colon+1+length]), data[colon+1+length:], nil
+	default:
+		return nil, nil, fmt.Errorf("invalid bencode token %q", c)
+	}
+}
+
+func bencode(buf *bytes.Buffer, value any) {
+	switch v := value.(type) {
+	case int64:
+		fmt.Fprintf(buf, "i%de", v)
+	case string:
+		fmt.Fprintf(buf, "%d:%s", len(v), v)
+	case []any:
+		buf.WriteByte('l')
+		for _, item := range v {
+			bencode(buf, item)
+		}
+		buf.WriteByte('e')
+	case map[string]any:
+		buf.WriteByte('d')
+		keys := make([]string, 0, len(v))
+		for key := range v {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			bencode(buf, key)
+			bencode(buf, v[key])
+		}
+		buf.WriteByte('e')
+	}
+}
diff --git a/types/types.go b/types/types.go
new file mode 100644
index 0000000000000000000000000000000000000000..c79d41fd198e650e22a4d1d88a18fcb91ce45a8d
--- /dev/null
+++ b/types/types.go
@@ -0,0 +1,582 @@
+// Package types contains the protocol, API and persisted user state types of
+// the Stremio core engine, together with their serde-compatible JSON encoding.
+package types
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"net/url"
+	"reflect"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// UID is the user id: `nil` when not authenticated.
+type UID = *string
+
+// NewUID returns a UID for the given user id.
+func NewUID(id string) UID {
+	return &id
+}
+
+// UIDEqual compares two UIDs by value.
+func UIDEqual(a, b UID) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return *a == *b
+}
+
+// MarshalJSON encodes a value as compact JSON without HTML escaping,
+// matching the output of `serde_json::to_string`.
+func MarshalJSON(v any) ([]byte, error) {
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	if err := enc.Encode(v); err != nil {
+		return nil, err
+	}
+	out := buf.Bytes()
+	return out[:len(out)-1], nil
+}
+
+// MustMarshalJSON is MarshalJSON for values which are known to be serializable.
+func MustMarshalJSON(v any) json.RawMessage {
+	data, err := MarshalJSON(v)
+	if err != nil {
+		panic(fmt.Sprintf("json serialization failed: %v", err))
+	}
+	return data
+}
+
+// isJSONNull reports whether the raw value is absent or `null`.
+func isJSONNull(data []byte) bool {
+	trimmed := bytes.TrimSpace(data)
+	return len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null"))
+}
+
+// True is a boolean which only (de)serializes as `true`.
+type True struct{}
+
+func (True) MarshalJSON() ([]byte, error) { return []byte("true"), nil }
+
+func (t *True) UnmarshalJSON(data []byte) error {
+	var value bool
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	if !value {
+		return errors.New("invalid value: boolean `false`, expected true")
+	}
+	return nil
+}
+
+//
+// Time
+//
+
+// FormatTime formats a time the way chrono serializes a `DateTime`:
+// RFC 3339 with 0, 3, 6 or 9 fractional digits and `Z` for a zero offset.
+func FormatTime(t time.Time) string {
+	_, offset := t.Zone()
+	var b strings.Builder
+	b.WriteString(t.Format("2006-01-02T15:04:05"))
+	if ns := t.Nanosecond(); ns != 0 {
+		switch {
+		case ns%1_000_000 == 0:
+			fmt.Fprintf(&b, ".%03d", ns/1_000_000)
+		case ns%1_000 == 0:
+			fmt.Fprintf(&b, ".%06d", ns/1_000)
+		default:
+			fmt.Fprintf(&b, ".%09d", ns)
+		}
+	}
+	if offset == 0 {
+		b.WriteByte('Z')
+	} else {
+		sign := byte('+')
+		if offset < 0 {
+			sign = '-'
+			offset = -offset
+		}
+		b.WriteByte(sign)
+		fmt.Fprintf(&b, "%02d:%02d", offset/3600, (offset/60)%60)
+		if seconds := offset % 60; seconds != 0 {
+			fmt.Fprintf(&b, ":%02d", seconds)
+		}
+	}
+	return b.String()
+}
+
+// ParseTime parses an RFC 3339 date time.
+func ParseTime(value string) (time.Time, error) {
+	t, err := time.Parse(time.RFC3339Nano, value)
+	if err != nil {
+		// chrono also accepts a space as a date/time separator
+		t, err = time.Parse("2006-01-02 15:04:05.999999999Z07:00", value)
+	}
+	return t, err
+}
+
+// Time is a UTC `DateTime` with chrono-compatible (de)serialization.
+type Time time.Time
+
+func (t Time) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(FormatTime(time.Time(t).UTC()))
+}
+
+func (t *Time) UnmarshalJSON(data []byte) error {
+	var value string
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	parsed, err := ParseTime(value)
+	if err != nil {
+		return err
+	}
+	*t = Time(parsed.UTC())
+	return nil
+}
+
+// LocalTime is a `DateTime<Local>`: it keeps its offset when serialized.
+type LocalTime time.Time
+
+func (t LocalTime) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(FormatTime(time.Time(t)))
+}
+
+func (t *LocalTime) UnmarshalJSON(data []byte) error {
+	var value string
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	parsed, err := ParseTime(value)
+	if err != nil {
+		return err
+	}
+	*t = LocalTime(parsed)
+	return nil
+}
+
+// NullableTime is an `Option<DateTime<Utc>>` which deserializes `null` and
+// empty strings as `None` (`DefaultOnNull<NoneAsEmptyString>`).
+type NullableTime struct {
+	Time *time.Time
+}
+
+func (t NullableTime) MarshalJSON() ([]byte, error) {
+	if t.Time == nil {
+		return []byte("null"), nil
+	}
+	return Time(*t.Time).MarshalJSON()
+}
+
+func (t *NullableTime) UnmarshalJSON(data []byte) error {
+	t.Time = nil
+	if isJSONNull(data) {
+		return nil
+	}
+	var value string
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	if value == "" {
+		return nil
+	}
+	parsed, err := ParseTime(value)
+	if err != nil {
+		return err
+	}
+	parsed = parsed.UTC()
+	t.Time = &parsed
+	return nil
+}
+
+func timePtr(t *time.Time) *Time {
+	if t == nil {
+		return nil
+	}
+	value := Time(*t)
+	return &value
+}
+
+func fromTimePtr(t *Time) *time.Time {
+	if t == nil {
+		return nil
+	}
+	value := time.Time(*t).UTC()
+	return &value
+}
+
+// TimestampMillis returns the milliseconds since the unix epoch.
+func TimestampMillis(t time.Time) int64 {
+	return t.UnixMilli()
+}
+
+//
+// Numbers
+//
+
+// FormatFloat formats a float the way serde_json does (`1.0`, `0.5`, `1e20`).
+func FormatFloat(value float64, bitSize int) string {
+	if math.IsNaN(value) || math.IsInf(value, 0) {
+		return "null"
+	}
+	abs := math.Abs(value)
+	if abs != 0 && (abs < 1e-5 || abs >= 1e16) {
+		formatted := strconv.FormatFloat(value, 'e', -1, bitSize)
+		mantissa, exponent, _ := strings.Cut(formatted, "e")
+		exponent = strings.TrimPrefix(exponent, "+")
+		if strings.HasPrefix(exponent, "-") {
+			exponent = "-" + strings.TrimLeft(exponent[1:], "0")
+		} else {
+			exponent = strings.TrimLeft(exponent, "0")
+		}
+		return mantissa + "e" + exponent
+	}
+	formatted := strconv.FormatFloat(value, 'f', -1, bitSize)
+	if !strings.ContainsAny(formatted, ".e") {
+		formatted += ".0"
+	}
+	return formatted
+}
+
+// Float64 is a f64 which serializes like serde_json (`1.0` instead of `1`).
+type Float64 float64
+
+func (f Float64) MarshalJSON() ([]byte, error) {
+	return []byte(FormatFloat(float64(f), 64)), nil
+}
+
+func (f *Float64) UnmarshalJSON(data []byte) error {
+	var value float64
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	*f = Float64(value)
+	return nil
+}
+
+// Float32 is a f32 which serializes like serde_json (`1.0` instead of `1`).
+type Float32 float32
+
+func (f Float32) MarshalJSON() ([]byte, error) {
+	return []byte(FormatFloat(float64(f), 32)), nil
+}
+
+func (f *Float32) UnmarshalJSON(data []byte) error {
+	var value float32
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	*f = Float32(value)
+	return nil
+}
+
+//
+// URLs
+//
+
+var defaultPorts = map[string]string{
+	"http":  "80",
+	"https": "443",
+	"ws":    "80",
+	"wss":   "443",
+	"ftp":   "21",
+	"file":  "",
+}
+
+// NormalizeURL returns the serialized form of a URL the way the WHATWG URL
+// parser (rust `url::Url`) serializes it: lowercase scheme and host, no
+// default port and a `/` path for special schemes (e.g. `http://domain.root`
+// becomes `http://domain.root/`), with the path, query and fragment
+// percent-encoded with the WHATWG encode sets.
+func NormalizeURL(raw string) string {
+	raw = strings.TrimSpace(raw)
+	idx := strings.Index(raw, ":")
+	if idx <= 0 {
+		return raw
+	}
+	scheme := strings.ToLower(raw[:idx])
+	rest := raw[idx+1:]
+	fragment, hasFragment := "", false
+	if hash := strings.IndexByte(rest, '#'); hash >= 0 {
+		rest, fragment, hasFragment = rest[:hash], rest[hash+1:], true
+	}
+	query, hasQuery := "", false
+	if question := strings.IndexByte(rest, '?'); question >= 0 {
+		rest, query, hasQuery = rest[:question], rest[question+1:], true
+	}
+	defaultPort, special := defaultPorts[scheme]
+	var b strings.Builder
+	b.WriteString(scheme)
+	b.WriteByte(':')
+	switch {
+	case special && strings.HasPrefix(rest, "//"):
+		rest = rest[2:]
+		authority, path := rest, ""
+		if slash := strings.IndexByte(rest, '/'); slash >= 0 {
+			authority, path = rest[:slash], rest[slash:]
+		}
+		userinfo, hostport := "", authority
+		if at := strings.LastIndex(authority, "@"); at >= 0 {
+			userinfo, hostport = authority[:at+1], authority[at+1:]
+		}
+		hostport = strings.ToLower(hostport)
+		if defaultPort != "" && strings.HasSuffix(hostport, ":"+defaultPort) {
+			hostport = strings.TrimSuffix(hostport, ":"+defaultPort)
+		}
+		hostport = strings.TrimSuffix(hostport, ":")
+		if path == "" {
+			path = "/"
+		}
+		b.WriteString("//")
+		b.WriteString(userinfo)
+		b.WriteString(hostport)
+		b.WriteString(percentEncode(path, pathEncodeSet))
+	case strings.HasPrefix(rest, "/"):
+		b.WriteString(percentEncode(rest, pathEncodeSet))
+	default:
+		// opaque path, e.g. `magnet:?...` or `data:text/plain,...`
+		b.WriteString(percentEncode(rest, ""))
+	}
+	if hasQuery {
+		b.WriteByte('?')
+		if special {
+			b.WriteString(percentEncode(query, specialQueryEncodeSet))
+		} else {
+			b.WriteString(percentEncode(query, queryEncodeSet))
+		}
+	}
+	if hasFragment {
+		b.WriteByte('#')
+		b.WriteString(percentEncode(fragment, fragmentEncodeSet))
+	}
+	return b.String()
+}
+
+// WHATWG percent-encode sets, on top of the C0 control set.
+const (
+	fragmentEncodeSet     = " \"<>`"
+	queryEncodeSet        = " \"#<>"
+	specialQueryEncodeSet = " \"#<>'"
+	pathEncodeSet         = " \"#<>?`{}"
+)
+
+// percentEncode percent-encodes the C0 controls, non-ASCII bytes and the
+// bytes of the set.
+func percentEncode(value, set string) string {
+	needed := false
+	for i := 0; i < len(value); i++ {
+		if c := value[i]; c < 0x20 || c > 0x7e || strings.IndexByte(set, c) >= 0 {
+			needed = true
+			break
+		}
+	}
+	if !needed {
+		return value
+	}
+	var b strings.Builder
+	for i := 0; i < len(value); i++ {
+		c := value[i]
+		if c < 0x20 || c > 0x7e || strings.IndexByte(set, c) >= 0 {
+			b.WriteByte('%')
+			b.WriteByte(upperHex[c>>4])
+			b.WriteByte(upperHex[c&15])
+		} else {
+			b.WriteByte(c)
+		}
+	}
+	return b.String()
+}
+
+// IsValidURL reports whether the value parses as an absolute URL.
+func IsValidURL(raw string) bool {
+	u, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil || u.Scheme == "" {
+		return false
+	}
+	if _, special := defaultPorts[strings.ToLower(u.Scheme)]; special && u.Scheme != "file" && u.Host == "" {
+		return false
+	}
+	return true
+}
+
+// URLScheme returns the lowercase scheme of the URL.
+func URLScheme(raw string) string {
+	idx := strings.Index(raw, ":")
+	if idx <= 0 {
+		return ""
+	}
+	return strings.ToLower(raw[:idx])
+}
+
+// URLJoin resolves a reference against a base URL (`Url::join`).
+func URLJoin(base, reference string) (string, error) {
+	baseURL, err := url.Parse(NormalizeURL(base))
+	if err != nil {
+		return "", err
+	}
+	if baseURL.Opaque != "" || (baseURL.Host == "" && baseURL.Path == "") {
+		return "", fmt.Errorf("relative URL with a cannot-be-a-base base")
+	}
+	referenceURL, err := url.Parse(reference)
+	if err != nil {
+		return "", err
+	}
+	return NormalizeURL(baseURL.ResolveReference(referenceURL).String()), nil
+}
+
+// MustURLJoin is URLJoin for references which are known to be valid.
+func MustURLJoin(base, reference string) string {
+	joined, err := URLJoin(base, reference)
+	if err != nil {
+		panic(fmt.Sprintf("url builder failed: %v", err))
+	}
+	return joined
+}
+
+// URLPath returns the path component of the URL.
+func URLPath(raw string) string {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return ""
+	}
+	return u.EscapedPath()
+}
+
+// CanBeABase reports whether the URL can be used as a base for path segments,
+// i.e. it is a hierarchical URL (`http://...`) and not `data:` or `mailto:`.
+func CanBeABase(raw string) bool {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return false
+	}
+	return u.Opaque == "" && strings.HasPrefix(raw[len(u.Scheme)+1:], "/")
+}
+
+// normalizeOptionalURL normalizes the URL if it is valid, otherwise returns nil
+// (`DefaultOnError<NoneAsEmptyString>` for `Option<Url>`).
+func normalizeOptionalURL(value *string) *string {
+	if value == nil || *value == "" || !IsValidURL(*value) {
+		return nil
+	}
+	normalized := NormalizeURL(*value)
+	return &normalized
+}
+
+//
+// Equality
+//
+
+var timeType = reflect.TypeOf(time.Time{})
+
+// Equal reports whether two values are deeply equal the way rust `PartialEq`
+// would compare them: nil and empty slices/maps are equal and times are
+// compared by instant.
+func Equal(a, b any) bool {
+	return equalValues(reflect.ValueOf(a), reflect.ValueOf(b))
+}
+
+func equalValues(a, b reflect.Value) bool {
+	if !a.IsValid() || !b.IsValid() {
+		return a.IsValid() == b.IsValid() || isEmptyValue(a) && isEmptyValue(b)
+	}
+	if a.Type() != b.Type() {
+		return false
+	}
+	if a.Type() == timeType {
+		if a.CanInterface() && b.CanInterface() {
+			return a.Interface().(time.Time).Equal(b.Interface().(time.Time))
+		}
+	}
+	switch a.Kind() {
+	case reflect.Pointer:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() && b.IsNil()
+		}
+		if a.Pointer() == b.Pointer() {
+			return true
+		}
+		return equalValues(a.Elem(), b.Elem())
+	case reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() && b.IsNil()
+		}
+		return equalValues(a.Elem(), b.Elem())
+	case reflect.Slice, reflect.Array:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !equalValues(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return false
+		}
+		iter := a.MapRange()
+		for iter.Next() {
+			other := b.MapIndex(iter.Key())
+			if !other.IsValid() || !equalValues(iter.Value(), other) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			if !equalValues(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Func:
+		return a.IsNil() && b.IsNil()
+	case reflect.Bool:
+		return a.Bool() == b.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return a.Int() == b.Int()
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		return a.Uint() == b.Uint()
+	case reflect.Float32, reflect.Float64:
+		return a.Float() == b.Float()
+	case reflect.String:
+		return a.String() == b.String()
+	default:
+		if a.CanInterface() && b.CanInterface() {
+			return reflect.DeepEqual(a.Interface(), b.Interface())
+		}
+		return false
+	}
+}
+
+func isEmptyValue(v reflect.Value) bool {
+	if !v.IsValid() {
+		return true
+	}
+	switch v.Kind() {
+	case reflect.Pointer, reflect.Interface, reflect.Slice, reflect.Map:
+		return v.IsNil()
+	}
+	return false
+}
+
+// Clone returns a deep copy of a value by round-tripping it through JSON.
+func Clone[T any](value T) T {
+	data, err := MarshalJSON(value)
+	if err != nil {
+		panic(fmt.Sprintf("clone serialization failed: %v", err))
+	}
+	var cloned T
+	if err := json.Unmarshal(data, &cloned); err != nil {
+		panic(fmt.Sprintf("clone deserialization failed: %v", err))
+	}
+	return cloned
+}
