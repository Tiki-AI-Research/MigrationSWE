+func drainPlayerEvents(rx <-chan runtime.RuntimeEvent) []runtime.RuntimeEvent {
+	events := []runtime.RuntimeEvent{}
+	for {
+		select {
+		case event := <-rx:
+			events = append(events, event)
+		case <-time.After(50 * time.Millisecond):
+			return events
+		}
+	}
+}
+
+func playerCoreEvents(events []runtime.RuntimeEvent, names ...string) []*msg.Event {
+	result := []*msg.Event{}
+	for _, event := range events {
+		if coreEvent := event.Event(); coreEvent != nil {
+			for _, name := range names {
+				if coreEvent.Event == name {
+					result = append(result, coreEvent)
+				}
+			}
+		}
+	}
+	return result
+}
