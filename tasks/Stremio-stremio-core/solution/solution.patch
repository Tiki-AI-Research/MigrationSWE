+
+//
+// stream_deep_links.rs
+//
+
+const (
+	sdMagnetStrURL        = "magnet:?xt=urn:btih:dd8255ecdc7ca55fb0bbf81323d87062db1f6d1c"
+	sdHTTPStrURL          = "http://domain.root/some/path"
+	sdHTTPWithQueryStrURL = "http://domain.root/some/path?param=some&foo=bar"
+	sdBase64HTTPURL       = "data:application/octet-stream;charset=utf-8;base64,I0VYVE0zVQojRVhUSU5GOjAKaHR0cDovL2RvbWFpbi5yb290L3NvbWUvcGF0aA=="
+	sdYtID                = "aqz-KE-bpKQ"
+)
+
+func TestStreamDeepLinksMagnet(t *testing.T) {
+	sdl := NewStreamDeepLinks(urlStream(sdMagnetStrURL), ptr(streamingServerStrURL), types.NewSettings())
+	assertEqual(t, sdl.Player, "stremio:///player/eAEBRgC5%2F3sidXJsIjoibWFnbmV0Oj94dD11cm46YnRpaDpkZDgyNTVlY2RjN2NhNTVmYjBiYmY4MTMyM2Q4NzA2MmRiMWY2ZDFjIn0%2BMhZF")
+	assertStrPtr(t, sdl.ExternalPlayer.Download, nil)
+	assertStrPtr(t, sdl.ExternalPlayer.Magnet, ptr(sdMagnetStrURL))
+	assertStrPtr(t, sdl.ExternalPlayer.FileName, nil)
+}
+
+func TestStreamDeepLinksTorrentMagnet(t *testing.T) {
+	stream := torrentStream(ptr(uint16(0)), []string{"http://bt1.archive.org:6969/announce"})
+	stream.Name = ptr("Test Torrent")
+	settings := types.NewSettings()
+
+	sdlWithServer := NewStreamDeepLinks(stream, ptr(streamingServerStrURL), settings)
+	if sdlWithServer.ExternalPlayer.Magnet == nil {
+		t.Fatal("magnet missing with server")
+	}
+	magnet := *sdlWithServer.ExternalPlayer.Magnet
+	if !strings.HasPrefix(magnet, "magnet:") {
+		t.Error("magnet missing with server")
+	}
+	if !strings.Contains(magnet, "xt=urn:btih:") {
+		t.Error("magnet missing xt param")
+	}
+	if !strings.Contains(magnet, "tr=") {
+		t.Error("magnet missing tracker")
+	}
+	if sdlWithServer.ExternalPlayer.Download == nil {
+		t.Error("download URL should be present when server is running")
+	}
+
+	sdlNoServer := NewStreamDeepLinks(stream, nil, settings)
+	if sdlNoServer.ExternalPlayer.Magnet == nil {
+		t.Fatal("magnet missing without server")
+	}
+	magnet = *sdlNoServer.ExternalPlayer.Magnet
+	if !strings.HasPrefix(magnet, "magnet:") {
+		t.Error("magnet missing without server")
+	}
+	if !strings.Contains(magnet, "xt=urn:btih:") {
+		t.Error("magnet missing xt param")
+	}
+	assertStrPtr(t, sdlNoServer.ExternalPlayer.Download, nil, "download URL must be None when server is not running")
+}
+
+func TestStreamDeepLinksHTTP(t *testing.T) {
+	sdl := NewStreamDeepLinks(urlStream(sdHTTPStrURL), ptr(streamingServerStrURL), types.NewSettings())
+	assertEqual(t, sdl.Player, "stremio:///player/eAEBJgDZ%2F3sidXJsIjoiaHR0cDovL2RvbWFpbi5yb290L3NvbWUvcGF0aCJ9AYANjw%3D%3D")
+	assertStrPtr(t, sdl.ExternalPlayer.Playlist, ptr(sdBase64HTTPURL))
+	assertStrPtr(t, sdl.ExternalPlayer.Streaming, ptr(sdHTTPStrURL))
+	assertStrPtr(t, sdl.ExternalPlayer.FileName, ptr("playlist.m3u"))
+}
+
+func TestStreamDeepLinksInfuseCallbackReturnsToSelectedItem(t *testing.T) {
+	streamRequest := types.NewResourceRequest("http://stream.addon", types.NewResourcePath("stream", "series", "tt123:1:2"))
+	metaRequest := types.NewResourceRequest("http://meta.addon", types.NewResourcePath("meta", "series", "tt123"))
+	sdl := NewStreamDeepLinksWithRequests(urlStream(sdHTTPStrURL), streamRequest, metaRequest,
+		ptr(streamingServerStrURL), playerSettings("infuse"))
+	if sdl.ExternalPlayer.OpenPlayer == nil || sdl.ExternalPlayer.OpenPlayer.IOS == nil {
+		t.Fatalf("missing infuse link: %+v", sdl.ExternalPlayer.OpenPlayer)
+	}
+	ios := *sdl.ExternalPlayer.OpenPlayer.IOS
+	assertEqual(t, queryParam(t, ios, "x-success"), "stremio:///detail/series/tt123/tt123%3A1%3A2")
+	assertEqual(t, queryParam(t, ios, "x-error"), "stremio:///detail/series/tt123/tt123%3A1%3A2")
+	assertStrPtr(t, sdl.ExternalPlayer.OpenPlayer.MacOS, &ios)
+	assertStrPtr(t, sdl.ExternalPlayer.OpenPlayer.VisionOS, &ios)
+	assertStrPtr(t, sdl.ExternalPlayer.OpenPlayer.TvOS, &ios)
+	assertEqual(t, ios, "infuse://x-callback-url/play?x-success=stremio%3A%2F%2F%2Fdetail%2Fseries%2Ftt123%2Ftt123%253A1%253A2&x-error=stremio%3A%2F%2F%2Fdetail%2Fseries%2Ftt123%2Ftt123%253A1%253A2&url=http%3A%2F%2Fdomain.root%2Fsome%2Fpath")
+}
+
+func proxyStream(url string, request, response map[string]string) types.Stream {
+	stream := urlStream(url)
+	stream.BehaviorHints.ProxyHeaders = &types.StreamProxyHeaders{Request: request, Response: response}
+	return stream
+}
+
+func TestStreamDeepLinksHTTPWithRequestHeaders(t *testing.T) {
+	stream := proxyStream(sdHTTPStrURL, map[string]string{"Authorization": "my+token"}, nil)
+	sdl := NewStreamDeepLinks(stream, ptr(streamingServerStrURL), types.NewSettings())
+	assertEqual(t, sdl.Player, "stremio:///player/eAEBcACP%2F3sidXJsIjoiaHR0cDovL2RvbWFpbi5yb290L3NvbWUvcGF0aCIsImJlaGF2aW9ySGludHMiOnsicHJveHlIZWFkZXJzIjp7InJlcXVlc3QiOnsiQXV0aG9yaXphdGlvbiI6Im15K3Rva2VuIn19fX3Y5Cjf")
+	assertStrPtr(t, sdl.ExternalPlayer.Streaming, ptr(fmt.Sprintf("%s/proxy/%s", streamingServerStrURL,
+		"d=http%3A%2F%2Fdomain.root&h=Authorization%3Amy%2Btoken/some/path")))
+}
+
+func TestStreamDeepLinksHTTPWithRequestResponseHeadersAndQueryParams(t *testing.T) {
