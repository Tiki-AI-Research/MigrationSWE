+// recorder is a send function which records the sent batches and returns
+// the next queued result (nil when none is queued).
+type recorder struct {
+	mu      sync.Mutex
+	sent    []Batch
+	results []error
+	// during is called while sending, before returning the result.
+	during func(Batch)
+}
+
+func (r *recorder) send(batch Batch) error {
+	r.mu.Lock()
+	r.sent = append(r.sent, batch)
+	var result error
+	if len(r.results) > 0 {
+		result = r.results[0]
+		r.results = r.results[1:]
+	}
+	during := r.during
+	r.mu.Unlock()
+	if during != nil {
+		during(batch)
+	}
+	return result
+}
+
+func (r *recorder) sentBatches() []Batch {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]Batch(nil), r.sent...)
+}
+
+func newTestAnalytics(t *testing.T) (*Analytics, *testenv.Env, *recorder) {
+	t.Helper()
+	env := testenv.New()
+	env.SetNow(time.Date(2024, 1, 2, 3, 4, 5, 6_000_000, time.UTC))
+	rec := &recorder{}
+	return New(env, rec.send), env, rec
+}
