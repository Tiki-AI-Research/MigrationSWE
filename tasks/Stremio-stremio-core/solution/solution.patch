+func ssDrainEvents(rx <-chan runtime.RuntimeEvent) []*msg.Event {
+	events := []*msg.Event{}
+	for {
+		select {
+		case event := <-rx:
+			if e := event.Event(); e != nil {
+				events = append(events, e)
+			}
+		default:
+			return events
+		}
+	}
+}
