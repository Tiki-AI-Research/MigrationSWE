+// NewCalendarItemDeepLinks creates the deep links of a video of a meta item
+// shown in the calendar.
+func NewCalendarItemDeepLinks(metaItem types.MetaItem, video types.Video) CalendarItemDeepLinks {
+	return CalendarItemDeepLinks{
+		MetaDetailsStreams: detailVideoLink(metaItem.Preview.Type, metaItem.Preview.ID, video.ID),
+	}
+}
