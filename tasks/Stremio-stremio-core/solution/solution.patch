+func TestPlayerRatioFloor(t *testing.T) {
+	cases := []struct{ numer, denom, value, expected uint64 }{
+		{3_000_000, 2_900_000, 10_000, 10344},
+		{3_000_000, 2_900_000, 70_000, 72413},
+		{1, 1, 0, 0},
+		{2, 3, 5, 3},
+		// the intermediate product does not fit in 64 bits
+		{1 << 40, (1 << 40) - 1, 1 << 30, 1 << 30},
+		{6_000_000_000, 7, 5_000_000_000, 4285714285714285714},
+		{^uint64(0), 1, 2, ^uint64(0)},
+	}
+	for _, c := range cases {
+		if got := ratioFloor(c.numer, c.denom, c.value); got != c.expected {
+			t.Fatalf("ratioFloor(%d, %d, %d) = %d, expected %d", c.numer, c.denom, c.value, got, c.expected)
+		}
+	}
+}
