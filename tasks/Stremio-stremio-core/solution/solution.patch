@@ -0,0 +1,352 @@
+package runtime
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/types"
+)
+
+// EnvError codes.
+const (
+	EnvErrorCodeFetch                         = 1
+	EnvErrorCodeAddonTransport                = 2
+	EnvErrorCodeSerde                         = 3
+	EnvErrorCodeStorageUnavailable            = 4
+	EnvErrorCodeStorageSchemaVersionDowngrade = 5
+	EnvErrorCodeStorageSchemaVersionUpgrade   = 6
+	EnvErrorCodeStorageReadError              = 7
+	EnvErrorCodeStorageWriteError             = 8
+	EnvErrorCodeOther                         = 1001
+)
+
+// EnvError is an error of the environment, serialized as
+// `{"code": <code>, "message": <message>}`.
+type EnvError struct {
+	Code    int    `json:"code"`
+	Message string `json:"message"`
+}
+
+func (e *EnvError) Error() string {
+	return e.Message
+}
+
+// Equal compares two errors by value.
+func (e *EnvError) Equal(other *EnvError) bool {
+	if e == nil || other == nil {
+		return e == nil && other == nil
+	}
+	return e.Code == other.Code && e.Message == other.Message
+}
+
+// EnvErrorFetch is returned by Env.Fetch.
+func EnvErrorFetch(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeFetch, Message: "Failed to fetch: " + message}
+}
+
+// EnvErrorAddonTransport is returned on addon protocol violations.
+func EnvErrorAddonTransport(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeAddonTransport, Message: "Addon protocol violation: " + message}
+}
+
+// EnvErrorSerde is returned on (de)serialization errors.
+func EnvErrorSerde(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeSerde, Message: "Serialization error: " + message}
+}
+
+// EnvErrorStorageUnavailable is returned when the storage is not available.
+func EnvErrorStorageUnavailable() *EnvError {
+	return &EnvError{Code: EnvErrorCodeStorageUnavailable, Message: "Storage is not available"}
+}
+
+// EnvErrorStorageSchemaVersionDowngrade is returned when the persisted schema
+// version is newer than the latest one.
+func EnvErrorStorageSchemaVersionDowngrade(from, to uint32) *EnvError {
+	return &EnvError{
+		Code:    EnvErrorCodeStorageSchemaVersionDowngrade,
+		Message: fmt.Sprintf("Downgrade storage schema version from %d to %d is not allowed", from, to),
+	}
+}
+
+// EnvErrorStorageSchemaVersionUpgrade is returned when a migration failed.
+func EnvErrorStorageSchemaVersionUpgrade(source *EnvError) *EnvError {
+	message := ""
+	if source != nil {
+		message = source.Message
+	}
+	return &EnvError{
+		Code:    EnvErrorCodeStorageSchemaVersionUpgrade,
+		Message: "Upgrade storage schema version failed caused by: " + message,
+	}
+}
+
+// EnvErrorStorageReadError is returned when reading the storage failed.
+func EnvErrorStorageReadError(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeStorageReadError, Message: "Storage read error: " + message}
+}
+
+// EnvErrorStorageWriteError is returned when writing the storage failed.
+func EnvErrorStorageWriteError(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeStorageWriteError, Message: "Storage write error: " + message}
+}
+
+// EnvErrorOther is any other error.
+func EnvErrorOther(message string) *EnvError {
+	return &EnvError{Code: EnvErrorCodeOther, Message: "Other error: " + message}
+}
+
+// AddonTransport fetches the resources and the manifest of an addon.
+type AddonTransport interface {
+	Resource(path types.ResourcePath) (types.ResourceResponse, *EnvError)
+	Manifest() (types.Manifest, *EnvError)
+}
+
+// Env is the environment the engine runs in: network, storage, scheduling,
+// time and analytics.
+type Env interface {
+	// Fetch performs an HTTP request and returns the response body.
+	Fetch(method, url string, headers map[string]string, body []byte) ([]byte, *EnvError)
+	// GetStorage returns the raw JSON stored under the key and whether it exists.
+	GetStorage(key string) (json.RawMessage, bool, *EnvError)
+	// SetStorage stores the JSON serialization of the value; a nil value
+	// removes the key.
+	SetStorage(key string, value any) *EnvError
+	// ExecConcurrent schedules a task which may run concurrently with others.
+	ExecConcurrent(f func())
+	// ExecSequential schedules a task which runs after the previously
+	// scheduled sequential tasks.
+	ExecSequential(f func())
+	Now() time.Time
+	LocalNow() time.Time
+	FlushAnalytics()
+	AnalyticsContext(ctx any, streamingServer any, path string) any
+	Log(message string)
+	// AddonTransport returns the transport for the addon transport url.
+	AddonTransport(transportURL string) AddonTransport
+	// MigrateStorageSchema migrates the persisted state to the latest schema.
+	MigrateStorageSchema() *EnvError
+}
+
+// FetchJSON performs a request with a JSON body (when body is not nil) and
+// decodes the JSON response into out.
+func FetchJSON(env Env, method, url string, body any, out any) *EnvError {
+	var payload []byte
+	headers := map[string]string{}
+	if body != nil {
+		data, err := types.MarshalJSON(body)
+		if err != nil {
+			return EnvErrorSerde(err.Error())
+		}
+		payload = data
+		headers["content-type"] = "application/json"
+	}
+	response, envErr := env.Fetch(method, url, headers, payload)
+	if envErr != nil {
+		return envErr
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(response, out); err != nil {
+		return EnvErrorSerde(err.Error())
+	}
+	return nil
+}
+
+// storage keys removed by the respective schema versions
+var removedStorageKeys = map[uint32][]string{
