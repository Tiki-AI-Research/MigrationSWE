@@ -0,0 +1,180 @@
+package types
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestResourceResponseValidation(t *testing.T) {
+	if _, err := ParseResourceResponse([]byte(`256`)); err == nil || !strings.Contains(err.Error(), "expected an Object response") {
+		t.Fatalf("unexpected error %v", err)
+	}
+	if _, err := ParseResourceResponse([]byte(`{"unknownVariant":{"test":1}}`)); err == nil || !strings.Contains(err.Error(), "didn't contain any of the required keys") {
+		t.Fatalf("unexpected error %v", err)
+	}
+	if _, err := ParseResourceResponse([]byte(`{"metas":{},"metasDetailed":{}}`)); err == nil || !strings.Contains(err.Error(), "contained more than 1 of the unique keys") {
+		t.Fatalf("unexpected error %v", err)
+	}
+	response, err := ParseResourceResponse([]byte(`{"metas":null}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	metas, err := response.Metas()
+	if err != nil || len(metas) != 0 {
+		t.Fatalf("null metas should be empty: %v %v", metas, err)
+	}
+	response, _ = ParseResourceResponse([]byte(`{"metas":{"object_key":"value"}}`))
+	if _, err := response.Metas(); err == nil || !strings.Contains(err.Error(), "invalid type: map, expected a sequence") {
+		t.Fatalf("unexpected error %v", err)
+	}
+	// invalid items are skipped
+	response, _ = ParseResourceResponse([]byte(`{"streams":[{"url":"https://a.com/v.mp4"},{"invalid":true}],"cacheMaxAge":3600}`))
+	streams, err := response.Streams()
+	if err != nil || len(streams) != 1 {
+		t.Fatalf("unexpected streams %v %v", streams, err)
+	}
+	if _, err := response.Meta(); err == nil {
+		t.Fatal("a streams response is not a meta")
+	}
+}
+
+func TestExtendOneExtra(t *testing.T) {
+	genre := ExtraProp{Name: "genre", OptionsLimit: 1}
+	multi := ExtraProp{Name: "multi", OptionsLimit: 2}
+	required := ExtraProp{Name: "required", IsRequired: true, OptionsLimit: 1}
+	action, drama, comedy := "Action", "Drama", "Comedy"
+	extra := ExtendOneExtra(nil, &genre, &action)
+	extra = ExtendOneExtra(extra, &genre, &drama)
+	if len(extra) != 1 || extra[0].Value != "Drama" {
+		t.Fatalf("unexpected extra %v", extra)
+	}
+	extra = ExtendOneExtra(extra, &multi, &action)
+	extra = ExtendOneExtra(extra, &multi, &comedy)
+	extra = ExtendOneExtra(extra, &multi, &drama)
+	values := []string{}
+	for _, value := range extra {
+		values = append(values, value.Name+"="+value.Value)
+	}
+	if strings.Join(values, ",") != "multi=Drama,multi=Comedy,genre=Drama" {
+		t.Fatalf("unexpected extra %v", values)
+	}
+	extra = ExtendOneExtra(extra, &multi, &comedy)
+	if len(extra) != 2 {
+		t.Fatalf("existing multi value should be toggled off: %v", extra)
+	}
+	extra = ExtendOneExtra(extra, &genre, nil)
+	if len(extra) != 1 {
+		t.Fatalf("non required extra should be removed: %v", extra)
+	}
+	withRequired := ExtendOneExtra([]ExtraValue{{Name: "required", Value: "x"}}, &required, nil)
+	if len(withRequired) != 1 {
+		t.Fatalf("required extra should be kept: %v", withRequired)
+	}
+}
+
+func TestPlanCatalogsFiltered(t *testing.T) {
+	var addon Descriptor
+	err := json.Unmarshal([]byte(`{
+		"transportUrl": "https://addon.com/manifest.json",
+		"manifest": {
+			"id": "addon", "version": "1.0.0", "name": "Addon", "types": ["series", "movie"],
+			"resources": [{"name": "catalog", "types": ["series"], "idPrefixes": ["tt"]}, "meta"],
+			"catalogs": [
+				{"id": "last-videos", "type": "series", "extra": [{"name": "lastVideosIds", "isRequired": true, "optionsLimit": 2}]},
+				{"id": "top", "type": "series"}
+			]
+		}
+	}`), &addon)
+	if err != nil {
+		t.Fatal(err)
+	}
+	limit := 100
+	request := AggrRequest{Kind: AggrRequestCatalogsFiltered, ExtraTypes: []ExtraTypeIDs{{
+		ExtraName: "lastVideosIds",
+		IDTypes:   [][2]string{{"tt3", "series"}, {"tt1", "series"}, {"kitsu:1", "series"}, {"tt2", "movie"}, {"tt0", "series"}},
+		Limit:     &limit,
+	}}}
+	planned := request.Plan([]Descriptor{addon})
+	if len(planned) != 1 {
+		t.Fatalf("unexpected plan %+v", planned)
+	}
+	path := planned[0].Request.Path
+	if path.ID != "last-videos" || len(path.Extra) != 1 || path.Extra[0].Value != "tt1,tt3" {
+		t.Fatalf("unexpected path %+v", path)
+	}
+	all := AggrRequest{Kind: AggrRequestAllOfResource, Path: NewResourcePath("meta", "series", "tt1")}
+	if len(all.Plan([]Descriptor{addon})) != 1 {
+		t.Fatal("meta should be supported")
+	}
+	unsupported := AggrRequest{Kind: AggrRequestAllOfResource, Path: NewResourcePath("meta", "series", "kitsu:1")}
+	if len(unsupported.Plan([]Descriptor{addon})) != 1 {
+		t.Fatal("short resources use the manifest id prefixes (none)")
+	}
+}
+
+func TestQueryParamsEncode(t *testing.T) {
+	encoded := QueryParamsEncode([]QueryPair{{Key: "search", Value: "better call saul"}, {Key: "a&b", Value: "c=d/é*'()!~"}})
+	if encoded != "search=better%20call%20saul&a%26b=c%3Dd%2F%C3%A9*'()!~" {
+		t.Fatalf("unexpected encoding %s", encoded)
+	}
+	if QueryParamsEncode(nil) != "" {
+		t.Fatal("empty pairs should encode to an empty string")
+	}
+}
+
+func TestNormalizeURL(t *testing.T) {
+	cases := map[string]string{
+		"http://domain.root":                  "http://domain.root/",
+		"HTTP://Domain.Root:80/Path?q=1#f":    "http://domain.root/Path?q=1#f",
+		"https://a.com:443?x":                 "https://a.com/?x",
+		"http://127.0.0.1:11470":              "http://127.0.0.1:11470/",
+		"magnet:?xt=urn:btih:abc":             "magnet:?xt=urn:btih:abc",
+		"stremio:///detail/movie/tt1":         "stremio:///detail/movie/tt1",
+		"https://transport_url/manifest.json": "https://transport_url/manifest.json",
+	}
+	for input, expected := range cases {
+		if got := NormalizeURL(input); got != expected {
+			t.Fatalf("%s: got %s, want %s", input, got, expected)
+		}
+	}
+	joined, err := URLJoin("http://127.0.0.1:11470", "settings")
+	if err != nil || joined != "http://127.0.0.1:11470/settings" {
+		t.Fatalf("unexpected join %s %v", joined, err)
+	}
+	joined, _ = URLJoin("http://127.0.0.1:11470/a/b", "/create")
+	if joined != "http://127.0.0.1:11470/create" {
+		t.Fatalf("unexpected join %s", joined)
+	}
+}
+
+func TestSemverCompare(t *testing.T) {
+	if CompareVersions("3.0.14", "3.0.9") <= 0 || CompareVersions("1.0.0-alpha", "1.0.0") >= 0 || CompareVersions("1.2.3", "1.2.3") != 0 {
+		t.Fatal("unexpected semver ordering")
+	}
+}
+
+func TestFormatTime(t *testing.T) {
+	var value Time
+	if err := json.Unmarshal([]byte(`"2020-09-13T14:26:40.123+02:00"`), &value); err != nil {
+		t.Fatal(err)
+	}
+	serialized, _ := MarshalJSON(value)
+	if string(serialized) != `"2020-09-13T12:26:40.123Z"` {
+		t.Fatalf("unexpected time %s", serialized)
+	}
+	if err := json.Unmarshal([]byte(`"2020-09-13T12:26:40.120000001Z"`), &value); err != nil {
+		t.Fatal(err)
+	}
+	serialized, _ = MarshalJSON(value)
+	if string(serialized) != `"2020-09-13T12:26:40.120000001Z"` {
+		t.Fatalf("unexpected time %s", serialized)
+	}
+	if err := json.Unmarshal([]byte(`"2020-09-13T12:26:40.1Z"`), &value); err != nil {
+		t.Fatal(err)
+	}
+	serialized, _ = MarshalJSON(value)
+	if string(serialized) != `"2020-09-13T12:26:40.100Z"` {
+		t.Fatalf("unexpected time %s", serialized)
+	}
+}
