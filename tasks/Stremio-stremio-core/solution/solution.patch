+	}
+	a.SendNextBatch()
+	// the failed batch is not reverted since it is no longer pending
+	if a.QueueLen() != 0 || a.IsPending() {
+		t.Fatalf("queue length %d (pending %v), want 0", a.QueueLen(), a.IsPending())
