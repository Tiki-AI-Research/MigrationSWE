+func TestPlayerSkipGapsAndSeekLogs(t *testing.T) {
+	skipGapsURL := stremiocore.API_URL + "api/getSkipGaps"
+	seekLogURL := stremiocore.API_URL + "api/seekLog"
+	rt, m, env, _ := newPlaybackRuntime(t, func(env *testenv.Env, m *Model) {
+		premiumExpire := env.Now().Add(time.Hour)
+		m.Ctx.Profile.Auth = &types.Auth{Key: "auth_key", User: types.User{ID: "user_id", PremiumExpire: &premiumExpire}}
+		m.Player.CollectSeekLogs = true
+	}, map[string]string{
+		skipGapsURL: `{"result": {"accuracy": "byOsHash", "gaps": {
+			"2900000": {"seekHistory": [{"records": 3, "seekFrom": 10000, "seekTo": 70000}], "outro": 2800000},
+			"3500000": {"outro": 3400000},
+			"100": {"seekHistory": []}
+		}}}`,
+		seekLogURL: `{"result": {"success": true}}`,
+	})
+	p := m.Player
+	if requests := playerRequestsTo(env, skipGapsURL); len(requests) != 0 || p.SkipGaps != nil {
+		t.Fatalf("the skip gaps require the video params")
+	}
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerVideoParamsChanged, map[string]any{"videoParams": map[string]any{"hash": "os_hash"}}))
+	requests := playerRequestsTo(env, skipGapsURL)
+	if len(requests) != 1 {
+		t.Fatalf("expected a skip gaps request, got %d", len(requests))
+	}
+	expectedBody := `{"type":"SkipGaps","authKey":"auth_key","osId":"os_hash","itemId":"tt123456","season":1,"episode":1,"stHash":"Oozf5IrzQ/L3JK7TTACvP1WdLB4Tdhp9mzADfrP4DUI="}`
+	if body := string(requests[0].Body); body != expectedBody {
+		t.Fatalf("unexpected skip gaps request body:\n got %s\nwant %s", body, expectedBody)
+	}
+	if p.SkipGaps == nil || !p.SkipGaps.Response.IsReady() {
+		t.Fatalf("the skip gaps should be loaded: %+v", p.SkipGaps)
+	}
+	if p.IntroOutro != nil {
+		t.Fatalf("the intro/outro requires the duration: %+v", p.IntroOutro)
+	}
+	dispatchPlayer(rt, timeChangedAction(100_000, 3_000_000))
+	expected := &types.IntroOutro{
+		Intro: &types.IntroData{From: 10344, To: 72413, Duration: playerU64Ptr(60_000)},
+		Outro: playerU64Ptr(2_900_000),
+	}
+	if !types.Equal(p.IntroOutro, expected) {
+		t.Fatalf("unexpected intro/outro: %s", types.MustMarshalJSON(p.IntroOutro))
+	}
+	if !strings.Contains(string(types.MustMarshalJSON(p)), `"introOutro":{"intro":{"from":10344,"to":72413,"duration":60000},"outro":2900000}`) {
+		t.Fatalf("the intro/outro should be serialized: %s", types.MustMarshalJSON(p))
+	}
+	if requests := playerRequestsTo(env, skipGapsURL); len(requests) != 1 {
+		t.Fatalf("the same skip gaps must not be requested again")
+	}
+
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerSeek, map[string]any{"time": 50_000, "duration": 3_000_000, "device": "web"}))
+	// seeks after PLAYER_IGNORE_SEEK_AFTER are not collected
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerSeek, map[string]any{"time": 700_000, "duration": 3_000_000, "device": "web"}))
+	if !types.Equal(p.SeekHistory, []types.SeekLog{{From: 100_000, To: 50_000}}) {
+		t.Fatalf("unexpected seek history: %+v", p.SeekHistory)
+	}
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerNextVideo, nil))
+	requests = playerRequestsTo(env, seekLogURL)
+	if len(requests) != 1 {
+		t.Fatalf("expected a seek log request, got %d", len(requests))
+	}
+	expectedBody = `{"type":"SeekLog","osId":"os_hash","itemId":"tt123456","season":1,"episode":1,"stHash":"Oozf5IrzQ/L3JK7TTACvP1WdLB4Tdhp9mzADfrP4DUI=","duration":3000000,"seekHistory":[{"from":100000,"to":50000}],"skipOutro":[700000]}`
+	if body := string(requests[0].Body); body != expectedBody {
+		t.Fatalf("unexpected seek log request body:\n got %s\nwant %s", body, expectedBody)
+	}
+	if len(p.SeekHistory) != 0 {
+		t.Fatalf("the seek history should be reset: %+v", p.SeekHistory)
+	}
+	dispatchPlayer(rt, msg.UnloadAction())
+	if requests := playerRequestsTo(env, seekLogURL); len(requests) != 1 {
+		t.Fatalf("no seek logs are sent without seeks")
+	}
+}
