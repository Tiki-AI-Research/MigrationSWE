+package runtime
+
+import "github.com/stremio/stremio-core/runtime/msg"
+
+// Model is the state of the engine. Update handles a message with the whole
+// model, UpdateField only with the given field; both return the effects and
+// the changed fields.
+type Model interface {
+	Update(m *msg.Msg) ([]Effect, []string)
+	UpdateField(m *msg.Msg, field string) ([]Effect, []string)
+}
+
+// Update is implemented by the models which do not depend on the Ctx.
+type Update interface {
+	Update(m *msg.Msg) Effects
+}
