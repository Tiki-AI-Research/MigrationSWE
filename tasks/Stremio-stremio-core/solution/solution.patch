+func TestSendNextBatchResults(t *testing.T) {
+	var nilEnvErr *runtime.EnvError
+	var nilAPIErr *types.APIError
+	tests := []struct {
+		name     string
+		err      error
+		reverted bool
+	}{
+		{"success", nil, false},
+		{"fetch error", runtime.EnvErrorFetch("offline"), true},
+		{"serde error", runtime.EnvErrorSerde("invalid"), true},
+		{"wrapped fetch error", fmt.Errorf("sending: %w", runtime.EnvErrorFetch("offline")), true},
+		{"addon transport error", runtime.EnvErrorAddonTransport("x"), false},
+		{"storage error", runtime.EnvErrorStorageUnavailable(), false},
+		{"other env error", runtime.EnvErrorOther("x"), false},
+		{"api error code 1", &types.APIError{Message: "session expired", Code: 1}, false},
+		{"api error code 2", &types.APIError{Message: "error", Code: 2}, true},
+		{"api error code 0", &types.APIError{Message: "error", Code: 0}, true},
+		{"wrapped api error code 1", fmt.Errorf("api: %w", &types.APIError{Code: 1}), false},
+		{"other error", errors.New("boom"), true},
+		{"typed nil env error", nilEnvErr, false},
+		{"typed nil api error", nilAPIErr, false},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			a, _, rec := newTestAnalytics(t)
+			rec.results = []error{test.err}
+			a.Emit("e1", nil, "k1", nil)
+			a.Emit("e2", nil, "k2", nil)
+			a.SendNextBatch()
+			if a.IsPending() {
+				t.Fatal("the batch is still pending")
+			}
+			queue := a.Queue()
+			if test.reverted {
+				assertStrings(t, authKeys(queue), []string{"k1", "k2"})
+				assertStrings(t, eventNames(queue[0]), []string{"e1"})
+			} else {
+				assertStrings(t, authKeys(queue), []string{"k2"})
+			}
+		})
+	}
