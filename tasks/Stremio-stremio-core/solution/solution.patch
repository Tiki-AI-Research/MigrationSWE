+	assertStrPtr(t, lidl.MetaDetailsVideos, ptr(metaDetailsVideos))
+	assertStrPtr(t, lidl.MetaDetailsStreams, nil)
+	// with a stream and StreamSource::Torrent we should get an external_player link
+	assertInfuseOpenPlayer(t, lidl.ExternalPlayer)
+	// with a Stream we should get a player link
+	assertPlayerLink(t, lidl.Player)
+}
+
+func TestLibraryItemDeepLinksStateVideoID(t *testing.T) {
