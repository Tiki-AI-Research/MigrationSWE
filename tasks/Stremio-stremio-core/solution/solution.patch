+func TestPlayerSubtitlesRequest(t *testing.T) {
+	rt, m, env, _ := newPlaybackRuntime(t, nil, nil)
+	env.FetchFn = func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		if strings.HasPrefix(url, "https://opensubtitles-v3.strem.io/subtitles/") {
+			return []byte(`{"subtitles": [{"id": "1", "lang": "eng", "url": "https://subs/1.srt"}]}`), nil
+		}
+		return nil, runtime.EnvErrorFetch("Unhandled fetch request: " + url)
+	}
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerVideoParamsChanged, map[string]any{
+		"videoParams": map[string]any{"hash": "ffff", "size": 1234, "filename": "video.mkv"},
+	}))
+	p := m.Player
+	if p.VideoParams == nil || p.VideoParams.Hash == nil || *p.VideoParams.Hash != "ffff" {
+		t.Fatalf("unexpected video params: %+v", p.VideoParams)
+	}
+	if len(p.Subtitles) != 1 {
+		t.Fatalf("expected a subtitles request to the opensubtitles addon: %+v", p.Subtitles)
+	}
+	expectedExtra := []types.ExtraValue{{Name: "filename", Value: "video.mkv"}, {Name: "videoSize", Value: "1234"}, {Name: "videoHash", Value: "ffff"}}
+	if !types.Equal(p.Subtitles[0].Request.Path.Extra, expectedExtra) {
+		t.Fatalf("unexpected subtitles extra: %+v", p.Subtitles[0].Request.Path.Extra)
+	}
+	content := p.Subtitles[0].Content
+	if content == nil || !content.IsReady() || len(content.Content) != 1 || content.Content[0].ID != "1" {
+		t.Fatalf("the subtitles should be loaded: %+v", content)
+	}
+	// without any video hash, size, filename and video params the subtitles are kept
+	dispatchPlayer(rt, playerAction(msg.ActionPlayerVideoParamsChanged, map[string]any{"videoParams": nil}))
+	if p.VideoParams != nil || len(p.Subtitles) != 1 {
+		t.Fatalf("the subtitles should be kept without video params: %+v", p.Subtitles)
+	}
+	dispatchPlayer(rt, msg.UnloadAction())
+	if len(p.Subtitles) != 0 {
+		t.Fatalf("the subtitles should be cleared on unload: %+v", p.Subtitles)
+	}
+}
