+func (p *PosterShape) UnmarshalJSON(data []byte) error {
+	var value string
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	switch PosterShape(value) {
+	case PosterShapeSquare, PosterShapeLandscape:
+		*p = PosterShape(value)
+	default:
+		*p = PosterShapePoster
+	}
+	return nil
+}
