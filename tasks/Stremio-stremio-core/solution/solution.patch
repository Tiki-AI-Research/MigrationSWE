+//
+// Search
+//
+
+// SearchHistoryItemDeepLinks are the deep links of a search history item.
+type SearchHistoryItemDeepLinks struct {
+	Search string `json:"search"`
+}
+
+func (l SearchHistoryItemDeepLinks) MarshalJSON() ([]byte, error) {
+	type searchHistoryItemDeepLinks SearchHistoryItemDeepLinks
+	return types.MarshalJSON(searchHistoryItemDeepLinks(l))
+}
+
+// NewSearchHistoryItemDeepLinks creates the deep links of the search query.
+func NewSearchHistoryItemDeepLinks(query string) SearchHistoryItemDeepLinks {
+	return SearchHistoryItemDeepLinks{Search: searchLink(query)}
+}
+
+// LocalSearchItemDeepLinks are the deep links of a local search item.
+type LocalSearchItemDeepLinks struct {
+	Search string `json:"search"`
+}
+
+func (l LocalSearchItemDeepLinks) MarshalJSON() ([]byte, error) {
+	type localSearchItemDeepLinks LocalSearchItemDeepLinks
+	return types.MarshalJSON(localSearchItemDeepLinks(l))
+}
+
+// NewLocalSearchItemDeepLinks creates the deep links of the search query.
+func NewLocalSearchItemDeepLinks(query string) LocalSearchItemDeepLinks {
+	return LocalSearchItemDeepLinks{Search: searchLink(query)}
+}
+
+func searchLink(query string) string {
+	return "stremio:///search?query=" + enc(query)
+}
