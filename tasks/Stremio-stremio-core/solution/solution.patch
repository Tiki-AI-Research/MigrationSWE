+}
+
+func TestActionCtxPullAddonsFromAPIWithUser(t *testing.T) {
+	env := newTestEnv(time.Time{})
+	const collectionBody = `{"type":"AddonCollectionGet","authKey":"auth_key","update":true}`
+	setRoutes(t, env, fetchRoute{
+		Method:   "POST",
+		URL:      "https://api.strem.io/api/addonCollectionGet",
+		Body:     collectionBody,
+		Response: authCollectionResponse(types.OfficialAddons(), env.Now()),
+	})
+	profile := loggedInProfile(userFixture(env.Now()))
+	profile.Addons = []types.Descriptor{authTestAddon()}
+	h := newHarness(t, env, withProfileAndLibrary(env, profile, types.NewLibraryBucket(nil, nil)))
+	h.dispatchCtx(msg.ActionCtxPullAddonsFromAPI, nil)
+
+	assertEqual(t, h.ctx().Profile.Addons, types.OFFICIAL_ADDONS, "addons updated successfully in memory")
+	stored, ok := storageValue[types.Profile](t, env, stremiocore.PROFILE_STORAGE_KEY)
+	if !ok {
+		t.Errorf("addons updated successfully in storage: missing key")
+	}
+	assertEqual(t, stored.Addons, types.OFFICIAL_ADDONS, "addons updated successfully in storage")
+	if len(env.Requests) != 1 {
+		t.Fatalf("One request has been sent, got %d: %s", len(env.Requests), describeRequests(env.Requests))
+	}
+	if env.Requests[0].URL != "https://api.strem.io/api/addonCollectionGet" {
+		t.Errorf("addonCollectionGet request has been sent, got %s", env.Requests[0].URL)
+	}
+	assertRequests(t, env, fetchRoute{Method: "POST", URL: "https://api.strem.io/api/addonCollectionGet", Body: collectionBody})
+
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventUserAddonsLocked,
+		msg.EventAddonsPulledFromAPI,
+		msg.EventProfilePushedToStorage,
+	}, "events")
+	assertEvent(t, h.findEvent(msg.EventUserAddonsLocked), msg.EventUserAddonsLocked,
+		`{"addons_locked":false}`, "UserAddonsLocked")
+	// the added transport urls (in any order: rust HashSet), then the removed one
+	var args msg.TransportURLsArgs
+	if event := h.findEvent(msg.EventAddonsPulledFromAPI); event != nil {
+		if err := event.DecodeArgs(&args); err != nil {
+			t.Fatalf("AddonsPulledFromAPI args: %v", err)
+		}
+	}
+	if n := len(args.TransportURLs); n == 0 || args.TransportURLs[n-1] != "https://transport_url/" {
+		t.Errorf("AddonsPulledFromAPI: the removed transport url is last, got %v", args.TransportURLs)
+	} else {
+		added := append([]string{}, args.TransportURLs[:n-1]...)
+		officialURLs := []string{}
+		for _, addon := range types.OFFICIAL_ADDONS {
+			officialURLs = append(officialURLs, addon.TransportURL)
+		}
+		sort.Strings(added)
+		sort.Strings(officialURLs)
+		assertEqual(t, added, officialURLs, "AddonsPulledFromAPI: the added transport urls")
+	}
+	assertEvent(t, h.findEvent(msg.EventProfilePushedToStorage), msg.EventProfilePushedToStorage,
+		`{"uid":"user_id"}`, "ProfilePushedToStorage")
+	// the action is unchanged, the AddonsAPIResult changes the profile
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
