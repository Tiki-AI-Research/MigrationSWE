+func TestStreamingServerCreateTorrentFromMagnet(t *testing.T) {
+	const infoHash = "8c3c23f2d1635fa63968c43d3366329e7a14eb39"
+	env, rt, rx := ssLoadedRuntime(t, func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		if method == "POST" && url == ssURL+infoHash+"/create" {
+			return []byte(`{"torrent":{"infoHash":"` + infoHash + `"}}`), nil
+		}
+		return nil, nil
+	})
+	magnet := "magnet:?xt=urn:btih:8C3C23F2D1635FA63968C43D3366329E7A14EB39&dn=Test&tr=udp%3A%2F%2Ftracker.opentrackr.org%3A1337"
+	rt.Dispatch(ssAction(msg.ActionStreamingServerCreateTorrent, magnet))
+	if len(env.Requests) != 1 {
+		t.Fatalf("requests = %+v", env.Requests)
+	}
+	request := env.Requests[0]
+	wantBody := `{"peerSearch":{"max":200,"min":40,"sources":["dht:` + infoHash + `","tracker:udp://tracker.opentrackr.org:1337"]}}`
+	if request.Method != "POST" || string(request.Body) != wantBody || request.Headers["content-type"] != "application/json" {
+		t.Errorf("request = %s %s %v %s", request.Method, request.URL, request.Headers, request.Body)
+	}
+	torrent := ssModel(t, rt.Model()).StreamingServer.Torrent
+	if torrent == nil || torrent.InfoHash.String() != infoHash ||
+		!torrent.Path.Equal(common.Ready(types.NewResourcePath("meta", "other", "bt:"+infoHash))) {
+		t.Fatalf("torrent = %+v", torrent)
+	}
+	events := ssDrainEvents(rx)
+	if len(events) != 1 || events[0].Event != msg.EventMagnetParsed || string(events[0].Args) != `{"magnet":"`+magnet+`"}` {
+		t.Errorf("events = %v", events)
+	}
+	data, _ := types.MarshalJSON(ssModel(t, rt.Model()).StreamingServer)
+	if !strings.Contains(string(data), `"torrent":["`+infoHash+`",{"type":"Ready","content":{"resource":"meta","type":"other","id":"bt:`+infoHash+`","extra":[]}}]`) {
+		t.Errorf("serialized torrent: %s", data)
+	}
+
+	// an invalid magnet resets the torrent
+	rt.Dispatch(ssAction(msg.ActionStreamingServerCreateTorrent, "magnet:?dn=no-hash"))
+	if ssModel(t, rt.Model()).StreamingServer.Torrent != nil {
+		t.Error("torrent should be reset")
+	}
+	events = ssDrainEvents(rx)
+	wantError := `{"error":{"type":"Env","code":1001,"message":"Other error: Failed to parse magnet url"},"source":{"event":"MagnetParsed","args":{"magnet":"magnet:?dn=no-hash"}}}`
+	if len(events) != 1 || events[0].Event != msg.EventError || string(events[0].Args) != wantError {
+		t.Errorf("events = %v", events)
+	}
+}
