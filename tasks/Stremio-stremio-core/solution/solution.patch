+		"https://transport_url/stream/series/tt123456%3A1%3A2.json": `{"streams": []}`,
+	}
+	for url, response := range responses {
+		all[url] = response
+	}
+	env.FetchFn = playerFetchHandler(all)
+	m := New(env)
+	m.Ctx.Library = types.NewLibraryBucket(nil, []types.LibraryItem{playerLibraryItem("tt123456:1:1")})
+	if configure != nil {
+		configure(env, m)
