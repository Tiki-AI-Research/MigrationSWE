+
+func zlibSum(data []byte) string {
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:8])
+}
+
+func TestZlibVectors(t *testing.T) {
+	inputs := zlibVectorInputs()
+	if len(inputs) != len(zlibVectorExpectations) {
+		t.Fatalf("got %d inputs, want %d", len(inputs), len(zlibVectorExpectations))
+	}
+	for i, input := range inputs {
+		want := zlibVectorExpectations[i]
+		if len(input) != want.inputLen {
+			t.Fatalf("vector %d: input length %d, want %d", i, len(input), want.inputLen)
+		}
+		if got := ZlibCompress(input); len(got) != want.level6Len || zlibSum(got) != want.level6Sum {
+			t.Errorf("vector %d (len %d): ZlibCompress output (len %d, sum %s) differs from Rust (len %d, sum %s)",
+				i, len(input), len(got), zlibSum(got), want.level6Len, want.level6Sum)
+		}
+		if got := ZlibStore(input); len(got) != want.level0Len || zlibSum(got) != want.level0Sum {
+			t.Errorf("vector %d (len %d): ZlibStore output (len %d, sum %s) differs from Rust (len %d, sum %s)",
+				i, len(input), len(got), zlibSum(got), want.level0Len, want.level0Sum)
+		}
+	}
+}
+
+func TestZlibStoreMatchesLevel0Compressor(t *testing.T) {
+	for i, input := range zlibVectorInputs() {
+		if !bytes.Equal(ZlibStore(input), zlCompress(input, zlCompFlagsFromLevel(0))) {
+			t.Errorf("vector %d (len %d): ZlibStore differs from the level 0 compressor", i, len(input))
+		}
+	}
+}
+
+func TestZlibRoundTrip(t *testing.T) {
+	for i, input := range zlibVectorInputs() {
+		for name, compressed := range map[string][]byte{"ZlibCompress": ZlibCompress(input), "ZlibStore": ZlibStore(input)} {
+			reader, err := zlib.NewReader(bytes.NewReader(compressed))
+			if err != nil {
+				t.Fatalf("vector %d: %s: %v", i, name, err)
+			}
+			output, err := io.ReadAll(reader)
+			if err != nil || !bytes.Equal(output, input) {
+				t.Errorf("vector %d: %s does not round trip: %v", i, name, err)
+			}
+		}
+	}
+}
