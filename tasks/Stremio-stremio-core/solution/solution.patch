@@ -0,0 +1,666 @@
+package types
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strconv"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+)
+
+// Auth request types.
+const (
+	AuthRequestLogin          = "Login"
+	AuthRequestRegister       = "Register"
+	AuthRequestFacebook       = "Facebook"
+	AuthRequestApple          = "Apple"
+	AuthRequestLoginWithToken = "LoginWithToken"
+)
+
+// AuthRequest is an authentication request, tagged by Type.
+type AuthRequest struct {
+	Type        string
+	Email       string
+	Password    string
+	Facebook    bool
+	GDPRConsent GDPRConsent
+	Token       string
+	Sub         string
+	Name        string
+}
+
+func (r AuthRequest) MarshalJSON() ([]byte, error) {
+	switch r.Type {
+	case AuthRequestLogin:
+		return MarshalJSON(struct {
+			Type     string `json:"type"`
+			Email    string `json:"email"`
+			Password string `json:"password"`
+			Facebook bool   `json:"facebook"`
+		}{r.Type, r.Email, r.Password, r.Facebook})
+	case AuthRequestRegister:
+		return MarshalJSON(struct {
+			Type        string      `json:"type"`
+			Email       string      `json:"email"`
+			Password    string      `json:"password"`
+			GDPRConsent GDPRConsent `json:"gdpr_consent"`
+		}{r.Type, r.Email, r.Password, r.GDPRConsent})
+	case AuthRequestFacebook, AuthRequestLoginWithToken:
+		return MarshalJSON(struct {
+			Type  string `json:"type"`
+			Token string `json:"token"`
+		}{r.Type, r.Token})
+	case AuthRequestApple:
+		return MarshalJSON(struct {
+			Type  string `json:"type"`
+			Token string `json:"token"`
+			Sub   string `json:"sub"`
+			Email string `json:"email"`
+			Name  string `json:"name"`
+		}{r.Type, r.Token, r.Sub, r.Email, r.Name})
+	}
+	return nil, fmt.Errorf("unknown auth request type %q", r.Type)
+}
+
+func (r *AuthRequest) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Type        *string      `json:"type"`
+		Email       *string      `json:"email"`
+		Password    *string      `json:"password"`
+		Facebook    bool         `json:"facebook"`
+		GDPRConsent *GDPRConsent `json:"gdpr_consent"`
+		Token       *string      `json:"token"`
+		Sub         *string      `json:"sub"`
+		Name        *string      `json:"name"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Type == nil {
+		return errors.New("missing field `type`")
+	}
+	request := AuthRequest{Type: *wire.Type, Facebook: wire.Facebook}
+	str := func(value *string, name string) (string, error) {
+		if value == nil {
+			return "", fmt.Errorf("missing field `%s`", name)
+		}
+		return *value, nil
+	}
+	var err error
+	switch request.Type {
+	case AuthRequestLogin:
+		if request.Email, err = str(wire.Email, "email"); err != nil {
+			return err
+		}
+		if request.Password, err = str(wire.Password, "password"); err != nil {
+			return err
+		}
+	case AuthRequestRegister:
+		if request.Email, err = str(wire.Email, "email"); err != nil {
+			return err
+		}
+		if request.Password, err = str(wire.Password, "password"); err != nil {
+			return err
+		}
+		if wire.GDPRConsent == nil {
+			return errors.New("missing field `gdpr_consent`")
+		}
+		request.GDPRConsent = *wire.GDPRConsent
+	case AuthRequestFacebook, AuthRequestLoginWithToken:
+		if request.Token, err = str(wire.Token, "token"); err != nil {
+			return err
+		}
+	case AuthRequestApple:
+		if request.Token, err = str(wire.Token, "token"); err != nil {
+			return err
+		}
+		if request.Sub, err = str(wire.Sub, "sub"); err != nil {
+			return err
+		}
+		if request.Email, err = str(wire.Email, "email"); err != nil {
+			return err
+		}
+		if request.Name, err = str(wire.Name, "name"); err != nil {
+			return err
+		}
+	default:
+		return fmt.Errorf("unknown variant `%s`", request.Type)
+	}
+	*r = request
+	return nil
+}
+
+// Path returns the API method of the auth request.
+func (r AuthRequest) Path() string {
+	switch r.Type {
+	case AuthRequestLogin:
+		return "login"
+	case AuthRequestLoginWithToken:
+		return "loginWithToken"
+	case AuthRequestFacebook:
+		return "authWithFacebook"
+	case AuthRequestApple:
+		return "authWithApple"
+	case AuthRequestRegister:
+		return "register"
+	}
+	return ""
+}
+
+// API request types.
+const (
+	APIRequestAuth               = "Auth"
+	APIRequestLogout             = "Logout"
+	APIRequestDeleteAccount      = "DeleteAccount"
+	APIRequestAddonCollectionGet = "AddonCollectionGet"
+	APIRequestAddonCollectionSet = "AddonCollectionSet"
+	APIRequestGetUser            = "GetUser"
+	APIRequestSaveUser           = "SaveUser"
+	APIRequestDataExport         = "DataExport"
+	APIRequestEvents             = "Events"
+	APIRequestSeekLog            = "SeekLog"
+	APIRequestSkipGaps           = "SkipGaps"
+	APIRequestGetModal           = "GetModal"
+	APIRequestGetNotification    = "GetNotification"
+)
+
+// FetchRequest is a request which can be sent through Env.Fetch.
+type FetchRequest interface {
+	// Method is the HTTP method.
+	Method() string
+	// URL is the full request url.
+	URL() string
+	// Body is the JSON body (nil for no body).
+	Body() ([]byte, error)
+}
+
+// APIRequest is a request to the Stremio API, tagged by Type.
+type APIRequest struct {
+	Type     string
+	Auth     AuthRequest
+	AuthKey  AuthKey
+	Password Password
+	Update   bool
+	Addons   []Descriptor
+	User     User
+	Events   []json.RawMessage
+	SeekLog  SeekLogRequest
+	SkipGaps SkipGapsRequest
+	Date     time.Time
+}
+
+func (r APIRequest) MarshalJSON() ([]byte, error) {
+	tag := []byte(`{"type":"` + r.Type + `"}`)
+	var rest []byte
+	var err error
+	switch r.Type {
+	case APIRequestAuth:
+		rest, err = MarshalJSON(r.Auth)
+	case APIRequestLogout, APIRequestGetUser, APIRequestDataExport:
+		rest, err = MarshalJSON(struct {
+			AuthKey AuthKey `json:"authKey"`
+		}{r.AuthKey})
+	case APIRequestDeleteAccount:
+		rest, err = MarshalJSON(struct {
+			AuthKey  AuthKey  `json:"authKey"`
+			Password Password `json:"password"`
+		}{r.AuthKey, r.Password})
+	case APIRequestAddonCollectionGet:
+		rest, err = MarshalJSON(struct {
+			AuthKey AuthKey `json:"authKey"`
+			Update  bool    `json:"update"`
+		}{r.AuthKey, r.Update})
+	case APIRequestAddonCollectionSet:
+		rest, err = MarshalJSON(struct {
+			AuthKey AuthKey      `json:"authKey"`
+			Addons  []Descriptor `json:"addons"`
+		}{r.AuthKey, nonNilSlice(r.Addons)})
+	case APIRequestSaveUser:
+		head, headErr := MarshalJSON(struct {
+			AuthKey AuthKey `json:"authKey"`
+		}{r.AuthKey})
+		if headErr != nil {
+			return nil, headErr
+		}
+		user, userErr := MarshalJSON(r.User)
+		if userErr != nil {
+			return nil, userErr
+		}
+		rest = mergeJSONObjects(head, user)
+	case APIRequestEvents:
+		rest, err = MarshalJSON(struct {
+			AuthKey AuthKey           `json:"authKey"`
+			Events  []json.RawMessage `json:"events"`
+		}{r.AuthKey, nonNilSlice(r.Events)})
+	case APIRequestSeekLog:
+		rest, err = MarshalJSON(r.SeekLog)
+	case APIRequestSkipGaps:
+		rest, err = MarshalJSON(r.SkipGaps)
+	case APIRequestGetModal, APIRequestGetNotification:
+		rest, err = MarshalJSON(struct {
+			Date LocalTime `json:"date"`
+		}{LocalTime(r.Date)})
+	default:
+		return nil, fmt.Errorf("unknown api request type %q", r.Type)
+	}
+	if err != nil {
+		return nil, err
+	}
+	// The tag is prepended like serde does for internally tagged enums; for
+	// `Auth` this results in two `type` keys, as in the original protocol.
+	return mergeJSONObjects(tag, rest), nil
+}
+
+// Path returns the API method of the request.
+func (r APIRequest) Path() string {
+	switch r.Type {
+	case APIRequestAuth:
+		return r.Auth.Path()
+	case APIRequestLogout:
+		return "logout"
+	case APIRequestDeleteAccount:
+		return "deleteUser"
+	case APIRequestAddonCollectionGet:
+		return "addonCollectionGet"
+	case APIRequestAddonCollectionSet:
+		return "addonCollectionSet"
+	case APIRequestGetUser:
+		return "getUser"
+	case APIRequestSaveUser:
+		return "saveUser"
+	case APIRequestDataExport:
+		return "dataExport"
+	case APIRequestEvents:
+		return "events"
+	case APIRequestSeekLog:
+		return "seekLog"
+	case APIRequestSkipGaps:
+		return "getSkipGaps"
+	case APIRequestGetModal:
+		return "getModal"
+	case APIRequestGetNotification:
+		return "getNotification"
+	}
+	return ""
+}
+
+func (r APIRequest) Method() string { return "POST" }
+
+func (r APIRequest) URL() string {
+	return stremiocore.API_URL + "api/" + r.Path()
+}
+
+func (r APIRequest) Body() ([]byte, error) { return MarshalJSON(r) }
+
+// SeekLog is a seek performed by the user (in milliseconds).
+type SeekLog struct {
+	From uint64 `json:"from"`
+	To   uint64 `json:"to"`
+}
+
+// SeekLogRequest sends the seek logs of a played stream.
+type SeekLogRequest struct {
+	// OsHash is the opensubtitles hash returned by the streaming server.
+	OsHash     string
+	ItemID     string
+	SeriesInfo SeriesInfo
+	// StreamNameHash is the base64 encoded SHA-256 hash of the stream name.
+	StreamNameHash string
+	Duration       uint64
+	SeekHistory    []SeekLog
+	// SkipOutro is when (in milliseconds) the user played the next video.
+	SkipOutro []uint64
+}
+
+func (r SeekLogRequest) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(struct {
+		OsHash         string    `json:"osId"`
+		ItemID         string    `json:"itemId"`
+		Season         uint32    `json:"season"`
+		Episode        uint32    `json:"episode"`
+		StreamNameHash string    `json:"stHash"`
+		Duration       uint64    `json:"duration"`
+		SeekHistory    []SeekLog `json:"seekHistory"`
+		SkipOutro      []uint64  `json:"skipOutro"`
+	}{r.OsHash, r.ItemID, r.SeriesInfo.Season, r.SeriesInfo.Episode, r.StreamNameHash, r.Duration,
+		nonNilSlice(r.SeekHistory), nonNilSlice(r.SkipOutro)})
+}
