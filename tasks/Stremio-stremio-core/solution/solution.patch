+++ b/models/ctx/update_events.go
@@ -0,0 +1,108 @@
+package ctx
+
+import (
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateEvents(env runtime.Env, events *Events, dismissedEvents *types.DismissedEventsBucket, m *msg.Msg) runtime.Effects {
+	if m.IsInternal(msg.InternalLogout) {
+		*dismissedEvents = types.NewDismissedEventsBucket(nil)
+		return dismissedEventsChangedEffects()
+	}
+	if isCtxAction(m, msg.ActionCtxGetEvents) {
+		modalEffects := common.EqUpdate(&events.Modal, common.Loading[*types.GetModalResponse]())
+		notificationEffects := common.EqUpdate(&events.Notification, common.Loading[*types.GetNotificationResponse]())
+		requestsEffects := runtime.ManyEffects(getModal(env), getNotification(env))
+		return modalEffects.
+			Join(notificationEffects).
+			Join(requestsEffects)
+	}
+	if isCtxAction(m, msg.ActionCtxDismissEvent) {
+		var id string
+		if !decodeStrictCtxAction(m, msg.ActionCtxDismissEvent, &id) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		if dismissedEvents.Items == nil {
+			dismissedEvents.Items = map[string]time.Time{}
+		}
+		dismissedEvents.Items[id] = env.LocalNow()
+		messageEffects := dismissedEventsChangedEffects()
+		eventsModalEffects := runtime.NoneEffects().Unchanged()
+		if modal, ok := events.Modal.Ready(); ok && modal != nil && isEventDismissed(dismissedEvents, modal.ID) {
+			eventsModalEffects = common.EqUpdate(&events.Modal, common.Ready[*types.GetModalResponse](nil))
+		}
+		eventsNotificationEffects := runtime.NoneEffects().Unchanged()
+		if notification, ok := events.Notification.Ready(); ok && notification != nil && isEventDismissed(dismissedEvents, notification.ID) {
+			eventsNotificationEffects = common.EqUpdate(&events.Notification, common.Ready[*types.GetNotificationResponse](nil))
+		}
+		return messageEffects.
+			Join(eventsModalEffects).
+			Join(eventsNotificationEffects)
+	}
+	if result, ok := InternalData[GetModalResult](m, msg.InternalGetModalResult); ok {
+		switch {
+		case result.Err != nil:
+			return common.EqUpdate(&events.Modal, common.Err[*types.GetModalResponse](result.Err))
+		case result.Response != nil && !isEventDismissed(dismissedEvents, result.Response.ID):
+			return common.EqUpdate(&events.Modal, common.Ready(result.Response))
+		}
+		return common.EqUpdate(&events.Modal, common.Ready[*types.GetModalResponse](nil))
+	}
+	if result, ok := InternalData[GetNotificationResult](m, msg.InternalGetNotificationResult); ok {
+		switch {
+		case result.Err != nil:
+			return common.EqUpdate(&events.Notification, common.Err[*types.GetNotificationResponse](result.Err))
+		case result.Response != nil && !isEventDismissed(dismissedEvents, result.Response.ID):
+			return common.EqUpdate(&events.Notification, common.Ready(result.Response))
+		}
+		return common.EqUpdate(&events.Notification, common.Ready[*types.GetNotificationResponse](nil))
+	}
+	if m.IsInternal(msg.InternalDismissedEventsChanged) {
+		return runtime.OneEffect(pushDismissedEventsToStorage(env, dismissedEvents)).Unchanged()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func isEventDismissed(dismissedEvents *types.DismissedEventsBucket, id string) bool {
+	_, ok := dismissedEvents.Items[id]
+	return ok
+}
+
+func dismissedEventsChangedEffects() runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalDismissedEventsChanged, nil)))
+}
+
+func getModal(env runtime.Env) runtime.Effect {
+	request := types.APIRequest{Type: types.APIRequestGetModal, Date: env.LocalNow()}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		response, err := fetchAPI[*types.GetModalResponse](env, request)
+		result := GetModalResult{Request: request, Err: err}
+		if err == nil {
+			result.Response = response
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalGetModalResult, result))
+	})
+}
+
+func getNotification(env runtime.Env) runtime.Effect {
+	request := types.APIRequest{Type: types.APIRequestGetNotification, Date: env.LocalNow()}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		response, err := fetchAPI[*types.GetNotificationResponse](env, request)
+		result := GetNotificationResult{Request: request, Err: err}
+		if err == nil {
+			result.Response = response
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalGetNotificationResult, result))
+	})
+}
+
+func pushDismissedEventsToStorage(env runtime.Env, dismissedEvents *types.DismissedEventsBucket) runtime.Effect {
+	return common.StorageFuture(env, stremiocore.DISMISSED_EVENTS_STORAGE_KEY, *dismissedEvents,
+		storageResult(msg.UIDEvent(msg.EventDismissedEventsPushedToStorage, dismissedEvents.UID)))
+}
diff --git a/models/ctx/update_events_test.go b/models/ctx/update_events_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..9323f7b16a213fb994a21a6dfd15fd8a065ce0ac
--- /dev/null
+++ b/models/ctx/update_events_test.go
@@ -0,0 +1,179 @@
+package ctx_test
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of src/unit_tests/ctx/update_events.rs
+
+// evModalResponse is the modal returned by the fake API.
+func evModalResponse() *types.GetModalResponse {
+	return &types.GetModalResponse{
+		ID:       "modal_id",
+		Title:    "title",
+		Message:  "message",
+		ImageURL: "https://image_url/",
+	}
+}
+
+// evNotificationResponse is the notification returned by the fake API.
+func evNotificationResponse() *types.GetNotificationResponse {
+	return &types.GetNotificationResponse{
+		ID:      "notification_id",
+		Title:   "title",
+		Message: "message",
+	}
+}
+
+// evRoutes are the routes of the rust `fetch_handler`: the getModal and
+// getNotification requests, with the date of the request in the local time.
+func evRoutes(date string) []fetchRoute {
+	return []fetchRoute{
+		{
+			Method:   "POST",
+			URL:      "https://api.strem.io/api/getModal",
+			Body:     `{"type":"GetModal","date":"` + date + `"}`,
+			Response: apiOK(evModalResponse()),
+		},
+		{
+			Method:   "POST",
+			URL:      "https://api.strem.io/api/getNotification",
+			Body:     `{"type":"GetNotification","date":"` + date + `"}`,
+			Response: apiOK(evNotificationResponse()),
+		},
+	}
+}
+
+// evAssertLoading checks that both events are loading.
+func evAssertLoading(t *testing.T, h *harness) {
+	t.Helper()
+	if !h.ctx().Events.Modal.IsLoading() {
+		t.Errorf("Modal should be loading")
+	}
+	if !h.ctx().Events.Notification.IsLoading() {
+		t.Errorf("Notification should be loading")
+	}
+}
+
+// evStoredDismissedEvents returns the raw serialized dates of the stored
+// dismissed events by id.
+func evStoredDismissedEvents(t *testing.T, env *testenv.Env) map[string]string {
+	t.Helper()
+	raw, ok := env.Storage[stremiocore.DISMISSED_EVENTS_STORAGE_KEY]
+	if !ok {
+		t.Fatalf("Dismissed events should be stored")
+	}
+	var stored struct {
+		UID   *string           `json:"uid"`
+		Items map[string]string `json:"items"`
+	}
+	if err := json.Unmarshal(raw, &stored); err != nil {
+		t.Fatalf("invalid stored dismissed events %s: %v", raw, err)
+	}
+	return stored.Items
+}
+
+func TestEvents(t *testing.T) {
+	env := newTestEnv(datetime(2020, 1, 1, 10, 30, 0))
+	setRoutes(t, env, evRoutes("2020-01-01T10:30:00Z")...)
+	h := newHarness(t, env, defaultCtx(env))
+	evAssertLoading(t, h)
+
+	h.dispatchCtx(msg.ActionCtxGetEvents, nil)
+
+	if !h.ctx().Events.Modal.IsReady() {
+		t.Errorf("Modal should be ready")
+	}
+	if !h.ctx().Events.Notification.IsReady() {
+		t.Errorf("Notification should be ready")
+	}
+	assertEqual(t, h.ctx().Events.Modal, common.Ready(evModalResponse()), "Modal")
+	assertEqual(t, h.ctx().Events.Notification, common.Ready(evNotificationResponse()), "Notification")
+	routes := evRoutes("2020-01-01T10:30:00Z")
+	assertRequests(t, env, routes[0], routes[1])
+	assertEqual(t, h.coreEventNames(), []string{}, "No events emitted")
+	// GetEvents (the requests effects are changed), GetModalResult, GetNotificationResult
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}, {"ctx"}, {"ctx"}}, "NewState")
+}
+
+func TestDismissedEvents(t *testing.T) {
+	now := datetime(2020, 1, 1, 10, 30, 0)
+	env := newTestEnv(now)
+	env.LocalOffset = 2 * 60 * 60
+	setRoutes(t, env, evRoutes("2020-01-01T12:30:00+02:00")...)
+	h := newHarness(t, env, defaultCtx(env))
+	evAssertLoading(t, h)
+
+	h.dispatchCtx(msg.ActionCtxGetEvents, nil)
+
+	if !h.ctx().Events.Modal.IsReady() {
+		t.Errorf("Modal should be ready")
+	}
+	if !h.ctx().Events.Notification.IsReady() {
+		t.Errorf("Notification should be ready")
+	}
+
+	h.clearEvents()
+	h.dispatchCtx(msg.ActionCtxDismissEvent, "modal_id")
+	assertEqual(t, h.ctx().Events.Modal, common.Ready[*types.GetModalResponse](nil), "Modal should be ready and empty")
+	assertEqual(t, h.ctx().Events.Notification, common.Ready(evNotificationResponse()), "Notification is not dismissed yet")
+	h.dispatchCtx(msg.ActionCtxDismissEvent, "notification_id")
+
+	assertEqual(t, h.ctx().Events.Modal, common.Ready[*types.GetModalResponse](nil), "Modal should be ready and empty")
+	assertEqual(t, h.ctx().Events.Notification, common.Ready[*types.GetNotificationResponse](nil), "Notification should be ready and empty")
+
+	// the events are dismissed at the local time
+	assertEqual(t, h.ctx().DismissedEvents.Items, map[string]time.Time{
+		"modal_id":        now,
+		"notification_id": now,
+	}, "Dismissed events in memory")
+	for id, date := range h.ctx().DismissedEvents.Items {
+		if _, offset := date.Zone(); offset != 2*60*60 {
+			t.Errorf("Dismissed event %s should be in the local time, got %s", id, date)
+		}
+	}
+	assertEqual(t, evStoredDismissedEvents(t, env), map[string]string{
+		"modal_id":        "2020-01-01T12:30:00+02:00",
+		"notification_id": "2020-01-01T12:30:00+02:00",
+	}, "Dismissed events stored with the local time")
+	stored, _ := storageValue[types.DismissedEventsBucket](t, env, stremiocore.DISMISSED_EVENTS_STORAGE_KEY)
+	assertEqual(t, stored, h.ctx().DismissedEvents, "Dismissed events stored")
+
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventDismissedEventsPushedToStorage,
+		msg.EventDismissedEventsPushedToStorage,
+	}, "events")
+	assertEvent(t, h.findEvent(msg.EventDismissedEventsPushedToStorage), msg.EventDismissedEventsPushedToStorage, `{"uid":null}`, "DismissedEventsPushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}, {"ctx"}}, "NewState")
+	if len(env.Requests) != 2 {
+		t.Errorf("Dismissing the events should not send requests: %s", describeRequests(env.Requests))
+	}
+}
+
+func TestStoredDismissedEvents(t *testing.T) {
+	env := newTestEnv(datetime(2020, 1, 1, 10, 30, 0))
+	setRoutes(t, env, evRoutes("2020-01-01T10:30:00Z")...)
+	dismissedEvents := types.NewDismissedEventsBucket(nil)
+	dismissedEvents.Items["modal_id"] = env.LocalNow()
+	dismissedEvents.Items["notification_id"] = env.LocalNow()
+	c := defaultCtx(env)
+	c.DismissedEvents = dismissedEvents
+	h := newHarness(t, env, c)
+	evAssertLoading(t, h)
+
+	h.dispatchCtx(msg.ActionCtxGetEvents, nil)
+
+	assertEqual(t, h.ctx().Events.Modal, common.Ready[*types.GetModalResponse](nil), "Modal should be ready and empty")
+	assertEqual(t, h.ctx().Events.Notification, common.Ready[*types.GetNotificationResponse](nil), "Notification should be ready and empty")
+	routes := evRoutes("2020-01-01T10:30:00Z")
+	assertRequests(t, env, routes[0], routes[1])
+	assertEqual(t, h.coreEventNames(), []string{}, "No events emitted")
+}
diff --git a/models/ctx/update_library.go b/models/ctx/update_library.go
new file mode 100644
index 0000000000000000000000000000000000000000..3aa2950aaa49886345a55278d56614dfaaaca291
--- /dev/null
+++ b/models/ctx/update_library.go
@@ -0,0 +1,377 @@
+package ctx
+
+import (
+	"encoding/json"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateLibrary(env runtime.Env, library *types.LibraryBucket, profile *types.Profile, status *CtxStatus, m *msg.Msg) runtime.Effects {
+	authKey := profile.AuthKey()
+	if m.IsInternal(msg.InternalLogout) {
+		nextLibrary := types.NewLibraryBucket(nil, nil)
+		if !types.Equal(*library, nextLibrary) {
+			*library = nextLibrary
+			return libraryChangedEffects(false)
+		}
+		return runtime.NoneEffects().Unchanged()
+	}
+	if action := ctxAction(m); action != nil {
+		return updateLibraryWithAction(env, library, profile, m, action.Action)
+	}
+	if item, ok := InternalLibraryItemData(m); ok {
+		if prev, exists := library.Items[item.ID]; exists && item.EqNoMtime(prev) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		item.Mtime = env.Now()
+		pushToAPIEffects := runtime.NoneEffects().Unchanged()
+		if authKey != nil {
+			pushToAPIEffects = runtime.OneEffect(pushItemsToAPI(env, []types.LibraryItem{item}, *authKey)).Unchanged()
+		}
+		pushToStorageEffects := runtime.OneEffect(updateAndPushItemsToStorage(env, library, []types.LibraryItem{item}))
+		return pushToAPIEffects.
+			Join(pushToStorageEffects).
+			Join(libraryChangedEffects(true))
+	}
+	if persisted, ok := InternalBoolData(m, msg.InternalLibraryChanged); ok {
+		if persisted {
+			return runtime.NoneEffects().Unchanged()
+		}
+		return runtime.OneEffect(pushLibraryToStorage(env, library)).Unchanged()
+	}
+	if result, ok := InternalCtxAuthResultData(m); ok {
+		if !status.IsLoading(result.AuthRequest) || result.Response == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		var items []types.LibraryItem
+		if result.Response.LibraryItemsErr == nil {
+			items = result.Response.LibraryItems
+		}
+		nextLibrary := types.NewLibraryBucket(types.NewUID(result.Response.Auth.User.ID), items)
+		if !types.Equal(*library, nextLibrary) {
+			*library = nextLibrary
+			return libraryChangedEffects(false)
+		}
+		return runtime.NoneEffects().Unchanged()
+	}
+	if result, ok := InternalData[LibrarySyncPlanResult](m, msg.InternalLibrarySyncPlanResult); ok {
+		if authKey == nil || *authKey != result.Request.AuthKey {
+			return runtime.NoneEffects().Unchanged()
+		}
+		if result.Err != nil {
+			return errorEffects(result.Err, librarySyncWithAPIPlannedEvent(profile.UID(), nil, nil))
+		}
+		pushIDs := map[string]bool{}
+		for _, id := range result.PushIDs {
+			pushIDs[id] = true
+		}
+		pushItems := []types.LibraryItem{}
+		for _, id := range sortedKeys(library.Items) {
+			if pushIDs[id] {
+				pushItems = append(pushItems, library.Items[id])
+			}
+		}
+		pushItemsToAPIEffects := runtime.NoneEffects().Unchanged()
+		if len(pushItems) > 0 {
+			pushItemsToAPIEffects = runtime.OneEffect(pushItemsToAPI(env, pushItems, result.Request.AuthKey)).Unchanged()
+		}
+		pullItemsFromAPIEffects := runtime.NoneEffects().Unchanged()
+		if len(result.PullIDs) > 0 {
+			pullItemsFromAPIEffects = runtime.OneEffect(pullItemsFromAPI(env, result.PullIDs, result.Request.AuthKey)).Unchanged()
+		}
+		return runtime.MsgEffects(msg.EventMsg(librarySyncWithAPIPlannedEvent(profile.UID(), result.PullIDs, result.PushIDs))).
+			Join(pushItemsToAPIEffects).
+			Join(pullItemsFromAPIEffects).
+			Unchanged()
+	}
+	if result, ok := InternalData[LibraryPullResult](m, msg.InternalLibraryPullResult); ok {
+		if authKey == nil || *authKey != result.Request.AuthKey || result.Request.Command.Kind != types.DatastoreCommandGet {
+			return runtime.NoneEffects().Unchanged()
+		}
+		ids := result.Request.Command.IDs
+		if result.Err != nil {
+			return errorEffects(result.Err, msg.IDsEvent(msg.EventLibraryItemsPulledFromAPI, ids))
+		}
+		// send an event that the missing library is now present
+		pulledEventsEffects := eventEffects(msg.NewEvent(msg.EventUserLibraryMissing, struct {
+			LibraryMissing bool `json:"library_missing"`
+		}{false})).
+			Join(eventEffects(msg.IDsEvent(msg.EventLibraryItemsPulledFromAPI, ids)))
+		if shouldUpdateLibraryWithItems(*library, result.Items) {
+			return pulledEventsEffects.
+				Join(runtime.OneEffect(updateAndPushItemsToStorage(env, library, result.Items))).
+				Join(libraryChangedEffects(true))
+		}
+		return pulledEventsEffects
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func updateLibraryWithAction(env runtime.Env, library *types.LibraryBucket, profile *types.Profile, m *msg.Msg, name string) runtime.Effects {
+	switch name {
+	case msg.ActionCtxAddToLibrary:
+		var metaPreview types.MetaItemPreview
+		if !decodeStrictCtxAction(m, name, &metaPreview) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		var libraryItem types.LibraryItem
+		if existing, ok := library.Items[metaPreview.ID]; ok {
+			libraryItem = types.LibraryItemFromMetaPreviewAndItem(metaPreview, existing)
+		} else {
+			libraryItem = types.NewLibraryItemFromMetaPreview(metaPreview, env.Now())
+		}
+		libraryItem.Removed = false
+		libraryItem.Temp = false
+		return updateLibraryItemEffects(libraryItem).
+			Join(runtime.MsgEffects(msg.EventMsg(msg.IDEvent(msg.EventLibraryItemAdded, metaPreview.ID)))).
+			Unchanged()
+	case msg.ActionCtxRemoveFromLibrary:
+		var id string
+		if !decodeStrictCtxAction(m, name, &id) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		libraryItem, ok := library.Items[id]
+		if !ok {
+			return errorEffects(NewOtherError(OtherErrorLibraryItemNotFound), msg.IDEvent(msg.EventLibraryItemRemoved, id))
+		}
+		libraryItem.Removed = true
+		libraryItem.Temp = false
+		// Dismiss any notification for the LibraryItem
+		// whether no_notifs is enabled or not, we do not care.
+		// we will dismiss the notifs. and remove the item from CW.
+		notificationsEffects := runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalDismissNotificationItem, id))).Unchanged()
+		return updateLibraryItemEffects(libraryItem).
+			Join(notificationsEffects).
+			Join(runtime.MsgEffects(msg.EventMsg(msg.IDEvent(msg.EventLibraryItemRemoved, id)))).
+			Unchanged()
+	case msg.ActionCtxRewindLibraryItem:
+		var id string
+		if !decodeStrictCtxAction(m, name, &id) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		libraryItem, ok := library.Items[id]
+		if !ok {
+			return errorEffects(NewOtherError(OtherErrorLibraryItemNotFound), msg.IDEvent(msg.EventLibraryItemRewinded, id))
+		}
+		libraryItem.State.TimeOffset = 0
+		return updateLibraryItemEffects(libraryItem).
+			Join(runtime.MsgEffects(msg.EventMsg(msg.IDEvent(msg.EventLibraryItemRewinded, id)))).
+			Unchanged()
+	case msg.ActionCtxToggleLibraryItemNotifications:
+		var args []json.RawMessage
+		if !decodeStrictCtxAction(m, name, &args) || len(args) != 2 {
+			return runtime.NoneEffects().Unchanged()
+		}
+		var id string
+		var state bool
+		if json.Unmarshal(args[0], &id) != nil || json.Unmarshal(args[1], &state) != nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		libraryItem, ok := library.Items[id]
+		if !ok {
+			return errorEffects(NewOtherError(OtherErrorLibraryItemNotFound), msg.IDEvent(msg.EventLibraryItemNotificationsToggled, id))
+		}
+		libraryItem.State.NoNotif = state
+		// if we have `no_notif` set to `true` (we don't want notifications for the LibraryItem)
+		// we want to dismiss any notifications for the LibraryItem that exist
+		notificationsEffects := runtime.NoneEffects().Unchanged()
+		if libraryItem.State.NoNotif {
+			notificationsEffects = runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalDismissNotificationItem, id))).Unchanged()
+		}
+		return updateLibraryItemEffects(libraryItem).
+			Join(runtime.MsgEffects(msg.EventMsg(msg.IDEvent(msg.EventLibraryItemNotificationsToggled, id)))).
+			Join(notificationsEffects).
+			Unchanged()
+	case msg.ActionCtxSyncLibraryWithAPI:
+		if authKey := profile.AuthKey(); authKey != nil {
+			return runtime.OneEffect(planSyncWithAPI(env, *library, *authKey)).Unchanged()
+		}
+		return errorEffects(NewOtherError(OtherErrorUserNotLoggedIn), librarySyncWithAPIPlannedEvent(profile.UID(), nil, nil))
+	case msg.ActionCtxLibraryItemMarkAsWatched:
+		var args struct {
+			ID        *string `json:"id"`
+			IsWatched *bool   `json:"is_watched"`
+		}
+		if !decodeStrictCtxAction(m, name, &args) || args.ID == nil || args.IsWatched == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		libraryItem, ok := library.Items[*args.ID]
+		if !ok {
+			return runtime.NoneEffects().Unchanged()
+		}
+		libraryItem.MarkAsWatched(env.Now(), *args.IsWatched)
+		return updateLibraryItemEffects(libraryItem).Unchanged()
+	case msg.ActionCtxMetaItemMarkAsWatched:
+		var args struct {
+			MetaItem  *types.MetaItemPreview `json:"meta_item"`
+			IsWatched *bool                  `json:"is_watched"`
+		}
+		if !decodeStrictCtxAction(m, name, &args) || args.MetaItem == nil || args.IsWatched == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		libraryItem, ok := library.Items[args.MetaItem.ID]
+		if !ok {
+			if !*args.IsWatched {
+				return runtime.NoneEffects().Unchanged()
+			}
+			libraryItem = types.NewLibraryItemFromMetaPreview(*args.MetaItem, env.Now())
+		}
+		libraryItem.MarkAsWatched(env.Now(), *args.IsWatched)
+		return updateLibraryItemEffects(libraryItem).Unchanged()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func updateLibraryItemEffects(item types.LibraryItem) runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, item)))
+}
+
+func libraryChangedEffects(persisted bool) runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalLibraryChanged, persisted)))
+}
+
+func librarySyncWithAPIPlannedEvent(uid types.UID, pullIDs, pushIDs []string) *msg.Event {
+	if pullIDs == nil {
+		pullIDs = []string{}
+	}
+	if pushIDs == nil {
+		pushIDs = []string{}
+	}
+	return msg.NewEvent(msg.EventLibrarySyncWithAPIPlanned, struct {
+		UID  types.UID   `json:"uid"`
+		Plan [2][]string `json:"plan"`
+	}{uid, [2][]string{pullIDs, pushIDs}})
+}
+
+func shouldUpdateLibraryWithItems(library types.LibraryBucket, items []types.LibraryItem) bool {
+	for _, item := range items {
+		current, ok := library.Items[item.ID]
+		if !ok {
+			return true
+		}
+		if !item.Mtime.Before(current.Mtime) && !libraryItemEqual(item, current) {
+			return true
+		}
+	}
+	return false
+}
+
+func updateAndPushItemsToStorage(env runtime.Env, library *types.LibraryBucket, items []types.LibraryItem) runtime.Effect {
+	ids := make([]string, 0, len(items))
+	for _, item := range items {
+		ids = append(ids, item.ID)
+	}
+	areItemsInRecent := library.AreIDsInRecent(ids)
+	library.MergeItems(items)
+	var writes []storageWrite
+	if len(library.Items) <= stremiocore.LIBRARY_RECENT_COUNT {
+		writes = []storageWrite{
+			{key: stremiocore.LIBRARY_RECENT_STORAGE_KEY, value: *library},
+			{key: stremiocore.LIBRARY_STORAGE_KEY, value: nil},
+		}
+	} else {
+		recentItems, otherItems := library.SplitItemsByRecent()
+		if areItemsInRecent {
+			writes = []storageWrite{
+				{key: stremiocore.LIBRARY_RECENT_STORAGE_KEY, value: types.NewLibraryBucketRef(library.UID, recentItems)},
+			}
+		} else {
+			writes = []storageWrite{
+				{key: stremiocore.LIBRARY_RECENT_STORAGE_KEY, value: types.NewLibraryBucketRef(library.UID, recentItems)},
+				{key: stremiocore.LIBRARY_STORAGE_KEY, value: types.NewLibraryBucketRef(library.UID, otherItems)},
+			}
+		}
+	}
+	return storageWritesFuture(env, writes, storageResult(msg.IDsEvent(msg.EventLibraryItemsPushedToStorage, ids)))
+}
+
+func pushLibraryToStorage(env runtime.Env, library *types.LibraryBucket) runtime.Effect {
+	ids := sortedKeys(library.Items)
+	recentItems, otherItems := library.SplitItemsByRecent()
+	return storageWritesFuture(env, []storageWrite{
+		{key: stremiocore.LIBRARY_RECENT_STORAGE_KEY, value: types.NewLibraryBucketRef(library.UID, recentItems)},
+		{key: stremiocore.LIBRARY_STORAGE_KEY, value: types.NewLibraryBucketRef(library.UID, otherItems)},
+	}, storageResult(msg.IDsEvent(msg.EventLibraryItemsPushedToStorage, ids)))
+}
+
+func pushItemsToAPI(env runtime.Env, items []types.LibraryItem, authKey types.AuthKey) runtime.Effect {
+	items = append([]types.LibraryItem{}, items...)
+	ids := make([]string, 0, len(items))
+	for _, item := range items {
+		ids = append(ids, item.ID)
+	}
+	request := types.DatastoreRequest{
+		AuthKey:    authKey,
+		Collection: stremiocore.LIBRARY_COLLECTION_NAME,
+		Command:    types.DatastoreCommand{Kind: types.DatastoreCommandPut, Changes: items},
+	}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		_, err := fetchAPI[types.SuccessResponse](env, request)
+		return eventResultMsg(err, msg.IDsEvent(msg.EventLibraryItemsPushedToAPI, ids))
+	})
+}
+
+func pullItemsFromAPI(env runtime.Env, ids []string, authKey types.AuthKey) runtime.Effect {
+	request := types.DatastoreRequest{
+		AuthKey:    authKey,
+		Collection: stremiocore.LIBRARY_COLLECTION_NAME,
+		Command:    types.DatastoreCommand{Kind: types.DatastoreCommandGet, IDs: append([]string{}, ids...), All: false},
+	}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		items, err := fetchAPI[types.LibraryItemsResponse](env, request)
+		result := LibraryPullResult{Request: request, Err: err}
+		if err == nil {
+			result.Items = []types.LibraryItem(items)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalLibraryPullResult, result))
+	})
+}
+
+type localMtime struct {
+	mtime      int64
+	shouldSync bool
+}
+
+func planSyncWithAPI(env runtime.Env, library types.LibraryBucket, authKey types.AuthKey) runtime.Effect {
+	now := env.Now()
+	localMtimes := make(map[string]localMtime, len(library.Items))
+	for id, item := range library.Items {
+		localMtimes[id] = localMtime{mtime: item.Mtime.Unix(), shouldSync: item.ShouldSync(now)}
+	}
+	request := types.DatastoreRequest{
+		AuthKey:    authKey,
+		Collection: stremiocore.LIBRARY_COLLECTION_NAME,
+		Command:    types.DatastoreCommand{Kind: types.DatastoreCommandMeta},
+	}
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		remote, err := fetchAPI[[]types.LibraryItemModified](env, request)
+		result := LibrarySyncPlanResult{Request: request, Err: err}
+		if err == nil {
+			remoteMtimes := make(map[string]int64, len(remote))
+			for _, modified := range remote {
+				remoteMtimes[modified.ID] = modified.Mtime.Unix()
+			}
+			pullIDs := []string{}
+			for _, id := range sortedKeys(remoteMtimes) {
+				local, ok := localMtimes[id]
+				if !ok || local.mtime < remoteMtimes[id] {
+					pullIDs = append(pullIDs, id)
+				}
+			}
+			pushIDs := []string{}
+			for _, id := range sortedKeys(localMtimes) {
+				local := localMtimes[id]
+				remoteMtime, ok := remoteMtimes[id]
+				if local.shouldSync && (!ok || remoteMtime < local.mtime) {
+					pushIDs = append(pushIDs, id)
+				}
+			}
+			result.PullIDs = pullIDs
+			result.PushIDs = pushIDs
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalLibrarySyncPlanResult, result))
+	})
+}
