+// zlTestRand is a small deterministic PRNG (splitmix64).
+type zlTestRand struct{ state uint64 }
+
+func (r *zlTestRand) next() uint64 {
+	r.state += 0x9E3779B97F4A7C15
+	z := r.state
+	z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
+	z = (z ^ (z >> 27)) * 0x94D049BB133111EB
+	return z ^ (z >> 31)
+}
+
+func (r *zlTestRand) intn(n int) int { return int(r.next() % uint64(n)) }
+
+var zlTestWords = []string{"{", "}", "\"", ":", ",", "[", "]", "id", "name", "tt0944947", "video", "series",
+	"https://", "example.com", "/stream/", "true", "false", "null", " ", "\n", "0", "1", "2", "42", "season",
+	"episode", "released", "2021-01-01T00:00:00.000Z", "watched", "behaviorHints", "a", "b", "c"}
+
+// zlTestInput deterministically generates the i-th test input for a seed.
+func zlTestInput(seed uint64, i int, maxLen int) []byte {
+	r := &zlTestRand{state: seed*0x100000001B3 + uint64(i)}
+	var n int
+	switch r.intn(10) {
+	case 0, 1, 2, 3:
+		n = r.intn(min(300, maxLen) + 1)
+	case 4, 5, 6:
+		n = r.intn(min(5000, maxLen) + 1)
+	case 7, 8:
+		n = r.intn(min(70000, maxLen) + 1)
+	default:
+		n = r.intn(maxLen + 1)
+	}
+	out := make([]byte, 0, n)
+	kind := r.intn(8)
+	for len(out) < n {
+		k := kind
+		if kind == 7 {
+			k = r.intn(7)
+		}
+		seg := 1 + r.intn(64)
+		if kind == 7 {
+			seg = 1 + r.intn(4096)
+		}
+		switch k {
+		case 0: // random bytes
+			for j := 0; j < seg; j++ {
+				out = append(out, byte(r.next()))
+			}
+		case 1: // small alphabet
+			alpha := 2 + r.intn(3)
+			for j := 0; j < seg; j++ {
+				out = append(out, byte('a'+r.intn(alpha)))
+			}
+		case 2: // runs
+			b := byte(r.next())
+			run := 1 + r.intn(600)
+			for j := 0; j < run; j++ {
+				out = append(out, b)
+			}
+		case 3: // sparse bitfield
+			for j := 0; j < seg; j++ {
+				switch r.intn(12) {
+				case 0:
+					out = append(out, 0xff)
+				case 1:
+					out = append(out, 0x55)
+				case 2:
+					out = append(out, byte(1<<r.intn(8)))
+				case 3:
+					out = append(out, byte(r.next()))
+				default:
+					out = append(out, 0)
+				}
+			}
+		case 4: // text / JSON-like
+			for j := 0; j < seg; j++ {
+				out = append(out, zlTestWords[r.intn(len(zlTestWords))]...)
+			}
+		case 5: // periodic with mutations
+			p := 1 + r.intn(300)
+			pattern := make([]byte, p)
+			for j := range pattern {
+				pattern[j] = byte(r.next())
+			}
+			reps := 1 + r.intn(2000)
+			for j := 0; j < reps*p && len(out) < n; j++ {
+				if r.intn(100) == 0 {
+					out = append(out, byte(r.next()))
+				} else {
+					out = append(out, pattern[j%p])
+				}
+			}
+		case 6: // far copy of earlier data
+			if len(out) == 0 {
+				out = append(out, byte(r.next()))
+			} else {
+				start := r.intn(len(out))
+				l := 3 + r.intn(300)
+				for j := 0; j < l; j++ {
+					out = append(out, out[(start+j)%len(out)])
+				}
+			}
+		}
+	}
+	return out[:n]
+}
+
+// zlTestEdgeInputs returns inputs around the block boundaries.
+func zlTestEdgeInputs() [][]byte {
+	r := &zlTestRand{state: 31745}
+	var out [][]byte
+	for _, n := range []int{1, 2, 3, 47, 48, 49, 31744, 31745, 31746, 63490, 65535, 65536, 65537, 100000} {
+		random := make([]byte, n)
+		for i := range random {
+			random[i] = byte(r.next())
+		}
+		out = append(out, make([]byte, n), random)
+	}
+	return out
+}
