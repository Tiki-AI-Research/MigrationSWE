+
+func (r *CollectionResponse) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Addons       *[]Descriptor `json:"addons"`
+		LastModified *Time         `json:"lastModified"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Addons == nil || wire.LastModified == nil {
+		return errors.New("missing field of CollectionResponse")
+	}
+	*r = CollectionResponse{Addons: nonNilSlice(*wire.Addons), LastModified: time.Time(*wire.LastModified)}
+	return nil
+}
+
+// AuthResponse is the response of an auth request.
+type AuthResponse struct {
+	Key  AuthKey `json:"authKey"`
+	User User    `json:"user"`
+}
+
+// DataExportResponse is the response of DataExport.
+type DataExportResponse struct {
+	ExportID string `json:"exportId"`
+}
+
+// LibraryItemModified is the `[id, mtime (ms)]` pair of datastoreMeta.
+type LibraryItemModified struct {
+	ID    string
+	Mtime time.Time
+}
+
+func (m *LibraryItemModified) UnmarshalJSON(data []byte) error {
+	var tuple []json.RawMessage
+	if err := json.Unmarshal(data, &tuple); err != nil {
+		return err
+	}
+	if len(tuple) != 2 {
+		return errors.New("invalid length, expected a tuple of size 2")
+	}
+	var id string
+	if err := json.Unmarshal(tuple[0], &id); err != nil {
+		return err
+	}
+	var millis int64
+	if err := json.Unmarshal(tuple[1], &millis); err != nil {
+		return err
+	}
+	*m = LibraryItemModified{ID: id, Mtime: time.UnixMilli(millis).UTC()}
+	return nil
+}
