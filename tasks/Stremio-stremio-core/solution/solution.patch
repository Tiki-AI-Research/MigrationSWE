+// ManifestCatalog is a catalog of the addon.
+type ManifestCatalog struct {
+	ID    string
+	Type  string
+	Name  *string
+	Extra ManifestExtra
+}
+
+func (c ManifestCatalog) MarshalJSON() ([]byte, error) {
+	head, err := MarshalJSON(struct {
+		ID   string  `json:"id"`
+		Type string  `json:"type"`
+		Name *string `json:"name"`
+	}{c.ID, c.Type, c.Name})
+	if err != nil {
+		return nil, err
+	}
+	extra, err := c.Extra.MarshalJSON()
+	if err != nil {
+		return nil, err
+	}
+	return mergeJSONObjects(head, extra), nil
+}
+
+func (c *ManifestCatalog) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		ID   *string `json:"id"`
+		Type *string `json:"type"`
+		Name *string `json:"name"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.ID == nil || wire.Type == nil {
+		return errors.New("missing field of ManifestCatalog")
+	}
+	var extra ManifestExtra
+	if err := extra.UnmarshalJSON(data); err != nil {
+		return err
+	}
+	*c = ManifestCatalog{ID: *wire.ID, Type: *wire.Type, Name: wire.Name, Extra: extra}
+	return nil
+}
+
+// mergeJSONObjects concatenates the keys of two serialized JSON objects.
+func mergeJSONObjects(a, b []byte) []byte {
+	a = trimJSONSpace(a)
+	b = trimJSONSpace(b)
+	if len(b) <= 2 {
+		return a
+	}
+	if len(a) <= 2 {
+		return b
+	}
+	merged := make([]byte, 0, len(a)+len(b))
+	merged = append(merged, a[:len(a)-1]...)
+	merged = append(merged, ',')
+	merged = append(merged, b[1:]...)
+	return merged
+}
+
+func trimJSONSpace(data []byte) []byte {
+	return []byte(strings.TrimSpace(string(data)))
+}
+
+// IsExtraSupported reports whether all values are supported and all the
+// required extra properties are present.
+func (c ManifestCatalog) IsExtraSupported(extra []ExtraValue) bool {
+	props := c.Extra.Props()
+	for _, value := range extra {
+		supported := false
+		for _, prop := range props {
+			if prop.Name == value.Name {
+				supported = true
+				break
+			}
+		}
+		if !supported {
+			return false
+		}
+	}
+	for _, prop := range props {
+		if !prop.IsRequired {
+			continue
+		}
+		present := false
+		for _, value := range extra {
+			if value.Name == prop.Name {
+				present = true
+				break
+			}
+		}
+		if !present {
+			return false
+		}
+	}
+	return true
+}
+
+// AreExtraNamesSupported is IsExtraSupported for extra names only.
+func (c ManifestCatalog) AreExtraNamesSupported(names []string) bool {
+	extra := make([]ExtraValue, 0, len(names))
+	for _, name := range names {
+		extra = append(extra, ExtraValue{Name: name})
+	}
+	return c.IsExtraSupported(extra)
+}
+
+// DefaultRequiredExtra returns the first option of every required extra
+// property, or nil if a required property has no options.
+func (c ManifestCatalog) DefaultRequiredExtra() ([]ExtraValue, bool) {
+	result := []ExtraValue{}
+	for _, prop := range c.Extra.Props() {
+		if !prop.IsRequired {
+			continue
+		}
+		if len(prop.Options) == 0 {
+			return nil, false
+		}
+		result = append(result, ExtraValue{Name: prop.Name, Value: prop.Options[0]})
+	}
+	return result, true
+}
+
+// ManifestExtra holds the extra properties of a catalog, in the full format
+// (`extra`) or the short one (`extraRequired`/`extraSupported`).
+type ManifestExtra struct {
+	Short     bool
+	Full      []ExtraProp
+	Required  []string
+	Supported []string
+}
+
+func (e ManifestExtra) MarshalJSON() ([]byte, error) {
+	if e.Short {
+		return MarshalJSON(struct {
+			Required  []string `json:"extraRequired"`
+			Supported []string `json:"extraSupported"`
+		}{nonNilSlice(e.Required), nonNilSlice(e.Supported)})
+	}
+	return MarshalJSON(struct {
+		Props []ExtraProp `json:"extra"`
+	}{nonNilSlice(e.Full)})
+}
+
+func (e *ManifestExtra) UnmarshalJSON(data []byte) error {
+	var full struct {
+		Props *[]ExtraProp `json:"extra"`
+	}
+	if err := json.Unmarshal(data, &full); err == nil && full.Props != nil {
+		props := []ExtraProp{}
+		seen := map[string]bool{}
+		for _, prop := range *full.Props {
+			if prop.Name == SKIP_EXTRA_PROP.Name {
+				prop = SKIP_EXTRA_PROP
+			}
+			if seen[prop.Name] {
+				continue
+			}
+			seen[prop.Name] = true
+			props = append(props, prop)
+		}
+		*e = ManifestExtra{Full: props}
+		return nil
+	}
+	var short struct {
+		Required  []string `json:"extraRequired"`
+		Supported []string `json:"extraSupported"`
+	}
+	if err := json.Unmarshal(data, &short); err != nil {
+		return errors.New("data did not match any variant of untagged enum ManifestExtra")
+	}
+	*e = ManifestExtra{Short: true, Required: uniqueStrings(short.Required), Supported: uniqueStrings(short.Supported)}
+	return nil
+}
+
+func uniqueStrings(values []string) []string {
+	result := []string{}
+	seen := map[string]bool{}
+	for _, value := range values {
+		if !seen[value] {
+			seen[value] = true
+			result = append(result, value)
+		}
+	}
+	return result
+}
+
+// Props returns the extra properties regardless of the format.
+func (e ManifestExtra) Props() []ExtraProp {
+	if !e.Short {
+		return e.Full
+	}
+	props := make([]ExtraProp, 0, len(e.Supported))
+	for _, name := range e.Supported {
+		props = append(props, ExtraProp{
+			Name:         name,
+			IsRequired:   containsString(e.Required, name),
+			Options:      []string{},
+			OptionsLimit: 1,
+		})
+	}
+	return props
+}
+
+// ExtraProp is an extra property supported by a catalog.
+type ExtraProp struct {
+	Name       string
+	IsRequired bool
+	Options    []string
+	// OptionsLimit is the maximum options that should be passed for this property.
+	OptionsLimit int
+}
+
+func (p ExtraProp) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(struct {
+		Name         string   `json:"name"`
+		IsRequired   bool     `json:"isRequired"`
+		Options      []string `json:"options"`
+		OptionsLimit int      `json:"optionsLimit"`
+	}{p.Name, p.IsRequired, nonNilSlice(p.Options), p.OptionsLimit})
+}
+
+func (p *ExtraProp) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Name         *string  `json:"name"`
+		IsRequired   bool     `json:"isRequired"`
+		Options      []string `json:"options"`
+		OptionsLimit *int     `json:"optionsLimit"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Name == nil {
+		return errors.New("missing field `name`")
+	}
+	*p = ExtraProp{Name: *wire.Name, IsRequired: wire.IsRequired, Options: nonNilSlice(wire.Options), OptionsLimit: 1}
+	if wire.OptionsLimit != nil {
+		if *wire.OptionsLimit < 0 {
+			return errors.New("invalid optionsLimit")
+		}
+		p.OptionsLimit = *wire.OptionsLimit
+	}
+	return nil
+}
