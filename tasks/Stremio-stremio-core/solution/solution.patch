@@ -0,0 +1,104 @@
+package ctx
+
+import (
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Payloads of the internal messages handled by the Ctx.
+
+// CtxAuthResponse is the successful result of an authentication: the auth
+// and the results of fetching the user's addons and library.
+type CtxAuthResponse struct {
+	Auth types.Auth
+	// Addons is the user's addons collection; AddonsErr is set if fetching it failed.
+	Addons    []types.Descriptor
+	AddonsErr *CtxError
+	// LibraryItems are the user's library items; LibraryItemsErr is set if fetching them failed.
+	LibraryItems    []types.LibraryItem
+	LibraryItemsErr *CtxError
+}
+
+// CtxAuthResult is the data of the `CtxAuthResult` internal message.
+type CtxAuthResult struct {
+	AuthRequest types.AuthRequest
+	Response    *CtxAuthResponse
+	Err         *CtxError
+}
+
+// AddonsAPIResult is the data of the `AddonsAPIResult` internal message.
+type AddonsAPIResult struct {
+	Request types.APIRequest
+	Addons  []types.Descriptor
+	Err     *CtxError
+}
+
+// UserAPIResult is the data of the `UserAPIResult` internal message.
+type UserAPIResult struct {
+	Request types.APIRequest
+	User    *types.User
+	Err     *CtxError
+	// Overwritten indicates that a token was used instead of the profile auth key.
+	Overwritten bool
+}
+
+// DeleteAccountAPIResult is the data of the `DeleteAccountAPIResult` internal message.
+type DeleteAccountAPIResult struct {
+	Request types.APIRequest
+	Err     *CtxError
+}
+
+// LibrarySyncPlanResult is the data of the `LibrarySyncPlanResult` internal
+// message: the ids to pull from and to push to the API.
+type LibrarySyncPlanResult struct {
+	Request types.DatastoreRequest
+	PullIDs []string
+	PushIDs []string
+	Err     *CtxError
+}
+
+// LibraryPullResult is the data of the `LibraryPullResult` internal message.
+type LibraryPullResult struct {
+	Request types.DatastoreRequest
+	Items   []types.LibraryItem
+	Err     *CtxError
+}
+
+// StreamLoaded is the data of the `StreamLoaded` internal message,
+// dispatched when a new stream is loaded into the Player.
+type StreamLoaded struct {
+	Stream        types.Stream
+	StreamRequest *types.ResourceRequest
+	MetaItem      common.ResourceLoadable[types.MetaItem]
+}
+
+// StreamStateChanged is the data of the `StreamStateChanged` internal message.
+type StreamStateChanged struct {
+	State         types.StreamItemState
+	StreamRequest *types.ResourceRequest
+	MetaRequest   *types.ResourceRequest
+}
+
+// GetModalResult is the data of the `GetModalResult` internal message.
+type GetModalResult struct {
+	Request  types.APIRequest
+	Response *types.GetModalResponse
+	Err      *CtxError
+}
+
+// GetNotificationResult is the data of the `GetNotificationResult` internal message.
+type GetNotificationResult struct {
+	Request  types.APIRequest
+	Response *types.GetNotificationResponse
+	Err      *CtxError
+}
+
+// Simple payloads:
+//   - Logout: bool (whether the session was already deleted server-side)
+//   - InstallAddon, UninstallAddon: types.Descriptor
+//   - UpdateLibraryItem: types.LibraryItem
+//   - LibraryChanged, StreamsChanged: bool (whether it's already persisted)
+//   - DismissNotificationItem: string (the meta item id)
+//   - CatalogsWithExtraSearch: string (the query)
+//   - ManifestRequestResult: common.ManifestRequestResult
+//   - ResourceRequestResult: msg.ResourceRequestResult
diff --git a/models/ctx/logout_test.go b/models/ctx/logout_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2cb0abe97659b7caf452996f86068c177b05a798
--- /dev/null
+++ b/models/ctx/logout_test.go
@@ -0,0 +1,127 @@
+package ctx_test
+
+import (
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of src/unit_tests/ctx/logout.rs
+
+const (
+	authLogoutURL  = "https://api.strem.io/api/logout"
+	authLogoutBody = `{"type":"Logout","authKey":"auth_key"}`
+)
+
+// authAssertLoggedOut checks the state, the storage and the events after
+// the `Logout(false)` internal message of a logged in user with an empty
+// library: the session is deleted and everything is reset.
+func authAssertLoggedOut(t *testing.T, h *harness, events []string) {
+	t.Helper()
+	env := h.env
+	assertEqual(t, h.ctx().Profile, types.NewProfile(), "profile updated successfully in memory")
+	assertEqual(t, h.ctx().Library, types.NewLibraryBucket(nil, nil), "library updated successfully in memory")
+	profile, ok := storageValue[types.Profile](t, env, stremiocore.PROFILE_STORAGE_KEY)
+	if !ok {
+		t.Errorf("profile updated successfully in storage: missing key")
+	}
+	assertEqual(t, profile, types.NewProfile(), "profile updated successfully in storage")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Errorf("recent library updated successfully in storage: missing key")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(nil, nil), "recent library updated successfully in storage")
+	library, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_STORAGE_KEY)
+	if !ok {
+		t.Errorf("library updated successfully in storage: missing key")
+	}
+	assertEqual(t, library, types.NewLibraryBucket(nil, nil), "library updated successfully in storage")
+
+	assertEqual(t, h.coreEventNames(), events, "events")
+	assertEvent(t, h.findEvent(msg.EventUserLoggedOut), msg.EventUserLoggedOut, `{"uid":"user_id"}`, "UserLoggedOut")
+	assertEvent(t, h.findEvent(msg.EventSessionDeleted), msg.EventSessionDeleted, `{"auth_key":"auth_key"}`, "SessionDeleted")
+	assertEvent(t, h.findEvent(msg.EventProfilePushedToStorage), msg.EventProfilePushedToStorage, `{"uid":null}`, "ProfilePushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage, `{"ids":[]}`, "LibraryItemsPushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventSearchHistoryPushedToStorage), msg.EventSearchHistoryPushedToStorage, `{"uid":null}`, "SearchHistoryPushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventDismissedEventsPushedToStorage), msg.EventDismissedEventsPushedToStorage, `{"uid":null}`, "DismissedEventsPushedToStorage")
+	// only the Logout internal message changes the ctx
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+func TestActionCtxLogout(t *testing.T) {
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env, fetchRoute{
+		Method:   "POST",
+		URL:      authLogoutURL,
+		Body:     authLogoutBody,
+		Response: apiSuccess,
+	})
+	profile := loggedInProfile(userFixture(env.Now()))
+	library := types.NewLibraryBucket(profile.UID(), nil)
+	setStorage(t, env, stremiocore.PROFILE_STORAGE_KEY, profile)
+	setStorage(t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY, types.NewLibraryBucket(profile.UID(), nil))
+	setStorage(t, env, stremiocore.LIBRARY_STORAGE_KEY, types.NewLibraryBucket(profile.UID(), nil))
+	h := newHarness(t, env, withProfileAndLibrary(env, profile, library))
+	h.dispatchCtx(msg.ActionCtxLogout, nil)
+
+	authAssertLoggedOut(t, h, []string{
+		msg.EventUserLoggedOut,
+		msg.EventSessionDeleted,
+		msg.EventProfilePushedToStorage,
+		msg.EventLibraryItemsPushedToStorage,
+		msg.EventSearchHistoryPushedToStorage,
+		msg.EventDismissedEventsPushedToStorage,
+	})
+	if len(env.Requests) != 1 {
+		t.Errorf("One request has been sent, got %d: %s", len(env.Requests), describeRequests(env.Requests))
+	}
+	assertRequests(t, env, fetchRoute{Method: "POST", URL: authLogoutURL, Body: authLogoutBody})
+}
+
+// There is no rust test for it: an expired session (API error code 1 on
+// `GetUser`) logs the user out (rust update_profile.rs
+// `Internal::UserAPIResult` => `Internal::Logout(false)`), which deletes the
+// session (ctx.rs `Internal::Logout`).
+func TestPullUserFromAPISessionExpired(t *testing.T) {
+	env := newTestEnv(time.Time{})
+	const getUserURL = "https://api.strem.io/api/getUser"
+	const getUserBody = `{"type":"GetUser","authKey":"auth_key"}`
+	setRoutes(t, env,
+		fetchRoute{
+			Method:   "POST",
+			URL:      getUserURL,
+			Body:     getUserBody,
+			Response: apiError(1, "Session does not exist"),
+		},
+		fetchRoute{
+			Method:   "POST",
+			URL:      authLogoutURL,
+			Body:     authLogoutBody,
+			Response: apiSuccess,
+		},
+	)
+	profile := loggedInProfile(userFixture(env.Now()))
+	setStorage(t, env, stremiocore.PROFILE_STORAGE_KEY, profile)
+	h := newHarness(t, env, withProfileAndLibrary(env, profile, types.NewLibraryBucket(profile.UID(), nil)))
+	h.dispatchCtx(msg.ActionCtxPullUserFromAPI, map[string]any{})
+
+	authAssertLoggedOut(t, h, []string{
+		msg.EventError,
+		msg.EventUserLoggedOut,
+		msg.EventSessionDeleted,
+		msg.EventProfilePushedToStorage,
+		msg.EventLibraryItemsPushedToStorage,
+		msg.EventSearchHistoryPushedToStorage,
+		msg.EventDismissedEventsPushedToStorage,
+	})
+	assertEvent(t, h.findEvent(msg.EventError), msg.EventError,
+		`{"error":{"type":"API","message":"Session does not exist","code":1},"source":{"event":"UserPulledFromAPI","args":{"uid":"user_id"}}}`,
+		"Error")
+	assertRequests(t, env,
+		fetchRoute{Method: "POST", URL: getUserURL, Body: getUserBody},
+		fetchRoute{Method: "POST", URL: authLogoutURL, Body: authLogoutBody},
+	)
+}
diff --git a/models/ctx/mark_meta_item_as_watched_test.go b/models/ctx/mark_meta_item_as_watched_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1fd683c03d04fc7f80c89bbb455b04958add8d04
--- /dev/null
+++ b/models/ctx/mark_meta_item_as_watched_test.go
@@ -0,0 +1,187 @@
+package ctx_test
+
+import (
+	"testing"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of src/unit_tests/ctx/mark_meta_item_as_watched.rs
+
+// libMetaPreview is the meta item of the MetaItemMarkAsWatched tests.
+func libMetaPreview() types.MetaItemPreview {
+	return types.MetaItemPreview{
+		ID:          "tt123",
+		Type:        "movie",
+		Name:        "Test Movie",
+		PosterShape: types.PosterShapePoster,
+	}
+}
+
+// libMetaItemMarkAsWatchedArgs are the args of
+// `ActionCtx::MetaItemMarkAsWatched { meta_item, is_watched }`.
+type libMetaItemMarkAsWatchedArgs struct {
+	MetaItem  types.MetaItemPreview `json:"meta_item"`
+	IsWatched bool                  `json:"is_watched"`
+}
+
+// libMarkAsWatchedHarness is rust `test_runtime(library)`: a logged out Ctx
+// with the given library.
+func libMarkAsWatchedHarness(t *testing.T, env *testenv.Env, library types.LibraryBucket) *harness {
+	t.Helper()
+	setRoutes(t, env)
+	return newHarness(t, env, withProfileAndLibrary(env, types.NewProfile(), library))
+}
+
+// libExistingMovie is the library item of the meta item, watched timesWatched times.
+func libExistingMovie(timesWatched uint32) types.LibraryItem {
+	return types.LibraryItem{
+		ID:          "tt123",
+		Name:        "Test Movie",
+		Type:        "movie",
+		PosterShape: types.PosterShapePoster,
+		Ctime:       timePtr(date(2020, 1, 1)),
+		Mtime:       date(2020, 1, 1),
+		State: types.LibraryItemState{
+			TimesWatched: timesWatched,
+			LastWatched:  timePtr(date(2020, 1, 1)),
+		},
+	}
+}
+
+func TestMetaItemMarkAsWatchedMissingItemCreatesTemp(t *testing.T) {
+	now := date(2020, 1, 1)
+	env := newTestEnv(now)
+	h := libMarkAsWatchedHarness(t, env, types.NewLibraryBucket(nil, nil))
+	if len(h.ctx().Library.Items) != 0 {
+		t.Fatalf("Library starts empty")
+	}
+	h.dispatchCtx(msg.ActionCtxMetaItemMarkAsWatched, libMetaItemMarkAsWatchedArgs{MetaItem: libMetaPreview(), IsWatched: true})
+
+	library := h.ctx().Library
+	if len(library.Items) != 1 {
+		t.Fatalf("One item created, got %d", len(library.Items))
+	}
+	item, ok := library.Items["tt123"]
+	if !ok {
+		t.Fatalf("Item exists")
+	}
+	if item.State.TimesWatched != 1 {
+		t.Errorf("times_watched is 1, got %d", item.State.TimesWatched)
+	}
+	if item.State.LastWatched == nil {
+		t.Errorf("last_watched is set")
+	}
+	if !item.Temp {
+		t.Errorf("Item is temporary")
+	}
+	if !item.Removed {
+		t.Errorf("Item is marked as removed")
+	}
+	// the whole item (rust `LibraryItem::from((meta_item, PhantomData))` then `mark_as_watched(true)`)
+	expected := types.LibraryItem{
+		ID:          "tt123",
+		Name:        "Test Movie",
+		Type:        "movie",
+		PosterShape: types.PosterShapePoster,
+		Removed:     true,
+		Temp:        true,
+		Ctime:       timePtr(now),
+		Mtime:       now,
+		State: types.LibraryItemState{
+			LastWatched:  timePtr(now),
+			TimesWatched: 1,
+		},
+	}
+	assertEqual(t, item, expected, "created item")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Library recent slot updated in storage")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(nil, []types.LibraryItem{expected}), "Library recent slot updated in storage")
+	if _, ok := env.Storage[stremiocore.LIBRARY_STORAGE_KEY]; ok {
+		t.Errorf("Library slot not in storage")
+	}
+	// logged out: no push to the API
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+	assertEqual(t, h.coreEventNames(), []string{msg.EventLibraryItemsPushedToStorage}, "events")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage, `{"ids":["tt123"]}`, "LibraryItemsPushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+func TestMetaItemMarkAsWatchedExistingItemIncrements(t *testing.T) {
+	now := date(2020, 1, 1)
+	env := newTestEnv(now)
+	h := libMarkAsWatchedHarness(t, env, types.NewLibraryBucket(nil, []types.LibraryItem{libExistingMovie(2)}))
+	h.dispatchCtx(msg.ActionCtxMetaItemMarkAsWatched, libMetaItemMarkAsWatchedArgs{MetaItem: libMetaPreview(), IsWatched: true})
+
+	item, ok := h.ctx().Library.Items["tt123"]
+	if !ok {
+		t.Fatalf("Item exists")
+	}
+	if item.State.TimesWatched != 3 {
+		t.Errorf("times_watched incremented to 3, got %d", item.State.TimesWatched)
+	}
+	if item.Temp {
+		t.Errorf("Item remains non-temp")
+	}
+	if item.Removed {
+		t.Errorf("Item remains non-removed")
+	}
+	expected := libExistingMovie(3)
+	assertEqual(t, item, expected, "updated item")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Library recent slot updated in storage")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(nil, []types.LibraryItem{expected}), "Library recent slot updated in storage")
+	assertEqual(t, h.coreEventNames(), []string{msg.EventLibraryItemsPushedToStorage}, "events")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+func TestMetaItemUnwatchMissingItemIsNoop(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 1))
+	h := libMarkAsWatchedHarness(t, env, types.NewLibraryBucket(nil, nil))
+	h.dispatchCtx(msg.ActionCtxMetaItemMarkAsWatched, libMetaItemMarkAsWatchedArgs{MetaItem: libMetaPreview(), IsWatched: false})
+
+	if len(h.ctx().Library.Items) != 0 {
+		t.Errorf("No ghost item created for unwatch on missing item: %d items", len(h.ctx().Library.Items))
+	}
+	if _, ok := env.Storage[stremiocore.LIBRARY_RECENT_STORAGE_KEY]; ok {
+		t.Errorf("Nothing persisted to storage")
+	}
+	if _, ok := env.Storage[stremiocore.LIBRARY_STORAGE_KEY]; ok {
+		t.Errorf("Nothing persisted to storage (library)")
+	}
+	assertEqual(t, h.coreEventNames(), []string{}, "events")
+	assertEqual(t, h.newStates(), [][]string{}, "NewState")
+}
+
+func TestMetaItemUnwatchExistingItemResets(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 1))
+	h := libMarkAsWatchedHarness(t, env, types.NewLibraryBucket(nil, []types.LibraryItem{libExistingMovie(5)}))
+	h.dispatchCtx(msg.ActionCtxMetaItemMarkAsWatched, libMetaItemMarkAsWatchedArgs{MetaItem: libMetaPreview(), IsWatched: false})
+
+	item, ok := h.ctx().Library.Items["tt123"]
+	if !ok {
+		t.Fatalf("Item still exists")
+	}
+	if item.State.TimesWatched != 0 {
+		t.Errorf("times_watched reset to 0, got %d", item.State.TimesWatched)
+	}
+	// unwatching keeps last_watched
+	expected := libExistingMovie(0)
+	assertEqual(t, item, expected, "updated item")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Library recent slot updated in storage")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(nil, []types.LibraryItem{expected}), "Library recent slot updated in storage")
+	assertEqual(t, h.coreEventNames(), []string{msg.EventLibraryItemsPushedToStorage}, "events")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
