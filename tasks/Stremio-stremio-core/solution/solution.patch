+
+// Port of src/unit_tests/ctx/remove_from_library.rs
+
+// libItemFixture is the library item of the remove/rewind tests (rust
+// `LibraryItem { id: "id", name: "name", type: "type", ctime: 2020-01-01, mtime: 2020-01-01, .. }`).
+func libItemFixture(state types.LibraryItemState) types.LibraryItem {
+	return types.LibraryItem{
+		ID:          "id",
+		Name:        "name",
+		Type:        "type",
+		PosterShape: types.PosterShapePoster,
+		Ctime:       timePtr(date(2020, 1, 1)),
+		Mtime:       date(2020, 1, 1),
+		State:       state,
+	}
+}
+
+func TestActionCtxRemoveFromLibrary(t *testing.T) {
+	env := newTestEnv(date(2020, 1, 2))
+	setRoutes(t, env, fetchRoute{
+		Method:   "POST",
+		URL:      "https://api.strem.io/api/datastorePut",
+		Body:     `{"authKey":"auth_key","collection":"libraryItem","changes":[{"_id":"id","name":"name","type":"type","poster":null,"posterShape":"poster","removed":true,"temp":false,"_ctime":"2020-01-01T00:00:00Z","_mtime":"2020-01-02T00:00:00Z","state":{"lastWatched":null,"timeWatched":0,"timeOffset":0,"overallTimeWatched":0,"timesWatched":0,"flaggedWatched":0,"duration":0,"video_id":null,"watched":null,"noNotif":false},"behaviorHints":{"defaultVideoId":null,"featuredVideoId":null,"hasScheduledVideos":false}}]}`,
+		Response: apiSuccess,
+	})
+	libraryItem := libItemFixture(types.LibraryItemState{})
+	libraryItemRemoved := libraryItem
+	libraryItemRemoved.Removed = true
+	libraryItemRemoved.Mtime = date(2020, 1, 2)
+	setStorage(t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY, types.NewLibraryBucket(uid("id"), []types.LibraryItem{libraryItem}))
+	h := newHarness(t, env, withProfileAndLibrary(env,
+		loggedInProfile(userFixture(env.Now())),
+		types.NewLibraryBucket(uid("id"), []types.LibraryItem{libraryItem}),
+	))
+	h.dispatchCtx(msg.ActionCtxRemoveFromLibrary, libraryItem.ID)
+
+	item, ok := h.ctx().Library.Items[libraryItem.ID]
+	if !ok {
+		t.Fatalf("Library updated successfully in memory: item missing")
+	}
+	assertEqual(t, item, libraryItemRemoved, "Library updated successfully in memory")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Library recent slot updated successfully in storage")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(uid("id"), []types.LibraryItem{libraryItemRemoved}), "Library recent slot updated successfully in storage")
+	if _, ok := env.Storage[stremiocore.LIBRARY_STORAGE_KEY]; ok {
+		t.Errorf("Library slot updated successfully in storage")
+	}
+	if len(env.Requests) != 1 {
+		t.Fatalf("One request has been sent, got %d: %s", len(env.Requests), describeRequests(env.Requests))
+	}
+	if env.Requests[0].URL != "https://api.strem.io/api/datastorePut" {
+		t.Errorf("datastorePut request has been sent")
+	}
+	// the events: UpdateLibraryItem and DismissNotificationItem (no
+	// notification for the item) are handled before LibraryItemRemoved,
+	// then the futures run: push to API, push to storage
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventLibraryItemRemoved,
+		msg.EventLibraryItemsPushedToAPI,
+		msg.EventLibraryItemsPushedToStorage,
+	}, "events")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemRemoved), msg.EventLibraryItemRemoved, `{"id":"id"}`, "LibraryItemRemoved")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToAPI), msg.EventLibraryItemsPushedToAPI, `{"ids":["id"]}`, "LibraryItemsPushedToAPI")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage, `{"ids":["id"]}`, "LibraryItemsPushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+func TestActionCtxRemoveFromLibraryNotAdded(t *testing.T) {
+	// rust `TestEnv::reset()` sets `NOW` to the current time
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env)
+	libraryItem := libItemFixture(types.LibraryItemState{})
+	setStorage(t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY, types.NewLibraryBucket(nil, []types.LibraryItem{libraryItem}))
+	h := newHarness(t, env, withProfileAndLibrary(env,
+		types.NewProfile(),
+		types.NewLibraryBucket(nil, []types.LibraryItem{libraryItem}),
+	))
+	h.dispatchCtx(msg.ActionCtxRemoveFromLibrary, "id2")
+
+	item, ok := h.ctx().Library.Items[libraryItem.ID]
+	if !ok {
+		t.Fatalf("Library not updated in memory: item missing")
+	}
+	assertEqual(t, item, libraryItem, "Library not updated in memory")
+	if len(h.ctx().Library.Items) != 1 {
+		t.Errorf("Library not updated in memory: %d items", len(h.ctx().Library.Items))
+	}
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Library recent slot not updated in storage: missing")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(nil, []types.LibraryItem{libraryItem}), "Library recent slot not updated in storage")
+	if _, ok := env.Storage[stremiocore.LIBRARY_STORAGE_KEY]; ok {
+		t.Errorf("Library slot not updated in storage")
+	}
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+	assertEqual(t, h.coreEventNames(), []string{msg.EventError}, "events")
+	assertEvent(t, h.findEvent(msg.EventError), msg.EventError,
+		`{"error":{"type":"Other","code":2,"message":"Item is not found in library"},"source":{"event":"LibraryItemRemoved","args":{"id":"id2"}}}`,
+		"Error LibraryItemNotFound")
+	assertEqual(t, h.newStates(), [][]string{}, "NewState")
+}
