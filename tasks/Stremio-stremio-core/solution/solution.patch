+package types
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+// StreamingServerSettings are the settings of the streaming server.
+type StreamingServerSettings struct {
+	AppPath       string
+	CacheRoot     string
+	ServerVersion string
+	// RemoteHTTPS (de)serializes `nil` as an empty string.
+	RemoteHTTPS *string
+	// TranscodeProfile defaults to `nil` for anything but a string.
+	TranscodeProfile         *string
+	CacheSize                *float64
+	ProxyStreamsEnabled      bool
+	BtMaxConnections         uint64
+	BtHandshakeTimeout       uint64
+	BtRequestTimeout         uint64
+	BtDownloadSpeedSoftLimit float64
+	BtDownloadSpeedHardLimit float64
+	BtMinPeersForStable      uint64
+}
+
+func float64Ptr(value *float64) *Float64 {
+	if value == nil {
+		return nil
+	}
+	converted := Float64(*value)
+	return &converted
+}
+
+func emptyStringAsNull(value *string) string {
+	if value == nil {
+		return ""
+	}
+	return *value
+}
+
+func nullAsEmptyString(value *string) *string {
+	if value == nil || *value == "" {
+		return nil
+	}
+	return value
+}
+
+func (s StreamingServerSettings) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(struct {
+		AppPath                  string   `json:"appPath"`
+		CacheRoot                string   `json:"cacheRoot"`
+		ServerVersion            string   `json:"serverVersion"`
+		RemoteHTTPS              string   `json:"remoteHttps"`
+		TranscodeProfile         *string  `json:"transcodeProfile"`
+		CacheSize                *Float64 `json:"cacheSize"`
+		ProxyStreamsEnabled      bool     `json:"proxyStreamsEnabled"`
+		BtMaxConnections         uint64   `json:"btMaxConnections"`
+		BtHandshakeTimeout       uint64   `json:"btHandshakeTimeout"`
+		BtRequestTimeout         uint64   `json:"btRequestTimeout"`
+		BtDownloadSpeedSoftLimit Float64  `json:"btDownloadSpeedSoftLimit"`
+		BtDownloadSpeedHardLimit Float64  `json:"btDownloadSpeedHardLimit"`
+		BtMinPeersForStable      uint64   `json:"btMinPeersForStable"`
+	}{s.AppPath, s.CacheRoot, s.ServerVersion, emptyStringAsNull(s.RemoteHTTPS), s.TranscodeProfile,
+		float64Ptr(s.CacheSize), s.ProxyStreamsEnabled, s.BtMaxConnections, s.BtHandshakeTimeout,
+		s.BtRequestTimeout, Float64(s.BtDownloadSpeedSoftLimit), Float64(s.BtDownloadSpeedHardLimit),
+		s.BtMinPeersForStable})
+}
+
+func (s *StreamingServerSettings) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		AppPath                  *string         `json:"appPath"`
+		CacheRoot                *string         `json:"cacheRoot"`
+		ServerVersion            *string         `json:"serverVersion"`
+		RemoteHTTPS              *string         `json:"remoteHttps"`
+		TranscodeProfile         json.RawMessage `json:"transcodeProfile"`
+		CacheSize                *float64        `json:"cacheSize"`
+		ProxyStreamsEnabled      bool            `json:"proxyStreamsEnabled"`
+		BtMaxConnections         *uint64         `json:"btMaxConnections"`
+		BtHandshakeTimeout       *uint64         `json:"btHandshakeTimeout"`
+		BtRequestTimeout         *uint64         `json:"btRequestTimeout"`
+		BtDownloadSpeedSoftLimit *float64        `json:"btDownloadSpeedSoftLimit"`
+		BtDownloadSpeedHardLimit *float64        `json:"btDownloadSpeedHardLimit"`
+		BtMinPeersForStable      *uint64         `json:"btMinPeersForStable"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.AppPath == nil || wire.CacheRoot == nil || wire.ServerVersion == nil || wire.BtMaxConnections == nil ||
+		wire.BtHandshakeTimeout == nil || wire.BtRequestTimeout == nil || wire.BtDownloadSpeedSoftLimit == nil ||
+		wire.BtDownloadSpeedHardLimit == nil || wire.BtMinPeersForStable == nil {
+		return errors.New("missing field of streaming server Settings")
+	}
+	var transcodeProfile *string
+	if !isJSONNull(wire.TranscodeProfile) {
+		var profile string
+		if json.Unmarshal(wire.TranscodeProfile, &profile) == nil {
+			transcodeProfile = &profile
+		}
+	}
+	*s = StreamingServerSettings{
+		AppPath:                  *wire.AppPath,
+		CacheRoot:                *wire.CacheRoot,
+		ServerVersion:            *wire.ServerVersion,
+		RemoteHTTPS:              nullAsEmptyString(wire.RemoteHTTPS),
+		TranscodeProfile:         transcodeProfile,
+		CacheSize:                wire.CacheSize,
+		ProxyStreamsEnabled:      wire.ProxyStreamsEnabled,
+		BtMaxConnections:         *wire.BtMaxConnections,
+		BtHandshakeTimeout:       *wire.BtHandshakeTimeout,
+		BtRequestTimeout:         *wire.BtRequestTimeout,
+		BtDownloadSpeedSoftLimit: *wire.BtDownloadSpeedSoftLimit,
+		BtDownloadSpeedHardLimit: *wire.BtDownloadSpeedHardLimit,
+		BtMinPeersForStable:      *wire.BtMinPeersForStable,
+	}
+	return nil
+}
+
+// StreamingServerSettingsBody is the body of the update settings request.
+func (s StreamingServerSettings) UpdateBody() ([]byte, error) {
+	return MarshalJSON(struct {
+		CacheSize                *Float64 `json:"cacheSize"`
+		CacheRoot                string   `json:"cacheRoot"`
+		BtMaxConnections         uint64   `json:"btMaxConnections"`
+		BtHandshakeTimeout       uint64   `json:"btHandshakeTimeout"`
+		BtRequestTimeout         uint64   `json:"btRequestTimeout"`
+		BtDownloadSpeedSoftLimit Float64  `json:"btDownloadSpeedSoftLimit"`
+		BtDownloadSpeedHardLimit Float64  `json:"btDownloadSpeedHardLimit"`
+		BtMinPeersForStable      uint64   `json:"btMinPeersForStable"`
+		RemoteHTTPS              string   `json:"remoteHttps"`
+		ProxyStreamsEnabled      bool     `json:"proxyStreamsEnabled"`
+		TranscodeProfile         *string  `json:"transcodeProfile"`
+	}{float64Ptr(s.CacheSize), s.CacheRoot, s.BtMaxConnections, s.BtHandshakeTimeout, s.BtRequestTimeout,
+		Float64(s.BtDownloadSpeedSoftLimit), Float64(s.BtDownloadSpeedHardLimit), s.BtMinPeersForStable,
+		emptyStringAsNull(s.RemoteHTTPS), s.ProxyStreamsEnabled, s.TranscodeProfile})
+}
+
+// SettingsOptionValue is the value of a settings option selection: a
+// string, a number or `null`.
+type SettingsOptionValue struct {
+	String *string
+	Number *float64
+}
+
+func (v SettingsOptionValue) MarshalJSON() ([]byte, error) {
+	switch {
+	case v.String != nil:
+		return MarshalJSON(*v.String)
+	case v.Number != nil:
+		return Float64(*v.Number).MarshalJSON()
+	}
+	return []byte("null"), nil
+}
+
+func (v *SettingsOptionValue) UnmarshalJSON(data []byte) error {
+	*v = SettingsOptionValue{}
+	if isJSONNull(data) {
+		return nil
+	}
+	var text string
+	if err := json.Unmarshal(data, &text); err == nil {
+		v.String = &text
+		return nil
+	}
+	var number float64
+	if err := json.Unmarshal(data, &number); err != nil {
+		return errors.New("data did not match any variant of untagged enum SettingsOptionValue")
+	}
+	v.Number = &number
+	return nil
+}
+
+// SettingsOptionSelection is a selection of a settings option.
+type SettingsOptionSelection struct {
+	Name string              `json:"name"`
+	Val  SettingsOptionValue `json:"val"`
+}
+
+// SettingsOption is a settings option of the streaming server.
+type SettingsOption struct {
+	ID         string                    `json:"id"`
+	Label      string                    `json:"label"`
+	Selections []SettingsOptionSelection `json:"selections,omitempty"`
+}
+
+// SettingsResponse is the response of the streaming server settings endpoint.
+type SettingsResponse struct {
+	BaseURL string                  `json:"baseUrl"`
+	Values  StreamingServerSettings `json:"values"`
+	Options []SettingsOption        `json:"options"`
+}
+
+func (r *SettingsResponse) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		BaseURL *string                  `json:"baseUrl"`
+		Values  *StreamingServerSettings `json:"values"`
+		Options []SettingsOption         `json:"options"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.BaseURL == nil || wire.Values == nil {
+		return errors.New("missing field of SettingsResponse")
+	}
+	if !IsValidURL(*wire.BaseURL) {
+		return fmt.Errorf("invalid baseUrl: %s", *wire.BaseURL)
+	}
+	*r = SettingsResponse{BaseURL: NormalizeURL(*wire.BaseURL), Values: *wire.Values, Options: nonNilSlice(wire.Options)}
+	return nil
+}
+
+// GetHTTPSResponse is the response of the streaming server https endpoint.
+type GetHTTPSResponse struct {
+	IPAddress string `json:"ipAddress"`
+	Domain    string `json:"domain"`
+	Port      uint16 `json:"port"`
+}
+
+// NetworkInfo is the network info of the streaming server.
+type NetworkInfo struct {
+	AvailableInterfaces []string `json:"availableInterfaces"`
+}
+
+func (n *NetworkInfo) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		AvailableInterfaces *[]string `json:"availableInterfaces"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.AvailableInterfaces == nil {
+		return errors.New("missing field `availableInterfaces`")
+	}
+	n.AvailableInterfaces = nonNilSlice(*wire.AvailableInterfaces)
+	return nil
+}
+
+// DeviceInfo is the device info of the streaming server.
+type DeviceInfo struct {
+	AvailableHardwareAccelerations []string `json:"availableHardwareAccelerations"`
+}
+
+func (d *DeviceInfo) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		AvailableHardwareAccelerations json.RawMessage `json:"availableHardwareAccelerations"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	d.AvailableHardwareAccelerations = []string{}
+	var accelerations []string
+	if json.Unmarshal(wire.AvailableHardwareAccelerations, &accelerations) == nil {
+		d.AvailableHardwareAccelerations = nonNilSlice(accelerations)
+	}
+	return nil
+}
+
+// StatisticsRequest requests the statistics of a torrent file.
+type StatisticsRequest struct {
+	InfoHash string `json:"infoHash"`
+	FileIdx  uint16 `json:"fileIdx"`
+}
+
+// TorrentStatisticsURL returns the statistics endpoint for the request.
+func TorrentStatisticsURL(serverURL string, request StatisticsRequest) (string, error) {
+	return URLJoin(serverURL, fmt.Sprintf("%s/%s/stats.json",
+		FormURLEncode(request.InfoHash), FormURLEncode(strconv.Itoa(int(request.FileIdx)))))
+}
+
+// TorrentFile is a file of a torrent.
+type TorrentFile struct {
+	Name   string `json:"name"`
+	Path   string `json:"path"`
+	Length uint64 `json:"length"`
+	Offset uint64 `json:"offset"`
+}
+
+// Growler are the growler options of a torrent.
+type Growler struct {
+	Flood uint64  `json:"flood"`
+	Pulse *uint64 `json:"pulse"`
+}
+
+// PeerSearch are the peer search options of a torrent.
+type PeerSearch struct {
+	Max     uint64   `json:"max"`
+	Min     uint64   `json:"min"`
+	Sources []string `json:"sources"`
+}
+
+// NewPeerSearch creates the peer search with the DHT source of the info hash
+// followed by the additional sources.
+func NewPeerSearch(min, max uint64, infoHash InfoHash, additionalSources []string) PeerSearch {
+	sources := append([]string{"dht:" + infoHash.String()}, additionalSources...)
+	return PeerSearch{Max: max, Min: min, Sources: sources}
+}
+
+// SwarmCap is the swarm cap of a torrent.
+type SwarmCap struct {
+	MaxSpeed *Float64 `json:"maxSpeed"`
+	MinPeers *uint64  `json:"minPeers"`
+}
+
+// TorrentOptions are the options of a torrent.
+type TorrentOptions struct {
+	Connections      *uint64    `json:"connections"`
+	Dht              bool       `json:"dht"`
+	Growler          Growler    `json:"growler"`
+	HandshakeTimeout *uint64    `json:"handshakeTimeout"`
+	Path             string     `json:"path"`
+	PeerSearch       PeerSearch `json:"peerSearch"`
+	SwarmCap         SwarmCap   `json:"swarmCap"`
+	Timeout          *uint64    `json:"timeout"`
+	Tracker          bool       `json:"tracker"`
+	Virtual          bool       `json:"virtual"`
+}
+
+// TorrentSource is a peer source of a torrent.
+type TorrentSource struct {
+	LastStarted  string `json:"lastStarted"`
+	NumFound     uint64 `json:"numFound"`
+	NumFoundUniq uint64 `json:"numFoundUniq"`
+	NumRequests  uint64 `json:"numRequests"`
+	URL          string `json:"url"`
+}
+
+// Statistics are the statistics of a torrent.
+type Statistics struct {
+	Name              string          `json:"name"`
+	InfoHash          string          `json:"infoHash"`
+	Files             []TorrentFile   `json:"files"`
+	Sources           []TorrentSource `json:"sources"`
+	Opts              TorrentOptions  `json:"opts"`
+	DownloadSpeed     Float64         `json:"downloadSpeed"`
+	UploadSpeed       Float64         `json:"uploadSpeed"`
+	Downloaded        uint64          `json:"downloaded"`
+	Uploaded          uint64          `json:"uploaded"`
+	Unchoked          uint64          `json:"unchoked"`
+	Peers             uint64          `json:"peers"`
+	Queued            uint64          `json:"queued"`
+	Unique            uint64          `json:"unique"`
+	ConnectionTries   uint64          `json:"connectionTries"`
+	PeerSearchRunning bool            `json:"peerSearchRunning"`
+	StreamLen         uint64          `json:"streamLen"`
+	StreamName        string          `json:"streamName"`
+	StreamProgress    Float64         `json:"streamProgress"`
+	SwarmConnections  uint64          `json:"swarmConnections"`
+	SwarmPaused       bool            `json:"swarmPaused"`
+	SwarmSize         uint64          `json:"swarmSize"`
+}
+
+// CreateMagnetURL returns the endpoint creating a torrent from a magnet.
+func CreateMagnetURL(serverURL string, infoHash InfoHash) (string, error) {
+	return URLJoin(serverURL, infoHash.String()+"/create")
+}
+
+// CreateMagnetBody returns the body creating a torrent from a magnet with the trackers.
+func CreateMagnetBody(infoHash InfoHash, announce []string) ([]byte, error) {
+	var peerSearch *PeerSearch
+	if len(announce) > 0 {
+		search := NewPeerSearch(40, 200, infoHash, normalizePeerSearchSources(announce))
+		peerSearch = &search
+	}
+	return MarshalJSON(struct {
+		PeerSearch *PeerSearch `json:"peerSearch,omitempty"`
+	}{peerSearch})
+}
+
+func normalizePeerSearchSources(sources []string) []string {
+	normalized := make([]string, 0, len(sources))
+	for _, source := range sources {
+		decoded, err := url.PathUnescape(source)
+		if err != nil {
+			decoded = source
+		}
+		if strings.HasPrefix(decoded, "dht:") || strings.HasPrefix(decoded, "tracker:") {
+			normalized = append(normalized, decoded)
+		} else {
+			normalized = append(normalized, "tracker:"+decoded)
+		}
+	}
+	return normalized
+}
+
+// CreateTorrentBlobURL returns the endpoint creating a torrent from a file.
+func CreateTorrentBlobURL(serverURL string) (string, error) {
+	return URLJoin(serverURL, "/create")
+}
+
+// CreateTorrentBlobBody returns the body creating a torrent from a file.
+func CreateTorrentBlobBody(torrent []byte) ([]byte, error) {
+	return MarshalJSON(struct {
+		Blob string `json:"blob"`
+	}{hex.EncodeToString(torrent)})
+}
+
+// CreatedTorrent is the response of the torrent creation.
+type CreatedTorrent struct {
+	Torrent struct {
+		InfoHash InfoHash `json:"infoHash"`
+	} `json:"torrent"`
+	PeerSearch   PeerSearch  `json:"peerSearch"`
+	GuessFileIdx *SeriesInfo `json:"guessFileIdx"`
+}
+
+// ArchiveCreateResponse is the response of an archive creation.
+type ArchiveCreateResponse struct {
+	Key *string `json:"key"`
+}
+
+// OpensubtitlesParamsResponse is the opensubtitles hash and size of a video.
+type OpensubtitlesParamsResponse struct {
+	Hash InfoHash `json:"hash"`
+	Size uint64   `json:"size"`
+}
+
+// PlaybackDevice is a casting device of the streaming server.
+type PlaybackDevice struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	// Type is e.g. `external`.
+	Type string `json:"type"`
+}
+
+func (d *PlaybackDevice) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		ID   *string `json:"id"`
+		Name *string `json:"name"`
+		Type *string `json:"type"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.ID == nil || wire.Name == nil || wire.Type == nil {
+		return errors.New("missing field of PlaybackDevice")
+	}
+	*d = PlaybackDevice{ID: *wire.ID, Name: *wire.Name, Type: *wire.Type}
+	return nil
+}
