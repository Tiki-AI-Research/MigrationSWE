+func marshalTimeBucket(uid UID, items map[string]time.Time, local bool) ([]byte, error) {
+	if local {
+		wire := map[string]LocalTime{}
+		for key, value := range items {
+			wire[key] = LocalTime(value)
+		}
+		return MarshalJSON(struct {
+			UID   UID                  `json:"uid"`
+			Items map[string]LocalTime `json:"items"`
+		}{uid, wire})
+	}
+	wire := map[string]Time{}
+	for key, value := range items {
+		wire[key] = Time(value)
+	}
+	return MarshalJSON(struct {
+		UID   UID             `json:"uid"`
+		Items map[string]Time `json:"items"`
+	}{uid, wire})
+}
+
+func unmarshalTimeBucket(data []byte, local bool) (UID, map[string]time.Time, error) {
+	var wire struct {
+		UID   UID                        `json:"uid"`
+		Items map[string]json.RawMessage `json:"items"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return nil, nil, err
+	}
+	items := map[string]time.Time{}
+	for key, raw := range wire.Items {
+		if local {
+			var value LocalTime
+			if err := json.Unmarshal(raw, &value); err != nil {
+				return nil, nil, err
+			}
+			items[key] = time.Time(value)
+		} else {
+			var value Time
+			if err := json.Unmarshal(raw, &value); err != nil {
+				return nil, nil, err
+			}
+			items[key] = time.Time(value)
+		}
+	}
+	return wire.UID, items, nil
+}
