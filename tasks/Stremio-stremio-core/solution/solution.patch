+func TestStreamingServerReferenceScenarios(t *testing.T) {
+	var scenarios []ssScenario
+	ssReadJSON(t, "testdata/streaming_server_scenarios.json", &scenarios)
+	var references []ssReference
+	ssReadJSON(t, "testdata/streaming_server_reference.json", &references)
+	if len(scenarios) != len(references) {
+		t.Fatalf("%d scenarios, %d references", len(scenarios), len(references))
+	}
+	for index, scenario := range scenarios {
+		reference := references[index]
+		t.Run(scenario.Name, func(t *testing.T) {
+			env := testenv.New()
+			driver := &ssDriver{t: t, env: env, responses: scenario.Responses}
+			env.FetchFn = driver.fetch
+			profile := ssTestProfile(scenario.AuthKey, scenario.StreamingServerURL)
+			driver.ctx = ctx.NewDefault(env)
+			driver.ctx.Profile = profile
+			server, effects := models.NewStreamingServer(env, &profile)
+			driver.server = server
+			driver.handleEffects(effects)
+			driver.runQueue()
+			ssCompareSnapshot(t, "initial", driver.snapshot(effects.HasChanged), reference.Initial)
+			for i, step := range scenario.Steps {
+				name := fmt.Sprintf("step %d", i)
+				switch {
+				case step.Responses != nil:
+					driver.responses = step.Responses
+					continue
+				case step.ProfileChanged != nil:
+					driver.ctx.Profile.Settings.StreamingServerURL = *step.ProfileChanged
+					changed := driver.dispatch(msg.InternalMsg(msg.NewInternal(msg.InternalProfileChanged, nil)))
+					ssCompareSnapshot(t, name, driver.snapshot(changed), reference.Steps[i])
+				default:
+					var action msg.Action
+					if err := json.Unmarshal(step.Action, &action); err != nil {
+						t.Fatalf("%s: decode action: %v", name, err)
+					}
+					changed := driver.dispatch(msg.ActionMsg(&action))
+					ssCompareSnapshot(t, name, driver.snapshot(changed), reference.Steps[i])
+				}
+			}
+		})
+	}
+}
