+package types
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+)
+
+//
+// Profile
+//
+
+// AuthKey is the API authentication key of the user.
+type AuthKey string
+
+// Password is a user password.
+type Password string
+
+// GDPRConsent is the GDPR consent of the user.
+type GDPRConsent struct {
+	Tos       bool    `json:"tos"`
+	Privacy   bool    `json:"privacy"`
+	Marketing bool    `json:"marketing"`
+	From      *string `json:"from"`
+}
+
+// TraktInfo is the Trakt authentication of the user.
+type TraktInfo struct {
+	CreatedAt   time.Time
+	ExpiresIn   time.Duration
+	AccessToken string
+}
+
+func (t TraktInfo) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(struct {
+		CreatedAt   int64  `json:"created_at"`
+		ExpiresIn   int64  `json:"expires_in"`
+		AccessToken string `json:"access_token"`
+	}{t.CreatedAt.Unix(), int64(t.ExpiresIn / time.Second), t.AccessToken})
+}
+
+func (t *TraktInfo) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		CreatedAt   *int64  `json:"created_at"`
+		ExpiresIn   *int64  `json:"expires_in"`
+		AccessToken *string `json:"access_token"`
+	}
