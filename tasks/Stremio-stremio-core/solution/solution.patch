+		AudioTrack:     s.AudioTrack,
+		AudioDelay:     s.AudioDelay,
+		PlaybackSpeed:  toFloat32Ptr(s.PlaybackSpeed),
+		PlayerType:     s.PlayerType,
+		VideoScale:     s.VideoScale,
+	})
+}
+
+func (s *StreamItemState) UnmarshalJSON(data []byte) error {
+	var wire streamItemStateJSON
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	*s = StreamItemState{
+		SubtitleTrack:  wire.SubtitleTrack,
+		SubtitleDelay:  wire.SubtitleDelay,
+		SubtitleSize:   fromFloat32Ptr(wire.SubtitleSize),
+		SubtitleOffset: fromFloat32Ptr(wire.SubtitleOffset),
+		AudioTrack:     wire.AudioTrack,
+		AudioDelay:     wire.AudioDelay,
+		PlaybackSpeed:  fromFloat32Ptr(wire.PlaybackSpeed),
+		PlayerType:     wire.PlayerType,
+		VideoScale:     wire.VideoScale,
+	}
+	return nil
+}
+
+// StreamsItem is the last stream played for a video of a meta item.
+type StreamsItem struct {
+	Stream             Stream
+	Type               string
+	MetaID             string
+	VideoID            string
+	MetaTransportURL   string
+	StreamTransportURL string
+	State              *StreamItemState
+	// Mtime is the modification time.
+	Mtime time.Time
+}
+
+type streamsItemJSON struct {
+	Stream             Stream           `json:"stream"`
+	Type               string           `json:"type"`
+	MetaID             string           `json:"metaId"`
+	VideoID            string           `json:"videoId"`
+	MetaTransportURL   string           `json:"metaTransportUrl"`
+	StreamTransportURL string           `json:"streamTransportUrl"`
+	State              *StreamItemState `json:"state"`
+	Mtime              Time             `json:"_mtime"`
+}
+
+func (i StreamsItem) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(streamsItemJSON{
+		Stream:             i.Stream,
+		Type:               i.Type,
+		MetaID:             i.MetaID,
+		VideoID:            i.VideoID,
+		MetaTransportURL:   i.MetaTransportURL,
+		StreamTransportURL: i.StreamTransportURL,
+		State:              i.State,
+		Mtime:              Time(i.Mtime),
+	})
+}
+
+func (i *StreamsItem) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Stream             *Stream          `json:"stream"`
+		Type               *string          `json:"type"`
+		MetaID             *string          `json:"metaId"`
+		VideoID            *string          `json:"videoId"`
+		MetaTransportURL   *string          `json:"metaTransportUrl"`
+		StreamTransportURL *string          `json:"streamTransportUrl"`
+		State              *StreamItemState `json:"state"`
+		Mtime              *Time            `json:"_mtime"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Stream == nil || wire.Type == nil || wire.MetaID == nil || wire.VideoID == nil ||
+		wire.MetaTransportURL == nil || wire.StreamTransportURL == nil || wire.Mtime == nil {
+		return errors.New("missing field of StreamsItem")
+	}
+	*i = StreamsItem{
+		Stream:             *wire.Stream,
+		Type:               *wire.Type,
+		MetaID:             *wire.MetaID,
+		VideoID:            *wire.VideoID,
+		MetaTransportURL:   *wire.MetaTransportURL,
+		StreamTransportURL: *wire.StreamTransportURL,
+		State:              wire.State,
+		Mtime:              time.Time(*wire.Mtime),
+	}
+	return nil
+}
+
+// AdjustedState returns the state to apply when playing the new stream:
+// the whole state for the same source, the state without the delays for the
+// same binge group and only the playback speed and player type otherwise.
+func (i StreamsItem) AdjustedState(newStream Stream) *StreamItemState {
+	if i.State == nil {
+		return nil
+	}
+	state := *i.State
+	if i.Stream.IsSourceMatch(newStream) {
+		return &state
+	}
+	if i.Stream.IsBingeMatch(newStream) {
+		if state.SubtitleTrack != nil && !state.SubtitleTrack.Embedded {
+			state.SubtitleTrack = nil
+		}
+		state.SubtitleDelay = nil
+		state.AudioDelay = nil
+		return &state
+	}
+	return &StreamItemState{PlaybackSpeed: state.PlaybackSpeed, PlayerType: state.PlayerType}
+}
+
+// StreamsBucket holds the last played streams; it serializes its items as
+// a list of `[key, item]` pairs.
+type StreamsBucket struct {
+	UID   UID
+	Items map[StreamsItemKey]StreamsItem
+}
+
+// NewStreamsBucket creates an empty bucket.
+func NewStreamsBucket(uid UID) StreamsBucket {
+	return StreamsBucket{UID: uid, Items: map[StreamsItemKey]StreamsItem{}}
+}
+
+func (b StreamsBucket) sortedKeys() []StreamsItemKey {
+	keys := make([]StreamsItemKey, 0, len(b.Items))
+	for key := range b.Items {
+		keys = append(keys, key)
+	}
+	sort.Slice(keys, func(i, j int) bool {
+		if keys[i].MetaID != keys[j].MetaID {
+			return keys[i].MetaID < keys[j].MetaID
+		}
+		return keys[i].VideoID < keys[j].VideoID
+	})
+	return keys
+}
+
+func (b StreamsBucket) MarshalJSON() ([]byte, error) {
+	items := make([][2]any, 0, len(b.Items))
+	for _, key := range b.sortedKeys() {
+		items = append(items, [2]any{key, b.Items[key]})
+	}
+	return MarshalJSON(struct {
+		UID   UID      `json:"uid"`
+		Items [][2]any `json:"items"`
+	}{b.UID, items})
+}
+
+func (b *StreamsBucket) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		UID   UID                  `json:"uid"`
+		Items [][2]json.RawMessage `json:"items"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	bucket := StreamsBucket{UID: wire.UID, Items: map[StreamsItemKey]StreamsItem{}}
+	for _, pair := range wire.Items {
+		var key StreamsItemKey
+		var item StreamsItem
+		if err := json.Unmarshal(pair[0], &key); err != nil {
+			return err
+		}
+		if err := json.Unmarshal(pair[1], &item); err != nil {
+			return err
+		}
+		bucket.Items[key] = item
+	}
+	*b = bucket
+	return nil
+}
+
+// LastStreamItem returns the last played stream for the video or, for meta
+// items with videos, for one of the up to 30 previous videos.
+func (b StreamsBucket) LastStreamItem(videoID string, meta MetaItem) *StreamsItem {
+	if len(meta.Videos) == 0 {
+		item, ok := b.Items[StreamsItemKey{MetaID: meta.Preview.ID, VideoID: videoID}]
+		if !ok {
+			return nil
+		}
+		return &item
+	}
+	maxIndex := -1
+	for i, video := range meta.Videos {
+		if video.ID == videoID {
+			maxIndex = i
+			break
+		}
+	}
+	if maxIndex < 0 {
+		return nil
+	}
+	minIndex := max(maxIndex-30, 0)
+	for i := maxIndex; i >= minIndex; i-- {
+		if item, ok := b.Items[StreamsItemKey{MetaID: meta.Preview.ID, VideoID: meta.Videos[i].ID}]; ok {
+			return &item
+		}
+	}
+	return nil
+}
diff --git a/types/watched_bitfield.go b/types/watched_bitfield.go
new file mode 100644
index 0000000000000000000000000000000000000000..a6eb01672fcb693aa8646c65317bc4bfb3604890
--- /dev/null
+++ b/types/watched_bitfield.go
@@ -0,0 +1,303 @@
+package types
+
+import (
+	"bytes"
+	"compress/zlib"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+)
+
+// BitField8 is a bit field backed by bytes, serialized as zlib + base64.
+type BitField8 struct {
+	Length int
+	Values []byte
+}
+
+// NewBitField8 creates a zeroed bit field of the given length.
+func NewBitField8(length int) BitField8 {
+	return BitField8{Length: length, Values: make([]byte, (length+7)/8)}
+}
+
+// NewBitField8WithValues creates a bit field with the given values; the
+// length defaults to `len(values) * 8`.
+func NewBitField8WithValues(values []byte, length *int) BitField8 {
+	l := len(values) * 8
+	if length != nil {
+		l = *length
+	}
+	values = append([]byte{}, values...)
+	if bytesCount := (l + 7) / 8; bytesCount > len(values) {
+		values = append(values, make([]byte, bytesCount-len(values))...)
+	}
+	return BitField8{Length: l, Values: values}
+}
+
+// ParseBitField8 decodes a base64 + zlib encoded bit field.
+func ParseBitField8(encoded string, length *int) (BitField8, error) {
+	compressed, err := decodeBase64Standard(encoded)
+	if err != nil {
+		return BitField8{}, err
+	}
+	var values []byte
+	// flate2's ZlibDecoder reads an empty input as empty data.
+	if len(compressed) > 0 {
+		reader, err := zlib.NewReader(bytes.NewReader(compressed))
+		if err != nil {
+			return BitField8{}, err
+		}
+		values, err = io.ReadAll(reader)
+		if err != nil {
+			return BitField8{}, err
+		}
+	}
+	return NewBitField8WithValues(values, length), nil
+}
+
+// decodeBase64Standard decodes like Rust's base64 0.13 `decode`: the
+// padding is optional, the trailing bits must be zero and no whitespace or
+// line breaks are allowed.
+func decodeBase64Standard(encoded string) ([]byte, error) {
+	if len(encoded)%4 == 1 {
+		return nil, errors.New("Encoded text cannot have a 6-bit remainder.")
+	}
+	data := strings.TrimRight(encoded, "=")
+	for i := len(data); i < len(encoded); i++ {
+		if i%4 < 2 {
+			return nil, fmt.Errorf("Invalid byte 61, offset %d.", i)
+		}
+	}
+	return base64.RawStdEncoding.Strict().DecodeString(data)
+}
+
+// Get returns the bit at the index.
+func (b BitField8) Get(i int) bool {
+	index, bit := i/8, i%8
+	if i < 0 || index >= len(b.Values) {
+		return false
+	}
+	return (b.Values[index]>>bit)&1 != 0
+}
+
+// Set sets the bit at the index, growing the field if needed.
+func (b *BitField8) Set(i int, value bool) {
+	index := i / 8
+	mask := byte(1) << (i % 8)
+	if index >= len(b.Values) {
+		b.Values = append(b.Values, make([]byte, index-len(b.Values)+1)...)
+		b.Length = len(b.Values) * 8
+	}
+	if value {
+		b.Values[index] |= mask
+	} else {
+		b.Values[index] &^= mask
+	}
+}
+
+// LastIndexOf returns the last index whose bit equals the value, or -1.
+func (b BitField8) LastIndexOf(value bool) int {
+	for i := b.Length - 1; i >= 0; i-- {
+		if b.Get(i) == value {
+			return i
+		}
+	}
+	return -1
+}
+
+// Clone returns a copy of the bit field.
+func (b BitField8) Clone() BitField8 {
+	return BitField8{Length: b.Length, Values: append([]byte{}, b.Values...)}
+}
+
+// String returns the base64 encoded zlib (level 6) compressed values.
+func (b BitField8) String() string {
+	return base64.StdEncoding.EncodeToString(ZlibCompress(b.Values))
+}
+
+func (b BitField8) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(b.String())
+}
+
+func (b *BitField8) UnmarshalJSON(data []byte) error {
+	var encoded string
+	if err := json.Unmarshal(data, &encoded); err != nil {
+		return err
+	}
+	parsed, err := ParseBitField8(encoded, nil)
+	if err != nil {
+		return err
+	}
+	*b = parsed
+	return nil
+}
+
+// WatchedField is the serialized form of a WatchedBitField, without the
+// knowledge of the video ids: `{anchor video id}:{anchor length}:{bitfield}`.
+type WatchedField struct {
+	// AnchorVideo is the last watched video id.
+	AnchorVideo string
+	// AnchorLength is the length from the beginning of the bit field to the last watched video.
+	AnchorLength int
+	BitField     BitField8
+}
+
+// ParseWatchedField parses a serialized watched field. The video id may
+// contain `:` so the components are popped from the end.
+func ParseWatchedField(serialized string) (WatchedField, error) {
+	components := strings.Split(serialized, ":")
+	if len(components) < 3 {
+		return WatchedField{}, errors.New("Not enough components")
+	}
+	encoded := components[len(components)-1]
+	// Rust's usize parsing accepts a leading `+`.
+	anchorLength, err := strconv.ParseUint(strings.TrimPrefix(components[len(components)-2], "+"), 10, 64)
+	if err != nil {
+		return WatchedField{}, err
+	}
+	bitfield, err := ParseBitField8(encoded, nil)
+	if err != nil {
+		return WatchedField{}, err
+	}
+	return WatchedField{
+		AnchorVideo:  strings.Join(components[:len(components)-2], ":"),
+		AnchorLength: int(anchorLength),
+		BitField:     bitfield,
+	}, nil
+}
+
+func (w WatchedField) String() string {
+	return fmt.Sprintf("%s:%d:%s", w.AnchorVideo, w.AnchorLength, w.BitField.String())
+}
+
+func (w WatchedField) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(w.String())
+}
+
+func (w *WatchedField) UnmarshalJSON(data []byte) error {
+	var serialized string
+	if err := json.Unmarshal(data, &serialized); err != nil {
+		return err
+	}
+	parsed, err := ParseWatchedField(serialized)
+	if err != nil {
+		return err
+	}
+	*w = parsed
+	return nil
+}
+
+// WatchedBitField tracks which videos (by id) have been watched.
+type WatchedBitField struct {
+	BitField BitField8
+	VideoIDs []string
+}
+
+// WatchedBitFieldConstructFromArray creates a watched bit field from the
+// watched flags of the videos.
+func WatchedBitFieldConstructFromArray(arr []bool, videoIDs []string) WatchedBitField {
+	bitfield := NewBitField8(len(videoIDs))
+	for i, value := range arr {
+		bitfield.Set(i, value)
+	}
+	return WatchedBitField{BitField: bitfield, VideoIDs: append([]string{}, videoIDs...)}
+}
+
+// WatchedBitFieldConstructWithVideos creates a watched bit field from a
+// watched field, shifting the bits so that the anchor video keeps its
+// position among the given videos.
+func WatchedBitFieldConstructWithVideos(field WatchedField, videoIDs []string) (WatchedBitField, error) {
+	videoIDs = append([]string{}, videoIDs...)
+	anchorIndex := -1
+	for i, id := range videoIDs {
+		if id == field.AnchorVideo {
+			anchorIndex = i
+			break
+		}
+	}
+	if anchorIndex < 0 {
+		// the anchor video could not be found, return a blank field
+		return WatchedBitField{BitField: NewBitField8(len(videoIDs)), VideoIDs: videoIDs}, nil
+	}
+	// i32 arithmetic (truncating and wrapping) like the Rust implementation.
+	offset := int32(field.AnchorLength) - int32(anchorIndex) - 1
+	length := len(videoIDs)
+	bitfield := NewBitField8WithValues(field.BitField.Values, &length)
+	if offset == 0 {
+		return WatchedBitField{BitField: bitfield, VideoIDs: videoIDs}, nil
+	}
+	resized := WatchedBitField{BitField: NewBitField8(len(videoIDs)), VideoIDs: videoIDs}
+	for i := range videoIDs {
+		previous := int32(i) + offset
+		if previous >= 0 && int(previous) < bitfield.Length {
+			resized.Set(i, bitfield.Get(int(previous)))
+		}
+	}
+	return resized, nil
+}
+
+// WatchedBitFieldConstructAndResize parses a serialized watched field and
+// creates a watched bit field for the given videos.
+func WatchedBitFieldConstructAndResize(serialized string, videoIDs []string) (WatchedBitField, error) {
+	field, err := ParseWatchedField(serialized)
+	if err != nil {
+		return WatchedBitField{}, err
+	}
+	return WatchedBitFieldConstructWithVideos(field, videoIDs)
+}
+
+// Get returns whether the video at the index is watched.
+func (w WatchedBitField) Get(index int) bool {
+	return w.BitField.Get(index)
+}
+
+// GetVideo returns whether the video is watched.
+func (w WatchedBitField) GetVideo(videoID string) bool {
+	for i, id := range w.VideoIDs {
+		if id == videoID {
+			return w.BitField.Get(i)
+		}
+	}
+	return false
+}
+
+// Set sets whether the video at the index is watched.
+func (w *WatchedBitField) Set(index int, value bool) {
+	w.BitField.Set(index, value)
+}
+
+// SetVideo sets whether the video is watched; unknown videos are ignored.
+func (w *WatchedBitField) SetVideo(videoID string, value bool) {
+	for i, id := range w.VideoIDs {
+		if id == videoID {
+			w.BitField.Set(i, value)
+			return
+		}
+	}
+}
+
+// Clone returns a copy of the watched bit field.
+func (w WatchedBitField) Clone() WatchedBitField {
+	return WatchedBitField{BitField: w.BitField.Clone(), VideoIDs: append([]string{}, w.VideoIDs...)}
+}
+
+// WatchedField returns the serializable watched field.
+func (w WatchedBitField) WatchedField() WatchedField {
+	lastID := w.BitField.LastIndexOf(true)
+	if lastID < 0 {
+		lastID = 0
+	}
+	lastVideoID := "undefined"
+	if lastID < len(w.VideoIDs) {
+		lastVideoID = w.VideoIDs[lastID]
+	}
+	return WatchedField{AnchorVideo: lastVideoID, AnchorLength: lastID + 1, BitField: w.BitField.Clone()}
+}
+
+// String serializes the watched bit field as `{last watched id}:{length}:{bitfield}`.
+func (w WatchedBitField) String() string {
+	return w.WatchedField().String()
+}
diff --git a/types/watched_bitfield_test.go b/types/watched_bitfield_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..35559c758ad1ea2dd0b98c56b2e2de4caec26d81
--- /dev/null
+++ b/types/watched_bitfield_test.go
@@ -0,0 +1,712 @@
+package types
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"testing"
+)
+
+// Ports of the tests of the Rust crate stremio-watched-bitfield.
+
+func TestBitField8DeSerialize(t *testing.T) {
+	const jsonValue = `"eJyTZwAAAEAAIA=="`
+
+	var actual BitField8
+	if err := json.Unmarshal([]byte(jsonValue), &actual); err != nil {
+		t.Fatalf("Should deserialize: %v", err)
+	}
+	if actual.Length != 16 || string(actual.Values) != string([]byte{31, 0}) {
+		t.Errorf("got %+v, want length 16 and values [31 0]", actual)
+	}
+	serialized, err := json.Marshal(BitField8{Length: 16, Values: []byte{31, 0}})
+	if err != nil || string(serialized) != jsonValue {
+		t.Errorf("Should serialize: got %s, %v", serialized, err)
+	}
+
+	// With a custom length the serialized value is the same.
+	expected := BitField8{Length: 9, Values: []byte{31, 0}}
+	if actual.Length == expected.Length || actual.Length != 16 {
+		t.Errorf("the deserialized length should be 16, got %d", actual.Length)
+	}
+	if string(actual.Values) != string(expected.Values) {
+		t.Errorf("got values %v, want %v", actual.Values, expected.Values)
+	}
+	serialized, err = json.Marshal(expected)
+	if err != nil || string(serialized) != jsonValue {
+		t.Errorf("Should serialize: got %s, %v", serialized, err)
+	}
+}
+
+func TestBitField8ParseLength(t *testing.T) {
+	const watched = "eJyTZwAAAEAAIA=="
+	length := 9
+	bitfield, err := ParseBitField8(watched, &length)
+	if err != nil || bitfield.Length != 9 {
+		t.Errorf("got %+v, %v, want length 9", bitfield, err)
+	}
+	// If the value is not provided the length is rounded towards the next byte.
+	bitfield, err = ParseBitField8(watched, nil)
+	if err != nil || bitfield.Length != 16 {
+		t.Errorf("got %+v, %v, want length 16", bitfield, err)
+	}
+}
+
+func TestBitField8NewUsesBitLength(t *testing.T) {
+	bitfield := NewBitField8(20)
+	if bitfield.Length != 20 {
+		t.Errorf("got length %d, want 20", bitfield.Length)
+	}
+	bitfield.Set(15, true)
+	if got := bitfield.LastIndexOf(true); got != 15 {
+		t.Errorf("LastIndexOf(true) = %d, want 15", got)
+	}
+}
+
+func TestWatchedBitFieldParseAndModify(t *testing.T) {
+	videos := []string{
+		"tt2934286:1:1", "tt2934286:1:2", "tt2934286:1:3", "tt2934286:1:4", "tt2934286:1:5",
+		"tt2934286:1:6", "tt2934286:1:7", "tt2934286:1:8", "tt2934286:1:9",
+	}
+	const watched = "tt2934286:1:5:5:eJyTZwAAAEAAIA=="
+	wb, err := WatchedBitFieldConstructAndResize(watched, videos)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !wb.GetVideo("tt2934286:1:5") {
+		t.Error("tt2934286:1:5 should be watched")
+	}
+	if wb.GetVideo("tt2934286:1:6") {
+		t.Error("tt2934286:1:6 should not be watched")
+	}
+	if got := wb.String(); got != watched {
+		t.Errorf("String() = %s, want %s", got, watched)
+	}
+	wb.SetVideo("tt2934286:1:6", true)
+	if !wb.GetVideo("tt2934286:1:6") {
+		t.Error("tt2934286:1:6 should be watched")
+	}
+}
+
+func TestWatchedBitFieldConstructFromArray(t *testing.T) {
+	arr := make([]bool, 500)
+	var videoIDs []string
+	for i := 1; i < 500; i++ {
+		videoIDs = append(videoIDs, fmt.Sprintf("tt2934286:1:%d", i))
+	}
+	wb := WatchedBitFieldConstructFromArray(arr, videoIDs)
+
+	// All should be false.
+	for i, id := range videoIDs {
+		if wb.Get(i) || wb.GetVideo(id) {
+			t.Fatalf("video %d should not be watched", i)
+		}
+	}
+	// Set half to true.
+	for i := range videoIDs {
+		wb.Set(i, i%2 == 0)
+	}
+	// Serialize and deserialize to a new structure.
+	watched := wb.String()
+	wb2, err := WatchedBitFieldConstructAndResize(watched, videoIDs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Half should still be true.
+	for i, id := range videoIDs {
+		if wb2.Get(i) != (i%2 == 0) || wb2.GetVideo(id) != (i%2 == 0) {
+			t.Fatalf("video %d: got %v, want %v", i, wb2.Get(i), i%2 == 0)
+		}
+	}
+}
+
+func TestWatchedBitFieldToStringEmpty(t *testing.T) {
+	watched := WatchedBitFieldConstructFromArray(nil, nil)
+	if got := watched.String(); got != "undefined:1:eJwDAAAAAAE=" {
+		t.Errorf("String() = %s, want undefined:1:eJwDAAAAAAE=", got)
+	}
+}
+
+func TestWatchedFieldDeSerialize(t *testing.T) {
+	const serialized = "tt7767422:3:8:24:eJz7//8/AAX9Av4="
+	jsonValue, _ := json.Marshal(serialized)
+
+	expected, err := ParseWatchedField(serialized)
+	if err != nil {
+		t.Fatalf("Should parse field: %v", err)
+	}
+	var actual WatchedField
+	if err := json.Unmarshal(jsonValue, &actual); err != nil {
+		t.Fatalf("Should deserialize: %v", err)
+	}
+	if actual.AnchorVideo != expected.AnchorVideo || actual.AnchorLength != expected.AnchorLength ||
+		actual.BitField.Length != expected.BitField.Length || string(actual.BitField.Values) != string(expected.BitField.Values) {
+		t.Errorf("got %+v, want %+v", actual, expected)
+	}
+	if got := actual.BitField.String(); got != "eJz7//8/AAX9Av4=" {
+		t.Errorf("BitField.String() = %s, want eJz7//8/AAX9Av4=", got)
+	}
+	if actual.AnchorLength != 24 {
+		t.Errorf("AnchorLength = %d, want 24", actual.AnchorLength)
+	}
+	if actual.AnchorVideo != "tt7767422:3:8" {
+		t.Errorf("AnchorVideo = %s, want tt7767422:3:8", actual.AnchorVideo)
+	}
+	got, err := json.Marshal(expected)
+	if err != nil || string(got) != string(jsonValue) {
+		t.Errorf("Should serialize: got %s, %v, want %s", got, err, jsonValue)
+	}
+}
