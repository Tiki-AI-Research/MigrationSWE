diff --git a/types/player.go b/types/player.go
new file mode 100644
index 0000000000000000000000000000000000000000..7cccfdc09c0cca4f4107cae6d21d3765fc0e2374
--- /dev/null
+++ b/types/player.go
@@ -0,0 +1,90 @@
+package types
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+// VideoScale is the scaling of the video in the player.
+type VideoScale string
+
+const (
+	VideoScaleContain VideoScale = "contain"
+	VideoScaleCover   VideoScale = "cover"
+	VideoScaleFill    VideoScale = "fill"
+)
+
+func (v *VideoScale) UnmarshalJSON(data []byte) error {
+	var value string
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	switch VideoScale(value) {
+	case VideoScaleContain, VideoScaleCover, VideoScaleFill:
+		*v = VideoScale(value)
+		return nil
+	}
+	return fmt.Errorf("unknown variant `%s`, expected one of `contain`, `cover`, `fill`", value)
+}
+
+// SubtitleSource is the source of the subtitles: embedded or external (addons).
+type SubtitleSource string
+
+const (
+	SubtitleSourceEmbedded SubtitleSource = "embedded"
+	SubtitleSourceExternal SubtitleSource = "external"
+)
+
+func (s *SubtitleSource) UnmarshalJSON(data []byte) error {
+	var value string
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	switch SubtitleSource(value) {
+	case SubtitleSourceEmbedded, SubtitleSourceExternal:
+		*s = SubtitleSource(value)
+		return nil
+	}
+	return fmt.Errorf("unknown variant `%s`, expected `embedded` or `external`", value)
+}
+
+// SubtitlePreference is the subtitle preference of the current player
+// session. It is preserved across player loads and is independent from the
+// episode-specific subtitle tracks.
+type SubtitlePreference struct {
+	Enabled bool `json:"enabled"`
+	// Source is the preferred source, `nil` keeps the client's normal ordering.
+	Source *SubtitleSource `json:"source,omitempty"`
+	// Language is the preferred normalized language code.
+	Language *string `json:"language,omitempty"`
+}
+
+func (p *SubtitlePreference) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Enabled  *bool           `json:"enabled"`
+		Source   *SubtitleSource `json:"source"`
+		Language *string         `json:"language"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Enabled == nil {
+		return fmt.Errorf("missing field `enabled`")
+	}
+	*p = SubtitlePreference{Enabled: *wire.Enabled, Source: wire.Source, Language: wire.Language}
+	return nil
+}
+
+// IntroOutro holds the intro and the outro (in milliseconds) of the video.
+type IntroOutro struct {
+	Intro *IntroData `json:"intro"`
+	Outro *uint64    `json:"outro"`
+}
+
+// IntroData is the intro of the video.
+type IntroData struct {
+	From uint64 `json:"from"`
+	To   uint64 `json:"to"`
+	// Duration is set when the skip gap duration differs from the stream duration.
+	Duration *uint64 `json:"duration"`
+}
diff --git a/types/query_params_encode.go b/types/query_params_encode.go
new file mode 100644
index 0000000000000000000000000000000000000000..7fe5e59568441b29a6942dc20e98a7b3e3d1a8de
--- /dev/null
+++ b/types/query_params_encode.go
@@ -0,0 +1,90 @@
+package types
+
+import "strings"
+
+// QueryPair is a key/value pair of a query string.
+type QueryPair struct {
+	Key   string
+	Value string
+}
+
+// QueryParamsEncode encodes the pairs as `key=value` joined with `&`,
+// percent-encoding keys and values like `encodeURIComponent`.
+func QueryParamsEncode(pairs []QueryPair) string {
+	encoded := make([]string, 0, len(pairs))
+	for _, pair := range pairs {
+		encoded = append(encoded, EncodeURIComponent(pair.Key)+"="+EncodeURIComponent(pair.Value))
+	}
+	return strings.Join(encoded, "&")
+}
+
+// ExtraValuesQueryParams returns the extra values as query pairs.
+func ExtraValuesQueryParams(extra []ExtraValue) []QueryPair {
+	pairs := make([]QueryPair, 0, len(extra))
+	for _, value := range extra {
+		pairs = append(pairs, QueryPair{Key: value.Name, Value: value.Value})
+	}
+	return pairs
+}
+
+const upperHex = "0123456789ABCDEF"
+
+// EncodeURIComponent percent-encodes every byte except ASCII alphanumerics and
+// `-_.!~*'()` (`URI_COMPONENT_ENCODE_SET`).
+func EncodeURIComponent(value string) string {
+	var b strings.Builder
+	b.Grow(len(value))
+	for i := 0; i < len(value); i++ {
+		c := value[i]
+		if isURIComponentUnreserved(c) {
+			b.WriteByte(c)
+		} else {
+			b.WriteByte('%')
+			b.WriteByte(upperHex[c>>4])
+			b.WriteByte(upperHex[c&15])
+		}
+	}
+	return b.String()
+}
+
+func isURIComponentUnreserved(c byte) bool {
+	switch {
+	case 'a' <= c && c <= 'z', 'A' <= c && c <= 'Z', '0' <= c && c <= '9':
+		return true
+	}
+	switch c {
+	case '-', '_', '.', '!', '~', '*', '\'', '(', ')':
+		return true
+	}
+	return false
+}
+
+// FormURLEncode encodes a value with `application/x-www-form-urlencoded`
+// rules (`url::form_urlencoded`): spaces become `+`.
+func FormURLEncode(value string) string {
+	var b strings.Builder
+	for i := 0; i < len(value); i++ {
+		c := value[i]
+		switch {
+		case 'a' <= c && c <= 'z', 'A' <= c && c <= 'Z', '0' <= c && c <= '9',
+			c == '*', c == '-', c == '.', c == '_':
+			b.WriteByte(c)
+		case c == ' ':
+			b.WriteByte('+')
+		default:
+			b.WriteByte('%')
+			b.WriteByte(upperHex[c>>4])
+			b.WriteByte(upperHex[c&15])
+		}
+	}
+	return b.String()
+}
+
+// FormURLEncodePairs serializes pairs as an `application/x-www-form-urlencoded` query.
+func FormURLEncodePairs(pairs []QueryPair) string {
+	encoded := make([]string, 0, len(pairs))
+	for _, pair := range pairs {
+		encoded = append(encoded, FormURLEncode(pair.Key)+"="+FormURLEncode(pair.Value))
+	}
+	return strings.Join(encoded, "&")
+}
diff --git a/types/rating.go b/types/rating.go
new file mode 100644
index 0000000000000000000000000000000000000000..c23462981a940cadc0d708b768952006aee17ddd
--- /dev/null
+++ b/types/rating.go
@@ -0,0 +1,126 @@
+package types
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+
+	stremiocore "github.com/stremio/stremio-core"
+)
+
+// Rating is a rating of a meta item.
+type Rating string
+
+const (
+	RatingWatched Rating = "watched"
+	RatingLiked   Rating = "liked"
+	RatingLoved   Rating = "loved"
+)
+
+func (r *Rating) UnmarshalJSON(data []byte) error {
+	var value string
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	switch Rating(value) {
+	case RatingWatched, RatingLiked, RatingLoved:
+		*r = Rating(value)
+		return nil
+	}
+	return fmt.Errorf("unknown variant `%s`, expected one of `watched`, `liked`, `loved`", value)
+}
+
+// RatingInfo is the rating status of a meta item.
+type RatingInfo struct {
+	MetaID string  `json:"metaId"`
+	Status *Rating `json:"status"`
+}
+
+// RatingGetStatusRequest requests the rating status of a meta item.
+type RatingGetStatusRequest struct {
+	AuthKey      AuthKey `json:"authKey"`
+	MetaItemID   string  `json:"metaItemId"`
+	MetaItemType string  `json:"metaItemType"`
+}
+
+// URL returns the endpoint of the request.
+func (r RatingGetStatusRequest) URL() string {
+	return MustURLJoin(stremiocore.USER_LIKES_API_URL, fmt.Sprintf("api/get_status?authToken=%s&mediaId=%s&mediaType=%s",
+		escapeQueryValue(string(r.AuthKey)), escapeQueryValue(r.MetaItemID), escapeQueryValue(r.MetaItemType)))
+}
+
+// escapeQueryValue percent-encodes the characters the WHATWG query parser encodes.
+func escapeQueryValue(value string) string {
+	var b strings.Builder
+	for i := 0; i < len(value); i++ {
+		c := value[i]
+		if c <= 0x20 || c >= 0x7f || c == '"' || c == '#' || c == '<' || c == '>' {
+			b.WriteByte('%')
+			b.WriteByte(upperHex[c>>4])
+			b.WriteByte(upperHex[c&15])
+		} else {
+			b.WriteByte(c)
+		}
+	}
+	return b.String()
+}
+
+// RatingSendRequest sends the rating of a meta item.
+type RatingSendRequest struct {
+	AuthKey      AuthKey
+	MetaItemID   string
+	MetaItemType string
+	Rating       *Rating
+}
+
+// RatingSendRequestBody is the body of a RatingSendRequest.
+type RatingSendRequestBody struct {
+	AuthToken AuthKey `json:"authToken"`
+	MediaID   string  `json:"mediaId"`
+	MediaType string  `json:"mediaType"`
+	Status    *Rating `json:"status"`
+}
+
+// URL returns the endpoint of the request.
+func (r RatingSendRequest) URL() string {
+	return MustURLJoin(stremiocore.USER_LIKES_API_URL, "api/send")
+}
+
+// Body returns the body of the request.
+func (r RatingSendRequest) Body() RatingSendRequestBody {
+	return RatingSendRequestBody{AuthToken: r.AuthKey, MediaID: r.MetaItemID, MediaType: r.MetaItemType, Status: r.Rating}
+}
+
+// RatingGetStatusResponse is the response of a RatingGetStatusRequest.
+type RatingGetStatusResponse struct {
+	Status *Rating `json:"status"`
+}
+
+// RatingSendResponseRating is the rating of a RatingSendResponse.
+type RatingSendResponseRating struct {
+	Status Rating `json:"status"`
+}
+
+// RatingSendResponse is the response of a RatingSendRequest.
+type RatingSendResponse struct {
+	Message string                    `json:"message"`
+	Rating  *RatingSendResponseRating `json:"rating"`
+	Action  *string                   `json:"action"`
+}
+
+func (r *RatingSendResponse) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Message *string                   `json:"message"`
+		Rating  *RatingSendResponseRating `json:"rating"`
+		Action  *string                   `json:"action"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Message == nil {
+		return errors.New("missing field `message`")
+	}
+	*r = RatingSendResponse{Message: *wire.Message, Rating: wire.Rating, Action: wire.Action}
+	return nil
+}
diff --git a/types/resource.go b/types/resource.go
new file mode 100644
index 0000000000000000000000000000000000000000..6546f56e03497e0846b3f79ffdaa2dc3b5566810
--- /dev/null
+++ b/types/resource.go
@@ -0,0 +1,588 @@
+package types
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"sort"
+	"strings"
+
+	stremiocore "github.com/stremio/stremio-core"
+)
+
+// ExtraValue is an extra query parameter of a resource request.
+// It (de)serializes as a `[name, value]` tuple.
+type ExtraValue struct {
+	Name  string
+	Value string
+}
+
+func (e ExtraValue) MarshalJSON() ([]byte, error) {
+	return MarshalJSON([2]string{e.Name, e.Value})
+}
+
+func (e *ExtraValue) UnmarshalJSON(data []byte) error {
+	var tuple []string
+	if err := json.Unmarshal(data, &tuple); err != nil {
+		return err
+	}
+	if len(tuple) != 2 {
+		return fmt.Errorf("invalid length %d, expected a tuple of size 2", len(tuple))
+	}
+	e.Name, e.Value = tuple[0], tuple[1]
+	return nil
+}
+
+// RemoveAllExtra removes all values of the given extra property.
+func RemoveAllExtra(extra []ExtraValue, prop *ExtraProp) []ExtraValue {
+	result := []ExtraValue{}
+	for _, value := range extra {
+		if value.Name != prop.Name {
+			result = append(result, value)
+		}
+	}
+	return result
+}
+
+// ExtendOneExtra sets (or toggles for multi-option props) the value of an
+// extra property, respecting its options limit (`ExtraExt::extend_one`).
+func ExtendOneExtra(extra []ExtraValue, prop *ExtraProp, value *string) []ExtraValue {
+	var matching, other []ExtraValue
+	for _, ev := range extra {
+		if ev.Name == prop.Name {
+			matching = append(matching, ev)
+		} else {
+			other = append(other, ev)
+		}
+	}
+	var next []ExtraValue
+	switch {
+	case value != nil && prop.OptionsLimit == 1:
+		next = []ExtraValue{{Name: prop.Name, Value: *value}}
+	case value != nil && prop.OptionsLimit > 1:
+		contains := false
+		for _, ev := range matching {
+			if ev.Value == *value {
+				contains = true
+				break
+			}
+		}
+		if contains {
+			for _, ev := range matching {
+				if ev.Value != *value {
+					next = append(next, ev)
+				}
+			}
+		} else {
+			next = append([]ExtraValue{{Name: prop.Name, Value: *value}}, matching...)
+			if len(next) > prop.OptionsLimit {
+				next = next[:prop.OptionsLimit]
+			}
+		}
+	case value == nil && !prop.IsRequired:
+		next = nil
+	case prop.OptionsLimit == 0:
+		next = nil
+	default:
+		next = matching
+	}
+	return append(append([]ExtraValue{}, next...), other...)
+}
+
+// ResourcePath is the path of an addon resource request:
+// `{resource}/{type}/{id}.json` or `{resource}/{type}/{id}/{extra}.json`.
+type ResourcePath struct {
+	Resource string
+	Type     string
+	ID       string
+	Extra    []ExtraValue
+}
+
+type resourcePathJSON struct {
+	Resource string       `json:"resource"`
+	Type     string       `json:"type"`
+	ID       string       `json:"id"`
+	Extra    []ExtraValue `json:"extra"`
+}
+
+func (p ResourcePath) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(resourcePathJSON{
+		Resource: p.Resource,
+		Type:     p.Type,
+		ID:       p.ID,
+		Extra:    nonNilSlice(p.Extra),
+	})
+}
+
+func (p *ResourcePath) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Resource *string      `json:"resource"`
+		Type     *string      `json:"type"`
+		ID       *string      `json:"id"`
+		Extra    []ExtraValue `json:"extra"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Resource == nil || wire.Type == nil || wire.ID == nil {
+		return errors.New("missing field of ResourcePath")
+	}
+	*p = ResourcePath{Resource: *wire.Resource, Type: *wire.Type, ID: *wire.ID, Extra: wire.Extra}
+	return nil
+}
+
+// NewResourcePath creates a path without extra values.
+func NewResourcePath(resource, typ, id string) ResourcePath {
+	return ResourcePath{Resource: resource, Type: typ, ID: id, Extra: []ExtraValue{}}
+}
+
+// NewResourcePathWithExtra creates a path with extra values.
+func NewResourcePathWithExtra(resource, typ, id string, extra []ExtraValue) ResourcePath {
+	return ResourcePath{Resource: resource, Type: typ, ID: id, Extra: append([]ExtraValue{}, extra...)}
+}
+
+// GetExtraFirstValue returns the first value of the named extra.
+func (p ResourcePath) GetExtraFirstValue(name string) *string {
+	for _, value := range p.Extra {
+		if value.Name == name {
+			v := value.Value
+			return &v
+		}
+	}
+	return nil
+}
+
+// EqNoExtra compares the paths ignoring the extra values.
+func (p ResourcePath) EqNoExtra(other ResourcePath) bool {
+	return p.Resource == other.Resource && p.Type == other.Type && p.ID == other.ID
+}
+
+// Equal compares two paths (nil and empty extra are equal).
+func (p ResourcePath) Equal(other ResourcePath) bool {
+	if !p.EqNoExtra(other) || len(p.Extra) != len(other.Extra) {
+		return false
+	}
+	for i := range p.Extra {
+		if p.Extra[i] != other.Extra[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// ResourceRequest is a request of a resource from the addon at `Base`.
+type ResourceRequest struct {
+	Base string
+	Path ResourcePath
+}
+
+type resourceRequestJSON struct {
+	Base string       `json:"base"`
+	Path ResourcePath `json:"path"`
+}
+
+func (r ResourceRequest) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(resourceRequestJSON{Base: r.Base, Path: r.Path})
+}
+
+func (r *ResourceRequest) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Base *string       `json:"base"`
+		Path *ResourcePath `json:"path"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Base == nil || wire.Path == nil {
+		return errors.New("missing field of ResourceRequest")
+	}
+	if !IsValidURL(*wire.Base) {
+		return fmt.Errorf("invalid base url: %s", *wire.Base)
+	}
+	*r = ResourceRequest{Base: *wire.Base, Path: *wire.Path}
+	return nil
+}
+
+// NewResourceRequest creates a resource request.
+func NewResourceRequest(base string, path ResourcePath) ResourceRequest {
+	return ResourceRequest{Base: base, Path: path}
+}
+
+// Equal compares two resource requests.
+func (r ResourceRequest) Equal(other ResourceRequest) bool {
+	return urlEqual(r.Base, other.Base) && r.Path.Equal(other.Path)
+}
+
+// EqNoExtra compares two resource requests ignoring the extra values.
+func (r ResourceRequest) EqNoExtra(other ResourceRequest) bool {
+	return urlEqual(r.Base, other.Base) && r.Path.EqNoExtra(other.Path)
+}
+
+func urlEqual(a, b string) bool {
+	return a == b || NormalizeURL(a) == NormalizeURL(b)
+}
+
+//
+// Resource response
+//
+
+// Resource response variants, i.e. the single key of the response object.
+const (
+	ResourceResponseMetas         = "metas"
+	ResourceResponseMetasDetailed = "metasDetailed"
+	ResourceResponseMeta          = "meta"
+	ResourceResponseStreams       = "streams"
+	ResourceResponseSubtitles     = "subtitles"
+	ResourceResponseAddons        = "addons"
+)
+
+var resourceResponseKeys = []string{
+	ResourceResponseMetas,
+	ResourceResponseMetasDetailed,
+	ResourceResponseMeta,
+	ResourceResponseStreams,
+	ResourceResponseSubtitles,
+	ResourceResponseAddons,
+}
+
+// ResourceResponse is the raw JSON response of an addon resource.
+// Exactly one of the `metas`, `metasDetailed`, `meta`, `streams`,
+// `subtitles` and `addons` keys is present in a valid response.
+type ResourceResponse struct {
+	Raw []byte
+}
+
+func (r ResourceResponse) MarshalJSON() ([]byte, error) {
+	if len(r.Raw) == 0 {
+		return []byte("null"), nil
+	}
+	var buf bytes.Buffer
+	if err := json.Compact(&buf, r.Raw); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+func (r *ResourceResponse) UnmarshalJSON(data []byte) error {
+	r.Raw = append([]byte{}, data...)
+	return nil
+}
+
+// NewResourceResponse creates a response with the given variant key and content.
+func NewResourceResponse(variant string, content any) ResourceResponse {
+	return ResourceResponse{Raw: MustMarshalJSON(map[string]any{variant: content})}
+}
+
+// ParseResourceResponse validates a raw response the way the rust
+// `ResourceResponse` deserializer does.
+func ParseResourceResponse(data []byte) (ResourceResponse, error) {
+	response := ResourceResponse{Raw: append([]byte{}, data...)}
+	if _, _, err := response.variant(); err != nil {
+		return ResourceResponse{}, err
+	}
+	return response, nil
+}
+
+func (r ResourceResponse) variant() (string, json.RawMessage, error) {
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(r.Raw, &object); err != nil || object == nil {
+		return "", nil, errors.New("Cannot deserialize as ResourceResponse, expected an Object response")
+	}
+	found := []string{}
+	for _, key := range resourceResponseKeys {
+		if _, ok := object[key]; ok {
+			found = append(found, key)
+		}
+	}
+	switch len(found) {
+	case 0:
+		return "", nil, fmt.Errorf("Cannot deserialize as ResourceResponse, the expected Object response didn't contain any of the required keys: %s", strings.Join(resourceResponseKeys, ", "))
+	case 1:
+		return found[0], object[found[0]], nil
+	default:
+		return "", nil, fmt.Errorf("Cannot deserialize as ResourceResponse, the expected Object response contained more than 1 of the unique keys: %s", strings.Join(resourceResponseKeys, ", "))
+	}
+}
+
+// Variant returns the key of the response variant.
+func (r ResourceResponse) Variant() string {
+	variant, _, _ := r.variant()
+	return variant
+}
+
+func (r ResourceResponse) content(expected string) (json.RawMessage, error) {
+	variant, content, err := r.variant()
+	if err != nil {
+		return nil, err
+	}
+	if variant != expected {
+		return nil, fmt.Errorf("Only %s can be converted from ResourceResponse", expected)
+	}
+	return content, nil
+}
+
+// decodeSkipErrors decodes a JSON array skipping the invalid items (`VecSkipError`).
+func decodeSkipErrors[T any](content json.RawMessage) ([]T, error) {
+	result := []T{}
+	if isJSONNull(content) {
+		return result, nil
+	}
+	var items []json.RawMessage
+	if err := json.Unmarshal(content, &items); err != nil {
+		return nil, errors.New("invalid type: map, expected a sequence")
+	}
+	for _, item := range items {
+		var value T
+		if err := json.Unmarshal(item, &value); err == nil {
+			result = append(result, value)
+		}
+	}
+	return result, nil
+}
+
+// Metas returns the content of a `metas` response.
+func (r ResourceResponse) Metas() ([]MetaItemPreview, error) {
+	content, err := r.content(ResourceResponseMetas)
+	if err != nil {
+		return nil, err
+	}
+	return decodeSkipErrors[MetaItemPreview](content)
+}
+
+// MetasDetailed returns the content of a `metasDetailed` response.
+func (r ResourceResponse) MetasDetailed() ([]MetaItem, error) {
+	content, err := r.content(ResourceResponseMetasDetailed)
+	if err != nil {
+		return nil, err
+	}
+	return decodeSkipErrors[MetaItem](content)
+}
+
+// Meta returns the content of a `meta` response.
+func (r ResourceResponse) Meta() (MetaItem, error) {
+	content, err := r.content(ResourceResponseMeta)
+	if err != nil {
+		return MetaItem{}, err
+	}
+	var meta MetaItem
+	if err := json.Unmarshal(content, &meta); err != nil {
+		return MetaItem{}, err
+	}
+	return meta, nil
+}
+
+// Streams returns the content of a `streams` response.
+func (r ResourceResponse) Streams() ([]Stream, error) {
+	content, err := r.content(ResourceResponseStreams)
+	if err != nil {
+		return nil, err
+	}
+	return decodeSkipErrors[Stream](content)
+}
+
+// Subtitles returns the content of a `subtitles` response.
+func (r ResourceResponse) Subtitles() ([]Subtitles, error) {
+	content, err := r.content(ResourceResponseSubtitles)
+	if err != nil {
+		return nil, err
+	}
+	return decodeSkipErrors[Subtitles](content)
+}
+
+// Addons returns the content of an `addons` response.
+func (r ResourceResponse) Addons() ([]Descriptor, error) {
+	content, err := r.content(ResourceResponseAddons)
+	if err != nil {
+		return nil, err
+	}
+	return decodeSkipErrors[Descriptor](content)
+}
+
+// Equal compares the decoded JSON of two responses.
+func (r ResourceResponse) Equal(other ResourceResponse) bool {
+	var a, b any
+	if json.Unmarshal(r.Raw, &a) != nil || json.Unmarshal(other.Raw, &b) != nil {
+		return bytes.Equal(r.Raw, other.Raw)
+	}
+	return Equal(a, b)
+}
+
+//
+// Aggregated requests
+//
+
+// ExtraTypeIDs is an extra which supports a list of ids (`ExtraType::Ids`).
+type ExtraTypeIDs struct {
+	// ExtraName is checked against the addon manifest to validate it's supported.
+	ExtraName string
+	// IDTypes are ordered `(id, type)` pairs, so that limiting keeps the first ones.
+	IDTypes [][2]string
+	// Limit is the requested limit of ids per addon.
+	Limit *int
+}
+
+// AggrRequest is a request planned against all the installed addons.
+type AggrRequest struct {
+	// Kind is one of AggrRequestAllCatalogs, AggrRequestCatalogsFiltered or AggrRequestAllOfResource.
+	Kind string
+	// Extra and Type are used by AllCatalogs.
+	Extra []ExtraValue
+	Type  *string
+	// ExtraTypes are used by CatalogsFiltered.
+	ExtraTypes []ExtraTypeIDs
+	// Path is used by AllOfResource.
+	Path ResourcePath
+}
+
+const (
+	AggrRequestAllCatalogs      = "AllCatalogs"
+	AggrRequestCatalogsFiltered = "CatalogsFiltered"
+	AggrRequestAllOfResource    = "AllOfResource"
+)
+
+// PlannedRequest is a request together with the addon it targets.
+type PlannedRequest struct {
+	Addon   *Descriptor
+	Request ResourceRequest
+}
+
+// Plan returns the requests to make to the given addons.
+func (a AggrRequest) Plan(addons []Descriptor) []PlannedRequest {
+	planned := []PlannedRequest{}
+	switch a.Kind {
+	case AggrRequestAllCatalogs:
+		for i := range addons {
+			addon := &addons[i]
+			for _, catalog := range addon.Manifest.Catalogs {
+				if !catalog.IsExtraSupported(a.Extra) {
+					continue
+				}
+				if a.Type != nil && catalog.Type != *a.Type {
+					continue
+				}
+				planned = append(planned, PlannedRequest{
+					Addon: addon,
+					Request: NewResourceRequest(addon.TransportURL, NewResourcePathWithExtra(
+						stremiocore.CATALOG_RESOURCE_NAME, catalog.Type, catalog.ID, a.Extra)),
+				})
+			}
+		}
+	case AggrRequestCatalogsFiltered:
+		extraNames := make([]string, 0, len(a.ExtraTypes))
+		for _, extraType := range a.ExtraTypes {
+			extraNames = append(extraNames, extraType.ExtraName)
+		}
+		for _, extraType := range a.ExtraTypes {
+			for i := range addons {
+				addon := &addons[i]
+				for _, catalog := range addon.Manifest.Catalogs {
+					if !catalog.AreExtraNamesSupported(extraNames) {
+						continue
+					}
+					if request, ok := planCatalogFiltered(addon, catalog, extraType); ok {
+						planned = append(planned, PlannedRequest{Addon: addon, Request: request})
+					}
+				}
+			}
+		}
+	case AggrRequestAllOfResource:
+		for i := range addons {
+			addon := &addons[i]
+			if addon.Manifest.IsResourceSupported(a.Path) {
+				planned = append(planned, PlannedRequest{
+					Addon:   addon,
+					Request: NewResourceRequest(addon.TransportURL, NewResourcePathWithExtra(a.Path.Resource, a.Path.Type, a.Path.ID, a.Path.Extra)),
+				})
+			}
+		}
+	}
+	return planned
+}
+
+func idSupportedByPrefixes(prefixes []string, id string) bool {
+	if prefixes == nil || len(prefixes) == 0 {
+		return true
+	}
+	for _, prefix := range prefixes {
+		if strings.HasPrefix(id, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+func planCatalogFiltered(addon *Descriptor, catalog ManifestCatalog, extraType ExtraTypeIDs) (ResourceRequest, bool) {
+	supportedIDs := []string{}
+	for _, idType := range extraType.IDTypes {
+		id, itemType := idType[0], idType[1]
+		catalogResourceSupported := false
+		for _, resource := range addon.Manifest.Resources {
+			if resource.Name != stremiocore.CATALOG_RESOURCE_NAME {
+				continue
+			}
+			if !resource.Full {
+				catalogResourceSupported = true
+				break
+			}
+			typeSupported := resource.Types == nil || containsString(resource.Types, itemType)
+			if typeSupported && idSupportedByPrefixes(resource.IDPrefixes, id) {
+				catalogResourceSupported = true
+				break
+			}
+		}
+		if !catalogResourceSupported || catalog.Type != itemType {
+			continue
+		}
+		if !idSupportedByPrefixes(addon.Manifest.IDPrefixes, id) || !containsString(addon.Manifest.Types, itemType) {
+			continue
+		}
+		supportedIDs = append(supportedIDs, id)
+	}
+	if len(supportedIDs) == 0 {
+		return ResourceRequest{}, false
+	}
+	var extraLimit *int
+	for _, prop := range catalog.Extra.Props() {
+		if prop.Name == extraType.ExtraName {
+			limit := prop.OptionsLimit
+			extraLimit = &limit
+			break
+		}
+	}
+	requestLimit := math.MaxInt
+	switch {
+	case extraLimit != nil && extraType.Limit != nil:
+		requestLimit = min(*extraLimit, *extraType.Limit)
+	case extraLimit != nil:
+		requestLimit = *extraLimit
+	case extraType.Limit != nil:
+		requestLimit = *extraType.Limit
+	}
+	lastIndex := min(requestLimit, len(supportedIDs))
+	ids := append([]string{}, supportedIDs[:lastIndex]...)
+	if len(ids) == 0 {
+		return ResourceRequest{}, false
+	}
+	sort.Strings(ids)
+	extra := []ExtraValue{{Name: extraType.ExtraName, Value: strings.Join(ids, ",")}}
+	return NewResourceRequest(addon.TransportURL, NewResourcePathWithExtra(
+		stremiocore.CATALOG_RESOURCE_NAME, catalog.Type, catalog.ID, extra)), true
+}
+
+func containsString(values []string, value string) bool {
+	for _, v := range values {
+		if v == value {
+			return true
+		}
+	}
+	return false
+}
+
+func nonNilSlice[T any](values []T) []T {
+	if values == nil {
+		return []T{}
+	}
+	return values
+}
diff --git a/types/resource_test.go b/types/resource_test.go
