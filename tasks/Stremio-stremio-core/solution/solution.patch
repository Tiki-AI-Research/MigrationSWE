+)
+
+func updateStreamingServerURLs(env runtime.Env, urls *types.ServerUrlsBucket, status *CtxStatus, m *msg.Msg) runtime.Effects {
+	if isCtxAction(m, msg.ActionCtxAddServerURL) {
+		url, ok := decodeURLArg(m, msg.ActionCtxAddServerURL)
+		if !ok {
+			return runtime.NoneEffects().Unchanged()
+		}
+		urls.AddURL(url, env.Now())
+		return streamingServerURLsChangedEffects()
+	}
+	if isCtxAction(m, msg.ActionCtxDeleteServerURL) {
+		url, ok := decodeURLArg(m, msg.ActionCtxDeleteServerURL)
+		if !ok {
+			return runtime.NoneEffects().Unchanged()
+		}
+		urls.DeleteURL(url)
+		return streamingServerURLsChangedEffects()
+	}
+	if result, ok := InternalCtxAuthResultData(m); ok {
+		if !status.IsLoading(result.AuthRequest) || result.Response == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		*urls = types.NewServerUrlsBucket(env.Now(), types.NewUID(result.Response.Auth.User.ID))
+		return streamingServerURLsChangedEffects()
+	}
+	if m.IsInternal(msg.InternalStreamingServerUrlsBucketChanged) {
+		return runtime.OneEffect(pushServerURLsToStorage(env, urls)).Unchanged()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func streamingServerURLsChangedEffects() runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerUrlsBucketChanged, nil)))
+}
+
+func pushServerURLsToStorage(env runtime.Env, urls *types.ServerUrlsBucket) runtime.Effect {
+	return common.StorageFuture(env, stremiocore.STREAMING_SERVER_URLS_STORAGE_KEY, *urls,
+		storageResult(msg.UIDEvent(msg.EventStreamingServerUrlsPushedToStorage, urls.UID)))
+}
