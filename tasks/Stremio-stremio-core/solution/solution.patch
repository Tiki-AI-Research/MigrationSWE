diff --git a/addon_transport/http_transport.go b/addon_transport/http_transport.go
new file mode 100644
index 0000000000000000000000000000000000000000..367483c272e06adc83741df49e1178dcff0470f7
--- /dev/null
+++ b/addon_transport/http_transport.go
@@ -0,0 +1,91 @@
+package addontransport
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+// AddonHTTPTransport requests the resources of an addon over HTTP:
+// `{base}/{resource}/{type}/{id}[/{extra}].json`.
+type AddonHTTPTransport struct {
+	transportURL string
+	env          runtime.Env
+}
+
+// NewAddonHTTPTransport creates the HTTP transport of the addon.
+func NewAddonHTTPTransport(transportURL string, env runtime.Env) *AddonHTTPTransport {
+	return &AddonHTTPTransport{transportURL: transportURL, env: env}
+}
+
+func (t *AddonHTTPTransport) isLegacy() bool {
+	return strings.HasSuffix(types.URLPath(t.transportURL), stremiocore.ADDON_LEGACY_PATH)
+}
+
+// ResourceURL returns the url of the resource; all the components are
+// percent-encoded and the extra values are query encoded.
+func ResourceURL(transportURL string, path types.ResourcePath) (string, *runtime.EnvError) {
+	if !strings.HasSuffix(types.URLPath(transportURL), stremiocore.ADDON_MANIFEST_PATH) {
+		return "", runtime.EnvErrorAddonTransport("addon http transport url must ends with " + stremiocore.ADDON_MANIFEST_PATH)
+	}
+	var resourcePath string
+	if len(path.Extra) == 0 {
+		resourcePath = fmt.Sprintf("/%s/%s/%s.json",
+			types.EncodeURIComponent(path.Resource),
+			types.EncodeURIComponent(path.Type),
+			types.EncodeURIComponent(path.ID))
+	} else {
+		resourcePath = fmt.Sprintf("/%s/%s/%s/%s.json",
+			types.EncodeURIComponent(path.Resource),
+			types.EncodeURIComponent(path.Type),
+			types.EncodeURIComponent(path.ID),
+			types.QueryParamsEncode(types.ExtraValuesQueryParams(path.Extra)))
+	}
+	url := strings.ReplaceAll(types.NormalizeURL(transportURL), stremiocore.ADDON_MANIFEST_PATH, resourcePath)
+	cinemetaAddonsCatalogURL := strings.ReplaceAll(stremiocore.CINEMETA_URL, stremiocore.ADDON_MANIFEST_PATH, "/addon_catalog/all/community.json")
+	if replaceURL := os.Getenv("CINEMETA_ADDONS_CATALOG_URL"); replaceURL != "" && strings.Contains(url, cinemetaAddonsCatalogURL) {
+		url = strings.ReplaceAll(url, cinemetaAddonsCatalogURL, replaceURL)
+	}
+	return url, nil
+}
+
+// Resource requests the resource from the addon.
+func (t *AddonHTTPTransport) Resource(path types.ResourcePath) (types.ResourceResponse, *runtime.EnvError) {
+	if t.isLegacy() {
+		return NewAddonLegacyTransport(t.transportURL, t.env).Resource(path)
+	}
+	url, envErr := ResourceURL(t.transportURL, path)
+	if envErr != nil {
+		return types.ResourceResponse{}, envErr
+	}
+	body, envErr := t.env.Fetch("GET", url, map[string]string{}, nil)
+	if envErr != nil {
+		return types.ResourceResponse{}, envErr
+	}
+	response, err := types.ParseResourceResponse(body)
+	if err != nil {
+		return types.ResourceResponse{}, runtime.EnvErrorSerde(err.Error())
+	}
+	return response, nil
+}
+
+// Manifest requests the manifest of the addon.
+func (t *AddonHTTPTransport) Manifest() (types.Manifest, *runtime.EnvError) {
+	if t.isLegacy() {
+		return NewAddonLegacyTransport(t.transportURL, t.env).Manifest()
+	}
+	body, envErr := t.env.Fetch("GET", types.NormalizeURL(t.transportURL), map[string]string{}, nil)
+	if envErr != nil {
+		return types.Manifest{}, envErr
+	}
+	var manifest types.Manifest
+	if err := json.Unmarshal(body, &manifest); err != nil {
+		return types.Manifest{}, runtime.EnvErrorSerde(err.Error())
+	}
+	return manifest, nil
+}
diff --git a/addon_transport/legacy.go b/addon_transport/legacy.go
new file mode 100644
index 0000000000000000000000000000000000000000..883138e4306a56df887fed435ed4d1042252f4e0
--- /dev/null
+++ b/addon_transport/legacy.go
@@ -0,0 +1,329 @@
+package addontransport
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+const (
+	imdbPrefix = "tt"
+	ytPrefix   = "UC"
+	// base64 of {"params":[],"method":"meta","id":1,"jsonrpc":"2.0"}
+	manifestRequestParam = "eyJwYXJhbXMiOltdLCJtZXRob2QiOiJtZXRhIiwiaWQiOjEsImpzb25ycGMiOiIyLjAifQ=="
+)
+
+// LegacyErrKind is the kind of a legacy transport error.
+type LegacyErrKind int
+
+const (
+	// LegacyJSONRPC is an error returned by the JSON-RPC server.
+	LegacyJSONRPC LegacyErrKind = iota
+	// LegacyUnsupportedResource is a resource the legacy transport doesn't support.
+	LegacyUnsupportedResource
+	// LegacyUnsupportedRequest is a request the legacy transport doesn't support.
+	LegacyUnsupportedRequest
+)
+
+// LegacyErr is an error of the legacy transport.
+type LegacyErr struct {
+	Kind    LegacyErrKind
+	Code    int
+	Message string
+}
+
+func (e *LegacyErr) Error() string {
+	return e.ToEnvError().Message
+}
+
+// ToEnvError converts the error to an addon transport error.
+func (e *LegacyErr) ToEnvError() *runtime.EnvError {
+	switch e.Kind {
+	case LegacyJSONRPC:
+		return runtime.EnvErrorAddonTransport(fmt.Sprintf("rpc error %d: %s", e.Code, e.Message))
+	case LegacyUnsupportedResource:
+		return runtime.EnvErrorAddonTransport("legacy transport: unsupported resource")
+	}
+	return runtime.EnvErrorAddonTransport("legacy transport: unsupported request")
+}
+
+// JSONRPCErr is the error of a JSON-RPC response.
+type JSONRPCErr struct {
+	Message string `json:"message"`
+	Code    int    `json:"code"`
+}
+
+// JSONRPCResp is a JSON-RPC response: either `{"result": ...}` or
+// `{"error": {"message": ..., "code": ...}}`.
+type JSONRPCResp struct {
+	Result json.RawMessage
+	Error  *JSONRPCErr
+}
+
+func (r *JSONRPCResp) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Result json.RawMessage `json:"result"`
+		Error  json.RawMessage `json:"error"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	*r = JSONRPCResp{}
+	if wire.Result != nil {
+		r.Result = wire.Result
+		return nil
+	}
+	if wire.Error != nil {
+		var rpcErr struct {
+			Message *string `json:"message"`
+			Code    int     `json:"code"`
+		}
+		if err := json.Unmarshal(wire.Error, &rpcErr); err != nil {
+			return err
+		}
+		if rpcErr.Message == nil {
+			return errors.New("missing field `message`")
+		}
+		r.Error = &JSONRPCErr{Message: *rpcErr.Message, Code: rpcErr.Code}
+		return nil
+	}
+	return errors.New("data did not match any variant of untagged enum JsonRPCResp")
+}
+
+// Parse returns the result of the response, or the JSON-RPC error.
+func (r JSONRPCResp) Parse() (json.RawMessage, *LegacyErr) {
+	if r.Error != nil && r.Result == nil {
+		return nil, &LegacyErr{Kind: LegacyJSONRPC, Code: r.Error.Code, Message: r.Error.Message}
+	}
+	return r.Result, nil
+}
+
+// AddonLegacyTransport requests the resources of a legacy (`/stremio/v1`)
+// addon with the JSON-RPC protocol.
+type AddonLegacyTransport struct {
+	transportURL string
+	env          runtime.Env
+}
+
+// NewAddonLegacyTransport creates the legacy transport of the addon.
+func NewAddonLegacyTransport(transportURL string, env runtime.Env) *AddonLegacyTransport {
+	return &AddonLegacyTransport{transportURL: transportURL, env: env}
+}
+
+func (t *AddonLegacyTransport) fetch(url string) (json.RawMessage, *runtime.EnvError) {
+	body, envErr := t.env.Fetch("GET", url, map[string]string{}, nil)
+	if envErr != nil {
+		return nil, envErr
+	}
+	var response JSONRPCResp
+	if err := json.Unmarshal(body, &response); err != nil {
+		return nil, runtime.EnvErrorSerde(err.Error())
+	}
+	result, legacyErr := response.Parse()
+	if legacyErr != nil {
+		return nil, legacyErr.ToEnvError()
+	}
+	return result, nil
+}
+
+func decodeResult[T any](result json.RawMessage) (T, *runtime.EnvError) {
+	var value T
+	if err := json.Unmarshal(result, &value); err != nil {
+		return value, runtime.EnvErrorSerde(err.Error())
+	}
+	return value, nil
+}
+
+// Resource requests the resource from the legacy addon.
+func (t *AddonLegacyTransport) Resource(path types.ResourcePath) (types.ResourceResponse, *runtime.EnvError) {
+	url, envErr := BuildLegacyReq(t.transportURL, path)
+	if envErr != nil {
+		return types.ResourceResponse{}, envErr
+	}
+	switch path.Resource {
+	case "catalog", "meta", "stream", "subtitles":
+	default:
+		return types.ResourceResponse{}, (&LegacyErr{Kind: LegacyUnsupportedResource}).ToEnvError()
+	}
+	result, envErr := t.fetch(url)
+	if envErr != nil {
+		return types.ResourceResponse{}, envErr
+	}
+	switch path.Resource {
+	case "catalog":
+		metas, envErr := decodeResult[[]types.MetaItemPreview](result)
+		if envErr != nil {
+			return types.ResourceResponse{}, envErr
+		}
+		return types.NewResourceResponse(types.ResourceResponseMetas, nonNil(metas)), nil
+	case "meta":
+		meta, envErr := decodeResult[types.MetaItem](result)
+		if envErr != nil {
+			return types.ResourceResponse{}, envErr
+		}
+		return types.NewResourceResponse(types.ResourceResponseMeta, meta), nil
+	case "stream":
+		streams, envErr := decodeResult[[]types.Stream](result)
+		if envErr != nil {
+			return types.ResourceResponse{}, envErr
+		}
+		return types.NewResourceResponse(types.ResourceResponseStreams, nonNil(streams)), nil
+	default:
+		subtitles, envErr := decodeResult[struct {
+			ID  string            `json:"id"`
+			All []types.Subtitles `json:"all"`
+		}](result)
+		if envErr != nil {
+			return types.ResourceResponse{}, envErr
+		}
+		return types.NewResourceResponse(types.ResourceResponseSubtitles, nonNil(subtitles.All)), nil
+	}
+}
+
+// Manifest requests the manifest of the legacy addon.
+func (t *AddonLegacyTransport) Manifest() (types.Manifest, *runtime.EnvError) {
+	url := fmt.Sprintf("%s/q.json?b=%s", types.NormalizeURL(t.transportURL), manifestRequestParam)
+	result, envErr := t.fetch(url)
+	if envErr != nil {
+		return types.Manifest{}, envErr
+	}
+	response, envErr := decodeResult[legacyManifestResp](result)
+	if envErr != nil {
+		return types.Manifest{}, envErr
+	}
+	return response.Manifest.toManifest(), nil
+}
+
+func nonNil[T any](values []T) []T {
+	if values == nil {
+		return []T{}
+	}
+	return values
+}
+
+// BuildLegacyReq builds the url of the JSON-RPC request for the resource:
+// `{transport_url}/q.json?b={base64 of the JSON-RPC body}`. Subtitles hashes
+// are supported, searching is not.
+func BuildLegacyReq(transportURL string, path types.ResourcePath) (string, *runtime.EnvError) {
+	var body map[string]any
+	switch path.Resource {
+	case "catalog":
+		query := map[string]any{"type": path.Type}
+		if genre := path.GetExtraFirstValue("genre"); genre != nil {
+			query["genre"] = *genre
+		}
+		var sort any
+		if path.ID != "top" {
+			sort = map[string]any{path.ID: -1, "popularity": -1}
+		}
+		skip := uint64(0)
+		if value := path.GetExtraFirstValue("skip"); value != nil {
+			if parsed, err := strconv.ParseUint(*value, 10, 32); err == nil {
+				skip = parsed
+			}
+		}
+		body = buildJSONRPC("meta.find", map[string]any{
+			"query": query,
+			"limit": 100,
+			"sort":  sort,
+			"skip":  skip,
+		})
+	case "meta":
+		body = buildJSONRPC("meta.get", map[string]any{"query": queryFromID(path.ID)})
+	case "stream":
+		query, ok := queryFromID(path.ID).(map[string]any)
+		if !ok {
+			return "", runtime.EnvErrorAddonTransport("legacy: stream request without a valid id")
+		}
+		query["type"] = path.Type
+		body = buildJSONRPC("stream.find", map[string]any{"query": query})
+	case "subtitles":
+		query := map[string]any{"itemHash": strings.ReplaceAll(path.ID, ":", " ")}
+		if videoHash := path.GetExtraFirstValue(types.VIDEO_HASH_EXTRA_PROP.Name); videoHash != nil {
+			query[types.VIDEO_HASH_EXTRA_PROP.Name] = *videoHash
+		}
+		if videoSize := path.GetExtraFirstValue(types.VIDEO_SIZE_EXTRA_PROP.Name); videoSize != nil {
+			if number, ok := parseJSONNumber(*videoSize); ok {
+				query[types.VIDEO_SIZE_EXTRA_PROP.Name] = number
+			}
+		}
+		if filename := path.GetExtraFirstValue(types.VIDEO_FILENAME_EXTRA_PROP.Name); filename != nil {
+			query[types.VIDEO_FILENAME_EXTRA_PROP.Name] = *filename
+		}
+		body = buildJSONRPC("subtitles.find", map[string]any{"query": query})
+	default:
+		return "", (&LegacyErr{Kind: LegacyUnsupportedRequest}).ToEnvError()
+	}
+	// NOTE: this is not using a URL safe base64 standard, the original
+	// stremio-addons implementation works the same way.
+	data, err := types.MarshalJSON(body)
+	if err != nil {
+		return "", runtime.EnvErrorSerde(err.Error())
+	}
+	param := base64.StdEncoding.EncodeToString(data)
+	return fmt.Sprintf("%s/q.json?b=%s", types.NormalizeURL(transportURL), param), nil
+}
+
+func parseJSONNumber(value string) (json.Number, bool) {
+	decoder := json.NewDecoder(bytes.NewReader([]byte(value)))
+	decoder.UseNumber()
+	var number any
+	if err := decoder.Decode(&number); err != nil || decoder.More() {
+		return "", false
+	}
+	n, ok := number.(json.Number)
+	return n, ok
+}
+
+func buildJSONRPC(method string, params any) map[string]any {
+	return map[string]any{
+		"params":  []any{nil, params},
+		"method":  method,
+		"id":      1,
+		"jsonrpc": "2.0",
+	}
+}
+
+func parseU16OrOne(value string) uint64 {
+	parsed, err := strconv.ParseUint(value, 10, 16)
+	if err != nil {
+		return 1
+	}
+	return parsed
+}
+
+// queryFromID converts an id to the legacy query: `tt...[:season:episode]`,
+// `UC...[:video_id]` or `{prefix}:{id}[:video_id]`.
+func queryFromID(id string) any {
+	parts := strings.Split(id, ":")
+	if strings.HasPrefix(id, imdbPrefix) {
+		if len(parts) == 3 {
+			return map[string]any{
+				"imdb_id": parts[0],
+				"season":  parseU16OrOne(parts[1]),
+				"episode": parseU16OrOne(parts[2]),
+			}
+		}
+		return map[string]any{"imdb_id": parts[0]}
+	}
+	if strings.HasPrefix(id, ytPrefix) {
+		if len(parts) == 2 {
+			return map[string]any{"yt_id": parts[0], "video_id": parts[1]}
+		}
+		return map[string]any{"yt_id": parts[0]}
+	}
+	switch len(parts) {
+	case 3:
+		return map[string]any{parts[0]: parts[1], "video_id": parts[2]}
+	case 2:
+		return map[string]any{parts[0]: parts[1]}
+	}
+	return nil
+}
diff --git a/addon_transport/legacy_manifest.go b/addon_transport/legacy_manifest.go
new file mode 100644
index 0000000000000000000000000000000000000000..c2bf437fc1c0155771062fa8038d76d107e662a5
--- /dev/null
+++ b/addon_transport/legacy_manifest.go
@@ -0,0 +1,153 @@
+package addontransport
+
+import (
+	"encoding/json"
+	"errors"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+// legacyIDProperty is either a single id property or many.
+type legacyIDProperty []string
+
+func (p *legacyIDProperty) UnmarshalJSON(data []byte) error {
+	var one string
+	if err := json.Unmarshal(data, &one); err == nil {
+		*p = []string{one}
+		return nil
+	}
+	var many []string
+	if err := json.Unmarshal(data, &many); err != nil {
+		return errors.New("data did not match any variant of untagged enum LegacyIdProperty")
+	}
+	*p = many
+	return nil
+}
+
+type legacySort struct {
+	Name  *string  `json:"name"`
+	ID    string   `json:"prop"`
+	Types []string `json:"types"`
+}
+
+// legacyManifestResp is the JSON-RPC result of the manifest request, which
+// contains `{manifest, methods}`; the methods are also in the manifest.
+type legacyManifestResp struct {
+	Manifest legacyManifest `json:"manifest"`
+}
+
+type legacyManifest struct {
+	ID           string            `json:"id"`
+	Name         string            `json:"name"`
+	Description  *string           `json:"description"`
+	Logo         *string           `json:"logo"`
+	Background   *string           `json:"background"`
+	Version      string            `json:"version"`
+	Methods      []string          `json:"methods"`
+	Types        []string          `json:"types"`
+	ContactEmail *string           `json:"contactEmail"`
+	IDProperty   *legacyIDProperty `json:"idProperty"`
+	Sorts        *[]legacySort     `json:"sorts"`
+}
+
+func (m *legacyManifest) UnmarshalJSON(data []byte) error {
+	type alias legacyManifest
+	var wire struct {
+		alias
+		ID      *string   `json:"id"`
+		Name    *string   `json:"name"`
+		Version *string   `json:"version"`
+		Methods *[]string `json:"methods"`
+		Types   *[]string `json:"types"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.ID == nil || wire.Name == nil || wire.Version == nil || wire.Methods == nil || wire.Types == nil {
+		return errors.New("missing field of LegacyManifest")
+	}
+	if _, err := types.ParseVersion(*wire.Version); err != nil {
+		return err
+	}
+	*m = legacyManifest(wire.alias)
+	m.ID, m.Name, m.Version, m.Methods, m.Types = *wire.ID, *wire.Name, *wire.Version, *wire.Methods, *wire.Types
+	return nil
+}
+
+func contains(values []string, value string) bool {
+	for _, v := range values {
+		if v == value {
+			return true
+		}
+	}
+	return false
+}
+
+func validURL(value *string) *string {
+	if value == nil || !types.IsValidURL(*value) {
+		return nil
+	}
+	normalized := types.NormalizeURL(*value)
+	return &normalized
+}
+
+// toManifest maps the legacy manifest: a catalog for each type of each sort
+// (or `top` catalogs for each type) and the resources from the methods.
+func (m legacyManifest) toManifest() types.Manifest {
+	catalogs := []types.ManifestCatalog{}
+	if contains(m.Methods, "meta.find") {
+		if m.Sorts != nil {
+			for _, sort := range *m.Sorts {
+				sortTypes := m.Types
+				if sort.Types != nil {
+					sortTypes = sort.Types
+				}
+				for _, t := range sortTypes {
+					catalogs = append(catalogs, types.ManifestCatalog{Type: t, ID: sort.ID, Name: sort.Name})
+				}
+			}
+		} else {
+			for _, t := range m.Types {
+				catalogs = append(catalogs, types.ManifestCatalog{Type: t, ID: "top"})
+			}
+		}
+	}
+	var idPrefixes []string
+	if m.IDProperty != nil {
+		idPrefixes = []string{}
+		for _, property := range *m.IDProperty {
+			switch property {
+			case "imdb_id":
+				idPrefixes = append(idPrefixes, "tt")
+			case "yt_id":
+				idPrefixes = append(idPrefixes, "UC")
+			default:
+				idPrefixes = append(idPrefixes, property+":")
+			}
+		}
+	}
+	resources := []types.ManifestResource{}
+	if contains(m.Methods, "meta.get") {
+		resources = append(resources, types.ManifestResource{Name: "meta"})
+	}
+	if contains(m.Methods, "stream.find") {
+		resources = append(resources, types.ManifestResource{Name: "stream"})
+	}
+	if contains(m.Methods, "subtitles.find") {
+		resources = append(resources, types.ManifestResource{Name: "subtitles"})
+	}
+	return types.Manifest{
+		ID:            m.ID,
+		Name:          m.Name,
+		Version:       m.Version,
+		Resources:     resources,
+		Types:         nonNil(m.Types),
+		Catalogs:      catalogs,
+		AddonCatalogs: []types.ManifestCatalog{},
+		Background:    validURL(m.Background),
+		Logo:          validURL(m.Logo),
+		IDPrefixes:    idPrefixes,
+		Description:   m.Description,
+		ContactEmail:  m.ContactEmail,
+	}
+}
diff --git a/addon_transport/transport.go b/addon_transport/transport.go
new file mode 100644
index 0000000000000000000000000000000000000000..a94f02991abdf29b8ac38fbead3d71ac3e5f82c1
--- /dev/null
+++ b/addon_transport/transport.go
@@ -0,0 +1,48 @@
+// Package addontransport implements the addon protocol clients: the HTTP
+// transport, the legacy JSON-RPC transport and the unsupported transport.
+package addontransport
+
+import (
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+func init() {
+	runtime.DefaultAddonTransport = func(transportURL string, env runtime.Env) runtime.AddonTransport {
+		return NewTransport(transportURL, env)
+	}
+}
+
+// NewTransport returns the transport for the transport url: the HTTP
+// transport for `http(s)` urls and the unsupported transport otherwise.
+func NewTransport(transportURL string, env runtime.Env) runtime.AddonTransport {
+	switch types.URLScheme(transportURL) {
+	case "http", "https":
+		return NewAddonHTTPTransport(transportURL, env)
+	}
+	return NewUnsupportedTransport(transportURL)
+}
+
+// UnsupportedTransport fails all the requests of an unsupported transport.
+type UnsupportedTransport struct {
+	transportURL string
+}
+
+// NewUnsupportedTransport creates an unsupported transport.
+func NewUnsupportedTransport(transportURL string) *UnsupportedTransport {
+	return &UnsupportedTransport{transportURL: transportURL}
+}
+
+func (t *UnsupportedTransport) err() *runtime.EnvError {
+	return runtime.EnvErrorAddonTransport("Unsupported addon transport: " + types.URLScheme(t.transportURL))
+}
+
+// Resource fails with an addon transport error.
+func (t *UnsupportedTransport) Resource(path types.ResourcePath) (types.ResourceResponse, *runtime.EnvError) {
+	return types.ResourceResponse{}, t.err()
+}
+
+// Manifest fails with an addon transport error.
+func (t *UnsupportedTransport) Manifest() (types.Manifest, *runtime.EnvError) {
+	return types.Manifest{}, t.err()
+}
