+// playerFetchHandler answers the given urls with the given bodies; other
+// requests fail with a fetch error.
+func playerFetchHandler(responses map[string]string) func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+	return func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		if response, ok := responses[url]; ok {
+			return []byte(response), nil
+		}
+		return nil, runtime.EnvErrorFetch("Unhandled fetch request: " + url)
+	}
