+func ptr[T any](value T) *T {
+	return &value
+}
+
+func assertEqual[T comparable](t *testing.T, actual, expected T, context ...string) {
+	t.Helper()
+	if actual != expected {
+		t.Errorf("%s\n got: %v\nwant: %v", strings.Join(context, " "), actual, expected)
+	}
+}
+
+func assertStrPtr(t *testing.T, actual, expected *string, context ...string) {
+	t.Helper()
+	switch {
+	case actual == nil && expected == nil:
+	case actual == nil || expected == nil:
+		t.Errorf("%s\n got: %v\nwant: %v", strings.Join(context, " "), optString(actual), optString(expected))
+	case *actual != *expected:
+		t.Errorf("%s\n got: %q\nwant: %q", strings.Join(context, " "), *actual, *expected)
+	}
+}
+
+func optString(value *string) string {
+	if value == nil {
+		return "<nil>"
+	}
+	return `"` + *value + `"`
+}
+
+func assertJSON(t *testing.T, value any, expected string) {
+	t.Helper()
+	actual, err := types.MarshalJSON(value)
+	if err != nil {
+		t.Fatalf("serialization failed: %v", err)
+	}
+	if string(actual) != expected {
+		t.Errorf("serialization\n got: %s\nwant: %s", actual, expected)
+	}
+}
+
+// queryParam returns the decoded value of the query parameter of the link.
+func queryParam(t *testing.T, link, name string) string {
+	t.Helper()
+	parsed, err := url.Parse(link)
+	if err != nil {
+		t.Fatalf("invalid link %q: %v", link, err)
+	}
+	values := parsed.Query()
+	if !values.Has(name) {
+		t.Fatalf("link %q has no %q query parameter", link, name)
+	}
+	return values.Get(name)
+}
