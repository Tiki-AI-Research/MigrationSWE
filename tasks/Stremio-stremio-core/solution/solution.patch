+//
+// Responses
+//
+
+// APIError is an error returned by the API.
+type APIError struct {
+	Message string `json:"message"`
+	Code    uint64 `json:"code"`
+}
+
+func (e *APIError) Error() string {
+	return fmt.Sprintf("API error %d: %s", e.Code, e.Message)
+}
+
+// ParseAPIResult decodes an API response, i.e. either `{"result": ...}` or
+// `{"error": {"message": ..., "code": ...}}`, into the result value.
+func ParseAPIResult(data []byte, result any) (*APIError, error) {
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(data, &object); err != nil {
+		return nil, err
+	}
+	if len(object) != 1 {
+		return nil, errors.New("invalid value: map, expected map with a single key")
+	}
+	if raw, ok := object["error"]; ok {
+		var apiErr APIError
+		if isJSONNull(raw) {
+			return nil, errors.New("invalid type: null, expected struct APIError")
+		}
+		if err := json.Unmarshal(raw, &apiErr); err != nil {
+			return nil, err
+		}
+		return &apiErr, nil
+	}
+	raw, ok := object["result"]
+	if !ok {
+		return nil, errors.New("unknown variant, expected `error` or `result`")
+	}
+	if err := json.Unmarshal(raw, result); err != nil {
+		return nil, err
+	}
+	return nil, nil
+}
+
+// CollectionResponse is the response of AddonCollectionGet.
+type CollectionResponse struct {
+	Addons       []Descriptor
+	LastModified time.Time
