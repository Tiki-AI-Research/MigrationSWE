@@ -0,0 +1,82 @@
+package types
+
+import (
+	"bufio"
+	"encoding/json"
+	"os"
+	"strings"
+	"testing"
+)
+
+// fixtures are serialized by the rust implementation (serde_json::to_string)
+func loadFixtures(t *testing.T) map[string]string {
+	t.Helper()
+	file, err := os.Open("testdata/serde_fixtures.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	fixtures := map[string]string{}
+	scanner := bufio.NewScanner(file)
+	scanner.Buffer(make([]byte, 1<<20), 1<<22)
+	for scanner.Scan() {
+		name, value, ok := strings.Cut(scanner.Text(), " ")
+		if ok {
+			fixtures[name] = value
+		}
+	}
+	return fixtures
+}
+
+func assertRoundTrip[T any](t *testing.T, name, data string) T {
+	t.Helper()
+	var value T
+	if err := json.Unmarshal([]byte(data), &value); err != nil {
+		t.Fatalf("%s: unmarshal failed: %v", name, err)
+	}
+	serialized, err := MarshalJSON(value)
+	if err != nil {
+		t.Fatalf("%s: marshal failed: %v", name, err)
+	}
+	if string(serialized) != data {
+		t.Fatalf("%s: round trip mismatch\n got: %s\nwant: %s", name, serialized, data)
+	}
+	return value
+}
+
+func TestSerdeRoundTripMatchesRust(t *testing.T) {
+	fixtures := loadFixtures(t)
+	assertRoundTrip[Profile](t, "PROFILE", fixtures["PROFILE"])
+	profile := assertRoundTrip[Profile](t, "PROFILE_AUTH", fixtures["PROFILE_AUTH"])
+	if profile.Auth == nil || profile.Auth.User.Trakt == nil || *profile.Settings.PlayerType != "vlc" {
+		t.Fatalf("unexpected profile %+v", profile)
+	}
+	library := assertRoundTrip[LibraryBucket](t, "LIBRARY", fixtures["LIBRARY"])
+	if item := library.Items["tt1"]; item.State.TimeOffset != 20 || item.State.Watched == nil {
+		t.Fatalf("unexpected library item %+v", item)
+	}
+	assertRoundTrip[LibraryBucket](t, "LIBRARY2", fixtures["LIBRARY2"])
+	assertRoundTrip[NotificationsBucket](t, "NOTIFICATIONS", fixtures["NOTIFICATIONS"])
+	assertRoundTrip[NotificationsBucket](t, "NOTIFICATIONS2", fixtures["NOTIFICATIONS2"])
+	assertRoundTrip[SearchHistoryBucket](t, "SEARCH", fixtures["SEARCH"])
+	assertRoundTrip[ServerUrlsBucket](t, "SERVERURLS", fixtures["SERVERURLS"])
+	assertRoundTrip[DismissedEventsBucket](t, "DISMISSED", fixtures["DISMISSED"])
+	assertRoundTrip[StreamsBucket](t, "STREAMS", fixtures["STREAMS"])
+	assertRoundTrip[StreamsBucket](t, "STREAMS_EMPTY", fixtures["STREAMS_EMPTY"])
+	assertRoundTrip[MetaItem](t, "META", fixtures["META"])
+}
+
+func TestDefaultsMatchRust(t *testing.T) {
+	fixtures := loadFixtures(t)
+	profile, err := MarshalJSON(NewProfile())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(profile) != fixtures["PROFILE"] {
+		t.Fatalf("default profile mismatch\n got: %s\nwant: %s", profile, fixtures["PROFILE"])
+	}
+	streams, _ := MarshalJSON(NewStreamsBucket(nil))
+	if string(streams) != fixtures["STREAMS_EMPTY"] {
+		t.Fatalf("streams bucket mismatch: %s", streams)
+	}
+}
diff --git a/types/stream.go b/types/stream.go
new file mode 100644
index 0000000000000000000000000000000000000000..b59c51e6728740bc18dfc5b39b69ab4bb2ecaf28
--- /dev/null
+++ b/types/stream.go
@@ -0,0 +1,1318 @@
+package types
+
+import (
+	"bytes"
+	"compress/zlib"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"sort"
+	"strconv"
+	"strings"
+
+	stremiocore "github.com/stremio/stremio-core"
+)
+
+// Stream source kinds.
+const (
+	StreamSourceURL         = "url"
+	StreamSourceYouTube     = "youTube"
+	StreamSourceRar         = "rar"
+	StreamSourceZip         = "zip"
+	StreamSourceZip7        = "zip7"
+	StreamSourceTgz         = "tgz"
+	StreamSourceTar         = "tar"
+	StreamSourceNzb         = "nzb"
+	StreamSourceTorrent     = "torrent"
+	StreamSourcePlayerFrame = "playerFrame"
+	StreamSourceExternal    = "external"
+)
+
+// ArchiveURL is an archive part url with its optional size in bytes,
+// (de)serialized as `[url]` or `[url, bytes]`.
+type ArchiveURL struct {
+	URL   string
+	Bytes *uint64
+}
+
+func (a ArchiveURL) MarshalJSON() ([]byte, error) {
+	if a.Bytes == nil {
+		return MarshalJSON([]any{a.URL})
+	}
+	return MarshalJSON([]any{a.URL, *a.Bytes})
+}
+
+func (a *ArchiveURL) UnmarshalJSON(data []byte) error {
+	var tuple []json.RawMessage
+	if err := json.Unmarshal(data, &tuple); err != nil {
+		return err
+	}
+	if len(tuple) < 1 || len(tuple) > 2 {
+		return fmt.Errorf("invalid length %d, expected tuple struct ArchiveUrlShort", len(tuple))
+	}
+	var url string
+	if err := json.Unmarshal(tuple[0], &url); err != nil {
+		return err
+	}
+	if !IsValidURL(url) {
+		return fmt.Errorf("invalid archive url: %s", url)
+	}
+	*a = ArchiveURL{URL: url}
+	if len(tuple) == 2 && !isJSONNull(tuple[1]) {
+		var size uint64
+		if err := json.Unmarshal(tuple[1], &size); err != nil {
+			return err
+		}
+		a.Bytes = &size
+	}
+	return nil
+}
+
+// StreamSource is the source of a stream. Kind selects the variant and only
+// the fields of that variant are meaningful.
+type StreamSource struct {
+	Kind string
+	// URL is used by the `url` kind.
+	URL string
+	// YtID is used by the `youTube` kind.
+	YtID string
+	// Urls, FileIdx and FileMustInclude are used by the archive kinds.
+	Urls            []ArchiveURL
+	FileIdx         *uint16
+	FileMustInclude []string
+	// NzbURL, NzbUrls and Servers are used by the `nzb` kind.
+	NzbURL  *string
+	NzbUrls []string
+	Servers []string
+	// InfoHash, FileIdx, Announce and FileMustInclude are used by the `torrent` kind.
+	InfoHash InfoHash
+	Announce []string
+	// PlayerFrameURL is used by the `playerFrame` kind.
+	PlayerFrameURL string
+	// ExternalURL, AndroidTvURL, TizenURL and WebosURL are used by the `external` kind.
+	ExternalURL  *string
+	AndroidTvURL *string
+	TizenURL     *string
+	WebosURL     *string
+}
+
+var archiveURLKeys = map[string]string{
+	StreamSourceRar:  "rarUrls",
+	StreamSourceZip:  "zipUrls",
+	StreamSourceZip7: "7zipUrls",
+	StreamSourceTgz:  "tgzUrls",
+	StreamSourceTar:  "tarUrls",
+}
+
+// IsArchive reports whether the source is a rar, zip, 7zip, tgz or tar archive.
+func (s StreamSource) IsArchive() bool {
+	_, ok := archiveURLKeys[s.Kind]
+	return ok
+}
+
+// fields returns the serialized fields of the source, in order.
+func (s StreamSource) fields() ([]byte, error) {
+	switch s.Kind {
+	case StreamSourceURL, "":
+		return MarshalJSON(struct {
+			URL string `json:"url"`
+		}{s.URL})
+	case StreamSourceYouTube:
+		return MarshalJSON(struct {
+			YtID string `json:"ytId"`
+		}{s.YtID})
+	case StreamSourceRar, StreamSourceZip, StreamSourceZip7:
+		urls, err := MarshalJSON(nonNilSlice(s.Urls))
+		if err != nil {
+			return nil, err
+		}
+		head := []byte(`{"` + archiveURLKeys[s.Kind] + `":` + string(urls) + `}`)
+		rest, err := MarshalJSON(struct {
+			FileIdx         *uint16  `json:"fileIdx"`
+			FileMustInclude []string `json:"fileMustInclude,omitempty"`
+		}{s.FileIdx, s.FileMustInclude})
+		if err != nil {
+			return nil, err
+		}
+		return mergeJSONObjects(head, rest), nil
+	case StreamSourceTgz, StreamSourceTar:
+		urls, err := MarshalJSON(nonNilSlice(s.Urls))
+		if err != nil {
+			return nil, err
+		}
+		head := []byte(`{"` + archiveURLKeys[s.Kind] + `":` + string(urls) + `}`)
+		rest, err := MarshalJSON(struct {
+			FileIdx         *uint16  `json:"fileIdx,omitempty"`
+			FileMustInclude []string `json:"fileMustInclude,omitempty"`
+		}{s.FileIdx, s.FileMustInclude})
+		if err != nil {
+			return nil, err
+		}
+		return mergeJSONObjects(head, rest), nil
+	case StreamSourceNzb:
+		return MarshalJSON(struct {
+			NzbURL  *string  `json:"nzbUrl,omitempty"`
+			NzbUrls []string `json:"nzbUrls,omitempty"`
+			Servers []string `json:"servers"`
+		}{s.NzbURL, s.NzbUrls, nonNilSlice(s.Servers)})
+	case StreamSourceTorrent:
+		return MarshalJSON(struct {
+			InfoHash        InfoHash `json:"infoHash"`
+			FileIdx         *uint16  `json:"fileIdx"`
+			Announce        []string `json:"announce"`
+			FileMustInclude []string `json:"fileMustInclude,omitempty"`
+		}{s.InfoHash, s.FileIdx, nonNilSlice(s.Announce), s.FileMustInclude})
+	case StreamSourcePlayerFrame:
+		return MarshalJSON(struct {
+			PlayerFrameURL string `json:"playerFrameUrl"`
+		}{s.PlayerFrameURL})
+	case StreamSourceExternal:
+		return MarshalJSON(struct {
+			ExternalURL  *string `json:"externalUrl,omitempty"`
+			AndroidTvURL *string `json:"androidTvUrl,omitempty"`
+			TizenURL     *string `json:"tizenUrl,omitempty"`
+			WebosURL     *string `json:"webosUrl,omitempty"`
+		}{s.ExternalURL, s.AndroidTvURL, s.TizenURL, s.WebosURL})
+	}
+	return nil, fmt.Errorf("unknown stream source kind %q", s.Kind)
+}
+
+func (s StreamSource) MarshalJSON() ([]byte, error) {
+	return s.fields()
+}
+
+func (s *StreamSource) UnmarshalJSON(data []byte) error {
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(data, &object); err != nil {
+		return err
+	}
+	source, err := streamSourceFromObject(object)
+	if err != nil {
+		return err
+	}
+	*s = source
+	return nil
+}
+
+func decodeURLField(object map[string]json.RawMessage, key string) (string, bool) {
+	raw, ok := object[key]
+	if !ok {
+		return "", false
+	}
+	var value string
+	if err := json.Unmarshal(raw, &value); err != nil || !IsValidURL(value) {
+		return "", false
+	}
+	return value, true
+}
+
+func decodeOptionalURLField(object map[string]json.RawMessage, key string) (*string, bool) {
+	raw, ok := object[key]
+	if !ok || isJSONNull(raw) {
+		return nil, true
+	}
+	value, ok := decodeURLField(object, key)
+	if !ok {
+		return nil, false
+	}
+	return &value, true
+}
+
+func decodeOptionalU16(object map[string]json.RawMessage, key string) (*uint16, bool) {
+	raw, ok := object[key]
+	if !ok || isJSONNull(raw) {
+		return nil, true
+	}
+	var value uint16
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return nil, false
+	}
+	return &value, true
+}
+
+// decodeStringsDefaultOnNull decodes a `DefaultOnNull` `Vec<String>`.
+func decodeStringsDefaultOnNull(raw json.RawMessage, present bool) ([]string, bool) {
+	if !present || isJSONNull(raw) {
+		return []string{}, true
+	}
+	var values []string
+	if err := json.Unmarshal(raw, &values); err != nil {
+		return nil, false
+	}
+	return nonNilSlice(values), true
+}
+
+func decodeURLs(raw json.RawMessage) ([]string, bool) {
+	var values []string
+	if err := json.Unmarshal(raw, &values); err != nil {
+		return nil, false
+	}
+	for _, value := range values {
+		if !IsValidURL(value) {
+			return nil, false
+		}
+	}
+	return nonNilSlice(values), true
+}
+
+// streamSourceFromObject tries the variants in order, like the rust untagged enum.
+func streamSourceFromObject(object map[string]json.RawMessage) (StreamSource, error) {
+	if url, ok := decodeURLField(object, "url"); ok {
+		return StreamSource{Kind: StreamSourceURL, URL: url}, nil
+	}
+	if raw, ok := object["ytId"]; ok {
+		var ytID string
+		if json.Unmarshal(raw, &ytID) == nil {
+			return StreamSource{Kind: StreamSourceYouTube, YtID: ytID}, nil
+		}
+	}
+	for _, kind := range []string{StreamSourceRar, StreamSourceZip, StreamSourceZip7, StreamSourceTgz, StreamSourceTar} {
+		raw, ok := object[archiveURLKeys[kind]]
+		if !ok {
+			continue
+		}
+		var urls []ArchiveURL
+		if err := json.Unmarshal(raw, &urls); err != nil {
+			continue
+		}
+		fileIdx, ok := decodeOptionalU16(object, "fileIdx")
+		if !ok {
+			continue
+		}
+		mustInclude, mustIncludePresent := object["fileMustInclude"]
+		fileMustInclude, ok := decodeStringsDefaultOnNull(mustInclude, mustIncludePresent)
+		if !ok {
+			continue
+		}
+		return StreamSource{Kind: kind, Urls: nonNilSlice(urls), FileIdx: fileIdx, FileMustInclude: fileMustInclude}, nil
+	}
+	if servers, ok := object["servers"]; ok {
+		if serverURLs, ok := decodeURLs(servers); ok {
+			nzbURL, nzbURLOk := decodeOptionalURLField(object, "nzbUrl")
+			nzbUrls := []string{}
+			nzbUrlsOk := true
+			if raw, ok := object["nzbUrls"]; ok && !isJSONNull(raw) {
+				nzbUrls, nzbUrlsOk = decodeURLs(raw)
+			}
+			if nzbURLOk && nzbUrlsOk {
+				return StreamSource{Kind: StreamSourceNzb, NzbURL: nzbURL, NzbUrls: nzbUrls, Servers: serverURLs}, nil
+			}
+		}
+	}
+	if raw, ok := object["infoHash"]; ok {
+		var infoHash InfoHash
+		if infoHash.UnmarshalJSON(raw) == nil {
+			fileIdx, fileIdxOk := decodeOptionalU16(object, "fileIdx")
+			announceRaw, announcePresent := object["announce"]
+			if !announcePresent {
+				announceRaw, announcePresent = object["sources"]
+			}
+			announce, announceOk := decodeStringsDefaultOnNull(announceRaw, announcePresent)
+			mustInclude, mustIncludePresent := object["fileMustInclude"]
+			fileMustInclude, mustIncludeOk := decodeStringsDefaultOnNull(mustInclude, mustIncludePresent)
+			if fileIdxOk && announceOk && mustIncludeOk {
+				return StreamSource{
+					Kind:            StreamSourceTorrent,
+					InfoHash:        infoHash,
+					FileIdx:         fileIdx,
+					Announce:        announce,
+					FileMustInclude: fileMustInclude,
+				}, nil
+			}
+		}
+	}
+	if url, ok := decodeURLField(object, "playerFrameUrl"); ok {
+		return StreamSource{Kind: StreamSourcePlayerFrame, PlayerFrameURL: url}, nil
+	}
+	externalURL, externalOk := decodeOptionalURLField(object, "externalUrl")
+	androidTvURL, androidOk := decodeOptionalURLField(object, "androidTvUrl")
+	tizenURL, tizenErr := decodeOptionalString(object["tizenUrl"])
+	webosURL, webosErr := decodeOptionalString(object["webosUrl"])
+	if externalOk && androidOk && tizenErr == nil && webosErr == nil &&
+		(externalURL != nil || androidTvURL != nil || tizenURL != nil || webosURL != nil) {
+		return StreamSource{
+			Kind:         StreamSourceExternal,
+			ExternalURL:  externalURL,
+			AndroidTvURL: androidTvURL,
+			TizenURL:     tizenURL,
+			WebosURL:     webosURL,
+		}, nil
+	}
+	return StreamSource{}, errors.New("Valid StreamSource")
+}
