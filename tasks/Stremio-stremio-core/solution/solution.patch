+	lidl := NewLibraryItemDeepLinks(item, torrentStreamsItem(t), streamingServerURL(), infusePlayerSettings())
+	assertStrPtr(t, lidl.MetaDetailsVideos, ptr(metaDetailsVideos))
+	assertStrPtr(t, lidl.MetaDetailsStreams, ptr("stremio:///detail/series/tt13622776/tt13622776%3A1%3A5"))
+	assertPlayerLink(t, lidl.Player)
+	assertInfuseOpenPlayer(t, lidl.ExternalPlayer)
+}
