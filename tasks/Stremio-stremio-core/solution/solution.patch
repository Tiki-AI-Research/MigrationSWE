+func TestPlayerTimeChangedSendsWatched(t *testing.T) {
+	const likesURL = "https://likes.stremio.com/api/send"
+	rt, m, env, _ := newPlaybackRuntime(t, func(env *testenv.Env, m *Model) {
+		m.Ctx.Profile.Auth = &types.Auth{Key: "auth_key", User: types.User{ID: "user_id"}}
+	}, map[string]string{likesURL: `{"message": "ok", "rating": {"status": "watched"}, "action": "set"}`})
+	dispatchPlayer(rt, timeChangedAction(60, 100))
+	if requests := playerRequestsTo(env, likesURL); len(requests) != 0 {
+		t.Fatalf("the watched threshold is not reached yet")
+	}
+	dispatchPlayer(rt, timeChangedAction(80, 100))
+	requests := playerRequestsTo(env, likesURL)
+	if len(requests) != 1 {
+		t.Fatalf("expected one watched request, got %d", len(requests))
+	}
+	if body := string(requests[0].Body); body != `{"authToken":"auth_key","mediaId":"tt123456","mediaType":"series","status":"watched"}` {
+		t.Fatalf("unexpected watched request body: %s", body)
+	}
+	if requests[0].Method != "POST" || requests[0].Headers["content-type"] != "application/json" {
+		t.Fatalf("unexpected watched request: %+v", requests[0])
+	}
+	item := m.Player.LibraryItem
+	if item.State.FlaggedWatched != 1 || item.State.TimesWatched != 1 || item.State.TimeWatched != 80 || item.State.Watched == nil {
+		t.Fatalf("the library item should be flagged as watched: %+v", item.State)
+	}
+	watched, err := types.WatchedBitFieldConstructAndResize(*item.State.Watched, []string{"tt123456:1:1", "tt123456:1:2"})
+	if err != nil || !watched.GetVideo("tt123456:1:1") || watched.GetVideo("tt123456:1:2") {
+		t.Fatalf("unexpected watched bitfield %s: %v", *item.State.Watched, err)
+	}
+	dispatchPlayer(rt, timeChangedAction(90, 100))
+	if requests := playerRequestsTo(env, likesURL); len(requests) != 1 {
+		t.Fatalf("the watched state is sent only once")
+	}
+}
