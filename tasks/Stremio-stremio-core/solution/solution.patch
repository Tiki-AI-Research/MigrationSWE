+func TestPlayerStreamStateChanged(t *testing.T) {
+	env := testenv.New()
+	c := ctx.NewDefault(env)
+	player := NewPlayer()
+	player.Selected = &Selected{
+		Stream:        playerURLStream("https://source_url", nil),
+		StreamRequest: playerRequest(stremiocore.STREAM_RESOURCE_NAME, "tt123456:1:1"),
+		MetaRequest:   playerRequest(stremiocore.META_RESOURCE_NAME, "tt123456"),
