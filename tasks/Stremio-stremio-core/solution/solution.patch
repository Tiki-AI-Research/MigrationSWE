+)
+
+// Port of src/unit_tests/ctx/update_search_history.rs
+//
+// The CatalogsWithExtra model is not ported: loading it with a `search`
+// extra dispatches `Internal::CatalogsWithExtraSearch { query }` to the Ctx,
+// which is simulated here.
+
+// evSearchHistoryHarness creates the default Ctx with its search history stored.
+func evSearchHistoryHarness(t *testing.T) *harness {
+	t.Helper()
+	env := newTestEnv(datetime(2020, 1, 1, 10, 30, 0))
+	setRoutes(t, env)
+	c := defaultCtx(env)
+	setStorage(t, env, stremiocore.SEARCH_HISTORY_STORAGE_KEY, c.SearchHistory)
+	return newHarness(t, env, c)
+}
+
+func TestSearchHistoryUpdate(t *testing.T) {
+	h := evSearchHistoryHarness(t)
+	env := h.env
+	query := "superman"
+	date := env.Now()
+
+	h.dispatchInternal(msg.InternalCatalogsWithExtraSearch, query)
+
+	searchDate, ok := h.ctx().SearchHistory.Items[query]
+	if !ok {
+		t.Fatalf("Should have updated search history")
+	}
+	assertEqual(t, searchDate, date, "Should have updated search history")
+	stored, ok := storageValue[types.SearchHistoryBucket](t, env, stremiocore.SEARCH_HISTORY_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Should have stored updated search history")
+	}
+	if _, ok := stored.Items[query]; !ok {
+		t.Errorf("Should have stored updated search history")
+	}
+	assertEqual(t, stored, types.SearchHistoryBucket{Items: map[string]time.Time{query: date}}, "Stored search history")
+	assertEqual(t, h.coreEventNames(), []string{msg.EventSearchHistoryPushedToStorage}, "events")
+	assertEvent(t, h.findEvent(msg.EventSearchHistoryPushedToStorage), msg.EventSearchHistoryPushedToStorage, `{"uid":null}`, "SearchHistoryPushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests should be sent: %s", describeRequests(env.Requests))
+	}
+}
+
+func TestSearchHistoryClearItems(t *testing.T) {
+	h := evSearchHistoryHarness(t)
+	env := h.env
+
+	h.dispatchInternal(msg.InternalCatalogsWithExtraSearch, "superman")
+
+	if len(h.ctx().SearchHistory.Items) == 0 {
+		t.Fatalf("Should have updated search history")
+	}
+
+	h.clearEvents()
+	h.dispatchCtx(msg.ActionCtxClearSearchHistory, nil)
+
+	if len(h.ctx().SearchHistory.Items) != 0 {
+		t.Errorf("Should have cleared search history, got %v", h.ctx().SearchHistory.Items)
+	}
+	stored, ok := storageValue[types.SearchHistoryBucket](t, env, stremiocore.SEARCH_HISTORY_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Should have stored the cleared search history")
+	}
+	assertEqual(t, stored, types.NewSearchHistoryBucket(nil), "Stored search history is cleared")
+	assertEqual(t, h.coreEventNames(), []string{msg.EventSearchHistoryPushedToStorage}, "events")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
