+
+// WatchedBitField returns the watched bitfield of the item for the given
+// videos, which are sorted by season, episode and release date.
+func (s LibraryItemState) WatchedBitField(videos []Video) WatchedBitField {
+	sorted := append([]Video{}, videos...)
+	key := func(v Video) (int64, int64, int64) {
+		season, episode, released := int64(-1<<63), int64(-1<<63), int64(-1<<63)
+		if v.SeriesInfo != nil {
+			season, episode = int64(v.SeriesInfo.Season), int64(v.SeriesInfo.Episode)
+		}
+		if v.Released != nil {
+			released = v.Released.UnixMilli()
+		}
+		return season, episode, released
+	}
+	sort.SliceStable(sorted, func(i, j int) bool {
+		as, ae, ar := key(sorted[i])
+		bs, be, br := key(sorted[j])
+		if as != bs {
+			return as < bs
+		}
+		if ae != be {
+			return ae < be
+		}
+		return ar < br
+	})
+	videoIDs := make([]string, 0, len(sorted))
+	for _, video := range sorted {
+		videoIDs = append(videoIDs, video.ID)
+	}
+	if s.Watched != nil {
+		if watched, err := WatchedBitFieldConstructAndResize(*s.Watched, videoIDs); err == nil {
+			return watched
+		}
+	}
+	return WatchedBitFieldConstructFromArray(nil, videoIDs)
+}
