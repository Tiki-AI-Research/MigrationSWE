+package models
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// StreamingServerSelected is the selected streaming server and statistics.
+type StreamingServerSelected struct {
+	TransportURL string
+	Statistics   *types.StatisticsRequest
+}
+
+func (s StreamingServerSelected) MarshalJSON() ([]byte, error) {
+	return types.MarshalJSON(struct {
+		TransportURL string                   `json:"transportUrl"`
+		Statistics   *types.StatisticsRequest `json:"statistics"`
+	}{types.NormalizeURL(s.TransportURL), s.Statistics})
+}
+
+// StreamingServerTorrent is the torrent being created and its meta path.
+type StreamingServerTorrent struct {
+	InfoHash types.InfoHash
+	Path     common.Loadable[types.ResourcePath]
+}
+
+// MarshalJSON serializes the torrent as the `[infoHash, path]` tuple.
+func (t StreamingServerTorrent) MarshalJSON() ([]byte, error) {
+	return types.MarshalJSON([]any{t.InfoHash, t.Path})
+}
+
+// StreamingServer is the model of the streaming server.
+type StreamingServer struct {
+	Selected                  StreamingServerSelected
+	Settings                  common.Loadable[types.StreamingServerSettings]
+	SettingsOptions           []types.SettingsOption
+	BaseURL                   *string
+	RemoteURL                 *string
+	PlaybackDevices           common.Loadable[[]types.PlaybackDevice]
+	PlaybackDevicesGeneration uint64
+	NetworkInfo               common.Loadable[types.NetworkInfo]
+	DeviceInfo                common.Loadable[types.DeviceInfo]
+	Torrent                   *StreamingServerTorrent
+	// Statistics is loading only on the first statistics request.
+	Statistics *common.Loadable[types.Statistics]
+}
+
+// MarshalJSON serializes the model; the playback devices generation is skipped.
+func (s StreamingServer) MarshalJSON() ([]byte, error) {
+	playbackDevices := s.PlaybackDevices
+	if playbackDevices.IsReady() && playbackDevices.Content == nil {
+		playbackDevices.Content = []types.PlaybackDevice{}
+	}
+	settingsOptions := s.SettingsOptions
+	if settingsOptions == nil {
+		settingsOptions = []types.SettingsOption{}
+	}
+	return types.MarshalJSON(struct {
+		Selected        StreamingServerSelected                        `json:"selected"`
+		Settings        common.Loadable[types.StreamingServerSettings] `json:"settings"`
+		SettingsOptions []types.SettingsOption                         `json:"settingsOptions"`
+		BaseURL         *string                                        `json:"baseUrl"`
+		RemoteURL       *string                                        `json:"remoteUrl"`
+		PlaybackDevices common.Loadable[[]types.PlaybackDevice]        `json:"playbackDevices"`
+		NetworkInfo     common.Loadable[types.NetworkInfo]             `json:"networkInfo"`
+		DeviceInfo      common.Loadable[types.DeviceInfo]              `json:"deviceInfo"`
+		Torrent         *StreamingServerTorrent                        `json:"torrent"`
+		Statistics      *common.Loadable[types.Statistics]             `json:"statistics"`
+	}{
+		Selected:        s.Selected,
+		Settings:        s.Settings,
+		SettingsOptions: settingsOptions,
+		BaseURL:         s.BaseURL,
+		RemoteURL:       s.RemoteURL,
+		PlaybackDevices: playbackDevices,
+		NetworkInfo:     s.NetworkInfo,
+		DeviceInfo:      s.DeviceInfo,
+		Torrent:         s.Torrent,
+		Statistics:      s.Statistics,
+	})
+}
+
+//
+// Internal messages
+//
+
+// StreamingServerSettingsResult is the data of the
+// `StreamingServerSettingsResult` internal message.
+type StreamingServerSettingsResult struct {
+	URL      string
+	Response *types.SettingsResponse
+	Err      *runtime.EnvError
+}
+
+// StreamingServerPlaybackDevicesResult is the data of the
+// `StreamingServerPlaybackDevicesResult` internal message.
+type StreamingServerPlaybackDevicesResult struct {
+	URL        string
+	Generation uint64
+	Devices    []types.PlaybackDevice
+	Err        *runtime.EnvError
+}
+
+// StreamingServerNetworkInfoResult is the data of the
+// `StreamingServerNetworkInfoResult` internal message.
+type StreamingServerNetworkInfoResult struct {
+	URL         string
+	NetworkInfo *types.NetworkInfo
+	Err         *runtime.EnvError
+}
+
+// StreamingServerDeviceInfoResult is the data of the
+// `StreamingServerDeviceInfoResult` internal message.
+type StreamingServerDeviceInfoResult struct {
+	URL        string
+	DeviceInfo *types.DeviceInfo
+	Err        *runtime.EnvError
+}
+
+// StreamingServerUpdateSettingsResult is the data of the
+// `StreamingServerUpdateSettingsResult` internal message.
+type StreamingServerUpdateSettingsResult struct {
+	URL string
+	Err *runtime.EnvError
+}
+
+// StreamingServerCreateTorrentResult is the data of the
+// `StreamingServerCreateTorrentResult` internal message.
+type StreamingServerCreateTorrentResult struct {
+	InfoHash types.InfoHash
+	Err      *runtime.EnvError
+}
+
+// StreamingServerPlayOnDeviceResult is the data of the
+// `StreamingServerPlayOnDeviceResult` internal message.
+type StreamingServerPlayOnDeviceResult struct {
+	Device string
+	Err    *runtime.EnvError
+}
+
+// StreamingServerGetHTTPSResult is the data of the
+// `StreamingServerGetHTTPSResult` internal message.
+type StreamingServerGetHTTPSResult struct {
+	URL      string
+	Response *types.GetHTTPSResponse
+	Err      *runtime.EnvError
+}
+
+// StreamingServerStatisticsResult is the data of the
+// `StreamingServerStatisticsResult` internal message. Statistics is nil
+// (with a nil Err) when the server responded with `null`, i.e. the whole
+// stream has been loaded.
+type StreamingServerStatisticsResult struct {
+	URL        string
+	Request    types.StatisticsRequest
+	Statistics *types.Statistics
+	Err        *runtime.EnvError
+}
+
+//
+// Action arguments
+//
+
+// CreateTorrentArgs are the arguments of the `CreateTorrent` action: either
+// the bytes of a torrent file (a JSON array of numbers) or a magnet url (a
+// JSON string).
+type CreateTorrentArgs struct {
+	File   []byte
+	Magnet *string
+}
+
+func (a CreateTorrentArgs) MarshalJSON() ([]byte, error) {
+	if a.Magnet != nil {
+		return types.MarshalJSON(*a.Magnet)
+	}
+	return types.MarshalJSON(byteArray(a.File))
+}
+
+func (a *CreateTorrentArgs) UnmarshalJSON(data []byte) error {
+	trimmed := bytes.TrimSpace(data)
+	if len(trimmed) > 0 && trimmed[0] == '[' {
+		var file []byte
+		if err := json.Unmarshal(trimmed, &file); err == nil {
+			*a = CreateTorrentArgs{File: append([]byte{}, file...)}
+			return nil
+		}
+	}
+	if len(trimmed) > 0 && trimmed[0] == '"' {
+		var magnet string
+		if err := json.Unmarshal(trimmed, &magnet); err == nil && types.IsValidURL(magnet) {
+			normalized := types.NormalizeURL(magnet)
+			*a = CreateTorrentArgs{Magnet: &normalized}
+			return nil
+		}
+	}
+	return fmt.Errorf("data did not match any variant of untagged enum CreateTorrentArgs")
+}
+
+// PlayOnDeviceArgs are the arguments of the `PlayOnDevice` action.
+type PlayOnDeviceArgs struct {
+	Device string  `json:"device"`
+	Source string  `json:"source"`
+	Time   *uint64 `json:"time"`
+}
+
+func (a *PlayOnDeviceArgs) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Device *string `json:"device"`
+		Source *string `json:"source"`
+		Time   *uint64 `json:"time"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Device == nil || wire.Source == nil {
+		return fmt.Errorf("missing field of PlayOnDeviceArgs")
+	}
+	*a = PlayOnDeviceArgs{Device: *wire.Device, Source: *wire.Source, Time: wire.Time}
+	return nil
+}
+
+// decodeStatisticsRequest strictly decodes a statistics request (both
+// fields are required).
+func decodeStatisticsRequest(action *msg.Action) (types.StatisticsRequest, bool) {
+	var wire struct {
+		InfoHash *string `json:"infoHash"`
+		FileIdx  *uint16 `json:"fileIdx"`
+	}
+	if action.DecodeArgs(&wire) != nil || wire.InfoHash == nil || wire.FileIdx == nil {
+		return types.StatisticsRequest{}, false
+	}
+	return types.StatisticsRequest{InfoHash: *wire.InfoHash, FileIdx: *wire.FileIdx}, true
+}
+
+// byteArray is serialized as a JSON array of numbers (rust `Vec<u8>`).
+type byteArray []byte
+
+func (b byteArray) MarshalJSON() ([]byte, error) {
+	var buf bytes.Buffer
+	buf.WriteByte('[')
+	for i, value := range b {
+		if i > 0 {
+			buf.WriteByte(',')
+		}
+		buf.WriteString(strconv.Itoa(int(value)))
+	}
+	buf.WriteByte(']')
+	return buf.Bytes(), nil
+}
+
+// Event arguments.
+type magnetParsedArgs struct {
+	Magnet string `json:"magnet"`
+}
+
+type torrentParsedArgs struct {
+	Torrent byteArray `json:"torrent"`
+}
+
+type playingOnDeviceArgs struct {
+	Device string `json:"device"`
+}
+
+//
+// Model
+//
+
+// NewStreamingServer creates the model for the streaming server url of the
+// profile, with the effects loading its state.
+func NewStreamingServer(env runtime.Env, profile *types.Profile) (*StreamingServer, runtime.Effects) {
+	transportURL := profile.Settings.StreamingServerURL
+	effects := runtime.ManyEffects(
+		getSettings(env, transportURL),
+		getPlaybackDevices(env, transportURL, 0),
+		getNetworkInfo(env, transportURL),
+		getDeviceInfo(env, transportURL),
+	)
+	server := &StreamingServer{
+		Selected:        StreamingServerSelected{TransportURL: transportURL},
+		Settings:        common.Loading[types.StreamingServerSettings](),
+		SettingsOptions: []types.SettingsOption{},
+		PlaybackDevices: common.Loading[[]types.PlaybackDevice](),
+		NetworkInfo:     common.Loading[types.NetworkInfo](),
+		DeviceInfo:      common.Loading[types.DeviceInfo](),
+	}
+	return server, effects.Unchanged()
+}
+
+// Update handles the message with the Ctx.
+func (s *StreamingServer) Update(env runtime.Env, m *msg.Msg, c *ctx.Ctx) runtime.Effects {
+	if m == nil {
+		return runtime.NoneEffects().Unchanged()
+	}
+	if action := m.NestedAction(msg.ActionNameStreamingServer); action != nil {
+		return s.updateAction(env, action, c)
+	}
+	if m.ResolvedKind() == msg.KindInternal && m.Internal != nil {
+		return s.updateInternal(env, m, c)
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func (s *StreamingServer) updateAction(env runtime.Env, action *msg.Action, c *ctx.Ctx) runtime.Effects {
+	switch action.Action {
+	case msg.ActionStreamingServerReload:
+		if action.HasArgs() {
+			break
+		}
+		settingsEffects := common.EqUpdate(&s.Settings, common.Loading[types.StreamingServerSettings]())
+		networkInfoEffects := common.EqUpdate(&s.NetworkInfo, common.Loading[types.NetworkInfo]())
+		deviceInfoEffects := common.EqUpdate(&s.DeviceInfo, common.Loading[types.DeviceInfo]())
+		settingsOptionsEffects := common.EqUpdate(&s.SettingsOptions, []types.SettingsOption{})
+		baseURLEffects := common.EqUpdate(&s.BaseURL, nil)
+		remoteURLEffects := common.EqUpdate(&s.RemoteURL, nil)
+		s.PlaybackDevicesGeneration++
+		return s.loadEffects(env).Unchanged().
+			Join(settingsEffects).
+			Join(settingsOptionsEffects).
+			Join(networkInfoEffects).
+			Join(deviceInfoEffects).
+			Join(baseURLEffects).
+			Join(remoteURLEffects)
+	case msg.ActionStreamingServerRefreshPlaybackDevices:
+		if action.HasArgs() {
+			break
+		}
+		s.PlaybackDevicesGeneration++
+		return runtime.OneEffect(getPlaybackDevices(env, s.Selected.TransportURL, s.PlaybackDevicesGeneration)).Unchanged()
+	case msg.ActionStreamingServerUpdateSettings:
+		var settings types.StreamingServerSettings
+		if action.DecodeArgs(&settings) != nil || !s.Settings.IsReady() {
+			break
+		}
+		settingsEffects := common.EqUpdate(&s.Settings, common.Ready(settings))
+		remoteURLEffects := updateRemoteURL(env, &s.RemoteURL, s.Selected, settings, c)
+		return runtime.OneEffect(setSettings(env, s.Selected.TransportURL, settings)).Unchanged().
+			Join(settingsEffects).
+			Join(remoteURLEffects)
+	case msg.ActionStreamingServerCreateTorrent:
+		var args CreateTorrentArgs
+		if action.DecodeArgs(&args) != nil {
+			break
+		}
+		if args.Magnet != nil {
+			return s.createTorrentFromMagnet(env, *args.Magnet)
+		}
+		return s.createTorrentFromFile(env, args.File)
+	case msg.ActionStreamingServerGetStatistics:
+		request, ok := decodeStatisticsRequest(action)
+		if !ok {
+			break
+		}
+		next := request
+		selectedEffects := common.EqUpdate(&s.Selected.Statistics, &next)
+		// mirrors the original: the selected statistics request has just been
+		// set to the request, so the requests never differ here.
+		isDifferentRequest := s.Selected.Statistics == nil || *s.Selected.Statistics != request
+		// set the Loading state only on the first fetch of the statistics
+		statisticsEffects := runtime.NoneEffects().Unchanged()
+		if s.Statistics == nil || isDifferentRequest {
+			loading := common.Loading[types.Statistics]()
+			statisticsEffects = common.EqUpdate(&s.Statistics, &loading)
+		}
+		return runtime.OneEffect(getTorrentStatistics(env, s.Selected.TransportURL, request)).Unchanged().
+			Join(selectedEffects).
+			Join(statisticsEffects)
+	case msg.ActionStreamingServerPlayOnDevice:
+		var args PlayOnDeviceArgs
+		if action.DecodeArgs(&args) != nil || !types.IsValidURL(args.Source) {
+			break
+		}
+		devices, ready := s.PlaybackDevices.Ready()
+		if !ready {
+			break
+		}
+		for _, device := range devices {
+			if device.ID == args.Device {
+				return runtime.OneEffect(playOnDevice(env, s.Selected.TransportURL, args)).Unchanged()
+			}
+		}
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func (s *StreamingServer) createTorrentFromMagnet(env runtime.Env, magnet string) runtime.Effects {
+	source := msg.NewEvent(msg.EventMagnetParsed, magnetParsedArgs{Magnet: magnet})
+	infoHash, announce, err := types.ParseMagnetInfoHash(magnet)
+	if err != nil {
+		torrentEffects := common.EqUpdate(&s.Torrent, nil)
+		return runtime.MsgEffects(msg.EventMsg(msg.ErrorEvent(
+			ctx.NewEnvError(runtime.EnvErrorOther("Failed to parse magnet url")), source,
+		))).Unchanged().Join(torrentEffects)
+	}
+	torrentEffects := common.EqUpdate(&s.Torrent, &StreamingServerTorrent{
+		InfoHash: infoHash,
+		Path:     common.Loading[types.ResourcePath](),
+	})
+	return runtime.ManyEffects(
+		createMagnet(env, s.Selected.TransportURL, infoHash, announce),
+		runtime.MsgEffect(msg.EventMsg(source)),
+	).Unchanged().Join(torrentEffects)
+}
+
+func (s *StreamingServer) createTorrentFromFile(env runtime.Env, torrent []byte) runtime.Effects {
+	source := msg.NewEvent(msg.EventTorrentParsed, torrentParsedArgs{Torrent: byteArray(torrent)})
+	infoHash, _, err := types.ParseTorrent(torrent)
+	if err != nil {
+		torrentEffects := common.EqUpdate(&s.Torrent, nil)
+		return runtime.MsgEffects(msg.EventMsg(msg.ErrorEvent(
+			ctx.NewEnvError(runtime.EnvErrorOther(fmt.Sprintf("Failed to parse stream from file: %s", err))), source,
+		))).Unchanged().Join(torrentEffects)
+	}
+	torrentEffects := common.EqUpdate(&s.Torrent, &StreamingServerTorrent{
+		InfoHash: infoHash,
+		Path:     common.Loading[types.ResourcePath](),
+	})
+	return runtime.ManyEffects(
+		createTorrentRequest(env, s.Selected.TransportURL, infoHash, torrent),
+		runtime.MsgEffect(msg.EventMsg(source)),
+	).Unchanged().Join(torrentEffects)
+}
+
+// loadEffects are the effects loading the state of the selected server.
+func (s *StreamingServer) loadEffects(env runtime.Env) runtime.Effects {
+	return runtime.ManyEffects(
+		getSettings(env, s.Selected.TransportURL),
+		getPlaybackDevices(env, s.Selected.TransportURL, s.PlaybackDevicesGeneration),
+		getNetworkInfo(env, s.Selected.TransportURL),
+		getDeviceInfo(env, s.Selected.TransportURL),
+	)
+}
+
+// failEffects mark the whole state as failed with the error.
+func (s *StreamingServer) failEffects(err *runtime.EnvError) runtime.Effects {
+	baseURLEffects := common.EqUpdate(&s.BaseURL, nil)
+	remoteURLEffects := common.EqUpdate(&s.RemoteURL, nil)
+	settingsOptionsEffects := common.EqUpdate(&s.SettingsOptions, []types.SettingsOption{})
+	playbackDevicesEffects := common.EqUpdate(&s.PlaybackDevices, common.Err[[]types.PlaybackDevice](err))
+	networkInfoEffects := common.EqUpdate(&s.NetworkInfo, common.Err[types.NetworkInfo](err))
+	deviceInfoEffects := common.EqUpdate(&s.DeviceInfo, common.Err[types.DeviceInfo](err))
+	settingsEffects := common.EqUpdate(&s.Settings, common.Err[types.StreamingServerSettings](err))
+	torrentEffects := common.EqUpdate(&s.Torrent, nil)
+	return baseURLEffects.
+		Join(remoteURLEffects).
+		Join(settingsOptionsEffects).
+		Join(playbackDevicesEffects).
+		Join(networkInfoEffects).
+		Join(deviceInfoEffects).
+		Join(settingsEffects).
+		Join(torrentEffects)
+}
+
+func (s *StreamingServer) updateInternal(env runtime.Env, m *msg.Msg, c *ctx.Ctx) runtime.Effects {
+	switch m.Internal.Name {
+	case msg.InternalProfileChanged:
+		if c == nil || sameURL(s.Selected.TransportURL, c.Profile.Settings.StreamingServerURL) {
+			break
+		}
+		s.Selected = StreamingServerSelected{TransportURL: c.Profile.Settings.StreamingServerURL}
+		s.Settings = common.Loading[types.StreamingServerSettings]()
+		s.SettingsOptions = []types.SettingsOption{}
+		s.NetworkInfo = common.Loading[types.NetworkInfo]()
+		s.DeviceInfo = common.Loading[types.DeviceInfo]()
+		s.BaseURL = nil
+		s.RemoteURL = nil
+		s.Torrent = nil
+		s.Statistics = nil
+		s.PlaybackDevicesGeneration++
+		return s.loadEffects(env)
+	case msg.InternalStreamingServerSettingsResult:
+		result, ok := ctx.InternalData[StreamingServerSettingsResult](m, msg.InternalStreamingServerSettingsResult)
+		if !ok || !sameURL(s.Selected.TransportURL, result.URL) || !s.Settings.IsLoading() {
+			break
+		}
+		if result.Err != nil || result.Response == nil {
+			return s.failEffects(resultError(result.Err))
+		}
+		response := *result.Response
+		settingsEffects := common.EqUpdate(&s.Settings, common.Ready(response.Values))
+		options := response.Options
+		if options == nil {
+			options = []types.SettingsOption{}
+		}
+		settingsOptionsEffects := common.EqUpdate(&s.SettingsOptions, options)
+		baseURL := types.NormalizeURL(response.BaseURL)
+		baseURLEffects := common.EqUpdate(&s.BaseURL, &baseURL)
+		remoteURLEffects := updateRemoteURL(env, &s.RemoteURL, s.Selected, response.Values, c)
+		return settingsEffects.
+			Join(settingsOptionsEffects).
+			Join(baseURLEffects).
+			Join(remoteURLEffects)
+	case msg.InternalStreamingServerPlaybackDevicesResult:
+		result, ok := ctx.InternalData[StreamingServerPlaybackDevicesResult](m, msg.InternalStreamingServerPlaybackDevicesResult)
+		if !ok || !sameURL(s.Selected.TransportURL, result.URL) || s.PlaybackDevicesGeneration != result.Generation {
+			break
+		}
+		if result.Err == nil {
+			devices := result.Devices
+			if devices == nil {
+				devices = []types.PlaybackDevice{}
+			}
+			return common.EqUpdate(&s.PlaybackDevices, common.Ready(devices))
+		}
+		if s.PlaybackDevices.IsLoading() {
+			return common.EqUpdate(&s.PlaybackDevices, common.Err[[]types.PlaybackDevice](result.Err))
+		}
+	case msg.InternalStreamingServerNetworkInfoResult:
+		result, ok := ctx.InternalData[StreamingServerNetworkInfoResult](m, msg.InternalStreamingServerNetworkInfoResult)
+		if !ok || !sameURL(s.Selected.TransportURL, result.URL) || !s.NetworkInfo.IsLoading() {
+			break
+		}
+		if result.Err != nil || result.NetworkInfo == nil {
+			return common.EqUpdate(&s.NetworkInfo, common.Err[types.NetworkInfo](resultError(result.Err)))
+		}
+		return common.EqUpdate(&s.NetworkInfo, common.Ready(*result.NetworkInfo))
+	case msg.InternalStreamingServerDeviceInfoResult:
+		result, ok := ctx.InternalData[StreamingServerDeviceInfoResult](m, msg.InternalStreamingServerDeviceInfoResult)
+		if !ok || !sameURL(s.Selected.TransportURL, result.URL) || !s.DeviceInfo.IsLoading() {
+			break
+		}
+		if result.Err != nil || result.DeviceInfo == nil {
+			return common.EqUpdate(&s.DeviceInfo, common.Err[types.DeviceInfo](resultError(result.Err)))
+		}
+		return common.EqUpdate(&s.DeviceInfo, common.Ready(*result.DeviceInfo))
+	case msg.InternalStreamingServerUpdateSettingsResult:
+		result, ok := ctx.InternalData[StreamingServerUpdateSettingsResult](m, msg.InternalStreamingServerUpdateSettingsResult)
+		if !ok || !sameURL(s.Selected.TransportURL, result.URL) {
+			break
+		}
+		if result.Err != nil {
+			return s.failEffects(result.Err)
+		}
+	case msg.InternalStreamingServerStatisticsResult:
+		result, ok := ctx.InternalData[StreamingServerStatisticsResult](m, msg.InternalStreamingServerStatisticsResult)
+		if !ok || !sameURL(s.Selected.TransportURL, result.URL) ||
+			s.Selected.Statistics == nil || *s.Selected.Statistics != result.Request {
+			break
+		}
+		var loadable common.Loadable[types.Statistics]
+		switch {
+		case result.Err != nil:
+			loadable = common.Err[types.Statistics](result.Err)
+		case result.Statistics != nil:
+			loadable = common.Ready(*result.Statistics)
+		default:
+			// we've loaded the whole stream, no need to update the statistics.
+			return runtime.NoneEffects().Unchanged()
+		}
+		return common.EqUpdate(&s.Statistics, &loadable)
+	case msg.InternalStreamingServerPlayOnDeviceResult:
+		result, ok := ctx.InternalData[StreamingServerPlayOnDeviceResult](m, msg.InternalStreamingServerPlayOnDeviceResult)
+		if !ok || result.Err != nil {
+			break
+		}
+		return runtime.MsgEffects(msg.EventMsg(msg.NewEvent(msg.EventPlayingOnDevice,
+			playingOnDeviceArgs{Device: result.Device}))).Unchanged()
+	case msg.InternalStreamingServerGetHTTPSResult:
+		result, ok := ctx.InternalData[StreamingServerGetHTTPSResult](m, msg.InternalStreamingServerGetHTTPSResult)
+		if !ok || !sameURL(s.Selected.TransportURL, result.URL) || result.Err != nil || result.Response == nil {
+			break
+		}
+		return common.EqUpdate(&s.RemoteURL, remoteHTTPSURL(result.Response.Domain, result.Response.Port))
+	case msg.InternalStreamingServerCreateTorrentResult:
+		result, ok := ctx.InternalData[StreamingServerCreateTorrentResult](m, msg.InternalStreamingServerCreateTorrentResult)
+		if !ok || s.Torrent == nil || s.Torrent.InfoHash != result.InfoHash || !s.Torrent.Path.IsLoading() {
+			break
+		}
+		if result.Err != nil {
+			s.Torrent.Path = common.Err[types.ResourcePath](result.Err)
+		} else {
+			s.Torrent.Path = common.Ready(types.NewResourcePath(
+				stremiocore.META_RESOURCE_NAME, "other", "bt:"+s.Torrent.InfoHash.String()))
+		}
+		return runtime.NoneEffects()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+//
+// Helpers
+//
+
+// sameURL compares two urls by their serialization (rust `Url` equality).
+func sameURL(a, b string) bool {
+	return a == b || types.NormalizeURL(a) == types.NormalizeURL(b)
+}
+
+// resultError returns the error of a result, or a serde error for a result
+// with neither a value nor an error.
+func resultError(err *runtime.EnvError) *runtime.EnvError {
+	if err != nil {
+		return err
+	}
+	return runtime.EnvErrorSerde("invalid type: null, expected a value")
+}
+
+// remoteHTTPSURL returns the `https://{domain}:{port}` url, nil if it is not valid.
+func remoteHTTPSURL(domain string, port uint16) *string {
+	raw := fmt.Sprintf("https://%s:%d", domain, port)
+	parsed, err := url.Parse(raw)
+	if err != nil || parsed.Hostname() == "" || !types.IsValidURL(raw) {
+		return nil
+	}
+	// a domain with a port (`host:80:3333`) has an invalid port
+	if !strings.HasPrefix(parsed.Host, "[") && strings.Contains(parsed.Hostname(), ":") {
+		return nil
+	}
+	normalized := types.NormalizeURL(raw)
+	return &normalized
+}
+
+func updateRemoteURL(env runtime.Env, remoteURL **string, selected StreamingServerSelected, settings types.StreamingServerSettings, c *ctx.Ctx) runtime.Effects {
+	if c != nil && settings.RemoteHTTPS != nil && *settings.RemoteHTTPS != "" {
+		if authKey := c.Profile.AuthKey(); authKey != nil {
+			return runtime.OneEffect(getHTTPSEndpoint(env, selected.TransportURL, *authKey, *settings.RemoteHTTPS)).Unchanged()
+		}
+	}
+	return common.EqUpdate(remoteURL, nil)
+}
+
+// jsonHeaders are the headers of the requests setting `CONTENT_TYPE`.
+func jsonHeaders() map[string]string {
+	return map[string]string{"content-type": "application/json"}
+}
+
+// fetchJSON performs the request and decodes the JSON response; the result
+// is nil for a `null` response.
+func fetchJSON[T any](env runtime.Env, method, endpoint string, headers map[string]string, body []byte) (*T, *runtime.EnvError) {
+	response, envErr := env.Fetch(method, endpoint, headers, body)
+	if envErr != nil {
+		return nil, envErr
+	}
+	var value *T
+	if err := json.Unmarshal(response, &value); err != nil {
+		return nil, runtime.EnvErrorSerde(err.Error())
+	}
+	return value, nil
+}
+
+// fetchRequiredJSON is fetchJSON for responses which must not be `null`.
+func fetchRequiredJSON[T any](env runtime.Env, method, endpoint string, headers map[string]string, body []byte) (*T, *runtime.EnvError) {
+	value, envErr := fetchJSON[T](env, method, endpoint, headers, body)
+	if envErr != nil {
+		return nil, envErr
+	}
+	if value == nil {
+		return nil, runtime.EnvErrorSerde("invalid type: null, expected a value")
+	}
+	return value, nil
+}
+
+// fetchAnyJSON performs the request expecting any JSON response.
+func fetchAnyJSON(env runtime.Env, method, endpoint string, headers map[string]string, body []byte) *runtime.EnvError {
+	response, envErr := env.Fetch(method, endpoint, headers, body)
+	if envErr != nil {
+		return envErr
+	}
+	var value any
+	if err := json.Unmarshal(response, &value); err != nil {
+		return runtime.EnvErrorSerde(err.Error())
+	}
+	return nil
+}
+
+func urlBuilderError(err error) *runtime.EnvError {
+	return runtime.EnvErrorOther("url builder failed: " + err.Error())
+}
+
+func getSettings(env runtime.Env, transportURL string) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerSettingsResult{URL: transportURL}
+		if endpoint, err := types.URLJoin(transportURL, "settings"); err != nil {
+			result.Err = urlBuilderError(err)
+		} else {
+			result.Response, result.Err = fetchRequiredJSON[types.SettingsResponse](env, "GET", endpoint, map[string]string{}, nil)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerSettingsResult, result))
+	})
+}
+
+func getPlaybackDevices(env runtime.Env, transportURL string, generation uint64) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerPlaybackDevicesResult{URL: transportURL, Generation: generation}
+		if endpoint, err := types.URLJoin(transportURL, "casting"); err != nil {
+			result.Err = urlBuilderError(err)
+		} else if devices, envErr := fetchRequiredJSON[[]types.PlaybackDevice](env, "GET", endpoint, map[string]string{}, nil); envErr != nil {
+			result.Err = envErr
+		} else {
+			result.Devices = *devices
+			if result.Devices == nil {
+				result.Devices = []types.PlaybackDevice{}
+			}
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerPlaybackDevicesResult, result))
+	})
+}
+
+func getNetworkInfo(env runtime.Env, transportURL string) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerNetworkInfoResult{URL: transportURL}
+		if endpoint, err := types.URLJoin(transportURL, "network-info"); err != nil {
+			result.Err = urlBuilderError(err)
+		} else {
+			result.NetworkInfo, result.Err = fetchRequiredJSON[types.NetworkInfo](env, "GET", endpoint, map[string]string{}, nil)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerNetworkInfoResult, result))
+	})
+}
+
+func getDeviceInfo(env runtime.Env, transportURL string) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerDeviceInfoResult{URL: transportURL}
+		if endpoint, err := types.URLJoin(transportURL, "device-info"); err != nil {
+			result.Err = urlBuilderError(err)
+		} else {
+			result.DeviceInfo, result.Err = fetchRequiredJSON[types.DeviceInfo](env, "GET", endpoint, map[string]string{}, nil)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerDeviceInfoResult, result))
+	})
+}
+
+func setSettings(env runtime.Env, transportURL string, settings types.StreamingServerSettings) runtime.Effect {
+	body, bodyErr := settings.UpdateBody()
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerUpdateSettingsResult{URL: transportURL}
+		if bodyErr != nil {
+			result.Err = runtime.EnvErrorSerde(bodyErr.Error())
+		} else if endpoint, err := types.URLJoin(transportURL, "settings"); err != nil {
+			result.Err = urlBuilderError(err)
+		} else {
+			_, result.Err = fetchRequiredJSON[types.SuccessResponse](env, "POST", endpoint, jsonHeaders(), body)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerUpdateSettingsResult, result))
+	})
+}
+
+func createMagnet(env runtime.Env, transportURL string, infoHash types.InfoHash, announce []string) runtime.Effect {
+	announce = append([]string{}, announce...)
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerCreateTorrentResult{InfoHash: infoHash}
+		if body, err := types.CreateMagnetBody(infoHash, announce); err != nil {
+			result.Err = runtime.EnvErrorSerde(err.Error())
+		} else if endpoint, err := types.CreateMagnetURL(transportURL, infoHash); err != nil {
+			result.Err = urlBuilderError(err)
+		} else {
+			result.Err = fetchAnyJSON(env, "POST", endpoint, jsonHeaders(), body)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerCreateTorrentResult, result))
+	})
+}
+
+func createTorrentRequest(env runtime.Env, transportURL string, infoHash types.InfoHash, torrent []byte) runtime.Effect {
+	torrent = append([]byte{}, torrent...)
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerCreateTorrentResult{InfoHash: infoHash}
+		if body, err := types.CreateTorrentBlobBody(torrent); err != nil {
+			result.Err = runtime.EnvErrorSerde(err.Error())
+		} else if endpoint, err := types.CreateTorrentBlobURL(transportURL); err != nil {
+			result.Err = urlBuilderError(err)
+		} else {
+			result.Err = fetchAnyJSON(env, "POST", endpoint, jsonHeaders(), body)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerCreateTorrentResult, result))
+	})
+}
+
+func getTorrentStatistics(env runtime.Env, transportURL string, request types.StatisticsRequest) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerStatisticsResult{URL: transportURL, Request: request}
+		if endpoint, err := types.TorrentStatisticsURL(transportURL, request); err != nil {
+			result.Err = urlBuilderError(err)
+		} else {
+			result.Statistics, result.Err = fetchJSON[types.Statistics](env, "GET", endpoint, jsonHeaders(), nil)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerStatisticsResult, result))
+	})
+}
+
+func playOnDevice(env runtime.Env, transportURL string, args PlayOnDeviceArgs) runtime.Effect {
+	device := args.Device
+	time := uint64(0)
+	if args.Time != nil {
+		time = *args.Time
+	}
+	body, bodyErr := types.MarshalJSON(struct {
+		Source string `json:"source"`
+		Time   uint64 `json:"time"`
+	}{args.Source, time})
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerPlayOnDeviceResult{Device: device}
+		if bodyErr != nil {
+			result.Err = runtime.EnvErrorSerde(bodyErr.Error())
+		} else if endpoint, err := types.URLJoin(transportURL, fmt.Sprintf("casting/%s/player", device)); err != nil {
+			result.Err = urlBuilderError(err)
+		} else {
+			result.Err = fetchAnyJSON(env, "POST", endpoint, jsonHeaders(), body)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerPlayOnDeviceResult, result))
+	})
+}
+
+func getHTTPSEndpoint(env runtime.Env, transportURL string, authKey types.AuthKey, ipAddress string) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		result := StreamingServerGetHTTPSResult{URL: transportURL}
+		if endpoint, err := types.URLJoin(transportURL, fmt.Sprintf("/get-https?authKey=%s&ipAddress=%s", authKey, ipAddress)); err != nil {
+			result.Err = urlBuilderError(err)
+		} else {
+			result.Response, result.Err = fetchRequiredJSON[types.GetHTTPSResponse](env, "GET", endpoint, jsonHeaders(), nil)
+		}
+		return msg.InternalMsg(msg.NewInternal(msg.InternalStreamingServerGetHTTPSResult, result))
+	})
+}
