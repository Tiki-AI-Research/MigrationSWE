+type streamFields struct {
+	name, description, thumbnail *string
+	subtitles                    []Subtitles
+	hints                        StreamBehaviorHints
+}
+
+func decodeStreamFields(object map[string]json.RawMessage) (streamFields, error) {
+	var fields streamFields
+	var err error
+	if fields.name, err = decodeOptionalString(object["name"]); err != nil {
+		return fields, err
+	}
+	description, ok := object["description"]
+	if !ok {
+		description = object["title"]
+	}
+	if fields.description, err = decodeOptionalString(description); err != nil {
+		return fields, err
+	}
+	if fields.thumbnail, err = decodeOptionalString(object["thumbnail"]); err != nil {
+		return fields, err
+	}
+	if raw, ok := object["subtitles"]; ok && !isJSONNull(raw) {
+		if fields.subtitles, err = decodeSkipErrors[Subtitles](raw); err != nil {
+			return fields, err
+		}
+	}
+	if raw, ok := object["behaviorHints"]; ok {
+		if err := fields.hints.UnmarshalJSON(raw); err != nil {
+			return fields, err
+		}
+	}
+	return fields, nil
+}
