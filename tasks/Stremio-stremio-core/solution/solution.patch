+func TestSendNextBatchWhilePending(t *testing.T) {
+	a, _, rec := newTestAnalytics(t)
+	a.Emit("e1", nil, "k1", nil)
+	a.Emit("e2", nil, "k2", nil)
+	calls := 0
+	rec.during = func(Batch) {
+		calls++
+		if !a.IsPending() {
+			t.Error("the batch should be pending while sending")
+		}
+		// a batch is already being sent: nothing happens
+		a.SendNextBatch()
+		// events can be emitted while sending
+		a.Emit("e3", nil, "k2", nil)
