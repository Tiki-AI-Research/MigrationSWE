+func TestConcurrentUse(t *testing.T) {
+	a, _, rec := newTestAnalytics(t)
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				a.Emit("e", map[string]any{"j": j}, fmt.Sprintf("k%d", i%2), nil)
+				if j%10 == 0 {
+					a.SendNextBatch()
+				}
+			}
+		}(i)
+	}
+	wg.Wait()
+	a.Flush()
+	total := 0
+	seen := map[uint64]bool{}
+	for _, batch := range rec.sentBatches() {
+		for _, event := range batch.Events {
+			total++
+			seen[event.Number] = true
+		}
+	}
+	if total != 800 || len(seen) != 800 {
+		t.Fatalf("sent %d events (%d unique numbers), want 800", total, len(seen))
+	}
+}
