+
+// ShouldSync reports whether the item should be synced with the API.
+func (i LibraryItem) ShouldSync(now time.Time) bool {
+	yearAgo := now.Add(-365 * 24 * time.Hour)
+	recentlyRemoved := i.Removed && i.Mtime.After(yearAgo)
+	return i.Type != "other" && (!i.Removed || recentlyRemoved)
+}
+
+// IsInContinueWatching reports whether the item is in continue watching.
+func (i LibraryItem) IsInContinueWatching() bool {
+	return i.Type != "other" && (!i.Removed || i.Temp) && i.State.TimeOffset > 0
+}
+
+// Progress returns the watch progress percentage.
+func (i LibraryItem) Progress() float64 {
+	if i.State.TimeOffset > 0 && i.State.Duration > 0 {
+		return float64(i.State.TimeOffset) / float64(i.State.Duration) * 100
+	}
+	return 0
+}
+
+// Watched reports whether the item has been watched.
+func (i LibraryItem) Watched() bool {
+	return i.State.TimesWatched > 0
+}
+
+// ShouldPullNotifications reports whether notifications should be pulled for the item.
+func (i LibraryItem) ShouldPullNotifications() bool {
+	return !i.State.NoNotif && i.Type != "other" && i.Type != "movie" &&
+		i.BehaviorHints.DefaultVideoID == nil && !i.Removed && !i.Temp
+}
+
+// EqNoMtime compares two items ignoring the modification time.
+func (i LibraryItem) EqNoMtime(other LibraryItem) bool {
+	a, b := i, other
+	a.Mtime, b.Mtime = time.Time{}, time.Time{}
+	a.PosterShape, b.PosterShape = a.PosterShape.Normalized(), b.PosterShape.Normalized()
+	return Equal(a, b)
+}
+
+// MarkAsWatched marks the item as watched or unwatched.
+func (i *LibraryItem) MarkAsWatched(now time.Time, isWatched bool) {
+	if isWatched {
+		i.State.TimesWatched = saturatingAddU32(i.State.TimesWatched, 1)
+		lastWatched := now
+		i.State.LastWatched = &lastWatched
+	} else {
+		i.State.TimesWatched = 0
+	}
+}
+
+func updateLastWatched(lastWatched *time.Time, released *time.Time) *time.Time {
+	switch {
+	case lastWatched != nil && released != nil && lastWatched.Before(*released):
+		value := *released
+		return &value
+	case lastWatched == nil:
+		if released == nil {
+			return nil
+		}
+		value := *released
+		return &value
+	}
+	return lastWatched
+}
+
+// MarkVideoAsWatched sets the video as watched or not watched.
+func (i *LibraryItem) MarkVideoAsWatched(watched WatchedBitField, video Video, isWatched bool) {
+	watched = watched.Clone()
+	watched.SetVideo(video.ID, isWatched)
+	field := watched.String()
+	i.State.Watched = &field
+	if isWatched {
+		i.State.LastWatched = updateLastWatched(i.State.LastWatched, video.Released)
+	}
+}
+
+// MarkVideosAsWatched sets the videos as watched or not watched.
+func (i *LibraryItem) MarkVideosAsWatched(watched WatchedBitField, videos []Video, isWatched bool) {
+	watched = watched.Clone()
+	for _, video := range videos {
+		watched.SetVideo(video.ID, isWatched)
+	}
+	field := watched.String()
+	i.State.Watched = &field
+	if isWatched {
+		var released *time.Time
+		if len(videos) > 0 {
+			released = videos[len(videos)-1].Released
+		}
+		i.State.LastWatched = updateLastWatched(i.State.LastWatched, released)
+	}
+}
+
+// AdvanceToVideo moves the continue watching pointer to the video and resets the playback state.
+func (i *LibraryItem) AdvanceToVideo(videoID string) {
+	id := videoID
+	i.State.VideoID = &id
+	i.State.OverallTimeWatched = saturatingAddU64(i.State.OverallTimeWatched, i.State.TimeWatched)
+	i.State.TimeWatched = 0
+	i.State.FlaggedWatched = 0
+	i.State.TimeOffset = 1
+}
+
+func saturatingAddU64(a, b uint64) uint64 {
+	if a+b < a {
+		return ^uint64(0)
+	}
+	return a + b
+}
+
+func saturatingAddU32(a, b uint32) uint32 {
+	if a+b < a {
+		return ^uint32(0)
+	}
+	return a + b
+}
+
+// SaturatingAddU64 adds without overflowing.
+func SaturatingAddU64(a, b uint64) uint64 { return saturatingAddU64(a, b) }
+
+// SaturatingAddU32 adds without overflowing.
+func SaturatingAddU32(a, b uint32) uint32 { return saturatingAddU32(a, b) }
+
+// SaturatingSubU64 subtracts without underflowing.
+func SaturatingSubU64(a, b uint64) uint64 {
+	if b > a {
+		return 0
+	}
+	return a - b
+}
