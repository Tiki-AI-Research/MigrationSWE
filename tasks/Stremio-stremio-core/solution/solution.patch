diff --git a/internal/testenv/env.go b/internal/testenv/env.go
new file mode 100644
index 0000000000000000000000000000000000000000..a2d67379719b96f173cfbc8e505a19792cc1bbf8
--- /dev/null
+++ b/internal/testenv/env.go
@@ -0,0 +1,214 @@
+// Package testenv provides an in-memory runtime.Env for tests: storage is
+// a map, fetching is delegated to FetchFn and the futures are executed
+// synchronously, in FIFO order, before the dispatch returns.
+package testenv
+
+import (
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"sync"
+	"time"
+
+	"github.com/stremio/stremio-core/runtime"
+)
+
+// Request is a request made through Env.Fetch.
+type Request struct {
+	Method  string
+	URL     string
+	Headers map[string]string
+	Body    []byte
+}
+
+// Env is an in-memory environment.
+type Env struct {
+	// Storage holds the serialized values by storage key.
+	Storage map[string]json.RawMessage
+	// FetchFn handles the requests; unhandled requests fail with a fetch error.
+	FetchFn func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError)
+	// Transport, when set, is used for all the addons instead of the HTTP transport.
+	Transport runtime.AddonTransport
+	// NowTime is the time returned by Now.
+	NowTime time.Time
+	// LocalOffset is the offset (in seconds) of the local time zone.
+	LocalOffset int
+	// Requests records all the fetched requests.
+	Requests []Request
+	// Logs records all the logged messages.
+	Logs []string
+	// AnalyticsFlushes counts the calls to FlushAnalytics.
+	AnalyticsFlushes int
+
+	mu       sync.Mutex
+	queue    []func()
+	draining bool
+}
+
+var _ runtime.Env = (*Env)(nil)
+
+// New creates an environment with an empty storage and the current time.
+func New() *Env {
+	return &Env{
+		Storage: map[string]json.RawMessage{},
+		NowTime: time.Now().UTC().Round(0),
+	}
+}
+
+// SetNow sets the time returned by Now.
+func (e *Env) SetNow(now time.Time) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.NowTime = now.UTC().Round(0)
+}
+
+// Fetch records the request and delegates it to FetchFn.
+func (e *Env) Fetch(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+	e.mu.Lock()
+	e.Requests = append(e.Requests, Request{Method: method, URL: url, Headers: headers, Body: body})
+	fetch := e.FetchFn
+	e.mu.Unlock()
+	if fetch == nil {
+		return nil, runtime.EnvErrorFetch(fmt.Sprintf("Unhandled fetch request: %s %s", method, url))
+	}
+	return fetch(method, url, headers, body)
+}
+
+// GetStorage returns the stored value.
+func (e *Env) GetStorage(key string) (json.RawMessage, bool, *runtime.EnvError) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	value, ok := e.Storage[key]
+	if !ok {
+		return nil, false, nil
+	}
+	return append(json.RawMessage{}, value...), true, nil
+}
+
+func isNil(value any) bool {
+	if value == nil {
+		return true
+	}
+	v := reflect.ValueOf(value)
+	switch v.Kind() {
+	case reflect.Pointer, reflect.Interface, reflect.Map, reflect.Slice, reflect.Func:
+		return v.IsNil()
+	}
+	return false
+}
+
+// SetStorage stores the JSON serialization of the value (as encoded by
+// encoding/json); nil removes the key.
+func (e *Env) SetStorage(key string, value any) *runtime.EnvError {
+	if isNil(value) {
+		e.mu.Lock()
+		delete(e.Storage, key)
+		e.mu.Unlock()
+		return nil
+	}
+	data, err := json.Marshal(value)
+	if err != nil {
+		return runtime.EnvErrorSerde(err.Error())
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.Storage == nil {
+		e.Storage = map[string]json.RawMessage{}
+	}
+	e.Storage[key] = data
+	return nil
+}
+
+// ExecConcurrent runs the task synchronously; tasks scheduled while another
+// task runs are queued and executed afterwards in order.
+func (e *Env) ExecConcurrent(f func()) {
+	e.exec(f)
+}
+
+// ExecSequential runs the task like ExecConcurrent.
+func (e *Env) ExecSequential(f func()) {
+	e.exec(f)
+}
+
+func (e *Env) exec(f func()) {
+	e.mu.Lock()
+	e.queue = append(e.queue, f)
+	if e.draining {
+		e.mu.Unlock()
+		return
+	}
+	e.draining = true
+	e.mu.Unlock()
+	defer func() {
+		e.mu.Lock()
+		e.draining = false
+		if r := recover(); r != nil {
+			e.queue = nil
+			e.mu.Unlock()
+			panic(r)
+		}
+		e.mu.Unlock()
+	}()
+	for {
+		e.mu.Lock()
+		if len(e.queue) == 0 {
+			e.mu.Unlock()
+			return
+		}
+		task := e.queue[0]
+		e.queue = e.queue[1:]
+		e.mu.Unlock()
+		task()
+	}
+}
+
+// Now returns NowTime.
+func (e *Env) Now() time.Time {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return e.NowTime
+}
+
+// LocalNow returns NowTime in the local offset.
+func (e *Env) LocalNow() time.Time {
+	now := e.Now()
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.LocalOffset == 0 {
+		return now
+	}
+	return now.In(time.FixedZone("", e.LocalOffset))
+}
+
+// FlushAnalytics counts the flushes.
+func (e *Env) FlushAnalytics() {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.AnalyticsFlushes++
+}
+
+// AnalyticsContext returns no context.
+func (e *Env) AnalyticsContext(ctx any, streamingServer any, path string) any {
+	return nil
+}
+
+// Log records the message.
+func (e *Env) Log(message string) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.Logs = append(e.Logs, message)
+}
+
+// AddonTransport returns Transport if set, otherwise the default transport
+// for the url (the HTTP transport for `http(s)` urls, using Fetch).
+func (e *Env) AddonTransport(transportURL string) runtime.AddonTransport {
+	if e.Transport != nil {
+		return e.Transport
+	}
+	return runtime.NewAddonTransport(transportURL, e)
+}
+
+// MigrateStorageSchema migrates the storage to the latest schema version.
+func (e *Env) MigrateStorageSchema() *runtime.EnvError {
+	return runtime.MigrateStorageSchema(e)
+}
