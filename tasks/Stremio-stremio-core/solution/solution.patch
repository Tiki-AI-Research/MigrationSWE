+//
+// Semver
+//
+
+// Version is a parsed semantic version.
+type Version struct {
+	Major, Minor, Patch uint64
+	Pre                 []string
+	Build               string
+}
+
+// ParseVersion parses a semantic version (`major.minor.patch[-pre][+build]`).
+func ParseVersion(value string) (Version, error) {
+	build := ""
+	if plus := strings.IndexByte(value, '+'); plus >= 0 {
+		value, build = value[:plus], value[plus+1:]
+		if build == "" {
+			return Version{}, errors.New("empty build metadata")
+		}
+	}
+	core, pre, hasPre := strings.Cut(value, "-")
+	parts := strings.Split(core, ".")
+	if len(parts) != 3 {
+		return Version{}, errors.New("unexpected end of input while parsing version")
+	}
+	var numbers [3]uint64
+	for i, part := range parts {
+		if part == "" || (len(part) > 1 && part[0] == '0') {
+			return Version{}, errors.New("invalid version number")
+		}
+		n, err := strconv.ParseUint(part, 10, 64)
+		if err != nil {
+			return Version{}, errors.New("invalid version number")
+		}
+		numbers[i] = n
+	}
+	version := Version{Major: numbers[0], Minor: numbers[1], Patch: numbers[2], Build: build}
+	if hasPre {
+		if pre == "" {
+			return Version{}, errors.New("empty pre-release identifier")
+		}
+		version.Pre = strings.Split(pre, ".")
+	}
+	return version, nil
+}
+
+// CompareVersions compares two semantic versions like the rust `semver`
+// crate: precedence, then the build metadata. Invalid versions compare lexically.
+func CompareVersions(a, b string) int {
+	va, errA := ParseVersion(a)
+	vb, errB := ParseVersion(b)
+	if errA != nil || errB != nil {
+		return strings.Compare(a, b)
+	}
+	if c := comparePrecedence(va, vb); c != 0 {
+		return c
+	}
+	return compareBuild(va.Build, vb.Build)
+}
+
+func comparePrecedence(va, vb Version) int {
+	for _, pair := range [][2]uint64{{va.Major, vb.Major}, {va.Minor, vb.Minor}, {va.Patch, vb.Patch}} {
+		if pair[0] != pair[1] {
+			if pair[0] < pair[1] {
+				return -1
+			}
+			return 1
+		}
+	}
+	switch {
+	case len(va.Pre) == 0 && len(vb.Pre) == 0:
+		return 0
+	case len(va.Pre) == 0:
+		return 1
+	case len(vb.Pre) == 0:
+		return -1
+	}
+	for i := 0; i < len(va.Pre) && i < len(vb.Pre); i++ {
+		if c := comparePreIdentifier(va.Pre[i], vb.Pre[i]); c != 0 {
+			return c
+		}
+	}
+	switch {
+	case len(va.Pre) < len(vb.Pre):
+		return -1
+	case len(va.Pre) > len(vb.Pre):
+		return 1
+	}
+	return 0
+}
+
+func comparePreIdentifier(a, b string) int {
+	na, errA := strconv.ParseUint(a, 10, 64)
+	nb, errB := strconv.ParseUint(b, 10, 64)
+	switch {
+	case errA == nil && errB == nil:
+		switch {
+		case na < nb:
+			return -1
+		case na > nb:
+			return 1
+		}
+		return 0
+	case errA == nil:
+		return -1
+	case errB == nil:
+		return 1
+	}
+	return strings.Compare(a, b)
+}
+
+// compareBuild orders the build metadata like `semver::BuildMetadata`.
+func compareBuild(a, b string) int {
+	left, right := strings.Split(a, "."), strings.Split(b, ".")
+	isDigits := func(value string) bool {
+		for i := 0; i < len(value); i++ {
+			if value[i] < '0' || value[i] > '9' {
+				return false
+			}
+		}
+		return true
+	}
+	for i, l := range left {
+		if i >= len(right) {
+			return 1
+		}
+		r := right[i]
+		var c int
+		switch lDigits, rDigits := isDigits(l), isDigits(r); {
+		case lDigits && rDigits:
+			lv, rv := strings.TrimLeft(l, "0"), strings.TrimLeft(r, "0")
+			c = cmpInt(len(lv), len(rv))
+			if c == 0 {
+				c = strings.Compare(lv, rv)
+			}
+			if c == 0 {
+				c = cmpInt(len(l), len(r))
+			}
+		case lDigits:
+			return -1
+		case rDigits:
+			return 1
+		default:
+			c = strings.Compare(l, r)
+		}
+		if c != 0 {
+			return c
+		}
+	}
+	if len(right) > len(left) {
+		return -1
+	}
+	return 0
+}
+
+func cmpInt(a, b int) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
