+
+func TestActionCtxUpdateSettingsNotChanged(t *testing.T) {
+	settings := authTestSettings()
+	profile := types.NewProfile()
+	profile.Settings = settings
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env)
+	setStorage(t, env, stremiocore.PROFILE_STORAGE_KEY, profile)
+	h := newHarness(t, env, withProfileAndLibrary(env, profile, types.NewLibraryBucket(nil, nil)))
+	h.dispatchCtx(msg.ActionCtxUpdateSettings, settings)
+
+	assertEqual(t, h.ctx().Profile.Settings, settings, "Settings not updated in memory")
+	stored, ok := storageValue[types.Profile](t, env, stremiocore.PROFILE_STORAGE_KEY)
+	if !ok {
+		t.Errorf("Settings not updated in storage: missing key")
+	}
+	assertEqual(t, stored.Settings, settings, "Settings not updated in storage")
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
