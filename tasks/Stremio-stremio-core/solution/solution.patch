+	effects := player.Update(env, playerActionMsg(msg.ActionPlayerStreamStateChanged, map[string]any{
+		"state": map[string]any{"playbackSpeed": 1.5},
+	}), c)
+	if effects.HasChanged || len(effects.Effects) != 1 || effects.Effects[0].Msg == nil {
+		t.Fatalf("expected a StreamStateChanged message: %+v", effects)
