+func (r SkipGapsRequest) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(struct {
+		AuthKey        AuthKey `json:"authKey"`
+		OsHash         string  `json:"osId"`
+		ItemID         string  `json:"itemId"`
+		Season         uint32  `json:"season"`
+		Episode        uint32  `json:"episode"`
+		StreamNameHash string  `json:"stHash"`
+	}{r.AuthKey, r.OsHash, r.ItemID, r.SeriesInfo.Season, r.SeriesInfo.Episode, r.StreamNameHash})
+}
+
+// Datastore commands.
+const (
+	DatastoreCommandMeta = "Meta"
+	DatastoreCommandGet  = "Get"
+	DatastoreCommandPut  = "Put"
+)
+
+// DatastoreCommand is a command of a datastore request.
+type DatastoreCommand struct {
+	Kind    string
+	IDs     []string
+	All     bool
+	Changes []LibraryItem
+}
+
+// DatastoreRequest is a request to the library datastore of the API.
+type DatastoreRequest struct {
+	AuthKey    AuthKey
+	Collection string
+	Command    DatastoreCommand
+}
+
+func (r DatastoreRequest) MarshalJSON() ([]byte, error) {
+	head, err := MarshalJSON(struct {
+		AuthKey    AuthKey `json:"authKey"`
+		Collection string  `json:"collection"`
+	}{r.AuthKey, r.Collection})
+	if err != nil {
+		return nil, err
+	}
+	var command []byte
+	switch r.Command.Kind {
+	case DatastoreCommandGet:
+		command, err = MarshalJSON(struct {
+			IDs []string `json:"ids"`
+			All bool     `json:"all"`
+		}{nonNilSlice(r.Command.IDs), r.Command.All})
+	case DatastoreCommandPut:
+		command, err = MarshalJSON(struct {
+			Changes []LibraryItem `json:"changes"`
+		}{nonNilSlice(r.Command.Changes)})
+	default:
+		command = []byte("{}")
+	}
+	if err != nil {
+		return nil, err
+	}
+	return mergeJSONObjects(head, command), nil
+}
+
+func (r DatastoreRequest) Path() string {
+	switch r.Command.Kind {
+	case DatastoreCommandGet:
+		return "datastoreGet"
+	case DatastoreCommandPut:
+		return "datastorePut"
+	}
+	return "datastoreMeta"
+}
+
+func (r DatastoreRequest) Method() string { return "POST" }
+
+func (r DatastoreRequest) URL() string {
+	return stremiocore.API_URL + "api/" + r.Path()
