+// addonDescriptor is the addon of the addon tests: rust `Descriptor {
+// manifest: Manifest { id, version, name: "name", <empty/None fields>,
+// behavior_hints: Default::default() }, transport_url, flags: Default::default() }`.
+// The transport url must be given in its normalized (rust `Url`) form.
+func addonDescriptor(id, version, transportURL string) types.Descriptor {
+	return types.Descriptor{
+		Manifest: types.Manifest{
+			ID:            id,
+			Version:       version,
+			Name:          "name",
+			Types:         []string{},
+			Resources:     []types.ManifestResource{},
+			Catalogs:      []types.ManifestCatalog{},
