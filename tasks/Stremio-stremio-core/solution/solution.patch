+package ctx
+
+import (
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of the `#[cfg(test)] mod tests` of src/models/ctx/update_library.rs
+
+func libInternalDate(year int, month time.Month, day int) time.Time {
+	return time.Date(year, month, day, 0, 0, 0, 0, time.UTC)
+}
+
+// libInternalItem is rust `library_item(id)`.
+func libInternalItem(id string) types.LibraryItem {
+	ctime := libInternalDate(2020, 1, 1)
+	return types.LibraryItem{
+		ID:          id,
+		Type:        "series",
+		Name:        "name",
+		PosterShape: types.PosterShapePoster,
+		Ctime:       &ctime,
+		Mtime:       libInternalDate(2020, 1, 1),
+	}
+}
+
+func TestShouldUpdateLibraryWithItemsOnlyWhenMergeChangesLibrary(t *testing.T) {
+	item := libInternalItem("id")
+	library := types.NewLibraryBucket(nil, []types.LibraryItem{item})
+
+	if shouldUpdateLibraryWithItems(library, []types.LibraryItem{item}) {
+		t.Errorf("the same item does not update the library")
+	}
+
+	newerItem := item
+	newerItem.Name = "updated"
+	newerItem.Mtime = libInternalDate(2020, 1, 2)
+	if !shouldUpdateLibraryWithItems(library, []types.LibraryItem{newerItem}) {
+		t.Errorf("a newer item updates the library")
+	}
+
+	olderItem := item
+	olderItem.Name = "older"
+	olderItem.Mtime = libInternalDate(2019, 12, 31)
+	if shouldUpdateLibraryWithItems(library, []types.LibraryItem{olderItem}) {
+		t.Errorf("an older item does not update the library")
+	}
+
+	if !shouldUpdateLibraryWithItems(library, []types.LibraryItem{libInternalItem("missing")}) {
+		t.Errorf("a missing item updates the library")
+	}
+}
+
+func TestLibraryPullResultIsUnchangedWhenItemsMatch(t *testing.T) {
+	item := libInternalItem("id")
+	authKey := types.AuthKey("auth_key")
+	profile := types.NewProfile()
+	from := "tests"
+	profile.Auth = &types.Auth{
+		Key: authKey,
+		User: types.User{
+			ID:             "user_id",
+			Email:          "user_email",
+			LastModified:   libInternalDate(2020, 1, 1),
+			DateRegistered: libInternalDate(2020, 1, 1),
+			GDPRConsent: types.GDPRConsent{
+				Tos:       true,
+				Privacy:   true,
+				Marketing: true,
+				From:      &from,
+			},
+		},
+	}
+	request := types.DatastoreRequest{
+		AuthKey:    authKey,
+		Collection: stremiocore.LIBRARY_COLLECTION_NAME,
+		Command: types.DatastoreCommand{
+			Kind: types.DatastoreCommandGet,
+			IDs:  []string{"id"},
+			All:  false,
+		},
+	}
+	m := msg.InternalMsg(msg.NewInternal(msg.InternalLibraryPullResult, LibraryPullResult{
+		Request: request,
+		Items:   []types.LibraryItem{item},
+	}))
+	library := types.NewLibraryBucket(types.NewUID("user_id"), []types.LibraryItem{item})
+	env := testenv.New()
+
+	effects := updateLibrary(env, &library, &profile, &CtxStatus{}, m)
+
+	if effects.HasChanged {
+		t.Errorf("effects are unchanged when the pulled items match the library")
+	}
+	if !types.Equal(library, types.NewLibraryBucket(types.NewUID("user_id"), []types.LibraryItem{item})) {
+		t.Errorf("library not updated: %s", types.MustMarshalJSON(library))
+	}
+}
diff --git a/models/ctx/update_library_test.go b/models/ctx/update_library_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..3a8f0ac2491d02d618f5411c2dd9d079a5f8e900
--- /dev/null
+++ b/models/ctx/update_library_test.go
@@ -0,0 +1,239 @@
+package ctx_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Extra tests of the library persistence of src/models/ctx/update_library.rs
+// (`update_and_push_items_to_storage` and `push_library_to_storage`): the
+// LIBRARY_RECENT_COUNT newest items are stored under `library_recent`, the
+// others under `library`.
+
+// libSplitItems returns count items with increasing (distinct) mtimes:
+// libSplitItems(n)[0] is the oldest one.
+func libSplitItems(count int) []types.LibraryItem {
+	items := make([]types.LibraryItem, 0, count)
+	for i := 0; i < count; i++ {
+		mtime := date(2020, 1, 1).Add(time.Duration(i) * time.Minute)
+		items = append(items, types.LibraryItem{
+			ID:          fmt.Sprintf("id%03d", i),
+			Name:        "name",
+			Type:        "movie",
+			PosterShape: types.PosterShapePoster,
+			Ctime:       timePtr(date(2020, 1, 1)),
+			Mtime:       mtime,
+		})
+	}
+	return items
+}
+
+// libSentinelBucket is a value stored before the test to check whether a
+// storage key has been written.
+func libSentinelBucket() types.LibraryBucket {
+	return types.NewLibraryBucket(uid("sentinel"), []types.LibraryItem{{
+		ID:          "sentinel",
+		Name:        "sentinel",
+		Type:        "movie",
+		PosterShape: types.PosterShapePoster,
+		Mtime:       date(2019, 1, 1),
+	}})
+}
+
+// libWithItem returns a copy of the items with the item replaced (by id).
+func libWithItem(items []types.LibraryItem, item types.LibraryItem) []types.LibraryItem {
+	result := make([]types.LibraryItem, 0, len(items))
+	for _, current := range items {
+		if current.ID == item.ID {
+			current = item
+		}
+		result = append(result, current)
+	}
+	return result
+}
+
+func libItemIDs(items []types.LibraryItem) []string {
+	ids := make([]string, 0, len(items))
+	for _, item := range items {
+		ids = append(ids, item.ID)
+	}
+	return ids
+}
+
+// libAssertPushedToStorageIDs checks the ids of the LibraryItemsPushedToStorage
+// event as a set (rust iterates a HashMap).
+func libAssertPushedToStorageIDs(t *testing.T, h *harness, expected []string) {
+	t.Helper()
+	event := h.findEvent(msg.EventLibraryItemsPushedToStorage)
+	if event == nil {
+		t.Errorf("missing event %s", msg.EventLibraryItemsPushedToStorage)
+		return
+	}
+	var args struct {
+		IDs []string `json:"ids"`
+	}
+	if err := json.Unmarshal(event.Args, &args); err != nil {
+		t.Fatalf("LibraryItemsPushedToStorage args: %v: %s", err, event.Args)
+	}
+	got := append([]string{}, args.IDs...)
+	want := append([]string{}, expected...)
+	sort.Strings(got)
+	sort.Strings(want)
+	assertEqual(t, got, want, "LibraryItemsPushedToStorage ids")
+}
+
+// An update of an item which is among the LIBRARY_RECENT_COUNT newest items
+// of a library with more items writes only the recent slot.
+func TestLibStorageSplitUpdateRecentItem(t *testing.T) {
+	now := date(2021, 1, 1)
+	env := newTestEnv(now)
+	setRoutes(t, env)
+	items := libSplitItems(stremiocore.LIBRARY_RECENT_COUNT + 1)
+	setStorage(t, env, stremiocore.LIBRARY_STORAGE_KEY, libSentinelBucket())
+	setStorage(t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY, libSentinelBucket())
+	h := newHarness(t, env, withProfileAndLibrary(env, types.NewProfile(), types.NewLibraryBucket(nil, items)))
+
+	updated := items[150]
+	updated.State.TimeOffset = 5
+	h.dispatchInternal(msg.InternalUpdateLibraryItem, updated)
+
+	updated.Mtime = now
+	assertEqual(t, h.ctx().Library.Items[updated.ID], updated, "item updated in memory")
+	// items[0] is the oldest: the only one not in the recent slot
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("library_recent written")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(nil, libWithItem(items[1:], updated)), "library_recent has the recent items")
+	other, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("library not removed")
+	}
+	assertEqual(t, other, libSentinelBucket(), "library not written")
+	assertEqual(t, h.coreEventNames(), []string{msg.EventLibraryItemsPushedToStorage}, "events")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage,
+		`{"ids":["id150"]}`, "LibraryItemsPushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+}
+
+// An update of an item which is not among the LIBRARY_RECENT_COUNT newest
+// items (checked before the merge) writes both slots.
+func TestLibStorageSplitUpdateOldItem(t *testing.T) {
+	now := date(2021, 1, 1)
+	env := newTestEnv(now)
+	setRoutes(t, env)
+	items := libSplitItems(stremiocore.LIBRARY_RECENT_COUNT + 1)
+	setStorage(t, env, stremiocore.LIBRARY_STORAGE_KEY, libSentinelBucket())
+	setStorage(t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY, libSentinelBucket())
+	h := newHarness(t, env, withProfileAndLibrary(env, types.NewProfile(), types.NewLibraryBucket(nil, items)))
+
+	updated := items[0]
+	updated.State.TimeOffset = 5
+	h.dispatchInternal(msg.InternalUpdateLibraryItem, updated)
+
+	// the updated item becomes the newest one, items[1] becomes the oldest
+	updated.Mtime = now
+	assertEqual(t, h.ctx().Library.Items[updated.ID], updated, "item updated in memory")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("library_recent written")
+	}
+	expectedRecent := append([]types.LibraryItem{updated}, items[2:]...)
+	if len(expectedRecent) != stremiocore.LIBRARY_RECENT_COUNT {
+		t.Fatalf("bad fixture")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(nil, expectedRecent), "library_recent has the recent items")
+	other, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("library written")
+	}
+	assertEqual(t, other, types.NewLibraryBucket(nil, []types.LibraryItem{items[1]}), "library has the other items")
+	assertEqual(t, h.coreEventNames(), []string{msg.EventLibraryItemsPushedToStorage}, "events")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage,
+		`{"ids":["id000"]}`, "LibraryItemsPushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+// `LibraryChanged(false)` (after a logout) writes both slots, even when the
+// library is small (unlike `UpdateLibraryItem` which removes `library`).
+func TestLibStorageLibraryChangedLogoutWritesBothKeys(t *testing.T) {
+	env := newTestEnv(date(2021, 1, 1))
+	setRoutes(t, env)
+	items := libSplitItems(2)
+	setStorage(t, env, stremiocore.LIBRARY_STORAGE_KEY, libSentinelBucket())
+	setStorage(t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY, libSentinelBucket())
+	h := newHarness(t, env, withProfileAndLibrary(env,
+		loggedInProfile(userFixture(env.Now())),
+		types.NewLibraryBucket(uid("user_id"), items),
+	))
+	// the session is already deleted: no logout request
+	h.dispatchInternal(msg.InternalLogout, true)
+
+	assertEqual(t, h.ctx().Library, types.NewLibraryBucket(nil, nil), "library reset in memory")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("library_recent written")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(nil, nil), "library_recent is empty")
+	other, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("library written (not removed)")
+	}
+	assertEqual(t, other, types.NewLibraryBucket(nil, nil), "library is empty")
+	assertJSONEqual(t, env.Storage[stremiocore.LIBRARY_STORAGE_KEY], `{"uid":null,"items":{}}`, "library json")
+	assertJSONEqual(t, env.Storage[stremiocore.LIBRARY_RECENT_STORAGE_KEY], `{"uid":null,"items":{}}`, "library_recent json")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage,
+		`{"ids":[]}`, "LibraryItemsPushedToStorage")
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+}
+
+// `LibraryChanged(false)` (after an authentication) splits the library
+// between the two slots.
+func TestLibStorageLibraryChangedCtxAuthResultWritesBothKeys(t *testing.T) {
+	env := newTestEnv(date(2021, 1, 1))
+	setRoutes(t, env)
+	items := libSplitItems(stremiocore.LIBRARY_RECENT_COUNT + 1)
+	authRequest := types.AuthRequest{Type: types.AuthRequestLogin, Email: "user_email", Password: "user_password"}
+	c := defaultCtx(env)
+	c.Status = ctx.CtxStatus{Loading: &authRequest}
+	h := newHarness(t, env, c)
+	user := userFixture(env.Now())
+	h.dispatchInternal(msg.InternalCtxAuthResult, ctx.CtxAuthResult{
+		AuthRequest: authRequest,
+		Response: &ctx.CtxAuthResponse{
+			Auth:         types.Auth{Key: "auth_key", User: user},
+			Addons:       types.OfficialAddons(),
+			LibraryItems: items,
+		},
+	})
+
+	assertEqual(t, h.ctx().Library, types.NewLibraryBucket(uid("user_id"), items), "library in memory")
+	recent, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("library_recent written")
+	}
+	assertEqual(t, recent, types.NewLibraryBucket(uid("user_id"), items[1:]), "library_recent has the recent items")
+	other, ok := storageValue[types.LibraryBucket](t, env, stremiocore.LIBRARY_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("library written")
+	}
+	assertEqual(t, other, types.NewLibraryBucket(uid("user_id"), items[:1]), "library has the other items")
+	libAssertPushedToStorageIDs(t, h, libItemIDs(items))
+	// movies: no notifications are pulled
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+}
diff --git a/models/ctx/update_notifications.go b/models/ctx/update_notifications.go
new file mode 100644
index 0000000000000000000000000000000000000000..6fdeb0692143d976fcaa635626a760d0fc6cdb3d
--- /dev/null
+++ b/models/ctx/update_notifications.go
@@ -0,0 +1,238 @@
+package ctx
+
+import (
+	"sort"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// REQUEST_LAST_VIDEOS_EVERY is the minimum interval between two requests of
+// the `lastVideosIds` catalogs.
+const REQUEST_LAST_VIDEOS_EVERY = 6 * time.Hour
+
+func updateNotifications(env runtime.Env, notifications *types.NotificationsBucket, notificationCatalogs *[]common.ResourceLoadable[[]types.MetaItem], profile *types.Profile, library *types.LibraryBucket, status *CtxStatus, m *msg.Msg) runtime.Effects {
+	if isCtxAction(m, msg.ActionCtxPullNotifications) {
+		return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalPullNotifications, nil))).Unchanged()
+	}
+	if m.IsInternal(msg.InternalPullNotifications) {
+		now := env.Now()
+		shouldMakeRequest := notifications.LastUpdated == nil || !notifications.LastUpdated.Add(REQUEST_LAST_VIDEOS_EVERY).After(now)
+
+		libraryItems := make([]types.LibraryItem, 0, len(library.Items))
+		for _, item := range library.Items {
+			if item.ShouldPullNotifications() {
+				libraryItems = append(libraryItems, item)
+			}
+		}
+		sort.SliceStable(libraryItems, func(i, j int) bool {
+			if !libraryItems[i].Mtime.Equal(libraryItems[j].Mtime) {
+				return libraryItems[i].Mtime.After(libraryItems[j].Mtime)
+			}
+			return libraryItems[i].ID < libraryItems[j].ID
+		})
+		idTypes := make([][2]string, 0, len(libraryItems))
+		for _, item := range libraryItems {
+			idTypes = append(idTypes, [2]string{item.ID, item.Type})
+		}
+
+		catalogResourceEffects := runtime.NoneEffects().Unchanged()
+		if len(idTypes) > 0 && shouldMakeRequest {
+			limit := stremiocore.NOTIFICATION_ITEMS_COUNT
+			// force the making of a requests every time PullNotifications is called.
+			catalogResourceEffects = common.ResourcesRequestedUpdate(env, notificationCatalogs, common.ResourcesRequest{
+				Request: types.AggrRequest{
+					Kind: types.AggrRequestCatalogsFiltered,
+					ExtraTypes: []types.ExtraTypeIDs{{
+						ExtraName: types.LAST_VIDEOS_IDS_EXTRA_PROP.Name,
+						IDTypes:   idTypes,
+						Limit:     &limit,
+					}},
+				},
+				Addons: profile.Addons,
+				Force:  true,
+			})
+			lastUpdated := now
+			notifications.LastUpdated = &lastUpdated
+		}
+		// first update the notification items
+		notificationItemsEffects := updateNotificationItems(env, &notifications.Items, *notificationCatalogs, library)
+		// because notifications are getting loaded by forcing new requests
+		// we do not trigger a `NotificationsChanged` as the addons should return results first.
+		return catalogResourceEffects.Join(notificationItemsEffects).Unchanged()
+	}
+	if isCtxAction(m, msg.ActionCtxDismissNotificationItem) {
+		var id string
+		if !decodeStrictCtxAction(m, msg.ActionCtxDismissNotificationItem, &id) {
+			return runtime.NoneEffects().Unchanged()
+		}
+		return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalDismissNotificationItem, id))).Unchanged()
+	}
+	if m.IsInternal(msg.InternalLogout) {
+		return resetNotifications(env, notifications, notificationCatalogs, profile).Unchanged()
+	}
+	if result, ok := InternalCtxAuthResultData(m); ok {
+		if !status.IsLoading(result.AuthRequest) || result.Response == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		pullNotificationsEffects := runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalPullNotifications, nil))).Unchanged()
+		return resetNotifications(env, notifications, notificationCatalogs, profile).
+			Join(pullNotificationsEffects).
+			Unchanged()
+	}
+	if action, ok := common.ResourceActionFromMsg(m); ok {
+		notificationCatalogsEffects := common.ResourcesResultUpdate(notificationCatalogs, action, common.MetaItemsFromResponse, true)
+		notificationItemsEffects := runtime.NoneEffects().Unchanged()
+		if notificationCatalogsEffects.HasChanged {
+			notificationItemsEffects = updateNotificationItems(env, &notifications.Items, *notificationCatalogs, library)
+		}
+		notificationsEffects := runtime.NoneEffects().Unchanged()
+		if notificationItemsEffects.HasChanged {
+			notificationsEffects = notificationsChangedEffects()
+		}
+		return notificationCatalogsEffects.
+			Join(notificationItemsEffects).
+			Join(notificationsEffects)
+	}
+	if id, ok := InternalStringData(m, msg.InternalDismissNotificationItem); ok {
+		return dismissNotificationItem(env, library, notifications, id)
+	}
+	if m.IsInternal(msg.InternalNotificationsChanged) {
+		return runtime.OneEffect(pushNotificationsToStorage(env, notifications)).Unchanged()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+// resetNotifications clears the notification catalogs and creates a new
+// notifications bucket for the user.
+func resetNotifications(env runtime.Env, notifications *types.NotificationsBucket, notificationCatalogs *[]common.ResourceLoadable[[]types.MetaItem], profile *types.Profile) runtime.Effects {
+	notificationCatalogsEffects := common.EqUpdate(notificationCatalogs, []common.ResourceLoadable[[]types.MetaItem]{})
+	nextNotifications := types.NewNotificationsBucket(env.Now(), profile.UID(), nil)
+	notificationsEffects := runtime.NoneEffects().Unchanged()
+	if !types.Equal(*notifications, nextNotifications) {
+		*notifications = nextNotifications
+		notificationsEffects = notificationsChangedEffects()
+	}
+	return notificationCatalogsEffects.Join(notificationsEffects)
+}
+
+func notificationsChangedEffects() runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalNotificationsChanged, nil)))
+}
+
+func updateNotificationItems(env runtime.Env, notificationItems *map[string]map[string]types.NotificationItem, notificationCatalogs []common.ResourceLoadable[[]types.MetaItem], library *types.LibraryBucket) runtime.Effects {
+	// take all catalogs with successful result or error
+	selectedCatalogs := make([]common.ResourceLoadable[[]types.MetaItem], 0, len(notificationCatalogs))
+	for _, catalog := range notificationCatalogs {
+		if catalog.Content != nil && (catalog.Content.IsReady() || catalog.Content.IsErr()) {
+			selectedCatalogs = append(selectedCatalogs, catalog)
+		}
+	}
+	now := env.Now()
+	// shared function to decide if a given video should be included in
+	// notifications or excluded
+	shouldRetainVideoReleased := func(lastWatched *time.Time, videoReleased *time.Time) bool {
+		switch {
+		case lastWatched != nil && videoReleased != nil:
+			// exclude future videos (i.e. that will air in the future)
+			return lastWatched.Before(*videoReleased) && !videoReleased.After(now)
+		case lastWatched == nil && videoReleased != nil:
+			// if you've never watched an episode, then we want to include new videos
+			return true
+		}
+		return false
+	}
+	findMetaItem := func(metaID string) *types.MetaItem {
+		// find the first occurrence of the meta item inside the catalogs
+		for _, catalog := range selectedCatalogs {
+			content, ok := catalog.Content.Ready()
+			if !ok {
+				continue
+			}
+			for i := range content {
+				if content[i].Preview.ID == metaID && len(content[i].Videos) > 0 {
+					return &content[i]
+				}
+			}
+		}
+		return nil
+	}
+
+	nextNotificationItems := map[string]map[string]types.NotificationItem{}
+	for metaID, libraryItem := range library.Items {
+		// Exit early if we don't need to pull notifications for the library item
+		if !libraryItem.ShouldPullNotifications() {
+			continue
+		}
+		metaItem := findMetaItem(metaID)
+		if metaItem == nil {
+			// try to default to currently existing notifications in the bucket before returning
+			if existingNotifications := (*notificationItems)[metaID]; len(existingNotifications) > 0 {
+				filteredNotifications := map[string]types.NotificationItem{}
+				for videoID, notification := range existingNotifications {
+					// filter by the same requirements as new videos
+					// to remove videos that no longer match
+					released := notification.VideoReleased
+					if shouldRetainVideoReleased(libraryItem.State.LastWatched, &released) {
+						filteredNotifications[videoID] = notification
+					}
+				}
+				nextNotificationItems[metaID] = filteredNotifications
+			}
+			continue
+		}
+		metaNotifications := map[string]types.NotificationItem{}
+		for _, video := range metaItem.VideosIter() {
+			if libraryItem.State.LastWatched == nil || video.Released == nil {
+				continue
+			}
+			if !shouldRetainVideoReleased(libraryItem.State.LastWatched, video.Released) {
+				continue
+			}
+			// for now just skip same videos that already exist
+			// leave the first one found in the Vec.
+			if _, exists := metaNotifications[video.ID]; exists {
+				continue
+			}
+			metaNotifications[video.ID] = types.NotificationItem{
+				MetaID:        libraryItem.ID,
+				VideoID:       video.ID,
+				VideoReleased: *video.Released,
+			}
+		}
+		// if not videos were added and the hashmap is empty, just remove the MetaItem record all together
+		if len(metaNotifications) > 0 {
+			nextNotificationItems[metaID] = metaNotifications
+		}
+	}
+	return common.EqUpdate(notificationItems, nextNotificationItems)
+}
+
+func pushNotificationsToStorage(env runtime.Env, notifications *types.NotificationsBucket) runtime.Effect {
+	ids := sortedKeys(notifications.Items)
+	return common.StorageFuture(env, stremiocore.NOTIFICATIONS_STORAGE_KEY, *notifications,
+		storageResult(msg.IDsEvent(msg.EventNotificationsPushedToStorage, ids)))
+}
+
+func dismissNotificationItem(env runtime.Env, library *types.LibraryBucket, notifications *types.NotificationsBucket, id string) runtime.Effects {
+	if _, ok := notifications.Items[id]; !ok {
+		return runtime.NoneEffects().Unchanged()
+	}
+	delete(notifications.Items, id)
+	// when dismissing notifications, make sure we update the `last_watched`
+	// of the LibraryItem this way if we've only `DismissedNotificationItem`
+	// the next time we `PullNotifications` we won't see the same notifications.
+	libraryItemEffects := runtime.NoneEffects().Unchanged()
+	if libraryItem, ok := library.Items[id]; ok {
+		lastWatched := env.Now()
+		libraryItem.State.LastWatched = &lastWatched
+		libraryItemEffects = updateLibraryItemEffects(libraryItem).Unchanged()
+	}
+	return notificationsChangedEffects().
+		Join(libraryItemEffects).
+		Join(runtime.MsgEffects(msg.EventMsg(msg.IDEvent(msg.EventNotificationsDismissed, id))))
+}
