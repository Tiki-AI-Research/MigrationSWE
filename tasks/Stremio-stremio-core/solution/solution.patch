+	return nil
+}
+
+func decodeRequiredString(object map[string]json.RawMessage, key string) (string, error) {
+	raw, ok := object[key]
+	if !ok {
+		return "", fmt.Errorf("missing field `%s`", key)
+	}
+	var value string
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return "", fmt.Errorf("invalid type for `%s`: %w", key, err)
+	}
+	return value, nil
+}
+
+func decodeOptionalString(raw json.RawMessage) (*string, error) {
+	if isJSONNull(raw) {
+		return nil, nil
+	}
+	var value string
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return nil, err
+	}
+	return &value, nil
+}
+
+// decodeOptionalURLEmptyAsNone decodes `DefaultOnNull<NoneAsEmptyString>` for `Option<Url>`.
+func decodeOptionalURLEmptyAsNone(raw json.RawMessage) (*string, error) {
+	value, err := decodeOptionalString(raw)
+	if err != nil || value == nil || *value == "" {
+		return nil, err
+	}
+	if !IsValidURL(*value) {
+		return nil, fmt.Errorf("relative URL without a base: %s", *value)
+	}
+	return value, nil
+}
+
+// decodeNumberAsString decodes `Option<NumberAsString>`.
+func decodeNumberAsString(raw json.RawMessage) (*string, error) {
+	if isJSONNull(raw) {
+		return nil, nil
+	}
+	var text string
+	if err := json.Unmarshal(raw, &text); err == nil {
+		return &text, nil
+	}
+	var number float64
+	if err := json.Unmarshal(raw, &number); err != nil {
+		return nil, errors.New("data did not match any variant of untagged enum Helper")
+	}
+	formatted := formatRustF64Display(number)
+	return &formatted, nil
+}
+
+// formatRustF64Display formats a float like rust's `f64::to_string`.
+func formatRustF64Display(value float64) string {
+	if math.IsInf(value, 1) {
+		return "inf"
+	}
+	if math.IsInf(value, -1) {
+		return "-inf"
+	}
+	if math.IsNaN(value) {
+		return "NaN"
+	}
+	return strconv.FormatFloat(value, 'f', -1, 64)
+}
+
+// decodeReleased decodes `PickFirst<(DateTime, Option<TimestampMilliSeconds>)>`.
+func decodeReleased(raw json.RawMessage) (*time.Time, error) {
+	if isJSONNull(raw) {
+		return nil, nil
+	}
+	var text string
+	if err := json.Unmarshal(raw, &text); err == nil {
+		parsed, err := ParseTime(text)
+		if err != nil {
+			return nil, err
+		}
+		parsed = parsed.UTC()
+		return &parsed, nil
+	}
+	var millis float64
+	if err := json.Unmarshal(raw, &millis); err != nil {
+		return nil, errors.New("invalid released date")
+	}
+	released := time.UnixMilli(int64(millis)).UTC()
+	return &released, nil
+}
+
+func metaItemPreviewFromLegacy(object map[string]json.RawMessage) (MetaItemPreview, error) {
+	var preview MetaItemPreview
+	var err error
+	if preview.ID, err = decodeRequiredString(object, "id"); err != nil {
+		return preview, err
+	}
+	if preview.Type, err = decodeRequiredString(object, "type"); err != nil {
+		return preview, err
+	}
+	if raw, ok := object["name"]; ok && !isJSONNull(raw) {
+		if err := json.Unmarshal(raw, &preview.Name); err != nil {
+			return preview, err
+		}
+	}
+	if preview.Poster, err = decodeOptionalURLEmptyAsNone(object["poster"]); err != nil {
+		return preview, err
+	}
+	if preview.Background, err = decodeOptionalURLEmptyAsNone(object["background"]); err != nil {
+		return preview, err
+	}
+	if preview.Logo, err = decodeOptionalURLEmptyAsNone(object["logo"]); err != nil {
+		return preview, err
+	}
+	if preview.Description, err = decodeOptionalString(object["description"]); err != nil {
+		return preview, err
+	}
+	if preview.ReleaseInfo, err = decodeNumberAsString(object["releaseInfo"]); err != nil {
+		return preview, err
+	}
+	if preview.Runtime, err = decodeNumberAsString(object["runtime"]); err != nil {
+		return preview, err
+	}
+	if preview.Released, err = decodeReleased(object["released"]); err != nil {
+		return preview, err
+	}
+	preview.PosterShape = PosterShapePoster
+	if raw, ok := object["posterShape"]; ok && !isJSONNull(raw) {
+		if err := json.Unmarshal(raw, &preview.PosterShape); err != nil {
+			return preview, err
+		}
+	}
+	imdbRating, err := decodeNumberAsString(object["imdbRating"])
+	if err != nil {
+		return preview, err
+	}
+	genres := []string{}
+	if raw, ok := object["genres"]; ok && !isJSONNull(raw) {
+		if err := json.Unmarshal(raw, &genres); err != nil {
+			return preview, err
+		}
+	}
+	var links []Link
+	hasLinks := false
+	if raw, ok := object["links"]; ok && !isJSONNull(raw) {
+		if err := json.Unmarshal(raw, &links); err != nil {
+			return preview, err
+		}
+		hasLinks = true
+	}
+	type trailer struct {
+		Source string `json:"source"`
+		Type   string `json:"type"`
+	}
+	trailers := []trailer{}
+	if raw, ok := object["trailers"]; ok && !isJSONNull(raw) {
+		var items []json.RawMessage
+		if err := json.Unmarshal(raw, &items); err != nil {
+			return preview, err
+		}
+		for _, item := range items {
+			var t trailer
+			var check struct {
+				Source *string `json:"source"`
+				Type   *string `json:"type"`
+			}
+			if err := json.Unmarshal(item, &check); err == nil && check.Source != nil && check.Type != nil {
+				t = trailer{Source: *check.Source, Type: *check.Type}
+			} else {
+				var stream Stream
+				if err := json.Unmarshal(item, &stream); err != nil {
+					return preview, err
+				}
+				if stream.Source.Kind != StreamSourceYouTube {
+					return preview, errors.New("Unsuported Trailer StreamSource")
+				}
+				t = trailer{Source: stream.Source.YtID, Type: "Trailer"}
+			}
+			trailers = append(trailers, t)
+		}
+	}
+	var trailerStreams []Stream
+	hasTrailerStreams := false
+	if raw, ok := object["trailerStreams"]; ok && !isJSONNull(raw) {
+		if err := json.Unmarshal(raw, &trailerStreams); err != nil {
+			return preview, err
+		}
+		hasTrailerStreams = true
+	}
+	if raw, ok := object["behaviorHints"]; ok {
+		if err := preview.BehaviorHints.UnmarshalJSON(raw); err != nil {
+			return preview, err
+		}
+	}
+
+	if hasLinks {
+		preview.Links = nonNilSlice(links)
+	} else {
+		preview.Links = []Link{}
+		if imdbRating != nil {
+			preview.Links = append(preview.Links, Link{
+				Name:     *imdbRating,
+				Category: stremiocore.IMDB_LINK_CATEGORY,
+				URL:      stremiocore.IMDB_URL + stremiocore.IMDB_TITLE_PATH + "/" + EncodeURIComponent(preview.ID),
+			})
+		}
+		for _, genre := range genres {
+			extra := []ExtraValue{{Name: "genre", Value: genre}}
+			preview.Links = append(preview.Links, Link{
+				Name:     genre,
+				Category: stremiocore.GENRES_LINK_CATEGORY,
+				URL: fmt.Sprintf("stremio:///discover/%s/%s/%s?%s",
+					EncodeURIComponent(stremiocore.CINEMETA_URL),
+					EncodeURIComponent(preview.Type),
+					EncodeURIComponent(stremiocore.CINEMETA_TOP_CATALOG_ID),
+					QueryParamsEncode(ExtraValuesQueryParams(extra))),
+			})
+		}
+	}
+	if hasTrailerStreams {
+		preview.TrailerStreams = nonNilSlice(trailerStreams)
+	} else {
+		preview.TrailerStreams = []Stream{}
+		for _, t := range trailers {
+			if t.Type == "Trailer" {
+				preview.TrailerStreams = append(preview.TrailerStreams, Stream{
+					Source: StreamSource{Kind: StreamSourceYouTube, YtID: t.Source},
+				})
+			}
+		}
+	}
+	return preview, nil
+}
+
+// MetaItem is a meta item with its videos.
+type MetaItem struct {
+	Preview MetaItemPreview
+	Videos  []Video
+}
+
+func (m MetaItem) MarshalJSON() ([]byte, error) {
+	preview, err := MarshalJSON(m.Preview.toJSON())
+	if err != nil {
+		return nil, err
+	}
+	videos, err := MarshalJSON(struct {
+		Videos []Video `json:"videos"`
+	}{nonNilSlice(m.Videos)})
+	if err != nil {
+		return nil, err
+	}
+	return mergeJSONObjects(preview, videos), nil
+}
+
+func (m *MetaItem) UnmarshalJSON(data []byte) error {
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(data, &object); err != nil {
+		return err
+	}
+	if object == nil {
+		return errors.New("invalid type: null, expected struct MetaItem")
+	}
+	preview, err := metaItemPreviewFromLegacy(object)
+	if err != nil {
+		return err
+	}
+	videos := []Video{}
+	if raw, ok := object["videos"]; ok && !isJSONNull(raw) {
+		if err := json.Unmarshal(raw, &videos); err != nil {
+			return err
+		}
+	}
+	*m = MetaItem{Preview: preview, Videos: SortVideos(UniqueVideos(videos))}
+	return nil
+}
+
+// UniqueVideos removes the videos with duplicated ids, keeping the first ones.
+func UniqueVideos(videos []Video) []Video {
+	result := []Video{}
+	seen := map[string]bool{}
+	for _, video := range videos {
+		if seen[video.ID] {
+			continue
+		}
+		seen[video.ID] = true
+		result = append(result, video)
+	}
+	return result
+}
+
+// SortVideos sorts the videos by season and episode (specials last) or by
+// release date (`VideoSortedVecAdapter`).
+func SortVideos(videos []Video) []Video {
+	isSeries := false
+	for _, video := range videos {
+		if video.SeriesInfo != nil {
+			isSeries = true
+			break
+		}
+	}
+	sorted := append([]Video{}, videos...)
+	sort.SliceStable(sorted, func(i, j int) bool {
+		return compareVideos(&sorted[i], &sorted[j], isSeries) < 0
+	})
+	return sorted
+}
+
+func compareVideos(a, b *Video, isSeries bool) int {
+	switch {
+	case a.SeriesInfo != nil && b.SeriesInfo != nil:
+		aSeason, bSeason := uint64(a.SeriesInfo.Season), uint64(b.SeriesInfo.Season)
+		if aSeason == 0 {
+			aSeason = math.MaxUint32
+		}
+		if bSeason == 0 {
+			bSeason = math.MaxUint32
+		}
+		if aSeason != bSeason {
+			return cmpUint(aSeason, bSeason)
+		}
+		return cmpUint(uint64(a.SeriesInfo.Episode), uint64(b.SeriesInfo.Episode))
+	case a.SeriesInfo != nil:
+		return -1
+	case b.SeriesInfo != nil:
+		return 1
+	case a.Released != nil && b.Released != nil:
+		c := a.Released.Compare(*b.Released)
+		if isSeries {
+			return c
+		}
+		return -c
+	case a.Released != nil:
+		return -1
+	case b.Released != nil:
+		return 1
+	}
+	return 0
+}
+
+func cmpUint(a, b uint64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+// VideosIter returns the videos of a series without the specials (season 0),
+// or the videos in reverse order for other types.
+func (m MetaItem) VideosIter() []Video {
+	result := []Video{}
+	if m.Preview.Type == "series" {
+		for _, video := range m.Videos {
+			if video.SeriesInfo != nil && video.SeriesInfo.Season != 0 {
+				result = append(result, video)
+			}
+		}
+		return result
+	}
+	for i := len(m.Videos) - 1; i >= 0; i-- {
+		result = append(result, m.Videos[i])
+	}
+	return result
+}
+
+// NextVideo returns the next released video after the given one, without
+// crossing into season 0 specials. Videos without a release date are
+// treated as released.
+func (m MetaItem) NextVideo(videoID string, now time.Time) *Video {
+	for pos := range m.Videos {
+		if m.Videos[pos].ID != videoID {
+			continue
+		}
+		if pos+1 >= len(m.Videos) {
+			return nil
+		}
+		current, next := m.Videos[pos], m.Videos[pos+1]
+		var currentSeason, nextSeason uint32
+		if current.SeriesInfo != nil {
+			currentSeason = current.SeriesInfo.Season
+		}
+		if next.SeriesInfo != nil {
+			nextSeason = next.SeriesInfo.Season
+		}
+		released := next.Released == nil || !next.Released.After(now)
+		if (nextSeason != 0 || currentSeason == nextSeason) && released {
+			return &m.Videos[pos+1]
+		}
+		return nil
+	}
+	return nil
+}
+
+// VideosBySeason returns the videos of the given season.
+func (m MetaItem) VideosBySeason(season uint32) []Video {
+	result := []Video{}
+	for _, video := range m.Videos {
+		if video.SeriesInfo != nil && video.SeriesInfo.Season == season {
+			result = append(result, video)
+		}
+	}
+	return result
+}
+
+// Video is a video of a meta item.
+type Video struct {
+	ID             string
+	Title          string
+	Released       *time.Time
+	Overview       *string
+	Thumbnail      *string
+	Streams        []Stream
+	SeriesInfo     *SeriesInfo
+	TrailerStreams []Stream
+}
+
+func (v Video) MarshalJSON() ([]byte, error) {
+	head, err := MarshalJSON(struct {
+		ID        string   `json:"id"`
+		Title     string   `json:"title"`
+		Released  *Time    `json:"released"`
+		Overview  *string  `json:"overview"`
+		Thumbnail *string  `json:"thumbnail"`
+		Streams   []Stream `json:"streams"`
+	}{v.ID, v.Title, timePtr(v.Released), v.Overview, v.Thumbnail, nonNilSlice(v.Streams)})
+	if err != nil {
+		return nil, err
+	}
+	if v.SeriesInfo != nil {
+		seriesInfo, err := MarshalJSON(v.SeriesInfo)
+		if err != nil {
+			return nil, err
+		}
+		head = mergeJSONObjects(head, seriesInfo)
+	}
+	tail, err := MarshalJSON(struct {
+		TrailerStreams []Stream `json:"trailerStreams"`
+	}{nonNilSlice(v.TrailerStreams)})
+	if err != nil {
+		return nil, err
+	}
+	return mergeJSONObjects(head, tail), nil
+}
+
+func (v *Video) UnmarshalJSON(data []byte) error {
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(data, &object); err != nil {
+		return err
+	}
+	if object == nil {
+		return errors.New("invalid type: null, expected struct Video")
+	}
+	var video Video
+	var err error
+	if video.ID, err = decodeRequiredString(object, "id"); err != nil {
+		return err
+	}
+	title, hasTitle := object["title"]
+	if !hasTitle {
+		title, hasTitle = object["name"]
+	}
+	if hasTitle {
+		if err := json.Unmarshal(title, &video.Title); err != nil {
+			return err
+		}
+	}
+	if raw, ok := object["released"]; ok && !isJSONNull(raw) {
+		var text string
+		if err := json.Unmarshal(raw, &text); err != nil {
+			return err
+		}
+		released, err := ParseTime(text)
+		if err != nil {
+			return err
+		}
+		released = released.UTC()
+		video.Released = &released
+	}
+	if video.Overview, err = decodeOptionalString(object["overview"]); err != nil {
+		return err
+	}
+	if video.Thumbnail, err = decodeOptionalString(object["thumbnail"]); err != nil {
+		return err
+	}
+	streams, hasStreams := object["streams"]
+	if !hasStreams {
+		streams, hasStreams = object["stream"]
+	}
+	video.Streams = []Stream{}
+	if hasStreams {
+		var many []Stream
+		if err := json.Unmarshal(streams, &many); err == nil {
+			video.Streams = nonNilSlice(many)
+		} else {
+			var one Stream
+			if err := json.Unmarshal(streams, &one); err != nil {
+				return err
+			}
+			video.Streams = []Stream{one}
+		}
+	}
+	seasonRaw, hasSeason := object["season"]
+	episodeRaw, hasEpisode := object["episode"]
+	if hasSeason && hasEpisode {
+		var season, episode uint32
+		if json.Unmarshal(seasonRaw, &season) == nil && json.Unmarshal(episodeRaw, &episode) == nil {
+			video.SeriesInfo = &SeriesInfo{Season: season, Episode: episode}
+		}
+	}
+	video.TrailerStreams = []Stream{}
+	if raw, ok := object["trailerStreams"]; ok {
+		if err := json.Unmarshal(raw, &video.TrailerStreams); err != nil {
+			return err
+		}
+		video.TrailerStreams = nonNilSlice(video.TrailerStreams)
+	}
+	*v = video
+	return nil
+}
+
+// Stream returns the single stream of the video, or a YouTube stream for
+// `yt_id:` videos without streams.
+func (v Video) Stream() *Stream {
+	if len(v.Streams) == 1 {
+		stream := v.Streams[0]
+		return &stream
+	}
+	if len(v.Streams) == 0 {
+		return YouTubeStream(v.ID)
+	}
+	return nil
+}
