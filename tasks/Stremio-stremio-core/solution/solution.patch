+// StreamBehaviorHints are the behavior hints of a stream.
+type StreamBehaviorHints struct {
+	NotWebReady      bool
+	BingeGroup       *string
+	CountryWhitelist []string
+	ProxyHeaders     *StreamProxyHeaders
+	Filename         *string
+	VideoHash        *string
+	VideoSize        *uint64
+	// Other holds any other (unknown) hints.
+	Other map[string]json.RawMessage
+}
+
+// IsDefault reports whether the hints are all unset.
+func (h StreamBehaviorHints) IsDefault() bool {
+	return !h.NotWebReady && h.BingeGroup == nil && h.CountryWhitelist == nil && h.ProxyHeaders == nil &&
+		h.Filename == nil && h.VideoHash == nil && h.VideoSize == nil && len(h.Other) == 0
+}
+
+func (h StreamBehaviorHints) MarshalJSON() ([]byte, error) {
+	head, err := MarshalJSON(struct {
+		NotWebReady      bool                `json:"notWebReady,omitempty"`
+		BingeGroup       *string             `json:"bingeGroup,omitempty"`
+		CountryWhitelist *[]string           `json:"countryWhitelist,omitempty"`
+		ProxyHeaders     *StreamProxyHeaders `json:"proxyHeaders,omitempty"`
+		Filename         *string             `json:"filename,omitempty"`
+		VideoHash        *string             `json:"videoHash,omitempty"`
+		VideoSize        *uint64             `json:"videoSize,omitempty"`
+	}{h.NotWebReady, h.BingeGroup, optionalSlice(h.CountryWhitelist), h.ProxyHeaders, h.Filename, h.VideoHash, h.VideoSize})
+	if err != nil {
+		return nil, err
+	}
+	if len(h.Other) == 0 {
+		return head, nil
+	}
+	other, err := MarshalJSON(h.Other)
+	if err != nil {
+		return nil, err
+	}
+	return mergeJSONObjects(head, other), nil
+}
+
+func optionalSlice(values []string) *[]string {
+	if values == nil {
+		return nil
+	}
+	return &values
+}
+
+func (h *StreamBehaviorHints) UnmarshalJSON(data []byte) error {
+	*h = StreamBehaviorHints{}
+	if isJSONNull(data) {
+		return nil
+	}
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(data, &object); err != nil {
+		return err
+	}
+	for key, raw := range object {
+		var err error
+		switch key {
+		case "notWebReady":
+			if !isJSONNull(raw) {
+				err = json.Unmarshal(raw, &h.NotWebReady)
+			}
+		case "bingeGroup":
+			h.BingeGroup, err = decodeOptionalString(raw)
+		case "countryWhitelist":
+			if !isJSONNull(raw) {
+				err = json.Unmarshal(raw, &h.CountryWhitelist)
+				h.CountryWhitelist = nonNilSlice(h.CountryWhitelist)
+			}
+		case "proxyHeaders":
+			if !isJSONNull(raw) {
+				h.ProxyHeaders = &StreamProxyHeaders{}
+				err = json.Unmarshal(raw, h.ProxyHeaders)
+			}
+		case "filename":
+			h.Filename, err = decodeOptionalString(raw)
+		case "videoHash":
+			h.VideoHash, err = decodeOptionalString(raw)
+		case "videoSize":
+			if !isJSONNull(raw) {
+				var size uint64
+				err = json.Unmarshal(raw, &size)
+				h.VideoSize = &size
+			}
+		default:
+			if h.Other == nil {
+				h.Other = map[string]json.RawMessage{}
+			}
+			h.Other[key] = compactJSON(raw)
+		}
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
