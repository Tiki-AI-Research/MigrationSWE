+	{bytes.Repeat([]byte{0x55}, 60), "eJydwIEAAAAAgCDK/FV2OL4AX/gT7Q==", "eAEBPADD/1VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV/4E+0="},
+}
+
+func TestZlibReference(t *testing.T) {
+	for _, test := range zlibReferenceTests {
+		if got := base64.StdEncoding.EncodeToString(ZlibCompress(test.input)); got != test.level6 {
+			t.Errorf("ZlibCompress(%q) = %s, want %s", test.input, got, test.level6)
+		}
+		if got := base64.StdEncoding.EncodeToString(ZlibStore(test.input)); got != test.level0 {
+			t.Errorf("ZlibStore(%q) = %s, want %s", test.input, got, test.level0)
+		}
+	}
+}
+
+// zlibVectorExpectations holds, for each generated input, its length and the
+// length and truncated sha256 of the Rust outputs at level 6 and level 0.
+var zlibVectorExpectations = []struct {
