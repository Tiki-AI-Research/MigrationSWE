+// NewDiscoverDeepLinks creates the deep links of the catalog request.
+func NewDiscoverDeepLinks(request types.ResourceRequest) DiscoverDeepLinks {
+	return DiscoverDeepLinks{
+		Discover: "stremio:///discover/" + encURL(request.Base) + "/" + enc(request.Path.Type) + "/" +
+			enc(request.Path.ID) + "?" + types.QueryParamsEncode(types.ExtraValuesQueryParams(request.Path.Extra)),
+	}
+}
