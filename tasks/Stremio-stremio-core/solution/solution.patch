+// Profile is the user profile: authentication, addons and settings.
+type Profile struct {
+	Auth   *Auth
+	Addons []Descriptor
+	// AddonsLocked is raised when fetching the addons from the API failed, in
+	// order to avoid overwriting the user's addons with the official ones.
+	AddonsLocked bool
+	Settings     Settings
+}
+
+type profileJSON struct {
+	Auth         *Auth        `json:"auth"`
+	Addons       []Descriptor `json:"addons"`
+	AddonsLocked bool         `json:"addonsLocked"`
+	Settings     Settings     `json:"settings"`
+}
+
+func (p Profile) MarshalJSON() ([]byte, error) {
+	return MarshalJSON(profileJSON{Auth: p.Auth, Addons: nonNilSlice(p.Addons), AddonsLocked: p.AddonsLocked, Settings: p.Settings})
+}
+
+func (p *Profile) UnmarshalJSON(data []byte) error {
+	wire := struct {
+		Auth         *Auth        `json:"auth"`
+		Addons       []Descriptor `json:"addons"`
+		AddonsLocked bool         `json:"addonsLocked"`
+		Settings     *Settings    `json:"settings"`
+	}{}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	settings := NewSettings()
+	if wire.Settings != nil {
+		settings = *wire.Settings
+	}
+	addons := []Descriptor{}
+	seen := map[string]bool{}
+	for _, addon := range wire.Addons {
+		if seen[addon.TransportURL] {
+			continue
+		}
+		seen[addon.TransportURL] = true
+		addons = append(addons, addon)
+	}
+	*p = Profile{Auth: wire.Auth, Addons: addons, AddonsLocked: wire.AddonsLocked, Settings: settings}
+	return nil
+}
+
+// NewProfile returns the default profile: not authenticated, the official
+// addons and the default settings.
+func NewProfile() Profile {
+	return Profile{Addons: OfficialAddons(), Settings: NewSettings()}
+}
