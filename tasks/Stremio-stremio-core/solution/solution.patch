+func TestStreamingServerReloadsOnStreamingServerURLChange(t *testing.T) {
+	const otherURL = "http://192.168.0.5:11470"
+	env, rt, _ := ssLoadedRuntime(t, func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		switch url {
+		case otherURL + "/settings":
+			return []byte(strings.Replace(ssSettingsResponse, "http://127.0.0.1:11470", otherURL, 1)), nil
+		case otherURL + "/casting":
+			return nil, runtime.EnvErrorFetch("Connection refused")
+		case otherURL + "/network-info":
+			return []byte(`{"availableInterfaces":["192.168.0.5"]}`), nil
+		case otherURL + "/device-info":
+			return []byte(`{"availableHardwareAccelerations":[]}`), nil
+		}
+		return nil, nil
+	})
+	m := ssModel(t, rt.Model())
+	generation := m.StreamingServer.PlaybackDevicesGeneration
+	settings := m.Ctx.Profile.Settings
+	settings.StreamingServerURL = otherURL
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameCtx, msg.NewAction(msg.ActionCtxUpdateSettings, settings))})
+
+	server := m.StreamingServer
+	if server.Selected.TransportURL != otherURL || server.PlaybackDevicesGeneration != generation+1 {
+		t.Fatalf("selected = %+v, generation %d", server.Selected, server.PlaybackDevicesGeneration)
+	}
+	if server.BaseURL == nil || *server.BaseURL != otherURL+"/" || !server.Settings.IsReady() {
+		t.Errorf("base url = %v, settings = %+v", server.BaseURL, server.Settings)
+	}
+	// the playback devices are not reset to loading on a profile change,
+	// so the error of the new server is ignored
+	if !server.PlaybackDevices.Equal(common.Ready([]types.PlaybackDevice{})) {
+		t.Errorf("playback devices = %+v", server.PlaybackDevices)
+	}
+	if !server.NetworkInfo.Equal(common.Ready(types.NetworkInfo{AvailableInterfaces: []string{"192.168.0.5"}})) {
+		t.Errorf("network info = %+v", server.NetworkInfo)
+	}
+	urls := []string{}
+	for _, request := range env.Requests {
+		urls = append(urls, request.Method+" "+request.URL)
+	}
+	want := []string{"GET " + otherURL + "/settings", "GET " + otherURL + "/casting", "GET " + otherURL + "/network-info", "GET " + otherURL + "/device-info"}
+	if !reflect.DeepEqual(urls, want) {
+		t.Errorf("requests = %v", urls)
+	}
+	data, _ := types.MarshalJSON(server)
+	if !strings.HasPrefix(string(data), `{"selected":{"transportUrl":"`+otherURL+`/","statistics":null}`) {
+		t.Errorf("serialized: %s", data)
+	}
+
+	// the same url (in another serialization) does not reload the server
+	env.Requests = nil
+	settings.StreamingServerURL = otherURL + "/"
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameCtx, msg.NewAction(msg.ActionCtxUpdateSettings, settings))})
+	if len(env.Requests) != 0 || server.PlaybackDevicesGeneration != generation+1 {
+		t.Errorf("requests = %+v", env.Requests)
+	}
+}
