+// analyticsContext returns a copy of the analytics context (the default one if unset).
+func (p *Player) analyticsContext() AnalyticsContext {
+	if p.AnalyticsContext == nil {
+		return AnalyticsContext{}
+	}
+	return *p.AnalyticsContext
+}
+
+// updateAnalyticsPlayback updates the analytics context with the playback
+// state of the library item and the player.
+func (p *Player) updateAnalyticsPlayback(args playerTimeArgs) {
+	if p.AnalyticsContext == nil || p.LibraryItem == nil {
+		return
+	}
+	item := p.LibraryItem
+	timeOffset, duration := item.State.TimeOffset, item.State.Duration
+	deviceType, deviceName := args.Device, args.Device
+	playerDuration := args.Duration
+	p.AnalyticsContext.VideoID = clonePtr(item.State.VideoID)
+	p.AnalyticsContext.Time = &timeOffset
+	p.AnalyticsContext.Duration = &duration
+	p.AnalyticsContext.DeviceType = &deviceType
+	p.AnalyticsContext.DeviceName = &deviceName
+	p.AnalyticsContext.PlayerDuration = &playerDuration
+}
+
+func (p *Player) eventEffects(name string, args any) runtime.Effects {
+	return runtime.MsgEffects(msg.EventMsg(msg.NewEvent(name, args))).Unchanged()
+}
+
+func (p *Player) contextEventEffects(name string) runtime.Effects {
+	return p.eventEffects(name, PlayerContextEventArgs{Context: p.analyticsContext()})
+}
+
+//
+// Helpers
+//
+
+// updateLibraryItemEffects dispatches `UpdateLibraryItem` with a copy of the item.
+func updateLibraryItemEffects(item *types.LibraryItem) runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalUpdateLibraryItem, cloneLibraryItem(*item))))
+}
+
+// streamLoadedEffects dispatches `StreamLoaded` with copies of the selected
+// stream and the meta item.
+func streamLoadedEffects(selected *Selected, metaItem *common.ResourceLoadable[types.MetaItem]) runtime.Effects {
+	loadedMetaItem := common.ResourceLoadable[types.MetaItem]{Request: metaItem.Request}
+	if metaItem.Content != nil {
+		content := *metaItem.Content
+		loadedMetaItem.Content = &content
+	}
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalStreamLoaded, ctx.StreamLoaded{
+		Stream:        selected.Stream,
+		StreamRequest: cloneResourceRequest(selected.StreamRequest),
+		MetaItem:      loadedMetaItem,
+	}))).Unchanged()
+}
+
+// pushToLibrary dispatches `UpdateLibraryItem` only if at least
+// PUSH_TO_LIBRARY_EVERY has passed since the last update.
+func pushToLibrary(env runtime.Env, pushLibraryItemTime *time.Time, item *types.LibraryItem) runtime.Effects {
+	now := env.Now()
+	if now.Sub(*pushLibraryItemTime) >= PUSH_TO_LIBRARY_EVERY {
+		*pushLibraryItemTime = now
+		return updateLibraryItemEffects(item).Unchanged()
+	}
+	return unchangedEffects()
+}
+
+func itemStateUpdate(item *types.LibraryItem, nextVideo *types.Video, markedVideoAsWatched bool) runtime.Effects {
+	if item != nil && (markedVideoAsWatched ||
+		float64(item.State.TimeOffset) > float64(item.State.Duration)*stremiocore.CREDITS_THRESHOLD_COEF) {
+		item.State.TimeOffset = 0
+		if nextVideo != nil {
+			item.AdvanceToVideo(nextVideo.ID)
+		}
+	}
+	return unchangedEffects()
+}
+
+func streamStateUpdate(state **types.StreamItemState, selected *Selected, streams *types.StreamsBucket) runtime.Effects {
+	var next *types.StreamItemState
+	if selected != nil && selected.StreamRequest != nil && selected.MetaRequest != nil {
+		key := types.StreamsItemKey{
+			MetaID:  selected.MetaRequest.Path.ID,
+			VideoID: selected.StreamRequest.Path.ID,
+		}
+		if item, ok := streams.Items[key]; ok && item.State != nil {
+			itemState := *item.State
+			next = &itemState
+		}
+	}
+	return common.EqUpdate(state, next)
+}
+
+func nextVideoUpdate(env runtime.Env, video **types.Video, stream *types.Stream, selected *Selected, metaItem *common.ResourceLoadable[types.MetaItem]) runtime.Effects {
+	var next *types.Video
+	if selected != nil && selected.StreamRequest != nil {
+		if meta := readyMetaItem(metaItem); meta != nil {
+			if nextVideo := meta.NextVideo(selected.StreamRequest.Path.ID, env.Now()); nextVideo != nil {
+				value := *nextVideo
+				if stream != nil {
+					value.Streams = []types.Stream{*stream}
+				}
+				next = &value
+			}
+		}
+	}
+	return common.EqUpdate(video, next)
+}
+
+func nextStreamsUpdate(env runtime.Env, nextStreams **common.ResourceLoadable[[]types.Stream], nextVideo *types.Video, selected *Selected) runtime.Effects {
+	if selected == nil || selected.StreamRequest == nil {
+		return unchangedEffects()
+	}
+	if nextVideo == nil {
+		return unchangedEffects()
+	}
+	streamRequest := *cloneResourceRequest(selected.StreamRequest)
+	streamRequest.Path.ID = nextVideo.ID
+	if *nextStreams != nil {
+		return common.ResourceUpdateWithVectorContent(env, *nextStreams, common.ResourceRequested(&streamRequest), common.StreamsFromResponse)
+	}
+	newNextStreams := &common.ResourceLoadable[[]types.Stream]{Request: streamRequest}
+	effects := common.ResourceUpdateWithVectorContent(env, newNextStreams, common.ResourceRequested(&streamRequest), common.StreamsFromResponse)
+	*nextStreams = newNextStreams
+	return effects
+}
+
+func nextStreamUpdate(stream **types.Stream, nextStreams *common.ResourceLoadable[[]types.Stream], selected *Selected) runtime.Effects {
+	var next *types.Stream
+	if selected != nil && nextStreams != nil && nextStreams.Content != nil {
+		if streams, ok := nextStreams.Content.Ready(); ok {
+			for _, nextStream := range streams {
+				if nextStream.IsBingeMatch(selected.Stream) {
+					value := nextStream
+					next = &value
+					break
+				}
+			}
+		}
+	}
+	return common.EqUpdate(stream, next)
+}
+
+func seriesInfoUpdate(seriesInfo **types.SeriesInfo, selected *Selected, metaItem *common.ResourceLoadable[types.MetaItem]) runtime.Effects {
+	var next *types.SeriesInfo
+	if selected != nil && selected.StreamRequest != nil {
+		if meta := readyMetaItem(metaItem); meta != nil {
+			for _, video := range meta.Videos {
+				if video.ID == selected.StreamRequest.Path.ID {
+					next = clonePtr(video.SeriesInfo)
+					break
+				}
+			}
+		}
+	}
+	return common.EqUpdate(seriesInfo, next)
+}
+
+func libraryItemUpdate(env runtime.Env, libraryItem **types.LibraryItem, selected *Selected, metaItem *common.ResourceLoadable[types.MetaItem], library *types.LibraryBucket) runtime.Effects {
+	var next *types.LibraryItem
+	if selected != nil && selected.MetaRequest != nil {
+		item, inLibrary := library.Items[selected.MetaRequest.Path.ID]
+		meta := readyMetaItem(metaItem)
+		switch {
+		case inLibrary && meta != nil:
+			value := types.LibraryItemFromMetaPreviewAndItem(meta.Preview, cloneLibraryItem(item))
+			next = &value
+		case meta != nil:
+			value := types.NewLibraryItemFromMetaPreview(meta.Preview, env.Now())
+			next = &value
+		case inLibrary:
+			value := cloneLibraryItem(item)
+			next = &value
+		}
+	}
+	return common.EqUpdate(libraryItem, next)
+}
+
+func watchedUpdate(watched **types.WatchedBitField, metaItem *common.ResourceLoadable[types.MetaItem], libraryItem *types.LibraryItem) runtime.Effects {
+	var next *types.WatchedBitField
+	if meta := readyMetaItem(metaItem); meta != nil && libraryItem != nil {
+		value := libraryItem.State.WatchedBitField(meta.Videos)
+		next = &value
+	}
+	return common.EqUpdate(watched, next)
+}
+
+func libraryItemStateUpdate(item *types.LibraryItem, nextVideo *types.Video, selected *Selected) runtime.Effects {
+	if item == nil || selected == nil {
+		return unchangedEffects()
+	}
+	if selected.StreamRequest != nil && item.State.VideoID != nil && selected.StreamRequest.Path.ID != *item.State.VideoID {
+		if nextVideo != nil {
+			item.State.TimeOffset = 1
+		} else {
+			item.State.TimeOffset = 0
+		}
+		return updateLibraryItemEffects(item)
+	}
+	return unchangedEffects()
+}
+
+// convertStreamError converts the error of a stream conversion to an EnvError.
+func convertStreamError(err error) *runtime.EnvError {
+	var convertErr *types.ConvertError
+	if errors.As(err, &convertErr) {
+		return runtime.EnvErrorOther(convertErr.Message)
+	}
+	return runtime.EnvErrorSerde(err.Error())
+}
+
+func streamUpdate(stream **common.Loadable[PlayerStream], selected *Selected, streamingServerURL string) runtime.Effects {
+	if selected == nil {
+		return common.EqUpdate(stream, nil)
+	}
+	// rust parses the setting into an `Url`, which is always normalized
+	serverURL := types.NormalizeURL(streamingServerURL)
+	var next common.Loadable[PlayerStream]
+	converted, err := selected.Stream.Convert(&serverURL)
+	if err != nil {
+		next = common.Err[PlayerStream](convertStreamError(err))
+	} else {
+		next = common.Ready(PlayerStream{
+			StreamUrls: types.NewStreamUrls(converted, &serverURL),
+			Stream:     converted,
+		})
+	}
+	return common.EqUpdate(stream, &next)
+}
+
+func subtitlesUpdate(
+	env runtime.Env,
+	subtitles *[]common.ResourceLoadable[[]types.Subtitles],
+	selected *Selected,
+	videoParams *VideoParams,
+	stream *common.Loadable[PlayerStream],
+	addons []types.Descriptor,
+) runtime.Effects {
+	if selected == nil || selected.SubtitlesPath == nil || stream == nil || !stream.IsReady() {
+		return common.EqUpdate(subtitles, []common.ResourceLoadable[[]types.Subtitles]{})
+	}
+	converted := stream.Content.Stream
+	videoHash := clonePtr(converted.BehaviorHints.VideoHash)
+	if videoHash == nil && videoParams != nil {
+		videoHash = clonePtr(videoParams.Hash)
+	}
+	videoSize := clonePtr(converted.BehaviorHints.VideoSize)
+	if videoSize == nil && videoParams != nil {
+		videoSize = clonePtr(videoParams.Size)
+	}
+	videoFilename := clonePtr(converted.BehaviorHints.Filename)
+	if videoFilename == nil && videoParams != nil {
+		videoFilename = clonePtr(videoParams.Filename)
+	}
+	if videoHash == nil && videoSize == nil && videoFilename == nil && videoParams == nil {
+		return unchangedEffects()
+	}
+	var videoSizeValue *string
+	if videoSize != nil {
+		size := strconv.FormatUint(*videoSize, 10)
+		videoSizeValue = &size
+	}
+	path := *selected.SubtitlesPath
+	extra := append([]types.ExtraValue{}, path.Extra...)
+	extra = types.ExtendOneExtra(extra, &types.VIDEO_HASH_EXTRA_PROP, videoHash)
+	extra = types.ExtendOneExtra(extra, &types.VIDEO_SIZE_EXTRA_PROP, videoSizeValue)
+	extra = types.ExtendOneExtra(extra, &types.VIDEO_FILENAME_EXTRA_PROP, videoFilename)
+	path.Extra = extra
+	return common.ResourcesRequestedUpdate(env, subtitles, common.ResourcesRequest{
+		Request: types.AggrRequest{Kind: types.AggrRequestAllOfResource, Path: path},
+		Addons:  addons,
+	})
+}
+
+// isSkipGapsStreamSupported reports whether the stream supports seek logs
+// and skip gaps: live streams will not have an opensubtitles hash so just
+// relying on URL and Torrent is enough.
+func isSkipGapsStreamSupported(stream types.Stream) bool {
+	return stream.Source.Kind == types.StreamSourceURL || stream.Source.Kind == types.StreamSourceTorrent
+}
+
+// streamNameHash is the base64 (standard) encoded SHA-256 of the stream name.
+func streamNameHash(name string) string {
+	hash := sha256.Sum256([]byte(name))
+	return base64.StdEncoding.EncodeToString(hash[:])
+}
+
+func seekUpdate(
+	env runtime.Env,
+	selected *Selected,
+	videoParams *VideoParams,
+	seriesInfo *types.SeriesInfo,
+	libraryItem *types.LibraryItem,
+	seekHistory *[]types.SeekLog,
+	outro *uint64,
+) runtime.Effects {
+	hasSeeksOrOutro := len(*seekHistory) > 0 || (outro != nil && *outro > 0)
+	seekRequestEffects := unchangedEffects()
+	if hasSeeksOrOutro && selected != nil && videoParams != nil && seriesInfo != nil && libraryItem != nil &&
+		isSkipGapsStreamSupported(selected.Stream) && selected.Stream.Name != nil && videoParams.Hash != nil {
+		skipOutro := []uint64{}
+		if outro != nil {
+			skipOutro = []uint64{*outro}
+		}
+		request := types.SeekLogRequest{
+			OsHash:         *videoParams.Hash,
+			ItemID:         libraryItem.ID,
+			SeriesInfo:     *seriesInfo,
+			StreamNameHash: streamNameHash(*selected.Stream.Name),
+			Duration:       libraryItem.State.Duration,
+			SeekHistory:    append([]types.SeekLog{}, *seekHistory...),
+			SkipOutro:      skipOutro,
+		}
+		seekRequestEffects = runtime.OneEffect(pushSeekToAPI(env, request)).Unchanged()
+	}
+	return seekRequestEffects.Join(common.EqUpdate(seekHistory, []types.SeekLog{}))
+}
+
+func absDiff(a, b uint64) uint64 {
+	if a > b {
+		return a - b
+	}
+	return b - a
+}
+
+// ratioFloor returns `floor(numer * value / denom)` computed exactly (the
+// integer part of the ratio `numer / denom` multiplied by value). The result
+// saturates if it does not fit in an u64.
+func ratioFloor(numer, denom, value uint64) uint64 {
+	hi, lo := bits.Mul64(numer, value)
+	if hi >= denom {
+		return math.MaxUint64
+	}
+	quotient, _ := bits.Div64(hi, lo, denom)
+	return quotient
+}
+
+func calculateOutro(libraryItem *types.LibraryItem, closestDuration, closestOutro uint64) *uint64 {
+	if closestOutro == 0 {
+		return nil
+	}
+	outro := absDiff(libraryItem.State.Duration, absDiff(closestDuration, closestOutro))
+	if outro > 0 && outro <= libraryItem.State.Duration {
+		return &outro
+	}
+	return nil
+}
+
+// sortedGapDurations returns the durations of the skip gaps in ascending
+// order, so that the closest duration is chosen deterministically.
+func sortedGapDurations(gaps map[uint64]types.SkipGaps) []uint64 {
+	durations := make([]uint64, 0, len(gaps))
+	for duration := range gaps {
+		durations = append(durations, duration)
+	}
+	sort.Slice(durations, func(i, j int) bool { return durations[i] < durations[j] })
+	return durations
+}
+
+func introOutroUpdate(
+	env runtime.Env,
+	introOutro **types.IntroOutro,
+	profile *types.Profile,
+	selected *Selected,
+	videoParams *VideoParams,
+	seriesInfo *types.SeriesInfo,
+	libraryItem *types.LibraryItem,
+	skipGaps **SkipGaps,
+) runtime.Effects {
+	skipGapsEffects := skipGapsUpdate(env, profile, selected, videoParams, seriesInfo, libraryItem, skipGaps)
+	var introOutroEffects runtime.Effects
+	if *skipGaps != nil && (*skipGaps).Response.IsReady() && libraryItem != nil && libraryItem.State.Duration > 0 {
+		response := (*skipGaps).Response.Content
+		duration := libraryItem.State.Duration
+		durations := sortedGapDurations(response.Gaps)
+
+		var outroTime *uint64
+		{
+			found := false
+			var closestDuration, closestOutro uint64
+			for _, gapDuration := range durations {
+				gap := response.Gaps[gapDuration]
+				if gap.Outro == nil {
+					continue
+				}
+				if !found || absDiff(gapDuration, duration) < absDiff(closestDuration, duration) {
+					found = true
+					closestDuration, closestOutro = gapDuration, *gap.Outro
+				}
+			}
+			if found {
+				outroTime = calculateOutro(libraryItem, closestDuration, closestOutro)
+			}
+		}
+
+		var introTime *types.IntroData
+		{
+			found := false
+			var closestDuration uint64
+			var closestGap types.SkipGaps
+			for _, gapDuration := range durations {
+				gap := response.Gaps[gapDuration]
+				if len(gap.SeekHistory) == 0 {
+					continue
+				}
+				if !found || absDiff(gapDuration, duration) < absDiff(closestDuration, duration) {
+					found = true
+					closestDuration, closestGap = gapDuration, gap
+				}
+			}
+			// the duration ratio is undefined for a zero closest duration
+			if found && closestDuration > 0 && len(closestGap.SeekHistory) > 0 {
+				durationDiffInSecs := absDiff(duration, closestDuration) / (1000 * 10) / 10
+				seekEvent := closestGap.SeekHistory[0]
+				intro := types.IntroData{
+					From: ratioFloor(duration, closestDuration, seekEvent.From),
+					To:   ratioFloor(duration, closestDuration, seekEvent.To),
+				}
+				if durationDiffInSecs > 0 {
+					introDuration := absDiff(seekEvent.To, seekEvent.From)
+					intro.Duration = &introDuration
+				}
+				introTime = &intro
+			}
+		}
+		introOutroEffects = common.EqUpdate(introOutro, &types.IntroOutro{Intro: introTime, Outro: outroTime})
+	} else {
+		introOutroEffects = common.EqUpdate(introOutro, nil)
+	}
+	return skipGapsEffects.Join(introOutroEffects)
+}
+
+func skipGapsUpdate(
+	env runtime.Env,
+	profile *types.Profile,
+	selected *Selected,
+	videoParams *VideoParams,
+	seriesInfo *types.SeriesInfo,
+	libraryItem *types.LibraryItem,
+	skipGaps **SkipGaps,
+) runtime.Effects {
+	if profile.Auth == nil || profile.Auth.User.PremiumExpire == nil || !profile.Auth.User.PremiumExpire.After(env.Now()) {
+		return unchangedEffects()
+	}
+	authKey := profile.Auth.Key
+	if selected == nil || videoParams == nil || seriesInfo == nil || libraryItem == nil {
+		return unchangedEffects()
+	}
+	if !isSkipGapsStreamSupported(selected.Stream) || selected.Stream.Name == nil || videoParams.Hash == nil {
+		return unchangedEffects()
+	}
+	request := types.SkipGapsRequest{
+		AuthKey:        authKey,
+		OsHash:         *videoParams.Hash,
+		ItemID:         libraryItem.ID,
+		SeriesInfo:     *seriesInfo,
+		StreamNameHash: streamNameHash(*selected.Stream.Name),
+	}
+	// no previous request or a different request
+	if *skipGaps == nil || !types.Equal((*skipGaps).Request, request) {
+		requestEffects := getSkipGaps(env, request)
+		skipGapsEffects := common.EqUpdate(skipGaps, &SkipGaps{Request: request, Response: common.Loading[types.SkipGapsResponse]()})
+		return runtime.OneEffect(requestEffects).Unchanged().Join(skipGapsEffects)
+	}
+	return unchangedEffects()
+}
+
+//
+// Copies
+//
+
+func clonePtr[T any](value *T) *T {
+	if value == nil {
+		return nil
+	}
+	copied := *value
+	return &copied
+}
+
+func stringPtrEqual(a, b *string) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return *a == *b
+}
+
+func metaRequestID(selected *Selected) *string {
+	if selected == nil || selected.MetaRequest == nil {
+		return nil
+	}
+	id := selected.MetaRequest.Path.ID
+	return &id
+}
+
+func readyMetaItem(metaItem *common.ResourceLoadable[types.MetaItem]) *types.MetaItem {
+	if metaItem == nil || metaItem.Content == nil {
+		return nil
+	}
+	if meta, ok := metaItem.Content.Ready(); ok {
+		return &meta
+	}
+	return nil
+}
+
+func cloneResourceRequest(request *types.ResourceRequest) *types.ResourceRequest {
+	if request == nil {
+		return nil
+	}
+	copied := *request
+	if request.Path.Extra != nil {
+		copied.Path.Extra = append([]types.ExtraValue{}, request.Path.Extra...)
+	}
+	return &copied
+}
+
+// cloneLibraryItem returns a deep copy of the library item.
+func cloneLibraryItem(item types.LibraryItem) types.LibraryItem {
+	item.Poster = clonePtr(item.Poster)
+	item.Ctime = clonePtr(item.Ctime)
+	item.State.LastWatched = clonePtr(item.State.LastWatched)
+	item.State.VideoID = clonePtr(item.State.VideoID)
+	item.State.Watched = clonePtr(item.State.Watched)
+	item.BehaviorHints.DefaultVideoID = clonePtr(item.BehaviorHints.DefaultVideoID)
+	item.BehaviorHints.FeaturedVideoID = clonePtr(item.BehaviorHints.FeaturedVideoID)
+	if item.BehaviorHints.Other != nil {
+		other := make(map[string]json.RawMessage, len(item.BehaviorHints.Other))
+		for key, value := range item.BehaviorHints.Other {
+			other[key] = append(json.RawMessage{}, value...)
+		}
+		item.BehaviorHints.Other = other
+	}
+	return item
+}
+
+//
+// JSON decoding (serde-like: exact field names, unknown fields ignored)
+//
+
+func isNullJSON(data []byte) bool {
+	trimmed := bytes.TrimSpace(data)
+	return len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null"))
+}
+
+// decodeObject decodes a JSON object into its raw fields.
+func decodeObject(data []byte, expected string) (map[string]json.RawMessage, error) {
+	if isNullJSON(data) {
+		return nil, fmt.Errorf("invalid type: null, expected %s", expected)
+	}
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(data, &object); err != nil {
+		return nil, err
+	}
+	return object, nil
+}
+
+// decodeRequiredField decodes a required, non-null field of an object.
+func decodeRequiredField(object map[string]json.RawMessage, key string, value any) error {
+	raw, ok := object[key]
+	if !ok {
+		return fmt.Errorf("missing field `%s`", key)
+	}
+	if isNullJSON(raw) {
+		return fmt.Errorf("invalid type: null, field `%s`", key)
+	}
+	return json.Unmarshal(raw, value)
+}
+
+// decodeOptionalField decodes an optional field of an object: nil when
+// missing or null.
+func decodeOptionalField[T any](object map[string]json.RawMessage, key string) (*T, error) {
+	raw, ok := object[key]
+	if !ok || isNullJSON(raw) {
+		return nil, nil
+	}
+	var value T
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return nil, err
+	}
+	return &value, nil
+}
