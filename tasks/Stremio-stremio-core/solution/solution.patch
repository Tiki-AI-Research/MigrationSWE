+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of src/unit_tests/ctx/pull_addons_from_api.rs
+
+// authTestAddon is the `id`/`name` 0.0.1 addon of the addons tests,
+// installed from `https://transport_url`.
+func authTestAddon() types.Descriptor {
+	return types.Descriptor{
+		Manifest: types.Manifest{
+			ID:            "id",
+			Version:       "0.0.1",
+			Name:          "name",
