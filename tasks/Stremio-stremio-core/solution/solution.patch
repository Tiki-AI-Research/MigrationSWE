+func TestStreamDeepLinksRequests(t *testing.T) {
+	streamRequest := types.NewResourceRequest("http://domain.root", types.NewResourcePath("stream", "movie", "yt_id:"+sdYtID))
+	metaRequest := types.NewResourceRequest("http://domain.root", types.NewResourcePath("meta", "movie", "yt_id:"+sdYtID))
+	sdl := NewStreamDeepLinksWithRequests(youTubeStream(sdYtID), streamRequest, metaRequest, ptr(streamingServerStrURL), types.NewSettings())
+	assertEqual(t, sdl.Player, fmt.Sprintf(
+		"stremio:///player/eAEBFgDp%%2F3sieXRJZCI6ImFxei1LRS1icEtRIn1RRQb5/http%%3A%%2F%%2Fdomain.root%%2F/http%%3A%%2F%%2Fdomain.root%%2F/movie/yt_id%%3A%s/yt_id%%3A%s",
+		sdYtID, sdYtID))
+	assertStrPtr(t, sdl.ExternalPlayer.Playlist, ptr(m3uPlaylist(streamingServerStrURL+"/yt/"+sdYtID)))
+	assertStrPtr(t, sdl.ExternalPlayer.FileName, ptr("playlist.m3u"))
+}
+
+func TestConvertedStreamDeepLinks(t *testing.T) {
+	converted, err := youTubeStream(sdYtID).Convert(ptr(streamingServerStrURL))
+	if err != nil {
+		t.Fatal(err)
+	}
+	sdl := NewConvertedStreamDeepLinks(converted, ptr(streamingServerStrURL), types.NewSettings())
+	encoded, err := converted.Encode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEqual(t, sdl.Player, "stremio:///player/"+types.EncodeURIComponent(encoded))
+	assertStrPtr(t, sdl.ExternalPlayer.Streaming, ptr(streamingServerStrURL+"/yt/"+sdYtID))
+	assertStrPtr(t, sdl.ExternalPlayer.Download, ptr("https://youtube.com/watch?v="+sdYtID))
+}
