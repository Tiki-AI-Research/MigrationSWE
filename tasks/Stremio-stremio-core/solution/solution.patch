+package ctx
+
+import (
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func updateSearchHistory(env runtime.Env, searchHistory *types.SearchHistoryBucket, status *CtxStatus, m *msg.Msg) runtime.Effects {
+	if m.IsInternal(msg.InternalLogout) {
+		*searchHistory = types.NewSearchHistoryBucket(nil)
+		return searchHistoryChangedEffects()
+	}
+	if isCtxAction(m, msg.ActionCtxClearSearchHistory) {
+		searchHistory.Items = map[string]time.Time{}
+		return searchHistoryChangedEffects()
+	}
+	if query, ok := InternalStringData(m, msg.InternalCatalogsWithExtraSearch); ok {
+		if searchHistory.Items == nil {
+			searchHistory.Items = map[string]time.Time{}
+		}
+		searchHistory.Items[query] = env.Now()
+		return searchHistoryChangedEffects()
+	}
+	if result, ok := InternalCtxAuthResultData(m); ok {
+		if !status.IsLoading(result.AuthRequest) || result.Response == nil {
+			return runtime.NoneEffects().Unchanged()
+		}
+		*searchHistory = types.NewSearchHistoryBucket(types.NewUID(result.Response.Auth.User.ID))
+		return searchHistoryChangedEffects()
+	}
+	if m.IsInternal(msg.InternalSearchHistoryChanged) {
+		return runtime.OneEffect(pushSearchHistoryToStorage(env, searchHistory)).Unchanged()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+func searchHistoryChangedEffects() runtime.Effects {
+	return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalSearchHistoryChanged, nil)))
+}
+
+func pushSearchHistoryToStorage(env runtime.Env, searchHistory *types.SearchHistoryBucket) runtime.Effect {
+	return common.StorageFuture(env, stremiocore.SEARCH_HISTORY_STORAGE_KEY, *searchHistory,
+		storageResult(msg.UIDEvent(msg.EventSearchHistoryPushedToStorage, searchHistory.UID)))
+}
