+//
+// Addons
+//
+
+// AddonsDeepLinks are the deep links of an addons catalog.
+type AddonsDeepLinks struct {
+	Addons string `json:"addons"`
+}
+
+func (l AddonsDeepLinks) MarshalJSON() ([]byte, error) {
