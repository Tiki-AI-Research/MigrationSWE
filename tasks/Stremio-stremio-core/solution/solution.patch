+// addonProfile is `Profile { addons, ..Default::default() }`.
+func addonProfile(addons ...types.Descriptor) types.Profile {
+	profile := types.NewProfile()
+	profile.Addons = append([]types.Descriptor{}, addons...)
+	return profile
+}
+
+// addonLoggedInProfile is `Profile { auth: Some(Auth { key: "auth_key", user }), addons, ..Default::default() }`.
