+	Event string          `json:"event"`
+	Args  json.RawMessage `json:"args,omitempty"`
+}
+
+// NewEvent creates an event with the given (serializable) arguments.
+func NewEvent(name string, args any) *Event {
+	return &Event{Event: name, Args: marshalArgs(args)}
+}
+
+// DecodeArgs decodes the arguments of the event into the value.
+func (e *Event) DecodeArgs(value any) error {
