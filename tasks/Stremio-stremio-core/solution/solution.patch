+// notifTestData is a test case of testdata/pull_notifications_data.json.
+type notifTestData struct {
+	// NetworkRequests are the raw addon responses by request url.
+	NetworkRequests   map[string]json.RawMessage                   `json:"network_requests"`
+	Addons            []types.Descriptor                           `json:"addons"`
+	LibraryItems      []types.LibraryItem                          `json:"library_items"`
+	NotificationItems []types.NotificationItem                     `json:"notification_items"`
+	Result            map[string]map[string]types.NotificationItem `json:"result"`
+}
+
+// notifAddonTransportURL is the transport url of notifAddon1.
+const notifAddonTransportURL = "https://addon_1.com/manifest.json"
+
+// notifCatalogURL is the `lastVideosIds` catalog request of the tt1 library item.
+const notifCatalogURL = "https://addon_1.com/catalog/series/lastVideosIds/lastVideosIds=tt1.json"
+
+// notifAddon1 is the addon with the `lastVideosIds` catalog (rust `ADDON_1`).
+func notifAddon1() types.Descriptor {
+	return types.Descriptor{
+		Manifest: types.Manifest{
+			ID:         "addon_1",
+			Version:    "0.0.1",
+			Name:       "Addon 1",
+			Types:      []string{"series"},
+			Resources:  []types.ManifestResource{{Name: stremiocore.CATALOG_RESOURCE_NAME}},
+			IDPrefixes: []string{"tt"},
+			Catalogs: []types.ManifestCatalog{{
+				ID:    "lastVideosIds",
+				Type:  "series",
+				Extra: types.ManifestExtra{Full: []types.ExtraProp{types.LAST_VIDEOS_IDS_EXTRA_PROP}},
+			}},
+			AddonCatalogs: []types.ManifestCatalog{},
+		},
+		TransportURL: notifAddonTransportURL,
+	}
+}
+
+// notifVideo is an episode of season 1 of tt1.
+func notifVideo(episode uint32, released time.Time) types.Video {
+	return types.Video{
+		ID:         fmt.Sprintf("tt1:1:%d", episode),
+		Title:      fmt.Sprintf("ep%d", episode),
+		Released:   timePtr(released),
+		SeriesInfo: &types.SeriesInfo{Season: 1, Episode: episode},
+	}
+}
+
+// notifMetaItem1 is the meta item `tt1` with 4 episodes of season 1 (rust `META_ITEM_1`).
+func notifMetaItem1() types.MetaItem {
+	return types.MetaItem{
+		Preview: types.MetaItemPreview{
+			ID:          "tt1",
+			Name:        "name",
+			Type:        "series",
+			PosterShape: types.PosterShapePoster,
+		},
+		Videos: []types.Video{
+			notifVideo(4, date(2019, 12, 20)),
+			notifVideo(5, date(2020, 1, 1)),
+			notifVideo(6, date(2020, 1, 5)),
+			notifVideo(7, date(2020, 1, 15)),
+		},
+	}
+}
+
+// notifCatalogRoute answers the `lastVideosIds` catalog request with notifMetaItem1.
+func notifCatalogRoute() fetchRoute {
+	return fetchRoute{
+		Method:   "GET",
+		URL:      notifCatalogURL,
+		Body:     "",
+		Response: string(types.NewResourceResponse(types.ResourceResponseMetasDetailed, []types.MetaItem{notifMetaItem1()}).Raw),
+	}
+}
+
+// notifLibraryItem1 is the library item of tt1: episode 5 is released on
+// 2020-01-01 and it was watched later that day.
+func notifLibraryItem1(now time.Time) types.LibraryItem {
+	return types.LibraryItem{
+		ID:          "tt1",
+		Name:        "name",
+		Type:        "series",
+		PosterShape: types.PosterShapePoster,
+		Ctime:       timePtr(now),
+		Mtime:       now,
+		State: types.LibraryItemState{
+			TimeWatched:        1000,
+			OverallTimeWatched: 15*60*1000 + 1,
+			LastWatched:        timePtr(datetime(2020, 1, 1, 20, 0, 0)),
+			TimesWatched:       5,
+			FlaggedWatched:     1,
+			TimeOffset:         100,
+			Duration:           101,
+			VideoID:            strPtr("tt1:1:5"),
+		},
+	}
+}
+
+// notifAddon1Ctx is the Ctx with notifAddon1 installed and the tt1 library item.
+func notifAddon1Ctx(env *testenv.Env, now time.Time) *ctx.Ctx {
+	profile := types.NewProfile()
+	profile.Addons = []types.Descriptor{notifAddon1()}
+	return withProfileAndLibrary(env, profile, types.NewLibraryBucket(nil, []types.LibraryItem{notifLibraryItem1(now)}))
+}
+
+// notifExpectedTT1 are the notifications of tt1 for the episodes 6 and 7.
+func notifExpectedTT1() map[string]types.NotificationItem {
+	return map[string]types.NotificationItem{
+		"tt1:1:6": {MetaID: "tt1", VideoID: "tt1:1:6", VideoReleased: date(2020, 1, 5)},
+		"tt1:1:7": {MetaID: "tt1", VideoID: "tt1:1:7", VideoReleased: date(2020, 1, 15)},
+	}
+}
+
+// The Player model is not used: the messages it dispatches to the Ctx when
+// it is loaded with episode 6 of tt1 and its time changes are simulated (see
+// src/models/player.rs, `Load(Player)`, `ResourceRequestResult` and
+// `TimeChanged`).
+func TestPullNotificationsAndPlayInPlayer(t *testing.T) {
+	now := datetime(2024, 1, 1, 10, 30, 0)
+	env := newTestEnv(now)
+	setRoutes(t, env, notifCatalogRoute())
+	h := newHarness(t, env, notifAddon1Ctx(env, now))
+
+	h.dispatchCtx(msg.ActionCtxPullNotifications, nil)
+
+	if len(env.Requests) != 1 {
+		t.Fatalf("One request has been sent, got %d: %s", len(env.Requests), describeRequests(env.Requests))
+	}
+	assertRequests(t, env, notifCatalogRoute())
+	notifications := h.ctx().Notifications
+	if len(notifications.Items) != 1 {
+		t.Fatalf("1 MetaItem should be in the notifications bucket, got %v", notifications.Items)
+	}
+	metaNotifs, ok := notifications.Items["tt1"]
+	if !ok {
+		t.Fatalf("Should have new notifications for this MetaItem")
+	}
+	if len(metaNotifs) != 2 {
+		t.Errorf("Should have 2 video notifications, got %d", len(metaNotifs))
+	}
+	if _, ok := metaNotifs["tt1:1:6"]; !ok {
+		t.Errorf("Should have notification for tt1:1:6")
+	}
+	if _, ok := metaNotifs["tt1:1:7"]; !ok {
+		t.Errorf("Should have notification for tt1:1:7")
+	}
+	assertEqual(t, metaNotifs, notifExpectedTT1(), "Notifications of tt1")
+	assertEqual(t, notifications.LastUpdated, timePtr(now), "Notifications last updated")
+	stored, ok := storageValue[types.NotificationsBucket](t, env, stremiocore.NOTIFICATIONS_STORAGE_KEY)
+	if !ok {
+		t.Fatalf("Notifications should be stored")
+	}
+	assertEqual(t, stored, notifications, "Notifications stored")
+	assertEqual(t, h.coreEventNames(), []string{msg.EventNotificationsPushedToStorage}, "events")
+	assertEvent(t, h.findEvent(msg.EventNotificationsPushedToStorage), msg.EventNotificationsPushedToStorage, `{"ids":["tt1"]}`, "NotificationsPushedToStorage")
+	// PullNotifications is unchanged, the catalog result changes the notifications
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+
+	// Start watching episode 6
+	// This should dismiss all notifications for this MetaItem Id.
+	// libraryItem.state.lastWatched dismisses any unwatched episode notifications
+	metaRequest := types.ResourceRequest{
+		Base: notifAddonTransportURL,
+		Path: types.ResourcePath{Resource: stremiocore.META_RESOURCE_NAME, Type: "series", ID: "tt1", Extra: []types.ExtraValue{}},
+	}
+	streamRequest := types.ResourceRequest{
+		Base: notifAddonTransportURL,
+		Path: types.ResourcePath{Resource: stremiocore.STREAM_RESOURCE_NAME, Type: "series", ID: "tt1:1:6", Extra: []types.ExtraValue{}},
+	}
+	stream := types.Stream{Source: types.StreamSource{Kind: types.StreamSourceURL, URL: "https://example.com/stream.mp4"}}
+	streamKey := types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:6"}
+
+	// Load: the meta item is requested, StreamLoaded is sent with the meta item loading
+	loading := common.Loading[types.MetaItem]()
+	h.dispatchInternal(msg.InternalStreamLoaded, ctx.StreamLoaded{
+		Stream:        stream,
+		StreamRequest: &streamRequest,
+		MetaItem:      common.ResourceLoadable[types.MetaItem]{Request: metaRequest, Content: &loading},
+	})
+	if _, ok := h.ctx().Streams.Items[streamKey]; ok {
+		t.Errorf("The stream should not be stored while the meta item is loading")
+	}
+	// Load: the library item of the Player (from the Ctx library) has another
+	// video, its time offset is reset (0 since there is no next video yet)
+	playerItem := h.ctx().Library.Items["tt1"]
+	playerItem.State.TimeOffset = 0
+	h.dispatchInternal(msg.InternalUpdateLibraryItem, playerItem)
+	// Load: the notifications of the library item are dismissed
+	h.clearEvents()
+	h.dispatchInternal(msg.InternalDismissNotificationItem, "tt1")
+
+	if _, ok := h.ctx().Notifications.Items["tt1"]; ok {
+		t.Errorf("All notifications for this MetaItem should be now dismissed")
+	}
+	assertEqual(t, h.ctx().Library.Items["tt1"].State.LastWatched, timePtr(now), "Dismissing the notifications updates the last watched")
+	assertEqual(t, h.ctx().Library.Items["tt1"].State.TimeOffset, uint64(0), "Library item time offset")
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventNotificationsDismissed,
+		msg.EventNotificationsPushedToStorage,
+		msg.EventLibraryItemsPushedToStorage,
+	}, "Dismiss events")
+	assertEvent(t, h.findEvent(msg.EventNotificationsDismissed), msg.EventNotificationsDismissed, `{"id":"tt1"}`, "NotificationsDismissed")
+	assertEvent(t, h.findEvent(msg.EventNotificationsPushedToStorage), msg.EventNotificationsPushedToStorage, `{"ids":[]}`, "NotificationsPushedToStorage")
+	assertEvent(t, h.findEvent(msg.EventLibraryItemsPushedToStorage), msg.EventLibraryItemsPushedToStorage, `{"ids":["tt1"]}`, "LibraryItemsPushedToStorage")
+
+	// the meta item is loaded by the Player: the result is not a notification
+	// catalog result, the Ctx ignores it
+	catalogs := types.MustMarshalJSON(h.ctx().NotificationCatalogs)
+	h.dispatchInternal(msg.InternalResourceRequestResult, msg.ResourceRequestResult{
+		Request: metaRequest,
+		Value:   types.NewResourceResponse(types.ResourceResponseMeta, notifMetaItem1()),
+	})
+	assertJSONEqual(t, h.ctx().NotificationCatalogs, catalogs, "Notification catalogs are not changed by the meta item")
+	if len(h.ctx().Notifications.Items) != 0 {
+		t.Errorf("No notifications expected, got %v", h.ctx().Notifications.Items)
+	}
+	// the Player sends StreamLoaded with the loaded meta item
+	ready := common.Ready(notifMetaItem1())
+	h.dispatchInternal(msg.InternalStreamLoaded, ctx.StreamLoaded{
+		Stream:        stream,
+		StreamRequest: &streamRequest,
+		MetaItem:      common.ResourceLoadable[types.MetaItem]{Request: metaRequest, Content: &ready},
+	})
+	assertEqual(t, h.ctx().Streams.Items[streamKey], types.StreamsItem{
+		Stream:             stream,
+		Type:               "series",
+		MetaID:             "tt1",
+		VideoID:            "tt1:1:6",
+		MetaTransportURL:   notifAddonTransportURL,
+		StreamTransportURL: notifAddonTransportURL,
+		Mtime:              now,
+	}, "The stream is stored")
+	// and resets the time offset of its library item (1 since there is a next video)
+	playerItem = h.ctx().Library.Items["tt1"]
+	playerItem.State.TimeOffset = 1
+	h.dispatchInternal(msg.InternalUpdateLibraryItem, playerItem)
+
+	// TimeChanged { time: 95, duration: 100 }: the Player updates its
+	// library item for the new video and pushes it to the library
+	playerItem = h.ctx().Library.Items["tt1"]
+	playerItem.State.LastWatched = timePtr(env.Now())
+	playerItem.State.VideoID = strPtr("tt1:1:6")
+	playerItem.State.OverallTimeWatched += playerItem.State.TimeWatched
+	playerItem.State.TimeWatched = 0
+	playerItem.State.FlaggedWatched = 0
+	playerItem.State.TimeOffset = 95
+	playerItem.State.Duration = 100
+	h.dispatchInternal(msg.InternalUpdateLibraryItem, playerItem)
+
+	expectedItem := notifLibraryItem1(now)
+	expectedItem.State.LastWatched = timePtr(now)
+	expectedItem.State.VideoID = strPtr("tt1:1:6")
+	expectedItem.State.OverallTimeWatched = 15*60*1000 + 1 + 1000
+	expectedItem.State.TimeWatched = 0
+	expectedItem.State.FlaggedWatched = 0
+	expectedItem.State.TimeOffset = 95
+	expectedItem.State.Duration = 100
+	assertEqual(t, h.ctx().Library.Items["tt1"], expectedItem, "Library item updated by the Player")
+	if _, ok := h.ctx().Notifications.Items["tt1"]; ok {
+		t.Errorf("All notifications for this MetaItem should be now dismissed")
+	}
+	if len(env.Requests) != 1 {
+		t.Errorf("The Ctx should not send other requests: %s", describeRequests(env.Requests))
+	}
+
+	// before pulling notifications, make sure to update the last_updated time
+	env.SetNow(time.Now())
+	h.dispatchCtx(msg.ActionCtxPullNotifications, nil)
+
+	if len(env.Requests) != 2 {
+		t.Errorf("The notifications should be requested again: %s", describeRequests(env.Requests))
+	}
+	if len(h.ctx().Notifications.Items) != 0 {
+		t.Errorf("MetaItem Id should be removed because it doesn't have any notifications anymore, got %v", h.ctx().Notifications.Items)
+	}
+}
+
+func TestPullNotificationsTestCases(t *testing.T) {
+	data, err := os.ReadFile("testdata/pull_notifications_data.json")
+	if err != nil {
+		t.Fatalf("read test data: %v", err)
+	}
+	var tests []notifTestData
+	if err := json.Unmarshal(data, &tests); err != nil {
+		t.Fatalf("decode test data: %v", err)
+	}
+	if len(tests) == 0 {
+		t.Fatalf("no test cases")
+	}
+	for i, test := range tests {
+		t.Run(fmt.Sprintf("case %d", i), func(t *testing.T) {
+			env := newTestEnv(time.Time{})
+			routes := []fetchRoute{}
+			for url, response := range test.NetworkRequests {
+				routes = append(routes, fetchRoute{Method: "GET", URL: url, Body: "", Response: string(response)})
+			}
+			setRoutes(t, env, routes...)
+			profile := types.NewProfile()
+			profile.Addons = test.Addons
+			h := newHarness(t, env, newCtx(
+				profile,
+				types.NewLibraryBucket(nil, test.LibraryItems),
+				types.NewStreamsBucket(nil),
+				types.NewServerUrlsBucket(env.Now(), nil),
+				types.NewNotificationsBucket(env.Now(), nil, test.NotificationItems),
+				types.NewSearchHistoryBucket(nil),
+				types.NewDismissedEventsBucket(nil),
+			))
+
+			h.dispatchCtx(msg.ActionCtxPullNotifications, nil)
+
+			assertEqual(t, h.ctx().Notifications.Items, test.Result, "Notifications items match")
+		})
+	}
+}
+
+// Go only: the `lastVideosIds` catalogs are requested at most every
+// REQUEST_LAST_VIDEOS_EVERY (6 hours) since `notifications.last_updated`.
+func TestPullNotificationsRequestLastVideosEvery(t *testing.T) {
+	now := datetime(2024, 1, 1, 10, 30, 0)
+	env := newTestEnv(now)
+	setRoutes(t, env, notifCatalogRoute())
+	h := newHarness(t, env, notifAddon1Ctx(env, now))
+
+	h.dispatchCtx(msg.ActionCtxPullNotifications, nil)
+	if len(env.Requests) != 1 {
+		t.Fatalf("The notifications should be requested: %s", describeRequests(env.Requests))
+	}
+	assertEqual(t, h.ctx().Notifications.LastUpdated, timePtr(now), "Last updated")
+	assertEqual(t, h.ctx().Notifications.Items, map[string]map[string]types.NotificationItem{"tt1": notifExpectedTT1()}, "Notifications")
+
+	// less than 6 hours later: no request
+	env.SetNow(now.Add(ctx.REQUEST_LAST_VIDEOS_EVERY - time.Second))
+	h.dispatchCtx(msg.ActionCtxPullNotifications, nil)
+	if len(env.Requests) != 1 {
+		t.Errorf("The notifications should not be requested within 6 hours: %s", describeRequests(env.Requests))
+	}
+	assertEqual(t, h.ctx().Notifications.LastUpdated, timePtr(now), "Last updated is unchanged")
+	assertEqual(t, h.ctx().Notifications.Items, map[string]map[string]types.NotificationItem{"tt1": notifExpectedTT1()}, "Notifications are kept")
+
+	// 6 hours later: requested again
+	later := now.Add(ctx.REQUEST_LAST_VIDEOS_EVERY)
+	env.SetNow(later)
+	h.dispatchCtx(msg.ActionCtxPullNotifications, nil)
+	if len(env.Requests) != 2 {
+		t.Errorf("The notifications should be requested again after 6 hours: %s", describeRequests(env.Requests))
+	}
+	assertEqual(t, h.ctx().Notifications.LastUpdated, timePtr(later), "Last updated")
+	assertEqual(t, h.ctx().Notifications.Items, map[string]map[string]types.NotificationItem{"tt1": notifExpectedTT1()}, "Notifications")
+
+	// a bucket updated less than 6 hours ago (e.g. loaded from the storage)
+	env = newTestEnv(now)
+	setRoutes(t, env, notifCatalogRoute())
+	c := notifAddon1Ctx(env, now)
+	c.Notifications.LastUpdated = timePtr(now.Add(-time.Hour))
+	h = newHarness(t, env, c)
+	h.dispatchCtx(msg.ActionCtxPullNotifications, nil)
+	if len(env.Requests) != 0 {
+		t.Errorf("The notifications should not be requested within 6 hours of the stored last updated: %s", describeRequests(env.Requests))
+	}
+	assertEqual(t, h.ctx().Notifications.LastUpdated, timePtr(now.Add(-time.Hour)), "Last updated is unchanged")
+}
+
+// notifSnapshot is the part of the Ctx checked in the states of
+// TestDismissNotification.
+type notifSnapshot struct {
+	notifications map[string]map[string]types.NotificationItem
+	library       map[string]types.LibraryItem
+}
+
+// notifSnapshotModel is the `{ ctx: Ctx }` model recording the state of the
+// Ctx at each `NewState` (rust `TestEnv::run_with_runtime` records `STATES`).
+type notifSnapshotModel struct {
+	env    runtime.Env
+	ctx    *ctx.Ctx
+	states []notifSnapshot
+}
+
+func (m *notifSnapshotModel) snapshot() {
+	m.states = append(m.states, notifSnapshot{
+		notifications: types.Clone(m.ctx.Notifications.Items),
+		library:       types.Clone(m.ctx.Library.Items),
+	})
+}
+
+func (m *notifSnapshotModel) Update(message *msg.Msg) ([]runtime.Effect, []string) {
+	effects := m.ctx.Update(m.env, message)
+	if !effects.HasChanged {
+		return effects.Effects, []string{}
+	}
+	// the runtime emits the NewState right after the update
+	m.snapshot()
+	return effects.Effects, []string{fieldCtx}
+}
+
+func (m *notifSnapshotModel) UpdateField(message *msg.Msg, field string) ([]runtime.Effect, []string) {
+	if field != fieldCtx {
+		return []runtime.Effect{}, []string{}
+	}
+	return m.Update(message)
+}
+
+// notifWatchedItem is a library item of TestDismissNotification.
+func notifWatchedItem(id, name string) types.LibraryItem {
+	watched := date(2022, 6, 20)
+	return types.LibraryItem{
+		ID:          id,
+		Name:        name,
+		Type:        "series",
+		PosterShape: types.PosterShapePoster,
+		Ctime:       timePtr(watched),
+		Mtime:       watched,
+		State: types.LibraryItemState{
+			LastWatched:        timePtr(watched),
+			TimeWatched:        40 * 60 * 60 * 1000,
+			TimeOffset:         15,
+			OverallTimeWatched: 140 * 60 * 60 * 1000,
+			TimesWatched:       2,
+			FlaggedWatched:     1,
+			Duration:           55 * 60 * 60 * 1000,
+			VideoID:            strPtr("tt1:1"),
+		},
+	}
+}
+
+func TestDismissNotification(t *testing.T) {
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env)
+	model := &notifSnapshotModel{
+		env: env,
+		ctx: newCtx(
+			types.NewProfile(),
+			types.NewLibraryBucket(nil, []types.LibraryItem{
+				notifWatchedItem("tt1", "Item 1"),
+				notifWatchedItem("tt2", "Item 2"),
+			}),
+			types.NewStreamsBucket(nil),
+			types.NewServerUrlsBucket(env.Now(), nil),
+			types.NewNotificationsBucket(env.Now(), nil, []types.NotificationItem{
+				{MetaID: "tt1", VideoID: "tt1:2", VideoReleased: date(2023, 7, 10)},
+				{MetaID: "tt2", VideoID: "tt2:10", VideoReleased: date(2023, 8, 14)},
+			}),
+			types.NewSearchHistoryBucket(nil),
+			types.NewDismissedEventsBucket(nil),
+		),
+	}
+	rt, rx := runtime.New(model, nil, 1000, env)
+	// update now to later date than both last_watched
+	expectedLastWatched := date(2023, 8, 14)
+	env.SetNow(expectedLastWatched)
+
+	// the initial state
+	model.snapshot()
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameCtx, msg.NewAction(msg.ActionCtxDismissNotificationItem, "tt1"))})
+
+	var events []runtime.RuntimeEvent
+	for done := false; !done; {
+		select {
+		case event := <-rx:
+			events = append(events, event)
+		default:
+			done = true
+		}
+	}
+	if len(events) != 5 {
+		t.Fatalf("expected 5 events, got %d: %v", len(events), events)
+	}
+	if len(model.states) != 3 {
+		t.Fatalf("expected 3 states, got %d", len(model.states))
+	}
+
+	assertEqual(t, events[0].Fields(), []string{fieldCtx}, "events[0] is a NewState of the ctx")
+	if len(model.states[1].notifications) != 1 {
+		t.Errorf("We should have notifications for 1 LibraryItem ids")
+	}
+	assertEqual(t, events[1].Fields(), []string{fieldCtx}, "events[1] is a NewState of the ctx")
+	if len(model.states[2].notifications) != 1 {
+		t.Errorf("We should have notifications for 1 LibraryItem ids")
+	}
+	assertEvent(t, events[2].Event(), msg.EventNotificationsDismissed, `{"id":"tt1"}`, "events[2]")
+	assertEvent(t, events[3].Event(), msg.EventNotificationsPushedToStorage, `{"ids":["tt2"]}`, "events[3]")
+	assertEvent(t, events[4].Event(), msg.EventLibraryItemsPushedToStorage, `{"ids":["tt1"]}`, "LibraryItem should be pushed to storage")
+
+	// state 0 - we have both notifs.
+	if len(model.states[0].notifications) != 2 {
+		t.Errorf("Should have both notifications, got %v", model.states[0].notifications)
+	}
+	// state 1 - we have only the remaining notification after we've dismissed the other
+	if len(model.states[1].notifications) != 1 {
+		t.Errorf("Should have single notification, got %v", model.states[1].notifications)
+	}
+	tt2, ok := model.states[1].notifications["tt2"]
+	if !ok {
+		t.Fatalf("Should have notification")
+	}
+	if _, ok := tt2["tt2:10"]; !ok {
+		t.Errorf("Should have notification")
+	}
+	// state 2 - `LibraryItem.state.last_watched` of the dismissed item's
+	// notifications should be updated too by the `UpdateLibraryItem`
+	assertEqual(t, model.states[2].library["tt1"].State.LastWatched, timePtr(expectedLastWatched), "last watched of the dismissed item")
+	assertEqual(t, model.states[2].library["tt2"], notifWatchedItem("tt2", "Item 2"), "other library item is unchanged")
+}
