+package ctx_test
+
+import (
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Port of src/unit_tests/ctx/upgrade_addon.rs
+
+func TestActionCtxAddonUpgrade(t *testing.T) {
+	addon1 := addonDescriptor("id1", "0.0.1", "https://transport_url/")
+	addon1Update := addonDescriptor("id1", "0.0.2", "https://transport_url/")
+	addon2 := addonDescriptor("id2", "0.0.1", "https://transport_url_other/")
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env)
+	h := newHarness(t, env, withProfileAndLibrary(env, addonProfile(addon1, addon2), types.NewLibraryBucket(nil, nil)))
+	h.dispatchCtx(msg.ActionCtxUpgradeAddon, addon1Update)
+
+	expected := []types.Descriptor{addon1Update, addon2}
+	assertEqual(t, h.ctx().Profile.Addons, expected, "addon upgrade successfully in memory")
+	addonAssertStoredAddons(t, env, expected, "addon upgrade successfully in storage")
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+	// the events
+	assertEqual(t, h.coreEventNames(), []string{msg.EventAddonUpgraded, msg.EventProfilePushedToStorage}, "events")
+	assertEvent(t, h.findEvent(msg.EventAddonUpgraded), msg.EventAddonUpgraded,
+		`{"transport_url":"https://transport_url/","id":"id1"}`, "AddonUpgraded")
+	assertEvent(t, h.findEvent(msg.EventProfilePushedToStorage), msg.EventProfilePushedToStorage, `{"uid":null}`, "ProfilePushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
+}
+
+func TestActionCtxAddonUpgradeFailDueToDifferentURL(t *testing.T) {
+	addon1 := addonDescriptor("id1", "0.0.1", "https://transport_url1/")
+	addon2 := addonDescriptor("id1", "0.0.2", "https://transport_url2/")
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env)
+	h := newHarness(t, env, withProfileAndLibrary(env, addonProfile(addon1), types.NewLibraryBucket(nil, nil)))
+	h.dispatchCtx(msg.ActionCtxUpgradeAddon, addon2)
+
+	assertEqual(t, h.ctx().Profile.Addons, []types.Descriptor{addon1}, "addon was not updated")
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+	if _, ok := env.Storage[stremiocore.PROFILE_STORAGE_KEY]; ok {
+		t.Errorf("profile is not pushed to storage")
+	}
+	addonAssertErrorEvent(t, h, 4, "Addon is not installed", msg.EventAddonUpgraded, addon2)
+}
+
+// Not in upgrade_addon.rs: the other error cases of `ActionCtx::UpgradeAddon`
+// (rust src/models/ctx/update_profile.rs).
+func TestActionCtxAddonUpgradeErrors(t *testing.T) {
+	addon := addonDescriptor("id1", "0.0.1", "https://transport_url/")
+	update := addonDescriptor("id1", "0.0.2", "https://transport_url/")
+	configurationRequired := update
+	configurationRequired.Manifest.BehaviorHints.ConfigurationRequired = true
+	protectedUpdate := update
+	protectedUpdate.Flags.Protected = true
+	protectedAddon := addon
+	protectedAddon.Flags = types.DescriptorFlags{Official: true, Protected: true}
+	locked := addonProfile(addon)
+	locked.AddonsLocked = true
+	tests := []struct {
+		name    string
+		profile types.Profile
+		addon   types.Descriptor
+		code    int
+		message string
+	}{
+		{
+			name:    "addons_locked",
+			profile: locked,
+			addon:   update,
+			code:    7,
+			message: "Fetching Addons from the API failed and we have defaulted the addons to the officials ones until the request succeeds",
+		},
+		{
+			name:    "already_installed",
+			profile: addonProfile(addon),
+			addon:   addon,
+			code:    3,
+			message: "Addon is already installed",
+		},
+		{
+			name:    "configuration_required",
+			profile: addonProfile(addon),
+			addon:   configurationRequired,
+			code:    6,
+			message: "Addon requires configuration",
+		},
+		{
+			name:    "protected_argument",
+			profile: addonProfile(addon),
+			addon:   protectedUpdate,
+			code:    5,
+			message: "Addon is protected",
+		},
+		{
+			name:    "protected_installed",
+			profile: addonProfile(protectedAddon),
+			addon:   update,
+			code:    5,
+			message: "Addon is protected",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			env := newTestEnv(time.Time{})
+			setRoutes(t, env)
+			h := newHarness(t, env, withProfileAndLibrary(env, test.profile, types.NewLibraryBucket(nil, nil)))
+			h.dispatchCtx(msg.ActionCtxUpgradeAddon, test.addon)
+
+			assertEqual(t, h.ctx().Profile, test.profile, "profile in memory not updated")
+			if _, ok := env.Storage[stremiocore.PROFILE_STORAGE_KEY]; ok {
+				t.Errorf("profile in storage not updated")
+			}
+			if len(env.Requests) != 0 {
+				t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+			}
+			addonAssertErrorEvent(t, h, test.code, test.message, msg.EventAddonUpgraded, test.addon)
+		})
+	}
+}
diff --git a/models/model.go b/models/model.go
new file mode 100644
index 0000000000000000000000000000000000000000..adea247ae5043520ce74d377d79efd5518eacafc
--- /dev/null
+++ b/models/model.go
@@ -0,0 +1,219 @@
+// Package models contains the models of the engine and the root Model
+// which combines the Ctx with the Player and StreamingServer models.
+package models
+
+import (
+	"encoding/json"
+	"sync"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/models/ctx"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Model fields, in the order they are updated and reported.
+const (
+	FieldCtx             = "ctx"
+	FieldStreamingServer = "streaming_server"
+	FieldPlayer          = "player"
+)
+
+// Model is the root model: the Ctx, the StreamingServer and the Player.
+type Model struct {
+	Ctx             *ctx.Ctx
+	Player          *Player
+	StreamingServer *StreamingServer
+
+	env runtime.Env
+}
+
+var (
+	defaultEnvMu sync.Mutex
+	defaultEnv   runtime.Env
+)
+
+// New creates the model, loading the persisted user state from the storage
+// of the env (the defaults are used for missing or invalid values).
+func New(env runtime.Env) *Model {
+	model, _ := NewWithEffects(env)
+	return model
+}
+
+// NewWithEffects creates the model together with its initial effects
+// (loading the streaming server state).
+func NewWithEffects(env runtime.Env) (*Model, []runtime.Effect) {
+	defaultEnvMu.Lock()
+	defaultEnv = env
+	defaultEnvMu.Unlock()
+	c := LoadCtx(env)
+	streamingServer, effects := NewStreamingServer(env, &c.Profile)
+	model := &Model{
+		Ctx:             c,
+		Player:          NewPlayer(),
+		StreamingServer: streamingServer,
+		env:             env,
+	}
+	return model, effects.Effects
+}
+
+// Env returns the environment of the model.
+func (m *Model) Env() runtime.Env {
+	if m.env != nil {
+		return m.env
+	}
+	defaultEnvMu.Lock()
+	defer defaultEnvMu.Unlock()
+	return defaultEnv
+}
+
+// SetEnv sets the environment of the model.
+func (m *Model) SetEnv(env runtime.Env) {
+	m.env = env
+}
+
+func loadStorage[T any](env runtime.Env, key string) *T {
+	raw, found, err := env.GetStorage(key)
+	if err != nil || !found {
+		return nil
+	}
+	var value T
+	if json.Unmarshal(raw, &value) != nil {
+		return nil
+	}
+	return &value
+}
+
+// LoadCtx creates the Ctx from the state persisted in the storage.
+func LoadCtx(env runtime.Env) *ctx.Ctx {
+	c := ctx.NewDefault(env)
+	if env == nil {
+		return c
+	}
+	if profile := loadStorage[types.Profile](env, stremiocore.PROFILE_STORAGE_KEY); profile != nil {
+		c.Profile = *profile
+	}
+	uid := c.Profile.UID()
+	library := types.NewLibraryBucket(uid, nil)
+	if recent := loadStorage[types.LibraryBucket](env, stremiocore.LIBRARY_RECENT_STORAGE_KEY); recent != nil {
+		library.MergeBucket(*recent)
+	}
+	if other := loadStorage[types.LibraryBucket](env, stremiocore.LIBRARY_STORAGE_KEY); other != nil {
+		library.MergeBucket(*other)
+	}
+	c.Library = library
+	if streams := loadStorage[types.StreamsBucket](env, stremiocore.STREAMS_STORAGE_KEY); streams != nil && types.UIDEqual(streams.UID, uid) {
+		c.Streams = *streams
+	} else {
+		c.Streams = types.NewStreamsBucket(uid)
+	}
+	if urls := loadStorage[types.ServerUrlsBucket](env, stremiocore.STREAMING_SERVER_URLS_STORAGE_KEY); urls != nil && types.UIDEqual(urls.UID, uid) {
+		c.StreamingServerURLs = *urls
+	} else {
+		c.StreamingServerURLs = types.NewServerUrlsBucket(env.Now(), uid)
+	}
+	if notifications := loadStorage[types.NotificationsBucket](env, stremiocore.NOTIFICATIONS_STORAGE_KEY); notifications != nil && types.UIDEqual(notifications.UID, uid) {
+		c.Notifications = *notifications
+	} else {
+		c.Notifications = types.NewNotificationsBucket(env.Now(), uid, nil)
+	}
+	if history := loadStorage[types.SearchHistoryBucket](env, stremiocore.SEARCH_HISTORY_STORAGE_KEY); history != nil && types.UIDEqual(history.UID, uid) {
+		c.SearchHistory = *history
+	} else {
+		c.SearchHistory = types.NewSearchHistoryBucket(uid)
+	}
+	if dismissed := loadStorage[types.DismissedEventsBucket](env, stremiocore.DISMISSED_EVENTS_STORAGE_KEY); dismissed != nil && types.UIDEqual(dismissed.UID, uid) {
+		c.DismissedEvents = *dismissed
+	} else {
+		c.DismissedEvents = types.NewDismissedEventsBucket(uid)
+	}
+	return c
+}
+
+func (m *Model) ensureFields() runtime.Env {
+	env := m.Env()
+	if m.Ctx == nil {
+		m.Ctx = ctx.NewDefault(env)
+	}
+	if m.Player == nil {
+		m.Player = NewPlayer()
+	}
+	if m.StreamingServer == nil {
+		m.StreamingServer, _ = NewStreamingServer(env, &m.Ctx.Profile)
+	}
+	return env
+}
+
+// Update updates the whole model with the message: first the Ctx, then the
+// StreamingServer and the Player. It returns the effects and the changed fields.
+func (m *Model) Update(message *msg.Msg) ([]runtime.Effect, []string) {
+	env := m.ensureFields()
+	effects := []runtime.Effect{}
+	fields := []string{}
+
+	ctxEffects := m.Ctx.Update(env, message)
+	if ctxEffects.HasChanged {
+		fields = append(fields, FieldCtx)
+	}
+	effects = append(effects, ctxEffects.Effects...)
+
+	streamingServerEffects := m.StreamingServer.Update(env, message, m.Ctx)
+	if streamingServerEffects.HasChanged {
+		fields = append(fields, FieldStreamingServer)
+	}
+	effects = append(effects, streamingServerEffects.Effects...)
+
+	playerEffects := m.Player.Update(env, message, m.Ctx)
+	if playerEffects.HasChanged {
+		fields = append(fields, FieldPlayer)
+	}
+	effects = append(effects, playerEffects.Effects...)
+
+	return effects, fields
+}
+
+// UpdateField updates only the given field of the model with the message.
+func (m *Model) UpdateField(message *msg.Msg, field string) ([]runtime.Effect, []string) {
+	env := m.ensureFields()
+	var effects runtime.Effects
+	switch field {
+	case FieldCtx:
+		effects = m.Ctx.Update(env, message)
+	case FieldStreamingServer:
+		effects = m.StreamingServer.Update(env, message, m.Ctx)
+	case FieldPlayer:
+		effects = m.Player.Update(env, message, m.Ctx)
+	default:
+		return []runtime.Effect{}, []string{}
+	}
+	fields := []string{}
+	if effects.HasChanged {
+		fields = append(fields, field)
+	}
+	return append([]runtime.Effect{}, effects.Effects...), fields
+}
+
+// MarshalJSON serializes the model fields.
+func (m *Model) MarshalJSON() ([]byte, error) {
+	return types.MarshalJSON(struct {
+		Ctx             *ctx.Ctx         `json:"ctx"`
+		StreamingServer *StreamingServer `json:"streaming_server"`
+		Player          *Player          `json:"player"`
+	}{m.Ctx, m.StreamingServer, m.Player})
+}
+
+// FieldJSON serializes a single field of the model.
+func (m *Model) FieldJSON(field string) (json.RawMessage, error) {
+	switch field {
+	case FieldCtx:
+		return types.MarshalJSON(m.Ctx)
+	case FieldStreamingServer:
+		return types.MarshalJSON(m.StreamingServer)
+	case FieldPlayer:
+		return types.MarshalJSON(m.Player)
+	}
+	return nil, nil
+}
+
+var _ runtime.Model = (*Model)(nil)
diff --git a/models/persistence_test.go b/models/persistence_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..10f9774032df32b47a1b58dfcf11424c6733291f
--- /dev/null
+++ b/models/persistence_test.go
@@ -0,0 +1,130 @@
+package models_test
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/models"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func ctxAction(name string, args any) runtime.RuntimeAction {
+	return runtime.RuntimeAction{Action: msg.NewAction(msg.ActionNameCtx, msg.NewAction(name, args))}
+}
+
+func assertStorageRoundTrip[T any](t *testing.T, env *testenv.Env, key string) T {
+	t.Helper()
+	raw, ok := env.Storage[key]
+	if !ok {
+		t.Fatalf("%s should be stored", key)
+	}
+	var value T
+	if err := json.Unmarshal(raw, &value); err != nil {
+		t.Fatalf("%s: %v", key, err)
+	}
+	serialized, err := json.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(serialized) != string(raw) {
+		t.Fatalf("%s does not round trip\n got: %s\nwant: %s", key, serialized, raw)
+	}
+	return value
+}
+
+func TestPersistedStateRoundTrips(t *testing.T) {
+	env := testenv.New()
+	env.SetNow(time.Date(2024, 5, 6, 7, 8, 9, 123_000_000, time.UTC))
+	model := models.New(env)
+	rt, _ := runtime.New(model, nil, 1000, env)
+
+	settings := types.NewSettings()
+	settings.InterfaceLanguage = "bul"
+	rt.Dispatch(ctxAction(msg.ActionCtxUpdateSettings, settings))
+	meta := types.MetaItemPreview{ID: "tt1", Type: "series", Name: "Series", PosterShape: types.PosterShapePoster}
+	rt.Dispatch(ctxAction(msg.ActionCtxAddToLibrary, meta))
+	rt.Dispatch(ctxAction(msg.ActionCtxAddServerURL, "http://192.168.0.10:11470/"))
+	rt.Dispatch(ctxAction(msg.ActionCtxDismissEvent, "event_id"))
+	rt.Model().(*models.Model).Ctx.SearchHistory.Items["superman"] = env.Now()
+	rt.Dispatch(ctxAction(msg.ActionCtxClearSearchHistory, nil))
+
+	profile := assertStorageRoundTrip[types.Profile](t, env, stremiocore.PROFILE_STORAGE_KEY)
+	if profile.Settings.InterfaceLanguage != "bul" {
+		t.Fatalf("unexpected settings %+v", profile.Settings)
+	}
+	library := assertStorageRoundTrip[types.LibraryBucket](t, env, stremiocore.LIBRARY_RECENT_STORAGE_KEY)
+	if item, ok := library.Items["tt1"]; !ok || item.Removed || !item.Mtime.Equal(env.Now()) {
+		t.Fatalf("unexpected library %+v", library)
+	}
+	urls := assertStorageRoundTrip[types.ServerUrlsBucket](t, env, stremiocore.STREAMING_SERVER_URLS_STORAGE_KEY)
+	if _, ok := urls.Items["http://192.168.0.10:11470/"]; !ok || len(urls.Items) != 2 {
+		t.Fatalf("unexpected urls %+v", urls)
+	}
+	dismissed := assertStorageRoundTrip[types.DismissedEventsBucket](t, env, stremiocore.DISMISSED_EVENTS_STORAGE_KEY)
+	if _, ok := dismissed.Items["event_id"]; !ok {
+		t.Fatalf("unexpected dismissed events %+v", dismissed)
+	}
+	history := assertStorageRoundTrip[types.SearchHistoryBucket](t, env, stremiocore.SEARCH_HISTORY_STORAGE_KEY)
+	if len(history.Items) != 0 {
+		t.Fatalf("unexpected search history %+v", history)
+	}
+
+	// the model restored from the storage has the same state
+	restored := models.New(env)
+	current := rt.Model().(*models.Model)
+	if !types.Equal(restored.Ctx.Profile, current.Ctx.Profile) {
+		t.Fatal("restored profile differs")
+	}
+	if !types.Equal(restored.Ctx.Library, current.Ctx.Library) {
+		t.Fatal("restored library differs")
+	}
+	if !types.Equal(restored.Ctx.StreamingServerURLs, current.Ctx.StreamingServerURLs) {
+		t.Fatal("restored streaming server urls differ")
+	}
+	if !types.Equal(restored.Ctx.DismissedEvents, current.Ctx.DismissedEvents) {
+		t.Fatal("restored dismissed events differ")
+	}
+}
+
+func TestNotificationsAndStreamsPersistence(t *testing.T) {
+	env := testenv.New()
+	now := time.Date(2024, 5, 6, 7, 8, 9, 0, time.UTC)
+	env.SetNow(now)
+	uid := types.NewUID("user")
+	notifications := types.NewNotificationsBucket(now, uid, []types.NotificationItem{
+		{MetaID: "tt1", VideoID: "tt1:1:1", VideoReleased: now},
+		{MetaID: "tt1", VideoID: "tt1:1:1", VideoReleased: now.Add(time.Hour)},
+	})
+	if len(notifications.Items["tt1"]) != 1 || !notifications.Items["tt1"]["tt1:1:1"].VideoReleased.Equal(now) {
+		t.Fatalf("the first notification should be kept: %+v", notifications)
+	}
+	if err := env.SetStorage(stremiocore.NOTIFICATIONS_STORAGE_KEY, notifications); err != nil {
+		t.Fatal(err)
+	}
+	assertStorageRoundTrip[types.NotificationsBucket](t, env, stremiocore.NOTIFICATIONS_STORAGE_KEY)
+
+	streams := types.NewStreamsBucket(uid)
+	speed := float32(1.5)
+	streams.Items[types.StreamsItemKey{MetaID: "tt1", VideoID: "tt1:1:1"}] = types.StreamsItem{
+		Stream:             types.Stream{Source: types.StreamSource{Kind: types.StreamSourceURL, URL: "https://source_url/"}},
+		Type:               "series",
+		MetaID:             "tt1",
+		VideoID:            "tt1:1:1",
+		MetaTransportURL:   "https://transport_url/manifest.json",
+		StreamTransportURL: "https://transport_url/manifest.json",
+		State:              &types.StreamItemState{PlaybackSpeed: &speed},
+		Mtime:              now,
+	}
+	if err := env.SetStorage(stremiocore.STREAMS_STORAGE_KEY, streams); err != nil {
+		t.Fatal(err)
+	}
+	restored := assertStorageRoundTrip[types.StreamsBucket](t, env, stremiocore.STREAMS_STORAGE_KEY)
+	if !types.Equal(restored, streams) {
+		t.Fatalf("restored streams differ: %+v", restored)
+	}
+}
