+//
+// Reference scenarios generated with the rust implementation: the
+// scenarios are in testdata/streaming_server_scenarios.json and the rust
+// outputs in testdata/streaming_server_reference.json.
+//
+
+type ssResponse struct {
+	Ok  json.RawMessage `json:"ok"`
+	Err *string         `json:"err"`
+}
+
+type ssScenario struct {
+	Name               string                  `json:"name"`
+	AuthKey            *string                 `json:"authKey"`
+	StreamingServerURL string                  `json:"streamingServerUrl"`
+	Responses          map[string][]ssResponse `json:"responses"`
+	Steps              []struct {
+		Action         json.RawMessage         `json:"action"`
+		Responses      map[string][]ssResponse `json:"responses"`
+		ProfileChanged *string                 `json:"profileChanged"`
+	} `json:"steps"`
+}
+
+type ssRequest struct {
+	Method  string            `json:"method"`
+	URL     string            `json:"url"`
+	Headers map[string]string `json:"headers"`
+	Body    string            `json:"body"`
+}
+
+type ssSnapshot struct {
+	Model    *string     `json:"model"`
+	Requests []ssRequest `json:"requests"`
+	Events   []string    `json:"events"`
+	Changed  *bool       `json:"changed"`
+	Invalid  bool        `json:"invalid"`
+}
+
+type ssReference struct {
+	Name    string       `json:"name"`
+	Initial ssSnapshot   `json:"initial"`
+	Steps   []ssSnapshot `json:"steps"`
+}
+
+// ssDriver drives the StreamingServer model like the rust reference: the
+// message effects are handled immediately, the futures in FIFO order.
+type ssDriver struct {
+	t         *testing.T
+	env       *testenv.Env
+	server    *models.StreamingServer
+	ctx       *ctx.Ctx
+	events    []string
+	queue     []*runtime.EffectFuture
+	responses map[string][]ssResponse
+}
+
+func (d *ssDriver) fetch(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+	key := method + " " + url
+	queue, ok := d.responses[key]
+	if !ok || len(queue) == 0 {
+		return nil, runtime.EnvErrorFetch(fmt.Sprintf("Unhandled fetch request: %s %s", method, url))
+	}
+	response := queue[0]
+	if len(queue) > 1 {
+		d.responses[key] = queue[1:]
+	}
+	if response.Err != nil {
+		return nil, runtime.EnvErrorFetch(*response.Err)
+	}
+	return response.Ok, nil
+}
+
+func (d *ssDriver) handleEffects(effects runtime.Effects) {
+	for _, effect := range effects.Effects {
+		switch {
+		case effect.Msg != nil:
+			d.handleMsg(effect.Msg)
+		case effect.Future != nil:
+			d.queue = append(d.queue, effect.Future)
+		}
+	}
+}
+
+func (d *ssDriver) handleMsg(m *msg.Msg) {
+	switch m.ResolvedKind() {
+	case msg.KindEvent:
+		data, err := types.MarshalJSON(m.Event)
+		if err != nil {
+			d.t.Fatalf("event serialization: %v", err)
+		}
+		d.events = append(d.events, string(data))
+	case msg.KindInternal:
+		d.handleEffects(d.server.Update(d.env, m, d.ctx))
+	default:
+		d.t.Fatalf("effects are not allowed to resolve with action")
+	}
+}
+
+func (d *ssDriver) runQueue() {
+	for len(d.queue) > 0 {
+		future := d.queue[0]
+		d.queue = d.queue[1:]
+		if output := future.Run(); output != nil {
+			d.handleMsg(output)
+		}
+	}
+}
+
+func (d *ssDriver) dispatch(m *msg.Msg) bool {
+	effects := d.server.Update(d.env, m, d.ctx)
+	d.handleEffects(effects)
+	d.runQueue()
+	return effects.HasChanged
+}
+
+func (d *ssDriver) snapshot(changed bool) ssSnapshot {
+	model, err := types.MarshalJSON(d.server)
+	if err != nil {
+		d.t.Fatalf("model serialization: %v", err)
+	}
+	modelText := string(model)
+	requests := []ssRequest{}
+	for _, request := range d.env.Requests {
+		body := "null"
+		if request.Body != nil {
+			body = string(request.Body)
+		}
+		requests = append(requests, ssRequest{Method: request.Method, URL: request.URL, Headers: request.Headers, Body: body})
+	}
+	d.env.Requests = nil
+	events := d.events
+	d.events = nil
+	return ssSnapshot{Model: &modelText, Requests: requests, Events: events, Changed: &changed}
+}
+
+func ssTestProfile(authKey *string, streamingServerURL string) types.Profile {
+	profile := types.NewProfile()
+	if authKey != nil {
+		profile.Auth = &types.Auth{Key: types.AuthKey(*authKey), User: types.User{ID: "user_id", Email: "user@stremio.com"}}
+	}
+	profile.Settings.StreamingServerURL = streamingServerURL
+	return profile
+}
+
+func ssCompareSnapshot(t *testing.T, step string, got, want ssSnapshot) {
+	t.Helper()
+	if want.Changed != nil && (got.Changed == nil || *got.Changed != *want.Changed) {
+		t.Errorf("%s: changed = %v, want %v", step, *got.Changed, *want.Changed)
+	}
+	if want.Model != nil && *got.Model != *want.Model {
+		t.Errorf("%s: model\n got: %s\nwant: %s", step, *got.Model, *want.Model)
+	}
+	if len(got.Requests) != len(want.Requests) {
+		t.Errorf("%s: requests\n got: %+v\nwant: %+v", step, got.Requests, want.Requests)
+	} else {
+		for i := range want.Requests {
+			g, w := got.Requests[i], want.Requests[i]
+			if g.Method != w.Method || g.URL != w.URL || g.Body != w.Body || !types.Equal(g.Headers, w.Headers) &&
+				!(len(g.Headers) == 0 && len(w.Headers) == 0) {
+				t.Errorf("%s: request %d\n got: %+v\nwant: %+v", step, i, g, w)
+			}
+		}
+	}
+	if !reflect.DeepEqual(ssNonNilStrings(got.Events), ssNonNilStrings(want.Events)) {
+		t.Errorf("%s: events\n got: %v\nwant: %v", step, got.Events, want.Events)
+	}
+}
+
+func ssNonNilStrings(values []string) []string {
+	if values == nil {
+		return []string{}
+	}
+	return values
+}
+
+func ssReadJSON(t *testing.T, path string, value any) {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read %s: %v", path, err)
+	}
+	if err := json.Unmarshal(data, value); err != nil {
+		t.Fatalf("decode %s: %v", path, err)
+	}
+}
