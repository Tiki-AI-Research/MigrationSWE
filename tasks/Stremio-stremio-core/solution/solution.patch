+	if len(env.Requests) != 1 || env.Requests[0].Method != "GET" || env.Requests[0].Body != nil ||
+		env.Requests[0].Headers["content-type"] != "application/json" {
+		t.Errorf("requests = %+v", env.Requests)
+	}
+	before := *server.Statistics
+	rt.Dispatch(ssAction(msg.ActionStreamingServerGetStatistics, request))
+	if server.Statistics == nil || !server.Statistics.Equal(before) {
+		t.Errorf("a null response should leave the statistics unchanged: %+v", server.Statistics)
