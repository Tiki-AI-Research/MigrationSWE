index 0000000000000000000000000000000000000000..7ba82ef9345f965e118b51d4b3eaf6ac09736120
--- /dev/null
+++ b/analytics/analytics.go
@@ -0,0 +1,261 @@
+// Package analytics queues the analytics events of the logged in users and
+// sends them to the API in batches.
+package analytics
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"sync"
+
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Event is an analytics event.
+type Event struct {
+	// Data is flattened into the serialized event.
+	Data map[string]any
+	// Name is serialized as `eventName`.
+	Name string
+	// Time is the unix time in milliseconds, serialized as `eventTime`.
+	Time int64
+	// Number is the sequence number of the event, serialized as `eventNumber`.
+	Number uint64
+	// Context is the analytics context of the app, serialized as `app`.
+	Context any
+}
+
+// MarshalJSON serializes the data keys followed by `eventName`,
+// `eventTime`, `eventNumber` and `app`.
+func (e Event) MarshalJSON() ([]byte, error) {
+	tail, err := types.MarshalJSON(struct {
+		Name    string `json:"eventName"`
+		Time    int64  `json:"eventTime"`
+		Number  uint64 `json:"eventNumber"`
+		Context any    `json:"app"`
+	}{e.Name, e.Time, e.Number, e.Context})
+	if err != nil {
+		return nil, err
+	}
+	if len(e.Data) == 0 {
+		return tail, nil
+	}
+	data, err := types.MarshalJSON(e.Data)
+	if err != nil {
+		return nil, err
+	}
+	merged := make([]byte, 0, len(data)+len(tail))
+	merged = append(merged, data[:len(data)-1]...)
+	merged = append(merged, ',')
+	merged = append(merged, tail[1:]...)
+	return merged, nil
+}
+
+// Batch is a batch of consecutive events of the same user.
+type Batch struct {
+	AuthKey string
+	Events  []Event
+}
+
+// Analytics holds the queue of the event batches to be sent.
+// It is safe for concurrent use.
+type Analytics struct {
+	env    runtime.Env
+	sendFn func(Batch) error
+
+	mu     sync.Mutex
+	number uint64
+	queue  []Batch
+	// pending is the batch being sent, nil when no batch is being sent.
+	pending *Batch
+}
+
+// New creates the analytics. env provides the time of the events and sendFn
+// sends a batch of events (see SendBatchToAPI).
+func New(env runtime.Env, sendFn func(Batch) error) *Analytics {
+	return &Analytics{env: env, sendFn: sendFn}
+}
+
+// Emit queues an event. Events without an auth key (i.e. when the user is
+// not logged in) are ignored. Consecutive events of the same user are sent in
+// the same batch.
+func (a *Analytics) Emit(name string, data map[string]any, authKey string, context any) {
+	if authKey == "" {
+		return
+	}
+	var eventData map[string]any
+	if data != nil {
+		eventData = make(map[string]any, len(data))
+		for key, value := range data {
+			eventData[key] = value
+		}
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.number++ // wraps around on overflow
+	event := Event{
+		Data:    eventData,
+		Name:    name,
+		Time:    a.env.Now().UnixMilli(),
+		Number:  a.number,
+		Context: context,
+	}
+	if last := len(a.queue) - 1; last >= 0 && a.queue[last].AuthKey == authKey {
+		a.queue[last].Events = append(a.queue[last].Events, event)
+		return
+	}
+	a.queue = append(a.queue, Batch{AuthKey: authKey, Events: []Event{event}})
+}
+
+// SendNextBatch sends the first queued batch, unless a batch is already
+// being sent. The batch is put back to the front of the queue when sending
+// fails because of a network, serialization or API error (except the API
+// error with code 1).
+func (a *Analytics) SendNextBatch() {
+	a.mu.Lock()
+	if a.pending != nil || len(a.queue) == 0 {
+		a.mu.Unlock()
+		return
+	}
+	batch := a.queue[0]
+	a.queue[0] = Batch{}
+	a.queue = a.queue[1:]
+	pending := &batch
+	a.pending = pending
+	a.mu.Unlock()
+
+	err := a.sendFn(batch)
+
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	// ignore the result when the batch is no longer pending (i.e. flushed)
+	if a.pending != pending {
+		return
+	}
+	a.pending = nil
+	if isSendFailure(err) {
+		a.queue = append([]Batch{batch}, a.queue...)
+	}
+}
+
+// isSendFailure reports whether the batch has to be sent again.
+func isSendFailure(err error) bool {
+	if err == nil {
+		return false
+	}
+	var envErr *runtime.EnvError
+	if errors.As(err, &envErr) {
+		if envErr == nil {
+			return false
+		}
+		return envErr.Code == runtime.EnvErrorCodeFetch || envErr.Code == runtime.EnvErrorCodeSerde
+	}
+	var apiErr *types.APIError
+	if errors.As(err, &apiErr) {
+		if apiErr == nil {
+			return false
+		}
+		return apiErr.Code != 1
+	}
+	return true
+}
+
+// Flush sends all the queued batches, ignoring the results. A batch being
+// sent is no longer considered pending.
+func (a *Analytics) Flush() {
+	a.mu.Lock()
+	a.pending = nil
+	batches := a.queue
+	a.queue = nil
+	a.mu.Unlock()
+	for _, batch := range batches {
+		_ = a.sendFn(batch)
+	}
+}
+
+// QueueLen returns the number of queued batches.
+func (a *Analytics) QueueLen() int {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return len(a.queue)
+}
+
+// IsPending reports whether a batch is being sent.
+func (a *Analytics) IsPending() bool {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return a.pending != nil
+}
+
+// Queue returns a copy of the queued batches.
+func (a *Analytics) Queue() []Batch {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	batches := make([]Batch, len(a.queue))
+	for i, batch := range a.queue {
+		batches[i] = Batch{AuthKey: batch.AuthKey, Events: append([]Event(nil), batch.Events...)}
+	}
+	return batches
+}
+
+// APIRequest returns the `events` API request of the batch, with the
+// events serialized by Event.MarshalJSON.
+func APIRequest(batch Batch) types.APIRequest {
+	events := make([]json.RawMessage, 0, len(batch.Events))
+	for _, event := range batch.Events {
+		data, err := sortedJSON(event)
+		if err != nil {
+			// an unserializable event is sent as null rather than dropping the batch
+			data = []byte("null")
+		}
+		events = append(events, data)
+	}
+	return types.APIRequest{
+		Type:    types.APIRequestEvents,
+		AuthKey: types.AuthKey(batch.AuthKey),
+		Events:  events,
+	}
+}
+
+// SendBatchToAPI returns a send function which sends the batch to the API
+// with env.Fetch. It returns a *runtime.EnvError for network and
+// serialization errors and a *types.APIError when the API returned an error.
+func SendBatchToAPI(env runtime.Env) func(Batch) error {
+	return func(batch Batch) error {
+		request := APIRequest(batch)
+		body, err := request.Body()
+		if err != nil {
+			return runtime.EnvErrorSerde(err.Error())
+		}
+		response, envErr := env.Fetch(request.Method(), request.URL(), map[string]string{}, body)
+		if envErr != nil {
+			return envErr
+		}
+		var result types.SuccessResponse
+		apiErr, err := types.ParseAPIResult(response, &result)
+		if err != nil {
+			return runtime.EnvErrorSerde(err.Error())
+		}
+		if apiErr != nil {
+			return apiErr
+		}
+		return nil
+	}
+}
+
+// sortedJSON serializes the value with the object keys sorted, like a rust
+// `serde_json::Value` (which the events are converted to before sending).
+func sortedJSON(value any) (json.RawMessage, error) {
+	data, err := types.MarshalJSON(value)
+	if err != nil {
+		return nil, err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	var generic any
+	if err := decoder.Decode(&generic); err != nil {
+		return nil, err
+	}
+	return types.MarshalJSON(generic)
+}
