+			return []byte(`{"availableHardwareAccelerations":[]}`), nil
+		}
+		return nil, runtime.EnvErrorFetch("Unhandled fetch request: " + method + " " + url)
+	}
+	m, effects := models.NewWithEffects(env)
+	rt, rx := runtime.New(m, effects, 1000, env)
+	if !ssModel(t, rt.Model()).StreamingServer.Settings.IsReady() {
+		t.Fatal("settings should be ready")
