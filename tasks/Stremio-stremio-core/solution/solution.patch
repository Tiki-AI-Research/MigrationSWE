+	assertEqual(t, h.ctx().Profile.Addons, []types.Descriptor{officialAddon}, "addons updated successfully in memory")
+	stored, ok := storageValue[types.Profile](t, env, stremiocore.PROFILE_STORAGE_KEY)
+	if !ok {
+		t.Errorf("addons updated successfully in storage: missing key")
+	}
+	assertEqual(t, stored.Addons, []types.Descriptor{officialAddon}, "addons updated successfully in storage")
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventAddonsPulledFromAPI,
+		msg.EventProfilePushedToStorage,
+	}, "events")
+	// the added transport url, then the removed one
+	assertEvent(t, h.findEvent(msg.EventAddonsPulledFromAPI), msg.EventAddonsPulledFromAPI,
+		msg.TransportURLsArgs{TransportURLs: []string{officialAddon.TransportURL, "https://transport_url/"}},
+		"AddonsPulledFromAPI")
+	assertEvent(t, h.findEvent(msg.EventProfilePushedToStorage), msg.EventProfilePushedToStorage,
+		`{"uid":null}`, "ProfilePushedToStorage")
