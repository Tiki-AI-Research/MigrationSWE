+func TestWatchedFieldAnchorPointsToLastWatchedVideo(t *testing.T) {
+	var videoIDs []string
+	for i := 1; i <= 20; i++ {
+		videoIDs = append(videoIDs, fmt.Sprintf("tt0:1:%d", i))
+	}
+	watched := WatchedBitFieldConstructFromArray(nil, videoIDs)
+	watched.SetVideo("tt0:1:16", true)
+	serialized := watched.WatchedField().String()
+	if len(serialized) < 12 || serialized[:12] != "tt0:1:16:16:" {
+		t.Errorf("anchor should point to the last watched video, got: %s", serialized)
+	}
+}
