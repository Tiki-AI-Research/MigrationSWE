@@ -0,0 +1,252 @@
+package deeplinks
+
+import (
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"testing"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+//
+// external_player_link.rs
+//
+
+const (
+	downloadTorrentStrURL = "http://127.0.0.1:11470/dd8255ecdc7ca55fb0bbf81323d87062db1f6d1c/0?external=1&download=1"
+	epMagnetStrURL        = "magnet:?xt=urn:btih:dd8255ecdc7ca55fb0bbf81323d87062db1f6d1c&tr=http%3A%2F%2Fbt1.archive.org%3A6969%2Fannounce"
+	epHTTPStrURL          = "http://domain.root/path"
+	epBase64HTTPURL       = "data:application/octet-stream;charset=utf-8;base64,I0VYVE0zVQojRVhUSU5GOjAKaHR0cDovL2RvbWFpbi5yb290L3BhdGg="
+	streamingServerStrURL = "http://127.0.0.1:11470"
+)
+
+var testInfoHash = types.InfoHash{
+	0xdd, 0x82, 0x55, 0xec, 0xdc, 0x7c, 0xa5, 0x5f, 0xb0, 0xbb, 0xf8, 0x13, 0x23, 0xd8, 0x70,
+	0x62, 0xdb, 0x1f, 0x6d, 0x1c,
+}
+
+func urlStream(url string) types.Stream {
+	return types.Stream{Source: types.StreamSource{Kind: types.StreamSourceURL, URL: url}}
+}
+
+func torrentStream(fileIdx *uint16, announce []string) types.Stream {
+	return types.Stream{Source: types.StreamSource{
+		Kind:            types.StreamSourceTorrent,
+		InfoHash:        testInfoHash,
+		FileIdx:         fileIdx,
+		Announce:        announce,
+		FileMustInclude: []string{},
+	}}
+}
+
+func youTubeStream(ytID string) types.Stream {
+	return types.Stream{Source: types.StreamSource{Kind: types.StreamSourceYouTube, YtID: ytID}}
+}
+
+func playerFrameStream(url string) types.Stream {
+	return types.Stream{Source: types.StreamSource{Kind: types.StreamSourcePlayerFrame, PlayerFrameURL: url}}
+}
+
+func externalStream(url string) types.Stream {
+	return types.Stream{Source: types.StreamSource{Kind: types.StreamSourceExternal, ExternalURL: ptr(url)}}
+}
+
+func m3uPlaylist(streamingURL string) string {
+	return "data:application/octet-stream;charset=utf-8;base64," +
+		base64.StdEncoding.EncodeToString([]byte("#EXTM3U\n#EXTINF:0\n"+streamingURL))
+}
+
+func playerSettings(playerType string) types.Settings {
+	settings := types.NewSettings()
+	settings.PlayerType = ptr(playerType)
+	settings.StreamingServerURL = streamingServerStrURL
+	return settings
+}
+
+func TestExternalPlayerLinkMagnet(t *testing.T) {
+	epl := NewExternalPlayerLink(urlStream(epMagnetStrURL), ptr(streamingServerStrURL), types.NewSettings())
+	assertStrPtr(t, epl.Download, nil)
+	assertStrPtr(t, epl.Magnet, ptr(epMagnetStrURL))
+	assertStrPtr(t, epl.FileName, nil)
+}
+
+func TestExternalPlayerLinkHTTP(t *testing.T) {
