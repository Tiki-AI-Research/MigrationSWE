+// LibraryBucket holds the library items of a user.
+type LibraryBucket struct {
+	UID UID
+	// Items are keyed by LibraryItem.ID.
+	Items map[string]LibraryItem
+}
+
+type libraryBucketJSON struct {
+	UID   UID                    `json:"uid"`
+	Items map[string]LibraryItem `json:"items"`
+}
+
+func (b LibraryBucket) MarshalJSON() ([]byte, error) {
+	items := b.Items
+	if items == nil {
+		items = map[string]LibraryItem{}
+	}
+	return MarshalJSON(libraryBucketJSON{UID: b.UID, Items: items})
+}
+
+func (b *LibraryBucket) UnmarshalJSON(data []byte) error {
+	var wire libraryBucketJSON
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Items == nil {
+		wire.Items = map[string]LibraryItem{}
+	}
+	*b = LibraryBucket{UID: wire.UID, Items: wire.Items}
+	return nil
+}
+
+// NewLibraryBucket creates a bucket with the given items.
+func NewLibraryBucket(uid UID, items []LibraryItem) LibraryBucket {
+	bucket := LibraryBucket{UID: uid, Items: map[string]LibraryItem{}}
+	for _, item := range items {
+		bucket.Items[item.ID] = item
+	}
+	return bucket
+}
+
+// MergeBucket merges the items of a bucket of the same user.
+func (b *LibraryBucket) MergeBucket(bucket LibraryBucket) {
+	if UIDEqual(b.UID, bucket.UID) {
+		items := make([]LibraryItem, 0, len(bucket.Items))
+		for _, item := range bucket.Items {
+			items = append(items, item)
+		}
+		b.MergeItems(items)
+	}
+}
+
+// MergeItems inserts the items, replacing the existing ones which are not newer.
+func (b *LibraryBucket) MergeItems(items []LibraryItem) {
+	if b.Items == nil {
+		b.Items = map[string]LibraryItem{}
+	}
+	for _, item := range items {
+		current, ok := b.Items[item.ID]
+		if !ok || !item.Mtime.Before(current.Mtime) {
+			b.Items[item.ID] = item
+		}
+	}
+}
+
+// itemsByRecent returns the items sorted by modification time, newest first.
+func (b LibraryBucket) itemsByRecent() []LibraryItem {
+	items := make([]LibraryItem, 0, len(b.Items))
+	for _, item := range b.Items {
+		items = append(items, item)
+	}
+	sort.SliceStable(items, func(i, j int) bool {
+		if !items[i].Mtime.Equal(items[j].Mtime) {
+			return items[i].Mtime.After(items[j].Mtime)
+		}
+		return items[i].ID < items[j].ID
+	})
+	return items
+}
+
+// AreIDsInRecent reports whether all the ids are among the LIBRARY_RECENT_COUNT newest items.
+func (b LibraryBucket) AreIDsInRecent(ids []string) bool {
+	recent := map[string]bool{}
+	for i, item := range b.itemsByRecent() {
+		if i >= stremiocore.LIBRARY_RECENT_COUNT {
+			break
+		}
+		recent[item.ID] = true
+	}
+	for _, id := range ids {
+		if !recent[id] {
+			return false
+		}
+	}
+	return true
+}
+
+// SplitItemsByRecent splits the items into the LIBRARY_RECENT_COUNT newest ones and the rest.
+func (b LibraryBucket) SplitItemsByRecent() ([]LibraryItem, []LibraryItem) {
+	sorted := b.itemsByRecent()
+	count := min(stremiocore.LIBRARY_RECENT_COUNT, len(sorted))
+	return sorted[:count], sorted[count:]
+}
+
+// NewLibraryBucketRef creates the bucket of a subset of the items.
+func NewLibraryBucketRef(uid UID, items []LibraryItem) LibraryBucket {
+	return NewLibraryBucket(uid, items)
+}
