+// UID returns the user id, `nil` when not authenticated.
+func (p Profile) UID() UID {
+	if p.Auth == nil {
+		return nil
+	}
+	return NewUID(p.Auth.User.ID)
+}
+
+// AuthKey returns the auth key, `nil` when not authenticated.
+func (p Profile) AuthKey() *AuthKey {
+	if p.Auth == nil {
+		return nil
+	}
+	key := p.Auth.Key
+	return &key
+}
+
+// HasTrakt reports whether the user has a valid (not expired) Trakt token.
+func (p Profile) HasTrakt(now time.Time) bool {
+	if p.Auth == nil || p.Auth.User.Trakt == nil {
+		return false
+	}
+	trakt := p.Auth.User.Trakt
+	return now.Before(trakt.CreatedAt.Add(trakt.ExpiresIn))
+}
