+		t.Fatalf("the empty next streams should be an EmptyContent error: %+v", p.NextStreams)
+	}
+	if p.SeriesInfo == nil || *p.SeriesInfo != (types.SeriesInfo{Season: 1, Episode: 1}) {
+		t.Fatalf("unexpected series info: %+v", p.SeriesInfo)
+	}
+	if p.LibraryItem == nil || p.LibraryItem.Name != "" || p.Watched == nil {
+		t.Fatalf("the library item should be updated with the meta item: %+v", p.LibraryItem)
+	}
+	if p.AnalyticsContext == nil || p.AnalyticsContext.ID == nil || *p.AnalyticsContext.ID != "tt123456" ||
+		p.AnalyticsContext.VideoID == nil || *p.AnalyticsContext.VideoID != "tt123456:1:1" {
+		t.Fatalf("unexpected analytics context: %+v", p.AnalyticsContext)
+	}
+	// the stream has no hash nor filename and there are no video params
+	if len(p.Subtitles) != 0 {
+		t.Fatalf("no subtitles should be requested: %+v", p.Subtitles)
+	}
+	if events := playerCoreEvents(drainPlayerEvents(rx), msg.EventTraktPaused, msg.EventPlayerStopped); len(events) != 0 {
+		t.Fatalf("no trakt events are expected for the first load: %v", events)
+	}
+}
