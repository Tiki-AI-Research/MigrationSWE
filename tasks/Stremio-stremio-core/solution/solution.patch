+
+func TestLibraryItemDeepLinksPlayerLink(t *testing.T) {
+	item := libraryItem("tt13622776", "Ahsoka", "series", libraryItemState(61_999, 3_600_000, ptr("tt13622776:1:5")), nil)
+	lidl := NewLibraryItemDeepLinks(item, torrentStreamsItem(t), nil, types.NewSettings())
+	encoded, err := torrentStreamsItem(t).Stream.Encode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertStrPtr(t, lidl.Player, ptr("stremio:///player/"+types.EncodeURIComponent(encoded)+
+		"/https%3A%2F%2Ftorrentio.strem.fun%2Fqualityfilter%3D1080p%2C720p%2Fmanifest.json"+
+		"/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/tt13622776/tt13622776%3A1%3A5?position=61"))
+	// without a streaming server the torrent can not be converted: only the magnet is available
+	if lidl.ExternalPlayer == nil {
+		t.Fatal("should have external player")
+	}
+	assertJSON(t, *lidl.ExternalPlayer, `{"download":null,"magnet":"magnet:?dn=PaidTV&xt=urn:btih:df2c94aec35f97943c4e432f25081b590cd35326","streaming":null,"playlist":null,"fileName":null,"openPlayer":null,"web":null,"androidTv":null,"tizen":null,"webos":null}`)
+}
+
+//
+// video_deep_links.rs
+//
+
+func TestVideoDeepLinks(t *testing.T) {
+	const streamingServer = "http://127.0.0.1:11470/"
+	const ytID = "aqz-KE-bpKQ"
+	video := types.Video{
+		ID:             "yt_id:UCSMOQeBJ2RAnuFungnQOxLg:" + ytID,
+		Title:          "Big Buck Bunny",
+		Streams:        []types.Stream{},
+		TrailerStreams: []types.Stream{},
+	}
+	request := types.NewResourceRequest("http://domain.root", types.NewResourcePath("meta", "movie", "yt_id:"+ytID))
+	vdl := NewVideoDeepLinks(video, request, ptr(streamingServer), types.NewSettings())
+	assertEqual(t, vdl.MetaDetailsVideos, "stremio:///detail/movie/yt_id%3A"+ytID)
+	assertEqual(t, vdl.MetaDetailsStreams, "stremio:///detail/movie/yt_id%3A"+ytID+"/yt_id%3AUCSMOQeBJ2RAnuFungnQOxLg%3A"+ytID)
+	assertStrPtr(t, vdl.Player, ptr("stremio:///player/eAEBFgDp%2F3sieXRJZCI6ImFxei1LRS1icEtRIn1RRQb5/http%3A%2F%2Fdomain.root%2F/http%3A%2F%2Fdomain.root%2F/movie/yt_id%3A"+ytID+"/yt_id%3AUCSMOQeBJ2RAnuFungnQOxLg%3A"+ytID))
+	expected := ExternalPlayerLink{
+		Playlist:  ptr(types.M3uDataURI(streamingServer + "yt/" + ytID)),
+		Download:  ptr("https://youtube.com/watch?v=" + ytID),
+		Streaming: ptr(streamingServer + "yt/" + ytID),
+		FileName:  ptr("playlist.m3u"),
+	}
+	if vdl.ExternalPlayer == nil || !types.Equal(*vdl.ExternalPlayer, expected) {
+		t.Errorf("external player\n got: %+v\nwant: %+v", vdl.ExternalPlayer, expected)
+	}
+	// the playlist is the base64 m3u of the streaming url
+	assertEqual(t, *expected.Playlist, "data:application/octet-stream;charset=utf-8;base64,I0VYVE0zVQojRVhUSU5GOjAKaHR0cDovLzEyNy4wLjAuMToxMTQ3MC95dC9hcXotS0UtYnBLUQ==")
+}
+
+func TestVideoDeepLinksWithRequests(t *testing.T) {
+	video := types.Video{ID: "tt1:1:2", Streams: []types.Stream{{Source: types.StreamSource{Kind: types.StreamSourceURL, URL: "http://domain.root/path"}}}}
+	streamRequest := types.NewResourceRequest("https://stream.addon/manifest.json", types.NewResourcePath("stream", "series", "tt1:1:2"))
+	metaRequest := types.NewResourceRequest("http://domain.root", types.NewResourcePath("meta", "series", "tt1"))
+	vdl := NewVideoDeepLinksWithRequests(video, streamRequest, metaRequest, nil, types.NewSettings())
+	assertEqual(t, vdl.MetaDetailsVideos, "stremio:///detail/series/tt1")
+	assertEqual(t, vdl.MetaDetailsStreams, "stremio:///detail/series/tt1/tt1%3A1%3A2")
+	assertStrPtr(t, vdl.Player, ptr("stremio:///player/eAEBIQDe%2F3sidXJsIjoiaHR0cDovL2RvbWFpbi5yb290L3BhdGgifcEEC6w%3D/https%3A%2F%2Fstream.addon%2Fmanifest.json/http%3A%2F%2Fdomain.root%2F/series/tt1/tt1%3A1%3A2"))
+	if vdl.ExternalPlayer == nil {
+		t.Fatal("should have external player")
+	}
+	assertStrPtr(t, vdl.ExternalPlayer.Streaming, ptr("http://domain.root/path"))
+
+	// more than one stream: no player links
+	video.Streams = append(video.Streams, video.Streams[0])
+	vdl = NewVideoDeepLinksWithRequests(video, streamRequest, metaRequest, nil, types.NewSettings())
+	assertStrPtr(t, vdl.Player, nil)
+	if vdl.ExternalPlayer != nil {
+		t.Errorf("unexpected external player %+v", vdl.ExternalPlayer)
+	}
+	assertJSON(t, vdl, `{"metaDetailsVideos":"stremio:///detail/series/tt1","metaDetailsStreams":"stremio:///detail/series/tt1/tt1%3A1%3A2","player":null,"externalPlayer":null}`)
+}
