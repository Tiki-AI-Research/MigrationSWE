+func TestStreamingServerCreateTorrentFromFile(t *testing.T) {
+	torrent := []byte("d8:announce20:udp://tracker.a:13374:infod6:lengthi1024e4:name8:test.mkv12:piece lengthi16384e6:pieces20:AAAAAAAAAAAAAAAAAAAAee")
+	infoHash, _, err := types.ParseTorrent(torrent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var createErr atomic.Bool
+	env, rt, rx := ssLoadedRuntime(t, func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		if method == "POST" && url == ssURL+"create" {
+			if createErr.Load() {
+				return nil, runtime.EnvErrorFetch("Connection refused")
+			}
+			return []byte(`{}`), nil
+		}
+		return nil, nil
+	})
+	numbers := make([]int, len(torrent))
+	for i, b := range torrent {
+		numbers[i] = int(b)
+	}
+	rt.Dispatch(ssAction(msg.ActionStreamingServerCreateTorrent, numbers))
+	if len(env.Requests) != 1 {
+		t.Fatalf("requests = %+v", env.Requests)
+	}
+	request := env.Requests[0]
+	if request.Method != "POST" || string(request.Body) != `{"blob":"`+fmt.Sprintf("%x", torrent)+`"}` ||
+		request.Headers["content-type"] != "application/json" {
+		t.Errorf("request = %s %s %v %s", request.Method, request.URL, request.Headers, request.Body)
+	}
+	server := ssModel(t, rt.Model()).StreamingServer
+	if server.Torrent == nil || server.Torrent.InfoHash != infoHash ||
+		!server.Torrent.Path.Equal(common.Ready(types.NewResourcePath("meta", "other", "bt:"+infoHash.String()))) {
+		t.Fatalf("torrent = %+v", server.Torrent)
+	}
+	numbersJSON, _ := json.Marshal(numbers)
+	events := ssDrainEvents(rx)
+	if len(events) != 1 || events[0].Event != msg.EventTorrentParsed || string(events[0].Args) != `{"torrent":`+string(numbersJSON)+`}` {
+		t.Errorf("events = %v", events)
+	}
+
+	// failed torrent creation
+	createErr.Store(true)
+	rt.Dispatch(ssAction(msg.ActionStreamingServerCreateTorrent, numbers))
+	if server.Torrent == nil || !server.Torrent.Path.IsErr() ||
+		!types.Equal(server.Torrent.Path.Err(), runtime.EnvErrorFetch("Connection refused")) {
+		t.Fatalf("torrent = %+v", server.Torrent)
+	}
+	ssDrainEvents(rx)
+
+	// invalid torrent file
+	rt.Dispatch(ssAction(msg.ActionStreamingServerCreateTorrent, []int{1, 2, 3}))
+	if server.Torrent != nil {
+		t.Error("torrent should be reset")
+	}
+	events = ssDrainEvents(rx)
+	if len(events) != 1 || events[0].Event != msg.EventError {
+		t.Fatalf("events = %v", events)
+	}
+	var args struct {
+		Error struct {
+			Type    string `json:"type"`
+			Code    int    `json:"code"`
+			Message string `json:"message"`
+		} `json:"error"`
+		Source msg.Event `json:"source"`
+	}
+	if err := events[0].DecodeArgs(&args); err != nil {
+		t.Fatal(err)
+	}
+	if args.Error.Type != "Env" || args.Error.Code != 1001 ||
+		!strings.HasPrefix(args.Error.Message, "Other error: Failed to parse stream from file: ") ||
+		args.Source.Event != msg.EventTorrentParsed || string(args.Source.Args) != `{"torrent":[1,2,3]}` {
+		t.Errorf("error event = %+v", args)
+	}
+}
