+package common
+
+import "reflect"
+
+func reflectLen(value any) int {
+	v := reflect.ValueOf(value)
+	switch v.Kind() {
+	case reflect.Slice, reflect.Map, reflect.Array, reflect.String:
+		return v.Len()
+	}
+	return -1
+}
diff --git a/models/common/resource_loadable.go b/models/common/resource_loadable.go
new file mode 100644
index 0000000000000000000000000000000000000000..1162bbf7ab020a2dbf482792995170ba429e53f9
--- /dev/null
+++ b/models/common/resource_loadable.go
@@ -0,0 +1,331 @@
+package common
+
+import (
+	"fmt"
+
+	addontransport "github.com/stremio/stremio-core/addon_transport"
+
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Resource error kinds.
+const (
+	ResourceErrorEmptyContent       = "EmptyContent"
+	ResourceErrorUnexpectedResponse = "UnexpectedResponse"
+	ResourceErrorEnv                = "Env"
+)
+
+// ResourceError is the error of a resource loadable.
+type ResourceError struct {
+	Kind    string
+	Message string
+	Env     *runtime.EnvError
+}
+
+func (e *ResourceError) Error() string {
+	switch e.Kind {
+	case ResourceErrorEmptyContent:
+		return "EmptyContent"
+	case ResourceErrorUnexpectedResponse:
+		return "UnexpectedResponse: " + e.Message
+	case ResourceErrorEnv:
+		if e.Env != nil {
+			return "Env: " + e.Env.Message
+		}
+		return "Env"
+	}
+	return e.Kind
+}
+
+func (e *ResourceError) MarshalJSON() ([]byte, error) {
+	switch e.Kind {
+	case ResourceErrorUnexpectedResponse:
+		return types.MarshalJSON(struct {
+			Type    string `json:"type"`
+			Content string `json:"content"`
+		}{e.Kind, e.Message})
+	case ResourceErrorEnv:
+		return types.MarshalJSON(struct {
+			Type    string            `json:"type"`
+			Content *runtime.EnvError `json:"content"`
+		}{e.Kind, e.Env})
+	}
+	return types.MarshalJSON(struct {
+		Type string `json:"type"`
+	}{e.Kind})
+}
+
+// ResourceLoadable is a resource loaded from an addon.
+type ResourceLoadable[T any] struct {
+	Request types.ResourceRequest
+	Content *Loadable[T]
+}
+
+func (r ResourceLoadable[T]) MarshalJSON() ([]byte, error) {
+	return types.MarshalJSON(struct {
+		Request types.ResourceRequest `json:"request"`
+		Content *Loadable[T]          `json:"content"`
+	}{r.Request, r.Content})
+}
+
+// ResourceResult is the result of fetching a resource.
+type ResourceResult struct {
+	Response *types.ResourceResponse
+	Err      *runtime.EnvError
+}
+
+// ResourceAction requests a resource (Result is nil) or loads the result of
+// a request.
+type ResourceAction struct {
+	Request *types.ResourceRequest
+	Result  *ResourceResult
+}
+
+// ResourceRequested requests the resource.
+func ResourceRequested(request *types.ResourceRequest) ResourceAction {
+	return ResourceAction{Request: request}
+}
+
+// ResourceRequestResult loads the result of the resource request.
+func ResourceRequestResult(request *types.ResourceRequest, result ResourceResult) ResourceAction {
+	return ResourceAction{Request: request, Result: &result}
+}
+
+// ResourceActionFromMsg returns the ResourceRequestResult action of a
+// `ResourceRequestResult` internal message.
+func ResourceActionFromMsg(m *msg.Msg) (ResourceAction, bool) {
+	data, ok := m.InternalData(msg.InternalResourceRequestResult)
+	if !ok {
+		return ResourceAction{}, false
+	}
+	return ResourceActionFromData(data)
+}
+
+// ResourceActionFromData converts the data of a `ResourceRequestResult` (or
+// `NotificationsRequestResult`) internal message to a ResourceAction.
+func ResourceActionFromData(data any) (ResourceAction, bool) {
+	var result msg.ResourceRequestResult
+	switch value := data.(type) {
+	case msg.ResourceRequestResult:
+		result = value
+	case *msg.ResourceRequestResult:
+		if value == nil {
+			return ResourceAction{}, false
+		}
+		result = *value
+	default:
+		return ResourceAction{}, false
+	}
+	var request types.ResourceRequest
+	switch value := result.Request.(type) {
+	case types.ResourceRequest:
+		request = value
+	case *types.ResourceRequest:
+		if value == nil {
+			return ResourceAction{}, false
+		}
+		request = *value
+	default:
+		return ResourceAction{}, false
+	}
+	resourceResult := ResourceResult{}
+	if result.Err != nil {
+		switch err := result.Err.(type) {
+		case *runtime.EnvError:
+			resourceResult.Err = err
+		default:
+			resourceResult.Err = runtime.EnvErrorOther(err.Error())
+		}
+	}
+	if resourceResult.Err == nil {
+		switch value := result.Value.(type) {
+		case types.ResourceResponse:
+			resourceResult.Response = &value
+		case *types.ResourceResponse:
+			resourceResult.Response = value
+		}
+		if resourceResult.Response == nil {
+			resourceResult.Err = runtime.EnvErrorOther("missing resource response")
+		}
+	}
+	return ResourceRequestResult(&request, resourceResult), true
+}
+
+// NewResourceRequestResultMsg creates the internal message carrying the
+// result of a resource request.
+func NewResourceRequestResultMsg(request types.ResourceRequest, response types.ResourceResponse, err *runtime.EnvError) *msg.Msg {
+	data := msg.ResourceRequestResult{Request: request}
+	if err != nil {
+		data.Err = err
+	} else {
+		data.Value = response
+	}
+	return msg.InternalMsg(msg.NewInternal(msg.InternalResourceRequestResult, data))
+}
+
+// AddonTransport returns the transport of the env for the addon, defaulting
+// to the HTTP transport.
+func AddonTransport(env runtime.Env, transportURL string) runtime.AddonTransport {
+	if transport := env.AddonTransport(transportURL); transport != nil {
+		return transport
+	}
+	return addontransport.NewTransport(transportURL, env)
+}
+
+// ResourceFuture is the effect fetching the resource from the addon.
+func ResourceFuture(env runtime.Env, request types.ResourceRequest) runtime.Effect {
+	return runtime.ConcurrentFuture(func() *msg.Msg {
+		response, err := AddonTransport(env, request.Base).Resource(request.Path)
+		return NewResourceRequestResultMsg(request, response, err)
+	})
+}
+
+func resourceContentFromResult[T any](result *ResourceResult, convert func(types.ResourceResponse) (T, error), vector bool) Loadable[T] {
+	if result.Err != nil || result.Response == nil {
+		env := result.Err
+		if env == nil {
+			env = runtime.EnvErrorOther("missing resource response")
+		}
+		return Err[T](&ResourceError{Kind: ResourceErrorEnv, Env: env})
+	}
+	content, err := convert(*result.Response)
+	if err != nil {
+		return Err[T](&ResourceError{Kind: ResourceErrorUnexpectedResponse, Message: err.Error()})
+	}
+	if vector && isEmptyCollection(content) {
+		return Err[T](&ResourceError{Kind: ResourceErrorEmptyContent})
+	}
+	return Ready(content)
+}
+
+func isEmptyCollection(value any) bool {
+	switch v := value.(type) {
+	case interface{ Len() int }:
+		return v.Len() == 0
+	}
+	return reflectLen(value) == 0
+}
+
+// ResourceUpdate updates the resource: a request starts loading it (if it is
+// not already loaded for the same request) and the result of the loading
+// request sets the content.
+func ResourceUpdate[T any](env runtime.Env, resource *ResourceLoadable[T], action ResourceAction, convert func(types.ResourceResponse) (T, error)) runtime.Effects {
+	return resourceUpdate(env, resource, action, convert, false)
+}
+
+// ResourceUpdateWithVectorContent is ResourceUpdate for a list content: an
+// empty list is an EmptyContent error.
+func ResourceUpdateWithVectorContent[T any](env runtime.Env, resource *ResourceLoadable[T], action ResourceAction, convert func(types.ResourceResponse) (T, error)) runtime.Effects {
+	return resourceUpdate(env, resource, action, convert, true)
+}
+
+func resourceUpdate[T any](env runtime.Env, resource *ResourceLoadable[T], action ResourceAction, convert func(types.ResourceResponse) (T, error), vector bool) runtime.Effects {
+	if action.Request == nil {
+		return runtime.NoneEffects().Unchanged()
+	}
+	request := *action.Request
+	if action.Result == nil {
+		if !resource.Request.Equal(request) || resource.Content == nil {
+			resource.Request = request
+			loading := Loading[T]()
+			resource.Content = &loading
+			return runtime.OneEffect(ResourceFuture(env, request))
+		}
+		return runtime.NoneEffects().Unchanged()
+	}
+	if resource.Request.Equal(request) && resource.Content != nil && resource.Content.IsLoading() {
+		content := resourceContentFromResult(action.Result, convert, vector)
+		resource.Content = &content
+		return runtime.NoneEffects()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+// ResourcesRequest requests the resources of an aggregated request from the addons.
+type ResourcesRequest struct {
+	Request types.AggrRequest
+	Addons  []types.Descriptor
+	// Force a new request instead of reusing an existing response.
+	Force bool
+}
+
+// ResourcesRequestedUpdate plans the aggregated request and requests the
+// resources which are not loaded yet (or all of them when forced).
+func ResourcesRequestedUpdate[T any](env runtime.Env, resources *[]ResourceLoadable[T], request ResourcesRequest) runtime.Effects {
+	planned := request.Request.Plan(request.Addons)
+	next := make([]ResourceLoadable[T], 0, len(planned))
+	effects := []runtime.Effect{}
+	for _, plan := range planned {
+		var existing *ResourceLoadable[T]
+		if !request.Force {
+			for i := range *resources {
+				resource := &(*resources)[i]
+				if resource.Request.Equal(plan.Request) && resource.Content != nil {
+					existing = resource
+					break
+				}
+			}
+		}
+		if existing != nil {
+			next = append(next, *existing)
+			continue
+		}
+		loading := Loading[T]()
+		next = append(next, ResourceLoadable[T]{Request: plan.Request, Content: &loading})
+		effects = append(effects, ResourceFuture(env, plan.Request))
+	}
+	return runtime.ManyEffects(effects...).Unchanged().Join(EqUpdate(resources, next))
+}
+
+// ResourcesResultUpdate loads the result into the loading resource of the request.
+func ResourcesResultUpdate[T any](resources *[]ResourceLoadable[T], action ResourceAction, convert func(types.ResourceResponse) (T, error), vector bool) runtime.Effects {
+	if action.Request == nil || action.Result == nil {
+		return runtime.NoneEffects().Unchanged()
+	}
+	for i := range *resources {
+		resource := &(*resources)[i]
+		if resource.Request.Equal(*action.Request) && resource.Content != nil && resource.Content.IsLoading() {
+			content := resourceContentFromResult(action.Result, convert, vector)
+			resource.Content = &content
+			return runtime.NoneEffects()
+		}
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+// Converters of resource responses.
+
+// MetaItemFromResponse converts a `meta` response.
+func MetaItemFromResponse(response types.ResourceResponse) (types.MetaItem, error) {
+	return response.Meta()
+}
+
+// MetaItemsFromResponse converts a `metasDetailed` response.
+func MetaItemsFromResponse(response types.ResourceResponse) ([]types.MetaItem, error) {
+	return response.MetasDetailed()
+}
+
+// MetaItemPreviewsFromResponse converts a `metas` response.
+func MetaItemPreviewsFromResponse(response types.ResourceResponse) ([]types.MetaItemPreview, error) {
+	return response.Metas()
+}
+
+// StreamsFromResponse converts a `streams` response.
+func StreamsFromResponse(response types.ResourceResponse) ([]types.Stream, error) {
+	return response.Streams()
+}
+
+// SubtitlesFromResponse converts a `subtitles` response.
+func SubtitlesFromResponse(response types.ResourceResponse) ([]types.Subtitles, error) {
+	return response.Subtitles()
+}
+
+// MetaItemsFromCatalogResponse converts a `metasDetailed` (or `metas`) response.
+func MetaItemsFromCatalogResponse(response types.ResourceResponse) ([]types.MetaItem, error) {
+	if response.Variant() == types.ResourceResponseMetasDetailed {
+		return response.MetasDetailed()
+	}
+	return nil, fmt.Errorf("Only MetasDetailed can be converted from ResourceResponse")
+}
diff --git a/models/common/resource_loadable_test.go b/models/common/resource_loadable_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..44f5fc224addc2a3e66c3beffa82c98ee209d2d2
--- /dev/null
+++ b/models/common/resource_loadable_test.go
@@ -0,0 +1,128 @@
+package common_test
+
+import (
+	"testing"
+
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/models/common"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+func metaRequest() types.ResourceRequest {
+	return types.NewResourceRequest("https://transport_url/manifest.json", types.NewResourcePath("meta", "series", "tt1"))
+}
+
+func runResourceLifecycle(t *testing.T, fetch func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError)) common.ResourceLoadable[types.MetaItem] {
+	t.Helper()
+	env := testenv.New()
+	env.FetchFn = fetch
+	request := metaRequest()
+	resource := common.ResourceLoadable[types.MetaItem]{Request: request}
+	effects := common.ResourceUpdate(env, &resource, common.ResourceRequested(&request), common.MetaItemFromResponse)
+	if !effects.HasChanged || len(effects.Effects) != 1 || effects.Effects[0].Future == nil {
+		t.Fatalf("a request should start loading: %+v", effects)
+	}
+	if resource.Content == nil || !resource.Content.IsLoading() {
+		t.Fatal("the resource should be loading")
+	}
+	// requesting the same resource again does nothing
+	if again := common.ResourceUpdate(env, &resource, common.ResourceRequested(&request), common.MetaItemFromResponse); again.HasChanged || len(again.Effects) != 0 {
+		t.Fatal("the same request should not be made twice")
+	}
+	output := effects.Effects[0].Future.Run()
+	if output.Internal == nil || output.Internal.Name != msg.InternalResourceRequestResult {
+		t.Fatalf("unexpected output %+v", output)
+	}
+	if _, ok := output.Internal.Data.(msg.ResourceRequestResult); !ok {
+		t.Fatalf("unexpected data %T", output.Internal.Data)
+	}
+	action, ok := common.ResourceActionFromMsg(output)
+	if !ok {
+		t.Fatal("the output should be a resource result")
+	}
+	result := common.ResourceUpdate(env, &resource, action, common.MetaItemFromResponse)
+	if !result.HasChanged || resource.Content.IsLoading() {
+		t.Fatal("the result should be loaded")
+	}
+	// a late result for the same request is ignored
+	if late := common.ResourceUpdate(env, &resource, action, common.MetaItemFromResponse); late.HasChanged {
+		t.Fatal("the result should be applied only once")
+	}
+	return resource
+}
+
+func TestResourceLoadableFetchSucceeds(t *testing.T) {
+	resource := runResourceLifecycle(t, func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		if url != "https://transport_url/meta/series/tt1.json" {
+			return nil, runtime.EnvErrorFetch("unexpected " + url)
+		}
+		return []byte(`{"meta":{"id":"tt1","type":"series","name":"Series"}}`), nil
+	})
+	meta, ok := resource.Content.Ready()
+	if !ok || meta.Preview.Name != "Series" {
+		t.Fatalf("unexpected content %+v", resource.Content)
+	}
+}
+
+func TestResourceLoadableFetchFails(t *testing.T) {
+	resource := runResourceLifecycle(t, func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		return nil, runtime.EnvErrorFetch("offline")
+	})
+	if !resource.Content.IsErr() {
+		t.Fatalf("unexpected content %+v", resource.Content)
+	}
+	resourceErr, ok := resource.Content.Err().(*common.ResourceError)
+	if !ok || resourceErr.Kind != common.ResourceErrorEnv || resourceErr.Env.Code != runtime.EnvErrorCodeFetch {
+		t.Fatalf("unexpected error %+v", resource.Content.Err())
+	}
+	data, _ := types.MarshalJSON(resource)
+	expected := `{"request":{"base":"https://transport_url/manifest.json","path":{"resource":"meta","type":"series","id":"tt1","extra":[]}},"content":{"type":"Err","content":{"type":"Env","content":{"code":1,"message":"Failed to fetch: offline"}}}}`
+	if string(data) != expected {
+		t.Fatalf("unexpected serialization %s", data)
+	}
+}
+
+func TestResourceLoadableUnexpectedResponse(t *testing.T) {
+	resource := runResourceLifecycle(t, func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		return []byte(`{"streams":[]}`), nil
+	})
+	resourceErr, ok := resource.Content.Err().(*common.ResourceError)
+	if !ok || resourceErr.Kind != common.ResourceErrorUnexpectedResponse {
+		t.Fatalf("unexpected error %+v", resource.Content.Err())
+	}
+}
+
+func TestVectorContentEmpty(t *testing.T) {
+	env := testenv.New()
+	request := types.NewResourceRequest("https://transport_url/manifest.json", types.NewResourcePath("stream", "series", "tt1"))
+	resource := common.ResourceLoadable[[]types.Stream]{Request: request}
+	common.ResourceUpdateWithVectorContent(env, &resource, common.ResourceRequested(&request), common.StreamsFromResponse)
+	response := types.NewResourceResponse(types.ResourceResponseStreams, []types.Stream{})
+	common.ResourceUpdateWithVectorContent(env, &resource, common.ResourceRequestResult(&request, common.ResourceResult{Response: &response}), common.StreamsFromResponse)
+	resourceErr, ok := resource.Content.Err().(*common.ResourceError)
+	if !ok || resourceErr.Kind != common.ResourceErrorEmptyContent {
+		t.Fatalf("an empty list should be an EmptyContent error: %+v", resource.Content)
+	}
+}
+
+func TestLoadableSerialization(t *testing.T) {
+	cases := map[string]common.Loadable[int]{
+		`{"type":"Loading"}`:           common.Loading[int](),
+		`{"type":"Ready","content":1}`: common.Ready(1),
+		`{"type":"Err","content":{"code":1001,"message":"Other error: x"}}`: common.Err[int](runtime.EnvErrorOther("x")),
+	}
+	for expected, loadable := range cases {
+		if data, _ := types.MarshalJSON(loadable); string(data) != expected {
+			t.Fatalf("got %s, want %s", data, expected)
+		}
+	}
+	value := 1
+	if effects := common.EqUpdate(&value, 1); effects.HasChanged {
+		t.Fatal("equal values should be unchanged")
+	}
+	if effects := common.EqUpdate(&value, 2); !effects.HasChanged || value != 2 {
+		t.Fatal("different values should be changed")
+	}
+}
