diff --git a/deep_links/reference_test.go b/deep_links/reference_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..34d199ce201f539addddf7f489bac9ec60807c29
--- /dev/null
+++ b/deep_links/reference_test.go
@@ -0,0 +1,140 @@
+package deeplinks
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+
+	"github.com/stremio/stremio-core/types"
+)
+
+// referenceCase is a case generated with the rust implementation: the
+// arguments of the deep links constructor and the expected serialization.
+type referenceCase struct {
+	Name     string                     `json:"name"`
+	Kind     string                     `json:"kind"`
+	Args     map[string]json.RawMessage `json:"args"`
+	Expected string                     `json:"expected"`
+}
+
+func decodeArg[T any](t *testing.T, c referenceCase, key string) T {
+	t.Helper()
+	var value T
+	raw, ok := c.Args[key]
+	if !ok {
+		t.Fatalf("%s %s: missing argument %q", c.Kind, c.Name, key)
+	}
+	if err := json.Unmarshal(raw, &value); err != nil {
+		t.Fatalf("%s %s: decoding argument %q (%s) failed: %v", c.Kind, c.Name, key, raw, err)
+	}
+	return value
+}
+
+func referenceSettings(t *testing.T, c referenceCase) types.Settings {
+	settings := types.NewSettings()
+	settings.PlayerType = decodeArg[*string](t, c, "player_type")
+	settings.StreamingServerURL = decodeArg[string](t, c, "settings_server")
+	return settings
+}
+
+func referenceOutput(t *testing.T, c referenceCase) any {
+	t.Helper()
+	switch c.Kind {
+	case "external_player":
+		return NewExternalPlayerLink(decodeArg[types.Stream](t, c, "stream"), decodeArg[*string](t, c, "server"), referenceSettings(t, c))
+	case "stream":
+		return NewStreamDeepLinks(decodeArg[types.Stream](t, c, "stream"), decodeArg[*string](t, c, "server"), referenceSettings(t, c))
+	case "stream_converted":
+		// the converted stream is created with types.Stream.Convert, as a
+		// converted stream can not be deserialized back to the same source
+		server := decodeArg[*string](t, c, "server")
+		converted, err := decodeArg[types.Stream](t, c, "stream").Convert(server)
+		if err != nil {
+			t.Fatalf("%s %s: conversion failed: %v", c.Kind, c.Name, err)
+		}
+		if actual := string(types.MustMarshalJSON(converted)); actual != decodeArg[string](t, c, "converted") {
+			t.Errorf("%s %s: converted stream:\n got: %s\nwant: %s", c.Kind, c.Name, actual, decodeArg[string](t, c, "converted"))
+		}
+		links := NewConvertedStreamDeepLinks(converted, server, referenceSettings(t, c))
+		if external := NewExternalPlayerLinkFromConverted(converted, server, referenceSettings(t, c)); !types.Equal(external, links.ExternalPlayer) {
+			t.Errorf("%s %s: external player link %+v != %+v", c.Kind, c.Name, external, links.ExternalPlayer)
+		}
+		return links
+	case "stream_requests":
+		return NewStreamDeepLinksWithRequests(decodeArg[types.Stream](t, c, "stream"),
+			decodeArg[types.ResourceRequest](t, c, "stream_request"), decodeArg[types.ResourceRequest](t, c, "meta_request"),
+			decodeArg[*string](t, c, "server"), referenceSettings(t, c))
+	case "library_item":
+		return NewLibraryItemDeepLinks(decodeArg[types.LibraryItem](t, c, "item"), decodeArg[*types.StreamsItem](t, c, "streams_item"),
+			decodeArg[*string](t, c, "server"), referenceSettings(t, c))
+	case "meta_item":
+		preview := decodeArg[types.MetaItemPreview](t, c, "preview")
+		request := decodeArg[types.ResourceRequest](t, c, "request")
+		links := NewMetaItemDeepLinksFromPreview(preview, request)
+		if fromItem := NewMetaItemDeepLinksFromMetaItem(types.MetaItem{Preview: preview}, request); !types.Equal(links, fromItem) {
+			t.Errorf("meta_item %s: from preview %+v != from meta item %+v", c.Name, links, fromItem)
+		}
+		return links
+	case "meta_item_path":
+		return NewMetaItemDeepLinks(decodeArg[string](t, c, "type"), decodeArg[string](t, c, "id"))
+	case "video":
+		return NewVideoDeepLinks(decodeArg[types.Video](t, c, "video"), decodeArg[types.ResourceRequest](t, c, "request"),
+			decodeArg[*string](t, c, "server"), referenceSettings(t, c))
+	case "video_requests":
+		return NewVideoDeepLinksWithRequests(decodeArg[types.Video](t, c, "video"), decodeArg[types.ResourceRequest](t, c, "stream_request"),
+			decodeArg[types.ResourceRequest](t, c, "meta_request"), decodeArg[*string](t, c, "server"), referenceSettings(t, c))
+	case "discover":
+		return NewDiscoverDeepLinks(decodeArg[types.ResourceRequest](t, c, "request"))
+	case "addons":
+		return NewAddonsDeepLinks(decodeArg[types.ResourceRequest](t, c, "request"))
+	case "installed_addons":
+		return NewInstalledAddonsDeepLinks(decodeArg[*string](t, c, "type"))
+	case "library":
+		sort := ""
+		if value := decodeArg[*string](t, c, "sort"); value != nil {
+			sort = *value
+		}
+		return NewLibraryDeepLinks(decodeArg[string](t, c, "root"), decodeArg[*string](t, c, "type"), sort)
+	case "calendar":
+		return NewCalendarDeepLinks(decodeArg[int](t, c, "year"), decodeArg[int](t, c, "month"))
+	case "calendar_item":
+		return NewCalendarItemDeepLinks(decodeArg[types.MetaItem](t, c, "meta_item"), decodeArg[types.Video](t, c, "video"))
+	case "search_history":
+		return NewSearchHistoryItemDeepLinks(decodeArg[string](t, c, "query"))
+	case "local_search":
+		return NewLocalSearchItemDeepLinks(decodeArg[string](t, c, "query"))
+	case "error":
+		return NewErrorLinkFromMessage(decodeArg[string](t, c, "message")).String()
+	}
+	t.Fatalf("unknown reference case kind %q", c.Kind)
+	return nil
+}
+
+// TestReference compares the deep links with the ones generated by the rust
+// implementation for the same arguments (testdata/reference.json). The
+// reference file was generated with a small program which deserializes the
+// arguments with stremio-core, calls the respective `From` implementation of
+// the deep links and serializes the result with `serde_json::to_string`.
+func TestReference(t *testing.T) {
+	data, err := os.ReadFile("testdata/reference.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var cases []referenceCase
+	if err := json.Unmarshal(data, &cases); err != nil {
+		t.Fatal(err)
+	}
+	if len(cases) == 0 {
+		t.Fatal("no reference cases")
+	}
+	for _, c := range cases {
+		output := referenceOutput(t, c)
+		actual, err := types.MarshalJSON(output)
+		if err != nil {
+			t.Fatalf("%s %s: serialization failed: %v", c.Kind, c.Name, err)
+		}
+		if string(actual) != c.Expected {
+			t.Errorf("%s %s:\n got: %s\nwant: %s", c.Kind, c.Name, actual, c.Expected)
+		}
+	}
+}
