+func TestWatchedBitFieldDeserializeEmpty(t *testing.T) {
+	watched, err := WatchedBitFieldConstructAndResize("undefined:1:eJwDAAAAAAE=", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if watched.BitField.Length != 0 || len(watched.BitField.Values) != 0 || len(watched.VideoIDs) != 0 {
+		t.Errorf("got %+v, want an empty bit field without videos", watched)
+	}
+}
