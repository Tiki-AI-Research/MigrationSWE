+// Port of src/unit_tests/ctx/update_settings.rs
+
+// authSettingsUpdatedArgs are the args of the `SettingsUpdated` event.
+type authSettingsUpdatedArgs struct {
+	Settings types.Settings `json:"settings"`
+}
+
+// authTestSettings are `Settings { subtitles_language: Some("bg"), subtitles_size: 150, ..Settings::default() }`.
+func authTestSettings() types.Settings {
+	settings := types.NewSettings()
+	settings.SubtitlesLanguage = strPtr("bg")
+	settings.SubtitlesSize = 150
+	return settings
+}
+
+func TestActionCtxUpdateSettings(t *testing.T) {
+	settings := authTestSettings()
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env)
+	h := newHarness(t, env, defaultCtx(env))
+	h.dispatchCtx(msg.ActionCtxUpdateSettings, settings)
+
+	assertEqual(t, h.ctx().Profile.Settings, settings, "Settings updated successfully in memory")
+	stored, ok := storageValue[types.Profile](t, env, stremiocore.PROFILE_STORAGE_KEY)
+	if !ok {
+		t.Errorf("Settings updated successfully in storage: missing key")
+	}
+	assertEqual(t, stored.Settings, settings, "Settings updated successfully in storage")
+	if len(env.Requests) != 0 {
+		t.Errorf("No requests have been sent: %s", describeRequests(env.Requests))
+	}
+	assertEqual(t, h.coreEventNames(), []string{
+		msg.EventSettingsUpdated,
+		msg.EventProfilePushedToStorage,
+	}, "events")
+	assertEvent(t, h.findEvent(msg.EventSettingsUpdated), msg.EventSettingsUpdated,
+		authSettingsUpdatedArgs{settings}, "SettingsUpdated")
+	assertEvent(t, h.findEvent(msg.EventProfilePushedToStorage), msg.EventProfilePushedToStorage,
+		`{"uid":null}`, "ProfilePushedToStorage")
+	assertEqual(t, h.newStates(), [][]string{{"ctx"}}, "NewState")
