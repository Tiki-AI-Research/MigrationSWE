+
+func (r SkipGapsResponse) MarshalJSON() ([]byte, error) {
+	gaps := map[string]SkipGaps{}
+	for duration, value := range r.Gaps {
+		gaps[strconv.FormatUint(duration, 10)] = value
+	}
+	return MarshalJSON(struct {
+		Accuracy string              `json:"accuracy"`
+		Gaps     map[string]SkipGaps `json:"gaps"`
+	}{r.Accuracy, gaps})
+}
+
+func (r *SkipGapsResponse) UnmarshalJSON(data []byte) error {
+	var wire struct {
+		Accuracy *string             `json:"accuracy"`
+		Gaps     map[string]SkipGaps `json:"gaps"`
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+	if wire.Accuracy == nil || wire.Gaps == nil {
+		return errors.New("missing field of SkipGapsResponse")
+	}
+	response := SkipGapsResponse{Accuracy: *wire.Accuracy, Gaps: map[uint64]SkipGaps{}}
+	for key, value := range wire.Gaps {
+		duration, err := strconv.ParseUint(key, 10, 64)
+		if err != nil {
+			return err
+		}
+		value.SeekHistory = nonNilSlice(value.SeekHistory)
+		response.Gaps[duration] = value
+	}
+	*r = response
+	return nil
+}
diff --git a/types/lzstring.go b/types/lzstring.go
new file mode 100644
index 0000000000000000000000000000000000000000..cfeca552a713d690f66e053623c04de3a17e2c27
--- /dev/null
+++ b/types/lzstring.go
@@ -0,0 +1,163 @@
+package types
+
+import "unicode/utf16"
+
+// This file contains a port of the Rust crate lz-str 0.2.1
+// (`compress_to_encoded_uri_component`), which itself is a port of the
+// JavaScript lz-string library.
+
+const lzURIKey = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+-$"
+
+const (
+	lzU8Code        = 0
+	lzU16Code       = 1
+	lzCloseCode     = 2
+	lzStartCodeBits = 2
+	lzNumBaseCodes  = 3
+)
+
+// LzCompressToEncodedURIComponent compresses the string with lz-string
+// (`compressToEncodedURIComponent`). The string is processed as UTF-16 code
+// units, like Rust's `str::encode_utf16`.
+func LzCompressToEncodedURIComponent(input string) string {
+	data := utf16.Encode([]rune(input))
+	out := lzCompressInternal(data, 6, func(n uint16) byte { return lzURIKey[n] })
+	return string(out)
+}
+
+// lzCompressContext mirrors lz-str's CompressContext. The dictionary of
+// words (sequences of UTF-16 code units) is stored as a trie: every word
+// is a known word extended by one code unit, so the words are identified by
+// their code and the trie edges are keyed by (parent code, code unit), with
+// the root having code 0.
+type lzCompressContext struct {
+	dictionary         map[uint64]uint32
+	dictionaryLen      int
+	dictionaryToCreate map[uint16]struct{}
+
+	// The current word w: its code, first code unit and whether it is empty.
+	wCode  uint32
+	wFirst uint16
+	wEmpty bool
+
+	enlargeIn   uint64
+	output      []byte
+	bitBuffer   uint16
+	numBits     uint8
+	bitPosition uint8
+	bitsPerChar uint8
+	toChar      func(uint16) byte
+}
+
+func lzKey(parent uint32, c uint16) uint64 {
+	return uint64(parent)<<16 | uint64(c)
+}
+
+func lzCompressInternal(data []uint16, bitsPerChar uint8, toChar func(uint16) byte) []byte {
+	ctx := &lzCompressContext{
+		dictionary:         make(map[uint64]uint32),
+		dictionaryToCreate: make(map[uint16]struct{}),
+		wEmpty:             true,
+		enlargeIn:          2,
+		output:             make([]byte, 0, len(data)>>1),
+		numBits:            lzStartCodeBits,
+		bitsPerChar:        bitsPerChar,
+		toChar:             toChar,
+	}
+	for _, c := range data {
+		ctx.writeU16(c)
+	}
+	return ctx.finish()
+}
+
+func (ctx *lzCompressContext) produceW() {
+	if _, ok := ctx.dictionaryToCreate[ctx.wFirst]; ok {
+		delete(ctx.dictionaryToCreate, ctx.wFirst)
+		if ctx.wFirst < 256 {
+			ctx.writeBits(ctx.numBits, lzU8Code)
+			ctx.writeBits(8, uint32(ctx.wFirst))
+		} else {
+			ctx.writeBits(ctx.numBits, lzU16Code)
+			ctx.writeBits(16, uint32(ctx.wFirst))
+		}
+		ctx.decrementEnlargeIn()
+	} else {
+		ctx.writeBits(ctx.numBits, ctx.wCode)
+	}
+	ctx.decrementEnlargeIn()
+}
+
+func (ctx *lzCompressContext) writeBit(bit bool) {
+	ctx.bitBuffer <<= 1
+	if bit {
+		ctx.bitBuffer |= 1
+	}
+	ctx.bitPosition++
+	if ctx.bitPosition == ctx.bitsPerChar {
+		ctx.bitPosition = 0
+		ctx.output = append(ctx.output, ctx.toChar(ctx.bitBuffer))
+		ctx.bitBuffer = 0
+	}
+}
+
+func (ctx *lzCompressContext) writeBits(n uint8, value uint32) {
+	for i := uint8(0); i < n; i++ {
+		ctx.writeBit(value&1 == 1)
+		value >>= 1
+	}
+}
+
+func (ctx *lzCompressContext) decrementEnlargeIn() {
+	ctx.enlargeIn--
+	if ctx.enlargeIn == 0 {
+		ctx.enlargeIn = 1 << ctx.numBits
+		ctx.numBits++
+	}
+}
+
+func (ctx *lzCompressContext) writeU16(c uint16) {
+	cKey := lzKey(0, c)
+	if _, ok := ctx.dictionary[cKey]; !ok {
+		ctx.dictionary[cKey] = uint32(ctx.dictionaryLen + lzNumBaseCodes)
+		ctx.dictionaryLen++
+		ctx.dictionaryToCreate[c] = struct{}{}
+	}
+
+	if ctx.wEmpty {
+		// wc = c, which is always in the dictionary: w = wc.
+		ctx.wCode = ctx.dictionary[cKey]
+		ctx.wFirst = c
+		ctx.wEmpty = false
+		return
+	}
+
+	// wc = w + c.
+	wcKey := lzKey(ctx.wCode, c)
+	if code, ok := ctx.dictionary[wcKey]; ok {
+		// w = wc.
+		ctx.wCode = code
+		return
+	}
+	// Add wc to the dictionary.
+	ctx.dictionary[wcKey] = uint32(ctx.dictionaryLen + lzNumBaseCodes)
+	ctx.dictionaryLen++
+	ctx.produceW()
+	// w = c.
+	ctx.wCode = ctx.dictionary[cKey]
+	ctx.wFirst = c
+}
+
+func (ctx *lzCompressContext) finish() []byte {
+	// Output the code for w.
+	if !ctx.wEmpty {
+		ctx.produceW()
+	}
+	// Mark the end of the stream.
+	ctx.writeBits(ctx.numBits, lzCloseCode)
+	// Flush the last char.
+	strLen := len(ctx.output)
+	for len(ctx.output) == strLen {
+		ctx.writeBit(false)
+	}
+	return ctx.output
+}
