+// YouTubeStream returns a YouTube stream for `yt_id:{channel}:{video}` ids.
+func YouTubeStream(videoID string) *Stream {
+	if !strings.HasPrefix(videoID, stremiocore.YOUTUBE_ADDON_ID_PREFIX) {
+		return nil
+	}
+	parts := strings.Split(videoID, ":")
+	if len(parts) < 3 {
+		return nil
+	}
+	return &Stream{Source: StreamSource{Kind: StreamSourceYouTube, YtID: parts[2]}}
+}
+
+// IsSourceMatch reports whether both streams have the same source.
+func (s Stream) IsSourceMatch(other Stream) bool {
+	return Equal(s.Source, other.Source)
+}
+
+// IsBingeMatch reports whether both streams have the same binge group.
+func (s Stream) IsBingeMatch(other Stream) bool {
+	return s.BehaviorHints.BingeGroup != nil && other.BehaviorHints.BingeGroup != nil &&
+		*s.BehaviorHints.BingeGroup == *other.BehaviorHints.BingeGroup
+}
+
+// normalizedURLs returns a copy of the source with the urls in their
+// serialized (WHATWG) form, as the rust `Url` fields are serialized.
+func (s StreamSource) normalizedURLs() StreamSource {
+	s.URL = normalizeIfURL(s.URL)
+	s.PlayerFrameURL = normalizeIfURL(s.PlayerFrameURL)
+	s.ExternalURL = normalizeOptional(s.ExternalURL)
+	s.AndroidTvURL = normalizeOptional(s.AndroidTvURL)
+	s.NzbURL = normalizeOptional(s.NzbURL)
+	if s.Urls != nil {
+		urls := make([]ArchiveURL, len(s.Urls))
+		for i, archiveURL := range s.Urls {
+			urls[i] = ArchiveURL{URL: normalizeIfURL(archiveURL.URL), Bytes: archiveURL.Bytes}
+		}
+		s.Urls = urls
+	}
+	s.NzbUrls = normalizeAll(s.NzbUrls)
+	s.Servers = normalizeAll(s.Servers)
+	return s
+}
+
+func normalizeIfURL(value string) string {
+	if value == "" {
+		return value
+	}
+	return NormalizeURL(value)
+}
+
+func normalizeOptional(value *string) *string {
+	if value == nil {
+		return nil
+	}
+	normalized := NormalizeURL(*value)
+	return &normalized
+}
+
+func normalizeAll(values []string) []string {
+	if values == nil {
+		return nil
+	}
+	normalized := make([]string, len(values))
+	for i, value := range values {
+		normalized[i] = NormalizeURL(value)
+	}
+	return normalized
+}
+
+func normalizedSubtitles(subtitles []Subtitles) []Subtitles {
+	if subtitles == nil {
+		return nil
+	}
+	normalized := make([]Subtitles, len(subtitles))
+	for i, s := range subtitles {
+		s.URL = NormalizeURL(s.URL)
+		s.Fonts = normalizeAll(s.Fonts)
+		normalized[i] = s
+	}
+	return normalized
+}
+
+// Encode serializes the stream, compresses it with zlib (no compression)
+// and encodes it with base64, as used by the player deep links.
+func (s Stream) Encode() (string, error) {
+	s.Source = s.Source.normalizedURLs()
+	s.Subtitles = normalizedSubtitles(s.Subtitles)
+	data, err := MarshalJSON(s)
+	if err != nil {
+		return "", err
+	}
+	return base64.StdEncoding.EncodeToString(ZlibStore(data)), nil
+}
+
+// DecodeStream decodes a stream encoded with Stream.Encode.
+func DecodeStream(encoded string) (Stream, error) {
+	var stream Stream
+	compressed, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return stream, err
+	}
+	reader, err := zlib.NewReader(bytes.NewReader(compressed))
+	if err != nil {
+		return stream, err
+	}
+	data, err := io.ReadAll(reader)
+	if err != nil {
+		return stream, err
+	}
+	err = json.Unmarshal(data, &stream)
+	return stream, err
+}
