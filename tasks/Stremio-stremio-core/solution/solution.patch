+}
+
+func TestActionCtxPullAddonsFromAPI(t *testing.T) {
+	if len(types.OFFICIAL_ADDONS) == 0 {
+		t.Fatal("OFFICIAL_ADDONS is empty")
+	}
+	officialAddon := types.Clone(types.OFFICIAL_ADDONS[0])
+	env := newTestEnv(time.Time{})
+	setRoutes(t, env)
+	manifest := types.Clone(officialAddon.Manifest)
