+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// TraktAddonURL returns the transport url of the Trakt addon of the user.
+func TraktAddonURL(uid string) string {
+	return "https://www.strem.io/trakt/addon/" + types.EncodeURIComponent(uid) + "/manifest.json"
+}
+
+func updateTraktAddon(env runtime.Env, traktAddon **common.DescriptorLoadable, profile *types.Profile, status *CtxStatus, m *msg.Msg) runtime.Effects {
+	if m.IsInternal(msg.InternalLogout) {
+		return clearTraktAddon(traktAddon)
+	}
+	if isCtxAction(m, msg.ActionCtxInstallTraktAddon) {
+		return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalInstallTraktAddon, nil)))
+	}
+	if m.IsInternal(msg.InternalInstallTraktAddon) {
+		uid := profile.UID()
+		if uid == nil {
+			return errorEffects(NewOtherError(OtherErrorUserNotLoggedIn), msg.UIDEvent(msg.EventTraktAddonFetched, uid))
+		}
+		return common.DescriptorRequested(env, traktAddon, TraktAddonURL(*uid))
+	}
+	if m.IsInternal(msg.InternalUninstallTraktAddon) {
+		// make sure we uninstall the addon from the user profile too!
+		traktUninstallEffects := runtime.NoneEffects().Unchanged()
+		if uid := profile.UID(); uid != nil {
+			if position := addonPosition(profile.Addons, TraktAddonURL(*uid)); position >= 0 {
+				addon := profile.Addons[position]
+				traktUninstallEffects = runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalUninstallAddon, addon)))
+			}
+		}
+		return traktUninstallEffects.Join(clearTraktAddon(traktAddon))
+	}
+	if result, ok := InternalData[common.ManifestRequestResult](m, msg.InternalManifestRequestResult); ok {
+		traktAddonEffects := common.DescriptorManifestResult(traktAddon, result)
+		traktAddonEventsEffects := runtime.NoneEffects().Unchanged()
+		if current := *traktAddon; current != nil && traktAddonEffects.HasChanged {
+			fetchedEvent := msg.UIDEvent(msg.EventTraktAddonFetched, profile.UID())
+			if addon, ready := current.Content.Ready(); ready {
+				traktAddonEventsEffects = runtime.MsgsEffects(
+					msg.EventMsg(fetchedEvent),
+					msg.InternalMsg(msg.NewInternal(msg.InternalInstallAddon, addon)),
+				).Unchanged()
+			} else if err := current.Content.Err(); err != nil {
+				envErr, isEnvErr := err.(*runtime.EnvError)
+				if !isEnvErr {
+					envErr = runtime.EnvErrorOther(err.Error())
+				}
+				traktAddonEventsEffects = errorEffects(NewEnvError(envErr), fetchedEvent)
+			}
+		}
+		*traktAddon = nil
+		return traktAddonEffects.Join(traktAddonEventsEffects)
+	}
+	if result, ok := InternalCtxAuthResultData(m); ok {
+		if status.IsLoading(result.AuthRequest) && result.Response != nil {
+			// clear the trakt_addon from Ctx when a new Auth request has been initialised
+			*traktAddon = nil
+		}
+		return runtime.NoneEffects().Unchanged()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
+
+// clearTraktAddon resets the trakt addon (rust `eq_update(trakt_addon, None)`).
+func clearTraktAddon(traktAddon **common.DescriptorLoadable) runtime.Effects {
+	if *traktAddon != nil {
+		*traktAddon = nil
+		return runtime.NoneEffects()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
