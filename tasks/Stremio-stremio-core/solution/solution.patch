+// SkipGapsRequest retrieves the skip gaps (intro and outro) of a video.
+type SkipGapsRequest struct {
+	// AuthKey of the user; this request requires a premium account.
+	AuthKey        AuthKey
+	OsHash         string
+	ItemID         string
+	SeriesInfo     SeriesInfo
+	StreamNameHash string
