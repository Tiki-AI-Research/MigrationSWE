index 0000000000000000000000000000000000000000..9c6428a90049e3d3ca92baf220252f9b655a4f37
--- /dev/null
+++ b/models/common/eq_update.go
@@ -0,0 +1,18 @@
+// Package common contains the building blocks shared by the models:
+// loadables, resource loadables and the equality update.
+package common
+
+import (
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/types"
+)
+
+// EqUpdate sets the value to next if they differ and reports the model as
+// changed only in that case.
+func EqUpdate[T any](value *T, next T) runtime.Effects {
+	if !types.Equal(*value, next) {
+		*value = next
+		return runtime.NoneEffects()
+	}
+	return runtime.NoneEffects().Unchanged()
+}
