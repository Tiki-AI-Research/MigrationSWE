+}
+
+func (b *ServerUrlsBucket) findKey(url string) (string, bool) {
+	if _, ok := b.Items[url]; ok {
+		return url, true
+	}
+	normalized := NormalizeURL(url)
+	for key := range b.Items {
+		if NormalizeURL(key) == normalized {
+			return key, true
+		}
+	}
+	return "", false
+}
+
+// AddURL adds (or refreshes) a url.
+func (b *ServerUrlsBucket) AddURL(url string, now time.Time) {
+	if b.Items == nil {
+		b.Items = map[string]time.Time{}
+	}
+	if key, ok := b.findKey(url); ok {
+		b.Items[key] = now
+		return
+	}
+	b.Items[url] = now
+}
+
+// DeleteURL removes a url; the default streaming server url is never removed.
+func (b *ServerUrlsBucket) DeleteURL(url string) {
+	if NormalizeURL(url) == stremiocore.STREAMING_SERVER_URL {
+		return
+	}
+	if key, ok := b.findKey(url); ok {
+		delete(b.Items, key)
+	}
+}
