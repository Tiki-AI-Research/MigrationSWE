+func TestLzCompressToEncodedURIComponentVectors(t *testing.T) {
+	var inputs []string
+	for i := 0; i < 150; i++ {
+		inputs = append(inputs, lzTestString(5, i))
+	}
+	inputs = append(inputs, `{"urls":[["https://example.com/a.rar",10]],"fileIdx":1}`, "", "a")
+	if len(inputs) != len(lzVectorExpectations) {
+		t.Fatalf("got %d inputs, want %d", len(inputs), len(lzVectorExpectations))
+	}
+	for i, input := range inputs {
+		want := lzVectorExpectations[i]
+		if len(input) != want.inputLen {
+			t.Fatalf("vector %d: input length %d, want %d", i, len(input), want.inputLen)
+		}
+		got := LzCompressToEncodedURIComponent(input)
+		if len(got) > 40 {
+			sum := sha256.Sum256([]byte(got))
+			got = hex.EncodeToString(sum[:8])
+		}
+		if got != want.want {
+			t.Errorf("vector %d (len %d): got %s, want %s", i, len(input), got, want.want)
+		}
+	}
+}
+
+var lzTestAlphabets = [][]rune{
+	[]rune("ab"),
+	[]rune("abcdefghijklmnopqrstuvwxyz"),
+	[]rune("{}[]\":,0123456789abcdefhttps://example.com/"),
+	[]rune("αβγδεжщюяÀÉÎõü"),
+	[]rune("日本語中文한국어"),
+	[]rune("😀🎬📺🇺🇸𝄞"),
+	[]rune("aé日😀\u0000\u007f\u0080ÿĀ￿"),
+}
+
+// lzTestString deterministically generates the i-th lz test string.
+func lzTestString(seed uint64, i int) string {
+	r := &zlTestRand{state: seed*0x100000001B3 + uint64(i)}
+	var n int
+	switch r.intn(4) {
+	case 0:
+		n = r.intn(10)
+	case 1:
+		n = r.intn(100)
+	case 2:
+		n = r.intn(2000)
+	default:
+		n = r.intn(20000)
+	}
+	var sb strings.Builder
+	switch kind := r.intn(5); kind {
+	case 0, 1, 2:
+		alpha := lzTestAlphabets[r.intn(len(lzTestAlphabets))]
+		for j := 0; j < n; j++ {
+			sb.WriteRune(alpha[r.intn(len(alpha))])
+		}
+	case 3:
+		for sb.Len() < n {
+			sb.WriteString(zlTestWords[r.intn(len(zlTestWords))])
+		}
+	default:
+		for j := 0; j < n; j++ {
+			c := rune(r.intn(0x110000))
+			if !utf8.ValidRune(c) {
+				c = rune(r.intn(0xD800))
+			}
+			sb.WriteRune(c)
+		}
+	}
+	return sb.String()
+}
