+func decodePlayerTimeArgs(action *msg.Action) (playerTimeArgs, error) {
+	var args playerTimeArgs
+	object, err := decodeObject(action.Args, "struct variant")
+	if err != nil {
+		return args, err
+	}
+	if err := decodeRequiredField(object, "time", &args.Time); err != nil {
+		return args, err
+	}
+	if err := decodeRequiredField(object, "duration", &args.Duration); err != nil {
+		return args, err
+	}
+	if err := decodeRequiredField(object, "device", &args.Device); err != nil {
+		return args, err
+	}
+	return args, nil
+}
+
+// decodeStructVariantField decodes the single required field of a struct variant.
+func decodeStructVariantField(action *msg.Action, key string, value any) error {
+	object, err := decodeObject(action.Args, "struct variant")
+	if err != nil {
+		return err
+	}
+	return decodeRequiredField(object, key, value)
+}
+
+// decodeTupleVariant decodes a tuple variant of two fields.
+func decodeTupleVariant(action *msg.Action, first, second any) error {
+	var tuple []json.RawMessage
+	if err := json.Unmarshal(action.Args, &tuple); err != nil {
+		return err
+	}
+	if len(tuple) != 2 {
+		return fmt.Errorf("invalid length %d, expected tuple variant with 2 elements", len(tuple))
+	}
+	for i, value := range []any{first, second} {
+		if isNullJSON(tuple[i]) {
+			return errors.New("invalid type: null")
+		}
+		if err := json.Unmarshal(tuple[i], value); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+//
+// Update
+//
+
+func unchangedEffects() runtime.Effects {
+	return runtime.NoneEffects().Unchanged()
+}
+
+// Update handles the message with the Ctx.
+func (p *Player) Update(env runtime.Env, m *msg.Msg, c *ctx.Ctx) runtime.Effects {
+	if m == nil || c == nil {
+		return unchangedEffects()
+	}
+	switch m.ResolvedKind() {
+	case msg.KindAction:
+		if m.Action == nil {
+			return unchangedEffects()
+		}
+		switch m.Action.Action {
+		case msg.ActionNameLoad:
+			raw, ok := m.LoadModel(msg.ModelPlayer)
+			if !ok {
+				return unchangedEffects()
+			}
+			var selected Selected
+			if err := json.Unmarshal(raw, &selected); err != nil {
+				return unchangedEffects()
+			}
+			return p.load(env, selected, c)
+		case msg.ActionNameUnload:
+			return p.unload(env)
+		case msg.ActionNamePlayer:
+			action := m.NestedAction(msg.ActionNamePlayer)
+			if action == nil {
+				return unchangedEffects()
+			}
+			return p.updateAction(env, action, c)
+		}
+	case msg.KindInternal:
+		if m.Internal == nil {
+			return unchangedEffects()
+		}
+		switch m.Internal.Name {
+		case msg.InternalLibraryChanged:
+			return p.libraryChanged(env, c)
+		case msg.InternalStreamsChanged:
+			return p.streamsChanged(c)
+		case msg.InternalResourceRequestResult:
+			if p.Selected == nil {
+				return unchangedEffects()
+			}
+			action, ok := common.ResourceActionFromMsg(m)
+			if !ok || action.Request == nil || action.Result == nil {
+				return unchangedEffects()
+			}
+			return p.resourceRequestResult(env, action, c)
+		case msg.InternalSkipGapsResult:
+			result, ok := ctx.InternalData[SkipGapsResult](m, msg.InternalSkipGapsResult)
+			if !ok {
+				return unchangedEffects()
+			}
+			return p.skipGapsResult(env, result, c)
+		case msg.InternalProfileChanged:
+			if p.AnalyticsContext != nil {
+				p.AnalyticsContext.HasTrakt = c.Profile.HasTrakt(env.Now())
+			}
+			return unchangedEffects()
+		}
+	}
+	return unchangedEffects()
+}
+
+func (p *Player) updateAction(env runtime.Env, action *msg.Action, c *ctx.Ctx) runtime.Effects {
+	switch action.Action {
+	case msg.ActionPlayerVideoParamsChanged:
+		object, err := decodeObject(action.Args, "struct variant")
+		if err != nil {
+			return unchangedEffects()
+		}
+		videoParams, err := decodeOptionalField[VideoParams](object, "videoParams")
+		if err != nil {
+			return unchangedEffects()
+		}
+		return p.videoParamsChanged(env, videoParams, c)
+	case msg.ActionPlayerStreamStateChanged:
+		var state types.StreamItemState
+		if decodeStructVariantField(action, "state", &state) != nil {
+			return unchangedEffects()
+		}
+		var streamRequest, metaRequest *types.ResourceRequest
+		if p.Selected != nil {
+			streamRequest = cloneResourceRequest(p.Selected.StreamRequest)
+			metaRequest = cloneResourceRequest(p.Selected.MetaRequest)
+		}
+		return runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalStreamStateChanged, ctx.StreamStateChanged{
+			State:         state,
+			StreamRequest: streamRequest,
+			MetaRequest:   metaRequest,
+		}))).Unchanged()
+	case msg.ActionPlayerSubtitlePreferenceChanged:
+		var preference types.SubtitlePreference
+		if decodeStructVariantField(action, "preference", &preference) != nil {
+			return unchangedEffects()
+		}
+		if p.Selected == nil {
+			return unchangedEffects()
+		}
+		return common.EqUpdate(&p.SubtitlePreference, &preference)
+	case msg.ActionPlayerVideoScaleChanged:
+		var videoScale types.VideoScale
+		if decodeStructVariantField(action, "videoScale", &videoScale) != nil {
+			return unchangedEffects()
+		}
+		if p.Selected == nil {
+			return unchangedEffects()
+		}
+		return common.EqUpdate(&p.VideoScale, &videoScale)
+	case msg.ActionPlayerSeek:
+		args, err := decodePlayerTimeArgs(action)
+		if err != nil {
+			return unchangedEffects()
+		}
+		return p.seek(env, args, c)
+	case msg.ActionPlayerTimeChanged:
+		args, err := decodePlayerTimeArgs(action)
+		if err != nil {
+			return unchangedEffects()
+		}
+		return p.timeChanged(env, args, c)
+	case msg.ActionPlayerPausedChanged:
+		var paused bool
+		if decodeStructVariantField(action, "paused", &paused) != nil {
+			return unchangedEffects()
+		}
+		if p.Selected == nil {
+			return unchangedEffects()
+		}
+		return p.pausedChanged(env, paused)
+	case msg.ActionPlayerNextVideo:
+		return p.nextVideo(env, c)
+	case msg.ActionPlayerEnded:
+		if p.Selected == nil {
+			return unchangedEffects()
+		}
+		p.Ended = true
+		return p.eventEffects(msg.EventPlayerEnded, PlayerVideoEventArgs{
+			Context:            p.analyticsContext(),
+			IsBingeEnabled:     c.Profile.Settings.BingeWatching,
+			IsPlayingNextVideo: p.NextVideo != nil,
+		})
+	case msg.ActionPlayerMarkVideoAsWatched:
+		var video types.Video
+		var isWatched bool
+		if decodeTupleVariant(action, &video, &isWatched) != nil {
+			return unchangedEffects()
+		}
+		return p.markVideoAsWatched(video, isWatched)
+	case msg.ActionPlayerMarkSeasonAsWatched:
+		var season uint32
+		var isWatched bool
+		if decodeTupleVariant(action, &season, &isWatched) != nil {
+			return unchangedEffects()
+		}
+		return p.markSeasonAsWatched(season, isWatched)
+	}
+	return unchangedEffects()
+}
+
+func (p *Player) load(env runtime.Env, selected Selected, c *ctx.Ctx) runtime.Effects {
+	// make sure we send the correct Trakt event if the model hasn't been unloaded
+	traktEventEffects := unchangedEffects()
+	if p.Selected != nil {
+		traktEventEffects = p.contextEventEffects(msg.EventTraktPaused)
+	}
+	itemStateUpdateEffects := unchangedEffects()
+	if !stringPtrEqual(metaRequestID(p.Selected), metaRequestID(&selected)) {
+		itemStateUpdateEffects = itemStateUpdate(p.LibraryItem, p.NextVideo, p.MarkedVideoAsWatched)
+	}
+	// Each player load starts a new observable playback lifecycle, even when the
+	// selected source is structurally identical to the previous one.
+	nextSelected := selected
+	selectedEffects := common.EqUpdate(&p.Selected, &nextSelected).Join(runtime.NoneEffects())
+	var metaItemEffects runtime.Effects
+	if selected.MetaRequest != nil {
+		metaRequest := *selected.MetaRequest
+		if p.MetaItem != nil {
+			metaItemEffects = common.ResourceUpdate(env, p.MetaItem, common.ResourceRequested(&metaRequest), common.MetaItemFromResponse)
+		} else {
+			metaItem := &common.ResourceLoadable[types.MetaItem]{Request: metaRequest}
+			metaItemEffects = common.ResourceUpdate(env, metaItem, common.ResourceRequested(&metaRequest), common.MetaItemFromResponse)
+			p.MetaItem = metaItem
+		}
+	} else {
+		metaItemEffects = common.EqUpdate(&p.MetaItem, nil)
+	}
+	streamStateEffects := common.EqUpdate(&p.StreamState, nil)
+	videoParamsEffects := common.EqUpdate(&p.VideoParams, nil)
+	streamEffects := streamUpdate(&p.Stream, p.Selected, c.Profile.Settings.StreamingServerURL)
+	subtitlesEffects := subtitlesUpdate(env, &p.Subtitles, p.Selected, p.VideoParams, p.Stream, c.Profile.Addons)
+	nextVideoEffects := nextVideoUpdate(env, &p.NextVideo, p.NextStream, p.Selected, p.MetaItem)
+	nextStreamsEffects := nextStreamsUpdate(env, &p.NextStreams, p.NextVideo, p.Selected)
+	nextStreamEffects := nextStreamUpdate(&p.NextStream, p.NextStreams, p.Selected)
+	// Make sure to update the streams and in turn the StreamsBucket
+	// once the player loads the newly selected item
+	updateStreamsEffects := unchangedEffects()
+	if p.Selected != nil && p.MetaItem != nil {
+		updateStreamsEffects = streamLoadedEffects(p.Selected, p.MetaItem)
+	}
+	seriesInfoEffects := seriesInfoUpdate(&p.SeriesInfo, p.Selected, p.MetaItem)
+	libraryItemEffects := libraryItemUpdate(env, &p.LibraryItem, p.Selected, p.MetaItem, &c.Library)
+	libraryItemStateEffects := libraryItemStateUpdate(p.LibraryItem, p.NextVideo, p.Selected)
+	watchedEffects := watchedUpdate(&p.Watched, p.MetaItem, p.LibraryItem)
+	skipGapsEffects := common.EqUpdate(&p.SkipGaps, nil)
+	introOutroEffects := introOutroUpdate(env, &p.IntroOutro, &c.Profile, p.Selected, p.VideoParams, p.SeriesInfo, p.LibraryItem, &p.SkipGaps)
+	// dismiss LibraryItem notification if we have a LibraryItem to begin with
+	notificationEffects := unchangedEffects()
+	if p.LibraryItem != nil {
+		notificationEffects = runtime.MsgEffects(msg.InternalMsg(msg.NewInternal(msg.InternalDismissNotificationItem, p.LibraryItem.ID))).Unchanged()
+	}
+	analyticsContext := &AnalyticsContext{HasTrakt: c.Profile.HasTrakt(env.Now())}
+	if item := p.LibraryItem; item != nil {
+		id, typ, name := item.ID, item.Type, item.Name
+		timeOffset, duration := item.State.TimeOffset, item.State.Duration
+		analyticsContext.ID = &id
+		analyticsContext.Type = &typ
+		analyticsContext.Name = &name
+		analyticsContext.VideoID = clonePtr(item.State.VideoID)
+		analyticsContext.Time = &timeOffset
+		analyticsContext.Duration = &duration
+	}
+	p.AnalyticsContext = analyticsContext
+	loadTime := env.Now()
+	p.LoadTime = &loadTime
+	p.Loaded = false
+	p.Ended = false
+	p.Paused = nil
+	p.MarkedVideoAsWatched = false
+	return traktEventEffects.
+		Join(itemStateUpdateEffects).
+		Join(selectedEffects).
+		Join(metaItemEffects).
+		Join(streamStateEffects).
+		Join(videoParamsEffects).
+		Join(streamEffects).
+		Join(subtitlesEffects).
+		Join(nextVideoEffects).
+		Join(nextStreamsEffects).
+		Join(nextStreamEffects).
+		Join(updateStreamsEffects).
+		Join(seriesInfoEffects).
+		Join(libraryItemEffects).
+		Join(libraryItemStateEffects).
+		Join(watchedEffects).
+		Join(skipGapsEffects).
+		Join(introOutroEffects).
+		Join(notificationEffects)
+}
+
+func (p *Player) unload(env runtime.Env) runtime.Effects {
+	traktEventEffects := unchangedEffects()
+	if p.Selected != nil {
+		traktEventEffects = p.contextEventEffects(msg.EventTraktPaused)
+	}
+	endedEffects := unchangedEffects()
+	if !p.Ended && p.Selected != nil {
+		endedEffects = p.contextEventEffects(msg.EventPlayerStopped)
+	}
+	// we do not have information whether the user is currently
+	// skipping the outro by Unloading the player.
+	seekHistoryEffects := seekUpdate(env, p.Selected, p.VideoParams, p.SeriesInfo, p.LibraryItem, &p.SeekHistory, nil)
+	itemStateUpdateEffects := itemStateUpdate(p.LibraryItem, p.NextVideo, p.MarkedVideoAsWatched)
+	pushToLibraryEffects := unchangedEffects()
+	if p.LibraryItem != nil {
+		pushToLibraryEffects = updateLibraryItemEffects(p.LibraryItem).Unchanged()
+	}
+	selectedEffects := common.EqUpdate(&p.Selected, nil)
+	videoParamsEffects := common.EqUpdate(&p.VideoParams, nil)
+	metaItemEffects := common.EqUpdate(&p.MetaItem, nil)
+	streamStateEffects := common.EqUpdate(&p.StreamState, nil)
+	subtitlePreferenceEffects := common.EqUpdate(&p.SubtitlePreference, nil)
+	videoScaleEffects := common.EqUpdate(&p.VideoScale, nil)
+	streamEffects := common.EqUpdate(&p.Stream, nil)
+	subtitlesEffects := common.EqUpdate(&p.Subtitles, []common.ResourceLoadable[[]types.Subtitles]{})
+	nextVideoEffects := common.EqUpdate(&p.NextVideo, nil)
+	nextStreamsEffects := common.EqUpdate(&p.NextStreams, nil)
+	nextStreamEffects := common.EqUpdate(&p.NextStream, nil)
+	seriesInfoEffects := common.EqUpdate(&p.SeriesInfo, nil)
+	libraryItemEffects := common.EqUpdate(&p.LibraryItem, nil)
+	watchedEffects := common.EqUpdate(&p.Watched, nil)
+	skipGapsEffects := common.EqUpdate(&p.SkipGaps, nil)
+	p.AnalyticsContext = nil
+	p.LoadTime = nil
+	p.Loaded = false
+	p.Ended = false
+	p.Paused = nil
+	p.MarkedVideoAsWatched = false
+	return traktEventEffects.
+		Join(seekHistoryEffects).
+		Join(itemStateUpdateEffects).
+		Join(pushToLibraryEffects).
+		Join(selectedEffects).
+		Join(videoParamsEffects).
+		Join(streamEffects).
+		Join(metaItemEffects).
+		Join(streamStateEffects).
+		Join(subtitlePreferenceEffects).
+		Join(videoScaleEffects).
+		Join(subtitlesEffects).
+		Join(nextVideoEffects).
+		Join(nextStreamsEffects).
+		Join(nextStreamEffects).
+		Join(seriesInfoEffects).
+		Join(libraryItemEffects).
+		Join(watchedEffects).
+		Join(skipGapsEffects).
+		Join(endedEffects)
+}
+
+func (p *Player) videoParamsChanged(env runtime.Env, videoParams *VideoParams, c *ctx.Ctx) runtime.Effects {
+	videoParamsEffects := common.EqUpdate(&p.VideoParams, videoParams)
+	subtitlesEffects := subtitlesUpdate(env, &p.Subtitles, p.Selected, p.VideoParams, p.Stream, c.Profile.Addons)
+	skipGapsEffects := skipGapsUpdate(env, &c.Profile, p.Selected, p.VideoParams, p.SeriesInfo, p.LibraryItem, &p.SkipGaps)
+	return videoParamsEffects.Join(subtitlesEffects).Join(skipGapsEffects)
+}
+
+func (p *Player) seek(env runtime.Env, args playerTimeArgs, c *ctx.Ctx) runtime.Effects {
+	// make sure we have a Selected
+	if p.Selected == nil || p.LibraryItem == nil {
+		return unchangedEffects()
+	}
+	item := p.LibraryItem
+	// We might want to consider whether we want to update the LibraryItem for next video
+	// like we do for TimeChanged
+
+	// update the last_watched
+	now := env.Now()
+	item.State.LastWatched = &now
+	if p.CollectSeekLogs {
+		// collect seek history
+		if item.Type == "series" && args.Time < stremiocore.PLAYER_IGNORE_SEEK_AFTER {
+			p.SeekHistory = append(p.SeekHistory, types.SeekLog{From: item.State.TimeOffset, To: args.Time})
+		}
+	}
+	item.State.TimeOffset = args.Time
+	item.State.Duration = args.Duration
+	// No need to check and flag the library item as watched,
+	// seeking does not update the time_watched!
+
+	// Nor there's a need to update removed and temp, this can only happen
+	// after we mark a LibraryItem as watched! Leave this to TimeChanged
+
+	// Update the analytics, we still want to keep the correct time and duration updated
+	p.updateAnalyticsPlayback(args)
+	// on seeking we want to make sure we send the correct Trakt events
+	traktEventEffects := runtime.NoneEffects()
+	if p.Loaded && p.Paused != nil {
+		if *p.Paused {
+			traktEventEffects = p.contextEventEffects(msg.EventTraktPaused)
+		} else {
+			traktEventEffects = p.contextEventEffects(msg.EventTraktPlaying)
+		}
+	}
+	pushToLibraryEffects := pushToLibrary(env, &p.PushLibraryItemTime, item)
+	introOutroEffects := introOutroUpdate(env, &p.IntroOutro, &c.Profile, p.Selected, p.VideoParams, p.SeriesInfo, item, &p.SkipGaps)
+	return traktEventEffects.Join(pushToLibraryEffects).Join(introOutroEffects)
+}
+
+func (p *Player) timeChanged(env runtime.Env, args playerTimeArgs, c *ctx.Ctx) runtime.Effects {
+	if p.Selected == nil || p.Selected.StreamRequest == nil || p.LibraryItem == nil {
+		return unchangedEffects()
+	}
+	videoID := p.Selected.StreamRequest.Path.ID
+	item := p.LibraryItem
+	// if we've selected a new video (like the next episode)
+	now := env.Now()
+	item.State.LastWatched = &now
+	if item.State.VideoID == nil || *item.State.VideoID != videoID {
+		id := videoID
+		item.State.VideoID = &id
+		item.State.OverallTimeWatched = types.SaturatingAddU64(item.State.OverallTimeWatched, item.State.TimeWatched)
+		item.State.TimeWatched = 0
+		item.State.FlaggedWatched = 0
+	} else {
+		timeWatched := types.SaturatingSubU64(args.Time, item.State.TimeOffset)
+		item.State.TimeWatched = types.SaturatingAddU64(item.State.TimeWatched, timeWatched)
+		item.State.OverallTimeWatched = types.SaturatingAddU64(item.State.OverallTimeWatched, timeWatched)
+	}
+	// if we seek forward, time will be < time_offset
+	// this is the only thing we can guard against!
+	//
+	// for both backward and forward seeking we expect the apps to
+	// send the right actions and update the times accordingly
+	// when the state changes (from seeking to playing and vice versa)
+	if args.Time > item.State.TimeOffset {
+		item.State.TimeOffset = args.Time
+		item.State.Duration = args.Duration
+	}
+	// Watched threshold for marking an episode/movie as watched
+	shouldSendWatched := false
+	if item.State.FlaggedWatched == 0 &&
+		float64(item.State.TimeWatched) > float64(item.State.Duration)*stremiocore.WATCHED_THRESHOLD_COEF {
+		item.State.FlaggedWatched = 1
+		item.State.TimesWatched = types.SaturatingAddU32(item.State.TimesWatched, 1)
+		if p.Watched != nil {
+			watched := p.Watched.Clone()
+			watched.SetVideo(videoID, true)
+			serialized := watched.String()
+			item.State.Watched = &serialized
+		}
+		shouldSendWatched = true
+	}
+	// send Watched for MetaDetail id
+	// single episode should mark the item as watched.
+	sendWatchedEffects := unchangedEffects()
+	if authKey := c.Profile.AuthKey(); shouldSendWatched && authKey != nil && p.Selected.MetaRequest != nil {
+		sendWatchedEffects = runtime.OneEffect(sendWatched(env, *authKey, p.Selected.MetaRequest.Path)).Unchanged()
+	}
+	if item.Temp && item.State.TimesWatched == 0 {
+		item.Removed = true
+	}
+	if item.Removed {
+		item.Temp = true
+	}
+	p.updateAnalyticsPlayback(args)
+	pushToLibraryEffects := pushToLibrary(env, &p.PushLibraryItemTime, item)
+	introOutroEffects := introOutroUpdate(env, &p.IntroOutro, &c.Profile, p.Selected, p.VideoParams, p.SeriesInfo, item, &p.SkipGaps)
+	return sendWatchedEffects.Join(pushToLibraryEffects).Join(introOutroEffects)
+}
+
+func (p *Player) pausedChanged(env runtime.Env, paused bool) runtime.Effects {
+	p.Paused = &paused
+	var traktEventEffects runtime.Effects
+	switch {
+	case !p.Loaded:
+		p.Loaded = true
+		loadTime := int64(-1)
+		if p.LoadTime != nil {
+			loadTime = env.Now().UnixMilli() - p.LoadTime.UnixMilli()
+		}
+		traktEventEffects = p.eventEffects(msg.EventPlayerPlaying, PlayerPlayingEventArgs{
+			Context:  p.analyticsContext(),
+			LoadTime: loadTime,
+		})
+	case paused:
+		traktEventEffects = p.contextEventEffects(msg.EventTraktPaused)
+	default:
+		traktEventEffects = p.contextEventEffects(msg.EventTraktPlaying)
+	}
+	libraryItemEffects := unchangedEffects()
+	if p.LibraryItem != nil {
+		libraryItemEffects = updateLibraryItemEffects(p.LibraryItem).Unchanged()
+	}
+	return traktEventEffects.Join(libraryItemEffects)
+}
+
+func (p *Player) nextVideo(env runtime.Env, c *ctx.Ctx) runtime.Effects {
+	// use the current LibraryItem time offset as the outro time.
+	var outro *uint64
+	if p.LibraryItem != nil {
+		timeOffset := p.LibraryItem.State.TimeOffset
+		outro = &timeOffset
+	}
+	seekHistoryEffects := seekUpdate(env, p.Selected, p.VideoParams, p.SeriesInfo, p.LibraryItem, &p.SeekHistory, outro)
+	// Set time_offset to 0 or 1 as we switch to next video
+	libraryItemEffects := unchangedEffects()
+	if p.LibraryItem != nil {
+		// instantly update the library item's time_offset.
+		if p.NextVideo != nil {
+			p.LibraryItem.State.TimeOffset = 1
+		} else {
+			p.LibraryItem.State.TimeOffset = 0
+		}
+		libraryItemEffects = updateLibraryItemEffects(p.LibraryItem).Unchanged()
+	}
+	// Load will actually take care of loading the next video
+	return seekHistoryEffects.
+		Join(p.eventEffects(msg.EventPlayerNextVideo, PlayerVideoEventArgs{
+			Context:            p.analyticsContext(),
+			IsBingeEnabled:     c.Profile.Settings.BingeWatching,
+			IsPlayingNextVideo: p.NextVideo != nil,
+		})).
+		Join(libraryItemEffects)
+}
+
+func (p *Player) markVideoAsWatched(video types.Video, isWatched bool) runtime.Effects {
+	if p.LibraryItem == nil || p.Watched == nil {
+		return unchangedEffects()
+	}
+	// advancing video_id to the next video is deferred to item_state_update,
+	// otherwise TimeChanged would reset it back to the playing video
+	if p.Selected != nil && p.Selected.StreamRequest != nil && p.Selected.StreamRequest.Path.ID == video.ID {
+		p.MarkedVideoAsWatched = isWatched
+	}
+	item := cloneLibraryItem(*p.LibraryItem)
+	item.MarkVideoAsWatched(*p.Watched, video, isWatched)
+	return updateLibraryItemEffects(&item).Unchanged()
+}
+
+func (p *Player) markSeasonAsWatched(season uint32, isWatched bool) runtime.Effects {
+	if p.LibraryItem == nil || p.Watched == nil {
+		return unchangedEffects()
+	}
+	// Find videos of given season from the meta item loadable
+	metaItem := readyMetaItem(p.MetaItem)
+	if metaItem == nil {
+		return unchangedEffects()
+	}
+	videos := metaItem.VideosBySeason(season)
+	item := cloneLibraryItem(*p.LibraryItem)
+	item.MarkVideosAsWatched(*p.Watched, videos, isWatched)
+	return updateLibraryItemEffects(&item).Unchanged()
+}
+
+func (p *Player) libraryChanged(env runtime.Env, c *ctx.Ctx) runtime.Effects {
+	libraryItemEffects := libraryItemUpdate(env, &p.LibraryItem, p.Selected, p.MetaItem, &c.Library)
+	libraryItemStateEffects := libraryItemStateUpdate(p.LibraryItem, p.NextVideo, p.Selected)
+	watchedEffects := watchedUpdate(&p.Watched, p.MetaItem, p.LibraryItem)
+	return libraryItemEffects.Join(libraryItemStateEffects).Join(watchedEffects)
+}
+
+func (p *Player) streamsChanged(c *ctx.Ctx) runtime.Effects {
+	streamStateEffects := streamStateUpdate(&p.StreamState, p.Selected, &c.Streams)
+	videoScaleEffects := unchangedEffects()
+	if p.VideoScale == nil {
+		var videoScale *types.VideoScale
+		if p.StreamState != nil {
+			videoScale = clonePtr(p.StreamState.VideoScale)
+		}
+		videoScaleEffects = common.EqUpdate(&p.VideoScale, videoScale)
+	}
+	return streamStateEffects.Join(videoScaleEffects)
+}
+
+func (p *Player) resourceRequestResult(env runtime.Env, action common.ResourceAction, c *ctx.Ctx) runtime.Effects {
+	resource := action.Request.Path.Resource
+	metaItemEffects := unchangedEffects()
+	if p.MetaItem != nil && resource == stremiocore.META_RESOURCE_NAME {
+		metaItemEffects = common.ResourceUpdate(env, p.MetaItem, action, common.MetaItemFromResponse)
+	}
+	updateStreamsEffects := unchangedEffects()
+	if p.Selected != nil && p.MetaItem != nil && resource == stremiocore.META_RESOURCE_NAME {
+		updateStreamsEffects = streamLoadedEffects(p.Selected, p.MetaItem)
+	}
+	subtitlesEffects := unchangedEffects()
+	if resource == stremiocore.SUBTITLES_RESOURCE_NAME {
+		subtitlesEffects = common.ResourcesResultUpdate(&p.Subtitles, action, common.SubtitlesFromResponse, true)
+	}
+	nextStreamsEffects := unchangedEffects()
+	if p.NextStreams != nil && resource == stremiocore.STREAM_RESOURCE_NAME {
+		nextStreamsEffects = common.ResourceUpdateWithVectorContent(env, p.NextStreams, action, common.StreamsFromResponse)
+	}
+	nextStreamEffects := nextStreamUpdate(&p.NextStream, p.NextStreams, p.Selected)
+	nextVideoEffects := nextVideoUpdate(env, &p.NextVideo, p.NextStream, p.Selected, p.MetaItem)
+	nextStreamsEffects = nextStreamsEffects.Join(nextStreamsUpdate(env, &p.NextStreams, p.NextVideo, p.Selected))
+	seriesInfoEffects := seriesInfoUpdate(&p.SeriesInfo, p.Selected, p.MetaItem)
+	libraryItemEffects := libraryItemUpdate(env, &p.LibraryItem, p.Selected, p.MetaItem, &c.Library)
+	libraryItemStateEffects := libraryItemStateUpdate(p.LibraryItem, p.NextVideo, p.Selected)
+	watchedEffects := watchedUpdate(&p.Watched, p.MetaItem, p.LibraryItem)
+	skipGapsEffects := skipGapsUpdate(env, &c.Profile, p.Selected, p.VideoParams, p.SeriesInfo, p.LibraryItem, &p.SkipGaps)
+	if p.AnalyticsContext != nil {
+		analyticsContext := p.AnalyticsContext
+		analyticsContext.ID, analyticsContext.Type, analyticsContext.Name = nil, nil, nil
+		analyticsContext.VideoID, analyticsContext.Time, analyticsContext.Duration = nil, nil, nil
+		if item := p.LibraryItem; item != nil {
+			id, typ, name := item.ID, item.Type, item.Name
+			timeOffset, duration := item.State.TimeOffset, item.State.Duration
+			analyticsContext.ID = &id
+			analyticsContext.Type = &typ
+			analyticsContext.Name = &name
+			analyticsContext.VideoID = clonePtr(item.State.VideoID)
+			analyticsContext.Time = &timeOffset
+			analyticsContext.Duration = &duration
+		}
+	}
+	return metaItemEffects.
+		Join(updateStreamsEffects).
+		Join(subtitlesEffects).
+		Join(nextVideoEffects).
+		Join(nextStreamsEffects).
+		Join(nextStreamEffects).
+		Join(seriesInfoEffects).
+		Join(libraryItemEffects).
+		Join(libraryItemStateEffects).
+		Join(watchedEffects).
+		Join(skipGapsEffects)
+}
+
+func (p *Player) skipGapsResult(env runtime.Env, result SkipGapsResult, c *ctx.Ctx) runtime.Effects {
+	var next common.Loadable[types.SkipGapsResponse]
+	switch {
+	case result.Err != nil:
+		next = common.Err[types.SkipGapsResponse](result.Err)
+	case result.Response != nil:
+		next = common.Ready(*result.Response)
+	default:
+		return unchangedEffects()
+	}
+	skipGapsEffects := common.EqUpdate(&p.SkipGaps, &SkipGaps{Request: result.Request, Response: next})
+	introOutroEffects := introOutroUpdate(env, &p.IntroOutro, &c.Profile, p.Selected, p.VideoParams, p.SeriesInfo, p.LibraryItem, &p.SkipGaps)
+	return skipGapsEffects.Join(introOutroEffects)
+}
