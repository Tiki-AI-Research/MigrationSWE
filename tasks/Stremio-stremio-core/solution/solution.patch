+func ssLoadedRuntime(t *testing.T, fetch func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError)) (*testenv.Env, *runtime.Runtime, <-chan runtime.RuntimeEvent) {
+	t.Helper()
+	env := testenv.New()
+	env.FetchFn = func(method, url string, headers map[string]string, body []byte) ([]byte, *runtime.EnvError) {
+		if response, err := fetch(method, url, headers, body); response != nil || err != nil {
+			return response, err
+		}
+		switch {
+		case method == "GET" && url == ssURL+"settings":
+			return []byte(ssSettingsResponse), nil
+		case url == ssURL+"casting":
+			return []byte(`[]`), nil
+		case url == ssURL+"network-info":
