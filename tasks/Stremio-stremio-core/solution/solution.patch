diff --git a/runtime/msg/msg.go b/runtime/msg/msg.go
new file mode 100644
index 0000000000000000000000000000000000000000..762e2d82e4cc4fac9e64b831661c829b68313079
--- /dev/null
+++ b/runtime/msg/msg.go
@@ -0,0 +1,74 @@
+// Package msg contains the messages of the runtime: actions dispatched by
+// the users of the engine, internal messages handled only by the engine and
+// events emitted by the engine.
+package msg
+
+// Kind is the kind of a message.
+type Kind int
+
+const (
+	// KindAction is a message dispatched by the users of the engine.
+	KindAction Kind = iota
+	// KindInternal is a message dispatched and handled only by the engine.
+	KindInternal
+	// KindEvent is a message emitted by the engine.
+	KindEvent
+)
+
+func (k Kind) String() string {
+	switch k {
+	case KindAction:
+		return "Action"
+	case KindInternal:
+		return "Internal"
+	case KindEvent:
+		return "Event"
+	}
+	return "Unknown"
+}
+
+// Msg is a message: exactly one of Action, Internal and Event is set.
+type Msg struct {
+	Kind     Kind
+	Action   *Action
+	Internal *Internal
+	Event    *Event
+}
+
+// ActionMsg wraps an action in a message.
+func ActionMsg(action *Action) *Msg {
+	return &Msg{Kind: KindAction, Action: action}
+}
+
+// InternalMsg wraps an internal message in a message.
+func InternalMsg(internal *Internal) *Msg {
+	return &Msg{Kind: KindInternal, Internal: internal}
+}
+
+// EventMsg wraps an event in a message.
+func EventMsg(event *Event) *Msg {
+	return &Msg{Kind: KindEvent, Event: event}
+}
+
+// ResolvedKind returns the kind of the message, determined by the set payload.
+func (m *Msg) ResolvedKind() Kind {
+	switch {
+	case m.Internal != nil:
+		return KindInternal
+	case m.Event != nil:
+		return KindEvent
+	case m.Action != nil:
+		return KindAction
+	}
+	return m.Kind
+}
+
+// IsAction reports whether the message is an action named name.
+func (m *Msg) IsAction(name string) bool {
+	return m != nil && m.ResolvedKind() == KindAction && m.Action != nil && m.Action.Action == name
+}
+
+// IsInternal reports whether the message is an internal message named name.
+func (m *Msg) IsInternal(name string) bool {
+	return m != nil && m.ResolvedKind() == KindInternal && m.Internal != nil && m.Internal.Name == name
+}
diff --git a/runtime/runtime.go b/runtime/runtime.go
new file mode 100644
index 0000000000000000000000000000000000000000..5ccd57215f7c25d0c5d9527c8c4300ac66ad416a
--- /dev/null
+++ b/runtime/runtime.go
@@ -0,0 +1,227 @@
+// Package runtime implements the single-directional update runtime of the
+// engine: actions update the model, the resulting effects are executed and
+// their messages update the model again until no effects are left.
+package runtime
+
+import (
+	"encoding/json"
+	"sync"
+
+	"github.com/stremio/stremio-core/runtime/msg"
+	"github.com/stremio/stremio-core/types"
+)
+
+// Runtime event names.
+const (
+	RuntimeEventNewState  = "NewState"
+	RuntimeEventCoreEvent = "CoreEvent"
+)
+
+// RuntimeEvent is emitted by the runtime, serialized as
+// `{"name": "NewState"|"CoreEvent", "args": ...}`. `NewState` carries the
+// changed model fields and `CoreEvent` an event.
+type RuntimeEvent struct {
+	Name string          `json:"name"`
+	Args json.RawMessage `json:"args"`
+}
+
+// NewStateEvent creates the `NewState` event for the changed fields.
+func NewStateEvent(fields []string) RuntimeEvent {
+	if fields == nil {
+		fields = []string{}
+	}
+	return RuntimeEvent{Name: RuntimeEventNewState, Args: types.MustMarshalJSON(fields)}
+}
+
+// CoreEvent creates the `CoreEvent` event for the event.
+func CoreEvent(event *msg.Event) RuntimeEvent {
+	return RuntimeEvent{Name: RuntimeEventCoreEvent, Args: types.MustMarshalJSON(event)}
+}
+
+// Fields returns the changed fields of a `NewState` event.
+func (e RuntimeEvent) Fields() []string {
+	var fields []string
+	if e.Name == RuntimeEventNewState {
+		_ = json.Unmarshal(e.Args, &fields)
+	}
+	return fields
+}
+
+// Event returns the event of a `CoreEvent` event.
+func (e RuntimeEvent) Event() *msg.Event {
+	if e.Name != RuntimeEventCoreEvent {
+		return nil
+	}
+	var event msg.Event
+	if err := json.Unmarshal(e.Args, &event); err != nil {
+		return nil
+	}
+	return &event
+}
+
+// RuntimeAction is an action dispatched to the runtime: with a Field only
+// that model field is updated, otherwise the whole model.
+type RuntimeAction struct {
+	Field  *string
+	Action *msg.Action
+}
+
+// Runtime holds the model and dispatches the actions to it.
+type Runtime struct {
+	mu    sync.RWMutex
+	model Model
+	env   Env
+
+	events     chan RuntimeEvent
+	emitMu     sync.Mutex
+	overflow   []RuntimeEvent
+	forwarding bool
+}
+
+// New creates a runtime for the model, handles the initial effects and
+// returns the receiver of the runtime events (with the given buffer size).
+func New(model Model, effects []Effect, buffer int, env Env) (*Runtime, <-chan RuntimeEvent) {
+	if buffer < 0 {
+		buffer = 0
+	}
+	runtime := &Runtime{
+		model:  model,
+		env:    env,
+		events: make(chan RuntimeEvent, buffer),
+	}
+	runtime.process(effects, nil)
+	return runtime, runtime.events
+}
+
+// Model returns the current model.
+func (r *Runtime) Model() Model {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	return r.model
+}
+
+// Env returns the environment of the runtime.
+func (r *Runtime) Env() Env {
+	return r.env
+}
+
+// Dispatch updates the model with the action and handles the resulting effects.
+func (r *Runtime) Dispatch(action RuntimeAction) {
+	m := msg.ActionMsg(action.Action)
+	r.mu.Lock()
+	var effects []Effect
+	var fields []string
+	func() {
+		defer r.mu.Unlock()
+		if action.Field != nil {
+			effects, fields = r.model.UpdateField(m, *action.Field)
+		} else {
+			effects, fields = r.model.Update(m)
+		}
+	}()
+	r.process(effects, fields)
+}
+
+// process handles the effects synchronously; the futures are scheduled on
+// the env once all the messages have been handled, in order.
+func (r *Runtime) process(effects []Effect, fields []string) {
+	var futures []*EffectFuture
+	r.handleEffects(effects, fields, &futures)
+	for _, future := range futures {
+		r.schedule(future)
+	}
+}
+
+func (r *Runtime) handleEffects(effects []Effect, fields []string, futures *[]*EffectFuture) {
+	if len(fields) > 0 {
+		r.emit(NewStateEvent(fields))
+	}
+	for _, effect := range effects {
+		switch {
+		case effect.Msg != nil:
+			r.handleEffectOutput(effect.Msg, futures)
+		case effect.Future != nil:
+			*futures = append(*futures, effect.Future)
+		}
+	}
+}
+
+func (r *Runtime) handleEffectOutput(m *msg.Msg, futures *[]*EffectFuture) {
+	switch m.ResolvedKind() {
+	case msg.KindEvent:
+		r.emit(CoreEvent(m.Event))
+	case msg.KindInternal:
+		r.mu.Lock()
+		var effects []Effect
+		var fields []string
+		func() {
+			defer r.mu.Unlock()
+			effects, fields = r.model.Update(m)
+		}()
+		r.handleEffects(effects, fields, futures)
+	case msg.KindAction:
+		panic("effects are not allowed to resolve with action")
+	}
+}
+
+func (r *Runtime) schedule(future *EffectFuture) {
+	task := func() {
+		if future.Run == nil {
+			return
+		}
+		output := future.Run()
+		if output == nil {
+			return
+		}
+		var futures []*EffectFuture
+		r.handleEffectOutput(output, &futures)
+		for _, next := range futures {
+			r.schedule(next)
+		}
+	}
+	if r.env == nil {
+		task()
+		return
+	}
+	if future.Concurrent {
+		r.env.ExecConcurrent(task)
+	} else {
+		r.env.ExecSequential(task)
+	}
+}
+
+// emit sends the event without blocking the runtime: when the channel buffer
+// is full the events are queued and forwarded in order.
+func (r *Runtime) emit(event RuntimeEvent) {
+	r.emitMu.Lock()
+	defer r.emitMu.Unlock()
+	if len(r.overflow) == 0 {
+		select {
+		case r.events <- event:
+			return
+		default:
+		}
+	}
+	r.overflow = append(r.overflow, event)
+	if !r.forwarding {
+		r.forwarding = true
+		go r.forward()
+	}
+}
+
+func (r *Runtime) forward() {
+	for {
+		r.emitMu.Lock()
+		if len(r.overflow) == 0 {
+			r.forwarding = false
+			r.emitMu.Unlock()
+			return
+		}
+		event := r.overflow[0]
+		r.emitMu.Unlock()
+		r.events <- event
+		r.emitMu.Lock()
+		r.overflow = r.overflow[1:]
+		r.emitMu.Unlock()
+	}
+}
diff --git a/runtime/runtime_test.go b/runtime/runtime_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..5596c1536ceb2f66f6a0238d62e974763b8cb4d7
--- /dev/null
+++ b/runtime/runtime_test.go
@@ -0,0 +1,187 @@
+package runtime_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/runtime"
+	"github.com/stremio/stremio-core/runtime/msg"
+)
+
+// counterModel counts actions and internal messages.
+type counterModel struct {
+	actions   int
+	internals int
+	// effects returned for the next update
+	next []runtime.Effect
+}
+
+func (m *counterModel) Update(message *msg.Msg) ([]runtime.Effect, []string) {
+	switch {
+	case message.Action != nil:
+		m.actions++
+	case message.Internal != nil:
+		m.internals++
+		if message.Internal.Name == "unchanged" {
+			return nil, nil
+		}
+	}
+	effects := m.next
+	m.next = nil
+	return effects, []string{"counter"}
+}
+
+func (m *counterModel) UpdateField(message *msg.Msg, field string) ([]runtime.Effect, []string) {
+	if field != "counter" {
+		return nil, nil
+	}
+	return m.Update(message)
+}
+
+func drain(rx <-chan runtime.RuntimeEvent) []runtime.RuntimeEvent {
+	events := []runtime.RuntimeEvent{}
+	for {
+		select {
+		case event := <-rx:
+			events = append(events, event)
+		default:
+			return events
+		}
+	}
+}
+
+func TestRuntimeEventSerialization(t *testing.T) {
+	newState, err := json.Marshal(runtime.NewStateEvent([]string{"ctx", "player"}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(newState) != `{"name":"NewState","args":["ctx","player"]}` {
+		t.Fatalf("unexpected NewState: %s", newState)
+	}
+	coreEvent, err := json.Marshal(runtime.CoreEvent(msg.NewEvent("UserLoggedOut", map[string]any{"uid": nil})))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(coreEvent) != `{"name":"CoreEvent","args":{"event":"UserLoggedOut","args":{"uid":null}}}` {
+		t.Fatalf("unexpected CoreEvent: %s", coreEvent)
+	}
+	envErr, _ := json.Marshal(runtime.EnvErrorFetch("boom"))
+	if string(envErr) != `{"code":1,"message":"Failed to fetch: boom"}` {
+		t.Fatalf("unexpected EnvError: %s", envErr)
+	}
+}
+
+func TestDispatchEmitsNewState(t *testing.T) {
+	env := testenv.New()
+	model := &counterModel{}
+	rt, rx := runtime.New(model, nil, 10, env)
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction("Test", nil)})
+	events := drain(rx)
+	if len(events) != 1 || events[0].Name != "NewState" || string(events[0].Args) != `["counter"]` {
+		t.Fatalf("unexpected events %+v", events)
+	}
+	field := "counter"
+	rt.Dispatch(runtime.RuntimeAction{Field: &field, Action: msg.NewAction("Test", nil)})
+	other := "other"
+	rt.Dispatch(runtime.RuntimeAction{Field: &other, Action: msg.NewAction("Test", nil)})
+	if events := drain(rx); len(events) != 1 {
+		t.Fatalf("expected a single NewState for the field update, got %+v", events)
+	}
+	if model.actions != 2 {
+		t.Fatalf("expected 2 actions, got %d", model.actions)
+	}
+	if rt.Model() != runtime.Model(model) {
+		t.Fatal("unexpected model")
+	}
+}
+
+func TestInternalAndEventEffects(t *testing.T) {
+	env := testenv.New()
+	model := &counterModel{}
+	rt, rx := runtime.New(model, nil, 10, env)
+	model.next = []runtime.Effect{
+		runtime.MsgEffect(msg.InternalMsg(msg.NewInternal("unchanged", nil))),
+		runtime.ConcurrentFuture(func() *msg.Msg {
+			return msg.EventMsg(msg.NewEvent("Done", nil))
+		}),
+		runtime.MsgEffect(msg.EventMsg(msg.NewEvent("Sync", nil))),
+	}
+	rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction("Test", nil)})
+	events := drain(rx)
+	names := []string{}
+	for _, event := range events {
+		if event.Name == "CoreEvent" {
+			names = append(names, event.Event().Event)
+		} else {
+			names = append(names, event.Name)
+		}
+	}
+	// the messages are handled synchronously, the futures after them
+	expected := []string{"NewState", "Sync", "Done"}
+	if len(names) != len(expected) {
+		t.Fatalf("unexpected events %v", names)
+	}
+	for i := range expected {
+		if names[i] != expected[i] {
+			t.Fatalf("unexpected events %v", names)
+		}
+	}
+	if model.internals != 1 {
+		t.Fatalf("expected the internal message to update the model, got %d", model.internals)
+	}
+}
+
+func TestInitialEffectsAndActionPanic(t *testing.T) {
+	env := testenv.New()
+	model := &counterModel{}
+	_, rx := runtime.New(model, []runtime.Effect{runtime.MsgEffect(msg.InternalMsg(msg.NewInternal("changed", nil)))}, 10, env)
+	if events := drain(rx); len(events) != 1 || events[0].Name != "NewState" {
+		t.Fatalf("unexpected events %+v", events)
+	}
+	defer func() {
+		if recover() == nil {
+			t.Fatal("expected a panic for an action resolved by an effect")
+		}
+	}()
+	runtime.New(&counterModel{}, []runtime.Effect{runtime.ConcurrentFuture(func() *msg.Msg {
+		return msg.ActionMsg(msg.NewAction("Test", nil))
+	})}, 10, env)
+}
+
+func TestSmallBufferDoesNotBlock(t *testing.T) {
+	env := testenv.New()
+	model := &counterModel{}
+	rt, rx := runtime.New(model, nil, 0, env)
+	for i := 0; i < 5; i++ {
+		rt.Dispatch(runtime.RuntimeAction{Action: msg.NewAction("Test", nil)})
+	}
+	for i := 0; i < 5; i++ {
+		if event := <-rx; event.Name != "NewState" {
+			t.Fatalf("unexpected event %+v", event)
+		}
+	}
+}
+
+func TestActionWireFormat(t *testing.T) {
+	load, _ := json.Marshal(msg.LoadAction("Player", map[string]string{"a": "b"}))
+	if string(load) != `{"action":"Load","args":{"model":"Player","args":{"a":"b"}}}` {
+		t.Fatalf("unexpected load action %s", load)
+	}
+	unload, _ := json.Marshal(msg.UnloadAction())
+	if string(unload) != `{"action":"Unload"}` {
+		t.Fatalf("unexpected unload action %s", unload)
+	}
+	var action msg.Action
+	if err := json.Unmarshal([]byte(`{"action":"Ctx","args":{"action":"Logout"}}`), &action); err != nil {
+		t.Fatal(err)
+	}
+	nested, err := action.Nested()
+	if err != nil || nested.Action != "Logout" || nested.HasArgs() {
+		t.Fatalf("unexpected nested action %+v %v", nested, err)
+	}
+	event, _ := json.Marshal(msg.NewEvent("SettingsUpdated", map[string]int{"x": 1}))
+	if string(event) != `{"event":"SettingsUpdated","args":{"x":1}}` {
+		t.Fatalf("unexpected event %s", event)
+	}
+}
