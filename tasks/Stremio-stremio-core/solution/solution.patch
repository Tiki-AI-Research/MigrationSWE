+func TestWatchedBitFieldRustScenarios(t *testing.T) {
+	scenarios := wbTestScenarios(42, 300)
+	if len(scenarios) != len(wbRustScenarioSums) {
+		t.Fatalf("got %d scenarios, want %d", len(scenarios), len(wbRustScenarioSums))
+	}
+	for i, scenario := range scenarios {
+		summary := wbTestRun(scenario)
+		sum := sha256.Sum256([]byte(summary))
+		if got := hex.EncodeToString(sum[:8]); got != wbRustScenarioSums[i] {
+			t.Errorf("scenario %d (%s, %d videos): results differ from Rust: %.300s", i, scenario.kind, len(scenario.videos), summary)
+		}
+	}
+}
