+}
+
+// settings introduced by the respective schema versions, with their values
+var settingsAddedBy = map[uint32][]orderedSetting{
+	3:  {{"streamingServerWarningDismissed", nil}},
+	4:  {{"seekTimeDuration", json.Number("20000")}},
+	5:  {{"audioLanguage", "eng"}, {"audioPassthrough", false}},
+	6:  {{"autoFrameRateMatching", false}, {"nextVideoNotificationDuration", json.Number("35000")}},
+	7:  {{"frameRateMatchingStrategy", "FrameRateOnly"}},
+	9:  {{"seekShortTimeDuration", json.Number("3000")}, {"escExitFullscreen", true}, {"pauseOnMinimize", false}},
+	11: {{"surroundSound", false}},
+	14: {{"subtitlesOpacity", json.Number("100")}},
+	16: {{"serverInForeground", false}, {"sendCrashReports", true}},
+	17: {{"quitOnClose", true}},
+	18: {{"hideSpoilers", false}},
+	19: {{"gamepadSupport", false}},
+	20: {{"videoMode", nil}},
+	21: {{"assSubtitlesStyling", false}},
+	22: {{"subtitlesAutoSelect", true}},
+	23: {{"discordRpcEnabled", false}},
+	24: {{"interfaceScale", json.Number("100")}},
+	25: {{"gpuVideoProcessing", false}},
+}
+
+// MigrateStorageSchema migrates the persisted user state from the stored
+// schema version to SCHEMA_VERSION, one version at a time. A stored version
+// newer than SCHEMA_VERSION is reported as a downgrade error.
+func MigrateStorageSchema(env Env) *EnvError {
+	raw, found, envErr := env.GetStorage(stremiocore.SCHEMA_VERSION_STORAGE_KEY)
+	if envErr != nil {
+		return envErr
+	}
+	var schemaVersion uint32
+	if found && !isNull(raw) {
+		if err := json.Unmarshal(raw, &schemaVersion); err != nil {
+			return EnvErrorSerde(err.Error())
+		}
+	}
+	if schemaVersion > stremiocore.SCHEMA_VERSION {
+		return EnvErrorStorageSchemaVersionDowngrade(schemaVersion, stremiocore.SCHEMA_VERSION)
+	}
+	for schemaVersion < stremiocore.SCHEMA_VERSION {
+		next := schemaVersion + 1
+		if err := MigrateStorageSchemaTo(env, next); err != nil {
+			return EnvErrorStorageSchemaVersionUpgrade(err)
+		}
+		schemaVersion = next
+	}
+	return nil
+}
+
+func isNull(raw json.RawMessage) bool {
+	trimmed := bytes.TrimSpace(raw)
+	return len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null"))
+}
+
+// MigrateStorageSchemaTo performs the single migration step to the given
+// version (from the previous one) and stores the new schema version.
+func MigrateStorageSchemaTo(env Env, version uint32) *EnvError {
+	for _, key := range removedStorageKeys[version] {
+		if err := env.SetStorage(key, nil); err != nil {
+			return err
+		}
+	}
+	if version != 1 && version != 8 && version != 10 && version != 12 && version != 15 {
+		if err := migrateProfile(env, version); err != nil {
+			return err
+		}
+	}
+	return env.SetStorage(stremiocore.SCHEMA_VERSION_STORAGE_KEY, version)
+}
+
+// migrateProfile upgrades the persisted profile to the given version. The
+// existing profile and settings are kept: legacy setting names are renamed
+// and the settings introduced by the version are added.
+func migrateProfile(env Env, version uint32) *EnvError {
+	raw, found, envErr := env.GetStorage(stremiocore.PROFILE_STORAGE_KEY)
+	if envErr != nil {
+		return envErr
+	}
+	if !found {
+		return nil
+	}
+	var value any
+	if !isNull(raw) {
+		decoder := json.NewDecoder(bytes.NewReader(raw))
+		decoder.UseNumber()
+		if err := decoder.Decode(&value); err != nil {
+			return EnvErrorSerde(err.Error())
+		}
+	}
+	profile, ok := value.(map[string]any)
+	if !ok {
+		// not a valid profile, discard it
+		return env.SetStorage(stremiocore.PROFILE_STORAGE_KEY, nil)
+	}
+	if version == 13 {
+		profile["addonsLocked"] = false
+		return env.SetStorage(stremiocore.PROFILE_STORAGE_KEY, profile)
+	}
+	settings, ok := profile["settings"].(map[string]any)
+	if !ok {
+		settings = map[string]any{}
+		profile["settings"] = settings
+	}
+	switch version {
+	case 2:
+		for _, rename := range settingsRenamedInV2 {
+			if legacyValue, exists := settings[rename[0]]; exists {
+				delete(settings, rename[0])
+				settings[rename[1]] = legacyValue
+			}
+		}
+	case 6:
+		playerType := any(nil)
+		if playInExternalPlayer, exists := settings["playInExternalPlayer"]; exists {
+			delete(settings, "playInExternalPlayer")
+			if enabled, isBool := playInExternalPlayer.(bool); isBool && enabled {
+				playerType = "external"
+			}
+		}
+		settings["playerType"] = playerType
+	case 7:
+		delete(settings, "autoFrameRateMatching")
+	}
+	for _, setting := range settingsAddedBy[version] {
+		settings[setting.key] = setting.value
+	}
+	return env.SetStorage(stremiocore.PROFILE_STORAGE_KEY, profile)
+}
+
+// DefaultAddonTransport creates the transport for an addon transport url. It
+// is registered by the addon_transport package (HTTP transport for `http(s)`
+// urls, unsupported transport otherwise).
+var DefaultAddonTransport func(transportURL string, env Env) AddonTransport
+
+// NewAddonTransport returns the default transport for the transport url.
+func NewAddonTransport(transportURL string, env Env) AddonTransport {
+	if DefaultAddonTransport != nil {
+		return DefaultAddonTransport(transportURL, env)
+	}
+	return unavailableTransport{transportURL: transportURL}
+}
+
+// unavailableTransport is used when no default transport is registered.
+type unavailableTransport struct {
+	transportURL string
+}
+
+func (t unavailableTransport) err() *EnvError {
+	return EnvErrorAddonTransport("Unsupported addon transport: " + types.URLScheme(t.transportURL))
+}
+
+func (t unavailableTransport) Resource(path types.ResourcePath) (types.ResourceResponse, *EnvError) {
+	return types.ResourceResponse{}, t.err()
+}
+
+func (t unavailableTransport) Manifest() (types.Manifest, *EnvError) {
+	return types.Manifest{}, t.err()
+}
diff --git a/runtime/env_test.go b/runtime/env_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..47eff3add3662703abf29c1237ac09608f48d835
--- /dev/null
+++ b/runtime/env_test.go
@@ -0,0 +1,203 @@
+package runtime_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	stremiocore "github.com/stremio/stremio-core"
+	"github.com/stremio/stremio-core/internal/testenv"
+	"github.com/stremio/stremio-core/runtime"
+)
+
+func setStorage(env *testenv.Env, key, value string) {
+	env.Storage[key] = json.RawMessage(value)
+}
+
+func storedProfile(t *testing.T, env *testenv.Env) map[string]any {
+	t.Helper()
+	raw, ok := env.Storage[stremiocore.PROFILE_STORAGE_KEY]
+	if !ok {
+		t.Fatal("profile should be stored")
+	}
+	var profile map[string]any
+	if err := json.Unmarshal(raw, &profile); err != nil {
+		t.Fatal(err)
+	}
+	return profile
+}
+
+func TestMigrationToLatestVersion(t *testing.T) {
+	env := testenv.New()
+	setStorage(env, stremiocore.SCHEMA_VERSION_STORAGE_KEY, "1")
+	setStorage(env, stremiocore.PROFILE_STORAGE_KEY, `{"settings":{}}`)
+	if err := runtime.MigrateStorageSchema(env); err != nil {
+		t.Fatal(err)
+	}
+	if string(env.Storage[stremiocore.SCHEMA_VERSION_STORAGE_KEY]) != "25" {
+		t.Fatalf("unexpected schema version %s", env.Storage[stremiocore.SCHEMA_VERSION_STORAGE_KEY])
+	}
+	expected := `{"settings":{"assSubtitlesStyling":false,"audioLanguage":"eng","audioPassthrough":false,` +
+		`"discordRpcEnabled":false,"escExitFullscreen":true,"frameRateMatchingStrategy":"FrameRateOnly",` +
+		`"gamepadSupport":false,"gpuVideoProcessing":false,"hideSpoilers":false,"interfaceScale":100,` +
+		`"nextVideoNotificationDuration":35000,"pauseOnMinimize":false,"playerType":null,"quitOnClose":true,` +
+		`"seekShortTimeDuration":3000,"seekTimeDuration":20000,"sendCrashReports":true,"serverInForeground":false,` +
+		`"streamingServerWarningDismissed":null,"subtitlesAutoSelect":true,"subtitlesOpacity":100,` +
+		`"surroundSound":false,"videoMode":null},"addonsLocked":false}`
+	var got, want any
+	_ = json.Unmarshal(env.Storage[stremiocore.PROFILE_STORAGE_KEY], &got)
+	_ = json.Unmarshal([]byte(expected), &want)
+	gotJSON, _ := json.Marshal(got)
+	wantJSON, _ := json.Marshal(want)
+	if string(gotJSON) != string(wantJSON) {
+		t.Fatalf("unexpected profile\n got: %s\nwant: %s", gotJSON, wantJSON)
+	}
+}
+
+func TestMigrationKeepsLegacySettings(t *testing.T) {
+	env := testenv.New()
+	setStorage(env, stremiocore.SCHEMA_VERSION_STORAGE_KEY, "1")
+	setStorage(env, stremiocore.PROFILE_STORAGE_KEY, `{"auth":null,"addons":[],"settings":{"interface_language":"bul","binge_watching":false,"play_in_external_player":true,"subtitles_size":2}}`)
+	setStorage(env, stremiocore.STREAMS_STORAGE_KEY, `{"uid":null,"items":[]}`)
+	setStorage(env, stremiocore.LIBRARY_STORAGE_KEY, `{"uid":null,"items":{}}`)
+	if err := env.MigrateStorageSchema(); err != nil {
+		t.Fatal(err)
+	}
+	profile := storedProfile(t, env)
+	settings := profile["settings"].(map[string]any)
+	expected := map[string]any{
+		"interfaceLanguage":  "bul",
+		"bingeWatching":      false,
+		"playerType":         "external",
+		"subtitlesSize":      float64(2),
+		"seekTimeDuration":   float64(20000),
+		"gpuVideoProcessing": false,
+	}
+	for key, value := range expected {
+		if settings[key] != value {
+			t.Fatalf("setting %s: got %v, want %v (settings %v)", key, settings[key], value, settings)
+		}
+	}
+	for _, legacy := range []string{"interface_language", "binge_watching", "play_in_external_player", "playInExternalPlayer", "autoFrameRateMatching"} {
+		if _, ok := settings[legacy]; ok {
+			t.Fatalf("legacy setting %s should be renamed", legacy)
+		}
+	}
+	if profile["addons"] == nil {
+		t.Fatal("the rest of the profile should be kept")
+	}
+	if _, ok := env.Storage[stremiocore.STREAMS_STORAGE_KEY]; ok {
+		t.Fatal("streams should be removed by the v8 migration")
+	}
+	if _, ok := env.Storage[stremiocore.LIBRARY_STORAGE_KEY]; !ok {
+		t.Fatal("library should be kept when migrating from v1")
+	}
+}
+
+func TestMigrationFromZeroClearsTheState(t *testing.T) {
+	env := testenv.New()
+	setStorage(env, stremiocore.PROFILE_STORAGE_KEY, `{"settings":{}}`)
+	setStorage(env, stremiocore.LIBRARY_STORAGE_KEY, `{"uid":null,"items":{}}`)
+	setStorage(env, stremiocore.LIBRARY_RECENT_STORAGE_KEY, `{"uid":null,"items":{}}`)
+	if err := runtime.MigrateStorageSchema(env); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{stremiocore.PROFILE_STORAGE_KEY, stremiocore.LIBRARY_STORAGE_KEY, stremiocore.LIBRARY_RECENT_STORAGE_KEY} {
+		if _, ok := env.Storage[key]; ok {
+			t.Fatalf("%s should be removed", key)
+		}
+	}
+	if string(env.Storage[stremiocore.SCHEMA_VERSION_STORAGE_KEY]) != "25" {
+		t.Fatal("schema version should be 25")
+	}
+}
+
+func TestMigrationSingleSteps(t *testing.T) {
+	cases := []struct {
+		from     int
+		before   string
+		expected string
+	}{
+		{5, `{"settings":{"playInExternalPlayer":true}}`, `{"settings":{"autoFrameRateMatching":false,"nextVideoNotificationDuration":35000,"playerType":"external"}}`},
+		{5, `{"settings":{"playInExternalPlayer":false}}`, `{"settings":{"autoFrameRateMatching":false,"nextVideoNotificationDuration":35000,"playerType":null}}`},
+		{5, `{"settings":{}}`, `{"settings":{"autoFrameRateMatching":false,"nextVideoNotificationDuration":35000,"playerType":null}}`},
+		{6, `{"settings":{"autoFrameRateMatching":false}}`, `{"settings":{"frameRateMatchingStrategy":"FrameRateOnly"}}`},
+		{8, `{"settings":{}}`, `{"settings":{"escExitFullscreen":true,"pauseOnMinimize":false,"seekShortTimeDuration":3000}}`},
+		{10, `{"settings":{}}`, `{"settings":{"surroundSound":false}}`},
+		{12, `{}`, `{"addonsLocked":false}`},
+		{13, `{"settings":{}}`, `{"settings":{"subtitlesOpacity":100}}`},
+		{15, `{"settings":{}}`, `{"settings":{"sendCrashReports":true,"serverInForeground":false}}`},
+		{16, `{"settings":{}}`, `{"settings":{"quitOnClose":true}}`},
+		{17, `{"settings":{}}`, `{"settings":{"hideSpoilers":false}}`},
+		{18, `{"settings":{}}`, `{"settings":{"gamepadSupport":false}}`},
+		{19, `{"settings":{}}`, `{"settings":{"videoMode":null}}`},
+		{20, `{"settings":{}}`, `{"settings":{"assSubtitlesStyling":false}}`},
+		{21, `{"settings":{}}`, `{"settings":{"subtitlesAutoSelect":true}}`},
+		{22, `{"settings":{}}`, `{"settings":{"discordRpcEnabled":false}}`},
+		{23, `{"settings":{}}`, `{"settings":{"interfaceScale":100}}`},
+		{24, `{"settings":{}}`, `{"settings":{"gpuVideoProcessing":false}}`},
+	}
+	for _, c := range cases {
+		env := testenv.New()
+		setStorage(env, stremiocore.SCHEMA_VERSION_STORAGE_KEY, "0")
+		setStorage(env, stremiocore.PROFILE_STORAGE_KEY, c.before)
+		if err := runtime.MigrateStorageSchemaTo(env, uint32(c.from+1)); err != nil {
+			t.Fatal(err)
+		}
+		if got := string(env.Storage[stremiocore.PROFILE_STORAGE_KEY]); got != c.expected {
+			t.Fatalf("migration from %d: got %s, want %s", c.from, got, c.expected)
+		}
+		if got, want := string(env.Storage[stremiocore.SCHEMA_VERSION_STORAGE_KEY]), json.Number(itoa(c.from+1)).String(); got != want {
+			t.Fatalf("migration from %d: schema version %s", c.from, got)
+		}
+	}
+}
+
+func itoa(n int) string {
+	data, _ := json.Marshal(n)
+	return string(data)
+}
+
+func TestMigrationRemovesBuckets(t *testing.T) {
+	for version, key := range map[uint32]string{
+		8:  stremiocore.STREAMS_STORAGE_KEY,
+		10: stremiocore.SEARCH_HISTORY_STORAGE_KEY,
+		12: stremiocore.DISMISSED_EVENTS_STORAGE_KEY,
+		15: stremiocore.STREAMING_SERVER_URLS_STORAGE_KEY,
+	} {
+		env := testenv.New()
+		setStorage(env, key, `{"uid":"test","items":[]}`)
+		if err := runtime.MigrateStorageSchemaTo(env, version); err != nil {
+			t.Fatal(err)
+		}
+		if _, ok := env.Storage[key]; ok {
+			t.Fatalf("v%d should remove %s", version, key)
+		}
+	}
+}
+
+func TestMigrationDowngrade(t *testing.T) {
+	env := testenv.New()
+	setStorage(env, stremiocore.SCHEMA_VERSION_STORAGE_KEY, "26")
+	err := runtime.MigrateStorageSchema(env)
+	if err == nil || err.Code != runtime.EnvErrorCodeStorageSchemaVersionDowngrade {
+		t.Fatalf("expected a downgrade error, got %v", err)
+	}
+	if err.Message != "Downgrade storage schema version from 26 to 25 is not allowed" {
+		t.Fatalf("unexpected message %s", err.Message)
+	}
+	if string(env.Storage[stremiocore.SCHEMA_VERSION_STORAGE_KEY]) != "26" {
+		t.Fatal("schema version should be left unchanged")
+	}
+}
+
+func TestMigrationOfLatestVersionIsNoop(t *testing.T) {
+	env := testenv.New()
+	setStorage(env, stremiocore.SCHEMA_VERSION_STORAGE_KEY, "25")
+	setStorage(env, stremiocore.PROFILE_STORAGE_KEY, `{"settings":{"x":1}}`)
+	if err := runtime.MigrateStorageSchema(env); err != nil {
+		t.Fatal(err)
+	}
+	if string(env.Storage[stremiocore.PROFILE_STORAGE_KEY]) != `{"settings":{"x":1}}` {
+		t.Fatal("profile should be unchanged")
+	}
+}
diff --git a/runtime/msg/action.go b/runtime/msg/action.go
new file mode 100644
index 0000000000000000000000000000000000000000..45922a2bd4391c30858be8f939bf0c0b88d1080c
--- /dev/null
+++ b/runtime/msg/action.go
@@ -0,0 +1,205 @@
+package msg
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+)
+
+// Action is a message dispatched by the users of the engine.
+// It is serialized as `{"action": <name>, "args": <args>}`.
+type Action struct {
+	Action string          `json:"action"`
+	Args   json.RawMessage `json:"args,omitempty"`
+}
+
+// Top level action names.
+const (
+	ActionNameCtx                = "Ctx"
+	ActionNameLink               = "Link"
+	ActionNameCatalogWithFilters = "CatalogWithFilters"
+	ActionNameCatalogsWithExtra  = "CatalogsWithExtra"
+	ActionNameLibraryByType      = "LibraryByType"
+	ActionNameLibraryWithFilters = "LibraryWithFilters"
+	ActionNameMetaDetails        = "MetaDetails"
+	ActionNameStreamingServer    = "StreamingServer"
+	ActionNamePlayer             = "Player"
+	ActionNameLoad               = "Load"
+	ActionNameSearch             = "Search"
+	ActionNameUnload             = "Unload"
+)
+
+// Ctx actions.
+const (
+	ActionCtxAuthenticate                   = "Authenticate"
+	ActionCtxLogout                         = "Logout"
+	ActionCtxDeleteAccount                  = "DeleteAccount"
+	ActionCtxInstallAddon                   = "InstallAddon"
+	ActionCtxInstallTraktAddon              = "InstallTraktAddon"
+	ActionCtxLogoutTrakt                    = "LogoutTrakt"
+	ActionCtxUpgradeAddon                   = "UpgradeAddon"
+	ActionCtxUninstallAddon                 = "UninstallAddon"
+	ActionCtxUpdateSettings                 = "UpdateSettings"
+	ActionCtxAddToLibrary                   = "AddToLibrary"
+	ActionCtxRemoveFromLibrary              = "RemoveFromLibrary"
+	ActionCtxRewindLibraryItem              = "RewindLibraryItem"
+	ActionCtxLibraryItemMarkAsWatched       = "LibraryItemMarkAsWatched"
+	ActionCtxMetaItemMarkAsWatched          = "MetaItemMarkAsWatched"
+	ActionCtxToggleLibraryItemNotifications = "ToggleLibraryItemNotifications"
+	ActionCtxDismissNotificationItem        = "DismissNotificationItem"
+	ActionCtxClearSearchHistory             = "ClearSearchHistory"
+	ActionCtxPushUserToAPI                  = "PushUserToAPI"
+	ActionCtxPullUserFromAPI                = "PullUserFromAPI"
+	ActionCtxPushAddonsToAPI                = "PushAddonsToAPI"
+	ActionCtxPullAddonsFromAPI              = "PullAddonsFromAPI"
+	ActionCtxSyncLibraryWithAPI             = "SyncLibraryWithAPI"
+	ActionCtxPullNotifications              = "PullNotifications"
+	ActionCtxGetEvents                      = "GetEvents"
+	ActionCtxDismissEvent                   = "DismissEvent"
+	ActionCtxAddServerURL                   = "AddServerUrl"
+	ActionCtxDeleteServerURL                = "DeleteServerUrl"
+)
+
+// StreamingServer actions.
+const (
+	ActionStreamingServerReload                 = "Reload"
+	ActionStreamingServerRefreshPlaybackDevices = "RefreshPlaybackDevices"
+	ActionStreamingServerUpdateSettings         = "UpdateSettings"
+	ActionStreamingServerCreateTorrent          = "CreateTorrent"
+	ActionStreamingServerGetStatistics          = "GetStatistics"
+	ActionStreamingServerPlayOnDevice           = "PlayOnDevice"
+)
+
+// Player actions.
+const (
+	ActionPlayerVideoParamsChanged        = "VideoParamsChanged"
+	ActionPlayerStreamStateChanged        = "StreamStateChanged"
+	ActionPlayerSubtitlePreferenceChanged = "SubtitlePreferenceChanged"
+	ActionPlayerVideoScaleChanged         = "VideoScaleChanged"
+	ActionPlayerSeek                      = "Seek"
+	ActionPlayerTimeChanged               = "TimeChanged"
+	ActionPlayerPausedChanged             = "PausedChanged"
+	ActionPlayerNextVideo                 = "NextVideo"
+	ActionPlayerEnded                     = "Ended"
+	ActionPlayerMarkVideoAsWatched        = "MarkVideoAsWatched"
+	ActionPlayerMarkSeasonAsWatched       = "MarkSeasonAsWatched"
+)
+
+// Models which can be loaded with a Load action.
+const (
+	ModelAddonDetails               = "AddonDetails"
+	ModelCatalogWithFilters         = "CatalogWithFilters"
+	ModelCatalogsWithExtra          = "CatalogsWithExtra"
+	ModelDataExport                 = "DataExport"
+	ModelInstalledAddonsWithFilters = "InstalledAddonsWithFilters"
+	ModelLibraryWithFilters         = "LibraryWithFilters"
+	ModelLibraryByType              = "LibraryByType"
+	ModelCalendar                   = "Calendar"
+	ModelLocalSearch                = "LocalSearch"
+	ModelMetaDetails                = "MetaDetails"
+	ModelPlayer                     = "Player"
+	ModelLink                       = "Link"
+)
+
+func marshalArgs(args any) json.RawMessage {
+	switch value := args.(type) {
+	case nil:
+		return nil
+	case json.RawMessage:
+		return value
+	}
+	var buf bytes.Buffer
+	encoder := json.NewEncoder(&buf)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(args); err != nil {
+		panic(fmt.Sprintf("action args serialization failed: %v", err))
+	}
+	return bytes.TrimRight(buf.Bytes(), "\n")
+}
+
+// NewAction creates an action with the given (serializable) arguments; nil
+// arguments are omitted.
+func NewAction(name string, args any) *Action {
+	return &Action{Action: name, Args: marshalArgs(args)}
+}
+
+// loadArgs are the arguments of a Load action.
+type loadArgs struct {
+	Model string `json:"model"`
+	Args  any    `json:"args,omitempty"`
+}
+
+// LoadAction creates a `Load` action for the given model:
+// `{"action": "Load", "args": {"model": <model>, "args": <args>}}`.
+func LoadAction(model string, args any) *Action {
+	return NewAction(ActionNameLoad, loadArgs{Model: model, Args: args})
+}
+
+// UnloadAction creates the `Unload` action.
+func UnloadAction() *Action {
+	return &Action{Action: ActionNameUnload}
+}
+
+// HasArgs reports whether the action has non-null arguments.
+func (a *Action) HasArgs() bool {
+	trimmed := bytes.TrimSpace(a.Args)
+	return len(trimmed) != 0 && !bytes.Equal(trimmed, []byte("null"))
+}
+
+// DecodeArgs decodes the arguments of the action into the value.
+func (a *Action) DecodeArgs(value any) error {
+	if !a.HasArgs() {
+		return fmt.Errorf("action %s: missing args", a.Action)
+	}
+	return json.Unmarshal(a.Args, value)
+}
+
+// Nested decodes the arguments of the action as a nested action, e.g. the
+// `{"action": "AddToLibrary", "args": ...}` of a `Ctx` action.
+func (a *Action) Nested() (*Action, error) {
+	var nested Action
+	if err := a.DecodeArgs(&nested); err != nil {
+		return nil, err
+	}
+	if nested.Action == "" {
+		return nil, fmt.Errorf("action %s: missing nested action name", a.Action)
+	}
+	return &nested, nil
+}
+
+// Load decodes the arguments of a Load action into the model name and its arguments.
+func (a *Action) Load() (string, json.RawMessage, error) {
+	var args struct {
+		Model string          `json:"model"`
+		Args  json.RawMessage `json:"args"`
+	}
+	if err := a.DecodeArgs(&args); err != nil {
+		return "", nil, err
+	}
+	return args.Model, args.Args, nil
+}
+
+// NestedAction returns the nested action of an action named name, or nil
+// if the message is not such an action or the nested action is invalid.
+func (m *Msg) NestedAction(name string) *Action {
+	if !m.IsAction(name) {
+		return nil
+	}
+	nested, err := m.Action.Nested()
+	if err != nil {
+		return nil
+	}
+	return nested
+}
+
+// LoadModel returns the arguments of a Load action for the given model.
+func (m *Msg) LoadModel(model string) (json.RawMessage, bool) {
+	if !m.IsAction(ActionNameLoad) {
+		return nil, false
+	}
+	name, args, err := m.Action.Load()
+	if err != nil || name != model {
+		return nil, false
+	}
+	return args, true
+}
