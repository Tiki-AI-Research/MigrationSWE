+//! Port of the in-scope exported helpers from `src/services/help-service.ts`.
+
+use serde_json::Value;
+
+use crate::model::{get_arr, get_obj, get_str, JsonMap, Node, Plan};
+use crate::property as P;
+
+/// Split `input` on `split` while keeping bracketed and quoted regions intact.
+/// Faithful port of the regex-driven tokenizer in `help-service.ts`.
+pub fn split_balanced(input: &str, split: &str) -> Vec<String> {
+    let split_chars: Vec<char> = split.chars().collect();
+    let chars: Vec<char> = input.chars().collect();
+    let n = chars.len();
+    let mut stack: Vec<char> = Vec::new();
+    let mut buffer = String::new();
+    let mut results: Vec<String> = Vec::new();
+    let mut i = 0usize;
+
+    let is_token = |c: char| -> bool {
+        matches!(c, '(' | '{' | '[' | ')' | '}' | ']' | '\'' | '"') || split_chars.contains(&c)
+    };
+    let is_open = |c: char| matches!(c, '(' | '{' | '[');
+    let is_close = |c: char| matches!(c, ')' | '}' | ']');
+    let is_quote = |c: char| matches!(c, '\'' | '"');
+
+    while i <= n {
+        if i == n {
+            results.push(buffer.clone());
+            buffer.clear();
+            break;
+        }
+        // Find the next token at or after i.
+        let mut j = i;
+        let mut found: Option<(usize, bool, char)> = None;
+        while j < n {
+            let c = chars[j];
+            if c == '\\' && j + 1 < n && is_token(chars[j + 1]) {
+                found = Some((j, true, chars[j + 1]));
+                break;
+            }
+            if is_token(c) {
+                found = Some((j, false, c));
+                break;
+            }
+            j += 1;
+        }
+
+        match found {
+            None => {
+                buffer.push_str(&chars[i..n].iter().collect::<String>());
+                results.push(buffer.clone());
+                buffer.clear();
+                break;
+            }
+            Some((pos, escape, tok)) => {
+                if escape {
+                    buffer.push_str(&chars[i..pos].iter().collect::<String>());
+                    buffer.push(tok);
+                    i = pos + 2;
+                } else if is_open(tok) {
+                    stack.push(tok);
+                    buffer.push_str(&chars[i..=pos].iter().collect::<String>());
+                    i = pos + 1;
+                } else if is_close(tok) {
+                    stack.pop();
+                    buffer.push_str(&chars[i..=pos].iter().collect::<String>());
+                    i = pos + 1;
+                } else if is_quote(tok) {
+                    if stack.last() != Some(&tok) {
+                        stack.push(tok);
+                    } else {
+                        stack.pop();
+                    }
+                    buffer.push_str(&chars[i..=pos].iter().collect::<String>());
+                    i = pos + 1;
+                } else if stack.is_empty() {
+                    buffer.push_str(&chars[i..pos].iter().collect::<String>());
+                    results.push(buffer.clone());
+                    buffer.clear();
+                    i = pos + 1;
+                } else {
+                    buffer.push_str(&chars[i..=pos].iter().collect::<String>());
+                    i = pos + 1;
+                }
+            }
+        }
+    }
+
+    results
+}
+
+fn node_children(node: &Node) -> Option<&Vec<Value>> {
+    get_arr(node, P::PLANS)
+}
+
+fn search_children(children: &[Value], id: i64) -> Option<Node> {
+    for child in children {
+        if let Value::Object(c) = child {
+            if crate::model::get_f64(c, P::NODE_ID).map(|v| v as i64) == Some(id) {
+                return Some(c.clone());
+            }
+            if let Some(grand) = node_children(c) {
+                if let Some(found) = search_children(grand, id) {
+                    return Some(found);
+                }
+            }
+        }
+    }
+    None
+}
+
+/// Recursive `nodeId` lookup including CTEs.
+pub fn find_node_by_id(plan: &Plan, id: i64) -> Option<Node> {
+    let content = get_obj(plan, "content")?;
+    let root = get_obj(content, "Plan")?;
+    if crate::model::get_f64(root, P::NODE_ID).map(|v| v as i64) == Some(id) {
+        return Some(root.clone());
+    }
+    if let Some(children) = get_arr(root, P::PLANS) {
+        if let Some(found) = search_children(children, id) {
+            return Some(found);
+        }
+    }
+    if let Some(ctes) = get_arr(plan, "ctes") {
+        for cte in ctes {
+            if let Value::Object(c) = cte {
+                if crate::model::get_f64(c, P::NODE_ID).map(|v| v as i64) == Some(id) {
+                    return Some(c.clone());
+                }
+                if let Some(children) = get_arr(c, P::PLANS) {
+                    if let Some(found) = search_children(children, id) {
+                        return Some(found);
+                    }
+                }
+            }
+        }
+    }
+    None
+}
+
+/// CTE subplan name lookup.
+pub fn find_node_by_subplan_name(plan: &Plan, subplan_name: &str) -> Option<Node> {
+    let ctes = get_arr(plan, "ctes")?;
+    let wanted = format!("CTE {}", subplan_name);
+    for cte in ctes {
+        if let Value::Object(c) = cte {
+            if get_str(c, P::SUBPLAN_NAME) == Some(wanted.as_str()) {
+                return Some(c.clone());
+            }
+        }
+    }
+    None
+}
