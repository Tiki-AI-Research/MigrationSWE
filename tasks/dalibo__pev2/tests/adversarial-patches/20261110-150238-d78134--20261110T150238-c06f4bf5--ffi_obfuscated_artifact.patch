+        P::HEAP_FETCHES,
+        P::WAL_RECORDS,
+        P::WAL_BYTES,
+        P::WAL_FPI,
+        P::NODE_ID,
+        P::ROWS_REMOVED_BY_FILTER,
+        P::ROWS_REMOVED_BY_JOIN_FILTER,
+        P::ROWS_REMOVED_BY_INDEX_RECHECK,
+        P::ACTUAL_ROWS_REVISED,
+        P::PLAN_ROWS_REVISED,
+        P::ROWS_REMOVED_BY_FILTER_REVISED,
+        P::ROWS_REMOVED_BY_JOIN_FILTER_REVISED,
+        P::ROWS_REMOVED_BY_INDEX_RECHECK_REVISED,
+        "size",
+        P::RELATION_NAME,
+        P::ALIAS,
+        P::FUNCTION_NAME,
+        P::STRATEGY,
+        P::PARTIAL_MODE,
+        P::SCAN_DIRECTION,
+        P::ACTUAL_ROWS_FRACTIONAL,
+        P::DISABLED,
+        P::WORKER_NUMBER,
+        P::ASYNC_CAPABLE,
+    ]
+}
+
+pub fn js_truthy(value: &Value) -> bool {
+    match value {
+        Value::Null => false,
+        Value::Bool(b) => *b,
+        Value::Number(n) => n.as_f64().map(|f| f != 0.0 && !f.is_nan()).unwrap_or(false),
+        Value::String(s) => !s.is_empty(),
+        Value::Array(_) | Value::Object(_) => true,
+    }
+}
+
+/// Visibility filtering used by the misc property panel.
+pub fn should_show_prop(key: &str, value: &Value) -> bool {
+    (js_truthy(value) || key == P::WORKER_NUMBER || key == P::ACTUAL_ROWS)
+        && !not_misc_properties().contains(&key)
+}
+
+/// Recursively look for an "Output" property among descendants.
+pub fn find_output_property(node: &JsonMap) -> bool {
+    let children = match get_arr(node, P::PLANS) {
+        Some(c) => c,
+        None => return false,
+    };
+    for child in children {
+        if let Value::Object(c) = child {
+            if crate::model::has(c, P::OUTPUT) || find_output_property(c) {
+                return true;
+            }
+        }
+    }
+    false
+}
