+#[test]
+fn hash_key_splits_on_comma_without_space() {
+    let source = r#"
+ Nested Loop  (cost=0.00..1.00 rows=1 width=4)
+   ->  Seq Scan on t  (cost=0.00..1.00 rows=1 width=4)
+         Hash Key: a,b
+"#;
+    let root = root_of(source);
+    let child = &root.get("Plans").unwrap().as_array().unwrap()[0];
+    let hash_keys = child
+        .get("Grouping Sets")
+        .and_then(|v| v.as_array())
+        .and_then(|a| a.first())
+        .and_then(|s| s.get("Hash Keys"))
+        .and_then(|v| v.as_array())
+        .and_then(|a| a.first())
+        .and_then(|v| v.as_array())
+        .expect("hash keys");
+    assert_eq!(hash_keys.len(), 2);
+    assert_eq!(hash_keys[0].as_str(), Some("a"));
+    assert_eq!(hash_keys[1].as_str(), Some("b"));
+}
