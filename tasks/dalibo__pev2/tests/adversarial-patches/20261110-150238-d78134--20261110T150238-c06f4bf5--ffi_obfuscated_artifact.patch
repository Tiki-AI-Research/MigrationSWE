+#[test]
+fn serialization_and_planning() {
+    let source = r#"
+ Seq Scan on people  (cost=0.00..22.70 rows=1270 width=32) (actual time=0.012..0.030 rows=100.00 loops=1)
+   Buffers: shared hit=1
+ Planning:
+   Buffers: shared hit=6
+   Memory: used=6kB  allocated=8kB
+ Planning Time: 0.065 ms
+ Serialization: time=4.690 ms  output=31251kB  format=text
+   Buffers: shared hit=200
+ Execution Time: 4.812 ms
+(9 rows)
+    "#;
+    let plan = plan_of(source);
+    let content = plan.get("content").unwrap();
+    assert_eq!(content.get("Planning Time").and_then(|v| v.as_f64()), Some(0.065));
+    let ser = content.get("Serialization").unwrap();
+    assert_eq!(ser.get("Time").and_then(|v| v.as_f64()), Some(4.69));
+    assert_eq!(ser.get("Output Volume").and_then(|v| v.as_i64()), Some(31251));
+    let planning = content.get("Planning").unwrap();
+    assert_eq!(planning.get("Shared Hit Blocks").and_then(|v| v.as_i64()), Some(6));
+    assert_eq!(planning.get("Shared Read Blocks").and_then(|v| v.as_i64()), Some(0));
+    assert_eq!(planning.get("Memory Used").and_then(|v| v.as_i64()), Some(6));
+    assert_eq!(planning.get("Memory Allocated").and_then(|v| v.as_i64()), Some(8));
+}
