+//! Ports of the inline `PlanService` Vitest specs that exercise parsing and
+//! derived metrics.
+
+use pev2_core::{create_plan, find_node_by_id, from_source, from_text};
+use serde_json::Value;
+
+fn plan_of(source: &str) -> Value {
+    let content = from_source(source).expect("parse");
+    let plan = create_plan("", content, "").expect("createPlan");
+    serde_json::to_value(&plan).unwrap()
+}
+
+fn root_of(source: &str) -> Value {
+    plan_of(source)
+        .get("content")
+        .and_then(|c| c.get("Plan"))
+        .cloned()
+        .unwrap()
+}
+
+fn f(v: &Value, key: &str) -> f64 {
+    v.get(key).and_then(|x| x.as_f64()).unwrap_or(f64::NAN)
+}
+
+fn approx(a: f64, b: f64) {
+    assert!((a - b).abs() < 1e-6, "expected {b}, got {a}");
+}
+
+#[test]
+fn actual_durations_loops() {
+    let source = r#"
+ Nested Loop  (cost=0.00..611.27 rows=13400 width=8) (actual time=0.025..10.198 rows=34956 loops=1)
+   Join Filter: (t1.c1 > t2.c2)
+   Rows Removed by Join Filter: 5244
+   ->  Seq Scan on t1  (cost=0.00..6.02 rows=402 width=4) (actual time=0.013..0.058 rows=402 loops=1)
+   ->  Materialize  (cost=0.00..2.50 rows=100 width=4) (actual time=0.000..0.008 rows=100 loops=402)
+         ->  Seq Scan on t2  (cost=0.00..2.00 rows=100 width=4) (actual time=0.005..0.015 rows=100 loops=1)
+ Planning Time: 0.083 ms
+ Execution Time: 12.035 ms
+"#;
+    let root = root_of(source);
+    let plans = root.get("Plans").unwrap().as_array().unwrap();
+    let m = 0.008 * 402.0 - 0.015;
+    approx(f(&plans[1], "*Duration (exclusive)"), m);
+    let nl = 10.198 - (m + 0.015) - 0.058;
+    approx(f(&root, "*Duration (exclusive)"), nl);
+}
+
+#[test]
+fn actual_durations_parallel_from_json() {
+    let source = r#"
+[
+  { "Plan": {
+      "Node Type": "Gather Merge",
+      "Parallel Aware": false,
+      "Startup Cost": 735306.27,
+      "Total Cost": 1707599.95,
+      "Plan Rows": 8333364,
+      "Actual Startup Time": 1592.880,
+      "Actual Total Time": 3805.404,
+      "Actual Rows": 10000000,
+      "Actual Loops": 1,
+      "Workers Planned": 2,
+      "Workers Launched": 2,
+      "Plans": [
+        { "Node Type": "Sort", "Parent Relationship": "Outer",
+          "Startup Cost": 734306.25, "Total Cost": 744722.95,
+          "Plan Rows": 4166682,
+          "Actual Startup Time": 1517.978, "Actual Total Time": 2020.558,
+          "Actual Rows": 3333333, "Actual Loops": 3,
+          "Plans": [
+            { "Node Type": "Seq Scan", "Parent Relationship": "Outer",
+              "Parallel Aware": true, "Relation Name": "t1",
+              "Startup Cost": 0.00, "Total Cost": 105264.82,
+              "Plan Rows": 4166682,
+              "Actual Startup Time": 0.214, "Actual Total Time": 400.681,
+              "Actual Rows": 3333333, "Actual Loops": 3 } ] } ] },
+    "Planning Time": 0.158, "Triggers": [], "Execution Time": 4225.445 }
+]
+"#;
+    let root = root_of(source);
+    let sort = &root.get("Plans").unwrap().as_array().unwrap()[0];
+    let seq = &sort.get("Plans").unwrap().as_array().unwrap()[0];
+    approx(f(seq, "*Duration (exclusive)"), 400.681);
+    approx(f(sort, "*Duration (exclusive)"), 2020.558 - 400.681);
+}
+
+#[test]
+fn parallel_children_loops() {
+    let source = r#"
+Gather  (cost=1782.55..53030.40 rows=3 width=72) (actual time=70.029..383125.490 rows=367315 loops=1)
+    Workers Planned: 3
+    Workers Launched: 3
+  ->  Nested Loop Left Join  (cost=782.55..52030.10 rows=1 width=72) (actual time=58.605..382365.760 rows=91829 loops=4)
+        ->  Parallel Index Scan using bravo_papa_tango on victor_sierra  (cost=0.43..51194.00 rows=1 width=50) (actual time=3.162..122.561 rows=20339 loops=4)
+              Index Cond: (whiskey = 'sierra_five'::date)
+        ->  Index Scan using yankee on tango  (cost=0.42..2.65 rows=1 width=20) (actual time=0.013..0.013 rows=1 loops=81357)
+              Index Cond: (whiskey = 'sierra_five'::date)
+        ->  Bitmap Heap Scan on golf  (cost=780.29..826.90 rows=1 width=37) (actual time=17.007..18.601 rows=2 loops=81357)
+                ->  BitmapAnd  (cost=780.29..780.29 rows=1583 width=0) (actual time=15.192..15.192 rows=0 loops=81357)
+                      ->  Bitmap Index Scan on echo  (cost=0.00..254.44 rows=15129 width=0) (actual time=1.009..1.009 rows=16719 loops=81357)
+                            Index Cond: ((whiskey = 'sierra_five'::date))
+                      ->  Bitmap Index Scan on mike_uniform  (cost=0.00..523.24 rows=52187 width=0) (actual time=14.023..14.023 rows=284399 loops=81357)
+                            Index Cond: ((hotel = tango.hotel))
+"#;
+    let content = from_source(source).unwrap();
+    let plan = create_plan("", content, "").unwrap();
+    let node = find_node_by_id(&plan, 6).expect("node 6");
+    let d = node.get("*Duration (exclusive)").and_then(|v| v.as_f64()).unwrap();
+    assert!(d > 0.0, "duration should be positive, got {}", d);
+}
+
+#[test]
+fn wal_parsing() {
+    let source = r#"
+ Limit  (cost=96.31..96.51 rows=10 width=4) (actual time=0.059..0.086 rows=10 loops=1)
+   Buffers: shared hit=21
+   WAL: records=20 bytes=1320
+   CTE x1
+     ->  Update on titi  (cost=0.00..96.31 rows=5865 width=10) (actual time=0.056..11.377 rows=5000 loops=1)
+           WAL: records=10000 bytes=660000
+   ->  CTE Scan on x1  (cost=0.00..117.30 rows=5865 width=4) (actual time=0.058..0.082 rows=10 loops=1)
+         WAL: records=20 bytes=1320
+ Planning Time: 0.098 ms
+ Execution Time: 11.797 ms
+"#;
+    let root = root_of(source);
+    assert_eq!(root.get("WAL Records").and_then(|v| v.as_i64()), Some(20));
+    assert_eq!(root.get("WAL Bytes").and_then(|v| v.as_i64()), Some(1320));
+    assert_eq!(root.get("WAL FPI").and_then(|v| v.as_i64()), Some(0));
+}
+
+#[test]
+fn subquery_scan_alias() {
+    let source = r#"
+ Subquery Scan on foo  (cost=0.00..2.27 rows=1 width=265)
+   Filter: (foo.relname = 'aa'::name)
+   ->  Limit  (cost=0.00..1.77 rows=40 width=265)
+         ->  Seq Scan on pg_class  (cost=0.00..18.10 rows=410 width=265)
+(4 rows)
+"#;
+    let root = root_of(source);
+    assert_eq!(root.get("Node Type").and_then(|v| v.as_str()), Some("Subquery Scan"));
+    assert_eq!(root.get("Alias").and_then(|v| v.as_str()), Some("foo"));
+}
+
+#[test]
+fn quoted_last_line() {
+    let source = "\"Aggregate  (cost=24729994.62..24729994.63 rows=1 width=8) (actual time=126922.755..126980.072 rows=1 loops=1)\"\n\"  Buffers: shared hit=31033317 read=640327, temp read=271916 written=271928\"\n\"Planning:\"\n\"  Buffers: shared hit=227 read=9\"\n\"Planning Time: 14.620 ms\"\n\"JIT:\"\n\"  Functions: 829\"\n\"  Options: Inlining true, Optimization true, Expressions true, Deforming true\"\n\"  Timing: Generation 113.965 ms, Inlining 706.405 ms, Optimization 7838.603 ms, Emission 7380.843 ms, Total 16039.815 ms\"\n\"Execution Time: 127241.780 ms\"";
+    let content = from_source(source).unwrap();
+    assert_eq!(content.get("Execution Time").and_then(|v| v.as_f64()), Some(127241.78));
+}
+
+#[test]
+fn insert_modifytable_text_and_json() {
+    let source = r#"
+      Insert on foo  (cost=0.00..0.01 rows=1 width=24) (actual time=0.504..0.505 rows=0 loops=1)
