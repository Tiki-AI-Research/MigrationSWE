+/// Map an upper-snake constant name (as built by the metric code) to the
+/// corresponding output property string. Mirrors `Property[name]` lookups.
+pub fn lookup(name: &str) -> Option<&'static str> {
+    Some(match name {
+        "ACTUAL_LOOPS" => ACTUAL_LOOPS,
+        "ACTUAL_ROWS" => ACTUAL_ROWS,
