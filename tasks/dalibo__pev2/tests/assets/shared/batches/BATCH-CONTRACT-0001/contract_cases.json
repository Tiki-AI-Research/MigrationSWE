{
  "schema_version": "migration-contract-cases:v1",
  "batch_id": "BATCH-CONTRACT-0001",
  "description": "Executable public-contract probes for the pev2 TypeScript -> Rust migration. Each case names one owned CONTRACT observation and one or more probes. A probe invokes the same public entry point on both the source (TypeScript PlanService / exported helpers) and the target (Rust pev2_core) and contributes one normalized value per side.",
  "normalization": {
    "string": "collapse internal runs of whitespace to a single space and trim",
    "number": "parse as f64",
    "boolean": "identity",
    "error": "{\"__error__\": <message normalized as string>}",
    "missing": "{\"__missing__\": true}",
    "json": "recursively normalize then serialize with sorted object keys"
  },
  "cases": [
