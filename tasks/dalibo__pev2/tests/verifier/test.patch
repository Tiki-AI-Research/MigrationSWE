diff --git a/tests/source/batches/BATCH-CONTRACT-0001/contract_probe.mjs b/tests/source/batches/BATCH-CONTRACT-0001/contract_probe.mjs
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-CONTRACT-0001/contract_probe.mjs
@@ -0,0 +1,198 @@
+#!/usr/bin/env node
+// Source-side adapter for BATCH-CONTRACT-0001.
+//
+// Reads the shared contract cases and evaluates every probe against the
+// public TypeScript surface (PlanService and the exported helper functions).
+// Emits one normalized value per probe so the CONTRACT harness can compare the
+// source and target sides for equality after normalization.
+//
+// Usage:
+//   node contract_probe.mjs [--repo <source-repo>] [--cases <cases.json>] [--out <json>]
+//
+// The source repo must be importable as ESM/TypeScript (run under `tsx` or a
+// Node build with type stripping available). Only the public entry points are
+// touched; the private `getPlanContent` helper is reached through a subclass to
+// keep R023/R024 observable.
+
+import { readFileSync, writeFileSync } from "node:fs";
+import { pathToFileURL } from "node:url";
+import path from "node:path";
+
+function parseArgs(argv) {
+  const out = {};
+  for (let i = 0; i < argv.length; i += 1) {
+    const key = argv[i];
+    if (key.startsWith("--")) {
+      out[key.slice(2)] = argv[i + 1];
+      i += 1;
+    }
+  }
+  return out;
+}
+
+const options = parseArgs(process.argv.slice(2));
+const here = path.dirname(new URL(import.meta.url).pathname);
+const repo = options.repo || process.env.SOURCE_REPO || "/workspace/repo";
+const casesPath =
+  options.cases ||
+  process.env.CONTRACT_CASES ||
+  path.resolve(here, "../../../shared/batches/BATCH-CONTRACT-0001/contract_cases.json");
+
+const PLAN_SERVICE = path.join(repo, "src/services/plan-service.ts");
+const HELP_SERVICE = path.join(repo, "src/services/help-service.ts");
+const INTERFACES = path.join(repo, "src/interfaces.ts");
+
+const casesDoc = JSON.parse(readFileSync(casesPath, "utf8"));
+
+const service = await import(pathToFileURL(PLAN_SERVICE).href);
+const help = await import(pathToFileURL(HELP_SERVICE).href);
+const ifaces = await import(pathToFileURL(INTERFACES).href);
+
+const PlanService = service.PlanService;
+const NodeCtor = ifaces.Node;
+
+function newService() {
+  return new PlanService();
+}
+
+// Reach the private helper without changing the public class.
+class ProbeService extends PlanService {
+  getPlanContentPublic(value) {
+    return this.getPlanContent(value);
+  }
+}
+
+function extract(value, trail) {
+  if (trail === undefined || trail === null) return value;
+  let current = value;
+  for (const step of trail) {
+    if (current === null || current === undefined) {
+      return { __missing__: true };
+    }
+    current = current[step];
+  }
+  if (current === undefined) return { __missing__: true };
+  return current;
+}
+
+function normalize(value) {
+  if (value === null || value === undefined) return value === undefined ? { __missing__: true } : null;
+  if (typeof value === "string") return value.replace(/\s+/g, " ").trim();
+  if (typeof value === "number" || typeof value === "boolean") return value;
+  if (Array.isArray(value)) return value.map(normalize);
+  if (typeof value === "object") {
+    const out = {};
+    for (const key of Object.keys(value).sort()) out[key] = normalize(value[key]);
+    return out;
+  }
+  return String(value);
+}
+
+function callSource(fn, args) {
+  const svc = new ProbeService();
+  switch (fn) {
+    case "from_source":
+      return svc.fromSource(args[0]);
+    case "from_text":
+      return svc.fromText(args[0]);
+    case "from_json":
+      return svc.fromJson(args[0]);
+    case "cleanup_source":
+      return svc.cleanupSource(args[0]);
+    case "split_into_lines":
+      return svc.splitIntoLines(args[0]);
+    case "create_plan":
+      return svc.createPlan(args[0], args[1], args[2]);
+    case "from_source_then_create_plan": {
+      const content = svc.fromSource(args[0]);
+      const name = args.length > 1 ? args[1] : "";
+      const query = args.length > 2 ? args[2] : "";
+      return svc.createPlan(name, content, query);
+    }
+    case "get_plan_content":
+      return svc.getPlanContentPublic(JSON.parse(args[0]));
+    case "split_balanced":
+      return help.splitBalanced(args[0], args[1]);
+    case "should_show_prop":
+      return help.shouldShowProp(args[0], args[1]);
+    case "parse_node_type":
+      return new NodeCtor(args[0]);
+    case "find_node_by_id_present": {
+      const content = svc.fromSource(args[0]);
+      const plan = svc.createPlan("", content, "");
+      return help.findNodeById(plan, args[1]) !== undefined;
+    }
+    case "find_node_by_subplan_name_absent": {
+      const content = svc.fromSource(args[0]);
+      const plan = svc.createPlan("", content, "");
+      return help.findNodeBySubplanName(plan, args[1]) === undefined;
+    }
+    case "public_entry_points": {
+      const names = [
+        "createPlan",
+        "cleanupSource",
+        "findNodeById",
+        "findNodeBySubplanName",
+        "fromJson",
+        "fromSource",
+        "fromText",
+        "shouldShowProp",
+        "splitBalanced",
+        "splitIntoLines"
+      ];
+      return names
+        .slice()
+        .sort()
+        .map((n) => n)
+        .filter((n) => {
+          if (typeof svc[n] === "function") return true;
+          return typeof help[n] === "function";
+        })
+        .map((n) => n.replace(/[A-Z]/g, (c) => "_" + c.toLowerCase()));
+    }
+    default:
+      throw new Error(`unknown function ${fn}`);
+  }
+}
+
+const results = [];
+for (const testCase of casesDoc.cases) {
+  for (let index = 0; index < testCase.probes.length; index += 1) {
+    const probe = testCase.probes[index];
+    const record = {
+      observation_id: testCase.observation_id,
+      probe_index: index,
+      fn: probe.fn
+    };
+    try {
+      let value = callSource(probe.fn, probe.args);
+      if (probe.present_keys) {
+        const source = value;
+        value = probe.present_keys.every((k) => Object.prototype.hasOwnProperty.call(source, k));
+      } else if (probe.extract && probe.extract[0] === "length" && Array.isArray(value)) {
+        value = value.length;
+      } else if (probe.extract) {
+        value = extract(value, probe.extract);
+      }
+      record.status = "PASS";
+      record.value = normalize(value);
+    } catch (error) {
+      record.status = "PASS";
+      record.value = { __error__: String(error && error.message ? error.message : error).replace(/\s+/g, " ").trim() };
+    }
+    results.push(record);
+  }
+}
+
+const report = {
+  batch_id: casesDoc.batch_id,
+  side: "source",
+  normalization: casesDoc.normalization,
+  results
+};
+
+if (options.out) {
+  writeFileSync(options.out, JSON.stringify(report, null, 2));
+} else {
+  process.stdout.write(JSON.stringify(report));
+}
diff --git a/tests/source/batches/BATCH-CONTRACT-0002/contract-source.ts b/tests/source/batches/BATCH-CONTRACT-0002/contract-source.ts
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-CONTRACT-0002/contract-source.ts
@@ -0,0 +1,163 @@
+// Source-side CONTRACT probes for BATCH-CONTRACT-0002.
+// Executed in the source (TypeScript) container by source/batches/BATCH-CONTRACT-0002/run.sh.
+// Emits the normalized value of every CONTRACT observation on stdout as JSON.
+import { createHash } from "node:crypto"
+import { existsSync, readFileSync, readdirSync, statSync } from "node:fs"
+import { join } from "node:path"
+
+import { Property } from "@/enums"
+import { Node } from "@/interfaces"
+import {
+  findNodeById,
+  findNodeBySubplanName,
+  shouldShowProp,
+  splitBalanced,
+} from "@/services/help-service"
+import { PlanService } from "@/services/plan-service"
+
+const REPO_ROOT = process.env.REPO_ROOT ?? "/workspace/repo"
+
+const NODE_TYPE_CASES = [
+  "Index Scan using idx on t",
+  "Index Scan Backward using idx2 on t2 alias2",
+  "Bitmap Index Scan on bidx",
+  "Seq Scan on foo",
+  "Parallel Seq Scan on t",
+  "Async Foreign Scan on t",
+  "CTE Scan on cte1 alias_cte",
+  "Function Scan on fn alias_fn",
+  "Subquery Scan on sub",
+  "Nested Loop",
+  "Nested Loop Join",
+  "Merge Left Join",
+  "Hash Join",
+  "Hash Left Join",
+  "HashAggregate",
+  "GroupAggregate",
+  "MixedAggregate",
+]
+
+const NODE_TYPE_KEYS: string[] = [
+  Property.NODE_TYPE,
+  Property.RELATION_NAME,
+  Property.ALIAS,
+  Property.INDEX_NAME,
+  Property.SCAN_DIRECTION,
+  Property.JOIN_TYPE,
+  Property.PARTIAL_MODE,
+  Property.STRATEGY,
+  Property.PARALLEL_AWARE,
+  Property.ASYNC_CAPABLE,
+  Property.DISABLED,
+  Property.PLANNED_PARTITIONS,
+  Property.CTE_NAME,
+  Property.FUNCTION_NAME,
+]
+
+function proposal033(): Record<string, Record<string, unknown>> {
+  const out: Record<string, Record<string, unknown>> = {}
+  for (const c of NODE_TYPE_CASES) {
+    const node = new Node(c) as unknown as Record<string, unknown>
+    const kept: Record<string, unknown> = {}
+    for (const k of NODE_TYPE_KEYS) {
+      if (node[k] !== undefined) kept[k] = node[k]
+    }
+    out[c] = kept
+  }
+  return out
+}
+
+const CANONICAL_CAPABILITIES = [
+  "from_source",
+  "create_plan",
+  "from_text",
+  "from_json",
+  "cleanup_source",
+  "split_into_lines",
+  "split_balanced",
+  "find_node_by_id",
+  "find_node_by_subplan_name",
+  "should_show_prop",
+]
+
+function proposal034(): string[] {
+  const planService = new PlanService() as unknown as Record<string, unknown>
+  const presence: Record<string, boolean> = {
+    from_source: typeof planService.fromSource === "function",
+    create_plan: typeof planService.createPlan === "function",
+    from_text: typeof planService.fromText === "function",
+    from_json: typeof planService.fromJson === "function",
+    cleanup_source: typeof planService.cleanupSource === "function",
+    split_into_lines: typeof planService.splitIntoLines === "function",
+    split_balanced: typeof splitBalanced === "function",
+    find_node_by_id: typeof findNodeById === "function",
+    find_node_by_subplan_name: typeof findNodeBySubplanName === "function",
+    should_show_prop: typeof shouldShowProp === "function",
+  }
+  return CANONICAL_CAPABILITIES.filter((c) => presence[c])
+}
+
+const PROTECTED_ROOTS = ["src/services/__tests__", "src/__tests__", "tests/e2e"]
+
+function walk(dir: string, acc: string[]): void {
+  for (const entry of readdirSync(dir)) {
+    const full = join(dir, entry)
+    if (statSync(full).isDirectory()) walk(full, acc)
+    else acc.push(full)
+  }
+}
+
+function proposal035(): string {
+  const files: string[] = []
+  for (const r of PROTECTED_ROOTS) {
+    const abs = join(REPO_ROOT, r)
+    if (existsSync(abs)) walk(abs, files)
+  }
+  files.sort()
+  const h = createHash("sha256")
+  for (const f of files) {
+    const rel = f.slice(REPO_ROOT.length + 1)
+    const fh = createHash("sha256").update(readFileSync(f)).digest("hex")
+    h.update(`${rel}\n${fh}\n`)
+  }
+  return h.digest("hex")
+}
+
+function proposal036(): Record<string, unknown> {
+  const planService = new PlanService()
+  const text = readFileSync(
+    join(REPO_ROOT, "fixtures/batches/BATCH-CONTRACT-0002/genuine-plan.txt"),
+    "utf8",
+  ).trim()
+  const content = planService.fromSource(text)
+  const plan = planService.createPlan("", content, "SELECT  a     b")
+  const root = plan.content.Plan as Record<string, unknown>
+  return {
+    "Node Type": root[Property.NODE_TYPE],
+    "Plan Rows": root[Property.PLAN_ROWS],
+    "Total Cost": root[Property.TOTAL_COST],
+    isAnalyze: plan.isAnalyze,
+    maxEstimateFactor: plan.content.maxEstimateFactor,
+    query: plan.query,
+  }
+}
+
+function proposal037(): Record<string, unknown> {
+  return {
+    repo_root: REPO_ROOT,
+    base_commit_present: existsSync(join(REPO_ROOT, ".git")),
+  }
+}
+
+function main(): void {
+  const result = {
+    "CONTRACT-033": proposal033(),
+    "CONTRACT-034": proposal034(),
+    "CONTRACT-035": proposal035(),
+    "CONTRACT-036": proposal036(),
+    "CONTRACT-037": proposal037(),
+  }
+  process.stdout.write(JSON.stringify(result))
+}
+
+main()
