+++ b/tests/source/batches/BATCH-CONTRACT-0002/run.sh
@@ -0,0 +1,15 @@
+#!/bin/sh
+# Source-side CONTRACT probe runner for BATCH-CONTRACT-0002.
+# Every potentially long-running command is wrapped in an explicit `timeout`.
+# No privileged commands and no permanently blocking cases are executed.
+set -eu
+
+REPO_ROOT="${REPO_ROOT:-/workspace/repo}"
+SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+export REPO_ROOT
+
+if command -v vite-node >/dev/null 2>&1; then
+  exec timeout 900 vite-node "$SCRIPT_DIR/contract-source.ts"
+fi
+
+exec timeout 900 npx --no-install vite-node "$SCRIPT_DIR/contract-source.ts"
