--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0002/harness.py
@@ -0,0 +1,169 @@
+#!/usr/bin/env python3
+"""F2P source-side probe for BATCH-F2P-0002.
+
+Applies the *same semantic predicate* as the target harness: the requirement
+postconditions must be produced by the frozen target technology
+(Rust 1.83.0, `crates/pev2-core`). This probe inspects the source repository
+and, only when the required Rust target capability is present, executes the
+shared Rust probe. On the TypeScript source repository the capability is
+explicitly absent, so every observation is a semantic FAIL -- the source
+technology does not satisfy the target postcondition.
+
+No result is hardcoded by role: the outcome is derived from the inspected
+repository. Long-running commands are wrapped in an explicit ``timeout``.
+
+Usage:
+    python3 harness.py [REPORT] [--repo REPO_PATH] [--probe PROBE_RS]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+BATCH_ID = "BATCH-F2P-0002"
+HERE = Path(__file__).resolve().parent
+
+BUILD_TIMEOUT = 900
+RUN_TIMEOUT = 600
+
+OBSERVATIONS = [
+    "F2P-028", "F2P-040", "F2P-041", "F2P-042", "F2P-047", "F2P-027",
+    "F2P-030", "F2P-031", "F2P-036", "F2P-037", "F2P-045", "F2P-046",
+    "F2P-025", "F2P-026", "F2P-029", "F2P-032", "F2P-033", "F2P-034",
+    "F2P-035", "F2P-038", "F2P-039", "F2P-043", "F2P-044", "F2P-048",
+]
+
+
+def _has_registry(cargo_home: str | None) -> bool:
+    if not cargo_home:
+        return False
+    cache = Path(cargo_home) / "registry" / "cache"
+    try:
+        return cache.is_dir() and any(cache.iterdir())
+    except OSError:
+        return False
+
+
+def resolve_repo(explicit: str | None) -> Path:
+    candidates = []
+    if explicit:
+        candidates.append(Path(explicit))
+    env_repo = os.environ.get("SOURCE_REPO")
+    if env_repo:
+        candidates.append(Path(env_repo))
+    candidates.extend([Path("/workspace/repo"), Path("/input/source")])
+    for candidate in candidates:
+        if candidate.is_dir():
+            return candidate
+    raise SystemExit("source repository not found")
+
+
+def rust_target_capability(repo: Path) -> bool:
+    """True only when the repository provides the frozen Rust target crate."""
+    return (repo / "Cargo.toml").is_file() and (
+        repo / "crates" / "pev2-core" / "Cargo.toml"
+    ).is_file()
+
+
+def run_shared_probe(repo: Path, probe: Path) -> dict | None:
+    """Run the shared Rust probe when a real target capability exists."""
+    workdir = Path(tempfile.mkdtemp(prefix="f2p-0002-src-"))
+    try:
+        dst = workdir / "repo"
+        copied = subprocess.run(
+            ["timeout", "300", "cp", "-a", str(repo), str(dst)],
+            capture_output=True, text=True, timeout=360, check=False,
+        )
+        if copied.returncode != 0:
+            return None
+        examples = dst / "crates" / "pev2-core" / "examples"
+        examples.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(probe, examples / "f2p_probe.rs")
+
+        env = dict(os.environ)
+        env.setdefault("CARGO_NET_OFFLINE", "true")
+        if not _has_registry(env.get("CARGO_HOME")) and _has_registry(
+            "/opt/migration/dependencies/cargo"
+        ):
+            env["CARGO_HOME"] = "/opt/migration/dependencies/cargo"
+
+        proc = subprocess.run(
+            [
+                "timeout", str(BUILD_TIMEOUT),
+                "cargo", "run", "--locked", "--offline",
+                "--manifest-path", str(dst / "Cargo.toml"), "--example", "f2p_probe",
+            ],
+            cwd=str(dst), capture_output=True, text=True,
+            timeout=BUILD_TIMEOUT + 30, env=env, check=False,
+        )
+        if proc.returncode != 0 or not proc.stdout.strip():
+            return None
+        return json.loads(proc.stdout.strip().splitlines()[-1])
+    except (OSError, ValueError):
+        return None
+    finally:
+        shutil.rmtree(workdir, ignore_errors=True)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("report", nargs="?", default=None)
+    parser.add_argument("--repo", default=None)
+    parser.add_argument("--probe", default=None)
+    args = parser.parse_args()
+
+    repo = resolve_repo(args.repo)
+    observations: dict[str, dict] = {}
+
+    if rust_target_capability(repo):
+        probe = Path(args.probe) if args.probe else (HERE.parent.parent.parent / "target" / "batches" / BATCH_ID / "f2p_probe.rs")
+        probe_result = run_shared_probe(repo, probe) if probe.is_file() else None
+        if probe_result is None:
+            for obs in OBSERVATIONS:
+                observations[obs] = {
+                    "ok": False,
+                    "detail": "target Rust capability present but probe could not be executed",
+                }
+        else:
+            for obs in OBSERVATIONS:
+                observations[obs] = probe_result.get(
+                    obs, {"ok": False, "detail": "missing from probe output"}
+                )
+    else:
+        reason = (
+            "required Rust 1.83.0 pev2-core target capability absent: "
+            "source repository has no Cargo.toml crate implementing the "
+            "in-scope parsing/metric responsibilities natively"
+        )
+        for obs in OBSERVATIONS:
+            observations[obs] = {"ok": False, "detail": reason}
+
+    payload = {
+        "batch_id": BATCH_ID,
+        "kind": "F2P",
+        "side": "source",
+        "repo": str(repo),
+        "observations": observations,
+    }
+    text = json.dumps(payload, indent=2, sort_keys=True)
+    if args.report:
+        report_path = Path(args.report)
+        report_path.parent.mkdir(parents=True, exist_ok=True)
+        report_path.write_text(text)
+    else:
+        print(text)
+
+    passed = [obs for obs in OBSERVATIONS if observations[obs].get("ok")]
+    # F2P requires every source observation to FAIL; any PASS is a problem.
+    return 0 if not passed else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
