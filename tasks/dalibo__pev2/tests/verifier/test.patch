+#!/usr/bin/env python3
+"""Source-side probe for BATCH-DIFFERENTIAL-0001.
+
+Establishes the TypeScript source expectation side of the differential
+comparison on ``/input/source``. The protected Vitest specifications and the
+``from-text`` fixtures are treated as read-only evidence; this probe records
+whether the source oracle is available and, when an explicit oracle command is
+provided, replays it to refresh the normalized expectations.
+
+Long-running commands are always wrapped in an explicit ``timeout``.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+sys.dont_write_bytecode = True
+
+BATCH_ID = "BATCH-DIFFERENTIAL-0001"
+KIND = "DIFFERENTIAL"
+ORACLE_TIMEOUT_SEC = 900
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+SHARED = ROOT / "shared" / "batches" / BATCH_ID
+sys.path.insert(0, str(SHARED))
+
+try:
+    import corpus as corpus_mod  # type: ignore
+except Exception:  # pragma: no cover
+    corpus_mod = None
+
+ORACLE_FILES = [
+    "src/services/plan-service.ts",
+    "src/services/help-service.ts",
+    "src/enums.ts",
+    "src/interfaces.ts",
+]
+
+
+def timeout_cmd(seconds: int, argv: list[str]) -> list[str]:
+    exe = shutil.which("timeout")
+    return [exe, str(seconds), *argv] if exe else argv
+
+
+def main() -> int:
+    report_path = Path(sys.argv[1]) if len(sys.argv) > 1 else None
+    source_repo = Path(os.environ.get("MIGRATION_SOURCE", "/input/source"))
+    corpus = corpus_mod.load_corpus() if corpus_mod is not None else {"cases": []}
+    ids = [c["observation_id"] for c in corpus["cases"]]
+
+    missing = [p for p in ORACLE_FILES if not (source_repo / p).exists()]
+    evidence = [{"path": p, "present": (source_repo / p).exists()} for p in ORACLE_FILES]
+
+    status = "pass"
+    detail = ""
+    oracle_output: list[str] = []
+
+    if missing:
+        status = "fail"
+        detail = "missing source oracle files: " + ", ".join(missing)
+    else:
+        oracle_cmd = os.environ.get("DIFF_SOURCE_ORACLE_CMD")
+        if oracle_cmd:
+            argv = oracle_cmd.split() + ["--report", "-"]
+            try:
+                proc = subprocess.run(
+                    timeout_cmd(ORACLE_TIMEOUT_SEC, argv),
+                    cwd=str(source_repo),
+                    stdout=subprocess.PIPE,
+                    stderr=subprocess.STDOUT,
+                    text=True,
+                    timeout=ORACLE_TIMEOUT_SEC + 60,
+                    errors="replace",
+                )
+                oracle_output = proc.stdout.splitlines()
+                if proc.returncode != 0:
+                    status = "fail"
+                    detail = f"source oracle exited {proc.returncode}"
+            except subprocess.TimeoutExpired:
+                status = "fail"
+                detail = "source oracle exceeded the explicit timeout"
+        else:
+            detail = "source oracle command not provided; verified protected surfaces only"
+
+    report = {
+        "batch_id": BATCH_ID,
+        "kind": KIND,
+        "source_repo": str(source_repo),
+        "status": status,
+        "detail": detail,
+        "observations": ids,
+        "evidence": evidence,
+        "oracle_invoked": bool(os.environ.get("DIFF_SOURCE_ORACLE_CMD")),
+        "oracle_output_tail": oracle_output[-20:],
+    }
+    text = json.dumps(report, indent=2, ensure_ascii=False)
+    if report_path is not None:
+        report_path.parent.mkdir(parents=True, exist_ok=True)
+        report_path.write_text(text, encoding="utf-8")
+    else:
+        print(text)
+    return 0 if status == "pass" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
