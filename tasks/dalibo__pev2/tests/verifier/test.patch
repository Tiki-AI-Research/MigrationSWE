+++ b/tests/source/batches/BATCH-P2P-0001/run-p2p.sh
@@ -0,0 +1,97 @@
+#!/bin/sh
+# BATCH-P2P-0001 source-side executable P2P projection.
+#
+# P2P is executable state preservation: this runner executes the source
+# repository's own test command inside its own container and maps every owned
+# P2P observation of this batch to the raw PASS/FAIL produced by that real
+# execution. It never waits forever: every potentially long-running command is
+# wrapped in an explicit `timeout` that hard-kills the process group.
+#
+# This file is deliberately POSIX `sh` only (no bash arrays, no `pipefail`, no
+# process substitution) so that static `sh -n` validation and any POSIX shell
+# invocation succeed.
+#
+# The emitted report and the stdout projection have the exact same shape as the
+# target-side harness so that, after normalization, both sides compare equal.
+set -u
+
+REPORT="${1:-/logs/result.json}"
+REPO="${REPO_ROOT:-/workspace/repo}"
+TIMEOUT_SECONDS="${P2P_TIMEOUT_SECONDS:-1800}"
+BATCH_ID="BATCH-P2P-0001"
+
+# Observation IDs owned by this batch. Used as a fallback when the shared
+# fixture cannot be located at runtime.
+FALLBACK_IDS="P2P-001 P2P-002 P2P-003 P2P-004 P2P-005 P2P-006 P2P-007 P2P-008 P2P-009 P2P-010 P2P-011 P2P-012 P2P-013 P2P-014 P2P-015 P2P-016 P2P-017 P2P-018 P2P-019 P2P-020 P2P-021 P2P-022 P2P-023 P2P-024 P2P-025 P2P-026 P2P-027 P2P-028 P2P-029 P2P-030 P2P-031 P2P-032 P2P-033 P2P-034 P2P-035 P2P-036 P2P-037 P2P-038 P2P-039 P2P-040"
+
+run_with_timeout() {
+  # Hard kill after the timeout; never wait forever.
+  timeout -s KILL "$TIMEOUT_SECONDS" "$@"
+}
+
+# Resolve the per-observation fixture so every owned observation ID is covered.
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
+OBS_FILE=""
+for candidate in \
+  "${P2P_OBSERVATIONS:-}" \
+  "/assets/fixtures/batches/${BATCH_ID}/observations.json" \
+  "${SCRIPT_DIR}/../../../fixtures/batches/${BATCH_ID}/observations.json"; do
+  if [ -n "$candidate" ] && [ -f "$candidate" ]; then
+    OBS_FILE="$candidate"
+    break
+  fi
+done
+
+OBSERVATION_IDS=""
+if [ -n "$OBS_FILE" ]; then
+  OBSERVATION_IDS=$(grep -oE '"id"[[:space:]]*:[[:space:]]*"P2P-[0-9]+"' "$OBS_FILE" 2>/dev/null \
+    | grep -oE 'P2P-[0-9]+' | tr '\n' ' ')
+fi
+if [ -z "$OBSERVATION_IDS" ]; then
+  OBSERVATION_IDS="$FALLBACK_IDS"
+fi
+
+cd "$REPO" 2>/dev/null || echo "warning: cannot enter $REPO" >&2
+
+status="PASS"
+
+# 1) Execute the repository's own test suite when it is available offline.
+#    Falls back to the runtime-provided native test command otherwise.
+if [ -n "${P2P_SOURCE_TEST_COMMAND:-}" ]; then
+  run_with_timeout sh -c "$P2P_SOURCE_TEST_COMMAND" >/dev/null 2>&1 || status="FAIL"
+elif [ -x node_modules/.bin/vitest ]; then
+  run_with_timeout node_modules/.bin/vitest --run >/dev/null 2>&1 || status="FAIL"
+elif command -v npm >/dev/null 2>&1 && [ -d node_modules ]; then
+  run_with_timeout npm test >/dev/null 2>&1 || status="FAIL"
+fi
+
+# 2) The migration baseline must be preserved: no tracked modifications.
+if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
+  run_with_timeout git diff --exit-code >/dev/null 2>&1 || status="FAIL"
+fi
+
+# 3) Protected tests/fixtures backing this batch must remain in place.
+if [ ! -f "src/__tests__/filters-formatDuration.spec.ts" ]; then
+  status="FAIL"
+fi
+
+# Emit the per-observation report (identical schema on both sides).
+mkdir -p "$(dirname "$REPORT")"
+{
+  printf '{\n'
+  printf '  "batch_id": "%s",\n' "$BATCH_ID"
+  printf '  "result": "%s",\n' "$status"
+  printf '  "observations": {\n'
+  first=1
+  for oid in $OBSERVATION_IDS; do
+    if [ "$first" -eq 1 ]; then
+      first=0
+    else
+      printf ',\n'
+    fi
+    printf '    "%s": {"result": "%s"}' "$oid" "$status"
+  done
+  printf '\n  }\n}\n'
+} > "$REPORT"
+
+printf '{"result": "%s"}\n' "$status"
