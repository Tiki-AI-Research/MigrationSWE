+            for ch in l.chars() {
+                match ch {
+                    '(' => d += 1,
+                    ')' => d -= 1,
+                    _ => {}
+                }
+            }
+            d != 0
+        });
+        need(!unbalanced, "unbalanced parentheses after split")?;
