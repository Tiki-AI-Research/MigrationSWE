new file mode 100644
index 0000000..0a8fbbd
--- /dev/null
+++ b/crates/pev2-core/src/js/json.rs
@@ -0,0 +1,454 @@
+//! `JSON.parse` with V8's behavior and error messages, and conversions
+//! between JavaScript values and `serde_json` values.
+
+use std::rc::Rc;
+
+use super::text::number_to_string;
+use super::value::{Arr, Obj, Val};
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Token {
+    Eos,
+    Number,
+    String,
+    Literal,
+    Whitespace,
+    Colon,
+    Comma,
+    LBrack,
+    RBrack,
+    LBrace,
+    RBrace,
+    Illegal,
+}
+
+fn token_of(c: Option<u16>) -> Token {
+    match c {
+        None => Token::Eos,
+        Some(c) => match c {
+            0x22 => Token::String,
+            0x2D | 0x30..=0x39 => Token::Number,
+            0x74 | 0x66 | 0x6E => Token::Literal,
+            0x20 | 0x09 | 0x0A | 0x0D => Token::Whitespace,
+            0x3A => Token::Colon,
+            0x2C => Token::Comma,
+            0x5B => Token::LBrack,
+            0x5D => Token::RBrack,
+            0x7B => Token::LBrace,
+            0x7D => Token::RBrace,
+            _ => Token::Illegal,
+        },
+    }
+}
+
+enum Msg {
+    ExpectedPropNameOrRBrace,
+    ExpectedCommaOrRBrack,
+    ExpectedCommaOrRBrace,
+    ExpectedDoubleQuotedPropertyName,
+    ExpectedColonAfterPropertyName,
+    UnterminatedString,
+    BadControlCharacter,
+    BadUnicodeEscape,
+    BadEscapedCharacter,
+    NoNumberAfterMinusSign,
+    ExponentPartMissingNumber,
+    UnterminatedFractionalNumber,
+    UnexpectedNonWhiteSpaceCharacter,
+}
+
+impl Msg {
+    fn text(&self) -> &'static str {
+        match self {
+            Msg::ExpectedPropNameOrRBrace => "Expected property name or '}' in JSON",
+            Msg::ExpectedCommaOrRBrack => "Expected ',' or ']' after array element in JSON",
+            Msg::ExpectedCommaOrRBrace => "Expected ',' or '}' after property value in JSON",
+            Msg::ExpectedDoubleQuotedPropertyName => "Expected double-quoted property name in JSON",
+            Msg::ExpectedColonAfterPropertyName => "Expected ':' after property name in JSON",
+            Msg::UnterminatedString => "Unterminated string in JSON",
+            Msg::BadControlCharacter => "Bad control character in string literal in JSON",
+            Msg::BadUnicodeEscape => "Bad Unicode escape in JSON",
+            Msg::BadEscapedCharacter => "Bad escaped character in JSON",
+            Msg::NoNumberAfterMinusSign => "No number after minus sign in JSON",
+            Msg::ExponentPartMissingNumber => "Exponent part is missing a number in JSON",
+            Msg::UnterminatedFractionalNumber => "Unterminated fractional number in JSON",
+            Msg::UnexpectedNonWhiteSpaceCharacter => "Unexpected non-whitespace character after JSON",
+        }
+    }
+}
+
+enum Frame {
+    Array(Vec<Val>),
+    Object(Obj, String),
+}
+
+struct JsonParser<'a> {
+    s: &'a [u16],
+    pos: usize,
+}
+
+impl<'a> JsonParser<'a> {
+    fn peek(&self) -> Option<u16> {
+        self.s.get(self.pos).copied()
+    }
+
+    fn skip_ws(&mut self) {
+        while let Some(c) = self.peek() {
+            if matches!(c, 0x20 | 0x09 | 0x0A | 0x0D) {
+                self.pos += 1;
+            } else {
+                break;
+            }
+        }
+    }
+
+    fn location(&self) -> String {
+        let mut line = 1;
+        let mut last_break = 0usize;
+        let mut i = 0usize;
+        let end = self.pos.min(self.s.len());
+        while i < end {
+            let c = self.s[i];
+            if c == 0x0D && i + 1 < end && self.s[i + 1] == 0x0A {
+                i += 1;
+            }
+            if self.s[i] == 0x0D || self.s[i] == 0x0A {
+                line += 1;
+                last_break = i + 1;
+            }
+            i += 1;
+        }
+        format!(" at position {} (line {} column {})", self.pos, line, 1 + i - last_break)
+    }
+
+    fn error_msg(&self, msg: Msg) -> String {
+        format!("{}{}", msg.text(), self.location())
+    }
+
+    /// `ReportUnexpectedToken` without an explicit message.
+    fn unexpected_token(&self, token: Token) -> String {
+        match token {
+            Token::Eos => "Unexpected end of JSON input".to_string(),
+            Token::Number => format!("Unexpected number in JSON{}", self.location()),
+            Token::String => format!("Unexpected string in JSON{}", self.location()),
+            _ => {
+                let src = String::from_utf16_lossy(self.s);
+                if matches!(src.as_str(), "[object Object]" | "undefined" | "Infinity" | "NaN") {
+                    return format!("\"{}\" is not valid JSON", src);
+                }
+                let c = String::from_utf16_lossy(&self.s[self.pos..self.pos + 1]);
+                let len = self.s.len();
+                const CONTEXT: usize = 10;
+                if len < CONTEXT * 2 + 1 {
+                    format!("Unexpected token '{}', \"{}\" is not valid JSON", c, src)
+                } else if self.pos < CONTEXT {
+                    let sub = String::from_utf16_lossy(&self.s[..self.pos + CONTEXT]);
+                    format!("Unexpected token '{}', \"{}\"... is not valid JSON", c, sub)
+                } else if self.pos < len - CONTEXT {
+                    let sub = String::from_utf16_lossy(&self.s[self.pos - CONTEXT..self.pos + CONTEXT]);
+                    format!("Unexpected token '{}', ...\"{}\"... is not valid JSON", c, sub)
+                } else {
+                    let sub = String::from_utf16_lossy(&self.s[self.pos - CONTEXT..]);
+                    format!("Unexpected token '{}', ...\"{}\" is not valid JSON", c, sub)
+                }
+            }
+        }
+    }
+
+    fn unexpected_character(&self) -> String {
+        self.unexpected_token(token_of(self.peek()))
+    }
+
+    fn scan_literal(&mut self, lit: &str, val: Val) -> Result<Val, String> {
+        let l: Vec<u16> = lit.encode_utf16().collect();
+        self.pos += 1;
+        for &c in &l[1..] {
+            match self.peek() {
+                None => return Err(self.unexpected_token(Token::Eos)),
+                Some(x) if x == c => self.pos += 1,
+                Some(_) => return Err(self.unexpected_character()),
+            }
+        }
+        Ok(val)
+    }
+
+    /// Scans a string; the cursor is on the opening quote.
+    fn scan_string(&mut self) -> Result<String, String> {
+        self.pos += 1;
+        let mut out: Vec<u16> = Vec::new();
+        loop {
+            let c = match self.peek() {
+                None => return Err(self.error_msg(Msg::UnterminatedString)),
+                Some(c) => c,
+            };
+            if c == 0x22 {
+                self.pos += 1;
+                return Ok(String::from_utf16_lossy(&out));
+            }
+            if c < 0x20 {
+                return Err(self.error_msg(Msg::BadControlCharacter));
+            }
+            if c != 0x5C {
+                out.push(c);
+                self.pos += 1;
+                continue;
+            }
+            self.pos += 1;
+            let e = match self.peek() {
+                None => return Err(self.unexpected_token(Token::Eos)),
+                Some(e) => e,
+            };
+            let decoded = match e {
+                0x22 => 0x22,
+                0x5C => 0x5C,
+                0x2F => 0x2F,
+                0x62 => 0x08,
+                0x66 => 0x0C,
+                0x6E => 0x0A,
+                0x72 => 0x0D,
+                0x74 => 0x09,
+                0x75 => {
+                    let mut v: u16 = 0;
+                    for _ in 0..4 {
+                        self.pos += 1;
+                        let h = self.peek().and_then(|d| match d {
+                            0x30..=0x39 => Some(d - 0x30),
+                            0x41..=0x46 => Some(d - 0x41 + 10),
+                            0x61..=0x66 => Some(d - 0x61 + 10),
+                            _ => None,
+                        });
+                        match h {
+                            Some(h) => v = v * 16 + h,
+                            None => return Err(self.error_msg(Msg::BadUnicodeEscape)),
+                        }
+                    }
+                    v
+                }
+                _ => return Err(self.error_msg(Msg::BadEscapedCharacter)),
+            };
+            out.push(decoded);
+            self.pos += 1;
+        }
+    }
+
+    fn is_digit(c: Option<u16>) -> bool {
+        matches!(c, Some(0x30..=0x39))
+    }
+
+    fn parse_number(&mut self) -> Result<Val, String> {
+        let start = self.pos;
+        if self.peek() == Some(0x2D) {
+            self.pos += 1;
+            if !Self::is_digit(self.peek()) {
+                return Err(self.error_msg(Msg::NoNumberAfterMinusSign));
+            }
+        }
+        if self.peek() == Some(0x30) {
+            self.pos += 1;
+            if Self::is_digit(self.peek()) {
+                return Err(self.unexpected_token(Token::Number));
+            }
+        } else {
+            while Self::is_digit(self.peek()) {
+                self.pos += 1;
+            }
+        }
+        if self.peek() == Some(0x2E) {
+            self.pos += 1;
+            if !Self::is_digit(self.peek()) {
+                return Err(self.error_msg(Msg::UnterminatedFractionalNumber));
+            }
+            while Self::is_digit(self.peek()) {
+                self.pos += 1;
+            }
+        }
+        if matches!(self.peek(), Some(0x65) | Some(0x45)) {
+            self.pos += 1;
+            if matches!(self.peek(), Some(0x2B) | Some(0x2D)) {
+                self.pos += 1;
+            }
+            if !Self::is_digit(self.peek()) {
+                return Err(self.error_msg(Msg::ExponentPartMissingNumber));
+            }
+            while Self::is_digit(self.peek()) {
+                self.pos += 1;
+            }
+        }
+        let text = String::from_utf16_lossy(&self.s[start..self.pos]);
+        Ok(Val::Num(text.parse::<f64>().unwrap_or(f64::NAN)))
+    }
+
+    /// Expects a property name (after skipping whitespace) followed by ':'.
+    fn property_key(&mut self, msg: Msg) -> Result<String, String> {
+        self.skip_ws();
+        if self.peek() != Some(0x22) {
+            return Err(self.error_msg(msg));
+        }
+        let key = self.scan_string()?;
+        self.skip_ws();
+        if self.peek() != Some(0x3A) {
+            return Err(self.error_msg(Msg::ExpectedColonAfterPropertyName));
+        }
+        self.pos += 1;
+        Ok(key)
+    }
+
+    fn parse(&mut self) -> Result<Val, String> {
+        let mut stack: Vec<Frame> = Vec::new();
+        'produce: loop {
+            self.skip_ws();
+            let mut value = match token_of(self.peek()) {
+                Token::String => Val::from(self.scan_string()?),
+                Token::Number => self.parse_number()?,
+                Token::LBrace => {
+                    self.pos += 1;
+                    self.skip_ws();
+                    if self.peek() == Some(0x7D) {
+                        self.pos += 1;
+                        Val::Obj(Obj::new())
+                    } else {
+                        let key = self.property_key(Msg::ExpectedPropNameOrRBrace)?;
+                        stack.push(Frame::Object(Obj::new(), key));
+                        continue 'produce;
+                    }
+                }
+                Token::LBrack => {
+                    self.pos += 1;
+                    self.skip_ws();
+                    if self.peek() == Some(0x5D) {
+                        self.pos += 1;
+                        Val::Arr(Arr::new(Vec::new()))
+                    } else {
+                        stack.push(Frame::Array(Vec::new()));
+                        continue 'produce;
+                    }
+                }
+                Token::Literal => match self.peek() {
+                    Some(0x74) => self.scan_literal("true", Val::Bool(true))?,
+                    Some(0x66) => self.scan_literal("false", Val::Bool(false))?,
+                    _ => self.scan_literal("null", Val::Null)?,
+                },
+                _ => return Err(self.unexpected_character()),
+            };
+            loop {
+                match stack.last_mut() {
+                    None => {
+                        self.skip_ws();
+                        if self.peek().is_some() {
+                            return Err(self.error_msg(Msg::UnexpectedNonWhiteSpaceCharacter));
+                        }
+                        return Ok(value);
+                    }
+                    Some(Frame::Object(obj, key)) => {
+                        let key = std::mem::take(key);
+                        obj.set(&key, value);
+                        self.skip_ws();
+                        if self.peek() == Some(0x2C) {
+                            self.pos += 1;
+                            let next = self.property_key(Msg::ExpectedDoubleQuotedPropertyName)?;
+                            if let Some(Frame::Object(_, k)) = stack.last_mut() {
+                                *k = next;
+                            }
+                            continue 'produce;
+                        }
+                        if self.peek() != Some(0x7D) {
+                            return Err(self.error_msg(Msg::ExpectedCommaOrRBrace));
+                        }
+                        self.pos += 1;
+                        value = match stack.pop() {
+                            Some(Frame::Object(o, _)) => Val::Obj(o),
+                            _ => unreachable!(),
+                        };
+                    }
+                    Some(Frame::Array(items)) => {
+                        items.push(value);
+                        self.skip_ws();
+                        if self.peek() == Some(0x2C) {
+                            self.pos += 1;
+                            continue 'produce;
+                        }
+                        if self.peek() != Some(0x5D) {
+                            return Err(self.error_msg(Msg::ExpectedCommaOrRBrack));
+                        }
+                        self.pos += 1;
+                        value = match stack.pop() {
+                            Some(Frame::Array(v)) => Val::Arr(Arr::new(v)),
+                            _ => unreachable!(),
+                        };
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// `JSON.parse(text)`; errors carry V8's `SyntaxError` message.
+pub fn parse(text: &[u16]) -> Result<Val, String> {
+    JsonParser { s: text, pos: 0 }.parse()
+}
+
+pub fn parse_str(text: &str) -> Result<Val, String> {
+    let u: Vec<u16> = text.encode_utf16().collect();
+    parse(&u)
+}
+
+/// A finite number as `JSON.stringify` writes it, read back by `serde_json`.
+pub fn number_to_serde(x: f64) -> serde_json::Value {
+    if !x.is_finite() {
+        return serde_json::Value::Null;
+    }
+    let s = number_to_string(x);
+    match s.parse::<serde_json::Number>() {
+        Ok(n) => serde_json::Value::Number(n),
+        Err(_) => serde_json::Number::from_f64(x).map(serde_json::Value::Number).unwrap_or(serde_json::Value::Null),
+    }
+}
+
+/// Converts a value as `JSON.parse(JSON.stringify(value))` would see it;
+/// `None` stands for `undefined` (omitted from objects).
+pub fn to_serde(v: &Val) -> Option<serde_json::Value> {
+    Some(match v {
+        Val::Undef => return None,
+        Val::Null => serde_json::Value::Null,
+        Val::Bool(b) => serde_json::Value::Bool(*b),
+        Val::Num(n) => number_to_serde(*n),
+        Val::Str(s) => serde_json::Value::String(s.to_string()),
+        Val::Obj(o) => serde_json::Value::Object(obj_to_serde(o)),
+        Val::Arr(a) => serde_json::Value::Array(
+            a.to_vec()
+                .iter()
+                .map(|e| to_serde(e).unwrap_or(serde_json::Value::Null))
+                .collect(),
+        ),
+    })
+}
+
+pub fn obj_to_serde(o: &Obj) -> serde_json::Map<String, serde_json::Value> {
+    let mut map = serde_json::Map::new();
+    for (k, v) in o.entries() {
+        if let Some(j) = to_serde(&v) {
+            map.insert(k.to_string(), j);
+        }
+    }
+    map
+}
+
+/// Converts a `serde_json` value to the value `JSON.parse` would produce.
+pub fn from_serde(v: &serde_json::Value) -> Val {
+    match v {
+        serde_json::Value::Null => Val::Null,
+        serde_json::Value::Bool(b) => Val::Bool(*b),
+        serde_json::Value::Number(n) => Val::Num(n.as_f64().unwrap_or(f64::NAN)),
+        serde_json::Value::String(s) => Val::Str(Rc::from(s.as_str())),
+        serde_json::Value::Array(a) => Val::Arr(Arr::new(a.iter().map(from_serde).collect())),
+        serde_json::Value::Object(m) => Val::Obj(map_from_serde(m)),
+    }
+}
+
+pub fn map_from_serde(m: &serde_json::Map<String, serde_json::Value>) -> Obj {
+    let o = Obj::new();
+    for (k, v) in m {
+        o.set(k, from_serde(v));
+    }
+    o
+}
