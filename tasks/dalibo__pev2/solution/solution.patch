+fn match_all(re: &Regex, s: &[u16]) -> Vec<Vec<u16>> {
+    re.all_matches(s)
+        .into_iter()
+        .map(|c| {
+            let (a, b) = c[0].unwrap();
+            s[a..b].to_vec()
+        })
+        .collect()
+}
+
+/// `_.deburr`.
+pub fn deburr(s: &str) -> String {
+    let u = utf16(s);
+    let replaced = lodash_re!(RE_LATIN).replace_with(&u, |caps, input| {
+        let (a, b) = caps[0].unwrap();
+        let c = from_utf16(&input[a..b]);
+        let letter = c.chars().next().and_then(deburred_letter).unwrap_or("undefined");
+        utf16(letter)
+    });
+    from_utf16(&lodash_re!(RE_COMBO_MARK).replace(&replaced, &[]))
+}
+
+/// `_.words` with the default pattern.
+pub fn words(s: &str) -> Vec<String> {
+    let u = utf16(s);
+    let re = if lodash_re!(RE_HAS_UNICODE_WORD).test(&u) {
+        lodash_re!(RE_UNICODE_WORD)
+    } else {
+        lodash_re!(RE_ASCII_WORD)
+    };
+    match_all(re, &u).iter().map(|w| from_utf16(w)).collect()
+}
+
+/// `_.upperFirst`.
+pub fn upper_first(s: &str) -> String {
+    let u = utf16(s);
+    if lodash_re!(RE_HAS_UNICODE).test(&u) {
+        let symbols = match_all(lodash_re!(RE_UNICODE), &u);
+        match symbols.split_first() {
+            Some((first, rest)) => {
+                let mut out = from_utf16(first).to_uppercase();
+                for sym in rest {
+                    out.push_str(&from_utf16(sym));
+                }
+                out
+            }
+            None => String::new(),
+        }
+    } else if u.is_empty() {
+        String::new()
+    } else {
+        from_utf16(&u[..1]).to_uppercase() + &from_utf16(&u[1..])
+    }
+}
+
+/// `_.capitalize`.
+pub fn capitalize(s: &str) -> String {
+    upper_first(&s.to_lowercase())
+}
+
+fn compound_words(s: &str) -> Vec<String> {
+    let deburred = utf16(&deburr(s));
+    words(&from_utf16(&lodash_re!(RE_APOS).replace(&deburred, &[])))
+}
+
+/// `_.startCase`.
+pub fn start_case(s: &str) -> String {
+    compound_words(s)
+        .iter()
+        .map(|w| upper_first(w))
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+/// `_.upperCase`.
+pub fn upper_case(s: &str) -> String {
+    compound_words(s)
+        .iter()
+        .map(|w| w.to_uppercase())
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+/// `_.trim` without custom characters (whitespace trim).
+pub fn trim(s: &str) -> String {
+    super::text::trim(s).to_string()
+}
