@@ -0,0 +1,337 @@
+//! Parsing and metrics for PostgreSQL `EXPLAIN` plans.
+//!
+//! This crate is the Rust implementation of pev2's plan service
+//! (`src/services/plan-service.ts`, `src/services/help-service.ts`,
+//! `src/enums.ts` and `src/interfaces.ts`). It parses `EXPLAIN` output in
+//! text or JSON form into the same JSON structures as the TypeScript
+//! implementation, and computes the same plan-level fields and derived
+//! metrics.
+//!
+//! Plans and nodes are plain JSON objects keyed by the
+//! [`enums::property`] strings, for example `"Node Type"` or
+//! `"Actual Rows"`. They hold what `JSON.stringify` writes for the
+//! TypeScript structures: properties that are `undefined` are absent,
+//! `NaN` and infinite numbers are `null`, and numbers are those JavaScript
+//! computes. Errors are reported with the message the TypeScript
+//! implementation throws.
+//!
+//! The JavaScript semantics this requires (regular expressions, coercions,
+//! `JSON.parse`, lodash helpers) are implemented natively in the crate.
+//!
+//! ```
+//! let content = pev2_core::from_source(
+//!     "Seq Scan on tenk1  (cost=0.00..333.00 rows=10000 width=148)",
+//! )
+//! .unwrap();
+//! assert_eq!(content["Plan"]["Plan Rows"], 10000);
+//!
+//! let plan = pev2_core::create_plan("", content, "select * from tenk1").unwrap();
+//! assert_eq!(plan["content"]["maxTotalCost"], 333);
+//! ```
+
+pub mod enums;
+pub mod interfaces;
+#[doc(hidden)]
+pub mod js;
+
+mod help_service;
+mod plan_service;
+
+use js::json::{from_serde, map_from_serde, obj_to_serde};
+use js::value::Val;
+use plan_service::PlanService;
+
+/// A JSON object.
+pub type JsonMap = serde_json::Map<String, serde_json::Value>;
+/// Parsed plan content (`IPlanContent`): the root node under `"Plan"` and
+/// global fields such as `"JIT"`, `"Planning"`, `"Serialization"`,
+/// `"Triggers"` or `"Query Text"` beside it.
+pub type PlanContent = JsonMap;
+/// A plan (`IPlan`): the plan content under `"content"` and the plan-level
+/// fields (`"isAnalyze"`, `"isVerbose"`, `"ctes"`, `"query"`, ...).
+pub type Plan = JsonMap;
+/// A plan node, keyed by property strings such as `"Node Type"`.
+pub type Node = JsonMap;
+
+fn to_map(v: &Val) -> JsonMap {
+    match v {
+        Val::Obj(o) => obj_to_serde(o),
+        _ => JsonMap::new(),
+    }
+}
+
+/// Parse results and the JavaScript values they were serialized from.
+///
+/// In TypeScript, `createPlan(name, fromSource(source), query)` receives the
+/// parsed objects themselves. Nodes built by the text parser are `Node`
+/// instances whose declared fields are own properties set to `undefined`
+/// (`_.has(plan, "Actual Rows")` is then true), and parsed values may be
+/// `NaN`; neither survives the conversion to JSON. Keep these values for the
+/// particular returned allocation, never for other equal JSON objects. Moving
+/// a map, including to another thread, preserves its heap allocations; JSON
+/// serialization, cloning and the JSON constructors create independent maps.
+mod parsed {
+    use super::{JsonMap, Val};
+    use crate::js::json::from_serde;
+    use crate::js::value::{Arr, FrozenVal, Obj};
+    use serde_json::Value;
+    use std::collections::BTreeMap;
+    use std::sync::{Mutex, OnceLock};
+
+    // Keep allocation identity separately from serialized values. Adding a
+    // property does not turn a text Node into a plain JSON object. Conversely,
+    // replacing a node with independently constructed JSON must not give the
+    // replacement the old Node's undefined fields.
+    enum Captured {
+        Scalar(FrozenVal, Option<Value>),
+        Object {
+            keys: Vec<(String, usize)>,
+            entries: Vec<(String, Captured)>,
+            fields: Option<&'static [&'static str]>,
+        },
+        Array(usize, Vec<Captured>),
+    }
+
+    impl Captured {
+        fn object(
+            entries: Vec<(String, FrozenVal)>,
+            fields: Option<&'static [&'static str]>,
+            map: Option<&JsonMap>,
+        ) -> Self {
+            let keys = map.map(|m| m.keys()
+                .map(|key| (key.clone(), key.as_ptr() as usize)).collect())
+                .unwrap_or_default();
+            let entries = entries.into_iter().map(|(key, value)| {
+                let captured = Self::capture(value, map.and_then(|m| m.get(&key)));
+                (key, captured)
+            }).collect();
+            Self::Object { keys, entries, fields }
+        }
+
+        fn capture(value: FrozenVal, json: Option<&Value>) -> Self {
+            match value {
+                FrozenVal::Obj(entries, fields) => {
+                    Self::object(entries, fields, json.and_then(Value::as_object))
+                }
+                FrozenVal::Arr(entries) => {
+                    let array = json.and_then(Value::as_array);
+                    let pointer = array.map(|v| v.as_ptr() as usize).unwrap_or(0);
+                    Self::Array(pointer, entries.into_iter().enumerate().map(|(index, value)| {
+                        Self::capture(value, array.and_then(|a| a.get(index)))
+                    }).collect())
+                }
+                scalar => Self::Scalar(scalar, json.cloned()),
+            }
+        }
+
+        fn same_object(keys: &[(String, usize)], map: &JsonMap) -> bool {
+            // String buffers remain stable when BTreeMap entries move during
+            // insertion or removal. A clone/replacement has new buffers.
+            map.keys().any(|key| keys.iter().any(|(old_key, pointer)| {
+                key == old_key && key.as_ptr() as usize == *pointer
+            }))
+        }
+
+        fn matches(&self, json: &Value) -> bool {
+            match (self, json) {
+                (Self::Object { keys, .. }, Value::Object(map)) => Self::same_object(keys, map),
+                (Self::Array(pointer, _), Value::Array(values)) => {
+                    !values.is_empty() && *pointer == values.as_ptr() as usize
+                }
+                _ => false,
+            }
+        }
+
+        fn restore_object(
+            keys: Vec<(String, usize)>,
+            entries: Vec<(String, Captured)>,
+            fields: Option<&'static [&'static str]>,
+            map: &JsonMap,
+        ) -> Val {
+            let same = Self::same_object(&keys, map);
+            let object = Obj::new();
+            let was_serialized = |key: &str| keys.iter().any(|(old_key, _)| old_key == key);
+            // Only omitted own properties are carried over. A serialized
+            // property explicitly removed by the caller stays removed.
+            if same {
+                for key in fields.unwrap_or_default() {
+                    if !was_serialized(key) && !map.contains_key(*key) {
+                        object.set(key, Val::Undef);
+                    }
+                }
+            }
+            let mut remaining: BTreeMap<_, _> = map.iter().map(|(key, value)| (key.as_str(), value)).collect();
+            for (key, captured) in entries {
+                if let Some(value) = remaining.remove(key.as_str()) {
+                    object.set(&key, captured.restore(value, same));
+                } else if same && !was_serialized(&key) {
+                    object.set(&key, Val::Undef);
+                }
+            }
+            for (key, value) in remaining {
+                object.set(key, from_serde(value));
+            }
+            Val::Obj(object)
+        }
+
+        fn restore(self, json: &Value, same_parent: bool) -> Val {
+            match (self, json) {
+                (Self::Object { keys, entries, fields }, Value::Object(map)) => {
+                    Self::restore_object(keys, entries, fields, map)
+                }
+                (Self::Array(pointer, entries), Value::Array(values)) => {
+                    let same = pointer == values.as_ptr() as usize;
+                    let mut entries: Vec<_> = entries.into_iter().map(Some).collect();
+                    let restored = values.iter().enumerate().map(|(index, value)| {
+                        // Reordering existing nodes preserves their identity.
+                        let matching = if matches!(value, Value::Object(_) | Value::Array(_)) {
+                            if entries.get(index).and_then(|entry| entry.as_ref())
+                                .map(|entry| entry.matches(value)).unwrap_or(false) {
+                                Some(index)
+                            } else {
+                                entries.iter().position(|entry| {
+                                    entry.as_ref().map(|entry| entry.matches(value)).unwrap_or(false)
+                                })
+                            }
+                        } else { None };
+                        let captured = matching.or_else(|| {
+                            entries.get(index).and_then(|entry| entry.as_ref()).map(|_| index)
+                        }).and_then(|index| entries[index].take());
+                        captured.map(|entry| entry.restore(value, same))
+                            .unwrap_or_else(|| from_serde(value))
+                    }).collect();
+                    Val::Arr(Arr::new(restored))
+                }
+                (Self::Scalar(value, original), _) if same_parent && original.as_ref() == Some(json) => {
+                    value.thaw()
+                }
+                _ => from_serde(json),
+            }
+        }
+    }
+
+    fn pending() -> &'static Mutex<BTreeMap<usize, Captured>> {
+        static PENDING: OnceLock<Mutex<BTreeMap<usize, Captured>>> = OnceLock::new();
+        PENDING.get_or_init(|| Mutex::new(BTreeMap::new()))
+    }
+
+    fn identity(map: &JsonMap) -> Option<usize> {
+        map.keys().find(|key| key.as_str() == "Plan").map(|key| key.as_ptr() as usize)
+    }
+
+    /// Retain each outstanding parse independently until it is consumed.
+    /// Unrelated parsing must not evict a value still owned by the caller.
+    pub(super) fn remember(map: &JsonMap, value: Val) {
+        if let (Some(identity), FrozenVal::Obj(entries, fields)) = (identity(map), FrozenVal::freeze(&value)) {
+            let captured = Captured::object(entries, fields, Some(map));
+            pending().lock().unwrap().insert(identity, captured);
+        }
+    }
+
+    pub(super) fn recall(map: &JsonMap) -> Option<Val> {
+        let captured = pending().lock().unwrap().remove(&identity(map)?)?;
+        match captured {
+            Captured::Object { keys, entries, fields } => {
+                Some(Captured::restore_object(keys, entries, fields, map))
+            }
+            _ => None,
+        }
+    }
+}
+
+fn parse_result(v: Val) -> PlanContent {
+    let map = to_map(&v);
+    parsed::remember(&map, v);
+    map
+}
+
+/// `PlanService.fromSource`: parses `EXPLAIN` output given as text or JSON.
+pub fn from_source(source: &str) -> Result<PlanContent, String> {
+    PlanService::new().from_source(source).map(parse_result)
+}
+
+/// `PlanService.fromText`: builds the plan content and node tree from text
+/// output. Fails with `"Unable to parse plan"` when no root node is found.
+pub fn from_text(text: &str) -> Result<PlanContent, String> {
+    PlanService::new().from_text(text).map(parse_result)
+}
+
+/// `PlanService.fromJson`: builds the plan content from JSON output
+/// embedded in text.
+pub fn from_json(source: &str) -> Result<PlanContent, String> {
+    PlanService::new().from_json(source).map(parse_result)
+}
+
+/// `PlanService.getPlanContent`: the plan content of a parsed JSON payload
+/// (the first element when it is an array). Fails with `"Invalid plan"`
+/// when there is no `Plan` member.
+pub fn get_plan_content(value: &serde_json::Value) -> Result<PlanContent, String> {
+    PlanService::new()
+        .get_plan_content(&from_serde(value))
+        .map(parse_result)
+}
+
+/// `PlanService.cleanupSource`: removes psql frames, separators, quotes,
+/// line continuations, the `QUERY PLAN` header and row counts.
+pub fn cleanup_source(source: &str) -> String {
+    PlanService::new().cleanup_source(source)
+}
+
+/// `PlanService.splitIntoLines`: splits text into lines, joining lines that
+/// were wrapped.
+pub fn split_into_lines(text: &str) -> Vec<String> {
+    PlanService::new().split_into_lines(text)
+}
+
+/// `splitBalanced`: splits `input` on `split` (a regular expression source,
+/// matched case-insensitively) outside of brackets and quotes. Returns an
+/// empty list when `split` is not a valid regular expression.
+pub fn split_balanced(input: &str, split: &str) -> Vec<String> {
+    help_service::split_balanced(input, split).unwrap_or_default()
+}
+
+/// `PlanService.createPlan`: builds a plan from parsed content, normalizing
+/// whitespace in the query, assigning node identifiers and computing the
+/// derived metrics. Edits to parsed content are applied while preserving the
+/// undefined fields of text nodes that the caller has kept.
+///
+/// Content returned by [`from_source`], [`from_text`] or [`from_json`], moved
+/// into this call without copying, retains the original parser values (see
+/// the parse results notes in the source). Other content is plain JSON data.
+pub fn create_plan(plan_name: &str, plan_content: PlanContent, plan_query: &str) -> Result<Plan, String> {
+    let content = parsed::recall(&plan_content).unwrap_or_else(|| Val::Obj(map_from_serde(&plan_content)));
+    PlanService::new()
+        .create_plan(plan_name, &content, plan_query)
+        .map(|plan| obj_to_serde(&plan))
+}
+
+/// `new Node(type)`: the node structure derived from a text plan node type,
+/// for example `"Index Scan using idx on tbl t"` or `"Hash Left Join"`.
+pub fn parse_node_type(node_type: &str) -> Node {
+    obj_to_serde(&interfaces::new_node(node_type))
+}
+
+/// `shouldShowProp`: whether a node property belongs to the miscellaneous
+/// properties shown in the detailed view.
+pub fn should_show_prop(key: &str, value: &serde_json::Value) -> bool {
+    help_service::should_show_prop(key, &from_serde(value))
+}
+
+/// `findNodeById`: the node of a plan (including its CTEs) with the given
+/// `nodeId`.
+pub fn find_node_by_id(plan: &Plan, id: i64) -> Option<Node> {
+    let plan = Val::Obj(map_from_serde(plan));
+    match help_service::find_node_by_id(&plan, id as f64) {
+        Ok(Val::Obj(node)) => Some(obj_to_serde(&node)),
+        _ => None,
+    }
+}
+
+/// `findNodeBySubplanName`: the CTE of a plan named `subplan_name`.
+pub fn find_node_by_subplan_name(plan: &Plan, subplan_name: &str) -> Option<Node> {
+    let plan = Val::Obj(map_from_serde(plan));
+    match help_service::find_node_by_subplan_name(&plan, subplan_name) {
+        Ok(Val::Obj(node)) => Some(obj_to_serde(&node)),
+        _ => None,
+    }
+}
