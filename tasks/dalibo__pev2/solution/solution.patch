+///
+/// Guards against catastrophic backtracking in `cleanupSource`: the
+/// frame-stripping regexes must stay linear so a large single-line plan is
+/// cleaned quickly rather than in O(n^2) time.
+mod spec_25_cleanup_source_backtracking {
+    use serde_json::json;
+    use std::time::Instant;
+
+    // TS: test("cleans a large single-line JSON plan quickly") (Vitest test
+    // timeout: 10000 ms)
+    #[test]
+    fn cleans_a_large_single_line_json_plan_quickly() {
+        let filter = "(a = ".to_string() + &"1 OR a = ".repeat(15000) + "1)";
+        let source = r#"[{"Plan":{"Node Type":"Seq Scan","Relation Name":"t","Alias":"t","#.to_string()
+            + r#""Startup Cost":0.00,"Total Cost":1.00,"Plan Rows":1,"Plan Width":4,"#
+            + &format!(r#""Filter":"{}"}}}}]"#, filter);
+
+        let start = Instant::now();
+        let json = pev2_core::from_source(&source);
+        let elapsed_ms = start.elapsed().as_secs_f64() * 1000.0;
+        println!("fromSource took {:.3} ms", elapsed_ms);
+
+        let json = json.expect("source parses");
+        assert_eq!(json.get("Plan").and_then(|p| p.get("Node Type")), Some(&json!("Seq Scan")));
+        assert!(elapsed_ms < 2000.0, "fromSource took {} ms, expected less than 2000 ms", elapsed_ms);
+    }
+}
