@@ -0,0 +1,1909 @@
+//! Backtracking regular expressions with ECMAScript semantics.
+//!
+//! The plan parser relies heavily on JavaScript regular expressions, and its
+//! observable behavior depends on details that differ between regex flavors:
+//! the JavaScript definitions of `\s`, `\d`, `\w` and `.`, multiline anchors,
+//! backreferences, lookaheads, the reset of captures on each iteration of a
+//! quantified group and the rejection of empty iterations. This module
+//! implements the non-unicode (Annex B) flavor of the ECMAScript `RegExp`
+//! matcher, operating on UTF-16 code units like JavaScript strings do.
+
+use std::cell::RefCell;
+use std::collections::HashSet;
+use std::hash::{BuildHasherDefault, Hasher};
+
+use super::text::is_line_terminator;
+
+const INF: u32 = u32::MAX;
+
+/// A lazily compiled, process-wide regular expression, standing in for a
+/// JavaScript regex literal.
+macro_rules! js_regex {
+    ($pattern:expr, $flags:expr) => {{
+        static RE: ::std::sync::OnceLock<$crate::js::regex::Regex> = ::std::sync::OnceLock::new();
+        RE.get_or_init(|| {
+            $crate::js::regex::Regex::new($pattern, $flags).expect("valid regular expression")
+        })
+    }};
+}
+pub(crate) use js_regex;
+
+/// Capture positions; index 0 is the whole match.
+pub type Captures = Vec<Option<(usize, usize)>>;
+
+#[derive(Clone, Debug)]
+struct CharSet {
+    /// Sorted, non-overlapping inclusive ranges.
+    ranges: Vec<(u16, u16)>,
+    negated: bool,
+}
+
+impl CharSet {
+    fn new(mut ranges: Vec<(u16, u16)>, negated: bool) -> CharSet {
+        ranges.sort_unstable();
+        let mut merged: Vec<(u16, u16)> = Vec::with_capacity(ranges.len());
+        for (lo, hi) in ranges {
+            if let Some(last) = merged.last_mut() {
+                if lo as u32 <= last.1 as u32 + 1 {
+                    if hi > last.1 {
+                        last.1 = hi;
+                    }
+                    continue;
+                }
+            }
+            merged.push((lo, hi));
+        }
+        CharSet {
+            ranges: merged,
+            negated,
+        }
+    }
+
+    fn empty() -> CharSet {
+        CharSet {
+            ranges: Vec::new(),
+            negated: false,
+        }
+    }
+
+    fn all() -> CharSet {
+        CharSet {
+            ranges: vec![(0, 0xFFFF)],
+            negated: false,
+        }
+    }
+
+    /// The same set without negation.
+    fn positive(&self) -> CharSet {
+        if self.negated {
+            CharSet::new(complement(self.ranges.clone()), false)
+        } else {
+            self.clone()
+        }
+    }
+
+    fn union(&self, other: &CharSet) -> CharSet {
+        let mut r = self.positive().ranges;
+        r.extend(other.positive().ranges);
+        CharSet::new(r, false)
+    }
+
+    #[inline]
+    fn matches(&self, c: u16) -> bool {
+        self.contains(c) != self.negated
+    }
+
+    fn contains(&self, c: u16) -> bool {
+        // Binary search over the sorted ranges.
+        let r = &self.ranges;
+        let (mut lo, mut hi) = (0usize, r.len());
+        while lo < hi {
+            let mid = (lo + hi) / 2;
+            if c < r[mid].0 {
+                hi = mid;
+            } else if c > r[mid].1 {
+                lo = mid + 1;
+            } else {
+                return true;
+            }
+        }
+        false
+    }
+}
+
+#[derive(Debug)]
+enum Node {
+    Empty,
+    Lit(Vec<u16>),
+    Any,
+    Set(CharSet),
+    Bol,
+    Eol,
+    /// Word boundary; `true` for `\B`.
+    WordB(bool),
+    Seq(Vec<Node>),
+    Alt(Vec<Node>),
+    Group(Box<Node>, usize),
+    /// Lookahead; `true` when negative.
+    Look(Box<Node>, bool),
+    BackRef(usize),
+    Repeat(Box<RepeatNode>),
+}
+
+#[derive(Debug)]
+struct RepeatNode {
+    node: Node,
+    min: u32,
+    max: u32,
+    greedy: bool,
+    /// Range of capture indices contained in `node` (half-open).
+    cap_lo: usize,
+    cap_hi: usize,
+    id: usize,
+    /// Whether failures of this repetition can be memoized by position.
+    memo: bool,
+    /// Width of `node` when it is a deterministic, capture-free atom.
+    width: Option<usize>,
+    /// When known, the code units one of which the rest of the pattern
+    /// must consume first after this repetition.
+    follow: Option<CharSet>,
+    /// Whether `node` matches in at most one viable way at any position (see
+    /// `is_deterministic`), so iterations can be computed without recursion.
+    det: bool,
+}
+
+/// A compiled ECMAScript regular expression.
+#[derive(Debug)]
+pub struct Regex {
+    node: Node,
+    ncaps: usize,
+    pub global: bool,
+    pub ignore_case: bool,
+    pub multiline: bool,
+    pub dot_all: bool,
+    pub sticky: bool,
+    start: StartReq,
+}
+
+#[derive(Debug, Clone)]
+enum StartReq {
+    None,
+    Bol,
+    Set(CharSet),
+}
+
+// ---------------------------------------------------------------------------
+// Character classes
+
+fn ranges_whitespace() -> Vec<(u16, u16)> {
+    vec![
+        (0x09, 0x0D),
+        (0x20, 0x20),
+        (0xA0, 0xA0),
+        (0x1680, 0x1680),
+        (0x2000, 0x200A),
+        (0x2028, 0x2029),
+        (0x202F, 0x202F),
+        (0x205F, 0x205F),
+        (0x3000, 0x3000),
+        (0xFEFF, 0xFEFF),
+    ]
+}
+
+fn ranges_digit() -> Vec<(u16, u16)> {
+    vec![(0x30, 0x39)]
+}
+
+fn ranges_word() -> Vec<(u16, u16)> {
+    vec![(0x30, 0x39), (0x41, 0x5A), (0x5F, 0x5F), (0x61, 0x7A)]
+}
+
+fn complement(ranges: Vec<(u16, u16)>) -> Vec<(u16, u16)> {
+    let set = CharSet::new(ranges, false);
+    let mut out = Vec::new();
+    let mut next: u32 = 0;
+    for (lo, hi) in set.ranges {
+        if (lo as u32) > next {
+            out.push((next as u16, lo - 1));
+        }
+        next = hi as u32 + 1;
+    }
+    if next <= 0xFFFF {
+        out.push((next as u16, 0xFFFF));
+    }
+    out
+}
+
+fn class_escape(c: u16) -> Option<Vec<(u16, u16)>> {
+    match c {
+        0x64 => Some(ranges_digit()),              // d
+        0x44 => Some(complement(ranges_digit())),  // D
+        0x73 => Some(ranges_whitespace()),         // s
+        0x53 => Some(complement(ranges_whitespace())), // S
+        0x77 => Some(ranges_word()),               // w
+        0x57 => Some(complement(ranges_word())),   // W
+        _ => None,
+    }
+}
+
+fn is_word_char(c: u16) -> bool {
+    matches!(c, 0x30..=0x39 | 0x41..=0x5A | 0x5F | 0x61..=0x7A)
+}
+
+/// `Canonicalize` for case-insensitive, non-unicode matching.
+fn canonicalize(ch: u16) -> u16 {
+    if (0xD800..=0xDFFF).contains(&ch) {
+        return ch;
+    }
+    if ch < 128 {
+        return if (0x61..=0x7A).contains(&ch) { ch - 32 } else { ch };
+    }
+    let c = match char::from_u32(ch as u32) {
+        Some(c) => c,
+        None => return ch,
+    };
+    let mut up = c.to_uppercase();
+    let first = match up.next() {
+        Some(u) => u,
+        None => return ch,
+    };
+    if up.next().is_some() {
+        return ch;
+    }
+    let cu = first as u32;
+    if cu > 0xFFFF || cu < 128 {
+        return ch;
+    }
+    cu as u16
+}
+
+/// For each canonical value, the list of code units that canonicalize to it.
+fn canonical_equivalents(ch: u16) -> &'static [u16] {
+    use std::sync::OnceLock;
+    static TABLE: OnceLock<std::collections::HashMap<u16, Vec<u16>>> = OnceLock::new();
+    let table = TABLE.get_or_init(|| {
+        let mut map: std::collections::HashMap<u16, Vec<u16>> = std::collections::HashMap::new();
+        for c in 0..=0xFFFFu32 {
+            let c = c as u16;
+            let k = canonicalize(c);
+            if k != c {
+                map.entry(k).or_insert_with(|| vec![k]).push(c);
+            }
+        }
+        map
+    });
+    match table.get(&canonicalize(ch)) {
+        Some(v) => v.as_slice(),
+        None => &[],
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Parser
+
+struct Parser<'a> {
+    p: &'a [u16],
+    i: usize,
+    total_caps: usize,
+    ncaps: usize,
+    has_backref: bool,
+}
+
+fn is_digit(c: u16) -> bool {
+    (0x30..=0x39).contains(&c)
+}
+
+fn hex_val(c: u16) -> Option<u16> {
+    match c {
+        0x30..=0x39 => Some(c - 0x30),
+        0x41..=0x46 => Some(c - 0x41 + 10),
+        0x61..=0x66 => Some(c - 0x61 + 10),
+        _ => None,
+    }
+}
+
+const fn ch(c: char) -> u16 {
+    c as u16
+}
+
+enum ClassAtom {
+    Char(u16),
+    Set(Vec<(u16, u16)>),
+}
+
+impl<'a> Parser<'a> {
+    fn peek(&self) -> Option<u16> {
+        self.p.get(self.i).copied()
+    }
+
+    fn peek_at(&self, off: usize) -> Option<u16> {
+        self.p.get(self.i + off).copied()
+    }
+
+    fn eat(&mut self, c: char) -> bool {
+        if self.peek() == Some(ch(c)) {
+            self.i += 1;
+            true
+        } else {
+            false
+        }
+    }
+
+    fn starts_with(&self, s: &str) -> bool {
+        let mut j = self.i;
+        for c in s.encode_utf16() {
+            if self.p.get(j) != Some(&c) {
+                return false;
+            }
+            j += 1;
+        }
+        true
+    }
+
+    fn count_groups(p: &[u16]) -> usize {
+        let mut n = 0;
+        let mut i = 0;
+        let mut in_class = false;
+        while i < p.len() {
+            let c = p[i];
+            if c == ch('\\') {
+                i += 2;
+                continue;
+            }
+            if in_class {
+                if c == ch(']') {
+                    in_class = false;
+                }
+            } else if c == ch('[') {
+                in_class = true;
+            } else if c == ch('(') && p.get(i + 1) != Some(&ch('?')) {
+                n += 1;
+            }
+            i += 1;
+        }
+        n
+    }
+
+    fn parse_disjunction(&mut self) -> Result<Node, String> {
+        let mut alts = vec![self.parse_alternative()?];
+        while self.eat('|') {
+            alts.push(self.parse_alternative()?);
+        }
+        if alts.len() == 1 {
+            Ok(alts.pop().unwrap())
+        } else {
+            Ok(Node::Alt(alts))
+        }
+    }
+
+    fn parse_alternative(&mut self) -> Result<Node, String> {
+        let mut terms: Vec<Node> = Vec::new();
+        while let Some(c) = self.peek() {
+            if c == ch('|') || c == ch(')') {
+                break;
+            }
+            let t = self.parse_term()?;
+            if let Node::Lit(ref l) = t {
+                if let Some(Node::Lit(prev)) = terms.last_mut() {
+                    prev.extend_from_slice(l);
+                    continue;
+                }
+            }
+            terms.push(t);
+        }
+        match terms.len() {
+            0 => Ok(Node::Empty),
+            1 => Ok(terms.pop().unwrap()),
+            _ => Ok(Node::Seq(terms)),
+        }
+    }
+
+    fn parse_term(&mut self) -> Result<Node, String> {
+        let c = self.peek().unwrap();
+        if c == ch('^') {
+            self.i += 1;
+            return self.no_quantifier(Node::Bol);
+        }
+        if c == ch('$') {
+            self.i += 1;
+            return self.no_quantifier(Node::Eol);
+        }
+        if c == ch('\\') && self.peek_at(1) == Some(ch('b')) {
+            self.i += 2;
+            return self.no_quantifier(Node::WordB(false));
+        }
+        if c == ch('\\') && self.peek_at(1) == Some(ch('B')) {
+            self.i += 2;
+            return self.no_quantifier(Node::WordB(true));
+        }
+        if self.starts_with("(?<=") || self.starts_with("(?<!") {
+            return Err("Invalid group".to_string());
+        }
+        let caps_before = self.ncaps;
+        let atom = if self.starts_with("(?=") || self.starts_with("(?!") {
+            let negative = self.peek_at(2) == Some(ch('!'));
+            self.i += 3;
+            let d = self.parse_disjunction()?;
+            if !self.eat(')') {
+                return Err("Unterminated group".to_string());
+            }
+            Node::Look(Box::new(d), negative)
+        } else {
+            self.parse_atom()?
+        };
+        let caps_after = self.ncaps;
+        if let Some((min, max)) = self.parse_quantifier()? {
+            let greedy = !self.eat('?');
+            return Ok(Node::Repeat(Box::new(RepeatNode {
+                node: atom,
+                min,
+                max,
+                greedy,
+                cap_lo: caps_before + 1,
+                cap_hi: caps_after + 1,
+                id: 0,
+                memo: false,
+                width: None,
+                follow: None,
+                det: false,
+            })));
+        }
+        Ok(atom)
+    }
+
+    fn no_quantifier(&mut self, node: Node) -> Result<Node, String> {
+        if let Some(c) = self.peek() {
+            if c == ch('*') || c == ch('+') || c == ch('?') || (c == ch('{') && self.quantifier_ahead()) {
+                return Err("Nothing to repeat".to_string());
+            }
+        }
+        Ok(node)
+    }
+
+    /// Whether a `{n}`, `{n,}` or `{n,m}` quantifier starts at the cursor.
+    fn quantifier_ahead(&self) -> bool {
+        let mut j = self.i;
+        if self.p.get(j) != Some(&ch('{')) {
+            return false;
+        }
+        j += 1;
+        let start = j;
+        while j < self.p.len() && is_digit(self.p[j]) {
+            j += 1;
+        }
+        if j == start {
+            return false;
+        }
+        if self.p.get(j) == Some(&ch('}')) {
+            return true;
+        }
+        if self.p.get(j) != Some(&ch(',')) {
+            return false;
+        }
+        j += 1;
+        while j < self.p.len() && is_digit(self.p[j]) {
+            j += 1;
+        }
+        self.p.get(j) == Some(&ch('}'))
+    }
+
+    fn parse_number(&mut self) -> u32 {
+        let mut v: u64 = 0;
+        while let Some(c) = self.peek() {
+            if !is_digit(c) {
+                break;
+            }
+            v = (v * 10 + (c - 0x30) as u64).min(INF as u64 - 1);
+            self.i += 1;
+        }
+        v as u32
+    }
+
+    fn parse_quantifier(&mut self) -> Result<Option<(u32, u32)>, String> {
+        let c = match self.peek() {
+            Some(c) => c,
+            None => return Ok(None),
+        };
+        if c == ch('*') {
+            self.i += 1;
+            return Ok(Some((0, INF)));
+        }
+        if c == ch('+') {
+            self.i += 1;
+            return Ok(Some((1, INF)));
+        }
+        if c == ch('?') {
+            self.i += 1;
+            return Ok(Some((0, 1)));
+        }
+        if c == ch('{') && self.quantifier_ahead() {
+            self.i += 1;
+            let min = self.parse_number();
+            let max = if self.eat(',') {
+                if self.peek() == Some(ch('}')) {
+                    INF
+                } else {
+                    self.parse_number()
+                }
+            } else {
+                min
+            };
+            self.eat('}');
+            if max < min {
+                return Err("numbers out of order in {} quantifier".to_string());
+            }
+            return Ok(Some((min, max)));
+        }
+        Ok(None)
+    }
+
+    fn parse_atom(&mut self) -> Result<Node, String> {
+        let c = self.peek().unwrap();
+        match c {
+            0x2E => {
+                // .
+                self.i += 1;
+                Ok(Node::Any)
+            }
+            0x28 => {
+                // (
+                if self.starts_with("(?:") {
+                    self.i += 3;
+                    let d = self.parse_disjunction()?;
+                    if !self.eat(')') {
+                        return Err("Unterminated group".to_string());
+                    }
+                    Ok(d)
+                } else if self.peek_at(1) == Some(ch('?')) {
+                    Err("Invalid group".to_string())
+                } else {
+                    self.i += 1;
+                    self.ncaps += 1;
+                    let idx = self.ncaps;
+                    let d = self.parse_disjunction()?;
+                    if !self.eat(')') {
+                        return Err("Unterminated group".to_string());
+                    }
+                    Ok(Node::Group(Box::new(d), idx))
+                }
+            }
+            0x5B => self.parse_class(),
+            0x5C => self.parse_atom_escape(),
+            0x2A | 0x2B | 0x3F => Err("Nothing to repeat".to_string()),
+            0x7B => {
+                if self.quantifier_ahead() {
+                    Err("Nothing to repeat".to_string())
+                } else {
+                    self.i += 1;
+                    Ok(Node::Lit(vec![c]))
+                }
+            }
+            _ => {
+                self.i += 1;
+                Ok(Node::Lit(vec![c]))
+            }
+        }
+    }
+
+    fn parse_legacy_octal(&mut self) -> u16 {
+        let d1 = self.peek().unwrap() - 0x30;
+        self.i += 1;
+        let is_oct = |c: Option<u16>| matches!(c, Some(0x30..=0x37));
+        if !is_oct(self.peek()) {
+            return d1;
+        }
+        let d2 = self.peek().unwrap() - 0x30;
+        self.i += 1;
+        if d1 <= 3 && is_oct(self.peek()) {
+            let d3 = self.peek().unwrap() - 0x30;
+            self.i += 1;
+            return d1 * 64 + d2 * 8 + d3;
+        }
+        d1 * 8 + d2
+    }
+
+    /// Parses escapes shared by atoms and classes (after the backslash).
+    fn parse_character_escape(&mut self, in_class: bool) -> u16 {
+        let e = self.peek().unwrap();
+        match e {
+            0x74 => {
+                self.i += 1;
+                0x09
+            }
+            0x6E => {
+                self.i += 1;
+                0x0A
+            }
+            0x76 => {
+                self.i += 1;
+                0x0B
+            }
+            0x66 => {
+                self.i += 1;
+                0x0C
+            }
+            0x72 => {
+                self.i += 1;
+                0x0D
+            }
+            0x63 => {
+                // \c
+                match self.peek_at(1) {
+                    Some(l) if (l as u8 as u16 == l) && (l as u8).is_ascii_alphabetic() => {
+                        self.i += 2;
+                        l % 32
+                    }
+                    Some(l) if in_class && (is_digit(l) || l == ch('_')) => {
+                        self.i += 2;
+                        l % 32
+                    }
+                    _ => ch('\\'),
+                }
+            }
+            0x78 => {
+                // \x
+                if let (Some(a), Some(b)) = (
+                    self.peek_at(1).and_then(hex_val),
+                    self.peek_at(2).and_then(hex_val),
+                ) {
+                    self.i += 3;
+                    a * 16 + b
+                } else {
+                    self.i += 1;
+                    e
+                }
+            }
+            0x75 => {
+                // \u
+                let digits: Option<Vec<u16>> = (1..=4).map(|k| self.peek_at(k).and_then(hex_val)).collect();
+                if let Some(d) = digits {
+                    self.i += 5;
+                    d.iter().fold(0u16, |acc, v| acc * 16 + v)
+                } else {
+                    self.i += 1;
+                    e
+                }
+            }
+            0x30..=0x37 => {
+                if e == ch('0') && !matches!(self.peek_at(1), Some(c) if is_digit(c)) {
+                    self.i += 1;
+                    0
+                } else {
+                    self.parse_legacy_octal()
+                }
+            }
+            _ => {
+                self.i += 1;
+                e
+            }
+        }
+    }
+
+    fn parse_atom_escape(&mut self) -> Result<Node, String> {
+        self.i += 1;
+        let e = match self.peek() {
+            Some(e) => e,
+            None => return Err("\\ at end of pattern".to_string()),
+        };
+        if (0x31..=0x39).contains(&e) {
+            let save = self.i;
+            let n = self.parse_number() as usize;
+            if n <= self.total_caps {
+                self.has_backref = true;
+                return Ok(Node::BackRef(n));
+            }
+            self.i = save;
+            if e >= ch('8') {
+                self.i += 1;
+                return Ok(Node::Lit(vec![e]));
+            }
+            return Ok(Node::Lit(vec![self.parse_legacy_octal()]));
+        }
+        if let Some(r) = class_escape(e) {
+            self.i += 1;
+            return Ok(Node::Set(CharSet::new(r, false)));
+        }
+        let c = self.parse_character_escape(false);
+        Ok(Node::Lit(vec![c]))
+    }
+
+    fn parse_class_atom(&mut self) -> Result<ClassAtom, String> {
+        let c = self.peek().unwrap();
+        if c != ch('\\') {
+            self.i += 1;
+            return Ok(ClassAtom::Char(c));
+        }
+        self.i += 1;
+        let e = match self.peek() {
+            Some(e) => e,
+            None => return Err("\\ at end of pattern".to_string()),
+        };
+        if e == ch('b') {
+            self.i += 1;
+            return Ok(ClassAtom::Char(0x08));
+        }
+        if e == ch('-') {
+            self.i += 1;
+            return Ok(ClassAtom::Char(e));
+        }
+        if let Some(r) = class_escape(e) {
+            self.i += 1;
+            return Ok(ClassAtom::Set(r));
+        }
+        if e == ch('8') || e == ch('9') {
+            self.i += 1;
+            return Ok(ClassAtom::Char(e));
+        }
+        Ok(ClassAtom::Char(self.parse_character_escape(true)))
+    }
+
+    fn parse_class(&mut self) -> Result<Node, String> {
+        self.i += 1;
+        let negated = self.eat('^');
+        let mut ranges: Vec<(u16, u16)> = Vec::new();
+        loop {
+            let c = match self.peek() {
+                Some(c) => c,
+                None => return Err("Unterminated character class".to_string()),
+            };
+            if c == ch(']') {
+                self.i += 1;
+                break;
+            }
+            let a = self.parse_class_atom()?;
+            if self.peek() == Some(ch('-')) && self.peek_at(1).is_some() && self.peek_at(1) != Some(ch(']')) {
+                self.i += 1;
+                let b = self.parse_class_atom()?;
+                match (a, b) {
+                    (ClassAtom::Char(x), ClassAtom::Char(y)) => {
+                        if x > y {
+                            return Err("Range out of order in character class".to_string());
+                        }
+                        ranges.push((x, y));
+                    }
+                    (a, b) => {
+                        for atom in [a, b] {
+                            match atom {
+                                ClassAtom::Char(x) => ranges.push((x, x)),
+                                ClassAtom::Set(r) => ranges.extend(r),
+                            }
+                        }
+                        ranges.push((ch('-'), ch('-')));
+                    }
+                }
+            } else {
+                match a {
+                    ClassAtom::Char(x) => ranges.push((x, x)),
+                    ClassAtom::Set(r) => ranges.extend(r),
+                }
+            }
+        }
+        Ok(Node::Set(CharSet::new(ranges, negated)))
+    }
+}
+
+/// The code units a node can consume first (`None` when unknown) and
+/// whether it can match without consuming anything.
+struct First {
+    set: Option<CharSet>,
+    nullable: bool,
+}
+
+fn union_opt(a: &Option<CharSet>, b: &Option<CharSet>) -> Option<CharSet> {
+    match (a, b) {
+        (Some(x), Some(y)) => Some(x.union(y)),
+        _ => None,
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Flags {
+    ignore_case: bool,
+    dot_all: bool,
+}
+
+fn first(node: &Node, f: Flags) -> First {
+    let consuming = |set: Option<CharSet>| First { set, nullable: false };
+    match node {
+        Node::Empty | Node::Bol | Node::Eol | Node::WordB(_) | Node::Look(..) => First {
+            set: Some(CharSet::empty()),
+            nullable: true,
+        },
+        Node::BackRef(_) => First { set: None, nullable: true },
+        Node::Lit(l) => {
+            if l.is_empty() {
+                First {
+                    set: Some(CharSet::empty()),
+                    nullable: true,
+                }
+            } else if f.ignore_case {
+                consuming(None)
+            } else {
+                consuming(Some(CharSet::new(vec![(l[0], l[0])], false)))
+            }
+        }
+        Node::Any => consuming(Some(if f.dot_all {
+            CharSet::all()
+        } else {
+            CharSet::new(complement(vec![(0x0A, 0x0A), (0x0D, 0x0D), (0x2028, 0x2029)]), false)
+        })),
+        Node::Set(set) => consuming(if f.ignore_case { None } else { Some(set.positive()) }),
+        Node::Group(n, _) => first(n, f),
+        Node::Seq(v) => {
+            let mut set = Some(CharSet::empty());
+            for n in v {
+                let fi = first(n, f);
+                set = union_opt(&set, &fi.set);
+                if !fi.nullable {
+                    return First { set, nullable: false };
+                }
+            }
+            First { set, nullable: true }
+        }
+        Node::Alt(v) => {
+            let mut set = Some(CharSet::empty());
+            let mut nullable = false;
+            for n in v {
+                let fi = first(n, f);
+                set = union_opt(&set, &fi.set);
+                nullable |= fi.nullable;
+            }
+            First { set, nullable }
+        }
+        Node::Repeat(r) => {
+            if r.max == 0 {
+                return First {
+                    set: Some(CharSet::empty()),
+                    nullable: true,
+                };
+            }
+            let fi = first(&r.node, f);
+            First {
+                set: fi.set,
+                nullable: r.min == 0 || fi.nullable,
+            }
+        }
+    }
+}
+
+struct Finalizer {
+    next_id: usize,
+    memo_allowed: bool,
+    flags: Flags,
+}
+
+impl Finalizer {
+    /// Assigns repetition ids, memoization eligibility, fixed widths and
+    /// follow sets. `follow` describes what the continuation of `node` must
+    /// consume first (`None` when unknown or possibly nothing).
+    fn run(&mut self, node: &mut Node, in_repeat: bool, follow: Option<CharSet>) {
+        match node {
+            Node::Seq(v) => {
+                let n = v.len();
+                let mut follows: Vec<Option<CharSet>> = vec![None; n];
+                // First set and nullability of v[i + 1..].
+                let mut rest_set = Some(CharSet::empty());
+                let mut rest_nullable = true;
+                for i in (0..n).rev() {
+                    follows[i] = if rest_nullable {
+                        union_opt(&rest_set, &follow)
+                    } else {
+                        rest_set.clone()
+                    };
+                    let fi = first(&v[i], self.flags);
+                    if fi.nullable {
+                        rest_set = union_opt(&fi.set, &rest_set);
+                    } else {
+                        rest_set = fi.set;
+                        rest_nullable = false;
+                    }
+                }
+                for (el, fo) in v.iter_mut().zip(follows) {
+                    self.run(el, in_repeat, fo);
+                }
+            }
+            Node::Alt(v) => {
+                for n in v {
+                    self.run(n, in_repeat, follow.clone());
+                }
+            }
+            Node::Group(n, _) => self.run(n, in_repeat, follow),
+            // The continuation of a lookahead body always succeeds.
+            Node::Look(n, _) => self.run(n, false, None),
+            Node::Repeat(r) => {
+                r.id = self.next_id;
+                self.next_id += 1;
+                r.memo = self.memo_allowed && !in_repeat;
+                r.width = simple_width(&r.node);
+                let body_follow = union_opt(&first(&r.node, self.flags).set, &follow);
+                r.follow = follow;
+                self.run(&mut r.node, true, body_follow);
+                r.det = !first(&r.node, self.flags).nullable && is_deterministic(&r.node, self.flags);
+            }
+            _ => {}
+        }
+    }
+}
+
+fn disjoint(a: &CharSet, b: &CharSet) -> bool {
+    let a = a.positive();
+    let b = b.positive();
+    let (mut i, mut j) = (0, 0);
+    while i < a.ranges.len() && j < b.ranges.len() {
+        let (x, y) = (a.ranges[i], b.ranges[j]);
+        if x.1 < y.0 {
+            i += 1;
+        } else if y.1 < x.0 {
+            j += 1;
+        } else {
+            return false;
+        }
+    }
+    true
+}
+
+/// Whether `node` can match in at most one way that the rest of the
+/// pattern can follow, at any position. Requires the follow sets of the
+/// repetitions it contains.
+///
+/// - alternatives must be non-nullable and start with pairwise disjoint
+///   code units, or all be capture-free atoms of the same width (any of them
+///   then leads to the same state);
+/// - a repetition must be of a single code unit and be followed by code
+///   units it cannot match: only its longest run can be followed.
+fn is_deterministic(node: &Node, f: Flags) -> bool {
+    match node {
+        Node::Empty
+        | Node::Lit(_)
+        | Node::Any
+        | Node::Set(_)
+        | Node::Bol
+        | Node::Eol
+        | Node::WordB(_)
+        | Node::BackRef(_) => true,
+        Node::Look(..) => false,
+        Node::Group(n, _) => is_deterministic(n, f),
+        Node::Seq(v) => v.iter().all(|n| is_deterministic(n, f)),
+        Node::Alt(v) => {
+            if v.iter().any(|n| first(n, f).nullable || !is_deterministic(n, f)) {
+                return false;
+            }
+            if let Some(w) = v.first().and_then(simple_width) {
+                if v.iter().all(|n| simple_width(n) == Some(w)) {
+                    return true;
+                }
+            }
+            let sets: Option<Vec<CharSet>> = v.iter().map(|n| first(n, f).set).collect();
+            match sets {
+                Some(sets) => sets
+                    .iter()
+                    .enumerate()
+                    .all(|(i, a)| sets[i + 1..].iter().all(|b| disjoint(a, b))),
+                None => false,
+            }
+        }
+        Node::Repeat(r) => {
+            r.width == Some(1)
+                && match (&r.follow, first(&r.node, f).set) {
+                    (Some(follow), Some(set)) => disjoint(follow, &set),
+                    _ => false,
+                }
+        }
+    }
+}
+
+/// Width of a deterministic, capture-free atom.
+fn simple_width(node: &Node) -> Option<usize> {
+    match node {
+        Node::Lit(l) => Some(l.len()),
+        Node::Any | Node::Set(_) => Some(1),
+        Node::Seq(v) => {
+            let mut w = 0;
+            for n in v {
+                w += simple_width(n)?;
+            }
+            Some(w)
+        }
+        _ => None,
+    }
+}
+
+/// Computes a necessary condition on the start position of a match.
+fn start_req(node: &Node, f: Flags) -> StartReq {
+    fn starts_with_bol(node: &Node) -> bool {
+        match node {
+            Node::Bol => true,
+            Node::Group(n, _) => starts_with_bol(n),
+            Node::Seq(v) => v.first().map(starts_with_bol).unwrap_or(false),
+            Node::Alt(v) => !v.is_empty() && v.iter().all(starts_with_bol),
+            _ => false,
+        }
+    }
+    if starts_with_bol(node) {
+        return StartReq::Bol;
+    }
+    let fi = first(node, f);
+    match fi.set {
+        Some(set) if !fi.nullable => StartReq::Set(set),
+        _ => StartReq::None,
+    }
+}
+
+impl Regex {
+    /// Compiles `pattern` (the pattern source, as given to `new RegExp`) with
+    /// the given flags. Errors carry the V8 `SyntaxError` message.
+    pub fn new(pattern: &str, flags: &str) -> Result<Regex, String> {
+        let mut re = Regex {
+            node: Node::Empty,
+            ncaps: 0,
+            global: false,
+            ignore_case: false,
+            multiline: false,
+            dot_all: false,
+            sticky: false,
+            start: StartReq::None,
+        };
+        for f in flags.chars() {
+            let slot = match f {
+                'g' => &mut re.global,
+                'i' => &mut re.ignore_case,
+                'm' => &mut re.multiline,
+                's' => &mut re.dot_all,
+                'y' => &mut re.sticky,
+                'd' => continue,
+                _ => return Err(format!("Invalid flags supplied to RegExp constructor '{}'", flags)),
+            };
+            if *slot {
+                return Err(format!("Invalid flags supplied to RegExp constructor '{}'", flags));
+            }
+            *slot = true;
+        }
+        let p: Vec<u16> = pattern.encode_utf16().collect();
+        let mut parser = Parser {
+            p: &p,
+            i: 0,
+            total_caps: Parser::count_groups(&p),
+            ncaps: 0,
+            has_backref: false,
+        };
+        let wrap = |msg: String| format!("Invalid regular expression: /{}/{}: {}", pattern, flags, msg);
+        let mut node = parser.parse_disjunction().map_err(wrap)?;
+        if parser.i < p.len() {
+            // Only an unmatched closing parenthesis can stop the parser early.
+            return Err(wrap("Unmatched ')'".to_string()));
+        }
+        let flags = Flags {
+            ignore_case: re.ignore_case,
+            dot_all: re.dot_all,
+        };
+        Finalizer {
+            next_id: 0,
+            memo_allowed: !parser.has_backref,
+            flags,
+        }
+        .run(&mut node, false, None);
+        re.start = start_req(&node, flags);
+        re.ncaps = parser.ncaps;
+        re.node = node;
+        Ok(re)
+    }
+
+    fn can_start(&self, input: &[u16], p: usize) -> bool {
+        match &self.start {
+            StartReq::None => true,
+            StartReq::Bol => p == 0 || (self.multiline && is_line_terminator(input[p - 1])),
+            StartReq::Set(s) => p < input.len() && s.matches(input[p]),
+        }
+    }
+
+    /// Attempts a match starting exactly at `p`.
+    pub fn match_at(&self, input: &[u16], p: usize) -> Option<Captures> {
+        if p > input.len() || !self.can_start(input, p) {
+            return None;
+        }
+        let ctx = Ctx {
+            re: self,
+            input,
+            memo: RefCell::new(MemoSet::default()),
+        };
+        ctx.try_at(p)
+    }
+
+    /// Searches for the first match starting at or after `start`.
+    pub fn search(&self, input: &[u16], start: usize) -> Option<Captures> {
+        if start > input.len() {
+            return None;
+        }
+        let ctx = Ctx {
+            re: self,
+            input,
+            memo: RefCell::new(MemoSet::default()),
+        };
+        if self.sticky {
+            return if self.can_start(input, start) { ctx.try_at(start) } else { None };
+        }
+        let len = input.len();
+        let mut p = start;
+        let mut caps: Captures = vec![None; self.ncaps + 1];
+        loop {
+            // Advance to the next position satisfying the start condition.
+            match &self.start {
+                StartReq::None => {}
+                StartReq::Bol => {
+                    if p > 0 && !(self.multiline && is_line_terminator(input[p - 1])) {
+                        if !self.multiline {
+                            return None;
+                        }
+                        match input[p..].iter().position(|c| is_line_terminator(*c)) {
+                            Some(i) => p += i + 1,
+                            None => return None,
+                        }
+                    }
+                }
+                StartReq::Set(set) => match input[p..].iter().position(|c| set.matches(*c)) {
+                    Some(i) => p += i,
+                    None => return None,
+                },
+            }
+            if ctx.try_at_with(p, &mut caps) {
+                return Some(caps);
+            }
+            if p >= len {
+                return None;
+            }
+            p += 1;
+        }
+    }
+
+    /// `RegExpBuiltinExec`: honors `lastIndex` for global and sticky
+    /// expressions and updates it.
+    pub fn exec(&self, input: &[u16], last_index: &mut usize) -> Option<Captures> {
+        let lazy = !self.global && !self.sticky;
+        let start = if lazy { 0 } else { *last_index };
+        if start > input.len() {
+            if !lazy {
+                *last_index = 0;
+            }
+            return None;
+        }
+        let r = if self.sticky {
+            self.match_at(input, start)
+        } else {
+            self.search(input, start)
+        };
+        match r {
+            None => {
+                if !lazy {
+                    *last_index = 0;
+                }
+                None
+            }
+            Some(c) => {
+                if !lazy {
+                    *last_index = c[0].unwrap().1;
+                }
+                Some(c)
+            }
+        }
+    }
+
+    /// `exec` for an expression whose `lastIndex` is 0 (a fresh literal).
+    pub fn exec_fresh(&self, input: &[u16]) -> Option<Captures> {
+        let mut li = 0;
+        self.exec(input, &mut li)
+    }
+
+    pub fn test(&self, input: &[u16]) -> bool {
+        self.exec_fresh(input).is_some()
+    }
+
+    /// All successive matches, as `String.prototype.replace` and
+    /// `String.prototype.match` iterate them for a global expression.
+    pub fn all_matches(&self, input: &[u16]) -> Vec<Captures> {
+        let mut out = Vec::new();
+        if !self.global {
+            if let Some(c) = self.exec_fresh(input) {
+                out.push(c);
+            }
+            return out;
+        }
+        let mut last_index = 0usize;
+        loop {
+            let r = if self.sticky {
+                self.match_at(input, last_index)
+            } else {
+                self.search(input, last_index)
+            };
+            match r {
+                None => break,
+                Some(c) => {
+                    let (s, e) = c[0].unwrap();
+                    last_index = if s == e { e + 1 } else { e };
+                    out.push(c);
+                    if last_index > input.len() {
+                        break;
+                    }
+                }
+            }
+        }
+        out
+    }
+
+    /// `String.prototype.replace` with a replacement string.
+    pub fn replace(&self, input: &[u16], replacement: &[u16]) -> Vec<u16> {
+        self.replace_with(input, |caps, input| get_substitution(input, caps, replacement))
+    }
+
+    /// `String.prototype.replace` with a replacement function.
+    pub fn replace_with<F>(&self, input: &[u16], mut f: F) -> Vec<u16>
+    where
+        F: FnMut(&Captures, &[u16]) -> Vec<u16>,
+    {
+        let mut out = Vec::with_capacity(input.len());
+        let mut next = 0usize;
+        for caps in self.all_matches(input) {
+            let (s, e) = caps[0].unwrap();
+            if s >= next {
+                out.extend_from_slice(&input[next..s]);
+                out.extend(f(&caps, input));
+                next = e;
+            }
+        }
+        if next < input.len() {
+            out.extend_from_slice(&input[next..]);
+        }
+        out
+    }
+
+    /// `String.prototype.split` with a regular expression separator.
+    pub fn split(&self, input: &[u16]) -> Vec<Option<Vec<u16>>> {
+        let size = input.len();
+        let mut out = Vec::new();
+        if size == 0 {
+            if self.match_at_sticky(input, 0).is_some() {
+                return out;
+            }
+            out.push(Some(Vec::new()));
+            return out;
+        }
+        let mut p = 0usize;
+        let mut q = 0usize;
+        while q < size {
+            // The next position where the sticky splitter matches is the
+            // start of the next match found by a search.
+            let found = self.search_nonsticky(input, q).filter(|c| c[0].unwrap().0 < size);
+            match found {
+                None => break,
+                Some(caps) => {
+                    q = caps[0].unwrap().0;
+                    let e = caps[0].unwrap().1.min(size);
+                    if e == p {
+                        q += 1;
+                    } else {
+                        out.push(Some(input[p..q].to_vec()));
+                        for c in caps.iter().skip(1) {
+                            out.push(c.map(|(a, b)| input[a..b].to_vec()));
+                        }
+                        p = e;
+                        q = p;
+                    }
+                }
+            }
+        }
+        out.push(Some(input[p..size].to_vec()));
+        out
+    }
+
+    /// Sticky match at `p`, as used by `@@split`.
+    fn match_at_sticky(&self, input: &[u16], p: usize) -> Option<Captures> {
+        self.match_at(input, p)
+    }
+
+    /// Like `search`, ignoring the sticky flag.
+    fn search_nonsticky(&self, input: &[u16], start: usize) -> Option<Captures> {
+        if !self.sticky {
+            return self.search(input, start);
+        }
+        (start..=input.len()).find_map(|p| self.match_at(input, p))
+    }
+}
+
+/// `GetSubstitution` for replacement templates.
+pub fn get_substitution(input: &[u16], caps: &Captures, replacement: &[u16]) -> Vec<u16> {
+    let (pos, end) = caps[0].unwrap();
+    let m = caps.len() - 1;
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < replacement.len() {
+        let c = replacement[i];
+        if c != ch('$') || i + 1 >= replacement.len() {
+            out.push(c);
+            i += 1;
+            continue;
+        }
+        let n = replacement[i + 1];
+        if n == ch('$') {
+            out.push(ch('$'));
+            i += 2;
+        } else if n == ch('&') {
+            out.extend_from_slice(&input[pos..end]);
+            i += 2;
+        } else if n == ch('`') {
+            out.extend_from_slice(&input[..pos]);
+            i += 2;
+        } else if n == ch('\'') {
+            out.extend_from_slice(&input[end.min(input.len())..]);
+            i += 2;
+        } else if is_digit(n) {
+            let two = replacement.get(i + 2).copied().filter(|d| is_digit(*d));
+            let mut digit_count = if two.is_some() { 2 } else { 1 };
+            let mut index = if let Some(d2) = two {
+                ((n - 0x30) * 10 + (d2 - 0x30)) as usize
+            } else {
+                (n - 0x30) as usize
+            };
+            if index > m && digit_count == 2 {
+                digit_count = 1;
+                index = (n - 0x30) as usize;
+            }
+            if index >= 1 && index <= m {
+                if let Some((a, b)) = caps[index] {
+                    out.extend_from_slice(&input[a..b]);
+                }
+            } else {
+                out.extend_from_slice(&replacement[i..i + 1 + digit_count]);
+            }
+            i += 1 + digit_count;
+        } else {
+            out.push(c);
+            i += 1;
+        }
+    }
+    out
+}
+
+// ---------------------------------------------------------------------------
+// Matcher
+
+type Cont<'k> = dyn FnMut(usize, &mut Captures) -> bool + 'k;
+
+/// A fast hasher for the small integer keys of the memo table.
+#[derive(Default)]
+struct MemoHasher(u64);
+
+impl Hasher for MemoHasher {
+    fn write(&mut self, bytes: &[u8]) {
+        for b in bytes {
+            self.write_u64(*b as u64);
+        }
+    }
+
+    fn write_u64(&mut self, v: u64) {
+        self.0 = (self.0.rotate_left(5) ^ v).wrapping_mul(0x51_7c_c1_b7_27_22_0a_95);
+    }
+
+    fn write_u32(&mut self, v: u32) {
+        self.write_u64(v as u64);
+    }
+
+    fn write_usize(&mut self, v: usize) {
+        self.write_u64(v as u64);
+    }
+
+    fn finish(&self) -> u64 {
+        self.0
+    }
+}
+
+type MemoSet = HashSet<(usize, usize, u32, u32), BuildHasherDefault<MemoHasher>>;
+
+struct Ctx<'a> {
+    re: &'a Regex,
+    input: &'a [u16],
+    memo: RefCell<MemoSet>,
+}
+
+impl<'a> Ctx<'a> {
+    fn try_at(&self, p: usize) -> Option<Captures> {
+        let mut caps: Captures = vec![None; self.re.ncaps + 1];
+        if self.try_at_with(p, &mut caps) {
+            Some(caps)
+        } else {
+            None
+        }
+    }
+
+    /// Attempts a match at `p` using `caps` (all `None`) as the capture
+    /// buffer; on failure `caps` is left unchanged.
+    fn try_at_with(&self, p: usize, caps: &mut Captures) -> bool {
+        let mut end = 0usize;
+        let ok = self.m(&self.re.node, p, caps, &mut |e, _| {
+            end = e;
+            true
+        });
+        if ok {
+            caps[0] = Some((p, end));
+        }
+        ok
+    }
+
+    #[inline]
+    fn unit_eq(&self, a: u16, b: u16) -> bool {
+        a == b || (self.re.ignore_case && canonicalize(a) == canonicalize(b))
+    }
+
+    #[inline]
+    fn set_match(&self, s: &CharSet, c: u16) -> bool {
+        let mut found = s.contains(c);
+        if !found && self.re.ignore_case {
+            found = canonical_equivalents(c).iter().any(|a| s.contains(*a));
+        }
+        found != s.negated
+    }
+
+    fn is_bol(&self, pos: usize) -> bool {
+        pos == 0 || (self.re.multiline && is_line_terminator(self.input[pos - 1]))
+    }
+
+    fn is_eol(&self, pos: usize) -> bool {
+        pos == self.input.len() || (self.re.multiline && is_line_terminator(self.input[pos]))
+    }
+
+    /// Matches a deterministic atom (see `simple_width`) at `pos`.
+    fn simple_at(&self, node: &Node, pos: usize) -> bool {
+        let input = self.input;
+        match node {
+            Node::Lit(l) => {
+                if pos + l.len() > input.len() {
+                    return false;
+                }
+                l.iter().zip(&input[pos..]).all(|(a, b)| self.unit_eq(*a, *b))
+            }
+            Node::Any => pos < input.len() && (self.re.dot_all || !is_line_terminator(input[pos])),
+            Node::Set(s) => pos < input.len() && self.set_match(s, input[pos]),
+            Node::Seq(v) => {
+                let mut p = pos;
+                for n in v {
+                    if !self.simple_at(n, p) {
+                        return false;
+                    }
+                    p += simple_width(n).unwrap();
+                }
+                true
+            }
+            _ => unreachable!(),
+        }
+    }
+
+    fn backref_at(&self, caps: &Captures, n: usize, pos: usize) -> Option<usize> {
+        match caps[n] {
+            None => Some(0),
+            Some((a, b)) => {
+                let len = b - a;
+                if pos + len > self.input.len() {
+                    return None;
+                }
+                for k in 0..len {
+                    if !self.unit_eq(self.input[a + k], self.input[pos + k]) {
+                        return None;
+                    }
+                }
+                Some(len)
+            }
+        }
+    }
+
+    fn m(&self, node: &Node, pos: usize, caps: &mut Captures, k: &mut Cont) -> bool {
+        match node {
+            Node::Empty => k(pos, caps),
+            Node::Lit(_) | Node::Any | Node::Set(_) => {
+                if self.simple_at(node, pos) {
+                    k(pos + simple_width(node).unwrap(), caps)
+                } else {
+                    false
+                }
+            }
+            Node::Bol => self.is_bol(pos) && k(pos, caps),
+            Node::Eol => self.is_eol(pos) && k(pos, caps),
+            Node::WordB(negate) => {
+                let a = pos > 0 && is_word_char(self.input[pos - 1]);
+                let b = pos < self.input.len() && is_word_char(self.input[pos]);
+                ((a != b) != *negate) && k(pos, caps)
+            }
+            Node::Seq(v) => self.seq(v, 0, pos, caps, k),
+            Node::Alt(v) => {
+                for alt in v {
+                    if self.m(alt, pos, caps, k) {
+                        return true;
+                    }
+                }
+                false
+            }
+            Node::Group(inner, idx) => {
+                let idx = *idx;
+                self.m(inner, pos, caps, &mut |p, c: &mut Captures| {
+                    let old = c[idx];
+                    c[idx] = Some((pos, p));
+                    if k(p, c) {
+                        true
+                    } else {
+                        c[idx] = old;
+                        false
+                    }
+                })
+            }
+            Node::Look(inner, negative) => {
+                let saved = caps.clone();
+                let r = self.m(inner, pos, caps, &mut |_, _| true);
+                if *negative {
+                    *caps = saved;
+                    !r && k(pos, caps)
+                } else {
+                    if !r {
+                        return false;
+                    }
+                    if k(pos, caps) {
+                        true
+                    } else {
+                        *caps = saved;
+                        false
+                    }
+                }
+            }
+            Node::BackRef(n) => match self.backref_at(caps, *n, pos) {
+                Some(len) => k(pos + len, caps),
+                None => false,
+            },
+            Node::Repeat(r) => self.repeat(r, r.min, r.max, pos, caps, k),
+        }
+    }
+
+    fn seq(&self, v: &[Node], mut i: usize, mut pos: usize, caps: &mut Captures, k: &mut Cont) -> bool {
+        // Deterministic elements are matched inline to keep recursion shallow.
+        while i < v.len() {
+            match &v[i] {
+                n @ (Node::Lit(_) | Node::Any | Node::Set(_)) => {
+                    if !self.simple_at(n, pos) {
+                        return false;
+                    }
+                    pos += simple_width(n).unwrap();
+                }
+                Node::Bol => {
+                    if !self.is_bol(pos) {
+                        return false;
+                    }
+                }
+                Node::Eol => {
+                    if !self.is_eol(pos) {
+                        return false;
+                    }
+                }
+                Node::Empty => {}
+                _ => break,
+            }
+            i += 1;
+        }
+        if i == v.len() {
+            return k(pos, caps);
+        }
+        if i + 1 == v.len() {
+            return self.m(&v[i], pos, caps, k);
+        }
+        self.m(&v[i], pos, caps, &mut |p, c: &mut Captures| self.seq(v, i + 1, p, c, k))
+    }
+
+    fn repeat(&self, r: &RepeatNode, min: u32, max: u32, x: usize, caps: &mut Captures, k: &mut Cont) -> bool {
+        if max == 0 {
+            return k(x, caps);
+        }
+        let width = match (&r.node, r.width) {
+            (_, Some(w)) => Some(w),
+            (Node::BackRef(n), None) => match self.backref_at(caps, *n, x) {
+                Some(w) => Some(w),
+                None => {
+                    // The first iteration cannot match: only zero iterations
+                    // remain possible.
+                    return min == 0 && self.may_follow(r, x) && k(x, caps);
+                }
+            },
+            _ => None,
+        };
+        if let Some(w) = width {
+            return self.repeat_simple(r, w, min, max, x, caps, k);
+        }
+        if r.det && min == r.min && max == r.max {
+            return self.repeat_det(r, x, caps, k);
+        }
+        let key = (r.id, x, min, max);
+        if r.memo && self.memo.borrow().contains(&key) {
+            return false;
+        }
+        let (lo, hi) = (r.cap_lo, r.cap_hi);
+        let saved: Vec<Option<(usize, usize)>> = caps[lo..hi].to_vec();
+        let result = if min > 0 || r.greedy {
+            for c in &mut caps[lo..hi] {
+                *c = None;
+            }
+            let ok = {
+                let mut d = |y: usize, c: &mut Captures| -> bool {
+                    if min == 0 && y == x {
+                        return false;
+                    }
+                    let min2 = if min == 0 { 0 } else { min - 1 };
+                    let max2 = if max == INF { INF } else { max - 1 };
+                    self.repeat(r, min2, max2, y, c, k)
+                };
+                self.m(&r.node, x, caps, &mut d)
+            };
+            if ok {
+                true
+            } else {
+                caps[lo..hi].copy_from_slice(&saved);
+                min == 0 && self.may_follow(r, x) && k(x, caps)
+            }
+        } else if self.may_follow(r, x) && k(x, caps) {
+            true
+        } else {
+            for c in &mut caps[lo..hi] {
+                *c = None;
+            }
+            let ok = {
+                let mut d = |y: usize, c: &mut Captures| -> bool {
+                    if y == x {
+                        return false;
+                    }
+                    let max2 = if max == INF { INF } else { max - 1 };
+                    self.repeat(r, 0, max2, y, c, k)
+                };
+                self.m(&r.node, x, caps, &mut d)
+            };
+            if !ok {
+                caps[lo..hi].copy_from_slice(&saved);
+            }
+            ok
+        };
+        if !result && r.memo {
+            self.memo.borrow_mut().insert(key);
+        }
+        result
+    }
+
+    /// Matches a node for which `is_deterministic` holds, returning the end
+    /// of its only viable match.
+    fn det_match(&self, node: &Node, pos: usize, caps: &mut Captures) -> Option<usize> {
+        match node {
+            Node::Empty => Some(pos),
+            Node::Lit(_) | Node::Any | Node::Set(_) => {
+                if self.simple_at(node, pos) {
+                    Some(pos + simple_width(node).unwrap())
+                } else {
+                    None
+                }
+            }
+            Node::Bol => self.is_bol(pos).then_some(pos),
+            Node::Eol => self.is_eol(pos).then_some(pos),
+            Node::WordB(negate) => {
+                let a = pos > 0 && is_word_char(self.input[pos - 1]);
+                let b = pos < self.input.len() && is_word_char(self.input[pos]);
+                ((a != b) != *negate).then_some(pos)
+            }
+            Node::BackRef(n) => self.backref_at(caps, *n, pos).map(|w| pos + w),
+            Node::Group(inner, idx) => {
+                let end = self.det_match(inner, pos, caps)?;
+                caps[*idx] = Some((pos, end));
+                Some(end)
+            }
+            Node::Seq(v) => {
+                let mut p = pos;
+                for n in v {
+                    p = self.det_match(n, p, caps)?;
+                }
+                Some(p)
+            }
+            Node::Alt(v) => {
+                for n in v {
+                    let saved = caps.clone();
+                    if let Some(end) = self.det_match(n, pos, caps) {
+                        return Some(end);
+                    }
+                    *caps = saved;
+                }
+                None
+            }
+            Node::Repeat(r) => {
+                // Only the longest run can be followed.
+                let mut count = 0u32;
+                let mut p = pos;
+                while count < r.max && self.simple_at(&r.node, p) {
+                    p += 1;
+                    count += 1;
+                }
+                if count < r.min || !self.may_follow(r, p) {
+                    return None;
+                }
+                Some(p)
+            }
+            Node::Look(..) => unreachable!(),
+        }
+    }
+
+    /// Repetition of a deterministic, non-nullable node: the iterations are
+    /// computed first, then the continuation is tried after each possible
+    /// number of iterations in the order the backtracking matcher would.
+    fn repeat_det(&self, r: &RepeatNode, x: usize, caps: &mut Captures, k: &mut Cont) -> bool {
+        let (lo, hi) = (r.cap_lo, r.cap_hi);
+        let original: Vec<Option<(usize, usize)>> = caps[lo..hi].to_vec();
+        let mut ends: Vec<usize> = Vec::new();
+        // Captures of the body after each iteration.
+        let mut states: Vec<Vec<Option<(usize, usize)>>> = Vec::new();
+        let mut p = x;
+        while (ends.len() as u32) < r.max {
+            for c in &mut caps[lo..hi] {
+                *c = None;
+            }
+            match self.det_match(&r.node, p, caps) {
+                Some(end) if end > p => {
+                    ends.push(end);
+                    if hi > lo {
+                        states.push(caps[lo..hi].to_vec());
+                    }
+                    p = end;
+                }
+                _ => break,
+            }
+        }
+        let n = ends.len();
+        let min = r.min as usize;
+        if n >= min {
+            let mut attempt = |j: usize, caps: &mut Captures| -> bool {
+                let end = if j == 0 { x } else { ends[j - 1] };
+                if j == 0 {
+                    caps[lo..hi].copy_from_slice(&original);
+                } else if hi > lo {
+                    caps[lo..hi].copy_from_slice(&states[j - 1]);
+                }
+                self.may_follow(r, end) && k(end, caps)
+            };
+            if r.greedy {
+                for j in (min..=n).rev() {
+                    if attempt(j, caps) {
+                        return true;
+                    }
+                }
+            } else {
+                for j in min..=n {
+                    if attempt(j, caps) {
+                        return true;
+                    }
+                }
+            }
+        }
+        caps[lo..hi].copy_from_slice(&original);
+        false
+    }
+
+    /// Whether the continuation of `r` can possibly match at `pos`.
+    #[inline]
+    fn may_follow(&self, r: &RepeatNode, pos: usize) -> bool {
+        match &r.follow {
+            None => true,
+            Some(set) => pos < self.input.len() && set.matches(self.input[pos]),
+        }
+    }
+
+    /// Repetition of an atom that always consumes exactly `w` units.
+    fn repeat_simple(&self, r: &RepeatNode, w: usize, min: u32, max: u32, x: usize, caps: &mut Captures, k: &mut Cont) -> bool {
+        if w == 0 {
+            // Every iteration is empty: the mandatory ones succeed and any
+            // further one is rejected by the empty-iteration check.
+            return self.may_follow(r, x) && k(x, caps);
+        }
+        let matches_at = |p: usize, caps: &Captures| -> bool {
+            match &r.node {
+                Node::BackRef(n) => self.backref_at(caps, *n, p) == Some(w),
+                n => self.simple_at(n, p),
+            }
+        };
+        if r.greedy {
+            let mut count: u32 = 0;
+            let mut p = x;
+            while count < max && matches_at(p, caps) {
+                p += w;
+                count += 1;
+            }
+            if count < min {
+                return false;
+            }
+            loop {
+                let end = x + count as usize * w;
+                if self.may_follow(r, end) && k(end, caps) {
+                    return true;
+                }
+                if count == min {
+                    return false;
+                }
+                count -= 1;
+            }
+        } else {
+            let mut count: u32 = 0;
+            let mut p = x;
+            while count < min {
+                if !matches_at(p, caps) {
+                    return false;
+                }
+                p += w;
+                count += 1;
+            }
+            loop {
+                if self.may_follow(r, p) && k(p, caps) {
+                    return true;
+                }
+                if count >= max || !matches_at(p, caps) {
+                    return false;
+                }
+                p += w;
+                count += 1;
+            }
+        }
+    }
+}
