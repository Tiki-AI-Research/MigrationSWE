+//! Port of the plan helpers of `src/services/help-service.ts`:
+//! `splitBalanced`, `findNodeById`, `findNodeBySubplanName` and
+//! `shouldShowProp`.
+
+use crate::enums::property as p;
+use crate::js::lodash;
+use crate::js::regex::{get_substitution, Regex};
+use crate::js::text::{from_utf16, utf16};
+use crate::js::value::{get, loose_eq, not_a_function, strict_eq, JsResult, Val};
+
+/// `String.prototype.replace` with a string pattern: replaces the first
+/// occurrence, expanding `$` patterns in the replacement.
+fn replace_first(s: &str, search: &str, replacement: &str) -> String {
+    let u = utf16(s);
+    let su = utf16(search);
+    let pos = if su.is_empty() {
+        Some(0)
+    } else {
+        u.windows(su.len()).position(|w| w == su.as_slice())
+    };
+    match pos {
+        None => s.to_string(),
+        Some(pos) => {
+            let caps = vec![Some((pos, pos + su.len()))];
+            let mut out = u[..pos].to_vec();
+            out.extend(get_substitution(&u, &caps, &utf16(replacement)));
+            out.extend_from_slice(&u[pos + su.len()..]);
+            from_utf16(&out)
+        }
+    }
+}
+
+/// `splitBalanced(input, split)`: splits `input` on `split` (a regular
+/// expression source) outside of brackets and quotes.
+pub(crate) fn split_balanced(input: &str, split: &str) -> JsResult<Vec<String>> {
+    let pattern = replace_first(r"([\s\S]*?)(e)?(?:(o)|(c)|(t)|(sp)|$)", "sp", split);
+    let pattern = replace_first(&pattern, "o", r"[\(\{\[]");
+    let pattern = replace_first(&pattern, "c", r"[\)\}\]]");
+    let pattern = replace_first(&pattern, "t", r#"['"]"#);
+    let pattern = replace_first(&pattern, "e", r"[\\]");
+    let re = Regex::new(&pattern, "gi")?;
+    let u = utf16(input);
+    let mut stack: Vec<String> = Vec::new();
+    // `undefined` entries are joined as empty strings.
+    let mut buffer: Vec<Option<String>> = Vec::new();
+    let mut results: Vec<String> = Vec::new();
+    let join = |buffer: &[Option<String>]| -> String { buffer.iter().map(|s| s.as_deref().unwrap_or("")).collect() };
+    for caps in re.all_matches(&u) {
+        let group = |i: usize| -> Option<String> { caps.get(i).copied().flatten().map(|(a, b)| from_utf16(&u[a..b])) };
+        let truthy = |v: &Option<String>| v.as_deref().map(|s| !s.is_empty()).unwrap_or(false);
+        let (m0, m1, me, mo, mc, mt, ms) = (group(0), group(1), group(2), group(3), group(4), group(5), group(6));
+        if truthy(&me) {
+            // Escape
+            buffer.push(m1);
+            let escaped = [&ms, &mo, &mc].into_iter().find(|v| truthy(v)).cloned().unwrap_or(mt);
+            buffer.push(escaped);
+            continue;
+        } else if truthy(&mo) {
+            // Open
+            stack.push(mo.unwrap());
+        } else if truthy(&mc) {
+            // Close
+            stack.pop();
+        } else if truthy(&mt) {
+            // Toggle
+            let t = mt.unwrap();
+            if stack.last() != Some(&t) {
+                stack.push(t);
+            } else {
+                stack.pop();
+            }
+        } else {
+            // Split (if no stack) or EOF
+            let done = if truthy(&ms) { stack.is_empty() } else { !truthy(&m1) };
+            if done {
+                buffer.push(m1);
+                results.push(join(&buffer));
+                buffer.clear();
+                continue;
+            }
+        }
+        buffer.push(m0);
+    }
+    Ok(results)
+}
+
+/// `Array.prototype.some` on `plans`, which must be an array.
+fn array_some<F>(plans: &Val, expr: &str, f: &mut F) -> JsResult<bool>
+where
+    F: FnMut(&Val) -> JsResult<bool>,
+{
+    match plans {
+        Val::Arr(a) => {
+            for child in a.to_vec() {
+                if f(&child)? {
+                    return Ok(true);
+                }
+            }
+            Ok(false)
+        }
+        _ => {
+            get(plans, "some")?;
+            Err(not_a_function(&format!("{}.some", expr)))
+        }
+    }
+}
+
+fn find_in_children(plans: &Val, id: &Val, expr: &str) -> JsResult<Val> {
+    let mut found = Val::Undef;
+    fn iter(child: &Val, id: &Val, found: &mut Val) -> JsResult<bool> {
+        if strict_eq(&get(child, "nodeId")?, id) {
+            *found = child.clone();
+            return Ok(true);
+        }
+        let plans = get(child, p::PLANS)?;
+        if !plans.truthy() {
+            return Ok(false);
+        }
+        array_some(&plans, "child.Plans", &mut |c| iter(c, id, found))
+    }
+    array_some(plans, expr, &mut |c| iter(c, id, &mut found))?;
+    Ok(found)
+}
+
+/// `findNodeById(plan, id)`.
+pub(crate) fn find_node_by_id(plan: &Val, id: f64) -> JsResult<Val> {
+    let id = Val::Num(id);
+    let root = get(&get(plan, "content")?, "Plan")?;
+    if loose_eq(&get(&root, "nodeId")?, &id) {
+        return Ok(root);
+    }
+    let mut o = Val::Undef;
+    if root.truthy() && get(&root, p::PLANS)?.truthy() {
+        o = find_in_children(&get(&root, p::PLANS)?, &id, "root.Plans")?;
+        if !o.truthy() && get(plan, "ctes")?.truthy() {
+            for cte in lodash::values(&get(plan, "ctes")?) {
+                if loose_eq(&get(&cte, "nodeId")?, &id) {
+                    o = cte;
+                    break;
+                } else if get(&cte, p::PLANS)?.truthy() {
+                    o = find_in_children(&get(&cte, p::PLANS)?, &id, "cte.Plans")?;
+                    if o.truthy() {
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    Ok(o)
+}
+
+/// `findNodeBySubplanName(plan, subplanName)`.
+pub(crate) fn find_node_by_subplan_name(plan: &Val, subplan_name: &str) -> JsResult<Val> {
+    let ctes = get(plan, "ctes")?;
+    if ctes.truthy() {
+        let name = Val::from(format!("CTE {}", subplan_name));
+        for cte in lodash::values(&ctes) {
+            if loose_eq(&get(&cte, p::SUBPLAN_NAME)?, &name) {
+                return Ok(cte);
+            }
+        }
+    }
+    Ok(Val::Undef)
+}
+
