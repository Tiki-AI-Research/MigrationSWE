+                "maxBlocks": {},
+                "maxIo": 0,
+                "maxEstimateFactor": 1
+            }
+        }),
+    );
+    assert!(plan["id"].as_str().unwrap().starts_with("plan_"));
+    // Values that are NaN in JavaScript are serialized as null
+    assert_eq!(plan["content"]["Plan"]["*Shared Hit Blocks (exclusive)"], Value::Null);
+
+    let json_content = pev2_core::from_source(
+        r#"[{"Plan": {"Node Type": "Seq Scan", "Total Cost": 1.0, "Plan Rows": 10}}]"#,
+    )
+    .unwrap();
+    let plan = Value::Object(pev2_core::create_plan("", json_content, "select 1").unwrap());
+    assert_eq!(plan["isAnalyze"], json!(false));
+    assert!(plan["name"].as_str().unwrap().starts_with("plan created on "));
+}
+
+#[test]
+fn create_plan_ctes() {
+    let plan = common::plan_from_source(CTE_PLAN);
+    let ctes = plan["ctes"].as_array().unwrap();
+    assert_eq!(ctes.len(), 1);
+    assert_eq!(ctes[0]["Subplan Name"], "CTE c");
+    assert_eq!(ctes[0]["nodeId"], 2);
+    // The CTE is not one of the plan's nodes anymore
+    let root = &plan["content"]["Plan"];
+    assert_eq!(root["Plans"].as_array().unwrap().len(), 1);
+    assert_eq!(root["Plans"][0]["nodeId"], 3);
+    assert_eq!(num(root, "/*Duration (exclusive)"), 1.0 - 0.8);
+    // The CTE scan duration excludes its share of the CTE duration
+    assert_eq!(num(root, "/Plans/0/*Duration (exclusive)"), f64::max(0.0, 0.8 - (0.5 * 0.8) / 0.8));
+    assert_eq!(num(&plan, "/content/maxDuration"), 0.5);
+    assert_eq!(num(&plan, "/content/maxEstimateFactor"), 2.0);
+
+    let plan = plan.as_object().unwrap();
+    let cte = pev2_core::find_node_by_subplan_name(plan, "c").unwrap();
+    assert_eq!(cte["nodeId"], 2);
+    assert!(pev2_core::find_node_by_subplan_name(plan, "d").is_none());
+    assert_eq!(pev2_core::find_node_by_id(plan, 2).unwrap()["Node Type"], "Seq Scan");
+    assert_eq!(pev2_core::find_node_by_id(plan, 3).unwrap()["Node Type"], "CTE Scan");
+    assert!(pev2_core::find_node_by_id(plan, 4).is_none());
+}
+
+#[test]
+fn property_names() {
+    assert_eq!(pev2_core::enums::property::ACTUAL_ROWS, "Actual Rows");
+    assert_eq!(pev2_core::enums::to_property("TOTAL_COST"), Ok("Total Cost"));
+    assert_eq!(
+        pev2_core::enums::to_property("NOPE"),
+        Err("\"NOPE\" is not a valid Property key".to_string())
+    );
+}
diff --git a/crates/pev2-core/tests/common/mod.rs b/crates/pev2-core/tests/common/mod.rs
new file mode 100644
index 0000000..2439a90
--- /dev/null
+++ b/crates/pev2-core/tests/common/mod.rs
@@ -0,0 +1,97 @@
+//! Helpers shared by the integration tests, which mirror the Vitest specs of
+//! `src/services/__tests__` and read the same fixtures.
+
+#![allow(dead_code)]
+
+use serde_json::Value;
+use std::path::PathBuf;
+
+/// Directory of the TypeScript specs and their fixtures.
+pub fn fixtures_dir() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../src/services/__tests__")
+}
+
+pub fn read_fixture(relative: &str) -> String {
+    let path = fixtures_dir().join(relative);
+    std::fs::read_to_string(&path).unwrap_or_else(|e| panic!("cannot read {}: {}", path.display(), e))
+}
+
+/// Files of a fixture directory, sorted by name.
+pub fn fixture_files(relative: &str) -> Vec<String> {
+    let mut names: Vec<String> = std::fs::read_dir(fixtures_dir().join(relative))
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    names.sort();
+    names
+}
+
+/// Collects the differences between `actual` and `expected` under Jest's
+/// `toMatchObject` semantics: objects must contain the expected properties
+/// (recursively), arrays must have the same length and matching elements,
+/// numbers are compared by value.
+fn match_object(actual: &Value, expected: &Value, path: &str, diffs: &mut Vec<String>) {
+    match (actual, expected) {
+        (Value::Object(a), Value::Object(e)) => {
+            for (k, ev) in e {
+                let p = format!("{}.{}", path, k);
+                match a.get(k) {
+                    Some(av) => match_object(av, ev, &p, diffs),
+                    None => diffs.push(format!("{}: missing, expected {}", p, ev)),
+                }
+            }
+        }
+        (Value::Array(a), Value::Array(e)) => {
+            if a.len() != e.len() {
+                diffs.push(format!("{}: length {} instead of {}", path, a.len(), e.len()));
+                return;
+            }
+            for (i, (av, ev)) in a.iter().zip(e).enumerate() {
+                match_object(av, ev, &format!("{}[{}]", path, i), diffs);
+            }
+        }
+        (Value::Number(a), Value::Number(e)) => {
+            if a.as_f64() != e.as_f64() {
+                diffs.push(format!("{}: {} instead of {}", path, a, e));
+            }
+        }
+        (a, e) => {
+            if a != e {
+                diffs.push(format!("{}: {} instead of {}", path, a, e));
+            }
+        }
+    }
+}
+
+/// `expect(actual).toMatchObject(expected)`.
+#[track_caller]
+pub fn assert_match_object(actual: &Value, expected: &Value) {
+    let mut diffs = Vec::new();
+    match_object(actual, expected, "$", &mut diffs);
+    assert!(diffs.is_empty(), "object does not match:\n  {}", diffs.join("\n  "));
+}
+
+/// Number at a JSON pointer-like path (`/`-separated keys and indices).
+#[track_caller]
+pub fn num(v: &Value, pointer: &str) -> f64 {
+    v.pointer(pointer)
+        .and_then(Value::as_f64)
+        .unwrap_or_else(|| panic!("no number at {}: {:?}", pointer, v.pointer(pointer)))
+}
+
+/// Depth-first search for the first node (in `Plan`/`Plans`) satisfying `pred`.
+pub fn find_node<'a>(node: &'a Value, pred: &dyn Fn(&Value) -> bool) -> Option<&'a Value> {
+    if pred(node) {
+        return Some(node);
+    }
+    node.get("Plans")?
+        .as_array()?
+        .iter()
+        .find_map(|child| find_node(child, pred))
+}
+
+/// The plan content and plan for a source, as `createPlan("", fromSource(source), "")`.
+pub fn plan_from_source(source: &str) -> Value {
+    let content = pev2_core::from_source(source).expect("source parses");
+    Value::Object(pev2_core::create_plan("", content, "").expect("plan is created"))
+}
