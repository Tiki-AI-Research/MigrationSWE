@@ -0,0 +1,87 @@
+use pev2_core::{create_plan, from_json, from_text, get_plan_content};
+use serde_json::Value;
+
+const SOURCE: &str = "Seq Scan on records  (cost=0.00..3.00 rows=2 width=8)";
+
+#[test]
+fn equal_json_construction_does_not_change_live_text_results() {
+    let first = from_text(SOURCE).unwrap();
+    let second = from_text(SOURCE).unwrap();
+    let serialized = serde_json::to_value(&first).unwrap();
+    assert!(serialized["Plan"].get("Actual Rows").is_none());
+
+    let object = get_plan_content(&serialized).unwrap();
+    assert_eq!(create_plan("", object, "").unwrap()["isAnalyze"], false);
+
+    let json_text = serde_json::to_string_pretty(&vec![&serialized]).unwrap();
+    let json = from_json(&json_text).unwrap();
+    assert_eq!(create_plan("", first, "").unwrap()["isAnalyze"], true);
+    assert_eq!(create_plan("", json, "").unwrap()["isAnalyze"], false);
+    assert_eq!(create_plan("", second, "").unwrap()["isAnalyze"], true);
+}
+
+#[test]
+fn retained_text_result_survives_unrelated_parsing() {
+    let retained = from_text(SOURCE).unwrap();
+    let others: Vec<_> = (0..200)
+        .map(|i| from_text(&format!("Seq Scan on records_{i}  (cost=0.00..3.00 rows=2 width=8)")).unwrap())
+        .collect();
+    assert_eq!(create_plan("", retained, "").unwrap()["isAnalyze"], true);
+    for content in others {
+        assert_eq!(create_plan("", content, "").unwrap()["isAnalyze"], true);
+    }
+}
+
+#[test]
+fn parse_result_can_move_to_another_thread() {
+    let content = from_text(SOURCE).unwrap();
+    let plan = std::thread::spawn(move || create_plan("", content, "").unwrap()).join().unwrap();
+    assert_eq!(plan["isAnalyze"], true);
+}
+
+#[test]
+fn explicit_json_values_are_not_replaced_by_an_old_snapshot() {
+    let mut content = from_text(SOURCE).unwrap();
+    content.get_mut("Plan").unwrap().as_object_mut().unwrap()
+        .insert("Actual Rows".into(), Value::from(7));
+    let plan = create_plan("", content, "").unwrap();
+    assert_eq!(plan["content"]["Plan"]["Actual Rows"], 7);
+}
+
+#[test]
+fn adding_global_fields_keeps_text_node_fields() {
+    let mut content = from_text(SOURCE).unwrap();
+    content.insert("Query Text".into(), Value::from("select * from records"));
+    let plan = create_plan("", content, "").unwrap();
+    assert_eq!(plan["isAnalyze"], true);
+    assert_eq!(plan["content"]["Query Text"], "select * from records");
+}
+
+#[test]
+fn editing_node_properties_keeps_its_other_own_fields() {
+    let mut content = from_text(SOURCE).unwrap();
+    let root = content.get_mut("Plan").unwrap().as_object_mut().unwrap();
+    root.insert("Relation Name".into(), Value::from("renamed"));
+    root.insert("Plan Rows".into(), Value::from(9));
+    let plan = create_plan("", content, "").unwrap();
+    assert_eq!(plan["isAnalyze"], true);
+    assert_eq!(plan["content"]["Plan"]["Relation Name"], "renamed");
+    assert_eq!(plan["content"]["Plan"]["Plan Rows"], 9);
+}
+
+#[test]
+fn replacing_a_text_node_with_json_does_not_keep_its_undefined_fields() {
+    let mut content = from_text(SOURCE).unwrap();
+    let plain = content["Plan"].clone();
+    content.insert("Plan".into(), plain);
+    assert_eq!(create_plan("", content, "").unwrap()["isAnalyze"], false);
+}
+
+#[test]
+fn removing_an_explicit_property_does_not_restore_it_as_a_class_field() {
+    let mut content = from_text(
+        "Seq Scan on records  (cost=0.00..3.00 rows=2 width=8) (actual time=0.1..0.2 rows=2 loops=1)",
+    ).unwrap();
+    content.get_mut("Plan").unwrap().as_object_mut().unwrap().remove("Actual Rows");
+    assert_eq!(create_plan("", content, "").unwrap()["isAnalyze"], false);
+}
