+    #[test]
+    fn case_helpers() {
+        assert_eq!(start_case("Planning time"), "Planning Time");
+        assert_eq!(start_case("Total runtime"), "Total Runtime");
+        assert_eq!(start_case("I/O Timings"), "I O Timings");
+        assert_eq!(start_case("fooBar baz"), "Foo Bar Baz");
+        assert_eq!(capitalize("SHARED"), "Shared");
+        assert_eq!(upper_case("shared"), "SHARED");
+        assert_eq!(deburr("déjà vu"), "deja vu");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Collection helpers, with lodash's handling of arrays, array-likes and
+// plain objects.
+
+use super::value::{get, gt, JsResult, Obj, Val};
+
+const MAX_SAFE_INTEGER: f64 = 9007199254740991.0;
+
+fn object_array_like_len(o: &Obj) -> Option<usize> {
+    match o.get("length") {
+        Some(Val::Num(n)) if n > -1.0 && n.fract() == 0.0 && n <= MAX_SAFE_INTEGER => Some(n as usize),
+        _ => None,
+    }
+}
+
+/// The `(key, value)` pairs visited by `_.forEach` and friends.
+pub fn entries(v: &Val) -> Vec<(Val, Val)> {
+    match v {
+        Val::Arr(a) => a
+            .to_vec()
+            .into_iter()
+            .enumerate()
+            .map(|(i, x)| (Val::Num(i as f64), x))
+            .collect(),
+        Val::Str(s) => s
+            .encode_utf16()
+            .enumerate()
+            .map(|(i, u)| (Val::Num(i as f64), Val::from(String::from_utf16_lossy(&[u]))))
+            .collect(),
+        Val::Obj(o) => match object_array_like_len(o) {
+            Some(n) => (0..n)
+                .map(|i| (Val::Num(i as f64), o.get(&i.to_string()).unwrap_or(Val::Undef)))
+                .collect(),
+            None => o
+                .entries_ordered()
+                .into_iter()
+                .map(|(k, v)| (Val::Str(k), v))
+                .collect(),
+        },
+        _ => Vec::new(),
+    }
+}
+
+/// The values visited by `_.forEach`, `_.map`, `_.filter`, `_.some`, ...
+pub fn values(v: &Val) -> Vec<Val> {
+    entries(v).into_iter().map(|(_, v)| v).collect()
+}
+
+/// `_.filter(collection, predicate)`.
+pub fn filter<F>(v: &Val, mut pred: F) -> JsResult<Vec<Val>>
+where
+    F: FnMut(&Val) -> JsResult<bool>,
+{
+    let mut out = Vec::new();
+    for x in values(v) {
+        if pred(&x)? {
+            out.push(x);
+        }
+    }
+    Ok(out)
+}
+
+/// `_.some(collection, predicate)`.
+pub fn some<F>(v: &Val, mut pred: F) -> JsResult<bool>
+where
+    F: FnMut(&Val) -> JsResult<bool>,
+{
+    for x in values(v) {
+        if pred(&x)? {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+/// `_.find(collection, predicate)`.
+pub fn find<F>(v: &Val, mut pred: F) -> JsResult<Val>
+where
+    F: FnMut(&Val) -> JsResult<bool>,
+{
+    for x in values(v) {
+        if pred(&x)? {
+            return Ok(x);
+        }
+    }
+    Ok(Val::Undef)
+}
+
+/// `_.last(array)`.
+pub fn last(v: &Val) -> JsResult<Val> {
+    match v {
+        Val::Undef | Val::Null => Ok(Val::Undef),
+        Val::Arr(a) => Ok(if a.is_empty() { Val::Undef } else { a.get(a.len() - 1) }),
+        _ => {
+            let len = get(v, "length")?;
+            if !len.truthy() {
+                return Ok(Val::Undef);
+            }
+            let key = Val::Num(len.to_number() - 1.0).to_js_string();
+            get(v, &key)
+        }
+    }
+}
+
+/// `_.has(object, key)` for a simple key.
+pub fn has(v: &Val, key: &str) -> bool {
+    match v {
+        Val::Obj(o) => o.has(key),
+        Val::Arr(a) => key == "length" || key.parse::<usize>().map(|i| i < a.len() && i.to_string() == key).unwrap_or(false),
+        Val::Str(s) => key == "length" || key.parse::<usize>().map(|i| i < s.encode_utf16().count() && i.to_string() == key).unwrap_or(false),
+        _ => false,
+    }
+}
+
+/// `_.startsWith(value, target)`.
+pub fn starts_with(v: &Val, target: &str) -> bool {
+    let s = to_string(v);
+    let su: Vec<u16> = s.encode_utf16().collect();
+    let tu: Vec<u16> = target.encode_utf16().collect();
+    su.len() >= tu.len() && su[..tu.len()] == tu[..]
+}
+
+/// lodash `toString`: `null`/`undefined` become the empty string.
+pub fn to_string(v: &Val) -> String {
+    match v {
+        Val::Undef | Val::Null => String::new(),
+        Val::Num(n) if *n == 0.0 && n.is_sign_negative() => "-0".to_string(),
+        Val::Arr(a) => a.to_vec().iter().map(to_string).collect::<Vec<_>>().join(","),
+        v => v.to_js_string(),
+    }
+}
+
+/// `_.sumBy(array, iteratee)`.
+pub fn sum_by<F>(items: &[Val], mut iteratee: F) -> JsResult<Val>
+where
+    F: FnMut(&Val) -> JsResult<Val>,
+{
+    if items.is_empty() {
+        return Ok(Val::Num(0.0));
+    }
+    let mut result = Val::Undef;
+    for x in items {
+        let current = iteratee(x)?;
+        if !current.is_undef() {
+            result = if result.is_undef() {
+                current
+            } else {
+                super::value::add(&result, &current)
+            };
+        }
+    }
+    Ok(result)
+}
+
+/// `_.maxBy(array, iteratee)`.
+pub fn max_by<F>(items: &[Val], mut iteratee: F) -> JsResult<Val>
+where
+    F: FnMut(&Val) -> JsResult<Val>,
+{
+    let mut computed: Option<Val> = None;
+    let mut result = Val::Undef;
+    for x in items {
+        let current = iteratee(x)?;
+        if current.is_nullish() {
+            continue;
+        }
+        let better = match &computed {
+            None => !matches!(current, Val::Num(n) if n.is_nan()),
+            Some(c) => gt(&current, c),
+        };
+        if better {
+            computed = Some(current);
+            result = x.clone();
+        }
+    }
+    Ok(result)
+}
+
+/// `_.max(array)`.
+pub fn max(items: &[Val]) -> Val {
+    max_by(items, |v| Ok(v.clone())).unwrap_or(Val::Undef)
+}
+
+/// `_.remove(array, predicate)` (only arrays can actually be modified).
+pub fn remove<F>(v: &Val, mut pred: F) -> JsResult<()>
+where
+    F: FnMut(&Val) -> JsResult<bool>,
+{
+    if let Val::Arr(a) = v {
+        let mut indexes = Vec::new();
+        for (i, x) in a.to_vec().iter().enumerate() {
+            if pred(x)? {
+                indexes.push(i);
+            }
+        }
+        a.retain_indices(&indexes);
+    } else if v.truthy() && get(v, "length")?.truthy() {
+        for x in values(v) {
+            pred(&x)?;
+        }
+    }
+    Ok(())
+}
+
+/// `_.flattenDeep` applied to a single value.
+pub fn flatten_into(v: &Val, out: &mut Vec<Val>) {
+    match v {
+        Val::Arr(a) => {
+            for x in a.to_vec() {
+                flatten_into(&x, out);
+            }
+        }
+        v => out.push(v.clone()),
+    }
+}
