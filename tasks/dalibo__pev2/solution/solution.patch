+//! Fixture-driven specs: `from-text.spec.ts`, `11-psql-frames.spec.ts`,
+//! `12-line-wrapped-plans.spec.ts` and `21-io-timings.spec.ts`.
+
+mod common;
+
+use common::{assert_match_object, fixture_files, read_fixture};
+use serde_json::Value;
+
+/// Removes keys that cannot be determined from text format, for fixtures
+/// whose `-expect` file was generated with `EXPLAIN (FORMAT JSON)`.
+fn remove_keys(node: &mut Value) {
+    match node {
+        Value::Array(nodes) => nodes.iter_mut().for_each(remove_keys),
+        Value::Object(o) => {
+            o.remove("Inner Unique");
+            if let Some(plans) = o.get_mut("Plans") {
+                remove_keys(plans);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Runs `check` for every name, reporting all failures at once.
+fn for_each_fixture(names: &[String], check: impl Fn(&str)) {
+    let failures: Vec<String> = names
+        .iter()
+        .filter_map(|name| {
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| check(name)))
+                .err()
+                .map(|e| {
+                    let msg = e
+                        .downcast_ref::<String>()
+                        .cloned()
+                        .or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string()))
+                        .unwrap_or_default();
+                    format!("{}: {}", name, msg)
+                })
+        })
+        .collect();
+    assert!(failures.is_empty(), "{} fixture(s) failed:\n{}", failures.len(), failures.join("\n"));
+}
+
+#[test]
+fn from_text_fixtures() {
+    let plans: Vec<String> = fixture_files("from-text")
+        .into_iter()
+        .filter(|f| f.ends_with("-plan"))
+        .collect();
+    assert!(!plans.is_empty());
+    for_each_fixture(&plans, |plan_test| {
+        let plan_text = read_fixture(&format!("from-text/{}", plan_test));
+        let expect_name = format!("{}-expect", plan_test.trim_end_matches("-plan"));
+        let mut expected: Value = serde_json::from_str(&read_fixture(&format!("from-text/{}", expect_name))).unwrap();
+        if let Value::Array(mut a) = expected {
+            expected = a.remove(0);
+        }
+        remove_keys(&mut expected["Plan"]);
+        let r = pev2_core::from_source(&plan_text).unwrap();
+        assert_match_object(&Value::Object(r), &expected);
+    });
+}
+
+#[test]
+fn psql_frames_fixtures() {
+    let files = fixture_files("11-psql-frames");
+    assert!(!files.is_empty());
+    for_each_fixture(&files, |plan_test| {
+        let source = read_fixture(&format!("11-psql-frames/{}", plan_test));
+        // Fails if the service is unable to parse the file
+        pev2_core::from_source(&source).unwrap();
+    });
+}
+
+#[test]
+fn line_wrapped_fixtures() {
+    let mut tests: Vec<String> = fixture_files("12-line-wrapped-plans")
+        .into_iter()
+        .map(|f| f.split('-').next().unwrap().to_string())
+        .collect();
+    tests.dedup();
+    assert!(!tests.is_empty());
+    for_each_fixture(&tests, |plan_test| {
+        let plan_text = read_fixture(&format!("12-line-wrapped-plans/{}-plan", plan_test));
+        let expected: Value =
+            serde_json::from_str(&read_fixture(&format!("12-line-wrapped-plans/{}-expect", plan_test))).unwrap();
+        let r = pev2_core::from_source(&plan_text).unwrap();
+        assert_match_object(&Value::Object(r), &expected);
+    });
+}
+
+#[test]
+fn io_timings_fixtures() {
+    let mut tests: Vec<String> = fixture_files("21-io-timings")
+        .into_iter()
+        .map(|f| f.split('.').next().unwrap().to_string())
+        .collect();
+    tests.dedup();
+    assert!(!tests.is_empty());
+    for_each_fixture(&tests, |plan_test| {
+        let plan_text = read_fixture(&format!("21-io-timings/{}.plan", plan_test));
+        let expected: Value =
+            serde_json::from_str(&read_fixture(&format!("21-io-timings/{}.expect", plan_test))).unwrap();
+        let content = pev2_core::from_source(&plan_text).unwrap();
+        let plan = pev2_core::create_plan("", content, "").unwrap();
+        // Verify timings for the first node
+        assert_match_object(&plan["content"]["Plan"], &expected);
+    });
+}
