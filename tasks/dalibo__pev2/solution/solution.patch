+//! Port of `src/services/plan-service.ts`.
+//!
+//! The code follows the TypeScript implementation statement by statement on
+//! top of the JavaScript value model in [`crate::js`], so that parsing,
+//! coercions, evaluation order and the floating point computations of the
+//! derived metrics are reproduced exactly.
+
+use crate::enums::property as p;
+use crate::help_service::split_balanced;
+use crate::interfaces::new_node;
+use crate::js::json;
+use crate::js::lodash::{self, capitalize, start_case, trim as ld_trim};
+use crate::js::regex::{js_regex, Captures, Regex};
+use crate::js::text::{from_utf16, parse_float, parse_int, to_fixed_number, trim, utf16};
+use crate::js::value::{
+    add, get, gt, loose_eq, lt, max_zero, not_a_function, or, push, same_value_zero, set, strict_eq, Arr, JsResult,
+    Obj, Val,
+};
+
+/// Captured groups of a successful `exec`.
+struct Match<'a> {
+    input: &'a [u16],
+    caps: Captures,
+}
+
+impl<'a> Match<'a> {
+    fn new(input: &'a [u16], caps: Captures) -> Match<'a> {
+        Match { input, caps }
+    }
+
+    fn get(&self, i: usize) -> Option<String> {
+        self.caps.get(i).copied().flatten().map(|(a, b)| from_utf16(&self.input[a..b]))
+    }
+
+    /// The group as a JavaScript value (`undefined` when not participating).
+    fn val(&self, i: usize) -> Val {
+        self.get(i).map(Val::from).unwrap_or(Val::Undef)
+    }
+
+    /// The group when it is truthy (participating and non-empty).
+    fn truthy(&self, i: usize) -> Option<String> {
+        self.get(i).filter(|s| !s.is_empty())
+    }
+
+    /// `m[a] || m[b]` as a string for `parseFloat`/`parseInt` (which turn
+    /// `undefined` into `"undefined"`).
+    fn either(&self, a: usize, b: usize) -> String {
+        self.truthy(a)
+            .or_else(|| self.get(b))
+            .unwrap_or_else(|| "undefined".to_string())
+    }
+
+    fn str_or_undefined(&self, i: usize) -> String {
+        self.get(i).unwrap_or_else(|| "undefined".to_string())
+    }
+}
+
+fn exec<'a>(re: &Regex, input: &'a [u16]) -> Option<Match<'a>> {
+    re.exec_fresh(input).map(|caps| Match::new(input, caps))
+}
+
+fn replace(re: &Regex, s: &str, replacement: &str) -> String {
+    from_utf16(&re.replace(&utf16(s), &utf16(replacement)))
+}
+
+fn split(re: &Regex, s: &str) -> Vec<Option<String>> {
+    re.split(&utf16(s))
+        .into_iter()
+        .map(|part| part.map(|u| from_utf16(&u)))
+        .collect()
+}
+
+/// `str.split(re)` where `re` has no capture groups.
+fn split_strings(re: &Regex, s: &str) -> Vec<String> {
+    split(re, s).into_iter().map(|p| p.unwrap_or_default()).collect()
+}
+
+fn num(v: f64) -> Val {
+    Val::Num(v)
+}
+
+fn s(v: &str) -> Val {
+    Val::from(v)
+}
+
+fn arr(items: Vec<Val>) -> Val {
+    Val::Arr(Arr::new(items))
+}
+
+/// The key `Property[name]` designates (`undefined` keys become the
+/// property `"undefined"`, as in JavaScript).
+fn property_key(name: &str) -> &'static str {
+    static BY_NAME: std::sync::OnceLock<std::collections::HashMap<&'static str, &'static str>> =
+        std::sync::OnceLock::new();
+    let map = BY_NAME.get_or_init(|| crate::enums::PROPERTIES.iter().copied().collect());
+    map.get(name).copied().unwrap_or("undefined")
+}
+
+// V8 describes the callee of a failed call with the source text of the
+// running code. These are the names the modules' imports have when the
+// TypeScript implementation runs under the project's test runner (Vite SSR
+// transform), so that error messages are the same.
+macro_rules! PROPERTY_IMPORT {
+    () => {
+        "__vite_ssr_import_1__.Property"
+    };
+}
+macro_rules! LODASH_IMPORT {
+    () => {
+        "__vite_ssr_import_0__.default"
+    };
+}
+
+/// `Number(v.toFixed(3))`.
+fn to_fixed3(v: &Val, expr: &str) -> JsResult<f64> {
+    match v {
+        Val::Num(n) => Ok(to_fixed_number(*n, 3)),
+        Val::Undef => Err("Cannot read properties of undefined (reading 'toFixed')".to_string()),
+        Val::Null => Err("Cannot read properties of null (reading 'toFixed')".to_string()),
+        _ => Err(not_a_function(&format!("{}.toFixed", expr))),
+    }
+}
+
+/// An entry of the parser's depth stack (`NodeElement` / `JitElement`).
+#[derive(Clone)]
+struct Element {
+    node: Val,
+    subelement_type: Option<String>,
+    name: Option<String>,
+}
+
+impl Element {
+    fn plain(node: Val) -> Element {
+        Element {
+            node,
+            subelement_type: None,
+            name: None,
+        }
+    }
+}
+
+/// `PlanService`.
+#[derive(Default)]
+pub(crate) struct PlanService {
+    node_id: f64,
+    flat: Vec<Val>,
+}
+
+const CALCULATED_REVISED: &[(&str, &str)] = &[
+    (p::ACTUAL_ROWS, p::ACTUAL_ROWS_REVISED),
+    (p::PLAN_ROWS, p::PLAN_ROWS_REVISED),
+    (p::ROWS_REMOVED_BY_FILTER, p::ROWS_REMOVED_BY_FILTER_REVISED),
+    (p::ROWS_REMOVED_BY_JOIN_FILTER, p::ROWS_REMOVED_BY_JOIN_FILTER_REVISED),
+    (p::ROWS_REMOVED_BY_INDEX_RECHECK, p::ROWS_REMOVED_BY_INDEX_RECHECK_REVISED),
+];
+
+const BUFFERS_IO_PROPERTIES: &[&str] = &[
+    "SHARED_HIT_BLOCKS",
+    "SHARED_READ_BLOCKS",
+    "SHARED_DIRTIED_BLOCKS",
+    "SHARED_WRITTEN_BLOCKS",
+    "TEMP_READ_BLOCKS",
+    "TEMP_WRITTEN_BLOCKS",
+    "LOCAL_HIT_BLOCKS",
+    "LOCAL_READ_BLOCKS",
+    "LOCAL_DIRTIED_BLOCKS",
+    "LOCAL_WRITTEN_BLOCKS",
+    "IO_READ_TIME",
+    "IO_WRITE_TIME",
+    "SHARED_IO_READ_TIME",
+    "SHARED_IO_WRITE_TIME",
+    "LOCAL_IO_READ_TIME",
+    "LOCAL_IO_WRITE_TIME",
+    "TEMP_IO_READ_TIME",
+    "TEMP_IO_WRITE_TIME",
+];
+
+/// `(Property[p], Property["EXCLUSIVE_" + p])` for the buffers and I/O
+/// properties of `calculateBuffersIOExclusives`.
+fn buffers_io_keys() -> &'static [(&'static str, &'static str)] {
+    static KEYS: std::sync::OnceLock<Vec<(&'static str, &'static str)>> = std::sync::OnceLock::new();
+    KEYS.get_or_init(|| {
+        BUFFERS_IO_PROPERTIES
+            .iter()
+            .map(|name| (property_key(name), property_key(&format!("EXCLUSIVE_{}", name))))
+            .collect()
+    })
+}
+
+/// Property keys used by `calculateIoTimingsAverage` for a timing scope,
+/// indexed by operation (`read`, `write`) and prefix (`exclusive_`, ``).
+struct TimingScope {
+    time: [[&'static str; 2]; 2],
+    speed: [[&'static str; 2]; 2],
+    buffers: [[Vec<&'static str>; 2]; 2],
+}
+
+struct IoTimingTables {
+    pre_pg15: Vec<TimingScope>,
+    pg15: Vec<TimingScope>,
+    pg17: Vec<TimingScope>,
+    buffers: [[&'static str; 2]; 2],
+    sum_time: [[&'static str; 2]; 2],
+    sum_speed: [[&'static str; 2]; 2],
+}
+
+/// The property keys `calculateIoTimingsAverage` builds from its scopes
+/// matrices, resolved once.
+fn io_timing_tables() -> &'static IoTimingTables {
+    const OPERATIONS: [&str; 2] = ["read", "write"];
+    const BUFFERS_OPERATIONS: [&str; 2] = ["read", "written"];
+    const PREFIXES: [&str; 2] = ["exclusive_", ""];
+    fn key(s: String) -> &'static str {
+        property_key(&s.to_uppercase())
+    }
+    fn scope(timing_scope: &str, buffers_scopes: &[&str]) -> TimingScope {
+        let scoped = if timing_scope.is_empty() {
+            String::new()
+        } else {
+            format!("{}_", timing_scope)
+        };
+        let grid = |f: &dyn Fn(usize, &str) -> &'static str| -> [[&'static str; 2]; 2] {
+            [[f(0, PREFIXES[0]), f(0, PREFIXES[1])], [f(1, PREFIXES[0]), f(1, PREFIXES[1])]]
+        };
+        let buffers = |op: usize, prefix: &str| -> Vec<&'static str> {
+            buffers_scopes
+                .iter()
+                .map(|b| key(format!("{}{}_{}_blocks", prefix, b, BUFFERS_OPERATIONS[op])))
+                .collect()
+        };
+        TimingScope {
+            time: grid(&|op, prefix| key(format!("{}{}io_{}_time", prefix, scoped, OPERATIONS[op]))),
+            speed: grid(&|op, prefix| key(format!("{}average_{}io_{}_speed", prefix, scoped, OPERATIONS[op]))),
+            buffers: [
+                [buffers(0, PREFIXES[0]), buffers(0, PREFIXES[1])],
+                [buffers(1, PREFIXES[0]), buffers(1, PREFIXES[1])],
+            ],
+        }
+    }
+    static TABLES: std::sync::OnceLock<IoTimingTables> = std::sync::OnceLock::new();
+    TABLES.get_or_init(|| {
+        let grid = |f: &dyn Fn(usize, &str) -> String| -> [[&'static str; 2]; 2] {
+            [
+                [key(f(0, PREFIXES[0])), key(f(0, PREFIXES[1]))],
+                [key(f(1, PREFIXES[0])), key(f(1, PREFIXES[1]))],
+            ]
+        };
+        IoTimingTables {
+            pre_pg15: vec![scope("", &["shared", "local", "temp"])],
+            pg15: vec![scope("", &["shared", "local"]), scope("temp", &["temp"])],
+            pg17: vec![scope("shared", &["shared"]), scope("local", &["local"]), scope("temp", &["temp"])],
+            buffers: grid(&|op, prefix| format!("{}{}_blocks", prefix, BUFFERS_OPERATIONS[op])),
+            sum_time: grid(&|op, prefix| format!("{}sum_io_{}_time", prefix, OPERATIONS[op])),
+            sum_speed: grid(&|op, prefix| format!("{}average_sum_io_{}_speed", prefix, OPERATIONS[op])),
+        }
+    })
+}
+
+impl PlanService {
+    pub(crate) fn new() -> PlanService {
+        PlanService::default()
+    }
+
+    /// `recurse` followed by `_.flattenDeep`: the nodes in pre-order.
+    fn recurse(&self, nodes: &Val, out: &mut Vec<Val>) -> JsResult<()> {
+        for node in lodash::values(nodes) {
+            let children = get(&node, p::PLANS)?;
+            lodash::flatten_into(&node, out);
+            self.recurse(&children, out)?;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn create_plan(&mut self, plan_name: &str, plan_content: &Val, plan_query: &str) -> JsResult<Obj> {
+        // remove any extra white spaces in the middle of query
+        let plan_query = replace(js_regex!(r"(\S)(?!$)(\s{2,})", "gm"), plan_query, "$1 ");
+
+        let now = now_millis();
+        let plan = Obj::new();
+        plan.set("id", Val::from(format!("{}{}", p::PEV_PLAN_TAG, now)));
+        let name = if plan_name.is_empty() {
+            format!("plan created on {}", date_string(now))
+        } else {
+            plan_name.to_string()
+        };
+        plan.set("name", Val::from(name));
+        plan.set("createdOn", Val::from(iso_string(now)));
+        plan.set("content", plan_content.clone());
+        plan.set("query", Val::from(plan_query));
+        plan.set("planStats", Val::Obj(Obj::new()));
+        plan.set("ctes", arr(Vec::new()));
+        let root = get(plan_content, "Plan")?;
+        plan.set("isAnalyze", Val::Bool(lodash::has(&root, p::ACTUAL_ROWS)));
+        let is_verbose = self.find_output_property(&get(plan_content, "Plan")?)?;
+        plan.set("isVerbose", Val::Bool(is_verbose));
+
+        self.node_id = 1.0;
+        self.flat = Vec::new();
+        self.process_node(&get(plan_content, "Plan")?, &plan)?;
+
+        let planning = get(plan_content, "Planning")?;
+        if planning.truthy() {
+            self.calculate_io_timings_average(&planning)?;
+        }
+
+        let mut flat = std::mem::take(&mut self.flat);
+        let content = plan.get("content").unwrap();
+        self.recurse(&arr(vec![get(&content, "Plan")?]), &mut flat)?;
+        for cte in lodash::values(&plan.get("ctes").unwrap()) {
+            self.recurse(&arr(vec![cte]), &mut flat)?;
+        }
+        self.flat = flat;
+
+        self.fix_cte_scans_duration(&plan)?;
+        self.fix_init_plan_usage_duration(&plan)?;
+        self.calculate_maximums(&plan)?;
+        Ok(plan)
+    }
+
+    fn is_cte(&self, node: &Val) -> JsResult<bool> {
+        Ok(strict_eq(&get(node, p::PARENT_RELATIONSHIP)?, &s("InitPlan"))
+            && lodash::starts_with(&get(node, p::SUBPLAN_NAME)?, "CTE"))
+    }
+
+    // recursively walk down the plan to compute various metrics
+    fn process_node(&mut self, node: &Val, plan: &Obj) -> JsResult<()> {
+        let id = self.node_id;
+        self.node_id += 1.0;
+        set(node, "nodeId", num(id))?;
+        self.calculate_planner_estimate(node)?;
+
+        for child in lodash::values(&get(node, p::PLANS)?) {
+            // Disseminate workers planned info to parallel nodes (ie. Gather children)
+            if !self.is_cte(&child)?
+                && !strict_eq(&get(&child, p::PARENT_RELATIONSHIP)?, &s("InitPlan"))
+                && !strict_eq(&get(&child, p::PARENT_RELATIONSHIP)?, &s("SubPlan"))
+            {
+                let planned = or(get(node, p::WORKERS_PLANNED)?, get(node, p::WORKERS_PLANNED_BY_GATHER)?);
+                set(&child, p::WORKERS_PLANNED_BY_GATHER, planned)?;
+                let launched = or(get(node, p::WORKERS_LAUNCHED)?, get(node, p::WORKERS_LAUNCHED_BY_GATHER)?);
+                set(&child, p::WORKERS_LAUNCHED_BY_GATHER, launched)?;
+            }
+            if self.is_cte(&child)? {
+                push(&plan.get("ctes").unwrap(), child.clone(), "plan.ctes")?;
+            }
+            self.process_node(&child, plan)?;
+        }
+
+        let plans = get(node, p::PLANS)?;
+        lodash::remove(&plans, |child| self.is_cte(child))?;
+
+        // calculate exclusives after processing child nodes so that exclusive duration
+        // takes loops into account
+        self.calculate_exclusives(node)?;
+        self.calculate_buffers_io_exclusives(node)?;
+        self.calculate_io_timings_average(node)?;
+        self.convert_node_type(node)?;
+        Ok(())
+    }
+
+    fn calculate_maximums(&mut self, plan: &Obj) -> JsResult<()> {
+        let content = plan.get("content").unwrap();
+        let flat = self.flat.clone();
+        let property = |key: &'static str| move |o: &Val| -> JsResult<Val> { Ok(lodash_property(o, key)) };
+
+        let largest = lodash::max_by(&flat, property(p::ACTUAL_ROWS_REVISED))?;
+        if largest.truthy() {
+            set(&content, "maxRows", get(&largest, p::ACTUAL_ROWS_REVISED)?)?;
+        }
+
+        let costliest = lodash::max_by(&flat, property(p::EXCLUSIVE_COST))?;
+        if costliest.truthy() {
+            set(&content, "maxCost", get(&costliest, p::EXCLUSIVE_COST)?)?;
+        }
+
+        let total_costliest = lodash::max_by(&flat, property(p::TOTAL_COST))?;
+        if total_costliest.truthy() {
+            set(&content, "maxTotalCost", get(&total_costliest, p::TOTAL_COST)?)?;
+        }
+
+        let slowest = lodash::max_by(&flat, property(p::EXCLUSIVE_DURATION))?;
+        if slowest.truthy() {
+            set(&content, "maxDuration", get(&slowest, p::EXCLUSIVE_DURATION)?)?;
+        }
+
+        if !get(&content, "maxBlocks")?.truthy() {
+            set(&content, "maxBlocks", Val::Obj(Obj::new()))?;
+        }
+
+        fn sum(o: &Val, keys: &[&str]) -> JsResult<Val> {
+            let mut total = get(o, keys[0])?;
+            for k in &keys[1..] {
+                total = add(&total, &get(o, k)?);
+            }
+            Ok(total)
+        }
+        let groups: [(&str, &[&str]); 3] = [
+            (
+                "Shared",
+                &[
+                    p::EXCLUSIVE_SHARED_HIT_BLOCKS,
+                    p::EXCLUSIVE_SHARED_READ_BLOCKS,
+                    p::EXCLUSIVE_SHARED_DIRTIED_BLOCKS,
+                    p::EXCLUSIVE_SHARED_WRITTEN_BLOCKS,
+                ],
+            ),
+            ("Temp", &[p::EXCLUSIVE_TEMP_READ_BLOCKS, p::EXCLUSIVE_TEMP_WRITTEN_BLOCKS]),
+            (
+                "Local",
+                &[
+                    p::EXCLUSIVE_LOCAL_HIT_BLOCKS,
+                    p::EXCLUSIVE_LOCAL_READ_BLOCKS,
+                    p::EXCLUSIVE_LOCAL_DIRTIED_BLOCKS,
+                    p::EXCLUSIVE_LOCAL_WRITTEN_BLOCKS,
+                ],
+            ),
+        ];
+        for (location, keys) in groups {
+            let highest = lodash::max_by(&flat, |o| sum(o, keys))?;
+            if highest.truthy() && sum(&highest, keys)?.truthy() {
+                set(&get(&content, "maxBlocks")?, location, sum(&highest, keys)?)?;
+            }
+        }
+
+        if !get(&content, "maxIo")?.truthy() {
+            set(&content, "maxIo", num(0.0))?;
+        }
+        let io_keys = [p::EXCLUSIVE_SUM_IO_READ_TIME, p::EXCLUSIVE_SUM_IO_WRITE_TIME];
+        let highest_io = lodash::max_by(&flat, |o| sum(o, &io_keys))?;
+        if highest_io.truthy() && sum(&highest_io, &io_keys)?.truthy() {
+            set(&content, "maxIo", sum(&highest_io, &io_keys)?)?;
+        }
+
+        let mut factors = Vec::with_capacity(flat.len());
+        for node in &flat {
+            let f = get(node, p::PLANNER_ESTIMATE_FACTOR)?;
+            factors.push(if !strict_eq(&f, &num(f64::INFINITY)) { f } else { Val::Undef });
+        }
+        let highest_estimate_factor = lodash::max(&factors);
+        let doubled = highest_estimate_factor.to_number() * 2.0;
+        set(&content, "maxEstimateFactor", or(num(doubled), num(1.0)))?;
+        Ok(())
+    }
+
+    fn set_parent_relationship(&self, node: &Val, parent: Option<&Val>, index: &Val) -> JsResult<()> {
+        // Set the "Parent Relationship" field given parent and siblings
+        for (i, child) in lodash::entries(&get(node, p::PLANS)?) {
+            self.set_parent_relationship(&child, Some(node), &i)?;
+        }
+        // Root node doesn't have any relationship set
+        // Also don't overwrite already set parent relationship
+        let parent = match parent {
+            None => return Ok(()),
+            Some(parent) => parent,
+        };
+        if get(node, p::PARENT_RELATIONSHIP)?.truthy() {
+            return Ok(());
+        }
+        let t = get(parent, p::NODE_TYPE)?;
+        let includes = |list: &[&str]| list.iter().any(|x| same_value_zero(&s(x), &t));
+        let r = if includes(&["Nested Loop", "Hash Join", "Merge Join"]) {
+            if loose_eq(index, &num(0.0)) {
+                "Outer"
+            } else {
+                "Inner"
+            }
+        } else if includes(&["Append", "MergeAppend", "BitmapAnd", "BitmapOr"]) {
+            "Member"
+        } else if loose_eq(&t, &s("Subquery Scan")) {
+            "Subquery"
+        } else {
+            "Outer"
+        };
+        set(node, p::PARENT_RELATIONSHIP, s(r))
+    }
+
+    fn calculate_exclusives(&self, node: &Val) -> JsResult<()> {
+        // Calculate exclusive duration and cost by subtracting child values from the total
+        if !get(node, p::ACTUAL_TOTAL_TIME)?.is_undef() {
+            // since time is reported for an invidual loop, actual duration must be adjusted by number of loops
+            // number of workers is also taken into account
+            let workers = add(&or(get(node, p::WORKERS_LAUNCHED_BY_GATHER)?, num(0.0)), &num(1.0)).to_number();
+            let loops = get(node, p::ACTUAL_LOOPS)?.to_number();
+            let total_time_revised = (get(node, p::ACTUAL_TOTAL_TIME)?.to_number() * loops) / workers;
+            let startup = (get(node, p::ACTUAL_STARTUP_TIME)?.to_number() * get(node, p::ACTUAL_LOOPS)?.to_number())
+                / workers;
+            set(node, p::ACTUAL_STARTUP_TIME_REVISED, num(startup))?;
+            set(node, p::ACTUAL_TOTAL_TIME_REVISED, num(total_time_revised))?;
+
+            let duration = total_time_revised - self.children_duration(node)?.to_number();
+            set(node, p::EXCLUSIVE_DURATION, num(if duration > 0.0 { duration } else { 0.0 }))?;
+        }
+
+        let total_cost = get(node, p::TOTAL_COST)?;
+        if !total_cost.is_undef() {
+            set(node, p::EXCLUSIVE_COST, total_cost)?;
+        }
+
+        for sub_plan in lodash::values(&get(node, p::PLANS)?) {
+            if get(&sub_plan, p::TOTAL_COST)?.truthy() {
+                let v = get(node, p::EXCLUSIVE_COST)?.to_number() - get(&sub_plan, p::TOTAL_COST)?.to_number();
+                set(node, p::EXCLUSIVE_COST, num(v))?;
+            }
+        }
+
+        if lt(&get(node, p::EXCLUSIVE_COST)?, &num(0.0)) {
+            set(node, p::EXCLUSIVE_COST, num(0.0))?;
+        }
+
+        for (prop, revised_prop) in CALCULATED_REVISED {
+            let v = get(node, prop)?;
+            if !v.is_undef() {
+                let loops = or(get(node, p::ACTUAL_LOOPS)?, num(1.0));
+                let revised = v.to_number() * loops.to_number();
+                set(node, revised_prop, num(revised))?;
+            }
+        }
+        Ok(())
+    }
+
+    fn fix_cte_scans_duration(&self, plan: &Obj) -> JsResult<()> {
+        // No need for fix if plan is not analyzed
+        if !plan.get("isAnalyze").unwrap().truthy() {
+            return Ok(());
+        }
+
+        for cte in lodash::values(&plan.get("ctes").unwrap()) {
+            // Time spent in the CTE itself
+            let cte_duration = or(get(&cte, p::ACTUAL_TOTAL_TIME_REVISED)?, num(0.0));
+
+            // Find all nodes that are "CTE Scan" for the given CTE
+            let subplan_name = get(&cte, p::SUBPLAN_NAME)?;
+            let mut cte_scans = Vec::new();
+            for node in &self.flat {
+                let name = Val::from(format!("CTE {}", get(node, p::CTE_NAME)?.to_js_string()));
+                if loose_eq(&name, &subplan_name) {
+                    cte_scans.push(node.clone());
+                }
+            }
+
+            // Sum of exclusive time for the CTE Scans
+            let sum_scans_duration = lodash::sum_by(&cte_scans, |node| get(node, p::EXCLUSIVE_DURATION))?;
+
+            // Subtract exclusive time proportionally
+            for node in &cte_scans {
+                let v = get(node, p::EXCLUSIVE_DURATION)?.to_number()
+                    - (cte_duration.to_number() * or(get(node, p::ACTUAL_TOTAL_TIME_REVISED)?, num(0.0)).to_number())
+                        / sum_scans_duration.to_number();
+                set(node, p::EXCLUSIVE_DURATION, num(max_zero(v)))?;
+            }
+        }
+        Ok(())
+    }
+
+    fn fix_init_plan_usage_duration(&self, plan: &Obj) -> JsResult<()> {
+        // No need for fix if plan is not analyzed
+        if !plan.get("isAnalyze").unwrap().truthy() {
+            return Ok(());
+        }
+
+        // Find all initPlans
+        let mut init_plans = Vec::new();
+        for node in &self.flat {
+            if loose_eq(&get(node, p::PARENT_RELATIONSHIP)?, &s("InitPlan")) {
+                init_plans.push(node.clone());
+            }
+        }
+
+        for sub_plan in &init_plans {
+            // Get the sub plan name
+            // It can be either:
+            //  - InitPlan 2 (returns $1) -> $1
+            //  - InitPlan 2 -> InitPlan 2
+            let subplan_name = get(sub_plan, p::SUBPLAN_NAME)?;
+            if !subplan_name.truthy() {
+                continue;
+            }
+            let text = utf16(&subplan_name.to_js_string());
+            let matches = match exec(js_regex!(r"(InitPlan\s+[1-9]+)(?:\s+\(returns (\$[0-9]+)\))*", "m"), &text) {
+                Some(m) => m,
+                None => continue,
+            };
+            let name = matches.truthy(2).or_else(|| matches.get(1)).unwrap_or_default();
+
+            // Find all nodes that are using data from this InitPlan
+            // There should be the name of the sub plan somewhere in the extra info
+            let mut users = Vec::new();
+            for node in &self.flat {
+                if !loose_eq(&get(node, p::PARENT_RELATIONSHIP)?, &s("InitPlan")) {
+                    users.push(node.clone());
+                }
+            }
+            for node in &users {
+                for value in lodash::values(node) {
+                    let value = match value.as_str() {
+                        Some(v) => v.to_string(),
+                        None => continue,
+                    };
+                    // `new RegExp(".*" + escaped(name) + "[0-9]?")` matches
+                    // exactly the strings containing `name`.
+                    // Never executed nodes (time == 0) are not taken into account
+                    if value.contains(&name) && get(node, p::EXCLUSIVE_DURATION)?.truthy() {
+                        let v = get(node, p::EXCLUSIVE_DURATION)?.to_number()
+                            - or(get(sub_plan, p::ACTUAL_TOTAL_TIME_REVISED)?, num(0.0)).to_number();
+                        set(node, p::EXCLUSIVE_DURATION, num(v))?;
+                        // Stop iterating for this node
+                        break;
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    // function to get the sum of actual durations of a a node children
+    fn children_duration(&self, node: &Val) -> JsResult<Val> {
+        let mut duration = num(0.0);
+        for child in lodash::values(&get(node, p::PLANS)?) {
+            // Subtract sub plans duration from this node except for InitPlans
+            // (ie. CTE)
+            let relationship = get(&child, p::PARENT_RELATIONSHIP)?;
+            if !strict_eq(&relationship, &s("InitPlan"))
+                || (loose_eq(&get(&child, p::PARENT_RELATIONSHIP)?, &s("InitPlan"))
+                    && loose_eq(&get(node, p::NODE_TYPE)?, &s("Result")))
+            {
+                duration = add(&duration, &or(get(&child, p::ACTUAL_TOTAL_TIME_REVISED)?, num(0.0)));
+            }
+        }
+        Ok(duration)
+    }
+
+    // figure out order of magnitude by which the planner mis-estimated how many rows would be
+    // invloved in this node
+    fn calculate_planner_estimate(&self, node: &Val) -> JsResult<()> {
+        if !get(node, p::ACTUAL_ROWS)?.is_undef() && !get(node, p::PLAN_ROWS)?.is_undef() {
+            let actual = get(node, p::ACTUAL_ROWS)?;
+            let planned = get(node, p::PLAN_ROWS)?;
+            set(node, p::PLANNER_ESTIMATE_FACTOR, num(actual.to_number() / planned.to_number()))?;
+            set(node, p::PLANNER_ESTIMATE_DIRECTION, num(3.0))?;
+
+            if gt(&get(node, p::ACTUAL_ROWS)?, &get(node, p::PLAN_ROWS)?) {
+                set(node, p::PLANNER_ESTIMATE_DIRECTION, num(2.0))?;
+            }
+            if lt(&get(node, p::ACTUAL_ROWS)?, &get(node, p::PLAN_ROWS)?) {
+                set(node, p::PLANNER_ESTIMATE_DIRECTION, num(1.0))?;
+                let factor = get(node, p::PLAN_ROWS)?.to_number() / get(node, p::ACTUAL_ROWS)?.to_number();
+                set(node, p::PLANNER_ESTIMATE_FACTOR, num(factor))?;
+            }
+        }
+        Ok(())
+    }
+
+    fn calculate_buffers_io_exclusives(&self, node: &Val) -> JsResult<()> {
+        // Caculate inclusive value for the current node for the given property
+        for (key, exclusive_key) in buffers_io_keys() {
+            // Don't take subplans into account (InitPlan)
+            let children = lodash::filter(&get(node, p::PLANS)?, |child| Ok(!get(child, p::SUBPLAN_NAME)?.truthy()))?;
+            let sum = lodash::sum_by(&children, |child| Ok(or(get(child, key)?, num(0.0))))?;
+            let sum = to_fixed3(&sum, concat!(LODASH_IMPORT!(), ".sumBy(...)"))?;
+            let v = get(node, key)?.to_number() - sum;
+            set(node, exclusive_key, num(to_fixed_number(v, 3)))?;
+        }
+        Ok(())
+    }
+
+    fn calculate_io_timings_average(&self, node: &Val) -> JsResult<()> {
+        // The matrix to match I/O Timings with Buffers
+        let tables = io_timing_tables();
+        let matrix = if get(node, p::TEMP_IO_READ_TIME)?.is_undef() {
+            // pre Pg15
+            &tables.pre_pg15
+        } else if !get(node, p::IO_READ_TIME)?.is_undef() {
+            // pg15-16
+            &tables.pg15
+        } else {
+            // pg17+
+            &tables.pg17
+        };
+
+        // `_.sumBy(buffersScopes, (bufferScope) => node[bufferProp] || 0)`
+        let sum_buffers = |keys: &[&'static str]| -> JsResult<Val> {
+            let mut result = Val::Undef;
+            for key in keys {
+                let current = or(get(node, key)?, num(0.0));
+                result = if result.is_undef() { current } else { add(&result, &current) };
+            }
+            Ok(result)
+        };
+
+        for scope in matrix {
+            for operation in 0..2 {
+                for prefix in 0..2 {
+                    let time = or(get(node, scope.time[operation][prefix])?, num(0.0));
+                    let buffers = sum_buffers(&scope.buffers[operation][prefix])?;
+                    set(node, tables.buffers[operation][prefix], buffers.clone())?;
+                    if time.truthy() {
+                        let speed = buffers.to_number() / (time.to_number() / 1000.0);
+                        set(node, scope.speed[operation][prefix], num(to_fixed_number(speed, 3)))?;
+                    }
+                }
+            }
+        }
+
+        // We also compute sum and average speed for read / write timings for all scopes
+        for operation in 0..2 {
+            for prefix in 0..2 {
+                let mut time = num(0.0);
+                let mut buffers = num(0.0);
+                for scope in matrix {
+                    time = add(&time, &or(get(node, scope.time[operation][prefix])?, num(0.0)));
+                    buffers = add(&buffers, &sum_buffers(&scope.buffers[operation][prefix])?);
+                }
+                set(node, tables.sum_time[operation][prefix], num(to_fixed3(&time, "time")?))?;
+                if time.truthy() {
+                    let speed = buffers.to_number() / (time.to_number() / 1000.0);
+                    set(node, tables.sum_speed[operation][prefix], num(to_fixed_number(speed, 3)))?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn find_output_property(&self, node: &Val) -> JsResult<bool> {
+        // resursively look for an "Output" property
+        let children = get(node, "Plans")?;
+        if !children.truthy() {
+            return Ok(false);
+        }
+        lodash::some(&children, |child| {
+            Ok(lodash::has(child, p::OUTPUT) || self.find_output_property(child)?)
+        })
+    }
+
+    fn convert_node_type(&self, node: &Val) -> JsResult<()> {
+        if loose_eq(&get(node, p::NODE_TYPE)?, &s("ModifyTable")) {
+            set(node, p::NODE_TYPE, get(node, p::OPERATION)?)?;
+        }
+        Ok(())
+    }
+
+    // -----------------------------------------------------------------------
+    // Parsing
+
+    pub(crate) fn cleanup_source(&self, source: &str) -> String {
+        let mut u = utf16(source);
+        let rep = |u: &[u16], re: &Regex, r: &str| re.replace(u, &utf16(r));
+        // Remove frames around, handles |, ║,
+        u = rep(&u, js_regex!(r"^(\||║|│)(.*)\1\r?\n", "gm"), "$2\n");
+        // Remove frames at the end of line, handles |, ║,
+        u = rep(&u, js_regex!(r"^(.*)(\||║|│)$\r?\n", "gm"), "$1\n");
+
+        // Remove separator lines from various types of borders
+        u = rep(&u, js_regex!(r"^\+-+\+\r?\n", "gm"), "");
+        u = rep(&u, js_regex!(r"^(-|─|═)\1+\r?\n", "gm"), "");
+        u = rep(&u, js_regex!(r"^(├|╟|╠|╞)(─|═)\2*(┤|╢|╣|╡)\r?\n", "gm"), "");
+
+        // Remove more horizontal lines
+        u = rep(&u, js_regex!(r"^\+-+\+\r?\n", "gm"), "");
+        u = rep(&u, js_regex!(r"^└(─)+┘\r?\n", "gm"), "");
+        u = rep(&u, js_regex!(r"^╚(═)+╝\r?\n", "gm"), "");
+        u = rep(&u, js_regex!(r"^┌(─)+┐\r?\n", "gm"), "");
+        u = rep(&u, js_regex!(r"^╔(═)+╗\r?\n", "gm"), "");
+
+        // Remove quotes around lines, both ' and "
+        u = rep(&u, js_regex!(r#"^(["'])(.*)\1\r?"#, "gm"), "$2");
+
+        // Remove "+" line continuations
+        u = remove_plus_continuations(&u);
+
+        // Remove "↵" line continuations
+        u = rep(&u, js_regex!(r"↵\r?", "gm"), "\n");
+
+        // Remove "query plan" header
+        u = rep(&u, js_regex!(r"^\s*QUERY PLAN\s*\r?\n", "m"), "");
+
+        // Remove rowcount
+        // example: (8 rows)
+        // Note: can be translated
+        // example: (8 lignes)
+        u = rep(&u, js_regex!(r"^\(\d+\s+[a-z]*s?\)(\r?\n|$)", "gm"), "\n");
+
+        from_utf16(&u)
+    }
+
+    pub(crate) fn from_source(&mut self, source: &str) -> JsResult<Val> {
+        let source = self.cleanup_source(source);
+
+        let parsed = json::parse_str(&source).and_then(|data| self.get_plan_content(&data));
+        match parsed {
+            Ok(content) => Ok(content),
+            Err(_) => {
+                let u = utf16(&source);
+                if js_regex!(r"^(\s*)(\[|\{)\s*\n.*?\1(\]|\})\s*", "gms").test(&u) {
+                    return self.from_json(&source);
+                }
+                self.from_text(&source)
+            }
+        }
+    }
+
+    pub(crate) fn from_json(&self, source: &str) -> JsResult<Val> {
+        // We need to remove things before and/or after explain
+        // To do this, first - split explain into lines...
+        let source_lines = split_strings(js_regex!(r"[\r\n]+", ""), source);
+
+        // Now, find first line of explain, and cache it's prefix (some spaces ...)
+        let mut prefix = String::new();
+        let mut first_line_index = 0usize;
+        for (index, l) in source_lines.iter().enumerate() {
+            let lu = utf16(l);
+            if let Some(m) = exec(js_regex!(r"^(\s*)(\[|\{)\s*$", ""), &lu) {
+                prefix = m.get(1).unwrap_or_default();
+                first_line_index = index;
+                break;
+            }
+        }
+        // now find last line
+        let mut last_line_index = 0usize;
+        let last_line_re = Regex::new(&format!("^{}(]|}})s*$", prefix), "")?;
+        for (index, l) in source_lines.iter().enumerate() {
+            if last_line_re.test(&utf16(l)) {
+                last_line_index = index;
+                break;
+            }
+        }
+
+        let selected: Vec<&str> = if last_line_index + 1 > first_line_index {
+            source_lines[first_line_index..(last_line_index + 1).min(source_lines.len())]
+                .iter()
+                .map(|l| l.as_str())
+                .collect()
+        } else {
+            Vec::new()
+        };
+        // Replace two double quotes (added by pgAdmin)
+        let use_source = replace(js_regex!(r#""""#, "gm"), &selected.join("\n"), "\"");
+
+        let data = json::parse_str(&use_source)?;
+        self.get_plan_content(&data)
+    }
+
+    pub(crate) fn get_plan_content(&self, value: &Val) -> JsResult<Val> {
+        let value = match value {
+            Val::Arr(a) => a.get(0),
+            v => v.clone(),
+        };
+        if !get(&value, "Plan")?.truthy() {
+            return Err("Invalid plan".to_string());
+        }
+        Ok(value)
+    }
+
+    pub(crate) fn split_into_lines(&self, text: &str) -> Vec<String> {
+        // Splits source into lines, while fixing (well, trying to fix)
+        // cases where input has been force-wrapped to some length.
+        let mut out: Vec<String> = Vec::new();
+        let lines = split_strings(js_regex!(r"\r?\n", ""), text);
+        let count_char = |s: &str, c: char| s.chars().filter(|x| *x == c).count();
+        let closing_first = |s: &str| match (s.find(')'), s.find('(')) {
+            (Some(close), Some(open)) => close < open,
+            _ => false,
+        };
+        let first_non_blank = |s: &str| -> i64 {
+            let u = utf16(s);
+            match u.iter().position(|c| !crate::js::text::is_whitespace(*c)) {
+                Some(i) => i as i64,
+                None => -1,
+            }
+        };
+        let same_indent = |a: &str, b: &str| first_non_blank(a) == first_non_blank(b);
+
+        for line in lines {
+            if let Some(prev) = out.last_mut() {
+                if !prev.is_empty() && count_char(prev, ')') != count_char(prev, '(') {
+                    // if number of opening/closing parenthesis doesn't match in the
+                    // previous line, this means the current line is the continuation of previous line
+                    prev.push_str(&line);
+                    continue;
+                }
+            }
+            let lu = utf16(&line);
+            let previous_line = out.last().map(|l| l.as_str()).unwrap_or("");
+            if js_regex!(
+                r"^(?:Total\s+runtime|Planning(\s+time)?|Execution\s+time|Time|Filter|Output|JIT|Trigger|Settings|Serialization)",
+                "i"
+            )
+            .test(&lu)
+            {
+                out.push(line);
+            } else if js_regex!(r"^\S", "").test(&lu) // doesn't start with a blank space (allowed only for the first node)
+                || js_regex!(r"^\s*\(", "").test(&lu) // first non-blank character is an opening parenthesis
+                || closing_first(&line)
+            // closing parenthesis before opening one
+            {
+                if !out.is_empty() {
+                    out.last_mut().unwrap().push_str(&line);
+                } else {
+                    out.push(line);
+                }
+            } else if !out.is_empty()
+                && js_regex!(r"^.*,\s*$", "").test(&utf16(previous_line))
+                && !same_indent(previous_line, &line)
+                && !js_regex!(r"^\s*->", "i").test(&lu)
+            {
+                // If previous line was an info line (Output, Sort Key, … with a list
+                // of items separated by coma ",")
+                // and current line is not same indent
+                // (which would mean a new information line)
+                out.last_mut().unwrap().push_str(&line);
+            } else {
+                out.push(line);
+            }
+        }
+        out
+    }
+
+    pub(crate) fn from_text(&self, text: &str) -> JsResult<Val> {
+        let lines = self.split_into_lines(text);
+
+        let root = Val::Obj(Obj::new());
+        // Array to keep reference to previous nodes with there depth
+        let mut elements_at_depth: Vec<(usize, Element)> = Vec::new();
+
+        // `subRegex` and `cteRegex` are global expressions shared by all
+        // lines: their `lastIndex` carries over from one line to the next.
+        let sub_regex = js_regex!(r"^(\s*)((?:Sub|Init)Plan)\s*(?:\d+\s*)?\s*(?:\(returns.*\)\s*)?$", "gm");
+        let cte_regex = js_regex!(r"^(\s*)CTE\s+(\S+)\s*$", "g");
+        let mut sub_last_index = 0usize;
+        let mut cte_last_index = 0usize;
+
+        let last_element = |e: &Vec<(usize, Element)>| e.last().map(|(_, el)| el.clone());
+
+        for line in lines {
+            // Remove any trailing "
+            let line = replace(js_regex!(r#""\s*$"#, ""), &line, "");
+            // Remove any begining "
+            let line = replace(js_regex!(r#"^\s*""#, ""), &line, "");
+            // Replace tabs with 4 spaces
+            let line = line.replace('\t', "    ");
+
+            let full = utf16(&line);
+            let depth = full.iter().take_while(|c| crate::js::text::is_whitespace(**c)).count();
+            // remove indentation
+            let u: Vec<u16> = full[depth..].to_vec();
+            let line = from_utf16(&u);
+
+            let empty_line_matches = js_regex!(r"^s*$", "").test(&u);
+            let header_matches = js_regex!(r"^\\s*(QUERY|---|#).*$", "").test(&u);
+            let node_matches = node_regex_exec(&u);
+            let sub_matches = sub_regex.exec(&u, &mut sub_last_index).map(|c| Match::new(&u, c));
+            let cte_matches = cte_regex.exec(&u, &mut cte_last_index).map(|c| Match::new(&u, c));
+            let trigger_matches = exec(
+                js_regex!(r"^(\s*)Trigger\s+(.*):\s+time=(\d+\.\d+)\s+calls=(\d+)\s*$", ""),
+                &u,
+            );
+            let worker_matches = exec(
+                js_regex!(
+                    r"^(\s*)Worker\s+(\d+):\s+(?:(?:actual(?:\stime=(\d+\.\d+)\.\.(\d+\.\d+))?\srows=(\d+(?:\.\d+)?)\sloops=(\d+)|(never\s+executed)))?(.*)\s*$",
+                    ""
+                ),
+                &u,
+            );
+            let jit_matches = js_regex!(r"^(\s*)JIT:\s*$", "").test(&u);
+            let planning_matches = js_regex!(r"^(\s*)Planning:$", "").test(&u);
+            let serialization_matches = exec(
+                js_regex!(r"^(\s*)Serialization:\s+time=(\d+\.\d+) ms.*output=(\d+).*$", ""),
+                &u,
+            );
+            let extra_matches = exec(js_regex!(r"^(\s*)(\S.*\S)\s*$", ""), &u);
+
+            if empty_line_matches || header_matches {
+                continue;
+            } else if node_matches.is_some() && cte_matches.is_none() && sub_matches.is_none() {
+                let m = node_matches.unwrap();
+                let never_executed = m.truthy(12);
+                let new_node = Val::Obj(new_node(&m.get(3).unwrap_or_default()));
+                if (m.truthy(4).is_some() && m.truthy(5).is_some()) || (m.truthy(13).is_some() && m.truthy(14).is_some()) {
+                    set(&new_node, p::STARTUP_COST, num(parse_float(&m.either(4, 13))))?;
+                    set(&new_node, p::TOTAL_COST, num(parse_float(&m.either(5, 14))))?;
+                    set(&new_node, p::PLAN_ROWS, num(parse_int(&m.either(6, 15))))?;
+                    set(&new_node, p::PLAN_WIDTH, num(parse_int(&m.either(7, 16))))?;
+                }
+                if (m.truthy(8).is_some() && m.truthy(9).is_some()) || (m.truthy(17).is_some() && m.truthy(18).is_some()) {
+                    set(&new_node, p::ACTUAL_STARTUP_TIME, num(parse_float(&m.either(8, 17))))?;
+                    set(&new_node, p::ACTUAL_TOTAL_TIME, num(parse_float(&m.either(9, 18))))?;
+                }
+
+                if (m.truthy(10).is_some() && m.truthy(11).is_some()) || (m.truthy(19).is_some() && m.truthy(20).is_some()) {
+                    let actual_rows = m.either(10, 19);
+                    if actual_rows.contains('.') {
+                        set(&new_node, p::ACTUAL_ROWS_FRACTIONAL, Val::Bool(true))?;
+                    }
+                    set(&new_node, p::ACTUAL_ROWS, num(parse_float(&actual_rows)))?;
+                    set(&new_node, p::ACTUAL_LOOPS, num(parse_int(&m.either(11, 20))))?;
+                }
+
+                if let Some(mode) = m.truthy(2) {
+                    set(&new_node, p::PARTIAL_MODE, Val::from(mode))?;
+                }
+
+                if never_executed.is_some() {
+                    set(&new_node, p::ACTUAL_LOOPS, num(0.0))?;
+                    set(&new_node, p::ACTUAL_ROWS, num(0.0))?;
+                    set(&new_node, p::ACTUAL_TOTAL_TIME, num(0.0))?;
+                    set(&new_node, p::ACTUAL_STARTUP_TIME, num(0.0))?;
+                }
+                let element = Element {
+                    node: new_node.clone(),
+                    subelement_type: Some("subnode".to_string()),
+                    name: None,
+                };
+
+                if elements_at_depth.is_empty() {
+                    elements_at_depth.push((depth, element));
+                    set(&root, "Plan", new_node)?;
+                    continue;
+                }
+
+                // Remove elements from elementsAtDepth for deeper levels
+                elements_at_depth.retain(|e| e.0 < depth);
+
+                let previous_element = match last_element(&elements_at_depth) {
+                    Some(e) => e,
+                    None => continue,
+                };
+
+                elements_at_depth.push((depth, element));
+
+                if !get(&previous_element.node, p::PLANS)?.truthy() {
+                    set(&previous_element.node, p::PLANS, arr(Vec::new()))?;
+                }
+                let name = previous_element.name.clone().map(Val::from).unwrap_or(Val::Undef);
+                match previous_element.subelement_type.as_deref() {
+                    Some("initplan") => {
+                        set(&new_node, p::PARENT_RELATIONSHIP, s("InitPlan"))?;
+                        set(&new_node, p::SUBPLAN_NAME, name)?;
+                    }
+                    Some("subplan") => {
+                        set(&new_node, p::PARENT_RELATIONSHIP, s("SubPlan"))?;
+                        set(&new_node, p::SUBPLAN_NAME, name)?;
+                    }
+                    _ => {}
+                }
+                let plans = get(&previous_element.node, "Plans")?;
+                if !plans.is_nullish() {
+                    push(&plans, new_node, "previousElement.node.Plans?")?;
+                }
+            } else if let Some(m) = sub_matches {
+                let kind = m.get(2).unwrap_or_default();
+                // Remove elements from elementsAtDepth for deeper levels
+                elements_at_depth.retain(|e| e.0 < depth);
+                let previous_element = last_element(&elements_at_depth);
+                let element = Element {
+                    node: previous_element.map(|e| e.node).unwrap_or(Val::Undef),
+                    subelement_type: Some(kind.to_lowercase()),
+                    name: m.get(0),
+                };
+                elements_at_depth.push((depth, element));
+            } else if let Some(m) = cte_matches {
+                let cte_name = m.get(2).unwrap_or_default();
+                // Remove elements from elementsAtDepth for deeper levels
+                elements_at_depth.retain(|e| e.0 < depth);
+                let previous_element = last_element(&elements_at_depth);
+                let element = Element {
+                    node: previous_element.map(|e| e.node).unwrap_or(Val::Undef),
+                    subelement_type: Some("initplan".to_string()),
+                    name: Some(format!("CTE {}", cte_name)),
+                };
+                elements_at_depth.push((depth, element));
+            } else if let Some(m) = worker_matches {
+                let worker_number = parse_int(&m.str_or_undefined(2));
+                let previous_element = match last_element(&elements_at_depth) {
+                    Some(e) => e,
+                    None => continue,
+                };
+                let target = &previous_element.node;
+                if !get(target, p::WORKERS)?.truthy() {
+                    set(target, p::WORKERS, arr(Vec::new()))?;
+                }
+                let mut worker = self.get_worker(target, worker_number)?;
+                if worker.is_undef() {
+                    let w = Obj::new();
+                    w.set(p::WORKER_NUMBER, num(worker_number));
+                    worker = Val::Obj(w);
+                    let workers = get(target, p::WORKERS)?;
+                    if !workers.is_nullish() {
+                        push(&workers, worker.clone(), concat!("previousElement.node[", PROPERTY_IMPORT!(), ".WORKERS]?"))?;
+                    }
+                }
+                if m.truthy(3).is_some() && m.truthy(4).is_some() {
+                    set(&worker, p::ACTUAL_STARTUP_TIME, num(parse_float(&m.str_or_undefined(3))))?;
+                    set(&worker, p::ACTUAL_TOTAL_TIME, num(parse_float(&m.str_or_undefined(4))))?;
+                    set(&worker, p::ACTUAL_ROWS, num(parse_int(&m.str_or_undefined(5))))?;
+                    set(&worker, p::ACTUAL_LOOPS, num(parse_int(&m.str_or_undefined(6))))?;
+                }
+
+                let extra = m.get(8).unwrap_or_default();
+                if self.parse_sort(&utf16(&extra), &worker)? {
+                    continue;
+                }
+
+                // extra info
+                let info = split_info(&extra);
+                if !extra.is_empty() {
+                    if info.len() < 2 {
+                        continue;
+                    }
+                    let property = start_case(&info[0]);
+                    set(&worker, &property, Val::from(info[1].as_str()))?;
+                }
+            } else if let Some(m) = trigger_matches {
+                // Remove elements from elementsAtDepth for deeper levels
+                elements_at_depth.retain(|e| e.0 < depth);
+                let triggers = or(get(&root, "Triggers")?, arr(Vec::new()));
+                set(&root, "Triggers", triggers)?;
+                let trigger = Obj::new();
+                trigger.set("Trigger Name", m.val(2));
+                trigger.set("Time", num(parse_time(&m.str_or_undefined(3))));
+                trigger.set("Calls", m.val(4));
+                push(&get(&root, "Triggers")?, Val::Obj(trigger), "root.Triggers")?;
+            } else if jit_matches {
+                if elements_at_depth.is_empty() {
+                    let jit = Val::Obj(Obj::new());
+                    set(&root, "JIT", jit.clone())?;
+                    elements_at_depth.push((1, Element::plain(jit)));
+                } else {
+                    let last = last_element(&elements_at_depth).unwrap();
+                    let workers = if last.node.is_nullish() {
+                        Val::Undef
+                    } else {
+                        get(&last.node, p::WORKERS)?
+                    };
+                    let last_worker = lodash::last(&workers)?;
+                    if last_worker.truthy() {
+                        let jit = Val::Obj(Obj::new());
+                        set(&last_worker, "JIT", jit.clone())?;
+                        elements_at_depth.push((depth, Element::plain(jit)));
+                    }
+                }
+            } else if planning_matches {
+                let planning = Val::Obj(Obj::new());
+                set(&root, "Planning", planning.clone())?;
+                elements_at_depth.push((1, Element::plain(planning)));
+            } else if let Some(m) = serialization_matches {
+                let serialization = Obj::new();
+                serialization.set("Time", num(parse_float(&m.str_or_undefined(2))));
+                serialization.set("Output Volume", num(parse_int(&m.str_or_undefined(3))));
+                let serialization = Val::Obj(serialization);
+                set(&root, "Serialization", serialization.clone())?;
+                elements_at_depth.push((1, Element::plain(serialization)));
+            } else if let Some(m) = extra_matches {
+                // Remove elements from elementsAtDepth for deeper levels
+                // Depth == 1 is a special case here. Global info (for example
+                // execution|planning time) have a depth of 1 but shouldn't be removed
+                // in case first node was at depth 0.
+                elements_at_depth.retain(|e| !(e.0 >= depth || depth == 1));
+
+                let element = if elements_at_depth.is_empty() {
+                    root.clone()
+                } else {
+                    last_element(&elements_at_depth).unwrap().node
+                };
+
+                // if no node have been found yet and a 'Query Text' has been found
+                // there the line is the part of the query
+                if !get(&element, "Plan")?.truthy() && get(&element, "Query Text")?.truthy() {
+                    let text = add(&get(&element, "Query Text")?, &Val::from(format!("\n{}", line)));
+                    set(&element, "Query Text", text)?;
+                    continue;
+                }
+
+                let extra = m.get(2).unwrap_or_default();
+                let info = split_info(&extra);
+                if info.len() < 2 {
+                    continue;
+                }
+
+                if !element.truthy() {
+                    continue;
+                }
+
+                // Each parser below is attempted only when its expression's
+                // literal text occurs in the line (a necessary condition).
+                let eu = utf16(&extra);
+                if extra.contains("Sort Method:") && self.parse_sort(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains(" Key:") && self.parse_group_hash_sort_key(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("Buffers:") && self.parse_buffers(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("Buckets:") && self.parse_buckets(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("Planned Partitions:") && self.parse_planned_partitions(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("WAL:") && self.parse_wal(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("I/O Timings:") && self.parse_io_timings(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("Options:") && self.parse_options(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("Timing:") && self.parse_timing(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("Settings:") && self.parse_settings(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains(" Groups:") && self.parse_sort_groups(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains(" Key:") && self.parse_sort_key(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("Disabled") && self.parse_disabled(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("Memory:") && self.parse_memory(&eu, &element)? {
+                    continue;
+                }
+                if extra.contains("Hits:") && self.parse_cache(&eu, &element)? {
+                    continue;
+                }
+
+                // remove the " ms" unit in case of time
+                let raw = replace(js_regex!(r"(\s*ms)$", ""), &info[1], "");
+                // try to convert to number
+                let parsed = parse_float(&raw);
+                let value = if Val::Num(parsed).truthy() {
+                    num(parsed)
+                } else {
+                    Val::from(raw)
+                };
+
+                let mut property = info[0].clone();
+                if property.contains(" runtime") || property.contains(" time") {
+                    property = start_case(&property);
+                }
+                set(&element, &property, value)?;
+            }
+        }
+        if !get(&root, "Plan")?.truthy() {
+            return Err("Unable to parse plan".to_string());
+        }
+        self.set_parent_relationship(&get(&root, "Plan")?, None, &num(0.0))?;
+        Ok(root)
+    }
+
+    fn parse_sort_key(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        if let Some(m) = exec(js_regex!(r"^\s*((?:Sort|Presorted) Key):\s+(.*)", "g"), text) {
+            let keys = split_balanced(&m.get(2).unwrap_or_default(), ",")?;
+            let keys = keys.iter().map(|k| Val::from(ld_trim(k))).collect();
+            set(el, &m.get(1).unwrap_or_default(), arr(keys))?;
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+    fn parse_sort(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        if let Some(m) = exec(
+            js_regex!(r"^(\s*)Sort Method:\s+(.*)\s+(Memory|Disk):\s+(?:(\S*)kB)\s*$", "g"),
+            text,
+        ) {
+            set(el, p::SORT_METHOD, Val::from(trim(&m.get(2).unwrap_or_default())))?;
+            set(el, p::SORT_SPACE_USED, m.val(4))?;
+            set(el, p::SORT_SPACE_TYPE, m.val(3))?;
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+    fn parse_buffers(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        let m = match exec(js_regex!(r"Buffers:\s+(.*)\s*$", "g"), text) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        for infos in split_strings(js_regex!(r",\s+", ""), &m.get(1).unwrap_or_default()) {
+            let iu = utf16(&infos);
+            if let Some(bm) = exec(js_regex!(r"(shared|temp|local)\s+(.*)$", "g"), &iu) {
+                let kind = bm.get(1).unwrap_or_default();
+                // Initiate with default value
+                for method in ["hit", "read", "written", "dirtied"] {
+                    set(el, &buffer_key(&kind, method), num(0.0))?;
+                }
+                for buffer in split_strings(js_regex!(r"\s+", ""), &bm.get(2).unwrap_or_default()) {
+                    self.parse_buffer(&buffer, &kind, el)?;
+                }
+            }
+        }
+        Ok(true)
+    }
+
+    fn parse_buffer(&self, text: &str, kind: &str, el: &Val) -> JsResult<()> {
+        let parts = split_strings(js_regex!(r"=", ""), text);
+        let method = parts[0].clone();
+        let value = parse_int(parts.get(1).map(|s| s.as_str()).unwrap_or("undefined"));
+        set(el, &buffer_key(kind, &method), num(value))
+    }
+
+    fn parse_buckets(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        let m = match exec(
+            js_regex!(
+                r"Buckets:\s+([0-9]*)(?:\s*\(originally\s+([0-9]*)\))*\s+Batches:\s+([0-9]*)(?:\s*\(originally\s+([0-9]*)\))*\s+Memory Usage:\s+([0-9]*)kB\s*$",
+                "g"
+            ),
+            text,
+        ) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        set(el, p::HASH_BUCKETS, num(parse_int(&m.str_or_undefined(1))))?;
+        set(el, p::HASH_BATCHES, num(parse_int(&m.str_or_undefined(3))))?;
+        let original = or(num(parse_int(&m.str_or_undefined(2))), get(el, p::HASH_BUCKETS)?);
+        set(el, p::ORIGINAL_HASH_BUCKETS, original)?;
+        let original = or(num(parse_int(&m.str_or_undefined(4))), get(el, p::HASH_BATCHES)?);
+        set(el, p::ORIGINAL_HASH_BATCHES, original)?;
+        set(el, p::PEAK_MEMORY_USAGE, num(parse_int(&m.str_or_undefined(5))))?;
+        Ok(true)
+    }
+
+    fn parse_planned_partitions(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        let m = match exec(
+            js_regex!(
+                r"Planned Partitions:\s+([0-9]*)(?:\s+Batches:\s+([0-9]*))*(?:\s+Memory Usage:\s+([0-9]*)kB)*(?:\s*Disk Usage:\s+([0-9]*)kB)*\s*$",
+                "g"
+            ),
+            text,
+        ) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        set(el, p::PLANNED_PARTITIONS, num(parse_int(&m.str_or_undefined(1))))?;
+        if let Some(batches) = m.truthy(2) {
+            set(el, p::HASHAGG_BATCHES, num(parse_int(&batches)))?;
+        }
+        if let Some(memory_usage) = m.truthy(3) {
+            set(el, p::PEAK_MEMORY_USAGE, num(parse_int(&memory_usage)))?;
+        }
+        if let Some(disk_usage) = m.truthy(4) {
+            set(el, p::DISK_USAGE, num(parse_int(&disk_usage)))?;
+        }
+        Ok(true)
+    }
+
+    fn get_worker(&self, node: &Val, worker_number: f64) -> JsResult<Val> {
+        let workers = get(node, p::WORKERS)?;
+        lodash::find(&workers, |worker| {
+            Ok(strict_eq(&get(worker, p::WORKER_NUMBER)?, &num(worker_number)))
+        })
+    }
+
+    fn parse_wal(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        let m = match exec(js_regex!(r"WAL:\s+(.*)\s*$", "g"), text) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        // Initiate with default value
+        for kind in ["Records", "Bytes", "FPI"] {
+            set(el, &format!("WAL {}", kind), num(0.0))?;
+        }
+        for t in split_strings(js_regex!(r"\s+", ""), &m.get(1).unwrap_or_default()) {
+            let parts = split_strings(js_regex!(r"=", ""), &t);
+            let kind = parts[0].clone();
+            let value = parse_int(parts.get(1).map(|s| s.as_str()).unwrap_or("undefined"));
+            let kind_caps = if kind == "fpi" { "FPI".to_string() } else { capitalize(&kind) };
+            set(el, &format!("WAL {}", kind_caps), num(value))?;
+        }
+        Ok(true)
+    }
+
+    fn parse_io_timings(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        if exec(js_regex!(r"I\/O Timings:\s+(.*)\s*$", "g"), text).is_none() {
+            return Ok(false);
+        }
+
+        let scope_regex = js_regex!(
+            r"\b(shared\/local|shared|local|temp)((?:\s+(?:read|write)=\d+(?:\.\d+)?)+)",
+            "g"
+        );
+        let operation_regex = js_regex!(r"(read|write)=(\d+(?:\.\d+)?)", "g");
+
+        struct Entry {
+            scope: Option<String>,
+            read: f64,
+            write: f64,
+        }
+        let mut results: Vec<Entry> = Vec::new();
+
+        // 1. Handle scoped timings like "local read=10 write=20"
+        for scope_match in scope_regex.all_matches(text) {
+            let sm = Match::new(text, scope_match);
+            let mut entry = Entry {
+                scope: sm.get(1),
+                read: 0.0,
+                write: 0.0,
+            };
+            let operations = utf16(&sm.get(2).unwrap_or_default());
+            for op in operation_regex.all_matches(&operations) {
+                let om = Match::new(&operations, op);
+                let value = parse_float(&om.str_or_undefined(2));
+                if om.get(1).as_deref() == Some("read") {
+                    entry.read = value;
+                } else {
+                    entry.write = value;
+                }
+            }
+            results.push(entry);
+        }
+
+        // 2. Handle unscoped timings like "read=0.011" outside of scoped blocks
+        let rest = scope_regex.replace(text, &[]);
+        let mut unscoped = Entry {
+            scope: None,
+            read: 0.0,
+            write: 0.0,
+        };
+        let mut found = false;
+        for op in operation_regex.all_matches(&rest) {
+            let om = Match::new(&rest, op);
+            let value = parse_float(&om.str_or_undefined(2));
+            if om.get(1).as_deref() == Some("read") {
+                unscoped.read = value;
+            } else {
+                unscoped.write = value;
+            }
+            found = true;
+        }
+        if found {
+            results.push(unscoped);
+        }
+
+        let scope_is_detailed = results
+            .iter()
+            .any(|r| matches!(r.scope.as_deref(), Some("shared") | Some("local")));
+        let scope_is_partially_detailed = results.iter().any(|r| r.scope.as_deref() == Some("shared/local"));
+
+        // Initiate with default value
+        if scope_is_detailed {
+            set(el, p::SHARED_IO_READ_TIME, num(0.0))?;
+            set(el, p::SHARED_IO_WRITE_TIME, num(0.0))?;
+            set(el, p::LOCAL_IO_READ_TIME, num(0.0))?;
+            set(el, p::LOCAL_IO_WRITE_TIME, num(0.0))?;
+        } else {
+            set(el, p::IO_READ_TIME, num(0.0))?;
+            set(el, p::IO_WRITE_TIME, num(0.0))?;
+        }
+        if scope_is_partially_detailed || scope_is_detailed {
+            set(el, p::TEMP_IO_READ_TIME, num(0.0))?;
+            set(el, p::TEMP_IO_WRITE_TIME, num(0.0))?;
+        }
+
+        for result in &results {
+            for (operation, value) in [("READ", result.read), ("WRITE", result.write)] {
+                let mut prop = format!("IO_{}_TIME", operation);
+                if let Some(scope) = result.scope.as_deref() {
+                    if scope != "shared/local" {
+                        prop = format!("{}_{}", scope.to_uppercase(), prop);
+                    }
+                }
+                set(el, property_key(&prop), num(value))?;
+            }
+        }
+        Ok(true)
+    }
+
+    fn parse_options(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        // Parses an options block in JIT block
+        // eg. Options: Inlining false, Optimization false, Expressions true, Deforming true
+        let m = match exec(js_regex!(r"^(\s*)Options:\s+(.*)$", "g"), text) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        set(el, "Options", Val::Obj(Obj::new()))?;
+        for option in split_strings(js_regex!(r"\s*,\s*", ""), &m.get(2).unwrap_or_default()) {
+            let ou = utf16(&option);
+            if let Some(om) = exec(js_regex!(r"^(\S*)\s+(.*)$", "g"), &ou) {
+                let options = get(el, "Options")?;
+                if options.truthy() {
+                    let value = json::parse_str(&om.get(2).unwrap_or_default())?;
+                    set(&options, &om.get(1).unwrap_or_default(), value)?;
+                }
+            }
+        }
+        Ok(true)
+    }
+
+    fn parse_timing(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        // Parses a timing block in JIT block
+        // eg. Timing: Generation 0.340 ms, Inlining 0.000 ms, Optimization 0.168 ms, Emission 1.907 ms, Total 2.414 ms
+        let m = match exec(js_regex!(r"^(\s*)Timing:\s+(.*)$", "g"), text) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        set(el, "Timing", Val::Obj(Obj::new()))?;
+        for timing in split_strings(js_regex!(r"\s*,\s*", ""), &m.get(2).unwrap_or_default()) {
+            let tu = utf16(&timing);
+            if let Some(tm) = exec(js_regex!(r"^(\S*)\s+(.*)$", "g"), &tu) {
+                let timings = get(el, "Timing")?;
+                if timings.truthy() {
+                    let value = parse_time(&tm.get(2).unwrap_or_default());
+                    set(&timings, &tm.get(1).unwrap_or_default(), num(value))?;
+                }
+            }
+        }
+        Ok(true)
+    }
+
+    fn parse_settings(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        // Parses a settings block
+        // eg. Settings: constraint_exclusion = 'on', effective_cache_size = '30GB'
+        let m = match exec(js_regex!(r"^(\s*)Settings:\s*(.*)$", "g"), text) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        set(el, "Settings", Val::Obj(Obj::new()))?;
+        for option in split_balanced(&m.get(2).unwrap_or_default(), ",")? {
+            let ou = utf16(&ld_trim(&option));
+            if let Some(om) = exec(js_regex!(r"^(\S*)\s+=\s+(.*)$", "g"), &ou) {
+                let settings = get(el, "Settings")?;
+                if settings.truthy() {
+                    let value = om.get(2).unwrap_or_default().replace('\'', "");
+                    set(&settings, &om.get(1).unwrap_or_default(), Val::from(value))?;
+                }
+            }
+        }
+        Ok(true)
+    }
+
+    fn parse_sort_groups(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        // Parses a Full-sort Groups block
+        // eg. Full-sort Groups: 312500  Sort Method: quicksort  Average Memory: 26kB  Peak Memory: 26kB
+        let m = match exec(
+            js_regex!(
+                r"^\s*(Full-sort|Pre-sorted) Groups:\s+([0-9]*)\s+Sort Method[s]*:\s+(.*)\s+Average Memory:\s+(\S*)kB\s+Peak Memory:\s+(\S*)kB.*$",
+                "g"
+            ),
+            text,
+        ) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        let groups = Obj::new();
+        groups.set(p::GROUP_COUNT, num(parse_int(&m.str_or_undefined(2))));
+        let methods = m
+            .get(3)
+            .unwrap_or_default()
+            .split(',')
+            .map(|x| Val::from(ld_trim(x)))
+            .collect();
+        groups.set(p::SORT_METHODS_USED, arr(methods));
+        let memory = Obj::new();
+        memory.set(p::AVERAGE_SORT_SPACE_USED, num(parse_int(&m.str_or_undefined(4))));
+        memory.set(p::PEAK_SORT_SPACE_USED, num(parse_int(&m.str_or_undefined(5))));
+        groups.set(p::SORT_SPACE_MEMORY, Val::Obj(memory));
+
+        match m.get(1).as_deref() {
+            Some("Full-sort") => set(el, p::FULL_SORT_GROUPS, Val::Obj(groups))?,
+            Some("Pre-sorted") => set(el, p::PRE_SORTED_GROUPS, Val::Obj(groups))?,
+            _ => return Err("Unsupported sort groups method".to_string()),
+        }
+        Ok(true)
+    }
+
+    fn parse_disabled(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        // Parse Disabled value into boolean
+        if js_regex!(r"^\s*(Disabled)\s*:\s*(true)$", "").test(text) {
+            set(el, p::DISABLED, Val::Bool(true))?;
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+    fn parse_cache(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        // Parses a cache block (usually for a Memoize node)
+        // eg. Hits: 998  Misses: 2  Evictions: 0  Overflows: 0  Memory Usage: 1kB
+        let m = match exec(
+            js_regex!(
+                r"^(\s*)Hits:\s+(\d+)\s+Misses:\s+(\d+)\s+Evictions:\s+(\d+)\s+Overflows:\s+(\d+)\s+Memory Usage:\s+(\d+)kB\s*$",
+                ""
+            ),
+            text,
+        ) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        set(el, p::CACHE_HITS, num(parse_int(&m.str_or_undefined(2))))?;
+        set(el, p::CACHE_MISSES, num(parse_int(&m.str_or_undefined(3))))?;
+        set(el, p::CACHE_EVICTIONS, num(parse_int(&m.str_or_undefined(4))))?;
+        set(el, p::CACHE_OVERFLOWS, num(parse_int(&m.str_or_undefined(5))))?;
+        set(el, p::PEAK_MEMORY_USAGE, num(parse_int(&m.str_or_undefined(6))))?;
+        Ok(true)
+    }
+
+    fn parse_memory(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        // Parses a memory block (for example in Planning block)
+        // eg. Memory: used=6kB  allocated=8kB
+        let m = match exec(js_regex!(r"^(\s*)Memory:\s+used=(\d+)kB.*allocated=(\d+)kB.*$", ""), text) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        set(el, p::MEMORY_USED, num(parse_int(&m.str_or_undefined(2))))?;
+        set(el, p::MEMORY_ALLOCATED, num(parse_int(&m.str_or_undefined(3))))?;
+        Ok(true)
+    }
+
+    fn parse_group_hash_sort_key(&self, text: &[u16], el: &Val) -> JsResult<bool> {
+        // Parses a Group, Hash or Sort Key line, e.g.:
+        //   Group Key: customer_id, status
+        //   Hash Key: customer_id, status
+        //   Sort Key: status
+        // Possibly converted to Grouping Sets / Group Keys of multiple values
+        let m = match exec(js_regex!(r"^\s*(Group|Hash|Sort) Key:\s+(.*)$", ""), text) {
+            Some(m) => m,
+            None => return Ok(false),
+        };
+        let key_type = m.get(1).unwrap_or_default();
+        let raw_value = m.get(2).unwrap_or_default();
+        let values = || -> Val {
+            if raw_value == "()" {
+                arr(Vec::new())
+            } else {
+                arr(split_strings(js_regex!(r"\s*,\s*", ""), &raw_value)
+                    .into_iter()
+                    .map(Val::from)
+                    .collect())
+            }
+        };
+        let values = values();
+
+        match key_type.as_str() {
+            "Hash" => {
+                let sets = or(get(el, p::GROUPING_SETS)?, arr(Vec::new()));
+                set(el, p::GROUPING_SETS, sets)?;
+                let entry = Obj::new();
+                entry.set(p::HASH_KEYS, arr(vec![values]));
+                push(&get(el, p::GROUPING_SETS)?, Val::Obj(entry), concat!("el[", PROPERTY_IMPORT!(), ".GROUPING_SETS]"))?;
+                Ok(true)
+            }
+            "Sort" => {
+                // Only handle here when already inside a Grouping Sets block;
+                // otherwise the simple case is handled elsewhere (parseSortKey).
+                if !get(el, p::GROUPING_SETS)?.truthy() {
+                    return Ok(false);
+                }
+                let entry = Obj::new();
+                entry.set(p::SORT_KEY, values);
+                push(&get(el, p::GROUPING_SETS)?, Val::Obj(entry), concat!("el[", PROPERTY_IMPORT!(), ".GROUPING_SETS]"))?;
+                Ok(true)
+            }
+            "Group" => {
+                let sets = get(el, p::GROUPING_SETS)?;
+                let last_set = if sets.truthy() { lodash::last(&sets)? } else { sets };
+
+                if last_set.truthy() && js_in(p::SORT_KEY, &last_set)? {
+                    // Group Key attached to a Sort Key in the same Grouping Set
+                    set(&last_set, p::GROUP_KEYS, arr(vec![values]))?;
+                } else if last_set.truthy() && js_in(p::HASH_KEYS, &last_set)? {
+                    // Last set was Hash Keys: start a new Grouping Set
+                    let entry = Obj::new();
+                    entry.set(p::GROUP_KEYS, arr(vec![values]));
+                    push(&get(el, p::GROUPING_SETS)?, Val::Obj(entry), concat!("el[", PROPERTY_IMPORT!(), ".GROUPING_SETS]"))?;
+                } else if last_set.truthy() {
+                    // Append to the current set's existing Group Keys
+                    let keys = get(&last_set, p::GROUP_KEYS)?;
+                    if !keys.is_nullish() {
+                        push(&keys, values, concat!("lastSet[", PROPERTY_IMPORT!(), ".GROUP_KEYS]?"))?;
+                    }
+                } else if get(el, p::GROUP_KEY)?.truthy() {
+                    // No Grouping Sets yet, but a Group Key already exists:
+                    // convert it into a Grouping Set holding both keys
+                    let entry = Obj::new();
+                    entry.set(p::GROUP_KEYS, arr(vec![get(el, p::GROUP_KEY)?, values]));
+                    set(el, p::GROUPING_SETS, arr(vec![Val::Obj(entry)]))?;
+                } else {
+                    set(el, p::GROUP_KEY, values)?;
+                }
+                Ok(true)
+            }
+            _ => Ok(false),
+        }
+    }
+}
+
+/// The `in` operator for a string key.
+fn js_in(key: &str, target: &Val) -> JsResult<bool> {
+    match target {
+        Val::Obj(o) => Ok(o.has(key)),
+        Val::Arr(a) => Ok(key == "length" || key.parse::<usize>().map(|i| i < a.len()).unwrap_or(false)),
+        other => Err(format!(
+            "Cannot use 'in' operator to search for '{}' in {}",
+            key,
+            other.to_js_string()
+        )),
+    }
+}
+
+/// `_.property(key)` iteratee.
+fn lodash_property(o: &Val, key: &str) -> Val {
+    if o.is_nullish() {
+        Val::Undef
+    } else {
+        get(o, key).unwrap_or(Val::Undef)
+    }
+}
+
+/// The `[regex] || ...` alternatives used by `nodeRegex` all start with
+/// `(cost=`, `(actual` or `(never`; lines without any of them cannot match.
+fn node_regex_exec(u: &[u16]) -> Option<Match<'_>> {
+    let line = from_utf16(u);
+    if !(line.contains("(cost=") || line.contains("(actual") || line.contains("(never")) {
+        return None;
+    }
+    exec(node_regex(), u)
+}
+
+fn node_regex() -> &'static Regex {
+    let prefix_pattern = r"^(\s*->\s*|\s*)";
+    let partial_pattern = r"(Finalize|Simple|Partial)*";
+    let type_pattern = r"([^\r\n\t\f\v\(]*?)";
+    let estimation_pattern = r"\(cost=(\d+\.\d+)\.\.(\d+\.\d+)\s+rows=(\d+)\s+width=(\d+)\)";
+    let non_capturing_group_open = "(?:";
+    let non_capturing_group_close = ")";
+    let open_parenthesis_pattern = r"\(";
+    let close_parenthesis_pattern = r"\)";
+    let actual_pattern =
+        r"(?:actual(?:\stime=(\d+\.\d+)\.\.(\d+\.\d+))?\srows=(\d+(?:\.\d+)?)\sloops=(\d+)|(never\s+executed))";
+    static RE: std::sync::OnceLock<Regex> = std::sync::OnceLock::new();
+    RE.get_or_init(|| {
+        let pattern = [
+            prefix_pattern,
+            partial_pattern,
+            r"\s*",
+            type_pattern,
+            r"\s*",
+            non_capturing_group_open,
+            non_capturing_group_open,
+            estimation_pattern,
+            r"\s+",
+            open_parenthesis_pattern,
+            actual_pattern,
+            close_parenthesis_pattern,
+            non_capturing_group_close,
+            "|",
+            non_capturing_group_open,
+            estimation_pattern,
+            non_capturing_group_close,
+            "|",
+            non_capturing_group_open,
+            open_parenthesis_pattern,
+            actual_pattern,
+            close_parenthesis_pattern,
+            non_capturing_group_close,
+            non_capturing_group_close,
+            r"\s*$",
+        ]
+        .concat();
+        Regex::new(&pattern, "m").expect("valid node regex")
+    })
+}
+
+/// `text.split(/: (.+)/).filter((x) => x)`.
+fn split_info(text: &str) -> Vec<String> {
+    split(js_regex!(r": (.+)", ""), text)
+        .into_iter()
+        .flatten()
+        .filter(|x| !x.is_empty())
+        .collect()
+}
+
+fn buffer_key(kind: &str, method: &str) -> String {
+    format!("{} {} {}", capitalize(kind), capitalize(method), capitalize("blocks"))
+}
+
+fn parse_time(text: &str) -> f64 {
+    parse_float(&replace(js_regex!(r"(\s*ms)$", ""), text, ""))
+}
+
+/// `source.replace(/\s*\+\r?\n/g, "\n")`, computed in linear time.
+///
+/// At a given position the greedy `\s*` either reaches a `+` followed by a
+/// line break or fails without useful backtracking, so the leftmost match
+/// starts at the beginning of the whitespace run preceding `+`.
+fn remove_plus_continuations(u: &[u16]) -> Vec<u16> {
+    use crate::js::text::is_whitespace;
+    let mut out = Vec::with_capacity(u.len());
+    let mut copied = 0usize;
+    let mut p = 0usize;
+    let len = u.len();
+    while p < len {
+        let mut q = p;
+        while q < len && is_whitespace(u[q]) {
+            q += 1;
+        }
+        if q < len && u[q] == b'+' as u16 {
+            let end = if q + 1 < len && u[q + 1] == b'\n' as u16 {
+                Some(q + 2)
+            } else if q + 2 < len && u[q + 1] == b'\r' as u16 && u[q + 2] == b'\n' as u16 {
+                Some(q + 3)
+            } else {
+                None
+            };
+            if let Some(end) = end {
+                out.extend_from_slice(&u[copied..p]);
+                out.push(b'\n' as u16);
+                copied = end;
+                p = end;
+                continue;
+            }
+        }
+        p = q + 1;
+    }
+    out.extend_from_slice(&u[copied..]);
+    out
+}
+
+// ---------------------------------------------------------------------------
+// Dates for the plan metadata (`id`, `name`, `createdOn`).
+
+fn now_millis() -> i64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis() as i64)
+        .unwrap_or(0)
+}
+
+fn civil_from_days(days: i64) -> (i64, u32, u32) {
+    let z = days + 719468;
+    let era = if z >= 0 { z } else { z - 146096 } / 146097;
+    let doe = z - era * 146097;
+    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = (doy - (153 * mp + 2) / 5 + 1) as u32;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 } as u32;
+    (if m <= 2 { y + 1 } else { y }, m, d)
+}
+
+/// `Date.prototype.toDateString` (in UTC).
+fn date_string(ms: i64) -> String {
+    const DAYS: [&str; 7] = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+    const MONTHS: [&str; 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+    let days = ms.div_euclid(86_400_000);
+    let (y, m, d) = civil_from_days(days);
+    let weekday = (days + 4).rem_euclid(7) as usize;
+    format!("{} {} {:02} {:04}", DAYS[weekday], MONTHS[(m - 1) as usize], d, y)
+}
+
+/// `Date.prototype.toISOString`, which `JSON.stringify` uses for dates.
+fn iso_string(ms: i64) -> String {
+    let days = ms.div_euclid(86_400_000);
+    let rem = ms.rem_euclid(86_400_000);
+    let (y, m, d) = civil_from_days(days);
+    format!(
+        "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z",
+        y,
+        m,
+        d,
+        rem / 3_600_000,
+        rem / 60_000 % 60,
+        rem / 1000 % 60,
+        rem % 1000
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn dates() {
+        assert_eq!(iso_string(0), "1970-01-01T00:00:00.000Z");
+        assert_eq!(date_string(0), "Thu Jan 01 1970");
+        assert_eq!(iso_string(1_789_000_000_123), "2026-09-10T00:26:40.123Z");
+    }
+
+    #[test]
+    fn plus_continuations_match_the_regex() {
+        let re = Regex::new(r"\s*\+\r?\n", "g").unwrap();
+        for s in ["a +\nb", "a  \n  +\nb", "+\r\n", "+\r", "x+ \n+\n", " \t+\n\n+\n", "a+", "+"] {
+            let u = utf16(s);
+            assert_eq!(remove_plus_continuations(&u), re.replace(&u, &utf16("\n")), "{:?}", s);
+        }
+    }
+}
