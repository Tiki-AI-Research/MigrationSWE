+const RE_HAS_UNICODE: (&str, &str) = (r#"[\u200d\ud800-\udfff\u0300-\u036f\ufe20-\ufe2f\u20d0-\u20ff\ufe0e\ufe0f]"#, "");
+const RE_HAS_UNICODE_WORD: (&str, &str) = (r#"[a-z][A-Z]|[A-Z]{2}[a-z]|[0-9][a-zA-Z]|[a-zA-Z][0-9]|[^a-zA-Z0-9 ]"#, "");
+const RE_ASCII_WORD: (&str, &str) = (r#"[^\x00-\x2f\x3a-\x40\x5b-\x60\x7b-\x7f]+"#, "g");
