+
+    fn u(s: &str) -> Vec<u16> {
+        s.encode_utf16().collect()
+    }
+
+    fn groups(re: &str, flags: &str, s: &str) -> Option<Vec<Option<String>>> {
+        let re = Regex::new(re, flags).unwrap();
+        let input = u(s);
+        re.exec_fresh(&input).map(|c| {
+            c.iter()
+                .map(|g| g.map(|(a, b)| String::from_utf16_lossy(&input[a..b])))
+                .collect()
+        })
+    }
+
+    #[test]
+    fn captures_reset_per_iteration() {
+        assert_eq!(
+            groups(r"(?:(a)|b)*", "", "ab").unwrap(),
+            vec![Some("ab".to_string()), None]
+        );
+    }
+
+    #[test]
+    fn empty_iterations_are_rejected() {
+        assert_eq!(
+            groups(r"^(Group|Hash|Mixed|[A-z]*)*Aggregate$", "", "Aggregate").unwrap(),
+            vec![Some("Aggregate".to_string()), None]
+        );
+        assert_eq!(
+            groups(r"^(Group|Hash|Mixed|[A-z]*)*Aggregate$", "", "HashAggregate").unwrap()[1],
+            Some("Hash".to_string())
+        );
+    }
+
+    #[test]
+    fn backreferences_and_multiline() {
+        let re = Regex::new(r"^(\||║|│)(.*)\1\r?\n", "gm").unwrap();
+        let out = re.replace(&u("|a|\n|b|\r\nc\n"), &u("$2\n"));
+        assert_eq!(String::from_utf16_lossy(&out), "a\nb\nc\n");
+    }
+
+    #[test]
+    fn split_with_captures() {
+        let re = Regex::new(r": (.+)", "").unwrap();
+        let parts: Vec<Option<String>> = re
+            .split(&u("Sort Key: a: b"))
+            .into_iter()
+            .map(|p| p.map(|v| String::from_utf16_lossy(&v)))
+            .collect();
+        assert_eq!(
+            parts,
+            vec![Some("Sort Key".into()), Some("a: b".into()), Some("".into())]
+        );
+    }
+}
diff --git a/crates/pev2-core/src/js/text.rs b/crates/pev2-core/src/js/text.rs
new file mode 100644
index 0000000..33dcdfd
--- /dev/null
+++ b/crates/pev2-core/src/js/text.rs
@@ -0,0 +1,350 @@
+//! JavaScript string and number primitives.
+//!
+//! JavaScript strings are sequences of UTF-16 code units; the helpers here
+//! work on that representation where indices matter, and reproduce the
+//! number conversions used by the plan parser (`parseFloat`, `parseInt`,
+//! `Number(...)`, `Number.prototype.toString` and `toFixed`).
+
+/// `WhiteSpace` or `LineTerminator`, i.e. the code units matched by `\s` and
+/// removed by `String.prototype.trim`.
+pub fn is_whitespace(c: u16) -> bool {
+    matches!(
+        c,
+        0x09..=0x0D | 0x20 | 0xA0 | 0x1680 | 0x2000..=0x200A | 0x2028 | 0x2029 | 0x202F | 0x205F | 0x3000 | 0xFEFF
+    )
+}
+
+/// `LineTerminator` code units (`.` does not match them, `^`/`$` treat them
+/// as line boundaries in multiline mode).
+pub fn is_line_terminator(c: u16) -> bool {
+    matches!(c, 0x0A | 0x0D | 0x2028 | 0x2029)
+}
+
+pub fn is_whitespace_char(c: char) -> bool {
+    (c as u32) <= 0xFFFF && is_whitespace(c as u32 as u16)
+}
+
+pub fn utf16(s: &str) -> Vec<u16> {
+    s.encode_utf16().collect()
+}
+
+pub fn from_utf16(u: &[u16]) -> String {
+    String::from_utf16_lossy(u)
+}
+
+/// `String.prototype.trim`.
+pub fn trim(s: &str) -> &str {
+    s.trim_matches(is_whitespace_char)
+}
+
+pub fn trim_start(s: &str) -> &str {
+    s.trim_start_matches(is_whitespace_char)
+}
+
+/// Length of the longest prefix of `s` that is a `StrDecimalLiteral`
+/// (without sign), or `None` when there is none. Returns the normalized
+/// literal suitable for `str::parse::<f64>`.
+fn decimal_prefix(s: &str) -> Option<(usize, String)> {
+    let b = s.as_bytes();
+    let mut i = 0;
+    let int_start = i;
+    while i < b.len() && b[i].is_ascii_digit() {
+        i += 1;
+    }
+    let int_part = &s[int_start..i];
+    let mut frac_part = "";
+    if i < b.len() && b[i] == b'.' {
+        let fs = i + 1;
+        let mut j = fs;
+        while j < b.len() && b[j].is_ascii_digit() {
+            j += 1;
+        }
+        if !int_part.is_empty() || j > fs {
+            frac_part = &s[fs..j];
+            i = j;
+        }
+    }
+    if int_part.is_empty() && frac_part.is_empty() {
+        return None;
+    }
+    let mut exp = String::new();
+    if i < b.len() && (b[i] == b'e' || b[i] == b'E') {
+        let mut j = i + 1;
+        let mut sign = "";
+        if j < b.len() && (b[j] == b'+' || b[j] == b'-') {
+            sign = if b[j] == b'-' { "-" } else { "" };
+            j += 1;
+        }
+        let ds = j;
+        while j < b.len() && b[j].is_ascii_digit() {
+            j += 1;
+        }
+        if j > ds {
+            exp = format!("e{}{}", sign, &s[ds..j]);
+            i = j;
+        }
+    }
+    let lit = format!(
+        "{}.{}{}",
+        if int_part.is_empty() { "0" } else { int_part },
+        if frac_part.is_empty() { "0" } else { frac_part },
+        exp
+    );
+    Some((i, lit))
+}
+
+fn parse_decimal(lit: &str) -> f64 {
+    lit.parse::<f64>().unwrap_or(f64::NAN)
+}
+
+/// `parseFloat(string)`.
+pub fn parse_float(s: &str) -> f64 {
+    let t = trim_start(s);
+    let (neg, rest) = match t.as_bytes().first() {
+        Some(b'-') => (true, &t[1..]),
+        Some(b'+') => (false, &t[1..]),
+        _ => (false, t),
+    };
+    let v = if rest.starts_with("Infinity") {
+        f64::INFINITY
+    } else {
+        match decimal_prefix(rest) {
+            Some((_, lit)) => parse_decimal(&lit),
+            None => return f64::NAN,
+        }
+    };
+    if neg {
+        -v
+    } else {
+        v
+    }
+}
+
+/// `parseInt(string)` / `parseInt(string, 0)`.
+pub fn parse_int(s: &str) -> f64 {
+    let t = trim_start(s);
+    let (neg, mut rest) = match t.as_bytes().first() {
+        Some(b'-') => (true, &t[1..]),
+        Some(b'+') => (false, &t[1..]),
+        _ => (false, t),
+    };
+    let mut radix = 10u32;
+    if rest.starts_with("0x") || rest.starts_with("0X") {
+        rest = &rest[2..];
+        radix = 16;
+    }
+    let end = rest
+        .char_indices()
+        .find(|(_, c)| !c.is_digit(radix))
+        .map(|(i, _)| i)
+        .unwrap_or(rest.len());
+    let digits = &rest[..end];
+    if digits.is_empty() {
+        return f64::NAN;
+    }
+    let v = if radix == 10 {
+        parse_decimal(digits)
+    } else {
+        let mut acc: u128 = 0;
+        let mut overflow = false;
+        let mut approx = 0f64;
+        for c in digits.chars() {
+            let d = c.to_digit(radix).unwrap();
+            approx = approx * radix as f64 + d as f64;
+            match acc.checked_mul(radix as u128).and_then(|a| a.checked_add(d as u128)) {
+                Some(a) => acc = a,
+                None => overflow = true,
+            }
+        }
+        if overflow {
+            approx
+        } else {
+            acc as f64
+        }
+    };
+    if neg {
+        -v
+    } else {
+        v
+    }
+}
+
+/// `StringToNumber`, as performed by `Number(string)` or arithmetic.
+pub fn string_to_number(s: &str) -> f64 {
+    let t = trim(s);
+    if t.is_empty() {
+        return 0.0;
+    }
+    let radix_prefix = |p: &str, radix: u32| -> Option<f64> {
+        let lower = t.get(..2)?;
+        if !lower.eq_ignore_ascii_case(p) {
+            return None;
+        }
+        let digits = &t[2..];
+        if digits.is_empty() || !digits.chars().all(|c| c.is_digit(radix)) {
+            return Some(f64::NAN);
+        }
+        let mut v = 0f64;
+        for c in digits.chars() {
+            v = v * radix as f64 + c.to_digit(radix).unwrap() as f64;
+        }
+        Some(v)
+    };
+    if let Some(v) = radix_prefix("0x", 16)
+        .or_else(|| radix_prefix("0o", 8))
+        .or_else(|| radix_prefix("0b", 2))
+    {
+        return v;
+    }
+    let (neg, rest) = match t.as_bytes()[0] {
+        b'-' => (true, &t[1..]),
+        b'+' => (false, &t[1..]),
+        _ => (false, t),
+    };
+    let v = if rest == "Infinity" {
+        f64::INFINITY
+    } else {
+        match decimal_prefix(rest) {
+            Some((len, lit)) if len == rest.len() => parse_decimal(&lit),
+            _ => return f64::NAN,
+        }
+    };
+    if neg {
+        -v
+    } else {
+        v
+    }
+}
+
+/// `Number::toString(x)` (radix 10).
+pub fn number_to_string(x: f64) -> String {
+    if x.is_nan() {
+        return "NaN".to_string();
+    }
+    if x == 0.0 {
+        return "0".to_string();
+    }
+    if x.is_infinite() {
+        return if x > 0.0 { "Infinity" } else { "-Infinity" }.to_string();
+    }
+    if x < 0.0 {
+        return format!("-{}", number_to_string(-x));
+    }
+    // Shortest round-tripping digits, as produced by Rust's float formatting.
+    let e = format!("{:e}", x);
+    let (mant, exp) = e.split_once('e').unwrap();
+    let digits: String = mant.chars().filter(|c| *c != '.').collect();
+    let exp: i64 = exp.parse().unwrap();
+    let k = digits.len() as i64;
+    let n = exp + 1;
+    if k <= n && n <= 21 {
+        format!("{}{}", digits, "0".repeat((n - k) as usize))
+    } else if 0 < n && n <= 21 {
+        format!("{}.{}", &digits[..n as usize], &digits[n as usize..])
+    } else if -6 < n && n <= 0 {
+        format!("0.{}{}", "0".repeat((-n) as usize), digits)
+    } else {
+        let e = n - 1;
+        let sign = if e >= 0 { "+" } else { "-" };
+        if k == 1 {
+            format!("{}e{}{}", digits, sign, e.abs())
+        } else {
+            format!("{}.{}e{}{}", &digits[..1], &digits[1..], sign, e.abs())
+        }
+    }
+}
+
+/// `Number(x.toFixed(digits))` for a number `x`.
+pub fn to_fixed_number(x: f64, digits: u32) -> f64 {
+    if x.is_nan() {
+        return f64::NAN;
+    }
+    if x.abs() >= 1e21 {
+        return x;
+    }
+    let neg = x < 0.0;
+    let a = x.abs();
+    let scale = 10u128.pow(digits);
+    // Decompose `a` as `mant * 2^exp` exactly.
+    let bits = a.to_bits();
+    let biased = ((bits >> 52) & 0x7FF) as i64;
+    let frac = (bits & ((1u64 << 52) - 1)) as u128;
+    let (mant, exp) = if biased == 0 {
+        (frac, -1074i64)
+    } else {
+        (frac | (1u128 << 52), biased - 1075)
+    };
+    let num = mant * scale;
+    // n is the integer closest to a * 10^digits, picking the larger on ties.
+    let n: u128 = if exp >= 0 {
+        num << exp
+    } else {
+        let sh = (-exp) as u32;
+        if sh >= 127 {
+            0
+        } else {
+            let q = num >> sh;
+            let r = num - (q << sh);
+            let half = 1u128 << (sh - 1);
+            if r >= half {
+                q + 1
+            } else {
+                q
+            }
+        }
+    };
+    let int_part = n / scale;
+    let frac_part = n % scale;
+    let s = if digits == 0 {
+        format!("{}{}", if neg { "-" } else { "" }, int_part)
+    } else {
+        format!(
+            "{}{}.{:0width$}",
+            if neg { "-" } else { "" },
+            int_part,
+            frac_part,
+            width = digits as usize
+        )
+    };
+    s.parse::<f64>().unwrap()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn number_formatting() {
+        assert_eq!(number_to_string(0.1 + 0.2), "0.30000000000000004");
+        assert_eq!(number_to_string(1e21), "1e+21");
+        assert_eq!(number_to_string(123456789012345680000.0), "123456789012345680000");
+        assert_eq!(number_to_string(0.000001), "0.000001");
+        assert_eq!(number_to_string(1e-7), "1e-7");
+        assert_eq!(number_to_string(-1.5e-9), "-1.5e-9");
+        assert_eq!(number_to_string(5.0), "5");
+    }
+
+    #[test]
+    fn fixed() {
+        assert_eq!(to_fixed_number(1.0005, 3), 1.0);
+        assert_eq!(to_fixed_number(1.0625, 3), 1.063);
+        assert_eq!(to_fixed_number(-0.0001, 3).to_bits(), (-0.0f64).to_bits());
+        assert_eq!(to_fixed_number(2.5, 0), 3.0);
+    }
+
+    #[test]
+    fn parsing() {
+        assert_eq!(parse_float("  1.5 ms"), 1.5);
+        assert_eq!(parse_float(".5"), 0.5);
+        assert_eq!(parse_float("5."), 5.0);
+        assert_eq!(parse_float("1e3x"), 1000.0);
+        assert_eq!(parse_float("1e"), 1.0);
+        assert!(parse_float("abc").is_nan());
+        assert_eq!(parse_int("0x1A"), 26.0);
+        assert_eq!(parse_int("12.7"), 12.0);
+        assert!(parse_int("").is_nan());
+        assert_eq!(string_to_number(" 12 "), 12.0);
+        assert!(string_to_number("12px").is_nan());
+        assert_eq!(string_to_number(""), 0.0);
+    }
+}
diff --git a/crates/pev2-core/src/js/value.rs b/crates/pev2-core/src/js/value.rs
new file mode 100644
index 0000000..7e5c6bb
--- /dev/null
+++ b/crates/pev2-core/src/js/value.rs
@@ -0,0 +1,558 @@
+//! A small model of JavaScript values.
+//!
+//! The plan service mutates loosely typed, shared object graphs (a node is
+//! referenced from its parent's `Plans`, from the parser's depth stack and
+//! from the flat node list at the same time). Values here have JavaScript
+//! reference semantics, keep "own property with value `undefined`" distinct
+//! from "missing property", and implement the coercions the TypeScript code
+//! relies on.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::hash::{BuildHasherDefault, Hasher};
+use std::rc::Rc;
+
+use super::text::{number_to_string, string_to_number};
+
+pub type JsResult<T> = Result<T, String>;
+
+#[derive(Clone, Debug)]
+pub enum Val {
+    Undef,
+    Null,
+    Bool(bool),
+    Num(f64),
+    Str(Rc<str>),
+    Obj(Obj),
+    Arr(Arr),
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct Obj(Rc<RefCell<ObjData>>);
+
+/// FNV-1a, a fast hash for short property names.
+#[derive(Default)]
+pub struct KeyHasher(u64);
+
+impl Hasher for KeyHasher {
+    fn write(&mut self, bytes: &[u8]) {
+        let mut h = if self.0 == 0 { 0xcbf29ce484222325 } else { self.0 };
+        for b in bytes {
+            h ^= *b as u64;
+            h = h.wrapping_mul(0x100000001b3);
+        }
+        self.0 = h;
+    }
+
+    fn finish(&self) -> u64 {
+        self.0
+    }
+}
+
+type KeyIndex = HashMap<Rc<str>, usize, BuildHasherDefault<KeyHasher>>;
+
+#[derive(Debug, Default)]
+pub struct ObjData {
+    keys: Vec<Rc<str>>,
+    vals: Vec<Val>,
+    index: KeyIndex,
+    /// Declared class fields that are own properties without having been
+    /// assigned (their value is `undefined`).
+    fields: Option<&'static [&'static str]>,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct Arr(Rc<RefCell<Vec<Val>>>);
+
+/// An owned snapshot of a parser-produced value tree. Unlike `Val`, it can
+/// cross threads while retaining undefined class fields and non-finite numbers.
+pub(crate) enum FrozenVal {
+    Undef,
+    Null,
+    Bool(bool),
+    Num(f64),
+    Str(String),
+    Obj(Vec<(String, FrozenVal)>, Option<&'static [&'static str]>),
+    Arr(Vec<FrozenVal>),
+}
+
+impl FrozenVal {
+    pub(crate) fn freeze(value: &Val) -> Self {
+        match value {
+            Val::Undef => Self::Undef,
+            Val::Null => Self::Null,
+            Val::Bool(v) => Self::Bool(*v),
+            Val::Num(v) => Self::Num(*v),
+            Val::Str(v) => Self::Str(v.to_string()),
+            Val::Obj(v) => Self::Obj(
+                v.entries().into_iter().map(|(k, v)| (k.to_string(), Self::freeze(&v))).collect(),
+                v.0.borrow().fields,
+            ),
+            Val::Arr(v) => Self::Arr(v.to_vec().iter().map(Self::freeze).collect()),
+        }
+    }
+
+    pub(crate) fn thaw(self) -> Val {
+        match self {
+            Self::Undef => Val::Undef,
+            Self::Null => Val::Null,
+            Self::Bool(v) => Val::Bool(v),
+            Self::Num(v) => Val::Num(v),
+            Self::Str(v) => Val::Str(Rc::from(v)),
+            Self::Obj(entries, fields) => {
+                let obj = fields.map(Obj::with_fields).unwrap_or_default();
+                for (key, value) in entries {
+                    obj.set(&key, value.thaw());
+                }
+                Val::Obj(obj)
+            }
+            Self::Arr(values) => Val::Arr(Arr::new(values.into_iter().map(Self::thaw).collect())),
+        }
+    }
+}
+
+impl Obj {
+    pub fn new() -> Obj {
+        Obj::default()
+    }
+
+    /// Own property lookup.
+    pub fn get(&self, key: &str) -> Option<Val> {
+        let d = self.0.borrow();
+        d.index.get(key).map(|i| d.vals[*i].clone())
+    }
+
+    /// An instance of a class declaring `fields`: they are own properties
+    /// whose value is `undefined` until assigned.
+    pub fn with_fields(fields: &'static [&'static str]) -> Obj {
+        let o = Obj::new();
+        o.0.borrow_mut().fields = Some(fields);
+        o
+    }
+
+    /// Whether `key` is an own property.
+    pub fn has(&self, key: &str) -> bool {
+        let d = self.0.borrow();
+        d.index.contains_key(key) || d.fields.map(|f| f.contains(&key)).unwrap_or(false)
+    }
+
+    /// Defines or updates an own data property.
+    pub fn set(&self, key: &str, val: Val) {
+        let mut d = self.0.borrow_mut();
+        if let Some(i) = d.index.get(key).copied() {
+            d.vals[i] = val;
+        } else {
+            let k: Rc<str> = Rc::from(key);
+            let i = d.keys.len();
+            d.keys.push(k.clone());
+            d.vals.push(val);
+            d.index.insert(k, i);
+        }
+    }
+
+    pub fn entries(&self) -> Vec<(Rc<str>, Val)> {
+        let d = self.0.borrow();
+        d.keys.iter().cloned().zip(d.vals.iter().cloned()).collect()
+    }
+
+    pub fn values(&self) -> Vec<Val> {
+        self.0.borrow().vals.clone()
+    }
+
+    /// Own properties in `OrdinaryOwnPropertyKeys` order: array indices in
+    /// ascending numeric order, then the other keys in insertion order.
+    pub fn entries_ordered(&self) -> Vec<(Rc<str>, Val)> {
+        let mut entries = self.entries();
+        if entries.iter().any(|(k, _)| array_index(k).is_some()) {
+            let mut indexed: Vec<(usize, (Rc<str>, Val))> = Vec::new();
+            let mut named: Vec<(Rc<str>, Val)> = Vec::new();
+            for (k, v) in entries {
+                match array_index(&k) {
+                    Some(i) if i < u32::MAX as usize => indexed.push((i, (k, v))),
+                    _ => named.push((k, v)),
+                }
+            }
+            indexed.sort_by_key(|(i, _)| *i);
+            entries = indexed.into_iter().map(|(_, e)| e).collect();
+            entries.extend(named);
+        }
+        entries
+    }
+
+    pub fn ptr_eq(&self, other: &Obj) -> bool {
+        Rc::ptr_eq(&self.0, &other.0)
+    }
+}
+
+impl Arr {
+    pub fn new(v: Vec<Val>) -> Arr {
+        Arr(Rc::new(RefCell::new(v)))
+    }
+
+    pub fn len(&self) -> usize {
+        self.0.borrow().len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    pub fn get(&self, i: usize) -> Val {
+        self.0.borrow().get(i).cloned().unwrap_or(Val::Undef)
+    }
+
+    pub fn push(&self, v: Val) {
+        self.0.borrow_mut().push(v);
+    }
+
+    pub fn to_vec(&self) -> Vec<Val> {
+        self.0.borrow().clone()
+    }
+
+    pub fn retain_indices(&self, remove: &[usize]) {
+        let mut v = self.0.borrow_mut();
+        let mut i = 0;
+        v.retain(|_| {
+            let keep = !remove.contains(&i);
+            i += 1;
+            keep
+        });
+    }
+
+    pub fn ptr_eq(&self, other: &Arr) -> bool {
+        Rc::ptr_eq(&self.0, &other.0)
+    }
+
+    fn set_index(&self, i: usize, val: Val) {
+        let mut v = self.0.borrow_mut();
+        if i >= v.len() {
+            v.resize(i + 1, Val::Undef);
+        }
+        v[i] = val;
+    }
+}
+
+/// Parses a canonical array index ("0", "1", ... without leading zeros).
+fn array_index(key: &str) -> Option<usize> {
+    if key.is_empty() || (key.len() > 1 && key.starts_with('0')) || !key.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    key.parse::<usize>().ok()
+}
+
+impl Val {
+    pub fn str(s: &str) -> Val {
+        Val::Str(Rc::from(s))
+    }
+
+    pub fn is_undef(&self) -> bool {
+        matches!(self, Val::Undef)
+    }
+
+    pub fn is_nullish(&self) -> bool {
+        matches!(self, Val::Undef | Val::Null)
+    }
+
+    pub fn as_str(&self) -> Option<&str> {
+        match self {
+            Val::Str(s) => Some(s),
+            _ => None,
+        }
+    }
+
+    pub fn truthy(&self) -> bool {
+        match self {
+            Val::Undef | Val::Null => false,
+            Val::Bool(b) => *b,
+            Val::Num(n) => !(*n == 0.0 || n.is_nan()),
+            Val::Str(s) => !s.is_empty(),
+            Val::Obj(_) | Val::Arr(_) => true,
+        }
+    }
+
+    /// `ToPrimitive` for the object types this model has.
+    pub fn to_primitive(&self) -> Val {
+        match self {
+            Val::Obj(_) => Val::str("[object Object]"),
+            Val::Arr(_) => Val::Str(Rc::from(self.to_js_string())),
+            v => v.clone(),
+        }
+    }
+
+    pub fn to_number(&self) -> f64 {
+        match self {
+            Val::Undef => f64::NAN,
+            Val::Null => 0.0,
+            Val::Bool(b) => {
+                if *b {
+                    1.0
+                } else {
+                    0.0
+                }
+            }
+            Val::Num(n) => *n,
+            Val::Str(s) => string_to_number(s),
+            Val::Obj(_) => f64::NAN,
+            Val::Arr(_) => string_to_number(&self.to_js_string()),
+        }
+    }
+
+    /// `ToString`.
+    pub fn to_js_string(&self) -> String {
+        match self {
+            Val::Undef => "undefined".to_string(),
+            Val::Null => "null".to_string(),
+            Val::Bool(b) => b.to_string(),
+            Val::Num(n) => number_to_string(*n),
+            Val::Str(s) => s.to_string(),
+            Val::Obj(_) => "[object Object]".to_string(),
+            Val::Arr(a) => a
+                .to_vec()
+                .iter()
+                .map(|v| if v.is_nullish() { String::new() } else { v.to_js_string() })
+                .collect::<Vec<_>>()
+                .join(","),
+        }
+    }
+
+    /// The `typeof`-style description V8 uses in "Cannot create property"
+    /// errors.
+    fn primitive_description(&self) -> String {
+        match self {
+            Val::Str(s) => format!("string '{}'", s),
+            Val::Num(n) => format!("number '{}'", number_to_string(*n)),
+            Val::Bool(b) => format!("boolean '{}'", b),
+            _ => String::new(),
+        }
+    }
+}
+
+impl From<f64> for Val {
+    fn from(n: f64) -> Val {
+        Val::Num(n)
+    }
+}
+
+impl From<bool> for Val {
+    fn from(b: bool) -> Val {
+        Val::Bool(b)
+    }
+}
+
+impl From<&str> for Val {
+    fn from(s: &str) -> Val {
+        Val::str(s)
+    }
+}
+
+impl From<String> for Val {
+    fn from(s: String) -> Val {
+        Val::Str(Rc::from(s))
+    }
+}
+
+impl From<Obj> for Val {
+    fn from(o: Obj) -> Val {
+        Val::Obj(o)
+    }
+}
+
+impl From<Arr> for Val {
+    fn from(a: Arr) -> Val {
+        Val::Arr(a)
+    }
+}
+
+/// Property read `v[key]`.
+pub fn get(v: &Val, key: &str) -> JsResult<Val> {
+    match v {
+        Val::Undef => Err(format!("Cannot read properties of undefined (reading '{}')", key)),
+        Val::Null => Err(format!("Cannot read properties of null (reading '{}')", key)),
+        Val::Obj(o) => Ok(o.get(key).unwrap_or(Val::Undef)),
+        Val::Arr(a) => Ok(if key == "length" {
+            Val::Num(a.len() as f64)
+        } else {
+            match array_index(key) {
+                Some(i) => a.get(i),
+                None => Val::Undef,
+            }
+        }),
+        Val::Str(s) => Ok(if key == "length" {
+            Val::Num(s.encode_utf16().count() as f64)
+        } else {
+            match array_index(key) {
+                Some(i) => match s.encode_utf16().nth(i) {
+                    Some(u) => Val::Str(Rc::from(String::from_utf16_lossy(&[u]))),
+                    None => Val::Undef,
+                },
+                None => Val::Undef,
+            }
+        }),
+        Val::Num(_) | Val::Bool(_) => Ok(Val::Undef),
+    }
+}
+
+/// Property assignment `v[key] = val` in strict mode code.
+pub fn set(v: &Val, key: &str, val: Val) -> JsResult<()> {
+    match v {
+        Val::Undef => Err(format!("Cannot set properties of undefined (setting '{}')", key)),
+        Val::Null => Err(format!("Cannot set properties of null (setting '{}')", key)),
+        Val::Obj(o) => {
+            // Assigning `__proto__` goes through the prototype setter and never
+            // creates an own property.
+            if key != "__proto__" {
+                o.set(key, val);
+            }
+            Ok(())
+        }
+        Val::Arr(a) => {
+            if let Some(i) = array_index(key) {
+                a.set_index(i, val);
+            } else if key == "length" {
+                let n = val.to_number();
+                if n >= 0.0 && n.fract() == 0.0 {
+                    a.0.borrow_mut().resize(n as usize, Val::Undef);
+                }
+            }
+            Ok(())
+        }
+        p => Err(format!("Cannot create property '{}' on {}", key, p.primitive_description())),
+    }
+}
+
+/// `a || b`.
+pub fn or(a: Val, b: Val) -> Val {
+    if a.truthy() {
+        a
+    } else {
+        b
+    }
+}
+
+/// The binary `+` operator.
+pub fn add(a: &Val, b: &Val) -> Val {
+    let pa = a.to_primitive();
+    let pb = b.to_primitive();
+    if matches!(pa, Val::Str(_)) || matches!(pb, Val::Str(_)) {
+        Val::from(pa.to_js_string() + &pb.to_js_string())
+    } else {
+        Val::Num(pa.to_number() + pb.to_number())
+    }
+}
+
+/// `a < b` (`IsLessThan` with primitive operands).
+pub fn lt(a: &Val, b: &Val) -> bool {
+    let pa = a.to_primitive();
+    let pb = b.to_primitive();
+    if let (Val::Str(x), Val::Str(y)) = (&pa, &pb) {
+        return x.encode_utf16().lt(y.encode_utf16());
+    }
+    pa.to_number() < pb.to_number()
+}
+
+/// `a > b`.
+pub fn gt(a: &Val, b: &Val) -> bool {
+    lt(b, a)
+}
+
+/// `a === b`.
+pub fn strict_eq(a: &Val, b: &Val) -> bool {
+    match (a, b) {
+        (Val::Undef, Val::Undef) | (Val::Null, Val::Null) => true,
+        (Val::Bool(x), Val::Bool(y)) => x == y,
+        (Val::Num(x), Val::Num(y)) => x == y,
+        (Val::Str(x), Val::Str(y)) => x == y,
+        (Val::Obj(x), Val::Obj(y)) => x.ptr_eq(y),
+        (Val::Arr(x), Val::Arr(y)) => x.ptr_eq(y),
+        _ => false,
+    }
+}
+
+/// `SameValueZero`, as used by `Array.prototype.includes`.
+pub fn same_value_zero(a: &Val, b: &Val) -> bool {
+    match (a, b) {
+        (Val::Num(x), Val::Num(y)) if x.is_nan() && y.is_nan() => true,
+        _ => strict_eq(a, b),
+    }
+}
+
+/// `a == b`.
+pub fn loose_eq(a: &Val, b: &Val) -> bool {
+    match (a, b) {
+        (Val::Undef | Val::Null, Val::Undef | Val::Null) => true,
+        (Val::Undef | Val::Null, _) | (_, Val::Undef | Val::Null) => false,
+        (Val::Num(x), Val::Str(s)) | (Val::Str(s), Val::Num(x)) => *x == string_to_number(s),
+        (Val::Bool(x), other) | (other, Val::Bool(x)) if !matches!(other, Val::Bool(_)) => {
+            loose_eq(&Val::Num(if *x { 1.0 } else { 0.0 }), other)
+        }
+        (Val::Obj(_) | Val::Arr(_), Val::Num(_) | Val::Str(_)) => loose_eq(&a.to_primitive(), b),
+        (Val::Num(_) | Val::Str(_), Val::Obj(_) | Val::Arr(_)) => loose_eq(a, &b.to_primitive()),
+        _ => strict_eq(a, b),
+    }
+}
+
+/// `Math.max(0, x)` for a number `x`.
+pub fn max_zero(x: f64) -> f64 {
+    if x.is_nan() {
+        f64::NAN
+    } else if x > 0.0 {
+        x
+    } else {
+        0.0
+    }
+}
+
+/// Error raised when calling a method that does not exist on a value.
+pub fn not_a_function(expr: &str) -> String {
+    format!("{} is not a function", expr)
+}
+
+/// `array.push(value)` where `array` is expected to be an array.
+pub fn push(target: &Val, value: Val, expr: &str) -> JsResult<()> {
+    match target {
+        Val::Arr(a) => {
+            a.push(value);
+            Ok(())
+        }
+        Val::Undef => Err("Cannot read properties of undefined (reading 'push')".to_string()),
+        Val::Null => Err("Cannot read properties of null (reading 'push')".to_string()),
+        _ => Err(not_a_function(&format!("{}.push", expr))),
+    }
+}
+
+/// Deep copy of a value graph, preserving shared references.
+pub fn deep_clone(v: &Val) -> Val {
+    fn go(v: &Val, objs: &mut HashMap<*const RefCell<ObjData>, Obj>, arrs: &mut HashMap<*const RefCell<Vec<Val>>, Arr>) -> Val {
+        match v {
+            Val::Obj(o) => {
+                let key = Rc::as_ptr(&o.0);
+                if let Some(c) = objs.get(&key) {
+                    return Val::Obj(c.clone());
+                }
+                let copy = Obj::new();
+                copy.0.borrow_mut().fields = o.0.borrow().fields;
+                objs.insert(key, copy.clone());
+                for (k, x) in o.entries() {
+                    let x = go(&x, objs, arrs);
+                    copy.set(&k, x);
+                }
+                Val::Obj(copy)
+            }
+            Val::Arr(a) => {
+                let key = Rc::as_ptr(&a.0);
+                if let Some(c) = arrs.get(&key) {
+                    return Val::Arr(c.clone());
+                }
+                let copy = Arr::new(Vec::new());
+                arrs.insert(key, copy.clone());
+                for x in a.to_vec() {
+                    let x = go(&x, objs, arrs);
+                    copy.push(x);
+                }
+                Val::Arr(copy)
+            }
+            v => v.clone(),
+        }
+    }
+    go(v, &mut HashMap::new(), &mut HashMap::new())
+}
