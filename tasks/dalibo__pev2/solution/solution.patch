+//! Parallel plan specs: `05-parallel-child-without-worker.spec.ts`,
+//! `05-parallel-children-loops.spec.ts`, `05-parallel-gather-children.spec.ts`,
+//! `05-parallel-launched-workers.spec.ts`, `05-parallel-pg12.spec.ts`,
+//! `24-parallel-aware.spec.ts` and `worker-actual-rows.spec.ts`.
+
+mod common;
+
+use serde_json::Value;
+
+/// `planService.createPlan("", planService.fromSource(source), "")`.
+fn create_plan(source: &str) -> Value {
+    common::plan_from_source(source)
+}
+
+/// `plan.content.Plan`.
+fn root(plan: &Value) -> &Value {
+    &plan["content"]["Plan"]
+}
+
+/// `expect(node).toHaveProperty(key)`.
+#[track_caller]
+fn assert_has_property(node: &Value, key: &str) {
+    assert!(node.get(key).is_some(), "property {:?} missing in {}", key, node);
+}
+
+/// `expect(node).toHaveProperty(key, value)`.
+#[track_caller]
+fn assert_has_property_value(node: &Value, key: &str, expected: &Value) {
+    let actual = node
+        .get(key)
+        .unwrap_or_else(|| panic!("property {:?} missing in {}", key, node));
+    let equal = match (actual.as_f64(), expected.as_f64()) {
+        (Some(a), Some(e)) => a == e,
+        _ => actual == expected,
+    };
+    assert!(equal, "property {:?} is {} instead of {}", key, actual, expected);
+}
+
+/// `expect(actual).toBe(expected)` for numbers (`Object.is`, ignoring the sign of zero).
+#[track_caller]
+fn assert_number_is(actual: Option<&Value>, expected: f64) {
+    let a = actual.and_then(Value::as_f64);
+    assert!(a == Some(expected), "{:?} is not {}", actual, expected);
+}
+
+/// `expect(actual).toBeCloseTo(expected, precision)`.
+#[track_caller]
+fn assert_close_to(actual: Option<&Value>, expected: f64, precision: i32) {
+    let a = actual
+        .and_then(Value::as_f64)
+        .unwrap_or_else(|| panic!("{:?} is not a number", actual));
+    let pass = if a == f64::INFINITY && expected == f64::INFINITY
+        || a == f64::NEG_INFINITY && expected == f64::NEG_INFINITY
+    {
+        true
+    } else {
+        (expected - a).abs() < 10f64.powi(-precision) / 2.0
+    };
+    assert!(pass, "{} is not close to {} (precision {})", a, expected, precision);
+}
