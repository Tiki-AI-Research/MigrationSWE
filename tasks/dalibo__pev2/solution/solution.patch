+
+/// `STRATEGY_MAP`: aggregate node name prefix to `Strategy`.
+pub const STRATEGY_MAP: &[(&str, &str)] = &[("Group", "Sorted"), ("Hash", "Hashed"), ("Mixed", "Mixed")];
+
+/// `REVERSE_STRATEGY_MAP`: `Strategy` to aggregate node name prefix.
+pub const REVERSE_STRATEGY_MAP: &[(&str, &str)] = &[("Sorted", "Group"), ("Hashed", "Hash"), ("Mixed", "Mixed")];
+
+/// Fields declared on the `Node` class. With `useDefineForClassFields` every
+/// declared field is an own property of a new instance, initialized to
+/// `undefined` unless the declaration has an initializer (so for example
+/// `_.has(node, "Actual Rows")` holds for any node of a text plan).
+const NODE_FIELDS: &[&str] = &[
+    "nodeId",
+    "size",
+    "Options",
+    "Timing",
+    "Settings",
+    p::ACTUAL_LOOPS,
+    p::ACTUAL_ROWS,
+    p::ACTUAL_ROWS_REVISED,
+    p::ACTUAL_STARTUP_TIME,
+    p::ACTUAL_STARTUP_TIME_REVISED,
+    p::ACTUAL_TOTAL_TIME,
+    p::ACTUAL_TOTAL_TIME_REVISED,
+    p::ASYNC_CAPABLE,
+    p::EXCLUSIVE_COST,
+    p::EXCLUSIVE_DURATION,
+    p::EXCLUSIVE_LOCAL_DIRTIED_BLOCKS,
+    p::EXCLUSIVE_LOCAL_HIT_BLOCKS,
+    p::EXCLUSIVE_LOCAL_READ_BLOCKS,
+    p::EXCLUSIVE_LOCAL_WRITTEN_BLOCKS,
+    p::EXCLUSIVE_SHARED_DIRTIED_BLOCKS,
+    p::EXCLUSIVE_SHARED_HIT_BLOCKS,
+    p::EXCLUSIVE_SHARED_READ_BLOCKS,
+    p::EXCLUSIVE_SHARED_WRITTEN_BLOCKS,
+    p::EXCLUSIVE_READ_BLOCKS,
+    p::EXCLUSIVE_WRITTEN_BLOCKS,
+    p::EXCLUSIVE_TEMP_READ_BLOCKS,
+    p::EXCLUSIVE_TEMP_WRITTEN_BLOCKS,
+    p::FILTER,
+    p::HASH_KEY,
+    p::GROUPING_SETS,
+    p::GROUP_KEY,
+    p::PLANNED_PARTITIONS,
+    p::PLANNER_ESTIMATE_DIRECTION,
+    p::PLANNER_ESTIMATE_FACTOR,
+    p::INDEX_NAME,
+    p::NODE_TYPE,
+    p::PARALLEL_AWARE,
+    p::PLANS,
+    p::PLAN_ROWS,
+    p::PLAN_ROWS_REVISED,
+    p::SUBPLAN_NAME,
+    p::TOTAL_COST,
+    p::WORKERS,
+    p::WORKERS_LAUNCHED,
+    p::WORKERS_PLANNED,
+    p::WORKERS_LAUNCHED_BY_GATHER,
+    p::WORKERS_PLANNED_BY_GATHER,
+    p::EXCLUSIVE_IO_READ_TIME,
+    p::EXCLUSIVE_IO_WRITE_TIME,
+    p::EXCLUSIVE_SHARED_IO_READ_TIME,
+    p::EXCLUSIVE_SHARED_IO_WRITE_TIME,
+    p::EXCLUSIVE_LOCAL_IO_READ_TIME,
+    p::EXCLUSIVE_LOCAL_IO_WRITE_TIME,
+    p::EXCLUSIVE_TEMP_IO_READ_TIME,
+    p::EXCLUSIVE_TEMP_IO_WRITE_TIME,
+    p::EXCLUSIVE_SUM_IO_READ_TIME,
+    p::EXCLUSIVE_SUM_IO_WRITE_TIME,
+    p::AVERAGE_IO_READ_SPEED,
+    p::AVERAGE_IO_WRITE_SPEED,
+    p::AVERAGE_SHARED_IO_READ_SPEED,
+    p::AVERAGE_SHARED_IO_WRITE_SPEED,
+    p::AVERAGE_LOCAL_IO_READ_SPEED,
+    p::AVERAGE_LOCAL_IO_WRITE_SPEED,
+    p::AVERAGE_TEMP_IO_READ_SPEED,
+    p::AVERAGE_TEMP_IO_WRITE_SPEED,
+    p::AVERAGE_SUM_IO_READ_SPEED,
+    p::AVERAGE_SUM_IO_WRITE_SPEED,
+    p::EXCLUSIVE_AVERAGE_SUM_IO_READ_SPEED,
+    p::EXCLUSIVE_AVERAGE_SUM_IO_WRITE_SPEED,
+    p::IO_READ_TIME,
+    p::IO_WRITE_TIME,
+    p::SHARED_IO_READ_TIME,
+    p::SHARED_IO_WRITE_TIME,
+    p::LOCAL_IO_READ_TIME,
+    p::LOCAL_IO_WRITE_TIME,
+    p::TEMP_IO_READ_TIME,
+    p::TEMP_IO_WRITE_TIME,
+    p::SUM_IO_READ_TIME,
+    p::SUM_IO_WRITE_TIME,
+    p::PARTIAL_MODE,
+    p::SCAN_DIRECTION,
+    p::DISABLED,
+];
+
+/// Members of `Object.prototype` that `name in STRATEGY_MAP` also finds.
+fn inherited_strategy(name: &str) -> Option<Val> {
+    match name {
+        // `Object.prototype` itself, which serializes as an empty object.
+        "__proto__" => Some(Val::Obj(Obj::new())),
+        // Methods: functions are dropped by `JSON.stringify`.
+        "constructor" | "hasOwnProperty" | "isPrototypeOf" | "propertyIsEnumerable" | "toLocaleString"
+        | "toString" | "valueOf" | "__defineGetter__" | "__defineSetter__" | "__lookupGetter__"
+        | "__lookupSetter__" => Some(Val::Undef),
+        _ => None,
+    }
+}
+
+struct Groups {
+    input: Vec<u16>,
+    caps: Vec<Option<(usize, usize)>>,
+}
+
+impl Groups {
+    fn get(&self, i: usize) -> Option<String> {
+        self.caps.get(i).copied().flatten().map(|(a, b)| from_utf16(&self.input[a..b]))
+    }
+
+    /// The group value if it participated and is a non-empty string.
+    fn truthy(&self, i: usize) -> Option<String> {
+        self.get(i).filter(|s| !s.is_empty())
+    }
+}
+
+fn exec(re: &crate::js::regex::Regex, s: &str) -> Option<Groups> {
+    let input = utf16(s);
+    re.exec_fresh(&input).map(|caps| Groups { input, caps })
+}
+
+/// `new Node(type)`.
+pub(crate) fn new_node(node_type: &str) -> Obj {
+    let node = Obj::with_fields(NODE_FIELDS);
+    node.set(p::ASYNC_CAPABLE, Val::Bool(false));
+    node.set(p::PARALLEL_AWARE, Val::Bool(false));
+    node.set(p::DISABLED, Val::Bool(false));
+    if node_type.is_empty() {
+        return node;
+    }
+    node.set(p::NODE_TYPE, Val::from(node_type));
+
+    // The TypeScript code runs every expression first; they have no side
+    // effects, so they are evaluated here in the order the results are used.
+    let scan_and_operations = || exec(
+        js_regex!(
+            r"^((?:Parallel\s+)?(?:Seq|Tid.*|Bitmap\s+Heap|WorkTable|(Async\s+)?Foreign)\s+Scan|Update|Insert|Delete|Merge)\son\s(\S+)(?:\s+(\S+))?$",
+            ""
+        ),
+        node_type,
+    );
+    let bitmap = || exec(js_regex!(r"^(Bitmap\s+Index\s+Scan)\son\s(\S+)$", ""), node_type);
+    let index = || exec(
+        js_regex!(
+            r"^((?:Parallel\s+)?Index(?:\sOnly)?\sScan)(\sBackward)?\susing\s(\S+)\son\s(\S+)(?:\s+(\S+))?$",
+            ""
+        ),
+        node_type,
+    );
+    let cte = || exec(js_regex!(r"^(CTE\sScan)\son\s(\S+)(?:\s+(\S+))?$", ""), node_type);
+    let function = || exec(js_regex!(r"^(Function\sScan)\son\s(\S+)(?:\s+(\S+))?$", ""), node_type);
+    let subquery = || exec(js_regex!(r"^(Subquery\sScan)\son\s(.+)$", ""), node_type);
+    let aggregate = || exec(
+        js_regex!(r"^(Partial|Finalize)*\s*(Group|Hash|Mixed|[A-z]*)*Aggregate$", ""),
+        node_type,
+    );
+
+    let opt = |v: Option<String>| v.map(Val::from).unwrap_or(Val::Undef);
+    if let Some(m) = scan_and_operations() {
+        node.set(p::NODE_TYPE, opt(m.get(1)));
+        let relation = opt(m.get(3));
+        node.set(p::RELATION_NAME, relation.clone());
+        node.set(p::ALIAS, m.truthy(4).map(Val::from).unwrap_or(relation));
+        if m.truthy(2).is_some() {
+            node.set(p::ASYNC_CAPABLE, Val::Bool(true));
+            let t = utf16(&m.get(1).unwrap_or_default());
+            let replaced = js_regex!(r"Async\s+", "").replace(&t, &[]);
+            node.set(p::NODE_TYPE, Val::from(from_utf16(&replaced)));
+        }
+    } else if let Some(m) = bitmap() {
+        node.set(p::NODE_TYPE, opt(m.get(1)));
+        node.set(p::INDEX_NAME, opt(m.get(2)));
+    } else if let Some(m) = index() {
+        node.set(p::NODE_TYPE, opt(m.get(1)));
+        node.set(p::INDEX_NAME, opt(m.get(3)));
+        node.set(
+            p::SCAN_DIRECTION,
+            Val::from(if m.truthy(2).is_some() { "Backward" } else { "Forward" }),
+        );
+        node.set(p::RELATION_NAME, opt(m.get(4)));
+        if let Some(alias) = m.truthy(5) {
+            node.set(p::ALIAS, Val::from(alias));
+        }
+    } else if let Some(m) = cte() {
+        node.set(p::NODE_TYPE, opt(m.get(1)));
+        node.set(p::CTE_NAME, opt(m.get(2)));
+        if let Some(alias) = m.truthy(3) {
+            node.set(p::ALIAS, Val::from(alias));
+        }
+    } else if let Some(m) = function() {
+        node.set(p::NODE_TYPE, opt(m.get(1)));
+        node.set(p::FUNCTION_NAME, opt(m.get(2)));
+        if let Some(alias) = m.truthy(3) {
+            node.set(p::ALIAS, Val::from(alias));
+        }
+    } else if let Some(m) = subquery() {
+        node.set(p::NODE_TYPE, opt(m.get(1)));
+        node.set(p::ALIAS, opt(m.get(2)));
+    } else if let Some(m) = aggregate() {
+        node.set(p::NODE_TYPE, Val::from("Aggregate"));
+        node.set(
+            p::PARTIAL_MODE,
+            Val::from(m.truthy(1).unwrap_or_else(|| "Simple".to_string())),
+        );
+        let raw_strategy = m.get(2);
+        let strategy = match &raw_strategy {
+            None => Val::from("Plain"),
+            Some(raw) => match STRATEGY_MAP.iter().find(|(k, _)| k == raw) {
+                Some((_, v)) => Val::from(*v),
+                None => inherited_strategy(raw).unwrap_or_else(|| Val::from(raw.as_str())),
+            },
+        };
+        if matches!(raw_strategy.as_deref(), Some("Hash") | Some("Mixed")) {
+            let planned = node.get(p::PLANNED_PARTITIONS).unwrap_or(Val::Undef);
+            node.set(
+                p::PLANNED_PARTITIONS,
+                if planned.truthy() { planned } else { Val::Num(0.0) },
+            );
+        }
+        node.set(p::STRATEGY, strategy);
+    }
+
+    let current_type = |node: &Obj| node.get(p::NODE_TYPE).unwrap_or(Val::Undef).to_js_string();
+    if let Some(m) = exec(js_regex!(r"^(Parallel\s+)(.*)", ""), &current_type(&node)) {
+        node.set(p::NODE_TYPE, opt(m.get(2)));
+        node.set(p::PARALLEL_AWARE, Val::Bool(true));
+    }
+    if let Some(m) = exec(js_regex!(r"^(Async\s+)(.*)", ""), &current_type(&node)) {
+        node.set(p::NODE_TYPE, opt(m.get(2)));
+        node.set(p::ASYNC_CAPABLE, Val::Bool(true));
+    }
+    if let Some(m) = exec(
+        js_regex!(
+            r"^(Nested Loop|Hash|Merge)(?:\s+(Right Semi|Right Anti|Left|Right|Full|Semi|Anti))?\s+Join$",
+            ""
+        ),
+        &current_type(&node),
+    ) {
+        let base = m.get(1).unwrap_or_default();
+        node.set(
+            p::JOIN_TYPE,
+            Val::from(m.truthy(2).unwrap_or_else(|| "Inner".to_string())),
+        );
+        let suffix = if base == "Nested Loop" { "" } else { " Join" };
+        node.set(p::NODE_TYPE, Val::from(format!("{}{}", base, suffix)));
+    }
+    node
+}
