+//! Specs of `src/services/__tests__`: `20-insert-modifytable.spec.ts`,
+//! `22-triggers.spec.ts`, `23-serialization-and-planning.spec.ts`,
+//! `25-cleanup-source-backtracking.spec.ts`, `25-enable-parameter.spec.ts`,
+//! `26-planned-partitions.spec.ts` and `cte-exclusive-time.spec.ts`.
+//!
+//! The plan sources are copied verbatim from the TypeScript template
+//! literals (which contain no escape sequences), including their leading and
+//! trailing whitespace.
+
+mod common;
+
+/// Runs `check` for every name, reporting all failures at once.
+fn for_each_fixture(names: &[String], check: impl Fn(&str)) {
+    let failures: Vec<String> = names
+        .iter()
+        .filter_map(|name| {
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| check(name)))
+                .err()
+                .map(|e| {
+                    let msg = e
+                        .downcast_ref::<String>()
+                        .cloned()
+                        .or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string()))
+                        .unwrap_or_default();
+                    format!("{}: {}", name, msg)
+                })
+        })
+        .collect();
+    assert!(failures.is_empty(), "{} fixture(s) failed:\n{}", failures.len(), failures.join("\n"));
+}
+
+/// `plan.content["Triggers"]?.length`.
+fn triggers_length(plan: &serde_json::Value) -> Option<usize> {
+    plan["content"].get("Triggers").and_then(|t| t.as_array()).map(|t| t.len())
+}
