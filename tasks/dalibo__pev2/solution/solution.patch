+/// `cte-exclusive-time.spec.ts`
+mod cte_exclusive_time {
+    use crate::common::{fixture_files, read_fixture};
+    use crate::for_each_fixture;
+    use pev2_core::enums::property;
+    use serde_json::Value;
+
+    /// `_.sumBy(nodes, (node) => node[EXCLUSIVE_DURATION] + childrenSum)`:
+    /// `0` for an empty list, otherwise the first value plus the following
+    /// ones, in order. A missing (`undefined`) or `NaN` (`null`) exclusive
+    /// duration makes the sum `NaN`, as in JavaScript.
+    fn sum_exclusive_duration(nodes: &[Value]) -> f64 {
+        let mut result: Option<f64> = None;
+        for node in nodes {
+            let base_value = node
+                .get(property::EXCLUSIVE_DURATION)
+                .and_then(Value::as_f64)
+                .unwrap_or(f64::NAN);
+            let children_sum = match node.get(property::PLANS) {
+                Some(Value::Array(plans)) => sum_exclusive_duration(plans),
+                _ => 0.0,
+            };
+            let current = base_value + children_sum;
+            result = Some(match result {
+                None => current,
+                Some(r) => r + current,
+            });
+        }
+        result.unwrap_or(0.0)
+    }
+
+    // TS: describe("From text: Plan " + planTest) / test("Sum of exclusive
+    // times is correct"), for every file of `cte-exclusive-time`
+    #[test]
+    fn sum_of_exclusive_times_is_correct() {
+        let files = fixture_files("cte-exclusive-time");
+        // file.replace(/\..*/, ""), then _.uniq
+        let mut tests: Vec<String> = Vec::new();
+        for file in &files {
+            let stem = match file.find('.') {
+                Some(i) => file[..i].to_string(),
+                None => file.clone(),
+            };
+            if !tests.contains(&stem) {
+                tests.push(stem);
+            }
+        }
+        assert!(!tests.is_empty());
+        for_each_fixture(&tests, |plan_test| {
+            let plan_text = read_fixture(&format!("cte-exclusive-time/{}.plan", plan_test));
+            let r = pev2_core::from_source(&plan_text).expect("source parses");
+            let plan = Value::Object(pev2_core::create_plan("", r, "").expect("plan is created"));
+
+            // Excpect the sum of exclusives to be approvimatively equal to the
+            // duration of the root node
+            let root = &plan["content"]["Plan"];
+            // (plan.content.Plan[ACTUAL_TOTAL_TIME] || 0)
+            let total = root
+                .get(property::ACTUAL_TOTAL_TIME)
+                .and_then(Value::as_f64)
+                .filter(|t| *t != 0.0 && !t.is_nan())
+                .unwrap_or(0.0);
+            let min = total * 0.99;
+            let max = total * 1.01;
+            // [plan.content.Plan].concat(plan.ctes)
+            let mut nodes = vec![root.clone()];
+            nodes.extend(plan["ctes"].as_array().cloned().unwrap_or_default());
+            let sum = sum_exclusive_duration(&nodes);
+            assert!(sum > min, "expected {} to be greater than {}", sum, min);
+            let sum = sum_exclusive_duration(&nodes);
+            assert!(sum < max, "expected {} to be less than {}", sum, max);
+        });
+    }
+}
