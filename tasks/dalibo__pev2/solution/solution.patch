+/// `EstimateDirection`; the numeric values are stored in
+/// `*Planner Row Estimate Direction`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum EstimateDirection {
+    Over = 1,
+    Under = 2,
+    None = 3,
+}
