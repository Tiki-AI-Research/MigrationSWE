+/// `19-io-timings.spec.ts`
+mod spec_19_io_timings {
+    use serde_json::Value;
+
+    #[test]
+    fn computes_io_timings_and_speed_correctly() {
+        let source = r#"
+     Update on a  (cost=0.00..266690.72 rows=0 width=0) (actual time=10.00..11.00 rows=0 loops=1)
+         Buffers: shared hit=2 read=4 dirtied=6 written=8
+         I/O Timings: read=2 write=4
+         ->  Seq Scan on a  (cost=0.00..0.00 rows=10 width=1) (actual time=9.00..10.00 rows=10000000 loops=1)
+               Buffers: shared hit=1 read=2 written=4
+               I/O Timings: read=1 write=2
+    "#;
+        let r = pev2_core::from_source(source).unwrap();
+        let plan = Value::Object(pev2_core::create_plan("", r, "").unwrap());
+        let root = &plan["content"]["Plan"];
+        assert_eq!(root["*I/O Read Time (exclusive)"].as_f64(), Some(1.0));
+        assert_eq!(root["*I/O Read Speed (exclusive)"].as_f64(), Some(2000.0)); // 16 Mo/s
+
+        assert_eq!(root["*I/O Write Time (exclusive)"].as_f64(), Some(2.0));
+        assert_eq!(root["*I/O Write Speed (exclusive)"].as_f64(), Some(2000.0)); // 16 Mo/s
+    }
+}
