@@ -0,0 +1,647 @@
+//! Core plan service specs: `plan-service.spec.ts`,
+//! `02-actual-duration-loops.spec.ts`, `03-actual-duration-cte.spec.ts`,
+//! `04-actual-duration-parallel-from-text.spec.ts`,
+//! `04-actual-duration-parallel.spec.ts`, `07-no-analyze.spec.ts`,
+//! `07-bis-no-analyze-workers.spec.ts`, `08-plan-without-cost.spec.ts`,
+//! `17-cost-0.00.spec.ts` and `18-fractional-rows.spec.ts`.
+
+mod common;
+
+use serde_json::Value;
+
+/// `expect(actual).toBe(expected)` / `toEqual(expected)` for numbers, which
+/// both compare with `Object.is`.
+#[track_caller]
+fn assert_is(actual: f64, expected: f64) {
+    let same = (actual == expected && actual.is_sign_negative() == expected.is_sign_negative())
+        || (actual.is_nan() && expected.is_nan());
+    assert!(same, "expected {:?} to be {:?}", actual, expected);
+}
+
+/// The number of an optional value, as read by `toBe`/`toEqual` on a number.
+#[track_caller]
+fn num_of(v: Option<&Value>) -> f64 {
+    v.and_then(Value::as_f64)
+        .unwrap_or_else(|| panic!("not a number: {:?}", v))
+}
+
+/// JavaScript truthiness of a possibly `undefined` value.
+fn is_truthy(v: Option<&Value>) -> bool {
+    match v {
+        None | Some(Value::Null) => false,
+        Some(Value::Bool(b)) => *b,
+        Some(Value::Number(n)) => n.as_f64().is_some_and(|f| f != 0.0 && !f.is_nan()),
+        Some(Value::String(s)) => !s.is_empty(),
+        Some(Value::Array(_)) | Some(Value::Object(_)) => true,
+    }
+}
+
+/// `planService.fromSource(source)`.
+#[track_caller]
+fn from_source(source: &str) -> pev2_core::PlanContent {
+    pev2_core::from_source(source).unwrap_or_else(|e| panic!("fromSource threw: {}", e))
+}
+
+/// `planService.createPlan(name, content, query)`.
+#[track_caller]
+fn create_plan(name: &str, content: pev2_core::PlanContent, query: &str) -> pev2_core::Plan {
+    pev2_core::create_plan(name, content, query).unwrap_or_else(|e| panic!("createPlan threw: {}", e))
+}
+
+/// `plan-service.spec.ts`
+mod plan_service {
+    use super::{assert_is, create_plan, from_source, num_of};
+    use crate::common::num;
+    use serde_json::Value;
+
+    #[test]
+    fn can_parse_plan_in_json_format() {
+        let source = r#"
+[
+  {
+    "Plan": {
+      "Node Type": "Seq Scan",
+      "Parallel Aware": false,
+      "Relation Name": "users",
+      "Alias": "users",
+      "Startup Cost": 0.00,
+      "Total Cost": 22.70,
+      "Plan Rows": 1270,
+      "Plan Width": 36
+    }
+  }
+]"#;
+        let r = Value::Object(from_source(source));
+        assert_is(num(&r, "/Plan/Plan Rows"), 1270.0);
+    }
+
+    #[test]
+    fn can_parse_plan_in_json_format_2() {
+        let source = r#"
+{
+  "Plan": {
+    "Node Type": "Seq Scan",
+    "Parallel Aware": false,
+    "Relation Name": "users",
+    "Alias": "users",
+    "Startup Cost": 0.00,
+    "Total Cost": 22.70,
+    "Plan Rows": 1270,
+    "Plan Width": 36
+  }
+}"#;
+        let r = Value::Object(from_source(source));
+        assert_is(num(&r, "/Plan/Plan Rows"), 1270.0);
+    }
+
+    #[test]
+    fn can_parse_plan_in_json_format_with_extra_text() {
+        let source = r#"
+           QUERY PLAN
+---------------------------------
+ [                              +
+   {                            +
+     "Plan": {                  +
+       "Node Type": "Seq Scan", +
+       "Parallel Aware": false, +
+       "Relation Name": "users",+
+       "Alias": "users",        +
+       "Startup Cost": 0.00,    +
+       "Total Cost": 22.70,     +
+       "Plan Rows": 1270,       +
+       "Plan Width": 36         +
+     }                          +
+   }                            +
+ ]
+(1 row)"#;
+        from_source(source);
+    }
+
+    #[test]
+    fn can_parse_plan_with_extra_text() {
+        let source = r#"
+                  QUERY PLAN
+-----------------------------------------------------------
+ Seq Scan on tenk1  (cost=0.00..333.00 rows=10000 width=148)
+(1 row)"#;
+        let r = Value::Object(from_source(source));
+        assert_is(num(&r, "/Plan/Plan Rows"), 10000.0);
+    }
+
+    #[test]
+    fn creates_plan_from_text() {
+        let source = r#"
+Nested Loop Left Join  (cost=11.95..28.52 rows=5 width=157) (actual time=0.010..0.010 rows=0 loops=1)
+  Output: rel_users_exams.user_username, rel_users_exams.exam_id, rel_users_exams.started_at, rel_users_exams.finished_at, exam_1.id, exam_1.title, exam_1.date_from, exam_1.date_to, exam_1.created, exam_1.created_by_, exam_1.duration, exam_1.success_threshold, exam_1.published
+  Inner Unique: true
+  Join Filter: (exam_1.id = rel_users_exams.exam_id)
+  Buffers: shared hit=1
+  ->  Bitmap Heap Scan on public.rel_users_exams  (cost=11.80..20.27 rows=5 width=52) (actual time=0.009..0.009 rows=0 loops=1)
+        Output: rel_users_exams.user_username, rel_users_exams.exam_id, rel_users_exams.started_at, rel_users_exams.finished_at
+        Recheck Cond: (1 = rel_users_exams.exam_id)
+        Buffers: shared hit=1
+        ->  Bitmap Index Scan on rel_users_exams_pkey  (cost=0.00..11.80 rows=5 width=0) (actual time=0.005..0.005 rows=0 loops=1)
+              Index Cond: (1 = rel_users_exams.exam_id)
+              Buffers: shared hit=1
+  ->  Materialize  (cost=0.15..8.17 rows=1 width=105) (never executed)
+        Output: exam_1.id, exam_1.title, exam_1.date_from, exam_1.date_to, exam_1.created, exam_1.created_by_, exam_1.duration, exam_1.success_threshold, exam_1.published
+        ->  Index Scan using exam_pkey on public.exam exam_1  (cost=0.15..8.17 rows=1 width=105) (never executed)
+              Output: exam_1.id, exam_1.title, exam_1.date_from, exam_1.date_to, exam_1.created, exam_1.created_by_, exam_1.duration, exam_1.success_threshold, exam_1.published
+              Index Cond: (exam_1.id = 1)
+Planning Time: 1.110 ms
+Execution Time: 0.170 ms"#;
+        let r = Value::Object(from_source(source));
+        assert_is(num(&r, "/Plan/Plan Rows"), 5.0);
+        assert_is(num(&r, "/Execution Time"), 0.17);
+    }
+
+    /// Second `test("creates plan from text", ...)` of the spec.
+    #[test]
