+def run_probe(repo, binary=None):
+    probe = TargetProbe(repo, binary=binary)
+    results = {}
+    try:
+        try:
+            probe.build()
+            capability_error = None
+        except ProbeFailure as exc:
+            capability_error = str(exc)
