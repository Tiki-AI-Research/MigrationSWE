diff --git a/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe.py b/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe.py
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Source probe for BATCH-DIFFERENTIAL-0001.
+
+Builds the Rust reference implementation and executes the shared differential
+corpus against it.  The probe is run in the private authoring container only;
+it is not part of the public target assets.
+"""
+
+import argparse
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ASSET_ROOT = Path(__file__).resolve().parents[3]
+SHARED_CORPUS = (
+    ASSET_ROOT / "shared" / "batches" / "BATCH-DIFFERENTIAL-0001" / "corpus.py"
+)
+EXPECTED = (
+    ASSET_ROOT
+    / "fixtures"
+    / "batches"
+    / "BATCH-DIFFERENTIAL-0001"
+    / "expected-results.json"
+)
+
+
+def build(repo, target_dir):
+    cargo = shutil.which("cargo")
+    if cargo is None:
+        cargo = str(Path(os.environ.get("CARGO_HOME", Path.home() / ".cargo")) / "bin" / "cargo")
+    if not Path(cargo).is_file():
+        raise SystemExit("cargo is required to build the Rust source reference")
+    env = dict(os.environ)
+    env["CARGO_TARGET_DIR"] = str(target_dir)
+    command = [cargo, "build", "--release"]
+    completed = subprocess.run(command, cwd=str(repo), env=env)
+    if completed.returncode != 0:
+        raise SystemExit("cargo build failed with exit code %d" % completed.returncode)
+    return target_dir / "release" / "rubyfmt-main"
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--repo", default="/input/source")
+    parser.add_argument("--output")
+    parser.add_argument("--expected", default=str(EXPECTED))
+    parser.add_argument("--no-build", action="store_true")
+    parser.add_argument("--binary")
+    args = parser.parse_args(argv)
+
+    repo = Path(args.repo)
+    workdir = Path(tempfile.mkdtemp(prefix="rubyfmt-source-probe-"))
+    binary = Path(args.binary) if args.binary else None
+    if binary is None:
+        binary = workdir / "rubyfmt-main"
+        if not args.no_build:
+            binary = build(repo, workdir / "cargo-target")
+
+    output = args.output or str(workdir / "source-results.json")
+    command = [
+        sys.executable,
+        str(SHARED_CORPUS),
+        "--binary",
+        str(binary),
+        "--repo",
+        str(repo),
+        "--output",
+        output,
+        "--expected",
+        args.expected,
+    ]
+    return subprocess.run(command).returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
