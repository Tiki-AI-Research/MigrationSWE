+	case "RestParameterNode":
+		formatRestParameterNode(ps, node)
+	case "RetryNode":
+		ps.emitKeyword([]byte("retry"))
+	case "ReturnNode":
+		formatReturnNode(ps, node)
+	case "SelfNode":
+		ps.emitIdent([]byte("self"))
+	case "ShareableConstantNode":
+		formatNode(ps, node.Get("write"))
+	case "SingletonClassNode":
+		formatSingletonClassNode(ps, node)
+	case "SourceEncodingNode":
+		handleStringAtOffset(ps, []byte("__ENCODING__"), node.Start())
+	case "SourceFileNode":
+		handleStringAtOffset(ps, []byte("__FILE__"), node.Start())
+	case "SourceLineNode":
+		handleStringAtOffset(ps, []byte("__LINE__"), node.Start())
+	case "SplatNode":
+		formatSplatNode(ps, node)
+	case "StatementsNode":
+		formatStatements(ps, node)
+	case "StringNode":
+		formatStringNode(ps, node)
+	case "SuperNode":
