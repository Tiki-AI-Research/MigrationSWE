diff --git a/internal/cli/cli_test.go b/internal/cli/cli_test.go
new file mode 100644
index 0000000..25e56a2
--- /dev/null
+++ b/internal/cli/cli_test.go
@@ -0,0 +1,770 @@
+package cli
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+var (
+	buildOnce  sync.Once
+	binaryPath string
+	buildErr   error
+	moduleRoot string
+)
+
+func TestMain(m *testing.M) {
+	code := m.Run()
+	if binaryPath != "" {
+		_ = os.RemoveAll(filepath.Dir(binaryPath))
+	}
+	os.Exit(code)
+}
+
+func repoRootDir(t *testing.T) string {
+	t.Helper()
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("could not locate test source")
+	}
+	dir := filepath.Dir(file)
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatal("could not locate repository root")
+		}
+		dir = parent
+	}
+}
+
+func builtBinary(t *testing.T) string {
+	t.Helper()
+	buildOnce.Do(func() {
+		moduleRoot = repoRootDir(t)
+		dir, err := os.MkdirTemp("", "rubyfmt-cli-test-*")
+		if err != nil {
+			buildErr = err
+			return
+		}
+		binaryPath = filepath.Join(dir, "rubyfmt")
+		goTool := filepath.Join(runtime.GOROOT(), "bin", "go")
+		if _, err := os.Stat(goTool); err != nil {
+			goTool = "go"
+		}
+		command := exec.Command(goTool, "build", "-mod=vendor", "-buildvcs=false", "-o", binaryPath, "./cmd/rubyfmt")
+		command.Dir = moduleRoot
+		output, err := command.CombinedOutput()
+		if err != nil {
+			buildErr = &buildError{err: err, output: string(output)}
+		}
+	})
+	if buildErr != nil {
+		t.Fatal(buildErr)
+	}
+	return binaryPath
+}
+
+type buildError struct {
+	err    error
+	output string
+}
+
+func (e *buildError) Error() string {
+	return e.err.Error() + "\n" + e.output
+}
+
+type runResult struct {
+	stdout string
+	stderr string
+	code   int
+}
+
+func runRubyfmt(t *testing.T, dir string, stdin string, args ...string) runResult {
+	t.Helper()
+	command := exec.Command(builtBinary(t), args...)
+	command.Dir = dir
+	if stdin != "" {
+		command.Stdin = strings.NewReader(stdin)
+	}
+	var stdout, stderr bytes.Buffer
+	command.Stdout = &stdout
+	command.Stderr = &stderr
+	err := command.Run()
+	code := 0
+	if err != nil {
+		if exitErr, ok := err.(*exec.ExitError); ok {
+			code = exitErr.ExitCode()
+		} else {
+			t.Fatal(err)
+		}
+	}
+	return runResult{stdout: stdout.String(), stderr: stderr.String(), code: code}
+}
+
+func writeFile(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(content), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestStdinStdout(t *testing.T) {
+	result := runRubyfmt(t, t.TempDir(), "a 1,2,3")
+	if result.code != 0 || result.stdout != "a(1, 2, 3)\n" {
+		t.Fatalf("unexpected result: %+v", result)
+	}
+}
+
+func TestFileStdout(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "test.rb")
+	writeFile(t, path, "a 1,2,3\n")
+	result := runRubyfmt(t, dir, "", path)
+	if result.code != 0 || result.stdout != "a(1, 2, 3)\n" {
+		t.Fatalf("unexpected result: %+v", result)
+	}
+}
+
+func TestHeaderOptInOut(t *testing.T) {
+	dir := t.TempDir()
+	result := runRubyfmt(t, dir, "a 1,2,3", "--header-opt-in")
+	if result.code != 0 || result.stdout != "a 1,2,3" {
+		t.Fatalf("opt-in passthrough failed: %+v", result)
+	}
+	result = runRubyfmt(t, dir, "# rubyfmt:false\na 1,2,3", "--header-opt-out")
+	if result.code != 0 || result.stdout != "# rubyfmt:false\na 1,2,3" {
+		t.Fatalf("opt-out passthrough failed: %+v", result)
+	}
+	result = runRubyfmt(t, dir, "# rubyfmt: true\na 1,2,3\n", "--header-opt-in")
+	if result.code != 0 || result.stdout != "# rubyfmt: true\na(1, 2, 3)\n" {
+		t.Fatalf("opt-in format failed: %+v", result)
+	}
+}
+
+func TestInPlaceOnlyWritesChanged(t *testing.T) {
+	dir := t.TempDir()
+	unchanged := filepath.Join(dir, "unchanged.rb")
+	changed := filepath.Join(dir, "changed.rb")
+	writeFile(t, unchanged, "a(1, 2, 3)\n")
+	writeFile(t, changed, "a 1,2,3\n")
+	beforeUnchanged, err := os.Stat(unchanged)
+	if err != nil {
+		t.Fatal(err)
+	}
+	beforeChanged, err := os.Stat(changed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(20 * time.Millisecond)
+	result := runRubyfmt(t, dir, "", "-i", unchanged, changed)
+	if result.code != 0 || result.stdout != "" {
+		t.Fatalf("unexpected result: %+v", result)
+	}
+	afterUnchanged, _ := os.Stat(unchanged)
+	afterChanged, _ := os.Stat(changed)
+	unchangedContent, _ := os.ReadFile(unchanged)
+	changedContent, _ := os.ReadFile(changed)
+	if string(unchangedContent) != "a(1, 2, 3)\n" || string(changedContent) != "a(1, 2, 3)\n" {
+		t.Fatalf("unexpected file contents: %q %q", unchangedContent, changedContent)
+	}
+	if !afterUnchanged.ModTime().Equal(beforeUnchanged.ModTime()) {
+		t.Fatal("unchanged file mtime changed")
+	}
+	if afterChanged.ModTime().Equal(beforeChanged.ModTime()) {
+		t.Fatal("changed file mtime did not change")
+	}
+}
