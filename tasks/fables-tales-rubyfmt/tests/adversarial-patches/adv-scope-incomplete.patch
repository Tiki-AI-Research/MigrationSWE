+	result = runRubyfmt(t, dir, "", "-i", dir)
+	if result.code != 0 || result.stdout != "" {
+		t.Fatalf("directory: %+v", result)
+	}
+	oneContent, _ := os.ReadFile(one)
+	twoContent, _ := os.ReadFile(two)
+	if string(oneContent) != "a(1, 2, 3)\n" || string(twoContent) != "a(4, 5, 6)\n" {
+		t.Fatalf("unexpected contents: %q %q", oneContent, twoContent)
+	}
+}
+
+func TestStdinFilepathRubyfmtignoreDirectoryPattern(t *testing.T) {
+	dir := t.TempDir()
+	writeFile(t, filepath.Join(dir, ".rubyfmtignore"), "ignored/\n")
+	result := runRubyfmt(t, dir, "a 1,2,3", "--stdin-filepath", "ignored/foo.rb")
+	if result.code != 0 || result.stdout != "a 1,2,3" {
+		t.Fatalf("unexpected result: %+v", result)
+	}
+	result = runRubyfmt(t, dir, "a 1,2,3", "--stdin-filepath", "not_ignored/foo.rb")
+	if result.code != 0 || result.stdout != "a(1, 2, 3)\n" {
+		t.Fatalf("unexpected result: %+v", result)
+	}
+}
+
+func TestIgnoreSubdirectoryArgument(t *testing.T) {
+	for _, ignoreName := range []string{".gitignore", ".rubyfmtignore"} {
+		dir := t.TempDir()
+		if ignoreName == ".gitignore" {
+			if err := os.Mkdir(filepath.Join(dir, ".git"), 0755); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := os.MkdirAll(filepath.Join(dir, "a", "b"), 0755); err != nil {
+			t.Fatal(err)
+		}
+		one := filepath.Join(dir, "a", "test.rb")
+		two := filepath.Join(dir, "a", "b", "test.rb")
+		writeFile(t, one, "a 1, 2, 3\n")
+		writeFile(t, two, "a 4, 5, 6\n")
+		writeFile(t, filepath.Join(dir, ignoreName), "/a/b/\n")
+		result := runRubyfmt(t, dir, "", "-i", "a")
+		if result.code != 0 || result.stdout != "" {
+			t.Fatalf("%s unexpected result: %+v", ignoreName, result)
+		}
+		oneContent, _ := os.ReadFile(one)
+		twoContent, _ := os.ReadFile(two)
+		if string(oneContent) != "a(1, 2, 3)\n" || string(twoContent) != "a 4, 5, 6\n" {
+			t.Fatalf("%s unexpected contents: %q %q", ignoreName, oneContent, twoContent)
+		}
+	}
+}
+
+func TestRespectsAncestorIgnoreFromSubdirectory(t *testing.T) {
+	for _, ignoreName := range []string{".gitignore", ".rubyfmtignore"} {
+		dir := t.TempDir()
+		if err := os.Mkdir(filepath.Join(dir, ".git"), 0755); err != nil {
+			t.Fatal(err)
+		}
+		sub := filepath.Join(dir, "app")
+		if err := os.MkdirAll(sub, 0755); err != nil {
+			t.Fatal(err)
+		}
+		ignored := filepath.Join(sub, "ignored.rb")
+		kept := filepath.Join(sub, "kept.rb")
+		writeFile(t, ignored, "a 4, 5, 6\n")
+		writeFile(t, kept, "a 1, 2, 3\n")
+		writeFile(t, filepath.Join(dir, ignoreName), "ignored.rb\n")
+
+		result := runRubyfmt(t, sub, "", "-i", ".")
+		if result.code != 0 || result.stdout != "" {
+			t.Fatalf("%s unexpected result: %+v", ignoreName, result)
+		}
+		ignoredContent, _ := os.ReadFile(ignored)
+		keptContent, _ := os.ReadFile(kept)
+		if string(ignoredContent) != "a 4, 5, 6\n" {
+			t.Fatalf("%s ancestor ignore not applied: %q", ignoreName, ignoredContent)
+		}
+		if string(keptContent) != "a(1, 2, 3)\n" {
+			t.Fatalf("%s non-ignored file not formatted: %q", ignoreName, keptContent)
+		}
+	}
+}
+
+func TestIgnoredDirectoryIsNotTraversed(t *testing.T) {
+	dir := t.TempDir()
+	ignoredDir := filepath.Join(dir, "ignored")
+	if err := os.MkdirAll(ignoredDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	nested := filepath.Join(ignoredDir, "nested.rb")
+	writeFile(t, nested, "a 4, 5, 6\n")
+	writeFile(t, filepath.Join(dir, ".rubyfmtignore"), "ignored/\n")
+	writeFile(t, filepath.Join(ignoredDir, ".rubyfmtignore"), "!nested.rb\n")
+
+	result := runRubyfmt(t, dir, "", "-i", ".")
+	if result.code != 0 || result.stdout != "" {
+		t.Fatalf("unexpected result: %+v", result)
+	}
+	content, _ := os.ReadFile(nested)
+	if string(content) != "a 4, 5, 6\n" {
+		t.Fatalf("ignored directory was traversed: %q", content)
+	}
+}
