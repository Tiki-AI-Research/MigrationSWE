-pub static RSPEC_METHODS: [&[u8]; 2] = [b"it", b"describe"];
-
-pub static GEMFILE_METHODS: [&[u8]; 4] = [b"gem", b"source", b"ruby", b"group"];
-
-pub static OPTIONALLY_PARENTHESIZED_METHODS: [&[u8]; 3] =
-    [b"super", b"require", b"require_relative"];
