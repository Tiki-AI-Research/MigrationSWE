+                                if (quote == PM_HEREDOC_QUOTE_NONE) {
+                                    parser->current.end += width;
+
+                                    while ((width = char_is_identifier(parser, parser->current.end, parser->end - parser->current.end))) {
+                                        parser->current.end += width;
+                                    }
