-                ps.emit_comma();
-            } else {
-                if has_lefts {
-                    ps.emit_comma_space();
-                }
-                format_node(ps, rest);
-            }
-        }
-
-        if has_rights {
-            if has_lefts || has_rest {
-                ps.emit_comma_space();
-            }
-            let rights_offset = rights.last().unwrap().location().end_offset();
-            format_list_like_thing(ps, rights, rights_offset, true);
-        }
-    });
