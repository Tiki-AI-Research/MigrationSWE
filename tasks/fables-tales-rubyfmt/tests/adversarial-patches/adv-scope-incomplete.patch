@@ -0,0 +1,32 @@
+package cli
+
+import (
+	"bytes"
+	"strings"
+
+	"github.com/pmezard/go-difflib/difflib"
+)
+
+func splitLines(value string) []string {
+	if value == "" {
+		return nil
+	}
+	lines := strings.SplitAfter(value, "\n")
+	if len(lines) > 0 && lines[len(lines)-1] == "" {
+		lines = lines[:len(lines)-1]
+	}
+	return lines
+}
+
+func UnifiedDiff(path string, before, after []byte) []byte {
+	diff := difflib.UnifiedDiff{
+		A:        splitLines(string(before)),
+		B:        splitLines(string(after)),
+		FromFile: path,
+		ToFile:   path,
+		Context:  3,
+	}
+	var buffer bytes.Buffer
+	_ = difflib.WriteUnifiedDiff(&buffer, diff)
+	return buffer.Bytes()
+}
diff --git a/internal/cli/ignore.go b/internal/cli/ignore.go
new file mode 100644
index 0000000..73b7b24
--- /dev/null
+++ b/internal/cli/ignore.go
@@ -0,0 +1,281 @@
+package cli
+
+import (
+	"bufio"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+type ignorePattern struct {
+	base     string
+	pattern  string
+	negated  bool
+	dirOnly  bool
+	hasSlash bool
+	re       *regexp.Regexp
+}
+
+type IgnoreMatcher struct {
+	patterns          []ignorePattern
+	loaded            map[string]bool
+	includeGitignored bool
+	cwd               string
+}
+
+func NewIgnoreMatcher() *IgnoreMatcher {
+	return &IgnoreMatcher{loaded: map[string]bool{}}
+}
+
+// LoadIgnoreMatcher loads ignore files from the working directory and every
+// ancestor up to the repository root. Deeper files are loaded later so their
+// patterns take precedence over ancestor patterns.
+func LoadIgnoreMatcher(cwd string, includeGitignored bool) *IgnoreMatcher {
+	m := NewIgnoreMatcher()
+	m.includeGitignored = includeGitignored
+	absCwd, err := filepath.Abs(cwd)
+	if err != nil {
+		absCwd = cwd
+	}
+	m.cwd = absCwd
+	for _, dir := range ancestorDirectories(absCwd) {
+		m.loadDirectory(dir)
+	}
+	return m
+}
+
+func ancestorDirectories(cwd string) []string {
+	var chain []string
+	current := cwd
+	for {
+		chain = append(chain, current)
+		parent := filepath.Dir(current)
+		if parent == current {
+			break
+		}
+		current = parent
+	}
+
+	gitIndex := -1
+	for i := 0; i < len(chain); i++ {
+		if _, err := os.Stat(filepath.Join(chain[i], ".git")); err == nil {
+			gitIndex = i
+			break
+		}
+	}
+	if gitIndex < 0 {
+		return []string{chain[0]}
+	}
+
+	dirs := make([]string, 0, gitIndex+1)
+	for i := gitIndex; i >= 0; i-- {
+		dirs = append(dirs, chain[i])
+	}
+	return dirs
+}
+
+func (m *IgnoreMatcher) AddDirectory(cwd, dir string) {
+	m.loadDirectory(dir)
+}
+
+func (m *IgnoreMatcher) loadDirectory(dir string) {
+	absDir, err := filepath.Abs(dir)
+	if err != nil {
+		absDir = dir
+	}
+	m.loadFile(absDir, ".rubyfmtignore")
+	if !m.includeGitignored {
+		m.loadFile(absDir, ".gitignore")
+	}
+}
+
+func (m *IgnoreMatcher) loadFile(dir, name string) {
+	path := filepath.Join(dir, name)
+	if m.loaded[path] {
+		return
+	}
+	m.loaded[path] = true
+	file, err := os.Open(path)
+	if err != nil {
+		return
+	}
+	defer file.Close()
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		line := strings.TrimSuffix(scanner.Text(), "\r")
+		m.addLine(dir, line)
+	}
+}
+
+func (m *IgnoreMatcher) addLine(base, line string) {
+	if line == "" {
+		return
+	}
+	if strings.HasPrefix(line, "#") {
+		return
+	}
+	if strings.HasPrefix(line, "\\#") {
+		line = line[1:]
+	}
+	negated := false
+	if strings.HasPrefix(line, "!") {
+		negated = true
+		line = line[1:]
+	}
+	if line == "" {
+		return
+	}
+	line = strings.TrimSuffix(line, " ")
+	anchored := strings.HasPrefix(line, "/")
+	if anchored {
+		line = strings.TrimPrefix(line, "/")
+	}
+	dirOnly := strings.HasSuffix(line, "/")
+	if dirOnly {
+		line = strings.TrimSuffix(line, "/")
+	}
+	hasSlash := strings.Contains(line, "/") || anchored
+	if line == "" {
+		return
+	}
+	pattern := ignorePattern{
+		base:     base,
+		pattern:  line,
+		negated:  negated,
+		dirOnly:  dirOnly,
+		hasSlash: hasSlash,
+	}
+	if hasSlash {
+		pattern.re = regexp.MustCompile("^" + globToRegexp(line) + "$")
+	}
+	m.patterns = append(m.patterns, pattern)
+}
+
+func globToRegexp(pattern string) string {
+	var b strings.Builder
+	for i := 0; i < len(pattern); i++ {
+		c := pattern[i]
+		switch c {
+		case '*':
+			if i+1 < len(pattern) && pattern[i+1] == '*' {
+				i++
+				if i+1 < len(pattern) && pattern[i+1] == '/' {
+					i++
+					b.WriteString("(?:.*/)?")
+				} else {
+					b.WriteString(".*")
+				}
+			} else {
+				b.WriteString("[^/]*")
+			}
+		case '?':
+			b.WriteString("[^/]")
+		case '[':
+			j := i + 1
+			if j < len(pattern) && (pattern[j] == '!' || pattern[j] == '^') {
+				j++
+			}
+			if j < len(pattern) && pattern[j] == ']' {
+				j++
+			}
+			for j < len(pattern) && pattern[j] != ']' {
+				j++
+			}
+			if j < len(pattern) {
+				class := pattern[i+1 : j]
+				if strings.HasPrefix(class, "!") {
+					class = "^" + class[1:]
+				}
+				b.WriteString("[" + class + "]")
+				i = j
+			} else {
+				b.WriteString("\\[")
+			}
+		case '\\':
+			if i+1 < len(pattern) {
+				i++
+				b.WriteString(regexp.QuoteMeta(string(pattern[i])))
+			} else {
+				b.WriteString("\\\\")
+			}
+		default:
+			b.WriteString(regexp.QuoteMeta(string(c)))
+		}
+	}
+	return b.String()
+}
+
+func (m *IgnoreMatcher) IsIgnored(rel string, isDir bool) bool {
+	absPath := rel
+	if !filepath.IsAbs(absPath) {
+		cwd := m.cwd
+		if cwd == "" {
+			var err error
+			cwd, err = os.Getwd()
+			if err != nil {
+				cwd = "."
+			}
+		}
+		absPath = filepath.Join(cwd, rel)
+	}
+	absPath = filepath.Clean(absPath)
+	ignored := false
+	for _, p := range m.patterns {
+		if p.matches(absPath, isDir) {
+			ignored = !p.negated
+		}
+	}
+	return ignored
+}
+
+func (p ignorePattern) matches(absPath string, isDir bool) bool {
+	rel, err := filepath.Rel(p.base, absPath)
+	if err != nil {
+		return false
+	}
+	if rel == ".." || strings.HasPrefix(rel, ".."+string(os.PathSeparator)) {
+		return false
+	}
+	sub := filepath.ToSlash(rel)
+	if sub == "" || sub == "." {
+		return false
+	}
+
+	if p.hasSlash {
+		if p.dirOnly {
+			if isDir && p.re.MatchString(sub) {
+				return true
+			}
+			parts := strings.Split(sub, "/")
+			for i := 1; i < len(parts); i++ {
+				if p.re.MatchString(strings.Join(parts[:i], "/")) {
+					return true
+				}
+			}
+			return false
+		}
+		if p.re.MatchString(sub) {
+			return true
+		}
+		parts := strings.Split(sub, "/")
+		for i := 1; i < len(parts); i++ {
+			if p.re.MatchString(strings.Join(parts[:i], "/")) {
+				return true
+			}
+		}
+		return false
+	}
+
+	parts := strings.Split(sub, "/")
+	for i, part := range parts {
+		isLast := i == len(parts)-1
+		if p.dirOnly && isLast && !isDir {
+			continue
+		}
+		if ok, _ := filepath.Match(p.pattern, part); ok {
+			return true
+		}
+	}
+	return false
+}
