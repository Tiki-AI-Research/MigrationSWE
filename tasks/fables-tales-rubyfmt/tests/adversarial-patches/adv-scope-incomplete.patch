+	case "UndefNode":
+		formatUndefNode(ps, node)
+	case "UnlessNode":
+		formatConditionalNode(ps, []byte("unless"), true, &Conditional{Kind: CondUnless, Node: node})
+	case "UntilNode":
+		formatConditionalNode(ps, []byte("until"), true, &Conditional{Kind: CondUntil, Node: node})
+	case "WhenNode":
+		formatWhenNode(ps, node)
+	case "WhileNode":
+		formatConditionalNode(ps, []byte("while"), true, &Conditional{Kind: CondWhile, Node: node})
+	case "XStringNode":
+		formatXStringNode(ps, node)
+	case "YieldNode":
+		formatYieldNode(ps, node)
+	}
+
+	ps.atOffset(node.End())
+	if needsHandling {
+		ps.emitNewline()
+	}
+}
+
+func formatProgram(ps *ParserState, programNode Node, dataLoc *Loc) {
+	ps.withStartOfLine(true, func(ps *ParserState) {
+		formatStatements(ps, programNode.Get("statements"))
+	})
+	ps.emitNewline()
+	ps.onLine(10000000000)
+	ps.shiftComments()
+	if dataLoc != nil {
+		ps.emitData(ps.slice(dataLoc))
+	}
+}
+
+func formatStatements(ps *ParserState, statementsNode Node) {
+	ps.withStartOfLine(true, func(ps *ParserState) {
+		for _, node := range statementsNode.List("body") {
+			formatNode(ps, node)
+		}
+	})
+}
+
+func nodeListEndOffset(list []Node) int {
+	if len(list) == 0 {
+		return 0
+	}
+	return list[len(list)-1].End()
+}
+
+func handleStringAtOffset(ps *ParserState, ident []byte, offset int) {
+	ps.atOffset(offset)
+	ps.emitIdent(ident)
+}
