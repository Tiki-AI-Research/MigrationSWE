+package formatter
+
+func formatNode(ps *ParserState, node Node) {
+	if node == nil {
+		return
+	}
+	ps.atOffset(node.Start())
+
+	needsHandling := ps.atStartOfLine()
+	if node.Type() == "StatementsNode" {
+		needsHandling = false
+	}
+	if begin := node; begin.Type() == "BeginNode" && begin.LocField("begin_keyword_loc") == nil {
+		needsHandling = false
+	}
+
+	if needsHandling {
+		ps.emitIndent()
+	}
+
+	switch node.Type() {
+	case "AliasGlobalVariableNode":
+		formatAliasGlobalVariableNode(ps, node)
+	case "AliasMethodNode":
+		formatAliasMethodNode(ps, node)
+	case "AlternationPatternNode":
+		formatAlternationPatternNode(ps, node)
+	case "AndNode":
+		formatAndNode(ps, node)
+	case "ArgumentsNode":
+		formatArgumentsNode(ps, node)
+	case "ArrayNode":
+		formatArrayNode(ps, node)
+	case "ArrayPatternNode":
+		formatArrayPatternNode(ps, node)
+	case "AssocNode":
+		formatAssocNode(ps, node)
+	case "AssocSplatNode":
+		formatAssocSplatNode(ps, node)
+	case "BackReferenceReadNode":
+		formatBackReferenceReadNode(ps, node)
+	case "BeginNode":
+		formatBeginNode(ps, node)
+	case "BlockArgumentNode":
+		formatBlockArgumentNode(ps, node)
+	case "BlockLocalVariableNode":
+		formatBlockLocalVariableNode(ps, node)
+	case "BlockNode":
+		formatBlockNode(ps, node)
+	case "BlockParameterNode":
+		formatBlockParameterNode(ps, node)
+	case "BlockParametersNode":
+		formatBlockParametersNode(ps, node)
+	case "BreakNode":
+		formatBreakNode(ps, node)
+	case "CallAndWriteNode":
+		formatCallAndWriteNode(ps, node)
+	case "CallNode":
+		isLast := node.Get("receiver") == nil
+		hasBlock := node.Get("block") != nil && node.Get("block").Type() == "BlockNode"
+		if isLast && hasBlock {
+			ps.breakableCallChainOf(false, func(ps *ParserState) {
+				formatCallNode(ps, node, false, true, false)
