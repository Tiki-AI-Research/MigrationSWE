--- /dev/null
+++ b/internal/formatter/bench_test.go
@@ -0,0 +1,26 @@
+package formatter
+
+import (
+	"os"
+	"testing"
+)
+
+func BenchmarkFormatFixtures(b *testing.B) {
+	root := repoRoot(b)
+	pairs := collectFixtures(b, root)
+	inputs := make([][]byte, 0, len(pairs))
+	for _, pair := range pairs {
+		data, err := os.ReadFile(pair.actual)
+		if err != nil {
+			b.Fatal(err)
+		}
+		inputs = append(inputs, data)
+	}
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		data := inputs[i%len(inputs)]
+		if _, err := FormatBuffer(data); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
