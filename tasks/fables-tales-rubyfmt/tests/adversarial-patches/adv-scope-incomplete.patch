+			list := arguments.List("arguments")
+			if len(list) == 1 {
+				ps.emitSpace()
+				formatNode(ps, list[0])
+			} else {
+				ps.breakableOf(ForReturnKw(), func(ps *ParserState) {
+					ps.withStartOfLine(false, func(ps *ParserState) {
+						formatListLikeThing(ps, list, arguments.End(), false)
+					})
+				})
+			}
+		}
+	})
+}
+
+func formatYieldNode(ps *ParserState, n Node) {
+	ps.emitIdent([]byte("yield"))
+	if arguments := n.Get("arguments"); arguments != nil {
+		useParens := ps.currentFormattingContextRequiresParens() || n.LocField("lparen_loc") != nil
+		list := arguments.List("arguments")
+		if len(list) == 1 && list[0].Type() == "KeywordHashNode" {
+			useParens = true
+		}
+		delims := ForKw()
+		if useParens {
+			delims = ForMethodCall()
+		}
+		ps.breakableOf(delims, func(ps *ParserState) {
+			formatArgumentsNode(ps, arguments)
+		})
+	}
+}
+
+func formatOrNode(ps *ParserState, n Node) {
+	ps.inlineBreakableOf(ForBinaryOp(), func(ps *ParserState) {
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			formatInfixOperator(ps, n.Get("left"), ps.slice(n.LocField("operator_loc")), n.Get("right"))
+		})
