+		if left := n.Get("left"); left != nil {
+			formatNode(ps, left)
+		}
+		ps.emitOp(ps.slice(n.LocField("operator_loc")))
+		if right := n.Get("right"); right != nil {
+			formatNode(ps, right)
+		}
+	})
+}
diff --git a/internal/formatter/format_strings.go b/internal/formatter/format_strings.go
new file mode 100644
index 0000000..e76f4b8
--- /dev/null
+++ b/internal/formatter/format_strings.go
@@ -0,0 +1,598 @@
+package formatter
+
+import "bytes"
+
+func locTrimmed(ps *ParserState, n Node, key string) ([]byte, bool) {
+	loc := n.LocField(key)
+	if loc == nil {
+		return nil, false
+	}
+	return trimASCII(ps.slice(loc)), true
+}
+
+func formatStringNode(ps *ParserState, n Node) {
+	ps.atOffset(n.Start())
+
+	opener, hasOpener := locTrimmed(ps, n, "opening_loc")
+	closer, hasCloser := locTrimmed(ps, n, "closing_loc")
+	isHeredoc := hasOpener && bytes.HasPrefix(opener, []byte("<"))
+
+	if isHeredoc {
+		formatHeredoc(ps, []Node{n}, n.LocField("closing_loc"), opener)
+		return
+	}
+
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		if hasOpener {
+			ps.emitDoubleQuote()
+		}
+		inEscapedContext := isHeredoc || !hasOpener || bytes.HasPrefix(opener, []byte("\""))
+		var stringContent []byte
+		if inEscapedContext {
+			stringContent = ps.slice(n.LocField("content_loc"))
+		} else {
+			endDelim := []byte("\"")
+			if hasCloser {
+				endDelim = closer
+			}
+			stringContent = singleToDoubleQuoted(ps.slice(n.LocField("content_loc")), opener, endDelim)
+		}
+		ps.emitStringContent(stringContent)
+		ps.windDumpingCommentsUntilOffset(n.LocField("content_loc").End)
+		if hasOpener {
+			ps.emitDoubleQuote()
+		}
+	})
+	ps.windDumpingCommentsUntilOffset(n.End())
+}
+
+func formatInterpolatedStringNode(ps *ParserState, n Node) {
+	opener, hasOpener := locTrimmed(ps, n, "opening_loc")
+	closer, hasCloser := locTrimmed(ps, n, "closing_loc")
+	isHeredoc := hasOpener && bytes.HasPrefix(opener, []byte("<"))
+	needsEscape := hasOpener && !bytes.HasPrefix(opener, []byte("\"")) && !isHeredoc
+
+	parts := n.List("parts")
+	isBackslashStringInterpolation := !isHeredoc && len(parts) > 1
+	if isBackslashStringInterpolation {
+		hasOpening := false
+		for _, part := range parts {
+			if part.Type() == "StringNode" && part.LocField("opening_loc") != nil {
+				hasOpening = true
+				break
+			}
+			if part.Type() == "InterpolatedStringNode" && part.LocField("opening_loc") != nil {
+				hasOpening = true
+				break
+			}
+		}
+		isBackslashStringInterpolation = hasOpening
+	}
+
+	ps.atOffset(n.Start())
+
+	if isHeredoc {
+		formatHeredoc(ps, parts, n.LocField("closing_loc"), opener)
+		return
+	}
+
+	if hasOpener {
+		if needsEscape {
+			ps.emitDoubleQuote()
+		} else {
+			ps.emitStringContent(opener)
+		}
+	}
+
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		stringPartsCount := len(parts)
+		for i, part := range parts {
+			startOffset := part.Start()
+			endOffset := part.End()
+			ps.atOffset(startOffset)
+			indentForConsecutive := isBackslashStringInterpolation && i > 0
+			if indentForConsecutive {
+				ps.startIndent()
+				ps.emitNewline()
+				ps.emitIndent()
+			}
+			if needsEscape && part.Type() == "StringNode" {
+				endDelim := []byte("\"")
+				if hasCloser {
+					endDelim = closer
+				}
+				escaped := singleToDoubleQuoted(ps.slice(part.LocField("content_loc")), opener, endDelim)
+				ps.emitStringContent(escaped)
+			} else {
+				formatNode(ps, part)
+			}
+			if isBackslashStringInterpolation && i < stringPartsCount-1 {
+				if hasCloser {
+					if needsEscape {
+						ps.emitDoubleQuote()
+					} else {
+						ps.emitStringContent(closer)
+					}
+				}
+				ps.emitSpace()
+				ps.emitSlash()
+			}
+			ps.atOffset(endOffset)
+			if indentForConsecutive {
+				ps.endIndent()
+			}
+		}
+	})
+
+	if hasCloser {
+		if needsEscape {
+			ps.emitDoubleQuote()
+		} else {
+			ps.emitStringContent(closer)
+		}
+	}
+}
+
+func formatHeredoc(ps *ParserState, parts []Node, closingLoc *Loc, heredocSymbol []byte) {
+	heredocKind := HeredocKindFromBytes(heredocSymbol)
+	ps.emitHeredocStart(heredocSymbol, heredocKind)
+
+	closingEndLine := ps.getLineNumberForOffset(closingLoc.Start)
+	ps.pushHeredocContent(trimASCII(ps.slice(closingLoc)), heredocKind, closingEndLine, func(n *ParserState) {
+		n.disableUserNewlines()
+		formatInnerString(n, parts, heredocKind)
+	})
+	ps.windDumpingCommentsUntilOffset(closingLoc.Start)
+}
+
+func maybeRenderHeredocsInString(ps *ParserState, parts []Node, index int) {
+	if index+1 < len(parts) {
+		next := parts[index+1]
+		if next.Type() == "StringNode" && bytes.HasPrefix(ps.slice(next.LocField("content_loc")), []byte("\n")) {
+			ps.renderHeredocs(true)
+		}
+	}
+}
+
+func formatInnerString(ps *ParserState, parts []Node, heredocKind HeredocKind) {
+	commonIndent := 0
+	if heredocKind.IsSquiggly() {
+		for _, part := range parts {
+			if part.Type() != "StringNode" {
+				continue
+			}
+			raw := ps.slice(part.LocField("content_loc"))
+			unescaped := []byte(part.Str("unescaped"))
+			rawLeading := 0
+			for rawLeading < len(raw) && (raw[rawLeading] == ' ' || raw[rawLeading] == '\t') {
+				rawLeading++
+			}
+			afterWS := raw[rawLeading:]
+			escapedWSCount := 0
+			i := 0
+			for i+1 < len(afterWS) && afterWS[i] == '\\' {
+				if afterWS[i+1] == 't' || afterWS[i+1] == 's' {
+					escapedWSCount++
+					i += 2
+				} else {
+					break
+				}
+			}
+			unescapedLeading := 0
+			for unescapedLeading < len(unescaped) && (unescaped[unescapedLeading] == ' ' || unescaped[unescapedLeading] == '\t') {
+				unescapedLeading++
+			}
+			unescapedLeading -= escapedWSCount
+			if unescapedLeading < 0 {
+				unescapedLeading = 0
+			}
+			if rawLeading > unescapedLeading {
+				commonIndent = rawLeading - unescapedLeading
+				break
+			}
+		}
+	}
+
+	prevEndedWithNewline := true
+	for index, part := range parts {
+		switch part.Type() {
+		case "StringNode":
+			raw := ps.slice(part.LocField("content_loc"))
+			contents := raw
+			if commonIndent > 0 {
+				lines := bytes.Split(raw, []byte{'\n'})
+				var result []byte
+				for lineIdx, line := range lines {
+					shouldStrip := (lineIdx > 0 || prevEndedWithNewline) && len(line) != 0 && len(line) >= commonIndent
+					if shouldStrip {
+						line = line[commonIndent:]
+					}
+					if lineIdx > 0 {
+						result = append(result, '\n')
+					}
+					result = append(result, line...)
+				}
+				contents = result
+			}
+
+			renderedHeredocs := false
+			if ps.hasPendingHeredocs() && !bytes.HasPrefix(contents, []byte("\n")) {
+				if newlineIdx := bytes.IndexByte(contents, '\n'); newlineIdx >= 0 {
+					beforeNewline := contents[:newlineIdx]
+					if len(beforeNewline) != 0 {
+						ps.emitStringContent(append([]byte{}, beforeNewline...))
+					}
+					ps.emitHardNewlineInHeredoc()
+					ps.renderHeredocs(false)
+					contents = contents[newlineIdx+1:]
+					renderedHeredocs = true
+				}
+			}
+
+			if renderedHeredocs && len(contents) == 0 {
+				prevEndedWithNewline = true
+			} else {
+				prevEndedWithNewline = bytes.HasSuffix(contents, []byte("\n"))
+			}
+
+			if index == len(parts)-1 && bytes.HasSuffix(contents, []byte("\n")) {
+				contents = contents[:len(contents)-1]
+			}
+
+			ps.atOffset(part.End())
+			if len(contents) != 0 {
+				ps.emitStringContent(contents)
+			}
+		case "InterpolatedStringNode":
+			ps.atOffset(part.Start())
+			formatInterpolatedStringNode(ps, part)
+			maybeRenderHeredocsInString(ps, parts, index)
+			prevEndedWithNewline = false
+		case "EmbeddedStatementsNode":
+			formatEmbeddedStatementsNode(ps, part)
+			maybeRenderHeredocsInString(ps, parts, index)
+			prevEndedWithNewline = false
+		case "EmbeddedVariableNode":
+			formatEmbeddedVariableNode(ps, part)
+			prevEndedWithNewline = false
+		}
+	}
+}
+
+func formatInterpolatedSymbolNode(ps *ParserState, n Node) {
+	opener := ps.slice(n.LocField("opening_loc"))
+	if opener == nil {
+		opener = []byte(":\"")
+	}
+	closer := ps.slice(n.LocField("closing_loc"))
+	if closer == nil {
+		closer = []byte("\"")
+	}
+
+	ps.emitIdent(opener)
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		for _, part := range n.List("parts") {
+			startOffset := part.Start()
+			endOffset := part.End()
+			ps.atOffset(startOffset)
+			formatNode(ps, part)
+			ps.atOffset(endOffset)
+		}
+	})
+	emitSymbolKeyCloser(ps, closer)
+}
+
+func formatInterpolatedXStringNode(ps *ParserState, n Node) {
+	ps.emitIdent([]byte("`"))
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		for _, part := range n.List("parts") {
+			startOffset := part.Start()
+			endOffset := part.End()
+			ps.atOffset(startOffset)
+			formatNode(ps, part)
+			ps.atOffset(endOffset)
+		}
+	})
+	ps.emitIdent([]byte("`"))
+}
+
+func formatInterpolatedLastLineNode(ps *ParserState, n Node) {
+	ps.emitIdent(ps.slice(n.LocField("opening_loc")))
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		for _, part := range n.List("parts") {
+			startOffset := part.Start()
+			endOffset := part.End()
+			ps.atOffset(startOffset)
+			formatNode(ps, part)
+			ps.atOffset(endOffset)
+		}
+	})
+	ps.emitIdent(ps.slice(n.LocField("closing_loc")))
+}
+
+func formatInterpolatedRegularExpressionNode(ps *ParserState, n Node) {
+	ps.emitIdent(ps.slice(n.LocField("opening_loc")))
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		for _, part := range n.List("parts") {
+			startOffset := part.Start()
+			endOffset := part.End()
+			ps.atOffset(startOffset)
+			formatNode(ps, part)
+			ps.atOffset(endOffset)
+		}
+	})
+	ps.emitIdent(ps.slice(n.LocField("closing_loc")))
+}
+
+func formatEmbeddedStatementsNode(ps *ParserState, n Node) {
+	ps.emitStringContent([]byte("#{"))
+	if statements := n.Get("statements"); statements != nil {
+		ps.withFormattingContext(StringEmbexprContext(), func(ps *ParserState) {
+			hasMultiple := len(statements.List("body")) > 1
+			ps.withStartOfLine(hasMultiple, func(ps *ParserState) {
+				if hasMultiple {
+					ps.emitNewline()
+					ps.newBlock(func(ps *ParserState) { formatNode(ps, statements) })
+					ps.emitIndent()
+				} else if list := statements.List("body"); len(list) > 0 {
+					formatNode(ps, list[0])
+				}
+			})
+		})
+	}
+	ps.emitStringContent([]byte("}"))
+}
+
+func formatEmbeddedVariableNode(ps *ParserState, n Node) {
+	ps.emitStringContent([]byte("#{"))
+	formatNode(ps, n.Get("variable"))
+	ps.emitStringContent([]byte("}"))
+}
+
+func formatSymbolNode(ps *ParserState, n Node) {
+	opener := ps.slice(n.LocField("opening_loc"))
+	closer := ps.slice(n.LocField("closing_loc"))
+	isSingleQuoted := bytes.Equal(opener, []byte(":'"))
+
+	if isSingleQuoted {
+		ps.emitIdent([]byte(":"))
+		ps.emitDoubleQuote()
+		if valueLoc := n.LocField("value_loc"); valueLoc != nil {
+			escaped := singleToDoubleQuoted(ps.slice(valueLoc), opener, closer)
+			ps.emitStringContent(escaped)
+		}
+		ps.emitDoubleQuote()
+	} else {
+		if opener != nil {
+			ps.emitIdent(opener)
+		}
+		if valueLoc := n.LocField("value_loc"); valueLoc != nil {
+			ps.emitIdent(ps.slice(valueLoc))
+		}
+		if closer != nil {
+			emitSymbolKeyCloser(ps, closer)
+		}
+	}
+}
+
+func emitSymbolKeyCloser(ps *ParserState, closer []byte) {
+	trimmed := closer
+	if bytes.HasSuffix(trimmed, []byte(":")) {
+		trimmed = trimmed[:len(trimmed)-1]
+	}
+	if len(trimmed) != 0 {
+		ps.emitIdent(trimmed)
+	}
+}
+
+func formatAssocNode(ps *ParserState, n Node) {
+	asSymbol := false
+	if hashType := ps.hashTypeFromFormattingContext(); hashType != nil {
+		asSymbol = *hashType == HashSymbolKey
+	} else {
+		asSymbol = n.LocField("operator_loc") == nil
+	}
+
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		if !asSymbol && n.LocField("operator_loc") == nil {
+			ps.emitIdent([]byte(":"))
+		}
+		formatNode(ps, n.Get("key"))
+		if asSymbol {
+			ps.emitIdent([]byte(":"))
+		} else {
+			ps.emitSpace()
+			ps.emitIdent([]byte("=>"))
+		}
+		value := n.Get("value")
+		if value != nil && value.Type() == "ImplicitNode" {
+			if !asSymbol {
+				ps.emitSpace()
+				formatNode(ps, value.Get("value"))
+			}
+		} else {
+			ps.emitSpace()
+			formatNode(ps, value)
+		}
+	})
+}
+
+func formatAssocSplatNode(ps *ParserState, n Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.emitIdent([]byte("**"))
+		if value := n.Get("value"); value != nil {
+			formatNode(ps, value)
+		}
+	})
+}
+
+func formatArrayNode(ps *ParserState, n Node) {
+	opening, hasOpening := locTrimmed(ps, n, "opening_loc")
+	isWordArray := hasOpening && bytes.HasPrefix(opening, []byte("%"))
+	origDelim := byte('[')
+	if hasOpening && len(opening) > 2 {
+		origDelim = opening[2]
+	}
+
+	if isWordArray {
+		ps.emitIdent(opening[:2])
+	}
+
+	elements := n.List("elements")
+	if len(elements) == 0 {
+		if ps.hasCommentInOffsetSpan(n.Start(), n.End()) {
+			ps.withStartOfLine(false, func(ps *ParserState) {
+				ps.breakableOf(ForArray(), func(ps *ParserState) {
+					ps.windDumpingCommentsUntilOffset(n.End())
+				})
+			})
+		} else {
+			ps.emitOpenSquareBracket()
+			ps.emitCloseSquareBracket()
+		}
+	} else if isWordArray {
+		ps.breakableOf(ForArray(), func(ps *ParserState) {
+			ps.withStartOfLine(false, func(ps *ParserState) {
+				formatWordArrayElements(ps, elements, n.End(), origDelim)
+			})
+		})
+		ps.windDumpingCommentsUntilOffset(n.End())
+	} else {
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			if !hasOpening {
+				formatListLikeThing(ps, elements, n.End(), true)
+			} else {
+				ps.breakableOf(ForArray(), func(ps *ParserState) {
+					formatListLikeThing(ps, elements, n.End(), false)
+					ps.windDumpingCommentsUntilOffset(n.End())
+				})
+			}
+		})
+	}
+}
+
+func formatWordArrayElements(ps *ParserState, nodeList []Node, endOffset int, origOpenDelim byte) {
+	argsCount := len(nodeList)
+	origCloseDelim := matchingDelimiter(origOpenDelim)
+	endLine := ps.getLineNumberForOffset(endOffset)
+
+	ps.magicHandleCommentsForMultilineArrays(&endLine, func(ps *ParserState) {
+		for idx, expr := range nodeList {
+			ps.emitSoftIndent()
+			switch expr.Type() {
+			case "StringNode":
+				ps.atOffset(expr.Start())
+				escaped := escapeWordArrayContent(ps.slice(expr.LocField("content_loc")), origOpenDelim, origCloseDelim)
+				ps.emitStringContent(escaped)
+			case "SymbolNode":
+				ps.atOffset(expr.Start())
+				if valueLoc := expr.LocField("value_loc"); valueLoc != nil {
+					escaped := escapeWordArrayContent(ps.slice(valueLoc), origOpenDelim, origCloseDelim)
+					ps.emitStringContent(escaped)
+				}
+			case "InterpolatedSymbolNode":
+				ps.atOffset(expr.Start())
+				formatWordArrayInterpolatedParts(ps, expr.List("parts"), origOpenDelim, origCloseDelim)
+			case "InterpolatedStringNode":
+				ps.atOffset(expr.Start())
+				formatWordArrayInterpolatedParts(ps, expr.List("parts"), origOpenDelim, origCloseDelim)
+			default:
+				formatNode(ps, expr)
+			}
+			if idx != argsCount-1 {
+				ps.emitSoftNewline()
+			}
+		}
+	})
+}
+
+func matchingDelimiter(open byte) byte {
+	switch open {
+	case '[':
+		return ']'
+	case '(':
+		return ')'
+	case '{':
+		return '}'
+	case '<':
+		return '>'
+	default:
+		return open
+	}
+}
+
+func formatWordArrayInterpolatedParts(ps *ParserState, parts []Node, origOpenDelim, origCloseDelim byte) {
+	for _, part := range parts {
+		startOffset := part.Start()
+		endOffset := part.End()
+		ps.atOffset(startOffset)
+		switch part.Type() {
+		case "StringNode":
+			escaped := escapeWordArrayContent(ps.slice(part.LocField("content_loc")), origOpenDelim, origCloseDelim)
+			ps.emitStringContent(escaped)
+		case "EmbeddedStatementsNode":
+			formatEmbeddedStatementsNode(ps, part)
+		default:
+			formatNode(ps, part)
+		}
+		ps.atOffset(endOffset)
+	}
+}
+
+func formatHashNode(ps *ParserState, n Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		elements := n.List("elements")
+		if len(elements) == 0 {
+			startOffset := n.Start()
+			endOffset := n.End()
+			isMultiline := ps.getLineNumberForOffset(startOffset) != ps.getLineNumberForOffset(endOffset)
+			hasComments := ps.hasCommentInOffsetSpan(startOffset, endOffset)
+			if isMultiline && hasComments {
+				ps.breakableOf(ForHash(), func(ps *ParserState) {
+					ps.windDumpingCommentsUntilOffset(endOffset)
+				})
+			} else {
+				ps.emitIdent([]byte("{}"))
+				ps.windDumpingCommentsUntilOffset(endOffset)
+			}
+		} else {
+			allSymbolKeys := true
+			for _, element := range elements {
+				if element.Type() == "AssocNode" && element.LocField("operator_loc") != nil {
+					allSymbolKeys = false
+					break
+				}
+			}
+			hashType := HashRocket
+			if allSymbolKeys {
+				hashType = HashSymbolKey
+			}
+			ps.withFormattingContext(HashTypeContext(hashType), func(ps *ParserState) {
+				ps.breakableOf(ForHash(), func(ps *ParserState) {
+					ps.emitSoftIndent()
+					formatListLikeThing(ps, elements, n.LocField("closing_loc").End, false)
+					ps.windDumpingCommentsUntilOffset(n.LocField("closing_loc").End)
+				})
+			})
+		}
+	})
+}
+
+func formatKeywordHashNode(ps *ParserState, n Node) {
+	allSymbolKeys := true
+	for _, node := range n.List("elements") {
+		if node.Type() == "AssocNode" && node.LocField("operator_loc") != nil {
+			allSymbolKeys = false
+			break
+		}
+	}
+	hashType := HashRocket
+	if allSymbolKeys {
+		hashType = HashSymbolKey
+	}
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.withFormattingContext(HashTypeContext(hashType), func(ps *ParserState) {
+			formatListLikeThing(ps, n.List("elements"), n.End(), false)
+		})
+	})
+}
diff --git a/internal/formatter/formatter.go b/internal/formatter/formatter.go
new file mode 100644
index 0000000..9248aae
--- /dev/null
+++ b/internal/formatter/formatter.go
@@ -0,0 +1,72 @@
+package formatter
+
+import (
+	"fmt"
+
+	"rubyfmt/internal/prism"
+)
+
+type FormatError int
+
+const (
+	FormatOK FormatError = iota
+	FormatSyntaxError
+	FormatRipperParseFailure
+	FormatIOError
+	FormatOtherRubyError
+	FormatDiffDetected
+)
+
+type RichFormatError struct {
+	Kind FormatError
+	Err  error
+}
+
+func (e *RichFormatError) Error() string {
+	if e.Err != nil {
+		return e.Err.Error()
+	}
+	switch e.Kind {
+	case FormatSyntaxError:
+		return "syntax error"
+	case FormatIOError:
+		return "IO error"
+	case FormatDiffDetected:
+		return "diff detected"
+	}
+	return "format error"
+}
+
+func (e *RichFormatError) ExitCode() int { return int(e.Kind) }
+
+func FormatBuffer(buf []byte) ([]byte, *RichFormatError) {
+	result, err := prism.Parse(buf)
+	if err != nil {
+		return nil, &RichFormatError{Kind: FormatIOError, Err: fmt.Errorf("parsing Ruby source: %w", err)}
+	}
+	if result.Errors > 0 {
+		return nil, &RichFormatError{Kind: FormatSyntaxError}
+	}
+
+	root, err := DecodeNode(result.AST)
+	if err != nil {
+		return nil, &RichFormatError{Kind: FormatIOError, Err: err}
+	}
+
+	rawComments := make([]RawComment, 0, len(result.Comments))
+	for _, comment := range result.Comments {
+		rawComments = append(rawComments, RawComment{Start: comment.Start, End: comment.End})
+	}
+	fileComments := FileCommentsFromComments(rawComments, buf)
+	ps := NewParserState(fileComments)
+	ps.source = NewSource(buf)
+	ps.flushStartOfFileComments()
+
+	var dataLoc *Loc
+	if result.Data != nil {
+		dataLoc = &Loc{Start: result.Data.Start, End: result.Data.End}
+	}
+	formatProgram(ps, root, dataLoc)
+
+	return ps.Write(), nil
+}
diff --git a/internal/formatter/heredoc.go b/internal/formatter/heredoc.go
new file mode 100644
index 0000000..c70fffd
--- /dev/null
+++ b/internal/formatter/heredoc.go
@@ -0,0 +1,78 @@
+package formatter
+
+import "bytes"
+
+type HeredocKind int
+
+const (
+	HeredocBare HeredocKind = iota
+	HeredocDash
+	HeredocSquiggly
+)
+
+func HeredocKindFromBytes(kind []byte) HeredocKind {
+	if bytes.IndexByte(kind, '~') >= 0 {
+		return HeredocSquiggly
+	}
+	if bytes.IndexByte(kind, '-') >= 0 {
+		return HeredocDash
+	}
+	return HeredocBare
+}
+
+func (k HeredocKind) IsSquiggly() bool { return k == HeredocSquiggly }
+func (k HeredocKind) IsBare() bool     { return k == HeredocBare }
+
+type HeredocSegment struct {
+	Raw     bool
+	Content []byte
+}
+
+type HeredocString struct {
+	Symbol   []byte
+	Kind     HeredocKind
+	Segments []HeredocSegment
+	Indent   uint32
+}
+
+func (h *HeredocString) RenderAsBytes() []byte {
+	var result []byte
+	if h.Kind.IsSquiggly() {
+		for _, segment := range h.Segments {
+			lines := bytes.Split(segment.Content, []byte{'\n'})
+			for i, line := range lines {
+				if i > 0 {
+					result = append(result, '\n')
+				}
+				if segment.Raw {
+					result = append(result, trimASCIIEnd(line)...)
+				} else {
+					indented := append(getIndent(int(h.Indent)+2), line...)
+					result = append(result, trimASCIIEnd(indented)...)
+				}
+			}
+		}
+		return result
+	}
+
+	for _, segment := range h.Segments {
+		lines := bytes.Split(segment.Content, []byte{'\n'})
+		for i, line := range lines {
+			if i > 0 {
+				result = append(result, '\n')
+			}
+			result = append(result, trimASCIIEnd(line)...)
+		}
+	}
+	return result
+}
+
+func (h *HeredocString) ClosingSymbol() []byte {
+	out := make([]byte, 0, len(h.Symbol))
+	for _, b := range h.Symbol {
+		if b != '\'' && b != '"' {
+			out = append(out, b)
+		}
+	}
+	return out
+}
diff --git a/internal/formatter/intermediary.go b/internal/formatter/intermediary.go
new file mode 100644
index 0000000..8109494
--- /dev/null
+++ b/internal/formatter/intermediary.go
@@ -0,0 +1,162 @@
+package formatter
+
+import "bytes"
+
+type BlanklineReason int
+
+const (
+	ComesAfterEnd BlanklineReason = iota
+	ClassOrModule
+	EndOfRequireBlock
+)
+
+type LineMetadata struct {
+	getsIndented bool
+	indentLevel  *uint32
+	require      bool
+}
+
+func (m *LineMetadata) SetHasRequire()              { m.require = true }
+func (m *LineMetadata) HasRequire() bool            { return m.require }
+func (m *LineMetadata) ObserveIndentLevel(l uint32) { m.indentLevel = &l }
+func (m *LineMetadata) GetsIndented() bool          { return m.getsIndented }
+func (m *LineMetadata) SetGetsIndented()            { m.getsIndented = true }
+
+func indentLevelIncreasesBetween(prev, current *LineMetadata) bool {
+	if current.indentLevel == nil {
+		return false
+	}
+	if prev.indentLevel == nil {
+		return true
+	}
+	return *prev.indentLevel < *current.indentLevel
+}
+
+type Intermediary struct {
+	tokens                 []*ConcreteToken
+	indexOfLastHardNewline int
+	currentLineMetadata    LineMetadata
+	previousLineMetadata   *LineMetadata
+	AdditionalIndent       int
+}
+
+func NewIntermediary() *Intermediary {
+	return &Intermediary{}
+}
+
+func (i *Intermediary) Len() int { return len(i.tokens) }
+
+func (i *Intermediary) FixHeredocDuplicateIndentMistake() {
+	idx := len(i.tokens) - 3
+	i.tokens = append(i.tokens[:idx], i.tokens[idx+1:]...)
+}
+
+func (i *Intermediary) IntoTokens() []*ConcreteToken { return i.tokens }
+
+func (i *Intermediary) CurrentLineLength() int {
+	if len(i.tokens) == 0 {
+		return 0
+	}
+	lineStart := i.indexOfLastHardNewline + 1
+	total := 0
+	for _, t := range i.tokens[lineStart:] {
+		total += t.Len()
+	}
+	return total
+}
+
+func (i *Intermediary) Push(lt *ConcreteToken) {
+	doPush := true
+
+	switch lt.Kind {
+	case THardNewLine:
+		if i.previousLineMetadata != nil && !i.currentLineMetadata.HasRequire() && i.previousLineMetadata.HasRequire() {
+			i.InsertTrailingBlankline(EndOfRequireBlock)
+		}
+		md := i.currentLineMetadata
+		i.currentLineMetadata = LineMetadata{}
+		i.previousLineMetadata = &md
+		i.indexOfLastHardNewline = len(i.tokens)
+
+		if len(i.tokens) >= 2 &&
+			i.tokens[i.indexOfLastHardNewline-2].Kind == THardNewLine &&
+			i.tokens[i.indexOfLastHardNewline-1].Kind == THardNewLine {
+			doPush = false
+			i.indexOfLastHardNewline = len(i.tokens) - 1
+		}
+	case TModuleKeyword, TClassKeyword:
+		i.handleClassOrModule()
+	case TIndent:
+		i.currentLineMetadata.ObserveIndentLevel(lt.Depth)
+		if i.previousLineMetadata != nil && indentLevelIncreasesBetween(i.previousLineMetadata, &i.currentLineMetadata) {
+			i.previousLineMetadata.SetGetsIndented()
+		}
+	case TMethodName:
+		if bytes.Equal(lt.Data, []byte("require")) && len(i.tokens) > 0 && i.tokens[len(i.tokens)-1].IsIndent() {
+			i.currentLineMetadata.SetHasRequire()
+		}
+	}
+
+	if doPush {
+		i.tokens = append(i.tokens, lt)
+	}
+}
+
+func (i *Intermediary) handleClassOrModule() {
+	if i.previousLineMetadata != nil && !i.previousLineMetadata.GetsIndented() {
+		i.InsertTrailingBlankline(ClassOrModule)
+	}
+}
+
+func (i *Intermediary) ClearBreakableGarbage() {
+	for len(i.tokens) > 2 && i.tokens[len(i.tokens)-2].IsSingleLineBreakableGarbage() {
+		idx := len(i.tokens) - 2
+		i.tokens = append(i.tokens[:idx], i.tokens[idx+1:]...)
+	}
+}
+
+func (i *Intermediary) InsertBlanklineFromEnd(indexFromEnd int) {
+	insertPosition := len(i.tokens) - indexFromEnd
+	if insertPosition < 0 {
+		insertPosition = 0
+	}
+	i.tokens = append(i.tokens, nil)
+	copy(i.tokens[insertPosition+1:], i.tokens[insertPosition:])
+	i.tokens[insertPosition] = NewConcrete(THardNewLine)
+	if insertPosition <= i.indexOfLastHardNewline {
+		i.indexOfLastHardNewline++
+	}
+}
+
+func (i *Intermediary) InsertTrailingBlankline(_ BlanklineReason) {
+	if i.indexOfLastHardNewline <= 2 {
+		i.tokens = append(i.tokens, nil)
+		copy(i.tokens[i.indexOfLastHardNewline+1:], i.tokens[i.indexOfLastHardNewline:])
+		i.tokens[i.indexOfLastHardNewline] = NewConcrete(THardNewLine)
+		i.indexOfLastHardNewline++
+		return
+	}
+	prev2 := i.tokens[i.indexOfLastHardNewline-2]
+	prev1 := i.tokens[i.indexOfLastHardNewline-1]
+	var current *ConcreteToken
+	if i.indexOfLastHardNewline < len(i.tokens) {
+		current = i.tokens[i.indexOfLastHardNewline]
+	}
+	if prev2.Kind == THardNewLine && prev1.Kind == TIndent && current != nil && current.Kind == THardNewLine {
+		return
+	}
+	if prev1.Kind == THardNewLine && current != nil && current.Kind == THardNewLine {
+		return
+	}
+	i.tokens = append(i.tokens, nil)
+	copy(i.tokens[i.indexOfLastHardNewline+1:], i.tokens[i.indexOfLastHardNewline:])
+	i.tokens[i.indexOfLastHardNewline] = NewConcrete(THardNewLine)
+	i.indexOfLastHardNewline++
+}
+
+func (i *Intermediary) LastN(n int) []*ConcreteToken {
+	if len(i.tokens) < n {
+		return nil
+	}
+	return i.tokens[len(i.tokens)-n:]
+}
diff --git a/internal/formatter/node.go b/internal/formatter/node.go
new file mode 100644
index 0000000..82c72e0
--- /dev/null
+++ b/internal/formatter/node.go
@@ -0,0 +1,195 @@
+package formatter
+
+import (
+	"encoding/json"
+	"strings"
+)
+
+// Node is a decoded Prism AST node. Field names match the Prism binding API.
+type Node map[string]any
+
+// DecodeNode decodes a JSON AST document into a Node tree.
+func DecodeNode(raw []byte) (Node, error) {
+	var n Node
+	if err := json.Unmarshal(raw, &n); err != nil {
+		return nil, err
+	}
+	return n, nil
+}
+
+func (n Node) Type() string {
+	if n == nil {
+		return ""
+	}
+	s, _ := n["type"].(string)
+	return s
+}
+
+func (n Node) Is(typ string) bool {
+	return n.Type() == typ
+}
+
+func (n Node) Get(key string) Node {
+	if n == nil {
+		return nil
+	}
+	if child, ok := n[key].(map[string]any); ok && child != nil {
+		return Node(child)
+	}
+	return nil
+}
+
+func (n Node) List(key string) []Node {
+	if n == nil {
+		return nil
+	}
+	raw, ok := n[key].([]any)
+	if !ok {
+		return nil
+	}
+	out := make([]Node, 0, len(raw))
+	for _, item := range raw {
+		if child, ok := item.(map[string]any); ok {
+			out = append(out, Node(child))
+		}
+	}
+	return out
+}
+
+func (n Node) Str(key string) string {
+	if n == nil {
+		return ""
+	}
+	s, _ := n[key].(string)
+	return s
+}
+
+func (n Node) Has(key string) bool {
+	if n == nil {
+		return false
+	}
+	v, ok := n[key]
+	return ok && v != nil
+}
+
+func (n Node) Flags(key string) []string {
+	if n == nil {
+		return nil
+	}
+	raw, ok := n[key].([]any)
+	if !ok {
+		return nil
+	}
+	out := make([]string, 0, len(raw))
+	for _, item := range raw {
+		if s, ok := item.(string); ok {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+func (n Node) HasFlag(key, flag string) bool {
+	for _, f := range n.Flags(key) {
+		if f == flag {
+			return true
+		}
+	}
+	return false
+}
+
+// Loc returns the node's location. A nil node has an empty location at 0.
+func (n Node) Loc() Loc {
+	if n == nil {
+		return Loc{}
+	}
+	return newLoc(n.Get("location"))
+}
+
+// LocField returns a location-valued field, or nil if absent.
+func (n Node) LocField(key string) *Loc {
+	if n == nil {
+		return nil
+	}
+	m, ok := n[key].(map[string]any)
+	if !ok || m == nil {
+		return nil
+	}
+	loc := newLoc(Node(m))
+	return &loc
+}
+
+// Loc returns the location stored directly in a location object node.
+func newLoc(n Node) Loc {
+	if n == nil {
+		return Loc{}
+	}
+	start, _ := n["start"].(float64)
+	end, _ := n["end"].(float64)
+	return Loc{Start: int(start), End: int(end)}
+}
+
+type Loc struct {
+	Start int
+	End   int
+}
+
+func nameBytes(ps *ParserState, n Node) []byte {
+	name := []byte(n.Str("name"))
+	ascii := true
+	for _, b := range name {
+		if b >= 0x80 {
+			ascii = false
+			break
+		}
+	}
+	if ascii {
+		return name
+	}
+	return ps.nodeBytes(n, "location")
+}
+
+func (n Node) Start() int { return n.Loc().Start }
+func (n Node) End() int   { return n.Loc().End }
+
+// Source gives byte-slice access to the original Ruby source.
+type Source struct {
+	data []byte
+}
+
+func NewSource(data []byte) *Source {
+	return &Source{data: data}
+}
+
+func (s *Source) Slice(loc *Loc) []byte {
+	if loc == nil {
+		return nil
+	}
+	start, end := loc.Start, loc.End
+	if start < 0 {
+		start = 0
+	}
+	if end > len(s.data) {
+		end = len(s.data)
+	}
+	if start > end || start > len(s.data) {
+		return nil
+	}
+	return s.data[start:end]
+}
+
+func (s *Source) SliceNode(n Node) []byte {
+	return s.Slice(n.LocField("location"))
+}
+
+func trimASCIIEnd(b []byte) []byte {
+	return []byte(strings.TrimRight(string(b), " \t\r\n\v\f"))
+}
+
+func trimASCII(b []byte) []byte {
+	return []byte(strings.Trim(string(b), " \t\r\n\v\f"))
+}
+
+func locSlice(src *Source, n Node, key string) []byte {
+	return src.Slice(n.LocField(key))
+}
diff --git a/internal/formatter/parser_state.go b/internal/formatter/parser_state.go
new file mode 100644
index 0000000..0bbad8d
--- /dev/null
+++ b/internal/formatter/parser_state.go
@@ -0,0 +1,740 @@
+package formatter
+
+import "bytes"
+
+type FCKind int
+
+const (
+	FCMain FCKind = iota
+	FCBinary
+	FCClassOrModule
+	FCDef
+	FCIfOp
+	FCStringEmbexpr
+	FCHashType
+)
+
+type HashType int
+
+const (
+	HashSymbolKey HashType = iota
+	HashRocket
+)
+
+type FormattingContext struct {
+	Kind     FCKind
+	HashType HashType
+}
+
+func MainContext() FormattingContext          { return FormattingContext{Kind: FCMain} }
+func BinaryContext() FormattingContext        { return FormattingContext{Kind: FCBinary} }
+func ClassOrModuleContext() FormattingContext { return FormattingContext{Kind: FCClassOrModule} }
+func DefContext() FormattingContext           { return FormattingContext{Kind: FCDef} }
+func IfOpContext() FormattingContext          { return FormattingContext{Kind: FCIfOp} }
+func StringEmbexprContext() FormattingContext { return FormattingContext{Kind: FCStringEmbexpr} }
+func HashTypeContext(ht HashType) FormattingContext {
+	return FormattingContext{Kind: FCHashType, HashType: ht}
+}
+
+type IndentDepth struct {
+	depth uint32
+}
+
+func (i *IndentDepth) Increment()  { i.depth++ }
+func (i *IndentDepth) Decrement()  { i.depth-- }
+func (i *IndentDepth) Get() uint32 { return i.depth }
+
+type ParserState struct {
+	indentDepth                IndentDepth
+	startOfLine                []bool
+	suppressCommentsStack      []bool
+	renderQueue                BaseQueue
+	currentOrigLineNumber      int
+	commentsHash               *FileComments
+	heredocStrings             []*HeredocString
+	commentsToInsert           *CommentBlock
+	breakableEntryStack        []*Breakable
+	formattingContext          []FormattingContext
+	insertUserNewlines         bool
+	spacesAfterLastNewline     uint32
+	scopes                     [][][]byte
+	insideSquigglyHeredoc      bool
+	source                     *Source
+	suppressBlankBeforeComment bool
+}
+
+func NewParserState(fc *FileComments) *ParserState {
+	return &ParserState{
+		startOfLine:           []bool{true},
+		suppressCommentsStack: []bool{false},
+		commentsHash:          fc,
+		formattingContext:     []FormattingContext{MainContext()},
+		insertUserNewlines:    true,
+		scopes:                [][][]byte{{}},
+	}
+}
+
+func (ps *ParserState) slice(loc *Loc) []byte {
+	return ps.source.Slice(loc)
+}
+
+func (ps *ParserState) nodeBytes(n Node, key string) []byte {
+	return ps.slice(n.LocField(key))
+}
+
+func (ps *ParserState) scopeHasVariable(s []byte) bool {
+	scope := ps.scopes[len(ps.scopes)-1]
+	for _, v := range scope {
+		if bytes.Equal(v, s) {
+			return true
+		}
+	}
+	return false
+}
+
+func (ps *ParserState) newScope(f func(*ParserState)) {
+	ps.scopes = append(ps.scopes, [][]byte{})
+	f(ps)
+	ps.scopes = ps.scopes[:len(ps.scopes)-1]
+}
+
+func (ps *ParserState) bindVariable(s []byte) {
+	ps.scopes[len(ps.scopes)-1] = append(ps.scopes[len(ps.scopes)-1], s)
+}
+
+func (ps *ParserState) pushHeredocContent(symbol []byte, kind HeredocKind, endLine int, f func(*ParserState)) {
+	next := newWithResetIndentation(ps)
+	next.insideSquigglyHeredoc = kind.IsSquiggly() || ps.insideSquigglyHeredoc
+	f(next)
+
+	ps.heredocStrings = append(ps.heredocStrings, next.heredocStrings...)
+	next.heredocStrings = nil
+
+	ps.commentsHash.ExtractCommentsToLine(ps.currentOrigLineNumber, endLine, false)
+	ps.currentOrigLineNumber = endLine
+
+	segments := next.renderToSegments()
+	ps.heredocStrings = append(ps.heredocStrings, &HeredocString{
+		Symbol:   append([]byte{}, symbol...),
+		Kind:     kind,
+		Segments: segments,
+		Indent:   ps.currentSpaces(),
+	})
+}
+
+func (ps *ParserState) emitHeredocStart(symbol []byte, kind HeredocKind) {
+	ps.pushConcreteToken(HeredocStartToken(kind, symbol))
+}
+
+func (ps *ParserState) emitHeredocClose(symbol []byte) {
+	ps.pushConcreteToken(HeredocCloseToken(symbol))
+}
+
+func (ps *ParserState) magicHandleCommentsForMultilineArrays(endLine *int, f func(*ParserState)) {
+	currentLineNumber := ps.currentOrigLineNumber
+	ps.newBlock(func(ps *ParserState) { ps.shiftComments() })
+	f(ps)
+	ps.resetSpaceCount()
+	newLineNumber := ps.currentOrigLineNumber
+	if newLineNumber > currentLineNumber {
+		if ps.commentsHash.IsEmptyLine(newLineNumber + 1) {
+			if endLine != nil {
+				ps.windDumpingCommentsUntilLine(*endLine)
+			}
+			if ps.commentsToInsert != nil && ps.commentsToInsert.HasComments() {
+				ps.pushConcreteToken(NewConcrete(THardNewLine))
+			}
+			index := 0
+			if len(ps.breakableEntryStack) > 0 {
+				index = ps.breakableEntryStack[len(ps.breakableEntryStack)-1].Len()
+			} else if idx, ok := ps.indexOfPrevHardNewline(); ok {
+				index = idx
+			}
+			ps.shiftCommentsAtIndex(index)
+		} else {
+			ps.shiftComments()
+		}
+	}
+}
+
+func (ps *ParserState) hasCommentInOffsetSpan(start, end int) bool {
+	return ps.commentsHash.HasCommentInOffsets(start, end)
+}
+
+func (ps *ParserState) resetSpaceCount() {
+	ps.spacesAfterLastNewline = ps.currentSpaces()
+}
+
+func (ps *ParserState) dedent(f func(*ParserState)) {
+	ps.endIndent()
+	f(ps)
+	ps.startIndent()
+}
+
+func (ps *ParserState) startIndent() { ps.indentDepth.Increment() }
+func (ps *ParserState) endIndent()   { ps.indentDepth.Decrement() }
+
+func (ps *ParserState) startIndentForCallChain() {
+	ps.pushConcreteToken(NewConcrete(TBeginCallChainIndent))
+}
+func (ps *ParserState) endIndentForCallChain() {
+	ps.pushConcreteToken(NewConcrete(TEndCallChainIndent))
+}
+
+func (ps *ParserState) withStartOfLine(start bool, f func(*ParserState)) {
+	ps.startOfLine = append(ps.startOfLine, start)
+	f(ps)
+	ps.startOfLine = ps.startOfLine[:len(ps.startOfLine)-1]
+}
+
+func (ps *ParserState) breakableOf(delims BreakableDelims, f func(*ParserState)) {
+	ps.shiftComments()
+	be := NewBreakableEntry(delims, ps.formattingContext)
+	be.PushLineNumber(ps.currentOrigLineNumber)
+	ps.breakableEntryStack = append(ps.breakableEntryStack, &Breakable{Kind: BDelimiter, BE: be})
+
+	ps.newBlock(func(ps *ParserState) {
+		ps.emitCollapsingNewline()
+		f(ps)
+		ps.emitCollapsingNewline()
+	})
+
+	ps.resetSpaceCount()
+	ps.shiftComments()
+	ps.emitSoftIndent()
+
+	last := ps.breakableEntryStack[len(ps.breakableEntryStack)-1]
+	ps.breakableEntryStack = ps.breakableEntryStack[:len(ps.breakableEntryStack)-1]
+	insertBE := last.IntoBreakableEntry()
+	ps.pushTarget(QueueBreakableEntry(insertBE))
+}
+
+func (ps *ParserState) inlineBreakableOf(delims BreakableDelims, f func(*ParserState)) {
+	ps.shiftComments()
+	be := NewBreakableEntry(delims, ps.formattingContext)
+	be.PushLineNumber(ps.currentOrigLineNumber)
+	ps.breakableEntryStack = append(ps.breakableEntryStack, &Breakable{Kind: BDelimiter, BE: be})
+
+	ps.newBlock(f)
+
+	ps.resetSpaceCount()
+	ps.shiftComments()
+
+	last := ps.breakableEntryStack[len(ps.breakableEntryStack)-1]
+	ps.breakableEntryStack = ps.breakableEntryStack[:len(ps.breakableEntryStack)-1]
+	insertBE := last.IntoBreakableEntry()
+	ps.pushTarget(QueueBreakableEntry(insertBE))
+}
+
+func (ps *ParserState) breakableCallChainOf(isUserMultilined bool, f func(*ParserState)) {
+	ps.shiftComments()
+	be := NewBreakableCallChainEntry(ps.formattingContext, isUserMultilined)
+	ps.breakableEntryStack = append(ps.breakableEntryStack, &Breakable{Kind: BCallChain, BCCE: be})
+
+	f(ps)
+
+	last := ps.breakableEntryStack[len(ps.breakableEntryStack)-1]
+	ps.breakableEntryStack = ps.breakableEntryStack[:len(ps.breakableEntryStack)-1]
+	insert := last.IntoBreakableCallChain()
+	ps.pushTarget(QueueCallChain(insert))
+}
+
+func (ps *ParserState) newBlock(f func(*ParserState)) {
+	ps.startIndent()
+	f(ps)
+	ps.endIndent()
+}
+
+func (ps *ParserState) withFormattingContext(fc FormattingContext, f func(*ParserState)) {
+	ps.formattingContext = append(ps.formattingContext, fc)
+	f(ps)
+	ps.formattingContext = ps.formattingContext[:len(ps.formattingContext)-1]
+}
+
+func (ps *ParserState) onLine(lineNumber int) {
+	if lineNumber < ps.currentOrigLineNumber {
+		return
+	}
+	for i := len(ps.breakableEntryStack) - 1; i >= 0; i-- {
+		ps.breakableEntryStack[i].PushLineNumber(lineNumber)
+	}
+	if comments, lastCommentLine, ok := ps.commentsHash.ExtractCommentsToLine(ps.currentOrigLineNumber, lineNumber, ps.suppressBlankBeforeComment); ok {
+		ps.pushComments(comments)
+		if lastCommentLine > ps.currentOrigLineNumber {
+			ps.currentOrigLineNumber = lastCommentLine
+		}
+	}
+	if lineDifferenceRequiresNewline(lineNumber, ps.currentOrigLineNumber) && ps.insertUserNewlines {
+		ps.insertExtraNewlineAtLastNewline()
+	}
+	ps.currentOrigLineNumber = lineNumber
+}
+
+func (ps *ParserState) atOffset(sourceOffset int) {
+	ps.onLine(ps.getLineNumberForOffset(sourceOffset))
+}
+
+func (ps *ParserState) emitIndent() {
+	ps.pushConcreteToken(IndentToken(ps.currentSpaces()))
+}
+
+func (ps *ParserState) atStartOfLine() bool {
+	return ps.startOfLine[len(ps.startOfLine)-1]
+}
+
+func (ps *ParserState) hasCommentsInLine(startLine, endLine int) bool {
+	return ps.commentsHash.HasCommentsInLines(startLine, endLine)
+}
+
+func (ps *ParserState) insertCommentCollection(comments *CommentBlock) {
+	comments = comments.EnforceAtLeastOneSpaceAfterCommentSymbol().ApplySpaces(ps.spacesAfterLastNewline)
+	mergeCommentBlock(&ps.commentsToInsert, comments)
+}
+
+func (ps *ParserState) emitOp(op []byte) {
+	ps.pushConcreteToken(OpToken(op))
+}
+
+func (ps *ParserState) emitDoubleQuote() {
+	ps.pushConcreteToken(NewConcrete(TDoubleQuote))
+}
+
+func (ps *ParserState) emitStringContent(s []byte) {
+	newlineCount := bytes.Count(s, []byte{'\n'})
+	ps.currentOrigLineNumber += newlineCount
+	for i := len(ps.breakableEntryStack) - 1; i >= 0; i-- {
+		ps.breakableEntryStack[i].PushLineNumber(ps.currentOrigLineNumber)
+	}
+	ps.pushConcreteToken(StringContentToken(s))
+}
+
+func (ps *ParserState) emitIdent(ident []byte) {
+	ps.pushConcreteToken(DirectPartToken(ident))
+}
+
+func (ps *ParserState) emitMethodName(name []byte) {
+	ps.pushConcreteToken(MethodNameToken(name))
+}
+
+func (ps *ParserState) emitNewline() {
+	ps.shiftComments()
+	ps.pushConcreteToken(NewConcrete(THardNewLine))
+	ps.renderHeredocs(false)
+	ps.spacesAfterLastNewline = ps.currentSpaces()
+}
+
+func (ps *ParserState) emitHardNewlineInHeredoc() {
+	ps.pushConcreteToken(NewConcrete(THardNewLine))
+}
+
+func (ps *ParserState) windDumpingCommentsUntilLine(lineNumber int) {
+	ps.windDumpingComments(&lineNumber)
+}
+
+func (ps *ParserState) windDumpingCommentsUntilOffset(sourceOffset int) {
+	line := ps.getLineNumberForOffset(sourceOffset)
+	ps.windDumpingCommentsUntilLine(line)
+}
+
+func (ps *ParserState) windDumpingComments(maybeMax *int) {
+	if maybeMax != nil && *maybeMax <= ps.currentOrigLineNumber {
+		return
+	}
+	ps.onLine(ps.currentOrigLineNumber + 1)
+	shouldIter := func(ps *ParserState, ln int) bool {
+		if maybeMax != nil && ln+1 == *maybeMax {
+			return true
+		}
+		return ps.commentsHash.StillInFile(ln+1) &&
+			(ps.commentsHash.HasLine(ln+1) || ps.commentsHash.IsEmptyLine(ln+1)) &&
+			(maybeMax == nil || ln+1 < *maybeMax)
+	}
+	for shouldIter(ps, ps.currentOrigLineNumber) {
+		if !ps.commentsHash.HasLine(ps.currentOrigLineNumber+1) &&
+			ps.commentsHash.IsEmptyLine(ps.currentOrigLineNumber+1) &&
+			ps.commentsToInsert != nil && ps.commentsToInsert.LineCount() > 0 {
+			ps.commentsToInsert.AddLine([]byte{})
+		}
+		ps.onLine(ps.currentOrigLineNumber + 1)
+	}
+}
+
+func (ps *ParserState) emitEnd() {
+	if !ps.lastTokenIsANewline() {
+		ps.emitNewline()
+	}
+	if ps.atStartOfLine() {
+		ps.emitIndent()
+	}
+	ps.pushConcreteToken(NewConcrete(TEnd))
+}
+
+func (ps *ParserState) emitComma() {
+	ps.pushConcreteToken(NewConcrete(TComma))
+}
+
+func (ps *ParserState) shiftComments() {
+	if idx, ok := ps.indexOfPrevHardNewline(); ok {
+		ps.shiftCommentsAtIndex(idx)
+	} else {
+		ps.shiftCommentsAtIndex(0)
+	}
+}
+
+func (ps *ParserState) shiftCommentsAtIndex(index int) {
+	if ps.commentsToInsert != nil {
+		newComments := ps.commentsToInsert
+		ps.commentsToInsert = nil
+		ps.insertConcreteTokens(index, newComments.IntoLineTokens())
+	}
+}
+
+func (ps *ParserState) emitSoftNewline() {
+	ps.newBlock(func(ps *ParserState) { ps.shiftComments() })
+	hd := ps.gatherHeredocs()
+	ps.pushAbstractToken(AbstractSoftNewline(hd))
+	ps.spacesAfterLastNewline = ps.currentSpaces()
+}
+
+func (ps *ParserState) emitSoftIndent() {
+	ps.pushAbstractToken(AbstractSoftIndent(ps.currentSpaces()))
+}
+
+func (ps *ParserState) emitCollapsingNewline() {
+	if !ps.lastTokenIsANewline() {
+		hd := ps.gatherHeredocs()
+		ps.pushAbstractToken(AbstractCollapsing(hd))
+	}
+	ps.spacesAfterLastNewline = ps.currentSpaces()
+}
+
+func (ps *ParserState) emitAfterCallChain() {
+	ps.pushConcreteToken(NewConcrete(TAfterCallChain))
+}
+
+func (ps *ParserState) emitSpace() {
+	ps.pushConcreteToken(NewConcrete(TSpace))
+}
+
+func (ps *ParserState) emitOpenParen()         { ps.pushConcreteToken(NewConcrete(TOpenParen)) }
+func (ps *ParserState) emitCommaSpace()        { ps.pushConcreteToken(NewConcrete(TCommaSpace)) }
+func (ps *ParserState) emitCloseParen()        { ps.pushConcreteToken(NewConcrete(TCloseParen)) }
+func (ps *ParserState) emitSlash()             { ps.pushConcreteToken(NewConcrete(TSingleSlash)) }
+func (ps *ParserState) emitCloseCurlyBracket() { ps.pushConcreteToken(NewConcrete(TCloseCurlyBracket)) }
+func (ps *ParserState) emitOpenCurlyBracket()  { ps.pushConcreteToken(NewConcrete(TOpenCurlyBracket)) }
+func (ps *ParserState) emitCloseSquareBracket() {
+	ps.pushConcreteToken(NewConcrete(TCloseSquareBracket))
+}
+func (ps *ParserState) emitOpenSquareBracket() { ps.pushConcreteToken(NewConcrete(TOpenSquareBracket)) }
+
+func (ps *ParserState) emitRescue()        { ps.pushConcreteToken(KeywordToken([]byte("rescue"))) }
+func (ps *ParserState) emitCaseKeyword()   { ps.pushConcreteToken(KeywordToken([]byte("case"))) }
+func (ps *ParserState) emitWhenKeyword()   { ps.pushConcreteToken(KeywordToken([]byte("when"))) }
+func (ps *ParserState) emitInKeyword()     { ps.pushConcreteToken(KeywordToken([]byte("in"))) }
+func (ps *ParserState) emitDoKeyword()     { ps.pushConcreteToken(NewConcrete(TDoKeyword)) }
+func (ps *ParserState) emitClassKeyword()  { ps.pushConcreteToken(NewConcrete(TClassKeyword)) }
+func (ps *ParserState) emitModuleKeyword() { ps.pushConcreteToken(NewConcrete(TModuleKeyword)) }
+func (ps *ParserState) emitElse()          { ps.emitConditionalKeyword([]byte("else")) }
+
+func (ps *ParserState) emitData(data []byte) {
+	ps.pushConcreteToken(DirectPartToken(data))
+}
+
+func (ps *ParserState) currentFormattingContextRequiresParens() bool {
+	k := ps.currentFormattingContext().Kind
+	return k == FCBinary || k == FCIfOp
+}
+
+func (ps *ParserState) hashTypeFromFormattingContext() *HashType {
+	for i := len(ps.formattingContext) - 1; i >= 0; i-- {
+		if ps.formattingContext[i].Kind == FCHashType {
+			ht := ps.formattingContext[i].HashType
+			return &ht
+		}
+	}
+	return nil
+}
+
+func (ps *ParserState) emitDot()            { ps.pushConcreteToken(NewConcrete(TDot)) }
+func (ps *ParserState) emitLonelyOperator() { ps.pushConcreteToken(NewConcrete(TLonelyOperator)) }
+func (ps *ParserState) emitColonColon()     { ps.pushConcreteToken(NewConcrete(TColonColon)) }
+
+func (ps *ParserState) currentFormattingContext() FormattingContext {
+	return ps.formattingContext[len(ps.formattingContext)-1]
+}
+
+func (ps *ParserState) getLineNumberForOffset(offset int) int {
+	return ps.commentsHash.GetLineNumberForOffset(offset)
+}
+
+func (ps *ParserState) renderHeredocs(skip bool) {
+	heredocs := ps.heredocStrings
+	ps.heredocStrings = nil
+	for _, next := range heredocs {
+		wantNewline := !ps.lastTokenIsANewline()
+		if wantNewline {
+			ps.pushConcreteToken(NewConcrete(THardNewLine))
+		}
+		kind := next.Kind
+		symbol := next.ClosingSymbol()
+		spaceCount := next.Indent
+		stringContents := next.RenderAsBytes()
+		emitAsRaw := ps.insideSquigglyHeredoc && !kind.IsSquiggly()
+
+		if len(stringContents) != 0 {
+			if emitAsRaw {
+				ps.pushConcreteToken(RawHeredocContentToken(stringContents))
+			} else {
+				ps.pushConcreteToken(DirectPartToken(stringContents))
+			}
+			ps.emitNewline()
+		}
+
+		if emitAsRaw {
+			var closeContent []byte
+			if kind.IsBare() {
+				closeContent = symbol
+			} else {
+				closeContent = append(getIndent(int(spaceCount)), symbol...)
+			}
+			ps.pushConcreteToken(RawHeredocContentToken(closeContent))
+		} else {
+			if !kind.IsBare() {
+				ps.pushConcreteToken(IndentToken(spaceCount))
+			}
+			ps.emitHeredocClose(symbol)
+		}
+
+		if !skip {
+			ps.emitNewline()
+		}
+	}
+}
+
+func (ps *ParserState) emitDefKeyword() { ps.pushConcreteToken(NewConcrete(TDefKeyword)) }
+
+func (ps *ParserState) emitKeyword(keyword []byte) {
+	ps.pushConcreteToken(KeywordToken(keyword))
+}
+
+func (ps *ParserState) emitConditionalKeyword(contents []byte) {
+	ps.pushConcreteToken(ConditionalKeywordToken(contents))
+}
+
+func (ps *ParserState) consumeToRenderQueue() []QueueItem {
+	return ps.renderQueue.IntoTokens()
+}
+
+func (ps *ParserState) gatherHeredocs() []*HeredocString {
+	if len(ps.heredocStrings) == 0 {
+		return nil
+	}
+	out := make([]*HeredocString, len(ps.heredocStrings))
+	for i := range ps.heredocStrings {
+		out[len(ps.heredocStrings)-1-i] = ps.heredocStrings[i]
+	}
+	ps.heredocStrings = nil
+	return out
+}
+
+func (ps *ParserState) pushComments(comments *CommentBlock) {
+	if !ps.suppressCommentsStack[len(ps.suppressCommentsStack)-1] {
+		lineCount := comments.LineCount()
+		trailingComment := comments.IsTrailing()
+		ps.insertCommentCollection(comments)
+		if !trailingComment {
+			ps.currentOrigLineNumber += lineCount
+		}
+	}
+}
+
+func (ps *ParserState) insertExtraNewlineAtLastNewline() {
+	idx, ok := ps.indexOfPrevHardNewline()
+	if !ok {
+		idx = 0
+	}
+	if len(ps.breakableEntryStack) > 0 {
+		bs := ps.breakableEntryStack[len(ps.breakableEntryStack)-1]
+		bs.InsertAt(idx, []AbstractToken{AbstractConcrete(NewConcrete(THardNewLine))})
+	} else {
+		ps.insertConcreteTokens(idx, []*ConcreteToken{NewConcrete(THardNewLine)})
+	}
+}
+
+func (ps *ParserState) currentSpaces() uint32 {
+	return 2 * ps.indentDepth.Get()
+}
+
+func (ps *ParserState) disableUserNewlines() { ps.insertUserNewlines = false }
+
+func (ps *ParserState) withUserNewlinesDisabled(f func(*ParserState)) {
+	saved := ps.insertUserNewlines
+	savedBlank := ps.suppressBlankBeforeComment
+	ps.insertUserNewlines = false
+	ps.suppressBlankBeforeComment = true
+	f(ps)
+	ps.insertUserNewlines = saved
+	ps.suppressBlankBeforeComment = savedBlank
+}
+
+func (ps *ParserState) lastTokenIsANewline() bool {
+	if len(ps.breakableEntryStack) > 0 {
+		return ps.breakableEntryStack[len(ps.breakableEntryStack)-1].LastTokenIsANewline()
+	}
+	return ps.renderQueue.LastTokenIsANewline()
+}
+
+func (ps *ParserState) indexOfPrevHardNewline() (int, bool) {
+	if len(ps.breakableEntryStack) > 0 {
+		return ps.breakableEntryStack[len(ps.breakableEntryStack)-1].IndexOfPrevNewline()
+	}
+	return ps.renderQueue.IndexOfPrevNewline()
+}
+
+func newWithResetIndentation(ps *ParserState) *ParserState {
+	next := NewParserState(NewFileComments())
+	next.commentsHash = ps.commentsHash.Clone()
+	next.startOfLine = append([]bool{}, ps.startOfLine...)
+	next.currentOrigLineNumber = ps.currentOrigLineNumber
+	next.source = ps.source
+	return next
+}
+
+func (ps *ParserState) renderToSegments() []HeredocSegment {
+	rqw := NewRenderQueueWriter(ps.consumeToRenderQueue())
+	finalTokens := rqw.IntoTokens()
+	var segments []HeredocSegment
+	var currentNormal []byte
+	flushNormal := func() {
+		if len(currentNormal) != 0 {
+			segments = append(segments, HeredocSegment{Raw: false, Content: currentNormal})
+			currentNormal = nil
+		}
+	}
+	for _, token := range finalTokens {
+		if token.Kind == TRawHeredocContent {
+			flushNormal()
+			segments = append(segments, HeredocSegment{Raw: true, Content: token.Data})
+		} else {
+			currentNormal = append(currentNormal, token.IntoRuby()...)
+		}
+	}
+	flushNormal()
+	return segments
+}
+
+func (ps *ParserState) hasPendingHeredocs() bool { return len(ps.heredocStrings) > 0 }
+
+func (ps *ParserState) Write() []byte {
+	rqw := NewRenderQueueWriter(ps.consumeToRenderQueue())
+	return rqw.Write()
+}
+
+func dangerouslyConvert(t AbstractToken) QueueItem {
+	switch t.Kind {
+	case AConcrete:
+		return QueueConcrete(t.CT)
+	case ABreakableEntry:
+		return QueueBreakableEntry(t.BE)
+	case ABreakableCallChain:
+		return QueueCallChain(t.BCCE)
+	}
+	return QueueItem{}
+}
+
+func (ps *ParserState) flushStartOfFileComments() {
+	comments := ps.commentsHash.TakeStartOfFileContiguousCommentLines()
+	if comments == nil {
+		ps.onLine(1)
+		return
+	}
+	comments = comments.EnforceAtLeastOneSpaceAfterCommentSymbol()
+	lineCount := comments.LineCount()
+	for _, token := range comments.IntoLineTokens() {
+		ps.pushConcreteToken(token)
+	}
+	ps.currentOrigLineNumber = lineCount
+}
+
+func (ps *ParserState) insertConcreteTokens(insertIdx int, clts []*ConcreteToken) {
+	var abstract []AbstractToken
+	for _, t := range clts {
+		abstract = append(abstract, AbstractConcrete(t))
+	}
+	if len(ps.breakableEntryStack) > 0 {
+		ps.breakableEntryStack[len(ps.breakableEntryStack)-1].InsertAt(insertIdx, abstract)
+	} else {
+		var items []QueueItem
+		for _, t := range clts {
+			items = append(items, QueueConcrete(t))
+		}
+		ps.renderQueue.InsertAt(insertIdx, items)
+	}
+}
+
+func (ps *ParserState) pushConcreteToken(t *ConcreteToken) {
+	if len(ps.breakableEntryStack) > 0 {
+		ps.breakableEntryStack[len(ps.breakableEntryStack)-1].Push(AbstractConcrete(t))
+	} else {
+		ps.renderQueue.Push(QueueConcrete(t))
+	}
+}
+
+func (ps *ParserState) pushTarget(t QueueItem) {
+	if len(ps.breakableEntryStack) > 0 {
+		switch t.Kind {
+		case QConcrete:
+			ps.breakableEntryStack[len(ps.breakableEntryStack)-1].Push(AbstractConcrete(t.CT))
+		case QBreakableEntry:
+			ps.breakableEntryStack[len(ps.breakableEntryStack)-1].Push(AbstractBreakable(t.BE))
+		case QCallChain:
+			ps.breakableEntryStack[len(ps.breakableEntryStack)-1].Push(AbstractCallChain(t.BCCE))
+		case QConditional:
+			ps.breakableEntryStack[len(ps.breakableEntryStack)-1].Push(AbstractConditional(t.CLE))
+		}
+	} else {
+		ps.renderQueue.Push(t)
+	}
+}
+
+func (ps *ParserState) pushAbstractToken(t AbstractToken) {
+	if len(ps.breakableEntryStack) > 0 {
+		ps.breakableEntryStack[len(ps.breakableEntryStack)-1].Push(t)
+	} else {
+		ps.renderQueue.Push(dangerouslyConvert(t))
+	}
+}
+
+func (ps *ParserState) conditionalLayoutOf(keyword []byte, formatPredicate, formatStatement func(*ParserState)) {
+	savedComments := ps.commentsToInsert
+	ps.commentsToInsert = nil
+
+	entry := NewConditionalLayoutEntry(keyword, ps.currentSpaces())
+	ps.breakableEntryStack = append(ps.breakableEntryStack, &Breakable{Kind: BInlineConditional, CLE: entry})
+
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.newBlock(formatStatement)
+	})
+
+	ps.breakableEntryStack[len(ps.breakableEntryStack)-1].CLE.SwitchToPredicate()
+
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.newBlock(formatPredicate)
+	})
+
+	last := ps.breakableEntryStack[len(ps.breakableEntryStack)-1]
+	ps.breakableEntryStack = ps.breakableEntryStack[:len(ps.breakableEntryStack)-1]
+	cle := last.IntoConditionalLayout()
+
+	outerSpaces := ps.currentSpaces()
+	var accumulated *CommentBlock
+	if ps.commentsToInsert != nil {
+		accumulated = ps.commentsToInsert.ApplySpaces(outerSpaces)
+	}
+	ps.commentsToInsert = savedComments
+	if accumulated != nil {
+		mergeCommentBlock(&ps.commentsToInsert, accumulated)
+	}
+
+	ps.pushTarget(QueueConditional(cle))
+}
diff --git a/internal/formatter/render_queue_writer.go b/internal/formatter/render_queue_writer.go
new file mode 100644
index 0000000..f48f6b1
--- /dev/null
+++ b/internal/formatter/render_queue_writer.go
@@ -0,0 +1,191 @@
+package formatter
+
+import "bytes"
+
+const MaxLineLength = 120
+
+type RenderQueueWriter struct {
+	tokens []QueueItem
+}
+
+func NewRenderQueueWriter(tokens []QueueItem) *RenderQueueWriter {
+	return &RenderQueueWriter{tokens: tokens}
+}
+
+func (r *RenderQueueWriter) Write() []byte {
+	accum := NewIntermediary()
+	renderAs(accum, r.tokens)
+	return writeFinalTokens(accum.IntoTokens())
+}
+
+func (r *RenderQueueWriter) IntoTokens() []*ConcreteToken {
+	accum := NewIntermediary()
+	renderAs(accum, r.tokens)
+	return accum.IntoTokens()
+}
+
+func renderAs(accum *Intermediary, tokens []QueueItem) {
+	tokenLen := len(tokens)
+	var currentHeredocKind *HeredocKind
+
+	for index := 0; index < len(tokens); index++ {
+		nextToken := tokens[index]
+
+		if nextToken.Kind == QConcrete {
+			switch nextToken.CT.Kind {
+			case TIndent:
+				isEndingHeredocToken := index+1 < tokenLen && tokens[index+1].Kind == QConcrete && tokens[index+1].CT.Kind == THeredocClose
+				if !isEndingHeredocToken {
+					nextToken = QueueConcrete(IndentToken(nextToken.CT.Depth + uint32(accum.AdditionalIndent*2)))
+				}
+			case TComment:
+				if len(nextToken.CT.Data) != 0 {
+					indent := getIndent(accum.AdditionalIndent * 2)
+					contents := make([]byte, 0, len(indent)+len(nextToken.CT.Data))
+					contents = append(contents, indent...)
+					contents = append(contents, nextToken.CT.Data...)
+					nextToken = QueueConcrete(CommentToken(contents))
+				}
+			case TDirectPart:
+				if currentHeredocKind != nil && currentHeredocKind.IsSquiggly() {
+					indent := getIndent(accum.AdditionalIndent * 2)
+					var newContents []byte
+					parts := bytes.Split(nextToken.CT.Data, []byte{'\n'})
+					for i, p := range parts {
+						if i > 0 {
+							newContents = append(newContents, '\n')
+						}
+						if len(p) != 0 {
+							newContents = append(newContents, indent...)
+						}
+						newContents = append(newContents, p...)
+					}
+					nextToken = QueueConcrete(DirectPartToken(newContents))
+				}
+			case THeredocStart:
+				kind := nextToken.CT.HeredocKind
+				currentHeredocKind = &kind
+			case THeredocClose:
+				if currentHeredocKind != nil && !currentHeredocKind.IsBare() {
+					indent := getIndent(accum.AdditionalIndent * 2)
+					newContents := make([]byte, 0, len(indent)+len(nextToken.CT.Data))
+					newContents = append(newContents, indent...)
+					newContents = append(newContents, nextToken.CT.Data...)
+					nextToken = QueueConcrete(HeredocCloseToken(newContents))
+				}
+				currentHeredocKind = nil
+			}
+		}
+
+		switch nextToken.Kind {
+		case QBreakableEntry:
+			formatBreakableEntry(accum, nextToken.BE)
+		case QCallChain:
+			formatBreakableCallChainEntry(accum, nextToken.BCCE)
+		case QConditional:
+			formatConditionalLayoutEntry(accum, nextToken.CLE)
+		case QConcrete:
+			switch nextToken.CT.Kind {
+			case TBeginCallChainIndent:
+				accum.AdditionalIndent++
+			case TEndCallChainIndent:
+				accum.AdditionalIndent--
+			default:
+				accum.Push(nextToken.CT)
+			}
+		}
+
+		if last := accum.LastN(4); last != nil && last[0].Kind == TEnd && last[1].Kind == THardNewLine && last[2].Kind == TIndent && last[3].IsInNeedOfTrailingBlankline() {
+			accum.InsertTrailingBlankline(ComesAfterEnd)
+		}
+
+		if last := accum.LastN(7); last != nil && last[0].Kind == TEnd && last[1].Kind == TAfterCallChain && last[2].Kind == THardNewLine && last[3].Kind == TIndent {
+			x := last[4]
+			maybeSpace := last[5]
+			maybeDef := last[6]
+			if x.Kind != TDefKeyword {
+				if x.IsInNeedOfTrailingBlankline() && !(maybeSpace.Kind == TSpace && maybeDef.Kind == TDefKeyword) {
+					const lastNewlineIndexFromEnd = 4
+					accum.InsertBlanklineFromEnd(lastNewlineIndexFromEnd)
+				}
+			}
+		}
+
+		if last := accum.LastN(5); last != nil && last[0].Kind == THeredocClose && last[1].Kind == THardNewLine && last[2].Kind == TIndent && last[3].Kind == TIndent {
+			k := last[4].Kind
+			if k == TDelim || k == TDot || k == TDirectPart || k == TMethodName {
+				accum.FixHeredocDuplicateIndentMistake()
+			}
+		}
+	}
+}
+
+func formatBreakableEntry(accum *Intermediary, be *BreakableEntry) {
+	forceSingleLine := be.InStringEmbexpr() && !be.AnyCollapsingNewlineHasHeredocContent() && !be.ContainsHardNewline()
+
+	var tokens []QueueItem
+	if !forceSingleLine && (be.IsMultiline() || rendersOverMaxLineLength(accum, be)) {
+		be.WriteTokens(MultiLine, &tokens)
+		renderAs(accum, tokens)
+	} else {
+		be.WriteTokens(SingleLine, &tokens)
+		renderAs(accum, tokens)
+		accum.ClearBreakableGarbage()
+	}
+}
+
+func formatBreakableCallChainEntry(accum *Intermediary, bcce *BreakableCallChainEntry) {
+	mustMultiline := bcce.AnyCollapsingNewlineHasHeredocContent() && bcce.InStringEmbexpr()
+	var tokens []QueueItem
+	if mustMultiline || ((bcce.IsMultiline() || rendersOverMaxLineLength(accum, bcce)) && !bcce.InStringEmbexpr()) {
+		bcce.WriteTokens(MultiLine, &tokens)
+		renderAs(accum, tokens)
+	} else {
+		bcce.RemoveCallChainMagicTokens()
+		bcce.WriteTokens(SingleLine, &tokens)
+		renderAs(accum, tokens)
+	}
+}
+
+func formatConditionalLayoutEntry(accum *Intermediary, cle *ConditionalLayoutEntry) {
+	if cle.ShouldUseBlockForm(accum.CurrentLineLength()) {
+		renderAs(accum, cle.IntoBlockTokens())
+	} else {
+		renderAs(accum, cle.IntoInlineTokens())
+	}
+}
+
+type breakableLength interface {
+	SingleLineStringLength(int) int
+}
+
+func rendersOverMaxLineLength(accum *Intermediary, breakable breakableLength) bool {
+	return breakable.SingleLineStringLength(accum.CurrentLineLength()) > MaxLineLength
+}
+
+func writeFinalTokens(tokens []*ConcreteToken) []byte {
+	for {
+		length := len(tokens)
+		if length < 2 {
+			break
+		}
+		deleteToken := false
+		secondLast := tokens[length-2]
+		last := tokens[length-1]
+		if secondLast.Kind == TComment && last.Kind == THardNewLine {
+			deleteToken = len(secondLast.Data) == 0
+		} else if secondLast.Kind == THardNewLine && last.Kind == THardNewLine {
+			deleteToken = true
+		}
+		if deleteToken {
+			tokens = tokens[:length-1]
+		} else {
+			break
+		}
+	}
+	var out []byte
+	for _, token := range tokens {
+		out = append(out, token.IntoRuby()...)
+	}
+	return out
+}
diff --git a/internal/formatter/render_targets.go b/internal/formatter/render_targets.go
new file mode 100644
index 0000000..d7e10c2
--- /dev/null
+++ b/internal/formatter/render_targets.go
@@ -0,0 +1,619 @@
+package formatter
+
+func insertAtTokens(idx int, target *[]AbstractToken, input []AbstractToken) {
+	*target = append((*target)[:idx], append(append([]AbstractToken{}, input...), (*target)[idx:]...)...)
+}
+
+func insertAtQueue(idx int, target *[]QueueItem, input []QueueItem) {
+	*target = append((*target)[:idx], append(append([]QueueItem{}, input...), (*target)[idx:]...)...)
+}
+
+func tokensContainHardNewline(token AbstractToken) bool {
+	switch token.Kind {
+	case AConcrete:
+		return token.CT.Kind == THardNewLine
+	case ABreakableEntry:
+		return token.BE.ContainsHardNewline()
+	case ABreakableCallChain:
+		return token.BCCE.ContainsHardNewline()
+	case AConditionalLayout:
+		return token.CLE.ContainsHardNewline()
+	}
+	return false
+}
+
+type ConvertType int
+
+const (
+	MultiLine ConvertType = iota
+	SingleLine
+)
+
+type BaseQueue struct {
+	tokens []QueueItem
+}
+
+func (q *BaseQueue) Push(item QueueItem) { q.tokens = append(q.tokens, item) }
+
+func (q *BaseQueue) InsertAt(idx int, tokens []QueueItem) {
+	insertAtQueue(idx, &q.tokens, tokens)
+}
+
+func (q *BaseQueue) IntoTokens() []QueueItem { return q.tokens }
+
+func (q *BaseQueue) LastTokenIsANewline() bool {
+	return len(q.tokens) > 0 && q.tokens[len(q.tokens)-1].IsNewline()
+}
+
+func (q *BaseQueue) IndexOfPrevNewline() (int, bool) {
+	for i := len(q.tokens) - 1; i >= 0; i-- {
+		if q.tokens[i].IsNewline() || q.tokens[i].IsIndent() {
+			return i, true
+		}
+	}
+	return 0, false
+}
+
+type BreakableEntry struct {
+	tokens          []AbstractToken
+	multiline       MultilineTracker
+	Delims          BreakableDelims
+	inStringEmbexpr bool
+}
+
+func NewBreakableEntry(delims BreakableDelims, formattingContext []FormattingContext) *BreakableEntry {
+	inString := false
+	for _, fc := range formattingContext {
+		if fc.Kind == FCStringEmbexpr {
+			inString = true
+			break
+		}
+	}
+	return &BreakableEntry{Delims: delims, inStringEmbexpr: inString}
+}
+
+func (b *BreakableEntry) Push(t AbstractToken) { b.tokens = append(b.tokens, t) }
+
+func (b *BreakableEntry) WriteTokens(ct ConvertType, out *[]QueueItem) {
+	if ct == MultiLine {
+		*out = append(*out, QueueConcrete(b.Delims.MultiLineOpen()))
+		for _, t := range b.tokens {
+			t.WriteMultiLine(out)
+		}
+		*out = append(*out, QueueConcrete(b.Delims.MultiLineClose()))
+	} else {
+		*out = append(*out, QueueConcrete(b.Delims.SingleLineOpen()))
+		for _, t := range b.tokens {
+			t.WriteSingleLine(out)
+		}
+		*out = append(*out, QueueConcrete(b.Delims.SingleLineClose()))
+	}
+}
+
+func (b *BreakableEntry) SingleLineStringLength(current int) int {
+	return b.SingleLineLen() + current
+}
+
+func (b *BreakableEntry) IsMultiline() bool {
+	return b.multiline.IsMultiline() || b.AnyCollapsingNewlineHasHeredocContent() || b.ContainsHardNewline()
+}
+
+func (b *BreakableEntry) Tokens() []AbstractToken { return b.tokens }
+
+func (b *BreakableEntry) AnyCollapsingNewlineHasHeredocContent() bool {
+	for _, t := range b.tokens {
+		switch t.Kind {
+		case ACollapsingNewLine, ASoftNewline:
+			if t.Heredocs != nil {
+				return true
+			}
+		case ABreakableEntry:
+			if t.BE.AnyCollapsingNewlineHasHeredocContent() {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (b *BreakableEntry) InsertAt(idx int, tokens []AbstractToken) {
+	insertAtTokens(idx, &b.tokens, tokens)
+}
+
+func (b *BreakableEntry) PushLineNumber(number int) { b.multiline.OnLine(number) }
+
+func (b *BreakableEntry) InStringEmbexpr() bool { return b.inStringEmbexpr }
+
+func (b *BreakableEntry) ContainsHardNewline() bool {
+	for _, t := range b.tokens {
+		if tokensContainHardNewline(t) {
+			return true
+		}
+	}
+	return false
+}
+
+func (b *BreakableEntry) SingleLineLen() int {
+	total := b.Delims.SingleLineLen()
+	for _, tok := range b.tokens {
+		total += tok.SingleLineLen()
+	}
+	return total
+}
+
+func (b *BreakableEntry) SingleLineLenParamsOnly() int {
+	if len(b.tokens) > 0 && b.tokens[0].Kind == ABreakableEntry && b.tokens[0].BE.Delims.Equal(ForBlockParams()) {
+		return b.tokens[0].BE.SingleLineLen() + b.Delims.SingleLineLen()
+	}
+	return 0
+}
+
+func (b *BreakableEntry) IndexOfPrevNewline() (int, bool) {
+	return abstractIndexOfPrevNewline(b.tokens)
+}
+
+func (b *BreakableEntry) LastTokenIsANewline() bool {
+	if len(b.tokens) == 0 {
+		return false
+	}
+	return b.tokens[len(b.tokens)-1].IsNewline()
+}
+
+func (b *BreakableEntry) Len() int { return len(b.tokens) }
+
+type BreakableCallChainEntry struct {
+	tokens           []AbstractToken
+	isUserMultilined bool
+	inStringEmbexpr  bool
+}
+
+func NewBreakableCallChainEntry(formattingContext []FormattingContext, isUserMultilined bool) *BreakableCallChainEntry {
+	inString := false
+	for _, fc := range formattingContext {
+		if fc.Kind == FCStringEmbexpr {
+			inString = true
+			break
+		}
+	}
+	return &BreakableCallChainEntry{inStringEmbexpr: inString, isUserMultilined: isUserMultilined}
+}
+
+func (b *BreakableCallChainEntry) Tokens() []AbstractToken { return b.tokens }
+
+func (b *BreakableCallChainEntry) Push(t AbstractToken) { b.tokens = append(b.tokens, t) }
+
+func (b *BreakableCallChainEntry) WriteTokens(ct ConvertType, out *[]QueueItem) {
+	for _, t := range b.tokens {
+		if ct == MultiLine {
+			t.WriteMultiLine(out)
+		} else {
+			t.WriteSingleLine(out)
+		}
+	}
+}
+
+func (b *BreakableCallChainEntry) SingleLineStringLength(current int) int {
+	tokens := b.tokens
+	braceBlockParamsOnlyIndex := -1
+
+	if len(tokens) > 2 {
+		index := len(tokens) - 2
+		token := tokens[index]
+		if token.Kind == AConcrete && token.CT.Kind == TEnd {
+			for len(tokens) > 0 {
+				last := tokens[len(tokens)-1]
+				if last.Kind == ABreakableEntry && last.BE.Delims.Equal(ForBlockParams()) {
+					break
+				}
+				tokens = tokens[:len(tokens)-1]
+			}
+		} else if token.Kind == ABreakableEntry && token.BE.Delims.Equal(ForBraceBlock()) {
+			braceBlockParamsOnlyIndex = index
+		}
+	}
+
+	if len(tokens) > 0 && tokens[0].Kind == ABreakableEntry {
+		if braceBlockParamsOnlyIndex >= 0 {
+			braceBlockParamsOnlyIndex--
+		}
+		tokens = tokens[1:]
+	}
+	if len(tokens) > 0 {
+		last := tokens[len(tokens)-1]
+		if last.Kind == AConcrete && last.CT.Kind == TEndCallChainIndent {
+			tokens = tokens[:len(tokens)-1]
+		}
+	}
+	callCount := 0
+	for _, t := range tokens {
+		if t.Kind == AConcrete && (t.CT.Kind == TDot || t.CT.Kind == TLonelyOperator) {
+			callCount++
+		}
+	}
+	if len(tokens) > 0 {
+		last := tokens[len(tokens)-1]
+		if last.Kind == ABreakableEntry && (callCount == 1 || last.BE.IsMultiline()) &&
+			!last.BE.Delims.Equal(ForBraceBlock()) && !last.BE.Delims.Equal(ForBlockParams()) {
+			if braceBlockParamsOnlyIndex >= 0 && braceBlockParamsOnlyIndex == len(tokens)-1 {
+				braceBlockParamsOnlyIndex = -1
+			}
+			tokens = tokens[:len(tokens)-1]
+		}
+	}
+
+	total := current
+	for i, t := range tokens {
+		if braceBlockParamsOnlyIndex >= 0 && braceBlockParamsOnlyIndex == i && t.Kind == ABreakableEntry {
+			total += t.BE.SingleLineLenParamsOnly()
+			continue
+		}
+		total += t.SingleLineLen()
+	}
+	return total
+}
+
+func (b *BreakableCallChainEntry) IsMultiline() bool {
+	if b.beginsWithHeredoc() {
+		return true
+	}
+	return b.isUserMultilined
+}
+
+func (b *BreakableCallChainEntry) AnyCollapsingNewlineHasHeredocContent() bool {
+	for _, t := range b.tokens {
+		switch t.Kind {
+		case ACollapsingNewLine, ASoftNewline:
+			if t.Heredocs != nil {
+				return true
+			}
+		case ABreakableEntry:
+			if t.BE.AnyCollapsingNewlineHasHeredocContent() {
+				return true
+			}
+		}
+	}
+	if len(b.tokens) > 0 && b.tokens[0].Kind == AConcrete && b.tokens[0].CT.Kind == THeredocStart {
+		return true
+	}
+	return false
+}
+
+func (b *BreakableCallChainEntry) InsertAt(idx int, tokens []AbstractToken) {
+	insertAtTokens(idx, &b.tokens, tokens)
+}
+
+func (b *BreakableCallChainEntry) RemoveCallChainMagicTokens() {
+	filtered := make([]AbstractToken, 0, len(b.tokens))
+	for _, t := range b.tokens {
+		if t.Kind == AConcrete && (t.CT.Kind == TBeginCallChainIndent || t.CT.Kind == TEndCallChainIndent) {
+			continue
+		}
+		filtered = append(filtered, t)
+	}
+	b.tokens = filtered
+}
+
+func (b *BreakableCallChainEntry) InStringEmbexpr() bool { return b.inStringEmbexpr }
+
+func (b *BreakableCallChainEntry) beginsWithHeredoc() bool {
+	return len(b.tokens) > 0 && b.tokens[0].Kind == AConcrete && b.tokens[0].CT.Kind == THeredocStart
+}
+
+func (b *BreakableCallChainEntry) SingleLineLen() int {
+	total := 0
+	for _, tok := range b.tokens {
+		total += tok.SingleLineLen()
+	}
+	return total
+}
+
+func (b *BreakableCallChainEntry) ContainsHardNewline() bool {
+	for _, t := range b.tokens {
+		if tokensContainHardNewline(t) {
+			return true
+		}
+	}
+	return false
+}
+
+func (b *BreakableCallChainEntry) IndexOfPrevNewline() (int, bool) {
+	return abstractIndexOfPrevNewline(b.tokens)
+}
+
+func (b *BreakableCallChainEntry) LastTokenIsANewline() bool {
+	if len(b.tokens) == 0 {
+		return false
+	}
+	return b.tokens[len(b.tokens)-1].IsNewline()
+}
+
+func (b *BreakableCallChainEntry) Len() int { return len(b.tokens) }
+
+type BreakableKind int
+
+const (
+	BDelimiter BreakableKind = iota
+	BCallChain
+	BInlineConditional
+)
+
+type Breakable struct {
+	Kind BreakableKind
+	BE   *BreakableEntry
+	BCCE *BreakableCallChainEntry
+	CLE  *ConditionalLayoutEntry
+}
+
+func (b *Breakable) Push(t AbstractToken) {
+	switch b.Kind {
+	case BDelimiter:
+		b.BE.Push(t)
+	case BCallChain:
+		b.BCCE.Push(t)
+	case BInlineConditional:
+		b.CLE.Push(t)
+	}
+}
+
+func (b *Breakable) InsertAt(idx int, tokens []AbstractToken) {
+	switch b.Kind {
+	case BDelimiter:
+		b.BE.InsertAt(idx, tokens)
+	case BCallChain:
+		b.BCCE.InsertAt(idx, tokens)
+	case BInlineConditional:
+		b.CLE.InsertAt(idx, tokens)
+	}
+}
+
+func (b *Breakable) PushLineNumber(number int) {
+	switch b.Kind {
+	case BDelimiter:
+		b.BE.PushLineNumber(number)
+	}
+}
+
+func (b *Breakable) Len() int {
+	switch b.Kind {
+	case BDelimiter:
+		return b.BE.Len()
+	case BCallChain:
+		return b.BCCE.Len()
+	case BInlineConditional:
+		return b.CLE.Len()
+	}
+	return 0
+}
+
+func (b *Breakable) LastTokenIsANewline() bool {
+	switch b.Kind {
+	case BDelimiter:
+		return b.BE.LastTokenIsANewline()
+	case BCallChain:
+		return b.BCCE.LastTokenIsANewline()
+	case BInlineConditional:
+		return b.CLE.LastTokenIsANewline()
+	}
+	return false
+}
+
+func (b *Breakable) IndexOfPrevNewline() (int, bool) {
+	switch b.Kind {
+	case BDelimiter:
+		return b.BE.IndexOfPrevNewline()
+	case BCallChain:
+		return b.BCCE.IndexOfPrevNewline()
+	case BInlineConditional:
+		return b.CLE.IndexOfPrevNewline()
+	}
+	return 0, false
+}
+
+func (b *Breakable) IntoBreakableEntry() *BreakableEntry {
+	if b.Kind == BDelimiter {
+		return b.BE
+	}
+	return nil
+}
+
+func (b *Breakable) IntoBreakableCallChain() *BreakableCallChainEntry {
+	if b.Kind == BCallChain {
+		return b.BCCE
+	}
+	return nil
+}
+
+func (b *Breakable) IntoConditionalLayout() *ConditionalLayoutEntry {
+	if b.Kind == BInlineConditional {
+		return b.CLE
+	}
+	return nil
+}
+
+type MultilineTracker struct {
+	firstLine   *int
+	isMultiline bool
+}
+
+func (m *MultilineTracker) OnLine(line int) {
+	if m.firstLine == nil {
+		v := line
+		m.firstLine = &v
+	} else if *m.firstLine != line {
+		m.isMultiline = true
+	}
+}
+
+func (m *MultilineTracker) IsMultiline() bool { return m.isMultiline }
+
+type ConditionalLayoutPhase int
+
+const (
+	PhasePredicate ConditionalLayoutPhase = iota
+	PhaseStatement
+)
+
+type ConditionalLayoutEntry struct {
+	predicateTokens []AbstractToken
+	statementTokens []AbstractToken
+	keyword         []byte
+	indentDepth     uint32
+	phase           ConditionalLayoutPhase
+}
+
+func NewConditionalLayoutEntry(keyword []byte, indentDepth uint32) *ConditionalLayoutEntry {
+	return &ConditionalLayoutEntry{keyword: keyword, indentDepth: indentDepth, phase: PhaseStatement}
+}
+
+func (c *ConditionalLayoutEntry) Push(token AbstractToken) {
+	if c.phase == PhasePredicate {
+		c.predicateTokens = append(c.predicateTokens, token)
+	} else {
+		c.statementTokens = append(c.statementTokens, token)
+	}
+}
+
+func (c *ConditionalLayoutEntry) SwitchToPredicate() { c.phase = PhasePredicate }
+
+func (c *ConditionalLayoutEntry) Len() int {
+	if c.phase == PhasePredicate {
+		return len(c.predicateTokens)
+	}
+	return len(c.statementTokens)
+}
+
+func (c *ConditionalLayoutEntry) InsertAt(idx int, tokens []AbstractToken) {
+	if c.phase == PhasePredicate {
+		insertAtTokens(idx, &c.predicateTokens, tokens)
+	} else {
+		insertAtTokens(idx, &c.statementTokens, tokens)
+	}
+}
+
+func (c *ConditionalLayoutEntry) LastTokenIsANewline() bool {
+	tokens := c.predicateTokens
+	if c.phase == PhaseStatement {
+		tokens = c.statementTokens
+	}
+	if len(tokens) == 0 {
+		return false
+	}
+	return tokens[len(tokens)-1].IsNewline()
+}
+
+func (c *ConditionalLayoutEntry) IndexOfPrevNewline() (int, bool) {
+	tokens := c.predicateTokens
+	if c.phase == PhaseStatement {
+		tokens = c.statementTokens
+	}
+	return abstractIndexOfPrevNewline(tokens)
+}
+
+func (c *ConditionalLayoutEntry) InlineSingleLineLen() int {
+	statementLen := 0
+	for _, t := range c.statementTokens {
+		statementLen += t.SingleLineLen()
+	}
+	predicateLen := 0
+	for _, t := range c.predicateTokens {
+		predicateLen += t.SingleLineLen()
+	}
+	return statementLen + 1 + len(c.keyword) + 1 + predicateLen
+}
+
+func (c *ConditionalLayoutEntry) IsMultiline() bool {
+	for _, t := range c.statementTokens {
+		if tokenIsMultiline(t) {
+			return true
+		}
+	}
+	for _, t := range c.predicateTokens {
+		if tokenIsMultiline(t) {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *ConditionalLayoutEntry) ContainsHardNewline() bool {
+	for _, t := range c.statementTokens {
+		if tokensContainHardNewline(t) {
+			return true
+		}
+	}
+	for _, t := range c.predicateTokens {
+		if tokensContainHardNewline(t) {
+			return true
+		}
+	}
+	return false
+}
+
+func tokenIsMultiline(token AbstractToken) bool {
+	switch token.Kind {
+	case AConcrete:
+		return token.CT.Kind == THardNewLine
+	case ABreakableEntry:
+		return token.BE.IsMultiline()
+	case ABreakableCallChain:
+		if token.BCCE.IsMultiline() {
+			return true
+		}
+		for _, t := range token.BCCE.tokens {
+			if tokenIsMultiline(t) {
+				return true
+			}
+		}
+	case AConditionalLayout:
+		return token.CLE.IsMultiline()
+	}
+	return false
+}
+
+func (c *ConditionalLayoutEntry) ShouldUseBlockForm(currentLineLength int) bool {
+	return c.IsMultiline() || currentLineLength+c.InlineSingleLineLen() > MaxLineLength
+}
+
+func (c *ConditionalLayoutEntry) IntoInlineTokens() []QueueItem {
+	var result []QueueItem
+	for _, token := range c.statementTokens {
+		token.WriteSingleLine(&result)
+	}
+	result = append(result, QueueConcrete(NewConcrete(TSpace)))
+	result = append(result, QueueConcrete(ConditionalKeywordToken(c.keyword)))
+	result = append(result, QueueConcrete(NewConcrete(TSpace)))
+	for _, token := range c.predicateTokens {
+		token.WriteSingleLine(&result)
+	}
+	return result
+}
+
+func (c *ConditionalLayoutEntry) IntoBlockTokens() []QueueItem {
+	var result []QueueItem
+	result = append(result, QueueConcrete(ConditionalKeywordToken(c.keyword)))
+	result = append(result, QueueConcrete(NewConcrete(TSpace)))
+	for _, token := range c.predicateTokens {
+		token.WriteMultiLine(&result)
+	}
+	result = append(result, QueueConcrete(NewConcrete(THardNewLine)))
+	result = append(result, QueueConcrete(IndentToken(c.indentDepth+2)))
+	for _, token := range c.statementTokens {
+		token.WriteMultiLine(&result)
+	}
+	result = append(result, QueueConcrete(NewConcrete(THardNewLine)))
+	result = append(result, QueueConcrete(IndentToken(c.indentDepth)))
+	result = append(result, QueueConcrete(NewConcrete(TEnd)))
+	return result
+}
+
+func abstractIndexOfPrevNewline(tokens []AbstractToken) (int, bool) {
+	for i := len(tokens) - 1; i >= 0; i-- {
+		if tokens[i].IsNewline() || tokens[i].IsIndent() {
+			if tokens[i].Kind == ACollapsingNewLine || tokens[i].Kind == ASoftNewline {
+				return i + 1, true
+			}
+			return i, true
+		}
+	}
+	return 0, false
+}
