+
+    *node = (pm_multi_target_node_t) {
+        .base = PM_NODE_INIT_UNSET(parser, PM_MULTI_TARGET_NODE, 0),
+        .lefts = { 0 },
+        .rest = NULL,
+        .rights = { 0 },
