index 0000000..3eda1e9
--- /dev/null
+++ b/cmd/rubyfmt/main.go
@@ -0,0 +1,36 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"rubyfmt/internal/cli"
+)
+
+func main() {
+	c := make(chan os.Signal, 1)
+	signal.Notify(c, os.Interrupt, syscall.SIGTERM)
+	go func() {
+		<-c
+		fmt.Fprintln(os.Stderr, "`rubyfmt` process was terminated. Exiting...")
+		os.Exit(1)
+	}()
+
+	result := cli.Parse(os.Args[1:])
+	if result.ShowHelp {
+		fmt.Fprint(os.Stdout, cli.HelpText())
+		return
+	}
+	if result.ShowVersion {
+		fmt.Fprintf(os.Stdout, "rubyfmt %s\n", cli.Version)
+		return
+	}
+	if result.Error != nil {
+		fmt.Fprintln(os.Stderr, result.Error)
+		os.Exit(2)
+	}
+
+	os.Exit(cli.Run(result.Options, os.Stdout, os.Stderr))
+}
