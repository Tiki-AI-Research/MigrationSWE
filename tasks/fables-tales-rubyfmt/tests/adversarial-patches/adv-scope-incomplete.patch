+                        LEX(PM_TOKEN_EOF);
+                    }
+
+                    pm_lex_state_t last_state = parser->lex_state;
+
+                    if (type == PM_TOKEN_IDENTIFIER || type == PM_TOKEN_CONSTANT || type == PM_TOKEN_METHOD_NAME) {
