new file mode 100644
index 0000000..6791a98
--- /dev/null
+++ b/rubyfmt.go
@@ -0,0 +1,36 @@
+// Package rubyfmt exposes the library formatting entry point for rubyfmt.
+package rubyfmt
+
+import (
+	"rubyfmt/internal/formatter"
+)
+
+type FormatError = formatter.FormatError
+
+const (
+	FormatOK                 = formatter.FormatOK
+	FormatSyntaxError        = formatter.FormatSyntaxError
+	FormatRipperParseFailure = formatter.FormatRipperParseFailure
+	FormatIOError            = formatter.FormatIOError
+	FormatOtherRubyError     = formatter.FormatOtherRubyError
+	FormatDiffDetected       = formatter.FormatDiffDetected
+)
+
+type RichFormatError = formatter.RichFormatError
+
+// FormatBuffer formats Ruby source bytes and returns the formatted output.
+// Syntax errors are reported as FormatSyntaxError and IO/parse failures as
+// FormatIOError; callers can use the returned error's ExitCode method to map
+// failures onto the documented CLI exit codes.
+func FormatBuffer(buf []byte) ([]byte, *RichFormatError) {
+	return formatter.FormatBuffer(buf)
+}
+
+// ExitCode maps a formatting error onto the documented CLI exit codes. A nil
+// error maps to FormatOK.
+func ExitCode(err *RichFormatError) int {
+	if err == nil {
+		return int(FormatOK)
+	}
+	return err.ExitCode()
+}
