@@ -0,0 +1,146 @@
+package formatter
+
+import "bytes"
+
+func singleToDoubleQuoted(content, startDelim, endDelim []byte) []byte {
+	if bytes.Equal(startDelim, []byte("'")) || bytes.HasPrefix(startDelim, []byte("%q")) {
+		return escapeString(content, startDelim[len(startDelim)-1], endDelim[len(endDelim)-1])
+	}
+	return convertPercentLiteralEscapes(content, startDelim[len(startDelim)-1], endDelim[len(endDelim)-1])
+}
+
+func convertPercentLiteralEscapes(content []byte, startDelim, endDelim byte) []byte {
+	firstChange := -1
+	for i := 0; i < len(content); i++ {
+		c := content[i]
+		if c == '"' {
+			firstChange = i
+			break
+		}
+		if c == '\\' && i+1 < len(content) {
+			next := content[i+1]
+			if next == startDelim || next == endDelim {
+				firstChange = i
+				break
+			}
+			i++
+		}
+	}
+	if firstChange < 0 {
+		return content
+	}
+
+	output := append([]byte{}, content[:firstChange]...)
+	for i := firstChange; i < len(content); i++ {
+		c := content[i]
+		if c == '\\' {
+			if i+1 < len(content) {
+				next := content[i+1]
+				if next == startDelim || next == endDelim {
+					output = append(output, next)
+				} else {
+					output = append(output, '\\', next)
+				}
+				i++
+			} else {
+				output = append(output, '\\')
+			}
+		} else if c == '"' {
+			output = append(output, '\\', '"')
+		} else {
+			output = append(output, c)
+		}
+	}
+	return output
+}
+
+func escapeWordArrayContent(content []byte, origOpenDelim, origCloseDelim byte) []byte {
+	const targetOpen byte = '['
+	const targetClose byte = ']'
+
+	output := make([]byte, 0, len(content)+4)
+	for i := 0; i < len(content); i++ {
+		c := content[i]
+		if c == '\\' {
+			if i+1 < len(content) {
+				next := content[i+1]
+				if next == '\\' {
+					output = append(output, '\\', '\\')
+				} else if next == origOpenDelim || next == origCloseDelim {
+					if next == targetOpen || next == targetClose {
+						output = append(output, '\\')
+					}
+					output = append(output, next)
+				} else if next == targetOpen || next == targetClose {
+					output = append(output, '\\', next)
+				} else {
+					output = append(output, '\\', next)
+				}
+				i++
+			} else {
+				output = append(output, '\\')
+			}
+		} else if c == targetOpen || c == targetClose {
+			output = append(output, '\\', c)
+		} else {
+			output = append(output, c)
+		}
+	}
+	return output
+}
+
+func escapeString(content []byte, openingDelim, closingDelim byte) []byte {
+	if openingDelim == '"' {
+		return content
+	}
+
+	output := make([]byte, 0, len(content)+4)
+	for i := 0; i < len(content); i++ {
+		c := content[i]
+		switch c {
+		case '"':
+			output = append(output, '\\')
+		case '\\':
+			if i+1 < len(content) {
+				next := content[i+1]
+				switch next {
+				case '\'':
+					output = append(output, '\'')
+					i++
+					continue
+				case '\\':
+					output = append(output, '\\', '\\')
+					i++
+					continue
+				case '"':
+					output = append(output, '\\', '\\', '\\', '"')
+					i++
+					continue
+				case '#':
+					output = append(output, '\\', '\\')
+					continue
+				default:
+					if (next == openingDelim || next == closingDelim) && openingDelim != '\'' {
+						output = append(output, next)
+						i++
+						continue
+					}
+					output = append(output, '\\', '\\', next)
+					i++
+					continue
+				}
+			}
+		case '#':
+			if i+1 < len(content) {
+				next := content[i+1]
+				if next == '$' || next == '@' || next == '{' {
+					output = append(output, '\\', c, next)
+					i++
+					continue
+				}
+			}
+		}
+		output = append(output, c)
+	}
+	return output
+}
