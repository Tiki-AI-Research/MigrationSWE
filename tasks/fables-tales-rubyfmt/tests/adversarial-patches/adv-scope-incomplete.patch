+		formatPreExecutionNode(ps, node)
+	case "ProgramNode":
+		formatProgram(ps, node, nil)
+	case "RangeNode":
+		formatRangeNode(ps, node)
+	case "RationalNode":
+		handleStringAtOffset(ps, ps.nodeBytes(node, "location"), node.Start())
+	case "RedoNode":
+		ps.emitIdent([]byte("redo"))
+	case "RegularExpressionNode":
+		formatRegularExpressionNode(ps, node)
+	case "RequiredKeywordParameterNode":
+		formatRequiredKeywordParameterNode(ps, node)
+	case "RequiredParameterNode":
