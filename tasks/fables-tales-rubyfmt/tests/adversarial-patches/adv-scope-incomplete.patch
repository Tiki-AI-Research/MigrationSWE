-            cmd.arg(actual.to_str().unwrap());
-
-            cmd.assert().success().stdout(expected_text.clone());
-
-            // Test if the formatting is idempotent
-            let mut cmd = Command::cargo_bin("rubyfmt-main").unwrap();
