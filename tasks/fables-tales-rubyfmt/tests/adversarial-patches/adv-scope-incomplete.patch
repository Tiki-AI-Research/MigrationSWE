+++ b/internal/formatter/tokens.go
@@ -0,0 +1,422 @@
+package formatter
+
+import "bytes"
+
+type ConcreteKind int
+
+const (
+	THardNewLine ConcreteKind = iota
+	TIndent
+	TKeyword
+	TDefKeyword
+	TClassKeyword
+	TModuleKeyword
+	TDoKeyword
+	TConditionalKeyword
+	TDirectPart
+	TMethodName
+	TCommaSpace
+	TComma
+	TSpace
+	TDot
+	TColonColon
+	TLonelyOperator
+	TOpenSquareBracket
+	TCloseSquareBracket
+	TOpenCurlyBracket
+	TCloseCurlyBracket
+	TOpenParen
+	TCloseParen
+	TOp
+	TDoubleQuote
+	TLTStringContent
+	TSingleSlash
+	TComment
+	TDelim
+	TEnd
+	THeredocClose
+	TAfterCallChain
+	TBeginCallChainIndent
+	TEndCallChainIndent
+	THeredocStart
+	TRawHeredocContent
+)
+
+type ConcreteToken struct {
+	Kind ConcreteKind
+	Data []byte
+	// Depth is used by indent tokens.
+	Depth uint32
+	// HeredocKind is used by heredoc start tokens.
+	HeredocKind HeredocKind
+}
+
+func NewConcrete(kind ConcreteKind) *ConcreteToken {
+	return &ConcreteToken{Kind: kind}
+}
+
+func KeywordToken(keyword []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: TKeyword, Data: keyword}
+}
+
+func ConditionalKeywordToken(keyword []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: TConditionalKeyword, Data: keyword}
+}
+
+func DirectPartToken(part []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: TDirectPart, Data: part}
+}
+
+func MethodNameToken(name []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: TMethodName, Data: name}
+}
+
+func OpToken(op []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: TOp, Data: op}
+}
+
+func CommentToken(contents []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: TComment, Data: contents}
+}
+
+func DelimToken(contents []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: TDelim, Data: contents}
+}
+
+func StringContentToken(content []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: TLTStringContent, Data: content}
+}
+
+func IndentToken(depth uint32) *ConcreteToken {
+	return &ConcreteToken{Kind: TIndent, Depth: depth}
+}
+
+func HeredocCloseToken(symbol []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: THeredocClose, Data: symbol}
+}
+
+func HeredocStartToken(kind HeredocKind, symbol []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: THeredocStart, Data: symbol, HeredocKind: kind}
+}
+
+func RawHeredocContentToken(content []byte) *ConcreteToken {
+	return &ConcreteToken{Kind: TRawHeredocContent, Data: content}
+}
+
+func (t *ConcreteToken) IntoRuby() []byte {
+	switch t.Kind {
+	case THardNewLine:
+		return []byte("\n")
+	case TIndent:
+		return getIndent(int(t.Depth))
+	case TKeyword, TConditionalKeyword, TDirectPart, TMethodName, TOp, TComment, TDelim, TLTStringContent, THeredocStart, TRawHeredocContent:
+		return t.Data
+	case TCommaSpace:
+		return []byte(", ")
+	case TComma:
+		return []byte(",")
+	case TSpace:
+		return []byte(" ")
+	case TDot:
+		return []byte(".")
+	case TColonColon:
+		return []byte("::")
+	case TLonelyOperator:
+		return []byte("&.")
+	case TOpenSquareBracket:
+		return []byte("[")
+	case TCloseSquareBracket:
+		return []byte("]")
+	case TOpenCurlyBracket:
+		return []byte("{")
+	case TCloseCurlyBracket:
+		return []byte("}")
+	case TOpenParen:
+		return []byte("(")
+	case TCloseParen:
+		return []byte(")")
+	case TDoubleQuote:
+		return []byte("\"")
+	case TSingleSlash:
+		return []byte("\\")
+	case TDoKeyword:
+		return []byte("do")
+	case TClassKeyword:
+		return []byte("class")
+	case TDefKeyword:
+		return []byte("def")
+	case TModuleKeyword:
+		return []byte("module")
+	case TEnd:
+		return []byte("end")
+	case THeredocClose:
+		return t.Data
+	case TAfterCallChain, TBeginCallChainIndent, TEndCallChainIndent:
+		return []byte("")
+	}
+	return nil
+}
+
+func (t *ConcreteToken) Len() int {
+	switch t.Kind {
+	case TAfterCallChain, TBeginCallChainIndent, TEndCallChainIndent:
+		return 0
+	case TIndent:
+		return int(t.Depth)
+	case THardNewLine, TComma, TSpace, TDot, TOpenSquareBracket, TCloseSquareBracket,
+		TOpenCurlyBracket, TCloseCurlyBracket, TOpenParen, TCloseParen, TSingleSlash, TDoubleQuote:
+		return 1
+	case TDoKeyword, TCommaSpace, TLonelyOperator, TColonColon:
+		return 2
+	case TDefKeyword, TEnd:
+		return 3
+	case TClassKeyword:
+		return 5
+	case TModuleKeyword:
+		return 6
+	default:
+		return len(t.Data)
+	}
+}
+
+func (t *ConcreteToken) IsNewline() bool { return t.Kind == THardNewLine }
+func (t *ConcreteToken) IsIndent() bool  { return t.Kind == TIndent }
+
+func (t *ConcreteToken) IsBlockClosingToken() bool {
+	if t.Kind == TEnd {
+		return true
+	}
+	if t.Kind == TDirectPart {
+		return bytes.Equal(t.Data, []byte("}")) || bytes.Equal(t.Data, []byte("]")) || bytes.Equal(t.Data, []byte(")"))
+	}
+	if t.Kind == TDelim {
+		return bytes.Equal(t.Data, []byte("}")) || bytes.Equal(t.Data, []byte("]")) || bytes.Equal(t.Data, []byte(")"))
+	}
+	return false
+}
+
+func (t *ConcreteToken) IsConditionalSpacedToken() bool {
+	switch t.Kind {
+	case TConditionalKeyword:
+		return !(bytes.Equal(t.Data, []byte("else")) || bytes.Equal(t.Data, []byte("elsif")))
+	case TDot, TLonelyOperator:
+		return false
+	case TDirectPart:
+		return !bytes.Equal(t.Data, []byte("&."))
+	default:
+		return true
+	}
+}
+
+func (t *ConcreteToken) IsSingleLineBreakableGarbage() bool {
+	if t.Kind == TDirectPart {
+		return len(t.Data) == 0
+	}
+	return t.Kind == TSpace
+}
+
+func (t *ConcreteToken) IsInNeedOfTrailingBlankline() bool {
+	return t.IsConditionalSpacedToken() && !t.IsBlockClosingToken()
+}
+
+type QueueKind int
+
+const (
+	QConcrete QueueKind = iota
+	QBreakableEntry
+	QCallChain
+	QConditional
+)
+
+type QueueItem struct {
+	Kind QueueKind
+	CT   *ConcreteToken
+	BE   *BreakableEntry
+	BCCE *BreakableCallChainEntry
+	CLE  *ConditionalLayoutEntry
+}
+
+func QueueConcrete(ct *ConcreteToken) QueueItem {
+	return QueueItem{Kind: QConcrete, CT: ct}
+}
+
+func QueueBreakableEntry(be *BreakableEntry) QueueItem {
+	return QueueItem{Kind: QBreakableEntry, BE: be}
+}
+
+func QueueCallChain(bcce *BreakableCallChainEntry) QueueItem {
+	return QueueItem{Kind: QCallChain, BCCE: bcce}
+}
+
+func QueueConditional(cle *ConditionalLayoutEntry) QueueItem {
+	return QueueItem{Kind: QConditional, CLE: cle}
+}
+
+func (q QueueItem) IsNewline() bool {
+	return q.Kind == QConcrete && q.CT.IsNewline()
+}
+
+func (q QueueItem) IsIndent() bool {
+	return q.Kind == QConcrete && q.CT.IsIndent()
+}
+
+type AbstractKind int
+
+const (
+	AConcrete AbstractKind = iota
+	ACollapsingNewLine
+	ASoftNewline
+	ASoftIndent
+	ABreakableEntry
+	ABreakableCallChain
+	AConditionalLayout
+)
+
+type AbstractToken struct {
+	Kind     AbstractKind
+	CT       *ConcreteToken
+	Heredocs []*HeredocString
+	Depth    uint32
+	BE       *BreakableEntry
+	BCCE     *BreakableCallChainEntry
+	CLE      *ConditionalLayoutEntry
+}
+
+func AbstractConcrete(ct *ConcreteToken) AbstractToken {
+	return AbstractToken{Kind: AConcrete, CT: ct}
+}
+
+func AbstractCollapsing(heredocs []*HeredocString) AbstractToken {
+	return AbstractToken{Kind: ACollapsingNewLine, Heredocs: heredocs}
+}
+
+func AbstractSoftNewline(heredocs []*HeredocString) AbstractToken {
+	return AbstractToken{Kind: ASoftNewline, Heredocs: heredocs}
+}
+
+func AbstractSoftIndent(depth uint32) AbstractToken {
+	return AbstractToken{Kind: ASoftIndent, Depth: depth}
+}
+
+func AbstractBreakable(be *BreakableEntry) AbstractToken {
+	return AbstractToken{Kind: ABreakableEntry, BE: be}
+}
+
+func AbstractCallChain(bcce *BreakableCallChainEntry) AbstractToken {
+	return AbstractToken{Kind: ABreakableCallChain, BCCE: bcce}
+}
+
+func AbstractConditional(cle *ConditionalLayoutEntry) AbstractToken {
+	return AbstractToken{Kind: AConditionalLayout, CLE: cle}
+}
+
+func (t AbstractToken) IsNewline() bool {
+	if t.Kind == AConcrete {
+		return t.CT.IsNewline()
+	}
+	return t.Kind == ASoftNewline || t.Kind == ACollapsingNewLine
+}
+
+func (t AbstractToken) IsIndent() bool {
+	return t.Kind == AConcrete && t.CT.IsIndent()
+}
+
+func (t AbstractToken) WriteSingleLine(out *[]QueueItem) {
+	switch t.Kind {
+	case ACollapsingNewLine:
+		if t.Heredocs != nil {
+			*out = append(*out, QueueConcrete(NewConcrete(THardNewLine)))
+		}
+		writeHeredocs(t.Heredocs, out)
+	case ASoftNewline:
+		*out = append(*out, QueueConcrete(NewConcrete(TSpace)))
+		writeHeredocs(t.Heredocs, out)
+	case ASoftIndent:
+	case AConcrete:
+		*out = append(*out, QueueConcrete(t.CT))
+	case ABreakableEntry:
+		*out = append(*out, QueueBreakableEntry(t.BE))
+	case ABreakableCallChain:
+		*out = append(*out, QueueCallChain(t.BCCE))
+	case AConditionalLayout:
+		*out = append(*out, QueueConditional(t.CLE))
+	}
+}
+
+func (t AbstractToken) WriteMultiLine(out *[]QueueItem) {
+	switch t.Kind {
+	case ACollapsingNewLine:
+		*out = append(*out, QueueConcrete(NewConcrete(THardNewLine)))
+		writeHeredocs(t.Heredocs, out)
+	case ASoftNewline:
+		*out = append(*out, QueueConcrete(NewConcrete(THardNewLine)))
+		writeHeredocs(t.Heredocs, out)
+	case ASoftIndent:
+		*out = append(*out, QueueConcrete(IndentToken(t.Depth)))
+	case AConcrete:
+		*out = append(*out, QueueConcrete(t.CT))
+	case ABreakableEntry:
+		*out = append(*out, QueueBreakableEntry(t.BE))
+	case ABreakableCallChain:
+		*out = append(*out, QueueCallChain(t.BCCE))
+	case AConditionalLayout:
+		*out = append(*out, QueueConditional(t.CLE))
+	}
+}
+
+func writeHeredocs(heredocs []*HeredocString, out *[]QueueItem) {
+	for _, hds := range heredocs {
+		indent := hds.Indent
+		kind := hds.Kind
+		symbol := hds.ClosingSymbol()
+
+		s := hds.RenderAsBytes()
+		if len(s) != 0 {
+			*out = append(*out, QueueConcrete(DirectPartToken(s)))
+			*out = append(*out, QueueConcrete(NewConcrete(THardNewLine)))
+		}
+		if !kind.IsBare() {
+			*out = append(*out, QueueConcrete(IndentToken(indent)))
+		}
+		*out = append(*out, QueueConcrete(HeredocCloseToken(symbol)))
+		*out = append(*out, QueueConcrete(NewConcrete(THardNewLine)))
+		indentDepth := indent
+		if indent != 0 {
+			indentDepth = indent - 2
+		}
+		*out = append(*out, QueueConcrete(IndentToken(indentDepth)))
+	}
+}
+
+func (t AbstractToken) SingleLineLen() int {
+	switch t.Kind {
+	case ACollapsingNewLine:
+		if t.Heredocs != nil {
+			return MaxLineLength + 1
+		}
+		return 0
+	case ASoftNewline:
+		if t.Heredocs != nil {
+			return MaxLineLength + 1
+		}
+		return 1
+	case ASoftIndent:
+		return 0
+	case AConcrete:
+		return t.CT.Len()
+	case ABreakableEntry:
+		return t.BE.SingleLineLen()
+	case ABreakableCallChain:
+		return t.BCCE.SingleLineLen()
+	case AConditionalLayout:
+		return t.CLE.InlineSingleLineLen()
+	}
+	return 0
+}
+
+func getIndent(depth int) []byte {
+	if depth < 0 {
+		depth = 0
+	}
+	return bytes.Repeat([]byte(" "), depth)
+}
diff --git a/internal/prism/bridge.c b/internal/prism/bridge.c
new file mode 100644
index 0000000..82f9b70
--- /dev/null
+++ b/internal/prism/bridge.c
@@ -0,0 +1,51 @@
+#include <stdlib.h>
+#include <string.h>
+#include "prism.h"
+#include "prism/util/pm_buffer.h"
+
+// Returns a malloc'd JSON document. The caller owns the returned pointer.
+char *rubyfmt_prism_parse_json(const uint8_t *source, size_t length, size_t *out_length) {
+    pm_parser_t parser;
+    pm_parser_init(&parser, source, length, NULL);
+    pm_node_t *root = pm_parse(&parser);
+
+    pm_buffer_t buffer = {0};
+    pm_buffer_init(&buffer);
+
+    pm_buffer_append_string(&buffer, "{\"ast\":", 7);
+    pm_dump_json(&buffer, &parser, root);
+    pm_buffer_append_string(&buffer, ",\"errors\":", 10);
+    pm_buffer_append_format(&buffer, "%zu", parser.error_list.size);
+
+    pm_buffer_append_string(&buffer, ",\"comments\":[", 13);
+    int first = 1;
+    for (pm_list_node_t *node = parser.comment_list.head; node != NULL; node = node->next) {
+        pm_comment_t *comment = (pm_comment_t *) node;
+        ptrdiff_t start = comment->location.start - parser.start;
+        ptrdiff_t end = comment->location.end - parser.start;
+        if (!first) pm_buffer_append_string(&buffer, ",", 1);
+        first = 0;
+        pm_buffer_append_format(&buffer, "{\"start\":%td,\"end\":%td,\"type\":%d}", start, end, (int) comment->type);
+    }
+    pm_buffer_append_string(&buffer, "]", 1);
+
+    pm_buffer_append_string(&buffer, ",\"data\":", 8);
+    if (parser.data_loc.start == NULL) {
+        pm_buffer_append_string(&buffer, "null", 4);
+    } else {
+        ptrdiff_t start = parser.data_loc.start - parser.start;
+        ptrdiff_t end = parser.data_loc.end - parser.start;
+        pm_buffer_append_format(&buffer, "{\"start\":%td,\"end\":%td}", start, end);
+    }
+    pm_buffer_append_string(&buffer, "}", 1);
+
+    *out_length = buffer.length;
+    char *result = malloc(buffer.length + 1);
+    memcpy(result, buffer.value, buffer.length);
+    result[buffer.length] = '\0';
+
+    pm_buffer_free(&buffer);
+    pm_node_destroy(&parser, root);
+    pm_parser_free(&parser);
+    return result;
+}
