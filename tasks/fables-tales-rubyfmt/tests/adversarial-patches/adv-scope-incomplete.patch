+
+    *node = (pm_call_node_t) {
+        .base = PM_NODE_INIT_BASE(parser, PM_CALL_NODE, flags),
+        .receiver = NULL,
+        .call_operator_loc = { 0 },
+        .message_loc = { 0 },
+        .opening_loc = { 0 },
+        .arguments = NULL,
+        .closing_loc = { 0 },
+        .equal_loc = { 0 },
