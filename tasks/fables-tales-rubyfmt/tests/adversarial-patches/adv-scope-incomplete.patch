+
+func formatMultiTargets(ps *ParserState, lefts []Node, rest Node, rights []Node, hasParens bool) {
+	if hasParens {
+		ps.emitOpenParen()
+	}
+	hasLefts := len(lefts) > 0
+	hasRest := rest != nil
+	hasRights := len(rights) > 0
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		if hasLefts {
+			formatListLikeThing(ps, lefts, nodeListEndOffset(lefts), true)
+		}
+		if rest != nil {
+			if rest.Type() == "ImplicitRestNode" {
+				ps.emitComma()
+			} else {
+				if hasLefts {
+					ps.emitCommaSpace()
+				}
+				formatNode(ps, rest)
+			}
+		}
+		if hasRights {
+			if hasLefts || hasRest {
+				ps.emitCommaSpace()
+			}
+			formatListLikeThing(ps, rights, nodeListEndOffset(rights), true)
+		}
+	})
+	if hasParens {
+		ps.emitCloseParen()
+	}
