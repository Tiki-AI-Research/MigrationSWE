-                    ps,
-                    array_node.elements(),
-                    array_node.location().end_offset(),
-                    true,
-                );
-            } else {
-                ps.breakable_of(BreakableDelims::for_array(), |ps| {
-                    format_list_like_thing(
-                        ps,
-                        array_node.elements(),
-                        array_node.location().end_offset(),
