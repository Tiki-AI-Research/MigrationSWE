--- /dev/null
+++ b/internal/formatter/binary_test.go
@@ -0,0 +1,52 @@
+package formatter
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"testing"
+)
+
+var (
+	binaryOnce sync.Once
+	binaryPath string
+	binaryErr  error
+)
+
+func builtRubyfmt(t testing.TB) string {
+	t.Helper()
+	binaryOnce.Do(func() {
+		root := repoRoot(t)
+		dir, err := os.MkdirTemp("", "rubyfmt-formatter-test-*")
+		if err != nil {
+			binaryErr = err
+			return
+		}
+		binaryPath = filepath.Join(dir, "rubyfmt")
+		goTool := filepath.Join(runtime.GOROOT(), "bin", "go")
+		if _, err := os.Stat(goTool); err != nil {
+			goTool = "go"
+		}
+		command := exec.Command(goTool, "build", "-mod=vendor", "-buildvcs=false", "-o", binaryPath, "./cmd/rubyfmt")
+		command.Dir = root
+		output, err := command.CombinedOutput()
+		if err != nil {
+			binaryErr = &buildError{err: err, output: string(output)}
+		}
+	})
+	if binaryErr != nil {
+		t.Fatal(binaryErr)
+	}
+	return binaryPath
+}
+
+type buildError struct {
+	err    error
+	output string
+}
+
+func (e *buildError) Error() string {
+	return e.err.Error() + "\n" + e.output
+}
diff --git a/internal/formatter/comments.go b/internal/formatter/comments.go
new file mode 100644
index 0000000..104fc19
--- /dev/null
+++ b/internal/formatter/comments.go
@@ -0,0 +1,346 @@
+package formatter
+
+import (
+	"bytes"
+	"sort"
+)
+
+type CommentBlock struct {
+	SpanStart int
+	SpanEnd   int
+	Comments  [][]byte
+}
+
+func NewCommentBlock(start, end int, comments [][]byte) *CommentBlock {
+	return &CommentBlock{SpanStart: start, SpanEnd: end, Comments: comments}
+}
+
+func (c *CommentBlock) FollowingLineNumber() int { return c.SpanEnd }
+
+func (c *CommentBlock) AddLine(line []byte) {
+	c.SpanEnd++
+	c.Comments = append(c.Comments, line)
+}
+
+func (c *CommentBlock) IntoLineTokens() []*ConcreteToken {
+	var out []*ConcreteToken
+	for i, comment := range c.Comments {
+		if len(comment) == 0 {
+			if i == len(c.Comments)-1 {
+				out = append(out, CommentToken(comment), NewConcrete(THardNewLine))
+			} else {
+				out = append(out, NewConcrete(THardNewLine))
+			}
+		} else {
+			out = append(out, CommentToken(comment), NewConcrete(THardNewLine))
+		}
+	}
+	return out
+}
+
+func (c *CommentBlock) EnforceAtLeastOneSpaceAfterCommentSymbol() *CommentBlock {
+	special := []byte{'!', '=', '-', ':', '|', '*'}
+	for i, comment := range c.Comments {
+		if len(comment) == 0 || bytes.HasPrefix(comment, []byte("=begin")) {
+			continue
+		}
+		start := bytes.IndexByte(comment, '#')
+		if start < 0 {
+			continue
+		}
+		collapse := 0
+		for start+collapse < len(comment) && comment[start+collapse] == '#' {
+			collapse++
+		}
+		anchor := start + collapse
+		if anchor == len(comment) {
+			continue
+		}
+		if isASCIIWhitespace(comment[anchor]) {
+			continue
+		}
+		ignored := false
+		for _, ch := range special {
+			if comment[anchor] == ch {
+				ignored = true
+				break
+			}
+		}
+		if ignored {
+			continue
+		}
+		updated := make([]byte, 0, len(comment)+1)
+		updated = append(updated, comment[:anchor]...)
+		updated = append(updated, ' ')
+		updated = append(updated, comment[anchor:]...)
+		c.Comments[i] = updated
+	}
+	return c
+}
+
+func (c *CommentBlock) ApplySpaces(indentDepth uint32) *CommentBlock {
+	target := int(indentDepth)
+	for i, comment := range c.Comments {
+		if len(comment) == 0 || bytes.HasPrefix(comment, []byte("=begin")) {
+			continue
+		}
+		current := 0
+		for current < len(comment) && comment[current] == ' ' {
+			current++
+		}
+		if current == target {
+			continue
+		}
+		if current > target {
+			c.Comments[i] = append([]byte{}, comment[current-target:]...)
+		} else {
+			extra := getIndent(target - current)
+			updated := make([]byte, 0, len(extra)+len(comment))
+			updated = append(updated, extra...)
+			updated = append(updated, comment...)
+			c.Comments[i] = updated
+		}
+	}
+	return c
+}
+
+func (c *CommentBlock) HasComments() bool { return len(c.Comments) > 0 }
+
+func (c *CommentBlock) LineCount() int {
+	total := 0
+	for _, comment := range c.Comments {
+		total += lineCount(comment)
+	}
+	return total
+}
+
+func (c *CommentBlock) IsTrailing() bool { return c.SpanStart+1 == c.SpanEnd }
+
+func (c *CommentBlock) Merge(other *CommentBlock) {
+	c.Comments = append(c.Comments, other.Comments...)
+}
+
+func mergeCommentBlock(dst **CommentBlock, other *CommentBlock) {
+	if *dst != nil {
+		(*dst).Merge(other)
+	} else {
+		*dst = other
+	}
+}
+
+func lineCount(b []byte) int {
+	if len(b) == 0 {
+		return 0
+	}
+	return bytes.Count(b, []byte{'\n'}) + 1
+}
+
+func isASCIIWhitespace(b byte) bool {
+	return b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == '\v' || b == '\f'
+}
+
+type commentEntry struct {
+	line int
+	text []byte
+}
+
+type FileComments struct {
+	startOfFileContiguous *CommentBlock
+	otherComments         []commentEntry
+	linesWithRuby         []int
+	lastLineno            int
+	lineStarts            []int
+	commentStartOffsets   []int
+}
+
+func NewFileComments() *FileComments {
+	return &FileComments{}
+}
+
+type RawComment struct {
+	Start int
+	End   int
+}
+
+func FileCommentsFromComments(comments []RawComment, source []byte) *FileComments {
+	lineStarts := []int{0}
+	linesWithRuby := []int{}
+
+	lineStart := 0
+	lineno := 1
+	insideEmbdoc := false
+
+	for i, b := range source {
+		if b != '\n' {
+			continue
+		}
+		lineStarts = append(lineStarts, i+1)
+		if lineHasRuby(source[lineStart:i], &insideEmbdoc) {
+			linesWithRuby = append(linesWithRuby, lineno)
+		}
+		lineStart = i + 1
+		lineno++
+	}
+
+	if lineStart < len(source) {
+		if lineHasRuby(source[lineStart:], &insideEmbdoc) {
+			linesWithRuby = append(linesWithRuby, lineno)
+		}
+	}
+
+	fc := &FileComments{linesWithRuby: linesWithRuby, lineStarts: lineStarts}
+	for _, comment := range comments {
+		line := fc.getLineNumber(comment.Start)
+		text := append([]byte{}, trimASCIIEnd(source[comment.Start:comment.End])...)
+		fc.pushComment(line, text)
+		fc.commentStartOffsets = append(fc.commentStartOffsets, comment.Start)
+	}
+	fc.lastLineno = len(lineStarts)
+	return fc
+}
+
+func lineHasRuby(line []byte, insideEmbdoc *bool) bool {
+	idx := -1
+	for i, b := range line {
+		if !isASCIIWhitespace(b) {
+			idx = i
+			break
+		}
+	}
+	if idx < 0 {
+		return false
+	}
+	trimmed := line[idx:]
+	if bytes.HasPrefix(trimmed, []byte("=begin")) {
+		*insideEmbdoc = true
+		return false
+	}
+	if bytes.HasPrefix(trimmed, []byte("=end")) {
+		*insideEmbdoc = false
+		return false
+	}
+	if *insideEmbdoc {
+		return false
+	}
+	return trimmed[0] != '#'
+}
+
+func (f *FileComments) getLineNumber(offset int) int {
+	i := sort.SearchInts(f.lineStarts, offset)
+	if i < len(f.lineStarts) && f.lineStarts[i] == offset {
+		return i + 1
+	}
+	if i == 0 {
+		return 1
+	}
+	return i
+}
+
+func (f *FileComments) GetLineNumberForOffset(offset int) int {
+	return f.getLineNumber(offset)
+}
+
+func (f *FileComments) StillInFile(line int) bool { return line < f.lastLineno }
+
+func (f *FileComments) HasLine(line int) bool {
+	i := sort.Search(len(f.otherComments), func(i int) bool { return f.otherComments[i].line >= line })
+	return i < len(f.otherComments) && f.otherComments[i].line == line
+}
+
+func (f *FileComments) IsEmptyLine(line int) bool {
+	i := sort.SearchInts(f.linesWithRuby, line)
+	return !(i < len(f.linesWithRuby) && f.linesWithRuby[i] == line)
+}
+
+func (f *FileComments) pushComment(line int, text []byte) {
+	isEmpty := f.IsEmptyLine(line)
+	if f.startOfFileContiguous == nil && line == 1 && isEmpty {
+		f.startOfFileContiguous = NewCommentBlock(1, 2, [][]byte{text})
+		return
+	}
+	if f.startOfFileContiguous != nil && isEmpty && f.startOfFileContiguous.FollowingLineNumber() == line {
+		f.startOfFileContiguous.AddLine(text)
+		return
+	}
+	f.otherComments = append(f.otherComments, commentEntry{line: line, text: text})
+}
+
+func (f *FileComments) TakeStartOfFileContiguousCommentLines() *CommentBlock {
+	result := f.startOfFileContiguous
+	f.startOfFileContiguous = nil
+	return result
+}
+
+func (f *FileComments) HasCommentsInLines(startLine, endLine int) bool {
+	for _, entry := range f.otherComments {
+		if entry.line >= startLine && entry.line < endLine {
+			return true
+		}
+	}
+	return false
+}
+
+func (f *FileComments) HasCommentInOffsets(start, end int) bool {
+	idx := sort.SearchInts(f.commentStartOffsets, start)
+	return idx < len(f.commentStartOffsets) && f.commentStartOffsets[idx] < end
+}
+
+func (f *FileComments) ExtractCommentsToLine(startingLine, lineNumber int, suppressLeadingBlank bool) (*CommentBlock, int, bool) {
+	if len(f.otherComments) == 0 {
+		return nil, 0, false
+	}
+	lowestLine := f.otherComments[0].line
+	if lowestLine > lineNumber {
+		return nil, 0, false
+	}
+	splitPoint := sort.Search(len(f.otherComments), func(i int) bool {
+		return f.otherComments[i].line > lineNumber
+	})
+
+	var blockWithSpaces [][]byte
+	lastLine := 0
+	hasLast := false
+
+	if !suppressLeadingBlank && lineDifferenceRequiresNewline(f.otherComments[0].line, startingLine) {
+		blockWithSpaces = append(blockWithSpaces, []byte{})
+	}
+
+	for _, entry := range f.otherComments[:splitPoint] {
+		if hasLast && lineDifferenceRequiresNewline(entry.line, lastLine) {
+			blockWithSpaces = append(blockWithSpaces, []byte{})
+		}
+		count := lineCount(entry.text)
+		lastLine = entry.line + count - 1
+		hasLast = true
+		blockWithSpaces = append(blockWithSpaces, entry.text)
+	}
+	f.otherComments = append([]commentEntry{}, f.otherComments[splitPoint:]...)
+
+	if !hasLast {
+		lastLine = startingLine
+	}
+	if lineNumber > lastLine+1 {
+		lastLine = lineNumber
+		blockWithSpaces = append(blockWithSpaces, []byte{})
+	}
+
+	return NewCommentBlock(lowestLine, lineNumber+1, blockWithSpaces), lastLine, true
+}
+
+func (f *FileComments) Clone() *FileComments {
+	c := *f
+	c.otherComments = append([]commentEntry{}, f.otherComments...)
+	c.linesWithRuby = append([]int{}, f.linesWithRuby...)
+	c.lineStarts = append([]int{}, f.lineStarts...)
+	c.commentStartOffsets = append([]int{}, f.commentStartOffsets...)
+	if f.startOfFileContiguous != nil {
+		block := *f.startOfFileContiguous
+		block.Comments = append([][]byte{}, f.startOfFileContiguous.Comments...)
+		c.startOfFileContiguous = &block
+	}
+	return &c
+}
+
+func lineDifferenceRequiresNewline(toLine, fromLine int) bool {
+	return toLine > fromLine && toLine-fromLine >= 2
+}
diff --git a/internal/formatter/delimiters.go b/internal/formatter/delimiters.go
new file mode 100644
index 0000000..882ddbd
--- /dev/null
+++ b/internal/formatter/delimiters.go
@@ -0,0 +1,70 @@
+package formatter
+
+type DelimiterPair struct {
+	Open  []byte
+	Close []byte
+}
+
+type BreakableDelims struct {
+	SingleLine DelimiterPair
+	MultiLine  DelimiterPair
+}
+
+var (
+	forMethodCallDelims  = BreakableDelims{DelimiterPair{[]byte("("), []byte(")")}, DelimiterPair{[]byte("("), []byte(")")}}
+	forReturnKwDelims    = BreakableDelims{DelimiterPair{[]byte(" "), []byte("")}, DelimiterPair{[]byte(" ["), []byte("]")}}
+	forKwDelims          = BreakableDelims{DelimiterPair{[]byte(" "), []byte("")}, DelimiterPair{[]byte("("), []byte(")")}}
+	forBlockParamsDelims = BreakableDelims{DelimiterPair{[]byte(" |"), []byte("|")}, DelimiterPair{[]byte(" |"), []byte("|")}}
+	forArrayDelims       = BreakableDelims{DelimiterPair{[]byte("["), []byte("]")}, DelimiterPair{[]byte("["), []byte("]")}}
+	forWhenDelims        = BreakableDelims{DelimiterPair{[]byte(" "), []byte("")}, DelimiterPair{[]byte(""), []byte("")}}
+	forHashDelims        = BreakableDelims{DelimiterPair{[]byte("{"), []byte("}")}, DelimiterPair{[]byte("{"), []byte("}")}}
+	forBraceBlockDelims  = BreakableDelims{DelimiterPair{[]byte("{"), []byte(" }")}, DelimiterPair{[]byte("{"), []byte("}")}}
+	forBinaryOpDelims    = BreakableDelims{DelimiterPair{[]byte(""), []byte("")}, DelimiterPair{[]byte(""), []byte("")}}
+	forParensDelims      = BreakableDelims{DelimiterPair{[]byte("("), []byte(")")}, DelimiterPair{[]byte("("), []byte(")")}}
+)
+
+func ForMethodCall() BreakableDelims  { return forMethodCallDelims }
+func ForReturnKw() BreakableDelims    { return forReturnKwDelims }
+func ForKw() BreakableDelims          { return forKwDelims }
+func ForBlockParams() BreakableDelims { return forBlockParamsDelims }
+func ForArray() BreakableDelims       { return forArrayDelims }
+func ForWhen() BreakableDelims        { return forWhenDelims }
+func ForHash() BreakableDelims        { return forHashDelims }
+func ForBraceBlock() BreakableDelims  { return forBraceBlockDelims }
+func ForBinaryOp() BreakableDelims    { return forBinaryOpDelims }
+func ForParens() BreakableDelims      { return forParensDelims }
+
+func (d BreakableDelims) SingleLineOpen() *ConcreteToken {
+	return DelimToken(d.SingleLine.Open)
+}
+func (d BreakableDelims) SingleLineClose() *ConcreteToken {
+	return DelimToken(d.SingleLine.Close)
+}
+func (d BreakableDelims) MultiLineOpen() *ConcreteToken {
+	return DelimToken(d.MultiLine.Open)
+}
+func (d BreakableDelims) MultiLineClose() *ConcreteToken {
+	return DelimToken(d.MultiLine.Close)
+}
+func (d BreakableDelims) SingleLineLen() int {
+	return len(d.SingleLine.Open) + len(d.SingleLine.Close)
+}
+
+func (d BreakableDelims) Equal(other BreakableDelims) bool {
+	return bytesEqual(d.SingleLine.Open, other.SingleLine.Open) &&
+		bytesEqual(d.SingleLine.Close, other.SingleLine.Close) &&
+		bytesEqual(d.MultiLine.Open, other.MultiLine.Open) &&
+		bytesEqual(d.MultiLine.Close, other.MultiLine.Close)
+}
+
+func bytesEqual(a, b []byte) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/formatter/fixtures_test.go b/internal/formatter/fixtures_test.go
new file mode 100644
index 0000000..3afc5d1
--- /dev/null
+++ b/internal/formatter/fixtures_test.go
@@ -0,0 +1,161 @@
+package formatter
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"testing"
+)
+
+func repoRoot(t testing.TB) string {
+	t.Helper()
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("could not locate test source")
+	}
+	dir := filepath.Dir(file)
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatal("could not locate repository root")
+		}
+		dir = parent
+	}
+}
+
+type fixturePair struct {
+	actual   string
+	expected string
+}
+
+func collectFixtures(t testing.TB, root string) []fixturePair {
+	t.Helper()
+	fixturesDir := filepath.Join(root, "fixtures")
+	byPrefix := map[string]*fixturePair{}
+	err := filepath.WalkDir(fixturesDir, func(path string, entry os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if entry.IsDir() {
+			return nil
+		}
+		name := entry.Name()
+		var prefix string
+		switch {
+		case strings.HasSuffix(name, "_actual.rb"):
+			prefix = strings.TrimSuffix(path, "_actual.rb")
+			pair := byPrefix[prefix]
+			if pair == nil {
+				pair = &fixturePair{}
+				byPrefix[prefix] = pair
+			}
+			pair.actual = path
+		case strings.HasSuffix(name, "_expected.rb"):
+			prefix = strings.TrimSuffix(path, "_expected.rb")
+			pair := byPrefix[prefix]
+			if pair == nil {
+				pair = &fixturePair{}
+				byPrefix[prefix] = pair
+			}
+			pair.expected = path
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	prefixes := make([]string, 0, len(byPrefix))
+	for prefix := range byPrefix {
+		prefixes = append(prefixes, prefix)
+	}
+	sort.Strings(prefixes)
+	pairs := make([]fixturePair, 0, len(prefixes))
+	for _, prefix := range prefixes {
+		pair := byPrefix[prefix]
+		if pair.actual != "" && pair.expected != "" {
+			pairs = append(pairs, *pair)
+		}
+	}
+	return pairs
+}
+
+func TestFixtures(t *testing.T) {
+	root := repoRoot(t)
+	binary := builtRubyfmt(t)
+	pairs := collectFixtures(t, root)
+	if len(pairs) == 0 {
+		t.Fatal("no fixture pairs found")
+	}
+	for _, pair := range pairs {
+		pair := pair
+		name, _ := filepath.Rel(filepath.Join(root, "fixtures"), pair.actual)
+		name = strings.TrimSuffix(name, "_actual.rb")
+		name = strings.ReplaceAll(name, string(filepath.Separator), "_")
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			expected, err := os.ReadFile(pair.expected)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := formatThroughCLI(t, binary, pair.actual)
+			if !bytes.Equal(got, expected) {
+				t.Fatalf("actual did not match expected\n%s", firstDiff(expected, got))
+			}
+			got = formatThroughCLI(t, binary, pair.expected)
+			if !bytes.Equal(got, expected) {
+				t.Fatalf("expected was not idempotent\n%s", firstDiff(expected, got))
+			}
+		})
+	}
+}
+
+func formatThroughCLI(t *testing.T, binary, path string) []byte {
+	t.Helper()
+	command := exec.Command(binary, path)
+	var stdout, stderr bytes.Buffer
+	command.Stdout = &stdout
+	command.Stderr = &stderr
+	if err := command.Run(); err != nil {
+		t.Fatalf("rubyfmt %s failed: %v\n%s", path, err, stderr.String())
+	}
+	return stdout.Bytes()
+}
+
+func firstDiff(expected, got []byte) string {
+	expectedLines := strings.Split(string(expected), "\n")
+	gotLines := strings.Split(string(got), "\n")
+	limit := len(expectedLines)
+	if len(gotLines) < limit {
+		limit = len(gotLines)
+	}
+	for i := 0; i < limit; i++ {
+		if expectedLines[i] != gotLines[i] {
+			return "first difference at line " + itoa(i+1) + "\nexpected: " + expectedLines[i] + "\ngot:      " + gotLines[i]
+		}
+	}
+	if len(expectedLines) != len(gotLines) {
+		return "different line counts"
+	}
+	return "outputs differ"
+}
+
+func itoa(value int) string {
+	if value == 0 {
+		return "0"
+	}
+	var digits [20]byte
+	i := len(digits)
+	for value > 0 {
+		i--
+		digits[i] = byte('0' + value%10)
+		value /= 10
+	}
+	return string(digits[i:])
+}
diff --git a/internal/formatter/format_calls.go b/internal/formatter/format_calls.go
new file mode 100644
index 0000000..6bf8fe4
--- /dev/null
+++ b/internal/formatter/format_calls.go
@@ -0,0 +1,911 @@
+package formatter
+
+import "bytes"
+
+var rspecMethods = [][]byte{[]byte("it"), []byte("describe")}
+var gemfileMethods = [][]byte{[]byte("gem"), []byte("source"), []byte("ruby"), []byte("group")}
+var optionallyParenthesizedMethods = [][]byte{[]byte("super"), []byte("require"), []byte("require_relative")}
+
+func containsBytes(list [][]byte, item []byte) bool {
+	for _, candidate := range list {
+		if bytes.Equal(candidate, item) {
+			return true
+		}
+	}
+	return false
+}
+
+func isDefModifierNode(node Node) bool {
+	if node == nil {
+		return false
+	}
+	if node.Type() == "DefNode" {
+		return true
+	}
+	if node.Type() == "CallNode" && node.Get("receiver") == nil {
+		arguments := node.Get("arguments")
+		if arguments != nil {
+			list := arguments.List("arguments")
+			if len(list) == 1 {
+				return isDefModifierNode(list[0])
+			}
+		}
+	}
+	return false
+}
+
+func useParensForCallNode(ps *ParserState, callNode Node, methodName []byte, isTerminalCall bool, context FormattingContext) bool {
+	originalUsedParens := callNode.LocField("opening_loc") != nil
+
+	arguments := callNode.Get("arguments")
+	hasArguments := arguments != nil && !(len(arguments.List("arguments")) == 0 ||
+		(len(arguments.List("arguments")) == 1 && is_empty_parentheses_node(arguments.List("arguments")[0])))
+
+	block := callNode.Get("block")
+	hasBlockArgOnly := !hasArguments && block != nil && block.Type() == "BlockArgumentNode"
+	if hasBlockArgOnly {
+		return false
+	}
+
+	if isTerminalCall && len(methodName) > 0 && methodName[0] >= 'A' && methodName[0] <= 'Z' {
+		if !hasArguments && block != nil && callNode.Get("receiver") == nil {
+			return false
+		}
+		return true
+	}
+
+	if bytes.HasPrefix(methodName, []byte("attr_")) && context.Kind == FCClassOrModule {
+		return originalUsedParens
+	}
+
+	if ps.scopeHasVariable(methodName) {
+		if callNode.Get("receiver") == nil {
+			return originalUsedParens
+		} else if isTerminalCall && callNode.Get("receiver") != nil && callNode.Get("receiver").Type() == "SelfNode" {
+			return true
+		}
+	}
+
+	if bytes.Equal(methodName, []byte("raise")) {
+		if ps.currentFormattingContextRequiresParens() {
+			return true
+		}
+		if arguments != nil {
+			for _, arg := range arguments.List("arguments") {
+				if arg.Type() == "SplatNode" || arg.Type() == "ForwardingArgumentsNode" {
+					return true
+				}
+			}
+		}
+		return false
+	}
+
+	if containsBytes(optionallyParenthesizedMethods, methodName) || containsBytes(gemfileMethods, methodName) {
+		return originalUsedParens
+	}
+
+	if !hasArguments {
+		return false
+	}
+
+	hasBraceBlock := false
+	if block != nil && block.Type() == "BlockNode" {
+		hasBraceBlock = !bytes.Equal(ps.slice(block.LocField("opening_loc")), []byte("do"))
+	}
+	if hasArguments && hasBraceBlock {
+		return true
+	}
+
+	if containsBytes(rspecMethods, methodName) && callNode.Get("receiver") == nil && block != nil && block.Type() == "BlockNode" {
+		return false
+	}
+
+	if receiver := callNode.Get("receiver"); receiver != nil && receiver.Type() == "ConstantReadNode" {
+		if bytes.Equal([]byte(receiver.Str("name")), []byte("RSpec")) && bytes.Equal(methodName, []byte("describe")) {
+			return false
+		}
+	}
+
+	if context.Kind == FCClassOrModule && !originalUsedParens {
+		return false
+	}
+
+	return true
+}
+
+func startLocForCallNodeInChain(callNode Node) int {
+	if loc := callNode.LocField("message_loc"); loc != nil {
+		return loc.Start
+	}
+	if loc := callNode.LocField("call_operator_loc"); loc != nil {
+		return loc.Start
+	}
+	return callNode.Start()
+}
+
+func callName(ps *ParserState, n Node) []byte {
+	name := []byte(n.Str("name"))
+	ascii := true
+	for _, b := range name {
+		if b >= 0x80 {
+			ascii = false
+			break
+		}
+	}
+	if ascii {
+		return name
+	}
+	if loc := n.LocField("message_loc"); loc != nil {
+		return ps.slice(loc)
+	}
+	return name
+}
+
+func formatCallNode(ps *ParserState, callNode Node, skipReceiver, isFinalCallInChain, skipAttrWriteValue bool) {
+	methodName := callName(ps, callNode)
+	var endOffset int
+	if skipAttrWriteValue {
+		endOffset = callNode.LocField("message_loc").End
+	} else {
+		endOffset = callNode.End()
+	}
+	messageLoc := callNode.LocField("message_loc")
+	isDotCall := bytes.Equal(methodName, []byte("call")) && messageLoc == nil
+	hasCallOperator := callNode.LocField("call_operator_loc") != nil
+	isAref := bytes.Equal(methodName, []byte("[]")) && !hasCallOperator
+	isArefWrite := bytes.Equal(methodName, []byte("[]=")) && !hasCallOperator
+	isAttributeWrite := callNode.HasFlag("CallNodeFlags", "ATTRIBUTE_WRITE")
+	arguments := callNode.Get("arguments")
+	block := callNode.Get("block")
+
+	if skipReceiver || callNode.Get("receiver") == nil {
+		if !isAref && !isArefWrite {
+			var methodIdent []byte
+			if isAttributeWrite {
+				methodIdent = ps.slice(messageLoc)
+			} else if isDotCall {
+				methodIdent = []byte("")
+			} else {
+				methodIdent = methodName
+			}
+			ps.atOffset(startLocForCallNodeInChain(callNode))
+			ps.emitMethodName(methodIdent)
+		}
+
+		hasOnlyEmptyParenArg := !isAref && !isArefWrite && arguments != nil &&
+			len(arguments.List("arguments")) == 1 && is_empty_parentheses_node(arguments.List("arguments")[0])
+
+		if arguments != nil && !hasOnlyEmptyParenArg {
+			argList := arguments.List("arguments")
+			if len(argList) == 1 && isDefModifierNode(argList[0]) {
+				ps.emitSpace()
+				if argList[0].Type() == "DefNode" {
+					formatDefNode(ps, argList[0])
+				} else {
+					ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, argList[0]) })
+				}
+			} else if isArefWrite {
+				argCount := len(argList)
+				ps.withStartOfLine(false, func(ps *ParserState) {
+					ps.breakableOf(ForArray(), func(ps *ParserState) {
+						for i, arg := range argList[:argCount-1] {
+							if i > 0 {
+								ps.emitComma()
+								ps.emitSoftNewline()
+							}
+							ps.emitSoftIndent()
+							formatNode(ps, arg)
+						}
+					})
+				})
+				ps.emitIdent([]byte(" = "))
+				ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, argList[len(argList)-1]) })
+			} else if isAttributeWrite {
+				if !skipAttrWriteValue {
+					ps.emitIdent([]byte(" = "))
+					ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, argList[0]) })
+				}
+			} else {
+				shouldUseParens := useParensForCallNode(ps, callNode, methodName, isFinalCallInChain, ps.currentFormattingContext())
+				delims := ForKw()
+				if isAref {
+					delims = ForArray()
+				} else if shouldUseParens {
+					delims = ForMethodCall()
+				}
+
+				var maybeUnwrappedSingleArg Node
+				if shouldUseParens && len(argList) == 1 && (block == nil || block.Type() != "BlockArgumentNode") {
+					maybeUnwrappedSingleArg = unwrapSingleArgParen(ps, argList[0])
+				}
+
+				var maybeClosingLine *int
+				if closingLoc := callNode.LocField("closing_loc"); closingLoc != nil {
+					line := ps.getLineNumberForOffset(closingLoc.Start)
+					maybeClosingLine = &line
+				}
+
+				ps.withStartOfLine(false, func(ps *ParserState) {
+					ps.breakableOf(delims, func(ps *ParserState) {
+						hasArgs := len(argList) != 0
+						if maybeUnwrappedSingleArg != nil {
+							ps.emitCollapsingNewline()
+							ps.emitSoftIndent()
+							formatNode(ps, maybeUnwrappedSingleArg)
+							ps.shiftComments()
+						} else {
+							formatArgumentsNode(ps, arguments)
+						}
+
+						if block != nil && block.Type() == "BlockArgumentNode" {
+							if hasArgs {
+								ps.emitComma()
+								ps.emitSoftNewline()
+								ps.emitSoftIndent()
+							}
+							formatBlockArgumentNode(ps, block)
+						}
+
+						if maybeClosingLine != nil {
+							ps.windDumpingCommentsUntilLine(*maybeClosingLine - 1)
+						}
+					})
+				})
+				if maybeClosingLine != nil {
+					ps.onLine(*maybeClosingLine)
+				}
+			}
+		} else if isAref {
+			ps.emitOpenSquareBracket()
+			ps.emitCloseSquareBracket()
+		} else if !hasOnlyEmptyParenArg && (!skipReceiver || (callNode.Get("receiver") != nil && callNode.Get("receiver").Type() == "SelfNode")) {
+			shouldUseParens := useParensForCallNode(ps, callNode, methodName, isFinalCallInChain, ps.currentFormattingContext())
+			if shouldUseParens {
+				ps.emitOpenParen()
+				ps.emitCloseParen()
+			}
+		} else {
+			hasBlockArgOnly := arguments == nil && block != nil && block.Type() == "BlockArgumentNode"
+			shouldUseParens := !hasBlockArgOnly && (isDotCall ||
+				useParensForCallNode(ps, callNode, methodName, isFinalCallInChain, ps.currentFormattingContext()))
+			if shouldUseParens {
+				ps.emitOpenParen()
+				ps.emitCloseParen()
+			}
+		}
+
+		if block != nil {
+			if block.Type() != "BlockArgumentNode" {
+				ps.emitSpace()
+				ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, block) })
+				if !skipReceiver {
+					ps.emitAfterCallChain()
+				}
+			} else if arguments == nil {
+				ps.breakableOf(ForMethodCall(), func(ps *ParserState) {
+					ps.emitSoftIndent()
+					formatBlockArgumentNode(ps, block)
+				})
+			}
+		}
+	} else {
+		isUnaryOperator := arguments == nil && callNode.LocField("call_operator_loc") == nil &&
+			(bytes.Equal(methodName, []byte("-@")) || bytes.Equal(methodName, []byte("+@")) ||
+				bytes.Equal(methodName, []byte("!")) || bytes.Equal(methodName, []byte("~")))
+
+		if isUnaryOperator {
+			formatUnaryOperator(ps, callNode, methodName)
+		} else {
+			isInfixOperator := !isAref && !isArefWrite && callNode.LocField("call_operator_loc") == nil
+			if isInfixOperator {
+				ps.inlineBreakableOf(ForBinaryOp(), func(ps *ParserState) {
+					formatInfixOperator(ps, callNode.Get("receiver"), methodName, arguments.List("arguments")[0])
+				})
+			} else {
+				formatCallChain(ps, callNode)
+			}
+			ps.emitAfterCallChain()
+		}
+	}
+	ps.windDumpingCommentsUntilOffset(endOffset)
+}
+
+func formatUnaryOperator(ps *ParserState, callNode Node, methodName []byte) {
+	messageLoc := callNode.LocField("message_loc")
+	isNotWithParens := bytes.Equal(methodName, []byte("!")) && messageLoc != nil &&
+		bytes.Equal(ps.slice(messageLoc), []byte("not")) && callNode.LocField("opening_loc") != nil
+
+	var operatorSymbol []byte
+	switch {
+	case bytes.Equal(methodName, []byte("!")):
+		if messageLoc != nil {
+			messageText := ps.slice(messageLoc)
+			if bytes.Equal(messageText, []byte("not")) {
+				if isNotWithParens {
+					operatorSymbol = []byte("not")
+				} else {
+					operatorSymbol = []byte("not ")
+				}
+			} else {
+				operatorSymbol = []byte("!")
+			}
+		} else {
+			operatorSymbol = []byte("!")
+		}
+	case bytes.Equal(methodName, []byte("-@")):
+		operatorSymbol = []byte("-")
+	case bytes.Equal(methodName, []byte("+@")):
+		operatorSymbol = []byte("+")
+	case bytes.Equal(methodName, []byte("~")):
+		operatorSymbol = []byte("~")
+	default:
+		operatorSymbol = ps.slice(messageLoc)
+	}
+
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.emitIdent(operatorSymbol)
+		receiver := callNode.Get("receiver")
+		if isNotWithParens {
+			ps.breakableOf(ForMethodCall(), func(ps *ParserState) {
+				ps.emitSoftIndent()
+				formatNode(ps, receiver)
+			})
+		} else {
+			formatNode(ps, receiver)
+		}
+	})
+}
+
+func formatInfixOperator(ps *ParserState, left Node, operator []byte, right Node) {
+	ps.withFormattingContext(BinaryContext(), func(ps *ParserState) {
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			if innerLeft, innerOp, innerRight, ok := asBinaryOp(ps, left); ok {
+				formatInfixOperator(ps, innerLeft, innerOp, innerRight)
+			} else {
+				ps.dedent(func(ps *ParserState) { formatNode(ps, left) })
+			}
+
+			comparisonOperators := [][]byte{[]byte(">"), []byte(">="), []byte("==="), []byte("=="), []byte("<"), []byte("<="), []byte("<=>"), []byte("!=")}
+			isComparison := containsBytes(comparisonOperators, operator)
+
+			ps.emitSpace()
+			ps.emitIdent(operator)
+			if isComparison {
+				ps.emitSpace()
+			} else {
+				ps.emitSoftNewline()
+				ps.emitSoftIndent()
+			}
+			ps.resetSpaceCount()
+
+			if innerLeft, innerOp, innerRight, ok := asBinaryOp(ps, right); ok {
+				formatInfixOperator(ps, innerLeft, innerOp, innerRight)
+			} else {
+				formatNode(ps, right)
+			}
+		})
+	})
+}
+
+func asBinaryOp(ps *ParserState, node Node) (Node, []byte, Node, bool) {
+	if node == nil {
+		return nil, nil, nil, false
+	}
+	if node.Type() == "AndNode" {
+		return node.Get("left"), ps.slice(node.LocField("operator_loc")), node.Get("right"), true
+	}
+	if node.Type() == "OrNode" {
+		return node.Get("left"), ps.slice(node.LocField("operator_loc")), node.Get("right"), true
+	}
+	if node.Type() != "CallNode" {
+		return nil, nil, nil, false
+	}
+	if node.LocField("call_operator_loc") != nil {
+		return nil, nil, nil, false
+	}
+	left := node.Get("receiver")
+	if left == nil {
+		return nil, nil, nil, false
+	}
+	arguments := node.Get("arguments")
+	if arguments == nil {
+		return nil, nil, nil, false
+	}
+	args := arguments.List("arguments")
+	if len(args) != 1 {
+		return nil, nil, nil, false
+	}
+	methodName := callName(ps, node)
+	if bytes.Equal(methodName, []byte("[]")) || bytes.Equal(methodName, []byte("[]=")) {
+		return nil, nil, nil, false
+	}
+	return left, methodName, args[0], true
+}
+
+func formatCallChain(ps *ParserState, callNode Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		segments := splitNodeIntoCallChains(ps, callNode)
+		formatCallChainSegments(ps, segments)
+	})
+}
+
+func formatCallChainSegments(ps *ParserState, segments [][]Node) {
+	if len(segments) == 0 {
+		return
+	}
+	current := segments[len(segments)-1]
+	segments = segments[:len(segments)-1]
+	hasInner := len(segments) > 0
+
+	chainElements, trailingArefs := extractTrailingArefs(current)
+
+	var trailingAttrWriteValue Node
+	if len(chainElements) > 0 {
+		last := chainElements[len(chainElements)-1]
+		if last.Type() == "CallNode" {
+			methodName := callName(ps, last)
+			if last.HasFlag("CallNodeFlags", "ATTRIBUTE_WRITE") && !bytes.Equal(methodName, []byte("[]=")) {
+				if args := last.Get("arguments"); args != nil {
+					argList := args.List("arguments")
+					if len(argList) > 0 {
+						trailingAttrWriteValue = argList[0]
+					}
+				}
+			}
+		}
+	}
+
+	shouldMultiline := callChainShouldBeMultilined(ps, chainElements)
+	ps.breakableCallChainOf(shouldMultiline, func(ps *ParserState) {
+		formatCallChainSegments(ps, segments)
+		formatCallBody(ps, chainElements, hasInner, trailingAttrWriteValue != nil)
+	})
+
+	if trailingAttrWriteValue != nil {
+		ps.emitSpace()
+		ps.emitOp([]byte("="))
+		ps.emitSpace()
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, trailingAttrWriteValue) })
+	}
+
+	for _, aref := range trailingArefs {
+		formatCallNode(ps, aref, true, false, false)
+	}
+}
+
+func extractTrailingArefs(elements []Node) ([]Node, []Node) {
+	trailingArefs := []Node{}
+	hasDotCalls := false
+	for _, elem := range elements {
+		if elem.Type() == "CallNode" && elem.LocField("call_operator_loc") != nil {
+			hasDotCalls = true
+			break
+		}
+	}
+	if hasDotCalls {
+		for len(elements) > 0 {
+			lastNode := elements[len(elements)-1]
+			if lastNode.Type() == "CallNode" && lastNode.LocField("call_operator_loc") == nil {
+				trailingArefs = append([]Node{lastNode}, trailingArefs...)
+				elements = elements[:len(elements)-1]
+			} else {
+				break
+			}
+		}
+	}
+	return elements, trailingArefs
+}
+
+func formatCallBody(ps *ParserState, callChainElements []Node, isContinuation, skipFinalAttrWriteValue bool) {
+	if len(callChainElements) == 0 {
+		return
+	}
+	if !isContinuation {
+		firstExpression := callChainElements[0]
+		callChainElements = callChainElements[1:]
+		formatNode(ps, firstExpression)
+		for len(callChainElements) > 0 {
+			next := callChainElements[0]
+			if next.Type() == "CallNode" && next.LocField("call_operator_loc") == nil {
+				callChainElements = callChainElements[1:]
+				formatCallNode(ps, next, true, false, false)
+				continue
+			}
+			break
+		}
+		ps.renderHeredocs(true)
+	}
+
+	if !isContinuation && len(callChainElements) == 1 && callChainElements[0].Type() == "CallNode" &&
+		callChainElements[0].HasFlag("CallNodeFlags", "ATTRIBUTE_WRITE") {
+		attrWrite := callChainElements[0]
+		callOperator := ps.slice(attrWrite.LocField("call_operator_loc"))
+		if callOperator != nil {
+			switch {
+			case bytes.Equal(callOperator, []byte(".")):
+				ps.emitDot()
+			case bytes.Equal(callOperator, []byte("&.")):
+				ps.emitLonelyOperator()
+			case bytes.Equal(callOperator, []byte("::")):
+				ps.emitColonColon()
+			default:
+				ps.emitIdent(callOperator)
+			}
+		}
+		ps.atOffset(startLocForCallNodeInChain(attrWrite))
+		ps.shiftComments()
+		formatCallNode(ps, attrWrite, true, true, skipFinalAttrWriteValue)
+	} else if len(callChainElements) != 0 {
+		ps.startIndentForCallChain()
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			count := len(callChainElements)
+			for idx, element := range callChainElements {
+				isFinalCall := idx == count-1
+				callOperator := ps.slice(element.LocField("call_operator_loc"))
+				if callOperator != nil {
+					if !bytes.Equal(callOperator, []byte("::")) {
+						ps.emitCollapsingNewline()
+						ps.emitSoftIndent()
+					}
+					switch {
+					case bytes.Equal(callOperator, []byte(".")):
+						ps.emitDot()
+					case bytes.Equal(callOperator, []byte("&.")):
+						ps.emitLonelyOperator()
+					case bytes.Equal(callOperator, []byte("::")):
+						ps.emitColonColon()
+					default:
+						ps.emitIdent(callOperator)
+					}
+				}
+				ps.withUserNewlinesDisabled(func(ps *ParserState) {
+					ps.atOffset(startLocForCallNodeInChain(element))
+				})
+				ps.shiftComments()
+
+				skipValue := isFinalCall && skipFinalAttrWriteValue && element.HasFlag("CallNodeFlags", "ATTRIBUTE_WRITE")
+				formatCallNode(ps, element, true, isFinalCall, skipValue)
+			}
+		})
+		ps.endIndentForCallChain()
+	}
+}
+
+func callChainShouldBeMultilined(ps *ParserState, callChainElements []Node) bool {
+	if len(callChainElements) > 1 {
+		firstType := callChainElements[0].Type()
+		isLiteralExpression := !(firstType == "CallNode" || firstType == "ConstantReadNode" || firstType == "ConstantPathNode" ||
+			firstType == "LocalVariableReadNode" || firstType == "GlobalVariableReadNode" ||
+			firstType == "InstanceVariableReadNode" || firstType == "ClassVariableReadNode" ||
+			firstType == "ItLocalVariableReadNode" || firstType == "NumberedReferenceReadNode" || firstType == "ParenthesesNode")
+		if isLiteralExpression {
+			firstCallStartLine := ps.getLineNumberForOffset(startLocForCallNodeInChain(callChainElements[1]))
+			leadingExprEndLine := ps.getLineNumberForOffset(callChainElements[0].End())
+			hasCommentBetween := ps.hasCommentsInLine(leadingExprEndLine+1, firstCallStartLine+1)
+			if !hasCommentBetween && !elementForcesChainToMultiline(ps, callChainElements[0]) {
+				callChainElements = callChainElements[1:]
+			}
+		}
+	}
+
+	firstIsNotCall := len(callChainElements) > 0 && callChainElements[0].Type() != "CallNode"
+	secondIsAref := len(callChainElements) > 1 && callChainElements[1].Type() == "CallNode" &&
+		callChainElements[1].LocField("call_operator_loc") == nil
+	if firstIsNotCall && secondIsAref {
+		callChainElements = callChainElements[1:]
+		for len(callChainElements) > 1 && callChainElements[0].Type() == "CallNode" {
+			if callChainElements[0].LocField("call_operator_loc") == nil {
+				callChainElements = callChainElements[1:]
+				continue
+			}
+			break
+		}
+	}
+	if len(callChainElements) == 0 {
+		return false
+	}
+
+	startLine := 0
+	startNode := callChainElements[0]
+	if startNode.Type() == "CallNode" {
+		startLine = ps.getLineNumberForOffset(startLocForCallNodeInChain(startNode))
+	} else {
+		startLine = ps.getLineNumberForOffset(startNode.Start())
+	}
+
+	for i := 1; i < len(callChainElements); i++ {
+		cce := callChainElements[i]
+		operatorLine := startLine
+		if loc := cce.LocField("call_operator_loc"); loc != nil {
+			operatorLine = ps.getLineNumberForOffset(loc.Start)
+		}
+		if startLine != operatorLine {
+			return true
+		}
+		if elementForcesChainToMultiline(ps, callChainElements[i-1]) {
+			return true
+		}
+	}
+	return false
+}
+
+func elementForcesChainToMultiline(ps *ParserState, element Node) bool {
+	if block := element.Get("block"); block != nil && block.Type() == "BlockNode" {
+		return blockBodyRendersMultiline(ps.slice(block.LocField("opening_loc")), block)
+	}
+	if element.Type() == "LambdaNode" {
+		return blockBodyRendersMultiline(ps.slice(element.LocField("opening_loc")), element)
+	}
+	return false
+}
+
+func blockBodyRendersMultiline(opening []byte, node Node) bool {
+	if bytes.Equal(opening, []byte("do")) {
+		return true
+	}
+	body := node.Get("body")
+	if body != nil && body.Type() == "StatementsNode" {
+		return len(body.List("body")) > 1
+	}
+	return false
+}
+
+func splitNodeIntoCallChains(ps *ParserState, node Node) [][]Node {
+	var elements []Node
+	maybeReceiver := node
+	for maybeReceiver != nil {
+		receiver := maybeReceiver
+		var next Node
+		if receiver.Type() == "CallNode" {
+			methodName := callName(ps, receiver)
+			isUnary := receiver.Get("arguments") == nil && receiver.LocField("call_operator_loc") == nil &&
+				(bytes.Equal(methodName, []byte("-@")) || bytes.Equal(methodName, []byte("+@")) ||
+					bytes.Equal(methodName, []byte("!")) || bytes.Equal(methodName, []byte("~")))
+			if !isUnary {
+				next = receiver.Get("receiver")
+			}
+		}
+		maybeReceiver = next
+		elements = append([]Node{receiver}, elements...)
+	}
+
+	hasDotAfter := make([]bool, len(elements))
+	seenDot := false
+	for i := len(elements) - 1; i >= 0; i-- {
+		hasDotAfter[i] = seenDot
+		if elements[i].Type() == "CallNode" && elements[i].LocField("call_operator_loc") != nil {
+			seenDot = true
+		}
+	}
+
+	var splitBefore []int
+	seenDotCall := false
+	for i, node := range elements {
+		if node.Type() == "CallNode" {
+			nodeIsDotCall := node.LocField("call_operator_loc") != nil
+			isAref := !nodeIsDotCall
+			if isAref && seenDotCall && hasDotAfter[i] {
+				splitIdx := i
+				for splitIdx < len(elements) {
+					if elements[splitIdx].Type() == "CallNode" && elements[splitIdx].LocField("call_operator_loc") == nil {
+						splitIdx++
+						continue
+					}
+					break
+				}
+				splitBefore = append(splitBefore, splitIdx)
+				seenDotCall = false
+				continue
+			}
+			if nodeIsDotCall {
+				seenDotCall = true
+			}
+		}
+	}
+
+	if len(splitBefore) == 0 {
+		return [][]Node{elements}
+	}
+
+	var segments [][]Node
+	remaining := elements
+	for i := len(splitBefore) - 1; i >= 0; i-- {
+		splitIdx := splitBefore[i]
+		after := append([]Node{}, remaining[splitIdx:]...)
+		remaining = remaining[:splitIdx]
+		segments = append([][]Node{after}, segments...)
+	}
+	segments = append([][]Node{remaining}, segments...)
+	return segments
+}
+
+func formatArgumentsNode(ps *ParserState, n Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		formatListLikeThing(ps, n.List("arguments"), n.End(), false)
+	})
+}
+
+func formatBlockArgumentNode(ps *ParserState, n Node) {
+	ps.emitIdent([]byte("&"))
+	if expression := n.Get("expression"); expression != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, expression) })
+	}
+}
+
+func formatBlockParameterNode(ps *ParserState, n Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.emitSoftIndent()
+		ps.emitIdent([]byte("&"))
+		if n.Has("name") {
+			ident := []byte(n.Str("name"))
+			ps.bindVariable(ident)
+			handleStringAtOffset(ps, ident, n.LocField("name_loc").End)
+		} else {
+			ps.atOffset(n.Start())
+		}
+	})
+}
+
+func formatBlockParametersNode(ps *ParserState, n Node) {
+	if len(n.List("locals")) == 0 && n.Get("parameters") == nil {
+		return
+	}
+	ps.breakableOf(ForBlockParams(), func(ps *ParserState) {
+		formatBlockParametersNames(ps, n.List("locals"), n.Get("parameters"), n.End())
+	})
+}
+
+func formatBlockParametersNames(ps *ParserState, locals []Node, parameters Node, endOffset int) {
+	hasLocals := len(locals) > 0
+	if parameters != nil {
+		formatParametersNode(ps, parameters)
+	}
+	if hasLocals {
+		ps.emitIdent([]byte(";"))
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			formatListLikeThing(ps, locals, endOffset, true)
+		})
+	}
+	ps.windDumpingCommentsUntilOffset(endOffset)
+}
+
+func formatBlockLocalVariableNode(ps *ParserState, n Node) {
+	handleStringAtOffset(ps, nameBytes(ps, n), n.Start())
+}
+
+func formatBraceBlockBody(ps *ParserState, body Node, openingStartOffset, closingEndOffset, endOffset int) {
+	if body != nil {
+		if body.Type() == "StatementsNode" {
+			statements := body.List("body")
+			if len(statements) > 1 {
+				ps.emitNewline()
+				ps.emitIndent()
+				ps.withStartOfLine(false, func(ps *ParserState) {
+					for i, node := range statements {
+						formatNode(ps, node)
+						ps.emitSoftNewline()
+						if i < len(statements)-1 {
+							ps.emitSoftIndent()
+						}
+					}
+					ps.shiftComments()
+				})
+			} else {
+				ps.withStartOfLine(false, func(ps *ParserState) {
+					if len(statements) > 0 {
+						ps.emitSoftNewline()
+						ps.emitSoftIndent()
+						formatNode(ps, statements[0])
+						ps.emitSoftNewline()
+					}
+				})
+			}
+		}
+	} else if ps.hasCommentInOffsetSpan(openingStartOffset, closingEndOffset) {
+		ps.emitSoftNewline()
+	}
+	ps.dedent(func(ps *ParserState) { ps.emitSoftIndent() })
+	ps.windDumpingCommentsUntilOffset(endOffset)
+	ps.shiftComments()
+}
+
+func formatBlockNode(ps *ParserState, n Node) {
+	if bytes.Equal(ps.slice(n.LocField("opening_loc")), []byte("do")) {
+		ps.newBlock(func(ps *ParserState) {
+			ps.emitDoKeyword()
+			if params := n.Get("parameters"); params != nil && params.Type() != "NumberedParametersNode" && params.Type() != "ItParametersNode" {
+				ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, params) })
+			}
+			ps.emitNewline()
+			if body := n.Get("body"); body != nil {
+				ps.withStartOfLine(true, func(ps *ParserState) { formatNode(ps, body) })
+			}
+		})
+		ps.withStartOfLine(true, func(ps *ParserState) {
+			ps.windDumpingCommentsUntilOffset(n.End())
+			ps.emitEnd()
+			ps.shiftComments()
+		})
+	} else {
+		ps.inlineBreakableOf(ForBraceBlock(), func(ps *ParserState) {
+			if params := n.Get("parameters"); params != nil && params.Type() != "NumberedParametersNode" && params.Type() != "ItParametersNode" {
+				formatNode(ps, params)
+			}
+			formatBraceBlockBody(ps, n.Get("body"), n.LocField("opening_loc").Start, n.LocField("closing_loc").End, n.End())
+		})
+	}
+}
+
+func formatParametersNode(ps *ParserState, params Node) {
+	nonNull := nonNullPositions(params)
+	formats := []func(*ParserState, Node){
+		func(ps *ParserState, p Node) {
+			list := p.List("requireds")
+			if len(list) > 0 {
+				formatListLikeThing(ps, list, nodeListEndOffset(list), false)
+			}
+		},
+		func(ps *ParserState, p Node) {
+			list := p.List("optionals")
+			if len(list) > 0 {
+				formatListLikeThing(ps, list, nodeListEndOffset(list), false)
+			}
+		},
+		func(ps *ParserState, p Node) {
+			if rest := p.Get("rest"); rest != nil {
+				formatNode(ps, rest)
+			}
+		},
+		func(ps *ParserState, p Node) {
+			list := p.List("posts")
+			if len(list) > 0 {
+				formatListLikeThing(ps, list, nodeListEndOffset(list), false)
+			}
+		},
+		func(ps *ParserState, p Node) {
+			list := p.List("keywords")
+			if len(list) > 0 {
+				formatListLikeThing(ps, list, nodeListEndOffset(list), false)
+			}
+		},
+		func(ps *ParserState, p Node) {
+			if keywordRest := p.Get("keyword_rest"); keywordRest != nil {
+				formatNode(ps, keywordRest)
+			}
+		},
+		func(ps *ParserState, p Node) {
+			if block := p.Get("block"); block != nil {
+				formatBlockParameterNode(ps, block)
+			}
+		},
+	}
+
+	for idx, formatFn := range formats {
+		formatFn(ps, params)
+		didEmit := nonNull[idx]
+		haveMore := false
+		for _, v := range nonNull[idx+1:] {
+			if v {
+				haveMore = true
+				break
+			}
+		}
+		if didEmit && haveMore {
+			ps.emitComma()
+			ps.emitSoftNewline()
+		}
+		ps.shiftComments()
+	}
+}
+
+func nonNullPositions(params Node) [7]bool {
+	return [7]bool{
+		len(params.List("requireds")) > 0,
+		len(params.List("optionals")) > 0,
+		params.Get("rest") != nil,
+		len(params.List("posts")) > 0,
+		len(params.List("keywords")) > 0,
+		params.Get("keyword_rest") != nil,
+		params.Get("block") != nil,
+	}
+}
