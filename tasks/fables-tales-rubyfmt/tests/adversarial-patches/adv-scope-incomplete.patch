-                        ps.with_start_of_line(false, |ps| {
-                            format_node(ps, body);
-                        });
-                    }
-                }
-            });
-        });
-    } else {
-        ps.emit_open_paren();
-        if let Some(body) = parentheses_node.body() {
-            ps.with_start_of_line(false, |ps| {
-                if let Some(statements_node) = body.as_statements_node() {
-                    if let Some(stmt) = statements_node.body().first() {
-                        format_node(ps, stmt);
