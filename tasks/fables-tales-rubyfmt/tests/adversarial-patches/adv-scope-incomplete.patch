+package formatter
+
+import "bytes"
+
+func formatCallAndWriteNode(ps *ParserState, n Node) {
+	if receiver := n.Get("receiver"); receiver != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, receiver) })
+	}
+	if loc := n.LocField("call_operator_loc"); loc != nil {
+		ps.emitIdent(ps.slice(loc))
+	}
+	if loc := n.LocField("message_loc"); loc != nil {
+		ps.emitIdent(ps.slice(loc))
+	}
+	ps.emitSpace()
+	ps.emitOp([]byte("&&="))
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("value")) })
+}
+
+func formatCallOperatorWriteNode(ps *ParserState, n Node) {
+	if receiver := n.Get("receiver"); receiver != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, receiver) })
+	}
+	if loc := n.LocField("call_operator_loc"); loc != nil {
+		ps.emitIdent(ps.slice(loc))
+	}
+	if loc := n.LocField("message_loc"); loc != nil {
+		ps.emitIdent(ps.slice(loc))
+	}
+	ps.emitSpace()
+	ps.emitOp(ps.slice(n.LocField("binary_operator_loc")))
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("value")) })
+}
+
+func formatCallOrWriteNode(ps *ParserState, n Node) {
+	if receiver := n.Get("receiver"); receiver != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, receiver) })
+	}
+	if loc := n.LocField("call_operator_loc"); loc != nil {
+		ps.emitIdent(ps.slice(loc))
+	}
+	if loc := n.LocField("message_loc"); loc != nil {
+		ps.emitIdent(ps.slice(loc))
+	}
+	ps.emitSpace()
+	ps.emitOp([]byte("||="))
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("value")) })
+}
+
+func formatCallTargetNode(ps *ParserState, n Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("receiver")) })
+	ps.emitIdent(ps.slice(n.LocField("call_operator_loc")))
+	ps.emitIdent(ps.slice(n.LocField("message_loc")))
+}
+
+func formatIndexAndWriteNode(ps *ParserState, n Node) {
+	if receiver := n.Get("receiver"); receiver != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, receiver) })
+	}
+	if arguments := n.Get("arguments"); arguments != nil {
+		ps.breakableOf(ForArray(), func(ps *ParserState) {
+			formatArgumentsNode(ps, arguments)
+		})
+	}
+	ps.emitSpace()
+	ps.emitOp([]byte("&&="))
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("value")) })
+}
+
+func formatIndexOperatorWriteNode(ps *ParserState, n Node) {
+	if receiver := n.Get("receiver"); receiver != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, receiver) })
+	}
+	if arguments := n.Get("arguments"); arguments != nil {
+		ps.breakableOf(ForArray(), func(ps *ParserState) {
+			formatArgumentsNode(ps, arguments)
+		})
+	}
+	ps.emitSpace()
+	ps.emitOp(ps.slice(n.LocField("binary_operator_loc")))
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("value")) })
+}
+
+func formatIndexOrWriteNode(ps *ParserState, n Node) {
+	if receiver := n.Get("receiver"); receiver != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, receiver) })
+	}
+	if arguments := n.Get("arguments"); arguments != nil {
+		ps.breakableOf(ForArray(), func(ps *ParserState) {
+			formatArgumentsNode(ps, arguments)
+		})
+	}
+	ps.emitSpace()
+	ps.emitOp([]byte("||="))
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("value")) })
+}
+
+func formatIndexTargetNode(ps *ParserState, n Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("receiver")) })
+	if arguments := n.Get("arguments"); arguments != nil {
+		ps.breakableOf(ForArray(), func(ps *ParserState) {
+			formatArgumentsNode(ps, arguments)
+		})
+	}
+}
+
+func formatFindPatternNode(ps *ParserState, n Node) {
+	if constant := n.Get("constant"); constant != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, constant) })
+	}
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.newBlock(func(ps *ParserState) {
+			ps.breakableOf(ForArray(), func(ps *ParserState) {
+				ps.emitSoftIndent()
+				ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("left")) })
+				requireds := n.List("requireds")
+				requiredsEndOffset := nodeListEndOffset(requireds)
+				if len(requireds) > 0 {
+					ps.emitComma()
+					ps.emitSoftNewline()
+					ps.emitSoftIndent()
+				}
+				formatListLikeThing(ps, requireds, requiredsEndOffset, false)
+				ps.emitComma()
+				ps.emitSoftNewline()
+				ps.emitSoftIndent()
+				ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("right")) })
+			})
+		})
+	})
+}
+
+func formatArrayPatternNode(ps *ParserState, n Node) {
+	if constant := n.Get("constant"); constant != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, constant) })
+	}
+	requireds := n.List("requireds")
+	rest := n.Get("rest")
+	posts := n.List("posts")
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.newBlock(func(ps *ParserState) {
+			ps.breakableOf(ForArray(), func(ps *ParserState) {
+				for i, element := range requireds {
+					if i > 0 {
+						ps.emitComma()
+						ps.emitSoftNewline()
+					}
+					ps.emitSoftIndent()
+					ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, element) })
+				}
+				hasRest := false
+				if rest != nil {
+					if len(requireds) > 0 {
+						ps.emitComma()
+						ps.emitSoftNewline()
+					}
+					ps.emitSoftIndent()
+					ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, rest) })
+					hasRest = true
+				}
+				hasPrior := len(requireds) > 0 || hasRest
+				for i, element := range posts {
+					if i > 0 || hasPrior {
+						ps.emitComma()
+						ps.emitSoftNewline()
+					}
+					ps.emitSoftIndent()
+					ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, element) })
+				}
+			})
+		})
+	})
+}
+
+func formatHashPatternNode(ps *ParserState, n Node) {
+	if constant := n.Get("constant"); constant != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, constant) })
+	}
+	opener := ps.slice(n.LocField("opening_loc"))
+	useParens := n.Get("constant") != nil || bytes.HasPrefix(opener, []byte("("))
+	elements := n.List("elements")
+	delims := ForHash()
+	if useParens {
+		delims = ForMethodCall()
+	}
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.newBlock(func(ps *ParserState) {
+			ps.breakableOf(delims, func(ps *ParserState) {
+				for i, element := range elements {
+					if i > 0 {
+						ps.emitComma()
+						ps.emitSoftNewline()
+					}
+					ps.emitSoftIndent()
+					ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, element) })
+				}
+				if rest := n.Get("rest"); rest != nil {
+					if len(elements) > 0 {
+						ps.emitComma()
+						ps.emitSoftNewline()
+					}
+					ps.emitSoftIndent()
+					ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, rest) })
+				}
+			})
+		})
+	})
+}
+
+func formatParenthesesNode(ps *ParserState, n Node) {
+	isMultilinable := false
+	if body := n.Get("body"); body != nil {
+		if body.Type() == "StatementsNode" {
+			list := body.List("body")
+			isMultilinable = len(list) > 1 || (len(list) > 0 && isMultilinableNode(list[0]))
+		} else {
+			isMultilinable = true
+		}
+	}
+
+	if isMultilinable {
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			ps.breakableOf(ForParens(), func(ps *ParserState) {
+				if body := n.Get("body"); body != nil {
+					if body.Type() == "StatementsNode" {
+						statements := body.List("body")
+						for idx, stmt := range statements {
+							ps.emitSoftIndent()
+							ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, stmt) })
+							if idx < len(statements)-1 {
+								ps.emitNewline()
+							}
+						}
+					} else {
+						ps.emitSoftIndent()
+						ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, body) })
+					}
+				}
+			})
+		})
+	} else {
+		ps.emitOpenParen()
+		if body := n.Get("body"); body != nil {
+			ps.withStartOfLine(false, func(ps *ParserState) {
+				if body.Type() == "StatementsNode" {
+					list := body.List("body")
+					if len(list) > 0 {
+						formatNode(ps, list[0])
+					}
+				} else {
+					formatNode(ps, body)
+				}
+			})
+		}
+		ps.emitCloseParen()
+	}
+}
+
+func isMultilinableNode(node Node) bool {
+	switch node.Type() {
+	case "CaseNode", "CaseMatchNode", "BeginNode", "UnlessNode":
+		return true
+	case "IfNode":
+		return node.LocField("if_keyword_loc") != nil
+	case "WhileNode":
+		return node.LocField("closing_loc") != nil
+	case "UntilNode":
+		return node.LocField("closing_loc") != nil
+	case "ForNode", "DefNode", "ClassNode", "ModuleNode":
+		return true
+	}
+	return false
+}
+
+func formatLambdaNode(ps *ParserState, n Node) {
+	operator := ps.slice(n.LocField("operator_loc"))
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.emitIdent(operator)
+		if parametersNode := n.Get("parameters"); parametersNode != nil {
+			if bytes.Equal(operator, []byte("->")) && parametersNode.Type() == "BlockParametersNode" {
+				if parametersNode.Get("parameters") != nil || len(parametersNode.List("locals")) > 0 {
+					ps.emitSpace()
+					ps.breakableOf(ForMethodCall(), func(ps *ParserState) {
+						formatBlockParametersNames(ps, parametersNode.List("locals"), parametersNode.Get("parameters"), parametersNode.End())
+					})
+				}
+			} else {
+				formatNode(ps, parametersNode)
+			}
+		}
+		opening := ps.slice(n.LocField("opening_loc"))
+		if bytes.Equal(opening, []byte("do")) {
+			ps.emitSpace()
+			ps.newBlock(func(ps *ParserState) {
+				ps.emitDoKeyword()
+				ps.emitNewline()
+				if body := n.Get("body"); body != nil {
+					ps.withStartOfLine(true, func(ps *ParserState) { formatNode(ps, body) })
+				}
+			})
+			ps.withStartOfLine(true, func(ps *ParserState) {
+				ps.windDumpingCommentsUntilOffset(n.End())
+				ps.emitEnd()
+				ps.shiftComments()
+			})
+		} else {
+			ps.emitSpace()
+			ps.inlineBreakableOf(ForBraceBlock(), func(ps *ParserState) {
+				formatBraceBlockBody(ps, n.Get("body"), n.LocField("opening_loc").Start, n.LocField("closing_loc").End, n.End())
+			})
+		}
+	})
+}
+
+type CondKind int
+
+const (
+	CondIf CondKind = iota
+	CondUnless
+	CondWhile
+	CondUntil
+)
+
+type Conditional struct {
+	Kind CondKind
+	Node Node
+}
+
+func (c *Conditional) predicate() Node  { return c.Node.Get("predicate") }
+func (c *Conditional) statements() Node { return c.Node.Get("statements") }
+
+func (c *Conditional) subsequentOrElse() Node {
+	switch c.Kind {
+	case CondIf:
+		return c.Node.Get("subsequent")
+	case CondUnless:
+		return c.Node.Get("else_clause")
+	}
+	return nil
+}
+
+func (c *Conditional) isBeginModifier() bool {
+	switch c.Kind {
+	case CondWhile, CondUntil:
+		return c.Node.HasFlag("LoopFlags", "BEGIN_MODIFIER")
+	}
+	return false
+}
+
+func (c *Conditional) keywordStartOffset() int {
+	switch c.Kind {
+	case CondIf:
+		if loc := c.Node.LocField("if_keyword_loc"); loc != nil {
+			return loc.Start
+		}
+		return c.Node.Start()
+	default:
+		return c.Node.LocField("keyword_loc").Start
+	}
+}
+
+func formatConditionalNode(ps *ParserState, conditionalKeyword []byte, requiresEndKeyword bool, conditional *Conditional) {
+	if conditional.isBeginModifier() {
+		beginNode := conditional.statements().List("body")[0]
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			formatBeginNode(ps, beginNode)
+			ps.emitSpace()
+			ps.emitKeyword(conditionalKeyword)
+			ps.emitSpace()
+			formatNode(ps, conditional.predicate())
+		})
+		return
+	}
+
+	isModifier := false
+	if statements := conditional.statements(); statements != nil {
+		isModifier = statements.Start() < conditional.keywordStartOffset()
+	}
+
+	if isModifier {
+		switch conditional.Kind {
+		case CondWhile, CondUntil:
+			formatInlineConditional(ps, conditional.predicate(), conditional.statements(), conditionalKeyword)
+		case CondIf, CondUnless:
+			ps.conditionalLayoutOf(conditionalKeyword,
+				func(ps *ParserState) { formatNode(ps, conditional.predicate()) },
+				func(ps *ParserState) {
+					if statements := conditional.statements(); statements != nil {
+						if list := statements.List("body"); len(list) > 0 {
+							formatNode(ps, list[0])
+						}
+					}
+				})
+		}
+	} else {
+		formatConditionalBlockForm(ps, conditionalKeyword, conditional.predicate(), conditional.statements(), conditional.subsequentOrElse(), requiresEndKeyword)
+	}
+}
+
+func formatInlineConditional(ps *ParserState, predicate Node, statements Node, keyword []byte) {
+	if statements != nil {
+		if list := statements.List("body"); len(list) > 0 {
+			ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, list[0]) })
+		}
+		ps.emitSpace()
+	}
+	ps.emitConditionalKeyword(keyword)
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, predicate) })
+}
+
+func formatConditionalBlockForm(ps *ParserState, keyword []byte, predicate Node, statements Node, subsequentOrElse Node, requiresEndKeyword bool) {
+	ps.emitConditionalKeyword(keyword)
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.newBlock(func(ps *ParserState) { formatNode(ps, predicate) })
+	})
+	ps.newBlock(func(ps *ParserState) {
+		ps.emitNewline()
+		if statements != nil {
+			formatNode(ps, statements)
+		}
+	})
+	if subsequentOrElse != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			ps.emitIndent()
+			formatNode(ps, subsequentOrElse)
+		})
+	}
+	if requiresEndKeyword {
+		ps.withStartOfLine(true, func(ps *ParserState) { ps.emitEnd() })
+	}
+}
+
+func formatIfNode(ps *ParserState, n Node) {
+	if ifLoc := n.LocField("if_keyword_loc"); ifLoc != nil {
+		isIfKeyword := (ifLoc.End - ifLoc.Start) == 2
+		keyword := []byte("if")
+		if !isIfKeyword {
+			keyword = []byte("elsif")
+		}
+		formatConditionalNode(ps, keyword, isIfKeyword, &Conditional{Kind: CondIf, Node: n})
+	} else {
+		ps.withFormattingContext(IfOpContext(), func(ps *ParserState) {
+			ps.withStartOfLine(false, func(ps *ParserState) {
+				formatNode(ps, n.Get("predicate"))
+				ps.emitIdent([]byte(" ? "))
+				formatNode(ps, n.Get("statements").List("body")[0])
+				formatNode(ps, n.Get("subsequent"))
+			})
+		})
+	}
+}
+
+func formatInNode(ps *ParserState, n Node) {
+	ps.emitInKeyword()
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.emitSpace()
+		formatNode(ps, n.Get("pattern"))
+	})
+	ps.newBlock(func(ps *ParserState) {
+		ps.withStartOfLine(true, func(ps *ParserState) {
+			ps.emitNewline()
+			if statements := n.Get("statements"); statements != nil {
+				formatNode(ps, statements)
+			}
+		})
+	})
+}
+
+func formatWhenNode(ps *ParserState, n Node) {
+	ps.atOffset(n.Start())
+	ps.emitIndent()
+	ps.emitWhenKeyword()
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.newBlock(func(ps *ParserState) {
+			ps.inlineBreakableOf(ForWhen(), func(ps *ParserState) {
+				ps.emitCollapsingNewline()
+				formatListLikeThing(ps, n.List("conditions"), nodeListEndOffset(n.List("conditions")), false)
+			})
+		})
+	})
+	if whenConditionsEndWithEndlessRange(n) {
+		ps.emitSpace()
+		ps.emitKeyword([]byte("then"))
+	}
+	ps.newBlock(func(ps *ParserState) {
+		ps.withStartOfLine(true, func(ps *ParserState) {
+			ps.emitNewline()
+			if statements := n.Get("statements"); statements != nil {
+				formatNode(ps, statements)
+			}
+		})
+	})
+}
+
+func whenConditionsEndWithEndlessRange(n Node) bool {
+	conditions := n.List("conditions")
+	if len(conditions) == 0 {
+		return false
+	}
+	last := conditions[len(conditions)-1]
+	return last.Type() == "RangeNode" && last.Get("right") == nil
+}
+
+func formatRescueNode(ps *ParserState, n Node) {
+	ps.atOffset(n.Start())
+	ps.emitKeyword([]byte("rescue"))
+	exceptions := n.List("exceptions")
+	reference := n.Get("reference")
+	if len(exceptions) > 0 {
+		ps.atOffset(exceptions[0].Start())
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			ps.inlineBreakableOf(ForBinaryOp(), func(ps *ParserState) {
+				count := len(exceptions)
+				for idx, exception := range exceptions {
+					if idx == 0 {
+						ps.emitSpace()
+						formatNode(ps, exception)
+					} else {
+						ps.emitSoftIndent()
+						formatNode(ps, exception)
+					}
+					if idx != count-1 {
+						ps.emitComma()
+						ps.emitSoftNewline()
+					}
+				}
+				if reference != nil {
+					ps.emitSpace()
+					ps.emitOp([]byte("=>"))
+					ps.emitSpace()
+					formatNode(ps, reference)
+				}
+			})
+		})
+	} else if reference != nil {
+		ps.emitSpace()
+		ps.emitOp([]byte("=>"))
+		ps.emitSpace()
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, reference) })
+	}
+	ps.newBlock(func(ps *ParserState) {
+		ps.emitNewline()
+		if statements := n.Get("statements"); statements != nil {
+			formatStatements(ps, statements)
+		}
+		ps.shiftComments()
+	})
+	if subsequent := n.Get("subsequent"); subsequent != nil {
+		ps.emitIndent()
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, subsequent) })
+	}
+	ps.atOffset(n.End())
+}
+
+func is_empty_parentheses_node(node Node) bool {
+	if node == nil || node.Type() != "ParenthesesNode" {
+		return false
+	}
+	body := node.Get("body")
+	if body == nil {
+		return true
+	}
+	if body.Type() == "StatementsNode" {
+		return len(body.List("body")) == 0
+	}
+	return false
+}
+
+func isKeywordExpression(ps *ParserState, node Node) bool {
+	switch node.Type() {
+	case "IfNode":
+		return node.LocField("if_keyword_loc") != nil
+	case "UnlessNode", "WhileNode", "UntilNode", "RescueModifierNode", "CaseNode", "CaseMatchNode", "BeginNode", "ForNode", "LocalVariableWriteNode":
+		return true
+	case "AndNode":
+		return bytes.Equal(ps.slice(node.LocField("operator_loc")), []byte("and"))
+	case "OrNode":
+		return bytes.Equal(ps.slice(node.LocField("operator_loc")), []byte("or"))
+	}
+	return false
+}
+
+func unwrapSingleArgParen(ps *ParserState, node Node) Node {
+	if node == nil || node.Type() != "ParenthesesNode" {
+		return nil
+	}
+	body := node.Get("body")
+	if body == nil || body.Type() != "StatementsNode" {
+		return nil
+	}
+	statements := body.List("body")
+	if len(statements) != 1 {
+		return nil
+	}
+	inner := statements[0]
+	if isKeywordExpression(ps, inner) {
+		return nil
+	}
+	if inner.Type() == "ParenthesesNode" {
+		if deeper := unwrapSingleArgParen(ps, inner); deeper != nil {
+			return deeper
+		}
+	}
+	return inner
+}
+
+func formatListLikeThing(ps *ParserState, nodeList []Node, endOffset int, singleLine bool) bool {
+	emittedArgs := false
+	argsCount := len(nodeList)
+	endLine := ps.getLineNumberForOffset(endOffset)
+	ps.magicHandleCommentsForMultilineArrays(&endLine, func(ps *ParserState) {
+		for idx, expr := range nodeList {
+			if singleLine {
+				formatNode(ps, expr)
+				if idx != argsCount-1 {
+					ps.emitCommaSpace()
+				}
+			} else {
+				ps.withStartOfLine(false, func(ps *ParserState) {
+					if expr.Type() == "AssocNode" {
+						if idx > 0 {
+							ps.emitSoftIndent()
+						}
+						formatAssocNode(ps, expr)
+					} else if expr.Type() == "AssocSplatNode" {
+						if idx > 0 {
+							ps.emitSoftIndent()
+						}
+						formatAssocSplatNode(ps, expr)
+					} else {
+						ps.emitSoftIndent()
+						formatNode(ps, expr)
+					}
+					if idx != argsCount-1 {
+						ps.emitComma()
+						ps.emitSoftNewline()
+					} else {
+						ps.shiftComments()
+					}
+				})
+			}
+			emittedArgs = true
+		}
+	})
+	return emittedArgs
+}
