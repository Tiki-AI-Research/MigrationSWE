+package formatter
+
+func formatAliasGlobalVariableNode(ps *ParserState, n Node) {
+	ps.emitIdent([]byte("alias"))
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		formatNode(ps, n.Get("new_name"))
+		ps.emitSpace()
+		formatNode(ps, n.Get("old_name"))
+	})
+}
+
+func formatAliasMethodNode(ps *ParserState, n Node) {
+	ps.emitIdent([]byte("alias "))
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		formatNode(ps, n.Get("new_name"))
+		ps.emitSpace()
+		formatNode(ps, n.Get("old_name"))
+	})
+}
+
+func formatAlternationPatternNode(ps *ParserState, n Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		formatNode(ps, n.Get("left"))
+		ps.emitSpace()
+		ps.emitIdent([]byte("|"))
+		ps.emitSpace()
+		formatNode(ps, n.Get("right"))
+	})
+}
+
+func formatAndNode(ps *ParserState, n Node) {
+	ps.inlineBreakableOf(ForBinaryOp(), func(ps *ParserState) {
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			formatInfixOperator(ps, n.Get("left"), ps.slice(n.LocField("operator_loc")), n.Get("right"))
+		})
+	})
+}
+
+func formatBackReferenceReadNode(ps *ParserState, n Node) {
+	loc := n.LocField("location")
+	handleStringAtOffset(ps, ps.slice(loc), n.End())
+}
+
+func formatBeginNode(ps *ParserState, n Node) {
+	isImplicit := n.LocField("begin_keyword_loc") == nil
+	ps.atOffset(n.Start())
+	if isImplicit {
+		ps.endIndent()
+	} else {
+		ps.emitKeyword([]byte("begin"))
+	}
+	ps.newBlock(func(ps *ParserState) {
+		if !isImplicit {
+			ps.emitNewline()
+		}
+		if statements := n.Get("statements"); statements != nil {
+			formatStatements(ps, statements)
+		}
+	})
+	ps.withStartOfLine(true, func(ps *ParserState) {
+		if rescueNode := n.Get("rescue_clause"); rescueNode != nil {
+			ps.emitIndent()
+			formatRescueNode(ps, rescueNode)
+		}
+		if elseNode := n.Get("else_clause"); elseNode != nil {
+			ps.emitIndent()
+			formatElseNode(ps, elseNode)
+		}
+		if ensureNode := n.Get("ensure_clause"); ensureNode != nil {
+			ps.emitIndent()
+			formatEnsureNode(ps, ensureNode)
+		}
+		if !isImplicit {
+			ps.emitEnd()
+		}
+	})
+	if isImplicit {
+		ps.startIndent()
+	}
+	ps.atOffset(n.End())
+}
+
+func formatBreakNode(ps *ParserState, n Node) {
+	ps.emitIdent([]byte("break"))
+	if arguments := n.Get("arguments"); arguments != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			list := arguments.List("arguments")
+			endOffset := nodeListEndOffset(list)
+			ps.emitSpace()
+			formatListLikeThing(ps, list, endOffset, true)
+		})
+	}
+}
+
+func formatCapturePatternNode(ps *ParserState, n Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		formatNode(ps, n.Get("value"))
+		ps.emitSpace()
+		ps.emitIdent([]byte("=>"))
+		ps.emitSpace()
+		formatNode(ps, n.Get("target"))
+	})
+}
+
+func formatCaseMatchNode(ps *ParserState, n Node) {
+	ps.emitCaseKeyword()
+	if predicate := n.Get("predicate"); predicate != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			ps.emitSpace()
+			formatNode(ps, predicate)
+		})
+	}
+	ps.emitNewline()
+	ps.withStartOfLine(true, func(ps *ParserState) {
+		for _, condition := range n.List("conditions") {
+			ps.atOffset(condition.Start())
+			ps.emitIndent()
+			ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, condition) })
+		}
+		if elseNode := n.Get("else_clause"); elseNode != nil {
+			ps.emitIndent()
+			formatElseNode(ps, elseNode)
+		}
+		ps.emitEnd()
+	})
+}
+
+func formatCaseNode(ps *ParserState, n Node) {
+	ps.emitCaseKeyword()
+	if predicate := n.Get("predicate"); predicate != nil {
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			ps.emitSpace()
+			formatNode(ps, predicate)
+		})
+	}
+	ps.emitNewline()
+	ps.withStartOfLine(true, func(ps *ParserState) {
+		for _, condition := range n.List("conditions") {
+			formatWhenNode(ps, condition)
+		}
+		if elseNode := n.Get("else_clause"); elseNode != nil {
+			ps.emitIndent()
+			formatElseNode(ps, elseNode)
+		}
+		ps.emitEnd()
+	})
+}
+
+func formatElseNode(ps *ParserState, n Node) {
+	ps.atOffset(n.Start())
+	keywordLoc := n.LocField("else_keyword_loc")
+	keywordLen := keywordLoc.End - keywordLoc.Start
+	if keywordLen == 4 {
+		ps.emitElse()
+		ps.newBlock(func(ps *ParserState) {
+			ps.emitNewline()
+			if statements := n.Get("statements"); statements != nil {
+				formatNode(ps, statements)
+			}
+		})
+	} else {
+		ps.emitSpace()
+		ps.emitConditionalKeyword([]byte(":"))
+		ps.emitSpace()
+		ps.withStartOfLine(false, func(ps *ParserState) {
+			statements := n.Get("statements")
+			formatNode(ps, statements.List("body")[0])
+		})
+	}
+	ps.atOffset(n.End())
+}
+
+func formatEnsureNode(ps *ParserState, n Node) {
+	ps.atOffset(n.Start())
+	ps.emitKeyword([]byte("ensure"))
+	ps.newBlock(func(ps *ParserState) {
+		ps.emitNewline()
+		if statements := n.Get("statements"); statements != nil {
+			formatStatements(ps, statements)
+		}
+	})
+	ps.atOffset(n.End())
+}
+
+func formatClassVariableAndWriteNode(ps *ParserState, n Node) {
+	formatWriteNode(ps, ps.slice(n.LocField("name_loc")), []byte("&&="), n.Get("value"))
+}
+
+func formatClassVariableOperatorWriteNode(ps *ParserState, n Node) {
+	formatWriteNode(ps, ps.slice(n.LocField("name_loc")), ps.slice(n.LocField("binary_operator_loc")), n.Get("value"))
+}
+
+func formatClassVariableOrWriteNode(ps *ParserState, n Node) {
+	formatWriteNode(ps, ps.slice(n.LocField("name_loc")), []byte("||="), n.Get("value"))
+}
+
+func formatClassVariableReadNode(ps *ParserState, n Node) {
+	ps.emitIdent(nameBytes(ps, n))
+}
+
+func formatClassVariableTargetNode(ps *ParserState, n Node) {
+	ps.emitIdent(nameBytes(ps, n))
+}
+
+func formatClassVariableWriteNode(ps *ParserState, n Node) {
+	ps.atOffset(n.Start())
+	formatWriteNode(ps, ps.slice(n.LocField("name_loc")), []byte("="), n.Get("value"))
+}
+
+func formatClassNode(ps *ParserState, n Node) {
+	ps.emitClassKeyword()
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("constant_path")) })
+	if superclass := n.Get("superclass"); superclass != nil {
+		ps.emitIdent([]byte(" < "))
+		ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, superclass) })
+	}
+	ps.newBlock(func(ps *ParserState) {
+		ps.withStartOfLine(true, func(ps *ParserState) {
+			ps.withFormattingContext(ClassOrModuleContext(), func(ps *ParserState) {
+				ps.emitNewline()
+				if body := n.Get("body"); body != nil {
+					formatNode(ps, body)
+				}
+			})
+		})
+	})
+	ps.withStartOfLine(true, func(ps *ParserState) { ps.emitEnd() })
+}
+
+func formatModuleNode(ps *ParserState, n Node) {
+	ps.emitModuleKeyword()
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) { formatNode(ps, n.Get("constant_path")) })
+	ps.newBlock(func(ps *ParserState) {
+		ps.withStartOfLine(true, func(ps *ParserState) {
+			ps.withFormattingContext(ClassOrModuleContext(), func(ps *ParserState) {
+				ps.emitNewline()
+				if body := n.Get("body"); body != nil {
+					formatNode(ps, body)
+				}
+			})
+		})
+	})
+	ps.withStartOfLine(true, func(ps *ParserState) { ps.emitEnd() })
+}
+
+func formatDefNode(ps *ParserState, n Node) {
+	ps.emitDefKeyword()
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		if receiver := n.Get("receiver"); receiver != nil {
+			formatNode(ps, receiver)
+			ps.emitDot()
+		}
+		handleStringAtOffset(ps, ps.slice(n.LocField("name_loc")), n.LocField("name_loc").End)
+	})
+	formatDefBody(ps, n)
+}
+
+func formatDefBody(ps *ParserState, n Node) {
+	ps.newScope(func(ps *ParserState) {
+		if parametersNode := n.Get("parameters"); parametersNode != nil {
+			ps.breakableOf(ForMethodCall(), func(ps *ParserState) {
+				ps.withStartOfLine(false, func(ps *ParserState) {
+					formatParametersNode(ps, parametersNode)
+					if rparenLoc := n.LocField("rparen_loc"); rparenLoc != nil {
+						ps.atOffset(rparenLoc.End)
+					}
+				})
+			})
+		}
+		ps.withFormattingContext(DefContext(), func(ps *ParserState) {
+			if n.LocField("end_keyword_loc") != nil {
+				ps.newBlock(func(ps *ParserState) {
+					ps.emitNewline()
+					ps.withStartOfLine(true, func(ps *ParserState) {
+						if body := n.Get("body"); body != nil {
+							if body.Type() == "BeginNode" && body.LocField("begin_keyword_loc") == nil {
+								formatBeginNode(ps, body)
+							} else {
+								formatNode(ps, body)
+							}
+						}
+					})
+				})
+			} else {
+				ps.emitSpace()
+				ps.emitOp([]byte("="))
+				ps.emitSpace()
+				ps.withStartOfLine(false, func(ps *ParserState) {
+					if body := n.Get("body"); body != nil {
+						bodyNodeList := body.List("body")
+						formatNode(ps, bodyNodeList[0])
+					}
+				})
+			}
+		})
+	})
+	if endLoc := n.LocField("end_keyword_loc"); endLoc != nil {
+		ps.withStartOfLine(true, func(ps *ParserState) {
+			ps.windDumpingCommentsUntilOffset(endLoc.End)
+			ps.emitEnd()
+		})
+	}
+}
+
+func formatDefinedNode(ps *ParserState, n Node) {
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		ps.emitIdent([]byte("defined?("))
+		formatNode(ps, n.Get("value"))
+		ps.emitCloseParen()
+	})
+}
+
+func formatForNode(ps *ParserState, n Node) {
+	ps.emitKeyword([]byte("for"))
+	ps.emitSpace()
+	ps.withStartOfLine(false, func(ps *ParserState) {
+		formatNode(ps, n.Get("index"))
+		ps.emitSpace()
+		ps.emitKeyword([]byte("in"))
+		ps.emitSpace()
+		formatNode(ps, n.Get("collection"))
+	})
+	ps.newBlock(func(ps *ParserState) {
+		ps.emitNewline()
+		if statements := n.Get("statements"); statements != nil {
+			formatStatements(ps, statements)
+		}
+	})
+	ps.withStartOfLine(true, func(ps *ParserState) { ps.emitEnd() })
