-fn matching_delimiter(open: u8) -> u8 {
-    match open {
-        b'[' => b']',
-        b'(' => b')',
-        b'{' => b'}',
-        b'<' => b'>',
-        // For non-paired delimiters (like ^, |, etc.), the closing is the same
-        c => c,
-    }
-}
