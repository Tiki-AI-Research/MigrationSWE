+	if err != nil {
+		return false
+	}
+	return info.Mode()&os.ModeCharDevice != 0
+}
diff --git a/internal/cli/options.go b/internal/cli/options.go
new file mode 100644
index 0000000..d883ccf
--- /dev/null
+++ b/internal/cli/options.go
@@ -0,0 +1,172 @@
+package cli
+
+import (
+	"fmt"
+	"strings"
+)
+
+const Version = "0.14.1"
+
+type Options struct {
+	Check             bool
+	IncludeGitignored bool
+	HeaderOptIn       bool
+	HeaderOptOut      bool
+	FailFast          bool
+	InPlace           bool
+	StdinFilepath     string
+	HasStdinFilepath  bool
+	IncludePaths      []string
+}
+
+type ParseResult struct {
+	Options     *Options
+	ShowHelp    bool
+	ShowVersion bool
+	Error       error
+}
+
+func Parse(args []string) ParseResult {
+	opts := &Options{}
+	var positional []string
+	stopFlags := false
+
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+		if stopFlags {
+			positional = append(positional, arg)
+			continue
+		}
+		if arg == "--" {
+			stopFlags = true
+			continue
+		}
+		if strings.HasPrefix(arg, "--") {
+			name := arg
+			value := ""
+			hasValue := false
+			if idx := strings.IndexByte(arg, '='); idx >= 0 {
+				name = arg[:idx]
+				value = arg[idx+1:]
+				hasValue = true
+			}
+			switch name {
+			case "--check":
+				opts.Check = true
+			case "--in-place":
+				opts.InPlace = true
+			case "--include-gitignored":
+				opts.IncludeGitignored = true
+			case "--header-opt-in":
+				opts.HeaderOptIn = true
+			case "--header-opt-out":
+				opts.HeaderOptOut = true
+			case "--fail-fast":
+				opts.FailFast = true
+			case "--version":
+				return ParseResult{ShowVersion: true}
+			case "--help":
+				return ParseResult{ShowHelp: true}
+			case "--stdin-filepath":
+				if !hasValue {
+					if i+1 >= len(args) {
+						return ParseResult{Error: fmt.Errorf("rubyfmt: option '--stdin-filepath' requires a value")}
+					}
+					i++
+					value = args[i]
+				}
+				opts.StdinFilepath = value
+				opts.HasStdinFilepath = true
+			default:
+				return ParseResult{Error: fmt.Errorf("rubyfmt: unknown option %s", name)}
+			}
+			continue
+		}
+		if strings.HasPrefix(arg, "-") && len(arg) > 1 {
+			switch arg {
+			case "-c":
+				opts.Check = true
+			case "-i":
+				opts.InPlace = true
+			case "-V":
+				return ParseResult{ShowVersion: true}
+			case "-h":
+				return ParseResult{ShowHelp: true}
+			default:
+				if !strings.HasPrefix(arg, "--") && len(arg) > 2 {
+					handled := true
+					for _, ch := range arg[1:] {
+						switch ch {
+						case 'c':
+							opts.Check = true
+						case 'i':
+							opts.InPlace = true
+						case 'V':
+							return ParseResult{ShowVersion: true}
+						case 'h':
+							return ParseResult{ShowHelp: true}
+						default:
+							handled = false
+						}
+					}
+					if handled {
+						continue
+					}
+				}
+				return ParseResult{Error: fmt.Errorf("rubyfmt: unknown option %s", arg)}
+			}
+			continue
+		}
+		positional = append(positional, arg)
+	}
+
+	opts.IncludePaths = positional
+	if opts.HasStdinFilepath {
+		if len(opts.IncludePaths) > 0 {
+			return ParseResult{Error: fmt.Errorf("rubyfmt: --stdin-filepath cannot be used with include paths")}
+		}
+		if opts.InPlace {
+			return ParseResult{Error: fmt.Errorf("rubyfmt: --stdin-filepath cannot be used with --in-place")}
+		}
+	}
+	return ParseResult{Options: opts}
+}
+
+func HelpText() string {
+	return `rubyfmt ` + Version + `
+
+Usage: rubyfmt [OPTIONS] [include-paths]...
+
+Rubyfmt is an opinionated Ruby source formatter.
+
+Options:
+  -c, --check                 Print unified diffs and exit 5 when differences are found
+  -i, --in-place              Rewrite files in place
+      --include-gitignored    Include files matched by .gitignore
+      --header-opt-in         Only format files with a "# rubyfmt: true" header
+      --header-opt-out        Skip files with a "# rubyfmt: false" header
+      --fail-fast             Exit immediately on syntax or IO errors
+      --stdin-filepath PATH   Apply ignore rules to stdin as if it came from PATH
+  -V, --version               Print version
+  -h, --help                  Print help
+
+include-paths may be files, directories, or @file path lists.
+`
+}
+
+func parseMagicComment(slice string) (string, bool) {
+	for _, line := range strings.Split(slice, "\n") {
+		if !strings.HasPrefix(line, "#") {
+			continue
+		}
+		rest := strings.TrimLeft(line[1:], " \t\r\v\f")
+		if !strings.HasPrefix(rest, "rubyfmt:") {
+			continue
+		}
+		val := strings.TrimSpace(rest[len("rubyfmt:"):])
+		if val == "true" || val == "false" {
+			return val, true
+		}
+	}
+	return "", false
+}
diff --git a/internal/cli/run.go b/internal/cli/run.go
new file mode 100644
index 0000000..5348e48
--- /dev/null
+++ b/internal/cli/run.go
@@ -0,0 +1,254 @@
+package cli
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"rubyfmt/internal/formatter"
+)
+
+func Run(opts *Options, stdout, stderr io.Writer) int {
+	if len(opts.IncludePaths) == 0 {
+		return runStdin(opts, stdout, stderr)
+	}
+
+	inputs, collectErrors, err := CollectInputs(opts)
+	if err != nil {
+		printError(stderr, fmt.Sprintf("Rubyfmt experienced an IO error: %v", err), nil)
+		return int(formatter.FormatIOError)
+	}
+	for _, collectErr := range collectErrors {
+		printError(stderr, fmt.Sprintf("Rubyfmt experienced an error searching for files: %v", collectErr.Err), nil)
+		if opts.FailFast {
+			return int(formatter.FormatIOError)
+		}
+	}
+
+	if opts.Check {
+		return runCheck(opts, inputs, stdout, stderr)
+	}
+	if opts.InPlace {
+		return runInPlace(opts, inputs, stderr)
+	}
+	return runStdout(opts, inputs, stdout, stderr)
+}
+
+func formatWithHeader(opts *Options, buffer []byte) ([]byte, bool, *formatter.RichFormatError) {
+	if opts.HeaderOptIn || opts.HeaderOptOut {
+		size := len(buffer)
+		if size > 500 {
+			size = 500
+		}
+		slice := strings.ToValidUTF8(string(buffer[:size]), "\uFFFD")
+		matched, found := parseMagicComment(slice)
+		if opts.HeaderOptIn && (!found || matched != "true") {
+			return nil, true, nil
+		}
+		if opts.HeaderOptOut && found && matched == "false" {
+			return nil, true, nil
+		}
+	}
+	out, err := formatter.FormatBuffer(buffer)
+	if err != nil {
+		return nil, false, err
+	}
+	return out, false, nil
+}
+
+func handleFormatError(opts *Options, err *formatter.RichFormatError, path string, stderr io.Writer) int {
+	if err.Kind == formatter.FormatSyntaxError {
+		printError(stderr, "Rubyfmt detected a syntax error in the ruby code being executed", &path)
+	} else {
+		printError(stderr, fmt.Sprintf("Rubyfmt experienced an IO error: %v", err), &path)
+	}
+	if opts.FailFast {
+		return err.ExitCode()
+	}
+	return 0
+}
+
+func handleReadError(opts *Options, err error, path string, stderr io.Writer) int {
+	printError(stderr, fmt.Sprintf("Rubyfmt experienced an IO error: %v", err), &path)
+	if opts.FailFast {
+		return int(formatter.FormatIOError)
+	}
+	return 0
+}
+
+func runCheck(opts *Options, inputs []Input, stdout, stderr io.Writer) int {
+	changed := 0
+	syntaxErrors := 0
+	for _, input := range inputs {
+		buffer, err := os.ReadFile(input.Path)
+		if err != nil {
+			if code := handleReadError(opts, err, input.Display, stderr); code != 0 {
+				return code
+			}
+			continue
+		}
+		out, skip, formatErr := formatWithHeader(opts, buffer)
+		if formatErr != nil {
+			if formatErr.Kind == formatter.FormatSyntaxError {
+				syntaxErrors++
+			}
+			if code := handleFormatError(opts, formatErr, input.Display, stderr); code != 0 {
+				return code
+			}
+			continue
+		}
+		if skip || bytes.Equal(buffer, out) {
+			continue
+		}
+		diff := UnifiedDiff(input.Display, buffer, out)
+		if len(diff) > 0 {
+			_, _ = stdout.Write(diff)
+			changed++
+		}
+	}
+	if syntaxErrors > 0 {
+		return int(formatter.FormatSyntaxError)
+	}
+	if changed > 0 {
+		return int(formatter.FormatDiffDetected)
+	}
+	return int(formatter.FormatOK)
+}
+
+func runInPlace(opts *Options, inputs []Input, stderr io.Writer) int {
+	for _, input := range inputs {
+		buffer, err := os.ReadFile(input.Path)
+		if err != nil {
+			if code := handleReadError(opts, err, input.Display, stderr); code != 0 {
+				return code
+			}
+			continue
+		}
+		out, skip, formatErr := formatWithHeader(opts, buffer)
+		if formatErr != nil {
+			if code := handleFormatError(opts, formatErr, input.Display, stderr); code != 0 {
+				return code
+			}
+			continue
+		}
+		if skip || bytes.Equal(buffer, out) {
+			continue
+		}
+		file, err := os.OpenFile(input.Path, os.O_WRONLY|os.O_TRUNC, 0)
+		if err != nil {
+			if code := handleReadError(opts, err, input.Display, stderr); code != 0 {
+				return code
+			}
+			continue
+		}
+		_, writeErr := file.Write(out)
+		closeErr := file.Close()
+		if writeErr != nil {
+			if code := handleReadError(opts, writeErr, input.Display, stderr); code != 0 {
+				return code
+			}
+			continue
+		}
+		if closeErr != nil {
+			if code := handleReadError(opts, closeErr, input.Display, stderr); code != 0 {
+				return code
+			}
+		}
+	}
+	return int(formatter.FormatOK)
+}
+
+func runStdout(opts *Options, inputs []Input, stdout, stderr io.Writer) int {
+	for _, input := range inputs {
+		buffer, err := os.ReadFile(input.Path)
+		if err != nil {
+			if code := handleReadError(opts, err, input.Display, stderr); code != 0 {
+				return code
+			}
+			continue
+		}
+		out, skip, formatErr := formatWithHeader(opts, buffer)
+		if formatErr != nil {
+			if code := handleFormatError(opts, formatErr, input.Display, stderr); code != 0 {
+				return code
+			}
+			continue
+		}
+		if skip {
+			_, _ = stdout.Write(buffer)
+		} else {
+			_, _ = stdout.Write(out)
+		}
+	}
+	return int(formatter.FormatOK)
+}
+
+func runStdin(opts *Options, stdout, stderr io.Writer) int {
+	if stdinIsTerminal() {
+		_, _ = io.WriteString(stdout, HelpText())
+		return int(formatter.FormatOK)
+	}
+	buffer, err := io.ReadAll(os.Stdin)
+	if err != nil {
+		printError(stderr, fmt.Sprintf("Rubyfmt experienced an IO error: %v", err), nil)
+		return int(formatter.FormatIOError)
+	}
+
+	display := "stdin"
+	if opts.HasStdinFilepath {
+		display = opts.StdinFilepath
+		cwd, _ := os.Getwd()
+		matcher := LoadIgnoreMatcher(cwd, opts.IncludeGitignored)
+		rel, relErr := filepath.Rel(cwd, opts.StdinFilepath)
+		if relErr != nil {
+			rel = opts.StdinFilepath
+		}
+		if matcher.IsIgnored(rel, false) {
+			if !opts.Check {
+				_, _ = stdout.Write(buffer)
+			}
+			return int(formatter.FormatOK)
+		}
+	}
+
+	out, skip, formatErr := formatWithHeader(opts, buffer)
+	if formatErr != nil {
+		if formatErr.Kind == formatter.FormatSyntaxError {
+			printError(stderr, "Rubyfmt detected a syntax error in the ruby code being executed", &display)
+		} else {
+			printError(stderr, fmt.Sprintf("Rubyfmt experienced an IO error: %v", formatErr), &display)
+		}
+		return formatErr.ExitCode()
+	}
+	if skip {
+		if opts.Check {
+			return int(formatter.FormatOK)
+		}
+		_, _ = stdout.Write(buffer)
+		return int(formatter.FormatOK)
+	}
+	if opts.Check {
+		if bytes.Equal(buffer, out) {
+			return int(formatter.FormatOK)
+		}
+		_, _ = stdout.Write(UnifiedDiff(display, buffer, out))
+		return int(formatter.FormatDiffDetected)
+	}
+	_, _ = stdout.Write(out)
+	return int(formatter.FormatOK)
+}
+
+func printError(stderr io.Writer, msg string, path *string) {
+	firstLine := "Error!"
+	if path != nil {
+		firstLine = fmt.Sprintf("Error! source: %s", *path)
+	}
+	_, _ = fmt.Fprintf(stderr, "%s\n%s\n", firstLine, msg)
+}
+
+func stdinIsTerminal() bool {
+	return isTerminal(os.Stdin.Fd())
+}
diff --git a/internal/cli/walk.go b/internal/cli/walk.go
new file mode 100644
index 0000000..b9cd2d2
--- /dev/null
+++ b/internal/cli/walk.go
@@ -0,0 +1,145 @@
+package cli
+
+import (
+	"bufio"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+type Input struct {
+	Path     string
+	Explicit bool
+	Display  string
+}
+
+type CollectError struct {
+	Path string
+	Err  error
+}
+
+func ExpandIncludePaths(paths []string) ([]string, error) {
+	var expanded []string
+	for _, path := range paths {
+		if strings.HasPrefix(path, "@") {
+			file, err := os.Open(path[1:])
+			if err != nil {
+				return nil, err
+			}
+			scanner := bufio.NewScanner(file)
+			for scanner.Scan() {
+				expanded = append(expanded, scanner.Text())
+			}
+			scanErr := scanner.Err()
+			file.Close()
+			if scanErr != nil {
+				return nil, scanErr
+			}
+		} else {
+			expanded = append(expanded, path)
+		}
+	}
+	return expanded, nil
+}
+
+func CollectInputs(opts *Options) ([]Input, []CollectError, error) {
+	cwd, err := os.Getwd()
+	if err != nil {
+		return nil, nil, err
+	}
+	expanded, err := ExpandIncludePaths(opts.IncludePaths)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	var explicit []Input
+	var directories []string
+	for _, path := range expanded {
+		info, statErr := os.Stat(path)
+		if statErr == nil && info.IsDir() {
+			directories = append(directories, path)
+		} else {
+			explicit = append(explicit, Input{Path: path, Explicit: true, Display: path})
+		}
+	}
+
+	inputs := append([]Input{}, explicit...)
+	var collectErrors []CollectError
+	for _, dir := range directories {
+		matcher := LoadIgnoreMatcher(cwd, opts.IncludeGitignored)
+		addAncestorIgnores(matcher, cwd, dir)
+		absRoot, absErr := filepath.Abs(dir)
+		if absErr != nil {
+			absRoot = dir
+		}
+		walkErr := filepath.WalkDir(dir, func(path string, entry os.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				collectErrors = append(collectErrors, CollectError{Path: path, Err: walkErr})
+				if entry != nil && entry.IsDir() {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			if entry.IsDir() {
+				if entry.Name() == ".git" {
+					return filepath.SkipDir
+				}
+				matcher.AddDirectory(cwd, path)
+				absPath, pathErr := filepath.Abs(path)
+				if pathErr == nil && filepath.Clean(absPath) != filepath.Clean(absRoot) {
+					rel, relErr := filepath.Rel(cwd, path)
+					if relErr != nil {
+						rel = path
+					}
+					if matcher.IsIgnored(rel, true) {
+						return filepath.SkipDir
+					}
+				}
+				return nil
+			}
+			if !entry.Type().IsRegular() {
+				return nil
+			}
+			if filepath.Ext(path) != ".rb" {
+				return nil
+			}
+			rel, relErr := filepath.Rel(cwd, path)
+			if relErr != nil {
+				rel = path
+			}
+			if matcher.IsIgnored(rel, false) {
+				return nil
+			}
+			inputs = append(inputs, Input{Path: path, Display: path})
+			return nil
+		})
+		if walkErr != nil {
+			collectErrors = append(collectErrors, CollectError{Path: dir, Err: walkErr})
+		}
+	}
+	return inputs, collectErrors, nil
+}
+
+func addAncestorIgnores(matcher *IgnoreMatcher, cwd, dir string) {
+	absCwd, err := filepath.Abs(cwd)
+	if err != nil {
+		return
+	}
+	absDir, err := filepath.Abs(dir)
+	if err != nil {
+		return
+	}
+	rel, err := filepath.Rel(absCwd, absDir)
+	if err != nil || strings.HasPrefix(rel, "..") {
+		return
+	}
+	current := absCwd
+	matcher.AddDirectory(absCwd, current)
+	if rel == "." {
+		return
+	}
+	for _, part := range strings.Split(filepath.ToSlash(rel), "/") {
+		current = filepath.Join(current, part)
+		matcher.AddDirectory(absCwd, current)
+	}
+}
diff --git a/internal/formatter/bench_test.go b/internal/formatter/bench_test.go
new file mode 100644
