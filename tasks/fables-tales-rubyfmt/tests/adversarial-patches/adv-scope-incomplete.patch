-            let errors_count: Arc<Mutex<usize>> = Arc::new(Mutex::new(0));
-
-            iterate_input_files(
-                &opts,
-                &|(file_path, before)| match rubyfmt_string(&opts, before) {
-                    Ok(None) => {}
-                    Ok(Some(fmtted)) => {
