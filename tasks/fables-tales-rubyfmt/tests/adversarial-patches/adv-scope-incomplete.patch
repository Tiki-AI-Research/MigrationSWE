+static inline void
+pm_hash_node_closing_loc_set(pm_hash_node_t *hash, pm_token_t *token) {
+    hash->base.location.end = token->end;
+    hash->closing_loc = PM_LOCATION_TOKEN_VALUE(token);
+}
