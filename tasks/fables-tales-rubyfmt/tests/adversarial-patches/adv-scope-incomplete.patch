+                    // If we've hit a __END__ and it was at the start of the
+                    // line or the start of the file and it is followed by
+                    // either a \n or a \r\n, then this is the last token of the
+                    // file.
+                    if (
+                        ((parser->current.end - parser->current.start) == 7) &&
