    ],
    "bridge_sink_rules": [
      {
        "class": "subprocess",
        "description": "spawn/exec/fork of an external process",
        "id": "BRIDGE-SUBPROCESS",
        "patterns": [
          "from\\s+['\"](?:node:)?child_process['\"]",
          "require\\s*\\(\\s*['\"](?:node:)?child_process['\"]\\s*\\)",
          "(?<![.\\w$])(?:spawn|spawnSync|execSync|execFile|execFileSync|execFileSync)\\s*\\(",
          "(?<![.\\w$])fork\\s*\\(",
          "\\b(?:child_process|cp|cpSync)\\.(?:spawn|spawnSync|exec|execSync|execFile|execFileSync|fork)\\s*\\("
        ]
      },
      {
        "class": "ffi",
        "description": "native addon or FFI symbol lookup",
        "id": "BRIDGE-FFI",
        "patterns": [
          "\\bprocess\\.dlopen\\s*\\(",
          "\\bffi\\.(?:Library|dlopen)\\s*\\(",
          "require\\s*\\(\\s*['\"][^'\"]*ffi[^'\"]*['\"]\\s*\\)",
          "['\"][^'\"]+\\.node['\"]"
        ]
      },
      {
        "class": "rpc_http",
        "description": "socket, HTTP or RPC bridge to another runtime",
        "id": "BRIDGE-RPC-HTTP",
        "patterns": [
          "\\bnet\\.(?:connect|createConnection)\\s*\\(",
          "\\b(?:http|https)\\.request\\s*\\(",
          "\\b(?:http|https|net|dgram|tls)\\.createServer\\s*\\(",
          "\\bcreateServer\\s*\\(",
          "new\\s+WebSocket\\s*\\(",
          "\\bgrpc\\b",
          "from\\s+['\"](?:node:)?(?:net|dgram|tls|grpc[^'\"]*)['\"]"
        ]
      },
      {
        "class": "dynamic_load",
        "description": "computed module load or code evaluation",
        "id": "BRIDGE-DYNAMIC-LOAD",
        "patterns": [
          "\\brequire\\s*\\(\\s*[^'\"\\s)]",
          "\\bimport\\s*\\(\\s*[^'\"\\s)]",
          "\\bmodule\\._load\\s*\\(",
          "new\\s+Function\\s*\\(",
          "\\bvm\\.(?:runIn\\w*|compileFunction|Script)\\s*\\(",
          "(?<![.\\w$])eval\\s*\\("
        ]
      },
      {
        "class": "legacy_runtime",
        "description": "import of the superseded source framework module",
        "id": "BRIDGE-LEGACY-RUNTIME",
        "patterns": [
          "\\bfrom\\s+['\"]commander['\"]",
          "\\brequire\\s*\\(\\s*['\"]commander['\"]\\s*\\)",
          "\\bfrom\\s+['\"]commander/[^'\"]+['\"]",
          "\\bimport\\s*\\(\\s*['\"]commander(?:/[^'\"]*)?['\"]\\s*\\)"
        ],
        "modules": [
          "commander"
        ]
      }
    ],
