+  ]);
+  const failed = checks.filter(([, condition]) => !condition).map(([label]) => label);
+  return {
+    ok: failed.length === 0,
+    detail: failed.length === 0
+      ? 'built-CLI version, missing-argument, and required-option assertions passed'
+      : `built-CLI assertions failed: ${failed.join(', ')}`,
