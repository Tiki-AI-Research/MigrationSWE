+import { Help } from '@oclif/core';
+import { showCachedUpdateNotice } from './cli-update.js';
+
+/**
+ * oclif help renderer used by the Field Theory CLI. The cached update notice
+ * is appended for user-requested help (stdout), while help rendered after a
+ * validation error stays on stderr without the notice.
+ */
+export class FtHelp extends Help {
+  async showHelp(argv: string[]): Promise<void> {
+    await super.showHelp(argv);
+    if (!this.opts.sendToStderr) showCachedUpdateNotice();
+  }
+}
+
+export default FtHelp;
diff --git a/src/cli-runtime.ts b/src/cli-runtime.ts
new file mode 100644
index 0000000..5fb23d6
--- /dev/null
+++ b/src/cli-runtime.ts
@@ -0,0 +1,506 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { Command, Config, Errors, Flags, execute } from '@oclif/core';
+import { checkForUpdate } from './cli-update.js';
+
+export const ROOT_DESCRIPTION = 'Self-custody for your X/Twitter bookmarks. Sync, search, classify, and explore locally.';
+
+export interface ArgSpec {
+  name: string;
+  description: string;
+  required: boolean;
+  multiple: boolean;
+  defaultValue?: unknown;
+}
+
+interface ParsedFlagText {
+  long: string;
+  char?: string;
+  valueName?: string;
+  multiple: boolean;
+}
+
+export class FlagSpec {
+  readonly flagsText: string;
+  readonly long: string;
+  readonly short?: string;
+  readonly descriptionText: string;
+  readonly negate: boolean;
+  readonly required: boolean;
+  readonly valueName?: string;
+  readonly multiple: boolean;
+  readonly parser?: (value: string) => unknown;
+  readonly defaultValue?: unknown;
+  readonly attr: string;
+
+  constructor(
+    flagsText: string,
+    description: string,
+    parserOrDefault?: ((value: string) => unknown) | unknown,
+    defaultValue?: unknown,
+  ) {
+    const parsed = parseFlagText(flagsText);
+    this.flagsText = flagsText;
+    this.long = `--${parsed.long}`;
+    this.short = parsed.char ? `-${parsed.char}` : undefined;
+    this.descriptionText = description;
+    this.negate = parsed.long.startsWith('no-');
+    this.required = false;
+    this.valueName = parsed.valueName;
+    this.multiple = parsed.multiple;
+    this.attr = attributeName(parsed.long);
+    if (typeof parserOrDefault === 'function') {
+      this.parser = parserOrDefault as (value: string) => unknown;
+      this.defaultValue = defaultValue;
+    } else {
+      this.defaultValue = parserOrDefault;
+    }
+  }
+
+  attributeName(): string {
+    return this.attr;
+  }
+}
+
+function attributeName(long: string): string {
+  const body = long.startsWith('no-') ? long.slice(3) : long;
+  return body.replace(/-([a-z0-9])/gi, (_, c: string) => c.toUpperCase());
+}
+
+function parseFlagText(flagsText: string): ParsedFlagText {
+  const parts = flagsText.split(',').map((part) => part.trim()).filter(Boolean);
+  let long = '';
+  let char: string | undefined;
+  for (const part of parts) {
+    if (part.startsWith('--')) long = part.replace(/^--/, '');
+    else if (part.startsWith('-')) char = part.replace(/^-/, '');
+  }
+  if (!long) throw new Error(`Unsupported flag declaration: ${flagsText}`);
+  const valueMatch = long.match(/\s*<([^>]+)>/);
+  const valueName = valueMatch?.[1];
+  const multiple = Boolean(valueName?.endsWith('...'));
+  const cleanLong = long.replace(/\s*<[^>]+>/, '');
+  return {
+    long: cleanLong,
+    char,
+    valueName: valueName?.replace(/\.\.\.$/, ''),
+    multiple,
+  };
+}
+
+type CommandHandler = (...args: any[]) => Promise<void> | void;
+
+/**
+ * Declarative command metadata. This is not a parser or runner: oclif owns
+ * argument/flag parsing, help, validation, and process lifecycle. The node
+ * tree only describes the command surface so it can be compiled into native
+ * oclif Command classes.
+ */
+export class CommandNode {
+  readonly parent?: CommandNode;
+  readonly children: CommandNode[] = [];
+  readonly flags: FlagSpec[] = [];
+  readonly args: ArgSpec[] = [];
+  readonly aliases: string[] = [];
+  hidden = false;
+  private _name: string;
+  private _description = '';
+  private _handler?: CommandHandler;
+
+  constructor(name: string, parent?: CommandNode, opts: { hidden?: boolean } = {}) {
+    this._name = name;
+    this.parent = parent;
+    this.hidden = Boolean(opts.hidden);
+  }
+
+  get commands(): CommandNode[] {
+    return this.children;
+  }
+
+  name(): string {
+    return this._name;
+  }
+
+  setName(value: string): this {
+    this._name = value;
+    return this;
+  }
+
+  describe(value: string): this {
+    this._description = value;
+    return this;
+  }
+
+  getDescription(): string {
+    return this._description;
+  }
+
+  alias(value: string): this {
+    this.aliases.push(value);
+    return this;
+  }
+
+  subcommand(name: string, opts: { hidden?: boolean } = {}): CommandNode {
+    const child = new CommandNode(name, this, opts);
+    this.children.push(child);
+    return child;
+  }
+
+  argument(spec: string, description: string, defaultValue?: unknown): this {
+    const required = spec.startsWith('<');
+    const raw = spec.replace(/^[<[]/, '').replace(/[>\]]$/, '');
+    const multiple = raw.endsWith('...');
+    const name = raw.replace(/\.\.\.$/, '');
+    this.args.push({ name, description, required, multiple, defaultValue });
+    return this;
+  }
+
+  flag(
+    flagsText: string,
+    description: string,
+    parserOrDefault?: ((value: string) => unknown) | unknown,
+    defaultValue?: unknown,
+  ): this {
+    this.flags.push(new FlagSpec(flagsText, description, parserOrDefault, defaultValue));
+    return this;
+  }
+
+  requiredFlag(
+    flagsText: string,
+    description: string,
+    parserOrDefault?: ((value: string) => unknown) | unknown,
+    defaultValue?: unknown,
+  ): this {
+    const flag = new FlagSpec(flagsText, description, parserOrDefault, defaultValue);
+    (flag as { required: boolean }).required = true;
+    this.flags.push(flag);
+    return this;
+  }
+
+  addFlag(flag: FlagSpec): this {
+    this.flags.push(flag);
+    return this;
+  }
+
+  handler(fn: CommandHandler): this {
+    this._handler = fn;
+    return this;
+  }
+
+  getHandler(): CommandHandler | undefined {
+    return this._handler;
+  }
+}
+
+function flagsForNode(node: CommandNode): Record<string, any> {
+  const flags: Record<string, any> = {};
+  for (const flag of node.flags) {
+    const parsed = parseFlagText(flag.flagsText);
+    const base: Record<string, any> = {
+      description: flag.descriptionText,
+      helpLabel: flag.flagsText,
+      required: flag.required,
+    };
+    if (parsed.char) base.char = parsed.char;
+    if (!parsed.valueName) {
+      base.type = 'boolean';
+      base.allowNo = false;
+      if (flag.defaultValue !== undefined) base.default = flag.defaultValue;
+      flags[parsed.long] = Flags.boolean(base);
+    } else {
+      flags[parsed.long] = Flags.string({
+        ...base,
+        multiple: parsed.multiple,
+        multipleNonGreedy: false,
+        default: flag.defaultValue as any,
+        parse: async (input: string) => (flag.parser ? flag.parser(input) : input),
+      } as any);
+    }
+  }
+  return flags;
+}
+
+function argsForNode(node: CommandNode): Record<string, any> {
+  const args: Record<string, any> = {};
+  for (const arg of node.args) {
+    args[arg.name] = {
+      name: arg.name,
+      description: arg.description,
+      required: arg.required,
+      parse: async (input: string) => input,
+      ...(arg.defaultValue !== undefined ? { default: arg.defaultValue } : {}),
+    };
+  }
+  return args;
+}
+
+export interface FlagDef {
+  key: string;
+  attr: string;
+  flagsText: string;
+  required: boolean;
+}
+
+export function flagDefsForNode(node: CommandNode): FlagDef[] {
+  return node.flags.map((flag) => ({
+    key: parseFlagText(flag.flagsText).long,
+    attr: flag.attr,
+    flagsText: flag.flagsText,
+    required: flag.required,
+  }));
+}
+
+export function handlerValues(defs: FlagDef[], flags: Record<string, any>): Record<string, any> {
+  const values: Record<string, any> = { ...flags };
+  const isNegated = (def: FlagDef): boolean => def.key.startsWith('no-');
+  const positiveKeys = new Set(defs.map((def) => def.key));
+
+  // Apply positive flags first so a paired negated flag (for example
+  // --defaults / --no-defaults) can override the positive default.
+  for (const def of defs) {
+    if (isNegated(def)) continue;
+    if (flags[def.key] !== undefined) values[def.attr] = flags[def.key];
+  }
+  for (const def of defs) {
+    if (!isNegated(def)) continue;
+    const positiveKey = def.key.slice(3);
+    if (positiveKeys.has(positiveKey)) {
+      if (flags[def.key]) values[def.attr] = false;
+      delete values[def.key];
+      continue;
+    }
+    values[def.attr] = !Boolean(flags[def.key]);
+    delete values[def.key];
+  }
+  delete values.json;
+  if (flags.json !== undefined) values.json = flags.json;
+  return values;
+}
+
+function handlerArgs(defs: ArgSpec[], parsed: any): any[] {
+  const values: any[] = [];
+  for (const def of defs) {
+    if (def.multiple) {
+      values.push([...parsed.argv]);
+    } else {
+      let value = parsed.args[def.name];
+      if (value === undefined && def.defaultValue !== undefined) value = def.defaultValue;
+      values.push(value);
+    }
+  }
+  return values;
+}
+
+const SHOULD_SKIP_CHROME = new Set([
+  'path', 'paths', 'current', 'recent', 'state', 'ls', 'tree', 'find', 'grep', 'cat',
+  'head', 'meta', 'pwd', 'context', 'open', 'tab', 'reveal', 'link', 'links',
+  'backlinks', 'tags', 'tagged', 'new', 'append', 'note', 'rename', 'cd', 'back',
+]);
+
+export function shouldSkipCommandChrome(id: string, flags: Record<string, any> = {}): boolean {
+  const parts = id.split(':');
+  const name = parts[parts.length - 1];
+  if (name === '_run-job') return true;
+  if (flags.json) return true;
+  if (parts[0] === 'current' && parts.length > 1) return true;
+  if (SHOULD_SKIP_CHROME.has(name)) return true;
+  if (id === 'skill:show') return true;
+  return false;
+}
+
+interface CliHooks {
+  logo?: () => string;
+  showWhatsNew?: () => void;
+  runStartupMigrations?: () => void;
+  getTopics?: () => Record<string, any>;
+}
+
+let cliHooks: CliHooks | undefined;
+let postActionUpdateCheck = false;
+
+export function setCliHooks(hooks: CliHooks): void {
+  cliHooks = hooks;
+}
+
+export class FtCommand extends Command {
+  static _argDefs: ArgSpec[] = [];
+  static _flagDefs: FlagDef[] = [];
+  static _handler?: CommandHandler;
+
+  async run(): Promise<void> {
+    const Ctor = this.constructor as typeof FtCommand & {
+      id?: string;
+      _argDefs: ArgSpec[];
+      _flagDefs: FlagDef[];
+      _handler?: CommandHandler;
+    };
+    const parsed = await this.parse(Ctor as any);
+    if (!Ctor._handler) {
+      const { loadHelpClass } = await import('@oclif/core');
+      const HelpClass = await loadHelpClass(this.config);
+      const help = new HelpClass(this.config, {
+        ...(this.config.pjson.oclif.helpOptions ?? this.config.pjson.helpOptions),
+        sendToStderr: true,
+      } as any);
+      await help.showHelp([Ctor.id ?? '']);
+      process.exitCode = process.exitCode ?? 1;
+      return;
+    }
+    const values = handlerValues(Ctor._flagDefs, parsed.flags as Record<string, any>);
+    if (!shouldSkipCommandChrome(Ctor.id ?? '', values)) {
+      if (cliHooks?.logo) console.log(cliHooks.logo());
+      if (cliHooks?.showWhatsNew) cliHooks.showWhatsNew();
+    }
+    const args = handlerArgs(Ctor._argDefs, parsed);
+    const parent = {
+      opts: () => ({}),
+    };
+    await Ctor._handler(...args, values, parent);
+  }
+
+  async catch(err: any): Promise<void> {
+    const Ctor = this.constructor as typeof FtCommand & { _flagDefs: FlagDef[] };
+    const missing = /Missing required flag (\S+)/.exec(err?.message ?? '');
+    if (missing) {
+      const def = Ctor._flagDefs.find((flag) => flag.key === missing[1]);
+      err.message = `required option '${def?.flagsText ?? missing[1]}' not specified`;
+    }
+    // oclif marks most parser failures for help, but bare CLIError cases such
+    // as "Flag --x expects a value" arrive without that marker even though
+    // they are usage errors. Keep help after every flag/argument parse
+    // failure, matching the CLI's historical behavior.
+    if (err instanceof Errors.CLIError) (err as any).showHelp = true;
+    if (err?.showHelp || missing) {
+      err.showHelp = true;
+      err.parse = err.parse ?? { input: { argv: [...this.argv] } };
+    }
+    throw err;
+  }
+
+  async finally(err?: Error): Promise<void> {
+    if (!postActionUpdateCheck || err) return;
+    // Help-only topic invocations never run an action, so the historical
+    // post-action update check did not fire for them either.
+    const Ctor = this.constructor as typeof FtCommand & { _handler?: CommandHandler };
+    if (!Ctor._handler) return;
+    if (shouldSkipCommandChrome(this.id ?? '', {}) || this.argv.includes('--json')) return;
+    await checkForUpdate();
+  }
+}
+
+function makeCommandClass(node: CommandNode, id: string): typeof FtCommand {
+  class Generated extends FtCommand {}
+  const cls = Generated as any;
+  cls.id = id;
+  cls.description = node.getDescription();
+  cls.aliases = [...node.aliases];
+  cls.hidden = node.hidden;
+  cls.strict = node.args.some((arg) => arg.multiple) ? false : true;
+  cls.args = argsForNode(node);
+  cls.flags = flagsForNode(node);
+  cls._argDefs = [...node.args];
+  cls._flagDefs = flagDefsForNode(node);
+  cls._handler = node.getHandler();
+  return cls as typeof FtCommand;
+}
+
+export function buildCommandMap(root: CommandNode): Record<string, typeof FtCommand> {
+  const map: Record<string, typeof FtCommand> = {};
+  const walk = (node: CommandNode, parentId: string): void => {
+    for (const child of node.children) {
+      const id = parentId ? `${parentId}:${child.name()}` : String(child.name());
+      map[id] = makeCommandClass(child, id);
+      walk(child, id);
+    }
+  };
+  walk(root, '');
+  return map;
+}
+
+export function buildTopics(root: CommandNode): Record<string, any> {
+  const topics: Record<string, any> = {};
+  for (const child of root.children) {
+    const entry: Record<string, any> = { description: child.getDescription() };
+    if (child.hidden) entry.hidden = true;
+    const subtopics = buildTopics(child);
+    if (Object.keys(subtopics).length > 0) entry.subtopics = subtopics;
+    topics[String(child.name())] = entry;
+  }
+  return topics;
+}
+
+const BOOKMARK_TARGETS = new Set([
+  'sync', 'search', 'list', 'show', 'stats', 'viz', 'classify', 'classify-domains',
+  'categories', 'domains', 'folders', 'model', 'index', 'auth', 'status', 'path',
+  'sample', 'fetch-media',
+]);
+
+export function rewriteCompatArgv(input: string[]): string[] {
+  const args = [...input];
+  if (args[0] === 'ideas') args[0] = 'possible';
+  if (args[0] === 'possible' && args[1] === 'seed') return ['seeds', ...args.slice(2)];
+  if (args[0] === 'bookmarks') {
+    if (args.length === 1) return args;
+    if (args[1] === 'enable') return ['sync', ...args.slice(2)];
+    if (BOOKMARK_TARGETS.has(args[1])) return [args[1], ...args.slice(2)];
+    return args;
+  }
+  if (args[0] === 'current' && args[1] !== 'update') {
+    for (let i = 1; i < args.length; i++) {
+      if (args[i] === '--manifest') {
+        i += 1;
+        continue;
+      }
+      if (args[i] === 'update') {
+        return ['current:update', ...args.slice(1, i), ...args.slice(i + 1)];
+      }
+      if (!args[i].startsWith('-')) break;
+    }
+  }
+  return args;
+}
+
+function packageRoot(): string {
+  return path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+}
+
+let configPromise: Promise<Config> | undefined;
+
+async function createConfig(dev: boolean): Promise<Config> {
+  const root = packageRoot();
+  const pkg = JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf-8'));
+  const target = dev ? './src/cli-commands.ts' : './dist/cli-commands.js';
+  pkg.oclif = {
+    ...(pkg.oclif ?? {}),
+    bin: 'ft',
+    dirname: 'fieldtheory',
+    description: ROOT_DESCRIPTION,
+    topicSeparator: ' ',
+    additionalHelpFlags: ['-h'],
+    additionalVersionFlags: ['-V'],
+    commands: { strategy: 'explicit', identifier: 'commands', target },
+    helpClass: dev ? './src/cli-help.ts' : './dist/cli-help.js',
+    ...(cliHooks?.getTopics ? { topics: cliHooks.getTopics() } : {}),
+  };
+  const config = await Config.load({ root, pjson: pkg });
+  // oclif prints `userAgent` for --version; the public contract requires the
+  // bare package version on that path.
+  config.userAgent = config.version;
+  return config;
+}
+
+export function warmCliConfig(dev = import.meta.url.endsWith('.ts')): Promise<Config> {
+  if (!configPromise) configPromise = createConfig(dev);
+  return configPromise;
+}
+
+export async function runCli(argv: string[], options: { postActionUpdateCheck?: boolean; dev?: boolean } = {}): Promise<unknown> {
+  postActionUpdateCheck = Boolean(options.postActionUpdateCheck);
+  if (!cliHooks) {
+    await import('./cli.js');
+  }
+  cliHooks?.runStartupMigrations?.();
+  const config = await warmCliConfig(options.dev ?? import.meta.url.endsWith('.ts'));
+  return execute({ args: rewriteCompatArgv([...argv]), loadOptions: config });
+}
