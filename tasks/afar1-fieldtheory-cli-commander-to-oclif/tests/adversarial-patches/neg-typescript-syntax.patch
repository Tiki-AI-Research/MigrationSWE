diff --git a/tests/cli-blackbox.test.ts b/tests/cli-blackbox.test.ts
new file mode 100644
index 0000000..4dc7363
--- /dev/null
+++ b/tests/cli-blackbox.test.ts
@@ -0,0 +1,156 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const distEntry = path.join(repoRoot, 'dist', 'cli.js');
+const binEntry = path.join(repoRoot, 'bin', 'ft.mjs');
+
+function runRaw(args: string[], input?: string) {
+  const home = fs.mkdtempSync(path.join(os.tmpdir(), 'ft-blackbox-'));
+  const data = path.join(home, 'data');
+  const result = spawnSync(process.execPath, args, {
+    cwd: home,
+    input,
+    encoding: 'utf-8',
+    env: {
+      ...process.env,
+      HOME: home,
+      FT_DATA_DIR: data,
+      FT_LIBRARY_DIR: path.join(home, 'library'),
+      FT_COMMANDS_DIR: path.join(home, 'commands'),
+    },
+  });
+  return { data, home, result };
+}
+
+function run(args: string[], input?: string) {
+  const { home, result } = runRaw(args, input);
+  fs.rmSync(home, { recursive: true, force: true });
+  return result;
+}
+
+test('built CLI exposes help and both version spellings', () => {
+  assert.ok(fs.existsSync(distEntry), 'dist/cli.js must exist; run npm run build before tests');
+  for (const flag of ['--version', '-V']) {
+    const result = run([distEntry, flag]);
+    assert.equal(result.status, 0);
+    assert.match(result.stdout.trim(), /^\d+\.\d+\.\d+$/);
+  }
+  const help = run([distEntry, '--help']);
+  assert.equal(help.status, 0);
+  assert.match(help.stdout, /Self-custody for your X\/Twitter bookmarks/);
+  for (const command of ['sync', 'search', 'possible', 'ideas', 'bookmarks', 'install', 'skill']) {
+    assert.match(help.stdout, new RegExp(`\\b${command}\\b`), `help should list ${command}`);
+  }
+});
+
+test('both package bin names point at the same entry', () => {
+  const pkg = JSON.parse(fs.readFileSync(path.join(repoRoot, 'package.json'), 'utf-8'));
+  assert.equal(pkg.bin.ft, 'bin/ft.mjs');
+  assert.equal(pkg.bin.fieldtheory, 'bin/ft.mjs');
+  const result = run([binEntry, '--version']);
+  assert.equal(result.status, 0);
+  assert.match(result.stdout.trim(), /^\d+\.\d+\.\d+$/);
+});
+
+test('compatibility forwarding, aliases, and validation keep their contracts', () => {
+  const alias = run([distEntry, 'ideas', '--help']);
+  assert.equal(alias.status, 0);
+  assert.match(alias.stdout, /possible/i);
+
+  const seedAlias = run([distEntry, 'possible', 'seed', 'list']);
+  assert.equal(seedAlias.status, 0);
+  assert.match(seedAlias.stdout, /seeds/i);
+
+  const bookmarks = run([distEntry, 'bookmarks', 'enable', '--help']);
+  assert.equal(bookmarks.status, 0);
+  assert.match(bookmarks.stdout, /sync bookmarks/i);
+
+  const invalid = run([distEntry, 'recent', '--limit', '0']);
+  assert.notEqual(invalid.status, 0);
+  assert.match(invalid.stderr, /positive integer/i);
+  assert.match(invalid.stderr, /USAGE/);
+
+  const positiveSpelling = run([distEntry, 'sync', '--media']);
+  assert.notEqual(positiveSpelling.status, 0);
+  assert.match(positiveSpelling.stderr, /--media/);
+  assert.match(positiveSpelling.stderr, /--no-media/);
+});
+
+test('variadic options accept space-separated values', () => {
+  const sync = run([
+    distEntry, 'sync', '--cookies', 'ct0-value', 'auth-token-value', '--rebuild', '--continue',
+  ]);
+  assert.notEqual(sync.status, 0);
+  assert.match(sync.stderr, /cannot be used together/);
+  assert.doesNotMatch(sync.stderr, /Unexpected argument/);
+
+  const seed = run([distEntry, 'seeds', 'create', '--artifact', 'artifact-one', 'artifact-two']);
+  assert.notEqual(seed.status, 0);
+  assert.match(seed.stderr, /Artifact not found: artifact-one/);
+  assert.doesNotMatch(seed.stderr, /Unexpected argument/);
+
+  const possible = run([distEntry, 'possible', 'run', '--repos', '/repo/one', '/repo/two']);
+  assert.notEqual(possible.status, 0);
+  assert.match(possible.stdout, /Provide either --seed-artifact/);
+  assert.doesNotMatch(possible.stderr, /Unexpected argument/);
+
+  const { data, home, result } = runRaw([
+    distEntry, 'possible', 'nightly', 'install',
+    '--seed-artifact', 'seed-a', 'seed-b',
+    '--repos', '/repo/a', '/repo/b',
+    '--no-launchd',
+  ]);
+  try {
+    assert.equal(result.status, 0, result.stderr);
+    const schedule = JSON.parse(fs.readFileSync(path.join(data, 'ideas', 'nightly', 'default.json'), 'utf-8'));
+    assert.deepEqual(schedule.plan.seedArtifactIds, ['seed-a', 'seed-b']);
+    assert.deepEqual(schedule.plan.repos, ['/repo/a', '/repo/b']);
+  } finally {
+    fs.rmSync(home, { recursive: true, force: true });
+  }
+});
+
+test('usage and validation failures show command help', () => {
+  const missing = run([distEntry, 'show']);
+  assert.notEqual(missing.status, 0);
+  assert.match(missing.stderr, /Missing 1 required arg/);
+  assert.match(missing.stderr, /USAGE/);
+
+  const unknown = run([distEntry, 'sync', '--bogus']);
+  assert.notEqual(unknown.status, 0);
+  assert.match(unknown.stderr, /Nonexistent flag: --bogus/);
+  assert.match(unknown.stderr, /USAGE/);
+
+  const missingValue = run([distEntry, 'recent', '--limit']);
+  assert.notEqual(missingValue.status, 0);
+  assert.match(missingValue.stderr, /expects a value/);
+  assert.match(missingValue.stderr, /USAGE/);
+
+  const missingRequiredOption = run([distEntry, 'seeds', 'create']);
+  assert.notEqual(missingRequiredOption.status, 0);
+  assert.match(missingRequiredOption.stderr, /required option '--artifact <id\.\.\.>' not specified/);
+  assert.match(missingRequiredOption.stderr, /USAGE/);
+});
+
+test('help appends the cached update notice', () => {
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'ft-blackbox-notice-'));
+  try {
+    fs.writeFileSync(path.join(tmp, '.update-check'), '99.99.99');
+    const result = spawnSync(process.execPath, [distEntry, '--help'], {
+      cwd: tmp,
+      encoding: 'utf-8',
+      env: { ...process.env, HOME: tmp, FT_DATA_DIR: tmp },
+    });
+    assert.equal(result.status, 0);
+    assert.match(result.stdout, /Update available/);
+    assert.match(result.stdout, /99\.99\.99/);
+  } finally {
+    fs.rmSync(tmp, { recursive: true, force: true });
+  }
+});
