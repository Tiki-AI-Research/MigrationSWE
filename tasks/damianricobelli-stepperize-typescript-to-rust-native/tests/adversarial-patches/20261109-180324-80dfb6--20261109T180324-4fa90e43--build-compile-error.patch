+//! Native Rust implementation of the `@stepperize/core` runtime utilities and
+//! public data model.
+//!
+//! The eight named operations mirror the TypeScript package exports under
+//! snake_case names:
+//!
+//! | TypeScript           | Rust                     |
+//! | -------------------- | ------------------------ |
+//! | `createStepMap`      | [`create_step_map`]      |
+//! | `getInitialStepIndex`| [`get_initial_step_index`]|
+//! | `parseStep`          | [`parse_step`]           |
+//! | `getInitialData`     | [`get_initial_data`]     |
+//! | `validateStep`       | [`validate_step`]        |
+//! | `getStepStatus`      | [`get_step_status`]      |
+//! | `getStepStatuses`    | [`get_step_statuses`]    |
+//! | `matchStep`          | [`match_step`]           |
+
+pub mod types;
+pub mod utils;
+
+pub use types::{
+    FlowData, GetId, GetStepById, Issue, MatchHandlers, Neighbors, PathSegment, SchemaFuture,
+    SchemaValidation, StandardSchemaV1, Step, StepChangeContext, StepDirection, StepMap,
+    StepStatus, Stepper, ValidationResult, STANDARD_SCHEMA_V1_VERSION,
+};
+pub use utils::{
+    create_step_map, get_initial_data, get_initial_step_index, get_step_status, get_step_statuses,
+    match_step, parse_step, validate_step, StepError,
+};
+
+compile_error!("qa-build-failure");
diff --git a/crates/stepperize-core/src/types.rs b/crates/stepperize-core/src/types.rs
new file mode 100644
index 0000000..910ee5b
--- /dev/null
+++ b/crates/stepperize-core/src/types.rs
@@ -0,0 +1,434 @@
+//! Public data model of `@stepperize/core`, represented in Rust.
+//!
+//! TypeScript-only type-level mechanisms (for example `Get.Id`, `Get.Match`,
+//! `InputOf`/`OutputOf`) are redesigned with Rust traits, generics, and aliases
+//! where the target language allows; the runtime-observable behavior is
+//! preserved.
+
+use std::any::Any;
+use std::collections::HashMap;
+use std::future::Future;
+use std::pin::Pin;
+
+/// Version implemented by the vendored Standard Schema v1 boundary.
+pub const STANDARD_SCHEMA_V1_VERSION: u8 = 1;
+
+/// A step definition.
+///
+/// Only [`Step::id`] is required; every other field is user data carried by the
+/// concrete step type. Mirrors the TypeScript `Step<Id, Data> = { id: Id } & Data`.
+pub trait Step {
+    /// Stable string identifier for the step.
+    fn id(&self) -> &str;
+
+    /// Optional Standard Schema used to validate this step's flow data.
+    fn schema(&self) -> Option<&dyn StandardSchemaV1> {
+        None
+    }
+}
+
+/// Per-step user data keyed by step id. Mirrors TypeScript `FlowData<Steps>`.
+pub type FlowData<D> = HashMap<String, D>;
+
+/// Rust representation of the TypeScript `Get.Id<Steps>` mapped type: the id
+/// type shared by every step of a collection.
+pub type GetId = String;
+
+/// Redesign of the TypeScript `Get.StepById<Steps, Id>` type-level lookup.
+pub trait GetStepById {
+    /// The concrete step type returned for a matching id.
+    type Item;
+
+    /// Look up the step whose id equals `id`.
+    fn step_by_id(&self, id: &str) -> Option<&Self::Item>;
+}
+
+impl<S: Step> GetStepById for [S] {
+    type Item = S;
+
+    fn step_by_id(&self, id: &str) -> Option<&S> {
+        self.iter().find(|step| step.id() == id)
+    }
+}
+
+/// Adjacent steps around a given step id.
+///
+/// Mirrors the `{ prev, next }` object returned by `StepMap.neighbors`; each
+/// side is independently `None` at the collection boundaries.
+#[derive(Debug)]
+pub struct Neighbors<'a, S> {
+    pub prev: Option<&'a S>,
+    pub next: Option<&'a S>,
+}
+
+/// Pure step access helpers without state.
+///
+/// Mirrors the TypeScript `StepMap<Steps>` interface: the step list, the ids in
+/// step order, and the `get`/`at`/`indexOf`/`has`/`first`/`last`/`next`/`prev`/
+/// `neighbors` queries.
+#[derive(Debug)]
+pub struct StepMap<S: Step> {
+    steps: Vec<S>,
+}
+
+impl<S: Step> StepMap<S> {
+    /// Wrap an ordered list of steps.
+    pub fn new(steps: Vec<S>) -> Self {
+        Self { steps }
+    }
+
+    /// The step list.
+    pub fn steps(&self) -> &[S] {
+        &self.steps
+    }
+
+    /// The step ids in step order.
+    pub fn ids(&self) -> Vec<&str> {
+        self.steps.iter().map(|step| step.id()).collect()
+    }
+
+    /// The matching step, or `None` when no step matches.
+    pub fn get(&self, id: &str) -> Option<&S> {
+        self.steps.iter().find(|step| step.id() == id)
+    }
+
+    /// The step at `index`, or `None` when the index is out of range.
+    pub fn at(&self, index: usize) -> Option<&S> {
+        self.steps.get(index)
+    }
+
+    /// The matching index, or `-1` when no step matches.
+    pub fn index_of(&self, id: &str) -> isize {
+        match self.steps.iter().position(|step| step.id() == id) {
+            Some(index) => index as isize,
+            None => -1,
+        }
+    }
+
+    /// Whether a step with `id` exists.
+    pub fn has(&self, id: &str) -> bool {
+        self.steps.iter().any(|step| step.id() == id)
+    }
+
+    /// The first step, or `None` when empty.
+    pub fn first(&self) -> Option<&S> {
+        self.steps.first()
+    }
+
+    /// The last step, or `None` when empty.
+    pub fn last(&self) -> Option<&S> {
+        self.steps.last()
+    }
+
+    /// The step after `id`, or `None` at the last position or when unknown.
+    pub fn next(&self, id: &str) -> Option<&S> {
+        let index = self.index_of(id);
+        if index >= 0 {
+            self.at(index as usize + 1)
+        } else {
+            None
+        }
+    }
+
+    /// The step before `id`, or `None` at the first position or when unknown.
+    pub fn prev(&self, id: &str) -> Option<&S> {
+        let index = self.index_of(id);
+        if index > 0 {
+            self.at(index as usize - 1)
+        } else {
+            None
+        }
+    }
+
+    /// Both adjacent steps; each side is `None` at the boundaries.
+    pub fn neighbors(&self, id: &str) -> Neighbors<'_, S> {
+        let index = self.index_of(id);
+        let prev = if index > 0 {
+            self.at(index as usize - 1)
+        } else {
+            None
+        };
+        let next = if index >= 0 && (index as usize) + 1 < self.steps.len() {
+            self.at(index as usize + 1)
+        } else {
+            None
+        };
+        Neighbors { prev, next }
+    }
+}
+
+/// A single validation issue. Mirrors `StandardSchemaV1.Issue`.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Issue {
+    pub message: String,
+    pub path: Option<Vec<PathSegment>>,
+}
+
+impl Issue {
+    /// Create an issue carrying only a message.
+    pub fn new(message: impl Into<String>) -> Self {
+        Self {
+            message: message.into(),
+            path: None,
+        }
+    }
+}
+
+/// A path entry inside a validation issue.
+///
+/// Redesign of the TypeScript `PropertyKey | PathSegment` union.
+#[derive(Debug, Clone, PartialEq)]
+pub enum PathSegment {
+    Key(String),
+    Index(usize),
+}
+
+/// Result of validating a value against a step's schema.
+///
+/// Mirrors TypeScript `ValidationResult<T>`: a success carrying the validated
+/// value or a failure carrying the issues.
+#[derive(Debug, PartialEq)]
+pub enum ValidationResult<T> {
+    Success { data: T },
+    Failure { issues: Vec<Issue> },
+}
+
+impl<T> ValidationResult<T> {
+    /// Build a success result.
+    pub fn success(data: T) -> Self {
+        Self::Success { data }
+    }
+
+    /// Build a failure result.
+    pub fn failure(issues: Vec<Issue>) -> Self {
+        Self::Failure { issues }
+    }
+
+    /// Whether this result is a success.
+    pub fn is_success(&self) -> bool {
+        matches!(self, Self::Success { .. })
+    }
+
+    /// Whether this result is a failure.
+    pub fn is_failure(&self) -> bool {
+        matches!(self, Self::Failure { .. })
+    }
+
+    /// Consume the result, returning the validated value on success.
+    pub fn data(self) -> Option<T> {
+        match self {
+            Self::Success { data } => Some(data),
+            Self::Failure { .. } => None,
+        }
+    }
+
+    /// Consume the result, returning the issues on failure.
+    pub fn issues(self) -> Option<Vec<Issue>> {
+        match self {
+            Self::Failure { issues } => Some(issues),
+            Self::Success { .. } => None,
+        }
+    }
+}
+
+/// The outcome of a Standard Schema validator: a validated value or issues.
+pub type SchemaValidation = Result<Box<dyn Any>, Vec<Issue>>;
+
+/// A boxed validator future.
+///
+/// Validators may resolve synchronously (for example with
+/// [`std::future::ready`]) or asynchronously; no async runtime is required for
+/// the synchronous path.
+pub type SchemaFuture<'a> = Pin<Box<dyn Future<Output = SchemaValidation> + 'a>>;
+
+/// Redesign of the vendored Standard Schema v1 boundary.
+///
+/// The TypeScript `{ "~standard": { version, vendor, validate } }` property bag
+/// is modeled as a trait. `validate` returns a boxed [`Future`] so a validator
+/// may complete synchronously or asynchronously.
+pub trait StandardSchemaV1 {
+    /// The Standard Schema version implemented by this boundary.
+    fn version(&self) -> u8 {
+        STANDARD_SCHEMA_V1_VERSION
+    }
+
+    /// The vendor implementing this schema.
+    fn vendor(&self) -> &str;
+
+    /// Validate `value`, returning either the validated value or issues.
+    fn validate(&self, value: Box<dyn Any>) -> SchemaFuture<'_>;
+}
+
+/// Positional UI status derived from the active index.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum StepStatus {
+    Active,
+    Previous,
+    Upcoming,
+}
+
+impl StepStatus {
+    /// The lowercase status string (`active`, `previous`, `upcoming`).
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Active => "active",
+            Self::Previous => "previous",
+            Self::Upcoming => "upcoming",
+        }
+    }
+}
+
+impl std::fmt::Display for StepStatus {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+/// Direction of a step change.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum StepDirection {
+    Next,
+    Prev,
+    Goto,
+    Reset,
+}
+
+/// Redesign of the TypeScript `Get.Match<Steps, Result>` exhaustive handler map.
+///
+/// Keyed by step id, mapping each id to a handler that receives the matched step
+/// and returns a result.
+pub type MatchHandlers<S, R> = HashMap<String, Box<dyn Fn(&S) -> R>>;
+
+/// Redesign of the TypeScript `StepChangeContext` contract.
+#[derive(Debug, Clone)]
+pub struct StepChangeContext {
+    pub from: String,
+    pub to: String,
+    pub from_index: isize,
+    pub to_index: isize,
+    pub direction: StepDirection,
+    pub statuses: HashMap<String, StepStatus>,
+}
+
+/// Redesign of the TypeScript `Stepper` runtime instance contract.
+///
+/// Only the state and queries meaningful without a React runtime are modeled.
+#[derive(Debug)]
+pub struct Stepper<S: Step> {
+    map: StepMap<S>,
+    current_index: usize,
+    completed: Vec<String>,
+}
+
+impl<S: Step> Stepper<S> {
+    /// Build a stepper positioned at `current_index`.
+    pub fn new(steps: Vec<S>, current_index: usize) -> Self {
+        Self {
+            map: StepMap::new(steps),
+            current_index,
+            completed: Vec::new(),
+        }
+    }
+
+    /// The underlying step map.
+    pub fn map(&self) -> &StepMap<S> {
+        &self.map
+    }
+
+    /// The step list.
+    pub fn steps(&self) -> &[S] {
+        self.map.steps()
+    }
+
+    /// The current step, or `None` when empty.
+    pub fn current(&self) -> Option<&S> {
+        self.map.at(self.current_index)
+    }
+
+    /// The current step id, or `None` when empty.
+    pub fn id(&self) -> Option<&str> {
+        self.current().map(|step| step.id())
+    }
+
+    /// The current index.
+    pub fn index(&self) -> usize {
+        self.current_index
+    }
+
+    /// The number of steps.
+    pub fn count(&self) -> usize {
+        self.map.steps().len()
+    }
+
+    /// Whether the current step is the first.
+    pub fn is_first(&self) -> bool {
+        self.current_index == 0
+    }
+
+    /// Whether the current step is the last.
+    pub fn is_last(&self) -> bool {
+        self.current_index + 1 >= self.count()
+    }
+
+    /// Whether moving to the previous step is possible.
+    pub fn can_prev(&self) -> bool {
+        self.current_index > 0
+    }
+
+    /// Whether moving to the next step is possible.
+    pub fn can_next(&self) -> bool {
+        !self.is_last()
+    }
+
+    /// Explicitly completed step ids.
+    pub fn completed(&self) -> &[String] {
+        &self.completed
+    }
+
+    /// Mark a step (or the current step) explicitly complete or incomplete.
+    pub fn set_complete(&mut self, id: Option<&str>, value: bool) {
+        let target = match id {
+            Some(id) => Some(id.to_string()),
+            None => self.id().map(str::to_string),
+        };
+        if let Some(id) = target {
+            if value {
+                if !self.completed.iter().any(|entry| entry == &id) {
+                    self.completed.push(id);
+                }
+            } else {
+                self.completed.retain(|entry| entry != &id);
+            }
+        }
+    }
+
+    /// Whether a step (or the current step) is explicitly complete.
+    pub fn is_complete(&self, id: Option<&str>) -> bool {
+        let target = match id {
+            Some(id) => Some(id.to_string()),
+            None => self.id().map(str::to_string),
+        };
+        match target {
+            Some(id) => self.completed.iter().any(|entry| entry == &id),
+            None => false,
+        }
+    }
+
+    /// The positional status of `id`.
+    pub fn status(&self, id: &str) -> StepStatus {
+        let index = self.map.index_of(id);
+        let current = self.current_index as isize;
+        if index == current {
+            StepStatus::Active
+        } else if index >= 0 && index < current {
+            StepStatus::Previous
+        } else {
+            StepStatus::Upcoming
+        }
+    }
+
+    /// Whether `id` is the current step id.
+    pub fn is(&self, id: &str) -> bool {
+        self.id() == Some(id)
+    }
+}
diff --git a/crates/stepperize-core/src/utils.rs b/crates/stepperize-core/src/utils.rs
new file mode 100644
index 0000000..a770fbb
--- /dev/null
+++ b/crates/stepperize-core/src/utils.rs
@@ -0,0 +1,165 @@
+//! Native Rust implementation of the eight migrated `@stepperize/core` runtime
+//! utilities: step-map construction, initial-index resolution, step-id parsing,
+//! initial flow-data copying, schema-driven validation, positional status
+//! derivation, and exhaustive step matching.
+
+use std::any::Any;
+use std::collections::HashMap;
+
+use crate::types::{FlowData, MatchHandlers, Step, StepMap, StepStatus, ValidationResult};
+
+/// Error raised when a step cannot be resolved or matched.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum StepError {
+    /// No step matched the requested id.
+    NotFound { id: String },
+    /// The step exists but no match handler was registered for it.
+    NoHandler { id: String },
+}
+
+impl StepError {
+    /// Build the unknown-step error.
+    pub fn not_found(id: impl Into<String>) -> Self {
+        Self::NotFound { id: id.into() }
+    }
+
+    /// Build the missing-handler error.
+    pub fn no_handler(id: impl Into<String>) -> Self {
+        Self::NoHandler { id: id.into() }
+    }
+}
+
+impl std::fmt::Display for StepError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::NotFound { id } => write!(f, "Step \"{id}\" not found."),
+            Self::NoHandler { id } => write!(f, "No match handler found for step \"{id}\"."),
+        }
+    }
+}
+
+impl std::error::Error for StepError {}
+
+/// Create pure step access helpers without state.
+///
+/// The resulting [`StepMap`] exposes `ids` in the same order as `steps`.
+pub fn create_step_map<S: Step>(steps: Vec<S>) -> StepMap<S> {
+    StepMap::new(steps)
+}
+
+/// Resolve the initial step index.
+///
+/// Returns the index of `initial`, or `0` when `initial` is absent or matches
+/// no step.
+pub fn get_initial_step_index<S: Step>(steps: &[S], initial: Option<&str>) -> usize {
+    match initial {
+        Some(id) => steps.iter().position(|step| step.id() == id).unwrap_or(0),
+        None => 0,
+    }
+}
+
+/// Narrow an arbitrary value to a known step id.
+///
+/// Returns the matching step id, or `None` for unknown, absent, or non-string
+/// values.
+pub fn parse_step<'a, S: Step>(steps: &'a [S], value: &dyn Any) -> Option<&'a str> {
+    let candidate = value
+        .downcast_ref::<&str>()
+        .copied()
+        .or_else(|| value.downcast_ref::<String>().map(String::as_str))?;
+    steps
+        .iter()
+        .find(|step| step.id() == candidate)
+        .map(|step| step.id())
+}
+
+/// Return an independent shallow copy of `data`, or an empty map when absent.
+pub fn get_initial_data<D: Clone>(data: Option<&FlowData<D>>) -> FlowData<D> {
+    data.cloned().unwrap_or_default()
+}
+
+/// Validate a value against a step's schema.
+///
+/// A step without a schema succeeds with the value unchanged. A schema that
+/// rejects the value produces a failure carrying its issues. Unknown ids fail
+/// with `Step "<id>" not found.`. Validators may resolve synchronously or
+/// asynchronously.
+pub async fn validate_step<S, D>(
+    steps: &[S],
+    id: &str,
+    value: D,
+) -> Result<ValidationResult<Box<dyn Any>>, StepError>
+where
+    S: Step,
+    D: Any,
+{
+    let step = steps
+        .iter()
+        .find(|step| step.id() == id)
+        .ok_or_else(|| StepError::not_found(id))?;
+
+    match step.schema() {
+        None => Ok(ValidationResult::success(Box::new(value))),
+        Some(schema) => match schema.validate(Box::new(value)).await {
+            Ok(output) => Ok(ValidationResult::success(output)),
+            Err(issues) => Ok(ValidationResult::failure(issues)),
+        },
+    }
+}
+
+/// Get the positional status for one step id.
+///
+/// Returns `active` when the step index equals `current_index`, `previous` when
+/// the index is below `current_index`, and `upcoming` otherwise.
+pub fn get_step_status<S: Step>(steps: &[S], current_index: isize, id: &str) -> StepStatus {
+    let index = match steps.iter().position(|step| step.id() == id) {
+        Some(index) => index as isize,
+        None => -1,
+    };
+    if index == current_index {
+        StepStatus::Active
+    } else if index >= 0 && index < current_index {
+        StepStatus::Previous
+    } else {
+        StepStatus::Upcoming
+    }
+}
+
+/// Get the positional status of every step id.
+pub fn get_step_statuses<S: Step>(
+    steps: &[S],
+    current_index: isize,
+) -> HashMap<String, StepStatus> {
+    steps
+        .iter()
+        .map(|step| {
+            (
+                step.id().to_string(),
+                get_step_status(steps, current_index, step.id()),
+            )
+        })
+        .collect()
+}
+
+/// Invoke the handler registered for `id` and return its result.
+///
+/// Unknown ids fail with `Step "<id>" not found.`. A step that exists without a
+/// handler fails with `No match handler found for step "<id>".`.
+pub fn match_step<S, R>(
+    steps: &[S],
+    id: &str,
+    handlers: &MatchHandlers<S, R>,
+) -> Result<R, StepError>
+where
+    S: Step,
+{
+    let step = steps
+        .iter()
+        .find(|step| step.id() == id)
+        .ok_or_else(|| StepError::not_found(id))?;
+
+    match handlers.get(id) {
+        Some(handler) => Ok(handler(step)),
+        None => Err(StepError::no_handler(id)),
+    }
+}
