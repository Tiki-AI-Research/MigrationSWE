diff --git a/tests/shared/batches/BATCH-F2P-0001/probes/probe_lib.sh b/tests/shared/batches/BATCH-F2P-0001/probes/probe_lib.sh
new file mode 100755
--- /dev/null
+++ b/tests/shared/batches/BATCH-F2P-0001/probes/probe_lib.sh
@@ -0,0 +1,39 @@
+#!/bin/sh
+# Shared probe helpers for BATCH-F2P-0001 (F2P target-postcondition batch).
+#
+# Every potentially long-running command is wrapped in an explicit `timeout`
+# so the harness can never block forever. The default budget matches the
+# provided target harness (run_tests.py uses timeout=1500s).
+
+F2P_TIMEOUT_SECS="${F2P_TIMEOUT_SECS:-1500}"
+
+# run_cargo_test <repo-dir>
+# Build and test the Rust workspace offline under an explicit timeout.
+run_cargo_test() {
+  repo="$1"
+  ( cd "$repo" && timeout "$F2P_TIMEOUT_SECS" env \
+      CARGO_NET_OFFLINE=true CARGO_HOME="${CARGO_HOME:-/usr/local/cargo}" \
+      cargo test --workspace --locked --offline )
+}
+
+# cargo_manifest_has_dependencies <Cargo.toml> [section]
+# Print "yes" when the (default [dependencies]) table has entries, else "no".
+cargo_manifest_has_dependencies() {
+  python3 - "$1" "${2:-[dependencies]}" <<'PY'
+import sys
+path, want = sys.argv[1], sys.argv[2]
+section = None
+entries = []
+with open(path, encoding="utf-8") as handle:
+    for raw in handle:
+        line = raw.split("#", 1)[0].strip()
+        if not line:
+            continue
+        if line.startswith("[") and line.endswith("]"):
+            section = line
+            continue
+        if section == want:
+            entries.append(line)
+print("yes" if entries else "no")
+PY
+}
diff --git a/tests/shared/batches/BATCH-F2P-0003/f2p_probe.py b/tests/shared/batches/BATCH-F2P-0003/f2p_probe.py
new file mode 100755
--- /dev/null
+++ b/tests/shared/batches/BATCH-F2P-0003/f2p_probe.py
@@ -0,0 +1,441 @@
+#!/usr/bin/env python3
+"""Shared F2P probe runner for BATCH-F2P-0003.
+
+The runner implements one semantic predicate per observation. The *same* code
+is executed against the source (TypeScript) repository and against the target
+(Rust) repository; behaviour is therefore determined by the repository under
+evaluation, never by the side label.
+
+Every potentially long-running command is wrapped in an explicit ``timeout``
+and no step is allowed to block indefinitely.
+"""
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import xml.sax.saxutils as sax
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+# shared/batches/BATCH-F2P-0003 -> assets root
+ASSETS_ROOT = os.path.normpath(os.path.join(HERE, "..", "..", ".."))
+PROBE_FILE = os.path.join(ASSETS_ROOT, "fixtures", "batches", "BATCH-F2P-0003", "f2p_probe.rs")
+OBSERVATIONS_FILE = os.path.join(HERE, "observations.json")
+LOCKED = ["--workspace", "--locked", "--offline"]
+CARGO_TIMEOUT = 1500
+GIT_TIMEOUT = 300
+
+PASS = "PASS"
+FAIL = "FAIL"
+INFRA = "INFRA_ERROR"
+
+DELEGATION_MARKERS = (
+    "std::process::Command",
+    "Command::new",
+    "child_process",
+    "napi",
+    "neon::",
+    "libloading",
+)
+
+
+def _run(cmd, cwd, timeout):
+    """Run a command with a hard timeout.
+
+    Returns ``(returncode, output)`` where returncode is an int, the string
+    ``"timeout"`` for a permanent block, or ``None`` when the executable cannot
+    be started at all (infrastructure error).
+    """
+    try:
+        proc = subprocess.run(
+            cmd,
+            cwd=cwd,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.returncode, proc.stdout
+    except FileNotFoundError as exc:
+        return None, str(exc)
+    except subprocess.TimeoutExpired as exc:
+        out = exc.stdout or ""
+        if isinstance(out, bytes):
+            out = out.decode("utf-8", "replace")
+        return "timeout", out
+
+
+def _read(path):
+    try:
+        with open(path, "r", encoding="utf-8") as handle:
+            return handle.read()
+    except OSError:
+        return None
+
+
+def _load_toml(path):
+    try:
+        import tomllib
+    except ImportError:  # pragma: no cover - python < 3.11
+        return None
+    try:
+        with open(path, "rb") as handle:
+            return tomllib.load(handle)
+    except (OSError, ValueError):
+        return None
+
+
+def _crate_dir(repo):
+    return os.path.join(repo, "crates", "stepperize-core")
+
+
+def _crate_manifest(repo):
+    return os.path.join(_crate_dir(repo), "Cargo.toml")
+
+
+def _has_crate(repo):
+    return os.path.isfile(os.path.join(repo, "Cargo.toml")) and os.path.isfile(
+        _crate_manifest(repo)
+    )
+
+
+def _cargo_available():
+    return shutil.which("cargo") is not None
+
+
+def _manifest_has_external_dependencies(repo):
+    data = _load_toml(_crate_manifest(repo))
+    if data is None:
+        return None
+    package = data.get("package", {})
+    if package.get("build"):
+        return True
+    for section in ("dependencies", "dev-dependencies", "build-dependencies"):
+        deps = data.get(section)
+        if deps:
+            return True
+    return False
+
+
+def check_dependency_policy(repo):
+    """R028: no delegation, empty dependency table, no build script."""
+    if not _has_crate(repo):
+        return FAIL, "no stepperize-core crate in repository"
+    external = _manifest_has_external_dependencies(repo)
+    if external is None:
+        return FAIL, "crate manifest unreadable"
+    if external:
+        return FAIL, "crate declares external dependencies or a build script"
+
+    src_dir = os.path.join(_crate_dir(repo), "src")
+    for root, _dirs, files in os.walk(src_dir):
+        for name in files:
+            if not name.endswith(".rs"):
+                continue
+            text = _read(os.path.join(root, name)) or ""
+            for marker in DELEGATION_MARKERS:
+                if marker in text:
+                    return FAIL, "runtime delegation marker %r found" % marker
+
+    if not _cargo_available():
+        return INFRA, "cargo executable unavailable"
+    code, out = _run(["cargo", "test"] + LOCKED, repo, CARGO_TIMEOUT)
+    if code is None:
+        return INFRA, "cargo could not be started"
+    if code == "timeout":
+        return INFRA, "cargo test timed out"
+    if code != 0:
+        return FAIL, "cargo test failed\n" + out[-2000:]
+    return PASS, "no delegation; cargo test passed offline"
+
+
+def check_manifest(repo):
+    """R043/F2P-069: workspace and lock pin only the local crate, empty deps."""
+    root_manifest = os.path.join(repo, "Cargo.toml")
+    if not os.path.isfile(root_manifest):
+        return FAIL, "no root Cargo.toml"
+    root = _load_toml(root_manifest)
+    if root is None:
+        return FAIL, "root Cargo.toml unreadable"
+    members = (root.get("workspace") or {}).get("members")
+    if not isinstance(members, list) or "crates/stepperize-core" not in members:
+        return FAIL, "workspace does not declare crates/stepperize-core"
+
+    lock = _load_toml(os.path.join(repo, "Cargo.lock"))
+    if lock is None:
+        return FAIL, "Cargo.lock missing or unreadable"
+    package_names = {pkg.get("name") for pkg in lock.get("package", [])}
+    if package_names - {"stepperize-core"}:
+        return FAIL, "Cargo.lock pins external crates: %s" % sorted(package_names)
+
+    external = _manifest_has_external_dependencies(repo)
+    if external is None:
+        return FAIL, "crate manifest unreadable"
+    if external:
+        return FAIL, "crate declares external dependencies or a build script"
+    return PASS, "workspace and lock contain only the local crate"
+
+
+def check_change_scope(repo):
+    """R029/F2P-054: only migration scope plus the Rust crate change."""
+    if not _has_crate(repo):
+        return FAIL, "no stepperize-core crate in repository"
+    if not os.path.isfile(os.path.join(_crate_dir(repo), "src", "utils.rs")):
+        return FAIL, "crate source missing"
+
+    gitignore = _read(os.path.join(repo, ".gitignore")) or ""
+    if not re.search(r"(?m)^\s*/?target/?\s*$", gitignore):
+        return FAIL, "Rust build directory is not ignored"
+
+    for keep in ("packages/react", "apps/docs"):
+        if not os.path.isdir(os.path.join(repo, keep)):
+            return FAIL, "%s is missing" % keep
+
+    if shutil.which("git") is None:
+        return INFRA, "git unavailable; cannot compare against the base commit"
+    if not os.path.isdir(os.path.join(repo, ".git")):
+        return FAIL, "repository is not a git checkout; base scope unverifiable"
+    code, out = _run(
+        ["git", "diff", "--exit-code", "HEAD", "--", "packages/react", "apps/docs"],
+        repo,
+        GIT_TIMEOUT,
+    )
+    if code is None:
+        return INFRA, "git could not be started"
+    if code == "timeout":
+        return INFRA, "git diff timed out"
+    if code != 0:
+        return FAIL, "packages/react or apps/docs differ from the base commit"
+    return PASS, "scope limited to the crate; react/docs unchanged"
+
+
+def check_standalone(repo):
+    """R002/F2P-067: the crate builds and tests with the TypeScript sources gone."""
+    if not _has_crate(repo):
+        return FAIL, "no stepperize-core crate in repository"
+    if not _cargo_available():
+        return INFRA, "cargo executable unavailable"
+
+    work = tempfile.mkdtemp(prefix="f2p-standalone-")
+    try:
+        for name in ("Cargo.toml", "Cargo.lock"):
+            src = os.path.join(repo, name)
+            if os.path.isfile(src):
+                shutil.copyfile(src, os.path.join(work, name))
+        shutil.copytree(os.path.join(repo, "crates"), os.path.join(work, "crates"))
+        # packages/core/src is intentionally absent in this isolated tree.
+        code, out = _run(["cargo", "test"] + LOCKED, work, CARGO_TIMEOUT)
+    except OSError as exc:
+        return INFRA, "could not stage crate: %s" % exc
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+
+    if code is None:
+        return INFRA, "cargo could not be started"
+    if code == "timeout":
+        return INFRA, "cargo test timed out"
+    if code != 0:
+        return FAIL, "crate does not build or test without packages/core/src\n" + out[-2000:]
+    return PASS, "crate builds and tests without the TypeScript sources"
+
+
+def check_build(repo):
+    """R001/F2P-072: cargo build yields the native Rust library crate."""
+    if not _has_crate(repo):
+        return FAIL, "no stepperize-core crate in repository"
+    if not _cargo_available():
+        return INFRA, "cargo executable unavailable"
+    code, out = _run(
+        ["cargo", "build", "--workspace", "--locked", "--offline"], repo, CARGO_TIMEOUT
+    )
+    if code is None:
+        return INFRA, "cargo could not be started"
+    if code == "timeout":
+        return INFRA, "cargo build timed out"
+    if code != 0:
+        return FAIL, "cargo build failed\n" + out[-2000:]
+    return PASS, "cargo build produced the native library crate"
+
+
+PY_CHECKS = {
+    "dependency": check_dependency_policy,
+    "manifest": check_manifest,
+    "scope": check_change_scope,
+    "standalone": check_standalone,
+    "build": check_build,
+}
+
+
+def _parse_cargo_tests(output):
+    results = {}
+    for line in output.splitlines():
+        if not line.startswith("test "):
+            continue
+        parts = line.split(" ... ", 1)
+        if len(parts) != 2:
+            continue
+        name = parts[0][len("test "):].strip()
+        status = parts[1].strip()
+        if status in ("ok", "FAILED", "ignored"):
+            results[name] = status
+    return results
+
+
+def run_rust_checks(repo):
+    """Run the Rust probe suite once and return per-test status (or an error)."""
+    if not _has_crate(repo):
+        return None, "no stepperize-core crate in repository"
+    if not _cargo_available():
+        return None, "cargo executable unavailable"
+    if not os.path.isfile(PROBE_FILE):
+        return None, "probe fixture missing at %s" % PROBE_FILE
+
+    tests_dir = os.path.join(_crate_dir(repo), "tests")
+    dest = os.path.join(tests_dir, "f2p_probe.rs")
+    created = False
+    try:
+        if not os.path.isdir(tests_dir):
+            os.makedirs(tests_dir)
+        shutil.copyfile(PROBE_FILE, dest)
+        created = True
+        code, out = _run(["cargo", "test"] + LOCKED, repo, CARGO_TIMEOUT)
+    except OSError as exc:
+        return None, "could not stage probe: %s" % exc
+    finally:
+        if created:
+            try:
+                os.remove(dest)
+            except OSError:
+                pass
+
+    if code is None:
+        return None, "cargo could not be started"
+    if code == "timeout":
+        return None, "cargo test timed out"
+    return _parse_cargo_tests(out), out
+
+
+def evaluate(repo):
+    spec = json.loads(_read(OBSERVATIONS_FILE) or "{}")
+    observations = spec.get("observations", spec)
+    rust_results, rust_detail = run_rust_checks(repo)
+    py_cache = {}
+
+    report = {}
+    for observation_id, entry in observations.items():
+        statuses = []
+        details = []
+        for check in entry.get("checks", []):
+            if check.startswith("rust:"):
+                test_name = check[len("rust:"):].strip()
+                if rust_results is None:
+                    statuses.append(FAIL)
+                    details.append("rust:%s: %s" % (test_name, rust_detail))
+                elif rust_results.get(test_name) == "ok":
+                    statuses.append(PASS)
+                    details.append("rust:%s: pass" % test_name)
+                else:
+                    statuses.append(FAIL)
+                    details.append(
+                        "rust:%s: %s" % (test_name, rust_results.get(test_name, "not run"))
+                    )
+            elif check.startswith("policy:"):
+                kind = check[len("policy:"):].strip()
+                if kind not in py_cache:
+                    fn = PY_CHECKS.get(kind)
+                    py_cache[kind] = (
+                        fn(repo) if fn else (FAIL, "unknown policy check %r" % kind)
+                    )
+                status, detail = py_cache[kind]
+                statuses.append(status)
+                details.append("policy:%s: %s" % (kind, detail))
+            else:
+                statuses.append(FAIL)
+                details.append("unknown check %r" % check)
+
+        if FAIL in statuses:
+            status = FAIL
+        elif PASS in statuses and all(s == PASS for s in statuses):
+            status = PASS
+        elif INFRA in statuses:
+            status = INFRA
+        else:
+            status = INFRA
+        report[observation_id] = (status, " | ".join(details))
+    return report
+
+
+def write_report(report, path):
+    lines = ['<?xml version="1.0" encoding="UTF-8"?>']
+    failures = sum(1 for status, _ in report.values() if status == FAIL)
+    errors = sum(1 for status, _ in report.values() if status == INFRA)
+    lines.append(
+        '<testsuites tests="{}" failures="{}" errors="{}">'.format(
+            len(report), failures, errors
+        )
+    )
+    lines.append(
+        '<testsuite name="BATCH-F2P-0003" tests="{}" failures="{}" errors="{}">'.format(
+            len(report), failures, errors
+        )
+    )
+    for observation_id in sorted(report):
+        status, detail = report[observation_id]
+        lines.append(
+            '<testcase classname="BATCH-F2P-0003" name="{}">'.format(
+                sax.escape(observation_id)
+            )
+        )
+        if status == FAIL:
+            lines.append(
+                '<failure message="{}"/>'.format(sax.escape(detail[:500]))
+            )
+        elif status == INFRA:
+            lines.append(
+                '<error message="{}"/>'.format(sax.escape(detail[:500]))
+            )
+        lines.append("</testcase>")
+    lines.append("</testsuite></testsuites>")
+
+    directory = os.path.dirname(os.path.abspath(path))
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+    with open(path, "w", encoding="utf-8") as handle:
+        handle.write("\n".join(lines) + "\n")
+
+
+def main(argv, default_side="target"):
+    repo = os.environ.get("MIGRATION_REPO") or os.getcwd()
+    report = None
+    side = default_side
+    args = list(argv)
+    for index, arg in enumerate(args):
+        if arg == "--repo" and index + 1 < len(args):
+            repo = args[index + 1]
+        elif arg == "--report" and index + 1 < len(args):
+            report = args[index + 1]
+        elif arg == "--side" and index + 1 < len(args):
+            side = args[index + 1]
+    positional = [a for a in args if not a.startswith("--")]
+    # Tolerate either "<report>" or "<assets> <report>" invocation styles.
+    if report is None:
+        if positional:
+            report = positional[-1]
+        else:
+            report = "/logs/result.json"
+
+    report_map = evaluate(repo)
+    write_report(report_map, report)
+    failed = any(status == FAIL for status, _ in report_map.values())
+    sys.stderr.write(
+        "BATCH-F2P-0003 %s probe: repo=%s report=%s failed=%s\n"
+        % (side, repo, report, failed)
+    )
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
