+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe.test.ts
@@ -0,0 +1,185 @@
+// Differential source probe for BATCH-DIFFERENTIAL-0001.
+//
+// Consumes the shared case corpus (shared/batches/BATCH-DIFFERENTIAL-0001/cases.json)
+// against the TypeScript implementation in `packages/core/src/utils.ts`. The
+// normalized results are compared with the Rust target probe
+// (`target/batches/BATCH-DIFFERENTIAL-0001/probe.rs`).
+//
+// This probe is authored to run inside the source repository next to the
+// behavioral reference `packages/core/src/tests/utils.test.ts`.
+
+import { describe, expect, it } from "vitest";
+import {
+	createStepMap,
+	getInitialData,
+	getInitialStepIndex,
+	getStepStatus,
+	getStepStatuses,
+	matchStep,
+	parseStep,
+	validateStep,
+} from "../utils";
+
+type ProbeStep =
+	| { id: "first"; label: string }
+	| { id: "second"; label: string }
+	| { id: "third"; label: string };
+
+const steps: ProbeStep[] = [
+	{ id: "first", label: "Step 1" },
+	{ id: "second", label: "Step 2" },
+	{ id: "third", label: "Step 3" },
+];
+
+describe("DIFF-002 createStepMap ids order", () => {
+	it("keeps input order", () => {
+		expect(createStepMap(steps).ids).toEqual(["first", "second", "third"]);
+	});
+});
+
+describe("DIFF-003..008 StepMap queries", () => {
+	const map = createStepMap(steps);
+
+	it("get / at return matching steps or no value", () => {
+		expect(map.get("second")).toEqual({ id: "second", label: "Step 2" });
+		expect(map.get("missing" as never)).toBeUndefined();
+		expect(map.at(0)).toEqual({ id: "first", label: "Step 1" });
+		expect(map.at(9)).toBeUndefined();
+	});
+
+	it("indexOf / has", () => {
+		expect(map.indexOf("third")).toBe(2);
+		expect(map.indexOf("missing" as never)).toBe(-1);
+		expect(map.has("second")).toBe(true);
+		expect(map.has("missing" as never)).toBe(false);
+	});
+
+	it("first / last", () => {
+		expect(map.first()).toEqual({ id: "first", label: "Step 1" });
+		expect(map.last()).toEqual({ id: "third", label: "Step 3" });
+		const empty = createStepMap([] as ProbeStep[]);
+		expect(empty.first()).toBeUndefined();
+		expect(empty.last()).toBeUndefined();
+	});
+
+	it("next / prev / neighbors", () => {
+		expect(map.next("first")).toEqual({ id: "second", label: "Step 2" });
+		expect(map.prev("third")).toEqual({ id: "second", label: "Step 2" });
+		expect(map.next("missing" as never)).toBeUndefined();
+		expect(map.prev("missing" as never)).toBeUndefined();
+		expect(map.neighbors("second")).toEqual({
+			prev: { id: "first", label: "Step 1" },
+			next: { id: "third", label: "Step 3" },
+		});
+		expect(map.neighbors("first")).toEqual({
+			prev: undefined,
+			next: { id: "second", label: "Step 2" },
+		});
+	});
+});
+
+describe("DIFF-009 getInitialStepIndex", () => {
+	it("resolves the initial index or defaults to 0", () => {
+		expect(getInitialStepIndex(steps, "second")).toBe(1);
+		expect(getInitialStepIndex(steps)).toBe(0);
+		expect(getInitialStepIndex(steps, "missing" as never)).toBe(0);
+	});
+});
+
+describe("DIFF-010 parseStep", () => {
+	it("returns known ids only", () => {
+		expect(parseStep(steps, "second")).toBe("second");
+		expect(parseStep(steps, "missing")).toBeUndefined();
+		expect(parseStep(steps, null)).toBeUndefined();
+		expect(parseStep(steps, 42)).toBeUndefined();
+	});
+});
+
+describe("DIFF-011 getInitialData", () => {
+	it("returns a defensive copy", () => {
+		const data = { first: { saved: true } };
+		const copy = getInitialData<ProbeStep[]>(data);
+		expect(copy).toEqual(data);
+		expect(copy).not.toBe(data);
+		const mutated = getInitialData<ProbeStep[]>(data);
+		mutated.second = { anything: true };
+		expect("second" in data).toBe(false);
+	});
+});
+
+describe("DIFF-012..016 validateStep", () => {
+	const schema = {
+		"~standard": {
+			version: 1 as const,
+			vendor: "test",
+			validate: (value: unknown) =>
+				typeof value === "string" && value.length > 0
+					? { value }
+					: { issues: [{ message: "Required" }] },
+		},
+	};
+	const withSchema = [{ id: "name", schema }, { id: "done" }] as const;
+
+	it("passes values through without a schema", async () => {
+		await expect(validateStep(withSchema, "done", { anything: true })).resolves.toEqual({
+			success: true,
+			data: { anything: true },
+		});
+	});
+
+	it("returns the validated value when the schema accepts", async () => {
+		await expect(validateStep(withSchema, "name", "Ada")).resolves.toEqual({
+			success: true,
+			data: "Ada",
+		});
+	});
+
+	it("returns issues when the schema rejects", async () => {
+		const result = await validateStep(withSchema, "name", "");
+		expect(result.success).toBe(false);
+		if (!result.success) expect(result.issues[0].message).toBe("Required");
+	});
+
+	it("fails for an unknown id", async () => {
+		await expect(validateStep(withSchema, "missing" as never, null)).rejects.toThrow(
+			/Step "missing" not found\./,
+		);
+	});
+});
+
+describe("DIFF-017..018 statuses", () => {
+	it("derives positional status", () => {
+		expect(getStepStatus(steps, 1, "first")).toBe("previous");
+		expect(getStepStatus(steps, 1, "second")).toBe("active");
+		expect(getStepStatus(steps, 1, "third")).toBe("upcoming");
+		expect(getStepStatuses(steps, 1)).toEqual({
+			first: "previous",
+			second: "active",
+			third: "upcoming",
+		});
+	});
+});
+
+describe("DIFF-019..021 matchStep", () => {
+	it("dispatches to the registered handler", () => {
+		expect(
+			matchStep(steps, "second", {
+				first: (step) => step.label,
+				second: (step) => step.label,
+				third: (step) => step.label,
+			}),
+		).toBe("Step 2");
+	});
+
+	it("fails for an unknown id", () => {
+		expect(() =>
+			matchStep(steps, "missing" as never, {} as never),
+		).toThrow(/Step "missing" not found\./);
+	});
+
+	it("fails when a step has no handler", () => {
+		expect(() =>
+			matchStep(steps, "third", { first: (step: never) => step } as never),
+		).toThrow(/No match handler found for step "third"\./);
+	});
+});
diff --git a/tests/source/batches/BATCH-F2P-0001/probes/run_source_probe.sh b/tests/source/batches/BATCH-F2P-0001/probes/run_source_probe.sh
new file mode 100755
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0001/probes/run_source_probe.sh
@@ -0,0 +1,62 @@
+#!/bin/sh
+# BATCH-F2P-0001 source-side probe.
+#
+# Uses the *same* semantic predicate as run_target_probe.sh: "the repository
+# exposes a native `stepperize_core` library crate whose eight operations can be
+# imported and invoked". On the frozen TypeScript source the predicate is
+# expected NOT to hold, so this probe reports the source observation as FAIL.
+#
+# The exit status reflects the postcondition itself (1 = not satisfied), never
+# a role-based hardcode: the predicate is executed and its real result is
+# reported. Every cargo invocation is wrapped in an explicit `timeout`.
+
+set -u
+
+SRC="${REPO_ROOT:-/input/source}"
+F2P_TIMEOUT_SECS="${F2P_TIMEOUT_SECS:-1500}"
+
+# The predicate is true only if a native Rust crate is present *and* a Rust
+# consumer can import the eight operations from it.
+if [ ! -f "$SRC/Cargo.toml" ] || [ ! -f "$SRC/crates/stepperize-core/Cargo.toml" ]; then
+  echo "source does not expose a native Rust stepperize_core crate; F2P target postcondition FAIL"
+  exit 1
+fi
+
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/consumer/src"
+cat > "$TMP/consumer/Cargo.toml" <<EOF
+[package]
+name = "f2p-source-consumer"
+version = "0.0.0"
+edition = "2021"
+
+[dependencies]
+stepperize_core = { path = "$SRC/crates/stepperize-core" }
+EOF
+cat > "$TMP/consumer/src/lib.rs" <<'EOF'
+use stepperize_core::{
+    create_step_map, get_initial_data, get_initial_step_index, get_step_status, get_step_statuses,
+    match_step, parse_step, validate_step,
+};
+
+pub fn probe() {
+    let _ = create_step_map(Vec::<()>::new());
+    let _ = get_initial_step_index(&[] as &[()], None);
+    let _ = parse_step(&[] as &[()], &"x");
+    let _ = get_initial_data::<()>(None);
+    let _ = get_step_status(&[] as &[()], 0, "x");
+    let _ = get_step_statuses(&[] as &[()], 0);
+    let _ = match_step(&[] as &[()], "x", &Default::default());
+    let _ = validate_step(&[] as &[()], "x", ());
+}
+EOF
+
+if ( cd "$TMP/consumer" && timeout "$F2P_TIMEOUT_SECS" env CARGO_NET_OFFLINE=true \
+      cargo build --offline >/dev/null 2>&1 ); then
+  echo "source satisfies the Rust target postcondition; F2P predicate PASS"
+  exit 0
+fi
+
+echo "source does not satisfy the Rust target postcondition; F2P predicate FAIL"
+exit 1
diff --git a/tests/source/batches/BATCH-F2P-0002/run_probe.sh b/tests/source/batches/BATCH-F2P-0002/run_probe.sh
new file mode 100755
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0002/run_probe.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Source-side probe harness for BATCH-F2P-0002.
+#
+# Runs the shared semantic predicate against the TypeScript implementation and
+# reports its raw observation. For an F2P batch the source side is expected to
+# FAIL (the target-only postconditions do not hold on the source technology).
+# The command is wrapped in an explicit `timeout` so the harness can never block
+# indefinitely.
+set -u
+
+PROBE="$(dirname "$0")/tests/f2p_0002.probe.ts"
+
+timeout 600 node --experimental-strip-types \
+  --experimental-transform-types "$PROBE"
+status=$?
+
+if [ "$status" -eq 0 ]; then
+  echo "source observation: PASS (target postconditions unexpectedly held)" >&2
+else
+  echo "source observation: FAIL (target postconditions absent, status=$status)" >&2
+fi
+exit "$status"
diff --git a/tests/source/batches/BATCH-F2P-0002/tests/f2p_0002.probe.ts b/tests/source/batches/BATCH-F2P-0002/tests/f2p_0002.probe.ts
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0002/tests/f2p_0002.probe.ts
@@ -0,0 +1,44 @@
+// Source-side probe for BATCH-F2P-0002.
+//
+// F2P observations are target-only postconditions. The *same* semantic
+// predicates that the Rust target probe asserts are asserted here against the
+// TypeScript implementation; each predicate is expected to FAIL on the source
+// technology, which is the required source-side observation for an F2P batch.
+//
+// The module under test is resolved from STEPPERIZE_CORE so the same probe can
+// be pointed at the TypeScript sources of the source repository.
+
+import assert from "node:assert/strict";
+import { createStepMap, getStepStatuses, parseStep, validateStep } from "../../../../../packages/core/src/utils";
+
+const steps = [
+	{ id: "first", label: "Step 1" },
+	{ id: "second", label: "Step 2" },
+	{ id: "third", label: "Step 3" },
+] as const;
+
+// F2P-046 / R038: the migrated status container is an unordered keyed map.
+const statuses = getStepStatuses(steps, 1);
+assert.ok(statuses instanceof Map, "statuses must be a Map, not a plain object");
+
+// F2P-042 / R034: parse_step accepts a boxed dynamic value and rejects
+// non-strings by returning no value.
+assert.equal(parseStep(steps as unknown, 42), undefined);
+assert.equal(parseStep(steps as unknown, "second"), "second");
+
+// F2P-043 / R032: validate_step returns an Err-like Result for an unknown id
+// instead of throwing.
+let threw = false;
+try {
+	await validateStep(steps, "missing" as never, true);
+} catch {
+	threw = true;
+}
+assert.equal(threw, false, "validate_step must return a Result, not throw");
+
+// F2P-038 / R037: index_of returns the signed integer -1 for an unknown id.
+const map = createStepMap(steps);
+assert.equal(map.indexOf("third"), 2);
+assert.equal(map.indexOf("missing" as never), -1);
+
+console.log("source probe satisfied the target postconditions");
