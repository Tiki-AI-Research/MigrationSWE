+#!/bin/sh
+# Target-side probe harness for BATCH-F2P-0002.
+#
+# All potentially long-running commands are wrapped in an explicit `timeout`
+# and run offline against the locked workspace so the harness can never block
+# indefinitely.
+set -eu
+
+REPO="${1:-/workspace/repo}"
+
+# Materialise the batch probe into the crate's integration-test directory.
+mkdir -p "${REPO}/crates/stepperize-core/tests"
+cp "$(dirname "$0")/tests/f2p_0002.rs" "${REPO}/crates/stepperize-core/tests/f2p_0002.rs"
+
+timeout 1500 cargo test \
+  --manifest-path "${REPO}/Cargo.toml" \
+  --workspace --locked --offline --test f2p_0002
