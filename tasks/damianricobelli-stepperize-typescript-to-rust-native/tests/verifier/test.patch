+#!/usr/bin/env python3
+"""Source-side integration entry point.
+
+Invoked by the source runner registry as::
+
+    <assets>/source/runner <report>
+
+It dispatches every dependency batch's executable projection against the source
+repository under evaluation and writes the unified ``migration-observations:v6``
+runtime report.
+"""
+
+import os
+import sys
+
+sys.dont_write_bytecode = True
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ASSETS = os.path.normpath(os.path.join(HERE, ".."))
+SHARED = os.path.join(ASSETS, "shared", "integration")
+if SHARED not in sys.path:
+    sys.path.insert(0, SHARED)
+
+import integration  # noqa: E402
+
+
+if __name__ == "__main__":
+    sys.exit(integration.main(sys.argv[1:], "source"))
