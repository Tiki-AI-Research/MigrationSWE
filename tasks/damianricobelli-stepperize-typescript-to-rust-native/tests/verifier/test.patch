+"""Source-side entry point for BATCH-F2P-0003.
+
+Thin wrapper around the shared probe runner. The shared runner evaluates the
+same semantic predicate used on the target side; the source repository provides
+no Rust crate, so the target postconditions do not hold and each observation
+resolves to FAIL.
+"""
+
+import os
+import sys
+
+sys.dont_write_bytecode = True
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+SHARED = os.path.normpath(
+    os.path.join(HERE, "..", "..", "..", "shared", "batches", "BATCH-F2P-0003")
+)
+if SHARED not in sys.path:
+    sys.path.insert(0, SHARED)
