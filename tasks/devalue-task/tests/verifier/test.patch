index 0000000..07fb3a7
--- /dev/null
+++ b/tests/assets/shared/batches/BATCH-F2P-0002/run.mjs
@@ -0,0 +1,191 @@
+/**
+ * Public type-surface gates.
+ *
+ * The migrated package must ship TypeScript declarations for the 6.0.0 public
+ * API, reachable through its own package entry when a consumer imports
+ * `devalue`.  Each fixture is compiled by the evaluator-owned TypeScript
+ * against a throw-away consumer package that resolves `devalue` to the
+ * candidate root, so a fixture can only type-check when the candidate's
+ * declared entry actually exports the required names with the required shape.
+ *
+ * A missing or unusable TypeScript toolchain, a timeout or an unparsable
+ * declaration surface is an ordinary gate failure.  It must never be reported
+ * as an infrastructure error, because the type surface is candidate evidence.
+ */
+import { spawnSync } from 'node:child_process';
+import {
+	existsSync,
+	mkdirSync,
+	mkdtempSync,
+	readFileSync,
+	rmSync,
+	symlinkSync,
+	writeFileSync
+} from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const FIXTURES = join(dirname(fileURLToPath(import.meta.url)), 'type-surface');
+
+export const TYPE_GATES = Object.freeze({
+	'F2P-030': 'g1.ts',
+	'F2P-031': 'g2.ts',
+	'F2P-032': 'g3.ts',
+	'F2P-033': 'g4.ts',
+	'F2P-034': 'g5.ts',
+	'F2P-035': 'g6.ts'
+});
+
+const FIXTURE_FILES = Object.values(TYPE_GATES);
+const EVALUATOR_NODE_MODULES = '/opt/migration/dependencies/node_modules';
+const TYPESCRIPT_TIMEOUT_MS = 120000;
+
+function unavailable(reason) {
+	return Object.fromEntries(
+		FIXTURE_FILES.map((file) => [
+			file,
+			{
+				ok: false,
+				checks: {
+					fixture: file,
+					typescript: false,
+					reason
+				}
+			}
+		])
+	);
+}
+
+function locateTypeScript(repoRoot) {
+	const directories = [
+		process.env.MIGRATION_EVALUATOR_NODE_MODULES,
+		EVALUATOR_NODE_MODULES,
+		join(repoRoot, 'node_modules')
+	];
+	for (const directory of directories) {
+		if (!directory) continue;
+		const candidate = join(directory, 'typescript', 'bin', 'tsc');
+		if (existsSync(candidate)) return candidate;
+	}
+	return null;
+}
+
+function evaluate(repoRoot) {
+	const typescript = locateTypeScript(repoRoot);
+	if (!typescript) return unavailable('typescript-unavailable');
+	if (!existsSync(join(repoRoot, 'package.json'))) {
+		return unavailable('package-entry-unavailable');
+	}
+
+	let directory;
+	try {
+		directory = mkdtempSync(join(tmpdir(), 'devalue-type-surface-'));
+	} catch {
+		return unavailable('temporary-directory-unavailable');
+	}
+
+	try {
+		for (const file of [...FIXTURE_FILES, 'tsconfig.json']) {
+			writeFileSync(
+				join(directory, file),
+				readFileSync(join(FIXTURES, file), 'utf8'),
+				'utf8'
+			);
+		}
+		mkdirSync(join(directory, 'node_modules'), { recursive: true });
+		symlinkSync(repoRoot, join(directory, 'node_modules', 'devalue'), 'dir');
+
+		const completed = spawnSync(
+			process.execPath,
+			[typescript, '-p', join(directory, 'tsconfig.json')],
+			{
+				cwd: directory,
+				encoding: 'utf8',
+				errors: 'replace',
+				timeout: TYPESCRIPT_TIMEOUT_MS,
+				maxBuffer: 16 * 1024 * 1024,
+				env: {
+					...process.env,
+					NODE_OPTIONS: '',
+					NO_COLOR: '1',
+					FORCE_COLOR: '0'
+				}
+			}
+		);
+		if (completed.error || completed.signal) {
+			return unavailable('typescript-execution-failed');
+		}
+
+		const output = `${completed.stdout ?? ''}\n${completed.stderr ?? ''}`;
+		const diagnostics = new Map(FIXTURE_FILES.map((file) => [file, 0]));
+		let external = 0;
+		for (const line of output.split(/\r?\n/)) {
+			const located = /^(.+?)\((\d+),(\d+)\):\s+(?:error|warning)\s+TS\d+:/.exec(
+				line
+			);
+			if (located) {
+				const file = located[1].replace(/\\/g, '/').split('/').pop();
+				if (diagnostics.has(file)) {
+					diagnostics.set(file, diagnostics.get(file) + 1);
+				} else {
+					external += 1;
+				}
+				continue;
+			}
+			// A diagnostic without a source location means the consumer project
+			// itself could not be compiled (bad config, unreadable declaration
+			// entry, missing package).  That invalidates every fixture.
+			if (/^\s*(?:error|warning)\s+TS\d+:/.test(line)) {
+				external += 1;
+			}
+		}
+
+		const failed = completed.status !== 0;
+		return Object.fromEntries(
+			FIXTURE_FILES.map((file) => [
+				file,
+				{
+					ok: !failed || (external === 0 && diagnostics.get(file) === 0),
+					checks: {
+						fixture: file,
+						typescript: true,
+						exit_code: completed.status,
+						diagnostics: diagnostics.get(file),
+						external_diagnostics: external
+					}
+				}
+			])
+		);
+	} catch {
+		return unavailable('type-surface-evaluation-failed');
+	} finally {
+		rmSync(directory, { recursive: true, force: true });
+	}
+}
+
+let cache = null;
+
+/**
+ * Return the verdict for one type-surface gate.  All fixtures share one
+ * compiler run; the result is cached for the lifetime of the harness process.
+ */
+export function typeSurfaceGate(repoRoot, identifier) {
+	const root = String(repoRoot ?? '');
+	if (!cache || cache.root !== root) {
+		cache = { root, results: evaluate(root) };
+	}
+	const file = TYPE_GATES[identifier];
+	const result = file ? cache.results[file] : null;
+	if (!result) {
+		return {
+			ok: false,
+			outcomes: {
+				fixture: file ?? null,
+				typescript: false,
+				reason: 'unknown-type-surface-gate'
+			}
+		};
+	}
+	return { ok: result.ok, outcomes: result.checks };
+}
