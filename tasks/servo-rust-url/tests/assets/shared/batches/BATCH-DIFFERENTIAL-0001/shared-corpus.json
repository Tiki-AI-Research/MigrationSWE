    {
      "observation_id": "DIFF-001",
      "requirement_ids": ["R003"],
      "family": "shared-case-corpus",
      "surface": "url.Parse and URL component accessors (AsStr, Scheme, Username, Password, HostStr, Host, Port, Path, PathSegments, Query, Fragment, CannotBeABase)",
      "input": "https://github.com/rust-lang/rust/issues?labels=E-easy&state=open",
      "expected": {
        "AsStr": "https://github.com/rust-lang/rust/issues?labels=E-easy&state=open",
        "Scheme": "https",
        "Username": "",
        "Password": {"value": "", "present": false},
        "HostStr": {"value": "github.com", "present": true},
        "HostKind": "HostDomain",
        "Port": {"value": 0, "present": false},
        "Path": "/rust-lang/rust/issues",
        "PathSegments": {"value": ["rust-lang", "rust", "issues"], "ok": true},
        "Query": {"value": "labels=E-easy&state=open", "present": true},
        "Fragment": {"value": "", "present": false},
        "CannotBeABase": false
      }
    },
    {
      "observation_id": "DIFF-002",
      "requirement_ids": ["R004"],
      "family": "shared-case-corpus",
      "surface": "url.Parse and URL accessors for cannot-be-a-base schemes",
      "input": "data:text/plain,Hello?World#",
      "expected": {
        "CannotBeABase": true,
        "Scheme": "data",
        "Path": "text/plain,Hello",
        "PathSegments": {"ok": false},
        "HasHost": false,
        "Query": {"value": "World", "present": true},
        "Fragment": {"value": "", "present": true},
        "AsStr": "data:text/plain,Hello?World#"
      }
    },
    {
      "observation_id": "DIFF-003",
      "requirement_ids": ["R005"],
      "family": "shared-case-corpus",
      "surface": "url.Parse invalid-IPv6 error identity",
      "input": "http://[:::1]",
      "expected": {
        "ParseError": true,
        "ErrorsIsErrInvalidIPv6Address": true,
        "ErrorsIsErrInvalidPort": false
      }
    },
    {
      "observation_id": "DIFF-004",
      "requirement_ids": ["R006"],
