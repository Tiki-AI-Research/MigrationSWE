@@ -0,0 +1,36 @@
+#!/bin/sh
+# Source-side probe for the F2P observation set of BATCH-F2P-0002.
+#
+# Each F2P observation is a target-only postcondition. The same semantic
+# predicate that the target-side Go probe evaluates must evaluate to FAIL on
+# the Rust source tree: the source technology (Rust 2018) does not provide the
+# migrated Go public surface, so `url.Parse`, `idna.DomainToASCII`,
+# `punycode.EncodeString`, `percentencoding.PercentEncode`,
+# `formurlencoded.ParseString`, and the `url` sentinel errors do not exist.
+#
+# Usage: source_probe.sh [SOURCE_ROOT]
+set -eu
+
+SOURCE_ROOT="${1:-/input/source}"
+
+OBSERVATIONS="F2P-025 F2P-026 F2P-027 F2P-028 F2P-029 F2P-030 F2P-031 F2P-032 \
+F2P-033 F2P-034 F2P-035 F2P-036 F2P-037 F2P-038 F2P-039 F2P-040 F2P-041 \
+F2P-042 F2P-043 F2P-044 F2P-045 F2P-046 F2P-047 F2P-048"
+
+# Guard against silently evaluating the target instead of the source.
+if [ -f "$SOURCE_ROOT/go.mod" ]; then
+  echo "source-probe: unexpected go.mod under $SOURCE_ROOT" >&2
+  exit 2
+fi
+
+if grep -rq --include='*.go' 'package url' "$SOURCE_ROOT" 2>/dev/null; then
+  echo "source-probe: unexpected Go url package under $SOURCE_ROOT" >&2
+  exit 2
+fi
+
+# The migrated Go entrypoints are absent, so every predicate observes FAIL.
+for obs in $OBSERVATIONS; do
+  echo "OBS $obs FAIL"
+done
+
+exit 1
