+	}
+	m, err := u.PathSegmentsMut()
+	if err != nil {
+		t.Fatalf("mut: %v", err)
+	}
+	m.Pop().Push("2/100%.png")
+	if got := u.Path(); got != "/b/2%2F100%25.png" {
+		t.Fatalf("Path=%q", got)
+	}
+	if q, ok := u.Query(); q != "q" || !ok {
+		t.Fatalf("Query=%q,%v", q, ok)
+	}
+	if f, ok := u.Fragment(); f != "frag" || !ok {
+		t.Fatalf("Fragment=%q,%v", f, ok)
+	}
