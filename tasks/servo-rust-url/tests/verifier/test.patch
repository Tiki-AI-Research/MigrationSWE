+#!/usr/bin/env python3
+"""Source-side integration entrypoint (owned by BATCH-INTEGRATION-0001).
+
+Usage: source/runner <report-path> [repo-root]
+
+Evaluates every required observation against the Rust source technology and
+writes a ``migration-observations:v6`` report. P2P/DIFFERENTIAL observations are
+evaluated by running the Rust crates natively when a toolchain is available;
+F2P postconditions are target-only and are observed FAIL on the source side (the
+target Go technology is genuinely absent there).
+"""
+
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(ROOT, "shared", "integration"))
+
+import harness  # noqa: E402
+
+
+def main():
+    if len(sys.argv) < 2:
+        sys.stderr.write("usage: source/runner <report-path> [repo-root]\n")
+        return 2
+    report_path = sys.argv[1]
+    repo_root = sys.argv[2] if len(sys.argv) > 2 else None
+    harness.run_report("source", os.path.abspath(__file__), report_path, repo_root)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
