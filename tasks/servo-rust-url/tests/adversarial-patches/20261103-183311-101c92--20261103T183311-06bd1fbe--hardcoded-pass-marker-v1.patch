diff --git a/formurlencoded/formurlencoded.go b/formurlencoded/formurlencoded.go
new file mode 100644
index 0000000..337a96c
--- /dev/null
+++ b/formurlencoded/formurlencoded.go
@@ -0,0 +1,186 @@
+package formurlencoded
+
+import (
+	"github.com/servo/rust-url/percentencoding"
+)
+
+// Parser iterates over (name, value) pairs decoded from
+// application/x-www-form-urlencoded input.
+type Parser struct {
+	input []byte
+}
+
+// Parse returns a Parser over the given bytes.
+func Parse(input []byte) *Parser {
+	return &Parser{input: input}
+}
+
+// ParseString returns a Parser over the given string.
+func ParseString(input string) *Parser {
+	return &Parser{input: []byte(input)}
+}
+
+// Next returns the next name/value pair. ok is false when exhausted.
+func (p *Parser) Next() (name string, value string, ok bool) {
+	for {
+		if len(p.input) == 0 {
+			return "", "", false
+		}
+		var sequence []byte
+		if i := indexByte(p.input, '&'); i >= 0 {
+			sequence = p.input[:i]
+			p.input = p.input[i+1:]
+		} else {
+			sequence = p.input
+			p.input = nil
+		}
+		if len(sequence) == 0 {
+			continue
+		}
+		nameB := sequence
+		valueB := []byte{}
+		if i := indexByte(sequence, '='); i >= 0 {
+			nameB = sequence[:i]
+			valueB = sequence[i+1:]
+		}
+		return decode(nameB), decode(valueB), true
+	}
+}
+
+func indexByte(b []byte, c byte) int {
+	for i, x := range b {
+		if x == c {
+			return i
+		}
+	}
+	return -1
+}
+
+func decode(input []byte) string {
+	replaced := replacePlus(input)
+	return percentencoding.Decode(replaced).DecodeUTF8Lossy()
+}
+
+func replacePlus(input []byte) []byte {
+	first := -1
+	for i, b := range input {
+		if b == '+' {
+			first = i
+			break
+		}
+	}
+	if first < 0 {
+		return input
+	}
+	replaced := make([]byte, len(input))
+	copy(replaced, input)
+	for i := first; i < len(replaced); i++ {
+		if replaced[i] == '+' {
+			replaced[i] = ' '
+		}
+	}
+	return replaced
+}
+
+// ByteSerialize serializes bytes per the application/x-www-form-urlencoded byte
+// serializer.
+func ByteSerialize(input []byte) string {
+	n := 0
+	for _, b := range input {
+		if byteSerializedUnchanged(b) {
+			n++
+		} else {
+			n += 3
+		}
+	}
+	out := make([]byte, 0, n)
+	for _, b := range input {
+		if byteSerializedUnchanged(b) {
+			out = append(out, b)
+		} else if b == ' ' {
+			out = append(out, '+')
+		} else {
+			out = append(out, percentencoding.PercentEncodeByte(b)...)
+		}
+	}
+	return string(out)
+}
+
+func byteSerializedUnchanged(b byte) bool {
+	switch {
+	case b == '*' || b == '-' || b == '.' || b == '_':
+		return true
+	case b >= '0' && b <= '9':
+		return true
+	case b >= 'A' && b <= 'Z':
+		return true
+	case b >= 'a' && b <= 'z':
+		return true
+	}
+	return false
+}
+
+// Serializer writes application/x-www-form-urlencoded pairs into a target
+// string.
+type Serializer struct {
+	target        *string
+	startPosition int
+	finished      bool
+}
+
+// NewSerializer creates a serializer writing into target. Any existing content
+// is assumed to already be in application/x-www-form-urlencoded syntax, so
+// appended pairs are separated from it with '&'.
+func NewSerializer(target *string) *Serializer {
+	return &Serializer{target: target}
+}
+
+// Clear removes all pairs appended by this serializer (since its start).
+func (s *Serializer) Clear() *Serializer {
+	*s.target = (*s.target)[:s.startPosition]
+	return s
+}
+
+func (s *Serializer) appendSeparatorIfNeeded() {
+	if len(*s.target) > s.startPosition {
+		*s.target += "&"
+	}
+}
+
+// AppendPair serializes and appends a name/value pair.
+func (s *Serializer) AppendPair(name, value string) *Serializer {
+	s.appendSeparatorIfNeeded()
+	*s.target += ByteSerialize([]byte(name))
+	*s.target += "="
+	*s.target += ByteSerialize([]byte(value))
+	return s
+}
+
+// AppendKeyOnly serializes and appends a name without a value.
+func (s *Serializer) AppendKeyOnly(name string) *Serializer {
+	s.appendSeparatorIfNeeded()
+	*s.target += ByteSerialize([]byte(name))
+	return s
+}
+
+// ExtendPairs appends each pair.
+func (s *Serializer) ExtendPairs(pairs [][2]string) *Serializer {
+	for _, p := range pairs {
+		s.AppendPair(p[0], p[1])
+	}
+	return s
+}
+
+// ExtendKeysOnly appends each key without a value.
+func (s *Serializer) ExtendKeysOnly(keys []string) *Serializer {
+	for _, k := range keys {
+		s.AppendKeyOnly(k)
+	}
+	return s
+}
+
+// Finish returns the serialized target.
+func (s *Serializer) Finish() string {
+	s.finished = true
+	return *s.target
+}
diff --git a/formurlencoded/formurlencoded_test.go b/formurlencoded/formurlencoded_test.go
new file mode 100644
index 0000000..47eb3e2
--- /dev/null
+++ b/formurlencoded/formurlencoded_test.go
@@ -0,0 +1,91 @@
+package formurlencoded
+
+import "testing"
+
+func TestParse(t *testing.T) {
+	p := ParseString("foo=bar&baz")
+	n, v, ok := p.Next()
+	if !ok || n != "foo" || v != "bar" {
+		t.Errorf("pair1 = (%q,%q,%v)", n, v, ok)
+	}
+	n, v, ok = p.Next()
+	if !ok || n != "baz" || v != "" {
+		t.Errorf("pair2 = (%q,%q,%v)", n, v, ok)
+	}
+	if _, _, ok := p.Next(); ok {
+		t.Errorf("expected exhaustion")
+	}
+
+	p = ParseString("%23first=%25try%25")
+	n, v, ok = p.Next()
+	if !ok || n != "#first" || v != "%try%" {
+		t.Errorf("decoded pair = (%q,%q,%v)", n, v, ok)
+	}
+
+	p = ParseString("a+b=c+d")
+	n, v, ok = p.Next()
+	if !ok || n != "a b" || v != "c d" {
+		t.Errorf("plus pair = (%q,%q,%v)", n, v, ok)
+	}
+
+	p = Parse([]byte("&&foo=1&&bar=2&"))
+	names := []string{}
+	for {
+		n, _, ok := p.Next()
+		if !ok {
+			break
+		}
+		names = append(names, n)
+	}
+	if len(names) != 2 || names[0] != "foo" || names[1] != "bar" {
+		t.Errorf("names = %v", names)
+	}
+}
+
+func TestByteSerialize(t *testing.T) {
+	if got := ByteSerialize([]byte("foo bar")); got != "foo+bar" {
+		t.Errorf("ByteSerialize = %q", got)
+	}
+	if got := ByteSerialize([]byte("a&b=c")); got != "a%26b%3Dc" {
+		t.Errorf("ByteSerialize = %q", got)
+	}
+}
+
+func TestSerializer(t *testing.T) {
+	var target string
+	s := NewSerializer(&target)
+	s.AppendPair("foo", "bar & baz").AppendPair("saison", "\u00C9t\u00E9+hiver")
+	if s.Finish() != "foo=bar+%26+baz&saison=%C3%89t%C3%A9%2Bhiver" {
+		t.Errorf("finish = %q", target)
+	}
+
+	target = "existing=1"
+	s = NewSerializer(&target)
+	s.AppendPair("a", "b")
+	if target != "existing=1&a=b" {
+		t.Errorf("append existing = %q", target)
+	}
+
+	target = ""
+	s = NewSerializer(&target)
+	s.AppendKeyOnly("k1").AppendKeyOnly("k2")
+	if target != "k1&k2" {
+		t.Errorf("key only = %q", target)
+	}
+
+	target = "x=1"
+	s = NewSerializer(&target)
+	s.AppendPair("y", "2")
+	s.Clear()
+	s.AppendPair("z", "3")
+	if target != "z=3" {
+		t.Errorf("clear = %q", target)
+	}
+
+	target = ""
+	s = NewSerializer(&target)
+	s.ExtendPairs([][2]string{{"a", "1"}, {"b", "2"}}).ExtendKeysOnly([]string{"c", "d"})
+	if target != "a=1&b=2&c&d" {
+		t.Errorf("extend = %q", target)
+	}
+}
