@@ -0,0 +1,105 @@
+// Package idna implements IDNA per the WHATWG URL Standard, exposing the
+// UTS #46 ToASCII/ToUnicode operations.
+package idna
+
+import (
+	"errors"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/servo/rust-url/internal/idnaproc"
+)
+
+// ErrInvalidDomain is returned for input rejected by UTS #46 processing.
+var ErrInvalidDomain error = errors.New("invalid domain")
+
+func asciiProfile() *idnaproc.Profile {
+	return idnaproc.New(
+		idnaproc.MapForLookup(),
+		idnaproc.StrictDomainName(false),
+		idnaproc.CheckHyphens(false),
+		idnaproc.Transitional(false),
+		idnaproc.BidiRule(),
+	)
+}
+
+func strictProfile() *idnaproc.Profile {
+	return idnaproc.New(
+		idnaproc.MapForLookup(),
+		idnaproc.StrictDomainName(true),
+		idnaproc.CheckHyphens(true),
+		idnaproc.VerifyDNSLength(true),
+		idnaproc.Transitional(false),
+		idnaproc.BidiRule(),
+	)
+}
+
+func unicodeProfile() *idnaproc.Profile {
+	return idnaproc.New(
+		idnaproc.MapForLookup(),
+		idnaproc.StrictDomainName(false),
+		idnaproc.CheckHyphens(false),
+		idnaproc.Transitional(false),
+		idnaproc.BidiRule(),
+	)
+}
+
+// DomainToASCII is the domain to ASCII algorithm with no ASCII deny list,
+// hyphens allowed, and DNS length ignored.
+func DomainToASCII(domain string) (string, error) {
+	out, err := asciiProfile().ToASCII(domain)
+	if err != nil {
+		return out, ErrInvalidDomain
+	}
+	return out, nil
+}
+
+// DomainToASCIIStrict is the domain to ASCII algorithm with the STD3 deny list,
+// hyphen checking, and DNS-length verification.
+func DomainToASCIIStrict(domain string) (string, error) {
+	out, err := strictProfile().ToASCII(domain)
+	if err != nil {
+		return out, ErrInvalidDomain
+	}
+	return out, nil
+}
+
+// DomainToUnicode is the domain to Unicode algorithm. The returned string is
+// meaningful even when the error is non-nil.
+func DomainToUnicode(domain string) (string, error) {
+	out, err := unicodeProfile().ToUnicode(domain)
+	if err != nil {
+		return out, ErrInvalidDomain
+	}
+	return out, nil
+}
+
+const urlDenyList = "%#/:<>?@[\\]^|"
+
+func urlDenied(c rune) bool {
+	if c >= 0x80 {
+		return false
+	}
+	if c <= 0x20 || c == 0x7F {
+		return true
+	}
+	return strings.ContainsRune(urlDenyList, c)
+}
+
+// DomainToASCIIURL is the domain to ASCII algorithm with the WHATWG URL
+// Standard forbidden-domain-code-point deny list applied.
+func DomainToASCIIURL(domain []byte) (string, error) {
+	if !utf8.Valid(domain) {
+		return "", ErrInvalidDomain
+	}
+	out, err := asciiProfile().ToASCII(string(domain))
+	if err != nil {
+		return out, ErrInvalidDomain
+	}
+	for _, c := range out {
+		if urlDenied(c) {
+			return out, ErrInvalidDomain
+		}
+	}
+	return out, nil
+}
diff --git a/idna/idna_test.go b/idna/idna_test.go
new file mode 100644
index 0000000..2f53551
--- /dev/null
+++ b/idna/idna_test.go
@@ -0,0 +1,241 @@
+package idna
+
+import (
+	"bufio"
+	"encoding/json"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/servo/rust-url/idna/punycode"
+	"github.com/servo/rust-url/internal/idnaproc"
+)
+
+func TestDomainToASCII(t *testing.T) {
+	cases := []struct {
+		in, want string
+	}{
+		{"GOOGLE.COM", "google.com"},
+		{"m\u00fcnchen.de", "xn--mnchen-3ya.de"},
+		{"\u4f8b\u3048.jp", "xn--r8jz45g.jp"},
+		{"example.com.", "example.com."},
+	}
+	for _, c := range cases {
+		got, err := DomainToASCII(c.in)
+		if err != nil {
+			t.Errorf("DomainToASCII(%q) error: %v", c.in, err)
+			continue
+		}
+		if got != c.want {
+			t.Errorf("DomainToASCII(%q) = %q, want %q", c.in, got, c.want)
+		}
+	}
+	if _, err := DomainToASCII("\u0080"); err != ErrInvalidDomain {
+		t.Errorf("expected ErrInvalidDomain, got %v", err)
+	}
+}
+
+func TestDomainToASCIIStrict(t *testing.T) {
+	if _, err := DomainToASCIIStrict("has_underscore.com"); err != ErrInvalidDomain {
+		t.Errorf("expected ErrInvalidDomain for underscore, got %v", err)
+	}
+	if _, err := DomainToASCIIStrict("xn--a.com"); err != ErrInvalidDomain {
+		t.Errorf("expected ErrInvalidDomain for invalid punycode, got %v", err)
+	}
+	got, err := DomainToASCIIStrict("example.com")
+	if err != nil || got != "example.com" {
+		t.Errorf("DomainToASCIIStrict = %q, %v", got, err)
+	}
+}
+
+func TestDomainToUnicode(t *testing.T) {
+	got, err := DomainToUnicode("xn--mnchen-3ya.de")
+	if err != nil {
+		t.Errorf("DomainToUnicode error: %v", err)
+	}
+	if got != "m\u00fcnchen.de" {
+		t.Errorf("DomainToUnicode = %q", got)
+	}
+	// Meaningful output even on error.
+	out, err := DomainToUnicode("\u0080")
+	if err == nil {
+		t.Errorf("expected error")
+	}
+	if out == "" {
+		t.Errorf("expected non-empty replacement output")
+	}
+}
+
+func unescapeIdna(s string) string {
+	var out strings.Builder
+	rs := []rune(s)
+	for i := 0; i < len(rs); i++ {
+		if rs[i] == '\\' && i+1 < len(rs) {
+			if rs[i+1] == '\\' {
+				out.WriteRune('\\')
+				i++
+				continue
+			}
+			if rs[i+1] == 'u' && i+5 < len(rs) {
+				v, err := strconv.ParseUint(string(rs[i+2:i+6]), 16, 32)
+				if err == nil {
+					out.WriteRune(rune(v))
+					i += 5
+					continue
+				}
+			}
+		}
+		out.WriteRune(rs[i])
+	}
+	return out.String()
+}
+
+func idnaStatus(s string) []string {
+	if s == "" || s == "[]" {
+		return nil
+	}
+	s = strings.TrimPrefix(s, "[")
+	s = strings.TrimSuffix(s, "]")
+	if s == "" {
+		return nil
+	}
+	return strings.Split(s, ", ")
+}
+
+func TestIdnaTestV2(t *testing.T) {
+	f, err := os.Open("tests/IdnaTestV2.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	strict := idnaproc.New(idnaproc.MapForLookup(), idnaproc.StrictDomainName(true), idnaproc.CheckHyphens(true), idnaproc.VerifyDNSLength(true), idnaproc.Transitional(false), idnaproc.BidiRule())
+	uni := idnaproc.New(idnaproc.MapForLookup(), idnaproc.StrictDomainName(true), idnaproc.CheckHyphens(true), idnaproc.Transitional(false), idnaproc.BidiRule())
+	scanner := bufio.NewScanner(f)
+	scanner.Buffer(make([]byte, 1024*1024), 1024*1024)
+	lineNo := 0
+	total := 0
+	for scanner.Scan() {
+		lineNo++
+		line := scanner.Text()
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		if i := strings.IndexByte(line, '#'); i >= 0 {
+			line = line[:i]
+		}
+		pieces := strings.Split(line, ";")
+		for i := range pieces {
+			pieces[i] = strings.TrimSpace(pieces[i])
+		}
+		if len(pieces) < 5 {
+			t.Fatalf("line %d: too few pieces", lineNo)
+		}
+		source := unescapeIdna(pieces[0])
+		toUnicode := unescapeIdna(pieces[1])
+		if toUnicode == "" {
+			toUnicode = source
+		}
+		toUnicodeStatus := idnaStatus(pieces[2])
+		toAscii := pieces[3]
+		if toAscii == "" {
+			toAscii = toUnicode
+		}
+		toAsciiStatus := pieces[4]
+		if toAsciiStatus == "" {
+			toAsciiStatus = pieces[2]
+		}
+		asciiStatus := idnaStatus(toAsciiStatus)
+		total++
+
+		// toASCII
+		gotA, errA := strict.ToASCII(source)
+		if len(asciiStatus) > 0 {
+			if errA == nil {
+				t.Errorf("line %d: source %q expected toASCII error %v, got %q", lineNo, source, asciiStatus, gotA)
+			}
+		} else {
+			if errA != nil {
+				t.Errorf("line %d: source %q expected %q, got error %v", lineNo, source, toAscii, errA)
+			} else if gotA != toAscii {
+				t.Errorf("line %d: source %q toASCII got %q want %q", lineNo, source, gotA, toAscii)
+			}
+		}
+
+		// toUnicode
+		ignore := false
+		for _, s := range toUnicodeStatus {
+			if s != "X4_2" {
+				ignore = false
+				goto checked
+			}
+		}
+		ignore = len(toUnicodeStatus) > 0
+	checked:
+		if len(toUnicodeStatus) > 0 && ignore {
+			continue
+		}
+		gotU, errU := uni.ToUnicode(source)
+		if len(toUnicodeStatus) > 0 {
+			if errU == nil {
+				t.Errorf("line %d: source %q expected toUnicode error %v, got %q", lineNo, source, toUnicodeStatus, gotU)
+			}
+		} else {
+			if errU != nil {
+				t.Errorf("line %d: source %q expected %q, got error %v", lineNo, source, toUnicode, errU)
+			} else if gotU != toUnicode {
+				t.Errorf("line %d: source %q toUnicode got %q want %q", lineNo, source, gotU, toUnicode)
+			}
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		t.Fatal(err)
+	}
+	if total == 0 {
+		t.Fatal("no test cases")
+	}
+}
+
+func TestPunycodeVectors(t *testing.T) {
+	data, err := os.ReadFile("tests/punycode_tests.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var tests []map[string]string
+	if err := json.Unmarshal(data, &tests); err != nil {
+		t.Fatal(err)
+	}
+	for i, tc := range tests {
+		decoded := tc["decoded"]
+		encoded := tc["encoded"]
+		got, ok := punycode.EncodeString(decoded)
+		if !ok || got != encoded {
+			t.Errorf("case %d: EncodeString(%q) = %q,%v want %q", i, decoded, got, ok, encoded)
+		}
+		runes, ok := punycode.Decode(encoded)
+		if !ok || string(runes) != decoded {
+			t.Errorf("case %d: Decode(%q) = %q,%v want %q", i, encoded, string(runes), ok, decoded)
+		}
+		gotStr, ok := punycode.DecodeToString(encoded)
+		if !ok || gotStr != decoded {
+			t.Errorf("case %d: DecodeToString(%q) = %q,%v want %q", i, encoded, gotStr, ok, decoded)
+		}
+	}
+}
+
+func TestBadPunycode(t *testing.T) {
+	data, err := os.ReadFile("tests/bad_punycode_tests.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var tests []map[string]string
+	if err := json.Unmarshal(data, &tests); err != nil {
+		t.Fatal(err)
+	}
+	for i, tc := range tests {
+		decoded := tc["decoded"]
+		if got, ok := punycode.EncodeString(decoded); ok {
+			t.Errorf("case %d: expected failure, got %q", i, got)
+		}
+	}
+}
diff --git a/idna/punycode/punycode.go b/idna/punycode/punycode.go
new file mode 100644
index 0000000..2c73697
--- /dev/null
+++ b/idna/punycode/punycode.go
@@ -0,0 +1,278 @@
+// Package punycode implements RFC 3492 Punycode encoding and decoding.
+package punycode
+
+import "math"
+
+const (
+	base        = 36
+	tmin        = 1
+	tmax        = 26
+	skew        = 38
+	damp        = 700
+	initialBias = 72
+	initialN    = 0x80
+)
+
+func adapt(delta, numPoints uint32, firstTime bool) uint32 {
+	if firstTime {
+		delta /= damp
+	} else {
+		delta /= 2
+	}
+	delta += delta / numPoints
+	k := uint32(0)
+	for delta > ((base-tmin)*tmax)/2 {
+		delta /= base - tmin
+		k += base
+	}
+	return k + (((base - tmin + 1) * delta) / (delta + skew))
+}
+
+func digitOf(b byte) (uint32, bool) {
+	switch {
+	case b >= '0' && b <= '9':
+		return uint32(b-'0') + 26, true
+	case b >= 'A' && b <= 'Z':
+		return uint32(b - 'A'), true
+	case b >= 'a' && b <= 'z':
+		return uint32(b - 'a'), true
+	}
+	return 0, false
+}
+
+func valueToDigit(value uint32) byte {
+	if value <= 25 {
+		return byte(value) + 'a'
+	}
+	return byte(value-26) + '0'
+}
+
+// Encode converts the given runes to Punycode. The boolean reports success;
+// it is false on overflow.
+func Encode(input []rune) (string, bool) {
+	if uint64(len(input)) > math.MaxUint32 {
+		return "", false
+	}
+	var out []byte
+	var inputLength uint32
+	basicLength := 0
+	for _, c := range input {
+		inputLength++
+		if c < 0x80 {
+			out = append(out, byte(c))
+			basicLength++
+		}
+	}
+	if basicLength > 0 {
+		out = append(out, '-')
+	}
+	codePoint := uint32(initialN)
+	delta := uint32(0)
+	bias := uint32(initialBias)
+	processed := uint32(basicLength)
+	for processed < inputLength {
+		minCodePoint := uint32(math.MaxUint32)
+		for _, c := range input {
+			cp := uint32(c)
+			if cp >= codePoint && cp < minCodePoint {
+				minCodePoint = cp
+			}
+		}
+		product := (minCodePoint - codePoint)
+		if product != 0 && processed+1 != 0 && product > math.MaxUint32/(processed+1) {
+			return "", false
+		}
+		product *= processed + 1
+		if delta > math.MaxUint32-product {
+			return "", false
+		}
+		delta += product
+		codePoint = minCodePoint
+		for _, c := range input {
+			cp := uint32(c)
+			if cp < codePoint {
+				if delta == math.MaxUint32 {
+					return "", false
+				}
+				delta++
+			}
+			if cp == codePoint {
+				q := delta
+				k := uint32(base)
+				for {
+					var t uint32
+					if k <= bias {
+						t = tmin
+					} else if k >= bias+tmax {
+						t = tmax
+					} else {
+						t = k - bias
+					}
+					if q < t {
+						break
+					}
+					value := t + ((q - t) % (base - t))
+					out = append(out, valueToDigit(value))
+					q = (q - t) / (base - t)
+					k += base
+				}
+				out = append(out, valueToDigit(q))
+				bias = adapt(delta, processed+1, processed == uint32(basicLength))
+				delta = 0
+				processed++
+			}
+		}
+		if delta == math.MaxUint32 {
+			return "", false
+		}
+		delta++
+		codePoint++
+	}
+	return string(out), true
+}
+
+// EncodeString converts the given string to Punycode.
+func EncodeString(input string) (string, bool) {
+	return Encode([]rune(input))
+}
+
+type insertion struct {
+	idx int
+	c   rune
+}
+
+// Decode converts Punycode to runes. The boolean reports success; it is false
+// on malformed input or overflow.
+func Decode(input string) ([]rune, bool) {
+	data := []byte(input)
+	position := -1
+	for i := len(data) - 1; i >= 0; i-- {
+		if data[i] == '-' {
+			position = i
+			break
+		}
+	}
+	var basic []byte
+	var rest []byte
+	if position >= 0 {
+		basic = data[:position]
+		if position > 0 {
+			rest = data[position+1:]
+		} else {
+			rest = data
+		}
+	} else {
+		basic = data[:0]
+		rest = data
+	}
+	for _, b := range basic {
+		if b >= 0x80 {
+			return nil, false
+		}
+	}
+
+	baseLen := uint32(len(basic))
+	length := baseLen
+	codePoint := uint32(initialN)
+	bias := uint32(initialBias)
+	i := uint32(0)
+	var insertions []insertion
+	pos := 0
+	for {
+		previousI := i
+		weight := uint32(1)
+		k := uint32(base)
+		if pos >= len(rest) {
+			break
+		}
+		b := rest[pos]
+		pos++
+		for {
+			d, ok := digitOf(b)
+			if !ok {
+				return nil, false
+			}
+			if weight != 0 && d > math.MaxUint32/weight {
+				return nil, false
+			}
+			product := d * weight
+			if product > math.MaxUint32-i {
+				return nil, false
+			}
+			i += product
+			var t uint32
+			if k <= bias {
+				t = tmin
+			} else if k >= bias+tmax {
+				t = tmax
+			} else {
+				t = k - bias
+			}
+			if d < t {
+				break
+			}
+			if base-t != 0 && weight > math.MaxUint32/(base-t) {
+				return nil, false
+			}
+			weight *= base - t
+			k += base
+			if pos >= len(rest) {
+				return nil, false
+			}
+			b = rest[pos]
+			pos++
+		}
+
+		bias = adapt(i-previousI, length+1, previousI == 0)
+
+		inc := i / (length + 1)
+		if codePoint > math.MaxUint32-inc {
+			return nil, false
+		}
+		codePoint += inc
+		i %= length + 1
+		if codePoint > 0x10FFFF || (codePoint >= 0xD800 && codePoint <= 0xDFFF) {
+			return nil, false
+		}
+		c := rune(codePoint)
+
+		for j := range insertions {
+			if insertions[j].idx >= int(i) {
+				insertions[j].idx++
+			}
+		}
+		insertions = append(insertions, insertion{int(i), c})
+		length++
+		i++
+	}
+
+	for a := 1; a < len(insertions); a++ {
+		for b := a; b > 0 && insertions[b].idx < insertions[b-1].idx; b-- {
+			insertions[b], insertions[b-1] = insertions[b-1], insertions[b]
+		}
+	}
+
+	total := int(baseLen) + len(insertions)
+	out := make([]rune, 0, total)
+	inserted := 0
+	basePos := 0
+	for p := 0; p < total; p++ {
+		if inserted < len(insertions) && insertions[inserted].idx == p {
+			out = append(out, insertions[inserted].c)
+			inserted++
+			continue
+		}
+		out = append(out, rune(basic[basePos]))
+		basePos++
+	}
+	return out, true
+}
+
+// DecodeToString converts Punycode to a string.
+func DecodeToString(input string) (string, bool) {
+	runes, ok := Decode(input)
+	if !ok {
+		return "", false
+	}
+	return string(runes), true
+}
