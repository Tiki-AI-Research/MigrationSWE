@@ -0,0 +1,94 @@
+package percentencoding
+
+// ASCIIStringSet represents a set of bytes in the ASCII range (0x00..=0x7F).
+// It has value semantics: all operations return new sets and never mutate the
+// receiver.
+type ASCIIStringSet struct {
+	mask [4]uint32
+}
+
+const asciiRangeLen = 0x80
+const bitsPerChunk = 32
+
+func (s ASCIIStringSet) contains(b byte) bool {
+	chunk := s.mask[b/bitsPerChunk]
+	mask := uint32(1) << (b % bitsPerChunk)
+	return chunk&mask != 0
+}
+
+func (s ASCIIStringSet) shouldPercentEncode(b byte) bool {
+	return b >= 0x80 || s.contains(b)
+}
+
+// Add returns a set that additionally contains b.
+func (s ASCIIStringSet) Add(b byte) ASCIIStringSet {
+	s.mask[b/bitsPerChunk] |= uint32(1) << (b % bitsPerChunk)
+	return s
+}
+
+// Remove returns a set that does not contain b.
+func (s ASCIIStringSet) Remove(b byte) ASCIIStringSet {
+	s.mask[b/bitsPerChunk] &^= uint32(1) << (b % bitsPerChunk)
+	return s
+}
+
+// Union returns the union of two sets.
+func (s ASCIIStringSet) Union(other ASCIIStringSet) ASCIIStringSet {
+	return ASCIIStringSet{mask: [4]uint32{
+		s.mask[0] | other.mask[0],
+		s.mask[1] | other.mask[1],
+		s.mask[2] | other.mask[2],
+		s.mask[3] | other.mask[3],
+	}}
+}
+
+// Complement returns the negation of the set within the ASCII range.
+func (s ASCIIStringSet) Complement() ASCIIStringSet {
+	return ASCIIStringSet{mask: [4]uint32{
+		^s.mask[0], ^s.mask[1], ^s.mask[2], ^s.mask[3],
+	}}
+}
+
+// Controls is the set of 0x00 to 0x1F (C0 controls) and 0x7F (DEL).
+var Controls = ASCIIStringSet{mask: [4]uint32{
+	0xFFFFFFFF,
+	0,
+	0,
+	uint32(1) << (0x7F % 32),
+}}
+
+// NonAlphanumeric is everything that is not an ASCII letter or digit.
+var NonAlphanumeric = Controls.
+	Add(' ').
+	Add('!').
+	Add('"').
+	Add('#').
+	Add('$').
+	Add('%').
+	Add('&').
+	Add('\'').
+	Add('(').
+	Add(')').
+	Add('*').
+	Add('+').
+	Add(',').
+	Add('-').
+	Add('.').
+	Add('/').
+	Add(':').
+	Add(';').
+	Add('<').
+	Add('=').
+	Add('>').
+	Add('?').
+	Add('@').
+	Add('[').
+	Add('\\').
+	Add(']').
+	Add('^').
+	Add('_').
+	Add('`').
+	Add('{').
+	Add('|').
+	Add('}').
+	Add('~')
diff --git a/percentencoding/percentencoding.go b/percentencoding/percentencoding.go
new file mode 100644
index 0000000..70de93c
--- /dev/null
+++ b/percentencoding/percentencoding.go
@@ -0,0 +1,323 @@
+package percentencoding
+
+import "unicode/utf8"
+
+const upperhex = "0123456789ABCDEF"
+
+// PercentEncodeByte returns the percent-encoding of the given byte, always
+// using uppercase hexadecimal digits.
+func PercentEncodeByte(b byte) string {
+	return string([]byte{'%', upperhex[b>>4], upperhex[b&0x0F]})
+}
+
+// PercentEncode percent-encodes the given bytes with the given set. Non-ASCII
+// bytes and bytes contained in the set are encoded.
+func PercentEncode(input []byte, set *ASCIIStringSet) string {
+	var s ASCIIStringSet
+	if set != nil {
+		s = *set
+	}
+	return percentEncode(input, s)
+}
+
+// UTF8PercentEncode percent-encodes the UTF-8 encoding of the given string.
+func UTF8PercentEncode(input string, set *ASCIIStringSet) string {
+	return PercentEncode([]byte(input), set)
+}
+
+func percentEncode(input []byte, set ASCIIStringSet) string {
+	// Fast path: count encoded bytes.
+	n := len(input)
+	for _, b := range input {
+		if set.shouldPercentEncode(b) {
+			n += 2
+		}
+	}
+	if n == len(input) {
+		return string(input)
+	}
+	out := make([]byte, 0, n)
+	for _, b := range input {
+		if set.shouldPercentEncode(b) {
+			out = append(out, '%', upperhex[b>>4], upperhex[b&0x0F])
+		} else {
+			out = append(out, b)
+		}
+	}
+	return string(out)
+}
+
+// PercentDecode holds percent-decoded bytes.
+type PercentDecode struct {
+	bytes []byte
+}
+
+// Decode percent-decodes the given bytes. Any sequence of '%' followed by two
+// hexadecimal digits is decoded; otherwise bytes are copied unchanged.
+func Decode(input []byte) *PercentDecode {
+	return &PercentDecode{bytes: percentDecode(input)}
+}
+
+// DecodeString percent-decodes the given string.
+func DecodeString(input string) *PercentDecode {
+	return &PercentDecode{bytes: percentDecode([]byte(input))}
+}
+
+func percentDecode(input []byte) []byte {
+	out := make([]byte, 0, len(input))
+	for i := 0; i < len(input); i++ {
+		if input[i] == '%' {
+			if i+2 < len(input) {
+				h := fromHex(input[i+1])
+				l := fromHex(input[i+2])
+				if h >= 0 && l >= 0 {
+					out = append(out, byte(h*0x10+l))
+					i += 2
+					continue
+				}
+			}
+			out = append(out, '%')
+		} else {
+			out = append(out, input[i])
+		}
+	}
+	return out
+}
+
+func fromHex(b byte) int {
+	switch {
+	case b >= '0' && b <= '9':
+		return int(b - '0')
+	case b >= 'a' && b <= 'f':
+		return int(b-'a') + 10
+	case b >= 'A' && b <= 'F':
+		return int(b-'A') + 10
+	}
+	return -1
+}
+
+// Bytes returns the percent-decoded bytes.
+func (p *PercentDecode) Bytes() []byte {
+	return p.bytes
+}
+
+// DecodeUTF8 decodes the percent-decoded bytes as UTF-8.
+func (p *PercentDecode) DecodeUTF8() (string, error) {
+	if utf8.Valid(p.bytes) {
+		return string(p.bytes), nil
+	}
+	validUpTo, errLen, hasErrLen := validateUTF8(p.bytes)
+	return "", &UTF8Error{validUpTo: validUpTo, errLen: errLen, hasErrLen: hasErrLen}
+}
+
+// DecodeUTF8Lossy decodes the percent-decoded bytes as UTF-8, replacing each
+// invalid sequence with U+FFFD.
+func (p *PercentDecode) DecodeUTF8Lossy() string {
+	return string(decodeUTF8Lossy(p.bytes))
+}
+
+// UTF8Error describes an invalid UTF-8 sequence.
+type UTF8Error struct {
+	validUpTo int
+	errLen    int
+	hasErrLen bool
+}
+
+func (e *UTF8Error) Error() string {
+	return "invalid utf-8 sequence"
+}
+
+// ValidUpTo returns the index of the first invalid byte.
+func (e *UTF8Error) ValidUpTo() int {
+	return e.validUpTo
+}
+
+// ErrorLen returns the length of the invalid sequence, and whether an explicit
+// length is known (false when the input ends unexpectedly).
+func (e *UTF8Error) ErrorLen() (int, bool) {
+	return e.errLen, e.hasErrLen
+}
+
+func decodeUTF8Lossy(b []byte) []byte {
+	if utf8.Valid(b) {
+		return b
+	}
+	out := make([]byte, 0, len(b))
+	for len(b) > 0 {
+		validUpTo, errLen, hasErrLen := validateUTF8(b)
+		out = append(out, b[:validUpTo]...)
+		b = b[validUpTo:]
+		if len(b) == 0 {
+			break
+		}
+		out = append(out, 0xEF, 0xBF, 0xBD) // U+FFFD
+		if !hasErrLen {
+			break
+		}
+		if errLen <= 0 {
+			b = b[1:]
+		} else {
+			b = b[errLen:]
+		}
+	}
+	return out
+}
+
+// validateUTF8 mirrors Rust's str::Utf8Error semantics: it returns the length of
+// the valid prefix, the length of the invalid sequence, and whether that length
+// is known (true) or the error was caused by the input ending unexpectedly
+// (false).
+func validateUTF8(b []byte) (validUpTo, errLen int, hasErrLen bool) {
+	i := 0
+	n := len(b)
+	for i < n {
+		c := b[i]
+		if c < 0x80 {
+			i++
+			continue
+		}
+		if c >= 0xC2 && c <= 0xDF {
+			if i+1 >= n {
+				return i, 0, false
+			}
+			if b[i+1] < 0x80 || b[i+1] > 0xBF {
+				return i, 1, true
+			}
+			i += 2
+			continue
+		}
+		if c == 0xE0 {
+			if i+1 >= n {
+				return i, 0, false
+			}
+			if b[i+1] < 0xA0 || b[i+1] > 0xBF {
+				return i, 1, true
+			}
+			if i+2 >= n {
+				return i, 0, false
+			}
+			if b[i+2] < 0x80 || b[i+2] > 0xBF {
+				return i, 2, true
+			}
+			i += 3
+			continue
+		}
+		if c >= 0xE1 && c <= 0xEC {
+			if i+1 >= n {
+				return i, 0, false
+			}
+			if b[i+1] < 0x80 || b[i+1] > 0xBF {
+				return i, 1, true
+			}
+			if i+2 >= n {
+				return i, 0, false
+			}
+			if b[i+2] < 0x80 || b[i+2] > 0xBF {
+				return i, 2, true
+			}
+			i += 3
+			continue
+		}
+		if c == 0xED {
+			if i+1 >= n {
+				return i, 0, false
+			}
+			if b[i+1] < 0x80 || b[i+1] > 0x9F {
+				return i, 1, true
+			}
+			if i+2 >= n {
+				return i, 0, false
+			}
+			if b[i+2] < 0x80 || b[i+2] > 0xBF {
+				return i, 2, true
+			}
+			i += 3
+			continue
+		}
+		if c >= 0xEE && c <= 0xEF {
+			if i+1 >= n {
+				return i, 0, false
+			}
+			if b[i+1] < 0x80 || b[i+1] > 0xBF {
+				return i, 1, true
+			}
+			if i+2 >= n {
+				return i, 0, false
+			}
+			if b[i+2] < 0x80 || b[i+2] > 0xBF {
+				return i, 2, true
+			}
+			i += 3
+			continue
+		}
+		if c == 0xF0 {
+			if i+1 >= n {
+				return i, 0, false
+			}
+			if b[i+1] < 0x90 || b[i+1] > 0xBF {
+				return i, 1, true
+			}
+			if i+2 >= n {
+				return i, 0, false
+			}
+			if b[i+2] < 0x80 || b[i+2] > 0xBF {
+				return i, 2, true
+			}
+			if i+3 >= n {
+				return i, 0, false
+			}
+			if b[i+3] < 0x80 || b[i+3] > 0xBF {
+				return i, 3, true
+			}
+			i += 4
+			continue
+		}
+		if c >= 0xF1 && c <= 0xF3 {
+			if i+1 >= n {
+				return i, 0, false
+			}
+			if b[i+1] < 0x80 || b[i+1] > 0xBF {
+				return i, 1, true
+			}
+			if i+2 >= n {
+				return i, 0, false
+			}
+			if b[i+2] < 0x80 || b[i+2] > 0xBF {
+				return i, 2, true
+			}
+			if i+3 >= n {
+				return i, 0, false
+			}
+			if b[i+3] < 0x80 || b[i+3] > 0xBF {
+				return i, 3, true
+			}
+			i += 4
+			continue
+		}
+		if c == 0xF4 {
+			if i+1 >= n {
+				return i, 0, false
+			}
+			if b[i+1] < 0x80 || b[i+1] > 0x8F {
+				return i, 1, true
+			}
+			if i+2 >= n {
+				return i, 0, false
+			}
+			if b[i+2] < 0x80 || b[i+2] > 0xBF {
+				return i, 2, true
+			}
+			if i+3 >= n {
+				return i, 0, false
+			}
+			if b[i+3] < 0x80 || b[i+3] > 0xBF {
+				return i, 3, true
+			}
+			i += 4
+			continue
+		}
+		// Invalid leading byte (0x80..=0xC1, 0xF5..=0xFF).
+		return i, 1, true
+	}
+	return n, 0, false
+}
diff --git a/percentencoding/percentencoding_test.go b/percentencoding/percentencoding_test.go
new file mode 100644
index 0000000..c5b4d53
--- /dev/null
+++ b/percentencoding/percentencoding_test.go
@@ -0,0 +1,95 @@
+package percentencoding
+
+import "testing"
+
+func TestEncode(t *testing.T) {
+	if got := PercentEncode([]byte("foo bar?"), &NonAlphanumeric); got != "foo%20bar%3F" {
+		t.Errorf("PercentEncode = %q", got)
+	}
+	if got := UTF8PercentEncode("foo bar?", &NonAlphanumeric); got != "foo%20bar%3F" {
+		t.Errorf("UTF8PercentEncode = %q", got)
+	}
+	if got := PercentEncode([]byte("\x00\x01\x02\x03"), &Controls); got != "%00%01%02%03" {
+		t.Errorf("controls = %q", got)
+	}
+	if got := PercentEncodeByte(0x3F); got != "%3F" {
+		t.Errorf("PercentEncodeByte = %q", got)
+	}
+	if got := PercentEncodeByte(0x0A); got != "%0A" {
+		t.Errorf("PercentEncodeByte uppercase = %q", got)
+	}
+	if got := UTF8PercentEncode("héllo", &NonAlphanumeric); got != "h%C3%A9llo" {
+		t.Errorf("utf8 non-ascii = %q", got)
+	}
+}
+
+func TestSetOps(t *testing.T) {
+	base := Controls
+	extended := base.Add(' ')
+	if !extended.shouldPercentEncode(' ') {
+		t.Errorf("Add should include ' '")
+	}
+	if base.shouldPercentEncode(' ') {
+		t.Errorf("Add must not mutate receiver")
+	}
+	removed := extended.Remove(' ')
+	if removed.shouldPercentEncode(' ') {
+		t.Errorf("Remove should exclude ' '")
+	}
+	union := Controls.Union(base.Add('A'))
+	if !union.shouldPercentEncode('A') || !union.shouldPercentEncode(0) {
+		t.Errorf("Union failed")
+	}
+	comp := base.Complement()
+	if comp.shouldPercentEncode(0) || !comp.shouldPercentEncode('A') {
+		t.Errorf("Complement failed")
+	}
+}
+
+func TestDecode(t *testing.T) {
+	if got := DecodeString("foo%20bar%3f").DecodeUTF8Lossy(); got != "foo bar?" {
+		t.Errorf("decode = %q", got)
+	}
+	b, _ := DecodeString("foo%20bar%3f").DecodeUTF8()
+	if b != "foo bar?" {
+		t.Errorf("decode utf8 = %q", b)
+	}
+	if string(Decode([]byte("foo%20bar%3f")).Bytes()) != "foo bar?" {
+		t.Errorf("bytes decode")
+	}
+	// Invalid percent sequences are left as-is.
+	if string(Decode([]byte("foo%2")).Bytes()) != "foo%2" {
+		t.Errorf("invalid percent preserve")
+	}
+}
+
+func TestDecodeUTF8Error(t *testing.T) {
+	_, err := Decode([]byte("%00%9F%92%96")).DecodeUTF8()
+	ue, ok := err.(*UTF8Error)
+	if !ok {
+		t.Fatalf("expected *UTF8Error, got %T", err)
+	}
+	if ue.ValidUpTo() != 1 {
+		t.Errorf("ValidUpTo = %d", ue.ValidUpTo())
+	}
+	n, has := ue.ErrorLen()
+	if !has || n != 1 {
+		t.Errorf("ErrorLen = (%d,%v)", n, has)
+	}
+	if ue.Error() == "" {
+		t.Errorf("Error() should be non-empty")
+	}
+}
+
+func TestDecodeUTF8Lossy(t *testing.T) {
+	if got := Decode([]byte("%00%9F%92%96")).DecodeUTF8Lossy(); got != "\x00\uFFFD\uFFFD\uFFFD" {
+		t.Errorf("lossy = %q", got)
+	}
+	if got := Decode([]byte("%F0%9F%92%96")).DecodeUTF8Lossy(); got != "\U0001F496" {
+		t.Errorf("lossy emoji = %q", got)
+	}
+	// Truncated multi-byte sequence becomes a single replacement char.
+	if got := Decode([]byte("%E2%82")).DecodeUTF8Lossy(); got != "\uFFFD" {
+		t.Errorf("truncated lossy = %q", got)
+	}
+}
diff --git a/url/conformance_test.go b/url/conformance_test.go
new file mode 100644
index 0000000..45db099
--- /dev/null
+++ b/url/conformance_test.go
@@ -0,0 +1,496 @@
+package url
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+func rustEscapeDefault(s string) string {
+	var b []byte
+	for _, c := range s {
+		switch c {
+		case '\t':
+			b = append(b, "\\t"...)
+		case '\r':
+			b = append(b, "\\r"...)
+		case '\n':
+			b = append(b, "\\n"...)
+		case '\\':
+			b = append(b, "\\\\"...)
+		case '\'':
+			b = append(b, "\\'"...)
+		case '"':
+			b = append(b, "\\\""...)
+		default:
+			if c >= 0x20 && c < 0x7F {
+				b = append(b, string(c)...)
+			} else {
+				b = append(b, fmt.Sprintf("\\u{%X}", c)...)
+			}
+		}
+	}
+	return string(b)
+}
+
+func loadExpectedFailures() map[string]bool {
+	m := map[string]bool{}
+	data, err := os.ReadFile("tests/expected_failures.txt")
+	if err != nil {
+		return m
+	}
+	for _, line := range splitLines(string(data)) {
+		if line != "" {
+			m[line] = true
+		}
+	}
+	return m
+}
+
+func splitLines(s string) []string {
+	var out []string
+	start := 0
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\n' {
+			out = append(out, s[start:i])
+			start = i + 1
+		}
+	}
+	if start < len(s) {
+		out = append(out, s[start:])
+	}
+	return out
+}
+
+func qProtocol(u *URL) string { return u.Scheme() + ":" }
+
+func qPassword(u *URL) string {
+	if p, ok := u.Password(); ok {
+		return p
+	}
+	return ""
+}
+
+func qHost(u *URL) string {
+	hs, ok := u.HostStr()
+	if !ok {
+		return ""
+	}
+	if p, ok := u.Port(); ok {
+		return hs + ":" + strconv.FormatUint(uint64(p), 10)
+	}
+	return hs
+}
+
+func qHostname(u *URL) string { hs, _ := u.HostStr(); return hs }
+
+func qPort(u *URL) string {
+	if p, ok := u.Port(); ok {
+		return strconv.FormatUint(uint64(p), 10)
+	}
+	return ""
+}
+
+func qSearch(u *URL) string {
+	q, ok := u.Query()
+	if !ok {
+		return ""
+	}
+	s := "?" + q
+	if len(s) == 1 {
+		return ""
+	}
+	return s
+}
+
+func qHash(u *URL) string {
+	f, ok := u.Fragment()
+	if !ok {
+		return ""
+	}
+	s := "#" + f
+	if len(s) == 1 {
+		return ""
+	}
+	return s
+}
+
+type urlTestOK struct {
+	Href     string `json:"href"`
+	Protocol string `json:"protocol"`
+	Username string `json:"username"`
+	Password string `json:"password"`
+	Host     string `json:"host"`
+	Hostname string `json:"hostname"`
+	Port     string `json:"port"`
+	Pathname string `json:"pathname"`
+	Search   string `json:"search"`
+	Hash     string `json:"hash"`
+}
+
+func parseWithBase(base *string, input string) (*URL, error) {
+	if base != nil {
+		b, err := Parse(*base)
+		if err != nil {
+			return nil, err
+		}
+		return b.Join(input)
+	}
+	return Parse(input)
+}
+
+func TestURLTestData(t *testing.T) {
+	expected := loadExpectedFailures()
+	data, err := os.ReadFile("tests/urltestdata.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var raw []json.RawMessage
+	if err := json.Unmarshal(data, &raw); err != nil {
+		t.Fatal(err)
+	}
+	total, pass := 0, 0
+	seenExpected := map[string]bool{}
+	for _, item := range raw {
+		var obj map[string]json.RawMessage
+		if err := json.Unmarshal(item, &obj); err != nil {
+			continue
+		}
+		if _, ok := obj["input"]; !ok {
+			continue
+		}
+		var failure bool
+		if f, ok := obj["failure"]; ok {
+			json.Unmarshal(f, &failure)
+		}
+		var input string
+		json.Unmarshal(obj["input"], &input)
+		var base *string
+		if b, ok := obj["base"]; ok && string(b) != "null" {
+			var bs string
+			json.Unmarshal(b, &bs)
+			base = &bs
+		}
+		name := "<" + rustEscapeDefault(input) + ">"
+		if base != nil {
+			name += " against <" + rustEscapeDefault(*base) + ">"
+		}
+		isExpected := expected[name]
+		if isExpected {
+			seenExpected[name] = true
+		}
+		total++
+		u, err := parseWithBase(base, input)
+		var res error
+		switch {
+		case failure:
+			if err == nil {
+				res = fmt.Errorf("expected failure, got %q", u.AsStr())
+			}
+		case err != nil:
+			res = fmt.Errorf("unexpected parse error: %v", err)
+		default:
+			var ok urlTestOK
+			json.Unmarshal(item, &ok)
+			got := urlTestOK{
+				Href: u.AsStr(), Protocol: qProtocol(u), Username: u.Username(),
+				Password: qPassword(u), Host: qHost(u), Hostname: qHostname(u),
+				Port: qPort(u), Pathname: u.Path(), Search: qSearch(u), Hash: qHash(u),
+			}
+			if got != ok {
+				res = fmt.Errorf("want %+v, got %+v", ok, got)
+			}
+		}
+		if res == nil {
+			pass++
+			if isExpected {
+				t.Errorf("%s: expected failure, but passed", name)
+			}
+		} else if !isExpected {
+			t.Errorf("%s: %v", name, res)
+		} else {
+			// An expected failure failed as expected.
+			pass++
+		}
+	}
+	for name := range expected {
+		if strings.Contains(name, "> set ") {
+			// Setter-test entries are covered by TestSettersTestData.
+			continue
+		}
+		if !seenExpected[name] {
+			t.Errorf("expected failure %q was not exercised", name)
+		}
+	}
+	if pass != total {
+		t.Errorf("URL tests: %d/%d passed", pass, total)
+	}
+}
+
+func setProtocol(u *URL, newProtocol string) error {
+	if i := strings.IndexByte(newProtocol, ':'); i >= 0 {
+		newProtocol = newProtocol[:i]
+	}
+	return u.SetScheme(newProtocol)
+}
+
+func setUsernameQ(u *URL, newUsername string) error { return u.SetUsername(newUsername) }
+
+func setPasswordQ(u *URL, newPassword string) error {
+	if newPassword == "" {
+		return u.SetPassword(nil)
+	}
+	return u.SetPassword(&newPassword)
+}
+
+func setHostnameQ(u *URL, newHostname string) error {
+	if u.cannotBeABase() {
+		return ErrSetHostOnCannotBeABaseURL
+	}
+	st := schemeTypeFrom(u.Scheme())
+	if st.isFile() && newHostname == "" {
+		u.setHostInternal(Host{kind: HostDomain, domain: ""}, nil, false)
+		return nil
+	}
+	p := &parser{context: contextSetter}
+	host, remaining, err := p.parseHost(input{s: newHostname}, st)
+	if err != nil {
+		return err
+	}
+	if remaining.startsWithChar(':') {
+		return ErrInvalidPort
+	}
+	if host.kind == HostDomain && host.domain == "" {
+		if st == schemeSpecialNotFile || qPort(u) != "" || u.Username() != "" || qPassword(u) != "" {
+			return ErrEmptyHost
+		}
+	}
+	u.setHostInternal(host, nil, false)
+	return nil
+}
+
+func setHostQ(u *URL, newHost string) error {
+	if u.cannotBeABase() {
+		return ErrSetHostOnCannotBeABaseURL
+	}
+	p := &parser{context: contextSetter}
+	st := schemeTypeFrom(u.Scheme())
+	if st.isFile() && newHost == "" {
+		u.setHostInternal(Host{kind: HostDomain, domain: ""}, nil, false)
+		return nil
+	}
+	host, remaining, err := p.parseHost(input{s: newHost}, st)
+	if err != nil {
+		return err
+	}
+	var optPort *uint16
+	setPort := false
+	if rest, ok := remaining.splitPrefixChar(':'); ok {
+		if !rest.isEmpty() {
+			port, _, perr := p.parsePort(rest, func() (uint16, bool) { return defaultPort(u.Scheme()) })
+			if perr == nil {
+				optPort = port
+				setPort = true
+			}
+		}
+	}
+	if host.kind == HostDomain && host.domain == "" {
+		if u.Username() != "" || (setPort && optPort != nil) || u.port != nil {
+			return ErrEmptyHost
+		}
+	}
+	u.setHostInternal(host, optPort, setPort)
+	return nil
+}
+
+func setPortQ(u *URL, newPort string) error {
+	scheme := u.Scheme()
+	emptyDomain := false
+	if h, ok := u.Host(); ok && h.kind == HostDomain && h.domain == "" {
+		emptyDomain = true
+	}
+	if !u.hasHost() || emptyDomain || scheme == "file" {
+		return ErrInvalidPort
+	}
+	p := &parser{context: contextSetter}
+	port, _, err := p.parsePort(input{s: newPort}, func() (uint16, bool) { return defaultPort(scheme) })
+	if err != nil {
+		return err
+	}
+	u.setPortInternal(port)
+	return nil
+}
+
+func setPathnameQ(u *URL, newPathname string) {
+	if u.cannotBeABase() {
+		return
+	}
+	st := schemeTypeFrom(u.Scheme())
+	if strings.HasPrefix(newPathname, "/") || (st.isSpecial() && strings.HasPrefix(newPathname, "\\")) {
+		u.SetPath(newPathname)
+	} else if st.isSpecial() || newPathname != "" || !u.hasHost() {
+		u.SetPath("/" + newPathname)
+	} else {
+		u.SetPath(newPathname)
+	}
+}
+
+func setSearchQ(u *URL, newSearch string) {
+	if newSearch == "" {
+		u.SetQuery(nil)
+		return
+	}
+	if strings.HasPrefix(newSearch, "?") {
+		q := newSearch[1:]
+		u.SetQuery(&q)
+		return
+	}
+	q := newSearch
+	u.SetQuery(&q)
+}
+
+func setHashQ(u *URL, newHash string) {
+	if newHash == "" {
+		u.SetFragment(nil)
+		return
+	}
+	if strings.HasPrefix(newHash, "#") {
+		f := newHash[1:]
+		u.SetFragment(&f)
+		return
+	}
+	f := newHash
+	u.SetFragment(&f)
+}
+
+type setterExpected struct {
+	Href     *string `json:"href"`
+	Protocol *string `json:"protocol"`
+	Username *string `json:"username"`
+	Password *string `json:"password"`
+	Host     *string `json:"host"`
+	Hostname *string `json:"hostname"`
+	Port     *string `json:"port"`
+	Pathname *string `json:"pathname"`
+	Search   *string `json:"search"`
+	Hash     *string `json:"hash"`
+}
+
+type setterTest struct {
+	Href     string         `json:"href"`
+	NewValue string         `json:"new_value"`
+	Expected setterExpected `json:"expected"`
+}
+
+func TestSettersTestData(t *testing.T) {
+	expected := loadExpectedFailures()
+	data, err := os.ReadFile("tests/setters_tests.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var raw map[string]json.RawMessage
+	if err := json.Unmarshal(data, &raw); err != nil {
+		t.Fatal(err)
+	}
+	total, pass := 0, 0
+	seenExpected := map[string]bool{}
+	for kind, arr := range raw {
+		if kind == "comment" {
+			continue
+		}
+		var tests []setterTest
+		if err := json.Unmarshal(arr, &tests); err != nil {
+			t.Fatal(err)
+		}
+		for _, test := range tests {
+			name := fmt.Sprintf("<%s> set %s to <%s>", rustEscapeDefault(test.Href), kind, rustEscapeDefault(test.NewValue))
+			isExpected := expected[name]
+			if isExpected {
+				seenExpected[name] = true
+			}
+			total++
+			u, err := Parse(test.Href)
+			var res error
+			if err != nil {
+				res = fmt.Errorf("parse href error %v", err)
+			} else {
+				switch kind {
+				case "protocol":
+					setProtocol(u, test.NewValue)
+				case "username":
+					setUsernameQ(u, test.NewValue)
+				case "password":
+					setPasswordQ(u, test.NewValue)
+				case "host":
+					setHostQ(u, test.NewValue)
+				case "hostname":
+					setHostnameQ(u, test.NewValue)
+				case "port":
+					setPortQ(u, test.NewValue)
+				case "pathname":
+					setPathnameQ(u, test.NewValue)
+				case "search":
+					setSearchQ(u, test.NewValue)
+				case "hash":
+					setHashQ(u, test.NewValue)
+				default:
+					res = fmt.Errorf("unsupported setter kind %q", kind)
+				}
+				ok := true
+				check := func(exp *string, got string) {
+					if exp != nil && *exp != got {
+						ok = false
+					}
+				}
+				check(test.Expected.Href, u.AsStr())
+				check(test.Expected.Protocol, qProtocol(u))
+				check(test.Expected.Username, u.Username())
+				check(test.Expected.Password, qPassword(u))
+				check(test.Expected.Host, qHost(u))
+				check(test.Expected.Hostname, qHostname(u))
+				check(test.Expected.Port, qPort(u))
+				check(test.Expected.Pathname, u.Path())
+				check(test.Expected.Search, qSearch(u))
+				check(test.Expected.Hash, qHash(u))
+				if !ok {
+					res = fmt.Errorf("want href=%v host=%v hostname=%v port=%v path=%v search=%v hash=%v protocol=%v; got href=%q host=%q hostname=%q port=%q path=%q search=%q hash=%q protocol=%q",
+						derefStr(test.Expected.Href), derefStr(test.Expected.Host), derefStr(test.Expected.Hostname), derefStr(test.Expected.Port), derefStr(test.Expected.Pathname), derefStr(test.Expected.Search), derefStr(test.Expected.Hash), derefStr(test.Expected.Protocol),
+						u.AsStr(), qHost(u), qHostname(u), qPort(u), u.Path(), qSearch(u), qHash(u), qProtocol(u))
+				}
+			}
+			if res == nil {
+				pass++
+				if isExpected {
+					t.Errorf("%s: expected failure, but passed", name)
+				}
+			} else if !isExpected {
+				t.Errorf("%s: %v", name, res)
+			} else {
+				// An expected failure failed as expected.
+				pass++
+			}
+		}
+	}
+	for name := range expected {
+		if !strings.Contains(name, "> set ") {
+			// URL-test entries are covered by TestURLTestData.
+			continue
+		}
+		if !seenExpected[name] {
+			t.Errorf("expected failure %q was not exercised", name)
+		}
+	}
+	if pass != total {
+		t.Errorf("Setter tests: %d/%d passed", pass, total)
+	}
+}
+
+func derefStr(s *string) string {
+	if s == nil {
+		return "<nil>"
+	}
+	return *s
+}
diff --git a/url/errors.go b/url/errors.go
new file mode 100644
index 0000000..3b96b6d
--- /dev/null
+++ b/url/errors.go
@@ -0,0 +1,17 @@
+package url
+
+import "errors"
+
+// Parse-failure sentinel errors, comparable with errors.Is.
+var (
+	ErrEmptyHost                        = errors.New("empty host")
+	ErrIdna                             = errors.New("invalid international domain name")
+	ErrInvalidPort                      = errors.New("invalid port number")
+	ErrInvalidIPv4Address               = errors.New("invalid IPv4 address")
+	ErrInvalidIPv6Address               = errors.New("invalid IPv6 address")
+	ErrInvalidDomainCharacter           = errors.New("invalid domain character")
+	ErrRelativeURLWithoutBase           = errors.New("relative URL without a base")
+	ErrRelativeURLWithCannotBeABaseBase = errors.New("relative URL with a cannot-be-a-base base")
+	ErrSetHostOnCannotBeABaseURL        = errors.New("a cannot-be-a-base URL doesn't have a host to set")
+	ErrOverflow                         = errors.New("URLs more than 4 GB are not supported")
+)
diff --git a/url/host.go b/url/host.go
new file mode 100644
index 0000000..cab85fe
--- /dev/null
+++ b/url/host.go
@@ -0,0 +1,478 @@
+package url
+
+import (
+	"net"
+	"strings"
+
+	"github.com/servo/rust-url/idna"
+	pe "github.com/servo/rust-url/percentencoding"
+)
+
+// HostKind identifies the kind of a Host.
+type HostKind uint8
+
+const (
+	HostDomain HostKind = iota
+	HostIPv4
+	HostIPv6
+)
+
+// Host is the host name of a URL.
+type Host struct {
+	kind   HostKind
+	domain string
+	ip     net.IP
+}
+
+func (h Host) Kind() HostKind {
+	return h.kind
+}
+
+func (h Host) Domain() string {
+	return h.domain
+}
+
+func (h Host) IP() net.IP {
+	return h.ip
+}
+
+func (h Host) String() string {
+	switch h.kind {
+	case HostDomain:
+		return h.domain
+	case HostIPv4:
+		return h.ip.String()
+	case HostIPv6:
+		return "[" + writeIPv6(ipv6Segments(h.ip)) + "]"
+	}
+	return ""
+}
+
+// parseHostCow parses a host per the WHATWG host parser (special schemes).
+func parseHostCow(input string) (Host, error) {
+	if strings.HasPrefix(input, "[") {
+		if !strings.HasSuffix(input, "]") {
+			return Host{}, ErrInvalidIPv6Address
+		}
+		ip, err := parseIPv6Addr(input[1 : len(input)-1])
+		if err != nil {
+			return Host{}, err
+		}
+		return Host{kind: HostIPv6, ip: ip}, nil
+	}
+	decoded := pe.DecodeString(input).Bytes()
+	domain, err := idna.DomainToASCIIURL(decoded)
+	if err != nil {
+		return Host{}, ErrIdna
+	}
+	if domain == "" {
+		return Host{}, ErrEmptyHost
+	}
+	if endsInANumber(domain) {
+		ip, err := parseIPv4Addr(domain)
+		if err != nil {
+			return Host{}, err
+		}
+		return Host{kind: HostIPv4, ip: ip}, nil
+	}
+	return Host{kind: HostDomain, domain: domain}, nil
+}
+
+func isInvalidHostChar(c rune) bool {
+	switch c {
+	case 0, '\t', '\n', '\r', ' ', '#', '/', ':', '<', '>', '?', '@', '[', '\\', ']', '^', '|':
+		return true
+	}
+	return false
+}
+
+// parseOpaqueHostCow parses an opaque host.
+func parseOpaqueHostCow(input string) (Host, error) {
+	if strings.HasPrefix(input, "[") {
+		if !strings.HasSuffix(input, "]") {
+			return Host{}, ErrInvalidIPv6Address
+		}
+		ip, err := parseIPv6Addr(input[1 : len(input)-1])
+		if err != nil {
+			return Host{}, err
+		}
+		return Host{kind: HostIPv6, ip: ip}, nil
+	}
+	for _, c := range input {
+		if isInvalidHostChar(c) {
+			return Host{}, ErrInvalidDomainCharacter
+		}
+	}
+	return Host{kind: HostDomain, domain: pe.UTF8PercentEncode(input, &pe.Controls)}, nil
+}
+
+// ParseHost parses a host: either an IPv6 address in [] square brackets, or a
+// domain.
+func ParseHost(input string) (Host, error) {
+	return parseHostCow(input)
+}
+
+// ParseOpaqueHost parses an opaque host.
+func ParseOpaqueHost(input string) (Host, error) {
+	return parseOpaqueHostCow(input)
+}
+
+func endsInANumber(input string) bool {
+	parts := strings.Split(input, ".")
+	last := parts[len(parts)-1]
+	if last == "" {
+		if len(parts) >= 2 {
+			last = parts[len(parts)-2]
+		} else {
+			return false
+		}
+	}
+	if last != "" && allASCIIDigits(last) {
+		return true
+	}
+	_, ok, _ := parseIPv4Number(last)
+	return ok
+}
+
+func allASCIIDigits(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return len(s) > 0
+}
+
+// parseIPv4Number returns (number, ok, overflow). ok is false when the input is
+// not a valid number; overflow is true when the number exceeds u32.
+func parseIPv4Number(input string) (uint32, bool, bool) {
+	if input == "" {
+		return 0, false, false
+	}
+	r := 10
+	if strings.HasPrefix(input, "0x") || strings.HasPrefix(input, "0X") {
+		input = input[2:]
+		r = 16
+	} else if len(input) >= 2 && input[0] == '0' {
+		input = input[1:]
+		r = 8
+	}
+	if input == "" {
+		return 0, true, false
+	}
+	switch r {
+	case 8:
+		for i := 0; i < len(input); i++ {
+			if input[i] < '0' || input[i] > '7' {
+				return 0, false, false
+			}
+		}
+	case 10:
+		for i := 0; i < len(input); i++ {
+			if input[i] < '0' || input[i] > '9' {
+				return 0, false, false
+			}
+		}
+	case 16:
+		for i := 0; i < len(input); i++ {
+			if !isHexDigit(input[i]) {
+				return 0, false, false
+			}
+		}
+	}
+	var num uint64
+	for i := 0; i < len(input); i++ {
+		var d uint64
+		c := input[i]
+		switch {
+		case c >= '0' && c <= '9':
+			d = uint64(c - '0')
+		case c >= 'a' && c <= 'f':
+			d = uint64(c-'a') + 10
+		case c >= 'A' && c <= 'F':
+			d = uint64(c-'A') + 10
+		}
+		num = num*uint64(r) + d
+		if num > 0xFFFFFFFF {
+			return 0, true, true
+		}
+	}
+	return uint32(num), true, false
+}
+
+func isHexDigit(c byte) bool {
+	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
+}
+
+func parseIPv4Addr(input string) (net.IP, error) {
+	parts := strings.Split(input, ".")
+	if len(parts) > 0 && parts[len(parts)-1] == "" {
+		parts = parts[:len(parts)-1]
+	}
+	if len(parts) > 4 {
+		return nil, ErrInvalidIPv4Address
+	}
+	numbers := make([]uint32, 0, len(parts))
+	for _, part := range parts {
+		n, ok, overflow := parseIPv4Number(part)
+		if !ok || overflow {
+			return nil, ErrInvalidIPv4Address
+		}
+		numbers = append(numbers, n)
+	}
+	if len(numbers) == 0 {
+		return nil, ErrInvalidIPv4Address
+	}
+	ipv4 := numbers[len(numbers)-1]
+	numbers = numbers[:len(numbers)-1]
+	if ipv4 > (0xFFFFFFFF >> (8 * uint(len(numbers)))) {
+		return nil, ErrInvalidIPv4Address
+	}
+	for _, x := range numbers {
+		if x > 255 {
+			return nil, ErrInvalidIPv4Address
+		}
+	}
+	for counter, n := range numbers {
+		ipv4 += n << (8 * uint(3-counter))
+	}
+	return net.IPv4(byte(ipv4>>24), byte(ipv4>>16), byte(ipv4>>8), byte(ipv4)).To4(), nil
+}
+
+func parseIPv6Addr(input string) (net.IP, error) {
+	b := []byte(input)
+	length := len(b)
+	isIPv4 := false
+	var pieces [8]uint16
+	piecePointer := 0
+	compressPointer := -1
+	i := 0
+
+	if length < 2 {
+		return nil, ErrInvalidIPv6Address
+	}
+	if b[0] == ':' {
+		if b[1] != ':' {
+			return nil, ErrInvalidIPv6Address
+		}
+		i = 2
+		piecePointer = 1
+		compressPointer = 1
+	}
+
+	for i < length {
+		if piecePointer == 8 {
+			return nil, ErrInvalidIPv6Address
+		}
+		if b[i] == ':' {
+			if compressPointer != -1 {
+				return nil, ErrInvalidIPv6Address
+			}
+			i++
+			piecePointer++
+			compressPointer = piecePointer
+			continue
+		}
+		start := i
+		end := start + 4
+		if end > length {
+			end = length
+		}
+		var value uint16
+		for i < end {
+			d := hexVal(b[i])
+			if d < 0 {
+				break
+			}
+			value = value*0x10 + uint16(d)
+			i++
+		}
+		if i < length {
+			switch b[i] {
+			case '.':
+				if i == start {
+					return nil, ErrInvalidIPv6Address
+				}
+				i = start
+				if piecePointer > 6 {
+					return nil, ErrInvalidIPv6Address
+				}
+				isIPv4 = true
+			case ':':
+				i++
+				if i == length {
+					return nil, ErrInvalidIPv6Address
+				}
+			default:
+				return nil, ErrInvalidIPv6Address
+			}
+		}
+		if isIPv4 {
+			break
+		}
+		pieces[piecePointer] = value
+		piecePointer++
+	}
+
+	if isIPv4 {
+		if piecePointer > 6 {
+			return nil, ErrInvalidIPv6Address
+		}
+		numbersSeen := 0
+		for i < length {
+			if numbersSeen > 0 {
+				if numbersSeen < 4 && i < length && b[i] == '.' {
+					i++
+				} else {
+					return nil, ErrInvalidIPv6Address
+				}
+			}
+			ipv4Piece := -1
+			for i < length {
+				c := b[i]
+				if c < '0' || c > '9' {
+					break
+				}
+				digit := int(c - '0')
+				if ipv4Piece == -1 {
+					ipv4Piece = digit
+				} else if ipv4Piece == 0 {
+					return nil, ErrInvalidIPv6Address
+				} else {
+					ipv4Piece = ipv4Piece*10 + digit
+					if ipv4Piece > 255 {
+						return nil, ErrInvalidIPv6Address
+					}
+				}
+				i++
+			}
+			if ipv4Piece < 0 {
+				return nil, ErrInvalidIPv6Address
+			}
+			pieces[piecePointer] = pieces[piecePointer]*0x100 + uint16(ipv4Piece)
+			numbersSeen++
+			if numbersSeen == 2 || numbersSeen == 4 {
+				piecePointer++
+			}
+		}
+		if numbersSeen != 4 {
+			return nil, ErrInvalidIPv6Address
+		}
+	}
+
+	if i < length {
+		return nil, ErrInvalidIPv6Address
+	}
+
+	if compressPointer != -1 {
+		swaps := piecePointer - compressPointer
+		piecePointer = 7
+		for swaps > 0 {
+			pieces[piecePointer], pieces[compressPointer+swaps-1] = pieces[compressPointer+swaps-1], pieces[piecePointer]
+			swaps--
+			piecePointer--
+		}
+	} else if piecePointer != 8 {
+		return nil, ErrInvalidIPv6Address
+	}
+
+	ip := make(net.IP, 16)
+	for j := 0; j < 8; j++ {
+		ip[j*2] = byte(pieces[j] >> 8)
+		ip[j*2+1] = byte(pieces[j])
+	}
+	return ip, nil
+}
+
+func hexVal(c byte) int {
+	switch {
+	case c >= '0' && c <= '9':
+		return int(c - '0')
+	case c >= 'a' && c <= 'f':
+		return int(c-'a') + 10
+	case c >= 'A' && c <= 'F':
+		return int(c-'A') + 10
+	}
+	return -1
+}
+
+func ipv6Segments(ip net.IP) [8]uint16 {
+	var seg [8]uint16
+	for j := 0; j < 8; j++ {
+		seg[j] = uint16(ip[j*2])<<8 | uint16(ip[j*2+1])
+	}
+	return seg
+}
+
+func writeIPv6(segments [8]uint16) string {
+	compressStart, compressEnd := longestZeroSequence(segments)
+	var sb strings.Builder
+	i := 0
+	for i < 8 {
+		if i == compressStart {
+			sb.WriteByte(':')
+			if i == 0 {
+				sb.WriteByte(':')
+			}
+			if compressEnd < 8 {
+				i = compressEnd
+			} else {
+				break
+			}
+		}
+		sb.WriteString(lowerHex16(segments[i]))
+		if i < 7 {
+			sb.WriteByte(':')
+		}
+		i++
+	}
+	return sb.String()
+}
+
+func longestZeroSequence(pieces [8]uint16) (int, int) {
+	longest := -1
+	longestLength := -1
+	start := -1
+	for i := 0; i < 8; i++ {
+		if pieces[i] == 0 {
+			if start < 0 {
+				start = i
+			}
+		} else {
+			if start >= 0 {
+				length := i - start
+				if length > longestLength {
+					longest = start
+					longestLength = length
+				}
+			}
+			start = -1
+		}
+	}
+	if start >= 0 {
+		length := 8 - start
+		if length > longestLength {
+			longest = start
+			longestLength = length
+		}
+	}
+	if longestLength < 2 {
+		return -1, -2
+	}
+	return longest, longest + longestLength
+}
+
+func lowerHex16(v uint16) string {
+	const digits = "0123456789abcdef"
+	if v == 0 {
+		return "0"
+	}
+	var buf [4]byte
+	i := 4
+	for v > 0 {
+		i--
+		buf[i] = digits[v&0xF]
+		v >>= 4
+	}
+	return string(buf[i:])
+}
diff --git a/url/origin.go b/url/origin.go
new file mode 100644
index 0000000..192957f
--- /dev/null
+++ b/url/origin.go
@@ -0,0 +1,76 @@
+package url
+
+import (
+	"strconv"
+	"sync/atomic"
+
+	"github.com/servo/rust-url/idna"
+)
+
+var opaqueCounter uint64
+
+// Origin is the origin of a URL.
+type Origin struct {
+	isTuple  bool
+	scheme   string
+	host     Host
+	port     uint16
+	opaqueID uint64
+}
+
+// NewOpaqueOrigin creates a new opaque origin that is only equal to itself.
+func NewOpaqueOrigin() *Origin {
+	return &Origin{opaqueID: atomic.AddUint64(&opaqueCounter, 1)}
+}
+
+// IsTuple reports whether this origin is a (scheme, host, port) tuple.
+func (o Origin) IsTuple() bool {
+	return o.isTuple
+}
+
+// ASCIISerialization returns the ASCII serialization of the origin.
+func (o Origin) ASCIISerialization() string {
+	if !o.isTuple {
+		return "null"
+	}
+	if dp, ok := defaultPort(o.scheme); ok && dp == o.port {
+		return o.scheme + "://" + o.host.String()
+	}
+	return o.scheme + "://" + o.host.String() + ":" + strconv.FormatUint(uint64(o.port), 10)
+}
+
+// UnicodeSerialization returns the Unicode serialization of the origin.
+func (o Origin) UnicodeSerialization() string {
+	if !o.isTuple {
+		return "null"
+	}
+	host := o.host
+	if host.kind == HostDomain {
+		d, _ := idna.DomainToUnicode(host.domain)
+		host = Host{kind: HostDomain, domain: d}
+	}
+	if dp, ok := defaultPort(o.scheme); ok && dp == o.port {
+		return o.scheme + "://" + host.String()
+	}
+	return o.scheme + "://" + host.String() + ":" + strconv.FormatUint(uint64(o.port), 10)
+}
+
+func urlOrigin(u *URL) Origin {
+	scheme := u.Scheme()
+	switch scheme {
+	case "blob":
+		inner, err := Parse(u.Path())
+		if err == nil {
+			return urlOrigin(inner)
+		}
+		return *NewOpaqueOrigin()
+	case "ftp", "http", "https", "ws", "wss":
+		host, _ := u.Host()
+		port, _ := u.PortOrKnownDefault()
+		return Origin{isTuple: true, scheme: scheme, host: host, port: port}
+	case "file":
+		return *NewOpaqueOrigin()
+	default:
+		return *NewOpaqueOrigin()
+	}
+}
diff --git a/url/parser.go b/url/parser.go
new file mode 100644
index 0000000..202606d
--- /dev/null
+++ b/url/parser.go
@@ -0,0 +1,1281 @@
+package url
+
+import (
+	"bytes"
+	"strings"
+	"unicode/utf8"
+
+	pe "github.com/servo/rust-url/percentencoding"
+)
+
+type schemeType int
+
+const (
+	schemeFile schemeType = iota
+	schemeSpecialNotFile
+	schemeNotSpecial
+)
+
+func (s schemeType) isSpecial() bool { return s != schemeNotSpecial }
+func (s schemeType) isFile() bool    { return s == schemeFile }
+
+func schemeTypeFrom(s string) schemeType {
+	switch s {
+	case "http", "https", "ws", "wss", "ftp":
+		return schemeSpecialNotFile
+	case "file":
+		return schemeFile
+	}
+	return schemeNotSpecial
+}
+
+func defaultPort(scheme string) (uint16, bool) {
+	switch scheme {
+	case "http", "ws":
+		return 80, true
+	case "https", "wss":
+		return 443, true
+	case "ftp":
+		return 21, true
+	}
+	return 0, false
+}
+
+type context int
+
+const (
+	contextURLParser context = iota
+	contextSetter
+	contextPathSegmentSetter
+)
+
+type input struct {
+	s string
+}
+
+func (in *input) clone() input { return input{s: in.s} }
+
+func (in *input) next() (rune, bool) {
+	for {
+		if in.s == "" {
+			return 0, false
+		}
+		c, size := utf8.DecodeRuneInString(in.s)
+		in.s = in.s[size:]
+		if !isTabOrNewline(c) {
+			return c, true
+		}
+	}
+}
+
+func (in *input) nextRaw() (rune, bool) {
+	if in.s == "" {
+		return 0, false
+	}
+	c, size := utf8.DecodeRuneInString(in.s)
+	in.s = in.s[size:]
+	return c, true
+}
+
+func (in *input) nextUTF8() (rune, string, bool) {
+	for {
+		if in.s == "" {
+			return 0, "", false
+		}
+		c, size := utf8.DecodeRuneInString(in.s)
+		utf8c := in.s[:size]
+		in.s = in.s[size:]
+		if !isTabOrNewline(c) {
+			return c, utf8c, true
+		}
+	}
+}
+
+func (in *input) splitFirst() (rune, bool, input) {
+	remaining := in.clone()
+	c, ok := remaining.next()
+	return c, ok, remaining
+}
+
+func (in *input) startsWithChar(c rune) bool {
+	tmp := in.clone()
+	got, ok := tmp.next()
+	return ok && got == c
+}
+
+func (in *input) startsWithStr(s string) bool {
+	tmp := in.clone()
+	for _, c := range s {
+		got, ok := tmp.next()
+		if !ok || got != c {
+			return false
+		}
+	}
+	return true
+}
+
+func (in *input) splitPrefixChar(c rune) (input, bool) {
+	remaining := in.clone()
+	got, ok := remaining.next()
+	if ok && got == c {
+		return remaining, true
+	}
+	return *in, false
+}
+
+func (in *input) splitPrefixStr(s string) (input, bool) {
+	remaining := in.clone()
+	for _, c := range s {
+		got, ok := remaining.next()
+		if !ok || got != c {
+			return *in, false
+		}
+	}
+	return remaining, true
+}
+
+func (in *input) countMatching(f func(rune) bool) (int, input) {
+	count := 0
+	remaining := in.clone()
+	for {
+		tmp := remaining.clone()
+		c, ok := tmp.next()
+		if ok && f(c) {
+			remaining = tmp
+			count++
+		} else {
+			return count, remaining
+		}
+	}
+}
+
+func (in *input) isEmpty() bool {
+	tmp := in.clone()
+	_, ok := tmp.next()
+	return !ok
+}
+
+func isTabOrNewline(c rune) bool { return c == '\t' || c == '\n' || c == '\r' }
+func isASCIIAlpha(c rune) bool   { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }
+
+func trimC0ControlOrSpace(s string) string {
+	start := 0
+	for start < len(s) && s[start] <= ' ' {
+		start++
+	}
+	end := len(s)
+	for end > start && s[end-1] <= ' ' {
+		end--
+	}
+	return s[start:end]
+}
+
+func trimTabAndNewlines(s string) string {
+	start := 0
+	for start < len(s) {
+		c := s[start]
+		if c == '\t' || c == '\n' || c == '\r' {
+			start++
+		} else {
+			break
+		}
+	}
+	end := len(s)
+	for end > start {
+		c := s[end-1]
+		if c == '\t' || c == '\n' || c == '\r' {
+			end--
+		} else {
+			break
+		}
+	}
+	return s[start:end]
+}
+
+func toU32(i int) (uint32, error) {
+	if uint64(i) <= 0xFFFFFFFF {
+		return uint32(i), nil
+	}
+	return 0, ErrOverflow
+}
+
+type parser struct {
+	serialization []byte
+	baseURL       *URL
+	context       context
+}
+
+func (p *parser) pushStr(s string) { p.serialization = append(p.serialization, s...) }
+func (p *parser) pushByte(b byte)  { p.serialization = append(p.serialization, b) }
+
+func (p *parser) appendEncoded(text string, set *pe.ASCIIStringSet) {
+	p.serialization = append(p.serialization, pe.UTF8PercentEncode(text, set)...)
+}
+
+func (p *parser) parseURL(raw string) (*URL, error) {
+	in := input{s: trimC0ControlOrSpace(raw)}
+	if remaining, ok := p.parseScheme(in.clone()); ok {
+		return p.parseWithScheme(remaining)
+	}
+	if p.baseURL != nil {
+		if in.startsWithChar('#') {
+			return p.fragmentOnly(p.baseURL, in)
+		}
+		if p.baseURL.cannotBeABase() {
+			return nil, ErrRelativeURLWithCannotBeABaseBase
+		}
+		st := schemeTypeFrom(p.baseURL.scheme())
+		if st.isFile() {
+			return p.parseFile(in, st, p.baseURL)
+		}
+		return p.parseRelative(in, st, p.baseURL)
+	}
+	return nil, ErrRelativeURLWithoutBase
+}
+
+func (p *parser) parseScheme(in input) (input, bool) {
+	tmp := in.clone()
+	c, ok := tmp.next()
+	if !ok || !isASCIIAlpha(c) {
+		return in, false
+	}
+	for {
+		c, ok := in.next()
+		if !ok {
+			break
+		}
+		switch {
+		case (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.':
+			p.pushByte(byte(c))
+		case c >= 'A' && c <= 'Z':
+			p.pushByte(byte(c) | 0x20)
+		case c == ':':
+			return in, true
+		default:
+			p.serialization = p.serialization[:0]
+			return in, false
+		}
+	}
+	if p.context == contextSetter {
+		return in, true
+	}
+	p.serialization = p.serialization[:0]
+	return in, false
+}
+
+func (p *parser) parseWithScheme(in input) (*URL, error) {
+	schemeEnd, err := toU32(len(p.serialization))
+	if err != nil {
+		return nil, err
+	}
+	st := schemeTypeFrom(string(p.serialization))
+	p.pushByte(':')
+	switch st {
+	case schemeFile:
+		var baseFile *URL
+		if p.baseURL != nil && p.baseURL.scheme() == "file" {
+			baseFile = p.baseURL
+		}
+		p.serialization = p.serialization[:0]
+		return p.parseFile(in, st, baseFile)
+	case schemeSpecialNotFile:
+		slashesCount, remaining := in.countMatching(func(c rune) bool { return c == '/' || c == '\\' })
+		if p.baseURL != nil {
+			if slashesCount < 2 && p.baseURL.scheme() == string(p.serialization[:schemeEnd]) {
+				p.serialization = p.serialization[:0]
+				return p.parseRelative(in, st, p.baseURL)
+			}
+		}
+		return p.afterDoubleSlash(remaining, st, schemeEnd)
+	default:
+		return p.parseNonSpecial(in, st, schemeEnd)
+	}
+}
+
+func (p *parser) parseNonSpecial(in input, st schemeType, schemeEnd uint32) (*URL, error) {
+	if rest, ok := in.splitPrefixStr("//"); ok {
+		return p.afterDoubleSlash(rest, st, schemeEnd)
+	}
+	pathStart, err := toU32(len(p.serialization))
+	if err != nil {
+		return nil, err
+	}
+	usernameEnd := pathStart
+	hostStart := pathStart
+	hostEnd := pathStart
+	host := hostInternal{kind: hostNoneKind}
+	var port *uint16
+	var remaining input
+	if rest, ok := in.splitPrefixChar('/'); ok {
+		p.pushByte('/')
+		hasHost := false
+		remaining = p.parsePath(st, &hasHost, int(pathStart), rest)
+	} else {
+		remaining = p.parseCannotBeABasePath(in)
+	}
+	return p.withQueryAndFragment(st, schemeEnd, usernameEnd, hostStart, hostEnd, host, port, pathStart, remaining)
+}
+
+func (p *parser) parseFile(in input, st schemeType, baseFileURL *URL) (*URL, error) {
+	firstChar, hasFirst, inputAfterFirst := in.splitFirst()
+	if hasFirst && (firstChar == '/' || firstChar == '\\') {
+		nextChar, hasNext, inputAfterNext := inputAfterFirst.splitFirst()
+		if hasNext && (nextChar == '/' || nextChar == '\\') {
+			p.pushStr("file://")
+			schemeEnd, _ := toU32(len("file"))
+			hostStart, _ := toU32(len("file://"))
+			pathStartBool, host, remaining, err := p.parseFileHost(inputAfterNext)
+			if err != nil {
+				return nil, err
+			}
+			hostEnd, _ := toU32(len(p.serialization))
+			hasHost := host.kind != hostNoneKind
+			var remaining2 input
+			if pathStartBool {
+				remaining2 = p.parsePathStart(schemeTypeFile, &hasHost, remaining)
+			} else {
+				pathStart := len(p.serialization)
+				p.pushByte('/')
+				remaining2 = p.parsePath(schemeTypeFile, &hasHost, pathStart, remaining)
+			}
+			queryStart, fragmentStart, err := p.parseQueryAndFragment(st, schemeEnd, remaining2)
+			if err != nil {
+				return nil, err
+			}
+			return &URL{
+				serialization: string(p.serialization),
+				schemeEnd:     schemeEnd,
+				usernameEnd:   hostStart,
+				hostStart:     hostStart,
+				hostEnd:       hostEnd,
+				host:          host,
+				port:          nil,
+				pathStart:     hostEnd,
+				queryStart:    queryStart,
+				fragmentStart: fragmentStart,
+			}, nil
+		}
+		p.pushStr("file://")
+		schemeEnd, _ := toU32(len("file"))
+		hostStart := len("file://")
+		hostEnd := hostStart
+		host := hostInternal{kind: hostNoneKind}
+		if !startsWithWindowsDriveLetterSegment(inputAfterFirst) {
+			if baseFileURL != nil {
+				firstSegment := ""
+				if segs := baseFileURL.pathSegments(); segs != nil && len(segs) > 0 {
+					firstSegment = segs[0]
+				}
+				if isNormalizedWindowsDriveLetter(firstSegment) {
+					p.pushByte('/')
+					p.pushStr(firstSegment)
+				} else if hs, ok := baseFileURL.hostStr(); ok {
+					p.pushStr(hs)
+					hostEnd = len(p.serialization)
+					host = baseFileURL.host
+				}
+			}
+		}
+		var parsePathInput input
+		if hasFirst {
+			if firstChar == '/' || firstChar == '\\' || firstChar == '?' || firstChar == '#' {
+				parsePathInput = in
+			} else {
+				parsePathInput = inputAfterFirst
+			}
+		} else {
+			parsePathInput = inputAfterFirst
+		}
+		hasHost := false
+		remaining := p.parsePath(schemeTypeFile, &hasHost, hostEnd, parsePathInput)
+		hostStartU, _ := toU32(hostStart)
+		queryStart, fragmentStart, err := p.parseQueryAndFragment(st, schemeEnd, remaining)
+		if err != nil {
+			return nil, err
+		}
+		hostEndU, _ := toU32(hostEnd)
+		return &URL{
+			serialization: string(p.serialization),
+			schemeEnd:     schemeEnd,
+			usernameEnd:   hostStartU,
+			hostStart:     hostStartU,
+			hostEnd:       hostEndU,
+			host:          host,
+			port:          nil,
+			pathStart:     hostEndU,
+			queryStart:    queryStart,
+			fragmentStart: fragmentStart,
+		}, nil
+	}
+	if baseFileURL != nil {
+		switch {
+		case !hasFirst:
+			beforeFragment := baseFileURL.serialization
+			if baseFileURL.fragmentStart >= 0 {
+				beforeFragment = baseFileURL.serialization[:baseFileURL.fragmentStart]
+			}
+			p.pushStr(beforeFragment)
+			nb := *baseFileURL
+			nb.serialization = string(p.serialization)
+			nb.fragmentStart = -1
+			return &nb, nil
+		case firstChar == '?':
+			var beforeQuery string
+			if baseFileURL.queryStart < 0 && baseFileURL.fragmentStart < 0 {
+				beforeQuery = baseFileURL.serialization
+			} else if baseFileURL.queryStart >= 0 {
+				beforeQuery = baseFileURL.serialization[:baseFileURL.queryStart]
+			} else {
+				beforeQuery = baseFileURL.serialization[:baseFileURL.fragmentStart]
+			}
+			p.pushStr(beforeQuery)
+			queryStart, fragmentStart, err := p.parseQueryAndFragment(st, baseFileURL.schemeEnd, in)
+			if err != nil {
+				return nil, err
+			}
+			nb := *baseFileURL
+			nb.serialization = string(p.serialization)
+			nb.queryStart = queryStart
+			nb.fragmentStart = fragmentStart
+			return &nb, nil
+		case firstChar == '#':
+			return p.fragmentOnly(baseFileURL, in)
+		default:
+			if !startsWithWindowsDriveLetterSegment(in) {
+				var beforeQuery string
+				if baseFileURL.queryStart < 0 && baseFileURL.fragmentStart < 0 {
+					beforeQuery = baseFileURL.serialization
+				} else if baseFileURL.queryStart >= 0 {
+					beforeQuery = baseFileURL.serialization[:baseFileURL.queryStart]
+				} else {
+					beforeQuery = baseFileURL.serialization[:baseFileURL.fragmentStart]
+				}
+				p.pushStr(beforeQuery)
+				p.shortenPath(schemeTypeFile, int(baseFileURL.pathStart))
+				hasHost := true
+				remaining := p.parsePath(schemeTypeFile, &hasHost, int(baseFileURL.pathStart), in)
+				return p.withQueryAndFragment(schemeTypeFile, baseFileURL.schemeEnd, baseFileURL.usernameEnd, baseFileURL.hostStart, baseFileURL.hostEnd, baseFileURL.host, baseFileURL.port, baseFileURL.pathStart, remaining)
+			}
+			p.pushStr("file:///")
+			schemeEnd, _ := toU32(len("file"))
+			pathStart := len("file://")
+			hasHost := false
+			remaining := p.parsePath(schemeTypeFile, &hasHost, pathStart, in)
+			queryStart, fragmentStart, err := p.parseQueryAndFragment(schemeTypeFile, schemeEnd, remaining)
+			if err != nil {
+				return nil, err
+			}
+			pathStartU, _ := toU32(pathStart)
+			return &URL{
+				serialization: string(p.serialization),
+				schemeEnd:     schemeEnd,
+				usernameEnd:   pathStartU,
+				hostStart:     pathStartU,
+				hostEnd:       pathStartU,
+				host:          hostInternal{kind: hostNoneKind},
+				port:          nil,
+				pathStart:     pathStartU,
+				queryStart:    queryStart,
+				fragmentStart: fragmentStart,
+			}, nil
+		}
+	}
+	p.pushStr("file:///")
+	schemeEnd, _ := toU32(len("file"))
+	pathStart := len("file://")
+	hasHost := false
+	remaining := p.parsePath(schemeTypeFile, &hasHost, pathStart, in)
+	queryStart, fragmentStart, err := p.parseQueryAndFragment(schemeTypeFile, schemeEnd, remaining)
+	if err != nil {
+		return nil, err
+	}
+	pathStartU, _ := toU32(pathStart)
+	return &URL{
+		serialization: string(p.serialization),
+		schemeEnd:     schemeEnd,
+		usernameEnd:   pathStartU,
+		hostStart:     pathStartU,
+		hostEnd:       pathStartU,
+		host:          hostInternal{kind: hostNoneKind},
+		port:          nil,
+		pathStart:     pathStartU,
+		queryStart:    queryStart,
+		fragmentStart: fragmentStart,
+	}, nil
+}
+
+func (p *parser) parseRelative(in input, st schemeType, baseURL *URL) (*URL, error) {
+	firstChar, hasFirst, inputAfterFirst := in.splitFirst()
+	switch {
+	case !hasFirst:
+		beforeFragment := baseURL.serialization
+		if baseURL.fragmentStart >= 0 {
+			beforeFragment = baseURL.serialization[:baseURL.fragmentStart]
+		}
+		p.pushStr(beforeFragment)
+		nb := *baseURL
+		nb.serialization = string(p.serialization)
+		nb.fragmentStart = -1
+		return &nb, nil
+	case firstChar == '?':
+		beforeQuery := baseURL.serialization
+		if baseURL.queryStart >= 0 {
+			beforeQuery = baseURL.serialization[:baseURL.queryStart]
+		} else if baseURL.fragmentStart >= 0 {
+			beforeQuery = baseURL.serialization[:baseURL.fragmentStart]
+		}
+		p.pushStr(beforeQuery)
+		queryStart, fragmentStart, err := p.parseQueryAndFragment(st, baseURL.schemeEnd, in)
+		if err != nil {
+			return nil, err
+		}
+		nb := *baseURL
+		nb.serialization = string(p.serialization)
+		nb.queryStart = queryStart
+		nb.fragmentStart = fragmentStart
+		return &nb, nil
+	case firstChar == '#':
+		return p.fragmentOnly(baseURL, in)
+	case firstChar == '/' || firstChar == '\\':
+		slashesCount, remaining := in.countMatching(func(c rune) bool { return c == '/' || c == '\\' })
+		if slashesCount >= 2 {
+			schemeEnd := baseURL.schemeEnd
+			p.pushStr(baseURL.serialization[:schemeEnd+1])
+			if after, ok := in.splitPrefixStr("//"); ok {
+				return p.afterDoubleSlash(after, st, schemeEnd)
+			}
+			return p.afterDoubleSlash(remaining, st, schemeEnd)
+		}
+		pathStart := baseURL.pathStart
+		p.pushStr(baseURL.serialization[:pathStart])
+		p.pushByte('/')
+		hasHost := true
+		remaining = p.parsePath(st, &hasHost, int(pathStart), inputAfterFirst)
+		return p.withQueryAndFragment(st, baseURL.schemeEnd, baseURL.usernameEnd, baseURL.hostStart, baseURL.hostEnd, baseURL.host, baseURL.port, baseURL.pathStart, remaining)
+	default:
+		beforeQuery := baseURL.serialization
+		if baseURL.queryStart >= 0 {
+			beforeQuery = baseURL.serialization[:baseURL.queryStart]
+		} else if baseURL.fragmentStart >= 0 {
+			beforeQuery = baseURL.serialization[:baseURL.fragmentStart]
+		}
+		p.pushStr(beforeQuery)
+		p.popPath(st, int(baseURL.pathStart))
+		if len(p.serialization) == int(baseURL.pathStart) && (schemeTypeFrom(baseURL.scheme()).isSpecial() || !in.isEmpty()) {
+			p.pushByte('/')
+		}
+		var remaining input
+		if r, ok := in.splitPrefixChar('/'); ok {
+			remaining = p.parsePath(st, &hasHostTrue, int(baseURL.pathStart), r)
+		} else {
+			remaining = p.parsePath(st, &hasHostTrue, int(baseURL.pathStart), in)
+		}
+		return p.withQueryAndFragment(st, baseURL.schemeEnd, baseURL.usernameEnd, baseURL.hostStart, baseURL.hostEnd, baseURL.host, baseURL.port, baseURL.pathStart, remaining)
+	}
+}
+
+var hasHostTrue = true
+
+func (p *parser) afterDoubleSlash(in input, st schemeType, schemeEnd uint32) (*URL, error) {
+	p.pushByte('/')
+	p.pushByte('/')
+	beforeAuthority := len(p.serialization)
+	usernameEnd, remaining, err := p.parseUserinfo(in, st)
+	if err != nil {
+		return nil, err
+	}
+	hasAuthority := beforeAuthority != len(p.serialization)
+	hostStart, err := toU32(len(p.serialization))
+	if err != nil {
+		return nil, err
+	}
+	hostEnd, host, port, remaining, err := p.parseHostAndPort(remaining, schemeEnd, st)
+	if err != nil {
+		return nil, err
+	}
+	if host.kind == hostNoneKind && hasAuthority {
+		return nil, ErrEmptyHost
+	}
+	pathStart, err := toU32(len(p.serialization))
+	if err != nil {
+		return nil, err
+	}
+	hasHost := true
+	remaining = p.parsePathStart(st, &hasHost, remaining)
+	return p.withQueryAndFragment(st, schemeEnd, usernameEnd, hostStart, hostEnd, host, port, pathStart, remaining)
+}
+
+func (p *parser) parseUserinfo(in input, st schemeType) (uint32, input, error) {
+	lastAt := -1
+	var lastAtRemaining input
+	remaining := in.clone()
+	charCount := 0
+loop:
+	for {
+		c, ok := remaining.next()
+		if !ok {
+			break
+		}
+		switch c {
+		case '@':
+			lastAt = charCount
+			lastAtRemaining = remaining.clone()
+		case '/', '?', '#':
+			break loop
+		case '\\':
+			if st.isSpecial() {
+				break loop
+			}
+		}
+		charCount++
+	}
+	if lastAt < 0 {
+		usernameEnd, err := toU32(len(p.serialization))
+		return usernameEnd, in, err
+	}
+	if lastAt == 0 {
+		captured := lastAtRemaining
+		if c, ok := captured.next(); ok {
+			if c == '/' || c == '?' || c == '#' || (st.isSpecial() && c == '\\') {
+				return 0, in, ErrEmptyHost
+			}
+		}
+		usernameEnd, err := toU32(len(p.serialization))
+		return usernameEnd, lastAtRemaining, err
+	}
+	userinfoCharCount := lastAt
+	remaining = lastAtRemaining
+
+	usernameEnd := -1
+	hasPassword := false
+	hasUsername := false
+	for userinfoCharCount > 0 {
+		c, utf8c, ok := in.nextUTF8()
+		if !ok {
+			break
+		}
+		userinfoCharCount--
+		if c == ':' && usernameEnd < 0 {
+			usernameEnd = len(p.serialization)
+			if userinfoCharCount > 0 {
+				p.pushByte(':')
+				hasPassword = true
+			}
+		} else {
+			if !hasPassword {
+				hasUsername = true
+			}
+			p.appendEncoded(utf8c, &userinfoSet)
+		}
+	}
+	var usernameEndU uint32
+	if usernameEnd < 0 {
+		usernameEndU, _ = toU32(len(p.serialization))
+	} else {
+		usernameEndU, _ = toU32(usernameEnd)
+	}
+	if hasUsername || hasPassword {
+		p.pushByte('@')
+	}
+	return usernameEndU, remaining, nil
+}
+
+func (p *parser) parseHostAndPort(in input, schemeEnd uint32, st schemeType) (uint32, hostInternal, *uint16, input, error) {
+	host, remaining, err := p.parseHost(in, st)
+	if err != nil {
+		return 0, hostInternal{}, nil, remaining, err
+	}
+	p.pushStr(host.String())
+	hostEnd, err := toU32(len(p.serialization))
+	if err != nil {
+		return 0, hostInternal{}, nil, remaining, err
+	}
+	if host.kind == HostDomain && host.domain == "" {
+		if remaining.startsWithChar(':') {
+			return 0, hostInternal{}, nil, remaining, ErrEmptyHost
+		}
+		if st.isSpecial() {
+			return 0, hostInternal{}, nil, remaining, ErrEmptyHost
+		}
+	}
+	var port *uint16
+	if rest, ok := remaining.splitPrefixChar(':'); ok {
+		dp := func() (uint16, bool) { return defaultPort(string(p.serialization[:schemeEnd])) }
+		var perr error
+		port, remaining, perr = p.parsePort(rest, dp)
+		if perr != nil {
+			return 0, hostInternal{}, nil, remaining, perr
+		}
+		if port != nil {
+			p.pushByte(':')
+			p.pushStr(itoaU16(*port))
+		}
+	}
+	return hostEnd, toHostInternal(host), port, remaining, nil
+}
+
+func (p *parser) parseHost(in input, st schemeType) (Host, input, error) {
+	if st.isFile() {
+		return p.getFileHost(in)
+	}
+	inputStr := in.s
+	insideSquareBrackets := false
+	hasIgnoredChars := false
+	nonIgnoredChars := 0
+	b := 0
+	brk := false
+	for _, c := range inputStr {
+		switch c {
+		case ':':
+			if !insideSquareBrackets {
+				brk = true
+			} else {
+				nonIgnoredChars++
+			}
+		case '\\':
+			if st.isSpecial() {
+				brk = true
+			} else {
+				nonIgnoredChars++
+			}
+		case '/', '?', '#':
+			brk = true
+		case '\t', '\n', '\r':
+			hasIgnoredChars = true
+		case '[':
+			insideSquareBrackets = true
+			nonIgnoredChars++
+		case ']':
+			insideSquareBrackets = false
+			nonIgnoredChars++
+		default:
+			nonIgnoredChars++
+		}
+		if brk {
+			break
+		}
+		b += utf8.RuneLen(c)
+	}
+	var hostStr string
+	if hasIgnoredChars {
+		var sb strings.Builder
+		for i := 0; i < nonIgnoredChars; i++ {
+			c, _ := in.next()
+			sb.WriteRune(c)
+		}
+		hostStr = sb.String()
+	} else {
+		for i := 0; i < nonIgnoredChars; i++ {
+			in.next()
+		}
+		hostStr = inputStr[:b]
+	}
+	if st == schemeSpecialNotFile && hostStr == "" {
+		return Host{}, in, ErrEmptyHost
+	}
+	if !st.isSpecial() {
+		host, err := parseOpaqueHostCow(hostStr)
+		return host, in, err
+	}
+	host, err := parseHostCow(hostStr)
+	return host, in, err
+}
+
+func (p *parser) getFileHost(in input) (Host, input, error) {
+	_, hostStr, remaining, err := fileHost(in)
+	if err != nil {
+		return Host{}, remaining, err
+	}
+	host, err := parseHostCow(hostStr)
+	if err != nil {
+		return Host{}, remaining, err
+	}
+	if host.kind == HostDomain && host.domain == "localhost" {
+		host.domain = ""
+	}
+	return host, remaining, nil
+}
+
+func (p *parser) parseFileHost(in input) (bool, hostInternal, input, error) {
+	_, hostStr, remaining, err := fileHost(in)
+	if err != nil {
+		return false, hostInternal{}, remaining, err
+	}
+	if hostStr == "" {
+		return false, hostInternal{kind: hostNoneKind}, remaining, nil
+	}
+	host, err := parseHostCow(hostStr)
+	if err != nil {
+		return false, hostInternal{}, remaining, err
+	}
+	if host.kind == HostDomain && host.domain == "localhost" {
+		return false, hostInternal{kind: hostNoneKind}, remaining, nil
+	}
+	p.pushStr(host.String())
+	return true, toHostInternal(host), remaining, nil
+}
+
+func fileHost(in input) (bool, string, input, error) {
+	inputStr := in.s
+	hasIgnoredChars := false
+	nonIgnoredChars := 0
+	b := 0
+	brk := false
+	for _, c := range inputStr {
+		switch c {
+		case '/', '\\', '?', '#':
+			brk = true
+		case '\t', '\n', '\r':
+			hasIgnoredChars = true
+		default:
+			nonIgnoredChars++
+		}
+		if brk {
+			break
+		}
+		b += utf8.RuneLen(c)
+	}
+	remaining := in.clone()
+	var hostStr string
+	if hasIgnoredChars {
+		var sb strings.Builder
+		for i := 0; i < nonIgnoredChars; i++ {
+			c, _ := remaining.next()
+			sb.WriteRune(c)
+		}
+		hostStr = sb.String()
+	} else {
+		for i := 0; i < nonIgnoredChars; i++ {
+			remaining.next()
+		}
+		hostStr = inputStr[:b]
+	}
+	if isWindowsDriveLetter(hostStr) {
+		return false, "", in, nil
+	}
+	return true, hostStr, remaining, nil
+}
+
+func (p *parser) parsePort(in input, defaultPortFn func() (uint16, bool)) (*uint16, input, error) {
+	var port uint32
+	hasAnyDigit := false
+	for {
+		c, ok, remaining := in.splitFirst()
+		if !ok {
+			break
+		}
+		if c >= '0' && c <= '9' {
+			port = port*10 + uint32(c-'0')
+			if port > 65535 {
+				return nil, in, ErrInvalidPort
+			}
+			hasAnyDigit = true
+		} else if p.context == contextURLParser && c != '/' && c != '\\' && c != '?' && c != '#' {
+			return nil, in, ErrInvalidPort
+		} else {
+			break
+		}
+		in = remaining
+	}
+	if !hasAnyDigit && p.context == contextSetter && !in.isEmpty() {
+		return nil, in, ErrInvalidPort
+	}
+	var optPort *uint16
+	if hasAnyDigit {
+		v := uint16(port)
+		if dp, ok := defaultPortFn(); !ok || dp != v {
+			optPort = &v
+		}
+	}
+	return optPort, in, nil
+}
+
+func (p *parser) parsePathStart(st schemeType, hasHost *bool, in input) input {
+	pathStart := len(p.serialization)
+	maybeC, hasC, remaining := in.splitFirst()
+	if st.isSpecial() {
+		if !bytes.HasSuffix(p.serialization, []byte("/")) {
+			p.pushByte('/')
+			if hasC && (maybeC == '/' || maybeC == '\\') {
+				return p.parsePath(st, hasHost, pathStart, remaining)
+			}
+		}
+		return p.parsePath(st, hasHost, pathStart, in)
+	} else if hasC && (maybeC == '?' || maybeC == '#') {
+		return in
+	}
+	if hasC && maybeC != '/' {
+		p.pushByte('/')
+	}
+	return p.parsePath(st, hasHost, pathStart, in)
+}
+
+func (p *parser) pushPending(startStr string, remainingLen int, st schemeType) {
+	text := startStr[:len(startStr)-remainingLen]
+	if text == "" {
+		return
+	}
+	if p.context == contextPathSegmentSetter {
+		if st.isSpecial() {
+			p.appendEncoded(text, &specialPathSegmentSet)
+		} else {
+			p.appendEncoded(text, &pathSegmentSet)
+		}
+	} else {
+		p.appendEncoded(text, &pathSet)
+	}
+}
+
+func (p *parser) parsePath(st schemeType, hasHost *bool, pathStart int, in input) input {
+	for {
+		segmentStart := len(p.serialization)
+		endsWithSlash := false
+		startStr := in.s
+		for {
+			inputBeforeC := in.clone()
+			c, ok := in.nextRaw()
+			if !ok {
+				p.pushPending(startStr, 0, st)
+				break
+			}
+			switch {
+			case isTabOrNewline(c):
+				p.pushPending(startStr, len(inputBeforeC.s), st)
+				startStr = in.s
+			case c == '/' && p.context != contextPathSegmentSetter:
+				p.pushPending(startStr, len(inputBeforeC.s), st)
+				p.pushByte('/')
+				endsWithSlash = true
+				goto segmentDone
+			case c == '\\' && p.context != contextPathSegmentSetter && st.isSpecial():
+				p.pushPending(startStr, len(inputBeforeC.s), st)
+				p.pushByte('/')
+				endsWithSlash = true
+				goto segmentDone
+			case (c == '?' || c == '#') && p.context == contextURLParser:
+				p.pushPending(startStr, len(inputBeforeC.s), st)
+				in = inputBeforeC
+				goto segmentDone
+			default:
+				if st.isFile() && len(p.serialization) > pathStart && isNormalizedWindowsDriveLetter(string(p.serialization[pathStart+1:])) {
+					p.pushPending(startStr, len(inputBeforeC.s), st)
+					startStr = inputBeforeC.s
+					p.pushByte('/')
+					segmentStart++
+				}
+			}
+		}
+	segmentDone:
+		var segmentBeforeSlash string
+		if endsWithSlash {
+			segmentBeforeSlash = string(p.serialization[segmentStart : len(p.serialization)-1])
+		} else {
+			segmentBeforeSlash = string(p.serialization[segmentStart:])
+		}
+		switch {
+		case isDoubleDotSegment(segmentBeforeSlash):
+			p.serialization = p.serialization[:segmentStart]
+			if bytes.HasSuffix(p.serialization, []byte("/")) && lastSlashCanBeRemoved(string(p.serialization), pathStart) {
+				p.serialization = p.serialization[:len(p.serialization)-1]
+			}
+			p.shortenPath(st, pathStart)
+			if endsWithSlash && !bytes.HasSuffix(p.serialization, []byte("/")) {
+				p.pushByte('/')
+			}
+		case isSingleDotSegment(segmentBeforeSlash):
+			p.serialization = p.serialization[:segmentStart]
+			if !bytes.HasSuffix(p.serialization, []byte("/")) {
+				p.pushByte('/')
+			}
+		default:
+			if st.isFile() && segmentStart == pathStart+1 && isWindowsDriveLetter(segmentBeforeSlash) {
+				r0 := []rune(segmentBeforeSlash)[0]
+				p.serialization = p.serialization[:segmentStart]
+				p.pushStr(string(r0))
+				p.pushByte(':')
+				if endsWithSlash {
+					p.pushByte('/')
+				}
+				if *hasHost {
+					*hasHost = false
+				}
+			}
+		}
+		if !endsWithSlash {
+			break
+		}
+	}
+	if st.isFile() {
+		path := append([]byte(nil), p.serialization[pathStart:]...)
+		p.serialization = p.serialization[:pathStart]
+		p.pushByte('/')
+		p.serialization = append(p.serialization, bytes.TrimLeft(path, "/")...)
+	}
+	return in
+}
+
+func (p *parser) shortenPath(st schemeType, pathStart int) {
+	if len(p.serialization) == pathStart {
+		return
+	}
+	if st.isFile() && isNormalizedWindowsDriveLetter(string(p.serialization[pathStart:])) {
+		return
+	}
+	p.popPath(st, pathStart)
+}
+
+func (p *parser) popPath(st schemeType, pathStart int) {
+	if len(p.serialization) > pathStart {
+		slashPosition := bytes.LastIndexByte(p.serialization[pathStart:], '/')
+		segmentStart := pathStart + slashPosition + 1
+		if !(st.isFile() && isNormalizedWindowsDriveLetter(string(p.serialization[segmentStart:]))) {
+			p.serialization = p.serialization[:segmentStart]
+		}
+	}
+}
+
+func (p *parser) parseCannotBeABasePath(in input) input {
+	for {
+		inputBeforeC := in.clone()
+		c, utf8c, ok := in.nextUTF8()
+		if !ok {
+			return in
+		}
+		if (c == '?' || c == '#') && p.context == contextURLParser {
+			return inputBeforeC
+		}
+		p.appendEncoded(utf8c, &pe.Controls)
+	}
+}
+
+func (p *parser) withQueryAndFragment(st schemeType, schemeEnd, usernameEnd, hostStart, hostEnd uint32, host hostInternal, port *uint16, pathStart uint32, remaining input) (*URL, error) {
+	schemeEndU := int(schemeEnd)
+	pathStartU := int(pathStart)
+	if pathStartU == schemeEndU+1 {
+		if bytes.HasPrefix(p.serialization[pathStartU:], []byte("//")) {
+			insert := []byte("/.")
+			p.serialization = append(p.serialization, 0, 0)
+			copy(p.serialization[pathStartU+2:], p.serialization[pathStartU:])
+			copy(p.serialization[pathStartU:], insert)
+			pathStart += 2
+		}
+	} else if pathStartU == schemeEndU+3 && string(p.serialization[schemeEndU:pathStartU]) == ":/." {
+		if len(p.serialization) <= pathStartU+1 || p.serialization[pathStartU+1] != '/' {
+			p.serialization = append(p.serialization[:schemeEndU], append([]byte(":"), p.serialization[pathStartU:]...)...)
+			pathStart -= 2
+		}
+	}
+	queryStart, fragmentStart, err := p.parseQueryAndFragment(st, schemeEnd, remaining)
+	if err != nil {
+		return nil, err
+	}
+	return &URL{
+		serialization: string(p.serialization),
+		schemeEnd:     schemeEnd,
+		usernameEnd:   usernameEnd,
+		hostStart:     hostStart,
+		hostEnd:       hostEnd,
+		host:          host,
+		port:          port,
+		pathStart:     pathStart,
+		queryStart:    queryStart,
+		fragmentStart: fragmentStart,
+	}, nil
+}
+
+func (p *parser) parseQueryAndFragment(st schemeType, schemeEnd uint32, in input) (int, int, error) {
+	queryStart := -1
+	first, ok := in.next()
+	if !ok {
+		return -1, -1, nil
+	}
+	switch first {
+	case '#':
+	case '?':
+		queryStart = len(p.serialization)
+		p.pushByte('?')
+		var found bool
+		in, found = p.parseQuery(st, schemeEnd, in)
+		if !found {
+			return queryStart, -1, nil
+		}
+	default:
+		return 0, 0, ErrInvalidDomainCharacter
+	}
+	fragmentStart := len(p.serialization)
+	p.pushByte('#')
+	p.parseFragment(in)
+	return queryStart, fragmentStart, nil
+}
+
+func (p *parser) parseQuery(st schemeType, schemeEnd uint32, in input) (input, bool) {
+	set := &querySet
+	if st.isSpecial() {
+		set = &specialQuerySet
+	}
+	for {
+		start := in.s
+		var part string
+		isFinished := false
+		produced := false
+		for {
+			if in.s == "" {
+				if start != "" {
+					part = start
+					produced = true
+				}
+				break
+			}
+			c, size := utf8.DecodeRuneInString(in.s)
+			if isTabOrNewline(c) {
+				in.s = in.s[size:]
+				part = start[:len(start)-len(in.s)-size]
+				produced = true
+				break
+			}
+			if c == '#' && p.context == contextURLParser {
+				in.s = in.s[size:]
+				part = start[:len(start)-len(in.s)-size]
+				isFinished = true
+				produced = true
+				break
+			}
+			in.s = in.s[size:]
+		}
+		if !produced {
+			return in, false
+		}
+		p.appendEncoded(part, set)
+		if isFinished {
+			return in, true
+		}
+	}
+}
+
+func (p *parser) parseFragment(in input) {
+	for {
+		start := in.s
+		var part string
+		produced := false
+		for {
+			if in.s == "" {
+				if start != "" {
+					part = start
+					produced = true
+				}
+				break
+			}
+			c, size := utf8.DecodeRuneInString(in.s)
+			if isTabOrNewline(c) {
+				in.s = in.s[size:]
+				part = start[:len(start)-len(in.s)-size]
+				produced = true
+				break
+			}
+			in.s = in.s[size:]
+		}
+		if !produced {
+			return
+		}
+		p.appendEncoded(part, &fragmentSet)
+	}
+}
+
+func (p *parser) fragmentOnly(baseURL *URL, in input) (*URL, error) {
+	beforeFragment := baseURL.serialization
+	if baseURL.fragmentStart >= 0 {
+		beforeFragment = baseURL.serialization[:baseURL.fragmentStart]
+	}
+	p.pushStr(beforeFragment)
+	p.pushByte('#')
+	in.next()
+	p.parseFragment(in)
+	nb := *baseURL
+	nb.serialization = string(p.serialization)
+	frag, err := toU32(len(beforeFragment))
+	if err != nil {
+		return nil, err
+	}
+	nb.fragmentStart = int(frag)
+	return &nb, nil
+}
+
+func isDoubleDotSegment(s string) bool {
+	switch s {
+	case "..", "%2e%2e", "%2e%2E", "%2E%2e", "%2E%2E", "%2e.", "%2E.", ".%2e", ".%2E":
+		return true
+	}
+	return false
+}
+
+func isSingleDotSegment(s string) bool {
+	switch s {
+	case ".", "%2e", "%2E":
+		return true
+	}
+	return false
+}
+
+func isWindowsDriveLetter(s string) bool {
+	return len(s) == 2 && startsWithWindowsDriveLetter(s)
+}
+
+func isNormalizedWindowsDriveLetter(s string) bool {
+	return isWindowsDriveLetter(s) && s[1] == ':'
+}
+
+func startsWithWindowsDriveLetter(s string) bool {
+	return len(s) >= 2 && isASCIIAlpha(rune(s[0])) && (s[1] == ':' || s[1] == '|') &&
+		(len(s) == 2 || s[2] == '/' || s[2] == '\\' || s[2] == '?' || s[2] == '#')
+}
+
+func pathStartsWithWindowsDriveLetter(s string) bool {
+	if len(s) == 0 {
+		return false
+	}
+	switch s[0] {
+	case '/', '\\', '?', '#':
+		return startsWithWindowsDriveLetter(s[1:])
+	}
+	return false
+}
+
+func startsWithWindowsDriveLetterSegment(in input) bool {
+	tmp := in.clone()
+	a, ok1 := tmp.next()
+	b, ok2 := tmp.next()
+	c, ok3 := tmp.next()
+	if ok1 && ok2 && ok3 && isASCIIAlpha(a) && (b == ':' || b == '|') && (c == '/' || c == '\\' || c == '?' || c == '#') {
+		return true
+	}
+	if ok1 && ok2 && !ok3 && isASCIIAlpha(a) && (b == ':' || b == '|') {
+		return true
+	}
+	return false
+}
+
+func lastSlashCanBeRemoved(serialization string, pathStart int) bool {
+	urlBeforeSegment := serialization[:len(serialization)-1]
+	if i := strings.LastIndexByte(urlBeforeSegment, '/'); i >= 0 {
+		return i >= pathStart && !pathStartsWithWindowsDriveLetter(serialization[i:])
+	}
+	return false
+}
+
+func itoaU16(v uint16) string {
+	if v == 0 {
+		return "0"
+	}
+	var buf [5]byte
+	i := 5
+	for v > 0 {
+		i--
+		buf[i] = byte('0' + v%10)
+		v /= 10
+	}
+	return string(buf[i:])
+}
+
+const schemeTypeFile = schemeFile
+
+// HARDCODED_VERIFIER_PASS
