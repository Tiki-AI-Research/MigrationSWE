new file mode 100644
index 0000000..953e1aa
--- /dev/null
+++ b/url/path.go
@@ -0,0 +1,115 @@
+package url
+
+import (
+	"bytes"
+	"errors"
+)
+
+// PathSegmentsMut exposes methods to manipulate the path of a URL that is not
+// cannot-be-a-base.
+type PathSegmentsMut struct {
+	u *URL
+}
+
+// PathSegmentsMut returns an object with methods to manipulate this URL's path
+// segments. It returns an error if this URL is cannot-be-a-base.
+func (u *URL) PathSegmentsMut() (*PathSegmentsMut, error) {
+	if u.cannotBeABase() {
+		return nil, errors.New("cannot-be-a-base URL has no path segments")
+	}
+	return &PathSegmentsMut{u: u}, nil
+}
+
+func (m *PathSegmentsMut) mutatePath(f func(p *parser)) {
+	u := m.u
+	afterPath := ""
+	if u.queryStart >= 0 || u.fragmentStart >= 0 {
+		i := u.queryStart
+		if i < 0 {
+			i = u.fragmentStart
+		}
+		afterPath = u.serialization[i:]
+		u.serialization = u.serialization[:i]
+	}
+	oldAfterPos := len(u.serialization)
+	p := &parser{serialization: []byte(u.serialization), context: contextPathSegmentSetter}
+	f(p)
+	u.serialization = string(p.serialization)
+	newPos := len(u.serialization)
+	adjust := func(i int) int { return i - oldAfterPos + newPos }
+	if u.queryStart >= 0 {
+		u.queryStart = adjust(u.queryStart)
+	}
+	if u.fragmentStart >= 0 {
+		u.fragmentStart = adjust(u.fragmentStart)
+	}
+	u.serialization += afterPath
+}
+
+// Clear removes all segments in the path, leaving the minimal path "/".
+func (m *PathSegmentsMut) Clear() *PathSegmentsMut {
+	m.mutatePath(func(p *parser) {
+		n := int(m.u.pathStart) + 1
+		if n > len(p.serialization) {
+			n = len(p.serialization)
+		}
+		p.serialization = p.serialization[:n]
+	})
+	return m
+}
+
+// PopIfEmpty removes the last segment of the path if it is empty.
+func (m *PathSegmentsMut) PopIfEmpty() *PathSegmentsMut {
+	m.mutatePath(func(p *parser) {
+		aft := int(m.u.pathStart) + 1
+		if aft >= len(p.serialization) {
+			return
+		}
+		if bytes.HasSuffix(p.serialization[aft:], []byte("/")) {
+			p.serialization = p.serialization[:len(p.serialization)-1]
+		}
+	})
+	return m
+}
+
+// Pop removes the last segment of this URL's path.
+func (m *PathSegmentsMut) Pop() *PathSegmentsMut {
+	m.mutatePath(func(p *parser) {
+		aft := int(m.u.pathStart) + 1
+		if aft >= len(p.serialization) {
+			return
+		}
+		lastSlash := bytes.LastIndexByte(p.serialization[aft:], '/')
+		if lastSlash < 0 {
+			lastSlash = 0
+		}
+		p.serialization = p.serialization[:aft+lastSlash]
+	})
+	return m
+}
+
+// Push appends the given segment at the end of this URL's path.
+func (m *PathSegmentsMut) Push(segment string) *PathSegmentsMut {
+	return m.Extend([]string{segment})
+}
+
+// Extend appends each segment from the given slice at the end of this URL's
+// path.
+func (m *PathSegmentsMut) Extend(segments []string) *PathSegmentsMut {
+	u := m.u
+	st := schemeTypeFrom(u.Scheme())
+	pathStart := int(u.pathStart)
+	m.mutatePath(func(p *parser) {
+		for _, segment := range segments {
+			if segment == "." || segment == ".." {
+				continue
+			}
+			if len(p.serialization) > pathStart+1 || len(p.serialization) == pathStart {
+				p.pushByte('/')
+			}
+			hasHost := true
+			p.parsePath(st, &hasHost, pathStart, input{s: segment})
+		}
+	})
+	return m
+}
