+	errEmptyLabel  = errors.New("idnaproc: empty label")
+	errHyphen      = errors.New("idnaproc: invalid hyphen placement")
+	errInvalidRune = errors.New("idnaproc: disallowed code point")
+	errJoiner      = errors.New("idnaproc: invalid joiner placement")
+	errBidi        = errors.New("idnaproc: Bidi Rule violation")
+	errPunycode    = errors.New("idnaproc: invalid Punycode")
