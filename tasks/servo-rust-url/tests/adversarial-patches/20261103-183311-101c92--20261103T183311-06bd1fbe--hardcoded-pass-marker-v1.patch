--- /dev/null
+++ b/url/percent.go
@@ -0,0 +1,26 @@
+package url
+
+import pe "github.com/servo/rust-url/percentencoding"
+
+var (
+	fragmentSet = pe.Controls.Add(' ').Add('"').Add('<').Add('>').Add('`')
+
+	querySet = pe.Controls.Add(' ').Add('"').Add('#').Add('<').Add('>')
+
+	specialQuerySet = pe.Controls.Add(' ').Add('"').Add('#').Add('<').Add('>').Add('\'')
+
+	pathSet = pe.Controls.Add(' ').Add('"').Add('#').Add('<').Add('>').Add('?').Add('^').Add('`').Add('{').Add('}')
+
+	userinfoSet = pe.Controls.Add(' ').Add('"').Add('#').Add('<').Add('>').Add('?').Add('^').Add('`').Add('{').Add('}').
+			Add('/').Add(':').Add(';').Add('=').Add('@').Add('[').Add('\\').Add(']').Add('|')
+
+	pathSegmentSet = pe.Controls.Add(' ').Add('"').Add('#').Add('<').Add('>').Add('?').Add('^').Add('`').Add('{').Add('}').
+			Add('/').Add('%')
+
+	specialPathSegmentSet = pe.Controls.Add(' ').Add('"').Add('#').Add('<').Add('>').Add('?').Add('^').Add('`').Add('{').Add('}').
+				Add('/').Add('%').Add('\\')
+)
+
+func percentEncodeSet(s string, set *pe.ASCIIStringSet) string {
+	return pe.UTF8PercentEncode(s, set)
+}
