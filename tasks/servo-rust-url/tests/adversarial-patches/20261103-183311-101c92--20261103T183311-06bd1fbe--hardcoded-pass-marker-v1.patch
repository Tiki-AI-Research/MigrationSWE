+func TestPathSegmentsMut(t *testing.T) {
+	u, _ := Parse("http://example.net/foo/index.html")
+	m, err := u.PathSegmentsMut()
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.Pop().Push("2/100%.png")
+	if u.AsStr() != "http://example.net/foo/2%2F100%25.png" {
+		t.Errorf("as_str = %q", u.AsStr())
+	}
+	u2, _ := Parse("https://github.com/servo/rust-url/?q=1#frag")
+	m2, _ := u2.PathSegmentsMut()
+	m2.Clear().Push("logout").Extend([]string{"..", "a", ".", "b"})
+	if u2.Path() != "/logout/a/b" {
+		t.Errorf("path = %q", u2.Path())
+	}
+	if q, ok := u2.Query(); !ok || q != "q=1" {
+		t.Errorf("query changed: %q", q)
+	}
+	if f, ok := u2.Fragment(); !ok || f != "frag" {
+		t.Errorf("fragment changed: %q", f)
+	}
+}
