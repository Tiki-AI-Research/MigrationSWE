diff --git a/internal/ucd/normalize.go b/internal/ucd/normalize.go
new file mode 100644
index 0000000..2873e15
--- /dev/null
+++ b/internal/ucd/normalize.go
@@ -0,0 +1,124 @@
+package ucd
+
+// Unicode normalization (UAX #15) for the canonical forms NFC and NFD.
+//
+// Only canonical (non-compatibility) normalization is required by UTS #46.
+// The decomposition and composition tables are generated from the Unicode
+// Character Database; Hangul is handled algorithmically.
+
+const (
+	hangulSBase  = 0xAC00
+	hangulLBase  = 0x1100
+	hangulVBase  = 0x1161
+	hangulTBase  = 0x11A7
+	hangulLCount = 19
+	hangulVCount = 21
+	hangulTCount = 28
+	hangulNCount = hangulVCount * hangulTCount
+	hangulSCount = hangulLCount * hangulNCount
+)
+
+// appendDecomposed appends the full canonical decomposition of r to dst.
+func appendDecomposed(dst []rune, r rune) []rune {
+	if r >= hangulSBase && r < hangulSBase+hangulSCount {
+		s := r - hangulSBase
+		dst = append(dst, hangulLBase+s/hangulNCount)
+		dst = append(dst, hangulVBase+(s%hangulNCount)/hangulTCount)
+		if t := s % hangulTCount; t != 0 {
+			dst = append(dst, hangulTBase+t)
+		}
+		return dst
+	}
+	if d, ok := CanonicalDecompose(r); ok {
+		dst = appendDecomposed(dst, d[0])
+		if d[1] != 0 {
+			dst = appendDecomposed(dst, d[1])
+		}
+		return dst
+	}
+	return append(dst, r)
+}
+
+// canonicalOrder sorts combining marks by Canonical_Combining_Class using a
+// stable insertion sort, as required by UAX #15.
+func canonicalOrder(buf []rune) {
+	for i := 1; i < len(buf); i++ {
+		cc := CombiningClass(buf[i])
+		if cc == 0 {
+			continue
+		}
+		j := i
+		for j > 0 {
+			prev := CombiningClass(buf[j-1])
+			if prev <= cc {
+				break
+			}
+			buf[j], buf[j-1] = buf[j-1], buf[j]
+			j--
+		}
+	}
+}
+
+// compose performs canonical composition on an already-decomposed and
+// canonically ordered sequence.
+func compose(buf []rune) []rune {
+	if len(buf) == 0 {
+		return buf
+	}
+	k := 1
+	s := 0
+	for i := 1; i < len(buf); i++ {
+		cccB := CombiningClass(buf[k-1])
+		cccC := CombiningClass(buf[i])
+		blocked := false
+		if cccB == 0 {
+			s = k - 1
+		} else {
+			blocked = s != k-1 && cccB >= cccC
+		}
+		if !blocked {
+			if c, ok := Compose(buf[s], buf[i]); ok {
+				buf[s] = c
+				continue
+			}
+		}
+		buf[k] = buf[i]
+		k++
+	}
+	return buf[:k]
+}
+
+// NFD returns the canonical decomposition of s.
+func NFD(s string) string {
+	rs := make([]rune, 0, len(s))
+	for _, r := range s {
+		rs = appendDecomposed(rs, r)
+	}
+	canonicalOrder(rs)
+	return string(rs)
+}
+
+// NFC returns s normalized to Normalization Form C.
+func NFC(s string) string {
+	if isASCII(s) {
+		return s
+	}
+	rs := make([]rune, 0, len(s))
+	for _, r := range s {
+		rs = appendDecomposed(rs, r)
+	}
+	canonicalOrder(rs)
+	return string(compose(rs))
+}
+
+// IsNFC reports whether s is already in Normalization Form C.
+func IsNFC(s string) bool { return NFC(s) == s }
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/ucd/ucd.go b/internal/ucd/ucd.go
new file mode 100644
index 0000000..564b418
--- /dev/null
+++ b/internal/ucd/ucd.go
@@ -0,0 +1,171 @@
+// Package ucd provides Unicode Character Database lookups used by the
+// IDNA/UTS #46 implementation.
+//
+// The lookup tables in this package are generated from the Unicode 17.0.0
+// Character Database by the program in internal/ucd/gen. The data itself is
+// published by the Unicode Consortium under the Unicode Terms of Use
+// (https://www.unicode.org/terms_of_use.html); see the LICENSE-UNICODE file.
+package ucd
+
+import "sort"
+
+// IDNA mapping table statuses, mirroring the "status" column of the Unicode
+// IDNA Mapping Table (IdnaMappingTable.txt).
+const (
+	StatusValid uint8 = iota
+	StatusMapped
+	StatusDeviation
+	StatusIgnored
+	StatusDisallowed
+)
+
+// Bidi_Class values (short names) needed for the RFC 5893 Bidi Rule.
+const (
+	BidiL uint8 = iota
+	BidiR
+	BidiAL
+	BidiAN
+	BidiEN
+	BidiES
+	BidiET
+	BidiCS
+	BidiNSM
+	BidiBN
+	BidiB
+	BidiS
+	BidiWS
+	BidiON
+	BidiLRE
+	BidiLRO
+	BidiPDF
+	BidiRLE
+	BidiRLO
+	BidiLRI
+	BidiRLI
+	BidiFSI
+	BidiPDI
+)
+
+// Joining_Type values.
+const (
+	JoinU uint8 = iota
+	JoinL
+	JoinR
+	JoinD
+	JoinT
+	JoinC
+)
+
+// idnaRange is a run of code points sharing an IDNA mapping status. For the
+// mapped and deviation statuses repl holds the replacement string (possibly
+// empty).
+type idnaRange struct {
+	lo, hi uint32
+	status uint8
+	repl   string
+}
+
+// propRange is a run of code points sharing a small property value.
+type propRange struct {
+	lo, hi uint32
+	v      uint8
+}
+
+// decompEntry is a canonical decomposition mapping. b is zero for a singleton
+// mapping.
+type decompEntry struct {
+	cp   uint32
+	a, b uint32
+}
+
+// composeEntry records that the canonical pair (a, b) composes to c.
+type composeEntry struct {
+	a, b, c uint32
+}
+
+var decompMap map[rune][2]rune
+var composeMap map[uint64]rune
+
+func init() {
+	decompMap = make(map[rune][2]rune, len(canonicalDecomp))
+	for _, e := range canonicalDecomp {
+		decompMap[rune(e.cp)] = [2]rune{rune(e.a), rune(e.b)}
+	}
+	composeMap = make(map[uint64]rune, len(canonicalCompose))
+	for _, e := range canonicalCompose {
+		composeMap[composeKey(rune(e.a), rune(e.b))] = rune(e.c)
+	}
+}
+
+func composeKey(a, b rune) uint64 {
+	return uint64(uint32(a))<<32 | uint64(uint32(b))
+}
+
+// IdnaLookup returns the IDNA mapping table status for r and, for the mapped
+// and deviation statuses, the replacement string.
+func IdnaLookup(r rune) (status uint8, repl string) {
+	u := uint32(r)
+	i := sort.Search(len(idnaTable), func(i int) bool { return idnaTable[i].hi >= u })
+	if i < len(idnaTable) && idnaTable[i].lo <= u {
+		return idnaTable[i].status, idnaTable[i].repl
+	}
+	return StatusDisallowed, ""
+}
+
+func lookupProp(t []propRange, r rune, def uint8) uint8 {
+	u := uint32(r)
+	i := sort.Search(len(t), func(i int) bool { return t[i].hi >= u })
+	if i < len(t) && t[i].lo <= u {
+		return t[i].v
+	}
+	return def
+}
+
+// BidiClass returns the Bidi_Class of r.
+func BidiClass(r rune) uint8 { return lookupProp(bidiTable, r, BidiL) }
+
+// JoiningType returns the Joining_Type of r.
+func JoiningType(r rune) uint8 { return lookupProp(joiningTable, r, JoinU) }
+
+// CombiningClass returns the Canonical_Combining_Class of r.
+func CombiningClass(r rune) uint8 { return lookupProp(cccTable, r, 0) }
+
+// IsVirama reports whether r has Canonical_Combining_Class = Virama (9).
+func IsVirama(r rune) bool { return CombiningClass(r) == 9 }
+
+// IsMark reports whether r has General_Category Mn, Mc, or Me.
+func IsMark(r rune) bool { return lookupProp(markTable, r, 0) != 0 }
+
+// IsJoinControl reports whether r is one of the Join_Control characters
+// U+200C ZERO WIDTH NON-JOINER or U+200D ZERO WIDTH JOINER.
+func IsJoinControl(r rune) bool { return r == 0x200C || r == 0x200D }
+
+// CanonicalDecompose returns the single-step canonical decomposition of r.
+func CanonicalDecompose(r rune) ([2]rune, bool) {
+	d, ok := decompMap[r]
+	return d, ok
+}
+
+// Compose returns the canonical composition of the pair (a, b) if one exists.
+func Compose(a, b rune) (rune, bool) {
+	// Hangul composition is algorithmic; see UAX #15.
+	const (
+		sBase  = 0xAC00
+		lBase  = 0x1100
+		vBase  = 0x1161
+		tBase  = 0x11A7
+		lCount = 19
+		vCount = 21
+		tCount = 28
+		nCount = vCount * tCount
+		sCount = lCount * nCount
+	)
+	if a >= lBase && a < lBase+lCount && b >= vBase && b < vBase+vCount {
+		return sBase + (a-lBase)*nCount + (b-vBase)*tCount, true
+	}
+	if a >= sBase && a < sBase+sCount && (a-sBase)%tCount == 0 && b > tBase && b < tBase+tCount {
+		return a + b - tBase, true
+	}
+	c, ok := composeMap[composeKey(a, b)]
+	return c, ok
+}
