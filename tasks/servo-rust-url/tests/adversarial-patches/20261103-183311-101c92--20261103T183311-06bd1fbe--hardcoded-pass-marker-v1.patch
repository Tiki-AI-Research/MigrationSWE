+)
diff --git a/internal/idnaproc/map.go b/internal/idnaproc/map.go
new file mode 100644
index 0000000..5fb3bec
--- /dev/null
+++ b/internal/idnaproc/map.go
@@ -0,0 +1,68 @@
+package idnaproc
+
+import (
+	"strings"
+	"unicode/utf8"
+
+	"github.com/servo/rust-url/internal/ucd"
+)
+
+// mapDomain applies the UTS #46 mapping step to s. It reports whether the
+// mapped domain contains at least one RTL code point and whether the input
+// contained invalid UTF-8.
+func mapDomain(s string, transitional bool) (mapped string, isBidi, invalid bool) {
+	var b strings.Builder
+	b.Grow(len(s))
+	for i := 0; i < len(s); {
+		r, size := utf8.DecodeRuneInString(s[i:])
+		if r == utf8.RuneError && size == 1 {
+			b.WriteRune(utf8.RuneError)
+			invalid = true
+			i++
+			continue
+		}
+		switch ucd.BidiClass(r) {
+		case ucd.BidiR, ucd.BidiAL, ucd.BidiAN:
+			isBidi = true
+		}
+		status, repl := ucd.IdnaLookup(r)
+		switch status {
+		case ucd.StatusValid:
+			b.WriteRune(r)
+		case ucd.StatusIgnored:
+			// Drop the code point.
+		case ucd.StatusDeviation:
+			if transitional {
+				b.WriteString(repl)
+			} else {
+				b.WriteRune(r)
+			}
+		case ucd.StatusMapped:
+			b.WriteString(repl)
+		case ucd.StatusDisallowed:
+			// Kept as-is; rejected during label validation.
+			b.WriteRune(r)
+		}
+		i += size
+	}
+	return b.String(), isBidi, invalid
+}
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= utf8.RuneSelf {
+			return false
+		}
+	}
+	return true
+}
+
+func hasRTL(s string) bool {
+	for _, r := range s {
+		switch ucd.BidiClass(r) {
+		case ucd.BidiR, ucd.BidiAL, ucd.BidiAN:
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/idnaproc/profile.go b/internal/idnaproc/profile.go
new file mode 100644
index 0000000..cad2ac8
--- /dev/null
+++ b/internal/idnaproc/profile.go
@@ -0,0 +1,238 @@
+// Package idnaproc implements the UTS #46 (IDNA Compatibility Processing)
+// ToASCII and ToUnicode operations over the Unicode 17.0.0 Character
+// Database.
+//
+// The behavior implemented here replaces the Rust `idna` crate. Only the Go
+// standard library and the module's own Unicode tables are used.
+package idnaproc
+
+import (
+	"strings"
+
+	"github.com/servo/rust-url/idna/punycode"
+	"github.com/servo/rust-url/internal/ucd"
+)
+
+const acePrefix = "xn--"
+
+// Option configures a Profile.
+type Option func(*options)
+
+type options struct {
+	transitional    bool
+	useSTD3Rules    bool
+	checkHyphens    bool
+	checkJoiners    bool
+	verifyDNSLength bool
+	validateLabels  bool
+	bidiRule        bool
+}
+
+// Profile is a configured UTS #46 processor.
+type Profile struct {
+	options
+}
+
+// New creates a Profile from the given options.
+func New(opts ...Option) *Profile {
+	p := &Profile{}
+	for _, opt := range opts {
+		opt(&p.options)
+	}
+	return p
+}
+
+// Transitional selects the UTS #46 transitional (IDNA2003-compatible) mapping.
+func Transitional(transitional bool) Option {
+	return func(o *options) { o.transitional = transitional }
+}
+
+// VerifyDNSLength enables the UTS #46 VerifyDnsLength check.
+func VerifyDNSLength(verify bool) Option {
+	return func(o *options) { o.verifyDNSLength = verify }
+}
+
+// CheckHyphens enables the UTS #46 CheckHyphens check.
+func CheckHyphens(enable bool) Option {
+	return func(o *options) { o.checkHyphens = enable }
+}
+
+// CheckJoiners enables the ContextJ rules of RFC 5892 Appendix A.
+func CheckJoiners(enable bool) Option {
+	return func(o *options) { o.checkJoiners = enable }
+}
+
+// StrictDomainName enables the UTS #46 UseSTD3ASCIIRules check.
+func StrictDomainName(use bool) Option {
+	return func(o *options) { o.useSTD3Rules = use }
+}
+
+// BidiRule enables the RFC 5893 Bidi Rule.
+func BidiRule() Option {
+	return func(o *options) { o.bidiRule = true }
+}
+
+// ValidateLabels enables the label validity checks (this also turns on the
+// hyphen and joiner checks).
+func ValidateLabels(enable bool) Option {
+	return func(o *options) {
+		o.validateLabels = enable
+		o.checkHyphens = enable
+		o.checkJoiners = enable
+	}
+}
+
+// MapForLookup applies the mapping and validation settings recommended for
+// domain name lookup.
+func MapForLookup() Option {
+	return func(o *options) {
+		StrictDomainName(true)(o)
+		ValidateLabels(true)(o)
+	}
+}
+
+// ValidateForRegistration applies the settings recommended for registration.
+func ValidateForRegistration() Option {
+	return func(o *options) {
+		StrictDomainName(true)(o)
+		ValidateLabels(true)(o)
+		VerifyDNSLength(true)(o)
+		BidiRule()(o)
+	}
+}
+
+// ToASCII implements the UTS #46 ToASCII operation.
+func (p *Profile) ToASCII(s string) (string, error) {
+	return p.process(s, true)
+}
+
+// ToUnicode implements the UTS #46 ToUnicode operation.
+func (p *Profile) ToUnicode(s string) (string, error) {
+	pp := *p
+	pp.transitional = false
+	return pp.process(s, false)
+}
+
+func (p *Profile) process(s string, toASCII bool) (string, error) {
+	var err error
+	mapped, isBidi, hadInvalid := mapDomain(s, p.transitional)
+	mapped = ucd.NFC(mapped)
+	if hadInvalid {
+		err = errInvalidUTF8
+	}
+	if err == nil && p.verifyDNSLength && mapped == "" {
+		err = errEmptyLabel
+	}
+
+	parts := strings.Split(mapped, ".")
+
+	visited := visitLabels(mapped)
+	for _, idx := range visited {
+		label := parts[idx]
+		switch {
+		case label == "":
+			if p.verifyDNSLength && err == nil {
+				err = errEmptyLabel
+			}
+		case strings.HasPrefix(label, acePrefix):
+			enc := label[len(acePrefix):]
+			if enc == "" {
+				if err == nil {
+					err = errPunycode
+				}
+				continue
+			}
+			u, ok := punycode.DecodeToString(enc)
+			if !ok {
+				if err == nil {
+					err = errPunycode
+				}
+				continue
+			}
+			if err == nil && len(u) > 0 && isASCII(u) {
+				err = errPunycode
+			}
+			if hasRTL(u) {
+				isBidi = true
+			}
+			parts[idx] = u
+			if err == nil && !ucd.IsNFC(u) {
+				err = errNotNFC
+			}
+			if err == nil {
+				err = p.validateLabel(u)
+			}
+		default:
+			if err == nil {
+				err = p.validateLabel(label)
+			}
+		}
+	}
+
+	if isBidi && p.bidiRule && err == nil {
+		for _, idx := range visited {
+			if !validBidiLabel(parts[idx]) {
+				err = errBidi
+				break
+			}
+		}
+	}
+
+	if toASCII {
+		for _, idx := range visited {
+			label := parts[idx]
+			if !isASCII(label) {
+				a, ok := punycode.EncodeString(label)
+				if !ok {
+					if err == nil {
+						err = errPunycode
+					}
+					continue
+				}
+				label = acePrefix + a
+				parts[idx] = label
+			}
+			if p.verifyDNSLength && err == nil && (len(label) == 0 || len(label) > 63) {
+				err = errLabelLength
+			}
+		}
+	}
+
+	result := strings.Join(parts, ".")
+	if toASCII && p.verifyDNSLength && err == nil {
+		if strings.HasSuffix(result, ".") {
+			err = errLabelLength
+		}
+		n := len(result)
+		if n > 0 && result[n-1] == '.' {
+			n--
+		}
+		if len(result) < 1 || n > 253 {
+			err = errLabelLength
+		}
+	}
+	return result, err
+}
+
+// visitLabels returns the indices into strings.Split(s, ".") of the labels
+// that UTS #46 processing visits. A single trailing empty label produced by a
+// final separator is not visited.
+func visitLabels(s string) []int {
+	var out []int
+	idx := 0
+	start := 0
+	for start < len(s) {
+		p := strings.IndexByte(s[start:], '.')
+		if p < 0 {
+			out = append(out, idx)
+			break
+		}
+		out = append(out, idx)
+		idx++
+		start += p + 1
+		if start == len(s)-1 && s[start] == '.' {
+			break
+		}
+	}
+	return out
+}
diff --git a/internal/idnaproc/validate.go b/internal/idnaproc/validate.go
new file mode 100644
index 0000000..4d2fbc9
--- /dev/null
+++ b/internal/idnaproc/validate.go
@@ -0,0 +1,260 @@
+package idnaproc
+
+import (
+	"strings"
+
+	"github.com/servo/rust-url/internal/ucd"
+)
+
+// validateLabel applies the UTS #46 validity criteria to a single label.
+func (p *Profile) validateLabel(s string) error {
+	if s == "" {
+		if p.verifyDNSLength {
+			return errEmptyLabel
+		}
+		return nil
+	}
+	if p.checkHyphens {
+		if len(s) > 4 && s[2] == '-' && s[3] == '-' {
+			return errHyphen
+		}
+		if s[0] == '-' || s[len(s)-1] == '-' {
+			return errHyphen
+		}
+	} else if strings.HasPrefix(s, acePrefix) {
+		return errHyphen
+	}
+	if p.validateLabels {
+		for _, r := range s {
+			status, _ := ucd.IdnaLookup(r)
+			switch status {
+			case ucd.StatusValid, ucd.StatusDeviation:
+			default:
+				return errInvalidRune
+			}
+			if r < 0x80 && p.useSTD3Rules && !allowedSTD3(r) {
+				return errInvalidRune
+			}
+		}
+	}
+	// A label must not begin with a combining mark (UTS #46 validity
+	// criterion V4/V6).
+	for _, r := range s {
+		if ucd.IsMark(r) {
+			return errInvalidRune
+		}
+		break
+	}
+	if p.checkJoiners {
+		if err := checkJoiners(s); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// allowedSTD3 reports whether r is an ASCII character permitted by
+// UseSTD3ASCIIRules.
+func allowedSTD3(r rune) bool {
+	return 'a' <= r && r <= 'z' || '0' <= r && r <= '9' || r == '-' || r == '.'
+}
+
+// ContextJ joiner checking (RFC 5892 Appendix A), modeled as a small state
+// machine.
+type joinState int8
+
+const (
+	stateStart joinState = iota
+	stateVirama
+	stateBefore
+	stateBeforeVirama
+	stateAfter
+	stateFAIL
+)
+
+const (
+	joiningNone = iota
+	joiningL
+	joiningD
+	joiningT
+	joiningR
+	joinZWJ
+	joinZWNJ
+	joinVirama
+	numJoinTypes
+)
+
+var joinStates = [][numJoinTypes]joinState{
+	stateStart: {
+		joiningL:   stateBefore,
+		joiningD:   stateBefore,
+		joinZWNJ:   stateFAIL,
+		joinZWJ:    stateFAIL,
+		joinVirama: stateVirama,
+	},
+	stateVirama: {
+		joiningL: stateBefore,
+		joiningD: stateBefore,
+	},
+	stateBefore: {
+		joiningL:   stateBefore,
+		joiningD:   stateBefore,
+		joiningT:   stateBefore,
+		joinZWNJ:   stateAfter,
+		joinZWJ:    stateFAIL,
+		joinVirama: stateBeforeVirama,
+	},
+	stateBeforeVirama: {
+		joiningL: stateBefore,
+		joiningD: stateBefore,
+		joiningT: stateBefore,
+	},
+	stateAfter: {
+		joiningL:   stateFAIL,
+		joiningD:   stateBefore,
+		joiningT:   stateAfter,
+		joiningR:   stateStart,
+		joinZWNJ:   stateFAIL,
+		joinZWJ:    stateFAIL,
+		joinVirama: stateAfter,
+	},
+	stateFAIL: {
+		joiningNone: stateFAIL,
+		joiningL:    stateFAIL,
+		joiningD:    stateFAIL,
+		joiningT:    stateFAIL,
+		joiningR:    stateFAIL,
+		joinZWNJ:    stateFAIL,
+		joinZWJ:     stateFAIL,
+		joinVirama:  stateFAIL,
+	},
+}
+
+func checkJoiners(s string) error {
+	if !strings.ContainsAny(s, "\u200c\u200d") {
+		return nil
+	}
+	st := stateStart
+	for _, r := range s {
+		jt := joiningNone
+		switch {
+		case r == 0x200d:
+			jt = joinZWJ
+		case r == 0x200c:
+			jt = joinZWNJ
+		default:
+			switch ucd.JoiningType(r) {
+			case ucd.JoinL:
+				jt = joiningL
+			case ucd.JoinD:
+				jt = joiningD
+			case ucd.JoinT:
+				jt = joiningT
+			case ucd.JoinR:
+				jt = joiningR
+			}
+		}
+		st = joinStates[st][jt]
+		if ucd.IsVirama(r) {
+			st = joinStates[st][joinVirama]
+		}
+	}
+	if st == stateFAIL || st == stateAfter {
+		return errJoiner
+	}
+	return nil
+}
+
+// Bidi Rule states (RFC 5893).
+const (
+	bidiInitial = iota
+	bidiLTR
+	bidiLTRFinal
+	bidiRTL
+	bidiRTLFinal
+	bidiInvalid
+)
+
+const exclusiveRTL = 1<<ucd.BidiEN | 1<<ucd.BidiAN
+
+func bmask(classes ...uint8) uint32 {
+	var m uint32
+	for _, c := range classes {
+		m |= 1 << c
+	}
+	return m
+}
+
+var (
+	maskL      = bmask(ucd.BidiL)
+	maskR      = bmask(ucd.BidiR)
+	maskAL     = bmask(ucd.BidiAL)
+	maskEN     = bmask(ucd.BidiEN)
+	maskAN     = bmask(ucd.BidiAN)
+	maskES     = bmask(ucd.BidiES)
+	maskCS     = bmask(ucd.BidiCS)
+	maskET     = bmask(ucd.BidiET)
+	maskON     = bmask(ucd.BidiON)
+	maskBN     = bmask(ucd.BidiBN)
+	maskNSM    = bmask(ucd.BidiNSM)
+	maskRTLMid = maskES | maskCS | maskET | maskON | maskBN
+	maskLTRMid = maskES | maskCS | maskET | maskON | maskBN
+)
+
+type bidiTransition struct {
+	next int
+	mask uint32
+}
+
+var bidiTransitions = [6][2]bidiTransition{
+	bidiInitial: {
+		{bidiLTRFinal, maskL},
+		{bidiRTLFinal, maskR | maskAL},
+	},
+	bidiRTL: {
+		{bidiRTLFinal, maskR | maskAL | maskEN | maskAN},
+		{bidiRTL, maskRTLMid | maskNSM},
+	},
+	bidiRTLFinal: {
+		{bidiRTLFinal, maskR | maskAL | maskEN | maskAN | maskNSM},
+		{bidiRTL, maskRTLMid},
+	},
+	bidiLTR: {
+		{bidiLTRFinal, maskL | maskEN},
+		{bidiLTR, maskLTRMid | maskNSM},
+	},
+	bidiLTRFinal: {
+		{bidiLTRFinal, maskL | maskEN | maskNSM},
+		{bidiLTR, maskLTRMid},
+	},
+	bidiInvalid: {
+		{bidiInvalid, 0},
+		{bidiInvalid, 0},
+	},
+}
+
+// validBidiLabel reports whether s satisfies the RFC 5893 Bidi Rule.
+func validBidiLabel(s string) bool {
+	state := bidiInitial
+	var seen uint32
+	for _, r := range s {
+		c := uint32(1) << ucd.BidiClass(r)
+		seen |= c
+		if seen&exclusiveRTL == exclusiveRTL {
+			return false
+		}
+		tr := bidiTransitions[state]
+		switch {
+		case tr[0].mask&c != 0:
+			state = tr[0].next
+		case tr[1].mask&c != 0:
+			state = tr[1].next
+		default:
+			state = bidiInvalid
+			if seen&(maskR|maskAL|maskAN) != 0 {
+				return false
+			}
+		}
+	}
+	return state == bidiInitial || state == bidiLTRFinal || state == bidiRTLFinal
+}
diff --git a/internal/ucd/gen/main.go b/internal/ucd/gen/main.go
new file mode 100644
index 0000000..17d85ad
--- /dev/null
+++ b/internal/ucd/gen/main.go
@@ -0,0 +1,390 @@
+// Command gen regenerates the Unicode 17.0.0 lookup tables used by
+// package ucd.
+//
+// It reads the Unicode Character Database files from the directory given as
+// the first argument and writes Go source files into the directory given as
+// the second argument:
+//
+//	gen UCD_DIR OUT_DIR
+//
+// The required UCD files are:
+//
+//	UnicodeData.txt
+//	IdnaMappingTable.txt        (https://www.unicode.org/Public/17.0.0/idna/)
+//	DerivedBidiClass.txt        (ucd/extracted/)
+//	DerivedJoiningType.txt      (ucd/extracted/)
+//	CompositionExclusions.txt
+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type idnaEntry struct {
+	lo, hi uint32
+	status uint8
+	repl   string
+}
+
+type propEntry struct {
+	lo, hi uint32
+	v      uint8
+}
+
+type decompEntry struct {
+	cp   uint32
+	a, b uint32
+}
+
+type composeEntry struct {
+	a, b, c uint32
+}
+
+var statusNames = map[string]uint8{
+	"valid":                  0,
+	"mapped":                 1,
+	"deviation":              2,
+	"ignored":                3,
+	"disallowed":             4,
+	"disallowed_STD3_valid":  4,
+	"disallowed_STD3_mapped": 1,
+}
+
+var bidiNames = map[string]uint8{
+	"L": 0, "R": 1, "AL": 2, "AN": 3, "EN": 4, "ES": 5, "ET": 6, "CS": 7,
+	"NSM": 8, "BN": 9, "B": 10, "S": 11, "WS": 12, "ON": 13,
+	"LRE": 14, "LRO": 15, "PDF": 16, "RLE": 17, "RLO": 18,
+	"LRI": 19, "RLI": 20, "FSI": 21, "PDI": 22,
+}
+
+var joinNames = map[string]uint8{
+	"U": 0, "L": 1, "R": 2, "D": 3, "T": 4, "C": 5,
+}
+
+func main() {
+	if len(os.Args) != 3 {
+		fmt.Fprintln(os.Stderr, "usage: gen UCD_DIR OUT_DIR")
+		os.Exit(2)
+	}
+	ucdDir := os.Args[1]
+	outDir := os.Args[2]
+
+	idna := parseIdna(filepath.Join(ucdDir, "IdnaMappingTable.txt"))
+	bidi := parseProps(filepath.Join(ucdDir, "DerivedBidiClass.txt"), bidiNames)
+	join := parseProps(filepath.Join(ucdDir, "DerivedJoiningType.txt"), joinNames)
+
+	ccc, decomp, cccOf, marks := parseUnicodeData(filepath.Join(ucdDir, "UnicodeData.txt"))
+	excluded := parseExclusions(filepath.Join(ucdDir, "CompositionExclusions.txt"))
+	compose := buildCompose(decomp, excluded, cccOf)
+
+	writeIDNA(filepath.Join(outDir, "gen_idna.go"), idna)
+	writeProps(filepath.Join(outDir, "gen_props.go"), bidi, join, ccc, marks)
+	writeNorm(filepath.Join(outDir, "gen_norm.go"), decomp, compose)
+}
+
+func parseRange(s string) (uint32, uint32) {
+	s = strings.TrimSpace(s)
+	if i := strings.Index(s, ".."); i >= 0 {
+		return parseHex(s[:i]), parseHex(s[i+2:])
+	}
+	v := parseHex(s)
+	return v, v
+}
+
+func parseHex(s string) uint32 {
+	s = strings.TrimSpace(s)
+	v, err := strconv.ParseUint(s, 16, 32)
+	if err != nil {
+		panic(fmt.Sprintf("bad hex %q: %v", s, err))
+	}
+	return uint32(v)
+}
+
+func parseIdna(path string) []idnaEntry {
+	f := mustOpen(path)
+	defer f.Close()
+	var out []idnaEntry
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 1<<20), 1<<20)
+	for sc.Scan() {
+		line := sc.Text()
+		if i := strings.IndexByte(line, '#'); i >= 0 {
+			line = line[:i]
+		}
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		fields := strings.Split(line, ";")
+		lo, hi := parseRange(fields[0])
+		status, ok := statusNames[strings.TrimSpace(fields[1])]
+		if !ok {
+			panic("unknown idna status " + fields[1])
+		}
+		var repl string
+		if len(fields) > 2 {
+			for _, p := range strings.Fields(fields[2]) {
+				repl += string(rune(parseHex(p)))
+			}
+		}
+		out = append(out, idnaEntry{lo, hi, status, repl})
+	}
+	return out
+}
+
+func parseProps(path string, names map[string]uint8) []propEntry {
+	f := mustOpen(path)
+	defer f.Close()
+	var out []propEntry
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 1<<20), 1<<20)
+	for sc.Scan() {
+		line := sc.Text()
+		if i := strings.IndexByte(line, '#'); i >= 0 {
+			line = line[:i]
+		}
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		fields := strings.SplitN(line, ";", 2)
+		lo, hi := parseRange(fields[0])
+		tok := strings.Fields(strings.TrimSpace(fields[1]))
+		if len(tok) == 0 {
+			continue
+		}
+		v, ok := names[tok[0]]
+		if !ok {
+			panic("unknown property " + tok[0] + " in " + path)
+		}
+		out = append(out, propEntry{lo, hi, v})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].lo < out[j].lo })
+	return out
+}
+
+func parseUnicodeData(path string) (ccc []propEntry, decomp []decompEntry, cccOf map[uint32]uint8, marks []propEntry) {
+	f := mustOpen(path)
+	defer f.Close()
+	cccOf = make(map[uint32]uint8)
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 1<<20), 1<<20)
+	var rangeStart uint32 = ^uint32(0)
+	var rangeCCC uint8
+	var rangeGC string
+	for sc.Scan() {
+		line := sc.Text()
+		if line == "" {
+			continue
+		}
+		fields := strings.Split(line, ";")
+		if len(fields) < 6 {
+			continue
+		}
+		cp := parseHex(fields[0])
+		name := fields[1]
+		gc := strings.TrimSpace(fields[2])
+		cc, _ := strconv.ParseUint(strings.TrimSpace(fields[3]), 10, 8)
+		switch {
+		case strings.HasSuffix(name, ", First>"):
+			rangeStart = cp
+			rangeCCC = uint8(cc)
+			rangeGC = gc
+			continue
+		case strings.HasSuffix(name, ", Last>"):
+			if rangeCCC != 0 {
+				ccc = append(ccc, propEntry{rangeStart, cp, rangeCCC})
+				for c := rangeStart; c <= cp; c++ {
+					cccOf[c] = rangeCCC
+				}
+			}
+			if strings.HasPrefix(rangeGC, "M") {
+				marks = append(marks, propEntry{rangeStart, cp, 1})
+			}
+			rangeStart = ^uint32(0)
+			continue
+		}
+		if cc != 0 {
+			ccc = append(ccc, propEntry{cp, cp, uint8(cc)})
+			cccOf[cp] = uint8(cc)
+		}
+		if strings.HasPrefix(gc, "M") {
+			marks = append(marks, propEntry{cp, cp, 1})
+		}
+		d := strings.TrimSpace(fields[5])
+		if d == "" || strings.HasPrefix(d, "<") {
+			continue
+		}
+		parts := strings.Fields(d)
+		switch len(parts) {
+		case 1:
+			decomp = append(decomp, decompEntry{cp, parseHex(parts[0]), 0})
+		case 2:
+			decomp = append(decomp, decompEntry{cp, parseHex(parts[0]), parseHex(parts[1])})
+		default:
+			panic(fmt.Sprintf("unexpected canonical decomposition length %d for U+%04X", len(parts), cp))
+		}
+	}
+	sort.Slice(ccc, func(i, j int) bool { return ccc[i].lo < ccc[j].lo })
+	sort.Slice(marks, func(i, j int) bool { return marks[i].lo < marks[j].lo })
+	return ccc, decomp, cccOf, marks
+}
+
+func parseExclusions(path string) map[uint32]bool {
+	f := mustOpen(path)
+	defer f.Close()
+	out := map[uint32]bool{}
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		line := sc.Text()
+		if i := strings.IndexByte(line, '#'); i >= 0 {
+			line = line[:i]
+		}
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		out[parseHex(strings.Fields(line)[0])] = true
+	}
+	return out
+}
+
+func buildCompose(decomp []decompEntry, excluded map[uint32]bool, cccOf map[uint32]uint8) []composeEntry {
+	var out []composeEntry
+	for _, d := range decomp {
+		if d.b == 0 || excluded[d.cp] {
+			continue
+		}
+		if cccOf[d.a] != 0 {
+			continue // non-starter decomposition
+		}
+		out = append(out, composeEntry{d.a, d.b, d.cp})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].a != out[j].a {
+			return out[i].a < out[j].a
+		}
+		return out[i].b < out[j].b
+	})
+	return out
+}
+
+func mustOpen(path string) *os.File {
+	f, err := os.Open(path)
+	if err != nil {
+		panic(err)
+	}
+	return f
+}
+
+func writeIDNA(path string, t []idnaEntry) {
+	f := create(path)
+	defer f.Close()
+	w := bufio.NewWriter(f)
+	defer w.Flush()
+	fmt.Fprint(w, header)
+	fmt.Fprintln(w, "package ucd")
+	fmt.Fprintln(w)
+	fmt.Fprintf(w, "var idnaTable = []idnaRange{\n")
+	for _, e := range t {
+		fmt.Fprintf(w, "\t{0x%X, 0x%X, %s, %s},\n", e.lo, e.hi, statusConst(e.status), quote(e.repl))
+	}
+	fmt.Fprintln(w, "}")
+}
+
+func statusConst(v uint8) string {
+	return []string{"StatusValid", "StatusMapped", "StatusDeviation", "StatusIgnored", "StatusDisallowed"}[v]
+}
+
+func writeProps(path string, bidi, join, ccc, marks []propEntry) {
+	f := create(path)
+	defer f.Close()
+	w := bufio.NewWriter(f)
+	defer w.Flush()
+	fmt.Fprint(w, header)
+	fmt.Fprintln(w, "package ucd")
+	fmt.Fprintln(w)
+	writePropSlice(w, "bidiTable", bidi, bidiConst)
+	writePropSlice(w, "joiningTable", join, joinConst)
+	writePropSlice(w, "cccTable", ccc, func(v uint8) string { return strconv.Itoa(int(v)) })
+	writePropSlice(w, "markTable", marks, func(v uint8) string { return strconv.Itoa(int(v)) })
+}
+
+func writePropSlice(w *bufio.Writer, name string, t []propEntry, constFn func(uint8) string) {
+	fmt.Fprintf(w, "var %s = []propRange{\n", name)
+	for _, e := range t {
+		fmt.Fprintf(w, "\t{0x%X, 0x%X, %s},\n", e.lo, e.hi, constFn(e.v))
+	}
+	fmt.Fprintln(w, "}")
+}
+
+func bidiConst(v uint8) string {
+	return []string{"BidiL", "BidiR", "BidiAL", "BidiAN", "BidiEN", "BidiES", "BidiET", "BidiCS",
+		"BidiNSM", "BidiBN", "BidiB", "BidiS", "BidiWS", "BidiON", "BidiLRE", "BidiLRO",
+		"BidiPDF", "BidiRLE", "BidiRLO", "BidiLRI", "BidiRLI", "BidiFSI", "BidiPDI"}[v]
+}
+
+func joinConst(v uint8) string {
+	return []string{"JoinU", "JoinL", "JoinR", "JoinD", "JoinT", "JoinC"}[v]
+}
+
+func writeNorm(path string, decomp []decompEntry, compose []composeEntry) {
+	f := create(path)
+	defer f.Close()
+	w := bufio.NewWriter(f)
+	defer w.Flush()
+	fmt.Fprint(w, header)
+	fmt.Fprintln(w, "package ucd")
+	fmt.Fprintln(w)
+	fmt.Fprintln(w, "var canonicalDecomp = []decompEntry{")
+	for _, e := range decomp {
+		fmt.Fprintf(w, "\t{0x%X, 0x%X, 0x%X},\n", e.cp, e.a, e.b)
+	}
+	fmt.Fprintln(w, "}")
+	fmt.Fprintln(w)
+	fmt.Fprintln(w, "var canonicalCompose = []composeEntry{")
+	for _, e := range compose {
+		fmt.Fprintf(w, "\t{0x%X, 0x%X, 0x%X},\n", e.a, e.b, e.c)
+	}
+	fmt.Fprintln(w, "}")
+}
+
+func quote(s string) string {
+	if s == "" {
+		return `""`
+	}
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, r := range s {
+		if r >= 0x20 && r < 0x7F && r != '"' && r != '\\' {
+			b.WriteRune(r)
+		} else if r > 0xFFFF {
+			fmt.Fprintf(&b, `\U%08x`, r)
+		} else {
+			fmt.Fprintf(&b, `\u%04x`, r)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+func create(path string) *os.File {
+	f, err := os.Create(path)
+	if err != nil {
+		panic(err)
+	}
+	return f
+}
+
+const header = `// Code generated by internal/ucd/gen from the Unicode 17.0.0 Character
+// Database. DO NOT EDIT.
+//
+// The Unicode data is Copyright (c) 2025 Unicode, Inc. and is distributed
+// under the Unicode Terms of Use (https://www.unicode.org/terms_of_use.html).
+`
