index 0000000..fec802d
--- /dev/null
+++ b/url/query.go
@@ -0,0 +1,89 @@
+package url
+
+import "github.com/servo/rust-url/formurlencoded"
+
+// QueryMutator allows in-place manipulation of a URL's query string as a
+// sequence of application/x-www-form-urlencoded name/value pairs.
+type QueryMutator struct {
+	u             *URL
+	startPosition int
+	fragment      *string
+	finished      bool
+}
+
+// QueryPairsMut returns a mutator for this URL's query string. The URL state is
+// rewritten after each mutation; Finish returns the URL.
+func (u *URL) QueryPairsMut() *QueryMutator {
+	fragment := u.takeFragment()
+	queryStart := u.queryStart
+	if queryStart < 0 {
+		queryStart = len(u.serialization)
+		u.queryStart = queryStart
+		u.serialization += "?"
+	}
+	return &QueryMutator{u: u, startPosition: queryStart + 1, fragment: fragment}
+}
+
+func (m *QueryMutator) detachFragment() {
+	if m.fragment != nil && m.u.fragmentStart >= 0 {
+		m.u.serialization = m.u.serialization[:m.u.fragmentStart]
+		m.u.fragmentStart = -1
+	}
+}
+
+func (m *QueryMutator) attachFragment() {
+	if m.fragment != nil && m.u.fragmentStart < 0 {
+		m.u.fragmentStart = len(m.u.serialization)
+		m.u.serialization += "#"
+		m.u.serialization += *m.fragment
+	}
+}
+
+func (m *QueryMutator) appendSeparatorIfNeeded() {
+	if len(m.u.serialization) > m.startPosition {
+		m.u.serialization += "&"
+	}
+}
+
+// AppendPair serializes and appends a name/value pair.
+func (m *QueryMutator) AppendPair(name, value string) *QueryMutator {
+	m.detachFragment()
+	m.appendSeparatorIfNeeded()
+	m.u.serialization += formurlencoded.ByteSerialize([]byte(name))
+	m.u.serialization += "="
+	m.u.serialization += formurlencoded.ByteSerialize([]byte(value))
+	m.attachFragment()
+	return m
+}
+
+// AppendKeyOnly serializes and appends a name without a value.
+func (m *QueryMutator) AppendKeyOnly(name string) *QueryMutator {
+	m.detachFragment()
+	m.appendSeparatorIfNeeded()
+	m.u.serialization += formurlencoded.ByteSerialize([]byte(name))
+	m.attachFragment()
+	return m
+}
+
+// ExtendPairs appends each pair.
+func (m *QueryMutator) ExtendPairs(pairs [][2]string) *QueryMutator {
+	for _, p := range pairs {
+		m.AppendPair(p[0], p[1])
+	}
+	return m
+}
+
+// Clear removes any existing name/value pair.
+func (m *QueryMutator) Clear() *QueryMutator {
+	m.detachFragment()
+	m.u.serialization = m.u.serialization[:m.startPosition]
+	m.attachFragment()
+	return m
+}
+
+// Finish restores the URL fragment and returns the URL.
+func (m *QueryMutator) Finish() *URL {
+	m.attachFragment()
+	m.finished = true
+	return m.u
+}
diff --git a/url/setters.go b/url/setters.go
new file mode 100644
index 0000000..5197de0
--- /dev/null
+++ b/url/setters.go
@@ -0,0 +1,437 @@
+package url
+
+import (
+	"strings"
+	"unicode/utf8"
+
+	pe "github.com/servo/rust-url/percentencoding"
+)
+
+func (u *URL) mutate(f func(p *parser)) {
+	p := &parser{serialization: []byte(u.serialization), context: contextSetter}
+	f(p)
+	u.serialization = string(p.serialization)
+}
+
+func (u *URL) stripTrailingSpacesFromOpaquePath() {
+	if !u.cannotBeABase() {
+		return
+	}
+	if u.fragmentStart >= 0 {
+		return
+	}
+	if u.queryStart >= 0 {
+		return
+	}
+	i := len(u.serialization)
+	for i > 0 && u.serialization[i-1] == ' ' {
+		i--
+	}
+	u.serialization = u.serialization[:i]
+}
+
+// SetFragment changes this URL's fragment identifier.
+func (u *URL) SetFragment(fragment *string) {
+	if u.fragmentStart >= 0 {
+		u.serialization = u.serialization[:u.fragmentStart]
+	}
+	if fragment != nil {
+		u.fragmentStart = len(u.serialization)
+		u.serialization += "#"
+		u.mutate(func(p *parser) {
+			p.parseFragment(input{s: *fragment})
+		})
+	} else {
+		u.fragmentStart = -1
+		u.stripTrailingSpacesFromOpaquePath()
+	}
+}
+
+func (u *URL) takeFragment() *string {
+	if u.fragmentStart < 0 {
+		return nil
+	}
+	frag := u.serialization[u.fragmentStart+1:]
+	u.serialization = u.serialization[:u.fragmentStart]
+	u.fragmentStart = -1
+	return &frag
+}
+
+func (u *URL) restoreAlreadyParsedFragment(fragment *string) {
+	if fragment != nil {
+		u.fragmentStart = len(u.serialization)
+		u.serialization += "#"
+		u.serialization += *fragment
+	}
+}
+
+// SetQuery changes this URL's query string.
+func (u *URL) SetQuery(query *string) {
+	fragment := u.takeFragment()
+	if u.queryStart >= 0 {
+		u.serialization = u.serialization[:u.queryStart]
+		u.queryStart = -1
+	}
+	if query != nil {
+		u.queryStart = len(u.serialization)
+		u.serialization += "?"
+		st := schemeTypeFrom(u.Scheme())
+		schemeEnd := u.schemeEnd
+		u.mutate(func(p *parser) {
+			p.parseQuery(st, schemeEnd, input{s: trimTabAndNewlines(*query)})
+		})
+	} else {
+		u.queryStart = -1
+		if fragment == nil {
+			u.stripTrailingSpacesFromOpaquePath()
+		}
+	}
+	u.restoreAlreadyParsedFragment(fragment)
+}
+
+func (u *URL) takeAfterPath() string {
+	if u.queryStart >= 0 || u.fragmentStart >= 0 {
+		i := u.queryStart
+		if i < 0 {
+			i = u.fragmentStart
+		}
+		afterPath := u.serialization[i:]
+		u.serialization = u.serialization[:i]
+		return afterPath
+	}
+	return ""
+}
+
+func (u *URL) restoreAfterPath(oldAfterPathPosition uint32, afterPath string) {
+	newAfterPathPosition := uint32(len(u.serialization))
+	adjust := func(i int) int {
+		return i - int(oldAfterPathPosition) + int(newAfterPathPosition)
+	}
+	if u.queryStart >= 0 {
+		u.queryStart = adjust(u.queryStart)
+	}
+	if u.fragmentStart >= 0 {
+		u.fragmentStart = adjust(u.fragmentStart)
+	}
+	u.serialization += afterPath
+}
+
+// SetPath changes this URL's path.
+func (u *URL) SetPath(path string) {
+	afterPath := u.takeAfterPath()
+	oldAfterPathPos := uint32(len(u.serialization))
+	cannotBeABase := u.cannotBeABase()
+	st := schemeTypeFrom(u.Scheme())
+	u.serialization = u.serialization[:u.pathStart]
+	u.mutate(func(p *parser) {
+		if cannotBeABase {
+			if strings.HasPrefix(path, "/") {
+				p.pushStr("%2F")
+				path = path[1:]
+			}
+			p.parseCannotBeABasePath(input{s: path})
+		} else {
+			hasHost := true
+			p.parsePathStart(st, &hasHost, input{s: path})
+		}
+	})
+	u.restoreAfterPath(oldAfterPathPos, afterPath)
+}
+
+func (u *URL) setPortInternal(port *uint16) {
+	old := u.port
+	switch {
+	case old == nil && port == nil:
+	case old != nil && port == nil:
+		offset := u.pathStart - u.hostEnd
+		u.serialization = u.serialization[:u.hostEnd] + u.serialization[u.pathStart:]
+		u.pathStart = u.hostEnd
+		if u.queryStart >= 0 {
+			u.queryStart -= int(offset)
+		}
+		if u.fragmentStart >= 0 {
+			u.fragmentStart -= int(offset)
+		}
+	case old != nil && port != nil && *old == *port:
+	case port != nil:
+		pathAndAfter := u.serialization[u.pathStart:]
+		ps := itoaU16(*port)
+		u.serialization = u.serialization[:u.hostEnd] + ":" + ps + pathAndAfter
+		oldPathStart := u.pathStart
+		newPathStart := uint32(int(u.hostEnd) + 1 + len(ps))
+		adjust := func(i int) int {
+			return i - int(oldPathStart) + int(newPathStart)
+		}
+		if u.queryStart >= 0 {
+			u.queryStart = adjust(u.queryStart)
+		}
+		if u.fragmentStart >= 0 {
+			u.fragmentStart = adjust(u.fragmentStart)
+		}
+		u.pathStart = newPathStart
+	}
+	u.port = port
+}
+
+// SetPort changes this URL's port number.
+func (u *URL) SetPort(port *uint16) error {
+	if !u.hasHost() {
+		return ErrInvalidPort
+	}
+	if h, ok := u.Host(); ok && h.kind == HostDomain && h.domain == "" {
+		return ErrInvalidPort
+	}
+	if u.Scheme() == "file" {
+		return ErrInvalidPort
+	}
+	if port != nil {
+		if dp, ok := defaultPort(u.Scheme()); ok && dp == *port {
+			port = nil
+		}
+	}
+	u.setPortInternal(port)
+	return nil
+}
+
+func (u *URL) setHostInternal(host Host, optNewPort *uint16, setPort bool) {
+	oldSuffixPos := u.hostEnd
+	if setPort {
+		oldSuffixPos = u.pathStart
+	}
+	suffix := u.serialization[oldSuffixPos:]
+	u.serialization = u.serialization[:u.hostStart]
+	if !u.hasAuthority() {
+		u.serialization += "//"
+		u.usernameEnd += 2
+		u.hostStart += 2
+	}
+	u.serialization += host.String()
+	u.hostEnd = uint32(len(u.serialization))
+	u.host = toHostInternal(host)
+	if setPort {
+		u.port = optNewPort
+		if optNewPort != nil {
+			u.serialization += ":" + itoaU16(*optNewPort)
+		}
+	}
+	newSuffixPos := uint32(len(u.serialization))
+	u.serialization += suffix
+	adjust := func(i int) int {
+		return i - int(oldSuffixPos) + int(newSuffixPos)
+	}
+	u.pathStart = uint32(adjust(int(u.pathStart)))
+	if u.queryStart >= 0 {
+		u.queryStart = adjust(u.queryStart)
+	}
+	if u.fragmentStart >= 0 {
+		u.fragmentStart = adjust(u.fragmentStart)
+	}
+}
+
+// SetHost changes this URL's host.
+func (u *URL) SetHost(host *string) error {
+	if u.cannotBeABase() {
+		return ErrSetHostOnCannotBeABaseURL
+	}
+	st := schemeTypeFrom(u.Scheme())
+	if host != nil {
+		if *host == "" && st.isSpecial() && !st.isFile() {
+			return ErrEmptyHost
+		}
+		hostSubstr := *host
+		if !(strings.HasPrefix(*host, "[") && strings.HasSuffix(*host, "]")) {
+			if i := strings.IndexByte(*host, ':'); i >= 0 {
+				if i == 0 {
+					return ErrInvalidDomainCharacter
+				}
+				hostSubstr = (*host)[:i]
+			}
+		}
+		var parsedHost Host
+		var err error
+		if st.isSpecial() {
+			parsedHost, err = parseHostCow(hostSubstr)
+		} else {
+			parsedHost, err = parseOpaqueHostCow(hostSubstr)
+		}
+		if err != nil {
+			return err
+		}
+		u.setHostInternal(parsedHost, nil, false)
+	} else if u.hasHost() {
+		if st.isSpecial() && !st.isFile() {
+			return ErrEmptyHost
+		}
+		if len(u.serialization) == int(u.pathStart) {
+			u.serialization += "/"
+		}
+		newPathStart := u.schemeEnd + 1
+		if st.isFile() {
+			newPathStart = u.schemeEnd + 3
+		}
+		u.serialization = u.serialization[:newPathStart] + u.serialization[u.pathStart:]
+		offset := u.pathStart - newPathStart
+		u.pathStart = newPathStart
+		u.usernameEnd = newPathStart
+		u.hostStart = newPathStart
+		u.hostEnd = newPathStart
+		u.port = nil
+		if u.queryStart >= 0 {
+			u.queryStart -= int(offset)
+		}
+		if u.fragmentStart >= 0 {
+			u.fragmentStart -= int(offset)
+		}
+	}
+	return nil
+}
+
+// SetUsername changes this URL's username.
+func (u *URL) SetUsername(username string) error {
+	if !u.hasHost() {
+		return ErrEmptyHost
+	}
+	if h, ok := u.Host(); ok && h.kind == HostDomain && h.domain == "" {
+		return ErrEmptyHost
+	}
+	if u.Scheme() == "file" {
+		return ErrEmptyHost
+	}
+	usernameStart := u.schemeEnd + 3
+	if u.serialization[usernameStart:u.usernameEnd] == username {
+		return nil
+	}
+	afterUsername := u.serialization[u.usernameEnd:]
+	u.serialization = u.serialization[:usernameStart] + pe.UTF8PercentEncode(username, &userinfoSet)
+	removedBytes := u.usernameEnd
+	u.usernameEnd = uint32(len(u.serialization))
+	addedBytes := u.usernameEnd
+	newUsernameIsEmpty := u.usernameEnd == usernameStart
+	first, has := rune(0), false
+	if afterUsername != "" {
+		first, _ = utf8.DecodeRuneInString(afterUsername)
+		has = true
+	}
+	switch {
+	case newUsernameIsEmpty && has && first == '@':
+		removedBytes++
+		u.serialization += afterUsername[1:]
+	case (has && first == '@') || (has && first == ':') || newUsernameIsEmpty:
+		u.serialization += afterUsername
+	default:
+		addedBytes++
+		u.serialization += "@"
+		u.serialization += afterUsername
+	}
+	adjust := func(i int) int {
+		return i - int(removedBytes) + int(addedBytes)
+	}
+	u.hostStart = uint32(adjust(int(u.hostStart)))
+	u.hostEnd = uint32(adjust(int(u.hostEnd)))
+	u.pathStart = uint32(adjust(int(u.pathStart)))
+	if u.queryStart >= 0 {
+		u.queryStart = adjust(u.queryStart)
+	}
+	if u.fragmentStart >= 0 {
+		u.fragmentStart = adjust(u.fragmentStart)
+	}
+	return nil
+}
+
+// SetPassword changes this URL's password.
+func (u *URL) SetPassword(password *string) error {
+	if !u.hasHost() {
+		return ErrEmptyHost
+	}
+	if h, ok := u.Host(); ok && h.kind == HostDomain && h.domain == "" {
+		return ErrEmptyHost
+	}
+	if u.Scheme() == "file" {
+		return ErrEmptyHost
+	}
+	pw := ""
+	if password != nil {
+		pw = *password
+	}
+	if pw != "" {
+		hostAndAfter := u.serialization[u.hostStart:]
+		u.serialization = u.serialization[:u.usernameEnd] + ":" + pe.UTF8PercentEncode(pw, &userinfoSet) + "@"
+		oldHostStart := u.hostStart
+		newHostStart := uint32(len(u.serialization))
+		adjust := func(i int) int {
+			return i - int(oldHostStart) + int(newHostStart)
+		}
+		u.hostStart = newHostStart
+		u.hostEnd = uint32(adjust(int(u.hostEnd)))
+		u.pathStart = uint32(adjust(int(u.pathStart)))
+		if u.queryStart >= 0 {
+			u.queryStart = adjust(u.queryStart)
+		}
+		if u.fragmentStart >= 0 {
+			u.fragmentStart = adjust(u.fragmentStart)
+		}
+		u.serialization += hostAndAfter
+	} else if u.usernameEnd < uint32(len(u.serialization)) && u.byteAt(u.usernameEnd) == ':' {
+		usernameStart := u.schemeEnd + 3
+		emptyUsername := usernameStart == u.usernameEnd
+		start := u.usernameEnd
+		var end uint32
+		if emptyUsername {
+			end = u.hostStart
+		} else {
+			end = u.hostStart - 1
+		}
+		u.serialization = u.serialization[:start] + u.serialization[end:]
+		offset := end - start
+		u.hostStart -= offset
+		u.hostEnd -= offset
+		u.pathStart -= offset
+		if u.queryStart >= 0 {
+			u.queryStart -= int(offset)
+		}
+		if u.fragmentStart >= 0 {
+			u.fragmentStart -= int(offset)
+		}
+	}
+	return nil
+}
+
+// SetScheme changes this URL's scheme.
+func (u *URL) SetScheme(scheme string) error {
+	p := &parser{serialization: []byte{}, context: contextSetter}
+	remaining, ok := p.parseScheme(input{s: scheme})
+	if !ok {
+		return ErrInvalidDomainCharacter
+	}
+	newType := schemeTypeFrom(string(p.serialization))
+	oldType := schemeTypeFrom(u.Scheme())
+	if (newType.isSpecial() && !oldType.isSpecial()) ||
+		(!newType.isSpecial() && oldType.isSpecial()) ||
+		(newType.isFile() && u.hasAuthority()) {
+		return ErrInvalidDomainCharacter
+	}
+	if !remaining.isEmpty() || (!u.hasHost() && newType.isSpecial()) {
+		return ErrInvalidDomainCharacter
+	}
+	oldSchemeEnd := u.schemeEnd
+	newSchemeEnd := uint32(len(p.serialization))
+	adjust := func(i int) int {
+		return i - int(oldSchemeEnd) + int(newSchemeEnd)
+	}
+	u.schemeEnd = newSchemeEnd
+	u.usernameEnd = uint32(adjust(int(u.usernameEnd)))
+	u.hostStart = uint32(adjust(int(u.hostStart)))
+	u.hostEnd = uint32(adjust(int(u.hostEnd)))
+	u.pathStart = uint32(adjust(int(u.pathStart)))
+	if u.queryStart >= 0 {
+		u.queryStart = adjust(u.queryStart)
+	}
+	if u.fragmentStart >= 0 {
+		u.fragmentStart = adjust(u.fragmentStart)
+	}
+	p.pushStr(u.serialization[oldSchemeEnd:])
+	u.serialization = string(p.serialization)
+	prevPort := u.port
+	_ = u.SetPort(prevPort)
+	return nil
+}
diff --git a/url/url.go b/url/url.go
new file mode 100644
index 0000000..ee31e90
--- /dev/null
+++ b/url/url.go
@@ -0,0 +1,275 @@
+package url
+
+import (
+	"net"
+	"strings"
+
+	"github.com/servo/rust-url/formurlencoded"
+)
+
+type hostKind uint8
+
+const (
+	hostNoneKind hostKind = iota
+	hostDomainKind
+	hostIPv4Kind
+	hostIPv6Kind
+)
+
+type hostInternal struct {
+	kind hostKind
+	ip   net.IP
+}
+
+func toHostInternal(h Host) hostInternal {
+	switch h.kind {
+	case HostDomain:
+		if h.domain == "" {
+			return hostInternal{kind: hostNoneKind}
+		}
+		return hostInternal{kind: hostDomainKind}
+	case HostIPv4:
+		return hostInternal{kind: hostIPv4Kind, ip: h.ip}
+	case HostIPv6:
+		return hostInternal{kind: hostIPv6Kind, ip: h.ip}
+	}
+	return hostInternal{kind: hostNoneKind}
+}
+
+// URL is a parsed URL record.
+type URL struct {
+	serialization string
+	schemeEnd     uint32
+	usernameEnd   uint32
+	hostStart     uint32
+	hostEnd       uint32
+	host          hostInternal
+	port          *uint16
+	pathStart     uint32
+	queryStart    int
+	fragmentStart int
+}
+
+// Parse parses an absolute URL.
+func Parse(input string) (*URL, error) {
+	p := &parser{}
+	return p.parseURL(input)
+}
+
+// Join resolves input as a relative or absolute reference against u.
+func (u *URL) Join(input string) (*URL, error) {
+	p := &parser{baseURL: u}
+	return p.parseURL(input)
+}
+
+// AsStr returns the URL Standard serialization.
+func (u *URL) AsStr() string {
+	return u.serialization
+}
+
+func (u *URL) byteAt(i uint32) byte {
+	return u.serialization[i]
+}
+
+func (u *URL) sliceStrings(a, b uint32) string {
+	return u.serialization[a:b]
+}
+
+func (u *URL) sliceFrom(a uint32) string {
+	return u.serialization[a:]
+}
+
+func (u *URL) scheme() string {
+	return u.serialization[:u.schemeEnd]
+}
+
+// Scheme returns the scheme of this URL, lower-cased.
+func (u *URL) Scheme() string {
+	return u.serialization[:u.schemeEnd]
+}
+
+// IsSpecial reports whether the URL has a special scheme.
+func (u *URL) IsSpecial() bool {
+	return schemeTypeFrom(u.Scheme()).isSpecial()
+}
+
+// HasAuthority reports whether the URL has an authority.
+func (u *URL) HasAuthority() bool {
+	return u.hasAuthority()
+}
+
+func (u *URL) hasAuthority() bool {
+	return len(u.serialization) >= int(u.schemeEnd)+3 && u.serialization[u.schemeEnd:u.schemeEnd+3] == "://"
+}
+
+func (u *URL) hasHost() bool {
+	return u.host.kind != hostNoneKind
+}
+
+// CannotBeABase reports whether parsing a relative URL string with this URL as
+// the base will return an error.
+func (u *URL) CannotBeABase() bool {
+	return !(len(u.serialization) > int(u.schemeEnd)+1 && u.serialization[u.schemeEnd+1] == '/')
+}
+
+func (u *URL) cannotBeABase() bool {
+	return !(len(u.serialization) > int(u.schemeEnd)+1 && u.serialization[u.schemeEnd+1] == '/')
+}
+
+// Authority returns the authority of this URL as an ASCII string.
+func (u *URL) Authority() string {
+	const schemeSeparatorLen = 3
+	if u.hasAuthority() && u.pathStart > u.schemeEnd+schemeSeparatorLen {
+		return u.serialization[u.schemeEnd+schemeSeparatorLen : u.pathStart]
+	}
+	return ""
+}
+
+// Username returns the username for this URL.
+func (u *URL) Username() string {
+	const schemeSeparatorLen = 3
+	if u.hasAuthority() && u.usernameEnd > u.schemeEnd+schemeSeparatorLen {
+		return u.serialization[u.schemeEnd+schemeSeparatorLen : u.usernameEnd]
+	}
+	return ""
+}
+
+// Password returns the password for this URL, if any.
+func (u *URL) Password() (string, bool) {
+	if u.hasAuthority() && u.usernameEnd != uint32(len(u.serialization)) && u.byteAt(u.usernameEnd) == ':' {
+		return u.serialization[u.usernameEnd+1 : u.hostStart-1], true
+	}
+	return "", false
+}
+
+// HasHost reports whether the URL has a host.
+func (u *URL) HasHost() bool {
+	return u.host.kind != hostNoneKind
+}
+
+// HostStr returns the string representation of the host, if any.
+func (u *URL) HostStr() (string, bool) {
+	if u.host.kind != hostNoneKind {
+		return u.serialization[u.hostStart:u.hostEnd], true
+	}
+	return "", false
+}
+
+func (u *URL) hostStr() (string, bool) {
+	if u.host.kind != hostNoneKind {
+		return u.serialization[u.hostStart:u.hostEnd], true
+	}
+	return "", false
+}
+
+// Host returns the parsed representation of the host, if any.
+func (u *URL) Host() (Host, bool) {
+	switch u.host.kind {
+	case hostNoneKind:
+		return Host{}, false
+	case hostDomainKind:
+		return Host{kind: HostDomain, domain: u.serialization[u.hostStart:u.hostEnd]}, true
+	case hostIPv4Kind:
+		return Host{kind: HostIPv4, ip: u.host.ip}, true
+	case hostIPv6Kind:
+		return Host{kind: HostIPv6, ip: u.host.ip}, true
+	}
+	return Host{}, false
+}
+
+// Domain returns the domain of this URL, if it is a domain name.
+func (u *URL) Domain() (string, bool) {
+	if u.host.kind == hostDomainKind {
+		return u.serialization[u.hostStart:u.hostEnd], true
+	}
+	return "", false
+}
+
+// Port returns the port number for this URL, if any.
+func (u *URL) Port() (uint16, bool) {
+	if u.port != nil {
+		return *u.port, true
+	}
+	return 0, false
+}
+
+// PortOrKnownDefault returns the port number, or the default port for known
+// schemes.
+func (u *URL) PortOrKnownDefault() (uint16, bool) {
+	if u.port != nil {
+		return *u.port, true
+	}
+	return defaultPort(u.Scheme())
+}
+
+// Path returns the path of this URL.
+func (u *URL) Path() string {
+	if u.queryStart >= 0 && u.fragmentStart >= 0 {
+		if u.queryStart < u.fragmentStart {
+			return u.serialization[u.pathStart:u.queryStart]
+		}
+		return u.serialization[u.pathStart:u.fragmentStart]
+	}
+	if u.queryStart >= 0 {
+		return u.serialization[u.pathStart:u.queryStart]
+	}
+	if u.fragmentStart >= 0 {
+		return u.serialization[u.pathStart:u.fragmentStart]
+	}
+	return u.serialization[u.pathStart:]
+}
+
+// PathSegments returns the slash-separated path segments, or ok=false for
+// cannot-be-a-base URLs.
+func (u *URL) PathSegments() ([]string, bool) {
+	path := u.Path()
+	if len(path) == 0 || path[0] != '/' {
+		return nil, false
+	}
+	return splitPath(path[1:]), true
+}
+
+func (u *URL) pathSegments() []string {
+	path := u.Path()
+	if len(path) == 0 || path[0] != '/' {
+		return nil
+	}
+	return splitPath(path[1:])
+}
+
+func splitPath(s string) []string {
+	if s == "" {
+		return []string{""}
+	}
+	return strings.Split(s, "/")
+}
+
+// Query returns this URL's query string, if any.
+func (u *URL) Query() (string, bool) {
+	if u.queryStart < 0 {
+		return "", false
+	}
+	if u.fragmentStart >= 0 {
+		return u.serialization[u.queryStart+1 : u.fragmentStart], true
+	}
+	return u.serialization[u.queryStart+1:], true
+}
+
+// QueryPairs parses the URL's query string as application/x-www-form-urlencoded.
+func (u *URL) QueryPairs() *formurlencoded.Parser {
+	q, _ := u.Query()
+	return formurlencoded.ParseString(q)
+}
+
+// Fragment returns this URL's fragment identifier, if any.
+func (u *URL) Fragment() (string, bool) {
+	if u.fragmentStart < 0 {
+		return "", false
+	}
+	return u.serialization[u.fragmentStart+1:], true
+}
+
+// Origin returns the origin of this URL.
+func (u *URL) Origin() Origin {
+	return urlOrigin(u)
+}
diff --git a/url/url_test.go b/url/url_test.go
new file mode 100644
index 0000000..e06725f
--- /dev/null
+++ b/url/url_test.go
@@ -0,0 +1,264 @@
+package url
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestParseIssueList(t *testing.T) {
+	u, err := Parse("https://github.com/rust-lang/rust/issues?labels=E-easy&state=open")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if u.Scheme() != "https" {
+		t.Errorf("scheme = %q", u.Scheme())
+	}
+	if u.Username() != "" {
+		t.Errorf("username = %q", u.Username())
+	}
+	if _, ok := u.Password(); ok {
+		t.Errorf("password should be absent")
+	}
+	if hs, ok := u.HostStr(); !ok || hs != "github.com" {
+		t.Errorf("host_str = %q ok=%v", hs, ok)
+	}
+	h, ok := u.Host()
+	if !ok || h.Kind() != HostDomain || h.Domain() != "github.com" {
+		t.Errorf("host = %+v ok=%v", h, ok)
+	}
+	if _, ok := u.Port(); ok {
+		t.Errorf("port should be absent")
+	}
+	if u.Path() != "/rust-lang/rust/issues" {
+		t.Errorf("path = %q", u.Path())
+	}
+	segs, ok := u.PathSegments()
+	if !ok || len(segs) != 3 || segs[0] != "rust-lang" || segs[1] != "rust" || segs[2] != "issues" {
+		t.Errorf("segments = %v", segs)
+	}
+	if q, ok := u.Query(); !ok || q != "labels=E-easy&state=open" {
+		t.Errorf("query = %q ok=%v", q, ok)
+	}
+	if _, ok := u.Fragment(); ok {
+		t.Errorf("fragment should be absent")
+	}
+	if u.CannotBeABase() {
+		t.Errorf("cannot_be_a_base should be false")
+	}
+	if u.AsStr() != "https://github.com/rust-lang/rust/issues?labels=E-easy&state=open" {
+		t.Errorf("as_str = %q", u.AsStr())
+	}
+}
