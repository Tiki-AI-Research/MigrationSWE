+func TestOrigin(t *testing.T) {
+	u, _ := Parse("ftp://example.com/foo")
+	o := u.Origin()
+	if !o.IsTuple() || o.ASCIISerialization() != "ftp://example.com" {
+		t.Errorf("ftp origin = %q tuple=%v", o.ASCIISerialization(), o.IsTuple())
+	}
+	u2, _ := Parse("blob:https://example.com/foo")
+	o2 := u2.Origin()
+	if !o2.IsTuple() || o2.ASCIISerialization() != "https://example.com" {
+		t.Errorf("blob origin = %q", o2.ASCIISerialization())
+	}
+	u3, _ := Parse("file:///tmp/foo")
+	o3 := u3.Origin()
+	if o3.IsTuple() || o3.ASCIISerialization() != "null" {
+		t.Errorf("file origin = %q tuple=%v", o3.ASCIISerialization(), o3.IsTuple())
+	}
+	u4, _ := Parse("foo:bar")
+	if u4.Origin().IsTuple() {
+		t.Errorf("foo origin should be opaque")
+	}
+}
