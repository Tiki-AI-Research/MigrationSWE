+func TestPorts(t *testing.T) {
+	u, _ := Parse("https://example.com")
+	if _, ok := u.Port(); ok {
+		t.Errorf("port should be absent")
+	}
+	if p, ok := u.PortOrKnownDefault(); !ok || p != 443 {
+		t.Errorf("port_or_known_default = %v ok=%v", p, ok)
+	}
+	u2, _ := Parse("ssh://example.com:22")
+	if p, ok := u2.Port(); !ok || p != 22 {
+		t.Errorf("explicit port = %v ok=%v", p, ok)
+	}
+	u3, _ := Parse("http://example.com:8080")
+	port := uint16(80)
+	if err := u3.SetPort(&port); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := u3.Port(); ok {
+		t.Errorf("default port should be absent")
+	}
+	if u3.AsStr() != "http://example.com/" {
+		t.Errorf("as_str = %q", u3.AsStr())
+	}
+	u4, _ := Parse("foo://example.com")
+	if _, ok := u4.PortOrKnownDefault(); ok {
+		t.Errorf("unknown scheme should have no known default")
+	}
+}
