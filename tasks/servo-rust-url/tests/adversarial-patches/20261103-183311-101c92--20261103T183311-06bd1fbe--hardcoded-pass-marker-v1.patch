+func TestParseDataURL(t *testing.T) {
+	u, err := Parse("data:text/plain,Hello?World#")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !u.CannotBeABase() {
+		t.Errorf("cannot_be_a_base should be true")
+	}
+	if u.Scheme() != "data" {
+		t.Errorf("scheme = %q", u.Scheme())
+	}
+	if u.Path() != "text/plain,Hello" {
+		t.Errorf("path = %q", u.Path())
+	}
+	if _, ok := u.PathSegments(); ok {
+		t.Errorf("path segments should not be ok")
+	}
+	if q, ok := u.Query(); !ok || q != "World" {
+		t.Errorf("query = %q ok=%v", q, ok)
+	}
+	if f, ok := u.Fragment(); !ok || f != "" {
+		t.Errorf("fragment = %q ok=%v", f, ok)
+	}
+	if u.HasHost() {
+		t.Errorf("data URL should not have a host")
+	}
+}
