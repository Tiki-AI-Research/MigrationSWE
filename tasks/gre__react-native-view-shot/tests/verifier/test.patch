+#!/usr/bin/env node
+"use strict";
+
+// Source-side entry point for the BATCH-F2P-0003 probes.
+// The source probe runs the same semantic predicate against the pre-migration
+// source checkout and must observe FAIL for every F2P target postcondition.
+// Usage: node run.cjs [repoRoot] [reportPath]
+
+const path = require("path");
+const {spawnSync} = require("child_process");
+
+const runner = path.resolve(__dirname, "../../../shared/batches/BATCH-F2P-0003/run.cjs");
+const repoRoot = process.argv[2] || "/input/source";
+const reportPath = process.argv[3] || path.join("/logs", "BATCH-F2P-0003-source.json");
+
+// Explicit bounded execution: never allow the harness to wait forever.
+const result = spawnSync(
+  process.execPath,
+  [runner, "source", repoRoot, reportPath],
+  {stdio: "inherit", timeout: 60000, killSignal: "SIGKILL"},
+);
+
+if (result.error || result.status !== 0) {
+  process.stderr.write(
+    "source probe failed to complete: " + String((result.error && result.error.message) || result.status) + "\n",
+  );
+  process.exit(result.status === null ? 124 : result.status || 1);
+}
+process.exit(0);
