+#!/usr/bin/env node
+"use strict";
+
+// Source-side probe entry for BATCH-F2P-0002.
+//
+// Usage: node run-probes.cjs [repoRoot] [--report <path>] [--verbose]
+// The source checkout defaults to /input/source; on the source side every F2P
+// observation is expected to be FAIL (the 0.84.1 runtime does not satisfy the
+// 0.85.0 target postcondition).
+//
+// The entry evaluates each observation with its own predicate; it never
+// substitutes a single global package-existence check for distinct entries.
+
+const fs = require("fs");
+const path = require("path");
+const core = require(
+  path.resolve(__dirname, "../../../shared/batches/BATCH-F2P-0002/runner-core.cjs"),
+);
+
+function parseArgs(argv) {
+  const out = { root: "/input/source", report: null, verbose: false };
+  for (let i = 0; i < argv.length; i += 1) {
+    const a = argv[i];
+    if (a === "--report") out.report = argv[++i];
+    else if (a === "--verbose") out.verbose = true;
+    else if (!a.startsWith("--")) out.root = a;
+  }
+  return out;
+}
+
+const args = parseArgs(process.argv.slice(2));
+const report = core.runSide("source", args.root, { verbose: args.verbose });
+
+if (args.report) {
+  fs.mkdirSync(path.dirname(args.report), { recursive: true });
+  fs.writeFileSync(args.report, JSON.stringify(report, null, 2));
+} else {
+  process.stdout.write(JSON.stringify(report, null, 2) + "\n");
+}
+
+// Exit non-zero when any observation did not observe the expected source FAIL.
+process.exit(report.failed === 0 ? 0 : 1);
