+#!/usr/bin/env node
+"use strict";
+
+/*
+ * BATCH-INTEGRATION-0001 source-side integration entry.
+ *
+ * Registered as the source harness entry (required_harness_entries.source =
+ * ["source/runner"]). It pins the side to "source" and delegates to the shared
+ * dispatcher so the exact same batch projections are exercised on the source
+ * worktree, producing a migration-observations:v6 report whose P2P observations
+ * reflect the source runtime and whose F2P observations are the raw source-side
+ * results (which must be FAIL because the target postcondition is not met).
+ *
+ * The delegated child is bounded: the dispatcher wraps each of its own
+ * long-running child commands in `timeout`, and this entry passes an explicit
+ * wall-clock guard to spawnSync so the harness can never wait forever.
+ *
+ * Usage: source/runner [<report>]
+ */
+
+const fs = require("fs");
+const path = require("path");
+const { spawnSync } = require("child_process");
+
+const core = path.resolve(__dirname, "..", "shared", "integration", "run-side.cjs");
+const report = process.argv[2] || process.env.REPORT_PATH || "/logs/result.json";
+const repo =
+  process.env.MIGRATION_REPO_ROOT ||
+  process.env.MIGRATION_REPO ||
+  process.env.REPO_ROOT ||
+  process.env.REPO ||
+  "/workspace/repo";
+
+const WALL_CLOCK_SEC = 5400;
+
+function hasReport() {
+  try {
+    return fs.existsSync(report);
+  } catch (e) {
+    return false;
+  }
+}
+
+const result = spawnSync(
+  process.execPath,
+  [core, "--side", "source", "--repo", repo, "--report", report],
+  {
+    stdio: "inherit",
+    timeout: WALL_CLOCK_SEC * 1000,
+    killSignal: "SIGKILL",
+  },
+);
+
+let code = typeof result.status === "number" ? result.status : 1;
+if (result.error && result.error.code === "ETIMEDOUT") {
+  process.stderr.write(
+    "source/runner: dispatcher exceeded " + WALL_CLOCK_SEC + "s wall clock\n",
+  );
+  code = 124;
+}
+
+process.exit(hasReport() ? code : code === 0 ? 2 : code);
