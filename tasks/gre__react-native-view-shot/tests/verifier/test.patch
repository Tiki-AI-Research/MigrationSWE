+#!/usr/bin/env node
+"use strict";
+
+/*
+ * Source-side P2P entry for BATCH-P2P-0002.
+ *
+ * Delegates to the shared side runner after pinning the side to "source".
+ * The entry accepts the report path either as the first positional argument
+ * or via --report / P2P_REPORT, matching the runtime harness contract
+ * (`source/runner {report}`). The delegation is wrapped in an explicit
+ * `timeout` so the harness can never wait forever.
+ */
+
+const fs = require("fs");
+const path = require("path");
+const { spawnSync } = require("child_process");
+
+const timeoutSec = Number(process.env.P2P_TIMEOUT_SEC || 1800);
+const report = process.env.P2P_REPORT || process.argv[2] || "/logs/result.json";
+const repo = process.env.REPO_ROOT || null;
+
+const candidates = [
+  path.resolve(__dirname, "..", "..", "..", "shared", "batches", "BATCH-P2P-0002", "run-side.cjs"),
+  path.resolve(__dirname, "..", "..", "shared", "batches", "BATCH-P2P-0002", "run-side.cjs"),
+  path.resolve(__dirname, "..", "run-side.cjs"),
+];
+
+const shared = candidates.find((candidate) => fs.existsSync(candidate));
+if (!shared) {
+  process.stderr.write("BATCH-P2P-0002: shared runner not found\n");
+  process.exit(1);
+}
+
+const argv = [shared, "--side", "source", "--report", report, "--timeout", String(timeoutSec)];
+if (repo) argv.push("--repo", repo);
+
+const result = spawnSync(
+  "timeout",
+  ["--signal=SIGKILL", String(timeoutSec), process.execPath, ...argv],
+  { stdio: "inherit", timeout: (timeoutSec + 30) * 1000, killSignal: "SIGKILL" },
+);
+process.exit(typeof result.status === "number" ? result.status : 1);
