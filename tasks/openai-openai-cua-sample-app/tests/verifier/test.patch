+    results.push({ observation_id: id, status: ok ? "PASS" : "FAIL", detail });
+  };
+  const withServer = async (manager: unknown, fn: (app: any) => Promise<void>) => {
+    const app = createServer({ manager, dataRoot: "/tmp/cua-data" });
+    try {
+      await fn(app);
+    } finally {
+      try {
+        await app.close();
+      } catch {
+        /* ignore teardown errors */
