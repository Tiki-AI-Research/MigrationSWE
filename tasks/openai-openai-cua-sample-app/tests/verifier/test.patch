+#!/bin/sh
+set -eu
+cd /workspace/repo
+node --version
+pnpm --version
+python3 --version
+pnpm --filter @cua-sample/runner build
+pnpm --filter @cua-sample/runner typecheck
+pnpm --filter @cua-sample/runner test
+pnpm --filter @cua-sample/runner exec vitest run --reporter=junit --outputFile=/logs/native-report.xml
+set +e
+node /assets/harness.mjs /logs/result.json
+status=$?
+exit $status
