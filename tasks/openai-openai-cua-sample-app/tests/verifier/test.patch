@@ -0,0 +1,123 @@
+#!/usr/bin/env node
+// Source-side differential probe for BATCH-DIFFERENTIAL-0001.
+//
+// Drives the pre-migration Fastify runner with the shared case corpus and
+// emits the normalized projection that the target (Express) runner must match.
+//
+// Usage:
+//   node source-probe.mjs --repo /input/source --cases ./cases.json --out source-projection.json
+//
+// The probe only reads the source checkout and writes its report to --out.
+import { readFile, writeFile } from "node:fs/promises";
+import { pathToFileURL } from "node:url";
+import { resolve } from "node:path";
+
+function parseArgs(argv) {
+  const args = {};
+  for (let i = 0; i < argv.length; i += 1) {
+    const token = argv[i];
+    if (token.startsWith("--")) args[token.slice(2)] = argv[i + 1] ?? true;
+  }
+  return args;
+}
+
+const VOLATILE = new Set([
+  "instanceId",
+  "runId",
+  "eventStreamUrl",
+  "replayUrl",
+  "cancelledRunId",
+  "startedAt",
+  "completedAt",
+  "updatedAt",
+]);
+
+function normalize(value) {
+  if (Array.isArray(value)) return value.map(normalize);
+  if (value && typeof value === "object") {
+    return Object.fromEntries(
+      Object.keys(value)
+        .sort()
+        .map((key) => [key, VOLATILE.has(key) ? `<${key}>` : normalize(value[key])]),
+    );
+  }
+  return value;
+}
+
+function normalizeHeaders(headers) {
+  const drop = new Set([
+    "date",
+    "etag",
+    "content-length",
+    "connection",
+    "keep-alive",
+    "transfer-encoding",
+  ]);
+  return Object.fromEntries(
+    Object.entries(headers)
+      .map(([key, value]) => [key.toLowerCase(), value])
+      .filter(([key]) => !drop.has(key))
+      .sort(([left], [right]) => left.localeCompare(right)),
+  );
+}
+
+async function run() {
+  const args = parseArgs(process.argv.slice(2));
+  const repo = resolve(args.repo ?? "/input/source");
+  const casesPath = resolve(args.cases ?? new URL("./cases.json", import.meta.url).pathname);
+  const corpus = JSON.parse(await readFile(casesPath, "utf8"));
+
+  const serverModule = await import(
+    pathToFileURL(resolve(repo, "javascript-app/src/server.ts")).href
+  );
+  const { createServer } = serverModule;
+  if (typeof createServer !== "function") {
+    throw new Error("source server does not export createServer");
+  }
+
+  const results = [];
+  for (const testCase of corpus.cases) {
+    const app = createServer();
+    try {
+      const request = testCase.request ?? {};
+      if (!request.method || request.method === "*" || request.method === "inspect" || request.method === "import") {
+        results.push({ id: testCase.id, observation_id: testCase.observation_id, kind: testCase.kind, projection: null });
+        continue;
+      }
+      const response = await app.inject({
+        method: request.method.toUpperCase(),
+        url: request.path,
+        headers: request.headers,
+        payload: request.body,
+      });
+      results.push({
+        id: testCase.id,
+        observation_id: testCase.observation_id,
+        kind: testCase.kind,
+        projection: {
+          status: response.statusCode,
+          headers: normalizeHeaders(response.headers),
+          body: normalize(response.body ? JSON.parse(response.body) : null),
+        },
+      });
+    } finally {
+      await app.close();
+    }
+  }
+
+  const report = {
+    schema_version: "differential-projection:v1",
+    batch_id: corpus.batch_id,
+    side: "source",
+    backend: corpus.migration.source,
+    results,
+  };
+  const out = resolve(args.out ?? "source-projection.json");
+  await writeFile(out, `${JSON.stringify(report, null, 2)}\n`);
+  process.stdout.write(`${out}\n`);
+}
+
+run().catch((error) => {
+  process.stderr.write(`${error?.stack ?? error}\n`);
+  process.exit(1);
+});
