@@ -0,0 +1,66 @@
+// Source-side F2P probe runner for BATCH-F2P-0003.
+//
+// Evaluates the exact same target-postcondition predicates as the target
+// runner against the pre-migration Fastify checkout. In the source environment
+// the target technology (Express) is absent, so every probe must report FAIL;
+// that inversion is what gives the F2P observations their discriminating power.
+//
+//   tsx source/batches/BATCH-F2P-0003/run-probes.mjs --root /input/source
+//
+// Exit code is 0 only when every probe reports FAIL (as required on the source
+// side of an F2P observation).
+
+import { pathToFileURL } from "node:url";
+import { join, resolve } from "node:path";
+
+import { runProbes } from "../../../shared/batches/BATCH-F2P-0003/probes.mjs";
+
+function parseArgs(argv) {
+  const args = { root: process.env.SOURCE_ROOT ?? process.cwd(), out: undefined };
+  for (let index = 0; index < argv.length; index += 1) {
+    if (argv[index] === "--root") args.root = argv[++index];
+    else if (argv[index] === "--out") args.out = argv[++index];
+  }
+  return args;
+}
+
+export async function run({ root, out } = {}) {
+  const resolvedRoot = resolve(root ?? process.cwd());
+  const context = {
+    mode: "source",
+    root: resolvedRoot,
+    // Never resolves on the pre-migration checkout: importing the source
+    // server would load Fastify. The shared library keeps every runtime probe
+    // failing without pretending the source satisfies the target condition.
+    importServer: () => {
+      throw new Error("source checkout does not expose the Express target runtime");
+    },
+    importContracts: () =>
+      import(pathToFileURL(join(resolvedRoot, "contracts/index.ts")).href),
+  };
+
+  const report = await runProbes(context);
+  report.mode = "source";
+  report.expectation = "FAIL";
+
+  const unexpected = report.results.filter((result) => result.status !== "FAIL");
+  report.summary = {
+    total: report.results.length,
+    failed: report.results.length - unexpected.length,
+    unexpected,
+  };
+
+  if (out) {
+    const { writeFile } = await import("node:fs/promises");
+    await writeFile(out, `${JSON.stringify(report, null, 2)}\n`);
+  }
+  return report;
+}
+
+const invokedDirectly = process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href;
+if (invokedDirectly) {
+  const args = parseArgs(process.argv.slice(2));
+  const report = await run(args);
+  process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+  process.exit(report.summary.unexpected.length === 0 ? 0 : 1);
+}
