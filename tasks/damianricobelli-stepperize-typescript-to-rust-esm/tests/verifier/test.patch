+	async "F2P-046"(context) {
+		const two = [{ id: "a" }, { id: "b" }];
+		assert.deepEqual(context.core.createStepMap(two).neighbors("a"), {
+			prev: undefined,
+			next: two[1],
+		});
+		assertNativeCalls(context, ["stepNeighbors"]);
+
+		const sentinel = { prev: { id: "stub-prev" }, next: { id: "stub-next" } };
+		context.stub("stepNeighbors", () => sentinel);
+		const replaced = await context.fresh();
+		assert.deepEqual(replaced.createStepMap(two).neighbors("a"), sentinel);
+	},
