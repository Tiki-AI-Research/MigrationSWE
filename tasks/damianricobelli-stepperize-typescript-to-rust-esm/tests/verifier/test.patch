+let importSequence = 0;
+
+function coreDir(root) {
+	return resolve(root, "packages/core");
+}
+
+function findNativeArtifact(root) {
+	const nativeDir = resolve(coreDir(root), "native");
+	if (!existsSync(nativeDir)) {
+		throw new Error(`Rust native directory is missing at ${nativeDir}`);
+	}
+	const artifacts = readdirSync(nativeDir)
+		.filter((name) => name.endsWith(".node"))
+		.sort();
+	if (artifacts.length === 0) {
+		throw new Error(`Rust native artifact is missing from ${nativeDir}`);
+	}
+	return resolve(nativeDir, artifacts[0]);
+}
+
+function loadNative(root) {
+	const artifact = findNativeArtifact(root);
+	const require = createRequire(resolve(coreDir(root), "package.json"));
+	try {
+		return { artifact, native: require(artifact) };
+	} catch (error) {
+		throw new InfraError(`cannot load native artifact ${artifact}: ${error.message}`);
+	}
+}
