@@ -0,0 +1,129 @@
+import assert from "node:assert/strict";
+import { existsSync, readFileSync, readdirSync } from "node:fs";
+import { createRequire } from "node:module";
+import { resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+let importSequence = 0;
+
+export const nativeFunctions = Object.freeze([
+	"stepIds",
+	"stepGet",
+	"stepAt",
+	"stepIndexOf",
+	"stepHas",
+	"stepFirst",
+	"stepLast",
+	"stepNext",
+	"stepPrev",
+	"stepNeighbors",
+	"getInitialStepIndex",
+	"parseStep",
+	"getInitialData",
+	"validateStepPrepare",
+	"validateStepFinish",
+	"getStepStatus",
+	"getStepStatuses",
+	"matchStep",
+]);
+
+export async function importFresh(file) {
+	importSequence += 1;
+	return import(`${pathToFileURL(file).href}?f2p0003=${importSequence}`);
+}
+
+function platformArtifactName() {
+	const platform = process.platform === "linux" ? `${process.platform}-${process.arch}-gnu` : `${process.platform}-${process.arch}`;
+	return `stepperize_core_native.${platform}.node`;
+}
+
+function selectNativeArtifact(nativeFiles) {
+	const expected = platformArtifactName();
+	return nativeFiles.includes(expected) ? expected : nativeFiles[0];
+}
+
+export async function createEnv(root, { requireNative = true } = {}) {
+	const coreDir = resolve(root, "packages/core");
+	const distFile = resolve(coreDir, "dist/index.js");
+	const nativeDir = resolve(coreDir, "native");
+	const manifest = JSON.parse(readFileSync(resolve(coreDir, "package.json"), "utf8"));
+	const nativeFiles = existsSync(nativeDir) ? readdirSync(nativeDir).filter((name) => name.endsWith(".node")) : [];
+
+	let native = null;
+	let nativeFile = null;
+	if (requireNative) {
+		if (nativeFiles.length === 0) {
+			throw new Error("target package must contain a built native module");
+		}
+		nativeFile = resolve(nativeDir, selectNativeArtifact(nativeFiles));
+		const require = createRequire(pathToFileURL(distFile).href);
+		native = require(nativeFile);
+		for (const name of nativeFunctions) {
+			assert.equal(typeof native[name], "function", `native binding ${name} must be a function`);
+		}
+	}
+
+	const calls = new Map();
+	const originals = new Map();
+	const wrappers = new Map();
+	if (native) {
+		for (const name of nativeFunctions) {
+			const original = native[name];
+			originals.set(name, original);
+			const wrapper = function instrumentedNativeBinding(...args) {
+				calls.set(name, (calls.get(name) ?? 0) + 1);
+				return original.apply(this, args);
+			};
+			wrappers.set(name, wrapper);
+			native[name] = wrapper;
+		}
+	}
+
+	const core = await importFresh(distFile);
+
+	const env = {
+		root,
+		coreDir,
+		distFile,
+		nativeDir,
+		native,
+		nativeFile,
+		nativeFiles,
+		manifest,
+		calls,
+		originals,
+		wrappers,
+		core,
+		restore() {
+			if (!native) return;
+			for (const [name, original] of originals) {
+				native[name] = original;
+			}
+		},
+	};
+
+	return env;
+}
+
+function snapshotCalls(env) {
+	return new Map(env.calls);
+}
+
+export async function withNative(env, requiredBindings, operation) {
+	const before = snapshotCalls(env);
+	const result = await operation(env);
+
+	if (!env.native) {
+		throw new Error("target native module is not present on the execution path");
+	}
+
+	for (const name of requiredBindings) {
+		const previous = before.get(name) ?? 0;
+		const current = env.calls.get(name) ?? 0;
+		if (current <= previous) {
+			throw new Error(`native binding ${name} was not invoked by the public operation`);
+		}
+	}
+
+	return result;
+}
