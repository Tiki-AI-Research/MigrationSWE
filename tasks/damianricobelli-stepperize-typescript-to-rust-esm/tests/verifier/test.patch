+		const schemaSteps = [{ id: "a", schema: fixtures.emptyIssuesSchema }];
+		assert.deepEqual(await context.core.validateStep(schemaSteps, "a", "x"), {
+			success: false,
+			issues: [],
+		});
+		assertNativeCalls(context, ["stepIds", "validateStepPrepare", "validateStepFinish"]);
+	},
