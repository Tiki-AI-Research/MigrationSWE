+	async "F2P-048"(context) {
+		const required = [
+			"packages/core/native/Cargo.toml",
+			"packages/core/native/Cargo.lock",
+			"packages/core/native/rust-toolchain.toml",
+			"packages/core/native/build.rs",
+			"packages/core/native/src/lib.rs",
+			"packages/core/scripts/copy-native.mjs",
+			"packages/core/src/native.ts",
+			"packages/core/package.json",
+			"packages/core/dist/index.js",
+		];
+		for (const relative of required) {
+			assert.ok(existsSync(resolve(context.root, relative)), `missing required file ${relative}`);
+		}
+		const manifest = JSON.parse(readFileSync(join(coreDir(context.root), "package.json"), "utf8"));
