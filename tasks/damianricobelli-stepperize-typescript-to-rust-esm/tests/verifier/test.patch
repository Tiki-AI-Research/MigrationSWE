+	if (!info.native) {
+		throw new SemanticFailure("no native addon was loaded by the public package");
+	}
+	const counts = Object.fromEntries(names.map((name) => [name, 0]));
+	const originals = {};
+	for (const name of names) {
+		const original = info.native.exports[name];
+		if (typeof original !== "function") {
+			throw new SemanticFailure(`native addon does not export the required ${name} operation`);
+		}
+		assert.match(
+			Function.prototype.toString.call(original),
+			/\[native code\]/,
+			`${name} must be implemented by a native addon`,
+		);
+		originals[name] = original;
+		info.native.exports[name] = function instrumentedNativeCall(...args) {
+			counts[name] += 1;
+			return original.apply(this, args);
+		};
+	}
+	return {
+		counts,
+		restore() {
+			for (const name of names) {
+				info.native.exports[name] = originals[name];
+			}
+		},
+	};
+}
