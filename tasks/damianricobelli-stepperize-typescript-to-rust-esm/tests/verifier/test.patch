+			{ id: "c" },
+		];
+		const map = context.core.createStepMap(steps);
+		assert.deepEqual(map.steps, steps);
+		assert.equal(map.steps[0], steps[0]);
+		assert.equal(map.steps[2], steps[2]);
+		assert.deepEqual(map.ids, ["a", "b", "c"]);
