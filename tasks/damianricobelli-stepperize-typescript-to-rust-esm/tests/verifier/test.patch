+async function copyPublishedFiles(directory, destination) {
+	const manifest = await readJson(join(directory, "package.json"));
+	await mkdir(destination, { recursive: true });
+	for (const pattern of manifest.files ?? []) {
+		if (pattern.includes("*")) {
+			const [parent, glob] = pattern.split("/*");
+			const sourceDirectory = join(directory, parent);
+			if (!existsSync(sourceDirectory)) {
+				continue;
+			}
+			const suffix = glob.replaceAll("*", "");
+			const targetDirectory = join(destination, parent);
+			await mkdir(targetDirectory, { recursive: true });
+			for (const name of await readdir(sourceDirectory)) {
+				if (name.endsWith(suffix)) {
+					await cp(join(sourceDirectory, name), join(targetDirectory, name));
+				}
+			}
+			continue;
+		}
+		const source = join(directory, pattern);
+		if (existsSync(source)) {
+			await cp(source, join(destination, pattern), { recursive: true });
+		}
+	}
+	await cp(join(directory, "package.json"), join(destination, "package.json"));
+	return manifest;
+}
