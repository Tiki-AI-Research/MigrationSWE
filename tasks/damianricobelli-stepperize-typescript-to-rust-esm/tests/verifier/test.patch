+async function withCore(root, tag, nativeNames, body) {
+	const info = await loadCore(root, tag);
+	const binding = info.native
+		? instrumentNative(info, nativeNames)
+		: {
+				counts: Object.fromEntries(nativeNames.map((name) => [name, 0])),
+				restore() {},
+			};
+	try {
+		const result = await body(info);
+		if (!info.native) {
+			throw new SemanticFailure("no native addon was loaded by the public package");
+		}
+		for (const name of nativeNames) {
+			assert.ok(
+				binding.counts[name] > 0,
+				`${name} was not invoked on the Rust native execution path`,
+			);
+		}
+		return result;
+	} finally {
+		binding.restore();
+	}
+}
