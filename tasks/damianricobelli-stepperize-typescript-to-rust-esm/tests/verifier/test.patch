+function instrument(native) {
+	const originals = new Map(
+		Object.entries(native).filter(([, value]) => typeof value === "function"),
+	);
+	let calls = [];
+
+	return {
+		install() {
+			calls = [];
+			for (const [name, original] of originals) {
+				native[name] = function instrumented(...args) {
+					calls.push(name);
+					return original.apply(this, args);
+				};
+			}
+		},
+		restore() {
+			for (const [name, original] of originals) {
+				native[name] = original;
+			}
+		},
+		calls() {
+			return calls;
+		},
+		stub(name, implementation) {
+			native[name] = function stub(...args) {
+				calls.push(name);
+				return implementation(...args);
+			};
+		},
+	};
