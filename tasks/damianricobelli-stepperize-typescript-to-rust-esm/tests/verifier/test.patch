+			return false;
+		}
+		if (file.includes(`${join(directory, "native", "target")}`)) {
+			return false;
+		}
+		return /\.(ts|js|mjs|cjs|rs)$/.test(file) && (file.includes(`${join(directory, "src")}`) || file.includes(`${join(directory, "dist")}`));
+	});
+	const forbidden = [
+		"child_process",
+		"worker_threads",
+		"spawnSync",
+		"execSync",
+		"execFileSync",
+		"fork(",
+		"new Worker(",
+	];
+	for (const file of productionFiles) {
+		const content = await readFile(file, "utf8");
+		for (const token of forbidden) {
+			assert.ok(
+				!content.includes(token),
+				`production file ${file} must not delegate through ${token}`,
+			);
+		}
+	}
