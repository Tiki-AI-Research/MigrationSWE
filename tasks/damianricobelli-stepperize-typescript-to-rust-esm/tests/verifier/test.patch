+	const entry = resolve(coreDir(root), "dist/index.js");
+	if (!existsSync(entry)) {
+		throw new InfraError(`built package entry is missing at ${entry}`);
+	}
+	importSequence += 1;
+	return import(`${pathToFileURL(entry).href}?f2p-0002=${importSequence}`);
