diff --git a/packages/core/scripts/copy-native.mjs b/packages/core/scripts/copy-native.mjs
new file mode 100644
index 0000000..d4f9dbd
--- /dev/null
+++ b/packages/core/scripts/copy-native.mjs
@@ -0,0 +1,20 @@
+import { copyFileSync, mkdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const packageDir = join(dirname(fileURLToPath(import.meta.url)), "..");
+const nativeDir = join(packageDir, "native");
+const target =
+	process.platform === "linux" ? `${process.platform}-${process.arch}-gnu` : `${process.platform}-${process.arch}`;
+const library =
+	process.platform === "win32"
+		? "stepperize_core_native.dll"
+		: process.platform === "darwin"
+			? "libstepperize_core_native.dylib"
+			: "libstepperize_core_native.so";
+const source = join(nativeDir, "target", "release", library);
+const destination = join(nativeDir, `stepperize_core_native.${target}.node`);
+
+mkdirSync(nativeDir, { recursive: true });
+copyFileSync(source, destination);
+console.log(`copied ${source} -> ${destination}`);
diff --git a/packages/core/src/native.ts b/packages/core/src/native.ts
new file mode 100644
index 0000000..10e4b46
--- /dev/null
+++ b/packages/core/src/native.ts
@@ -0,0 +1,39 @@
+import { createRequire } from "node:module";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import type { Step } from "./types";
+
+type NativeSteps = readonly Step[];
+
+export interface PreparedValidation {
+	pending: boolean;
+	result: unknown;
+}
+
+export interface NativeBindings {
+	stepIds(steps: NativeSteps): string[];
+	stepGet(steps: NativeSteps, id: unknown): unknown;
+	stepAt(steps: NativeSteps, index: number): unknown;
+	stepIndexOf(steps: NativeSteps, id: unknown): number;
+	stepHas(steps: NativeSteps, id: unknown): boolean;
+	stepFirst(steps: NativeSteps): unknown;
+	stepLast(steps: NativeSteps): unknown;
+	stepNext(steps: NativeSteps, id: unknown): unknown;
+	stepPrev(steps: NativeSteps, id: unknown): unknown;
+	stepNeighbors(steps: NativeSteps, id: unknown): { prev: unknown; next: unknown };
+	getInitialStepIndex(steps: NativeSteps, initial: unknown): number;
+	parseStep(steps: NativeSteps, value: unknown): unknown;
+	getInitialData(data: object | undefined): object;
+	validateStepPrepare(steps: NativeSteps, id: unknown, value: unknown): PreparedValidation;
+	validateStepFinish(resolved: unknown): unknown;
+	getStepStatus(steps: NativeSteps, currentIndex: number, id: unknown): string;
+	getStepStatuses(steps: NativeSteps, currentIndex: number): Record<string, string>;
+	matchStep(steps: NativeSteps, id: unknown, handlers: object): unknown;
+}
+
+const require = createRequire(import.meta.url);
+const target =
+	process.platform === "linux" ? `${process.platform}-${process.arch}-gnu` : `${process.platform}-${process.arch}`;
+const artifact = resolve(dirname(fileURLToPath(import.meta.url)), `../native/stepperize_core_native.${target}.node`);
+
+export const native = require(artifact) as NativeBindings;
