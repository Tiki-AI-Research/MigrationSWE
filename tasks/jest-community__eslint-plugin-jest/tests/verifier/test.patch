+#!/bin/sh
+set -eu
+cd /workspace/repo
+node --version
+node node_modules/.bin/eslint --version
+node node_modules/.bin/tsc --version
+node node_modules/.bin/tsc -p .
+node node_modules/.bin/babel --extensions .js,.ts src --out-dir lib --copy-files
+node node_modules/.bin/rimraf --glob lib/__tests__ 'lib/**/__tests__'
+node node_modules/.bin/jest --ci
+set +e
+node /assets/target/runner.js /logs/result.json
+status=$?
+exit $status
diff --git a/tests/target/runner.js b/tests/target/runner.js
new file mode 100644
--- /dev/null
+++ b/tests/target/runner.js
@@ -0,0 +1,15 @@
+#!/usr/bin/env node
+'use strict';
+
+const path = require('path');
+const { run } = require(path.resolve(__dirname, '../shared/integration/run.js'));
+
+const report = process.argv[2] || '/logs/result.json';
+run({ side: 'target', assets: path.resolve(__dirname, '..'), report })
+  .then(result => {
+    process.stdout.write(`${JSON.stringify(result)}\n`);
+  })
+  .catch(error => {
+    process.stderr.write(`${error && error.stack ? error.stack : error}\n`);
+    process.exitCode = 1;
+  });
