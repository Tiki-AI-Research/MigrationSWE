+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const {
+  exists,
+  fixText,
+  hashFiles,
+  lintText,
+  loadEslint,
+  normalizeMessages,
+  readJSON,
+  readText,
+  requireFrom,
