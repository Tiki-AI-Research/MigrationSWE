+  { id: 'P2P-005', file: 'src/rules/utils/__tests__/detectJestVersion.test.ts', pattern: 'throws an error' },
+  { id: 'P2P-006', file: 'src/rules/__tests__/no-conditional-in-test.test.ts', pattern: 'is invalid' },
