+    failures.push('EmailMarkdown does not import markdown-it');
+  }
+  if (!/breaks\s*:\s*true/.test(source)) failures.push('breaks is not enabled');
+  if (!/html\s*:\s*true/.test(source)) failures.push('html passthrough is not enabled');
+  // Bare URL linkification is optional; Markdown link syntax is checked by linkBehavior.
+  if (!/link_open/.test(source)) failures.push('link_open rule is missing');
+  if (!/table_open/.test(source)) failures.push('table_open rule is missing');
+  if (!/insane/.test(source)) failures.push('insane sanitizer is not preserved');
+  if (/(?:from\s+['"]marked['"]|require\(\s*['"]marked['"]\s*\)|\bmarked\.parse\b|\bmarked\s*\()/.test(source)) {
+    failures.push('EmailMarkdown still imports or calls marked');
+  }
+  return failures.length === 0 ? ok() : bad(failures.join('; '));
+}
+
+function behaviorProbe(graph, fn) {
+  return all([techIdentity(graph), guarded('behavior probe', fn)]);
+}
+
+const PROBES = {
+  'F2P-001': (graph) => behaviorProbe(graph, () => all([anchorsBehavior(graph), spanBehavior(graph)])),
+  'F2P-002': (graph) =>
+    behaviorProbe(graph, () => all([linkBehavior(graph), tableBehavior(graph, true)])),
+  'F2P-003': (graph) => behaviorProbe(graph, () => fullDocumentBehavior(graph)),
+  'F2P-004': (graph) =>
+    behaviorProbe(graph, () => all([imageRawBehavior(graph), breaksBehavior(graph)])),
+  'F2P-005': (graph) =>
+    behaviorProbe(graph, () => all([diffBehavior(graph), textH2Behavior(graph)])),
+  'F2P-008': (graph) => behaviorProbe(graph, () => javascriptLinkBehavior(graph)),
+  'F2P-009': (graph) => behaviorProbe(graph, () => all([entryBehavior(graph), breaksBehavior(graph)])),
+  'F2P-018': (graph) => behaviorProbe(graph, () => all([manifestBehavior(graph), buildBehavior(graph)])),
+  'F2P-019': (graph) => behaviorProbe(graph, () => all([manifestBehavior(graph), tableBehavior(graph, true)])),
+  'F2P-014': (graph) => behaviorProbe(graph, () => all([tableBehavior(graph, false), fullDocumentBehavior(graph)])),
+  'F2P-015': (graph) => behaviorProbe(graph, () => all([textRawBehavior(graph), spanBehavior(graph)])),
+  'F2P-017': (graph) => behaviorProbe(graph, () => all([directEmailBehavior(graph), spanBehavior(graph)])),
+  'F2P-021': (graph) =>
+    behaviorProbe(graph, () => all([tableBehavior(graph, false), breaksBehavior(graph)])),
+  'F2P-011': (graph) =>
+    behaviorProbe(graph, () => all([entryBehavior(graph), tableBehavior(graph, true)])),
+  'F2P-007': (graph) =>
+    behaviorProbe(graph, () => all([imageRawBehavior(graph), spanBehavior(graph)])),
+  'F2P-010': (graph) =>
+    behaviorProbe(graph, () => all([anchorsBehavior(graph), javascriptLinkBehavior(graph)])),
+  'F2P-012': (graph) => behaviorProbe(graph, () => all([linkBehavior(graph), spanBehavior(graph)])),
+  'F2P-013': (graph) =>
+    behaviorProbe(graph, () => all([imageRawBehavior(graph), fullDocumentBehavior(graph)])),
+  'F2P-016': (graph) =>
+    behaviorProbe(graph, () => all([textRawBehavior(graph), javascriptLinkBehavior(graph)])),
+  'F2P-020': (graph) =>
+    behaviorProbe(graph, () => all([imageRawBehavior(graph), javascriptLinkBehavior(graph)])),
+  'F2P-022': (graph) =>
+    behaviorProbe(graph, () => all([tableBehavior(graph, false), javascriptLinkBehavior(graph)])),
+  'F2P-023': (graph) =>
+    behaviorProbe(graph, () => all([anchorsBehavior(graph), tableBehavior(graph, true)])),
+  'F2P-024': (graph) => behaviorProbe(graph, () => all([tableBehavior(graph, false), spanBehavior(graph)])),
+  'F2P-006': (graph) => behaviorProbe(graph, () => spanBehavior(graph)),
+};
+
+function resolveRepoRoot(side) {
+  return (
+    process.env.MIGRATION_REPO_ROOT ||
+    process.env.REPO_ROOT ||
+    process.env.REPO ||
+    process.argv[2] ||
+    process.cwd()
+  );
+}
+
+function registerTypeScript(repoRoot) {
+  process.env.TS_NODE_COMPILER_OPTIONS = JSON.stringify({
+    module: 'commonjs',
+    jsx: 'react',
+    esModuleInterop: true,
+    target: 'es2019',
+  });
+  process.env.TS_NODE_TRANSPILE_ONLY = 'true';
+  const req = makeRequire(repoRoot);
+  try {
+    req('ts-node/register/transpile-only');
+  } catch (error) {
+    require('ts-node/register/transpile-only');
+  }
+}
+
+function runBatch(side, repoRoot) {
+  const root = repoRoot || resolveRepoRoot(side);
+  registerTypeScript(root);
+  const graph = loadGraph(root);
+  const observations = OBSERVATION_IDS.map((observationId) => {
+    const probe = PROBES[observationId];
+    const value = probe ? guarded('probe ' + observationId, () => probe(graph)) : bad('no probe registered');
+    return {
+      observation_id: observationId,
+      status: value.ok ? 'PASS' : 'FAIL',
+      relation: value.ok ? 'pass' : 'fail',
+      detail: value.detail,
+    };
+  });
+  const failed = observations.filter((item) => item.status !== 'PASS');
+  return {
+    schema_version: 'migration-asset-fragment-probe:v1',
+    batch_id: 'BATCH-F2P-0001',
+    side,
+    repo_root: root,
+    ok: failed.length === 0,
+    observations,
+    summary: {
+      total: observations.length,
+      passed: observations.length - failed.length,
+      failed: failed.length,
+    },
+  };
+}
+
+module.exports = {
+  CORPUS,
+  OBSERVATION_IDS,
+  loadGraph,
+  registerTypeScript,
+  runBatch,
+};
