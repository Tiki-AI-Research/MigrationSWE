+
+  it('P2P-033', () => {
+    const root = content(
+      <Text
+        props={{
+          markdown: true,
+          text: '<div><span style="color:red">ok</span></div><script>x</script><a href="https://e.com">raw</a>',
+        }}
+      />
+    );
+    const anchor = root.querySelector('a');
+    const projection = {
+      anchor: { href: anchor?.getAttribute('href') ?? null, target: anchor?.getAttribute('target') ?? null },
+      divCount: root.querySelectorAll('div').length,
+      scripts: root.querySelectorAll('script').length,
+      spanCount: root.querySelectorAll('span').length,
+      spanText: normalizedText(root.querySelector('span')),
+    };
+    expect(projection).toEqual({
+      anchor: { href: 'https://e.com', target: null },
+      divCount: 1,
+      scripts: 0,
+      spanCount: 1,
+      spanText: 'ok',
