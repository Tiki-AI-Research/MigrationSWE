+function renderText(props: any, style?: any): any {
+  const Text = loadIndexModule().Text;
+  return render(React.createElement(Text, style === undefined ? { props } : { props, style }));
+}
+
+function requireTargetTechnology(): void {
+  const pkg = readPackage();
