+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+const Module = require('module');
+
+const BATCH_ID = 'BATCH-F2P-0003';
+const FULL_DOCUMENT =
+  '# H\n\n- a\n\n**bold** *italic*\n\n[link](https://example.com)\n\n![img](https://example.com/i.png)\n\na\nb\n\n|a|b|\n|-|-|\n|1|2|\n\n<b>raw</b>';
+
+function loadCases() {
+  const casesPath = path.join(__dirname, '..', '..', '..', 'fixtures', 'batches', BATCH_ID, 'cases.json');
+  return JSON.parse(fs.readFileSync(casesPath, 'utf8'));
+}
+
+function ensureTsNode(repo) {
+  process.env.TS_NODE_TRANSPILE_ONLY = '1';
+  process.env.TS_NODE_COMPILER_OPTIONS = JSON.stringify({
+    allowJs: true,
+    esModuleInterop: true,
+    jsx: 'react',
+    module: 'commonjs',
+  });
+  const candidates = [
+    path.join(repo, 'node_modules', 'ts-node', 'register', 'transpile-only'),
+    'ts-node/register/transpile-only',
+  ];
+  let lastError = null;
+  for (const candidate of candidates) {
+    try {
+      require(candidate);
+      return;
+    } catch (error) {
+      lastError = error;
+    }
+  }
+  throw lastError || new Error('ts-node register is unavailable');
+}
+
+function purgeModules(repo) {
+  const prefixes = [
+    path.join(repo, 'packages', 'block-text', 'src'),
+    '/node_modules/markdown-it/',
+    '/node_modules/marked/',
+    '/node_modules/insane/',
+  ];
+  for (const key of Object.keys(require.cache)) {
+    if (prefixes.some((prefix) => key.includes(prefix))) {
+      delete require.cache[key];
+    }
+  }
+}
+
+function loadedModules() {
+  const names = new Set();
+  for (const key of Object.keys(require.cache)) {
+    const match = key.match(/node_modules\/((?:@[^/]+\/)?[^/]+)/);
+    if (match) {
+      names.add(match[1]);
+    }
+  }
+  return names;
+}
+
+function resolveFromRepo(repo, specifier) {
+  try {
+    const resolver = Module.createRequire(path.join(repo, 'packages', 'block-text', 'package.json'));
+    return resolver.resolve(specifier);
+  } catch {
+    try {
+      return require.resolve(specifier);
+    } catch {
+      return null;
+    }
+  }
+}
+
+function packageVersion(repo, name) {
+  const entry = resolveFromRepo(repo, name);
+  if (!entry) {
+    return null;
+  }
+  let directory = path.dirname(entry);
+  while (directory !== path.dirname(directory)) {
+    const manifest = path.join(directory, 'package.json');
+    if (fs.existsSync(manifest)) {
+      try {
+        const parsed = JSON.parse(fs.readFileSync(manifest, 'utf8'));
+        if (parsed.name === name) {
+          return parsed.version || null;
+        }
+      } catch {
+        return null;
+      }
+    }
+    directory = path.dirname(directory);
+  }
+  return null;
+}
+
+function readText(filePath) {
+  return fs.existsSync(filePath) ? fs.readFileSync(filePath, 'utf8') : '';
+}
+
+function getManifest(repo) {
+  return JSON.parse(readText(path.join(repo, 'packages', 'block-text', 'package.json')) || '{}');
+}
+
+function getProductionText(repo) {
+  const sourceDir = path.join(repo, 'packages', 'block-text', 'src');
+  return [path.join(sourceDir, 'EmailMarkdown.tsx'), path.join(sourceDir, 'index.tsx')]
+    .map(readText)
+    .join('\n');
+}
+
+function evaluateTargetTech(repo) {
+  const loaded = loadedModules();
+  return {
+    insaneLoaded: loaded.has('insane'),
+    markdownItLoaded: loaded.has('markdown-it'),
+    markdownItVersion: packageVersion(repo, 'markdown-it'),
+    markedLoaded: loaded.has('marked'),
+  };
+}
+
+function loadComponents(repo) {
+  purgeModules(repo);
+  const sourceDir = path.join(repo, 'packages', 'block-text', 'src');
+  const index = require(path.join(sourceDir, 'index.tsx'));
+  const email = require(path.join(sourceDir, 'EmailMarkdown.tsx'));
+  return { EmailMarkdown: email.default, Text: index.Text };
+}
+
+function renderEmail(components, markdown, style) {
+  const React = require('react');
+  const { renderToStaticMarkup } = require('react-dom/server');
+  return renderToStaticMarkup(
+    React.createElement(components.EmailMarkdown, { markdown, style: style || {} })
+  );
+}
+
+function renderText(components, markdown, markdownFlag) {
+  const React = require('react');
+  const { renderToStaticMarkup } = require('react-dom/server');
+  return renderToStaticMarkup(
+    React.createElement(components.Text, {
+      props: { markdown: markdownFlag, text: markdown },
+      style: { fontSize: 12 },
+    })
+  );
+}
+
+function result(ok, detail) {
+  return { detail, ok };
+}
+
+function allResults(items) {
+  const failed = items.filter((item) => !item.ok);
+  return {
+    detail: failed.length === 0 ? 'all predicates matched' : failed.map((item) => item.detail).join('; '),
+    ok: failed.length === 0,
+  };
+}
+
+function hasTags(html, tags) {
+  return tags.map((tag) => result(new RegExp(`<${tag}(?=[\\s/>])`, 'i').test(html), `missing <${tag}>`));
+}
+
+function checkFullDocument(components) {
+  const html = renderText(components, FULL_DOCUMENT, true);
+  const anchor = /<a\b[^>]*href="https:\/\/example\.com"[^>]*target="_blank"[^>]*>link<\/a>/.test(html);
+  const image = /<img\b[^>]*src="https:\/\/example\.com\/i\.png"[^>]*alt="img"/.test(html) ||
+    /<img\b[^>]*alt="img"[^>]*src="https:\/\/example\.com\/i\.png"/.test(html);
+  return allResults([
+    ...hasTags(html, ['h1', 'ul', 'li', 'strong', 'em', 'img', 'br', 'table', 'thead', 'tbody', 'tr', 'th', 'td']),
+    result(/<h1>H<\/h1>/.test(html), 'missing h1 text H'),
+    result(/<strong>bold<\/strong>/.test(html), 'missing strong bold'),
+    result(/<em>italic<\/em>/.test(html), 'missing em italic'),
+    result(anchor, 'markdown link is missing target=_blank'),
+    result(image, 'markdown image is missing src/alt'),
+    result(/<table\b[^>]*width="100%"/.test(html), 'table is missing width=100%'),
+    result(/<b>raw<\/b>/.test(html), 'raw HTML was not passed through and sanitized'),
+    result(!/<script\b/i.test(html), 'script element survived sanitization'),
+  ]);
+}
+
+function checkNonMarkdownLiteral(components) {
+  const html = renderText(components, '## This is not <span>markdown</span>', false);
+  return allResults([
+    result(html.includes('## This is not'), 'literal markdown text disappeared'),
+    result(!/<h2\b/i.test(html), 'non-markdown input produced an h2'),
+    result(!/<span>markdown<\/span>/.test(html), 'non-markdown input produced a live span'),
+  ]);
+}
+
+function checkDefaultEmpty(components) {
+  const React = require('react');
+  const { renderToStaticMarkup } = require('react-dom/server');
+  const html = renderToStaticMarkup(React.createElement(components.Text, {}));
+  return result(/^<div><\/div>$/.test(html.trim()), `default Text was not an empty div: ${html}`);
+}
+
+function checkXssSanitized(components, input) {
+  const html = renderText(components, input, true);
+  return allResults([
+    result(!/<script\b/i.test(html), 'script element survived sanitization'),
+    result(!/\son(?:error|load)\s*=/i.test(html), 'event handler attribute survived sanitization'),
+    result(!/(?:href|src)\s*=\s*["'][^"']*(?:javascript:|data:|ftp:)/i.test(html), 'blocked URL scheme survived sanitization'),
+    result(!/<\w+[^>]*\son\w+\s*=/i.test(html), 'inline event attribute survived sanitization'),
+  ]);
+}
+
+function checkSafeMarkdown(components, input) {
+  const html = renderText(components, input, true);
+  return allResults([
+    result(/<strong>Markdown<\/strong>/.test(html), 'safe markdown strong text missing'),
+    result(/<em>turned on<\/em>/.test(html), 'safe markdown em text missing'),
+    result(/<ul\b/.test(html) && /<li>One<\/li>/.test(html), 'safe markdown list missing'),
+    result(/<a\b[^>]*href="https:\/\/usewaypoint\.com"[^>]*target="_blank"/.test(html), 'safe markdown link is missing target=_blank'),
+    result(!/onClick/i.test(html), 'inline onClick attribute survived sanitization'),
+    result(/<span>text<\/span>/.test(html), 'allowed raw span was not preserved'),
+  ]);
+}
+
+function checkEmailStyle(components) {
+  const html = renderEmail(components, '**x**', { color: '#ff0000' });
+  return allResults([
+    result(/^<div style="color:#ff0000">\s*<p><strong>x<\/strong><\/p>\s*<\/div>$/.test(html.trim()), `EmailMarkdown wrapper contract changed: ${html}`),
+  ]);
+}
+
+function checkTable(components, input) {
+  const html = renderEmail(components, input || '|a|b|\n|-|-|\n|1|2|', {});
+  return allResults([
+    result(/<table\b[^>]*width="100%"/.test(html), 'table is missing width=100%'),
+    ...hasTags(html, ['table', 'thead', 'tbody', 'tr', 'th', 'td']),
+  ]);
+}
+
+function checkBreak(components, input) {
+  const html = renderEmail(components, input || 'a\nb', {});
+  return result(/a<br\s*\/?>\s*b/.test(html), `single newline did not become a br: ${html}`);
+}
+
+function checkBlockedScheme(components, input) {
+  const html = renderEmail(components, input || '[x](javascript:alert(1))', {});
+  return allResults([
+    result(/<a\b[^>]*target="_blank"[^>]*>x<\/a>/.test(html), 'blocked-scheme link lost target=_blank'),
+    result(!/<a\b[^>]*href=/.test(html), 'blocked-scheme link kept a href'),
+  ]);
+}
+
+function checkLinks(components, input) {
+  const titled = renderEmail(components, input || '[site](https://example.com "Title")', {});
+  const plain = renderEmail(components, '[site](https://example.com)', {});
+  return allResults([
+    result(/<a\b[^>]*href="https:\/\/example\.com"[^>]*title="Title"[^>]*target="_blank"[^>]*>site<\/a>/.test(titled), 'titled link lost href/title/target'),
+    result(/<a\b[^>]*href="https:\/\/example\.com"[^>]*target="_blank"[^>]*>site<\/a>/.test(plain), 'plain link lost href/target'),
+    result(!/<a\b[^>]*title=/.test(plain), 'plain link gained a title attribute'),
+  ]);
+}
+
+function checkImageRaw(components, input) {
+  const html = renderEmail(components, input, {});
+  const image = /<img\b[^>]*src="https:\/\/e\.com\/i\.png"[^>]*alt="alt"/.test(html) ||
+    /<img\b[^>]*alt="alt"[^>]*src="https:\/\/e\.com\/i\.png"/.test(html);
+  const rawAnchor = /<a\b[^>]*href="https:\/\/e\.com"(?![^>]*target=)[^>]*>raw<\/a>/.test(html);
+  return allResults([
+    result(image, 'markdown image is missing src/alt'),
+    result(/<span>s<\/span>/.test(html), 'allowed raw span missing'),
+    result(rawAnchor, 'raw HTML anchor should keep href without target'),
+  ]);
+}
+
+function checkRawHtml(components, input) {
+  const html = renderText(components, input, true);
+  const rawAnchor = /<a\b[^>]*href="https:\/\/e\.com"(?![^>]*target=)[^>]*>raw<\/a>/.test(html);
+  return allResults([
+    result(/<div><span style="color:red">ok<\/span><\/div>/.test(html), 'allowed raw HTML was not preserved'),
+    result(!/<script\b/i.test(html), 'script element survived sanitization'),
+    result(rawAnchor, 'raw HTML anchor should keep href without target'),
+  ]);
+}
+
+function checkDiffScope(repo, components) {
+  const manifest = getManifest(repo);
+  const deps = { ...(manifest.dependencies || {}), ...(manifest.devDependencies || {}) };
+  const lock = readText(path.join(repo, 'package-lock.json'));
+  const production = getProductionText(repo);
+  const snapshotPath = path.join(repo, 'packages', 'block-text', 'src', '__snapshots__', 'index.spec.tsx.snap');
+  const h2 = renderText(components, '## H', true);
+  return allResults([
+    result(deps['markdown-it'] === '14.1.0', 'manifest does not pin markdown-it 14.1.0'),
+    result(!('marked' in deps), 'manifest still declares marked'),
+    result(lock.includes('node_modules/markdown-it'), 'lockfile has no markdown-it entry'),
+    result(!lock.includes('node_modules/marked'), 'lockfile still contains marked'),
+    result(/from\s+['"]markdown-it['"]/.test(production), 'production code does not import markdown-it'),
+    result(!/from\s+['"]marked['"]|require\(\s*['"]marked['"]\s*\)|marked\.parse/.test(production), 'production code still references marked'),
+    result(fs.existsSync(snapshotPath) && fs.statSync(snapshotPath).isFile(), 'snapshot file is missing'),
+    result(/<h2>H<\/h2>/.test(h2), 'markdown heading did not render as h2'),
+  ]);
+}
+
+function checkModuleGraph(repo, components) {
+  const manifest = getManifest(repo);
+  const deps = { ...(manifest.dependencies || {}), ...(manifest.devDependencies || {}) };
+  const production = getProductionText(repo);
+  const loaded = loadedModules();
+  return allResults([
+    result(loaded.has('markdown-it'), 'markdown-it module was not loaded by the production path'),
+    result(loaded.has('insane'), 'insane module was not loaded by the production path'),
+    result(!loaded.has('marked'), 'marked module was loaded by the production path'),
+    result(deps['markdown-it'] === '14.1.0', 'manifest does not pin markdown-it 14.1.0'),
+    result(!('marked' in deps), 'manifest still declares marked'),
+    result(/from\s+['"]markdown-it['"]/.test(production), 'production code does not import markdown-it'),
+    result(!/from\s+['"]marked['"]|require\(\s*['"]marked['"]\s*\)|marked\.parse/.test(production), 'production code still references marked'),
+    result(/<table\b[^>]*width="100%"/.test(renderText(components, '|a|b|\n|-|-|\n|1|2|', true)), 'table did not render through the loaded graph'),
+  ]);
+}
+
+function checkNoFallback(repo, components) {
+  const loaded = loadedModules();
+  const production = getProductionText(repo);
+  const html = renderEmail(components, '# H\n\n[a](https://e.com)', {});
+  return allResults([
+    result(!loaded.has('marked'), 'marked fallback was loaded'),
+    result(!loaded.has('child_process'), 'a child process fallback was loaded'),
+    result(!loaded.has('worker_threads'), 'a worker-thread fallback was loaded'),
+    result(!/import\(\s*['"]marked['"]\s*\)|require\(\s*['"]marked['"]\s*\)/.test(production), 'production code contains a dynamic marked fallback'),
+    result(/<h1>H<\/h1>/.test(html) && /<a\b[^>]*target="_blank"/.test(html), 'synchronous render did not produce h1 and target=_blank anchor'),
+  ]);
+}
+
+function checkTargetTech(repo) {
+  const tech = evaluateTargetTech(repo);
+  const manifest = getManifest(repo);
+  const deps = { ...(manifest.dependencies || {}), ...(manifest.devDependencies || {}) };
+  return allResults([
+    result(tech.markdownItLoaded, 'markdown-it was not loaded by this invocation'),
+    result(tech.markdownItVersion === '14.1.0', `markdown-it version is ${tech.markdownItVersion}`),
+    result(!tech.markedLoaded, 'marked was loaded by this invocation'),
+    result(deps['markdown-it'] === '14.1.0', 'manifest does not pin markdown-it 14.1.0'),
+    result(!('marked' in deps), 'manifest still declares marked'),
+  ]);
+}
+
+function runCheck(name, context) {
+  const { components, input, repo } = context;
+  switch (name) {
+    case 'full-document':
+      return checkFullDocument(components);
+    case 'non-markdown-literal':
+      return checkNonMarkdownLiteral(components);
+    case 'default-empty':
+      return checkDefaultEmpty(components);
+    case 'xss-sanitized':
+      return checkXssSanitized(components, input);
+    case 'safe-markdown':
+      return checkSafeMarkdown(components, input);
+    case 'email-style':
+      return checkEmailStyle(components);
+    case 'table':
+      return checkTable(components, input);
+    case 'break':
+      return checkBreak(components, input);
+    case 'blocked-scheme':
+      return checkBlockedScheme(components, input);
+    case 'links':
+      return checkLinks(components, input);
+    case 'image-raw':
+      return checkImageRaw(components, input);
+    case 'raw-html':
+      return checkRawHtml(components, input);
+    case 'diff-scope':
+      return checkDiffScope(repo, components);
+    case 'module-graph':
+      return checkModuleGraph(repo, components);
+    case 'no-fallback':
+      return checkNoFallback(repo, components);
+    case 'target-tech':
+      return checkTargetTech(repo);
+    default:
+      return result(false, `unknown check ${name}`);
+  }
+}
+
+function evaluateObservation(definition, repo) {
+  const components = loadComponents(repo);
+  let entryResult = null;
+  if (definition.entry === 'email') {
+    entryResult = renderEmail(components, definition.input, { color: '#ff0000' });
+  } else if (definition.entry === 'text') {
+    entryResult = renderText(components, definition.input, definition.markdown === true);
+  } else if (definition.entry === 'module') {
+    entryResult = renderText(components, definition.input, true);
+  }
+  const context = { components, input: definition.input, repo };
+  const checks = definition.checks.map((name) => {
+    const check = runCheck(name, context);
+    return { ...check, name };
+  });
+  return {
+    checks,
+    entry: definition.entry,
+    id: definition.id,
+    status: checks.every((check) => check.ok) ? 'PASS' : 'FAIL',
+    surface: definition.surface,
+    tech: evaluateTargetTech(repo),
+    entryHtml: entryResult,
+  };
+}
+
+function run(repo, side) {
+  ensureTsNode(repo);
+  const cases = loadCases();
+  const observations = cases.observations.map((definition) => evaluateObservation(definition, repo));
+  return {
+    batch_id: BATCH_ID,
+    observations,
+    side,
+    summary: {
+      failed: observations.filter((observation) => observation.status !== 'PASS').map((observation) => observation.id),
+      passed: observations.filter((observation) => observation.status === 'PASS').map((observation) => observation.id),
+    },
+  };
+}
+
+module.exports = { BATCH_ID, run };
