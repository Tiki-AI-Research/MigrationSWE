+import React from 'react';
+
+import { describe, expect, it } from '@jest/globals';
+import { render } from '@testing-library/react';
+
+if (typeof (globalThis as any).TextEncoder === 'undefined') {
+  const util = require('util');
+  (globalThis as any).TextEncoder = util.TextEncoder;
+  (globalThis as any).TextDecoder = util.TextDecoder;
+}
+
+function load(relativePath: string) {
+  const roots = [process.env.P2P_REPO, process.cwd(), '/workspace/repo'].filter(Boolean) as string[];
+  for (const root of roots) {
+    try {
+      return require(`${root.replace(/\/$/, '')}/${relativePath}`);
+    } catch (error) {
+      void error;
+    }
+  }
+  throw new Error(`Unable to load ${relativePath}`);
+}
+
+const blockText = load('packages/block-text/src');
+const EmailMarkdown = load('packages/block-text/src/EmailMarkdown').default;
+const blockHeading = load('packages/block-heading/src');
+const renderToStaticMarkup = load('packages/email-builder/src/renderers/renderToStaticMarkup').default;
+
+const Text = blockText.Text;
+const TextPropsSchema = blockText.TextPropsSchema;
+const TextPropsDefaults = blockText.TextPropsDefaults;
+const Heading = blockHeading.Heading;
+
+function container(node: React.ReactElement) {
+  return render(node).container;
+}
+
+function content(node: React.ReactElement) {
+  const element = container(node).firstElementChild;
+  if (!element) {
+    throw new Error('Rendered output has no content element');
+  }
+  return element as HTMLElement;
+}
+
+function elementAttributes(element: Element) {
+  return Array.from(element.attributes)
+    .sort((left, right) => left.name.localeCompare(right.name))
+    .reduce<Record<string, string>>((result, attribute) => {
+      result[attribute.name] = attribute.value;
+      return result;
+    }, {});
+}
+
+function normalizedText(element: Element | null) {
+  if (!element) {
+    return '';
+  }
+  const clone = element.cloneNode(true) as Element;
+  clone.querySelectorAll('br').forEach((lineBreak) => lineBreak.replaceWith(document.createTextNode(' ')));
+  return (clone.textContent ?? '').replace(/\s+/g, ' ').trim();
+}
+
+function eventAttributeNames(root: Element) {
+  const names: string[] = [];
+  root.querySelectorAll('*').forEach((element) => {
+    Array.from(element.attributes).forEach((attribute) => {
+      if (attribute.name.toLowerCase().startsWith('on')) {
+        names.push(attribute.name.toLowerCase());
+      }
+    });
+  });
+  return names.sort();
+}
+
+function blockedSchemeAttributes(root: Element) {
+  const values: string[] = [];
+  root.querySelectorAll('[href], [src]').forEach((element) => {
+    for (const name of ['href', 'src']) {
+      const value = element.getAttribute(name);
+      if (value && /^(?:javascript|data|ftp):/i.test(value.trim())) {
+        values.push(value);
+      }
+    }
+  });
+  return values;
+}
+
+describe('BATCH-P2P-0002', () => {
+  it('P2P-026', () => {
+    const root = content(
+      <EmailMarkdown style={{}} markdown={'[site](https://example.com "Title")\n\n[plain](https://example.com)'} />
+    );
+    const links = Array.from(root.querySelectorAll('a')).map((link) => ({
+      href: link.getAttribute('href'),
