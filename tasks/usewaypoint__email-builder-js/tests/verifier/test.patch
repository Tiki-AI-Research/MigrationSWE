+'use strict';
+
+const { BATCH_ID, OBSERVATION_IDS, run, cli } = require('../../../shared/batches/BATCH-DIFFERENTIAL-0001/probe.js');
+
+const SIDE = 'source';
+
+function runSource(options) {
+  const repoRoot = (options && options.repoRoot) || process.env.REPO_ROOT || process.cwd();
+  return run({ repoRoot, side: SIDE });
+}
+
+module.exports = {
+  batch_id: BATCH_ID,
+  side: SIDE,
+  observation_ids: OBSERVATION_IDS,
+  run: runSource,
+};
+
+if (require.main === module) {
+  cli(process.argv, { side: SIDE, defaultRepoRoot: process.env.REPO_ROOT || process.cwd() });
+}
