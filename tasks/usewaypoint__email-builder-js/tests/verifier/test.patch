+
+  function normalizeNode(node) {
+    if (node.nodeType === 3) {
+      const text = node.nodeValue.replace(/\s+/g, ' ').trim();
+      return text || null;
+    }
+    if (node.nodeType !== 1) {
+      return null;
+    }
+    const attributes = {};
+    for (const attribute of Array.from(node.attributes)) {
+      attributes[attribute.name] = attribute.value;
+    }
+    const children = Array.from(node.childNodes)
+      .map(normalizeNode)
+      .filter((child) => child !== null);
+    const allText = children.every((child) => typeof child === 'string');
+    return {
+      tag: node.tagName.toLowerCase(),
+      attributes,
+      text: allText ? children.join('') : '',
+      children: allText ? [] : children,
+    };
+  }
+
+  function treeOf(element) {
+    const result = render(element);
+    return normalizeNode(result.container);
+  }
+
+  function tagsOf(node, output) {
+    const result = output || [];
+    if (!node || typeof node !== 'object') {
+      return result;
+    }
+    result.push(node.tag);
+    for (const child of node.children) {
+      tagsOf(child, result);
+    }
+    return result;
+  }
+
+  function attributesOf(node, output) {
+    const result = output || [];
+    if (!node || typeof node !== 'object') {
+      return result;
+    }
+    for (const name of Object.keys(node.attributes || {})) {
+      result.push([node.tag, name, node.attributes[name]]);
+    }
+    for (const child of node.children) {
+      attributesOf(child, result);
+    }
+    return result;
+  }
+
+  function textsOf(node, output) {
+    const result = output || [];
+    if (!node || typeof node !== 'object') {
+      return result;
+    }
+    if (node.text) {
+      result.push(node.text);
+    }
