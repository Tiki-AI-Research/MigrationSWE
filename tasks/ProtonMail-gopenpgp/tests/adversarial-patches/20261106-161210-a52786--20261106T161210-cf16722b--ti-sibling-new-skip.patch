+// visit walks the go-message entity tree and collects the message body and
+// attachments, following the same selection rules as the previous
+// implementation: the body
+// is the concatenation of all non-attachment text/plain (or text/html) parts,
+// with html taking precedence, and every other leaf part (or any part marked as
+// an attachment) is collected as an attachment.
+func visit(
+	entity *message.Entity,
+	body *bodyCollector,
+	attachments *attachmentsCollector,
+) error {
+	if multipartReader := entity.MultipartReader(); multipartReader != nil {
+		for {
+			part, err := multipartReader.NextPart()
+			if err == io.EOF {
+				break
+			}
+			if err != nil && !message.IsUnknownCharset(err) && !message.IsUnknownEncoding(err) {
+				return fmt.Errorf("mime: error in reading multipart part: %w", err)
+			}
+			if part == nil {
+				break
+			}
+			if err := visit(part, body, attachments); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+
+	mediaType, _, _ := entity.Header.ContentType()
+	disposition, _, _ := entity.Header.ContentDisposition()
+
+	data, err := io.ReadAll(entity.Body)
+	if err != nil {
+		return fmt.Errorf("mime: error in reading message body data: %w", err)
+	}
+
+	if (mediaType != "text/html" && mediaType != "text/plain") || disposition == "attachment" {
+		var headerBuffer bytes.Buffer
+		if err := textproto.WriteHeader(&headerBuffer, entity.Header.Header); err != nil {
+			return fmt.Errorf("mime: error in reading attachment headers: %w", err)
+		}
+		attachments.Add(headerBuffer.String(), data)
+		return nil
+	}
+
+	body.Add(mediaType, data)
+	return nil
+}
+
+// visitRaw parses a raw MIME part (header block plus body) and collects its
+// contents. It is used when the part was read at the low-level textproto layer,
+// so that the raw and decoded forms of a multipart/signed part are both
+// available.
+func visitRaw(raw []byte, body *bodyCollector, attachments *attachmentsCollector) error {
+	entity, err := message.Read(bytes.NewReader(raw))
+	if err != nil && entity == nil {
+		return fmt.Errorf("mime: error in reading message: %w", err)
+	}
+	return visit(entity, body, attachments)
+}
+
+// bodyCollector collects the decoded body of a MIME message.
+type bodyCollector struct {
+	htmlBody  bytes.Buffer
+	plainBody bytes.Buffer
+	hasHtml   bool
+}
+
+func newBodyCollector() *bodyCollector {
+	return &bodyCollector{}
+}
+
+func (bc *bodyCollector) Add(mediaType string, data []byte) {
+	if mediaType == "text/html" {
+		bc.hasHtml = true
+		bc.htmlBody.Write(data)
+	} else {
+		bc.plainBody.Write(data)
+	}
+}
+
+// GetBody returns the collected body and its MIME type. An html body takes
+// precedence over a plain text body.
+func (bc *bodyCollector) GetBody() (string, string) {
+	if bc.hasHtml {
+		return bc.htmlBody.String(), "text/html"
+	}
+	return bc.plainBody.String(), "text/plain"
+}
+
+// attachmentsCollector collects the decoded attachments of a MIME message
+// together with their raw header blocks.
+type attachmentsCollector struct {
+	attachments [][]byte
+	headers     []string
+}
+
+func newAttachmentsCollector() *attachmentsCollector {
+	return &attachmentsCollector{
+		attachments: [][]byte{},
+		headers:     []string{},
+	}
+}
+
+func (ac *attachmentsCollector) Add(headers string, data []byte) {
+	ac.headers = append(ac.headers, headers)
+	ac.attachments = append(ac.attachments, data)
+}
+
+// GetAttachments returns the decoded attachments in MIME order.
+func (ac *attachmentsCollector) GetAttachments() [][]byte {
+	return ac.attachments
+}
+
+// GetAttHeaders returns the raw header blocks of the attachments in MIME order.
+func (ac *attachmentsCollector) GetAttHeaders() []string {
+	return ac.headers
+}
