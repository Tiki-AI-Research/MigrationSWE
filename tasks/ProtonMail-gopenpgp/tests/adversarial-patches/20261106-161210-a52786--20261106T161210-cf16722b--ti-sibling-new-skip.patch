+// readRawPart returns the raw bytes (header block plus body) of a low-level
+// multipart part, before any transfer encoding or charset decoding.
+func readRawPart(part *textproto.Part) ([]byte, error) {
+	var buffer bytes.Buffer
+	if err := textproto.WriteHeader(&buffer, part.Header); err != nil {
+		return nil, err
+	}
+	if _, err := io.Copy(&buffer, part); err != nil {
+		return nil, err
+	}
+	return buffer.Bytes(), nil
+}
+
+// decodeRawPart parses a raw MIME part and returns its decoded (transfer
+// encoding and charset) body.
+func decodeRawPart(raw []byte) ([]byte, error) {
+	entity, err := message.Read(bytes.NewReader(raw))
+	if err != nil && entity == nil {
+		return nil, err
+	}
+	return io.ReadAll(entity.Body)
+}
