+KIND = {}
+for _i in REQUIRED:
+    KIND[_i] = "P2P" if _i.startswith("P2P") else (
+        "F2P" if _i.startswith("F2P") else "DIFFERENTIAL")
+
+# --------------------------------------------------------------------------
+# probe maps
+# --------------------------------------------------------------------------
+
+P2P_TESTS = {
