+F2P3_TESTS = {
+    "TestProbeGoMessageMultipartSignedRaw": ["F2P-072"],
+    "TestProbeGoMessageAttachmentDisposition": [
+        "F2P-049", "F2P-059", "F2P-062", "F2P-067"],
