+func check(id string, fn func() (bool, string)) {
+	tech, tdetail := targetTechnology()
+	ok, detail := fn()
+	pass := tech && ok
+	if !tech {
+		detail = "target technology absent: " + tdetail + "; " + detail
+	}
+	results = append(results, result{ID: id, Pass: pass, Detail: detail})
