+#!/bin/sh
+# Source-side runner for BATCH-DIFFERENTIAL-0001.
+#
+# Copies the /input/source read-only checkout into a scratch tree, drops the
+# shared differential probe next to the module and executes it so the source
+# callback behaviour can be compared with the target report by the shared
+# "equal_after_normalization" gates.
+set -eu
+
+SIDE="source"
+REPO="${REPO:-/input/source}"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ASSETS="$(cd "$HERE/../../.." && pwd)"
+PROBE="$ASSETS/shared/batches/BATCH-DIFFERENTIAL-0001/diffprobe/main.go"
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT INT TERM
+
+cp -R "$REPO"/. "$WORK"/
+mkdir -p "$WORK/diffprobe"
+cp "$PROBE" "$WORK/diffprobe/main.go"
+
+if [ -d "$WORK/.gomodcache" ]; then
+	GOMODCACHE="$WORK/.gomodcache"
+else
+	GOMODCACHE="/opt/migration/dependencies/gomodcache"
+fi
+export GOMODCACHE
+export GOFLAGS="${GOFLAGS:--mod=mod}"
+export GOPROXY="${GOPROXY:-off}"
+export GOSUMDB="${GOSUMDB:-off}"
+
+cd "$WORK"
+if [ -n "${DIFF_OUT:-}" ]; then
+	go run ./diffprobe > "$DIFF_OUT"
+	echo "$SIDE differential report written to $DIFF_OUT"
+else
+	go run ./diffprobe
+fi
