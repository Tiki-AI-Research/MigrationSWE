  "policy": {
    "allowed_equivalent_test_paths": [],
    "test_integrity": {
      "assertion_strength": true,
      "note": "Resolve assertion import aliases and preserve baseline test identities, assertion strength and checking paths. Equivalent success/error return branches are tolerated; returns or guards that bypass baseline checks are rejected. Independent behavior probes remain required."
    },
    "target_delegation": {
      "paths": [
        "mime"
      ],
      "exclude": [
        "mime/*_test.go",
        "mime/testdata/*"
      ],
      "api_calls": {
        "github.com/emersion/go-message": [
          "Read",
          "ReadWithOptions",
          "New",
          "NewMultipart"
        ],
        "github.com/emersion/go-message/mail": [
          "CreateReader",
          "NewReader"
        ],
        "github.com/emersion/go-message/textproto": [
          "ReadHeader",
          "NewMultipartReader"
        ]
      },
      "note": "Require an import-bound go-message parser/entity constructor call, including ReadWithOptions, NewMultipart, parenthesized function expressions, aliases and dot imports. Prose and uncalled function/type references are not delegation. Behavior probes verify the full migrated responsibilities."
    },
    "target_reimplementation": {
      "paths": [
        "mime"
      ],
      "exclude": [
        "mime/*_test.go",
        "mime/testdata/*"
      ],
      "api_calls": {
        "mime/multipart": [
          "NewReader"
        ]
      },
      "note": "Detect standard-library multipart traversal that replaces a migrated go-message responsibility. The baseline net/mail.ReadMessage envelope reader may feed go-message.New; target delegation, public behavior probes, and go-mime/runtime-bridge bans remain mandatory."
    },
