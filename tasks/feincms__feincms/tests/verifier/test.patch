--- /dev/null
+++ b/tests/shared/integration/observations.json
@@ -0,0 +1,634 @@
+{
+  "schema_version": "migration-observation-inventory:v1",
+  "migration": {
+    "source": "Django 3.2",
+    "target": "Django 5.2"
+  },
+  "observations": [
+    {
