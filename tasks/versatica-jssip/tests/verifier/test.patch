+#!/usr/bin/env node
+'use strict';
+
+// DeepSWE migration verifier harness for versatica/JsSIP pegjs -> peggy.
+// Runs static migration checks and behavior checks against a candidate repo.
+
+const fs = require('fs');
+const path = require('path');
+const childProcess = require('child_process');
+
+// Capture evaluator-owned primitives before any candidate module is required.
+// A candidate can monkey-patch fs/JSON/process globals after it loads, but it
+// must not be able to alter the answer material read, the comparisons, or the
+// authenticated result write.
+const readFileSync = fs.readFileSync;
+const writeSync = fs.writeSync;
+const ftruncateSync = fs.ftruncateSync;
+const closeSync = fs.closeSync;
+const stringify = JSON.stringify;
+const parseJson = JSON.parse;
+const FunctionCtor = Function;
+const processExit = process.exit.bind(process);
+const execPath = process.execPath;
+const spawnSyncCaptured = childProcess.spawnSync;
+
+const args = {};
+for (const arg of process.argv.slice(2)) {
+	const m = /^--([^=]+)=(.*)$/.exec(arg);
+	if (m) {
+		args[m[1]] = m[2];
+	}
+}
+const repo = path.resolve(args.repo || '/workspace/repo');
+const dump = args.dump === '1';
+
+// The verifier supplies references/expectations and a per-run nonce on stdin.
+// The harness consumes stdin before loading any candidate module and then uses
+// an out-of-band, pre-opened result descriptor; stdout is never trusted.
+const runPayload = dump ? null : parseJson(readFileSync(0, 'utf8'));
+const referenceSource = dump
+	? (args.reference ? readFileSync(path.resolve(args.reference), 'utf8') : null)
+	: (runPayload && runPayload.reference);
+const envelopeNonce = runPayload ? String(runPayload.nonce || '') : '';
+const resultFd = args['result-fd'] !== undefined ? Number(args['result-fd']) : null;
+
+function read(rel) {
+	return readFileSync(path.join(repo, rel), 'utf8');
+}
+function readJson(rel) {
+	return parseJson(read(rel));
+}
+function generatorSources() {
+	const queue = [path.join(repo, 'npm-scripts.mjs')];
+	const script = (readJson('package.json').scripts || {}).grammar;
+	if (typeof script === 'string') {
+		const entry = /^\s*node\s+(?:['"]([^'"]+)['"]|([^\s]+))/.exec(script);
+		if (entry) queue.push(path.resolve(repo, entry[1] || entry[2]));
+	}
+	const visited = new Set();
+	const sources = [];
+	while (queue.length) {
+		const filename = queue.pop();
+		const relative = path.relative(repo, filename);
+		if (relative.startsWith('..') || path.isAbsolute(relative) || visited.has(filename)) continue;
+		let source;
+		try {
+			source = readFileSync(filename, 'utf8');
+		} catch {
+			continue;
+		}
+		visited.add(filename);
+		sources.push(source);
+		const imports = /\brequire\s*\(\s*['"]([^'"]+)['"]\s*\)|\bfrom\s+['"]([^'"]+)['"]|\bimport\s*\(\s*['"]([^'"]+)['"]\s*\)|\bimport\s*['"]([^'"]+)['"]/g;
+		for (const match of source.matchAll(imports)) {
+			const specifier = match[1] || match[2] || match[3] || match[4];
+			if (!specifier.startsWith('.')) continue;
+			const base = path.resolve(path.dirname(filename), specifier);
+			const candidates = [base, ...['.js', '.cjs', '.mjs', '.ts'].map(extension => base + extension)];
+			candidates.push(...['.js', '.cjs', '.mjs', '.ts'].map(extension => path.join(base, 'index' + extension)));
+			for (const candidate of candidates) {
+				try {
+					readFileSync(candidate, 'utf8');
+					queue.push(candidate);
+					break;
+				} catch {
+					continue;
+				}
+			}
+		}
+	}
+	return sources.join('\n');
+}
+function runTypeScript(rel) {
+	const tsc = path.join(repo, 'node_modules/typescript/bin/tsc');
+	const result = spawnSyncCaptured(execPath, [
+		tsc,
+		'--noEmit',
+		'--strict',
+		'--skipLibCheck',
+		'--module',
+		'commonjs',
+		'--target',
+		'es2020',
+		'--moduleResolution',
+		'node',
+		path.join(repo, rel),
+	], { cwd: repo, encoding: 'utf8' });
+	if (result.error) {
+		throw result.error;
+	}
+	if (result.status !== 0) {
+		throw new Error(`tsc failed for ${rel}:\n${result.stdout || ''}\n${result.stderr || ''}`);
+	}
+	return true;
+}
+function ser(value, seen) {
+	if (value === null || value === undefined) {
+		return value;
+	}
+	const t = typeof value;
+	if (t === 'string' || t === 'number' || t === 'boolean') {
+		return value;
+	}
+	if (t === 'function') {
+		return '[function]';
+	}
+	if (t === 'object') {
+		seen = seen || new Set();
+		if (seen.has(value)) {
+			return '[circular]';
+		}
+		seen.add(value);
+		if (Array.isArray(value)) {
+			return value.map(item => ser(item, seen));
+		}
+		const out = { __type: value.constructor && value.constructor.name };
+		for (const key of Object.keys(value).sort()) {
+			out[key] = ser(value[key], seen);
+		}
+		return out;
+	}
+	return String(value);
+}
+function stable(value) {
+	return stringify(ser(value));
+}
+
+let Grammar = null;
+let URI = null;
+let NameAddrHeader = null;
+let Parser = null;
+function loadModules() {
+	if (Grammar) {
+		return;
+	}
+	Grammar = require(path.join(repo, 'src/Grammar.js'));
+	URI = require(path.join(repo, 'src/URI.js'));
+	NameAddrHeader = require(path.join(repo, 'src/NameAddrHeader.js'));
+	Parser = require(path.join(repo, 'src/Parser.js'));
+}
+
+function loadReference() {
+	if (!referenceSource) {
+		throw new Error('reference parser is unavailable');
+	}
+	const code = referenceSource;
+	const module = { exports: {} };
+	const customRequire = name => {
+		if (name === './URI') {
+			return require(path.join(repo, 'src/URI.js'));
+		}
+		if (name === './NameAddrHeader') {
+			return require(path.join(repo, 'src/NameAddrHeader.js'));
+		}
+		return require(name);
+	};
+	// eslint-disable-next-line no-new-func
+	const factory = new FunctionCtor('require', 'module', 'exports', code);
+	factory(customRequire, module, module.exports);
+	return module.exports;
+}
+
+function mulberry32(seed) {
+	return function () {
+		seed |= 0;
+		seed = (seed + 0x6d2b79f5) | 0;
+		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+	};
+}
