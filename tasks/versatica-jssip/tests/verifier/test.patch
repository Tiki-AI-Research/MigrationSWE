+import * as Grammar from '../../../Grammar';
+
+type SyntaxErrorExpectation =
+	| { readonly type: 'literal'; readonly text: string; readonly ignoreCase: boolean }
+	| {
+			readonly type: 'class';
+			readonly parts: readonly (string | readonly [string, string])[];
+			readonly inverted: boolean;
+			readonly ignoreCase: boolean;
+	  }
+	| { readonly type: 'any' }
+	| { readonly type: 'end' }
+	| { readonly type: 'other'; readonly description: string };
+type IsAny<T> = 0 extends 1 & T ? true : false;
+type AssertFalse<T extends false> = T;
+type SyntaxErrorExpectedIsNotAny = AssertFalse<
+	IsAny<Grammar.SyntaxError['expected']>
+>;
+type SyntaxErrorExpectedElement = NonNullable<
+	Grammar.SyntaxError['expected']
+> extends readonly (infer Item)[]
+	? Item
+	: never;
+type SyntaxErrorExpectedElementIsNotAny = AssertFalse<
+	IsAny<SyntaxErrorExpectedElement>
+>;
+type ClassExpectation = Extract<SyntaxErrorExpectedElement, { type: 'class' }>;
+type ClassParts = ClassExpectation['parts'];
+type ClassPartsIsNotAny = AssertFalse<IsAny<ClassParts>>;
+type ClassPartIsNotAny = AssertFalse<IsAny<ClassParts[number]>>;
+
+const classExpectation: ClassExpectation = {
+	type: 'class',
+	parts: ['a', ['a', 'z']],
+	inverted: false,
+	ignoreCase: false,
