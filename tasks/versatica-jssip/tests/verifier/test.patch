+function parseRule(rule, input) {
+	loadModules();
+	return Grammar.parse(input, rule);
+}
+
+function expectPlainError(invoke, message) {
+	let threw = false;
+	let error = null;
+	let value;
+	try {
+		value = invoke();
+	} catch (caught) {
+		threw = true;
+		error = caught;
+	}
+	if (!threw) {
+		throw new Error(`expected invalid-rule error, got ${stringify(value)}`);
+	}
+	if (!(error instanceof Error) || error.constructor !== Error) {
+		throw new Error(`expected plain Error, got ${error && error.constructor && error.constructor.name}`);
+	}
+	if (Object.keys(error).length !== 0) {
+		throw new Error(`expected no own properties on the error, got ${stringify(Object.keys(error))}`);
+	}
+	if (error.message !== message) {
+		throw new Error(`expected ${stringify(message)}, got ${stringify(error.message)}`);
+	}
+	return message;
+}
+
+// String call shape only: the two-shape requirement is a contract of its own.
+function expectInvalidRule(name, message) {
+	loadModules();
+	return expectPlainError(() => Grammar.parse('x', name), message);
+}
+
+// Both historical call shapes, asserted once for the shape contract itself.
+function expectInvalidRuleBothShapes(name, message) {
+	loadModules();
+	expectPlainError(() => Grammar.parse('x', name), message);
+	expectPlainError(() => Grammar.parse('x', { startRule: name }), message);
+}
+
+// A start-rule value that is not a string is reported through String().
+function expectInvalidRuleValue(value, message) {
+	loadModules();
+	return expectPlainError(() => Grammar.parse('x', { startRule: value }), message);
+}
+
+// The observable outcome of a call, including how it failed.
+function outcomeOf(invoke) {
+	try {
+		return 'VALUE:' + stable(invoke());
+	} catch (error) {
+		return 'THROW:' + (error && error.constructor && error.constructor.name) + ':' + String(error && error.message);
+	}
+}
+
+// An options object that selects nothing must behave exactly like omitting it.
+function expectEquivalentToOmitted(label, makeOptions) {
+	loadModules();
+	for (const input of ['', 'x', 'sip:alice@example.com', '%%%']) {
+		const omitted = outcomeOf(() => Grammar.parse(input));
+		const explicit = outcomeOf(() => Grammar.parse(input, makeOptions()));
+		if (explicit !== omitted) {
+			throw new Error(`${label} ${stringify(input)}: ${explicit} vs ${omitted}`);
+		}
+	}
+}
+
+const CASES = [
