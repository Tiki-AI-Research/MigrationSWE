+		const out = {};
+		for (const testCase of CASES) {
+			if (testCase.group === 'F2P') {
+				continue;
+			}
+			try {
+				out[testCase.id] = stable(testCase.run());
+			} catch (error) {
+				out[testCase.id] = 'THROW:' + (error && error.message);
+			}
+		}
+		process.stdout.write(stringify(out, null, 2));
+		return 0;
+	}
+	const EXPECTED = runPayload
+		? runPayload.expected
+		: parseJson(readFileSync(path.resolve(args.expected), 'utf8'));
+	if (!EXPECTED || typeof EXPECTED !== 'object') {
+		throw new Error('expected-value payload is unavailable');
+	}
+	const results = [];
+	for (const testCase of CASES) {
+		const started = Date.now();
+		let status = 'passed';
+		let message = '';
+		try {
+			if (testCase.group === 'F2P') {
+				// Fail-to-pass nodes are migration predicates: the base
+				// repository throws, a migrated repository returns normally.
+				testCase.run();
+			} else {
+				const actual = stable(testCase.run());
+				const expected = EXPECTED[testCase.id];
+				if (expected === undefined) {
+					throw new Error('no frozen expectation for node');
+				}
+				if (actual !== expected) {
+					throw new Error(`expected ${expected} but got ${actual}`);
+				}
+			}
+		} catch (error) {
+			status = 'failed';
+			message = String((error && error.message) || error);
+		}
