      ],
      [
        "npm",
        "--prefix",
        "packages/locale",
        "run",
        "build-prebuilt"
      ],
      [
        "node",
        "-e",
        "// Copy only generated distribution files; preserve original locale data,\n// package manifests and readmes. Mirrors the copy step in utils/create_packages.js.\nconst fs = require('fs');\nconst path = require('path');\nconst root = path.join(process.argv[1], 'packages', 'locale');\nconst files = ['index.js', 'index.js.map', 'index.min.js', 'index.esm.js', 'index.esm.js.map'];\nfor (const name of fs.readdirSync(path.join(root, 'packages'))) {\n  const pkg = path.join(root, 'packages', name);\n  if (!fs.statSync(pkg).isDirectory() || !fs.existsSync(path.join(pkg, 'package.json'))) continue;\n  fs.mkdirSync(path.join(pkg, 'dist'), {recursive: true});\n  for (const file of files) fs.copyFileSync(path.join(root, 'dist', 'prebuilt', name, file), path.join(pkg, 'dist', file));\n}\n",
        "{repo}"
      ]
    ],
