+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/probe.js
@@ -0,0 +1,137 @@
+#!/usr/bin/env node
+'use strict';
+
+/*
+ * Source probe for BATCH-DIFFERENTIAL-0001.
+ *
+ * Usage: node probe.js <report-path> [repo-root]
+ *
+ * Executes the shared differential corpus against the pre-migration source
+ * revision (default `/input/source`).  The source tree is mounted read-only,
+ * therefore the probe runs the corpus in declared mode: it reads the declared
+ * configuration and in-process behaviour without mutating the tree.  Long
+ * running commands remain bounded by the GNU `timeout` binary inside the
+ * corpus.
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+function findCorpus(startDir) {
+    let dir = startDir;
+    for (let i = 0; i < 8; i += 1) {
+        const candidates = [
+            path.join(dir, 'shared', 'batches', 'BATCH-DIFFERENTIAL-0001', 'corpus.js'),
+            path.join(dir, 'batches', 'BATCH-DIFFERENTIAL-0001', 'corpus.js'),
+            path.join(dir, 'corpus.js'),
+        ];
+        for (const candidate of candidates) {
+            if (fs.existsSync(candidate)) {
+                return candidate;
+            }
+        }
+        const parent = path.dirname(dir);
+        if (parent === dir) {
+            break;
+        }
+        dir = parent;
+    }
+    return null;
+}
+
+function findExpected(startDir) {
+    let dir = startDir;
+    for (let i = 0; i < 8; i += 1) {
+        const candidates = [
+            path.join(dir, 'fixtures', 'batches', 'BATCH-DIFFERENTIAL-0001', 'expected.json'),
+            path.join(dir, 'batches', 'BATCH-DIFFERENTIAL-0001', 'expected.json'),
+            path.join(dir, 'expected.json'),
+        ];
+        for (const candidate of candidates) {
+            if (fs.existsSync(candidate)) {
+                return candidate;
+            }
+        }
+        const parent = path.dirname(dir);
+        if (parent === dir) {
+            break;
+        }
+        dir = parent;
+    }
+    return null;
+}
+
+function writeReport(reportPath, report) {
+    try {
+        fs.mkdirSync(path.dirname(reportPath), { recursive: true });
+    } catch (e) {
+        /* directory may already exist */
+    }
+    fs.writeFileSync(reportPath, `${JSON.stringify(report, null, 2)}\n`);
+    process.stdout.write(`${JSON.stringify({ passed: report.passed, failed: report.failed_observations })}\n`);
+}
+
+function main(argv) {
+    const reportPath = argv[2] || '/logs/source-result.json';
+    const repoRoot = argv[3] || process.env.SOURCE_ROOT || '/input/source';
+
+    const corpusPath = findCorpus(__dirname);
+    if (!corpusPath) {
+        writeReport(reportPath, {
+            schema_version: 'migration-differential-report:v1',
+            batch_id: 'BATCH-DIFFERENTIAL-0001',
+            side: 'source',
+            passed: false,
+            error: 'corpus-not-found',
+            observations: {},
+            failed_observations: [],
+            differences: [],
+        });
+        return 1;
+    }
+    const corpus = require(corpusPath);
+
+    let report;
+    try {
+        const actual = corpus.runCorpus(repoRoot, { execute: false });
+        const expectedPath = findExpected(__dirname);
+        let differences = [];
+        let expected = null;
+        if (expectedPath) {
+            expected = JSON.parse(fs.readFileSync(expectedPath, 'utf8'));
+            differences = corpus.diffReports(expected, actual);
+        }
+        const failed = Object.keys(actual.observations).filter(
+            (id) => actual.observations[id].passed === false
+        );
+        report = {
+            schema_version: 'migration-differential-report:v1',
+            batch_id: corpus.BATCH_ID,
+            side: 'source',
+            repo_root: repoRoot,
+            expected_path: expectedPath,
+            expected_present: expected !== null,
+            observations: actual.observations,
+            failed_observations: failed,
+            differences,
+            passed: failed.length === 0 && differences.length === 0,
+        };
+    } catch (e) {
+        writeReport(reportPath, {
+            schema_version: 'migration-differential-report:v1',
+            batch_id: 'BATCH-DIFFERENTIAL-0001',
+            side: 'source',
+            passed: false,
+            error: `${(e && e.constructor && e.constructor.name) || 'Error'}: ${e && e.message}`,
+            observations: {},
+            failed_observations: [],
+            differences: [],
+        });
+        return 1;
+    }
+
+    writeReport(reportPath, report);
+    return report.passed ? 0 : 1;
+}
+
+process.exitCode = main(process.argv);
diff --git a/tests/source/batches/BATCH-F2P-0001/runner.js b/tests/source/batches/BATCH-F2P-0001/runner.js
