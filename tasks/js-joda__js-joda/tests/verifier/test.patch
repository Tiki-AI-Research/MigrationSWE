diff --git a/tests/shared/integration/bootstrap.js b/tests/shared/integration/bootstrap.js
new file mode 100644
--- /dev/null
+++ b/tests/shared/integration/bootstrap.js
@@ -0,0 +1,82 @@
+'use strict';
+
+/*
+ * Process bootstrap for integration-dispatched child processes.
+ *
+ * It is injected through NODE_OPTIONS=--require so that any batch executable
+ * spawned by the integration harness (and the grandchild test processes it
+ * spawns) observes the same module environment as the in-process dispatch:
+ * the workspace `node_modules` on NODE_PATH and bare `@js-joda/*` specifiers
+ * mapped to the in-repo entry files.  This keeps the dependency batch
+ * projections runnable on a fresh workspace whose package links are absent.
+ */
+
+const fs = require('fs');
+const path = require('path');
+const Module = require('module');
+
+const repoRoot = process.env.REPO_ROOT || process.env.MIGRATION_REPO_ROOT;
+
+if (repoRoot && !process.env.INTEGRATION_BOOTSTRAPPED) {
+  process.env.INTEGRATION_BOOTSTRAPPED = '1';
+  process.env.REPO_ROOT = repoRoot;
+
+  const nodeModules = path.join(repoRoot, 'node_modules');
+  const parts = (process.env.NODE_PATH || '')
+    .split(path.delimiter)
+    .filter((entry) => entry.length > 0);
+  for (const entry of [nodeModules, path.join(repoRoot, 'packages', 'core', 'node_modules')]) {
+    if (!parts.includes(entry)) {
+      parts.push(entry);
+    }
+  }
+  process.env.NODE_PATH = parts.join(path.delimiter);
+  Module._initPaths();
+
+  const entry = (name, srcRel) => {
+    const dir = path.join(repoRoot, 'packages', name);
+    let main = null;
+    try {
+      main = JSON.parse(fs.readFileSync(path.join(dir, 'package.json'), 'utf8')).main;
+    } catch (e) {
+      main = null;
+    }
+    if (typeof main === 'string' && main.length > 0 && fs.existsSync(path.join(dir, main))) {
+      return path.join(dir, main);
+    }
+    return path.join(dir, srcRel);
+  };
+  const map = {
+    '@js-joda/core': entry('core', path.join('src', 'js-joda.js')),
+    '@js-joda/timezone': entry('timezone', path.join('src', 'js-joda-timezone.js')),
+    '@js-joda/locale': entry('locale', path.join('src', 'js-joda-locale.js')),
+    '@js-joda/extra': entry('extra', path.join('src', 'js-joda-extra.js')),
+  };
+  const originalResolve = Module._resolveFilename;
+  Module._resolveFilename = function resolveFilename(request, parent, isMain, options) {
+    if (Object.prototype.hasOwnProperty.call(map, request) && fs.existsSync(map[request])) {
+      return map[request];
+    }
+    return originalResolve.call(this, request, parent, isMain, options);
+  };
+
+  try {
+    const { createRequire } = require('module');
+    const req = createRequire(path.join(repoRoot, 'package.json'));
+    const registerModule = req('@babel/register');
+    const register = registerModule && registerModule.default ? registerModule.default : registerModule;
+    const escapedRoot = repoRoot.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+    register({
+      cwd: repoRoot,
+      babelrc: false,
+      configFile: false,
+      cache: false,
+      only: [new RegExp(`^${escapedRoot}[\\\\/]`), new RegExp(`^${escapedRoot}$`)],
+      ignore: [/[\\/]node_modules[\\/]/],
+      extensions: ['.js'],
+      presets: [['@babel/preset-env', { modules: 'commonjs' }]],
+    });
+  } catch (e) {
+    /* Babel is optional; probes degrade to INCONCLUSIVE without it. */
+  }
+}
diff --git a/tests/shared/integration/cli.js b/tests/shared/integration/cli.js
new file mode 100644
--- /dev/null
+++ b/tests/shared/integration/cli.js
@@ -0,0 +1,132 @@
+#!/usr/bin/env node
+'use strict';
+
+/*
+ * BATCH-INTEGRATION-0001 report CLI.
+ *
+ * Shared by the two integration entry points:
+ *   - source/runner        runs every required runtime observation on the
+ *                          pre-upgrade source checkout (side = "source")
+ *   - harness.js           runs every required runtime observation on the
+ *                          migrated workspace (side = "target")
+ *
+ * Both emit a `migration-observations:v6` report and never hardcode a
+ * PASS/FAIL by role: the status is the raw outcome of the owning batch probe.
+ */
+
+const path = require('path');
+const { assetRoot, writeJson } = require(path.join(__dirname, 'runtime'));
+const { runSide, loadInventory } = require(path.join(__dirname, 'dispatch'));
+
+const REPO_ENV_KEYS = ['MIGRATION_REPO_ROOT', 'MIGRATION_REPO', 'REPO_ROOT', 'REPO'];
+const DEFAULT_TIMEOUT_MS = Number(process.env.INTEGRATION_TIMEOUT_MS || 1800000);
+
+function resolveRepoRoot() {
+  for (const key of REPO_ENV_KEYS) {
+    if (process.env[key] && process.env[key].trim().length > 0) {
+      return path.resolve(process.env[key].trim());
+    }
+  }
+  return path.resolve(process.cwd());
+}
+
+function resolveReportPath(argv) {
+  if (argv[2] && argv[2].length > 0) {
+    return argv[2];
+  }
+  return process.env.MIGRATION_REPORT_PATH || process.env.REPORT_PATH || null;
+}
+
+/*
+ * The runtime report must always cover every required observation ID: an
+ * empty `observations` array is explicitly forbidden and is what previously
+ * made the P2P projections look unexecutable.  When dispatch cannot complete
+ * (module missing, watchdog expiry, unexpected throw) we still emit one entry
+ * per inventory observation, all marked INCONCLUSIVE, so coverage holds and
+ * the failure is visible instead of silently dropping the whole inventory.
+ */
+function buildFallback(side, repoRoot, reason) {
+  let observations = [];
+  try {
+    observations = loadInventory().map((item) => ({
+      id: item.id,
+      kind: item.kind,
+      status: 'INCONCLUSIVE',
+      value: { type: 'json', value: { reason } },
+    }));
+  } catch (e) {
+    observations = [];
+  }
+  return {
+    schema_version: 'migration-observations:v6',
+    batch_id: 'BATCH-INTEGRATION-0001',
+    side,
+    repo_root: repoRoot,
+    target_name: 'js-joda',
+    target_version: '6.3.2',
+    observations,
+    diagnostics: [{ side, error: reason }],
+  };
+}
+
+async function main(side, argv) {
+  const repoRoot = resolveRepoRoot();
+  const reportPath = resolveReportPath(argv);
+  let report;
+  try {
+    const { observations, diagnostics } = await runSide(side, repoRoot);
+    report = {
+      schema_version: 'migration-observations:v6',
+      batch_id: 'BATCH-INTEGRATION-0001',
+      side,
+      repo_root: repoRoot,
+      target_name: 'js-joda',
+      target_version: '6.3.2',
+      observations,
+      diagnostics,
+    };
+  } catch (error) {
+    const reason = `integration dispatch failed: ${error && error.message ? error.message : error}`;
+    report = buildFallback(side, repoRoot, reason);
+    process.stderr.write(`${reason}\n`);
+  }
+  const text = `${JSON.stringify(report, null, 2)}\n`;
+  if (reportPath) {
+    writeJson(reportPath, report);
+  }
+  process.stdout.write(text);
+  return 0;
+}
+
+function watchdog(side) {
+  const timer = setTimeout(() => {
+    const reportPath = resolveReportPath(process.argv);
+    const fallback = buildFallback(side, resolveRepoRoot(), 'integration harness exceeded watchdog timeout');
+    if (reportPath) {
+      try {
+        writeJson(reportPath, fallback);
+      } catch (e) {
+        /* ignore */
+      }
+    }
+    process.stderr.write('integration harness exceeded watchdog timeout\n');
+    process.exit(124);
+  }, DEFAULT_TIMEOUT_MS);
+  timer.unref();
+}
+
+module.exports = { main, watchdog, resolveRepoRoot, assetRoot };
+
+if (require.main === module) {
+  const SIDE = process.env.INTEGRATION_SIDE || 'target';
+  watchdog(SIDE);
+  main(SIDE, process.argv).then(
+    (code) => {
+      process.exitCode = code;
+    },
+    (error) => {
+      process.stderr.write(`${(error && error.stack) || error}\n`);
+      process.exitCode = 1;
+    },
+  );
+}
diff --git a/tests/shared/integration/dispatch.js b/tests/shared/integration/dispatch.js
new file mode 100644
--- /dev/null
+++ b/tests/shared/integration/dispatch.js
@@ -0,0 +1,293 @@
+'use strict';
+
+/*
+ * BATCH-INTEGRATION-0001 observation dispatcher.
+ *
+ * The dependency batches each own a part of the frozen runtime observation
+ * inventory and expose an executable projection (a shared module with a
+ * documented entry function, or a self-contained harness).  This module
+ * dispatches every required_runtime_observation to its owning batch exactly
+ * once, on the requested side, and returns the raw observed status.  No status
+ * is derived from the side label: the very same probe code runs for source and
+ * target and naturally yields FAIL on the pre-upgrade source.
+ */
+
+const fs = require('fs');
+const path = require('path');
+const { assetRoot, setupRuntime, resetModuleState, runBounded } = require('./runtime');
+
+const INVENTORY_PATH = path.join(__dirname, 'observations.json');
+
+const ALLOWED_STATUS = new Set([
+  'PASS',
+  'FAIL',
+  'NA',
+  'INFRA_ERROR',
+  'INCONCLUSIVE',
+  'TIMEOUT',
+]);
+
+const BATCH_DIRS = {
+  'BATCH-P2P-0001': path.join('shared', 'batches', 'BATCH-P2P-0001'),
+  'BATCH-P2P-0002': path.join('shared', 'batches', 'BATCH-P2P-0002'),
+  'BATCH-F2P-0001': path.join('shared', 'batches', 'BATCH-F2P-0001'),
+  'BATCH-F2P-0002': path.join('shared', 'batches', 'BATCH-F2P-0002'),
+  'BATCH-F2P-0003': path.join('shared', 'batches', 'BATCH-F2P-0003'),
+  'BATCH-DIFFERENTIAL-0001': path.join('shared', 'batches', 'BATCH-DIFFERENTIAL-0001'),
+  'BATCH-CONTRACT-0001': path.join('shared', 'batches', 'BATCH-CONTRACT-0001'),
+};
+
+function loadInventory() {
+  return JSON.parse(fs.readFileSync(INVENTORY_PATH, 'utf8')).observations;
+}
+
+function statusOf(value) {
+  if (typeof value === 'string' && ALLOWED_STATUS.has(value)) {
+    return value;
+  }
+  if (value === true) {
+    return 'PASS';
+  }
+  if (value === false) {
+    return 'FAIL';
+  }
+  return 'INCONCLUSIVE';
+}
+
+function sanitize(value) {
+  if (value === undefined) {
+    return null;
+  }
+  try {
+    return JSON.parse(JSON.stringify(value));
+  } catch (e) {
+    return String(value);
+  }
+}
+
+function loadBatchModule(batchId, relative) {
+  const file = path.join(assetRoot(), BATCH_DIRS[batchId], relative);
+  return require(file);
+}
+
+function inconclusiveAll(ids, reason, error) {
+  const map = {};
+  for (const id of ids) {
+    map[id] = {
+      status: 'INCONCLUSIVE',
+      value: { reason, error: error ? String(error) : undefined },
+    };
+  }
+  return map;
+}
+
+function mapResults(records, idOf, statusOfRecord, valueOfRecord) {
+  const map = {};
+  for (const record of records || []) {
+    const id = idOf(record);
+    if (!id) {
+      continue;
+    }
+    map[id] = {
+      status: statusOf(statusOfRecord(record)),
+      value: sanitize(valueOfRecord(record)),
+    };
+  }
+  return map;
+}
+
+// --- per-batch executable projections ---------------------------------------
+
+function runP2P0001(side, repoRoot, ids) {
+  const harness = path.join(assetRoot(), BATCH_DIRS['BATCH-P2P-0001'], 'p2p_harness.js');
+  if (!fs.existsSync(harness)) {
+    return inconclusiveAll(ids, 'BATCH-P2P-0001 harness unavailable');
+  }
+  const out = path.join('/tmp', `integration-p2p0001-${side}-${process.pid}.json`);
+  const bootstrap = path.join(__dirname, 'bootstrap.js');
+  const nodeOptions = [process.env.NODE_OPTIONS || '', `--require ${bootstrap}`].join(' ').trim();
+  const env = {
+    REPO_ROOT: repoRoot,
+    NODE_OPTIONS: nodeOptions,
+    NODE_ENV: 'test',
+  };
+  const result = runBounded(
+    ['node', harness, '--side', side, '--repo', repoRoot, '--out', out],
+    { cwd: repoRoot, env },
+    1200,
+  );
+  let report = null;
+  try {
+    report = JSON.parse(fs.readFileSync(out, 'utf8'));
+  } catch (e) {
+    report = require('./runtime').extractJson(result.stdout);
+  }
+  try {
+    fs.unlinkSync(out);
+  } catch (e) {
+    /* ignore */
+  }
+  if (!report || !Array.isArray(report.checks)) {
+    return inconclusiveAll(
+      ids,
+      result.status === 124 || result.signal ? 'BATCH-P2P-0001 timed out' : 'BATCH-P2P-0001 produced no report',
+      result.error ? result.error.message : null,
+    );
+  }
+  return mapResults(
+    report.checks,
+    (record) => record.id,
+    (record) => record.status,
+    (record) => record.value,
+  );
+}
+
+function runP2P0002(side, repoRoot) {
+  const checks = loadBatchModule('BATCH-P2P-0002', 'p2p-checks.js');
+  const report = checks.runAll(repoRoot, side);
+  return mapResults(
+    report.observations,
+    (record) => record.observation_id,
+    (record) => record.result,
+    (record) => record.value,
+  );
+}
+
+function runF2P0001(side, repoRoot) {
+  const probes = loadBatchModule('BATCH-F2P-0001', 'f2p-probes.js');
+  const observations = probes.evaluateAll(repoRoot);
+  return mapResults(
+    observations,
+    (record) => record.observation_id,
+    (record) => record.status,
+    (record) => ({ status: record.status, detail: sanitize(record.detail) }),
+  );
+}
+
+function runF2P0002(side, repoRoot) {
+  const batch = require(path.join(assetRoot(), BATCH_DIRS['BATCH-F2P-0002']));
+  const report = batch.createSide(side).buildChecks(repoRoot);
+  return mapResults(
+    report,
+    (record) => record.observation_id,
+    (record) => record.status,
+    (record) => ({ status: record.status }),
+  );
+}
+
+async function runF2P0003(side, repoRoot) {
+  const support = loadBatchModule('BATCH-F2P-0003', 'support.js');
+  const probes = loadBatchModule('BATCH-F2P-0003', 'probes.js');
+  const ctx = support.createContext(repoRoot);
+  const observations = await support.runAll(ctx, probes.OBSERVATIONS);
+  return mapResults(
+    observations,
+    (record) => record.observation_id,
+    (record) => record.status,
+    (record) => ({ status: record.status, detail: sanitize(record.detail) }),
+  );
+}
+
+function runDifferential(side, repoRoot) {
+  const corpus = loadBatchModule('BATCH-DIFFERENTIAL-0001', 'corpus.js');
+  const execute = side === 'target' && process.env.INTEGRATION_VERIFY_COMMANDS === '1';
+  const report = corpus.runCorpus(repoRoot, { execute });
+  const map = {};
+  for (const id of Object.keys(report.observations)) {
+    const record = report.observations[id];
+    map[id] = {
+      status: statusOf(record.passed === false ? 'FAIL' : 'PASS'),
+      value: sanitize(record.value),
+    };
+  }
+  return map;
+}
+
+function runContract(side, repoRoot) {
+  const probe = loadBatchModule('BATCH-CONTRACT-0001', 'contract-probe.js');
+  const report = probe.runProbe(side, repoRoot);
+  const map = {};
+  for (const id of Object.keys(report.results)) {
+    const record = report.results[id];
+    map[id] = {
+      status: statusOf(record.status),
+      value: sanitize(record.value),
+    };
+  }
+  return map;
+}
+
+const RUNNERS = {
+  'BATCH-P2P-0001': (side, repoRoot, ids) => runP2P0001(side, repoRoot, ids),
+  'BATCH-P2P-0002': (side, repoRoot) => runP2P0002(side, repoRoot),
+  'BATCH-F2P-0001': (side, repoRoot) => runF2P0001(side, repoRoot),
+  'BATCH-F2P-0002': (side, repoRoot) => runF2P0002(side, repoRoot),
+  'BATCH-F2P-0003': (side, repoRoot) => runF2P0003(side, repoRoot),
+  'BATCH-DIFFERENTIAL-0001': (side, repoRoot) => runDifferential(side, repoRoot),
+  'BATCH-CONTRACT-0001': (side, repoRoot) => runContract(side, repoRoot),
+};
+
+/*
+ * Runs the complete inventory for one side and returns one entry per
+ * observation, in inventory order.
+ */
+async function runSide(side, repoRoot) {
+  setupRuntime(repoRoot);
+  const inventory = loadInventory();
+  const byBatch = {};
+  for (const item of inventory) {
+    if (!byBatch[item.batch_id]) {
+      byBatch[item.batch_id] = [];
+    }
+    byBatch[item.batch_id].push(item.id);
+  }
+
+  const results = Object.create(null);
+  const diagnostics = [];
+
+  for (const batchId of Object.keys(RUNNERS)) {
+    const ids = byBatch[batchId];
+    if (!ids || ids.length === 0) {
+      continue;
+    }
+    resetModuleState(repoRoot);
+    try {
+      const map = await Promise.resolve(RUNNERS[batchId](side, repoRoot, ids));
+      for (const id of ids) {
+        results[id] = map[id] || {
+          status: 'INCONCLUSIVE',
+          value: { reason: `observation not reported by ${batchId}` },
+        };
+      }
+    } catch (error) {
+      diagnostics.push({ batch_id: batchId, error: String(error && error.message ? error.message : error) });
+      const fallback = inconclusiveAll(
+        ids,
+        `batch dispatch failed: ${batchId}`,
+        error && error.message ? error.message : error,
+      );
+      for (const id of ids) {
+        results[id] = fallback[id];
+      }
+    }
+  }
+
+  return {
+    observations: inventory.map((item) => {
+      const result = results[item.id] || { status: 'INCONCLUSIVE', value: null };
+      return {
+        id: item.id,
+        kind: item.kind,
+        status: statusOf(result.status),
+        value: { type: 'json', value: sanitize(result.value) },
+      };
+    }),
+    diagnostics,
+  };
+}
+
+module.exports = {
+  loadInventory,
+  runSide,
+  ALLOWED_STATUS,
+};
