+	}
+	if head.CommitterName != testCommitterName || head.CommitterEmail != testCommitterEmail {
+		t.Fatalf("unexpected committer: %s <%s>", head.CommitterName, head.CommitterEmail)
+	}
+	if got := head.AuthorDate.Format(time.RFC3339); got != "2024-02-03T04:05:06-05:00" {
+		t.Fatalf("author date lost offset: %s", got)
+	}
+	if _, offset := head.AuthorDate.Zone(); offset != -5*60*60 {
+		t.Fatalf("unexpected offset: %d", offset)
+	}
+	if head.Subject != "002" {
+		t.Fatalf("unexpected subject: %s", head.Subject)
+	}
