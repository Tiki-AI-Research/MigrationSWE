+++ b/core/internal/toml/toml_test.go
@@ -0,0 +1,275 @@
+package toml
+
+import (
+	"math"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func mustParse(t *testing.T, src string) map[string]any {
+	t.Helper()
+	doc, err := Parse(src)
+	if err != nil {
+		t.Fatalf("Parse(%q): %v", src, err)
+	}
+	return doc
+}
+
+func TestParseValues(t *testing.T) {
+	src := `
+# comment
+str = "basic \"quoted\" \\ \t tab \u00e9 \U0001F600 \e \x41" # trailing comment
+lit = 'C:\Users\path'
+empty = ""
+int = 42
+neg = -17
+pos = +99
+under = 1_000_000
+hex = 0xDEAD_beef
+oct = 0o755
+bin = 0b1101
+max = 9223372036854775807
+flt = 3.1415
+exp = 5e+22
+exp2 = -2E-2
+fu = 224_617.445_991
+pinf = +inf
+ninf = -inf
+bool_t = true
+bool_f = false
+odt = 1979-05-27T07:32:00Z
+odt2 = 1979-05-27T00:32:00.999999-07:00
+odt3 = 1979-05-27 07:32:00Z
+ldt = 1979-05-27T07:32:00
+ld = 1979-05-27
+lt = 07:32:00
+lt2 = 00:32:00.999999
+`
+	doc := mustParse(t, src)
+	want := map[string]any{
+		"str":    "basic \"quoted\" \\ \t tab é 😀 \x1b A",
+		"lit":    `C:\Users\path`,
+		"empty":  "",
+		"int":    int64(42),
+		"neg":    int64(-17),
+		"pos":    int64(99),
+		"under":  int64(1000000),
+		"hex":    int64(0xdeadbeef),
+		"oct":    int64(0o755),
+		"bin":    int64(13),
+		"max":    int64(math.MaxInt64),
+		"flt":    3.1415,
+		"exp":    5e+22,
+		"exp2":   -2e-2,
+		"fu":     224617.445991,
+		"pinf":   math.Inf(1),
+		"ninf":   math.Inf(-1),
+		"bool_t": true,
+		"bool_f": false,
+		"odt":    Datetime("1979-05-27T07:32:00Z"),
+		"odt2":   Datetime("1979-05-27T00:32:00.999999-07:00"),
+		"odt3":   Datetime("1979-05-27 07:32:00Z"),
+		"ldt":    Datetime("1979-05-27T07:32:00"),
+		"ld":     Datetime("1979-05-27"),
+		"lt":     Datetime("07:32:00"),
+		"lt2":    Datetime("00:32:00.999999"),
+	}
+	if !reflect.DeepEqual(doc, want) {
+		for k, v := range want {
+			if !reflect.DeepEqual(doc[k], v) {
+				t.Errorf("%s = %#v, want %#v", k, doc[k], v)
+			}
+		}
+		t.Errorf("doc = %#v", doc)
+	}
+
+	nan := mustParse(t, "x = nan\ny = -nan")
+	if f, ok := nan["x"].(float64); !ok || !math.IsNaN(f) {
+		t.Errorf("nan = %#v", nan["x"])
+	}
+}
+
+func TestParseMultilineStrings(t *testing.T) {
+	src := "a = \"\"\"\nRoses are red\r\nViolets are blue\"\"\"\n" +
+		"b = \"\"\"\nThe quick brown \\\n\n\n  fox jumps over \\\n    the lazy dog.\"\"\"\n" +
+		"c = '''\nraw \\n text\n'''\n" +
+		"d = \"\"\"Here are two quotes: \"\". Ends with a quote: \"\"\"\"\n" +
+		"e = '''It's ''quoted'' '''''\n"
+	doc := mustParse(t, src)
+	want := map[string]any{
+		"a": "Roses are red\nViolets are blue",
+		"b": "The quick brown fox jumps over the lazy dog.",
+		"c": "raw \\n text\n",
+		"d": `Here are two quotes: "". Ends with a quote: "`,
+		"e": "It's ''quoted'' ''",
+	}
+	if !reflect.DeepEqual(doc, want) {
+		t.Errorf("doc = %#v, want %#v", doc, want)
+	}
+}
+
+func TestParseArraysAndInlineTables(t *testing.T) {
+	src := `
+ints = [1, 2, 3]
+nested = [[1, 2], ["a", 'b']]
+multi = [
+  "x", # comment
+  "y",
+]
+empty = []
+point = { x = 1, y = 2 }
+nested_inline = { a.b = 1, c = { d = "e" } }
+empty_inline = {}
+multiline_inline = {
+  a = 1,
+  b = 2,
+}
+`
+	doc := mustParse(t, src)
+	want := map[string]any{
+		"ints":             []any{int64(1), int64(2), int64(3)},
+		"nested":           []any{[]any{int64(1), int64(2)}, []any{"a", "b"}},
+		"multi":            []any{"x", "y"},
+		"empty":            []any{},
+		"point":            map[string]any{"x": int64(1), "y": int64(2)},
+		"nested_inline":    map[string]any{"a": map[string]any{"b": int64(1)}, "c": map[string]any{"d": "e"}},
+		"empty_inline":     map[string]any{},
+		"multiline_inline": map[string]any{"a": int64(1), "b": int64(2)},
+	}
+	if !reflect.DeepEqual(doc, want) {
+		t.Errorf("doc = %#v, want %#v", doc, want)
+	}
+}
+
+func TestParseTables(t *testing.T) {
+	src := `
+top = 1
+[a.b.c]
+x = 1
+[a]
+y = 2
+[ "quoted key" . 'lit key' ]
+z = 3
+[dotted]
+p.q.r = 4
+p.s = 5
+[dotted.p.t]
+u = 6
+[[arr]]
+n = 1
+[arr.sub]
+m = 1
+[[arr]]
+n = 2
+[[arr.items]]
+i = 1
+[bare-key_1]
+1234 = "digits"
+`
+	doc := mustParse(t, src)
+	want := map[string]any{
+		"top": int64(1),
+		"a": map[string]any{
+			"b": map[string]any{"c": map[string]any{"x": int64(1)}},
+			"y": int64(2),
+		},
+		"quoted key": map[string]any{"lit key": map[string]any{"z": int64(3)}},
+		"dotted": map[string]any{
+			"p": map[string]any{
+				"q": map[string]any{"r": int64(4)},
+				"s": int64(5),
+				"t": map[string]any{"u": int64(6)},
+			},
+		},
+		"arr": []any{
+			map[string]any{"n": int64(1), "sub": map[string]any{"m": int64(1)}},
+			map[string]any{"n": int64(2), "items": []any{map[string]any{"i": int64(1)}}},
+		},
+		"bare-key_1": map[string]any{"1234": "digits"},
+	}
+	if !reflect.DeepEqual(doc, want) {
+		t.Errorf("doc = %#v, want %#v", doc, want)
+	}
+}
+
+func TestParseAcceptsCRLFAndBOM(t *testing.T) {
+	doc := mustParse(t, "\uFEFF[core.git]\r\nmailmap = true\r\n")
+	want := map[string]any{"core": map[string]any{"git": map[string]any{"mailmap": true}}}
+	if !reflect.DeepEqual(doc, want) {
+		t.Errorf("doc = %#v", doc)
+	}
+}
+
+func TestParseErrors(t *testing.T) {
+	tests := map[string]string{
+		"duplicate key":                 "a = 1\na = 2",
+		"duplicate key via dotted":      "a.b = 1\na.b = 2",
+		"duplicate table":               "[a]\n[a]",
+		"table defined by dotted keys":  "[fruit]\napple.color = 'red'\n[fruit.apple]",
+		"dotted keys into header table": "[a.b]\nx = 1\n[a]\nb.y = 2",
+		"header after dotted keys":      "[a.b.c]\n[a]\nb.d = 1\n[a.b]",
+		"header after dotted in config": "[core.option.x]\n[core]\noption.order = \"topo\"\n[core.option]",
+		"extend inline table":           "a = { b = 1 }\na.c = 2",
+		"header into inline table":      "a = { b = 1 }\n[a.c]",
+		"redefine inline table":         "a = { b = 1 }\n[a]",
+		"array of tables over array":    "a = []\n[[a]]",
+		"table over array of tables":    "[[a]]\n[a]",
+		"table over value":              "a = 1\n[a]",
+		"duplicate key in inline table": "a = { b = 1, b = 2 }",
+		"missing value":                 "a =",
+		"missing equals":                "a",
+		"two values on a line":          "a = 1 b = 2",
+		"unterminated string":           "a = \"abc",
+		"newline in string":             "a = \"abc\ndef\"",
+		"unterminated literal":          "a = 'abc",
+		"unterminated multiline":        "a = \"\"\"abc",
+		"invalid escape":                `a = "\q"`,
+		"short unicode escape":          `a = "\u12"`,
+		"surrogate escape":              `a = "\uD800"`,
+		"control character":             "a = \"\x01\"",
+		"control character in comment":  "# \x01\na = 1",
+		"bare carriage return":          "a = 1\rb = 2",
+		"leading zero":                  "a = 012",
+		"trailing dot":                  "a = 1.",
+		"leading dot":                   "a = .5",
+		"double underscore":             "a = 1__0",
+		"integer overflow":              "a = 9223372036854775808",
+		"signed hex":                    "a = +0x10",
+		"invalid date":                  "a = 2024-02-30",
+		"invalid time":                  "a = 25:00:00",
+		"bare word":                     "a = yes",
+		"unterminated array":            "a = [1, 2",
+		"missing comma in array":        "a = [1 2]",
+		"unterminated inline table":     "a = { b = 1",
+		"multiline key":                 "\"\"\"a\"\"\" = 1",
+		"empty header":                  "[]",
+		"unterminated header":           "[a",
+		"invalid utf-8":                 "a = \"\xff\"",
+		"too many quotes":               "a = \"\"\"x\"\"\"\"\"\"",
+	}
+	for name, src := range tests {
+		if doc, err := Parse(src); err == nil {
+			t.Errorf("%s: expected an error, got %#v", name, doc)
+		}
+	}
+}
+
+func TestParseErrorReportsLine(t *testing.T) {
+	_, err := Parse("a = 1\n\n[b]\nc = \"unterminated\n")
+	if err == nil || !strings.Contains(err.Error(), "line 4") {
+		t.Errorf("err = %v", err)
+	}
+}
+
+func TestDottedKeysMayExtendImplicitTables(t *testing.T) {
+	doc := mustParse(t, "[a.b.c]\nx = 1\n[a]\nb.d = 2\n[a.b.e]\ny = 3\n")
+	want := map[string]any{"a": map[string]any{"b": map[string]any{
+		"c": map[string]any{"x": int64(1)},
+		"d": int64(2),
+		"e": map[string]any{"y": int64(3)},
+	}}}
+	if !reflect.DeepEqual(doc, want) {
+		t.Errorf("doc = %#v", doc)
+	}
+}
diff --git a/core/repository.go b/core/repository.go
new file mode 100644
--- /dev/null
+++ b/core/repository.go
@@ -0,0 +1,229 @@
+package core
+
+import (
+	"fmt"
+	"sort"
+)
+
+// Repository is a read-only view of a loaded Git repository.
+type Repository struct {
+	path string
+
+	commitMap   map[CommitHash]*Commit
+	parentsMap  map[CommitHash][]CommitHash
+	childrenMap map[CommitHash][]CommitHash
+	refMap      map[CommitHash][]Ref
+	head        Head
+
+	// commitHashes preserves the original git log order (including inserted
+	// stashes).
+	commitHashes []CommitHash
+}
+
+// Load loads a repository from path. sort selects git's commit ordering,
+// maxCount is optional (nil means unlimited), and mailmap enables Git's mailmap
+// identity resolution.
+func Load(path string, sortOrder SortCommit, maxCount *int, mailmap bool) (*Repository, error) {
+	if err := checkGitRepository(path); err != nil {
+		return nil, err
+	}
+
+	refMap, head, err := loadRefs(path)
+	if err != nil {
+		return nil, err
+	}
+
+	stashes, err := loadAllStashes(path, mailmap)
+	if err != nil {
+		return nil, err
+	}
+
+	commits, err := loadAllCommits(path, sortOrder, head, stashes, maxCount, mailmap)
+	if err != nil {
+		return nil, err
+	}
+	if len(commits) == 0 {
+		return nil, fmt.Errorf("no commits in the repository")
+	}
+
+	commits = mergeStashesToCommits(commits, stashes)
+	commitHashes := make([]CommitHash, len(commits))
+	for i := range commits {
+		commitHashes[i] = commits[i].CommitHash
+	}
+
+	parentsMap, childrenMap := buildCommitsMaps(commits)
+	commitMap := toCommitMap(commits)
+
+	stashRefMap, err := loadStashesAsRefs(path)
+	if err != nil {
+		return nil, err
+	}
+	mergeRefMaps(refMap, stashRefMap)
+
+	return &Repository{
+		path:         path,
+		commitMap:    commitMap,
+		parentsMap:   parentsMap,
+		childrenMap:  childrenMap,
+		refMap:       refMap,
+		head:         head,
+		commitHashes: commitHashes,
+	}, nil
+}
+
+// LoadRepository is an alias for Load.
+func LoadRepository(path string, sortOrder SortCommit, maxCount *int, mailmap bool) (*Repository, error) {
+	return Load(path, sortOrder, maxCount, mailmap)
+}
+
+// Commit returns a commit, or nil if it is not present in the loaded set.
+func (r *Repository) Commit(commitHash CommitHash) *Commit {
+	return r.commitMap[normalizeHash(commitHash)]
+}
+
+// HasCommit reports whether the commit is present in the loaded set.
+func (r *Repository) HasCommit(commitHash CommitHash) bool {
+	_, ok := r.commitMap[normalizeHash(commitHash)]
+	return ok
+}
+
+// AllCommits returns commits in repository commit order.
+func (r *Repository) AllCommits() []*Commit {
+	commits := make([]*Commit, 0, len(r.commitHashes))
+	for _, hash := range r.commitHashes {
+		if commit, ok := r.commitMap[hash]; ok {
+			commits = append(commits, commit)
+		}
+	}
+	return commits
+}
+
+// ParentsHash returns the parent hashes of a commit.
+func (r *Repository) ParentsHash(commitHash CommitHash) []CommitHash {
+	return append([]CommitHash(nil), r.parentsMap[normalizeHash(commitHash)]...)
+}
+
+// ChildrenHash returns the child hashes of a commit in repository commit order.
+func (r *Repository) ChildrenHash(commitHash CommitHash) []CommitHash {
+	return append([]CommitHash(nil), r.childrenMap[normalizeHash(commitHash)]...)
+}
+
+// Refs returns references for a commit in tag, branch, remote branch, stash
+// order. Multiple stashes retain git stash list order.
+func (r *Repository) Refs(commitHash CommitHash) []Ref {
+	return append([]Ref(nil), r.refMap[normalizeHash(commitHash)]...)
+}
+
+// AllRefs returns every loaded reference in a deterministic global order.
+func (r *Repository) AllRefs() []Ref {
+	refs := make([]Ref, 0)
+	for _, rs := range r.refMap {
+		refs = append(refs, rs...)
+	}
+	sort.SliceStable(refs, func(i, j int) bool {
+		return CompareRefs(refs[i], refs[j]) < 0
+	})
+	return refs
+}
+
+// Head returns the current HEAD state.
+func (r *Repository) Head() Head {
+	return r.head
+}
+
+// Path returns the repository path used for loading.
+func (r *Repository) Path() string {
+	return r.path
+}
+
+// CommitDetail returns a commit together with its file changes.
+func (r *Repository) CommitDetail(commitHash CommitHash) (Commit, []FileChange) {
+	commitHash = normalizeHash(commitHash)
+	commit := r.commitMap[commitHash]
+	if commit == nil {
+		return Commit{}, nil
+	}
+	var changes []FileChange
+	var err error
+	if len(commit.ParentCommitHashes) == 0 {
+		changes, err = loadInitialCommitAdditions(r.path, commitHash)
+	} else {
+		changes, err = loadDiffSummary(r.path, commitHash)
+	}
+	if err != nil {
+		changes = nil
+	}
+	return *commit, changes
+}
+
+// CommitDetailWithError is CommitDetail with explicit error reporting.
+func (r *Repository) CommitDetailWithError(commitHash CommitHash) (Commit, []FileChange, error) {
+	commitHash = normalizeHash(commitHash)
+	commit := r.commitMap[commitHash]
+	if commit == nil {
+		return Commit{}, nil, fmt.Errorf("commit not found: %s", commitHash.Full)
+	}
+	if len(commit.ParentCommitHashes) == 0 {
+		changes, err := loadInitialCommitAdditions(r.path, commitHash)
+		return *commit, changes, err
+	}
+	changes, err := loadDiffSummary(r.path, commitHash)
+	return *commit, changes, err
+}
+
+func buildCommitsMaps(commits []Commit) (map[CommitHash][]CommitHash, map[CommitHash][]CommitHash) {
+	parentsMap := make(map[CommitHash][]CommitHash)
+	childrenMap := make(map[CommitHash][]CommitHash)
+	for i := range commits {
+		commit := &commits[i]
+		hash := commit.CommitHash
+		for _, parentHash := range commit.ParentCommitHashes {
+			parentsMap[hash] = append(parentsMap[hash], parentHash)
+			childrenMap[parentHash] = append(childrenMap[parentHash], hash)
+		}
+	}
+	return parentsMap, childrenMap
+}
+
+func toCommitMap(commits []Commit) map[CommitHash]*Commit {
+	commitMap := make(map[CommitHash]*Commit, len(commits))
+	for i := range commits {
+		commitMap[commits[i].CommitHash] = &commits[i]
+	}
+	return commitMap
+}
+
+func mergeStashesToCommits(commits []Commit, stashes []Commit) []Commit {
+	stashMap := make(map[CommitHash][]Commit)
+	for _, stash := range stashes {
+		if len(stash.ParentCommitHashes) == 0 {
+			continue
+		}
+		parent := stash.ParentCommitHashes[0]
+		stashMap[parent] = append(stashMap[parent], stash)
+	}
+
+	ret := make([]Commit, 0, len(commits)+len(stashes))
+	for _, commit := range commits {
+		if stashes, ok := stashMap[commit.CommitHash]; ok {
+			ret = append(ret, stashes...)
+			delete(stashMap, commit.CommitHash)
+		}
+		ret = append(ret, commit)
+	}
+	return ret
+}
+
+func normalizeHash(commitHash CommitHash) CommitHash {
+	if commitHash.Short == "" && commitHash.Full != "" {
+		return NewCommitHash(commitHash.Full)
+	}
+	return commitHash
+}
+
+func sortRefs(refs []Ref) {
+	sort.SliceStable(refs, func(i, j int) bool {
+		return CompareRefs(refs[i], refs[j]) < 0
+	})
+}
