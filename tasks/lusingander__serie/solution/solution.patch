--- /dev/null
+++ b/core/internal/toml/toml.go
@@ -0,0 +1,866 @@
+// Package toml implements a small TOML parser that decodes a document into
+// nested Go maps. It accepts TOML 1.0 documents (and the TOML 1.1 relaxations
+// for inline tables, escapes, and optional seconds) without third-party
+// dependencies.
+package toml
+
+import (
+	"fmt"
+	"math"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+// Datetime is an offset date-time, local date-time, local date, or local
+// time value, kept in its original textual form.
+type Datetime string
+
+// Parse decodes a TOML document. Tables are returned as map[string]any,
+// arrays as []any, strings as string, integers as int64, floats as float64,
+// booleans as bool, and date-time values as Datetime.
+func Parse(src string) (map[string]any, error) {
+	if !utf8.ValidString(src) {
+		return nil, fmt.Errorf("toml: document is not valid UTF-8")
+	}
+	src = strings.TrimPrefix(src, "\uFEFF")
+
+	p := &parser{src: src, line: 1, root: newTable(tableHeader)}
+	p.current = p.root
+	if err := p.parseDocument(); err != nil {
+		return nil, err
+	}
+	return p.root.toMap(), nil
+}
+
+type tableKind int
+
+const (
+	// tableImplicit is created as the parent of a header or dotted key and
+	// may still be defined by a header later.
+	tableImplicit tableKind = iota
+	// tableHeader is defined by a [header] or [[header]].
+	tableHeader
+	// tableDotted is defined by dotted keys.
+	tableDotted
+	// tableInline is an inline table and cannot be extended.
+	tableInline
+)
+
+type table struct {
+	kind   tableKind
+	values map[string]any
+}
+
+func newTable(kind tableKind) *table {
+	return &table{kind: kind, values: make(map[string]any)}
+}
+
+// freeze marks t and every table nested in it as inline.
+func (t *table) freeze() {
+	t.kind = tableInline
+	for _, v := range t.values {
+		freezeValue(v)
+	}
+}
+
+func freezeValue(v any) {
+	switch v := v.(type) {
+	case *table:
+		v.freeze()
+	case []any:
+		for _, e := range v {
+			freezeValue(e)
+		}
+	}
+}
+
+func (t *table) toMap() map[string]any {
+	m := make(map[string]any, len(t.values))
+	for k, v := range t.values {
+		m[k] = toPlain(v)
+	}
+	return m
+}
+
+type tableArray struct {
+	tables []*table
+}
+
+func toPlain(v any) any {
+	switch v := v.(type) {
+	case *table:
+		return v.toMap()
+	case *tableArray:
+		a := make([]any, len(v.tables))
+		for i, t := range v.tables {
+			a[i] = t.toMap()
+		}
+		return a
+	case []any:
+		a := make([]any, len(v))
+		for i, e := range v {
+			a[i] = toPlain(e)
+		}
+		return a
+	default:
+		return v
+	}
+}
+
+type parser struct {
+	src     string
+	pos     int
+	line    int
+	root    *table
+	current *table
+}
+
+func (p *parser) errorf(format string, args ...any) error {
+	return fmt.Errorf("toml: line %d: %s", p.line, fmt.Sprintf(format, args...))
+}
+
+func (p *parser) eof() bool {
+	return p.pos >= len(p.src)
+}
+
+func (p *parser) peek() byte {
+	if p.eof() {
+		return 0
+	}
+	return p.src[p.pos]
+}
+
+func (p *parser) hasPrefix(s string) bool {
+	return strings.HasPrefix(p.src[p.pos:], s)
+}
+
+func (p *parser) skipWhitespace() {
+	for !p.eof() && (p.src[p.pos] == ' ' || p.src[p.pos] == '\t') {
+		p.pos++
+	}
+}
+
+// skipNewline consumes "\n" or "\r\n" and reports whether one was present.
+func (p *parser) skipNewline() (bool, error) {
+	switch {
+	case p.hasPrefix("\n"):
+		p.pos++
+	case p.hasPrefix("\r\n"):
+		p.pos += 2
+	case p.hasPrefix("\r"):
+		return false, p.errorf("bare carriage return")
+	default:
+		return false, nil
+	}
+	p.line++
+	return true, nil
+}
+
+func (p *parser) skipComment() error {
+	if p.peek() != '#' {
+		return nil
+	}
+	for !p.eof() {
+		c := p.src[p.pos]
+		if c == '\n' || (c == '\r' && p.hasPrefix("\r\n")) {
+			return nil
+		}
+		if isControl(c) {
+			return p.errorf("control character %U in comment", rune(c))
+		}
+		p.pos++
+	}
+	return nil
+}
+
+// skipBlank skips whitespace, comments, and newlines.
+func (p *parser) skipBlank() error {
+	for {
+		p.skipWhitespace()
+		if err := p.skipComment(); err != nil {
+			return err
+		}
+		ok, err := p.skipNewline()
+		if err != nil {
+			return err
+		}
+		if !ok {
+			return nil
+		}
+	}
+}
+
+// endOfLine consumes trailing whitespace, a comment, and the line break that
+// must follow an expression.
+func (p *parser) endOfLine() error {
+	p.skipWhitespace()
+	if err := p.skipComment(); err != nil {
+		return err
+	}
+	if p.eof() {
+		return nil
+	}
+	ok, err := p.skipNewline()
+	if err != nil {
+		return err
+	}
+	if !ok {
+		return p.errorf("expected newline, found %q", p.peek())
+	}
+	return nil
+}
+
+func (p *parser) parseDocument() error {
+	for {
+		if err := p.skipBlank(); err != nil {
+			return err
+		}
+		if p.eof() {
+			return nil
+		}
+		var err error
+		switch {
+		case p.hasPrefix("[["):
+			err = p.parseArrayTableHeader()
+		case p.peek() == '[':
+			err = p.parseTableHeader()
+		default:
+			err = p.parseKeyValue(p.current)
+		}
+		if err != nil {
+			return err
+		}
+		if err := p.endOfLine(); err != nil {
+			return err
+		}
+	}
+}
+
+func (p *parser) parseTableHeader() error {
+	p.pos++ // [
+	p.skipWhitespace()
+	key, err := p.parseKey()
+	if err != nil {
+		return err
+	}
+	p.skipWhitespace()
+	if p.peek() != ']' {
+		return p.errorf("expected ']' after table header")
+	}
+	p.pos++
+
+	parent, err := p.walkHeader(key[:len(key)-1])
+	if err != nil {
+		return err
+	}
+	last := key[len(key)-1]
+	switch v := parent.values[last].(type) {
+	case nil:
+		t := newTable(tableHeader)
+		parent.values[last] = t
+		p.current = t
+	case *table:
+		if v.kind != tableImplicit {
+			return p.errorf("table %q is already defined", strings.Join(key, "."))
+		}
+		v.kind = tableHeader
+		p.current = v
+	default:
+		return p.errorf("key %q is already defined", strings.Join(key, "."))
+	}
+	return nil
+}
+
+func (p *parser) parseArrayTableHeader() error {
+	p.pos += 2 // [[
+	p.skipWhitespace()
+	key, err := p.parseKey()
+	if err != nil {
+		return err
+	}
+	p.skipWhitespace()
+	if !p.hasPrefix("]]") {
+		return p.errorf("expected ']]' after array of tables header")
+	}
+	p.pos += 2
+
+	parent, err := p.walkHeader(key[:len(key)-1])
+	if err != nil {
+		return err
+	}
+	last := key[len(key)-1]
+	t := newTable(tableHeader)
+	switch v := parent.values[last].(type) {
+	case nil:
+		parent.values[last] = &tableArray{tables: []*table{t}}
+	case *tableArray:
+		v.tables = append(v.tables, t)
+	default:
+		return p.errorf("key %q is already defined", strings.Join(key, "."))
+	}
+	p.current = t
+	return nil
+}
+
+// walkHeader returns the table that a header's key path leads to, creating
+// implicit tables along the way.
+func (p *parser) walkHeader(path []string) (*table, error) {
+	t := p.root
+	for i, k := range path {
+		switch v := t.values[k].(type) {
+		case nil:
+			nt := newTable(tableImplicit)
+			t.values[k] = nt
+			t = nt
+		case *table:
+			if v.kind == tableInline {
+				return nil, p.errorf("cannot extend inline table %q", strings.Join(path[:i+1], "."))
+			}
+			t = v
+		case *tableArray:
+			t = v.tables[len(v.tables)-1]
+		default:
+			return nil, p.errorf("key %q is already defined", strings.Join(path[:i+1], "."))
+		}
+	}
+	return t, nil
+}
+
+func (p *parser) parseKeyValue(t *table) error {
+	key, err := p.parseKey()
+	if err != nil {
+		return err
+	}
+	p.skipWhitespace()
+	if p.peek() != '=' {
+		return p.errorf("expected '=' after key %q", strings.Join(key, "."))
+	}
+	p.pos++
+	p.skipWhitespace()
+	value, err := p.parseValue()
+	if err != nil {
+		return err
+	}
+
+	for i, k := range key[:len(key)-1] {
+		switch v := t.values[k].(type) {
+		case nil:
+			nt := newTable(tableDotted)
+			t.values[k] = nt
+			t = nt
+		case *table:
+			if v.kind == tableInline || v.kind == tableHeader {
+				return p.errorf("cannot extend table %q with dotted keys", strings.Join(key[:i+1], "."))
+			}
+			// dotted keys define an implicitly created table, so a header
+			// cannot define it again
+			v.kind = tableDotted
+			t = v
+		default:
+			return p.errorf("key %q is already defined", strings.Join(key[:i+1], "."))
+		}
+	}
+	last := key[len(key)-1]
+	if _, exists := t.values[last]; exists {
+		return p.errorf("duplicate key %q", strings.Join(key, "."))
+	}
+	t.values[last] = value
+	return nil
+}
+
+func (p *parser) parseKey() ([]string, error) {
+	var key []string
+	for {
+		part, err := p.parseSimpleKey()
+		if err != nil {
+			return nil, err
+		}
+		key = append(key, part)
+		p.skipWhitespace()
+		if p.peek() != '.' {
+			return key, nil
+		}
+		p.pos++
+		p.skipWhitespace()
+	}
+}
+
+func (p *parser) parseSimpleKey() (string, error) {
+	switch c := p.peek(); {
+	case c == '"':
+		if p.hasPrefix(`"""`) {
+			return "", p.errorf("multi-line strings cannot be keys")
+		}
+		return p.parseBasicString()
+	case c == '\'':
+		if p.hasPrefix("'''") {
+			return "", p.errorf("multi-line strings cannot be keys")
+		}
+		return p.parseLiteralString()
+	case isBareKeyChar(c):
+		start := p.pos
+		for !p.eof() && isBareKeyChar(p.src[p.pos]) {
+			p.pos++
+		}
+		return p.src[start:p.pos], nil
+	case p.eof():
+		return "", p.errorf("expected key, found end of document")
+	default:
+		return "", p.errorf("expected key, found %q", c)
+	}
+}
+
+func isBareKeyChar(c byte) bool {
+	return 'A' <= c && c <= 'Z' || 'a' <= c && c <= 'z' || '0' <= c && c <= '9' || c == '_' || c == '-'
+}
+
+func isControl(c byte) bool {
+	return (c < 0x20 && c != '\t') || c == 0x7f
+}
+
+func (p *parser) parseValue() (any, error) {
+	switch c := p.peek(); {
+	case p.eof():
+		return nil, p.errorf("expected value, found end of document")
+	case c == '"':
+		if p.hasPrefix(`"""`) {
+			return p.parseMultilineBasicString()
+		}
+		return p.parseBasicString()
+	case c == '\'':
+		if p.hasPrefix("'''") {
+			return p.parseMultilineLiteralString()
+		}
+		return p.parseLiteralString()
+	case c == '[':
+		return p.parseArray()
+	case c == '{':
+		return p.parseInlineTable()
+	case c == 't' || c == 'f':
+		return p.parseBool()
+	default:
+		return p.parseNumberOrDatetime()
+	}
+}
+
+func (p *parser) parseBool() (bool, error) {
+	for _, lit := range []string{"true", "false"} {
+		if p.hasPrefix(lit) {
+			end := p.pos + len(lit)
+			if end < len(p.src) && isBareKeyChar(p.src[end]) {
+				break
+			}
+			p.pos = end
+			return lit == "true", nil
+		}
+	}
+	return false, p.errorf("invalid value")
+}
+
+func (p *parser) parseBasicString() (string, error) {
+	p.pos++ // "
+	var sb strings.Builder
+	for {
+		if p.eof() {
+			return "", p.errorf("unterminated string")
+		}
+		c := p.src[p.pos]
+		switch {
+		case c == '"':
+			p.pos++
+			return sb.String(), nil
+		case c == '\\':
+			if err := p.parseEscape(&sb); err != nil {
+				return "", err
+			}
+		case c == '\n' || c == '\r':
+			return "", p.errorf("unterminated string")
+		case isControl(c):
+			return "", p.errorf("control character %U in string", rune(c))
+		default:
+			sb.WriteByte(c)
+			p.pos++
+		}
+	}
+}
+
+func (p *parser) parseMultilineBasicString() (string, error) {
+	p.pos += 3 // """
+	if _, err := p.skipNewline(); err != nil {
+		return "", err
+	}
+	var sb strings.Builder
+	for {
+		if p.eof() {
+			return "", p.errorf("unterminated multi-line string")
+		}
+		c := p.src[p.pos]
+		switch {
+		case c == '"':
+			if done, err := p.closeMultiline(&sb, '"'); done || err != nil {
+				return sb.String(), err
+			}
+		case c == '\\':
+			// a line ending backslash trims the following whitespace and newlines
+			end := p.pos + 1
+			for end < len(p.src) && (p.src[end] == ' ' || p.src[end] == '\t') {
+				end++
+			}
+			if strings.HasPrefix(p.src[end:], "\n") || strings.HasPrefix(p.src[end:], "\r\n") {
+				p.pos = end
+				for {
+					p.skipWhitespace()
+					ok, err := p.skipNewline()
+					if err != nil {
+						return "", err
+					}
+					if !ok {
+						break
+					}
+				}
+				continue
+			}
+			if err := p.parseEscape(&sb); err != nil {
+				return "", err
+			}
+		case c == '\n' || c == '\r':
+			if _, err := p.skipNewline(); err != nil {
+				return "", err
+			}
+			sb.WriteByte('\n')
+		case isControl(c):
+			return "", p.errorf("control character %U in string", rune(c))
+		default:
+			sb.WriteByte(c)
+			p.pos++
+		}
+	}
+}
+
+func (p *parser) parseLiteralString() (string, error) {
+	p.pos++ // '
+	start := p.pos
+	for {
+		if p.eof() {
+			return "", p.errorf("unterminated string")
+		}
+		c := p.src[p.pos]
+		switch {
+		case c == '\'':
+			s := p.src[start:p.pos]
+			p.pos++
+			return s, nil
+		case c == '\n' || c == '\r':
+			return "", p.errorf("unterminated string")
+		case isControl(c):
+			return "", p.errorf("control character %U in string", rune(c))
+		}
+		p.pos++
+	}
+}
+
+func (p *parser) parseMultilineLiteralString() (string, error) {
+	p.pos += 3 // '''
+	if _, err := p.skipNewline(); err != nil {
+		return "", err
+	}
+	var sb strings.Builder
+	for {
+		if p.eof() {
+			return "", p.errorf("unterminated multi-line string")
+		}
+		c := p.src[p.pos]
+		switch {
+		case c == '\'':
+			if done, err := p.closeMultiline(&sb, '\''); done || err != nil {
+				return sb.String(), err
+			}
+		case c == '\n' || c == '\r':
+			if _, err := p.skipNewline(); err != nil {
+				return "", err
+			}
+			sb.WriteByte('\n')
+		case isControl(c):
+			return "", p.errorf("control character %U in string", rune(c))
+		default:
+			sb.WriteByte(c)
+			p.pos++
+		}
+	}
+}
+
+// closeMultiline handles a run of quote characters inside a multi-line
+// string. Three or more quotes close the string, and up to two extra quotes
+// before the closing delimiter belong to the content.
+func (p *parser) closeMultiline(sb *strings.Builder, quote byte) (bool, error) {
+	n := 0
+	for p.pos+n < len(p.src) && p.src[p.pos+n] == quote {
+		n++
+	}
+	if n < 3 {
+		sb.WriteString(p.src[p.pos : p.pos+n])
+		p.pos += n
+		return false, nil
+	}
+	if n > 5 {
+		return true, p.errorf("too many quotes at the end of a multi-line string")
+	}
+	sb.WriteString(p.src[p.pos : p.pos+n-3])
+	p.pos += n
+	return true, nil
+}
+
+func (p *parser) parseEscape(sb *strings.Builder) error {
+	p.pos++ // backslash
+	if p.eof() {
+		return p.errorf("unterminated escape sequence")
+	}
+	c := p.src[p.pos]
+	p.pos++
+	switch c {
+	case 'b':
+		sb.WriteByte('\b')
+	case 't':
+		sb.WriteByte('\t')
+	case 'n':
+		sb.WriteByte('\n')
+	case 'f':
+		sb.WriteByte('\f')
+	case 'r':
+		sb.WriteByte('\r')
+	case 'e':
+		sb.WriteByte('\x1b')
+	case '"':
+		sb.WriteByte('"')
+	case '\\':
+		sb.WriteByte('\\')
+	case 'x', 'u', 'U':
+		size := 2
+		switch c {
+		case 'u':
+			size = 4
+		case 'U':
+			size = 8
+		}
+		if p.pos+size > len(p.src) {
+			return p.errorf("invalid escape sequence")
+		}
+		hex := p.src[p.pos : p.pos+size]
+		code, err := strconv.ParseUint(hex, 16, 32)
+		if err != nil {
+			return p.errorf("invalid escape sequence \\%c%s", c, hex)
+		}
+		r := rune(code)
+		if !utf8.ValidRune(r) {
+			return p.errorf("invalid unicode scalar value \\%c%s", c, hex)
+		}
+		sb.WriteRune(r)
+		p.pos += size
+	default:
+		return p.errorf("invalid escape sequence \\%c", c)
+	}
+	return nil
+}
+
+func (p *parser) parseArray() ([]any, error) {
+	p.pos++ // [
+	values := []any{}
+	for {
+		if err := p.skipBlank(); err != nil {
+			return nil, err
+		}
+		if p.peek() == ']' {
+			p.pos++
+			return values, nil
+		}
+		value, err := p.parseValue()
+		if err != nil {
+			return nil, err
+		}
+		values = append(values, value)
+		if err := p.skipBlank(); err != nil {
+			return nil, err
+		}
+		switch p.peek() {
+		case ',':
+			p.pos++
+		case ']':
+			p.pos++
+			return values, nil
+		default:
+			if p.eof() {
+				return nil, p.errorf("unterminated array")
+			}
+			return nil, p.errorf("expected ',' or ']' in array, found %q", p.peek())
+		}
+	}
+}
+
+func (p *parser) parseInlineTable() (*table, error) {
+	p.pos++ // {
+	t := newTable(tableHeader)
+	for {
+		if err := p.skipBlank(); err != nil {
+			return nil, err
+		}
+		if p.peek() == '}' {
+			p.pos++
+			t.freeze()
+			return t, nil
+		}
+		if err := p.parseKeyValue(t); err != nil {
+			return nil, err
+		}
+		if err := p.skipBlank(); err != nil {
+			return nil, err
+		}
+		switch p.peek() {
+		case ',':
+			p.pos++
+		case '}':
+			p.pos++
+			t.freeze()
+			return t, nil
+		default:
+			if p.eof() {
+				return nil, p.errorf("unterminated inline table")
+			}
+			return nil, p.errorf("expected ',' or '}' in inline table, found %q", p.peek())
+		}
+	}
+}
+
+var (
+	decimalIntRe = regexp.MustCompile(`^[+-]?(0|[1-9](_?[0-9])*)$`)
+	hexIntRe     = regexp.MustCompile(`^0x[0-9A-Fa-f](_?[0-9A-Fa-f])*$`)
+	octIntRe     = regexp.MustCompile(`^0o[0-7](_?[0-7])*$`)
+	binIntRe     = regexp.MustCompile(`^0b[01](_?[01])*$`)
+	floatRe      = regexp.MustCompile(`^[+-]?(0|[1-9](_?[0-9])*)(\.[0-9](_?[0-9])*)?([eE][+-]?[0-9](_?[0-9])*)?$`)
+	specialFloat = regexp.MustCompile(`^[+-]?(inf|nan)$`)
+	dateRe       = regexp.MustCompile(`^([0-9]{4})-([0-9]{2})-([0-9]{2})$`)
+	timeRe       = regexp.MustCompile(`^([0-9]{2}):([0-9]{2})(:([0-9]{2})(\.[0-9]+)?)?$`)
+	offsetRe     = regexp.MustCompile(`^([0-9]{2}):([0-9]{2})$`)
+)
+
+func isValueChar(c byte) bool {
+	return isBareKeyChar(c) || c == '+' || c == '.' || c == ':'
+}
+
+func (p *parser) parseNumberOrDatetime() (any, error) {
+	start := p.pos
+	for !p.eof() && isValueChar(p.src[p.pos]) {
+		p.pos++
+	}
+	// a space may separate the date and the time of a date-time
+	if dateRe.MatchString(p.src[start:p.pos]) && p.pos+1 < len(p.src) &&
+		p.src[p.pos] == ' ' && '0' <= p.src[p.pos+1] && p.src[p.pos+1] <= '9' {
+		p.pos++
+		for !p.eof() && isValueChar(p.src[p.pos]) {
+			p.pos++
+		}
+	}
+	token := p.src[start:p.pos]
+	if token == "" {
+		return nil, p.errorf("invalid value %q", p.peek())
+	}
+
+	switch {
+	case decimalIntRe.MatchString(token):
+		return p.parseInt(token, strings.ReplaceAll(token, "_", ""), 10)
+	case hexIntRe.MatchString(token):
+		return p.parseInt(token, strings.ReplaceAll(token[2:], "_", ""), 16)
+	case octIntRe.MatchString(token):
+		return p.parseInt(token, strings.ReplaceAll(token[2:], "_", ""), 8)
+	case binIntRe.MatchString(token):
+		return p.parseInt(token, strings.ReplaceAll(token[2:], "_", ""), 2)
+	case floatRe.MatchString(token):
+		f, err := strconv.ParseFloat(strings.ReplaceAll(token, "_", ""), 64)
+		if err != nil {
+			return nil, p.errorf("invalid float %q", token)
+		}
+		return f, nil
+	case specialFloat.MatchString(token):
+		switch strings.TrimLeft(token, "+-") {
+		case "inf":
+			if token[0] == '-' {
+				return math.Inf(-1), nil
+			}
+			return math.Inf(1), nil
+		default:
+			return math.NaN(), nil
+		}
+	}
+	if isDatetime(token) {
+		return Datetime(token), nil
+	}
+	return nil, p.errorf("invalid value %q", token)
+}
+
+func (p *parser) parseInt(token, digits string, base int) (int64, error) {
+	n, err := strconv.ParseInt(digits, base, 64)
+	if err != nil {
+		return 0, p.errorf("invalid integer %q", token)
+	}
+	return n, nil
+}
+
+// isDatetime reports whether s is an offset date-time, local date-time, local
+// date, or local time.
+func isDatetime(s string) bool {
+	if isTime(s) {
+		return true
+	}
+	if len(s) < 10 || !isDate(s[:10]) {
+		return false
+	}
+	rest := s[10:]
+	if rest == "" {
+		return true
+	}
+	if rest[0] != 'T' && rest[0] != 't' && rest[0] != ' ' {
+		return false
+	}
+	rest = rest[1:]
+	switch {
+	case strings.HasSuffix(rest, "Z") || strings.HasSuffix(rest, "z"):
+		return isTime(rest[:len(rest)-1])
+	case strings.LastIndexAny(rest, "+-") >= 0:
+		i := strings.LastIndexAny(rest, "+-")
+		m := offsetRe.FindStringSubmatch(rest[i+1:])
+		return m != nil && atoi(m[1]) <= 23 && atoi(m[2]) <= 59 && isTime(rest[:i])
+	default:
+		return isTime(rest)
+	}
+}
+
+func isDate(s string) bool {
+	m := dateRe.FindStringSubmatch(s)
+	if m == nil {
+		return false
+	}
+	year, month, day := atoi(m[1]), atoi(m[2]), atoi(m[3])
+	if month < 1 || month > 12 || day < 1 {
+		return false
+	}
+	daysInMonth := time.Date(year, time.Month(month)+1, 0, 0, 0, 0, 0, time.UTC).Day()
+	return day <= daysInMonth
+}
+
+func isTime(s string) bool {
+	m := timeRe.FindStringSubmatch(s)
+	if m == nil {
+		return false
+	}
+	if atoi(m[1]) > 23 || atoi(m[2]) > 59 {
+		return false
+	}
+	return m[4] == "" || atoi(m[4]) <= 60
+}
+
+func atoi(s string) int {
+	n, _ := strconv.Atoi(s)
+	return n
+}
