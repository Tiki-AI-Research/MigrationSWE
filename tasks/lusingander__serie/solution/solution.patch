+++ b/core/config_test.go
@@ -0,0 +1,210 @@
+package core
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestConfigOrderAndMailmap(t *testing.T) {
+	config, err := ParseCoreConfig(`
+[core.option]
+order = "topo"
+
+[core.git]
+mailmap = true
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.Order != SortTopological {
+		t.Fatalf("unexpected order: %v", config.Order)
+	}
+	if !config.Mailmap {
+		t.Fatal("mailmap should be enabled")
+	}
+
+	config, err = ParseCoreConfig(`
+[core.option]
+order = "chrono"
+[core.git]
+mailmap = false
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.Order != SortChronological || config.Mailmap {
+		t.Fatalf("unexpected config: %+v", config)
+	}
+}
+
+func TestConfigIgnoresUISections(t *testing.T) {
+	config, err := ParseCoreConfig(`
+[core.option]
+order = "chrono"
+
+[ui.list]
+order = "topo"
+columns = ["date", "subject"]
+
+[graph]
+row_image_width = "fixed"
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.Order != SortChronological {
+		t.Fatalf("UI section affected core order: %v", config.Order)
+	}
+}
+
+func TestConfigComplexValues(t *testing.T) {
+	config, err := ParseCoreConfig(`
+[core.option]
+protocol = "auto"
+order = "topo"
+graph_width = "auto"
+
+[core.git]
+mailmap = true
+
+[core.user_command]
+commands_1 = { name = "git diff", commands = ["git", "--no-pager", "diff", "{{first_parent_hash}}", "{{target_hash}}"]}
+commands_2 = { name = "echo hello", type = "silent", commands = ["echo", "hello"], refresh = true }
+tab_width = 4
+
+[ui.list]
+columns = ["graph", "marker", "subject", "name", "hash", "date"]
+cursor_type = { virtual = "|" }
+
+[graph.color]
+branches = [
+  "#E06C76",
+  "#98C379",
+  "#E5C07B",
+  "#61AFEF",
+  "#C678DD",
+  "#56B6C2",
+]
+edge = "#00000000"
+background = "#00000000"
+
+[color]
+fg = "#ffffff" # inline comment
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.Order != SortTopological || !config.Mailmap {
+		t.Fatalf("unexpected config: %+v", config)
+	}
+}
+
+func TestConfigInvalidOrder(t *testing.T) {
+	_, err := ParseCoreConfig(`
+[core.option]
+order = "sideways"
+`)
+	if err == nil || !strings.Contains(err.Error(), "invalid value") {
+		t.Fatalf("expected invalid order error, got %v", err)
+	}
+}
+
+func TestConfigPathPrecedence(t *testing.T) {
+	dir := t.TempDir()
+	explicit := filepath.Join(dir, "explicit.toml")
+	if err := os.WriteFile(explicit, []byte("[core.option]\norder = \"topo\"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SERIE_CONFIG_FILE", explicit)
+	config, err := LoadConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.Order != SortTopological {
+		t.Fatalf("SERIE_CONFIG_FILE was not used: %+v", config)
+	}
+
+	missing := filepath.Join(dir, "missing.toml")
+	t.Setenv("SERIE_CONFIG_FILE", missing)
+	_, err = LoadConfig()
+	if err == nil || !strings.Contains(err.Error(), "Config file specified by $SERIE_CONFIG_FILE environment variable not found") {
+		t.Fatalf("unexpected missing env-file error: %v", err)
+	}
+
+	unsetEnv(t, "SERIE_CONFIG_FILE")
+	xdg := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(xdg, "serie"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(xdg, "serie", "config.toml"), []byte("[core.git]\nmailmap = true\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("XDG_CONFIG_HOME", xdg)
+	config, err = LoadConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !config.Mailmap {
+		t.Fatalf("XDG config was not used: %+v", config)
+	}
+
+	unsetEnv(t, "XDG_CONFIG_HOME")
+	home := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(home, ".config", "serie"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(home, ".config", "serie", "config.toml"), []byte("[core.option]\norder = \"topo\"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("HOME", home)
+	config, err = LoadConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.Order != SortTopological {
+		t.Fatalf("home fallback was not used: %+v", config)
+	}
+}
+
+func TestConfigMissingFallbackUsesDefaults(t *testing.T) {
+	unsetEnv(t, "SERIE_CONFIG_FILE")
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	config, err := LoadConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.Order != SortChronological || config.Mailmap {
+		t.Fatalf("unexpected defaults: %+v", config)
+	}
+}
+
+func unsetEnv(t *testing.T, key string) {
+	t.Helper()
+	old, ok := os.LookupEnv(key)
+	if err := os.Unsetenv(key); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if ok {
+			_ = os.Setenv(key, old)
+		} else {
+			_ = os.Unsetenv(key)
+		}
+	})
+}
+
+func TestConfigEquivalentTOMLForms(t *testing.T) {
+	for _, content := range []string{
+		`core = { option = { order = "topo" }, git = { mailmap = true } }`,
+		"[core]\noption = { order = 'topo' }\ngit = { mailmap = true }\n",
+		"core.option.order = 'topo'\ncore.git.mailmap = true\n",
+		"[\"core\".\"option\"]\norder = 'topo'\n[core.git]\nmailmap = true\n",
+	} {
+		config, err := ParseCoreConfig(content)
+		if err != nil || config.Order != SortTopological || !config.Mailmap {
+			t.Fatalf("config %q = %+v, %v; want topo/true", content, config, err)
+		}
+	}
+}
