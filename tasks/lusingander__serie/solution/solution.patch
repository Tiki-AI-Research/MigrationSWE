+	loaded, err := Load(repo.dir, SortChronological, intPtr(1), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	graph := CalcGraph(loaded)
+	if len(graph.Commits) != 1 {
+		t.Fatalf("expected one commit, got %d", len(graph.Commits))
+	}
+	foundDown := false
+	for _, edge := range graph.Edges[0] {
+		if edge.EdgeType == EdgeTypeDown && edge.PosX == graph.CommitPosMap[graph.Commits[0].CommitHash].PosX {
+			foundDown = true
+		}
+	}
+	if !foundDown {
+		t.Fatalf("truncated parent did not emit a down edge: %+v", graph.Edges[0])
+	}
+	if graph.MaxPosX < graph.CommitPosMap[graph.Commits[0].CommitHash].PosX {
+		t.Fatalf("max lane does not include commit lane: %+v", graph)
+	}
