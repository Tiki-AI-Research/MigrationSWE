+	head := commits[0]
+	if head.CommitHash.Full != second || head.CommitHash.Short != second[:7] {
+		t.Fatalf("unexpected hashes: %+v", head.CommitHash)
+	}
+	if head.AuthorName != testAuthorName || head.AuthorEmail != testAuthorEmail {
