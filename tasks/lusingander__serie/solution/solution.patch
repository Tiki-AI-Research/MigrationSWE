+func TestJSONFieldNames(t *testing.T) {
+	repo := newTestRepo(t)
+	hash := repo.commit("001", "2024-01-01T01:02:03+09:00")
+	loaded, err := Load(repo.dir, SortChronological, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := json.Marshal(loaded.AllCommits()[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	var object map[string]any
+	if err := json.Unmarshal(data, &object); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{
+		"commit_hash", "author_name", "author_email", "author_date",
+		"committer_name", "committer_email", "committer_date",
+		"subject", "body", "parent_commit_hashes",
+	} {
+		if _, ok := object[key]; !ok {
+			t.Fatalf("missing JSON field %q in %s", key, data)
+		}
+	}
+	if object["commit_hash"] != hash {
+		t.Fatalf("commit_hash should serialize as the full string: %v", object["commit_hash"])
+	}
+	if _, ok := object["author_date"].(string); !ok {
+		t.Fatalf("author_date should serialize as a string: %v", object["author_date"])
+	}
+
+	edgeData, err := json.Marshal(Edge{EdgeType: EdgeTypeVertical, PosX: 1, AssociatedLinePosX: 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	object = nil
+	if err := json.Unmarshal(edgeData, &object); err != nil {
+		t.Fatal(err)
+	}
+	if object["edge_type"] != "vertical" || object["pos_x"] != float64(1) || object["associated_line_pos_x"] != float64(2) {
+		t.Fatalf("unexpected edge JSON: %s", edgeData)
+	}
+}
