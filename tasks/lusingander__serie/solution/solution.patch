+		}
+		graph := CalcGraph(loaded)
+		bySubject := map[string]Position{}
+		for _, commit := range graph.Commits {
+			bySubject[commit.Subject] = graph.CommitPosMap[commit.CommitHash]
+		}
+		if bySubject["002"].PosX != 0 || bySubject["002"].PosY != 0 {
+			t.Fatalf("unexpected 002 position: %+v", bySubject["002"])
+		}
+		if bySubject["011"].PosX != 1 || bySubject["011"].PosY != 1 {
+			t.Fatalf("unexpected 011 position: %+v", bySubject["011"])
+		}
+		if bySubject["001"].PosX != 0 || bySubject["001"].PosY != 2 {
+			t.Fatalf("unexpected 001 position: %+v", bySubject["001"])
+		}
+	})
+}
+
+func TestEdgeSortingAndDedup(t *testing.T) {
+	edges := []Edge{
+		{EdgeType: EdgeTypeRight, PosX: 0, AssociatedLinePosX: 2},
+		{EdgeType: EdgeTypeVertical, PosX: 2, AssociatedLinePosX: 1},
+		{EdgeType: EdgeTypeHorizontal, PosX: 1, AssociatedLinePosX: 1},
+		{EdgeType: EdgeTypeVertical, PosX: 0, AssociatedLinePosX: 1},
+		{EdgeType: EdgeTypeVertical, PosX: 2, AssociatedLinePosX: 1},
+		{EdgeType: EdgeTypeVertical, PosX: 0, AssociatedLinePosX: 2},
+	}
+	got := SortAndDedupEdges(edges)
+	want := []Edge{
+		{EdgeType: EdgeTypeVertical, PosX: 0, AssociatedLinePosX: 1},
+		{EdgeType: EdgeTypeHorizontal, PosX: 1, AssociatedLinePosX: 1},
+		{EdgeType: EdgeTypeVertical, PosX: 2, AssociatedLinePosX: 1},
+		{EdgeType: EdgeTypeVertical, PosX: 0, AssociatedLinePosX: 2},
+		{EdgeType: EdgeTypeRight, PosX: 0, AssociatedLinePosX: 2},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("unexpected sorted edges\nwant: %+v\ngot:  %+v", want, got)
+	}
+}
