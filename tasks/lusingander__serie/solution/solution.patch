+		graph := CalcGraph(loaded)
+		for y, commit := range graph.Commits {
+			position := graph.CommitPosMap[commit.CommitHash]
+			if position.PosX != 0 || position.PosY != y {
+				t.Fatalf("unexpected position for %s: %+v", commit.Subject, position)
+			}
