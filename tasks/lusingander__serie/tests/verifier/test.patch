new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-P2P-0001/run_p2p.py
@@ -0,0 +1,137 @@
+#!/usr/bin/env python3
+import json
+import os
+import re
+import subprocess
+import sys
+
+
+BATCH_ID = "BATCH-P2P-0001"
+HERE = os.path.dirname(os.path.abspath(__file__))
+SHARED = os.path.abspath(
+    os.path.join(HERE, "..", "..", "..", "shared", "batches", BATCH_ID, "observations.json")
+)
+PROTECTED_PATHS = (
+    "src/app.rs",
+    "src/view",
+    "src/widget",
+    "src/protocol.rs",
+    "src/graph/image.rs",
+    "src/graph/geometry.rs",
+    "src/color.rs",
+    "src/keybind.rs",
+    "src/config.rs",
+    "src/external.rs",
+    "src/main.rs",
+    "src/tests/graph.rs",
+    "src/tests/mailmap.rs",
+    "config.schema.json",
+    "tests/graph",
+)
+TEST_LINE = re.compile(r"^test\s+(\S+)\s+\.\.\.\s+(ok|FAILED|ignored)\s*$")
+
+
+def run(command, cwd, env=None):
+    return subprocess.run(
+        command,
+        cwd=cwd,
+        env=env,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+    )
+
+
+def parse_cargo_tests(output):
+    statuses = {}
+    for line in output.splitlines():
+        match = TEST_LINE.match(line.strip())
+        if match:
+            statuses[match.group(1)] = match.group(2)
+    return statuses
+
+
+def files_exist(repo):
+    missing = [path for path in PROTECTED_PATHS if not os.path.exists(os.path.join(repo, path))]
+    return missing
+
+
+def structural_check(name, repo, cargo_ok, statuses):
+    if name == "source-protected-files":
+        missing = files_exist(repo)
+        if missing:
+            return False, "protected baseline paths are missing: " + ", ".join(missing)
+        snapshots = os.path.join(repo, "tests", "graph")
+        if not os.path.isdir(snapshots):
+            return False, "tests/graph snapshot directory is missing"
+        pngs = [name for name in os.listdir(snapshots) if name.endswith(".png")]
+        if not pngs:
+            return False, "tests/graph contains no PNG snapshots"
+        return True, "protected Rust sources, tests, schema, and PNG snapshots are present"
+    return False, "unknown structural check: " + name
+
+
+def main():
+    repo = os.path.abspath(sys.argv[1]) if len(sys.argv) > 1 else "/workspace/repo"
+    report = os.path.abspath(sys.argv[2]) if len(sys.argv) > 2 else os.path.join(HERE, "result.json")
+    with open(SHARED, "r", encoding="utf-8") as handle:
+        spec = json.load(handle)
+
+    env = dict(os.environ)
+    env.setdefault("NO_COLOR", "1")
+    cargo = run(["cargo", "test", "--verbose"], repo, env=env)
+    statuses = parse_cargo_tests(cargo.stdout)
+    cargo_ok = cargo.returncode == 0
+
+    observations = {}
+    failed = []
+    for observation in spec["observations"]:
+        probe = observation["source_probe"]
+        if probe["kind"] == "cargo-test":
+            filters = probe.get("filters") or []
+            if filters:
+                selected = {
+                    name: status
+                    for name, status in statuses.items()
+                    if any(fragment in name for fragment in filters)
+                }
+                bad = [name for name, status in selected.items() if status != "ok"]
+                ok = bool(selected) and not bad
+                if not selected:
+                    detail = "no source test matched filters: " + ", ".join(filters)
+                elif bad:
+                    detail = "source tests did not pass: " + ", ".join(bad)
+                else:
+                    detail = "selected Rust tests passed"
+            else:
+                bad = [name for name, status in statuses.items() if status == "FAILED"]
+                ok = cargo_ok and not bad
+                detail = "full cargo test suite passed" if ok else "cargo test suite failed"
+        else:
+            ok, detail = structural_check(probe["check"], repo, cargo_ok, statuses)
+
+        value = {"result": "PASS"} if ok else {"result": "FAIL", "detail": detail}
+        observations[observation["id"]] = value
+        if not ok:
+            failed.append(observation["id"])
+
+    payload = {
+        "batch_id": BATCH_ID,
+        "side": "source",
+        "relation": spec["relation"],
+        "observations": observations,
+    }
+    os.makedirs(os.path.dirname(report), exist_ok=True)
+    with open(report, "w", encoding="utf-8") as handle:
+        json.dump(payload, handle, indent=2, sort_keys=True)
+        handle.write("\n")
+
+    print(json.dumps(payload, sort_keys=True))
+    if failed:
+        print("failed observations: " + ", ".join(failed), file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
