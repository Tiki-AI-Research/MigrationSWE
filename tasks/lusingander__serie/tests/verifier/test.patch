+}
+
+func checkCommitDetail(repo *core.Repository, info *complexFixture) error {
+	root, rootChanges := repo.CommitDetail(core.NewCommitHash(info.root))
+	if root.CommitHash.Full != info.root || len(rootChanges) == 0 {
