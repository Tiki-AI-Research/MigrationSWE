+	script := "#!/bin/sh\nprintf '%s\\n' \"$*\" >> " + fmt.Sprintf("%q", logPath) + "\nexec " + fmt.Sprintf("%q", realGit) + " \"$@\"\n"
+	if err := os.WriteFile(wrapper, []byte(script), 0o755); err != nil {
