new file mode 100644
--- /dev/null
+++ b/tests/target/batches/BATCH-DIFFERENTIAL-0001/probe.sh
@@ -0,0 +1,45 @@
+#!/bin/sh
+# Run the differential target probe against a candidate Go core.
+# Usage: probe.sh <repository-dir> [junit-report]
+set -eu
+
+repo=${1:?usage: probe.sh <repository-dir> [junit-report]}
+report=${2:-}
+
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+test_file="$here/core/diffbatch0001_test.go"
+target_dir="$repo/core"
+
+if [ ! -f "$test_file" ]; then
+  echo "missing differential test asset: $test_file" >&2
+  exit 2
+fi
+if [ ! -d "$target_dir" ]; then
+  echo "candidate has no core package at $target_dir" >&2
+  exit 1
+fi
+
+copied=0
+if [ ! -e "$target_dir/diffbatch0001_test.go" ]; then
+  cp "$test_file" "$target_dir/diffbatch0001_test.go"
+  copied=1
+fi
+cleanup() {
+  if [ "$copied" -eq 1 ]; then
+    rm -f "$target_dir/diffbatch0001_test.go"
+  fi
+}
+trap cleanup EXIT HUP INT TERM
+
+export GOPROXY=${GOPROXY:-off}
+export GOSUMDB=${GOSUMDB:-off}
+export GOTOOLCHAIN=${GOTOOLCHAIN:-local}
+export GOFLAGS=${GOFLAGS:--mod=readonly}
+export GOCACHE=${GOCACHE:-$repo/.gocache}
+export GOMODCACHE=${GOMODCACHE:-$repo/.gomodcache}
+
+cd "$repo"
+if [ -n "$report" ]; then
+  exec gotestsum --junitfile="$report" --format=standard-verbose -- -run 'TestDiffB0001' ./core
+fi
+exec go test -count=1 -run 'TestDiffB0001' ./core
