+	"testing"
+	"time"
+)
+
+const (
+	dif1AuthorName     = "Diff Author"
+	dif1AuthorEmail    = "diff-author@example.com"
+	dif1CommitterName  = "Diff Committer"
+	dif1CommitterEmail = "diff-committer@example.com"
