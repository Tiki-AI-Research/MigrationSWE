+func f2pSetEnv(t *testing.T, key, value string, present bool) {
+	t.Helper()
+	old, had := os.LookupEnv(key)
+	if present {
+		if err := os.Setenv(key, value); err != nil {
+			t.Fatal(err)
+		}
+	} else if err := os.Unsetenv(key); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if had {
+			_ = os.Setenv(key, old)
+		} else {
+			_ = os.Unsetenv(key)
+		}
+	})
+}
