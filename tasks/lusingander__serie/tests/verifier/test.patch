+++ b/tests/source/batches/BATCH-F2P-0003/probe.py
@@ -0,0 +1,240 @@
+#!/usr/bin/env python3
+"""Source-side F2P probe for BATCH-F2P-0003.
+
+Each observation is projected onto a concrete target-technology entry point.
+The probe is data-driven: it reports PASS only when the Go entry point for that
+observation is present and usable.  On the Rust source technology none of the
+Go entry points exist, so every observation is a semantic FAIL rather than a
+harness error.
+"""
+
+import json
+import os
+import re
+import subprocess
+import sys
+
+
+def read(path):
+    try:
+        with open(path, "r", encoding="utf-8") as handle:
+            return handle.read()
+    except OSError:
+        return ""
+
+
+def module_root(start):
+    current = os.path.abspath(start)
+    while True:
+        if os.path.isfile(os.path.join(current, "go.mod")):
+            return current
+        parent = os.path.dirname(current)
+        if parent == current:
+            return None
+        current = parent
+
+
+def require_files(root, names):
+    missing = [name for name in names if not os.path.isfile(os.path.join(root, name))]
+    if missing:
+        return False, "missing Go entry files: " + ", ".join(missing)
+    return True, ""
+
+
+def require_text(root, path, needles):
+    content = read(os.path.join(root, path))
+    if not content:
+        return False, "missing Go entry file: " + path
+    missing = [needle for needle in needles if needle not in content]
+    if missing:
+        return False, path + " lacks " + ", ".join(missing)
+    return True, ""
+
+
+def require_all(root, requirements):
+    for path, needles in requirements:
+        ok, reason = require_text(root, path, needles)
+        if not ok:
+            return False, reason
+    return True, ""
+
+
+def commit_parser_no_rust(root):
+    ok, reason = require_text(root, "core/gitcmd.go", ["func parseCommitRecord("])
+    if not ok:
+        return False, reason
+    return no_rust_delegation(root)
+
+
+def loader_no_rust(root):
+    ok, reason = require_text(root, "core/repository.go", ["func Load(", "maxCount"])
+    if not ok:
+        return False, reason
+    return no_rust_delegation(root)
+
+
+def validator_no_rust(root):
+    ok, reason = require_text(root, "core/gitcmd.go", ["func checkGitRepository("])
+    if not ok:
+        return False, reason
+    return no_rust_delegation(root)
+
+
+def dependency_policy(root):
+    go_mod = read(os.path.join(root, "go.mod"))
+    if "module github.com/lusingander/serie" not in go_mod:
+        return False, "go.mod does not declare github.com/lusingander/serie"
+    if not re.search(r"(?m)^go\s+1\.24\.0\s*$", go_mod):
+        return False, "go.mod does not declare Go 1.24.0"
+    for line in go_mod.splitlines():
+        if line.strip().startswith("require"):
+            return False, "third-party requirement present: " + line.strip()
+    for name in ("Cargo.toml", ".gitignore"):
+        if not os.path.isfile(os.path.join(root, name)):
+            return False, name + " is missing"
+    environment = dict(os.environ)
+    environment.update(
+        {
+            "CGO_ENABLED": "0",
+            "GOPROXY": "off",
+            "GOSUMDB": "off",
+            "GOTOOLCHAIN": "local",
+            "GOFLAGS": "-mod=readonly",
+        }
+    )
+    try:
+        result = subprocess.run(
+            ["go", "build", "-buildvcs=false", "./..."],
+            cwd=root,
+            env=environment,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            timeout=300,
+        )
+    except (OSError, subprocess.TimeoutExpired) as error:
+        return False, "offline Go build could not run: %s" % (error,)
+    if result.returncode != 0:
+        return False, "offline Go build failed: " + result.stdout.decode("utf-8", "replace")
+    return True, ""
+
+
+def no_rust_delegation(root):
+    forbidden = (
+        'exec.Command("cargo"',
+        'exec.Command("rustc"',
+        "serie-core-rs",
+        "libserie",
+        'import "C"',
+        "plugin.Open(",
+        "net/rpc",
+    )
+    for directory, _, files in os.walk(root):
+        if os.path.basename(directory) in (".git", "batches", "vendor"):
+            continue
+        for name in files:
+            if not name.endswith(".go") or name.endswith("_test.go"):
+                continue
+            path = os.path.join(directory, name)
+            content = read(path)
+            for needle in forbidden:
+                if needle in content:
+                    return False, path + " contains " + needle
+    return True, ""
+
+
+CHECKS = {
+    "F2P-051": lambda root: require_text(
+        root, "core/config.go", ["func LoadConfig(", "SERIE_CONFIG_FILE", "XDG_CONFIG_HOME", "func configFilePath("]
+    ),
+    "F2P-055": dependency_policy,
+    "F2P-070": lambda root: require_text(
+        root, "cmd/serie-core/main.go", ["func parseFlags(", "too many arguments", "opts.path = \".\""]
+    ),
+    "F2P-064": lambda root: require_text(
+        root, "core/graph.go", ["func CalcGraph(", "func calcCommitPositions(", "func getFirstVacantLine(", "func updateCommitLine("]
+    ),
+    "F2P-065": lambda root: require_text(
+        root, "core/config.go", ["func ParseCoreConfig(", "core.option.order", "core.git.mailmap"]
+    ),
+    "F2P-068": lambda root: require_text(
+        root, "core/graph.go", ["func SortAndDedupEdges(", "AssociatedLinePosX", "EdgeType"]
+    ),
+    "F2P-069": lambda root: require_text(
+        root, "core/graph.go", ["func CalcGraph(", "CommitPosMap", "MaxPosX"]
+    ),
+    "F2P-071": lambda root: require_text(
+        root, "core/serie.go", ["type Edge struct", "type EdgeType", "edgeTypeNames", "associated_line_pos_x"]
+    ),
+    "F2P-072": lambda root: require_text(
+        root, "core/repository.go", ["func (r *Repository) AllCommits(", "func (r *Repository) AllRefs("]
+    ),
+    "F2P-052": lambda root: require_text(
+        root, "core/gitcmd.go", ["func runGit(", '"show-ref", "--head", "--dereference"', '"stash", "list"']
+    ),
+    "F2P-049": lambda root: require_text(
+        root, "core/repository.go", ["func mergeStashesToCommits(", "func (r *Repository) Refs("]
+    ),
+    "F2P-050": lambda root: require_text(
+        root, "core/gitcmd.go", ["func loadCommitsFormat(", "%aN", "%cE"]
+    ),
+    "F2P-053": lambda root: require_all(
+        root,
+        [
+            ("core/repository.go", ["func (r *Repository) CommitDetail("]),
+            ("core/gitcmd.go", ["func checkGitRepository("]),
+        ],
+    ),
+    "F2P-054": lambda root: require_text(
+        root, "core/gitcmd.go", ["func parseCommitRecord(", "func parseCommitRecords(", "parseParentCommitHashes("]
+    ),
+    "F2P-056": lambda root: require_text(
+        root, "core/repository.go", ["func Load(", "func LoadRepository(", "maxCount"]
+    ),
+    "F2P-057": lambda root: require_all(
+        root,
+        [
+            ("core/repository.go", ["func (r *Repository) AllRefs("]),
+            ("core/serie.go", ["func CompareRefs("]),
+        ],
+    ),
+    "F2P-058": lambda root: require_text(
+        root, "core/graph.go", ["func CalcGraph(", "func calcEdges(", "sort.SliceStable"]
+    ),
+    "F2P-059": lambda root: require_text(
+        root, "core/gitcmd.go", ["func loadCommitsFormat(", "%aN", "%aE", "%cN", "%cE"]
+    ),
+    "F2P-060": commit_parser_no_rust,
+    "F2P-061": lambda root: require_text(
+        root, "core/repository.go", ["func mergeStashesToCommits(", "func (r *Repository) CommitDetail("]
+    ),
+    "F2P-062": loader_no_rust,
+    "F2P-063": validator_no_rust,
+    "F2P-066": lambda root: require_text(
+        root, "core/serie.go", ["type Commit struct", "commit_hash", "author_date", "committer_date"]
+    ),
+    "F2P-067": lambda root: require_text(
+        root, "core/serie.go", ["func NewCommitHash(", "AsShortHash("]
+    ),
+}
+
+
+def main():
+    repo = os.path.abspath(sys.argv[1]) if len(sys.argv) > 1 else os.getcwd()
+    root = module_root(repo)
+    results = []
+    failures = 0
+    for observation_id in sorted(CHECKS):
+        if root is None:
+            ok, reason = False, "no Go module on the repository loading path"
+        else:
+            ok, reason = CHECKS[observation_id](root)
+        status = "PASS" if ok else "FAIL"
+        if not ok:
+            failures += 1
+        results.append({"observation_id": observation_id, "status": status, "reason": reason})
+    print(json.dumps({"repo": repo, "results": results}, indent=2, sort_keys=True))
+    return 0 if failures == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
