+++ b/cmd/serie-core/main_test.go
@@ -0,0 +1,188 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/lusingander/serie/core"
+)
+
+func TestMaxCountFlag(t *testing.T) {
+	opts, err := parseFlags([]string{"-n", "2", "/tmp/repo"}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !opts.maxCount.set || opts.maxCount.value != 2 || opts.path != "/tmp/repo" {
+		t.Fatalf("unexpected options: %+v", opts)
+	}
+
+	opts, err = parseFlags([]string{"--max-count=3"}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !opts.maxCount.set || opts.maxCount.value != 3 || opts.path != "." {
+		t.Fatalf("unexpected options: %+v", opts)
+	}
+
+	opts, err = parseFlags([]string{"/tmp/repo", "-n", "4"}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !opts.maxCount.set || opts.maxCount.value != 4 || opts.path != "/tmp/repo" {
+		t.Fatalf("path before flags was not parsed: %+v", opts)
+	}
+}
+
+func TestOrderFlag(t *testing.T) {
+	opts, err := parseFlags([]string{"--order", "topo"}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !opts.order.set || opts.order.value != core.SortTopological {
+		t.Fatalf("unexpected options: %+v", opts)
+	}
+
+	opts, err = parseFlags([]string{"-o", "chrono"}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !opts.order.set || opts.order.value != core.SortChronological {
+		t.Fatalf("unexpected options: %+v", opts)
+	}
+}
+
+func TestCLIOverridesConfig(t *testing.T) {
+	opts, err := parseFlags([]string{"--order=chrono", "--mailmap=false", "-n", "1"}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config := core.Config{Order: core.SortTopological, Mailmap: true}
+	path, order, maxCount, mailmap := resolveOptions(opts, config)
+	if path != "." {
+		t.Fatalf("unexpected path: %s", path)
+	}
+	if order != core.SortChronological {
+		t.Fatalf("CLI order did not override config: %v", order)
+	}
+	if mailmap {
+		t.Fatal("CLI mailmap=false did not override config")
+	}
+	if maxCount == nil || *maxCount != 1 {
+		t.Fatalf("unexpected max count: %v", maxCount)
+	}
+
+	opts, err = parseFlags(nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, order, maxCount, mailmap = resolveOptions(opts, config)
+	if order != core.SortTopological || !mailmap || maxCount != nil {
+		t.Fatalf("config values were not retained: order=%v mailmap=%v max=%v", order, mailmap, maxCount)
+	}
+}
+
+func TestCLIJSONFieldNames(t *testing.T) {
+	repo := makeCLIRepo(t)
+	configPath := filepath.Join(t.TempDir(), "config.toml")
+	if err := os.WriteFile(configPath, []byte("[core.option]\norder = \"chrono\"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SERIE_CONFIG_FILE", configPath)
+
+	var stdout, stderr bytes.Buffer
+	if err := run([]string{repo}, &stdout, &stderr); err != nil {
+		t.Fatalf("run failed: %v\n%s", err, stderr.String())
+	}
+	var object map[string]any
+	if err := json.Unmarshal(stdout.Bytes(), &object); err != nil {
+		t.Fatalf("invalid JSON: %v\n%s", err, stdout.String())
+	}
+	for _, key := range []string{"commits", "commit_pos_map", "edges", "max_pos_x", "all_refs", "head"} {
+		if _, ok := object[key]; !ok {
+			t.Fatalf("missing CLI JSON field %q", key)
+		}
+	}
+	commits, ok := object["commits"].([]any)
+	if !ok || len(commits) != 1 {
+		t.Fatalf("unexpected commits: %v", object["commits"])
+	}
+	commit, ok := commits[0].(map[string]any)
+	if !ok {
+		t.Fatalf("unexpected commit: %v", commits[0])
+	}
+	if _, ok := commit["commit_hash"].(string); !ok {
+		t.Fatalf("commit_hash must be a string: %v", commit["commit_hash"])
+	}
+	if _, ok := commit["author_date"].(string); !ok {
+		t.Fatalf("author_date must be a string: %v", commit["author_date"])
+	}
+}
+
+func TestUIOnlyOptionsRejected(t *testing.T) {
+	for _, args := range [][]string{
+		{"--protocol", "kitty"},
+		{"--graph-width", "single"},
+		{"--initial-selection", "head"},
+	} {
+		if _, err := parseFlags(args, nil); err == nil {
+			t.Fatalf("UI-only option was accepted: %v", args)
+		}
+	}
+}
+
+func TestDeterministicOutput(t *testing.T) {
+	repo := makeCLIRepo(t)
+	configPath := filepath.Join(t.TempDir(), "config.toml")
+	if err := os.WriteFile(configPath, []byte("[core.option]\norder = \"chrono\"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SERIE_CONFIG_FILE", configPath)
+
+	var first []byte
+	for i := 0; i < 20; i++ {
+		var stdout, stderr bytes.Buffer
+		if err := run([]string{repo}, &stdout, &stderr); err != nil {
+			t.Fatalf("run failed: %v\n%s", err, stderr.String())
+		}
+		if i == 0 {
+			first = append([]byte(nil), stdout.Bytes()...)
+			continue
+		}
+		if !reflect.DeepEqual(first, stdout.Bytes()) {
+			t.Fatalf("CLI output changed on iteration %d", i)
+		}
+	}
+}
+
+func makeCLIRepo(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	git := func(args ...string) {
+		t.Helper()
+		cmd := exec.Command("git", args...)
+		cmd.Dir = dir
+		cmd.Env = append(os.Environ(),
+			"GIT_AUTHOR_NAME=Author Name",
+			"GIT_AUTHOR_EMAIL=author@example.com",
+			"GIT_COMMITTER_NAME=Committer Name",
+			"GIT_COMMITTER_EMAIL=committer@example.com",
+			"GIT_AUTHOR_DATE=2024-01-01T01:02:03+00:00",
+			"GIT_COMMITTER_DATE=2024-01-01T01:02:03+00:00",
+			"GIT_CONFIG_NOSYSTEM=true",
+			"HOME="+dir,
+		)
+		out, err := cmd.CombinedOutput()
+		if err != nil {
+			t.Fatalf("git %s failed: %v\n%s", strings.Join(args, " "), err, out)
+		}
+	}
+	git("init", "-b", "master")
+	git("commit", "--allow-empty", "-m", "001")
+	return dir
+}
diff --git a/core/config.go b/core/config.go
new file mode 100644
index 0000000..70e1b0b
--- /dev/null
+++ b/core/config.go
@@ -0,0 +1,308 @@
+package core
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+const (
+	// CoreOptionOrder is the only in-scope core.option key.
+	CoreOptionOrder = "core.option.order"
+	// CoreGitMailmap is the only in-scope core.git key.
+	CoreGitMailmap = "core.git.mailmap"
+
+	configFileEnvName    = "SERIE_CONFIG_FILE"
+	xdgConfigHomeEnvName = "XDG_CONFIG_HOME"
+	defaultConfigDir     = ".config"
+	appDirName           = "serie"
+	configFileName       = "config.toml"
+)
+
+// Config contains the in-scope core configuration values.
+type Config struct {
+	Order   SortCommit
+	Mailmap bool
+}
+
+// DefaultConfig returns the baseline defaults.
+func DefaultConfig() Config {
+	return Config{Order: SortChronological, Mailmap: false}
+}
+
+// LoadConfig reads the baseline config lookup locations. SERIE_CONFIG_FILE has
+// highest priority and is an error when set but missing. XDG_CONFIG_HOME or the
+// home directory fallback is used otherwise. A missing fallback file means the
+// defaults are used.
+func LoadConfig() (Config, error) {
+	path, explicit := configFilePath()
+	if path == "" {
+		return DefaultConfig(), nil
+	}
+	if _, err := os.Stat(path); err != nil {
+		if os.IsNotExist(err) {
+			if explicit {
+				return Config{}, fmt.Errorf("Config file specified by $%s environment variable not found: %s", configFileEnvName, path)
+			}
+			return DefaultConfig(), nil
+		}
+		return Config{}, err
+	}
+	return LoadConfigFromFile(path)
+}
+
+// LoadConfigFromFile reads only the in-scope keys from a TOML file.
+func LoadConfigFromFile(path string) (Config, error) {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return Config{}, err
+	}
+	return ParseCoreConfig(string(content))
+}
+
+// ParseCoreConfig extracts core.option.order and core.git.mailmap while
+// tolerating comments, arrays, inline tables, multiline arrays, and sections
+// that are outside the Go core's scope.
+func ParseCoreConfig(content string) (Config, error) {
+	config := DefaultConfig()
+	section := ""
+	depth := 0
+
+	lines := strings.Split(strings.ReplaceAll(content, "\r\n", "\n"), "\n")
+	for _, rawLine := range lines {
+		line := stripTOMLComment(rawLine)
+
+		if depth > 0 {
+			depth += bracketDelta(line)
+			if depth < 0 {
+				depth = 0
+			}
+			continue
+		}
+
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" {
+			continue
+		}
+
+		if strings.HasPrefix(trimmed, "[") {
+			if end := strings.LastIndex(trimmed, "]"); end > 0 {
+				inner := strings.TrimSpace(trimmed[1:end])
+				inner = strings.Trim(inner, "[]")
+				section = normalizeTOMLKey(inner)
+				continue
+			}
+		}
+
+		eq := topLevelEquals(trimmed)
+		if eq < 0 {
+			depth += bracketDelta(trimmed)
+			if depth < 0 {
+				depth = 0
+			}
+			continue
+		}
+
+		keyPart := strings.TrimSpace(trimmed[:eq])
+		valuePart := strings.TrimSpace(trimmed[eq+1:])
+		key := normalizeTOMLKey(keyPart)
+		if section != "" {
+			key = section + "." + key
+		}
+
+		switch key {
+		case CoreOptionOrder:
+			value, err := parseTOMLString(valuePart)
+			if err != nil {
+				return Config{}, err
+			}
+			switch value {
+			case "chrono":
+				config.Order = SortChronological
+			case "topo":
+				config.Order = SortTopological
+			default:
+				return Config{}, fmt.Errorf("invalid value for core.option.order: %s", value)
+			}
+		case CoreGitMailmap:
+			value := strings.TrimSpace(valuePart)
+			switch value {
+			case "true":
+				config.Mailmap = true
+			case "false":
+				config.Mailmap = false
+			default:
+				return Config{}, fmt.Errorf("invalid value for core.git.mailmap: %s", value)
+			}
+		}
+
+		depth += bracketDelta(valuePart)
+		if depth < 0 {
+			depth = 0
+		}
+	}
+
+	return config, nil
+}
+
+func configFilePath() (string, bool) {
+	if path, ok := os.LookupEnv(configFileEnvName); ok {
+		return path, true
+	}
+	if dir, ok := os.LookupEnv(xdgConfigHomeEnvName); ok {
+		return filepath.Join(dir, appDirName, configFileName), false
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return "", false
+	}
+	return filepath.Join(home, defaultConfigDir, appDirName, configFileName), false
+}
+
+func stripTOMLComment(line string) string {
+	var quote byte
+	escaped := false
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		if quote != 0 {
+			if quote == '"' && escaped {
+				escaped = false
+				continue
+			}
+			if quote == '"' && c == '\\' {
+				escaped = true
+				continue
+			}
+			if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		switch c {
+		case '"', '\'':
+			quote = c
+		case '#':
+			return line[:i]
+		}
+	}
+	return line
+}
+
+func bracketDelta(line string) int {
+	delta := 0
+	var quote byte
+	escaped := false
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		if quote != 0 {
+			if quote == '"' && escaped {
+				escaped = false
+				continue
+			}
+			if quote == '"' && c == '\\' {
+				escaped = true
+				continue
+			}
+			if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		switch c {
+		case '"', '\'':
+			quote = c
+		case '[', '{':
+			delta++
+		case ']', '}':
+			delta--
+		}
+	}
+	return delta
+}
+
+func topLevelEquals(line string) int {
+	var quote byte
+	escaped := false
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		if quote != 0 {
+			if quote == '"' && escaped {
+				escaped = false
+				continue
+			}
+			if quote == '"' && c == '\\' {
+				escaped = true
+				continue
+			}
+			if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		switch c {
+		case '"', '\'':
+			quote = c
+		case '=':
+			return i
+		}
+	}
+	return -1
+}
+
+func normalizeTOMLKey(key string) string {
+	parts := strings.Split(key, ".")
+	for i, part := range parts {
+		part = strings.TrimSpace(part)
+		if len(part) >= 2 {
+			if (part[0] == '"' && part[len(part)-1] == '"') || (part[0] == '\'' && part[len(part)-1] == '\'') {
+				part = part[1 : len(part)-1]
+			}
+		}
+		parts[i] = part
+	}
+	return strings.Join(parts, ".")
+}
+
+func parseTOMLString(value string) (string, error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return "", fmt.Errorf("expected a string value")
+	}
+	switch value[0] {
+	case '"':
+		end := -1
+		escaped := false
+		for i := 1; i < len(value); i++ {
+			if escaped {
+				escaped = false
+				continue
+			}
+			if value[i] == '\\' {
+				escaped = true
+				continue
+			}
+			if value[i] == '"' {
+				end = i
+				break
+			}
+		}
+		if end < 0 {
+			return "", fmt.Errorf("unterminated string value")
+		}
+		decoded, err := strconv.Unquote(value[:end+1])
+		if err != nil {
+			return "", err
+		}
+		return decoded, nil
+	case '\'':
+		end := strings.IndexByte(value[1:], '\'')
+		if end < 0 {
+			return "", fmt.Errorf("unterminated string value")
+		}
+		return value[1 : 1+end], nil
+	default:
+		return "", fmt.Errorf("expected a quoted string value")
+	}
+}
