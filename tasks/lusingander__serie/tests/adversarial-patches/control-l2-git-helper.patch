+++ b/core/repository_test.go
@@ -0,0 +1,406 @@
+package core
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestRepositoryValidation(t *testing.T) {
+	t.Run("not a repository", func(t *testing.T) {
+		_, err := Load(t.TempDir(), SortChronological, nil, false)
+		if err == nil || err.Error() != "not a git repository (or any of the parent directories)" {
+			t.Fatalf("unexpected error: %v", err)
+		}
+	})
+
+	t.Run("empty repository", func(t *testing.T) {
+		repo := newTestRepo(t)
+		_, err := Load(repo.dir, SortChronological, nil, false)
+		if err == nil || err.Error() != "no commits in the repository" {
+			t.Fatalf("unexpected error: %v", err)
+		}
+	})
+
+	t.Run("bare repository", func(t *testing.T) {
+		repo := newTestRepo(t)
+		repo.commit("001", "2024-01-01T01:02:03+00:00")
+		bare := filepath.Join(t.TempDir(), "bare.git")
+		cloneBare(t, repo.dir, bare)
+		loaded, err := Load(bare, SortChronological, nil, false)
+		if err != nil {
+			t.Fatalf("load bare repository: %v", err)
+		}
+		if got := len(loaded.AllCommits()); got != 1 {
+			t.Fatalf("expected one commit, got %d", got)
+		}
+	})
+}
+
+func TestCommitEnumerationOrder(t *testing.T) {
+	repo := newTestRepo(t)
+	repo.commit("001", "2024-01-01T01:02:03+00:00")
+	repo.checkoutB("10")
+	repo.commit("011", "2024-02-01T01:02:03+00:00")
+	repo.checkout("master")
+	repo.commit("002", "2024-01-02T01:02:03+00:00")
+	repo.merge("2024-03-01T01:02:03+00:00", "10")
+
+	for _, tc := range []struct {
+		name string
+		sort SortCommit
+		flag string
+	}{
+		{"chronological", SortChronological, "--date-order"},
+		{"topological", SortTopological, "--topo-order"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			loaded, err := Load(repo.dir, tc.sort, nil, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			expected := strings.Fields(repo.git("log", tc.flag, "--pretty=%H", "--branches", "--remotes", "--tags", "HEAD"))
+			actual := make([]string, 0)
+			for _, commit := range loaded.AllCommits() {
+				actual = append(actual, commit.CommitHash.Full)
+			}
+			if !reflect.DeepEqual(actual, expected) {
+				t.Fatalf("commit order mismatch\nexpected: %v\nactual:   %v", expected, actual)
+			}
+		})
+	}
+}
+
+func TestCommitFieldsAndDates(t *testing.T) {
+	repo := newTestRepo(t)
+	first := repo.commitFile("001", "2024-01-02T03:04:05+09:30", "a.txt", "one")
+	second := repo.commit("002", "2024-02-03T04:05:06-05:00")
+
+	loaded, err := Load(repo.dir, SortChronological, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	commits := loaded.AllCommits()
+	if len(commits) != 2 {
+		t.Fatalf("expected 2 commits, got %d", len(commits))
+	}
+	head := commits[0]
+	if head.CommitHash.Full != second || head.CommitHash.Short != second[:7] {
+		t.Fatalf("unexpected hashes: %+v", head.CommitHash)
+	}
+	if head.AuthorName != testAuthorName || head.AuthorEmail != testAuthorEmail {
+		t.Fatalf("unexpected author: %s <%s>", head.AuthorName, head.AuthorEmail)
+	}
+	if head.CommitterName != testCommitterName || head.CommitterEmail != testCommitterEmail {
+		t.Fatalf("unexpected committer: %s <%s>", head.CommitterName, head.CommitterEmail)
+	}
+	if got := head.AuthorDate.Format(time.RFC3339); got != "2024-02-03T04:05:06-05:00" {
+		t.Fatalf("author date lost offset: %s", got)
+	}
+	if _, offset := head.AuthorDate.Zone(); offset != -5*60*60 {
+		t.Fatalf("unexpected offset: %d", offset)
+	}
+	if head.Subject != "002" {
+		t.Fatalf("unexpected subject: %s", head.Subject)
+	}
+	old := commits[1]
+	if old.CommitHash.Full != first {
+		t.Fatalf("unexpected old hash: %s", old.CommitHash.Full)
+	}
+	if _, offset := old.AuthorDate.Zone(); offset != 9*60*60+30*60 {
+		t.Fatalf("unexpected first offset: %d", offset)
+	}
+	if !reflect.DeepEqual(head.ParentCommitHashes, []CommitHash{NewCommitHash(first)}) {
+		t.Fatalf("unexpected parents: %+v", head.ParentCommitHashes)
+	}
+	if got := loaded.ParentsHash(NewCommitHash(first)); len(got) != 0 {
+		t.Fatalf("root commit should have no parents, got %v", got)
+	}
+	if got := loaded.ChildrenHash(NewCommitHash(first)); len(got) != 1 || got[0].Full != second {
+		t.Fatalf("unexpected children: %v", got)
+	}
+	if commit := loaded.Commit(NewCommitHash(second)); commit == nil || commit.Subject != "002" {
+		t.Fatalf("commit query failed: %+v", commit)
+	}
+	if loaded.Commit(NewCommitHash("does-not-exist")) != nil {
+		t.Fatal("unknown commit should be nil")
+	}
+}
+
+func TestHeadStates(t *testing.T) {
+	t.Run("branch", func(t *testing.T) {
+		repo := newTestRepo(t)
+		repo.commit("001", "2024-01-01T01:02:03+00:00")
+		loaded, err := Load(repo.dir, SortChronological, nil, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		head := loaded.Head()
+		if head.Kind != HeadKindBranch || head.Name != "master" {
+			t.Fatalf("unexpected head: %+v", head)
+		}
+	})
+
+	t.Run("detached", func(t *testing.T) {
+		repo := newTestRepo(t)
+		hash := repo.commit("001", "2024-01-01T01:02:03+00:00")
+		repo.git("checkout", "--detach", hash)
+		loaded, err := Load(repo.dir, SortChronological, nil, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		head := loaded.Head()
+		if head.Kind != HeadKindDetached || head.Target.Full != hash {
+			t.Fatalf("unexpected head: %+v", head)
+		}
+	})
+
+	t.Run("none", func(t *testing.T) {
+		repo := newTestRepo(t)
+		hash := repo.commit("001", "2024-01-01T01:02:03+00:00")
+		bare := filepath.Join(t.TempDir(), "bare.git")
+		cloneBare(t, repo.dir, bare)
+		cmd := exec.Command("git", "symbolic-ref", "HEAD", "refs/heads/missing")
+		cmd.Dir = bare
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("symbolic-ref failed: %v\n%s", err, out)
+		}
+		cmd = exec.Command("git", "update-ref", "refs/heads/other", hash)
+		cmd.Dir = bare
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("update-ref failed: %v\n%s", err, out)
+		}
+		// Keep a branch reachable while HEAD has no target.
+		cmd = exec.Command("git", "branch", "-D", "master")
+		cmd.Dir = bare
+		_ = cmd.Run()
+		loaded, err := Load(bare, SortChronological, nil, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if loaded.Head().Kind != HeadKindNone {
+			t.Fatalf("unexpected head: %+v", loaded.Head())
+		}
+	})
+}
+
+func TestStashParentEnumerationAndInsertion(t *testing.T) {
+	repo := newTestRepo(t)
+	repo.commit("001", "2024-01-01T01:02:03+00:00")
+	repo.commit("002", "2024-01-02T01:02:03+00:00")
+	stashHash := repo.stash("2024-01-03T01:02:03+00:00")
+	parentHash := repo.revParse("HEAD")
+
+	loaded, err := Load(repo.dir, SortChronological, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	commits := loaded.AllCommits()
+	if len(commits) != 3 {
+		t.Fatalf("expected stash plus two commits, got %d", len(commits))
+	}
+	if commits[0].CommitHash.Full != stashHash {
+		t.Fatalf("stash was not inserted first: %v", commits[0].CommitHash.Full)
+	}
+	if commits[1].CommitHash.Full != parentHash {
+		t.Fatalf("stash was not inserted immediately before its parent")
+	}
+	refs := loaded.Refs(NewCommitHash(stashHash))
+	if len(refs) != 1 || refs[0].Kind != RefKindStash {
+		t.Fatalf("unexpected stash refs: %+v", refs)
+	}
+
+	limited, err := Load(repo.dir, SortChronological, intPtr(2), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := len(limited.AllCommits()); got != 3 {
+		t.Fatalf("max_count must apply before stash merge, got %d commits", got)
+	}
+}
+
+func TestStashParentOnlyReachableThroughStash(t *testing.T) {
+	repo := newTestRepo(t)
+	repo.commit("001", "2024-01-01T01:02:03+00:00")
+	repo.checkoutB("10")
+	orphanParent := repo.commit("011", "2024-02-01T01:02:03+00:00")
+	stashHash := repo.stash("2024-02-02T01:02:03+00:00")
+	repo.checkout("master")
+	repo.git("branch", "-D", "10")
+
+	loaded, err := Load(repo.dir, SortChronological, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.Commit(NewCommitHash(orphanParent)) == nil {
+		t.Fatal("stash first parent was not enumerated")
+	}
+	if loaded.Commit(NewCommitHash(stashHash)) == nil {
+		t.Fatal("stash commit was not inserted")
+	}
+	if len(loaded.Refs(NewCommitHash(stashHash))) != 1 {
+		t.Fatal("orphan stash reference missing")
+	}
+}
+
+func TestRefKindsOrderAndAnnotatedTags(t *testing.T) {
+	repo := newTestRepo(t)
+	repo.commit("001", "2024-01-01T01:02:03+00:00")
+	hash := repo.revParse("HEAD")
+
+	repo.git("branch", "branch-a", hash)
+	repo.git("tag", "light", hash)
+	repo.gitWithDate("2024-01-02T01:02:03+00:00", "tag", "-a", "annotated", "-m", "annotation", hash)
+	repo.git("update-ref", "refs/remotes/origin/master", hash)
+	repo.stash("2024-01-03T01:02:03+00:00")
+
+	loaded, err := Load(repo.dir, SortChronological, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	refs := loaded.Refs(NewCommitHash(hash))
+	if len(refs) != 5 {
+		t.Fatalf("expected tag, branch, remote refs, got %+v", refs)
+	}
+	wantKinds := []RefKind{RefKindTag, RefKindTag, RefKindBranch, RefKindBranch, RefKindRemoteBranch}
+	for i, want := range wantKinds {
+		if refs[i].Kind != want {
+			t.Fatalf("ref %d kind mismatch: got %s want %s", i, refs[i].Kind, want)
+		}
+	}
+	if refs[0].Name != "annotated" || refs[1].Name != "light" {
+		t.Fatalf("unexpected tag order: %+v", refs)
+	}
+	if refs[0].Target.Full != hash {
+		t.Fatalf("annotated tag was not dereferenced: %+v", refs[0])
+	}
+}
+
+func TestRefsIndependentOfMaxCount(t *testing.T) {
+	repo := newTestRepo(t)
+	old := repo.commit("001", "2024-01-01T01:02:03+00:00")
+	repo.git("tag", "old-tag", old)
+	repo.commit("002", "2024-01-02T01:02:03+00:00")
+
+	loaded, err := Load(repo.dir, SortChronological, intPtr(1), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := len(loaded.AllCommits()); got != 1 {
+		t.Fatalf("expected one commit, got %d", got)
+	}
+	refs := loaded.Refs(NewCommitHash(old))
+	if len(refs) != 1 || refs[0].Name != "old-tag" {
+		t.Fatalf("max_count affected refs: %+v", refs)
+	}
+}
+
+func TestMailmap(t *testing.T) {
+	repo := newTestRepo(t)
+	repo.commit("001", "2024-01-01T01:02:03+00:00")
+	mailmap := "New Author <new-author@example.com> Author Name <author@example.com>\n" +
+		"New Committer <new-committer@example.com> Committer Name <committer@example.com>\n"
+	if err := os.WriteFile(filepath.Join(repo.dir, ".mailmap"), []byte(mailmap), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	enabled, err := Load(repo.dir, SortChronological, nil, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	commit := enabled.AllCommits()[0]
+	if commit.AuthorName != "New Author" || commit.AuthorEmail != "new-author@example.com" {
+		t.Fatalf("author mailmap not applied: %+v", commit)
+	}
+	if commit.CommitterName != "New Committer" || commit.CommitterEmail != "new-committer@example.com" {
+		t.Fatalf("committer mailmap not applied: %+v", commit)
+	}
+
+	disabled, err := Load(repo.dir, SortChronological, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	commit = disabled.AllCommits()[0]
+	if commit.AuthorName != testAuthorName || commit.AuthorEmail != testAuthorEmail {
+		t.Fatalf("raw author identity expected: %+v", commit)
+	}
+	if commit.CommitterName != testCommitterName || commit.CommitterEmail != testCommitterEmail {
+		t.Fatalf("raw committer identity expected: %+v", commit)
+	}
+}
+
+func TestAllRefsDeterminism(t *testing.T) {
+	repo := newTestRepo(t)
+	hash := repo.commit("001", "2024-01-01T01:02:03+00:00")
+	repo.git("tag", "z-tag", hash)
+	repo.git("branch", "b-branch", hash)
+	repo.git("update-ref", "refs/remotes/origin/master", hash)
+	repo.stash("2024-01-02T01:02:03+00:00")
+
+	loaded, err := Load(repo.dir, SortChronological, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := loaded.AllRefs()
+	for i := 0; i < 20; i++ {
+		if got := loaded.AllRefs(); !reflect.DeepEqual(got, first) {
+			t.Fatalf("all_refs order changed on iteration %d", i)
+		}
+	}
+	for i := 1; i < len(first); i++ {
+		if CompareRefs(first[i-1], first[i]) > 0 {
+			t.Fatalf("all_refs is not sorted: %+v", first)
+		}
+	}
+}
+
+func TestJSONFieldNames(t *testing.T) {
+	repo := newTestRepo(t)
+	hash := repo.commit("001", "2024-01-01T01:02:03+09:00")
+	loaded, err := Load(repo.dir, SortChronological, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := json.Marshal(loaded.AllCommits()[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	var object map[string]any
+	if err := json.Unmarshal(data, &object); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{
+		"commit_hash", "author_name", "author_email", "author_date",
+		"committer_name", "committer_email", "committer_date",
+		"subject", "body", "parent_commit_hashes",
+	} {
+		if _, ok := object[key]; !ok {
+			t.Fatalf("missing JSON field %q in %s", key, data)
+		}
+	}
+	if object["commit_hash"] != hash {
+		t.Fatalf("commit_hash should serialize as the full string: %v", object["commit_hash"])
+	}
+	if _, ok := object["author_date"].(string); !ok {
+		t.Fatalf("author_date should serialize as a string: %v", object["author_date"])
+	}
+
+	edgeData, err := json.Marshal(Edge{EdgeType: EdgeTypeVertical, PosX: 1, AssociatedLinePosX: 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	object = nil
+	if err := json.Unmarshal(edgeData, &object); err != nil {
+		t.Fatal(err)
+	}
+	if object["edge_type"] != "vertical" || object["pos_x"] != float64(1) || object["associated_line_pos_x"] != float64(2) {
+		t.Fatalf("unexpected edge JSON: %s", edgeData)
+	}
+}
+
+func intPtr(n int) *int { return &n }
diff --git a/core/serie.go b/core/serie.go
new file mode 100644
index 0000000..c1ddd24
--- /dev/null
+++ b/core/serie.go
@@ -0,0 +1,327 @@
+// Package core implements serie's non-UI Git repository and commit graph logic.
+//
+// The package deliberately shells out to Git for repository data and only uses
+// the Go standard library.
+package core
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// CommitHash is a Git commit hash. Full contains the complete hash and Short is
+// the first seven characters. In JSON a commit hash is represented by its full
+// hash string.
+type CommitHash struct {
+	Full  string `json:"full"`
+	Short string `json:"short"`
+}
+
+// NewCommitHash creates a CommitHash with the required seven-character short
+// form.
+func NewCommitHash(full string) CommitHash {
+	short := full
+	if len(short) > 7 {
+		short = short[:7]
+	}
+	return CommitHash{Full: full, Short: short}
+}
+
+// String returns the full hash.
+func (h CommitHash) String() string { return h.Full }
+
+// AsString returns the full hash.
+func (h CommitHash) AsString() string { return h.Full }
+
+// AsShortHash returns the seven-character short hash.
+func (h CommitHash) AsShortHash() string { return h.Short }
+
+// MarshalJSON encodes a commit hash as its full hash string.
+func (h CommitHash) MarshalJSON() ([]byte, error) { return json.Marshal(h.Full) }
+
+// UnmarshalJSON decodes a commit hash from a string.
+func (h *CommitHash) UnmarshalJSON(data []byte) error {
+	var full string
+	if err := json.Unmarshal(data, &full); err != nil {
+		return err
+	}
+	*h = NewCommitHash(full)
+	return nil
+}
+
+// MarshalText makes CommitHash usable as a JSON object key.
+func (h CommitHash) MarshalText() ([]byte, error) { return []byte(h.Full), nil }
+
+// UnmarshalText decodes a commit hash from text.
+func (h *CommitHash) UnmarshalText(data []byte) error {
+	*h = NewCommitHash(string(data))
+	return nil
+}
+
+// Commit is the public commit record. Dates retain the fixed offset reported by
+// Git and are serialized as RFC3339 timestamps.
+type Commit struct {
+	CommitHash         CommitHash   `json:"commit_hash"`
+	AuthorName         string       `json:"author_name"`
+	AuthorEmail        string       `json:"author_email"`
+	AuthorDate         time.Time    `json:"author_date"`
+	CommitterName      string       `json:"committer_name"`
+	CommitterEmail     string       `json:"committer_email"`
+	CommitterDate      time.Time    `json:"committer_date"`
+	Subject            string       `json:"subject"`
+	Body               string       `json:"body"`
+	ParentCommitHashes []CommitHash `json:"parent_commit_hashes"`
+}
+
+// RefKind distinguishes the supported reference kinds.
+type RefKind string
+
+const (
+	RefKindTag          RefKind = "tag"
+	RefKindBranch       RefKind = "branch"
+	RefKindRemoteBranch RefKind = "remote_branch"
+	RefKindStash        RefKind = "stash"
+
+	// Short aliases for callers that prefer Ref<Kind> names.
+	RefTag          = RefKindTag
+	RefBranch       = RefKindBranch
+	RefRemoteBranch = RefKindRemoteBranch
+	RefStash        = RefKindStash
+)
+
+func (k RefKind) order() int {
+	switch k {
+	case RefKindTag:
+		return 0
+	case RefKindBranch:
+		return 1
+	case RefKindRemoteBranch:
+		return 2
+	case RefKindStash:
+		return 3
+	default:
+		return 4
+	}
+}
+
+// Ref is a tag, local branch, remote branch, or stash reference. Message is set
+// for stashes.
+type Ref struct {
+	Kind    RefKind    `json:"kind"`
+	Name    string     `json:"name"`
+	Target  CommitHash `json:"target"`
+	Message string     `json:"message,omitempty"`
+}
+
+// RefName returns the reference name.
+func (r Ref) RefName() string { return r.Name }
+
+// RefTarget returns the commit targeted by the reference.
+func (r Ref) RefTarget() CommitHash { return r.Target }
+
+// HeadKind distinguishes the HEAD states.
+type HeadKind string
+
+const (
+	HeadKindBranch   HeadKind = "branch"
+	HeadKindDetached HeadKind = "detached"
+	HeadKindNone     HeadKind = "none"
+
+	// Short aliases for callers that prefer Head<State> names.
+	HeadBranch   = HeadKindBranch
+	HeadDetached = HeadKindDetached
+	HeadNone     = HeadKindNone
+)
+
+// Head describes the current HEAD.
+type Head struct {
+	Kind   HeadKind   `json:"kind"`
+	Name   string     `json:"name,omitempty"`
+	Target CommitHash `json:"target,omitempty"`
+}
+
+// IsNone reports whether the repository has no HEAD.
+func (h Head) IsNone() bool { return h.Kind == HeadKindNone }
+
+// MarshalJSON emits only the fields meaningful for the current HEAD state.
+func (h Head) MarshalJSON() ([]byte, error) {
+	switch h.Kind {
+	case HeadKindBranch:
+		return json.Marshal(struct {
+			Kind HeadKind `json:"kind"`
+			Name string   `json:"name"`
+		}{Kind: h.Kind, Name: h.Name})
+	case HeadKindDetached:
+		return json.Marshal(struct {
+			Kind   HeadKind   `json:"kind"`
+			Target CommitHash `json:"target"`
+		}{Kind: h.Kind, Target: h.Target})
+	default:
+		return json.Marshal(struct {
+			Kind HeadKind `json:"kind"`
+		}{Kind: h.Kind})
+	}
+}
+
+// SortCommit selects the commit ordering passed to git log.
+type SortCommit int
+
+const (
+	// SortChronological corresponds to git log --date-order.
+	SortChronological SortCommit = iota
+	// SortTopological corresponds to git log --topo-order.
+	SortTopological
+
+	// Short aliases.
+	Chronological = SortChronological
+	Topological   = SortTopological
+)
+
+func (s SortCommit) gitOrder() string {
+	if s == SortTopological {
+		return "--topo-order"
+	}
+	return "--date-order"
+}
+
+// FileChangeKind distinguishes commit-detail file changes.
+type FileChangeKind string
+
+const (
+	FileChangeAdd    FileChangeKind = "add"
+	FileChangeModify FileChangeKind = "modify"
+	FileChangeDelete FileChangeKind = "delete"
+	FileChangeRename FileChangeKind = "rename"
+
+	// FileChangeMove is an alias for FileChangeRename.
+	FileChangeMove = FileChangeRename
+)
+
+// FileChange is a file change in a commit. Rename changes use From and To;
+// other changes use Path.
+type FileChange struct {
+	Kind FileChangeKind `json:"kind"`
+	Path string         `json:"path,omitempty"`
+	From string         `json:"from,omitempty"`
+	To   string         `json:"to,omitempty"`
+}
+
+// EdgeType is the visual type of a graph edge.
+type EdgeType int
+
+const (
+	EdgeTypeVertical EdgeType = iota
+	EdgeTypeHorizontal
+	EdgeTypeUp
+	EdgeTypeDown
+	EdgeTypeLeft
+	EdgeTypeRight
+	EdgeTypeRightTop
+	EdgeTypeRightBottom
+	EdgeTypeLeftTop
+	EdgeTypeLeftBottom
+)
+
+var edgeTypeNames = [...]string{
+	"vertical",
+	"horizontal",
+	"up",
+	"down",
+	"left",
+	"right",
+	"right_top",
+	"right_bottom",
+	"left_top",
+	"left_bottom",
+}
+
+// String returns the stable wire name of an edge type.
+func (t EdgeType) String() string {
+	if int(t) >= 0 && int(t) < len(edgeTypeNames) {
+		return edgeTypeNames[t]
+	}
+	return fmt.Sprintf("edge_type_%d", int(t))
+}
+
+// MarshalJSON encodes an edge type with its stable name.
+func (t EdgeType) MarshalJSON() ([]byte, error) { return json.Marshal(t.String()) }
+
+// UnmarshalJSON decodes an edge type from its stable name or numeric value.
+func (t *EdgeType) UnmarshalJSON(data []byte) error {
+	var name string
+	if err := json.Unmarshal(data, &name); err == nil {
+		for i, n := range edgeTypeNames {
+			if n == name {
+				*t = EdgeType(i)
+				return nil
+			}
+		}
+		return fmt.Errorf("unknown edge type %q", name)
+	}
+	var value int
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	*t = EdgeType(value)
+	return nil
+}
+
+// Edge is one graph drawing operation.
+type Edge struct {
+	EdgeType           EdgeType `json:"edge_type"`
+	PosX               int      `json:"pos_x"`
+	AssociatedLinePosX int      `json:"associated_line_pos_x"`
+}
+
+// Position is a commit's zero-based graph position.
+type Position struct {
+	PosX int `json:"pos_x"`
+	PosY int `json:"pos_y"`
+}
+
+// Graph is the result of calculating commit lanes and edges.
+type Graph struct {
+	Commits      []*Commit               `json:"commits"`
+	CommitPosMap map[CommitHash]Position `json:"commit_pos_map"`
+	Edges        [][]Edge                `json:"edges"`
+	MaxPosX      int                     `json:"max_pos_x"`
+}
+
+// CommitAt returns the commit at a row.
+func (g *Graph) CommitAt(posY int) *Commit {
+	if posY < 0 || posY >= len(g.Commits) {
+		return nil
+	}
+	return g.Commits[posY]
+}
+
+// Position returns a commit's graph position, normalizing a hash that was
+// constructed with only its Full field set.
+func (g *Graph) Position(commitHash CommitHash) (Position, bool) {
+	position, ok := g.CommitPosMap[normalizeHash(commitHash)]
+	return position, ok
+}
+
+// EdgeKey is used internally for deterministic sorting/deduplication.
+func (e Edge) EdgeKey() string {
+	return fmt.Sprintf("%d/%d/%d", e.AssociatedLinePosX, e.PosX, e.EdgeType)
+}
+
+// CompareRefs compares references by kind then name, target, and stash message.
+func CompareRefs(a, b Ref) int {
+	if ka, kb := a.Kind.order(), b.Kind.order(); ka != kb {
+		if ka < kb {
+			return -1
+		}
+		return 1
+	}
+	if a.Name != b.Name {
+		return strings.Compare(a.Name, b.Name)
+	}
+	if a.Target.Full != b.Target.Full {
+		return strings.Compare(a.Target.Full, b.Target.Full)
+	}
+	return strings.Compare(a.Message, b.Message)
+}
diff --git a/core/test_helpers_test.go b/core/test_helpers_test.go
new file mode 100644
index 0000000..3f93775
--- /dev/null
+++ b/core/test_helpers_test.go
@@ -0,0 +1,125 @@
+package core
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const (
+	testAuthorName     = "Author Name"
+	testAuthorEmail    = "author@example.com"
+	testCommitterName  = "Committer Name"
+	testCommitterEmail = "committer@example.com"
+	testDefaultDate    = "2024-01-01T01:02:03+00:00"
+)
+
+type testRepo struct {
+	t            *testing.T
+	dir          string
+	stashCounter int
+}
+
+func newTestRepo(t *testing.T) *testRepo {
+	t.Helper()
+	r := &testRepo{t: t, dir: t.TempDir()}
+	r.git("init", "-b", "master")
+	return r
+}
+
+func (r *testRepo) git(args ...string) string {
+	r.t.Helper()
+	return r.gitWithDate(testDefaultDate, args...)
+}
+
+func (r *testRepo) gitWithDate(date string, args ...string) string {
+	r.t.Helper()
+	cmd := exec.Command("git", args...)
+	cmd.Dir = r.dir
+	cmd.Env = append(os.Environ(),
+		"GIT_AUTHOR_NAME="+testAuthorName,
+		"GIT_AUTHOR_EMAIL="+testAuthorEmail,
+		"GIT_COMMITTER_NAME="+testCommitterName,
+		"GIT_COMMITTER_EMAIL="+testCommitterEmail,
+		"GIT_AUTHOR_DATE="+date,
+		"GIT_COMMITTER_DATE="+date,
+		"GIT_CONFIG_NOSYSTEM=true",
+		"GIT_MERGE_AUTOEDIT=no",
+		"HOME="+r.dir,
+	)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		r.t.Fatalf("git %s failed: %v\n%s", strings.Join(args, " "), err, out)
+	}
+	return strings.TrimSpace(string(out))
+}
+
+func (r *testRepo) commit(message, date string) string {
+	r.t.Helper()
+	r.gitWithDate(date, "commit", "--allow-empty", "-m", message)
+	return r.revParse("HEAD")
+}
+
+func (r *testRepo) commitFile(message, date, path, content string) string {
+	r.t.Helper()
+	full := filepath.Join(r.dir, path)
+	if err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {
+		r.t.Fatal(err)
+	}
+	if err := os.WriteFile(full, []byte(content), 0o644); err != nil {
+		r.t.Fatal(err)
+	}
+	r.git("add", "-A")
+	r.gitWithDate(date, "commit", "-m", message)
+	return r.revParse("HEAD")
+}
+
+func (r *testRepo) checkout(name string) {
+	r.t.Helper()
+	r.git("checkout", name)
+}
+
+func (r *testRepo) checkoutB(name string) {
+	r.t.Helper()
+	r.git("checkout", "-b", name)
+}
+
+func (r *testRepo) checkoutOrphan(name string) {
+	r.t.Helper()
+	r.git("checkout", "--orphan", name)
+}
+
+func (r *testRepo) merge(date string, branches ...string) {
+	r.t.Helper()
+	args := []string{"merge", "--no-ff", "--no-log", "-m", "merge", "--no-edit"}
+	args = append(args, branches...)
+	r.gitWithDate(date, args...)
+}
+
+func (r *testRepo) stash(date string) string {
+	r.t.Helper()
+	r.stashCounter++
+	name := filepath.Join(r.dir, "stash-"+string(rune('a'+r.stashCounter))+".txt")
+	if err := os.WriteFile(name, []byte(date), 0o644); err != nil {
+		r.t.Fatal(err)
+	}
+	r.gitWithDate(date, "stash", "push", "--include-untracked", "-m", "stash "+date)
+	out := r.git("rev-parse", "refs/stash")
+	return strings.TrimSpace(out)
+}
+
+func (r *testRepo) revParse(ref string) string {
+	r.t.Helper()
+	return strings.TrimSpace(r.git("rev-parse", ref))
+}
+
+func cloneBare(t *testing.T, source, dest string) {
+	t.Helper()
+	cmd := exec.Command("git", "clone", "--bare", source, dest)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("git clone --bare failed: %v\n%s", err, out)
+	}
+}
