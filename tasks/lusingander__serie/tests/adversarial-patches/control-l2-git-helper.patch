diff --git a/core/gitcmd.go b/core/gitcmd.go
new file mode 100644
index 0000000..a9ddc0e
--- /dev/null
+++ b/core/gitcmd.go
@@ -0,0 +1,338 @@
+package core
+
+import (
+	"bytes"
+	"fmt"
+	"os/exec"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// runGit executes Git in dir and returns stdout. A non-zero exit status is
+// returned as an error that includes stderr.
+func runGit(dir string, args ...string) ([]byte, error) {
+	cmd := exec.Command("git", args...)
+	cmd.Dir = dir
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		msg := strings.TrimSpace(stderr.String())
+		if msg == "" {
+			return stdout.Bytes(), fmt.Errorf("git %s: %w", strings.Join(args, " "), err)
+		}
+		return stdout.Bytes(), fmt.Errorf("git %s: %w: %s", strings.Join(args, " "), err, msg)
+	}
+	return stdout.Bytes(), nil
+}
+
+func checkGitRepository(path string) error {
+	if !isInsideWorkTree(path) && !isBareRepository(path) {
+		return fmt.Errorf("not a git repository (or any of the parent directories)")
+	}
+	return nil
+}
+
+func isInsideWorkTree(path string) bool {
+	out, err := runGit(path, "rev-parse", "--is-inside-work-tree")
+	return err == nil && strings.TrimSpace(string(out)) == "true"
+}
+
+func isBareRepository(path string) bool {
+	out, err := runGit(path, "rev-parse", "--is-bare-repository")
+	return err == nil && strings.TrimSpace(string(out)) == "true"
+}
+
+func currentBranch(path string) string {
+	out, err := runGit(path, "branch", "--show-current")
+	if err != nil {
+		return ""
+	}
+	return strings.TrimRight(strings.TrimSuffix(string(out), "\n"), "\r")
+}
+
+func loadCommitsFormat(mailmap bool) string {
+	fields := []string{"%H", "%an", "%ae", "%ad", "%cn", "%ce", "%cd", "%s", "%b", "%P"}
+	if mailmap {
+		fields = []string{"%H", "%aN", "%aE", "%ad", "%cN", "%cE", "%cd", "%s", "%b", "%P"}
+	}
+	return strings.Join(fields, "%x1f")
+}
+
+func parseISOdate(s string) (time.Time, error) {
+	return time.Parse(time.RFC3339, s)
+}
+
+func parseParentCommitHashes(s string) []CommitHash {
+	if s == "" {
+		return nil
+	}
+	parts := strings.Split(s, " ")
+	hashes := make([]CommitHash, 0, len(parts))
+	for _, p := range parts {
+		hashes = append(hashes, NewCommitHash(p))
+	}
+	return hashes
+}
+
+func parseCommitRecord(record string) (Commit, error) {
+	parts := strings.Split(record, "\x1f")
+	if len(parts) != 10 {
+		return Commit{}, fmt.Errorf("unexpected number of parts: %d [%s]", len(parts), record)
+	}
+	authorDate, err := parseISOdate(parts[3])
+	if err != nil {
+		return Commit{}, err
+	}
+	committerDate, err := parseISOdate(parts[6])
+	if err != nil {
+		return Commit{}, err
+	}
+	return Commit{
+		CommitHash:         NewCommitHash(parts[0]),
+		AuthorName:         parts[1],
+		AuthorEmail:        parts[2],
+		AuthorDate:         authorDate,
+		CommitterName:      parts[4],
+		CommitterEmail:     parts[5],
+		CommitterDate:      committerDate,
+		Subject:            parts[7],
+		Body:               parts[8],
+		ParentCommitHashes: parseParentCommitHashes(parts[9]),
+	}, nil
+}
+
+func parseCommitRecords(out []byte) ([]Commit, error) {
+	records := bytes.Split(out, []byte{0})
+	commits := make([]Commit, 0, len(records))
+	for _, record := range records {
+		if len(record) == 0 {
+			continue
+		}
+		commit, err := parseCommitRecord(string(record))
+		if err != nil {
+			return nil, err
+		}
+		commits = append(commits, commit)
+	}
+	return commits, nil
+}
+
+func loadAllCommits(path string, sort SortCommit, head Head, stashes []Commit, maxCount *int, mailmap bool) ([]Commit, error) {
+	args := []string{
+		"log",
+		sort.gitOrder(),
+		fmt.Sprintf("--pretty=%s", loadCommitsFormat(mailmap)),
+		"--date=iso-strict",
+		"-z",
+		"--branches",
+		"--remotes",
+		"--tags",
+	}
+	for _, stash := range stashes {
+		if len(stash.ParentCommitHashes) > 0 {
+			args = append(args, stash.ParentCommitHashes[0].Full)
+		}
+	}
+	if head.Kind != HeadKindNone {
+		args = append(args, "HEAD")
+	}
+	if maxCount != nil {
+		args = append(args, "--max-count", strconv.Itoa(*maxCount))
+	}
+	out, err := runGit(path, args...)
+	if err != nil && len(out) == 0 {
+		// An empty repository makes git log fail. Repository.load turns the
+		// resulting empty commit list into the required no-commits error.
+		return nil, nil
+	}
+	commits, parseErr := parseCommitRecords(out)
+	if parseErr != nil {
+		return nil, parseErr
+	}
+	return commits, nil
+}
+
+func loadAllStashes(path string, mailmap bool) ([]Commit, error) {
+	args := []string{
+		"stash", "list",
+		fmt.Sprintf("--pretty=%s", loadCommitsFormat(mailmap)),
+		"--date=iso-strict",
+		"-z",
+	}
+	out, err := runGit(path, args...)
+	if err != nil && len(out) == 0 {
+		return nil, nil
+	}
+	commits, parseErr := parseCommitRecords(out)
+	if parseErr != nil {
+		return nil, parseErr
+	}
+	return commits, nil
+}
+
+func loadRefs(path string) (map[CommitHash][]Ref, Head, error) {
+	out, err := runGit(path, "show-ref", "--head", "--dereference")
+	if err != nil && len(out) == 0 {
+		return map[CommitHash][]Ref{}, Head{Kind: HeadKindNone}, nil
+	}
+
+	refMap := make(map[CommitHash][]Ref)
+	tagMap := make(map[string]Ref)
+	head := Head{Kind: HeadKindNone}
+
+	lines := strings.Split(strings.ReplaceAll(string(out), "\r\n", "\n"), "\n")
+	for _, line := range lines {
+		if line == "" {
+			continue
+		}
+		parts := strings.Split(line, " ")
+		if len(parts) != 2 {
+			return nil, Head{}, fmt.Errorf("unexpected number of parts: %d [%s]", len(parts), line)
+		}
+		hash := parts[0]
+		refs := parts[1]
+
+		if refs == "HEAD" {
+			if branch := currentBranch(path); branch != "" {
+				head = Head{Kind: HeadKindBranch, Name: branch}
+			} else {
+				head = Head{Kind: HeadKindDetached, Target: NewCommitHash(hash)}
+			}
+			continue
+		}
+		if r, ok := parseBranchRefs(hash, refs); ok {
+			refMap[r.Target] = append(refMap[r.Target], r)
+			continue
+		}
+		if r, ok := parseTagRefs(hash, refs); ok {
+			// The dereferenced (^{}) line for an annotated tag follows the tag
+			// object line, so it overwrites the tag target.
+			tagMap[r.Name] = r
+		}
+	}
+
+	for _, tag := range tagMap {
+		refMap[tag.Target] = append(refMap[tag.Target], tag)
+	}
+	for hash, refs := range refMap {
+		sortRefs(refs)
+		refMap[hash] = refs
+	}
+	return refMap, head, nil
+}
+
+func loadStashesAsRefs(path string) (map[CommitHash][]Ref, error) {
+	format := []string{"%gd", "%H", "%s"}
+	out, err := runGit(path, "stash", "list", "--format="+strings.Join(format, "%x1f"))
+	if err != nil && len(out) == 0 {
+		return map[CommitHash][]Ref{}, nil
+	}
+
+	refMap := make(map[CommitHash][]Ref)
+	lines := strings.Split(strings.ReplaceAll(string(out), "\r\n", "\n"), "\n")
+	for _, line := range lines {
+		if line == "" {
+			continue
+		}
+		parts := strings.Split(line, "\x1f")
+		if len(parts) != 3 {
+			return nil, fmt.Errorf("unexpected number of parts: %d [%s]", len(parts), line)
+		}
+		hash := NewCommitHash(parts[1])
+		refMap[hash] = append(refMap[hash], Ref{
+			Kind:    RefKindStash,
+			Name:    parts[0],
+			Message: parts[2],
+			Target:  hash,
+		})
+	}
+	return refMap, nil
+}
+
+func mergeRefMaps(dst, src map[CommitHash][]Ref) {
+	for hash, refs := range src {
+		dst[hash] = append(dst[hash], refs...)
+	}
+}
+
+func parseBranchRefs(hash, refs string) (Ref, bool) {
+	if strings.HasPrefix(refs, "refs/heads/") {
+		return Ref{
+			Kind:   RefKindBranch,
+			Name:   strings.TrimPrefix(refs, "refs/heads/"),
+			Target: NewCommitHash(hash),
+		}, true
+	}
+	if strings.HasPrefix(refs, "refs/remotes/") {
+		return Ref{
+			Kind:   RefKindRemoteBranch,
+			Name:   strings.TrimPrefix(refs, "refs/remotes/"),
+			Target: NewCommitHash(hash),
+		}, true
+	}
+	return Ref{}, false
+}
+
+func parseTagRefs(hash, refs string) (Ref, bool) {
+	if !strings.HasPrefix(refs, "refs/tags/") {
+		return Ref{}, false
+	}
+	name := strings.TrimPrefix(refs, "refs/tags/")
+	name = strings.TrimSuffix(name, "^{}")
+	return Ref{Kind: RefKindTag, Name: name, Target: NewCommitHash(hash)}, true
+}
+
+func loadDiffSummary(path string, commitHash CommitHash) ([]FileChange, error) {
+	out, err := runGit(path, "diff", "--name-status", commitHash.Full+"^", commitHash.Full)
+	if err != nil && len(out) == 0 {
+		return nil, nil
+	}
+	changes := make([]FileChange, 0)
+	lines := strings.Split(strings.ReplaceAll(string(out), "\r\n", "\n"), "\n")
+	for _, line := range lines {
+		if line == "" {
+			continue
+		}
+		parts := strings.Split(line, "\t")
+		if len(parts) == 0 || parts[0] == "" {
+			continue
+		}
+		switch parts[0][0] {
+		case 'A':
+			if len(parts) > 1 {
+				changes = append(changes, FileChange{Kind: FileChangeAdd, Path: parts[1]})
+			}
+		case 'M':
+			if len(parts) > 1 {
+				changes = append(changes, FileChange{Kind: FileChangeModify, Path: parts[1]})
+			}
+		case 'D':
+			if len(parts) > 1 {
+				changes = append(changes, FileChange{Kind: FileChangeDelete, Path: parts[1]})
+			}
+		case 'R':
+			if len(parts) > 2 {
+				changes = append(changes, FileChange{Kind: FileChangeRename, From: parts[1], To: parts[2]})
+			}
+		}
+	}
+	return changes, nil
+}
+
+func loadInitialCommitAdditions(path string, commitHash CommitHash) ([]FileChange, error) {
+	out, err := runGit(path, "ls-tree", "--name-status", "-r", commitHash.Full)
+	if err != nil && len(out) == 0 {
+		return nil, nil
+	}
+	changes := make([]FileChange, 0)
+	lines := strings.Split(strings.ReplaceAll(string(out), "\r\n", "\n"), "\n")
+	for _, line := range lines {
+		if line == "" {
+			continue
+		}
+		changes = append(changes, FileChange{Kind: FileChangeAdd, Path: line})
+	}
+	return changes, nil
+}
diff --git a/core/graph.go b/core/graph.go
new file mode 100644
index 0000000..2651203
--- /dev/null
+++ b/core/graph.go
@@ -0,0 +1,325 @@
+package core
+
+import "sort"
+
+type wrappedEdge struct {
+	edge           Edge
+	edgeParentHash CommitHash
+}
+
+func newWrappedEdge(edgeType EdgeType, posX, linePosX int, parent CommitHash) wrappedEdge {
+	return wrappedEdge{
+		edge: Edge{
+			EdgeType:           edgeType,
+			PosX:               posX,
+			AssociatedLinePosX: linePosX,
+		},
+		edgeParentHash: parent,
+	}
+}
+
+// CalcGraph calculates commit lanes and edges for a repository.
+func CalcGraph(repository *Repository) *Graph {
+	commits := repository.AllCommits()
+	commitPosMap := calcCommitPositions(commits, repository)
+	graphEdges, maxPosX := calcEdges(commitPosMap, commits, repository)
+
+	return &Graph{
+		Commits:      commits,
+		CommitPosMap: commitPosMap,
+		Edges:        graphEdges,
+		MaxPosX:      maxPosX,
+	}
+}
+
+func calcCommitPositions(commits []*Commit, repository *Repository) map[CommitHash]Position {
+	commitPosMap := make(map[CommitHash]Position)
+	commitLineState := make([]CommitHash, 0)
+
+	for posY, commit := range commits {
+		filtered := filteredChildren(commit, repository)
+		if len(filtered) == 0 {
+			posX := getFirstVacantLine(commitLineState)
+			addCommitLine(commit, &commitLineState, posX)
+			commitPosMap[commit.CommitHash] = Position{PosX: posX, PosY: posY}
+		} else {
+			posX := updateCommitLine(commit, commitLineState, filtered)
+			commitPosMap[commit.CommitHash] = Position{PosX: posX, PosY: posY}
+		}
+	}
+	return commitPosMap
+}
+
+func filteredChildren(commit *Commit, repository *Repository) []CommitHash {
+	children := repository.ChildrenHash(commit.CommitHash)
+	filtered := make([]CommitHash, 0, len(children))
+	for _, childHash := range children {
+		childParents := repository.ParentsHash(childHash)
+		if len(childParents) > 0 && childParents[0] == commit.CommitHash {
+			filtered = append(filtered, childHash)
+		}
+	}
+	return filtered
+}
+
+func getFirstVacantLine(commitLineState []CommitHash) int {
+	for posX, hash := range commitLineState {
+		if hash.Full == "" {
+			return posX
+		}
+	}
+	return len(commitLineState)
+}
+
+func addCommitLine(commit *Commit, commitLineState *[]CommitHash, posX int) {
+	if len(*commitLineState) <= posX {
+		*commitLineState = append(*commitLineState, commit.CommitHash)
+	} else {
+		(*commitLineState)[posX] = commit.CommitHash
+	}
+}
+
+func updateCommitLine(commit *Commit, commitLineState []CommitHash, targetCommitHashes []CommitHash) int {
+	if len(commitLineState) == 0 {
+		return 0
+	}
+	minPosX := len(commitLineState) - 1
+	for _, targetHash := range targetCommitHashes {
+		for posX, commitHash := range commitLineState {
+			if commitHash.Full != "" && commitHash == targetHash {
+				commitLineState[posX] = CommitHash{}
+				if minPosX > posX {
+					minPosX = posX
+				}
+				break
+			}
+		}
+	}
+	commitLineState[minPosX] = commit.CommitHash
+	return minPosX
+}
+
+func calcEdges(commitPosMap map[CommitHash]Position, commits []*Commit, repository *Repository) ([][]Edge, int) {
+	maxPosX := 0
+	edges := make([][]wrappedEdge, len(commits))
+
+	for _, commit := range commits {
+		pos := commitPosMap[commit.CommitHash]
+		hash := commit.CommitHash
+
+		for _, childHash := range repository.ChildrenHash(hash) {
+			childPos := commitPosMap[childHash]
+
+			if pos.PosX == childPos.PosX {
+				// commit
+				edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeUp, pos.PosX, pos.PosX, hash))
+				for y := childPos.PosY + 1; y < pos.PosY; y++ {
+					edges[y] = append(edges[y], newWrappedEdge(EdgeTypeVertical, pos.PosX, pos.PosX, hash))
+				}
+				edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeDown, pos.PosX, pos.PosX, hash))
+			} else {
+				child := repository.Commit(childHash)
+				if child == nil || len(child.ParentCommitHashes) == 0 {
+					continue
+				}
+				childFirstParentHash := child.ParentCommitHashes[0]
+				if childFirstParentHash == hash {
+					// branch
+					if pos.PosX < childPos.PosX {
+						edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeRight, pos.PosX, childPos.PosX, hash))
+						for x := pos.PosX + 1; x < childPos.PosX; x++ {
+							edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeHorizontal, x, childPos.PosX, hash))
+						}
+						edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeRightBottom, childPos.PosX, childPos.PosX, hash))
+					} else {
+						edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeLeft, pos.PosX, childPos.PosX, hash))
+						for x := childPos.PosX + 1; x < pos.PosX; x++ {
+							edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeHorizontal, x, childPos.PosX, hash))
+						}
+						edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeLeftBottom, childPos.PosX, childPos.PosX, hash))
+					}
+					for y := childPos.PosY + 1; y < pos.PosY; y++ {
+						edges[y] = append(edges[y], newWrappedEdge(EdgeTypeVertical, childPos.PosX, childPos.PosX, hash))
+					}
+					edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeDown, childPos.PosX, childPos.PosX, hash))
+				}
+				// merge edges are handled in the second pass
+			}
+		}
+
+		if maxPosX < pos.PosX {
+			maxPosX = pos.PosX
+		}
+
+		// Draw a continuation if max_count removed the first parent.
+		if len(commit.ParentCommitHashes) > 0 && !repository.HasCommit(commit.ParentCommitHashes[0]) {
+			edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeDown, pos.PosX, pos.PosX, hash))
+			for y := pos.PosY + 1; y < len(commits); y++ {
+				edges[y] = append(edges[y], newWrappedEdge(EdgeTypeVertical, pos.PosX, pos.PosX, hash))
+			}
+		}
+	}
+
+	for _, commit := range commits {
+		pos := commitPosMap[commit.CommitHash]
+		hash := commit.CommitHash
+
+		for _, childHash := range repository.ChildrenHash(hash) {
+			childPos := commitPosMap[childHash]
+
+			if pos.PosX == childPos.PosX {
+				continue
+			}
+			child := repository.Commit(childHash)
+			if child == nil || len(child.ParentCommitHashes) == 0 {
+				continue
+			}
+			if child.ParentCommitHashes[0] == hash {
+				continue
+			}
+
+			// merge
+			overlap := false
+			newPosX := pos.PosX
+
+			skipJudgeOverlap := true
+			for y := childPos.PosY + 1; y < pos.PosY; y++ {
+				processingCommitPosX := commitPosMap[commits[y].CommitHash].PosX
+				if processingCommitPosX == newPosX {
+					skipJudgeOverlap = false
+					break
+				}
+				for _, edge := range edges[y] {
+					if edge.edge.PosX == pos.PosX &&
+						edge.edge.EdgeType == EdgeTypeVertical &&
+						edge.edgeParentHash != hash {
+						skipJudgeOverlap = false
+						break
+					}
+				}
+				if !skipJudgeOverlap {
+					break
+				}
+			}
+
+			if !skipJudgeOverlap {
+				for y := childPos.PosY + 1; y < pos.PosY; y++ {
+					processingCommitPosX := commitPosMap[commits[y].CommitHash].PosX
+					if processingCommitPosX == newPosX {
+						overlap = true
+						if newPosX < processingCommitPosX+1 {
+							newPosX = processingCommitPosX + 1
+						}
+					}
+					for _, edge := range edges[y] {
+						if edge.edge.PosX >= newPosX &&
+							edge.edgeParentHash != hash &&
+							edge.edge.EdgeType == EdgeTypeVertical {
+							overlap = true
+							if newPosX < edge.edge.PosX+1 {
+								newPosX = edge.edge.PosX + 1
+							}
+						}
+					}
+				}
+			}
+
+			if overlap {
+				// detour
+				edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeRight, pos.PosX, pos.PosX, hash))
+				for x := pos.PosX + 1; x < newPosX; x++ {
+					edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeHorizontal, x, pos.PosX, hash))
+				}
+				edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeRightBottom, newPosX, pos.PosX, hash))
+				for y := childPos.PosY + 1; y < pos.PosY; y++ {
+					edges[y] = append(edges[y], newWrappedEdge(EdgeTypeVertical, newPosX, pos.PosX, hash))
+				}
+				edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeRightTop, newPosX, pos.PosX, hash))
+				for x := childPos.PosX + 1; x < newPosX; x++ {
+					edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeHorizontal, x, pos.PosX, hash))
+				}
+				edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeRight, childPos.PosX, pos.PosX, hash))
+
+				if maxPosX < newPosX {
+					maxPosX = newPosX
+				}
+			} else {
+				edges[pos.PosY] = append(edges[pos.PosY], newWrappedEdge(EdgeTypeUp, pos.PosX, pos.PosX, hash))
+				for y := childPos.PosY + 1; y < pos.PosY; y++ {
+					edges[y] = append(edges[y], newWrappedEdge(EdgeTypeVertical, pos.PosX, pos.PosX, hash))
+				}
+				if pos.PosX < childPos.PosX {
+					edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeLeftTop, pos.PosX, pos.PosX, hash))
+					for x := pos.PosX + 1; x < childPos.PosX; x++ {
+						edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeHorizontal, x, pos.PosX, hash))
+					}
+					edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeLeft, childPos.PosX, pos.PosX, hash))
+				} else {
+					edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeRightTop, pos.PosX, pos.PosX, hash))
+					for x := childPos.PosX + 1; x < pos.PosX; x++ {
+						edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeHorizontal, x, pos.PosX, hash))
+					}
+					edges[childPos.PosY] = append(edges[childPos.PosY], newWrappedEdge(EdgeTypeRight, childPos.PosX, pos.PosX, hash))
+				}
+			}
+		}
+
+		if maxPosX < pos.PosX {
+			maxPosX = pos.PosX
+		}
+	}
+
+	graphEdges := make([][]Edge, len(edges))
+	for i, es := range edges {
+		row := make([]Edge, len(es))
+		for j := range es {
+			row[j] = es[j].edge
+		}
+		sort.SliceStable(row, func(a, b int) bool {
+			if row[a].AssociatedLinePosX != row[b].AssociatedLinePosX {
+				return row[a].AssociatedLinePosX < row[b].AssociatedLinePosX
+			}
+			if row[a].PosX != row[b].PosX {
+				return row[a].PosX < row[b].PosX
+			}
+			return row[a].EdgeType < row[b].EdgeType
+		})
+		if len(row) > 0 {
+			deduped := row[:1]
+			for _, edge := range row[1:] {
+				if edge != deduped[len(deduped)-1] {
+					deduped = append(deduped, edge)
+				}
+			}
+			row = deduped
+		}
+		graphEdges[i] = row
+	}
+
+	return graphEdges, maxPosX
+}
+
+// SortAndDedupEdges sorts one row by (associated_line_pos_x, pos_x,
+// edge_type) and removes exact duplicates.
+func SortAndDedupEdges(edges []Edge) []Edge {
+	row := append([]Edge(nil), edges...)
+	sort.SliceStable(row, func(a, b int) bool {
+		if row[a].AssociatedLinePosX != row[b].AssociatedLinePosX {
+			return row[a].AssociatedLinePosX < row[b].AssociatedLinePosX
+		}
+		if row[a].PosX != row[b].PosX {
+			return row[a].PosX < row[b].PosX
+		}
+		return row[a].EdgeType < row[b].EdgeType
+	})
+	if len(row) == 0 {
+		return row
+	}
+	deduped := row[:1]
+	for _, edge := range row[1:] {
+		if edge != deduped[len(deduped)-1] {
+			deduped = append(deduped, edge)
+		}
+	}
+	return deduped
+}
diff --git a/core/graph_test.go b/core/graph_test.go
