            "-b",
            "master"
          ]
        },
        {
          "op": "commit",
          "message": "one",
          "date": "2024-01-01T01:00:00+00:00"
        },
        {
          "op": "commit",
          "message": "two",
          "date": "2024-01-02T01:00:00+00:00"
        }
      ],
      "load": {
        "order": "chronological",
        "max_count": null,
        "mailmap": false
      },
      "assertions": [
        "each query returns the source-corpus value after normalization"
      ],
      "source_expectation": "PASS",
      "target_expectation": "PASS",
      "probe": "TestDiffB0001CommitRecordAndHash"
    },
    {
      "id": "DIFF-CASE-LOADER-PARAMS",
      "observations": [
        "DIFF-006",
        "DIFF-023"
      ],
      "kind": "load",
      "description": "Loader accepts path, chronological/topological order, optional max-count, and mailmap; repeated results are deterministic.",
      "setup": [
        {
          "op": "git",
          "args": [
            "init",
            "-b",
            "master"
          ]
        },
        {
          "op": "commit",
          "message": "c1",
          "date": "2024-01-01T01:00:00+00:00"
        },
        {
          "op": "git",
          "args": [
            "checkout",
            "-b",
            "side"
          ]
        },
        {
          "op": "commit",
          "message": "c2",
          "date": "2024-01-02T01:00:00+00:00"
        },
        {
          "op": "git",
          "args": [
            "checkout",
            "master"
          ]
        },
        {
          "op": "commit",
          "message": "c3",
          "date": "2024-01-03T01:00:00+00:00"
        },
        {
          "op": "merge",
          "branches": [
            "side"
          ],
          "date": "2024-01-04T01:00:00+00:00"
        }
      ],
      "load_matrix": [
        {
          "order": "chronological",
          "max_count": null,
          "mailmap": false
        },
        {
          "order": "topological",
          "max_count": null,
          "mailmap": false
        },
        {
          "order": "chronological",
          "max_count": 2,
          "mailmap": false
        },
        {
          "order": "chronological",
          "max_count": null,
          "mailmap": true
        }
      ],
      "assertions": [
        "chronological commits equal git log --date-order",
        "topological commits equal git log --topo-order",
        "max_count truncates the loaded commit set",
        "twenty repeated loads and graph calculations are identical"
      ],
      "source_expectation": "PASS",
      "target_expectation": "PASS",
      "probe": "TestDiffB0001LoaderOrderMailmapDeterminism"
    },
    {
      "id": "DIFF-CASE-COMMIT-DETAIL",
      "observations": [
        "DIFF-007"
      ],
      "kind": "load",
      "description": "Root commits report ls-tree additions; non-root diffs report add/modify/delete/rename and ignore unknown statuses.",
      "setup": [
        {
          "op": "git",
          "args": [
            "init",
            "-b",
            "master"
          ]
        },
        {
          "op": "write",
          "path": "a.txt",
          "content": "one\n"
        },
        {
          "op": "git",
          "args": [
            "add",
            "-A"
          ]
        },
        {
          "op": "commit",
          "message": "root",
          "date": "2024-02-01T01:00:00+00:00"
        },
        {
          "op": "write",
          "path": "a.txt",
          "content": "two\n"
        },
        {
          "op": "git",
          "args": [
            "add",
            "-A"
          ]
        },
        {
          "op": "commit",
          "message": "modify",
          "date": "2024-02-02T01:00:00+00:00"
        },
        {
          "op": "git",
          "args": [
            "mv",
            "a.txt",
            "b.txt"
          ]
        },
        {
          "op": "commit",
          "message": "rename",
          "date": "2024-02-03T01:00:00+00:00"
        }
      ],
      "load": {
        "order": "chronological",
        "max_count": null,
        "mailmap": false
      },
      "assertions": [
        "root commit yields add a.txt",
        "second commit yields modify a.txt",
        "rename commit yields rename from a.txt to b.txt",
        "unknown T status entries are ignored"
      ],
      "source_expectation": "PASS",
      "target_expectation": "PASS",
      "probe": "TestDiffB0001CommitDetail"
    },
