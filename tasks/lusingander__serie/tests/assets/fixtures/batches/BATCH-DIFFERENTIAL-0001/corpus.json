{
  "schema_version": "serie-differential-corpus:v1",
  "batch_id": "BATCH-DIFFERENTIAL-0001",
  "family": "shared-case-corpus",
  "source_baseline": {
    "repository_url": "https://github.com/lusingander/serie",
    "base_commit_hash": "605702602d2de9275d6df2d1162248d4d503b72e",
    "language": "Rust 2021"
  },
  "normalization": {
    "helper": "shared/batches/BATCH-DIFFERENTIAL-0001/normalize.py",
    "drop_fields": [
      "committer_date_unix",
      "duration_ms",
      "absolute_path"
    ],
    "sort_refs": "kind,name,target,message",
    "sort_edges": "associated_line_pos_x,pos_x,edge_type",
    "edge_type_order": [
      "vertical",
      "horizontal",
      "up",
      "down",
      "left",
      "right",
      "right_top",
      "right_bottom",
      "left_top",
      "left_bottom"
    ],
    "date_format": "RFC3339 with original fixed offset"
  },
  "cases": [
    {
      "id": "DIFF-CASE-OUT-OF-SCOPE",
      "observations": [
        "DIFF-001",
        "DIFF-027"
      ],
      "kind": "diff",
      "description": "Rust TUI, image, color/keybind, clipboard, and external-command modules are unchanged relative to the baseline.",
      "compare": "normalized-diff",
      "protected_paths": [
        "src/app.rs",
        "src/view/**",
        "src/widget/**",
        "src/protocol.rs",
        "src/graph/image.rs",
        "src/graph/geometry.rs",
        "src/color.rs",
        "src/keybind.rs",
        "src/config.rs",
        "src/external.rs",
        "src/main.rs"
      ],
      "source_expectation": "PASS",
      "target_expectation": "PASS",
      "probe": "target/batches/BATCH-DIFFERENTIAL-0001/core/diffbatch0001_test.go"
    },
    {
      "id": "DIFF-CASE-COMMIT-RECORD",
      "observations": [
        "DIFF-002",
        "DIFF-003",
        "DIFF-014"
      ],
      "kind": "load",
      "description": "Commit records expose ten fields, preserve fixed-offset RFC3339 dates, split parents on spaces, and expose full and seven-character short hashes.",
      "setup": [
        {
          "op": "git",
          "args": [
            "init",
            "-b",
            "master"
          ]
        },
        {
          "op": "commit",
          "message": "initial subject",
          "date": "2024-02-03T04:05:06-05:00"
        }
      ],
      "load": {
        "order": "chronological",
        "max_count": null,
        "mailmap": false
      },
      "assertions": [
        "commit_hash is a 40-character hash and short hash is its first seven characters",
        "author_name/author_email/committer_name/committer_email/subject/body are populated",
        "author_date and committer_date format as 2024-02-03T04:05:06-05:00",
        "parent_commit_hashes is empty for a root commit and split on spaces otherwise"
      ],
      "source_expectation": "PASS",
      "target_expectation": "PASS",
      "probe": "TestDiffB0001CommitRecordAndHash"
    },
    {
      "id": "DIFF-CASE-REFS-HEAD",
      "observations": [
        "DIFF-004",
        "DIFF-011",
        "DIFF-013",
        "DIFF-017",
        "DIFF-018"
      ],
      "kind": "load",
      "description": "Refs distinguish tags, branches, remote branches, and stashes; stash refs carry messages; HEAD distinguishes branch, detached, and none; validation errors are stable.",
      "setup": [
        {
          "op": "git",
          "args": [
            "init",
            "-b",
            "master"
          ]
        },
        {
          "op": "commit",
          "message": "base",
          "date": "2024-01-01T01:00:00+00:00"
        },
        {
          "op": "git",
          "args": [
            "tag",
            "zlite"
          ]
        },
        {
          "op": "git",
          "args": [
            "tag",
            "-a",
            "aannot",
            "-m",
            "annotated"
          ]
        },
        {
          "op": "git",
          "args": [
            "branch",
            "bbranch"
          ]
        },
        {
          "op": "git",
          "args": [
            "update-ref",
            "refs/remotes/origin/mmote",
            "HEAD"
          ]
        },
        {
          "op": "write",
          "path": "work.txt",
          "content": "dirty\n"
        },
        {
          "op": "git",
          "args": [
            "stash",
            "push",
            "--include-untracked",
            "-m",
            "stash message"
          ]
        },
        {
          "op": "git",
          "args": [
            "checkout",
            "--detach"
          ]
        }
      ],
      "load": {
        "order": "chronological",
        "max_count": null,
        "mailmap": false
      },
      "variants": [
        "bare repository accepted",
        "non-repository rejected with not a git repository (or any of the parent directories)",
        "empty repository rejected with no commits in the repository"
      ],
      "assertions": [
        "all_refs orders tag, branch, remote branch, stash",
        "stash ref message contains the stash list message",
        "HEAD kind is branch, detached, or none without collapsing states"
      ],
      "source_expectation": "PASS",
      "target_expectation": "PASS",
      "probe": "TestDiffB0001RefsStashHead"
    },
    {
      "id": "DIFF-CASE-QUERY-API",
      "observations": [
        "DIFF-005"
      ],
      "kind": "load",
      "description": "Read-only queries commit, all_commits, parents_hash, children_hash, refs, all_refs, head, and commit_detail return the same data as the Rust core.",
      "setup": [
        {
          "op": "git",
          "args": [
