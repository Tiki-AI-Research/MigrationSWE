+  const built = path.join(
+    packageDir,
+    (typeof rootExport === "string" ? rootExport : rootExport?.import) ??
+      manifest.module ??
+      manifest.main
+  );
+  return fs.existsSync(built) ? built : path.join(packageDir, "src/index.ts");
