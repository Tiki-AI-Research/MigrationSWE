+function resolveDependencyRoots(repoRoot) {
+  const candidates = [
+    process.env.F2P_DEPENDENCIES_NODE_MODULES,
+    process.env.F2P_EXTRA_NODE_MODULES,
+    path.join(repoRoot, "node_modules"),
