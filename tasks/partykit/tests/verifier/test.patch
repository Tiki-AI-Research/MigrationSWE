diff --git a/tests/source/batches/BATCH-DIFFERENTIAL-0001/run.mjs b/tests/source/batches/BATCH-DIFFERENTIAL-0001/run.mjs
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/run.mjs
@@ -0,0 +1,16 @@
+import { writeFile } from "node:fs/promises";
+import { runAll } from "../../../shared/batches/BATCH-DIFFERENTIAL-0001/cases.mjs";
+import { subject } from "./subject.mjs";
+
+const report = await runAll(subject);
+const reportPath = process.argv[2];
+
+if (reportPath) {
+  await writeFile(reportPath, `${JSON.stringify(report, null, 2)}\n`);
+} else {
+  process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+}
+
+if (report.summary.failed > 0) {
+  process.exitCode = 1;
+}
diff --git a/tests/source/batches/BATCH-DIFFERENTIAL-0001/subject.mjs b/tests/source/batches/BATCH-DIFFERENTIAL-0001/subject.mjs
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/subject.mjs
@@ -0,0 +1,57 @@
+import { readFile } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { Hono } from "hono";
+
+const entry = process.env.HONO_PARTY_ENTRY ?? "hono-party";
+const moduleSpecifier = entry.startsWith("/") || entry.startsWith(".")
+  ? pathToFileURL(resolve(entry)).href
+  : entry;
+
+const mod = await import(moduleSpecifier);
+const repoRoot = process.env.HONO_PARTY_REPO ?? process.cwd();
+
+export const subject = {
+  name: "source",
+  framework: "hono",
+  mod,
+  downstream: [],
+  create({ options, onError } = {}) {
+    this.downstream = [];
+    const app = new Hono();
+    app.use("*", mod.partyserverMiddleware({ options, onError }));
+    app.all("/parties/chat/room", (c) => {
+      this.downstream.push(c.req.path);
+      return c.text("next");
+    });
+    app.all("/party/chat/room", (c) => {
+      this.downstream.push(c.req.path);
+      return c.text("party-next");
+    });
+    app.all("/other", (c) => {
+      this.downstream.push(c.req.path);
+      return c.text("other");
+    });
+    app.all("/health", (c) => {
+      this.downstream.push(c.req.path);
+      return c.text("ok");
+    });
+    return app;
+  },
+  async handle(app, request) {
+    return app.fetch(request, {
+      JWT_SECRET: process.env.JWT_SECRET ?? "s3cr3t"
+    });
+  },
+  async registerZeroArgumentPlugin(plugin) {
+    const app = new Hono();
+    app.use("*", plugin);
+    const response = await app.fetch(new Request("http://localhost/health"), {});
+    return response.status === 404 || response.status === 200;
+  },
+  async packageJson() {
+    return JSON.parse(
+      await readFile(join(repoRoot, "packages/hono-party/package.json"), "utf8")
+    );
+  }
+};
