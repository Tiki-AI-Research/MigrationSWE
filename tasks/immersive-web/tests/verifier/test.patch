+import { describe, it, expect } from 'vitest';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { JSDOM } from 'jsdom';
+import { createRequire } from 'node:module';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const rootDir = path.resolve(__dirname, '..');
+const normalPath = path.resolve(rootDir, 'build/webvr-polyfill.js');
+const minPath = path.resolve(rootDir, 'build/webvr-polyfill.min.js');
+
+const require = createRequire(import.meta.url);
+
+describe('Build artifacts smoke tests', () => {
+  it('loads normal UMD artifact via CommonJS with window only', () => {
+    if (!fs.existsSync(normalPath) || !fs.existsSync(minPath)) {
+      const { execSync } = require('node:child_process');
+      execSync('node scripts/build-vite.mjs', { cwd: rootDir });
+    }
+
+    const dom = new JSDOM('');
+    global.window = dom.window;
+    delete global.document;
+    delete global.navigator;
+
+    delete require.cache[require.resolve(normalPath)];
+    const Polyfill = require(normalPath);
+
+    expect(typeof Polyfill).toBe('function');
+    expect(typeof Polyfill.VRDisplay).toBe('function');
+    expect(typeof Polyfill.VRFrameData).toBe('function');
+    expect(Polyfill.version).toBe('0.10.12');
+
+    const polyfill = new Polyfill();
+    expect(typeof polyfill.getVRDisplays).toBe('function');
+  });
+
+  it('loads minified UMD artifact via CommonJS with window only', () => {
+    if (!fs.existsSync(normalPath) || !fs.existsSync(minPath)) {
+      const { execSync } = require('node:child_process');
+      execSync('node scripts/build-vite.mjs', { cwd: rootDir });
+    }
+
+    const dom = new JSDOM('');
+    global.window = dom.window;
+    delete global.document;
+    delete global.navigator;
+
+    delete require.cache[require.resolve(minPath)];
+    const PolyfillMin = require(minPath);
+
+    expect(typeof PolyfillMin).toBe('function');
+    expect(typeof PolyfillMin.VRDisplay).toBe('function');
+    expect(typeof PolyfillMin.VRFrameData).toBe('function');
+    expect(PolyfillMin.version).toBe('0.10.12');
+
+    const polyfill = new PolyfillMin();
+    expect(typeof polyfill.getVRDisplays).toBe('function');
+  });
+
+  it('loads normal UMD artifact in browser-like global environment', () => {
+    if (!fs.existsSync(normalPath) || !fs.existsSync(minPath)) {
+      const { execSync } = require('node:child_process');
+      execSync('node scripts/build-vite.mjs', { cwd: rootDir });
+    }
+
+    const dom = new JSDOM('', { runScripts: 'dangerously' });
+    const code = fs.readFileSync(normalPath, 'utf8');
+    dom.window.eval(code);
+
+    const WebVRPolyfill = dom.window.WebVRPolyfill;
+    expect(typeof WebVRPolyfill).toBe('function');
+    expect(typeof WebVRPolyfill.VRDisplay).toBe('function');
+    expect(typeof WebVRPolyfill.VRFrameData).toBe('function');
+    expect(WebVRPolyfill.version).toBe('0.10.12');
+
+    const polyfill = new WebVRPolyfill();
+    expect(typeof polyfill.getVRDisplays).toBe('function');
+    expect(typeof dom.window.navigator.getVRDisplays).toBe('function');
+    expect(typeof dom.window.VRDisplay).toBe('function');
+    expect(typeof dom.window.VRFrameData).toBe('function');
+  });
+
+  it('loads minified UMD artifact in browser-like global environment', () => {
+    if (!fs.existsSync(normalPath) || !fs.existsSync(minPath)) {
+      const { execSync } = require('node:child_process');
+      execSync('node scripts/build-vite.mjs', { cwd: rootDir });
+    }
+
+    const dom = new JSDOM('', { runScripts: 'dangerously' });
+    const code = fs.readFileSync(minPath, 'utf8');
+    dom.window.eval(code);
+
+    const WebVRPolyfill = dom.window.WebVRPolyfill;
+    expect(typeof WebVRPolyfill).toBe('function');
+    expect(typeof WebVRPolyfill.VRDisplay).toBe('function');
+    expect(typeof WebVRPolyfill.VRFrameData).toBe('function');
+    expect(WebVRPolyfill.version).toBe('0.10.12');
+
+    const polyfill = new WebVRPolyfill();
+    expect(typeof polyfill.getVRDisplays).toBe('function');
+    expect(typeof dom.window.navigator.getVRDisplays).toBe('function');
+    expect(typeof dom.window.VRDisplay).toBe('function');
+    expect(typeof dom.window.VRFrameData).toBe('function');
+  });
+});
