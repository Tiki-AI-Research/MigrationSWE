diff --git a/scripts/build-vite.mjs b/scripts/build-vite.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..41e51eee520efbe2ec753a3007f5110e0f957837
--- /dev/null
+++ b/scripts/build-vite.mjs
@@ -0,0 +1,315 @@
+import { build } from 'vite';
+import { createHash, randomBytes } from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const scriptPath = fileURLToPath(import.meta.url);
+const scriptDir = path.dirname(scriptPath);
+
+export const rootDir = path.resolve(scriptDir, '..');
+export const buildDir = path.resolve(rootDir, 'build');
+export const licenseSource = path.resolve(rootDir, 'licenses.txt');
+
+// Every published file of the package. A build or rebuild is only complete
+// when this whole set is present and comes from the same source revision.
+export const DISTRIBUTION_FILES = [
+  'webvr-polyfill.js',
+  'webvr-polyfill.js.map',
+  'webvr-polyfill.min.js',
+  'webvr-polyfill.min.js.map',
+  'webvr-polyfill.mjs',
+  'webvr-polyfill.mjs.map',
+  'webvr-polyfill.min.mjs',
+  'webvr-polyfill.min.mjs.map',
+  'webvr-polyfill.cjs',
+  'webvr-polyfill.cjs.map',
+  'licenses.txt',
+];
+
+export const MINIFIED_FILES = [
+  'webvr-polyfill.min.js',
+  'webvr-polyfill.min.js.map',
+  'webvr-polyfill.min.mjs',
+  'webvr-polyfill.min.mjs.map',
+  'licenses.txt',
+];
+
+const PREPARED_MAPS = [
+  'webvr-polyfill.js.map',
+  'webvr-polyfill.mjs.map',
+  'webvr-polyfill.cjs.map',
+  'webvr-polyfill.min.js.map',
+  'webvr-polyfill.min.mjs.map',
+];
+
+const MINIFIED_MAPS = ['webvr-polyfill.min.js.map', 'webvr-polyfill.min.mjs.map'];
+
+const configFile = path.resolve(rootDir, 'vite.config.mjs');
+// Builds are staged outside `build/` and swapped in only after the complete
+// distribution exists, so a failed or interrupted build can never publish a
+// half-written or mixed-generation package. Staging and the displaced previous
+// generation are unique per process: a full `build-all` may run while the
+// watcher rebuilds, and two concurrent builds must never share or delete each
+// other's staging directory. The final directory exchange is serialized with a
+// short-lived lock so the published `build/` always flips between two complete
+// generations.
+const processTag = `${process.pid}-${randomBytes(4).toString('hex')}`;
+const stageDir = path.resolve(rootDir, `.build-staging-${processTag}`);
+const previousDir = path.resolve(rootDir, `.build-previous-${processTag}`);
+const lockDir = path.resolve(rootDir, '.build-lock');
+const STAGING_PATTERN = /^\.build-(?:staging|previous)-\d+-[0-9a-f]+$/;
+
+function sleepSync(milliseconds) {
+  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, milliseconds);
+}
+
+function processAlive(pid) {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    return error.code === 'EPERM';
+  }
+}
+
+// Remove only staging left behind by processes that are no longer running. A
+// live peer build owns its own `.build-*` directories and must be left alone.
+function cleanupStaleStaging() {
+  let entries;
+  try {
+    entries = fs.readdirSync(rootDir);
+  } catch {
+    return;
+  }
+  for (const name of entries) {
+    const full = path.join(rootDir, name);
+    if (name === path.basename(lockDir)) continue;
+    if (STAGING_PATTERN.test(name)) {
+      const pid = Number(name.split('-')[2]);
+      if (Number.isFinite(pid) && processAlive(pid)) continue;
+      fs.rmSync(full, { recursive: true, force: true });
+      continue;
+    }
+    if (/^\.build-(?:staging|previous)$/.test(name) || /^build\./.test(name)) {
+      fs.rmSync(full, { recursive: true, force: true });
+    }
+  }
+}
+
+function acquireSwapLock() {
+  const deadline = Date.now() + 60000;
+  for (;;) {
+    try {
+      fs.mkdirSync(lockDir);
+      return;
+    } catch (error) {
+      if (error.code !== 'EEXIST') throw error;
+    }
+    try {
+      if (Date.now() - fs.statSync(lockDir).mtimeMs > 120000) {
+        fs.rmSync(lockDir, { recursive: true, force: true });
+        continue;
+      }
+    } catch {}
+    if (Date.now() > deadline) {
+      throw new Error('timed out waiting for the build swap lock');
+    }
+    sleepSync(25);
+  }
+}
+
+function releaseSwapLock() {
+  try {
+    fs.rmSync(lockDir, { recursive: true, force: true });
+  } catch {}
+}
+
+// A published generation must be derived from a single state of the build
+// inputs. Hash the whole source tree plus every root metadata file the build
+// reads, before the build and again right before the swap, so an edit made
+// while the build runs can never publish a mix of two generations.
+function hashTree(dir, hash) {
+  let entries;
+  try {
+    entries = fs.readdirSync(dir, { withFileTypes: true });
+  } catch {
+    return;
+  }
+  entries.sort((left, right) => left.name.localeCompare(right.name));
+  for (const entry of entries) {
+    const full = path.join(dir, entry.name);
+    const relative = path.relative(rootDir, full).split(path.sep).join('/');
+    if (entry.isDirectory()) {
+      hash.update(`dir:${relative}\n`);
+      hashTree(full, hash);
+    } else if (entry.isFile()) {
+      hash.update(`file:${relative}\n`);
+      hash.update(fs.readFileSync(full));
+      hash.update('\n');
+    }
+  }
+}
+
+export function buildInputSnapshot() {
+  const hash = createHash('sha256');
+  hashTree(path.resolve(rootDir, 'src'), hash);
+  for (const name of ['package.json', 'licenses.txt']) {
+    const file = path.resolve(rootDir, name);
+    hash.update(`root:${name}\n`);
+    hash.update(fs.existsSync(file) ? fs.readFileSync(file) : Buffer.from('missing'));
+    hash.update('\n');
+  }
+  return hash.digest('hex');
+}
+
+export function copyLicense(targetDir) {
+  if (!fs.existsSync(licenseSource)) {
+    throw new Error(`license source is missing: ${licenseSource}`);
+  }
+  fs.mkdirSync(targetDir, { recursive: true });
+  fs.copyFileSync(licenseSource, path.join(targetDir, 'licenses.txt'));
+}
+
+// A source-map `sources` entry is only publishable when it is package-relative
+// and resolves to a real file inside the package. A map may live in the staging
+// directory, so resolve against the map directory first, then fall back to
+// already-normalized forms so the rewrite stays idempotent.
+function packageRelativeSource(mapDir, source) {
+  const candidates = [
+    path.isAbsolute(source) ? source : path.resolve(mapDir, source),
+    path.resolve(rootDir, source),
+    path.resolve(buildDir, source),
+  ];
+  for (const absolute of candidates) {
+    const relative = path.relative(rootDir, absolute).split(path.sep).join('/');
+    if (!relative || relative === '..' || relative.startsWith('../') || path.isAbsolute(relative)) {
+      continue;
+    }
+    if (!fs.existsSync(absolute)) continue;
+    return relative;
+  }
+  throw new Error(`Source map entry is not package-relative: ${source}`);
+}
+
+export function finalizeMaps(mapDir, names) {
+  if (!fs.existsSync(licenseSource)) {
+    throw new Error(`license source is missing: ${licenseSource}`);
+  }
+  const licenseText = fs.readFileSync(licenseSource, 'utf8');
+  const bannerLines = (licenseText.match(/\n/g) || []).length + 1;
+  for (const name of names) {
+    const file = path.resolve(mapDir, name);
+    if (!fs.existsSync(file)) continue;
+    const map = JSON.parse(fs.readFileSync(file, 'utf8'));
+    map.sources = (map.sources || []).map(source => packageRelativeSource(mapDir, source));
+    // The banner plugin prepends the license before Rollup composes the map,
+    // so keep the mappings aligned without shifting them twice.
+    const existingLines = (map.mappings.match(/^;*/) || [''])[0].length;
+    if (existingLines < bannerLines) {
+      map.mappings = ';'.repeat(bannerLines) + map.mappings;
+    }
+    fs.writeFileSync(file, JSON.stringify(map));
+  }
+}
+
+export function assertComplete(targetDir, expected = DISTRIBUTION_FILES) {
+  const missing = expected.filter(name => !fs.existsSync(path.join(targetDir, name)));
+  if (missing.length > 0) {
+    throw new Error(`build output is incomplete: ${missing.join(', ')}`);
+  }
+}
+
+// Finishing steps shared by the build and the watcher: the published license
+// copy plus package-relative, banner-aligned source maps.
+export function finalizeDistribution(targetDir, maps = PREPARED_MAPS) {
+  copyLicense(targetDir);
+  finalizeMaps(targetDir, maps);
+}
+
+async function buildIntoStage(isMinify, preserveUnrelated = false) {
+  const inputsBefore = buildInputSnapshot();
+  fs.rmSync(stageDir, { recursive: true, force: true });
+  fs.mkdirSync(stageDir, { recursive: true });
+  // The watcher must not discard files it does not own. Carry the unrelated
+  // entries of the current publication into the staged generation so the swap
+  // keeps them visible.
+  if (preserveUnrelated && fs.existsSync(buildDir)) {
+    for (const entry of fs.readdirSync(buildDir, { withFileTypes: true })) {
+      if (DISTRIBUTION_FILES.includes(entry.name)) continue;
+      fs.cpSync(
+        path.join(buildDir, entry.name),
+        path.join(stageDir, entry.name),
+        { recursive: true },
+      );
+    }
+  }
+  // `build-min` is incremental: it publishes the minified generation while
+  // leaving the readable artifacts of an earlier full build untouched.
+  if (isMinify && fs.existsSync(buildDir)) {
+    fs.cpSync(buildDir, stageDir, { recursive: true });
+  }
+  for (const mode of isMinify ? ['minify'] : ['production', 'minify']) {
+    await build({
+      configFile,
+      mode,
+      build: { outDir: stageDir, emptyOutDir: false },
+    });
+  }
+  finalizeDistribution(stageDir, isMinify ? MINIFIED_MAPS : PREPARED_MAPS);
+  assertComplete(stageDir, isMinify ? MINIFIED_FILES : DISTRIBUTION_FILES);
+  if (buildInputSnapshot() !== inputsBefore) {
+    throw new Error(
+      'build inputs changed while the build was running; refusing to publish a mixed generation',
+    );
+  }
+}
+
+function swapIntoPlace() {
+  acquireSwapLock();
+  try {
+    fs.rmSync(previousDir, { recursive: true, force: true });
+    if (fs.existsSync(buildDir)) {
+      fs.renameSync(buildDir, previousDir);
+    }
+    try {
+      fs.renameSync(stageDir, buildDir);
+    } catch (error) {
+      if (fs.existsSync(previousDir) && !fs.existsSync(buildDir)) {
+        fs.renameSync(previousDir, buildDir);
+      }
+      throw error;
+    }
+    fs.rmSync(previousDir, { recursive: true, force: true });
+  } finally {
+    releaseSwapLock();
+  }
+}
+
+async function main() {
+  const isMinify = process.argv.includes('--minify');
+  const preserveUnrelated = process.argv.includes('--preserve-unrelated');
+  const expected = isMinify ? MINIFIED_FILES : DISTRIBUTION_FILES;
+  // A previous run may have been killed before it could clean up. Drop every
+  // recognizable staging entry left by a dead process before starting a new
+  // generation; live peer builds keep their own staging.
+  cleanupStaleStaging();
+  try {
+    await buildIntoStage(isMinify, preserveUnrelated);
+    swapIntoPlace();
+    assertComplete(buildDir, expected);
+  } catch (error) {
+    // Keep the previous published set untouched and drop the staging area so a
+    // retry starts from a clean directory.
+    fs.rmSync(stageDir, { recursive: true, force: true });
+    fs.rmSync(previousDir, { recursive: true, force: true });
+    throw error;
+  }
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === scriptPath) {
+  main().catch(error => {
+    console.error(error);
+    process.exit(1);
+  });
+}
