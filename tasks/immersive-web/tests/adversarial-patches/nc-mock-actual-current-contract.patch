new file mode 100644
index 0000000000000000000000000000000000000000..64b2e02033f9bec51bd44d51a0a1a11fbf0bb08d
--- /dev/null
+++ b/vite.config.mjs
@@ -0,0 +1,83 @@
+import { defineConfig, transformWithEsbuild } from 'vite';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const banner = fs.readFileSync(path.resolve(__dirname, 'licenses.txt'), 'utf8');
+
+const intro = `if (typeof global !== 'undefined' && global.window) {
+  if (!global.document) {
+    global.document = global.window.document;
+  }
+  if (!global.navigator) {
+    global.navigator = global.window.navigator;
+  }
+}`;
+
+// Vite's library-mode esbuild pass leaves readable ES output. Minify the ES
+// chunk inside the Rollup pipeline so Rollup still composes the source map.
+const minifyEsLibrary = {
+  name: 'webvr-minify-es-library',
+  async renderChunk(code, chunk) {
+    if (!chunk.fileName.endsWith('.mjs')) return null;
+    const result = await transformWithEsbuild(code, chunk.fileName, {
+      minify: true,
+      sourcemap: true,
+      sourcefile: chunk.fileName,
+      target: 'esnext',
+    });
+    return { code: result.code, map: result.map };
+  },
+};
+
+export default defineConfig(({ mode }) => {
+  const isMinify = mode === 'minify' || process.env.MINIFY === 'true';
+
+  return {
+    plugins: [
+      {
+        name: 'license-banner-first',
+        generateBundle(_options, bundle) {
+          for (const chunk of Object.values(bundle)) {
+            if (chunk.type === 'chunk') {
+              chunk.code = `${banner}\n${chunk.code}`;
+            }
+          }
+        },
+      },
+    ],
+    build: {
+      outDir: 'build',
+      emptyOutDir: false,
+      sourcemap: true,
+      minify: isMinify ? 'esbuild' : false,
+      lib: {
+        entry: path.resolve(__dirname, 'src/webvr-polyfill.js'),
+        name: 'WebVRPolyfill',
+        // The readable build also emits a genuine CommonJS entry. The
+        // minified build stays UMD/ESM only so `build-min` remains a
+        // self-contained minified distribution.
+        formats: isMinify ? ['umd', 'es'] : ['umd', 'es', 'cjs'],
+        fileName: format => {
+          if (format === 'es') {
+            return isMinify ? 'webvr-polyfill.min.mjs' : 'webvr-polyfill.mjs';
+          }
+          if (format === 'cjs') {
+            return 'webvr-polyfill.cjs';
+          }
+          return isMinify ? 'webvr-polyfill.min.js' : 'webvr-polyfill.js';
+        },
+      },
+      rollupOptions: {
+        // Ensure all dependencies (including cardboard-vr-display) are bundled into the UMD output
+        external: [],
+        output: {
+          intro,
+          exports: 'default',
+          plugins: isMinify ? [minifyEsLibrary] : [],
+        },
+      },
+    },
+  };
+});
