+++ b/scripts/watch-vite.mjs
@@ -0,0 +1,277 @@
+#!/usr/bin/env node
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const scriptDir = path.dirname(fileURLToPath(import.meta.url));
+const rootDir = path.resolve(scriptDir, '..');
+const buildDriver = path.join(scriptDir, 'build-vite.mjs');
+const sourceDir = path.join(rootDir, 'src');
+const licenseSource = path.join(rootDir, 'licenses.txt');
+const packageSource = path.join(rootDir, 'package.json');
+const entryFile = path.join(sourceDir, 'webvr-polyfill.js');
+
+// The watcher delegates every rebuild to the same driver as `build-all`, so a
+// watch publication goes through the identical stage-then-swap path. That
+// keeps rebuilds atomic for readers and lets a killed rebuild reuse the same
+// stale-staging cleanup as a normal build.
+let running = null;
+let pending = false;
+let shuttingDown = false;
+let debounceTimer = null;
+let lastBuildFailed = false;
+
+const directoryWatchers = new Map();
+let graph = new Set();
+let missing = new Set();
+let watchedPaths = new Set();
+
+// Only the modules the bundle actually pulls in are inputs. Watching the whole
+// `src/` tree recursively would republish on unrelated files (notes, tests, a
+// module nobody imports), which must not rewrite any artifact. Events are
+// filtered against the resolved graph plus the expected-but-missing paths, so
+// a directory watcher on its own never turns an unrelated file into a rebuild.
+const SPECIFIER_PATTERNS = [
+  /(?:^|\n)\s*import\s+(?:[^'"]*?\s+from\s+)?['"]([^'"]+)['"]/g,
+  /(?:^|\n)\s*export\s+[^'"]*?\s+from\s+['"]([^'"]+)['"]/g,
+  /\bimport\s*\(\s*['"]([^'"]+)['"]\s*\)/g,
+  /\brequire\s*\(\s*['"]([^'"]+)['"]\s*\)/g,
+];
+
+function specifiersOf(text) {
+  const specifiers = [];
+  for (const pattern of SPECIFIER_PATTERNS) {
+    pattern.lastIndex = 0;
+    let match;
+    while ((match = pattern.exec(text)) !== null) {
+      specifiers.push(match[1]);
+    }
+  }
+  return specifiers;
+}
+
+// Resolution candidates for a relative specifier. The list is returned even
+// when none of the candidates exist yet: a module that is imported before it
+// is created must stay watched so its creation triggers the next publication.
+function moduleCandidates(fromFile, specifier) {
+  if (!specifier.startsWith('.') && !specifier.startsWith('/')) return null;
+  const base = path.resolve(path.dirname(fromFile), specifier);
+  const candidates = [base];
+  if (!path.extname(base)) {
+    candidates.push(`${base}.js`, `${base}.mjs`, `${base}.json`, path.join(base, 'index.js'));
+  }
+  return candidates;
+}
+
+function isFile(file) {
+  try {
+    return fs.statSync(file).isFile();
+  } catch {
+    return false;
+  }
+}
+
+// Walk the module graph, remembering both the files that resolved and the
+// paths that a mapped source expects but that do not exist yet. Keeping the
+// missing set is what makes delete-then-restore and import-before-create
+// recoverable without restarting the watcher.
+function collectGraph() {
+  const seen = new Set();
+  const unresolved = new Set();
+  const queue = [entryFile];
+  while (queue.length > 0) {
+    const file = queue.pop();
+    if (seen.has(file)) continue;
+    if (!isFile(file)) {
+      unresolved.add(file);
+      continue;
+    }
+    seen.add(file);
+    if (!/\.(?:m?js)$/.test(file)) continue;
+    let text;
+    try {
+      text = fs.readFileSync(file, 'utf8');
+    } catch {
+      continue;
+    }
+    for (const specifier of specifiersOf(text)) {
+      const candidates = moduleCandidates(file, specifier);
+      if (candidates === null) continue;
+      const resolved = candidates.find(isFile);
+      if (resolved) {
+        queue.push(resolved);
+      } else {
+        for (const candidate of candidates) unresolved.add(candidate);
+      }
+    }
+  }
+  return { graph: seen, missing: unresolved };
+}
+
+function nearestExistingDirectory(file) {
+  let directory = path.dirname(file);
+  for (;;) {
+    try {
+      if (fs.statSync(directory).isDirectory()) return directory;
+    } catch {}
+    const parent = path.dirname(directory);
+    if (parent === directory) return rootDir;
+    directory = parent;
+  }
+}
+
+function refreshWatchers() {
+  if (shuttingDown) return;
+
+  watchedPaths = new Set([...graph, ...missing, licenseSource, packageSource]);
+  const directories = new Set();
+  for (const file of watchedPaths) directories.add(nearestExistingDirectory(file));
+
+  for (const [directory, watcher] of directoryWatchers) {
+    if (directories.has(directory)) continue;
+    try {
+      watcher.close();
+    } catch {}
+    directoryWatchers.delete(directory);
+  }
+
+  for (const directory of directories) {
+    if (directoryWatchers.has(directory)) continue;
+    try {
+      const watcher = fs.watch(directory, { persistent: true }, (eventType, filename) => {
+        handleEvent(directory, filename);
+      });
+      watcher.on('error', () => {
+        try {
+          watcher.close();
+        } catch {}
+        directoryWatchers.delete(directory);
+      });
+      directoryWatchers.set(directory, watcher);
+    } catch {}
+  }
+}
+
+function handleEvent(directory, filename) {
+  if (shuttingDown) return;
+  if (!filename) {
+    // Some platforms omit the name. Fall back to a rebuild only when the last
+    // build failed, so a nameless event cannot turn into a rebuild loop on a
+    // healthy tree.
+    if (lastBuildFailed) schedule();
+    return;
+  }
+  const changed = path.resolve(directory, filename.toString());
+  if (watchedPaths.has(changed)) {
+    schedule();
+    return;
+  }
+  // A missing module may live in a directory that does not exist yet. When an
+  // ancestor of an expected path appears, start watching it and let the next
+  // event (or this rebuild) pick the module up.
+  const prefix = changed + path.sep;
+  for (const target of watchedPaths) {
+    if (target.startsWith(prefix)) {
+      refreshWatchers();
+      schedule();
+      return;
+    }
+  }
+}
+
+function recomputeInputs() {
+  const next = collectGraph();
+  graph = next.graph;
+  missing = next.missing;
+  refreshWatchers();
+}
+
+// A cheap identity of the current input graph. Comparing it with the identity
+// captured when a build started detects an edit that landed while the build was
+// running (including the creation of a previously missing module, whose event
+// could not be attributed to a watched path yet). A failed build then retries
+// instead of waiting for another edit that may never come.
+function inputSignature() {
+  const paths = [];
+  for (const file of watchedPaths) {
+    paths.push(`${file}:${isFile(file) ? 1 : 0}`);
+  }
+  paths.sort();
+  return paths.join('|');
+}
+
+function publish() {
+  if (shuttingDown) return;
+  if (running) {
+    pending = true;
+    return;
+  }
+  const signatureBefore = inputSignature();
+  running = spawn(process.execPath, [buildDriver, '--preserve-unrelated'], {
+    cwd: rootDir,
+    stdio: 'inherit',
+  });
+  running.on('error', error => {
+    console.error(error);
+    running = null;
+    lastBuildFailed = true;
+  });
+  running.on('exit', code => {
+    running = null;
+    lastBuildFailed = code !== 0;
+    if (code !== 0) {
+      console.error(`watch rebuild failed with exit code ${code}`);
+    }
+    // Re-derive the graph after every attempt, successful or not: a failed
+    // build must still remember which paths it was waiting for.
+    recomputeInputs();
+    if (inputSignature() !== signatureBefore) {
+      pending = true;
+    }
+    if (pending && !shuttingDown) {
+      pending = false;
+      schedule();
+    }
+  });
+}
+
+function schedule() {
+  if (shuttingDown) return;
+  if (debounceTimer) clearTimeout(debounceTimer);
+  debounceTimer = setTimeout(() => {
+    debounceTimer = null;
+    publish();
+  }, 120);
+}
+
+function shutdown() {
+  if (shuttingDown) return;
+  shuttingDown = true;
+  if (debounceTimer) clearTimeout(debounceTimer);
+  for (const watcher of directoryWatchers.values()) {
+    try {
+      watcher.close();
+    } catch {}
+  }
+  directoryWatchers.clear();
+  if (running) {
+    try {
+      running.kill('SIGTERM');
+    } catch {}
+    setTimeout(() => {
+      try {
+        running?.kill('SIGKILL');
+      } catch {}
+      process.exit(0);
+    }, 1000);
+    return;
+  }
+  process.exit(0);
+}
+
+process.on('SIGINT', shutdown);
+process.on('SIGTERM', shutdown);
+
+recomputeInputs();
+publish();
