+//go:build !noalloc
+
+package itertools_test
+
+import (
+	"cmp"
+	"errors"
+	"fmt"
+	"itertools"
+	"itertools/core"
+	"math/rand"
+	"reflect"
+	"slices"
+	"testing"
+)
+
+func TestAllocLaziness(t *testing.T) {
+	it := panicking{}
+	_ = itertools.Chunks(it, 2)
+	_ = itertools.ChunkBy(it, func(int) int { panic("key") })
+	_ = itertools.GroupBy(it, func(int) int { panic("key") })
+	_ = itertools.KMerge([]core.Iter[int]{it, it})
+	_ = itertools.KMergeBy([]core.Iter[int]{it}, func(int, int) bool { panic("compare") })
+	_ = itertools.KSorted(it, 2)
+	_ = itertools.Iproduct(it, it)
+	_ = itertools.Combinations(it, 3)
+	_ = itertools.CombinationsWithReplacement(it, 3)
+	_ = itertools.ArrayCombinations(it, 3)
+	_ = itertools.Permutations(it, 3)
+	_ = itertools.Powerset(it)
+	_ = itertools.MultiPeek(it)
+	_ = itertools.PeekNth(it)
+	_ = itertools.PutBackN(it)
+	_ = itertools.Rciter(it)
+	_, _ = itertools.Tee(it)
+}
+
+func referenceCombinations(values []int, k int, replacement bool) [][]int {
+	result := make([][]int, 0)
+	var visit func([]int, int)
+	visit = func(prefix []int, start int) {
+		if len(prefix) == k {
+			row := make([]int, k)
+			copy(row, prefix)
+			result = append(result, row)
+			return
+		}
+		for index := start; index < len(values); index++ {
+			next := index + 1
+			if replacement {
+				next = index
+			}
+			visit(append(append([]int{}, prefix...), values[index]), next)
+		}
+	}
+	visit(nil, 0)
+	return result
+}
+func referencePermutations(values []int, k int) [][]int {
+	result := make([][]int, 0)
+	used := make([]bool, len(values))
+	var visit func([]int)
+	visit = func(prefix []int) {
+		if len(prefix) == k {
+			row := make([]int, k)
+			copy(row, prefix)
+			result = append(result, row)
+			return
+		}
+		for index, value := range values {
+			if !used[index] {
+				used[index] = true
+				visit(append(append([]int{}, prefix...), value))
+				used[index] = false
+			}
+		}
+	}
+	visit(nil)
+	return result
+}
+func referenceProduct(dimensions [][]int) [][]int {
+	result := make([][]int, 0)
+	var visit func([]int, int)
+	visit = func(prefix []int, dimension int) {
+		if dimension == len(dimensions) {
+			row := make([]int, len(prefix))
+			copy(row, prefix)
+			result = append(result, row)
+			return
+		}
+		for _, value := range dimensions[dimension] {
+			visit(append(append([]int{}, prefix...), value), dimension+1)
+		}
+	}
+	visit(nil, 0)
+	return result
+}
+
+func TestCombinatoricsProperties(t *testing.T) {
+	for length := 0; length <= 6; length++ {
+		values := make([]int, length)
+		for index := range values {
+			values[index] = index
+		}
+		for k := 0; k <= length+2; k++ {
+			t.Run(fmt.Sprintf("combinations/%d/%d", length, k), func(t *testing.T) {
+				expectIter(t, itertools.Combinations(core.FromSlice(values), k), referenceCombinations(values, k, false), true)
+			})
+			t.Run(fmt.Sprintf("replacement/%d/%d", length, k), func(t *testing.T) {
+				expectIter(t, itertools.CombinationsWithReplacement(core.FromSlice(values), k), referenceCombinations(values, k, true), true)
+			})
+			t.Run(fmt.Sprintf("permutations/%d/%d", length, k), func(t *testing.T) {
+				expectIter(t, itertools.Permutations(core.FromSlice(values), k), referencePermutations(values, k), true)
+			})
+		}
+		powerset := make([][]int, 0)
+		for k := 0; k <= length; k++ {
+			powerset = append(powerset, referenceCombinations(values, k, false)...)
+		}
+		expectIter(t, itertools.Powerset(core.FromSlice(values)), powerset, true)
+	}
+	for dimensions := 0; dimensions <= 4; dimensions++ {
+		for length := 0; length <= 3; length++ {
+			inputs := make([]core.Iter[int], dimensions)
+			values := make([][]int, dimensions)
+			for index := range inputs {
+				row := make([]int, length)
+				for offset := range row {
+					row[offset] = index*10 + offset
+				}
+				values[index] = row
+				inputs[index] = core.FromSlice(row)
+			}
+			expectIter(t, itertools.Iproduct(inputs...), referenceProduct(values), true)
+		}
+	}
+	panics(t, func() { itertools.Combinations(source(1), -1) })
+	panics(t, func() { itertools.Permutations(source(1), -1) })
+}
+
+func TestInfiniteCombinatorics(t *testing.T) {
+	iterate := func() *core.Iterate[int] { return core.NewIterate(0, func(value int) int { return value + 1 }) }
+	combinations := itertools.Combinations(iterate(), 2)
+	for index := 1; index <= 10; index++ {
+		row, ok := combinations.Next()
+		if !ok || !reflect.DeepEqual(row, []int{0, index}) {
+			t.Fatal(row, ok)
+		}
+	}
+	permutations := itertools.Permutations(iterate(), 3)
+	for index := 2; index <= 10; index++ {
+		row, ok := permutations.Next()
+		if !ok || !reflect.DeepEqual(row, []int{0, 1, index}) {
+			t.Fatal(row, ok)
+		}
+	}
+	product := itertools.Iproduct(source(1, 2), iterate())
+	for index := 0; index < 10; index++ {
+		row, ok := product.Next()
+		if !ok || !reflect.DeepEqual(row, []int{1, index}) {
+			t.Fatal(row, ok)
+		}
+	}
+	calls := 0
+	effects := func() *core.Map[int, int] {
+		return itertools.Map(source(1, 2, 3), func(value int) int { calls++; return value })
+	}
+	emptyCombination := itertools.Combinations(effects(), 0)
+	collect(emptyCombination)
+	same(t, calls, 0)
+	emptyPermutation := itertools.Permutations(effects(), 0)
+	collect(emptyPermutation)
+	same(t, calls, 0)
+}
+
+func TestChunksAndGroups(t *testing.T) {
+	panics(t, func() { itertools.Chunks(source(1), 0) })
+	expectIter(t, itertools.Chunks(source(1, 2, 3, 4, 5), 2), [][]int{{1, 2}, {3, 4}, {5}}, true)
+	calls := 0
+	groups := itertools.ChunkBy(itertools.Map(source(1, 1, 2, 3, 3, 1), func(value int) int { calls++; return value }), func(value int) int { return value })
+	same(t, calls, 0)
+	first, ok := groups.Next()
+	if !ok || first.First != 1 {
+		t.Fatal(first, ok)
+	}
+	same(t, calls, 1)
+	second, ok := groups.Next()
+	if !ok || second.First != 2 {
+		t.Fatal(second, ok)
+	}
+	same(t, calls, 3)
+	third, ok := groups.Next()
+	if !ok || third.First != 3 {
+		t.Fatal(third, ok)
+	}
+	fourth, ok := groups.Next()
+	if !ok || fourth.First != 1 {
+		t.Fatal(fourth, ok)
+	}
+	same(t, collect(third.Second), []int{3, 3})
+	same(t, collect(first.Second), []int{1, 1})
+	same(t, collect(fourth.Second), []int{1})
+	same(t, collect(second.Second), []int{2})
+	if _, ok := groups.Next(); ok {
+		t.Fatal("extra group")
+	}
+	infinite := itertools.ChunkBy(core.RepeatIter(4), func(value int) int { return value })
+	group, _ := infinite.Next()
+	for index := 0; index < 10; index++ {
+		value, ok := group.Second.Next()
+		if !ok || value != 4 {
+			t.Fatal(value, ok)
+		}
+	}
+}
+
+func TestPeekingAndRestoration(t *testing.T) {
+	peek := itertools.PeekNth(source(1, 2, 3))
+	value, _ := peek.PeekNth(1)
+	same(t, value, 2)
+	value, _ = peek.PeekNth(1)
+	same(t, value, 2)
+	same(t, peek.Len(), 3)
+	pointer, ok := peek.PeekNthMut(1)
+	if !ok {
+		t.Fatal("missing mutable peek")
+	}
+	*pointer = 9
+	expectIter(t, peek, []int{1, 9, 3}, true)
+	peek = itertools.PeekNth(source(1, 2))
+	if _, ok := peek.PeekNth(5); ok {
+		t.Fatal("peek past end")
+	}
+	expectIter(t, peek, []int{1, 2}, true)
+	peek = itertools.PeekNth(source(1, 2))
+	if _, ok := peek.NextIf(func(value int) bool { return value > 1 }); ok {
+		t.Fatal("next if")
+	}
+	value, _ = peek.Next()
+	same(t, value, 1)
+	multi := itertools.MultiPeek(source(1, 2, 3))
+	value, _ = multi.Peek()
+	same(t, value, 1)
+	value, _ = multi.Peek()
+	same(t, value, 2)
+	multi.ResetPeek()
+	value, _ = multi.Peek()
+	same(t, value, 1)
+	value, _ = multi.Next()
+	same(t, value, 1)
+	value, _ = multi.Peek()
+	same(t, value, 2)
+	expectIter(t, multi, []int{2, 3}, true)
+	put := itertools.PutBackN(source(3, 4))
+	put.PutBack(2)
+	put.PutBack(1)
+	expectIter(t, put, []int{1, 2, 3, 4}, true)
+	left, right := itertools.Tee(source(1, 2, 3, 4))
+	value, _ = left.Next()
+	same(t, value, 1)
+	value, _ = left.Next()
+	same(t, value, 2)
+	same(t, collect(right), []int{1, 2, 3, 4})
+	expectIter(t, left, []int{3, 4}, true)
+	rc := itertools.Rciter(source(1, 2, 3))
+	clone := rc.Clone()
+	value, _ = rc.Next()
+	same(t, value, 1)
+	value, _ = clone.NextBack()
+	same(t, value, 3)
+	// Shared handles can consume the input, so the lower bound stays zero.
+	same(t, rc.SizeHint(), core.Hint(0, 1))
+	same(t, clone.SizeHint(), core.Hint(0, 1))
+	expectIter(t, rc, []int{2}, false)
+	same(t, clone.SizeHint(), core.Hint(0, 0))
+	if _, ok := clone.Next(); ok {
+		t.Fatal("rc clones must share consumption")
+	}
+}
+
+func TestSortingAndSelection(t *testing.T) {
+	random := rand.New(rand.NewSource(42))
+	for iteration := 0; iteration < 100; iteration++ {
+		values := make([]int, random.Intn(25))
+		for index := range values {
+			values[index] = random.Intn(10)
+		}
+		want := append([]int{}, values...)
+		slices.Sort(want)
+		same(t, itertools.Sorted(core.FromSlice(values)), want)
+		same(t, itertools.SortedBy(core.FromSlice(values), cmp.Compare[int]), want)
+		same(t, itertools.SortedUnstable(core.FromSlice(values)), want)
+		for k := 0; k <= len(values)+1; k++ {
+			same(t, itertools.KSmallest(core.FromSlice(values), k), want[:min(k, len(want))])
+			largest := append([]int{}, want...)
+			slices.Reverse(largest)
+			same(t, itertools.KLargest(core.FromSlice(values), k), largest[:min(k, len(largest))])
+		}
+		for n := 0; n <= len(values)+1; n++ {
+			expected := values[max(0, len(values)-n):]
+			same(t, collect(itertools.Tail(core.FromSlice(values), n)), append([]int{}, expected...))
+		}
+	}
+	expectIter(t, itertools.KSorted(source(2, 1, 4, 3, 6, 5), 1), []int{1, 2, 3, 4, 5, 6}, true)
+	items := []core.Pair[int, string]{{First: 2, Second: "a"}, {First: 1, Second: "b"}, {First: 2, Second: "c"}}
+	calls := 0
+	sorted := itertools.SortedByCachedKey(core.FromSlice(items), func(value core.Pair[int, string]) int { calls++; return value.First })
+	same(t, calls, 3)
+	same(t, sorted, []core.Pair[int, string]{{First: 1, Second: "b"}, {First: 2, Second: "a"}, {First: 2, Second: "c"}})
+	expectIter(t, itertools.KMerge([]core.Iter[int]{source(0, 3, 6, 9), source(0, 5, 10), source[int]()}), []int{0, 0, 3, 5, 6, 9, 10}, true)
+	expectIter(t, itertools.KMergeBy([]core.Iter[int]{source(9, 3), source(10, 5)}, func(a, b int) bool { return a > b }), []int{10, 9, 5, 3}, true)
+	same(t, itertools.MinSet(source(3, 1, 4, 1, 4)), []int{1, 1})
+	same(t, itertools.MaxSet(source(3, 1, 4, 1, 4)), []int{4, 4})
+}
+
+func TestResultsAndPartition(t *testing.T) {
+	failure := errors.New("stop")
+	results := source(core.Pair[int, error]{First: 1}, core.Pair[int, error]{First: 2}, core.Pair[int, error]{Second: failure}, core.Pair[int, error]{First: 4})
+	values, err := itertools.TryCollect(results)
+	if !errors.Is(err, failure) {
+		t.Fatal(err)
+	}
+	same(t, values, []int{1, 2})
+	tail, _ := results.Next()
+	same(t, tail.First, 4)
+	results = source(core.Pair[int, error]{First: 1}, core.Pair[int, error]{Second: failure}, core.Pair[int, error]{First: 4})
+	mapped := itertools.MapOK(results, func(value int) int { return value * 2 })
+	expectIter(t, mapped, []core.Pair[int, error]{{First: 2}, {Second: failure}, {First: 8}}, true)
+	flatten := itertools.FlattenOK(source(core.Pair[core.Iter[int], error]{First: source(1, 2)}, core.Pair[core.Iter[int], error]{Second: failure}, core.Pair[core.Iter[int], error]{First: source(3)}))
+	expectIter(t, flatten, []core.Pair[int, error]{{First: 1}, {First: 2}, {Second: failure}, {First: 3}}, false)
+	left, right := itertools.PartitionMap(source(1, 2, 3, 4), func(value int) core.EitherOrBoth[int, string] {
+		if value%2 == 0 {
+			return core.Left[int, string](value)
+		}
+		return core.Right[int, string](fmt.Sprint(value))
+	})
+	same(t, left, []int{2, 4})
+	same(t, right, []string{"1", "3"})
+	successes, failures := itertools.PartitionResult(source(core.Pair[int, error]{First: 1}, core.Pair[int, error]{Second: failure}, core.Pair[int, error]{First: 2}))
+	same(t, successes, []int{1, 2})
+	same(t, failures, []error{failure})
+}
