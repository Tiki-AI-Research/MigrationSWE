+func (iterator *RcIter[T]) NextBack() (T, bool) {
+	if !iterator.state.mu.TryLock() {
+		panic("RcIter: iterator already borrowed")
+	}
+	defer iterator.state.mu.Unlock()
+	return Back(iterator.state.it)
