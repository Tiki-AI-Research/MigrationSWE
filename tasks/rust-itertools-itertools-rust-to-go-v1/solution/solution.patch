@@ -0,0 +1,34 @@
+//go:build !nostd && !noalloc
+
+package itertools_test
+
+import (
+	"itertools"
+	"itertools/core"
+	"testing"
+)
+
+func TestCustomHashCollisions(t *testing.T) {
+	calls := 0
+	hash := func(int) uint64 { calls++; return 0 }
+	unique := itertools.UniqueWithHasher(source(1, 2, 1, 3, 2), hash)
+	same(t, calls, 0)
+	expectIter(t, unique, []int{1, 2, 3}, false)
+	if calls == 0 {
+		t.Fatal("custom hasher not used")
+	}
+	expectIter(t, itertools.DuplicatesWithHasher(source(1, 2, 1, 3, 2), hash), []int{1, 2}, false)
+	same(t, itertools.CountsWithHasher(source(1, 2, 1, 3, 2), hash), map[int]int{1: 2, 2: 2, 3: 1})
+	if !itertools.AllUniqueWithHasher(source(1, 2, 3), hash) || itertools.AllUniqueWithHasher(source(1, 2, 1), hash) {
+		t.Fatal("custom all unique")
+	}
+	pairs := source(core.Pair[int, int]{First: 1, Second: 2}, core.Pair[int, int]{First: 2, Second: 3}, core.Pair[int, int]{First: 1, Second: 4})
+	same(t, itertools.IntoGroupMapWithHasher(pairs, hash), map[int][]int{1: {2, 4}, 2: {3}})
+	grouped := itertools.IntoGroupingMapByWithHasher(source(1, 2, 3, 4, 5), func(value int) int { return value % 2 }, hash)
+	same(t, grouped.Aggregate(func(previous core.Option[int], key, value int) core.Option[int] {
+		if previous.Some {
+			return core.Option[int]{}
+		}
+		return core.Option[int]{Value: value, Some: true}
+	}), map[int]int{1: 5})
+}
diff --git a/hash_std.go b/hash_std.go
new file mode 100644
index 0000000000000000000000000000000000000000..05c9c6ec623fe3a6cf3f224ed5b360a696ead60d
--- /dev/null
+++ b/hash_std.go
@@ -0,0 +1,136 @@
+//go:build !nostd && !noalloc
+
+package itertools
+
+import (
+	"cmp"
+	"itertools/core"
+)
+
+func Unique[T comparable](it core.Iter[T]) *core.Unique[T] {
+	return &core.Unique[T]{UniqueBy: core.UniqueBy[T, T]{It: it, Key: func(value T) T { return value }}}
+}
+func UniqueBy[T any, K comparable](it core.Iter[T], key func(T) K) *core.UniqueBy[T, K] {
+	return &core.UniqueBy[T, K]{It: it, Key: key}
+}
+func UniqueWithHasher[T comparable](it core.Iter[T], hasher func(T) uint64) *core.Unique[T] {
+	result := Unique(it)
+	result.Hash = hasher
+	return result
+}
+func UniqueByWithHasher[T any, K comparable](it core.Iter[T], key func(T) K, hasher func(K) uint64) *core.UniqueBy[T, K] {
+	result := UniqueBy(it, key)
+	result.Hash = hasher
+	return result
+}
+func Duplicates[T comparable](it core.Iter[T]) *core.Duplicates[T] {
+	return &core.Duplicates[T]{DuplicatesBy: core.DuplicatesBy[T, T]{It: it, Key: func(value T) T { return value }}}
+}
+func DuplicatesBy[T any, K comparable](it core.Iter[T], key func(T) K) *core.DuplicatesBy[T, K] {
+	return &core.DuplicatesBy[T, K]{It: it, Key: key}
+}
+func DuplicatesWithHasher[T comparable](it core.Iter[T], hasher func(T) uint64) *core.Duplicates[T] {
+	result := Duplicates(it)
+	result.Hash = hasher
+	return result
+}
+func DuplicatesByWithHasher[T any, K comparable](it core.Iter[T], key func(T) K, hasher func(K) uint64) *core.DuplicatesBy[T, K] {
+	result := DuplicatesBy(it, key)
+	result.Hash = hasher
+	return result
+}
+func AllUnique[T comparable](it core.Iter[T]) bool {
+	seen := make(map[T]bool)
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return true
+		}
+		if seen[value] {
+			return false
+		}
+		seen[value] = true
+	}
+}
+func AllUniqueWithHasher[T comparable](it core.Iter[T], hasher func(T) uint64) bool {
+	seen := core.HashTable[T, bool]{Hash: hasher}
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return true
+		}
+		if _, exists := seen.Get(value); exists {
+			return false
+		}
+		seen.Set(value, true)
+	}
+}
+func Counts[T any, K comparable](it core.Iter[T], key func(T) K) map[K]int {
+	counts := make(map[K]int)
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return counts
+		}
+		counts[key(value)]++
+	}
+}
+func CountsBy[T any, K comparable](it core.Iter[T], key func(T) K) map[K]int { return Counts(it, key) }
+func CountsWithHasher[T comparable](it core.Iter[T], hasher func(T) uint64) map[T]int {
+	return CountsByWithHasher(it, func(value T) T { return value }, hasher)
+}
+func CountsByWithHasher[T any, K comparable](it core.Iter[T], key func(T) K, hasher func(K) uint64) map[K]int {
+	counts := core.HashTable[K, int]{Hash: hasher}
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return counts.IntoMap()
+		}
+		mapped := key(value)
+		count, _ := counts.Get(mapped)
+		counts.Set(mapped, count+1)
+	}
+}
+func IntoGroupMap[K comparable, V any](it core.Iter[core.Pair[K, V]]) map[K][]V {
+	return IntoGroupingMap(it).Collect()
+}
+func IntoGroupMapBy[T any, K comparable](it core.Iter[T], key func(T) K) map[K][]T {
+	return IntoGroupingMapBy(it, key).Collect()
+}
+func IntoGroupMapWithHasher[K comparable, V any](it core.Iter[core.Pair[K, V]], hasher func(K) uint64) map[K][]V {
+	return IntoGroupingMapWithHasher(it, hasher).Collect()
+}
+func IntoGroupMapByWithHasher[T any, K comparable](it core.Iter[T], key func(T) K, hasher func(K) uint64) map[K][]T {
+	return IntoGroupingMapByWithHasher(it, key, hasher).Collect()
+}
+func IntoGroupingMap[K comparable, V any](it core.Iter[core.Pair[K, V]]) *core.GroupingMap[K, V] {
+	return &core.GroupingMap[K, V]{It: it}
+}
+func IntoGroupingMapBy[T any, K comparable](it core.Iter[T], key func(T) K) *core.GroupingMap[K, T] {
+	return IntoGroupingMap(Map(it, func(value T) core.Pair[K, T] { return core.Pair[K, T]{First: key(value), Second: value} }))
+}
+func IntoGroupingMapWithHasher[K comparable, V any](it core.Iter[core.Pair[K, V]], hasher func(K) uint64) *core.GroupingMap[K, V] {
+	result := IntoGroupingMap(it)
+	result.Hash = hasher
+	return result
+}
+func IntoGroupingMapByWithHasher[T any, K comparable](it core.Iter[T], key func(T) K, hasher func(K) uint64) *core.GroupingMap[K, T] {
+	result := IntoGroupingMapBy(it, key)
+	result.Hash = hasher
+	return result
+}
+func GroupingMapMin[K comparable, V cmp.Ordered](g *core.GroupingMap[K, V]) map[K]V {
+	return g.MinBy(func(key K, a, b V) int { return cmp.Compare(a, b) })
+}
+func GroupingMapMax[K comparable, V cmp.Ordered](g *core.GroupingMap[K, V]) map[K]V {
+	return g.MaxBy(func(key K, a, b V) int { return cmp.Compare(a, b) })
+}
+func GroupingMapMinmax[K comparable, V cmp.Ordered](g *core.GroupingMap[K, V]) map[K]core.MinMaxResult[V] {
+	return g.MinmaxBy(func(key K, a, b V) int { return cmp.Compare(a, b) })
+}
+func GroupingMapSum[K comparable, V Number](g *core.GroupingMap[K, V]) map[K]V {
+	return g.Reduce(func(a V, key K, b V) V { return a + b })
+}
+func GroupingMapProduct[K comparable, V Number](g *core.GroupingMap[K, V]) map[K]V {
+	return g.Reduce(func(a V, key K, b V) V { return a * b })
+}
diff --git a/hash_std_test.go b/hash_std_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4203657b78951d4eca0975aafa5b039d59b8c10e
--- /dev/null
+++ b/hash_std_test.go
@@ -0,0 +1,74 @@
+//go:build !nostd && !noalloc
+
+package itertools_test
+
+import (
+	"fmt"
+	"itertools"
+	"itertools/core"
+	"math/rand"
+	"slices"
+	"testing"
+)
+
+func TestHashLaziness(t *testing.T) {
+	it := panicking{}
+	_ = itertools.Unique(it)
+	_ = itertools.UniqueBy(it, func(int) int { panic("key") })
+	_ = itertools.Duplicates(it)
+	_ = itertools.DuplicatesBy(it, func(int) int { panic("key") })
+	_ = itertools.IntoGroupingMapBy(it, func(int) int { panic("key") })
+}
+func TestHashOperations(t *testing.T) {
+	expectIter(t, itertools.Unique(source(1, 2, 1, 3, 2, 4, 1)), []int{1, 2, 3, 4}, false)
+	expectIter(t, itertools.Duplicates(source(1, 2, 1, 3, 2, 2, 4, 1, 3)), []int{1, 2, 3}, false)
+	expectIter(t, itertools.UniqueBy(source("a", "bb", "c", "ddd", "ee"), func(value string) int { return len(value) }), []string{"a", "bb", "ddd"}, false)
+	expectIter(t, itertools.DuplicatesBy(source("a", "bb", "c", "ddd", "ee"), func(value string) int { return len(value) }), []string{"c", "ee"}, false)
+	unique := itertools.Unique(source(1, 2, 1, 3, 2))
+	value, _ := unique.NextBack()
+	same(t, value, 2)
+	value, _ = unique.Next()
+	same(t, value, 1)
+	expectIter(t, unique, []int{3}, false)
+	if !itertools.AllUnique(source(1, 2, 3)) || itertools.AllUnique(source(1, 2, 1)) {
+		t.Fatal("all unique")
+	}
+	same(t, itertools.Counts(source("a", "bb", "c", "ddd", "ee"), func(value string) int { return len(value) }), map[int]int{1: 2, 2: 2, 3: 1})
+	pairs := []core.Pair[string, int]{{First: "a", Second: 1}, {First: "b", Second: 2}, {First: "a", Second: 3}}
+	same(t, itertools.IntoGroupMap(core.FromSlice(pairs)), map[string][]int{"a": {1, 3}, "b": {2}})
+	same(t, itertools.IntoGroupingMap(core.FromSlice(pairs)).Reduce(func(acc int, key string, value int) int { return acc + value }), map[string]int{"a": 4, "b": 2})
+	same(t, itertools.IntoGroupingMap(core.FromSlice(pairs)).Fold(10, func(acc int, key string, value int) int { return acc + value }), map[string]int{"a": 14, "b": 12})
+	same(t, core.GroupingMapFold(itertools.IntoGroupingMap(core.FromSlice(pairs)), "", func(acc, key string, value int) string { return acc + fmt.Sprint(value) }), map[string]string{"a": "13", "b": "2"})
+	same(t, itertools.GroupingMapMin(itertools.IntoGroupingMap(core.FromSlice(pairs))), map[string]int{"a": 1, "b": 2})
+	same(t, itertools.GroupingMapMax(itertools.IntoGroupingMap(core.FromSlice(pairs))), map[string]int{"a": 3, "b": 2})
+	same(t, itertools.GroupingMapSum(itertools.IntoGroupingMap(core.FromSlice(pairs))), map[string]int{"a": 4, "b": 2})
+	same(t, itertools.GroupingMapProduct(itertools.IntoGroupingMap(core.FromSlice(pairs))), map[string]int{"a": 3, "b": 2})
+	same(t, itertools.GroupingMapMinmax(itertools.IntoGroupingMap(core.FromSlice(pairs))), map[string]core.MinMaxResult[int]{"a": {Kind: core.MinMaxPair, Min: 1, Max: 3}, "b": {Kind: core.MinMaxOneElement, Min: 2, Max: 2}})
+}
+func TestHashProperties(t *testing.T) {
+	random := rand.New(rand.NewSource(151))
+	for iteration := 0; iteration < 200; iteration++ {
+		values := make([]int, random.Intn(60))
+		for index := range values {
+			values[index] = random.Intn(10)
+		}
+		unique, duplicates := make([]int, 0), make([]int, 0)
+		frequencies := make(map[int]int)
+		for _, value := range values {
+			frequencies[value]++
+			if frequencies[value] == 1 {
+				unique = append(unique, value)
+			}
+			if frequencies[value] == 2 {
+				duplicates = append(duplicates, value)
+			}
+		}
+		expectIter(t, itertools.Unique(core.FromSlice(values)), unique, false)
+		expectIter(t, itertools.Duplicates(core.FromSlice(values)), duplicates, false)
+		same(t, itertools.Counts(core.FromSlice(values), func(value int) int { return value }), frequencies)
+		got := collect(itertools.Duplicates(core.FromSlice(values)))
+		slices.Sort(got)
+		slices.Sort(duplicates)
+		same(t, got, duplicates)
+	}
+}
diff --git a/itertools.go b/itertools.go
new file mode 100644
index 0000000000000000000000000000000000000000..565dab15c7bd7924720ec2d1ad1a8e2fe9dd5cb0
--- /dev/null
+++ b/itertools.go
@@ -0,0 +1,168 @@
+package itertools
+
+import (
+	"cmp"
+	"fmt"
+	"itertools/core"
+)
+
+type Number interface {
+	~int | ~int8 | ~int16 | ~int32 | ~int64 | ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64 | ~float32 | ~float64
+}
+
+func Map[T, U any](it core.Iter[T], fn func(T) U) *core.Map[T, U] { return core.NewMap(it, fn) }
+func MapInto[T, U any](it core.Iter[T], convert func(T) U) *core.MapInto[T, U] {
+	return &core.MapInto[T, U]{Map: *Map(it, convert)}
+}
+func Filter[T any](it core.Iter[T], pred func(T) bool) *core.Filter[T] {
+	return &core.Filter[T]{It: it, Pred: pred}
+}
