+}
+
+func ExactLen[T any](it Iter[T]) int {
+	sh := it.SizeHint()
+	if !sh.IsExact() {
+		panic("iterator is not exact-sized")
+	}
+	return sh.Lower
+}
+func (failure *ExactlyOneError[T]) Len() int               { return ExactLen[T](failure) }
+func (iterator *WithPosition[T]) Len() int                 { return ExactLen[Pair[Position, T]](iterator) }
+func (iterator *PadUsing[T]) Len() int                     { return ExactLen[T](iterator) }
+func (iterator *Enumerate[T]) Len() int                    { return ExactLen[Pair[int, T]](iterator) }
+func (iterator *Rev[T]) Len() int                          { return ExactLen[T](iterator) }
+func (iterator *Zip[A, B]) Len() int                       { return ExactLen[Pair[A, B]](iterator) }
+func (iterator *ZipEq[A, B]) Len() int                     { return ExactLen[Pair[A, B]](iterator) }
+func (iterator *ZipLongest[A, B]) Len() int                { return ExactLen[EitherOrBoth[A, B]](iterator) }
+func (iterator *Tuples[T]) Len() int                       { return ExactLen[[]T](iterator) }
+func (iterator *ArrayWindows[T]) Len() int                 { return ExactLen[[]T](iterator) }
+func (iterator *CircularArrayWindows[T]) Len() int         { return ExactLen[[]T](iterator) }
+func (iterator *PutBack[T]) WithValue(value T) *PutBack[T] { iterator.PutBack(value); return iterator }
+func (result MinMaxResult[T]) IntoOption() (Pair[T, T], bool) {
+	if result.Kind == MinMaxNoElements {
+		return Pair[T, T]{}, false
+	}
+	if result.Kind == MinMaxOneElement {
+		return Pair[T, T]{result.Min, result.Min}, true
+	}
+	return Pair[T, T]{result.Min, result.Max}, true
+}
