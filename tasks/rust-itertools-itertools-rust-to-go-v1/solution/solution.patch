+package itertools_test
+
+import (
+	"fmt"
+	"itertools"
+	"itertools/core"
+	"strings"
+	"testing"
+)
+
+func TestFormattingVerbs(t *testing.T) {
+	same(t, fmt.Sprintf("%.2f", itertools.Format(source(1.25, 2.0), ", ")), "1.25, 2.00")
+	same(t, fmt.Sprintf("%04x", itertools.Format(source(10, 20), ":")), "000a:0014")
+	formatted := itertools.Format(source(1, 2), ",")
+	same(t, fmt.Sprintf("%v", formatted), "1,2")
+	if !strings.Contains(fmt.Sprintf("%v", formatted), "PANIC") {
+		t.Fatal("fmt must report reuse failure")
+	}
+	same(t, fmt.Sprintf("%v", core.NewFormat(source(1, 2), ",", func(value int) string { return "custom" })), "custom,custom")
+	with := itertools.FormatWith(source(1, 2), ",", func(value int, write func(any) string) string { return write(value * 2) })
+	same(t, fmt.Sprintf("%v", with), "2,4")
+	if !strings.Contains(fmt.Sprintf("%v", with), "PANIC") {
+		t.Fatal("FormatWith reuse must fail")
+	}
+}
