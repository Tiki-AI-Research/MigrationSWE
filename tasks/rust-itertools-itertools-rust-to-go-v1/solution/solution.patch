@@ -0,0 +1,157 @@
+package core
+
+import "fmt"
+
+type SizeHintError struct{ Hint SizeHint }
+
+func (failure SizeHintError) Error() string {
+	return fmt.Sprintf("iterator length is not exact: %v", failure.Hint)
+}
+
+type FoldWhile[T any] struct {
+	Value T
+	Done  bool
+}
+
+func Continue[T any](value T) FoldWhile[T] { return FoldWhile[T]{Value: value} }
+func Done[T any](value T) FoldWhile[T]     { return FoldWhile[T]{Value: value, Done: true} }
+func (outcome FoldWhile[T]) IntoInner() T  { return outcome.Value }
+func (outcome FoldWhile[T]) IsDone() bool  { return outcome.Done }
+
+type DiffKind int
+
+const (
+	DiffFirstMismatch DiffKind = iota
+	DiffShorter
+	DiffLonger
+)
+
+type Diff[A, B any] struct {
+	Kind  DiffKind
+	Index int
+	Left  Iter[A]
+	Right Iter[B]
+}
+type ProcessResults[T any] struct {
+	It  Iter[Pair[T, error]]
+	Err error
+}
+
+func (iterator *ProcessResults[T]) Next() (T, bool) {
+	value, ok := iterator.It.Next()
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	if value.Second != nil {
+		iterator.Err = value.Second
+		var zero T
+		return zero, false
+	}
+	return value.First, true
+}
+func (iterator *ProcessResults[T]) NextBack() (T, bool) {
+	value, ok := Back(iterator.It)
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	if value.Second != nil {
+		iterator.Err = value.Second
+		var zero T
+		return zero, false
+	}
+	return value.First, true
+}
+func (iterator *ProcessResults[T]) SizeHint() SizeHint { return Hint(0, iterator.It.SizeHint().Upper) }
+
+type FlattenOK[T any] struct {
+	It      Iter[Pair[Iter[T], error]]
+	current Iter[T]
+	back    Iter[T]
+}
+
+func (iterator *FlattenOK[T]) Next() (Pair[T, error], bool) {
+	for {
+		if iterator.current != nil {
+			value, ok := iterator.current.Next()
+			if ok {
+				return Pair[T, error]{First: value}, true
+			}
+			iterator.current = nil
+		}
+		value, ok := iterator.It.Next()
+		if !ok {
+			if iterator.back == nil {
+				return Pair[T, error]{}, false
+			}
+			value, ok := iterator.back.Next()
+			if ok {
+				return Pair[T, error]{First: value}, true
+			}
+			iterator.back = nil
+			continue
+		}
+		if value.Second != nil {
+			return Pair[T, error]{Second: value.Second}, true
+		}
+		iterator.current = value.First
+	}
+}
+func (iterator *FlattenOK[T]) NextBack() (Pair[T, error], bool) {
+	for {
+		if iterator.back != nil {
+			value, ok := Back(iterator.back)
+			if ok {
+				return Pair[T, error]{First: value}, true
+			}
+			iterator.back = nil
+		}
+		value, ok := Back(iterator.It)
+		if !ok {
+			if iterator.current == nil {
+				return Pair[T, error]{}, false
+			}
+			value, ok := Back(iterator.current)
+			if ok {
+				return Pair[T, error]{First: value}, true
+			}
+			iterator.current = nil
+			continue
+		}
+		if value.Second != nil {
+			return Pair[T, error]{Second: value.Second}, true
+		}
+		iterator.back = value.First
+	}
+}
+func (iterator *FlattenOK[T]) SizeHint() SizeHint {
+	sh := Hint(0, 0)
+	if iterator.current != nil {
+		sh = Add(sh, iterator.current.SizeHint())
+	}
+	if iterator.back != nil {
+		sh = Add(sh, iterator.back.SizeHint())
+	}
+	if iterator.It.SizeHint().Upper != 0 {
+		sh = Add(sh, Hint(0, -1))
+	}
+	return sh
+}
+
+type Take[T any] struct {
+	It        Iter[T]
+	Remaining int
+}
+
+func (iterator *Take[T]) Next() (T, bool) {
+	if iterator.Remaining == 0 {
+		var zero T
+		return zero, false
+	}
+	iterator.Remaining--
+	return iterator.It.Next()
+}
+func (iterator *Take[T]) SizeHint() SizeHint {
+	return Min(iterator.It.SizeHint(), Hint(iterator.Remaining, iterator.Remaining))
+}
