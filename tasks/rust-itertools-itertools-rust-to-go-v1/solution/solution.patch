+//go:build !noalloc
+
+package free_test
+
+import (
+	"itertools/core"
+	"itertools/free"
+	"testing"
+)
+
+func TestAllocatedFreeFunctions(t *testing.T) {
+	same(t, free.Join(source(1, 2, 3), ", "), "1, 2, 3")
+	same(t, free.Sorted(source(3, 1, 2)), []int{1, 2, 3})
+	same(t, free.SortedUnstable(source(3, 1, 2)), []int{1, 2, 3})
+	same(t, collect(free.KMergeBy([]core.Iter[int]{source(1, 3), source(2, 4)}, func(a, b int) bool { return a < b })), []int{1, 2, 3, 4})
+	left, right := free.Multiunzip(source(core.Pair[int, string]{First: 1, Second: "a"}, core.Pair[int, string]{First: 2, Second: "b"}))
+	same(t, left, []int{1, 2})
+	same(t, right, []string{"a", "b"})
+	peek := free.PeekNth(source(1, 2, 3))
+	value, ok := peek.PeekNth(2)
+	if !ok || value != 3 {
+		t.Fatal(value, ok)
+	}
+	same(t, collect(peek), []int{1, 2, 3})
+	put := free.PutBackN(source(3))
+	put.PutBack(2)
+	put.PutBack(1)
+	same(t, collect(put), []int{1, 2, 3})
+}
