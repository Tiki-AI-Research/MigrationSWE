+package itertools_test
+
+import (
+	"cmp"
+	"errors"
+	"fmt"
+	"itertools"
+	"itertools/core"
+	"math/rand"
+	"reflect"
+	"slices"
+	"testing"
+)
+
+func source[T any](values ...T) *core.Slice[T] { return core.FromSlice(values) }
+func collect[T any](it core.Iter[T]) []T {
+	values := make([]T, 0)
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return values
+		}
+		values = append(values, value)
+	}
+}
+func same[T any](t *testing.T, got, want T) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %#v, want %#v", got, want)
+	}
+}
+func panics(t *testing.T, fn func()) {
+	t.Helper()
+	defer func() {
+		if recover() == nil {
+			t.Error("expected panic")
+		}
+	}()
+	fn()
+}
+func expectIter[T any](t *testing.T, it core.Iter[T], want []T, exact bool) {
+	t.Helper()
+	for index := 0; index <= len(want); index++ {
+		sh := it.SizeHint()
+		remaining := len(want) - index
+		if sh.Lower > remaining || sh.Upper >= 0 && sh.Upper < remaining {
+			t.Fatalf("hint %v excludes remaining %d at %d", sh, remaining, index)
+		}
+		if exact && sh != core.Hint(remaining, remaining) {
+			t.Fatalf("inexact hint %v, remaining %d", sh, remaining)
+		}
+		value, ok := it.Next()
+		if index == len(want) {
+			if ok {
+				t.Fatalf("extra value %#v", value)
+			}
+			break
+		}
+		if !ok {
+			t.Fatalf("ended at %d, want %d items", index, len(want))
+		}
+		same(t, value, want[index])
+	}
+}
+func eq(a, b int) bool { return a == b }
+
+func TestInterleaveAndConcat(t *testing.T) {
+	expectIter(t, itertools.Interleave(source(1, 2), source(-1, -2)), []int{1, -1, 2, -2}, true)
+	expectIter(t, itertools.Interleave(source(1, 2, 3), source(-1)), []int{1, -1, 2, 3}, true)
+	expectIter(t, itertools.InterleaveShortest(source(1, 2, 3), source(-1, -2)), []int{1, -1, 2, -2, 3}, true)
+	expectIter(t, itertools.InterleaveShortest(source(1), source(-1, -2, -3)), []int{1, -1}, true)
+	expectIter(t, itertools.InterleaveShortest(source[int](), source(-1)), []int{}, true)
+	same(t, itertools.Concat(source([]int{1}, []int{2, 3}, []int{4, 5, 6})), []int{1, 2, 3, 4, 5, 6})
+	if itertools.Concat(core.EmptyIter[[]int]()) != nil {
+		t.Fatal("concat must return default nil slice")
+	}
+	if itertools.Concat(source([]int{})) == nil {
+		t.Fatal("concat must preserve first empty slice")
+	}
+}
+
+func TestWindows(t *testing.T) {
+	for length := 0; length < 12; length++ {
+		values := make([]int, length)
+		for index := range values {
+			values[index] = index
+		}
+		for width := 0; width < 15; width++ {
+			want := make([][]int, 0)
+			for index := 0; index+width <= length; index++ {
+				window := make([]int, width)
+				copy(window, values[index:index+width])
+				want = append(want, window)
+			}
+			expectIter(t, itertools.ArrayWindows(core.FromSlice(values), width), want, true)
+			circular := make([][]int, 0)
+			for index := 0; index < length; index++ {
+				window := make([]int, width)
+				for offset := range window {
+					window[offset] = values[(index+offset)%length]
+				}
+				circular = append(circular, window)
+			}
+			expectIter(t, itertools.CircularArrayWindows(core.FromSlice(values), width), circular, true)
+		}
+	}
+	panics(t, func() { itertools.ArrayWindows(source(1), -1) })
+	windows := itertools.ArrayWindows(source(1, 2, 3), 2)
+	first, _ := windows.Next()
+	first[1] = 99
+	next, _ := windows.Next()
+	same(t, next, []int{2, 3})
+}
+
+func TestErrorsAndShortCircuit(t *testing.T) {
+	_, err := itertools.AllEqualValue(source[int](), eq)
+	if err == nil || err.Error() != "got zero elements when all elements were expected to be equal" {
+		t.Fatal(err)
+	}
+	_, err = itertools.AllEqualValue(source(1, 2, 3), eq)
+	var unequal *core.AllEqualValueError[int]
+	if !errors.As(err, &unequal) || unequal.First != 1 || unequal.Second != 2 || err.Error() != "got different elements when all elements were expected to be equal" {
+		t.Fatal(err)
+	}
+	value, err := itertools.AllEqualValue(source(4, 4, 4), eq)
+	if err != nil || value != 4 {
+		t.Fatal(value, err)
+	}
+	for _, values := range [][]int{{}, {1}, {1, 2}, {1, 2, 3, 4}} {
+		value, err := itertools.ExactlyOne(core.FromSlice(values))
+		if len(values) == 1 {
+			if err != nil || value != 1 {
+				t.Fatal(value, err)
+			}
+			continue
+		}
+		if err == nil {
+			t.Fatal("missing exactly-one error")
+		}
+		text := "got zero elements when exactly one was expected"
+		if len(values) > 1 {
+			text = "got at least 2 elements when exactly one was expected"
+		}
+		if err.Error() != text {
+			t.Fatal(err.Error())
+		}
+		expectIter(t, err, values, true)
+	}
+	it := source(1, 2, 3)
+	if itertools.All(it, func(value int) bool { return value < 2 }) {
+		t.Fatal("all")
+	}
+	value, _ = it.Next()
+	if value != 3 {
+		t.Fatal("all consumed past first false")
+	}
+	it = source(1, 2, 3)
+	if !itertools.Any(it, func(value int) bool { return value == 2 }) {
+		t.Fatal("any")
+	}
+	value, _ = it.Next()
+	if value != 3 {
+		t.Fatal("any consumed past first true")
+	}
+	option, oneErr := itertools.AtMostOne(source(5))
+	if oneErr != nil || !option.Some || option.Value != 5 {
+		t.Fatal(option, oneErr)
+	}
+	option, oneErr = itertools.AtMostOne(source[int]())
+	if oneErr != nil || option.Some {
+		t.Fatal(option, oneErr)
+	}
+	_, oneErr = itertools.AtMostOne(source(5, 6, 7))
+	expectIter(t, oneErr, []int{5, 6, 7}, true)
+}
+
+func TestFormatting(t *testing.T) {
+	calls := 0
+	mapped := itertools.Map(source(1, 2, 3), func(value int) int { calls++; return value })
+	formatted := itertools.Format(mapped, " / ")
+	if calls != 0 {
+		t.Fatal("eager format")
+	}
+	same(t, formatted.String(), "1 / 2 / 3")
+	same(t, calls, 3)
+	panics(t, func() { _ = formatted.String() })
+	with := itertools.FormatWith(source(1, 2), ",", func(value int, write func(any) string) string { return write("[") + write(value) + write("]") })
+	same(t, with.String(), "[1],[2]")
+	panics(t, func() { _ = with.String() })
+	partial := core.NewFormat(source(1, 2), ",", func(value int) string { panic(value) })
+	panics(t, func() { _ = partial.String() })
+	panics(t, func() { _ = partial.String() })
+	same(t, itertools.Format(source[int](), ",").String(), "")
+}
