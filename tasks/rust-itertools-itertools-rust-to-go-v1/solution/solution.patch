@@ -0,0 +1,58 @@
+package itertools
+
+import "itertools/core"
+
+type MultiZip[T any] struct{ iters []core.Iter[T] }
+
+func Izip[T any](iters ...core.Iter[T]) *MultiZip[T]     { return &MultiZip[T]{iters: iters} }
+func Multizip[T any](iters ...core.Iter[T]) *MultiZip[T] { return Izip(iters...) }
+func (iterator *MultiZip[T]) Next() ([]T, bool) {
+	if len(iterator.iters) == 0 {
+		return nil, false
+	}
+	values := make([]T, len(iterator.iters))
+	for index, it := range iterator.iters {
+		value, ok := it.Next()
+		if !ok {
+			return nil, false
+		}
+		values[index] = value
+	}
+	return values, true
+}
+func (iterator *MultiZip[T]) SizeHint() core.SizeHint {
+	if len(iterator.iters) == 0 {
+		return core.Hint(0, 0)
+	}
+	sh := iterator.iters[0].SizeHint()
+	for _, it := range iterator.iters[1:] {
+		sh = core.Min(sh, it.SizeHint())
+	}
+	return sh
+}
+func (iterator *MultiZip[T]) Len() int { return core.ExactLen[[]T](iterator) }
+func (iterator *MultiZip[T]) NextBack() ([]T, bool) {
+	if len(iterator.iters) == 0 {
+		return nil, false
+	}
+	length := core.MaxInt
+	for _, it := range iterator.iters {
+		sh := it.SizeHint()
+		if !sh.IsExact() {
+			panic("multizip back requires exact sizes")
+		}
+		length = min(length, sh.Lower)
+	}
+	values := make([]T, len(iterator.iters))
+	for index, it := range iterator.iters {
+		for count := it.SizeHint().Lower; count > length; count-- {
+			core.Back(it)
+		}
+		value, ok := core.Back(it)
+		if !ok {
+			return nil, false
+		}
+		values[index] = value
+	}
+	return values, true
+}
