@@ -0,0 +1,96 @@
+package itertools_test
+
+import (
+	"go/ast"
+	"go/build"
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+func TestBuildTagSurface(t *testing.T) {
+	_, filename, _, _ := runtime.Caller(0)
+	directory := filepath.Dir(filename)
+	for _, tag := range []string{"", "nostd", "noalloc", "nostd,noalloc"} {
+		t.Run(tag, func(t *testing.T) {
+			context := build.Default
+			switch tag {
+			case "nostd":
+				context.BuildTags = []string{"nostd"}
+			case "noalloc":
+				context.BuildTags = []string{"noalloc"}
+			case "nostd,noalloc":
+				context.BuildTags = []string{"nostd", "noalloc"}
+			}
+			for _, pkg := range []string{".", "core", "free"} {
+				info, err := context.ImportDir(filepath.Join(directory, pkg), 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				names := make(map[string]bool)
+				for _, name := range info.GoFiles {
+					file, err := parser.ParseFile(token.NewFileSet(), filepath.Join(info.Dir, name), nil, 0)
+					if err != nil {
+						t.Fatal(err)
+					}
+					for _, decl := range file.Decls {
+						switch value := decl.(type) {
+						case *ast.FuncDecl:
+							if value.Recv == nil {
+								names[value.Name.Name] = true
+							}
+						case *ast.GenDecl:
+							for _, spec := range value.Specs {
+								if typ, ok := spec.(*ast.TypeSpec); ok {
+									names[typ.Name.Name] = true
+								}
+							}
+						}
+					}
+				}
+				if pkg == "." {
+					for _, name := range []string{"Map", "Merge", "Interleave", "ArrayWindows", "ExactlyOne", "Izip", "Concat"} {
+						if !names[name] {
+							t.Fatalf("%s absent under %s", name, tag)
+						}
+					}
+					for _, name := range []string{"Unique", "Duplicates", "Counts", "IntoGroupingMap"} {
+						want := tag == ""
+						if names[name] != want {
+							t.Fatalf("%s availability under %s: %v, want %v", name, tag, names[name], want)
+						}
+					}
+					for _, name := range []string{"Iproduct", "Combinations", "Permutations", "Powerset", "Sorted"} {
+						want := tag == "" || tag == "nostd"
+						if names[name] != want {
+							t.Fatalf("%s availability under %s: %v, want %v", name, tag, names[name], want)
+						}
+					}
+				}
+				if pkg == "core" {
+					for _, name := range []string{"Iter", "SizeHint", "Map", "ExactlyOneError"} {
+						if !names[name] {
+							t.Fatalf("core.%s absent", name)
+						}
+					}
+					if names["Unique"] != (tag == "") {
+						t.Fatal("core hashing availability")
+					}
+					if names["MultiProduct"] != (tag == "" || tag == "nostd") {
+						t.Fatal("core allocation availability")
+					}
+				}
+				if pkg == "free" {
+					if !names["Iterate"] || !names["ProcessResults"] || !names["Multizip"] {
+						t.Fatal("free surface missing")
+					}
+					if names["Sorted"] != (tag == "" || tag == "nostd") {
+						t.Fatal("free allocation availability")
+					}
+				}
+			}
+		})
+	}
+}
diff --git a/collection.go b/collection.go
new file mode 100644
index 0000000000000000000000000000000000000000..c27e7abea1d960313462fb7b8aaa42a4d395dddb
--- /dev/null
+++ b/collection.go
@@ -0,0 +1,42 @@
+package itertools
+
+import "itertools/core"
+
+func TryCollect[T any](it core.Iter[core.Pair[T, error]]) ([]T, error) {
+	return ProcessResults(it, func(values core.Iter[T]) []T {
+        out := []T{}
+        for v,ok := values.Next(); ok; v,ok = values.Next() { out = append(out,v) }
+        return out
+    })
+}
+
+func PartitionMap[T, A, B any](it core.Iter[T], fn func(T) core.EitherOrBoth[A, B]) ([]A, []B) {
+	left, right := make([]A, 0), make([]B, 0)
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return left, right
+		}
+		mapped := fn(value)
+		if a, ok := mapped.Left(); ok {
+			left = append(left, a)
+		}
+		if b, ok := mapped.Right(); ok {
+			right = append(right, b)
+		}
+	}
+}
+
+func PartitionResult[T any](it core.Iter[core.Pair[T, error]]) ([]T, []error) {
+	return PartitionMap(it, func(value core.Pair[T, error]) core.EitherOrBoth[T, error] {
+		if value.Second != nil {
+			return core.Right[T, error](value.Second)
+		}
+		return core.Left[T, error](value.First)
+	})
+}
+
+func Multiunzip[A, B any](it core.Iter[core.Pair[A, B]]) ([]A, []B) {
+	return PartitionMap(it, func(value core.Pair[A, B]) core.EitherOrBoth[A, B] { return core.Both(value.First, value.Second) })
+}
+
