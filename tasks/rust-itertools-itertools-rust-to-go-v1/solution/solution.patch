+//go:build !noalloc
+
+package itertools_test
+
+import (
+	"itertools"
+	"itertools/core"
+	"testing"
+)
+
+func TestOuterGroupHintExcludesCurrentGroup(t *testing.T) {
+	groups := itertools.ChunkBy(source(1, 1, 1), func(value int) int { return value })
+	first, ok := groups.Next()
+	if !ok {
+		t.Fatal("missing first group")
+	}
+	if hint := groups.SizeHint(); hint.Lower != 0 {
+		t.Fatal("current group is not an additional group", hint)
+	}
+	if _, ok := groups.Next(); ok {
+		t.Fatal("extra group")
+	}
+	same(t, collect(first.Second), []int{1, 1, 1})
+}
+
+func TestSelectionTiesAndProductSlices(t *testing.T) {
+	values := []core.Pair[int, string]{{First: 1, Second: "first"}, {First: 1, Second: "second"}}
+	result := itertools.KSmallestBy(core.FromSlice(values), 1, func(left, right core.Pair[int, string]) int { return left.First - right.First })
+	same(t, result, values[:1])
+	expectIter(t, itertools.MultiCartesianProduct([]core.Iter[int]{source(1, 2), source(3, 4)}), [][]int{{1, 3}, {1, 4}, {2, 3}, {2, 4}}, true)
+}
