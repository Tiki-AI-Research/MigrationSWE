+package itertools
+
+import (
+	"cmp"
+	"itertools/core"
+)
+
+func Iterate[T any](seed T, next func(T) T) *core.Iterate[T] { return core.NewIterate(seed, next) }
+func RepeatN[T any](n int, value T) *core.RepeatN[T]         { return core.NewRepeatN(n, value) }
+func Unfold[S, T any](state S, next func(*S) (T, bool)) *core.Unfold[S, T] {
+	return core.NewUnfold(state, next)
+}
+func Cloned[T any](it core.Iter[*T]) *core.Map[*T, T] {
+	return Map(it, func(value *T) T { return *value })
+}
+func Max[T cmp.Ordered](it core.Iter[T]) (T, bool) {
+	result, ok := PositionMaxBy(it, cmp.Compare[T])
+	return result.Second, ok
+}
+func Min[T cmp.Ordered](it core.Iter[T]) (T, bool) {
+	result, ok := PositionMinBy(it, cmp.Compare[T])
+	return result.Second, ok
+}
+func ConsTuples[A, B, C any](it core.Iter[core.Pair[core.Pair[A, B], C]]) *core.ConsTuples[A, B, C] {
+	return &core.ConsTuples[A, B, C]{Map: *Map(it, func(value core.Pair[core.Pair[A, B], C]) core.Triple[A, B, C] {
+		return core.Triple[A, B, C]{First: value.First.First, Second: value.First.Second, Third: value.Second}
+	})}
+}
