+type PeekNth[T any] struct {
+	It     Iter[T]
+	buffer []T
+	done   bool
+}
+
+func (iterator *PeekNth[T]) PeekNth(n int) (T, bool) {
+	if n < 0 {
+		panic("negative peek index")
+	}
+	for len(iterator.buffer) <= n && !iterator.done {
+		value, ok := iterator.It.Next()
+		if !ok {
+			iterator.done = true
+			break
+		}
+		iterator.buffer = append(iterator.buffer, value)
+	}
+	if n < len(iterator.buffer) {
+		return iterator.buffer[n], true
+	}
+	var zero T
+	return zero, false
+}
+func (iterator *PeekNth[T]) PeekNthMut(n int) (*T, bool) {
+	if _, ok := iterator.PeekNth(n); !ok {
+		return nil, false
+	}
+	return &iterator.buffer[n], true
+}
+func (iterator *PeekNth[T]) Peek() (T, bool) { return iterator.PeekNth(0) }
+func (iterator *PeekNth[T]) NextIf(fn func(T) bool) (T, bool) {
+	value, ok := iterator.Peek()
+	if ok && fn(value) {
+		return iterator.Next()
+	}
+	var zero T
+	return zero, false
+}
+func (iterator *PeekNth[T]) NextIfEq(value T, eq func(T, T) bool) (T, bool) {
+	return iterator.NextIf(func(next T) bool { return eq(next, value) })
+}
+func (iterator *PeekNth[T]) Next() (T, bool) {
+	if len(iterator.buffer) > 0 {
+		value := iterator.buffer[0]
+		var zero T
+		iterator.buffer[0] = zero
+		iterator.buffer = iterator.buffer[1:]
+		return value, true
+	}
+	if iterator.done {
+		var zero T
+		return zero, false
+	}
+	value, ok := iterator.It.Next()
+	iterator.done = !ok
+	return value, ok
+}
+func (iterator *PeekNth[T]) SizeHint() SizeHint {
+	sh := Hint(0, 0)
+	if !iterator.done {
+		sh = iterator.It.SizeHint()
+	}
+	return AddScalar(sh, len(iterator.buffer))
+}
+
+type MultiPeek[T any] struct {
+	PeekNth[T]
+	index int
+}
+
+func (iterator *MultiPeek[T]) Peek() (T, bool) {
+	value, ok := iterator.PeekNth.PeekNth(iterator.index)
+	if ok {
