diff --git a/core/adaptors.go b/core/adaptors.go
new file mode 100644
index 0000000000000000000000000000000000000000..c95fc0c335db9deb344df7283a52837662053538
--- /dev/null
+++ b/core/adaptors.go
@@ -0,0 +1,707 @@
+package core
+
+type Map[T, U any] struct {
+	It Iter[T]
+	Fn func(T) U
+}
+
+func NewMap[T, U any](it Iter[T], fn func(T) U) *Map[T, U] { return &Map[T, U]{it, fn} }
+func (iterator *Map[T, U]) Next() (U, bool) {
+	value, ok := iterator.It.Next()
+	if !ok {
+		var zero U
+		return zero, false
+	}
+	return iterator.Fn(value), true
+}
+func (iterator *Map[T, U]) NextBack() (U, bool) {
+	value, ok := Back(iterator.It)
+	if !ok {
+		var zero U
+		return zero, false
+	}
+	return iterator.Fn(value), true
+}
+func (iterator *Map[T, U]) SizeHint() SizeHint { return iterator.It.SizeHint() }
+func (iterator *Map[T, U]) Len() int {
+	sh := iterator.SizeHint()
+	if !sh.IsExact() {
+		panic("iterator is not exact-sized")
+	}
+	return sh.Lower
+}
+
+type Filter[T any] struct {
+	It   Iter[T]
+	Pred func(T) bool
+}
+
+func (iterator *Filter[T]) Next() (T, bool) {
+	for {
+		value, ok := iterator.It.Next()
+		if !ok || iterator.Pred(value) {
+			return value, ok
+		}
+	}
+}
+func (iterator *Filter[T]) NextBack() (T, bool) {
+	for {
+		value, ok := Back(iterator.It)
+		if !ok || iterator.Pred(value) {
+			return value, ok
+		}
+	}
+}
+func (iterator *Filter[T]) SizeHint() SizeHint { return Hint(0, iterator.It.SizeHint().Upper) }
+
+type FilterMap[T, U any] struct {
+	It Iter[T]
+	Fn func(T) (U, bool)
+}
+
+func (iterator *FilterMap[T, U]) Next() (U, bool) {
+	for {
+		value, ok := iterator.It.Next()
+		if !ok {
+			var zero U
+			return zero, false
+		}
+		if result, found := iterator.Fn(value); found {
+			return result, true
+		}
+	}
+}
+func (iterator *FilterMap[T, U]) NextBack() (U, bool) {
+	for {
+		value, ok := Back(iterator.It)
+		if !ok {
+			var zero U
+			return zero, false
+		}
+		if result, found := iterator.Fn(value); found {
+			return result, true
+		}
+	}
+}
+func (iterator *FilterMap[T, U]) SizeHint() SizeHint { return Hint(0, iterator.It.SizeHint().Upper) }
+
+type Enumerate[T any] struct {
+	It    Iter[T]
+	Index int
+}
+
+func (iterator *Enumerate[T]) Next() (Pair[int, T], bool) {
+	value, ok := iterator.It.Next()
+	if !ok {
+		return Pair[int, T]{}, false
+	}
+	result := Pair[int, T]{iterator.Index, value}
+	iterator.Index++
+	return result, true
+}
+func (iterator *Enumerate[T]) NextBack() (Pair[int, T], bool) {
+	sh := iterator.It.SizeHint()
+	if !sh.IsExact() {
+		panic("enumerate back requires exact size")
+	}
+	value, ok := Back(iterator.It)
+	return Pair[int, T]{iterator.Index + sh.Lower - 1, value}, ok
+}
+func (iterator *Enumerate[T]) SizeHint() SizeHint { return iterator.It.SizeHint() }
+
+type Rev[T any] struct{ It DoubleEnded[T] }
+
+func (iterator *Rev[T]) Next() (T, bool)     { return iterator.It.NextBack() }
+func (iterator *Rev[T]) NextBack() (T, bool) { return iterator.It.Next() }
+func (iterator *Rev[T]) SizeHint() SizeHint  { return iterator.It.SizeHint() }
+
+type ChainMany[T any] struct {
+	Iters       []Iter[T]
+	front, back int
+}
+
+func NewChainMany[T any](iters ...Iter[T]) *ChainMany[T] {
+	return &ChainMany[T]{Iters: iters, back: len(iters)}
+}
+func (iterator *ChainMany[T]) Next() (T, bool) {
+	for iterator.front < iterator.back {
+		if value, ok := iterator.Iters[iterator.front].Next(); ok {
+			return value, true
+		}
+		if iterator.front+1 == iterator.back {
+			var zero T
+			return zero, false
+		}
+		iterator.front++
+	}
+	var zero T
+	return zero, false
+}
+func (iterator *ChainMany[T]) NextBack() (T, bool) {
+	for iterator.front < iterator.back {
+		if value, ok := Back(iterator.Iters[iterator.back-1]); ok {
+			return value, true
+		}
+		if iterator.front+1 == iterator.back {
+			var zero T
+			return zero, false
+		}
+		iterator.back--
+	}
+	var zero T
+	return zero, false
+}
+func (iterator *ChainMany[T]) SizeHint() SizeHint {
+	sh := Hint(0, 0)
+	for _, it := range iterator.Iters[iterator.front:iterator.back] {
+		sh = Add(sh, it.SizeHint())
+	}
+	return sh
+}
+
+type Zip[A, B any] struct {
+	A Iter[A]
+	B Iter[B]
+}
+
+func (iterator *Zip[A, B]) Next() (Pair[A, B], bool) {
+	a, ok := iterator.A.Next()
+	if !ok {
+		return Pair[A, B]{}, false
+	}
+	b, ok := iterator.B.Next()
+	if !ok {
+		return Pair[A, B]{}, false
+	}
+	return Pair[A, B]{a, b}, true
+}
+func (iterator *Zip[A, B]) NextBack() (Pair[A, B], bool) {
+	ash, bsh := iterator.A.SizeHint(), iterator.B.SizeHint()
+	if !ash.IsExact() || !bsh.IsExact() {
+		panic("zip back requires exact sizes")
+	}
+	for ash.Lower > bsh.Lower {
+		Back(iterator.A)
+		ash.Lower--
+	}
+	for bsh.Lower > ash.Lower {
+		Back(iterator.B)
+		bsh.Lower--
+	}
+	a, ok := Back(iterator.A)
+	if !ok {
+		return Pair[A, B]{}, false
+	}
+	b, ok := Back(iterator.B)
+	return Pair[A, B]{a, b}, ok
+}
+func (iterator *Zip[A, B]) SizeHint() SizeHint {
+	return Min(iterator.A.SizeHint(), iterator.B.SizeHint())
+}
+
+type ZipEq[A, B any] struct {
+	A Iter[A]
+	B Iter[B]
+}
+
+func (iterator *ZipEq[A, B]) Next() (Pair[A, B], bool) {
+	a, aok := iterator.A.Next()
+	b, bok := iterator.B.Next()
+	if aok != bok {
+		panic("itertools: zip_eq reached end of one iterator before the other")
+	}
+	return Pair[A, B]{a, b}, aok
+}
+func (iterator *ZipEq[A, B]) NextBack() (Pair[A, B], bool) {
+	a, aok := Back(iterator.A)
+	b, bok := Back(iterator.B)
+	if aok != bok {
+		panic("itertools: zip_eq reached end of one iterator before the other")
+	}
+	return Pair[A, B]{a, b}, aok
+}
+func (iterator *ZipEq[A, B]) SizeHint() SizeHint {
+	return Min(iterator.A.SizeHint(), iterator.B.SizeHint())
+}
+
+type ZipLongest[A, B any] struct {
+	A            Iter[A]
+	B            Iter[B]
+	adone, bdone bool
+}
+
+func (iterator *ZipLongest[A, B]) Next() (EitherOrBoth[A, B], bool) {
+	var a A
+	var b B
+	var aok, bok bool
+	if !iterator.adone {
+		a, aok = iterator.A.Next()
+		iterator.adone = !aok
+	}
+	if !iterator.bdone {
+		b, bok = iterator.B.Next()
+		iterator.bdone = !bok
+	}
+	if aok && bok {
+		return Both(a, b), true
+	}
+	if aok {
+		return Left[A, B](a), true
+	}
+	if bok {
+		return Right[A, B](b), true
+	}
+	return EitherOrBoth[A, B]{}, false
+}
+func (iterator *ZipLongest[A, B]) NextBack() (EitherOrBoth[A, B], bool) {
+	// Each input is fused independently, including across direction changes.
+	ash, bsh := Hint(0, 0), Hint(0, 0)
+	if !iterator.adone {
+		ash = iterator.A.SizeHint()
+	}
+	if !iterator.bdone {
+		bsh = iterator.B.SizeHint()
+	}
+	if !ash.IsExact() || !bsh.IsExact() {
+		panic("zip longest back requires exact sizes")
+	}
+	if ash.Lower > bsh.Lower {
+		a, ok := Back(iterator.A)
+		iterator.adone = !ok
+		return Left[A, B](a), ok
+	}
+	if bsh.Lower > ash.Lower {
+		b, ok := Back(iterator.B)
+		iterator.bdone = !ok
+		return Right[A, B](b), ok
+	}
+	var a A
+	var b B
+	var aok, bok bool
+	if !iterator.adone {
+		a, aok = Back(iterator.A)
+		iterator.adone = !aok
+	}
+	if !iterator.bdone {
+		b, bok = Back(iterator.B)
+		iterator.bdone = !bok
+	}
+	if aok && bok {
+		return Both(a, b), true
+	}
+	if aok {
+		return Left[A, B](a), true
+	}
+	if bok {
+		return Right[A, B](b), true
+	}
+	return EitherOrBoth[A, B]{}, false
+}
+func (iterator *ZipLongest[A, B]) SizeHint() SizeHint {
+	a, b := Hint(0, 0), Hint(0, 0)
+	if !iterator.adone {
+		a = iterator.A.SizeHint()
+	}
+	if !iterator.bdone {
+		b = iterator.B.SizeHint()
+	}
+	return Max(a, b)
+}
+
+type Interleave[T any] struct {
+	A, B               Iter[T]
+	turn, adone, bdone bool
+}
+
+func (iterator *Interleave[T]) Next() (T, bool) {
+	for !iterator.adone || !iterator.bdone {
+		second := iterator.turn
+		iterator.turn = !iterator.turn
+		if second && !iterator.bdone {
+			value, ok := iterator.B.Next()
+			if ok {
+				return value, true
+			}
+			iterator.bdone = true
+		}
+		if !second && !iterator.adone {
+			value, ok := iterator.A.Next()
+			if ok {
+				return value, true
+			}
+			iterator.adone = true
+		}
+	}
+	var zero T
+	return zero, false
+}
+func (iterator *Interleave[T]) SizeHint() SizeHint {
+	a, b := Hint(0, 0), Hint(0, 0)
+	if !iterator.adone {
+		a = iterator.A.SizeHint()
+	}
+	if !iterator.bdone {
+		b = iterator.B.SizeHint()
+	}
+	return Add(a, b)
+}
+
+type InterleaveShortest[T any] struct {
+	A, B Iter[T]
+	turn bool
+}
+
+func (iterator *InterleaveShortest[T]) Next() (T, bool) {
+	it := iterator.A
+	if iterator.turn {
+		it = iterator.B
+	}
+	value, ok := it.Next()
+	if ok {
+		iterator.turn = !iterator.turn
+	}
+	return value, ok
+}
+func (iterator *InterleaveShortest[T]) SizeHint() SizeHint {
+	a, b := iterator.A.SizeHint(), iterator.B.SizeHint()
+	if iterator.turn {
+		a, b = b, a
+	}
+	return Min(MulScalar(a, 2), AddScalar(MulScalar(b, 2), 1))
+}
+
+type IntersperseWith[T any] struct {
+	It                        Iter[T]
+	Make                      func() T
+	pending                   T
+	hasPending, started, done bool
+}
+
+func (iterator *IntersperseWith[T]) Next() (T, bool) {
+	if iterator.done {
+		var zero T
+		return zero, false
+	}
+	if iterator.hasPending {
+		iterator.hasPending = false
+		return iterator.pending, true
+	}
+	value, ok := iterator.It.Next()
+	if !ok {
+		iterator.done = true
+		return value, false
+	}
+	if !iterator.started {
+		iterator.started = true
+		return value, true
+	}
+	iterator.pending = value
+	iterator.hasPending = true
+	return iterator.Make(), true
+}
+func (iterator *IntersperseWith[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := MulScalar(iterator.It.SizeHint(), 2)
+	if !iterator.started {
+		sh = SubScalar(sh, 1)
+	}
+	if iterator.hasPending {
+		sh = AddScalar(sh, 1)
+	}
+	return sh
+}
+
+type Intersperse[T any] struct{ IntersperseWith[T] }
+
+func NewIntersperse[T any](it Iter[T], value T) *Intersperse[T] {
+	return &Intersperse[T]{IntersperseWith[T]{It: it, Make: func() T { return value }}}
+}
+
+type TakeWhileInclusive[T any] struct {
+	It   Iter[T]
+	Pred func(T) bool
+	done bool
+}
+
+func (iterator *TakeWhileInclusive[T]) Next() (T, bool) {
+	if iterator.done {
+		var zero T
+		return zero, false
+	}
+	value, ok := iterator.It.Next()
+	if ok && !iterator.Pred(value) {
+		iterator.done = true
+	}
+	return value, ok
+}
+func (iterator *TakeWhileInclusive[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	return Hint(0, iterator.It.SizeHint().Upper)
+}
+
+type WhileSome[T any] struct {
+	It Iter[Option[T]]
+}
+
+func (iterator *WhileSome[T]) Next() (T, bool) {
+	value, ok := iterator.It.Next()
+	return value.Value, ok && value.Some
+}
+func (iterator *WhileSome[T]) SizeHint() SizeHint {
+	return Hint(0, iterator.It.SizeHint().Upper)
+}
+
+type Batching[T, U any] struct {
+	It Iter[T]
+	Fn func(Iter[T]) (U, bool)
+}
+
+func (iterator *Batching[T, U]) Next() (U, bool)    { return iterator.Fn(iterator.It) }
+func (iterator *Batching[T, U]) SizeHint() SizeHint { return Hint(0, -1) }
+
+type Positions[T any] struct {
+	It    Iter[T]
+	Pred  func(T) bool
+	index int
+}
+
+func (iterator *Positions[T]) Next() (int, bool) {
+	for {
+		value, ok := iterator.It.Next()
+		if !ok {
+			return 0, false
+		}
+		index := iterator.index
+		iterator.index++
+		if iterator.Pred(value) {
+			return index, true
+		}
+	}
+}
+func (iterator *Positions[T]) NextBack() (int, bool) {
+	for {
+		sh := iterator.It.SizeHint()
+		if !sh.IsExact() {
+			panic("positions back requires exact size")
+		}
+		value, ok := Back(iterator.It)
+		if !ok {
+			return 0, false
+		}
+		if iterator.Pred(value) {
+			return iterator.index + sh.Lower - 1, true
+		}
+	}
+}
+func (iterator *Positions[T]) SizeHint() SizeHint { return Hint(0, iterator.It.SizeHint().Upper) }
+
+type PadUsing[T any] struct {
+	It          Iter[T]
+	Min         int
+	Fill        func(int) T
+	front, back int
+	done        bool
+}
+
+func (iterator *PadUsing[T]) Next() (T, bool) {
+	if !iterator.done {
+		if value, ok := iterator.It.Next(); ok {
+			iterator.front++
+			return value, true
+		}
+		iterator.done = true
+	}
+	if iterator.front+iterator.back < iterator.Min {
+		value := iterator.Fill(iterator.front)
+		iterator.front++
+		return value, true
+	}
+	var zero T
+	return zero, false
+}
+func (iterator *PadUsing[T]) NextBack() (T, bool) {
+	// Fuse applies to the shared input, rather than just forward iteration.
+	sh := Hint(0, 0)
+	if !iterator.done {
+		sh = iterator.It.SizeHint()
+	}
+	if !sh.IsExact() {
+		panic("padding back requires exact size")
+	}
+	remaining := iterator.Min - iterator.front - iterator.back
+	if remaining > sh.Lower {
+		iterator.back++
+		return iterator.Fill(iterator.Min - iterator.back), true
+	}
+	if iterator.done {
+		var zero T
+		return zero, false
+	}
+	value, ok := Back(iterator.It)
+	if ok {
+		iterator.back++
+	} else {
+		iterator.done = true
+	}
+	return value, ok
+}
+func (iterator *PadUsing[T]) SizeHint() SizeHint {
+	sh := Hint(0, 0)
+	if !iterator.done {
+		sh = iterator.It.SizeHint()
+	}
+	count := max(0, iterator.Min-iterator.front-iterator.back)
+	return Max(sh, Hint(count, count))
+}
+
+type Position struct{ First, Last bool }
+
+func (position Position) IsFirst() bool  { return position.First }
+func (position Position) IsLast() bool   { return position.Last }
+func (position Position) IsMiddle() bool { return !position.First && !position.Last }
+func (position Position) IsOnly() bool   { return position.First && position.Last }
+
+type WithPosition[T any] struct {
+	It                   Iter[T]
+	pending              T
+	ready, started, done bool
+}
+
+func (iterator *WithPosition[T]) Next() (Pair[Position, T], bool) {
+	if iterator.done {
+		return Pair[Position, T]{}, false
+	}
+	if !iterator.ready {
+		var ok bool
+		iterator.pending, ok = iterator.It.Next()
+		if !ok {
+			iterator.done = true
+			return Pair[Position, T]{}, false
+		}
+	}
+	value := iterator.pending
+	iterator.pending, iterator.ready = iterator.It.Next()
+	iterator.done = !iterator.ready
+	pos := Position{!iterator.started, !iterator.ready}
+	iterator.started = true
+	return Pair[Position, T]{pos, value}, true
+}
+func (iterator *WithPosition[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := iterator.It.SizeHint()
+	if iterator.ready {
+		sh = AddScalar(sh, 1)
+	}
+	return sh
+}
+
+type Coalesce[T any] struct {
+	It          Iter[T]
+	Fn          func(T, T) (T, T, bool)
+	pending     T
+	ready, done bool
+}
+
+func (iterator *Coalesce[T]) Next() (T, bool) {
+	if iterator.done {
+		var zero T
+		return zero, false
+	}
+	if !iterator.ready {
+		var ok bool
+		iterator.pending, ok = iterator.It.Next()
+		if !ok {
+			iterator.done = true
+			var zero T
+			return zero, false
+		}
+		iterator.ready = true
+	}
+	for {
+		next, ok := iterator.It.Next()
+		if !ok {
+			iterator.done = true
+			iterator.ready = false
+			return iterator.pending, true
+		}
+		first, second, joined := iterator.Fn(iterator.pending, next)
+		iterator.pending = first
+		if !joined {
+			iterator.pending = second
+			return first, true
+		}
+	}
+}
+func (iterator *Coalesce[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := iterator.It.SizeHint()
+	if iterator.ready {
+		sh = AddScalar(sh, 1)
+	}
+	if sh.Lower > 0 {
+		sh.Lower = 1
+	}
+	return sh
+}
+
+type Dedup[T any] struct{ Coalesce[T] }
+
+func NewDedup[T any](it Iter[T], eq func(T, T) bool) *Dedup[T] {
+	return &Dedup[T]{Coalesce[T]{It: it, Fn: func(a, b T) (T, T, bool) { return a, b, eq(a, b) }}}
+}
+
+type DedupWithCount[T any] struct {
+	It          Iter[T]
+	Eq          func(T, T) bool
+	pending     T
+	ready, done bool
+}
+
+func (iterator *DedupWithCount[T]) Next() (Pair[int, T], bool) {
+	if iterator.done {
+		return Pair[int, T]{}, false
+	}
+	if !iterator.ready {
+		var ok bool
+		iterator.pending, ok = iterator.It.Next()
+		if !ok {
+			iterator.done = true
+			return Pair[int, T]{}, false
+		}
+		iterator.ready = true
+	}
+	value, count := iterator.pending, 1
+	for {
+		next, ok := iterator.It.Next()
+		if !ok {
+			iterator.done = true
+			return Pair[int, T]{count, value}, true
+		}
+		if !iterator.Eq(value, next) {
+			iterator.pending = next
+			return Pair[int, T]{count, value}, true
+		}
+		count++
+	}
+}
+func (iterator *DedupWithCount[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := iterator.It.SizeHint()
+	if iterator.ready {
+		sh = AddScalar(sh, 1)
+	}
+	if sh.Lower > 0 {
+		sh.Lower = 1
+	}
+	return sh
+}
