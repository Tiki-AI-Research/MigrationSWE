+}
+
+func NewChunks[T any](it Iter[T], size int) *Chunks[T] {
+	if size <= 0 {
+		panic("chunks: size must be positive")
+	}
+	return &Chunks[T]{It: it, Size: size}
+}
+func (iterator *Chunks[T]) Next() ([]T, bool) {
+	if iterator.done {
+		return nil, false
+	}
+	values := make([]T, 0)
+	for len(values) < iterator.Size {
+		value, ok := iterator.It.Next()
+		if !ok {
+			iterator.done = true
+			break
+		}
+		values = append(values, value)
+	}
+	return values, len(values) > 0
+}
+func (iterator *Chunks[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := iterator.It.SizeHint()
+	sh.Lower = sh.Lower/iterator.Size + boolInt(sh.Lower%iterator.Size != 0)
+	if sh.Upper >= 0 {
+		sh.Upper = sh.Upper/iterator.Size + boolInt(sh.Upper%iterator.Size != 0)
+	}
+	return sh
+}
+func boolInt(value bool) int {
+	if value {
+		return 1
+	}
+	return 0
+}
+
+type Group[T any, K comparable] struct {
+	parent *ChunkBy[T, K]
+	key    K
+	buffer []T
+	done   bool
+}
+
+func (iterator *Group[T, K]) Next() (T, bool) {
+	if len(iterator.buffer) > 0 {
+		value := iterator.buffer[0]
+		iterator.buffer = iterator.buffer[1:]
+		return value, true
+	}
+	if iterator.done {
+		var zero T
+		return zero, false
+	}
+	value, ok := iterator.parent.It.Next()
+	if !ok {
+		iterator.done = true
+		iterator.parent.done = true
+		return value, false
+	}
+	key := iterator.parent.Key(value)
+	if key != iterator.key {
+		iterator.parent.pending = value
+		iterator.parent.pendingKey = key
+		iterator.parent.ready = true
+		iterator.done = true
+		var zero T
+		return zero, false
+	}
+	return value, true
+}
+func (iterator *Group[T, K]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(len(iterator.buffer), len(iterator.buffer))
+	}
+	return AddScalar(Hint(0, iterator.parent.It.SizeHint().Upper), len(iterator.buffer))
+}
+
+type ChunkBy[T any, K comparable] struct {
+	It          Iter[T]
+	Key         func(T) K
+	current     *Group[T, K]
+	pending     T
+	pendingKey  K
+	ready, done bool
+}
+
+func (iterator *ChunkBy[T, K]) Next() (Pair[K, *Group[T, K]], bool) {
+	if iterator.current != nil && !iterator.current.done {
+		saved := iterator.current.buffer
+		iterator.current.buffer = nil
+		for {
+			value, ok := iterator.current.Next()
+			if !ok {
+				break
+			}
+			saved = append(saved, value)
+		}
+		iterator.current.buffer = saved
+	}
+	if iterator.done {
+		return Pair[K, *Group[T, K]]{}, false
+	}
+	if !iterator.ready {
+		var ok bool
+		iterator.pending, ok = iterator.It.Next()
+		if !ok {
+			iterator.done = true
+			return Pair[K, *Group[T, K]]{}, false
+		}
+		iterator.pendingKey = iterator.Key(iterator.pending)
+	}
+	group := &Group[T, K]{parent: iterator, key: iterator.pendingKey, buffer: []T{iterator.pending}}
+	iterator.current = group
+	iterator.ready = false
+	return Pair[K, *Group[T, K]]{iterator.pendingKey, group}, true
+}
+func (iterator *ChunkBy[T, K]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := iterator.It.SizeHint()
+	if iterator.ready {
+		sh = AddScalar(sh, 1)
+	}
+	lower := 0
+	if iterator.ready || iterator.current == nil && sh.Lower > 0 {
+		lower = 1
+	}
+	sh.Lower = lower
+	return sh
+}
diff --git a/core/combinatorics_alloc.go b/core/combinatorics_alloc.go
new file mode 100644
index 0000000000000000000000000000000000000000..1c74595ece7fd0344d4576692d91c6136b1b27b3
--- /dev/null
+++ b/core/combinatorics_alloc.go
@@ -0,0 +1,228 @@
+//go:build !noalloc
+
+package core
+
+import "math/big"
+
+type Combinations[T any] struct { combinationState[T] }
+func NewCombinations[T any](it Iter[T], k int) *Combinations[T] {
+    return &Combinations[T]{*newCombinationState(it,k)}
+}
+
+type CombinationsWithReplacement[T any] struct{ Combinations[T] }
+
+func NewCombinationsWithReplacement[T any](it Iter[T], k int) *CombinationsWithReplacement[T] {
+	combinations := NewCombinations(it, k)
+	combinations.replacement = true
+	return &CombinationsWithReplacement[T]{*combinations}
+}
+
+type Permutations[T any] struct {
+	buffer                LazyBuffer[T]
+	k                     int
+	indices, cycles       []int
+	started, loaded, done bool
+	emitted               int
+}
+
+func NewPermutations[T any](it Iter[T], k int) *Permutations[T] {
+	if k < 0 {
+		panic("negative permutation length")
+	}
+	return &Permutations[T]{buffer: LazyBuffer[T]{It: it}, k: k}
+}
+func (iterator *Permutations[T]) advance() bool {
+	length := len(iterator.indices)
+	for position := iterator.k - 1; position >= 0; position-- {
+		if iterator.cycles[position] == 0 {
+			iterator.cycles[position] = length - position - 1
+			first := iterator.indices[position]
+			copy(iterator.indices[position:], iterator.indices[position+1:])
+			iterator.indices[length-1] = first
+		} else {
+			other := length - iterator.cycles[position]
+			iterator.indices[position], iterator.indices[other] = iterator.indices[other], iterator.indices[position]
+			iterator.cycles[position]--
+			return true
+		}
+	}
+	return false
+}
+func (iterator *Permutations[T]) Next() ([]T, bool) {
+	if iterator.done {
+		return nil, false
+	}
+	if iterator.k == 0 {
+		iterator.done = true
+		return []T{}, true
+	}
+	if !iterator.started {
+		iterator.started = true
+		if _, ok := iterator.buffer.Get(iterator.k - 1); !ok {
+			iterator.done = true
+			return nil, false
+		}
+		iterator.emitted++
+		return append([]T(nil), iterator.buffer.Values[:iterator.k]...), true
+	}
+	if !iterator.loaded {
+		if value, ok := iterator.buffer.Get(len(iterator.buffer.Values)); ok {
+			values := make([]T, iterator.k)
+			copy(values, iterator.buffer.Values[:iterator.k-1])
+			values[iterator.k-1] = value
+			iterator.emitted++
+			return values, true
+		}
+		length := len(iterator.buffer.Values)
+		iterator.indices = make([]int, length)
+		iterator.cycles = make([]int, iterator.k)
+		for index := range iterator.indices {
+			iterator.indices[index] = index
+		}
+		for index := range iterator.cycles {
+			iterator.cycles[index] = length - index - 1
+		}
+		iterator.loaded = true
+		for count := 0; count < iterator.emitted; count++ {
+			if !iterator.advance() {
+				iterator.done = true
+				return nil, false
+			}
+		}
+	} else if !iterator.advance() {
+		iterator.done = true
+		return nil, false
+	}
+	values := make([]T, iterator.k)
+	for index := range values {
+		values[index] = iterator.buffer.Values[iterator.indices[index]]
+	}
+	iterator.emitted++
+	return values, true
+}
+func (iterator *Permutations[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	return selectionHint(iterator.buffer.SizeHint(), iterator.k, iterator.emitted, false, true)
+}
+
+type Powerset[T any] struct {
+	combinations *Combinations[T]
+	emitted      int
+	done         bool
+}
+
+func NewPowerset[T any](it Iter[T]) *Powerset[T] {
+	return &Powerset[T]{combinations: NewCombinations(it, 0)}
+}
+func (iterator *Powerset[T]) Next() ([]T, bool) {
+	if iterator.done {
+		return nil, false
+	}
+	for {
+		if values, ok := iterator.combinations.Next(); ok {
+			iterator.emitted++
+			return values, true
+		}
+		previous := iterator.combinations
+		k := previous.k + 1
+		if previous.buffer.done && k > len(previous.buffer.Values) {
+			iterator.done = true
+			return nil, false
+		}
+		iterator.combinations = &Combinations[T]{combinationState: combinationState[T]{buffer: previous.buffer, k: k}}
+	}
+}
+func (iterator *Powerset[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := iterator.combinations.buffer.SizeHint()
+	count := func(n int) SizeHint {
+		if n >= 64 {
+			return Hint(MaxInt, -1)
+		}
+		total := new(big.Int).Lsh(big.NewInt(1), uint(n))
+		total.Sub(total, big.NewInt(int64(iterator.emitted)))
+		return cardinality(total)
+	}
+	lower := count(sh.Lower).Lower
+	upper := -1
+	if sh.Upper >= 0 {
+		upper = count(sh.Upper).Upper
+	}
+	return Hint(lower, upper)
+}
+
+type MultiProduct[T any] struct {
+	buffers       []LazyBuffer[T]
+	indices       []int
+	started, done bool
+}
+
+func NewMultiProduct[T any](iters ...Iter[T]) *MultiProduct[T] {
+	product := &MultiProduct[T]{buffers: make([]LazyBuffer[T], len(iters)), indices: make([]int, len(iters))}
+	for index, it := range iters {
+		product.buffers[index] = LazyBuffer[T]{It: it}
+	}
+	return product
+}
+func (iterator *MultiProduct[T]) Next() ([]T, bool) {
+	if iterator.done {
+		return nil, false
+	}
+	if !iterator.started {
+		iterator.started = true
+		for index := range iterator.buffers {
+			if _, ok := iterator.buffers[index].Get(0); !ok {
+				iterator.done = true
+				return nil, false
+			}
+		}
+		if len(iterator.buffers) == 0 {
+			iterator.done = true
+			return []T{}, true
+		}
+	} else {
+		position := len(iterator.buffers) - 1
+		for position >= 0 {
+			if _, ok := iterator.buffers[position].Get(iterator.indices[position] + 1); ok {
+				iterator.indices[position]++
+				break
+			}
+			iterator.indices[position] = 0
+			position--
+		}
+		if position < 0 {
+			iterator.done = true
+			return nil, false
+		}
+	}
+	values := make([]T, len(iterator.buffers))
+	for index := range values {
+		values[index] = iterator.buffers[index].Values[iterator.indices[index]]
+	}
+	return values, true
+}
+func (iterator *MultiProduct[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	if !iterator.started {
+		sh := Hint(1, 1)
+		for index := range iterator.buffers {
+			sh = Mul(sh, iterator.buffers[index].SizeHint())
+		}
+		return sh
+	}
+	sh := Hint(0, 0)
+	suffix := Hint(1, 1)
+	for index := len(iterator.buffers) - 1; index >= 0; index-- {
+		total := iterator.buffers[index].SizeHint()
+		remaining := SubScalar(total, iterator.indices[index]+1)
+		sh = Add(sh, Mul(remaining, suffix))
+		suffix = Mul(suffix, total)
+	}
+	return sh
+}
diff --git a/core/doc.go b/core/doc.go
new file mode 100644
index 0000000000000000000000000000000000000000..494ca956eb8761e797deb59e5a5b7a8532a7993c
--- /dev/null
+++ b/core/doc.go
@@ -0,0 +1,13 @@
+// Package core defines the iterator protocol, source iterators, shared outcome
+// values, concrete adaptors, and recoverable errors used by itertools.
+//
+// Next returns a value and true, or the element type's zero value and false.
+// A false result need not be permanent unless the iterator is fused. SizeHint
+// bounds the number of values before the next false result; -1 means no known
+// upper bound, while MaxInt is the saturating lower bound for infinite sources.
+//
+// Adaptors that forward NextBack require a double-ended underlying iterator.
+// Operations that align endpoints also require exact size hints. Go's fixed
+// generic return types cannot conditionally expose methods based on an input's
+// dynamic type, so unsupported reverse or exact-length calls panic.
+package core
diff --git a/core/either_or_both.go b/core/either_or_both.go
new file mode 100644
index 0000000000000000000000000000000000000000..a54a2860fd8d25969c9b999ecdd004de8bd8a9c5
--- /dev/null
+++ b/core/either_or_both.go
@@ -0,0 +1,91 @@
+package core
+
+func (either EitherOrBoth[A, B]) LeftAndRight() Pair[Option[A], Option[B]] {
+	return Pair[Option[A], Option[B]]{Option[A]{either.first, either.HasLeft()}, Option[B]{either.second, either.HasRight()}}
+}
+func (either EitherOrBoth[A, B]) Both() (Pair[A, B], bool) {
+	return Pair[A, B]{either.first, either.second}, either.IsBoth()
+}
+func (either EitherOrBoth[A, B]) OrDefault() Pair[A, B] { var a A; var b B; return either.Or(a, b) }
+func (either EitherOrBoth[A, B]) OrElse(left func() A, right func() B) Pair[A, B] {
+	a, b := either.first, either.second
+	if !either.HasLeft() {
+		a = left()
+	}
+	if !either.HasRight() {
+		b = right()
+	}
+	return Pair[A, B]{a, b}
+}
+func (either *EitherOrBoth[A, B]) LeftOrInsert(value A) *A {
+	if !either.HasLeft() {
+		either.first = value
+		either.kind |= 1
+	}
+	return &either.first
+}
+func (either *EitherOrBoth[A, B]) RightOrInsert(value B) *B {
+	if !either.HasRight() {
+		either.second = value
+		either.kind |= 2
+	}
+	return &either.second
+}
+func (either *EitherOrBoth[A, B]) LeftOrInsertWith(fn func() A) *A {
+	if !either.HasLeft() {
+		either.first = fn()
+		either.kind |= 1
+	}
+	return &either.first
+}
+func (either *EitherOrBoth[A, B]) RightOrInsertWith(fn func() B) *B {
+	if !either.HasRight() {
+		either.second = fn()
+		either.kind |= 2
+	}
+	return &either.second
+}
+func (either *EitherOrBoth[A, B]) InsertLeft(value A) *A {
+	either.first = value
+	either.kind |= 1
+	return &either.first
+}
+func (either *EitherOrBoth[A, B]) InsertRight(value B) *B {
+	either.second = value
+	either.kind |= 2
+	return &either.second
+}
+func (either *EitherOrBoth[A, B]) InsertBoth(a A, b B) (*A, *B) {
+	either.first, either.second, either.kind = a, b, 3
+	return &either.first, &either.second
+}
+func AsRef[A, B any](e *EitherOrBoth[A, B]) EitherOrBoth[*A, *B] {
+	return EitherOrBoth[*A, *B]{&e.first, &e.second, e.kind}
+}
+func AsMut[A, B any](e *EitherOrBoth[A, B]) EitherOrBoth[*A, *B] { return AsRef(e) }
+func MapLeft[A, B, C any](e EitherOrBoth[A, B], fn func(A) C) EitherOrBoth[C, B] {
+	var value C
+	if e.HasLeft() {
+		value = fn(e.first)
+	}
+	return EitherOrBoth[C, B]{value, e.second, e.kind}
+}
+func MapRight[A, B, C any](e EitherOrBoth[A, B], fn func(B) C) EitherOrBoth[A, C] {
+	var value C
+	if e.HasRight() {
+		value = fn(e.second)
+	}
+	return EitherOrBoth[A, C]{e.first, value, e.kind}
+}
+func MapAny[A, B, C, D any](e EitherOrBoth[A, B], left func(A) C, right func(B) D) EitherOrBoth[C, D] {
+	return MapRight(MapLeft(e, left), right)
+}
+func Reduce[T any](e EitherOrBoth[T, T], fn func(T, T) T) T {
+	if e.IsBoth() {
+		return fn(e.first, e.second)
+	}
+	if e.HasLeft() {
+		return e.first
+	}
+	return e.second
+}
diff --git a/core/errors.go b/core/errors.go
new file mode 100644
index 0000000000000000000000000000000000000000..13dd73358ea6f944f18a65317ce3d97e49e1b3da
--- /dev/null
+++ b/core/errors.go
@@ -0,0 +1,50 @@
+package core
+
+type AllEqualValueError[T any] struct {
+	First   T
+	Second  T
+	Unequal bool
+}
+
+func NewAllEqualValueErrorZero[T any]() *AllEqualValueError[T] { return &AllEqualValueError[T]{} }
+func NewAllEqualValueErrorUnequal[T any](a, b T) *AllEqualValueError[T] {
+	return &AllEqualValueError[T]{a, b, true}
+}
+func (failure *AllEqualValueError[T]) Error() string {
+	if failure.Unequal {
+		return "got different elements when all elements were expected to be equal"
+	}
+	return "got zero elements when all elements were expected to be equal"
+}
+
+type ExactlyOneError[T any] struct {
+	inner      Iter[T]
+	first      [2]T
+	start, end int
+}
+
+func NewExactlyOneError[T any](it Iter[T], values ...T) *ExactlyOneError[T] {
+	if len(values) > 2 {
+		panic("too many restored values")
+	}
+	e := &ExactlyOneError[T]{inner: it, end: len(values)}
+	copy(e.first[:], values)
+	return e
+}
+func (failure *ExactlyOneError[T]) Error() string {
+	if failure.start < failure.end {
+		return "got at least 2 elements when exactly one was expected"
+	}
+	return "got zero elements when exactly one was expected"
+}
+func (failure *ExactlyOneError[T]) Next() (T, bool) {
+	if failure.start < failure.end {
+		value := failure.first[failure.start]
+		failure.start++
+		return value, true
+	}
+	return failure.inner.Next()
+}
+func (failure *ExactlyOneError[T]) SizeHint() SizeHint {
+	return AddScalar(failure.inner.SizeHint(), failure.end-failure.start)
+}
diff --git a/core/format.go b/core/format.go
new file mode 100644
index 0000000000000000000000000000000000000000..1e9ea910b7d45c45f43a8811465d0a3a3ffb2710
--- /dev/null
+++ b/core/format.go
@@ -0,0 +1,61 @@
+package core
+
+import (
+	"fmt"
+	"strings"
+)
+
+type Format[T any] struct {
+	it     Iter[T]
+	sep    string
+	render func(T) string
+	used   bool
+}
+
+func NewFormat[T any](it Iter[T], sep string, render func(T) string) *Format[T] {
+	return &Format[T]{it: it, sep: sep, render: render}
+}
+func (formatter *Format[T]) String() string {
+	return formatter.consume(formatter.render)
+}
+func (formatter *Format[T]) consume(render func(T) string) string {
+	if formatter.used {
+		panic("Format: already formatted")
+	}
+	formatter.used = true
+	var output strings.Builder
+	first := true
+	for {
+		value, ok := formatter.it.Next()
+		if !ok {
+			break
+		}
+		if !first {
+			output.WriteString(formatter.sep)
+		}
+		first = false
+		output.WriteString(render(value))
+	}
+	return output.String()
+}
+func (formatter *Format[T]) Format(state fmt.State, verb rune) {
+	render := formatter.render
+	_, width := state.Width()
+	_, precision := state.Precision()
+	if verb != 'v' && verb != 's' || width || precision || state.Flag('#') || state.Flag('+') || state.Flag('-') || state.Flag(' ') || state.Flag('0') {
+		spec := fmt.FormatString(state, verb)
+		render = func(value T) string { return fmt.Sprintf(spec, value) }
+	}
+	fmt.Fprint(state, formatter.consume(render))
+}
+
+type FormatWithFunc[T any] func(v T, write func(any) string) string
+type FormatWith[T any] struct{ format *Format[T] }
+
+func NewFormatWith[T any](it Iter[T], sep string, fn FormatWithFunc[T]) *FormatWith[T] {
+	return &FormatWith[T]{NewFormat(it, sep, func(value T) string { return fn(value, func(item any) string { return fmt.Sprint(item) }) })}
+}
+func (formatter *FormatWith[T]) String() string { return formatter.format.String() }
+func (formatter *FormatWith[T]) Format(state fmt.State, verb rune) {
+	fmt.Fprint(state, formatter.String())
+}
diff --git a/core/get.go b/core/get.go
new file mode 100644
index 0000000000000000000000000000000000000000..b9f3813190f41e5b425a32b7392003c26a0871be
--- /dev/null
+++ b/core/get.go
@@ -0,0 +1,37 @@
+package core
+
+type Get[T any] struct {
+	It              Iter[T]
+	Skip, Remaining int
+}
+
+func (iterator *Get[T]) Next() (T, bool) {
+	if iterator.Remaining == 0 {
+		var zero T
+		return zero, false
+	}
+	for iterator.Skip > 0 {
+		iterator.Skip--
+		if _, ok := iterator.It.Next(); !ok {
+			var zero T
+			return zero, false
+		}
+	}
+	iterator.Remaining--
+	return iterator.It.Next()
+}
+func (iterator *Get[T]) SizeHint() SizeHint {
+	return Min(SubScalar(iterator.It.SizeHint(), iterator.Skip), Hint(iterator.Remaining, iterator.Remaining))
+}
+
+type StripPrefixError[A, B any] struct {
+	Iterator Iter[A]
+	Prefix   Iter[B]
+	Mismatch Pair[Option[A], B]
+}
+
+func (failure *StripPrefixError[A, B]) Error() string {
+	return "iterator did not start with the requested prefix"
+}
+func (failure *StripPrefixError[A, B]) Next() (A, bool)    { return failure.Iterator.Next() }
+func (failure *StripPrefixError[A, B]) SizeHint() SizeHint { return failure.Iterator.SizeHint() }
diff --git a/core/hash_std.go b/core/hash_std.go
new file mode 100644
index 0000000000000000000000000000000000000000..640650d5d7d9b815f2ec5f6b0705928980118b68
--- /dev/null
+++ b/core/hash_std.go
@@ -0,0 +1,186 @@
+//go:build !nostd && !noalloc
+
+package core
+
+type UniqueBy[T any, K comparable] struct {
+	It   Iter[T]
+	Key  func(T) K
+	Hash func(K) uint64
+	seen HashTable[K, bool]
+}
+
+func (iterator *UniqueBy[T, K]) Next() (T, bool) {
+	for {
+		value, ok := iterator.It.Next()
+		if !ok {
+			return value, false
+		}
+		key := iterator.Key(value)
+		iterator.seen.Hash = iterator.Hash
+		if _, exists := iterator.seen.Get(key); !exists {
+			iterator.seen.Set(key, true)
+			return value, true
+		}
+	}
+}
+func (iterator *UniqueBy[T, K]) NextBack() (T, bool) {
+	for {
+		value, ok := Back(iterator.It)
+		if !ok {
+			return value, false
+		}
+		key := iterator.Key(value)
+		iterator.seen.Hash = iterator.Hash
+		if _, exists := iterator.seen.Get(key); !exists {
+			iterator.seen.Set(key, true)
+			return value, true
+		}
+	}
+}
+func (iterator *UniqueBy[T, K]) SizeHint() SizeHint {
+	sh := iterator.It.SizeHint()
+	lower := 0
+	if iterator.seen.Len() == 0 && sh.Lower > 0 {
+		lower = 1
+	}
+	return Hint(lower, sh.Upper)
+}
+
+type Unique[T comparable] struct{ UniqueBy[T, T] }
+type DuplicatesBy[T any, K comparable] struct {
+	It      Iter[T]
+	Key     func(T) K
+	Hash    func(K) uint64
+	seen    HashTable[K, uint8]
+	pending int
+}
+
+func (iterator *DuplicatesBy[T, K]) accept(value T) bool {
+	key := iterator.Key(value)
+	iterator.seen.Hash = iterator.Hash
+	state, _ := iterator.seen.Get(key)
+	if state == 0 {
+		iterator.seen.Set(key, 1)
+		iterator.pending++
+		return false
+	}
+	if state == 1 {
+		iterator.seen.Set(key, 2)
+		iterator.pending--
+		return true
+	}
+	return false
+}
+func (iterator *DuplicatesBy[T, K]) Next() (T, bool) {
+	for {
+		value, ok := iterator.It.Next()
+		if !ok || iterator.accept(value) {
+			return value, ok
+		}
+	}
+}
+func (iterator *DuplicatesBy[T, K]) NextBack() (T, bool) {
+	for {
+		value, ok := Back(iterator.It)
+		if !ok || iterator.accept(value) {
+			return value, ok
+		}
+	}
+}
+func (iterator *DuplicatesBy[T, K]) SizeHint() SizeHint {
+	sh := iterator.It.SizeHint()
+	if sh.Upper >= 0 {
+		sh.Upper = min(sh.Upper, (sh.Upper/2)+(iterator.pending/2)+(sh.Upper%2+iterator.pending%2)/2)
+	}
+	return Hint(0, sh.Upper)
+}
+
+type Duplicates[T comparable] struct{ DuplicatesBy[T, T] }
+type GroupingMap[K comparable, V any] struct {
+	It   Iter[Pair[K, V]]
+	Hash func(K) uint64
+}
+
+func (iterator *GroupingMap[K, V]) Next() (Pair[K, V], bool) { return iterator.It.Next() }
+func (iterator *GroupingMap[K, V]) SizeHint() SizeHint       { return iterator.It.SizeHint() }
+func (iterator *GroupingMap[K, V]) Collect() map[K][]V {
+	return GroupingMapFold(iterator, []V(nil), func(values []V, key K, value V) []V { return append(values, value) })
+}
+func (iterator *GroupingMap[K, V]) Reduce(operation func(V, K, V) V) map[K]V {
+	return GroupingMapAggregate(iterator, func(previous Option[V], key K, value V) Option[V] {
+		if previous.Some {
+			value = operation(previous.Value, key, value)
+		}
+		return Option[V]{value, true}
+	})
+}
+func (iterator *GroupingMap[K, V]) FoldFirst(operation func(V, K, V) V) map[K]V {
+	return iterator.Reduce(operation)
+}
+func (iterator *GroupingMap[K, V]) Fold(initial V, operation func(V, K, V) V) map[K]V {
+	return GroupingMapFold(iterator, initial, operation)
+}
+func (iterator *GroupingMap[K, V]) FoldWith(initial func(K, V) V, operation func(V, K, V) V) map[K]V {
+	return GroupingMapFoldWith(iterator, initial, operation)
+}
+func (iterator *GroupingMap[K, V]) Aggregate(operation func(Option[V], K, V) Option[V]) map[K]V {
+	return GroupingMapAggregate(iterator, operation)
+}
+func (iterator *GroupingMap[K, V]) MinBy(compare func(K, V, V) int) map[K]V {
+	return iterator.Reduce(func(previous V, key K, value V) V {
+		if compare(key, value, previous) < 0 {
+			return value
+		}
+		return previous
+	})
+}
+func (iterator *GroupingMap[K, V]) MaxBy(compare func(K, V, V) int) map[K]V {
+	return iterator.Reduce(func(previous V, key K, value V) V {
+		if compare(key, value, previous) >= 0 {
+			return value
+		}
+		return previous
+	})
+}
+func (iterator *GroupingMap[K, V]) MinmaxBy(compare func(K, V, V) int) map[K]MinMaxResult[V] {
+	return GroupingMapFoldWith(iterator, func(key K, value V) MinMaxResult[V] { return MinMaxResult[V]{} }, func(previous MinMaxResult[V], key K, value V) MinMaxResult[V] {
+		if previous.Kind == MinMaxNoElements {
+			return MinMaxResult[V]{MinMaxOneElement, value, value}
+		}
+		previous.Kind = MinMaxPair
+		if compare(key, value, previous.Min) < 0 {
+			previous.Min = value
+		}
+		if compare(key, value, previous.Max) >= 0 {
+			previous.Max = value
+		}
+		return previous
+	})
+}
+func GroupingMapAggregate[K comparable, V, R any](g *GroupingMap[K, V], operation func(Option[R], K, V) Option[R]) map[K]R {
+	result := HashTable[K, R]{Hash: g.Hash}
+	for {
+		pair, ok := g.It.Next()
+		if !ok {
+			return result.IntoMap()
+		}
+		previous, exists := result.Get(pair.First)
+		next := operation(Option[R]{previous, exists}, pair.First, pair.Second)
+		if next.Some {
+			result.Set(pair.First, next.Value)
+		} else {
+			result.Delete(pair.First)
+		}
+	}
+}
+func GroupingMapFold[K comparable, V, R any](g *GroupingMap[K, V], initial R, operation func(R, K, V) R) map[K]R {
+	return GroupingMapFoldWith(g, func(K, V) R { return initial }, operation)
+}
+func GroupingMapFoldWith[K comparable, V, R any](g *GroupingMap[K, V], initial func(K, V) R, operation func(R, K, V) R) map[K]R {
+	return GroupingMapAggregate(g, func(previous Option[R], key K, value V) Option[R] {
+		if !previous.Some {
+			previous.Value = initial(key, value)
+		}
+		return Option[R]{operation(previous.Value, key, value), true}
+	})
+}
diff --git a/core/hash_table_std.go b/core/hash_table_std.go
new file mode 100644
index 0000000000000000000000000000000000000000..035fed4373ebc60a651f446ad4195515d7fdf580
--- /dev/null
+++ b/core/hash_table_std.go
@@ -0,0 +1,90 @@
+//go:build !nostd && !noalloc
+
+package core
+
+type hashEntry[K comparable, V any] struct {
+	key   K
+	value V
+}
+type HashTable[K comparable, V any] struct {
+	Hash    func(K) uint64
+	native  map[K]V
+	buckets map[uint64][]hashEntry[K, V]
+	length  int
+}
+
+func (table *HashTable[K, V]) Get(key K) (V, bool) {
+	if table.Hash == nil {
+		value, ok := table.native[key]
+		return value, ok
+	}
+	bucket := table.buckets[table.Hash(key)]
+	for _, entry := range bucket {
+		if entry.key == key {
+			return entry.value, true
+		}
+	}
+	var zero V
+	return zero, false
+}
+func (table *HashTable[K, V]) Set(key K, value V) {
+	if table.Hash == nil {
+		if table.native == nil {
+			table.native = make(map[K]V)
+		}
+		table.native[key] = value
+		return
+	}
+	hash := table.Hash(key)
+	if table.buckets == nil {
+		table.buckets = make(map[uint64][]hashEntry[K, V])
+	}
+	bucket := table.buckets[hash]
+	for index := range bucket {
+		if bucket[index].key == key {
+			bucket[index].value = value
+			return
+		}
+	}
+	table.buckets[hash] = append(bucket, hashEntry[K, V]{key, value})
+	table.length++
+}
+func (table *HashTable[K, V]) Delete(key K) {
+	if table.Hash == nil {
+		delete(table.native, key)
+		return
+	}
+	hash := table.Hash(key)
+	bucket := table.buckets[hash]
+	for index := range bucket {
+		if bucket[index].key == key {
+			copy(bucket[index:], bucket[index+1:])
+			var zero hashEntry[K, V]
+			bucket[len(bucket)-1] = zero
+			table.buckets[hash] = bucket[:len(bucket)-1]
+			table.length--
+			return
+		}
+	}
+}
+func (table *HashTable[K, V]) Len() int {
+	if table.Hash == nil {
+		return len(table.native)
+	}
+	return table.length
+}
+func (table *HashTable[K, V]) IntoMap() map[K]V {
+	if table.Hash == nil {
+		if table.native == nil {
+			return make(map[K]V)
+		}
+		return table.native
+	}
+	result := make(map[K]V, table.length)
+	for _, bucket := range table.buckets {
+		for _, entry := range bucket {
+			result[entry.key] = entry.value
+		}
+	}
+	return result
+}
diff --git a/core/iterator.go b/core/iterator.go
new file mode 100644
index 0000000000000000000000000000000000000000..d28af20442b67c8655550dd775ece557bfc987ca
--- /dev/null
+++ b/core/iterator.go
@@ -0,0 +1,214 @@
+package core
+
+type Iter[T any] interface {
+	Next() (T, bool)
+	SizeHint() SizeHint
+}
+type DoubleEnded[T any] interface {
+	Iter[T]
+	NextBack() (T, bool)
+}
+type Fused[T any] interface{ Iter[T] }
+type ExactSize[T any] interface {
+	Iter[T]
+	Len() int
+}
+type Pair[A, B any] struct {
+	First  A
+	Second B
+}
+type Option[T any] struct {
+	Value T
+	Some  bool
+}
+type EitherOrBoth[A, B any] struct {
+	first  A
+	second B
+	kind   uint8
+}
+
+func Both[A, B any](a A, b B) EitherOrBoth[A, B]       { return EitherOrBoth[A, B]{a, b, 3} }
+func Left[A, B any](a A) EitherOrBoth[A, B]            { return EitherOrBoth[A, B]{first: a, kind: 1} }
+func Right[A, B any](b B) EitherOrBoth[A, B]           { return EitherOrBoth[A, B]{second: b, kind: 2} }
+func (either EitherOrBoth[A, B]) IsLeft() bool         { return either.kind == 1 }
+func (either EitherOrBoth[A, B]) IsRight() bool        { return either.kind == 2 }
+func (either EitherOrBoth[A, B]) IsBoth() bool         { return either.kind == 3 }
+func (either EitherOrBoth[A, B]) HasLeft() bool        { return either.kind&1 != 0 }
+func (either EitherOrBoth[A, B]) HasRight() bool       { return either.kind&2 != 0 }
+func (either EitherOrBoth[A, B]) JustLeft() (A, bool)  { return either.first, either.IsLeft() }
+func (either EitherOrBoth[A, B]) JustRight() (B, bool) { return either.second, either.IsRight() }
+func (either EitherOrBoth[A, B]) Left() (A, bool)      { return either.first, either.HasLeft() }
+func (either EitherOrBoth[A, B]) Right() (B, bool)     { return either.second, either.HasRight() }
+func (either EitherOrBoth[A, B]) MapLeft(fn func(A) A) EitherOrBoth[A, B] {
+	if either.HasLeft() {
+		either.first = fn(either.first)
+	}
+	return either
+}
+func (either EitherOrBoth[A, B]) MapRight(fn func(B) B) EitherOrBoth[A, B] {
+	if either.HasRight() {
+		either.second = fn(either.second)
+	}
+	return either
+}
+func (either EitherOrBoth[A, B]) Flip() EitherOrBoth[B, A] {
+	return EitherOrBoth[B, A]{either.second, either.first, (either.kind&1)<<1 | (either.kind&2)>>1}
+}
+func (either EitherOrBoth[A, B]) Or(a A, b B) Pair[A, B] {
+	if either.HasLeft() {
+		a = either.first
+	}
+	if either.HasRight() {
+		b = either.second
+	}
+	return Pair[A, B]{a, b}
+}
+
+type MinMaxResultKind int
+
+const (
+	MinMaxNoElements MinMaxResultKind = iota
+	MinMaxOneElement
+	MinMaxPair
+)
+
+type MinMaxResult[T any] struct {
+	Kind MinMaxResultKind
+	Min  T
+	Max  T
+}
+type Slice[T any] struct {
+	values      []T
+	front, back int
+}
+
+func FromSlice[T any](values []T) *Slice[T] { return &Slice[T]{values: values, back: len(values)} }
+func (iterator *Slice[T]) Next() (T, bool) {
+	if iterator.front == iterator.back {
+		var zero T
+		return zero, false
+	}
+	value := iterator.values[iterator.front]
+	iterator.front++
+	return value, true
+}
+func (iterator *Slice[T]) NextBack() (T, bool) {
+	if iterator.front == iterator.back {
+		var zero T
+		return zero, false
+	}
+	iterator.back--
+	return iterator.values[iterator.back], true
+}
+func (iterator *Slice[T]) SizeHint() SizeHint {
+	return Hint(iterator.back-iterator.front, iterator.back-iterator.front)
+}
+func (iterator *Slice[T]) Len() int         { return iterator.back - iterator.front }
+func (iterator *Slice[T]) Clone() *Slice[T] { cloned := *iterator; return &cloned }
+
+type Empty[T any] struct{}
+
+func EmptyIter[T any]() *Empty[T]              { return &Empty[T]{} }
+func (iterator *Empty[T]) Next() (T, bool)     { var zero T; return zero, false }
+func (iterator *Empty[T]) NextBack() (T, bool) { return iterator.Next() }
+func (iterator *Empty[T]) SizeHint() SizeHint  { return Hint(0, 0) }
+func (iterator *Empty[T]) Len() int            { return 0 }
+
+type Once[T any] struct {
+	value    T
+	consumed bool
+}
+
+func OnceIter[T any](value T) *Once[T] { return &Once[T]{value: value} }
+func (iterator *Once[T]) Next() (T, bool) {
+	if iterator.consumed {
+		var zero T
+		return zero, false
+	}
+	iterator.consumed = true
+	return iterator.value, true
+}
+func (iterator *Once[T]) NextBack() (T, bool) { return iterator.Next() }
+func (iterator *Once[T]) SizeHint() SizeHint {
+	if iterator.consumed {
+		return Hint(0, 0)
+	}
+	return Hint(1, 1)
+}
+func (iterator *Once[T]) Len() int { return iterator.SizeHint().Lower }
+
+type Repeat[T any] struct{ value T }
+
+func RepeatIter[T any](value T) *Repeat[T]      { return &Repeat[T]{value} }
+func (iterator *Repeat[T]) Next() (T, bool)     { return iterator.value, true }
+func (iterator *Repeat[T]) NextBack() (T, bool) { return iterator.Next() }
+func (iterator *Repeat[T]) SizeHint() SizeHint  { return Hint(MaxInt, -1) }
+
+type RepeatN[T any] struct {
+	value     T
+	remaining int
+}
+
+func NewRepeatN[T any](n int, value T) *RepeatN[T] {
+	if n < 0 {
+		panic("negative repeat count")
+	}
+	return &RepeatN[T]{value, n}
+}
+func (iterator *RepeatN[T]) Next() (T, bool) {
+	if iterator.remaining == 0 {
+		var zero T
+		return zero, false
+	}
+	iterator.remaining--
+	return iterator.value, true
+}
+func (iterator *RepeatN[T]) NextBack() (T, bool) { return iterator.Next() }
+func (iterator *RepeatN[T]) SizeHint() SizeHint  { return Hint(iterator.remaining, iterator.remaining) }
+func (iterator *RepeatN[T]) Len() int            { return iterator.remaining }
+
+type Iterate[T any] struct {
+	value T
+	next  func(T) T
+}
+
+func NewIterate[T any](seed T, next func(T) T) *Iterate[T] {
+	return &Iterate[T]{value: seed, next: next}
+}
+func (iterator *Iterate[T]) Next() (T, bool) {
+	value := iterator.value
+	iterator.value = iterator.next(iterator.value)
+	return value, true
+}
+func (iterator *Iterate[T]) SizeHint() SizeHint { return Hint(MaxInt, -1) }
+
+type Unfold[S, T any] struct {
+	State S
+	next  func(*S) (T, bool)
+}
+
+func NewUnfold[S, T any](state S, next func(*S) (T, bool)) *Unfold[S, T] {
+	return &Unfold[S, T]{state, next}
+}
+func (iterator *Unfold[S, T]) Next() (T, bool)    { return iterator.next(&iterator.State) }
+func (iterator *Unfold[S, T]) SizeHint() SizeHint { return Hint(0, -1) }
+
+type FuncIter[T any] struct {
+	Step     func() (T, bool)
+	HintFunc func() SizeHint
+}
+
+func (iterator *FuncIter[T]) Next() (T, bool) { return iterator.Step() }
+func (iterator *FuncIter[T]) SizeHint() SizeHint {
+	if iterator.HintFunc == nil {
+		return Hint(0, -1)
+	}
+	return iterator.HintFunc()
+}
+func Back[T any](it Iter[T]) (T, bool) {
+	back, ok := it.(DoubleEnded[T])
+	if !ok {
+		panic("iterator is not double-ended")
+	}
+	return back.NextBack()
+}
diff --git a/core/kmerge_alloc.go b/core/kmerge_alloc.go
new file mode 100644
index 0000000000000000000000000000000000000000..74277124b7ba50dbc6ec2adcf4feca53c5c0b266
--- /dev/null
+++ b/core/kmerge_alloc.go
@@ -0,0 +1,38 @@
+//go:build !noalloc
+
+package core
+
+type KMergeBy[T any] struct {
+	iters []Peekable[T]
+	first func(T, T) bool
+}
+
+func NewKMergeBy[T any](iters []Iter[T], first func(T, T) bool) *KMergeBy[T] {
+	merged := &KMergeBy[T]{first: first, iters: make([]Peekable[T], len(iters))}
+	for index, it := range iters {
+		merged.iters[index] = Peekable[T]{It: it, Fuse: true}
+	}
+	return merged
+}
+func (iterator *KMergeBy[T]) Next() (T, bool) {
+	best := -1
+	var value T
+	for index := range iterator.iters {
+		candidate, ok := iterator.iters[index].Peek()
+		if ok && (best < 0 || iterator.first(candidate, value)) {
+			best = index
+			value = candidate
+		}
+	}
+	if best < 0 {
+		return value, false
+	}
+	return iterator.iters[best].Next()
+}
+func (iterator *KMergeBy[T]) SizeHint() SizeHint {
+	sh := Hint(0, 0)
+	for index := range iterator.iters {
+		sh = Add(sh, iterator.iters[index].SizeHint())
+	}
+	return sh
+}
diff --git a/core/ksorted_alloc.go b/core/ksorted_alloc.go
new file mode 100644
index 0000000000000000000000000000000000000000..b1d027ccfbfdd4e4394010b7c708ca9b25e170be
--- /dev/null
+++ b/core/ksorted_alloc.go
@@ -0,0 +1,59 @@
+//go:build !noalloc
+
+package core
+
+import "slices"
+
+type KSorted[T any] struct {
+	it            Iter[T]
+	k             int
+	compare       func(T, T) int
+	values        []T
+	started, done bool
+}
+
+func NewKSorted[T any](it Iter[T], k int, compare func(T, T) int) *KSorted[T] {
+	if k < 0 {
+		panic("negative sort displacement")
+	}
+	return &KSorted[T]{it: it, k: k, compare: compare}
+}
+func (iterator *KSorted[T]) Next() (T, bool) {
+	if !iterator.started {
+		iterator.started = true
+		for index := 0; index <= iterator.k; index++ {
+			value, ok := iterator.it.Next()
+			if !ok {
+				iterator.done = true
+				break
+			}
+			iterator.values = append(iterator.values, value)
+		}
+		slices.SortStableFunc(iterator.values, iterator.compare)
+	}
+	if len(iterator.values) == 0 {
+		var zero T
+		return zero, false
+	}
+	value := iterator.values[0]
+	iterator.values = iterator.values[1:]
+	if !iterator.done {
+		next, ok := iterator.it.Next()
+		if ok {
+			position, _ := slices.BinarySearchFunc(iterator.values, next, iterator.compare)
+			iterator.values = append(iterator.values, next)
+			copy(iterator.values[position+1:], iterator.values[position:len(iterator.values)-1])
+			iterator.values[position] = next
+		} else {
+			iterator.done = true
+		}
+	}
+	return value, true
+}
+func (iterator *KSorted[T]) SizeHint() SizeHint {
+	sh := Hint(0, 0)
+	if !iterator.done {
+		sh = iterator.it.SizeHint()
+	}
+	return AddScalar(sh, len(iterator.values))
+}
diff --git a/core/merge.go b/core/merge.go
new file mode 100644
index 0000000000000000000000000000000000000000..19d774e30ae83d85e92ce30c68c941b555782c38
--- /dev/null
+++ b/core/merge.go
@@ -0,0 +1,194 @@
+package core
+
+type MergeOrdering interface{ int | bool }
+
+type Peekable[T any] struct {
+	It                  Iter[T]
+	Fuse                bool
+	value               T
+	ready, peeked, done bool
+}
+
+func (iterator *Peekable[T]) Peek() (T, bool) {
+	if !iterator.peeked && !iterator.done {
+		iterator.value, iterator.ready = iterator.It.Next()
+		iterator.peeked = true
+		iterator.done = iterator.Fuse && !iterator.ready
+	}
+	return iterator.value, iterator.ready
+}
+func (iterator *Peekable[T]) PeekMut() (*T, bool) {
+	_, ok := iterator.Peek()
+	if !ok {
+		return nil, false
+	}
+	return &iterator.value, true
+}
+func (iterator *Peekable[T]) Next() (T, bool) {
+	if iterator.peeked {
+		iterator.peeked = false
+		ok := iterator.ready
+		iterator.ready = false
+		return iterator.value, ok
+	}
+	if iterator.done {
+		var zero T
+		return zero, false
+	}
+	value, ok := iterator.It.Next()
+	iterator.done = iterator.Fuse && !ok
+	return value, ok
+}
+func (iterator *Peekable[T]) SizeHint() SizeHint {
+	if iterator.done || iterator.peeked && !iterator.ready {
+		return Hint(0, 0)
+	}
+	sh := iterator.It.SizeHint()
+	if iterator.ready {
+		return AddScalar(sh, 1)
+	}
+	return sh
+}
+
+type PutBack[T any] struct {
+	It    Iter[T]
+	value T
+	ready bool
+}
+
+func (iterator *PutBack[T]) PutBack(value T) { iterator.value = value; iterator.ready = true }
+func (iterator *PutBack[T]) Next() (T, bool) {
+	if iterator.ready {
+		iterator.ready = false
+		return iterator.value, true
+	}
+	return iterator.It.Next()
+}
+func (iterator *PutBack[T]) SizeHint() SizeHint {
+	sh := iterator.It.SizeHint()
+	if iterator.ready {
+		sh = AddScalar(sh, 1)
+	}
+	return sh
+}
+
+type MergeBy[T any] struct {
+	a, b  Peekable[T]
+	first func(T, T) bool
+}
+
+func NewMergeBy[T any](a, b Iter[T], first func(T, T) bool) *MergeBy[T] {
+	return &MergeBy[T]{a: Peekable[T]{It: a, Fuse: true}, b: Peekable[T]{It: b, Fuse: true}, first: first}
+}
+func (iterator *MergeBy[T]) Next() (T, bool) {
+	a, aok := iterator.a.Peek()
+	b, bok := iterator.b.Peek()
+	if !aok {
+		return iterator.b.Next()
+	}
+	if !bok || iterator.first(a, b) {
+		return iterator.a.Next()
+	}
+	return iterator.b.Next()
+}
+func (iterator *MergeBy[T]) SizeHint() SizeHint {
+	return Add(iterator.a.SizeHint(), iterator.b.SizeHint())
+}
+
+type MergeJoinBy[A, B any] struct {
+	a       Peekable[A]
+	b       Peekable[B]
+	compare func(A, B) int
+	boolean bool
+}
+
+func NewMergeJoinBy[A, B any, C MergeOrdering](a Iter[A], b Iter[B], compare func(A, B) C) *MergeJoinBy[A, B] {
+	var zero C
+	_, boolean := any(zero).(bool)
+	return &MergeJoinBy[A, B]{a: Peekable[A]{It: a, Fuse: true}, b: Peekable[B]{It: b, Fuse: true}, boolean: boolean, compare: func(left A, right B) int {
+		switch order := any(compare(left, right)).(type) {
+		case int:
+			return order
+		case bool:
+			if order {
+				return -1
+			}
+			return 1
+		}
+		panic("invalid merge ordering")
+	}}
+}
+func (iterator *MergeJoinBy[A, B]) Next() (EitherOrBoth[A, B], bool) {
+	a, aok := iterator.a.Peek()
+	b, bok := iterator.b.Peek()
+	if !aok && !bok {
+		return EitherOrBoth[A, B]{}, false
+	}
+	if !bok {
+		iterator.a.Next()
+		return Left[A, B](a), true
+	}
+	if !aok {
+		iterator.b.Next()
+		return Right[A, B](b), true
+	}
+	order := iterator.compare(a, b)
+	if order < 0 {
+		iterator.a.Next()
+		return Left[A, B](a), true
+	}
+	if order > 0 {
+		iterator.b.Next()
+		return Right[A, B](b), true
+	}
+	iterator.a.Next()
+	iterator.b.Next()
+	return Both(a, b), true
+}
+func (iterator *MergeJoinBy[A, B]) SizeHint() SizeHint {
+	a, b := iterator.a.SizeHint(), iterator.b.SizeHint()
+	if iterator.boolean {
+		return Add(a, b)
+	}
+	return Hint(max(a.Lower, b.Lower), Add(a, b).Upper)
+}
+
+type PeekingTakeWhile[T any] struct {
+	It   *Peekable[T]
+	Pred func(T) bool
+}
+
+func (iterator *PeekingTakeWhile[T]) Next() (T, bool) {
+	value, ok := iterator.It.Peek()
+	if !ok {
+		return iterator.It.Next()
+	}
+	if iterator.Pred(value) {
+		return iterator.It.Next()
+	}
+	var zero T
+	return zero, false
+}
+func (iterator *PeekingTakeWhile[T]) SizeHint() SizeHint {
+	return Hint(0, iterator.It.SizeHint().Upper)
+}
+
+type TakeWhileRef[T any] struct {
+	It   *PutBack[T]
+	Pred func(T) bool
+}
+
+func (iterator *TakeWhileRef[T]) Next() (T, bool) {
+	value, ok := iterator.It.Next()
+	if ok {
+		if iterator.Pred(value) {
+			return value, true
+		}
+		iterator.It.PutBack(value)
+	}
+	var zero T
+	return zero, false
+}
+func (iterator *TakeWhileRef[T]) SizeHint() SizeHint {
+	return Hint(0, iterator.It.SizeHint().Upper)
+}
