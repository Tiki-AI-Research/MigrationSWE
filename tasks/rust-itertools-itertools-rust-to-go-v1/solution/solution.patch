index 0000000000000000000000000000000000000000..11936364126adab31cdf87b2f526c3f2b0aba80a
--- /dev/null
+++ b/queries.go
@@ -0,0 +1,422 @@
+package itertools
+
+import (
+	"cmp"
+	"itertools/core"
+)
+
+func Fold[T, A any](it core.Iter[T], init A, fn func(A, T) A) A {
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return init
+		}
+		init = fn(init, value)
+	}
+}
+func Fold1[T any](it core.Iter[T], fn func(T, T) T) (T, bool) {
+	first, ok := it.Next()
+	if !ok {
+		return first, false
+	}
+	return Fold(it, first, fn), true
+}
+func All[T any](it core.Iter[T], pred func(T) bool) bool {
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return true
+		}
+		if !pred(value) {
+			return false
+		}
+	}
+}
+func Any[T any](it core.Iter[T], pred func(T) bool) bool {
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return false
+		}
+		if pred(value) {
+			return true
+		}
+	}
+}
+func Contains[T comparable](it core.Iter[T], query T) bool {
+	return Any(it, func(value T) bool { return value == query })
+}
+func AllEqualValue[T any](it core.Iter[T], eq func(T, T) bool) (T, error) {
+	first, ok := it.Next()
+	if !ok {
+		return first, core.NewAllEqualValueErrorZero[T]()
+	}
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return first, nil
+		}
+		if !eq(first, value) {
+			var zero T
+			return zero, core.NewAllEqualValueErrorUnequal(first, value)
+		}
+	}
+}
+func AllEqual[T comparable](it core.Iter[T]) bool {
+	first, ok := it.Next()
+	if !ok {
+		return true
+	}
+	return All(it, func(value T) bool { return value == first })
+}
+func ExactlyOne[T any](it core.Iter[T]) (T, *core.ExactlyOneError[T]) {
+	first, ok := it.Next()
+	if !ok {
+		return first, core.NewExactlyOneError(it)
+	}
+	second, ok := it.Next()
+	if ok {
+		var zero T
+		return zero, core.NewExactlyOneError(it, first, second)
+	}
+	return first, nil
+}
+func AtMostOne[T any](it core.Iter[T]) (core.Option[T], *core.ExactlyOneError[T]) {
+	first, ok := it.Next()
+	if !ok {
+		return core.Option[T]{}, nil
+	}
+	second, ok := it.Next()
+	if ok {
+		return core.Option[T]{}, core.NewExactlyOneError(it, first, second)
+	}
+	return core.Option[T]{Value: first, Some: true}, nil
+}
+func Sum1[T Number](it core.Iter[T]) (T, bool)                   { return Fold1(it, func(a, b T) T { return a + b }) }
+func Product1[T Number](it core.Iter[T]) (T, bool)               { return Fold1(it, func(a, b T) T { return a * b }) }
+func Minmax[T cmp.Ordered](it core.Iter[T]) core.MinMaxResult[T] { return MinmaxBy(it, cmp.Compare[T]) }
+func MinmaxBy[T any](it core.Iter[T], compare func(T, T) int) core.MinMaxResult[T] {
+	return minmaxImpl(it, func(T) struct{} { return struct{}{} }, func(left, right T, leftKey, rightKey struct{}) bool { return compare(left, right) < 0 })
+}
+func minmaxImpl[T, K any](it core.Iter[T], key func(T) K, less func(T, T, K, K) bool) core.MinMaxResult[T] {
+	first, ok := it.Next()
+	if !ok {
+		return core.MinMaxResult[T]{}
+	}
+	second, ok := it.Next()
+	if !ok {
+		return core.MinMaxResult[T]{Kind: core.MinMaxOneElement, Min: first, Max: first}
+	}
+	result := core.MinMaxResult[T]{Kind: core.MinMaxPair, Min: first, Max: second}
+	firstKey, secondKey := key(first), key(second)
+	minKey, maxKey := firstKey, secondKey
+	if less(second, first, secondKey, firstKey) {
+		result.Min, result.Max = second, first
+		minKey, maxKey = secondKey, firstKey
+	}
+	for {
+		first, ok = it.Next()
+		if !ok {
+			return result
+		}
+		second, ok = it.Next()
+		if !ok {
+			firstKey = key(first)
+			if less(first, result.Min, firstKey, minKey) {
+				result.Min = first
+			} else if !less(first, result.Max, firstKey, maxKey) {
+				result.Max = first
+			}
+			return result
+		}
+		firstKey, secondKey = key(first), key(second)
+		if !less(second, first, secondKey, firstKey) {
+			if less(first, result.Min, firstKey, minKey) {
+				result.Min = first
+				minKey = firstKey
+			}
+			if !less(second, result.Max, secondKey, maxKey) {
+				result.Max = second
+				maxKey = secondKey
+			}
+		} else {
+			if less(second, result.Min, secondKey, minKey) {
+				result.Min = second
+				minKey = secondKey
+			}
+			if !less(first, result.Max, firstKey, maxKey) {
+				result.Max = first
+				maxKey = firstKey
+			}
+		}
+	}
+}
+func MinmaxByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) core.MinMaxResult[T] {
+	return minmaxImpl(it, key, func(left, right T, leftKey, rightKey K) bool { return leftKey < rightKey })
+}
+func PositionMax[T interface {
+	~int | ~int8 | ~int16 | ~int32 | ~int64 | ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64 | ~float32 | ~float64 | ~string
+}](it core.Iter[T]) (core.Pair[int, T], bool) {
+	return PositionMaxBy(it, cmp.Compare[T])
+}
+func PositionMin[T interface {
+	~int | ~int8 | ~int16 | ~int32 | ~int64 | ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64 | ~float32 | ~float64 | ~string
+}](it core.Iter[T]) (core.Pair[int, T], bool) {
+	return PositionMinBy(it, cmp.Compare[T])
+}
+func PositionMaxBy[T any](it core.Iter[T], compare func(T, T) int) (core.Pair[int, T], bool) {
+	return positionExtreme(it, compare, true)
+}
+func PositionMinBy[T any](it core.Iter[T], compare func(T, T) int) (core.Pair[int, T], bool) {
+	return positionExtreme(it, compare, false)
+}
+func positionExtreme[T any](it core.Iter[T], compare func(T, T) int, maximum bool) (core.Pair[int, T], bool) {
+	first, ok := it.Next()
+	if !ok {
+		return core.Pair[int, T]{}, false
+	}
+	best := core.Pair[int, T]{First: 0, Second: first}
+	for index := 1; ; index++ {
+		value, ok := it.Next()
+		if !ok {
+			return best, true
+		}
+		order := compare(value, best.Second)
+		if maximum && order >= 0 || !maximum && order < 0 {
+			best = core.Pair[int, T]{First: index, Second: value}
+		}
+	}
+}
+func PositionMaxByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) (core.Pair[int, T], bool) {
+	result, ok := PositionMaxBy(Map(it, func(value T) core.Pair[T, K] { return core.Pair[T, K]{First: value, Second: key(value)} }), func(a, b core.Pair[T, K]) int { return cmp.Compare(a.Second, b.Second) })
+	return core.Pair[int, T]{First: result.First, Second: result.Second.First}, ok
+}
+func PositionMinByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) (core.Pair[int, T], bool) {
+	result, ok := PositionMinBy(Map(it, func(value T) core.Pair[T, K] { return core.Pair[T, K]{First: value, Second: key(value)} }), func(a, b core.Pair[T, K]) int { return cmp.Compare(a.Second, b.Second) })
+	return core.Pair[int, T]{First: result.First, Second: result.Second.First}, ok
+}
+func PositionMinMax[T cmp.Ordered](it core.Iter[T]) core.MinMaxResult[int] {
+	return PositionMinmaxBy(it, cmp.Compare[T])
+}
+func PositionMinmax[T cmp.Ordered](it core.Iter[T]) core.MinMaxResult[int] { return PositionMinMax(it) }
+func PositionMinmaxBy[T any](it core.Iter[T], compare func(T, T) int) core.MinMaxResult[int] {
+	result := MinmaxBy(Enumerate(it), func(a, b core.Pair[int, T]) int { return compare(a.Second, b.Second) })
+	return core.MinMaxResult[int]{Kind: result.Kind, Min: result.Min.First, Max: result.Max.First}
+}
+func PositionMinmaxByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) core.MinMaxResult[int] {
+	result := minmaxImpl(Enumerate(it), func(value core.Pair[int, T]) K { return key(value.Second) }, func(left, right core.Pair[int, T], leftKey, rightKey K) bool { return leftKey < rightKey })
+	return core.MinMaxResult[int]{Kind: result.Kind, Min: result.Min.First, Max: result.Max.First}
+}
+func FindPosition[T any](it core.Iter[T], pred func(T) bool) (core.Pair[int, T], bool) {
+	for index := 0; ; index++ {
+		value, ok := it.Next()
+		if !ok {
+			return core.Pair[int, T]{}, false
+		}
+		if pred(value) {
+			return core.Pair[int, T]{First: index, Second: value}, true
+		}
+	}
+}
+func FindOrLast[T any](it core.Iter[T], pred func(T) bool) (T, bool) {
+	var last T
+	found := false
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return last, found
+		}
+		last = value
+		found = true
+		if pred(value) {
+			return value, true
+		}
+	}
+}
+func FindOrFirst[T any](it core.Iter[T], pred func(T) bool) (T, bool) {
+	first, ok := it.Next()
+	if !ok || pred(first) {
+		return first, ok
+	}
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return first, true
+		}
+		if pred(value) {
+			return value, true
+		}
+	}
+}
+func TryLen[T any](it core.Iter[T]) (int, error) {
+	sh := it.SizeHint()
+	if sh.IsExact() {
+		return sh.Lower, nil
+	}
+	return 0, core.SizeHintError{Hint: sh}
+}
+func Equal[T comparable](a, b core.Iter[T]) bool {
+	return EqualBy(a, b, func(a, b T) bool { return a == b })
+}
+func EqualBy[A, B any](a core.Iter[A], b core.Iter[B], eq func(A, B) bool) bool {
+	for {
+		av, aok := a.Next()
+		bv, bok := b.Next()
+		if aok != bok {
+			return false
+		}
+		if !aok {
+			return true
+		}
+		if !eq(av, bv) {
+			return false
+		}
+	}
+}
+func AssertEqual[T comparable](a, b core.Iter[T]) {
+	if !Equal(a, b) {
+		panic("iterators are not equal")
+	}
+}
+func Get[T any](it core.Iter[T], start, end int) *core.Get[T] {
+	if start < 0 || end < start {
+		panic("invalid iterator range")
+	}
+	return &core.Get[T]{It: it, Skip: start, Remaining: end - start}
+}
+func SetFrom[T any](to core.Iter[*T], from core.Iter[T]) int {
+	count := 0
+	for {
+		value, ok := from.Next()
+		if !ok {
+			return count
+		}
+		target, ok := to.Next()
+		if !ok {
+			return count
+		}
+		*target = value
+		count++
+	}
+}
+func StripPrefixBy[A, B any](it core.Iter[A], prefix core.Iter[B], eq func(A, B) bool) (core.Iter[A], *core.StripPrefixError[A, B]) {
+	for {
+		expected, ok := prefix.Next()
+		if !ok {
+			return it, nil
+		}
+		value, ok := it.Next()
+		if !ok || !eq(value, expected) {
+			return nil, &core.StripPrefixError[A, B]{Iterator: it, Prefix: prefix, Mismatch: core.Pair[core.Option[A], B]{First: core.Option[A]{Value: value, Some: ok}, Second: expected}}
+		}
+	}
+}
+func StripPrefix[T comparable](it, prefix core.Iter[T]) (core.Iter[T], *core.StripPrefixError[T, T]) {
+	return StripPrefixBy(it, prefix, func(a, b T) bool { return a == b })
+}
+func FoldOK[T, A any](it core.Iter[core.Pair[T, error]], init A, fn func(A, T) A) (A, error) {
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return init, nil
+		}
+		if value.Second != nil {
+			return init, value.Second
+		}
+		init = fn(init, value.First)
+	}
+}
+func FoldOk[T, A any](it core.Iter[core.Pair[T, error]], init A, fn func(A, T) A) (A, error) {
+	return FoldOK(it, init, fn)
+}
+func FoldWhile[T, A any](it core.Iter[T], init A, fn func(A, T) core.FoldWhile[A]) core.FoldWhile[A] {
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return core.Continue(init)
+		}
+		result := fn(init, value)
+		if result.Done {
+			return result
+		}
+		init = result.Value
+	}
+}
+func ProcessResults[T, R any](it core.Iter[core.Pair[T, error]], processor func(core.Iter[T]) R) (R, error) {
+	results := &core.ProcessResults[T]{It: it}
+	value := processor(results)
+	return value, results.Err
+}
+func MapOK[T, U any](it core.Iter[core.Pair[T, error]], fn func(T) U) *core.Map[core.Pair[T, error], core.Pair[U, error]] {
+	return Map(it, func(value core.Pair[T, error]) core.Pair[U, error] {
+		if value.Second != nil {
+			return core.Pair[U, error]{Second: value.Second}
+		}
+		return core.Pair[U, error]{First: fn(value.First)}
+	})
+}
+func MapOk[T, U any](it core.Iter[core.Pair[T, error]], fn func(T) U) *core.MapOk[T, U] {
+	return &core.MapOk[T, U]{Map: *MapOK(it, fn)}
+}
+func FilterOK[T any](it core.Iter[core.Pair[T, error]], pred func(T) bool) *core.Filter[core.Pair[T, error]] {
+	return Filter(it, func(value core.Pair[T, error]) bool { return value.Second != nil || pred(value.First) })
+}
+func FilterOk[T any](it core.Iter[core.Pair[T, error]], pred func(T) bool) *core.FilterOk[T] {
+	return &core.FilterOk[T]{Filter: *FilterOK(it, pred)}
+}
+func FilterMapOK[T, U any](it core.Iter[core.Pair[T, error]], fn func(T) (U, bool)) *core.FilterMap[core.Pair[T, error], core.Pair[U, error]] {
+	return FilterMap(it, func(value core.Pair[T, error]) (core.Pair[U, error], bool) {
+		if value.Second != nil {
+			return core.Pair[U, error]{Second: value.Second}, true
+		}
+		mapped, ok := fn(value.First)
+		return core.Pair[U, error]{First: mapped}, ok
+	})
+}
+func FilterMapOk[T, U any](it core.Iter[core.Pair[T, error]], fn func(T) (U, bool)) *core.FilterMapOk[T, U] {
+	return &core.FilterMapOk[T, U]{FilterMap: *FilterMapOK(it, fn)}
+}
+func FlattenOK[T any](it core.Iter[core.Pair[core.Iter[T], error]]) *core.FlattenOK[T] {
+	return &core.FlattenOK[T]{It: it}
+}
+func FlattenOk[T any](it core.Iter[core.Pair[core.Iter[T], error]]) *core.FlattenOk[T] {
+	return &core.FlattenOk[T]{FlattenOK: *FlattenOK(it)}
+}
+func DiffWith[A, B any](a core.Iter[A], b core.Iter[B], eq func(A, B) bool) (*core.Diff[A, B], bool) {
+	for index := 0; ; index++ {
+		av, aok := a.Next()
+		bv, bok := b.Next()
+		if !aok && !bok {
+			return nil, false
+		}
+		if aok && bok && eq(av, bv) {
+			continue
+		}
+		kind := core.DiffFirstMismatch
+		var left core.Iter[A] = a
+		var right core.Iter[B] = b
+		if aok {
+			put := PutBack(a)
+			put.PutBack(av)
+			left = put
+		} else {
+			kind = core.DiffLonger
+		}
+		if bok {
+			put := PutBack(b)
+			put.PutBack(bv)
+			right = put
+		} else {
+			kind = core.DiffShorter
+		}
+		return &core.Diff[A, B]{Kind: kind, Index: index, Left: left, Right: right}, true
+	}
+}
+
+// PositionMinMaxBy preserves the casing of the explicitly named PositionMinMax.
+func PositionMinMaxBy[T any](it core.Iter[T], compare func(T, T) int) core.MinMaxResult[int] {
+	return PositionMinmaxBy(it, compare)
+}
+func PositionMinMaxByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) core.MinMaxResult[int] {
+	return PositionMinmaxByKey(it, key)
+}
