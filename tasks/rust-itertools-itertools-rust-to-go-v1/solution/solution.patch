diff --git a/grouping_std.go b/grouping_std.go
new file mode 100644
index 0000000000000000000000000000000000000000..38e3913495b0855a81e8837e958f1deb379222da
--- /dev/null
+++ b/grouping_std.go
@@ -0,0 +1,26 @@
+//go:build !nostd && !noalloc
+
+package itertools
+
+import "itertools/core"
+
+// GroupingMapAggregate permits an accumulator type independent of the input
+// value type, which Go cannot express as a generic method.
+func GroupingMapAggregate[K comparable,V,R any](g *core.GroupingMap[K,V], f func(R,bool,K,V)(R,bool)) map[K]R {
+    out := core.HashTable[K,R]{Hash:g.Hash}
+    for p,ok := g.It.Next(); ok; p,ok = g.It.Next() {
+        acc,exists := out.Get(p.First)
+        value,keep := f(acc,exists,p.First,p.Second)
+        if keep { out.Set(p.First,value) } else { out.Delete(p.First) }
+    }
+    return out.IntoMap()
+}
+func GroupingMapFoldWith[K comparable,V,R any](g *core.GroupingMap[K,V], init func(K,V)R, f func(R,K,V)R) map[K]R {
+    return GroupingMapAggregate(g,func(acc R,exists bool,key K,value V)(R,bool) {
+        if !exists { acc = init(key,value) }
+        return f(acc,key,value),true
+    })
+}
+func GroupingMapFold[K comparable,V,R any](g *core.GroupingMap[K,V], init R, f func(R,K,V)R) map[K]R {
+    return GroupingMapFoldWith(g,func(K,V)R{return init},f)
+}
