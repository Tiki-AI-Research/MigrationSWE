diff --git a/core/tuple_combinations.go b/core/tuple_combinations.go
new file mode 100644
index 0000000000000000000000000000000000000000..9397b6d472b4b845dec9c56b0513da4905b27767
--- /dev/null
+++ b/core/tuple_combinations.go
@@ -0,0 +1,167 @@
+package core
+
+import "math/big"
+
+func cardinality(value *big.Int) SizeHint {
+	if value.Sign() < 0 {
+		return Hint(0, 0)
+	}
+	if value.IsInt64() && value.Int64() <= int64(MaxInt) {
+		count := int(value.Int64())
+		return Hint(count, count)
+	}
+	return Hint(MaxInt, -1)
+}
+func choose(n, k int) *big.Int {
+	if k < 0 || n < k {
+		return new(big.Int)
+	}
+	return new(big.Int).Binomial(int64(n), int64(k))
+}
+func selectionHint(sh SizeHint, k, emitted int, replacement, permutation bool) SizeHint {
+	count := func(n int) SizeHint {
+		var total *big.Int
+		if permutation {
+			total = big.NewInt(1)
+			if n < k {
+				total.SetInt64(0)
+			} else {
+				for index := 0; index < k; index++ {
+					total.Mul(total, big.NewInt(int64(n-index)))
+					if total.BitLen() > 64 {
+						return Hint(MaxInt, -1)
+					}
+				}
+			}
+		} else {
+			if replacement && k > 0 {
+				if n == 0 {
+					return Hint(0, 0)
+				}
+				if n > MaxInt-k+1 {
+					return Hint(MaxInt, -1)
+				}
+				n += k - 1
+			}
+			total = choose(n, k)
+		}
+		total.Sub(total, big.NewInt(int64(emitted)))
+		return cardinality(total)
+	}
+	lower := count(sh.Lower).Lower
+	upper := -1
+	if sh.Upper >= 0 {
+		upper = count(sh.Upper).Upper
+	}
+	if k == 0 {
+		value := max(0, 1-emitted)
+		return Hint(value, value)
+	}
+	return Hint(lower, upper)
+}
+
+type combinationState[T any] struct {
+	buffer                     combinationBuffer[T]
+	k                          int
+	indices                    []int
+	started, done, replacement bool
+	emitted                    int
+}
+
+func newCombinationState[T any](it Iter[T], k int) *combinationState[T] {
+	if k < 0 {
+		panic("negative combination length")
+	}
+	return &combinationState[T]{buffer: combinationBuffer[T]{It: it}, k: k}
+}
+func (iterator *combinationState[T]) Next() ([]T, bool) {
+	if iterator.done {
+		return nil, false
+	}
+	if !iterator.started {
+		iterator.started = true
+		iterator.indices = make([]int, iterator.k)
+		for index := range iterator.indices {
+			if !iterator.replacement {
+				iterator.indices[index] = index
+			}
+		}
+		if iterator.k > 0 {
+			if _, ok := iterator.buffer.Get(iterator.indices[iterator.k-1]); !ok {
+				iterator.done = true
+				return nil, false
+			}
+		}
+	} else {
+		if iterator.k == 0 {
+			iterator.done = true
+			return nil, false
+		}
+		last := iterator.k - 1
+		_, available := iterator.buffer.Get(iterator.indices[last] + 1)
+		if available {
+			iterator.indices[last]++
+		} else {
+			position := last
+			for position >= 0 {
+				limit := len(iterator.buffer.Values) - iterator.k + position
+				if iterator.replacement {
+					limit = len(iterator.buffer.Values) - 1
+				}
+				if iterator.indices[position] < limit {
+					break
+				}
+				position--
+			}
+			if position < 0 {
+				iterator.done = true
+				return nil, false
+			}
+			iterator.indices[position]++
+			for index := position + 1; index < iterator.k; index++ {
+				iterator.indices[index] = iterator.indices[index-1]
+				if !iterator.replacement {
+					iterator.indices[index]++
+				}
+			}
+		}
+	}
+	values := make([]T, iterator.k)
+	for index, position := range iterator.indices {
+		values[index] = iterator.buffer.Values[position]
+	}
+	iterator.emitted++
+	return values, true
+}
+func (iterator *combinationState[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	return selectionHint(iterator.buffer.SizeHint(), iterator.k, iterator.emitted, iterator.replacement, false)
+}
+func (iterator *combinationState[T]) K() int { return iterator.k }
+func (iterator *combinationState[T]) N() int { return len(iterator.buffer.Values) }
+
+
+// TupleCombinations remains available without use_alloc, as in the Rust
+// feature surface. Dynamic Go tuple values are represented by slices.
+type TupleCombinations[T any] struct { combinationState[T] }
+func NewTupleCombinations[T any](it Iter[T], k int) *TupleCombinations[T] {
+    if k < 1 { panic("tuple combination size must be positive") }
+    return &TupleCombinations[T]{*newCombinationState(it,k)}
+}
+
+type combinationBuffer[T any] struct { It Iter[T]; Values []T; done bool }
+func (b *combinationBuffer[T]) Get(index int) (T, bool) {
+    for len(b.Values) <= index && !b.done {
+        v,ok := b.It.Next()
+        if !ok { b.done = true; break }
+        b.Values = append(b.Values,v)
+    }
+    if index >= 0 && index < len(b.Values) { return b.Values[index],true }
+    var zero T; return zero,false
+}
+func (b *combinationBuffer[T]) SizeHint() SizeHint {
+    if b.done { return Hint(len(b.Values),len(b.Values)) }
+    return AddScalar(b.It.SizeHint(),len(b.Values))
+}
diff --git a/core/windows.go b/core/windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..748039429409d8cf0355e43f7b5cfe3dba0bd5d9
--- /dev/null
+++ b/core/windows.go
@@ -0,0 +1,188 @@
+package core
+
+type ArrayWindows[T any] struct {
+	it            Iter[T]
+	n             int
+	buffer        []T
+	started, done bool
+}
+
+func NewArrayWindows[T any](it Iter[T], n int) *ArrayWindows[T] {
+	if n < 0 {
+		panic("negative window size")
+	}
+	return &ArrayWindows[T]{it: it, n: n}
+}
+func (iterator *ArrayWindows[T]) Next() ([]T, bool) {
+	if iterator.done {
+		return nil, false
+	}
+	if iterator.n == 0 {
+		if !iterator.started {
+			iterator.started = true
+			return []T{}, true
+		}
+		if _, ok := iterator.it.Next(); ok {
+			return []T{}, true
+		}
+		iterator.done = true
+		return nil, false
+	}
+	if !iterator.started {
+		iterator.started = true
+		for len(iterator.buffer) < iterator.n {
+			value, ok := iterator.it.Next()
+			if !ok {
+				iterator.done = true
+				return nil, false
+			}
+			iterator.buffer = append(iterator.buffer, value)
+		}
+	} else {
+		value, ok := iterator.it.Next()
+		if !ok {
+			iterator.done = true
+			return nil, false
+		}
+		copy(iterator.buffer, iterator.buffer[1:])
+		iterator.buffer[iterator.n-1] = value
+	}
+	return append([]T(nil), iterator.buffer...), true
+}
+func (iterator *ArrayWindows[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := iterator.it.SizeHint()
+	if iterator.n == 0 {
+		if !iterator.started {
+			return AddScalar(sh, 1)
+		}
+		return sh
+	}
+	if !iterator.started {
+		return SubScalar(sh, iterator.n-1)
+	}
+	return sh
+}
+
+type CircularArrayWindows[T any] struct {
+	it                        Iter[T]
+	n                         int
+	prefix, buffer            []T
+	started, sourceDone, done bool
+	emitted                   int
+}
+
+func NewCircularArrayWindows[T any](it Iter[T], n int) *CircularArrayWindows[T] {
+	if n < 0 {
+		panic("negative window size")
+	}
+	return &CircularArrayWindows[T]{it: it, n: n}
+}
+func (iterator *CircularArrayWindows[T]) read() (T, bool) {
+	if !iterator.sourceDone {
+		value, ok := iterator.it.Next()
+		if ok {
+			if len(iterator.prefix) < max(1, iterator.n-1) {
+				iterator.prefix = append(iterator.prefix, value)
+			}
+			return value, true
+		}
+		iterator.sourceDone = true
+	}
+	if len(iterator.prefix) == 0 {
+		var zero T
+		return zero, false
+	}
+	value := iterator.prefix[iterator.emitted%len(iterator.prefix)]
+	iterator.emitted++
+	return value, true
+}
+func (iterator *CircularArrayWindows[T]) Next() ([]T, bool) {
+	if iterator.done {
+		return nil, false
+	}
+	if iterator.n == 0 {
+		_, ok := iterator.it.Next()
+		if !ok {
+			iterator.done = true
+			return nil, false
+		}
+		return []T{}, true
+	}
+	if !iterator.started {
+		iterator.started = true
+		for len(iterator.buffer) < iterator.n {
+			value, ok := iterator.read()
+			if !ok {
+				iterator.done = true
+				return nil, false
+			}
+			iterator.buffer = append(iterator.buffer, value)
+		}
+	} else {
+		if iterator.sourceDone && iterator.emitted >= iterator.n-1 {
+			iterator.done = true
+			return nil, false
+		}
+		value, ok := iterator.read()
+		if !ok || iterator.sourceDone && iterator.emitted > iterator.n-1 {
+			iterator.done = true
+			return nil, false
+		}
+		copy(iterator.buffer, iterator.buffer[1:])
+		iterator.buffer[iterator.n-1] = value
+	}
+	return append([]T(nil), iterator.buffer...), true
+}
+func (iterator *CircularArrayWindows[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := Hint(0, 0)
+	if !iterator.sourceDone {
+		sh = iterator.it.SizeHint()
+	}
+	if !iterator.started || iterator.n == 0 {
+		return sh
+	}
+	remaining := max(0, iterator.n-1-iterator.emitted)
+	return AddScalar(sh, remaining)
+}
+
+type Tuples[T any] struct {
+	It        Iter[T]
+	N         int
+	remainder []T
+	done      bool
+}
+
+func (iterator *Tuples[T]) Next() ([]T, bool) {
+	if iterator.done {
+		return nil, false
+	}
+	values := make([]T, 0, iterator.N)
+	for len(values) < iterator.N {
+		value, ok := iterator.It.Next()
+		if !ok {
+			iterator.remainder = values
+			iterator.done = true
+			return nil, false
+		}
+		values = append(values, value)
+	}
+	return values, true
+}
+func (iterator *Tuples[T]) SizeHint() SizeHint {
+	if iterator.done {
+		return Hint(0, 0)
+	}
+	sh := iterator.It.SizeHint()
+	sh.Lower /= iterator.N
+	if sh.Upper >= 0 {
+		sh.Upper /= iterator.N
+	}
+	return sh
+}
+func (iterator *Tuples[T]) IntoBuffer() *Slice[T] { return FromSlice(iterator.remainder) }
