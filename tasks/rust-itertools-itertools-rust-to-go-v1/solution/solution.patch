@@ -0,0 +1,41 @@
+package itertools_test
+
+import (
+	"itertools"
+	"itertools/core"
+	"testing"
+)
+
+func TestSetFromConsumptionOrder(t *testing.T) {
+	first, second := 0, 0
+	targets := source(&first, &second)
+	values := source(1)
+	same(t, itertools.SetFrom(targets, values), 1)
+	if targets.Len() != 1 {
+		t.Fatal("set_from consumed a target after the source ended")
+	}
+	targets = source(&first)
+	values = source(1, 2, 3)
+	same(t, itertools.SetFrom(targets, values), 1)
+	same(t, collect(values), []int{3})
+}
+
+func TestChainDoesNotFuseFinalInput(t *testing.T) {
+	input := core.NewUnfold(0, func(state *int) (int, bool) { *state++; return *state, *state%2 == 1 })
+	chained := itertools.Chain(source(0), input)
+	first, ok := chained.Next()
+	if !ok || first != 0 {
+		t.Fatal(first, ok)
+	}
+	next, ok := chained.Next()
+	if !ok || next != 1 {
+		t.Fatal(next, ok)
+	}
+	if _, ok := chained.Next(); ok {
+		t.Fatal("expected intermittent end")
+	}
+	next, ok = chained.Next()
+	if !ok || next != 3 {
+		t.Fatal("chain unexpectedly fused the final iterator", next, ok)
+	}
+}
