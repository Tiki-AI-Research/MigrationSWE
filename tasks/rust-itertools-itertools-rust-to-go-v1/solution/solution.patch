new file mode 100644
index 0000000000000000000000000000000000000000..07a924614ec39551e99bc8e4d7a3915483e4177d
--- /dev/null
+++ b/reduce.go
@@ -0,0 +1,75 @@
+package itertools
+
+import "itertools/core"
+
+func FoldOptions[T, A any](it core.Iter[core.Option[T]], initial A, fn func(A, T) A) (A, bool) {
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return initial, true
+		}
+		if !value.Some {
+			var zero A
+			return zero, false
+		}
+		initial = fn(initial, value.Value)
+	}
+}
+func TreeReduce[T any](it core.Iter[T], fn func(T, T) T) (T, bool) {
+	var tree func(int) (T, bool, bool)
+	pair := func() (T, bool, bool) {
+		first, ok := it.Next()
+		if !ok {
+			return first, false, false
+		}
+		second, ok := it.Next()
+		if !ok {
+			return first, true, false
+		}
+		return fn(first, second), true, true
+	}
+	tree = func(stop int) (T, bool, bool) {
+		value, ok, full := pair()
+		if !full {
+			return value, ok, false
+		}
+		for height := 0; height < stop; height++ {
+			var next T
+			var nextOK, nextFull bool
+			if height == 0 {
+				next, nextOK, nextFull = pair()
+			} else {
+				next, nextOK, nextFull = tree(height)
+			}
+			if !nextOK {
+				return value, true, false
+			}
+			value = fn(value, next)
+			if !nextFull {
+				return value, true, false
+			}
+		}
+		return value, true, true
+	}
+	value, ok, _ := tree(core.MaxInt)
+	return value, ok
+}
+func TreeFold1[T any](it core.Iter[T], fn func(T, T) T) (T, bool) { return TreeReduce(it, fn) }
+func Partition[T any](values []T, pred func(T) bool) int {
+	front, back := 0, len(values)
+	for front < back {
+		if pred(values[front]) {
+			front++
+			continue
+		}
+		for front < back {
+			back--
+			if pred(values[back]) {
+				values[front], values[back] = values[back], values[front]
+				front++
+				break
+			}
+		}
+	}
+	return front
+}
