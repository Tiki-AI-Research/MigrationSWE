+//go:build !noalloc
+
+package itertools
+
+import (
+	"cmp"
+	"itertools/core"
+	"slices"
+)
+
+func CollectVec[T any](it core.Iter[T]) []T {
+	values := make([]T, 0)
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return values
+		}
+		values = append(values, value)
+	}
+}
+
+func Join[T any](it core.Iter[T], sep string) string          { return Format(it, sep).String() }
+func Chunks[T any](it core.Iter[T], size int) *core.Chunks[T] { return core.NewChunks(it, size) }
+func ChunkBy[T any, K comparable](it core.Iter[T], key func(T) K) *core.ChunkBy[T, K] {
+	return &core.ChunkBy[T, K]{It: it, Key: key}
+}
+func GroupBy[T any, K comparable](it core.Iter[T], key func(T) K) *core.GroupBy[T, K] {
+	return &core.GroupBy[T, K]{ChunkBy: *ChunkBy(it, key)}
+}
+func PutBackN[T any](it core.Iter[T]) *core.PutBackN[T] { return &core.PutBackN[T]{It: it} }
+func PeekNth[T any](it core.Iter[T]) *core.PeekNth[T]   { return &core.PeekNth[T]{It: it} }
+func MultiPeek[T any](it core.Iter[T]) *core.MultiPeek[T] {
+	return &core.MultiPeek[T]{PeekNth: core.PeekNth[T]{It: it}}
+}
+func Multipeek[T any](it core.Iter[T]) *core.MultiPeek[T]     { return MultiPeek(it) }
+func Tee[T any](it core.Iter[T]) (*core.Tee[T], *core.Tee[T]) { return core.NewTee(it) }
+func Rciter[T any](it core.Iter[T]) *core.RcIter[T]           { return core.NewRcIter(it) }
+func Iproduct[T any](iters ...core.Iter[T]) *core.MultiProduct[T] {
+	return core.NewMultiProduct(iters...)
+}
+func MultiCartesianProduct[T any](iters []core.Iter[T]) *core.MultiProduct[T] {
+	return Iproduct(iters...)
+}
+func KMerge[T cmp.Ordered](iters []core.Iter[T]) *core.KMergeBy[T] {
+	return KMergeBy(iters, func(a, b T) bool { return a < b })
+}
+func Kmerge[T cmp.Ordered](iters []core.Iter[T]) *core.KMergeBy[T] { return KMerge(iters) }
+func KMergeBy[T any](iters []core.Iter[T], first func(T, T) bool) *core.KMergeBy[T] {
+	return core.NewKMergeBy(iters, first)
+}
+func KmergeBy[T any](iters []core.Iter[T], first func(T, T) bool) *core.KMergeBy[T] {
+	return KMergeBy(iters, first)
+}
+func Combinations[T any](it core.Iter[T], k int) *core.Combinations[T] {
+	return core.NewCombinations(it, k)
+}
+func ArrayCombinations[T any](it core.Iter[T], k int) *core.ArrayCombinations[T] {
+	return &core.ArrayCombinations[T]{Combinations: *Combinations(it, k)}
+}
+func CombinationsWithReplacement[T any](it core.Iter[T], k int) *core.CombinationsWithReplacement[T] {
+	return core.NewCombinationsWithReplacement(it, k)
+}
+func ArrayCombinationsWithReplacement[T any](it core.Iter[T], k int) *core.ArrayCombinationsWithReplacement[T] {
+	return &core.ArrayCombinationsWithReplacement[T]{CombinationsWithReplacement: *CombinationsWithReplacement(it, k)}
+}
+func Permutations[T any](it core.Iter[T], k int) *core.Permutations[T] {
+	return core.NewPermutations(it, k)
+}
+func Powerset[T any](it core.Iter[T]) *core.Powerset[T] { return core.NewPowerset(it) }
+func Sorted[T cmp.Ordered](it core.Iter[T]) []T         { return SortedBy(it, cmp.Compare[T]) }
+func SortedBy[T any](it core.Iter[T], compare func(T, T) int) []T {
+	values := CollectVec(it)
+	slices.SortStableFunc(values, compare)
+	return values
+}
+func SortedUnstable[T cmp.Ordered](it core.Iter[T]) []T {
+	values := CollectVec(it)
+	slices.Sort(values)
+	return values
+}
+func SortedUnstableBy[T any](it core.Iter[T], compare func(T, T) int) []T {
+	values := CollectVec(it)
+	slices.SortFunc(values, compare)
+	return values
+}
+func SortedByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) []T {
+	return SortedBy(it, func(a, b T) int { return cmp.Compare(key(a), key(b)) })
+}
+func SortedUnstableByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) []T {
+	return SortedUnstableBy(it, func(a, b T) int { return cmp.Compare(key(a), key(b)) })
+}
+func SortedByCachedKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) []T {
+	values := SortedBy(Map(it, func(value T) core.Pair[T, K] { return core.Pair[T, K]{First: value, Second: key(value)} }), func(a, b core.Pair[T, K]) int { return cmp.Compare(a.Second, b.Second) })
+	output := make([]T, len(values))
+	for index := range values {
+		output[index] = values[index].First
+	}
+	return output
+}
+func KSmallest[T cmp.Ordered](it core.Iter[T], k int) []T { return KSmallestBy(it, k, cmp.Compare[T]) }
+func KSmallestBy[T any](it core.Iter[T], k int, compare func(T, T) int) []T {
+	if k < 0 {
+		panic("negative selection size")
+	}
+	values := make([]T, 0)
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return values
+		}
+		if k == 0 {
+			continue
+		}
+		if len(values) == k && compare(value, values[len(values)-1]) >= 0 {
+			continue
+		}
+		position, _ := slices.BinarySearchFunc(values, value, compare)
+		if position < k {
+			values = append(values, value)
+			copy(values[position+1:], values[position:len(values)-1])
+			values[position] = value
+			if len(values) > k {
+				values = values[:k]
+			}
+		}
+	}
+}
+func KSmallestByKey[T any, K cmp.Ordered](it core.Iter[T], k int, key func(T) K) []T {
+	selected := KSmallestBy(Map(it, func(value T) core.Pair[T, K] { return core.Pair[T, K]{First: value, Second: key(value)} }), k, func(a, b core.Pair[T, K]) int { return cmp.Compare(a.Second, b.Second) })
+	result := make([]T, len(selected))
+	for index := range selected {
+		result[index] = selected[index].First
+	}
+	return result
+}
+func KLargest[T cmp.Ordered](it core.Iter[T], k int) []T { return KLargestBy(it, k, cmp.Compare[T]) }
+func KLargestBy[T any](it core.Iter[T], k int, compare func(T, T) int) []T {
+	return KSmallestBy(it, k, func(a, b T) int { return compare(b, a) })
+}
+func KLargestByKey[T any, K cmp.Ordered](it core.Iter[T], k int, key func(T) K) []T {
+	values := KSmallestBy(Map(it, func(value T) core.Pair[T, K] { return core.Pair[T, K]{First: value, Second: key(value)} }), k, func(a, b core.Pair[T, K]) int { return cmp.Compare(b.Second, a.Second) })
+	result := make([]T, len(values))
+	for index := range values {
+		result[index] = values[index].First
+	}
+	return result
+}
+func KSmallestRelaxed[T cmp.Ordered](it core.Iter[T], k int) []T { return KSmallest(it, k) }
+func KSmallestRelaxedBy[T any](it core.Iter[T], k int, compare func(T, T) int) []T {
+	return KSmallestBy(it, k, compare)
+}
+func KSmallestRelaxedByKey[T any, K cmp.Ordered](it core.Iter[T], k int, key func(T) K) []T {
+	return KSmallestByKey(it, k, key)
+}
+func KLargestRelaxed[T cmp.Ordered](it core.Iter[T], k int) []T { return KLargest(it, k) }
+func KLargestRelaxedBy[T any](it core.Iter[T], k int, compare func(T, T) int) []T {
+	return KLargestBy(it, k, compare)
+}
+func KLargestRelaxedByKey[T any, K cmp.Ordered](it core.Iter[T], k int, key func(T) K) []T {
+	return KLargestByKey(it, k, key)
+}
+func KSorted[T cmp.Ordered](it core.Iter[T], k int) *core.KSorted[T] {
+	return core.NewKSorted(it, k, cmp.Compare[T])
+}
+func Tail[T any](it core.Iter[T], n int) *core.Slice[T] {
+	if n < 0 {
+		panic("negative tail size")
+	}
+	values := make([]T, 0)
+	cursor := 0
+	for {
+		value, ok := it.Next()
+		if !ok {
+			break
+		}
+		if n == 0 {
+			continue
+		}
+		if len(values) < n {
+			values = append(values, value)
+		} else {
+			values[cursor] = value
+			cursor = (cursor + 1) % n
+		}
+	}
+	if cursor > 0 {
+		ordered := append([]T(nil), values[cursor:]...)
+		values = append(ordered, values[:cursor]...)
+	}
+	return core.FromSlice(values)
+}
+func MinSet[T cmp.Ordered](it core.Iter[T]) []T { return MinSetBy(it, cmp.Compare[T]) }
+func MaxSet[T cmp.Ordered](it core.Iter[T]) []T { return MaxSetBy(it, cmp.Compare[T]) }
+func MinSetBy[T any](it core.Iter[T], compare func(T, T) int) []T {
+	values := make([]T, 0)
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return values
+		}
+		if len(values) == 0 {
+			values = append(values, value)
+			continue
+		}
+		order := compare(value, values[0])
+		if order < 0 {
+			values = values[:0]
+		}
+		if order <= 0 {
+			values = append(values, value)
+		}
+	}
+}
+func MaxSetBy[T any](it core.Iter[T], compare func(T, T) int) []T {
+	return MinSetBy(it, func(a, b T) int { return compare(b, a) })
+}
+func MinSetByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) []T {
+	values := MinSetBy(Map(it, func(value T) core.Pair[T, K] { return core.Pair[T, K]{First: value, Second: key(value)} }), func(a, b core.Pair[T, K]) int { return cmp.Compare(a.Second, b.Second) })
+	result := make([]T, len(values))
+	for index := range values {
+		result[index] = values[index].First
+	}
+	return result
+}
+func MaxSetByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) []T {
+	values := MaxSetBy(Map(it, func(value T) core.Pair[T, K] { return core.Pair[T, K]{First: value, Second: key(value)} }), func(a, b core.Pair[T, K]) int { return cmp.Compare(a.Second, b.Second) })
+	result := make([]T, len(values))
+	for index := range values {
+		result[index] = values[index].First
+	}
+	return result
+}
