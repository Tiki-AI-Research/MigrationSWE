+	maximum, _ := itertools.PositionMax(source(3, 1, 4, 1, 4))
+	minimum, _ := itertools.PositionMin(source(3, 1, 4, 1, 4))
+	same(t, maximum, core.Pair[int, int]{First: 4, Second: 4})
+	same(t, minimum, core.Pair[int, int]{First: 1, Second: 1})
+	calls := 0
