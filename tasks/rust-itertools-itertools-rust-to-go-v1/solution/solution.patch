+
+func (iterator *LazyBuffer[T]) Get(index int) (T, bool) {
+	for len(iterator.Values) <= index && !iterator.done {
+		value, ok := iterator.It.Next()
+		if !ok {
+			iterator.done = true
+			break
+		}
+		iterator.Values = append(iterator.Values, value)
+	}
+	if index >= 0 && index < len(iterator.Values) {
+		return iterator.Values[index], true
+	}
+	var zero T
+	return zero, false
