+	expectIter(t, zipped, []core.Pair[int, int]{{First: 1, Second: 4}}, true)
+	longest := itertools.ZipLongest(source(1, 2, 3), source(4, 5))
+	last, ok := longest.NextBack()
+	if !ok || !last.IsLeft() {
+		t.Fatal(last, ok)
+	}
+	expectIter(t, longest, []core.EitherOrBoth[int, int]{core.Both(1, 4), core.Both(2, 5)}, true)
+	pad := itertools.PadUsing(source(1, 2), 5, func(index int) int { return index * 10 })
+	value, ok = pad.NextBack()
+	if !ok || value != 40 {
+		t.Fatal(value, ok)
+	}
+	value, _ = pad.Next()
+	same(t, value, 1)
+	value, _ = pad.NextBack()
+	same(t, value, 30)
+	expectIter(t, pad, []int{2, 20}, true)
+	positions := itertools.Positions(source(0, 1, 2, 3, 4), func(value int) bool { return value%2 == 0 })
+	index, _ := positions.NextBack()
+	same(t, index, 4)
+	index, _ = positions.Next()
+	same(t, index, 0)
+	expectIter(t, positions, []int{2}, false)
+	expectIter(t, itertools.Rev(itertools.Enumerate(source(1, 2, 3))), []core.Pair[int, int]{{First: 2, Second: 3}, {First: 1, Second: 2}, {First: 0, Second: 1}}, true)
