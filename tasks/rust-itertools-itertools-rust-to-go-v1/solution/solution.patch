+	return core.NewFormat(it, sep, func(value T) string { return fmt.Sprint(value) })
+}
+func FormatWith[T any](it core.Iter[T], sep string, fn core.FormatWithFunc[T]) *core.FormatWith[T] {
+	return core.NewFormatWith(it, sep, fn)
+}
+func PeekingTakeWhile[T any](it *core.Peekable[T], pred func(T) bool) *core.PeekingTakeWhile[T] {
+	return &core.PeekingTakeWhile[T]{It: it, Pred: pred}
+}
+func TakeWhileRef[T any](it *core.PutBack[T], pred func(T) bool) *core.TakeWhileRef[T] {
+	return &core.TakeWhileRef[T]{It: it, Pred: pred}
+}
+func PutBack[T any](it core.Iter[T]) *core.PutBack[T] { return &core.PutBack[T]{It: it} }
+func Update[T any](it core.Iter[T], updater func(*T)) *core.Update[T] {
+	return &core.Update[T]{Map: *Map(it, func(value T) T { updater(&value); return value })}
+}
