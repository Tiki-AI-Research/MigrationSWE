+type teeState[T any] struct {
+	it     Iter[T]
+	queues [2][]T
+}
+type Tee[T any] struct {
+	state *teeState[T]
+	side  int
+}
+
+func NewTee[T any](it Iter[T]) (*Tee[T], *Tee[T]) {
+	state := &teeState[T]{it: it}
+	return &Tee[T]{state, 0}, &Tee[T]{state, 1}
+}
+func (iterator *Tee[T]) Next() (T, bool) {
+	queue := iterator.state.queues[iterator.side]
+	if len(queue) > 0 {
+		value := queue[0]
+		var zero T
+		queue[0] = zero
+		iterator.state.queues[iterator.side] = queue[1:]
+		return value, true
+	}
+	value, ok := iterator.state.it.Next()
+	if ok {
+		other := 1 - iterator.side
+		iterator.state.queues[other] = append(iterator.state.queues[other], value)
+	}
+	return value, ok
+}
+func (iterator *Tee[T]) SizeHint() SizeHint {
+	return AddScalar(iterator.state.it.SizeHint(), len(iterator.state.queues[iterator.side]))
