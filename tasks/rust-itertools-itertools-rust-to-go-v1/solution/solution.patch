+func TestZipAndBackwards(t *testing.T) {
+	expectIter(t, itertools.Zip(source(1, 2), source("a")), []core.Pair[int, string]{{First: 1, Second: "a"}}, true)
+	expectIter(t, itertools.ZipEq(source(1, 2), source("a", "b")), []core.Pair[int, string]{{First: 1, Second: "a"}, {First: 2, Second: "b"}}, true)
+	panics(t, func() { collect(itertools.ZipEq(source(1), source[int]())) })
+	panics(t, func() { collect(itertools.ZipEq(source[int](), source(1))) })
+	expectIter(t, itertools.ZipLongest(source(1, 2), source("a")), []core.EitherOrBoth[int, string]{core.Both(1, "a"), core.Left[int, string](2)}, true)
+	mapped := itertools.Map(source(1, 2, 3), func(value int) int { return value * 2 })
+	value, ok := mapped.NextBack()
+	if !ok || value != 6 {
+		t.Fatal(value, ok)
