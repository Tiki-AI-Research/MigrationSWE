+func Enumerate[T any](it core.Iter[T]) *core.Enumerate[T]              { return itertools.Enumerate(it) }
+func Rev[T any](it core.DoubleEnded[T]) *core.Rev[T]                   { return itertools.Rev(it) }
+func Cloned[T any](it core.Iter[*T]) *core.Map[*T, T] {
+	return itertools.Map(it, func(value *T) T { return *value })
+}
+func Intersperse[T any](it core.Iter[T], value T) *core.Intersperse[T] {
+	return itertools.Intersperse(it, value)
+}
+func IntersperseWith[T any](it core.Iter[T], fn func() T) *core.IntersperseWith[T] {
+	return itertools.IntersperseWith(it, fn)
+}
+func Interleave[T any](a, b core.Iter[T]) *core.Interleave[T] { return itertools.Interleave(a, b) }
+func PutBack[T any](it core.Iter[T]) *core.PutBack[T]         { return itertools.PutBack(it) }
+func Merge[T cmp.Ordered](a, b core.Iter[T]) *core.MergeBy[T] { return itertools.Merge(a, b) }
+func MergeJoinBy[A, B any, C core.MergeOrdering](a core.Iter[A], b core.Iter[B], compare func(A, B) C) *core.MergeJoinBy[A, B] {
+	return itertools.MergeJoinBy(a, b, compare)
+}
+func DiffWith[A, B any](a core.Iter[A], b core.Iter[B], eq func(A, B) bool) (*core.Diff[A, B], bool) {
+	return itertools.DiffWith(a, b, eq)
+}
+func Max[T cmp.Ordered](it core.Iter[T]) (T, bool) {
+	result, ok := itertools.PositionMaxBy(it, cmp.Compare[T])
+	return result.Second, ok
+}
+func Min[T cmp.Ordered](it core.Iter[T]) (T, bool) {
+	result, ok := itertools.PositionMinBy(it, cmp.Compare[T])
+	return result.Second, ok
+}
+func ConsTuples[A, B, C any](it core.Iter[core.Pair[core.Pair[A, B], C]]) *core.ConsTuples[A, B, C] {
+	return itertools.ConsTuples(it)
+}
diff --git a/free/free_test.go b/free/free_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4d90300523967584777404010e387d8b65d2f15a
--- /dev/null
+++ b/free/free_test.go
@@ -0,0 +1,89 @@
+package free_test
+
+import (
+	"errors"
+	"itertools/core"
+	"itertools/free"
+	"reflect"
+	"testing"
+)
+
+func source[T any](values ...T) *core.Slice[T] { return core.FromSlice(values) }
+func collect[T any](it core.Iter[T]) []T {
+	values := make([]T, 0)
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return values
+		}
+		values = append(values, value)
+	}
+}
+func same[T any](t *testing.T, got, want T) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %#v, want %#v", got, want)
+	}
+}
+
+func TestFreeFunctions(t *testing.T) {
+	if !free.All(source(1, 2, 3), func(value int) bool { return value > 0 }) || !free.Any(source(1, 2, 3), func(value int) bool { return value == 2 }) {
+		t.Fatal("predicates")
+	}
+	same(t, free.Fold(source(1, 2, 3), 0, func(acc, value int) int { return acc + value }), 6)
+	same(t, collect(free.Chain(source(1), source(2, 3))), []int{1, 2, 3})
+	same(t, collect(free.Enumerate(source("a", "b"))), []core.Pair[int, string]{{First: 0, Second: "a"}, {First: 1, Second: "b"}})
+	same(t, collect(free.Rev(source(1, 2, 3))), []int{3, 2, 1})
+	same(t, collect(free.Zip(source(1, 2), source("a", "b"))), []core.Pair[int, string]{{First: 1, Second: "a"}, {First: 2, Second: "b"}})
+	same(t, collect(free.Multizip(source(1, 2), source(3, 4))), [][]int{{1, 3}, {2, 4}})
+	same(t, collect(free.RepeatN(3, 4)), []int{4, 4, 4})
+	it := free.Iterate(1, func(value int) int { return value * 2 })
+	for _, want := range []int{1, 2, 4, 8} {
+		value, ok := it.Next()
+		if !ok || value != want {
+			t.Fatal(value, ok)
+		}
+	}
+	same(t, collect(free.Unfold(0, func(state *int) (int, bool) { *state++; return *state, *state <= 3 })), []int{1, 2, 3})
+	same(t, collect(free.Intersperse(source(1, 2, 3), 0)), []int{1, 0, 2, 0, 3})
+	same(t, collect(free.IntersperseWith(source(1, 2), func() int { return 9 })), []int{1, 9, 2})
+	maximum, ok := free.Max(source(1, 3, 2))
+	if !ok || maximum != 3 {
+		t.Fatal(maximum, ok)
+	}
+	minimum, ok := free.Min(source(1, 3, 2))
+	if !ok || minimum != 1 {
+		t.Fatal(minimum, ok)
+	}
+	if _, ok := free.Max(source[int]()); ok {
+		t.Fatal("empty max")
+	}
+	first, second := 1, 2
+	same(t, collect(free.Cloned(source(&first, &second))), []int{1, 2})
+	same(t, free.Concat(source([]int{1}, []int{2, 3})), []int{1, 2, 3})
+	same(t, collect(free.ConsTuples(source(core.Pair[core.Pair[int, string], bool]{First: core.Pair[int, string]{First: 1, Second: "a"}, Second: true}))), []core.Triple[int, string, bool]{{First: 1, Second: "a", Third: true}})
+}
+
+func TestProcessResults(t *testing.T) {
+	failure := errors.New("failure")
+	values := source(core.Pair[int, error]{First: 1}, core.Pair[int, error]{First: 2}, core.Pair[int, error]{Second: failure}, core.Pair[int, error]{First: 4})
+	result, err := free.ProcessResults(values, func(it core.Iter[int]) int { return free.Fold(it, 0, func(acc, value int) int { return acc + value }) })
+	if !errors.Is(err, failure) || result != 3 {
+		t.Fatal(result, err)
+	}
+	tail, _ := values.Next()
+	same(t, tail.First, 4)
+	values = source(core.Pair[int, error]{First: 1}, core.Pair[int, error]{Second: failure})
+	result, err = free.ProcessResults(values, func(it core.Iter[int]) int { value, _ := it.Next(); return value })
+	if err != nil || result != 1 {
+		t.Fatal(result, err)
+	}
+	tail, _ = values.Next()
+	if !errors.Is(tail.Second, failure) {
+		t.Fatal("processor consumed too far")
+	}
+	result, err = free.ProcessResults(core.EmptyIter[core.Pair[int, error]](), func(it core.Iter[int]) int { return 9 })
+	if err != nil || result != 9 {
+		t.Fatal(result, err)
+	}
+}
