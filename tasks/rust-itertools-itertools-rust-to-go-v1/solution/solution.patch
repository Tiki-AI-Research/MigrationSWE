+type PutBackN[T any] struct {
+	It     Iter[T]
+	buffer []T
+}
+
+func (iterator *PutBackN[T]) PutBack(value T) { iterator.buffer = append(iterator.buffer, value) }
+func (iterator *PutBackN[T]) Next() (T, bool) {
+	if len(iterator.buffer) > 0 {
+		index := len(iterator.buffer) - 1
+		value := iterator.buffer[index]
+		var zero T
+		iterator.buffer[index] = zero
+		iterator.buffer = iterator.buffer[:index]
+		return value, true
+	}
+	return iterator.It.Next()
+}
+func (iterator *PutBackN[T]) SizeHint() SizeHint {
+	return AddScalar(iterator.It.SizeHint(), len(iterator.buffer))
