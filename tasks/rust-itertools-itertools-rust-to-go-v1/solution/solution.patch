+package itertools_test
+
+import (
+    "reflect"
+    "testing"
+    it "itertools"
+    "itertools/core"
+    "itertools/free"
+)
+
+// These generic collectors and fixed-tuple combinations are also part of the
+// Rust surface without use_alloc. Keep this regression available under all tags.
+func TestCollectionFeatureBoundaries(t *testing.T) {
+    combinations := it.TupleCombinations(core.FromSlice([]int{1,2,3}),2)
+    for _, want := range [][]int{{1,2},{1,3},{2,3}} {
+        got,ok := combinations.Next()
+        if !ok || !reflect.DeepEqual(got,want) { t.Fatalf("tuple combination: %v,%v",got,ok) }
+    }
+    if _,ok := combinations.Next(); ok { t.Fatal("extra tuple combination") }
+    values,err := it.TryCollect(core.FromSlice([]core.Pair[int,error]{{First:1},{First:2}}))
+    if err != nil || !reflect.DeepEqual(values,[]int{1,2}) { t.Fatalf("TryCollect: %v,%v",values,err) }
+    left,right := free.Multiunzip(core.FromSlice([]core.Pair[int,string]{{First:1,Second:"a"},{First:2,Second:"b"}}))
+    if !reflect.DeepEqual(left,[]int{1,2}) || !reflect.DeepEqual(right,[]string{"a","b"}) { t.Fatal("Multiunzip changed values") }
+}
