+	if prefixErr == nil || prefixErr.Mismatch.First.Value != 2 || prefixErr.Mismatch.Second != 9 {
+		t.Fatal(prefixErr)
+	}
+	same(t, collect(prefixErr.Iterator), []int{3})
+	same(t, collect(prefixErr.Prefix), []int{4})
+	diff, found := itertools.DiffWith(source(1, 2), source(1, 2, 3), eq)
+	if !found || diff.Kind != core.DiffLonger || diff.Index != 2 {
+		t.Fatal(diff, found)
+	}
+	same(t, collect(diff.Right), []int{3})
+	diff, found = itertools.DiffWith(source(1, 2, 3), source(1), eq)
+	if !found || diff.Kind != core.DiffShorter {
+		t.Fatal(diff, found)
+	}
+	same(t, collect(diff.Left), []int{2, 3})
+	diff, found = itertools.DiffWith(source(1, 2, 3), source(1, 4, 5), eq)
+	if !found || diff.Kind != core.DiffFirstMismatch {
+		t.Fatal(diff, found)
+	}
+	same(t, collect(diff.Left), []int{2, 3})
+	same(t, collect(diff.Right), []int{4, 5})
+	values := []int{1, 4, 3, 2, 6, 5}
+	split := itertools.Partition(values, func(value int) bool { return value%2 == 0 })
+	same(t, split, 3)
