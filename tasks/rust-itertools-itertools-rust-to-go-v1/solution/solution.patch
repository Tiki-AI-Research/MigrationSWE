+package itertools_test
+
+import (
+    "testing"
+    it "itertools"
+    "itertools/core"
+)
+
+type conservativeWindowSource struct { values []int; index int }
+func (s *conservativeWindowSource) Next() (int, bool) {
+    if s.index == len(s.values) { return 0, false }
+    value := s.values[s.index]; s.index++; return value, true
+}
+func (s *conservativeWindowSource) SizeHint() core.SizeHint { return core.Hint(0, -1) }
+func TestCircularWindowFusedHint(t *testing.T) {
+    windows := it.CircularArrayWindows[int](&conservativeWindowSource{values: []int{1,2}}, 3)
+    windows.Next()
+    if h := windows.SizeHint(); h != core.Hint(1,1) { t.Fatalf("fused remainder: %v", h) }
+    windows.Next()
+    if h := windows.SizeHint(); h != core.Hint(0,0) { t.Fatalf("fused exhaustion: %v", h) }
+}
