new file mode 100644
index 0000000..cb1848c
--- /dev/null
+++ b/core/product.go
@@ -0,0 +1,99 @@
+package core
+
+import "reflect"
+
+// Product replays the right input's initial run, matching a cloned Rust
+// iterator. An absent current left item is distinct from permanent exhaustion:
+// the left input is polled again when the right input next wraps.
+type Product[A, B any] struct {
+	a               Iter[A]
+	b               Iter[B]
+	values          []B
+	current         A
+	index           int
+	started, bdone  bool
+	currentOK       bool
+	originalRight   Iter[B]
+	cloneRight      func() Iter[B]
+}
+
+func NewProduct[A, B any](a Iter[A], b Iter[B]) *Product[A, B] {
+	product := &Product[A, B]{a: a, b: b}
+	// Go permits Clone to return the concrete cursor type. Discover that
+	// method without imposing a covariant interface signature on callers.
+	clone := reflect.ValueOf(b).MethodByName("Clone")
+	protocol := reflect.TypeOf((*Iter[B])(nil)).Elem()
+	if clone.IsValid() && clone.Type().NumIn() == 0 && clone.Type().NumOut() == 1 && clone.Type().Out(0).Implements(protocol) {
+		product.originalRight = b
+		product.cloneRight = func() Iter[B] { return clone.Call(nil)[0].Interface().(Iter[B]) }
+		product.b = product.cloneRight()
+	}
+	return product
+}
+func (iterator *Product[A, B]) nextB() (B, bool) {
+	if iterator.index < len(iterator.values) {
+		value := iterator.values[iterator.index]
+		iterator.index++
+		return value, true
+	}
+	if !iterator.bdone {
+		value, ok := iterator.b.Next()
+		if ok {
+			iterator.values = append(iterator.values, value)
+			iterator.index++
+			return value, true
+		}
+		iterator.bdone = true
+	}
+	var zero B
+	return zero, false
+}
+func (iterator *Product[A, B]) Next() (Pair[A, B], bool) {
+	var value B
+	var ok bool
+	if iterator.cloneRight != nil {
+		value, ok = iterator.b.Next()
+	} else {
+		value, ok = iterator.nextB()
+	}
+	if !ok {
+		if iterator.cloneRight != nil {
+			iterator.b = iterator.cloneRight()
+			value, ok = iterator.b.Next()
+		} else {
+			iterator.index = 0
+			value, ok = iterator.nextB()
+		}
+		if !ok {
+			return Pair[A, B]{}, false
+		}
+		iterator.current, iterator.currentOK = iterator.a.Next()
+		iterator.started = true
+	}
+	if !iterator.started {
+		iterator.current, iterator.currentOK = iterator.a.Next()
+		iterator.started = true
+	}
+	if !iterator.currentOK {
+		return Pair[A, B]{}, false
+	}
+	return Pair[A, B]{iterator.current, value}, true
+}
+func (iterator *Product[A, B]) SizeHint() SizeHint {
+	if iterator.cloneRight != nil {
+		sh := Mul(iterator.a.SizeHint(), iterator.originalRight.SizeHint())
+		if iterator.started && iterator.currentOK {
+			sh = Add(sh, iterator.b.SizeHint())
+		}
+		return sh
+	}
+	total := Hint(len(iterator.values), len(iterator.values))
+	if !iterator.bdone {
+		total = AddScalar(iterator.b.SizeHint(), len(iterator.values))
+	}
+	sh := Mul(iterator.a.SizeHint(), total)
+	if iterator.started && iterator.currentOK {
+		sh = Add(sh, SubScalar(total, iterator.index))
+	}
+	return sh
+}
diff --git a/core/size_hint.go b/core/size_hint.go
new file mode 100644
index 0000000000000000000000000000000000000000..0ed2f65c9f7b75b57e2e6128d82de81e2afed502
--- /dev/null
+++ b/core/size_hint.go
@@ -0,0 +1,85 @@
+package core
+
+const MaxInt = int(^uint(0) >> 1)
+
+type SizeHint struct {
+	Lower int
+	Upper int
+}
+
+func Hint(lo, hi int) SizeHint {
+	if lo < 0 || hi < -1 || hi >= 0 && hi < lo {
+		panic("invalid size hint")
+	}
+	return SizeHint{lo, hi}
+}
+func (hint SizeHint) IsExact() bool { return hint.Lower == hint.Upper }
+func (hint SizeHint) Bounded() bool { return hint.Upper >= 0 }
+func addBound(a, b int) int {
+	if a < 0 || b < 0 || a > MaxInt-b {
+		return -1
+	}
+	return a + b
+}
+func mulBound(a, b int) int {
+	if a == 0 || b == 0 {
+		return 0
+	}
+	if a < 0 || b < 0 || a > MaxInt/b {
+		return -1
+	}
+	return a * b
+}
+func Add(a, b SizeHint) SizeHint {
+	lower := addBound(a.Lower, b.Lower)
+	if lower < 0 {
+		lower = MaxInt
+	}
+	return SizeHint{lower, addBound(a.Upper, b.Upper)}
+}
+func AddScalar(sh SizeHint, x int) SizeHint { return Add(sh, Hint(x, x)) }
+func SubScalar(sh SizeHint, x int) SizeHint {
+	if x < 0 {
+		panic("negative size")
+	}
+	upper := sh.Upper
+	if upper >= 0 {
+		upper = max(0, upper-x)
+	}
+	return SizeHint{max(0, sh.Lower-x), upper}
+}
+func Mul(a, b SizeHint) SizeHint {
+	lower := mulBound(a.Lower, b.Lower)
+	if lower < 0 {
+		lower = MaxInt
+	}
+	return SizeHint{lower, mulBound(a.Upper, b.Upper)}
+}
+func MulScalar(sh SizeHint, x int) SizeHint {
+	if x < 0 {
+		panic("negative size")
+	}
+	lower := mulBound(sh.Lower, x)
+	if lower < 0 {
+		lower = MaxInt
+	}
+	upper := -1
+	if sh.Upper >= 0 {
+		upper = mulBound(sh.Upper, x)
+	}
+	return SizeHint{lower, upper}
+}
+func Min(a, b SizeHint) SizeHint {
+	upper := a.Upper
+	if upper < 0 || b.Upper >= 0 && b.Upper < upper {
+		upper = b.Upper
+	}
+	return SizeHint{min(a.Lower, b.Lower), upper}
+}
+func Max(a, b SizeHint) SizeHint {
+	upper := -1
+	if a.Upper >= 0 && b.Upper >= 0 {
+		upper = max(a.Upper, b.Upper)
+	}
+	return SizeHint{max(a.Lower, b.Lower), upper}
+}
diff --git a/core/size_hint_test.go b/core/size_hint_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a2bd3825e09bc18920b91c838d451b82c10459a2
--- /dev/null
+++ b/core/size_hint_test.go
@@ -0,0 +1,149 @@
+package core_test
+
+import (
+	"itertools/core"
+	"testing"
+)
+
+func TestSizeHintArithmetic(t *testing.T) {
+	cases := []struct {
+		name      string
+		got, want core.SizeHint
+	}{
+		{"add", core.Add(core.Hint(2, 4), core.Hint(3, 5)), core.Hint(5, 9)},
+		{"add unknown", core.Add(core.Hint(2, -1), core.Hint(3, 5)), core.Hint(5, -1)},
+		{"add scalar", core.AddScalar(core.Hint(2, 4), 3), core.Hint(5, 7)},
+		{"subtract", core.SubScalar(core.Hint(2, 4), 3), core.Hint(0, 1)},
+		{"subtract unknown", core.SubScalar(core.Hint(2, -1), 3), core.Hint(0, -1)},
+		{"multiply", core.Mul(core.Hint(3, 4), core.Hint(3, 4)), core.Hint(9, 16)},
+		{"multiply zero", core.Mul(core.Hint(3, -1), core.Hint(0, 0)), core.Hint(0, 0)},
+		{"multiply scalar", core.MulScalar(core.Hint(2, 4), 3), core.Hint(6, 12)},
+		{"multiply scalar unknown zero", core.MulScalar(core.Hint(2, -1), 0), core.Hint(0, -1)},
+		{"minimum", core.Min(core.Hint(2, -1), core.Hint(3, 5)), core.Hint(2, 5)},
+		{"maximum", core.Max(core.Hint(2, -1), core.Hint(3, 5)), core.Hint(3, -1)},
+		{"add overflow", core.AddScalar(core.Hint(core.MaxInt, core.MaxInt), 1), core.Hint(core.MaxInt, -1)},
+		{"multiply overflow", core.MulScalar(core.Hint(core.MaxInt, core.MaxInt), 2), core.Hint(core.MaxInt, -1)},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			if test.got != test.want {
+				t.Fatalf("got %v, want %v", test.got, test.want)
+			}
+		})
+	}
+	if !core.Hint(3, 3).IsExact() || core.Hint(0, 3).IsExact() || !core.Hint(0, 3).Bounded() || core.Hint(0, -1).Bounded() {
+		t.Fatal("hint predicates")
+	}
+}
+
+func TestSources(t *testing.T) {
+	source := core.FromSlice([]int{1, 2, 3})
+	clone := source.Clone()
+	if value, ok := source.NextBack(); !ok || value != 3 {
+		t.Fatal(value, ok)
+	}
+	if value, ok := source.Next(); !ok || value != 1 {
+		t.Fatal(value, ok)
+	}
+	if source.Len() != 1 || clone.Len() != 3 {
+		t.Fatal("source lengths")
+	}
+	if value, ok := source.NextBack(); !ok || value != 2 {
+		t.Fatal(value, ok)
+	}
+	if _, ok := source.Next(); ok {
+		t.Fatal("slice not exhausted")
+	}
+	repeated := core.NewRepeatN(3, 4)
+	for index := 3; index > 0; index-- {
+		if repeated.Len() != index {
+			t.Fatal("repeat length")
+		}
+		value, ok := repeated.NextBack()
+		if value != 4 || !ok {
+			t.Fatal(value, ok)
+		}
+	}
+	if _, ok := repeated.Next(); ok {
+		t.Fatal("repeat not exhausted")
+	}
+	once := core.OnceIter(9)
+	if value, ok := once.NextBack(); value != 9 || !ok {
+		t.Fatal(value, ok)
+	}
+	if _, ok := once.Next(); ok {
+		t.Fatal("once not exhausted")
+	}
+	if _, ok := core.EmptyIter[int]().NextBack(); ok {
+		t.Fatal("empty yielded an item")
+	}
+	forever := core.RepeatIter(7)
+	if forever.SizeHint() != core.Hint(core.MaxInt, -1) {
+		t.Fatal("infinite hint")
+	}
+	for index := 0; index < 10; index++ {
+		value, ok := forever.Next()
+		if !ok || value != 7 {
+			t.Fatal(value, ok)
+		}
+	}
+	calls := 0
+	iterate := core.NewIterate(1, func(value int) int { calls++; return value + 2 })
+	if calls != 0 {
+		t.Fatal("eager iterate")
+	}
+	value, ok := iterate.Next()
+	if !ok || value != 1 || calls != 1 {
+		t.Fatal(value, ok, calls)
+	}
+	unfold := core.NewUnfold(0, func(state *int) (int, bool) { *state++; return *state, *state%2 == 1 })
+	if value, ok := unfold.Next(); value != 1 || !ok {
+		t.Fatal(value, ok)
+	}
+	if _, ok := unfold.Next(); ok {
+		t.Fatal("expected intermittent end")
+	}
+	if value, ok := unfold.Next(); value != 3 || !ok {
+		t.Fatal("unfold must not fuse", value, ok)
+	}
+}
+
+func TestEitherOrBoth(t *testing.T) {
+	left := core.Left[int, string](1)
+	right := core.Right[int, string]("x")
+	both := core.Both(2, "y")
+	if !left.IsLeft() || left.IsBoth() || !left.HasLeft() || left.HasRight() || !right.IsRight() || !both.IsBoth() {
+		t.Fatal("variants")
+	}
+	if value, ok := both.JustLeft(); ok || value != 2 {
+		t.Fatal("just left")
+	}
+	if value, ok := both.Right(); !ok || value != "y" {
+		t.Fatal("right payload")
+	}
+	if value, ok := left.Left(); !ok || value != 1 {
+		t.Fatal("left payload")
+	}
+	if value, ok := right.JustRight(); !ok || value != "x" {
+		t.Fatal("just right")
+	}
+	if left.Or(3, "z") != (core.Pair[int, string]{First: 1, Second: "z"}) {
+		t.Fatal("or")
+	}
+	if value, ok := both.Flip().Left(); !ok || value != "y" {
+		t.Fatal("flip")
+	}
+	*left.RightOrInsert("new") = "changed"
+	if !left.IsBoth() {
+		t.Fatal("insert")
+	}
+	if value, ok := left.Right(); !ok || value != "changed" {
+		t.Fatal("insert payload")
+	}
+	if core.Reduce(core.Both(2, 3), func(a, b int) int { return a + b }) != 5 {
+		t.Fatal("reduce")
+	}
+	if pair, ok := both.Both(); !ok || pair.First != 2 || pair.Second != "y" {
+		t.Fatal("both payloads")
+	}
+}
