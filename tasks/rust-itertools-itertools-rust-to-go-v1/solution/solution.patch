+type RcIter[T any] struct{ state *rcState[T] }
+
+func NewRcIter[T any](it Iter[T]) *RcIter[T]  { return &RcIter[T]{&rcState[T]{it: it}} }
+func (iterator *RcIter[T]) Clone() *RcIter[T] { return &RcIter[T]{iterator.state} }
+func (iterator *RcIter[T]) Next() (T, bool) {
