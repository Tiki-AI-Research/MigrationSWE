+	same(t, calls, 4)
+	same(t, result.Min, "b")
+	same(t, result.Max, "cc")
+	comparisons := 0
+	itertools.MinmaxBy(source(1, 2, 3, 4, 5, 6), func(a, b int) int { comparisons++; return cmp.Compare(a, b) })
+	same(t, comparisons, 7)
+	it := source(1, 2, 3, 4)
+	folded := itertools.FoldWhile(it, 0, func(acc, value int) core.FoldWhile[int] {
+		if value == 3 {
+			return core.Done(acc)
+		}
+		return core.Continue(acc + value)
+	})
+	if !folded.IsDone() || folded.IntoInner() != 3 {
