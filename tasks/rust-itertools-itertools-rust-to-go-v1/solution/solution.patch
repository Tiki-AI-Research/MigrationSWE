+package itertools_test
+
+import (
+	"testing"
+	it "itertools"
+	"itertools/core"
+)
+
+type productRightCursor struct{ calls int }
+
+func (s *productRightCursor) Next() (int, bool) {
+	s.calls++
+	if s.calls == 2 {
+		return 7, true
+	}
+	return 0, false
+}
+func (s *productRightCursor) SizeHint() core.SizeHint { return core.Hint(0, -1) }
+func (s *productRightCursor) Clone() *productRightCursor {
+	clone := *s
+	return &clone
+}
+
+func TestCartesianProductRightResumption(t *testing.T) {
+	product := it.CartesianProduct(core.FromSlice([]int{10, 20}), &productRightCursor{})
+	for index := 0; index < 6; index++ {
+		value, ok := product.Next()
+		if ok != (index%2 == 1) || ok && (value.First != 10 || value.Second != 7) {
+			t.Fatalf("step %d: %v,%v", index, value, ok)
+		}
+	}
+}
