+package itertools
+
+import "itertools/core"
+
+func Concat[T any](it core.Iter[[]T]) []T {
+	values, ok := it.Next()
+	if !ok {
+		return nil
+	}
+	for {
+		value, ok := it.Next()
+		if !ok {
+			return values
+		}
+		values = append(values, value...)
+	}
+}
