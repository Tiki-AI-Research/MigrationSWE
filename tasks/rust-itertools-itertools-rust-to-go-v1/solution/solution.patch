+}
+func NextArray[T any](it core.Iter[T], n int) ([]T, bool) {
+	if n < 0 {
+		panic("negative array size")
+	}
+	values := make([]T, n)
+	for index := range values {
+		value, ok := it.Next()
+		if !ok {
+			return nil, false
+		}
+		values[index] = value
+	}
+	return values, true
+}
+func CollectArray[T any](it core.Iter[T], n int) ([]T, bool) {
+	values, ok := NextArray(it, n)
+	if !ok {
+		return nil, false
+	}
+	if _, extra := it.Next(); extra {
+		return nil, false
+	}
+	return values, true
+}
+func NextTuple[T any](it core.Iter[T], n int) ([]T, bool)    { return NextArray(it, n) }
+func CollectTuple[T any](it core.Iter[T], n int) ([]T, bool) { return CollectArray(it, n) }
+func Dropping[T any](it core.Iter[T], n int) core.Iter[T] {
+	for index := 0; index < n; index++ {
+		if _, ok := it.Next(); !ok {
+			break
+		}
+	}
+	return it
+}
+func DroppingBack[T any](it core.DoubleEnded[T], n int) core.DoubleEnded[T] {
+	for index := 0; index < n; index++ {
+		if _, ok := it.NextBack(); !ok {
+			break
+		}
+	}
+	return it
+}
