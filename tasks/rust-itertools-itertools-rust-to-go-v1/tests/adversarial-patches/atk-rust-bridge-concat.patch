+func TestRepairSelectionAndConversion(t *testing.T) {
+	nums := []int{6, 9, 1, 14, 0, 4, 8, 7, 11, 2, 10, 3, 13, 12, 5}
+
+	got := it.KSmallestBy[int](slice(nums...), 5, func(a, b int) bool {
+		if a%7 != b%7 {
+			return a%7 < b%7
+		}
+		return a < b
+	})
+	if !eq(got, []int{0, 7, 14, 1, 8}) {
+		t.Fatalf("k_smallest_by = %v", got)
+	}
+
+	key := func(n int) int { return (n%7)*1000 + n }
+	if got := it.KSmallestByKey[int, int](slice(nums...), 5, key); !eq(got, []int{0, 7, 14, 1, 8}) {
+		t.Fatalf("k_smallest_by_key = %v", got)
+	}
+	if got := it.KLargestByKey[int, int](slice(nums...), 5, key); !eq(got, []int{13, 6, 12, 5, 11}) {
+		t.Fatalf("k_largest_by_key = %v", got)
+	}
+
+	tc := it.TupleCombinations(slice(1, 2, 3, 4), 3)
+	var combos [][]int
+	for {
+		v, ok := tc.Next()
+		if !ok {
+			break
+		}
+		combos = append(combos, v)
+	}
+	want := [][]int{{1, 2, 3}, {1, 2, 4}, {1, 3, 4}, {2, 3, 4}}
+	if !reflect.DeepEqual(combos, want) {
+		t.Fatalf("tuple_combinations = %v", combos)
+	}
+
+	mi := it.MapInto[int, float64](slice(1, 2, 3), func(v int) float64 { return float64(v) })
+	if got := collect(mi); !reflect.DeepEqual(got, []float64{1, 2, 3}) {
+		t.Fatalf("map_into = %v", got)
+	}
+}
