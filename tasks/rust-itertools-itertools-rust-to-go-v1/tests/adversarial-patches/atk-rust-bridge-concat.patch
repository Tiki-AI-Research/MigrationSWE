@@ -0,0 +1,758 @@
+package itertools_test
+
+import (
+	"reflect"
+	"testing"
+
+	it "itertools"
+	"itertools/core"
+)
+
+func slice[T any](v ...T) *core.Slice[T] { return core.FromSlice(v) }
+
+func collect[T any](it core.Iter[T]) []T {
+	return it_(it)
+}
+
+func it_[T any](it core.Iter[T]) []T {
+	var out []T
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return out
+		}
+		out = append(out, v)
+	}
+}
+
+func eq(a, b []int) bool { return reflect.DeepEqual(a, b) }
+
+func TestInterleave(t *testing.T) {
+	got := collect(it.Interleave(slice(1, 2), slice(-1, -2)))
+	if !eq(got, []int{1, -1, 2, -2}) {
+		t.Fatalf("interleave = %v", got)
+	}
+}
+
+func TestInterleaveShortest(t *testing.T) {
+	// Rust yields one extra element from the longer input once the selected
+	// iterator is the shorter one, matching tests/test_std.rs.
+	got := collect(it.InterleaveShortest(slice(1, 2, 3), slice(-1, -2)))
+	if !eq(got, []int{1, -1, 2, -2, 3}) {
+		t.Fatalf("interleave_shortest = %v", got)
+	}
+	got2 := collect(it.InterleaveShortest(slice(0, 2, 4, 6, 8), slice(1, 3, 5)))
+	if !eq(got2, []int{0, 1, 2, 3, 4, 5, 6}) {
+		t.Fatalf("interleave_shortest2 = %v", got2)
+	}
+}
+
+func TestIntersperse(t *testing.T) {
+	got := collect(it.Intersperse(slice(1, 2, 3), 0))
+	if !eq(got, []int{1, 0, 2, 0, 3}) {
+		t.Fatalf("intersperse = %v", got)
+	}
+	empty := collect(it.Intersperse(slice[int](), 0))
+	if len(empty) != 0 {
+		t.Fatalf("intersperse empty = %v", empty)
+	}
+}
+
+func TestIntersperseSizeHint(t *testing.T) {
+	itr := it.Intersperse(slice(1, 2, 3), 0)
+	if h := itr.SizeHint(); h.Lower != 5 || h.Upper != 5 {
+		t.Fatalf("size hint = %+v", h)
+	}
+}
+
+func TestConcat(t *testing.T) {
+	got := it.Concat(slice([]int{1}, []int{2, 3}, []int{4, 5, 6}))
+	if !eq(got, []int{1, 2, 3, 4, 5, 6}) {
+		t.Fatalf("concat = %v", got)
+	}
+	if got := it.Concat[int](slice[[]int]()); got != nil {
+		t.Fatalf("concat empty = %v", got)
+	}
+}
+
+func TestAllEqualValue(t *testing.T) {
+	v, err := it.AllEqualValue(slice(3, 3, 3), func(a, b int) bool { return a == b })
+	if err != nil || v != 3 {
+		t.Fatalf("all equal = %v, %v", v, err)
+	}
+	_, err = it.AllEqualValue(slice[int](), func(a, b int) bool { return a == b })
+	if err == nil || err.Error() != "got zero elements when all elements were expected to be equal" {
+		t.Fatalf("zero error = %v", err)
+	}
+	_, err = it.AllEqualValue(slice(1, 2), func(a, b int) bool { return a == b })
+	if err == nil || err.Error() != "got different elements when all elements were expected to be equal" {
+		t.Fatalf("unequal error = %v", err)
+	}
+}
+
+func TestArrayWindows(t *testing.T) {
+	got := windowList(it.ArrayWindows(slice(1, 2, 3, 4, 5), 3))
+	want := [][]int{{1, 2, 3}, {2, 3, 4}, {3, 4, 5}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("array_windows = %v", got)
+	}
+	if got := windowList(it.ArrayWindows(slice(1, 2), 3)); len(got) != 0 {
+		t.Fatalf("too-short = %v", got)
+	}
+	zero := windowList(it.ArrayWindows(slice(1, 2, 3), 0))
+	if len(zero) != 4 {
+		t.Fatalf("zero window count = %d", len(zero))
+	}
+	for _, w := range zero {
+		if len(w) != 0 {
+			t.Fatalf("zero window not empty: %v", w)
+		}
+	}
+}
+
+func windowList(it2 *core.ArrayWindows[int]) [][]int {
+	var out [][]int
+	for {
+		w, ok := it2.Next()
+		if !ok {
+			return out
+		}
+		out = append(out, append([]int(nil), w...))
+	}
+}
+
+func TestCircularArrayWindows(t *testing.T) {
+	got := circularList(it.CircularArrayWindows(slice(1, 2, 3, 4), 3))
+	want := [][]int{{1, 2, 3}, {2, 3, 4}, {3, 4, 1}, {4, 1, 2}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("circular = %v", got)
+	}
+	// Short input wraps.
+	short := circularList(it.CircularArrayWindows(slice(1, 2), 3))
+	wantShort := [][]int{{1, 2, 1}, {2, 1, 2}}
+	if !reflect.DeepEqual(short, wantShort) {
+		t.Fatalf("circular short = %v", short)
+	}
+}
+
+func circularList(it2 *core.CircularArrayWindows[int]) [][]int {
+	var out [][]int
+	for {
+		w, ok := it2.Next()
+		if !ok {
+			return out
+		}
+		out = append(out, append([]int(nil), w...))
+	}
+}
+
+func TestMerge(t *testing.T) {
+	got := collect(it.Merge(slice(0, 3, 6, 9), slice(0, 5, 10)))
+	if !eq(got, []int{0, 0, 3, 5, 6, 9, 10}) {
+		t.Fatalf("merge = %v", got)
+	}
+}
+
+func TestMergeJoinBy(t *testing.T) {
+	got := it.MergeJoinBy(slice(0, 3, 6, 9), slice(0, 5, 10), func(a, b int) core.Ordering {
+		return core.OrderBy(a, b)
+	})
+	var out []core.EitherOrBoth[int, int]
+	for {
+		v, ok := got.Next()
+		if !ok {
+			break
+		}
+		out = append(out, v)
+	}
+	if len(out) != 6 {
+		t.Fatalf("merge_join_by len = %d: %v", len(out), out)
+	}
+	if !out[0].IsBoth() {
+		t.Fatalf("first should be Both: %v", out[0])
+	}
+	if !out[1].IsLeft() || !out[2].IsRight() {
+		t.Fatalf("merge_join_by middle = %v %v", out[1], out[2])
+	}
+}
+
+func TestKMerge(t *testing.T) {
+	got := collect(it.KMerge([]core.Iter[int]{slice(0, 2, 4), slice(1, 3, 5), slice(6, 7)}))
+	if !eq(got, []int{0, 1, 2, 3, 4, 5, 6, 7}) {
+		t.Fatalf("kmerge = %v", got)
+	}
+}
+
+func TestZipEqPanics(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Fatal("zip_eq did not panic")
+		}
+	}()
+	collect(it.ZipEq(slice(1, 2, 3), slice(1, 2)))
+}
+
+func TestZipLongest(t *testing.T) {
+	z := it.ZipLongest(slice(1, 2, 3), slice(10, 20))
+	var kinds []int
+	for {
+		v, ok := z.Next()
+		if !ok {
+			break
+		}
+		switch {
+		case v.IsBoth():
+			kinds = append(kinds, 0)
+		case v.IsLeft():
+			kinds = append(kinds, 1)
+		default:
+			kinds = append(kinds, 2)
+		}
+	}
+	if !reflect.DeepEqual(kinds, []int{0, 0, 1}) {
+		t.Fatalf("zip_longest kinds = %v", kinds)
+	}
+}
+
+func TestChunksPanicsOnZero(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Fatal("chunks(0) did not panic")
+		}
+	}()
+	it.Chunks(slice(1, 2, 3), 0)
+}
+
+func TestChunks(t *testing.T) {
+	c := it.Chunks(slice(1, 2, 3, 4, 5), 2)
+	var got [][]int
+	for {
+		v, ok := c.Next()
+		if !ok {
+			break
+		}
+		got = append(got, v)
+	}
+	want := [][]int{{1, 2}, {3, 4}, {5}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("chunks = %v", got)
+	}
+}
+
+func TestChunkBy(t *testing.T) {
+	c := it.ChunkBy(slice(1, 1, 2, 3, 3, 3), func(v int) int { return v })
+	var got [][]int
+	for {
+		v, ok := c.Next()
+		if !ok {
+			break
+		}
+		got = append(got, v)
+	}
+	want := [][]int{{1, 1}, {2}, {3, 3, 3}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("chunk_by = %v", got)
+	}
+}
+
+func TestDedup(t *testing.T) {
+	got := collect(it.Dedup(slice(1, 1, 2, 2, 2, 3, 1), func(a, b int) bool { return a == b }))
+	if !eq(got, []int{1, 2, 3, 1}) {
+		t.Fatalf("dedup = %v", got)
+	}
+}
+
+func TestDedupWithCount(t *testing.T) {
+	d := it.DedupWithCount(slice(1, 1, 2, 3, 3), func(a, b int) bool { return a == b })
+	var got []core.Pair[int, int]
+	for {
+		v, ok := d.Next()
+		if !ok {
+			break
+		}
+		got = append(got, v)
+	}
+	want := []core.Pair[int, int]{{First: 2, Second: 1}, {First: 1, Second: 2}, {First: 2, Second: 3}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("dedup_with_count = %v", got)
+	}
+}
+
+func TestExactlyOneRestores(t *testing.T) {
+	_, err := it.ExactlyOne(slice(2, 3, 4))
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	if err.Error() != "got at least 2 elements when exactly one was expected" {
+		t.Fatalf("error text = %q", err.Error())
+	}
+	restored := collect[int](err)
+	if !eq(restored, []int{2, 3, 4}) {
+		t.Fatalf("restored = %v", restored)
+	}
+
+	_, err = it.ExactlyOne(slice[int]())
+	if err == nil || err.Error() != "got zero elements when exactly one was expected" {
+		t.Fatalf("empty error = %v", err)
+	}
+	if got := collect[int](err); len(got) != 0 {
+		t.Fatalf("empty restored = %v", got)
+	}
+
+	v, err := it.ExactlyOne(slice(7))
+	if err != nil || v != 7 {
+		t.Fatalf("exactly one = %v, %v", v, err)
+	}
+}
+
+func TestFormatWithOneShot(t *testing.T) {
+	f := it.Format(slice(1, 2, 3), "-")
+	if s := f.String(); s != "1-2-3" {
+		t.Fatalf("format = %q", s)
+	}
+	defer func() {
+		if recover() == nil {
+			t.Fatal("second format did not panic")
+		}
+	}()
+	_ = f.String()
+}
+
+func TestLaziness(t *testing.T) {
+	calls := 0
+	m := it.Map(slice(1, 2, 3), func(v int) int { calls++; return v * 2 })
+	if calls != 0 {
+		t.Fatal("map is eager")
+	}
+	collect(m)
+	if calls != 3 {
+		t.Fatalf("calls = %d", calls)
+	}
+}
+
+func TestCombinationsOrder(t *testing.T) {
+	c := it.Combinations(slice(0, 1, 2, 3), 2)
+	var got [][]int
+	for {
+		v, ok := c.Next()
+		if !ok {
+			break
+		}
+		got = append(got, v)
+	}
+	want := [][]int{{0, 1}, {0, 2}, {0, 3}, {1, 2}, {1, 3}, {2, 3}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("combinations = %v", got)
+	}
+}
+
+func TestPermutationsOrder(t *testing.T) {
+	p := it.Permutations(slice(0, 1, 2), 2)
+	var got [][]int
+	for {
+		v, ok := p.Next()
+		if !ok {
+			break
+		}
+		got = append(got, v)
+	}
+	want := [][]int{{0, 1}, {0, 2}, {1, 0}, {1, 2}, {2, 0}, {2, 1}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("permutations = %v", got)
+	}
+}
+
+func TestPowerset(t *testing.T) {
+	p := it.Powerset(slice(0, 1, 2))
+	var got [][]int
+	for {
+		v, ok := p.Next()
+		if !ok {
+			break
+		}
+		got = append(got, v)
+	}
+	want := [][]int{{}, {0}, {1}, {2}, {0, 1}, {0, 2}, {1, 2}, {0, 1, 2}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("powerset = %v", got)
+	}
+}
+
+func TestUniqueDuplicates(t *testing.T) {
+	u := it.Unique(slice(1, 1, 2, 3, 2), func(v int) any { return v })
+	if got := collect(u); !eq(got, []int{1, 2, 3}) {
+		t.Fatalf("unique = %v", got)
+	}
+	d := it.Duplicates(slice(1, 1, 2, 3, 2, 2), func(v int) any { return v })
+	if got := collect(d); !eq(got, []int{1, 2}) {
+		t.Fatalf("duplicates = %v", got)
+	}
+}
+
+func TestMinmax(t *testing.T) {
+	r := it.Minmax(slice(3, 1, 4, 1, 5, 9, 2))
+	mn, mx, ok := r.IntoOption()
+	if !ok || mn != 1 || mx != 9 {
