+func TestRepairFilterMapOk(t *testing.T) {
+	in := slice(
+		core.Pair[int, error]{First: 22},
+		core.Pair[int, error]{Second: boomErr{}},
+		core.Pair[int, error]{First: 11},
+	)
+	fm := it.FilterMapOk[int, int](in, func(v int) (int, bool) {
+		if v > 20 {
+			return v * 2, true
+		}
+		return 0, false
+	})
+	var got []core.Pair[int, error]
+	for {
+		p, ok := fm.Next()
+		if !ok {
+			break
+		}
+		got = append(got, p)
+	}
+	if len(got) != 2 || got[0].Second != nil || got[0].First != 44 {
+		t.Fatalf("filter_map_ok = %v", got)
+	}
+	if got[1].Second == nil {
+		t.Fatalf("filter_map_ok lost error: %v", got)
+	}
+}
