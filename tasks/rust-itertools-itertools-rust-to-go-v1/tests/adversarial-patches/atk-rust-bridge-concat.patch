+package core
+
+// Pair is a two-element tuple yielded by zip-like adaptors.
+type Pair[A, B any] struct {
+	First  A
+	Second B
+}
+
+// ---------------------------------------------------------------------------
+// Interleave
+// ---------------------------------------------------------------------------
+
+// Interleave alternates elements from two iterators until both run out.
+type Interleave[T any] struct {
+	i, j         Iter[T]
+	nextFromJ    bool
+	iDone, jDone bool
+}
+
+// NewInterleave builds an Interleave adaptor.
+func NewInterleave[T any](i, j Iter[T]) *Interleave[T] {
+	return &Interleave[T]{i: i, j: j}
+}
+
+// Next implements Iter.
+func (a *Interleave[T]) Next() (T, bool) {
+	a.nextFromJ = !a.nextFromJ
+	if a.nextFromJ {
+		if v, ok := a.i.Next(); ok {
+			return v, true
+		}
+		return a.j.Next()
+	}
+	if v, ok := a.j.Next(); ok {
+		return v, true
+	}
+	return a.i.Next()
+}
+
+// SizeHint implements Iter.
+func (a *Interleave[T]) SizeHint() SizeHint { return Add(a.i.SizeHint(), a.j.SizeHint()) }
+
+// InterleaveShortest alternates until the shorter input is exhausted.
+type InterleaveShortest[T any] struct {
+	i, j      Iter[T]
+	nextFromJ bool
+}
+
+// NewInterleaveShortest builds an InterleaveShortest adaptor.
+func NewInterleaveShortest[T any](i, j Iter[T]) *InterleaveShortest[T] {
+	return &InterleaveShortest[T]{i: i, j: j}
+}
+
+// Next implements Iter.
+func (a *InterleaveShortest[T]) Next() (T, bool) {
+	var v T
+	var ok bool
+	if a.nextFromJ {
+		v, ok = a.j.Next()
+	} else {
+		v, ok = a.i.Next()
+	}
+	if ok {
+		a.nextFromJ = !a.nextFromJ
+		return v, true
+	}
+	var zero T
+	return zero, false
+}
+
+// SizeHint implements Iter.
+func (a *InterleaveShortest[T]) SizeHint() SizeHint {
+	curr, next := a.i.SizeHint(), a.j.SizeHint()
+	if a.nextFromJ {
+		curr, next = next, curr
+	}
+	combined := MulScalar(Min(curr, next), 2)
+	lower := combined.Lower
+	if curr.Lower > next.Lower {
+		lower++
+	}
+	upper := combined.Upper
+	// Mirror Rust: (_, None) => false; (None, Some(_)) => true;
+	// (Some(curr_max), Some(next_max)) => curr_max > next_max.
+	extra := false
+	switch {
+	case !next.Bounded():
+		extra = false
+	case !curr.Bounded():
+		extra = true
+	default:
+		extra = curr.Upper > next.Upper
+	}
+	if extra && upper >= 0 {
+		upper++
+	}
+	return Hint(lower, upper)
+}
+
+// ---------------------------------------------------------------------------
+// Intersperse
+// ---------------------------------------------------------------------------
+
+// IntersperseWith inserts elements produced by gen between each element.
+type IntersperseWith[T any] struct {
+	gen       func() T
+	it        Iter[T]
+	state     int // 0=None, 1=Some(None), 2=Some(Some)
+	peeked    T
+	exhausted bool
+}
+
+// NewIntersperseWith builds an IntersperseWith adaptor.
+func NewIntersperseWith[T any](it Iter[T], gen func() T) *IntersperseWith[T] {
+	return &IntersperseWith[T]{gen: gen, it: it}
+}
+
+// Next implements Iter.
+func (a *IntersperseWith[T]) Next() (T, bool) {
+	switch a.state {
+	case 2:
+		a.state = 1
+		return a.peeked, true
+	case 1:
+		v, ok := a.it.Next()
+		if !ok {
+			var zero T
+			return zero, false
+		}
+		a.peeked = v
+		a.state = 2
+		return a.gen(), true
+	default:
+		a.state = 1
+		return a.it.Next()
+	}
+}
+
+// SizeHint implements Iter.
+func (a *IntersperseWith[T]) SizeHint() SizeHint {
+	sh := a.it.SizeHint()
+	sh = Add(sh, sh)
+	switch a.state {
+	case 2:
+		return AddScalar(sh, 1)
+	case 1:
+		return sh
+	default:
+		return SubScalar(sh, 1)
+	}
+}
+
+// Intersperse inserts a fixed element between each element.
+type Intersperse[T any] struct {
+	*IntersperseWith[T]
+}
+
+// NewIntersperse builds an Intersperse adaptor.
+func NewIntersperse[T any](it Iter[T], elt T) *Intersperse[T] {
+	return &Intersperse[T]{NewIntersperseWith(it, func() T { return elt })}
+}
+
+// ---------------------------------------------------------------------------
+// Map / Filter / FilterMap
+// ---------------------------------------------------------------------------
+
+// Map applies f to each element.
+type Map[T, U any] struct {
+	it Iter[T]
+	f  func(T) U
+}
+
+// NewMap builds a Map adaptor.
+func NewMap[T, U any](it Iter[T], f func(T) U) *Map[T, U] {
+	return &Map[T, U]{it: it, f: f}
+}
+
+// Next implements Iter.
+func (m *Map[T, U]) Next() (U, bool) {
+	v, ok := m.it.Next()
+	if !ok {
+		var zero U
+		return zero, false
+	}
+	return m.f(v), true
+}
+
+// SizeHint implements Iter.
+func (m *Map[T, U]) SizeHint() SizeHint { return m.it.SizeHint() }
+
+// NextBack implements DoubleEnded when the underlying iterator supports it.
+func (m *Map[T, U]) NextBack() (U, bool) {
+	de, ok := m.it.(DoubleEnded[T])
+	if !ok {
+		var zero U
+		return zero, false
+	}
+	v, ok := de.NextBack()
+	if !ok {
+		var zero U
+		return zero, false
+	}
+	return m.f(v), true
+}
+
+// Filter keeps elements matching pred.
+type Filter[T any] struct {
+	it   Iter[T]
+	pred func(T) bool
+}
+
+// NewFilter builds a Filter adaptor.
+func NewFilter[T any](it Iter[T], pred func(T) bool) *Filter[T] {
+	return &Filter[T]{it: it, pred: pred}
+}
+
+// Next implements Iter.
+func (m *Filter[T]) Next() (T, bool) {
+	for {
+		v, ok := m.it.Next()
+		if !ok {
+			var zero T
+			return zero, false
+		}
+		if m.pred(v) {
+			return v, true
+		}
+	}
+}
+
+// SizeHint implements Iter.
+func (m *Filter[T]) SizeHint() SizeHint {
+	h := m.it.SizeHint()
+	return Hint(0, h.Upper)
+}
+
+// FilterMap applies f, keeping only successful results.
+type FilterMap[T, U any] struct {
+	it Iter[T]
+	f  func(T) (U, bool)
+}
+
+// NewFilterMap builds a FilterMap adaptor.
+func NewFilterMap[T, U any](it Iter[T], f func(T) (U, bool)) *FilterMap[T, U] {
+	return &FilterMap[T, U]{it: it, f: f}
+}
+
+// Next implements Iter.
+func (m *FilterMap[T, U]) Next() (U, bool) {
+	for {
+		v, ok := m.it.Next()
+		if !ok {
+			var zero U
+			return zero, false
+		}
+		if u, keep := m.f(v); keep {
+			return u, true
+		}
+	}
+}
+
+// SizeHint implements Iter.
+func (m *FilterMap[T, U]) SizeHint() SizeHint {
+	h := m.it.SizeHint()
+	return Hint(0, h.Upper)
+}
+
+// Enumerate yields (index, element) pairs starting at 0.
+type Enumerate[T any] struct {
+	it Iter[T]
+	n  int
+}
+
+// NewEnumerate builds an Enumerate adaptor.
+func NewEnumerate[T any](it Iter[T]) *Enumerate[T] { return &Enumerate[T]{it: it} }
+
+// Next implements Iter.
+func (m *Enumerate[T]) Next() (Pair[int, T], bool) {
+	v, ok := m.it.Next()
+	if !ok {
+		return Pair[int, T]{}, false
+	}
+	p := Pair[int, T]{First: m.n, Second: v}
+	m.n++
+	return p, true
+}
+
+// SizeHint implements Iter.
+func (m *Enumerate[T]) SizeHint() SizeHint { return m.it.SizeHint() }
+
+// ---------------------------------------------------------------------------
+// Rev
+// ---------------------------------------------------------------------------
+
+// Rev reverses a double-ended iterator.
+type Rev[T any] struct{ it DoubleEnded[T] }
+
+// NewRev builds a Rev adaptor.
+func NewRev[T any](it DoubleEnded[T]) *Rev[T] { return &Rev[T]{it: it} }
+
+// Next implements Iter.
+func (r *Rev[T]) Next() (T, bool) { return r.it.NextBack() }
+
+// SizeHint implements Iter.
+func (r *Rev[T]) SizeHint() SizeHint { return r.it.SizeHint() }
+
+// ---------------------------------------------------------------------------
+// Chain
+// ---------------------------------------------------------------------------
+
+// Chain concatenates two iterators in order.
+type Chain[T any] struct {
+	a, b     Iter[T]
+	firstDel bool
+}
+
+// NewChain builds a two-input Chain.
+func NewChain[T any](a, b Iter[T]) *Chain[T] { return &Chain[T]{a: a, b: b} }
+
+// Next implements Iter.
+func (c *Chain[T]) Next() (T, bool) {
+	if !c.firstDel {
+		if v, ok := c.a.Next(); ok {
+			return v, true
+		}
+		c.firstDel = true
+	}
+	return c.b.Next()
+}
+
+// SizeHint implements Iter.
+func (c *Chain[T]) SizeHint() SizeHint {
+	if c.firstDel {
+		return c.b.SizeHint()
+	}
+	return Add(c.a.SizeHint(), c.b.SizeHint())
+}
+
+// ChainMany concatenates a sequence of iterators of the same element type.
+type ChainMany[T any] struct {
+	parts []Iter[T]
+	idx   int
+}
+
+// NewChainMany builds a variadic chain.
+func NewChainMany[T any](parts ...Iter[T]) *ChainMany[T] {
+	return &ChainMany[T]{parts: parts}
+}
+
+// Next implements Iter.
+func (c *ChainMany[T]) Next() (T, bool) {
+	for c.idx < len(c.parts) {
+		if v, ok := c.parts[c.idx].Next(); ok {
+			return v, true
+		}
+		c.idx++
+	}
+	var zero T
+	return zero, false
+}
+
+// SizeHint implements Iter.
+func (c *ChainMany[T]) SizeHint() SizeHint {
+	h := Hint(0, 0)
+	for i := c.idx; i < len(c.parts); i++ {
+		h = Add(h, c.parts[i].SizeHint())
+	}
+	return h
+}
+
+// ---------------------------------------------------------------------------
+// Peekable / MultiPeek
+// ---------------------------------------------------------------------------
+
+// Peekable allows looking at the next element without consuming it.
+type Peekable[T any] struct {
+	it     Iter[T]
+	peeked T
+	has    bool
+}
+
+// NewPeekable builds a Peekable adaptor.
+func NewPeekable[T any](it Iter[T]) *Peekable[T] { return &Peekable[T]{it: it} }
+
+// Peek returns the next element without consuming it.
+func (p *Peekable[T]) Peek() (T, bool) {
+	if !p.has {
+		v, ok := p.it.Next()
+		if !ok {
+			var zero T
+			return zero, false
+		}
+		p.peeked = v
+		p.has = true
+	}
+	return p.peeked, true
+}
+
+// Next implements Iter.
+func (p *Peekable[T]) Next() (T, bool) {
+	if p.has {
+		p.has = false
+		return p.peeked, true
+	}
+	return p.it.Next()
+}
+
+// SizeHint implements Iter.
+func (p *Peekable[T]) SizeHint() SizeHint {
+	extra := 0
+	if p.has {
+		extra = 1
+	}
+	return AddScalar(p.it.SizeHint(), extra)
+}
+
+// MultiPeek allows repeatedly peeking ahead without advancing.
+type MultiPeek[T any] struct {
+	it     Iter[T]
+	buffer []T
+	idx    int
+	done   bool
+}
+
+// NewMultiPeek builds a MultiPeek adaptor.
+func NewMultiPeek[T any](it Iter[T]) *MultiPeek[T] { return &MultiPeek[T]{it: it} }
+
+// Peek returns the element at the current peek offset and advances the offset.
+func (m *MultiPeek[T]) Peek() (T, bool) {
+	if m.idx < len(m.buffer) {
+		v := m.buffer[m.idx]
+		m.idx++
+		return v, true
+	}
+	if m.done {
+		var zero T
+		return zero, false
+	}
+	v, ok := m.it.Next()
+	if !ok {
+		m.done = true
+		var zero T
+		return zero, false
+	}
+	m.buffer = append(m.buffer, v)
+	m.idx++
+	return v, true
+}
+
+// ResetPeek resets the peek cursor to the start of the buffer.
+func (m *MultiPeek[T]) ResetPeek() { m.idx = 0 }
+
+// Next implements Iter.
+func (m *MultiPeek[T]) Next() (T, bool) {
+	if len(m.buffer) > 0 {
+		v := m.buffer[0]
+		m.buffer = m.buffer[1:]
+		if m.idx > 0 {
+			m.idx--
+		}
+		return v, true
+	}
+	return m.it.Next()
+}
+
+// SizeHint implements Iter.
+func (m *MultiPeek[T]) SizeHint() SizeHint {
+	return AddScalar(m.it.SizeHint(), len(m.buffer))
+}
+
+// ---------------------------------------------------------------------------
+// TakeWhileInclusive
+// ---------------------------------------------------------------------------
+
+// TakeWhileInclusive consumes until pred first returns false, including that element.
+type TakeWhileInclusive[T any] struct {
+	it   Iter[T]
+	pred func(T) bool
+	done bool
+}
+
+// NewTakeWhileInclusive builds a TakeWhileInclusive adaptor.
+func NewTakeWhileInclusive[T any](it Iter[T], pred func(T) bool) *TakeWhileInclusive[T] {
+	return &TakeWhileInclusive[T]{it: it, pred: pred}
+}
+
+// Next implements Iter.
+func (a *TakeWhileInclusive[T]) Next() (T, bool) {
+	if a.done {
+		var zero T
+		return zero, false
+	}
+	v, ok := a.it.Next()
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	if !a.pred(v) {
+		a.done = true
+	}
+	return v, true
+}
+
+// SizeHint implements Iter.
+func (a *TakeWhileInclusive[T]) SizeHint() SizeHint {
+	if a.done {
+		return Hint(0, 0)
+	}
+	return Hint(0, a.it.SizeHint().Upper)
+}
+
+// ---------------------------------------------------------------------------
+// WithPosition
+// ---------------------------------------------------------------------------
+
+// Position describes the location of an element.
+type Position struct {
+	IsFirst bool
+	IsLast  bool
+}
+
+// IsExactlyOne reports whether the element is both first and last.
+func (p Position) IsExactlyOne() bool { return p.IsFirst && p.IsLast }
+
+// IsMiddle reports whether the element is neither first nor last.
+func (p Position) IsMiddle() bool { return !p.IsFirst && !p.IsLast }
+
+// WithPosition wraps each element together with its Position.
+type WithPosition[T any] struct {
+	it           *Peekable[T]
+	handledFirst bool
+	done         bool
+}
+
+// NewWithPosition builds a WithPosition adaptor.
+func NewWithPosition[T any](it Iter[T]) *WithPosition[T] {
+	return &WithPosition[T]{it: NewPeekable(it)}
+}
+
+// Next implements Iter.
+func (a *WithPosition[T]) Next() (Pair[Position, T], bool) {
+	v, ok := a.it.Next()
+	if !ok {
+		return Pair[Position, T]{}, false
+	}
+	_, more := a.it.Peek()
+	isFirst := !a.handledFirst
+	a.handledFirst = true
+	return Pair[Position, T]{First: Position{IsFirst: isFirst, IsLast: !more}, Second: v}, true
+}
+
+// SizeHint implements Iter.
+func (a *WithPosition[T]) SizeHint() SizeHint { return a.it.SizeHint() }
+
+// ---------------------------------------------------------------------------
+// PutBack
+// ---------------------------------------------------------------------------
+
+// PutBack allows pushing a single element back onto the front.
+type PutBack[T any] struct {
+	top  *T
+	it   Iter[T]
+	done bool
+}
+
+// NewPutBack builds a PutBack adaptor.
+func NewPutBack[T any](it Iter[T]) *PutBack[T] { return &PutBack[T]{it: it} }
+
+// PutBack pushes x to the front, returning any element already held.
+func (p *PutBack[T]) PutBack(x T) (T, bool) {
+	var old T
+	had := p.top != nil
+	if had {
+		old = *p.top
+	}
+	xx := x
+	p.top = &xx
+	return old, had
+}
+
+// Next implements Iter.
+func (p *PutBack[T]) Next() (T, bool) {
+	if p.top != nil {
+		v := *p.top
+		p.top = nil
+		return v, true
+	}
+	return p.it.Next()
+}
+
+// SizeHint implements Iter.
+func (p *PutBack[T]) SizeHint() SizeHint {
+	extra := 0
+	if p.top != nil {
+		extra = 1
+	}
+	return AddScalar(p.it.SizeHint(), extra)
+}
+
+// PeekNth allows looking several elements ahead without advancing. Repeated
+// peeks return the same value until Next is called.
+type PeekNth[T any] struct {
+	it  Iter[T]
+	buf []T
+}
+
+// NewPeekNth builds a PeekNth adaptor.
+func NewPeekNth[T any](it Iter[T]) *PeekNth[T] { return &PeekNth[T]{it: it} }
+
+// PeekNth returns the element n positions ahead without advancing the cursor.
+func (p *PeekNth[T]) PeekNth(n int) (T, bool) {
+	for len(p.buf) <= n {
+		v, ok := p.it.Next()
+		if !ok {
+			break
+		}
+		p.buf = append(p.buf, v)
+	}
+	if n < len(p.buf) {
+		return p.buf[n], true
+	}
+	var zero T
+	return zero, false
+}
+
+// Peek returns the next element without consuming it.
+func (p *PeekNth[T]) Peek() (T, bool) { return p.PeekNth(0) }
+
+// Next implements Iter.
+func (p *PeekNth[T]) Next() (T, bool) {
+	if len(p.buf) > 0 {
+		v := p.buf[0]
+		p.buf = p.buf[1:]
+		return v, true
+	}
+	return p.it.Next()
+}
+
+// SizeHint implements Iter.
+func (p *PeekNth[T]) SizeHint() SizeHint {
+	return AddScalar(p.it.SizeHint(), len(p.buf))
+}
+
+// PutBackN allows pushing multiple elements back to the front.
+type PutBackN[T any] struct {
+	it  Iter[T]
+	top []T
+}
+
+// NewPutBackN builds a PutBackN adaptor.
+func NewPutBackN[T any](it Iter[T]) *PutBackN[T] { return &PutBackN[T]{it: it} }
+
+// PutBack pushes x to the front; the most recently pushed is yielded first.
+func (p *PutBackN[T]) PutBack(x T) { p.top = append(p.top, x) }
+
+// Next implements Iter.
+func (p *PutBackN[T]) Next() (T, bool) {
+	if len(p.top) > 0 {
+		v := p.top[len(p.top)-1]
+		p.top = p.top[:len(p.top)-1]
+		return v, true
+	}
+	return p.it.Next()
+}
+
+// SizeHint implements Iter.
+func (p *PutBackN[T]) SizeHint() SizeHint {
+	return AddScalar(p.it.SizeHint(), len(p.top))
+}
+
+// ---------------------------------------------------------------------------
+// Coalesce / Dedup
+// ---------------------------------------------------------------------------
+
+// CoalescePredicate combines an accumulated value with the next element.
+type CoalescePredicate[T any] func(accum T, item T) (T, bool)
+
+// Coalesce joins adjacent elements per the predicate.
+type Coalesce[T any] struct {
+	it          Iter[T]
+	f           CoalescePredicate[T]
+	last        *T
+	initialized bool
+}
+
+// NewCoalesce builds a Coalesce adaptor.
+func NewCoalesce[T any](it Iter[T], f CoalescePredicate[T]) *Coalesce[T] {
+	return &Coalesce[T]{it: it, f: f}
+}
+
+// Next implements Iter.
+func (c *Coalesce[T]) Next() (T, bool) {
+	var init T
+	if c.last != nil {
+		init = *c.last
+		c.last = nil
+	} else {
+		v, ok := c.it.Next()
+		if !ok {
+			c.initialized = true
+			var zero T
+			return zero, false
+		}
+		init = v
+	}
+	for {
+		v, ok := c.it.Next()
+		if !ok {
+			c.initialized = true
+			return init, true
+		}
+		joined, ok2 := c.f(init, v)
+		if ok2 {
+			init = joined
+			continue
+		}
+		vv := v
+		c.last = &vv
+		return init, true
+	}
+}
+
+// SizeHint implements Iter.
+func (c *Coalesce[T]) SizeHint() SizeHint {
+	extra := 0
+	if c.last != nil {
+		extra = 1
+	}
+	h := AddScalar(c.it.SizeHint(), extra)
+	if h.Lower > 0 {
+		return Hint(1, h.Upper)
+	}
+	return Hint(0, h.Upper)
+}
+
+// Dedup removes runs of consecutive equal elements.
+type Dedup[T any] struct {
+	it  Iter[T]
+	eq  func(a, b T) bool
+	buf []T
+}
+
+// NewDedup builds a Dedup adaptor using eq for equality.
+func NewDedup[T any](it Iter[T], eq func(a, b T) bool) *Dedup[T] {
+	return &Dedup[T]{it: it, eq: eq}
+}
+
+// Next implements Iter.
+func (d *Dedup[T]) Next() (T, bool) {
+	var last T
+	if len(d.buf) > 0 {
+		last = d.buf[0]
+		d.buf = d.buf[1:]
+	} else {
+		v, ok := d.it.Next()
+		if !ok {
+			var zero T
+			return zero, false
+		}
+		last = v
+	}
+	for {
+		v, ok := d.it.Next()
+		if !ok {
+			return last, true
+		}
+		if d.eq(last, v) {
+			continue
+		}
+		d.buf = append(d.buf, v)
+		return last, true
+	}
+}
+
+// SizeHint implements Iter.
+func (d *Dedup[T]) SizeHint() SizeHint {
+	extra := len(d.buf)
+	h := AddScalar(d.it.SizeHint(), extra)
+	if h.Lower > 0 {
+		return Hint(1, h.Upper)
+	}
+	return Hint(0, h.Upper)
+}
+
+// DedupWithCount removes runs of consecutive equal elements, yielding (count, value).
+type DedupWithCount[T any] struct {
+	it  Iter[T]
+	eq  func(a, b T) bool
+	buf []Pair[int, T]
+}
+
+// NewDedupWithCount builds a DedupWithCount adaptor.
+func NewDedupWithCount[T any](it Iter[T], eq func(a, b T) bool) *DedupWithCount[T] {
+	return &DedupWithCount[T]{it: it, eq: eq}
+}
+
+// Next implements Iter.
+func (d *DedupWithCount[T]) Next() (Pair[int, T], bool) {
+	var last Pair[int, T]
+	if len(d.buf) > 0 {
+		last = d.buf[0]
+		d.buf = d.buf[1:]
+	} else {
+		v, ok := d.it.Next()
+		if !ok {
+			return Pair[int, T]{}, false
+		}
+		last = Pair[int, T]{First: 1, Second: v}
+	}
+	for {
+		v, ok := d.it.Next()
+		if !ok {
+			return last, true
+		}
+		if d.eq(last.Second, v) {
+			last.First++
+			continue
+		}
+		d.buf = append(d.buf, Pair[int, T]{First: 1, Second: v})
+		return last, true
+	}
+}
+
+// SizeHint implements Iter.
+func (d *DedupWithCount[T]) SizeHint() SizeHint {
+	extra := len(d.buf)
+	h := AddScalar(d.it.SizeHint(), extra)
+	if h.Lower > 0 {
+		return Hint(1, h.Upper)
+	}
+	return Hint(0, h.Upper)
+}
+
+// ---------------------------------------------------------------------------
+// Batching / PadUsing / WhileSome / Positions / Update
+// ---------------------------------------------------------------------------
+
+// Batching yields the result of applying f to the underlying iterator.
+type Batching[T, B any] struct {
+	it Iter[T]
+	f  func(Iter[T]) (B, bool)
+}
+
+// NewBatching builds a Batching adaptor.
+func NewBatching[T, B any](it Iter[T], f func(Iter[T]) (B, bool)) *Batching[T, B] {
+	return &Batching[T, B]{it: it, f: f}
+}
+
+// Next implements Iter.
+func (b *Batching[T, B]) Next() (B, bool) { return b.f(b.it) }
+
+// SizeHint implements Iter.
+func (b *Batching[T, B]) SizeHint() SizeHint { return Hint(0, -1) }
+
+// PadUsing pads an iterator to a minimum length using filler.
+type PadUsing[T any] struct {
+	it           Iter[T]
+	fromNext     int
+	fromNextBack int
+	required     int
+	filler       func(int) T
+}
+
+// NewPadUsing builds a PadUsing adaptor.
+func NewPadUsing[T any](it Iter[T], required int, filler func(int) T) *PadUsing[T] {
+	return &PadUsing[T]{it: it, required: required, filler: filler}
+}
+
+// Next implements Iter.
+func (p *PadUsing[T]) Next() (T, bool) {
+	total := p.fromNext + p.fromNextBack
+	if total >= p.required {
+		return p.it.Next()
+	}
+	if v, ok := p.it.Next(); ok {
+		p.fromNext++
+		return v, true
+	}
+	v := p.filler(p.fromNext)
+	p.fromNext++
+	return v, true
+}
+
+// SizeHint implements Iter.
+func (p *PadUsing[T]) SizeHint() SizeHint {
+	total := p.fromNext + p.fromNextBack
+	if total >= p.required {
+		return p.it.SizeHint()
+	}
+	remaining := p.required - total
+	h := p.it.SizeHint()
+	lo := h.Lower
+	if remaining > lo {
+		lo = remaining
+	}
+	hi := h.Upper
+	if hi >= 0 && remaining > hi {
+		hi = remaining
+	}
+	return Hint(lo, hi)
+}
+
+// WhileSome yields the elements of an Option-like iterator until the first miss.
+// Values are represented as (value, ok) pairs.
+type WhileSome[T any] struct {
+	it   Iter[Pair[T, bool]]
+	done bool
+}
+
+// NewWhileSome builds a WhileSome adaptor over (value, ok) pairs.
+func NewWhileSome[T any](it Iter[Pair[T, bool]]) *WhileSome[T] {
+	return &WhileSome[T]{it: it}
+}
+
+// Next implements Iter.
+func (w *WhileSome[T]) Next() (T, bool) {
+	if w.done {
+		var zero T
+		return zero, false
+	}
+	pr, ok := w.it.Next()
+	if !ok || !pr.Second {
+		w.done = true
+		var zero T
+		return zero, false
+	}
+	return pr.First, true
+}
+
+// SizeHint implements Iter.
+func (w *WhileSome[T]) SizeHint() SizeHint {
+	if w.done {
+		return Hint(0, 0)
+	}
+	return Hint(0, w.it.SizeHint().Upper)
+}
diff --git a/core/combinations.go b/core/combinations.go
new file mode 100644
index 0000000..82c2a86
--- /dev/null
+++ b/core/combinations.go
@@ -0,0 +1,537 @@
+//go:build !noalloc
+
+package core
+
+import "math/big"
+
+// Binom returns the binomial coefficient C(n,k) and whether it fits in an int.
+func Binom(n, k int) (int, bool) {
+	if n < k || k < 0 {
+		return 0, true
+	}
+	if k > n-k {
+		k = n - k
+	}
+	z := big.NewInt(1)
+	for i := 1; i <= k; i++ {
+		z.Mul(z, big.NewInt(int64(n-k+i)))
+		z.Div(z, big.NewInt(int64(i)))
+	}
+	if !z.IsInt64() {
+		return 0, false
+	}
+	v := z.Int64()
+	if int64(int(v)) != v {
+		return 0, false
+	}
+	return int(v), true
+}
+
+// ---------------------------------------------------------------------------
+// Combinations
+// ---------------------------------------------------------------------------
+
+// Combinations yields all k-length combinations of the pool in lexicographic
+// order.
+type Combinations[T any] struct {
+	pool    *LazyBuffer[T]
+	indices []int
+	first   bool
+	done    bool
+}
+
+// NewCombinations builds a Combinations adaptor.
+func NewCombinations[T any](it Iter[T], k int) *Combinations[T] {
+	indices := make([]int, k)
+	for i := range indices {
+		indices[i] = i
+	}
+	return &Combinations[T]{pool: NewLazyBuffer(it), indices: indices, first: true}
+}
+
+// K returns the combination length.
+func (c *Combinations[T]) K() int { return len(c.indices) }
+
+// N returns the current pool length.
+func (c *Combinations[T]) N() int { return c.pool.Len() }
+
+func (c *Combinations[T]) init() bool {
+	c.pool.Prefill(c.K())
+	done := c.K() > c.pool.Len()
+	if !done {
+		c.first = false
+	}
+	return done
+}
+
+func (c *Combinations[T]) increment() bool {
+	indices := c.indices
+	if len(indices) == 0 {
+		return true
+	}
+	i := len(indices) - 1
+	if indices[i] == c.pool.Len()-1 {
+		c.pool.GetNext()
+	}
+	for indices[i] == i+c.pool.Len()-len(indices) {
+		if i > 0 {
+			i--
+		} else {
+			return true
+		}
+	}
+	indices[i]++
+	for j := i + 1; j < len(indices); j++ {
+		indices[j] = indices[j-1] + 1
+	}
+	return false
+}
+
+func (c *Combinations[T]) extract() []T {
+	out := make([]T, len(c.indices))
+	for i, idx := range c.indices {
+		out[i] = c.pool.At(idx)
+	}
+	return out
+}
+
+// Next implements Iter.
+func (c *Combinations[T]) Next() ([]T, bool) {
+	if c.done {
+		return nil, false
+	}
+	var done bool
+	if c.first {
+		done = c.init()
+	} else {
+		done = c.increment()
+	}
+	if done {
+		c.done = true
+		return nil, false
+	}
+	return c.extract(), true
+}
+
+// Reset reinitialises the combination iterator for a new length k.
+func (c *Combinations[T]) Reset(k int) {
+	c.first = true
+	c.done = false
+	if k < len(c.indices) {
+		c.indices = c.indices[:k]
+		for i := 0; i < k; i++ {
+			c.indices[i] = i
+		}
+	} else {
+		for i := range c.indices {
+			c.indices[i] = i
+		}
+		for i := len(c.indices); i < k; i++ {
+			c.indices = append(c.indices, i)
+		}
+		c.pool.Prefill(k)
+	}
+}
+
+// SizeHint implements Iter.
+func (c *Combinations[T]) SizeHint() SizeHint {
+	lo, up := c.pool.SizeHint().Lower, c.pool.SizeHint().Upper
+	rl, ok1 := remainingCombos(lo, c.first, c.indices)
+	lower := rl
+	if !ok1 {
+		lower = 1 << 62
+	}
+	upper := -1
+	if up >= 0 {
+		if ru, ok2 := remainingCombos(up, c.first, c.indices); ok2 {
+			upper = ru
+		}
+	}
+	return Hint(lower, upper)
+}
+
+func remainingCombos(n int, first bool, indices []int) (int, bool) {
+	k := len(indices)
+	if n < k {
+		return 0, true
+	}
+	if first {
+		return Binom(n, k)
+	}
+	sum := 0
+	for i, n0 := range indices {
+		v, ok := Binom(n-1-n0, k-i)
+		if !ok {
+			return 0, false
+		}
+		if sum > (1<<62)-v {
+			return 0, false
+		}
+		sum += v
+	}
+	return sum, true
+}
+
+// ---------------------------------------------------------------------------
+// CombinationsWithReplacement
+// ---------------------------------------------------------------------------
+
+// CombinationsWithReplacement yields all k-length combinations with
+// replacement in lexicographic order.
+type CombinationsWithReplacement[T any] struct {
+	pool    *LazyBuffer[T]
+	indices []int
+	first   bool
+	done    bool
+}
+
+// NewCombinationsWithReplacement builds a CombinationsWithReplacement adaptor.
+func NewCombinationsWithReplacement[T any](it Iter[T], k int) *CombinationsWithReplacement[T] {
+	return &CombinationsWithReplacement[T]{pool: NewLazyBuffer(it), indices: make([]int, k), first: true}
+}
+
+// Next implements Iter.
+func (c *CombinationsWithReplacement[T]) Next() ([]T, bool) {
+	if c.done {
+		return nil, false
+	}
+	if c.first {
+		if len(c.indices) != 0 && !c.pool.GetNext() {
+			c.done = true
+			return nil, false
+		}
+		c.first = false
+	} else if c.increment() {
+		c.done = true
+		return nil, false
+	}
+	out := make([]T, len(c.indices))
+	for i, idx := range c.indices {
+		out[i] = c.pool.At(idx)
+	}
+	return out, true
+}
+
+func (c *CombinationsWithReplacement[T]) increment() bool {
+	c.pool.GetNext()
+	increment := -1
+	incrementVal := 0
+	for i := len(c.indices) - 1; i >= 0; i-- {
+		if c.indices[i] < c.pool.Len()-1 {
+			increment = i
+			incrementVal = c.indices[i] + 1
+			break
+		}
+	}
+	if increment < 0 {
+		return true
+	}
+	for j := increment; j < len(c.indices); j++ {
+		c.indices[j] = incrementVal
+	}
+	return false
+}
+
+// SizeHint implements Iter.
+func (c *CombinationsWithReplacement[T]) SizeHint() SizeHint {
+	lo, up := c.pool.SizeHint().Lower, c.pool.SizeHint().Upper
+	lower, ok1 := remainingCombosRep(lo, c.first, c.indices)
+	if !ok1 {
+		lower = 1 << 62
+	}
+	upper := -1
+	if up >= 0 {
+		if ru, ok2 := remainingCombosRep(up, c.first, c.indices); ok2 {
+			upper = ru
+		}
+	}
+	return Hint(lower, upper)
+}
+
+func remainingCombosRep(n int, first bool, indices []int) (int, bool) {
+	k := len(indices)
+	count := func(n, k int) (int, bool) {
+		var positions int
+		if n == 0 {
+			positions = k - 1
+			if positions < 0 {
+				positions = 0
+			}
+		} else {
+			positions = n - 1 + k
+		}
+		return Binom(positions, k)
+	}
+	if first {
+		return count(n, k)
+	}
+	sum := 0
+	for i, n0 := range indices {
+		v, ok := count(n-1-n0, k-i)
+		if !ok {
+			return 0, false
+		}
+		sum += v
+	}
+	return sum, true
+}
+
+// ---------------------------------------------------------------------------
+// Permutations
+// ---------------------------------------------------------------------------
+
+// Permutations yields all k-permutations of the loaded elements in
+// lexicographic order.
+type Permutations[T any] struct {
+	items    []T
+	k        int
+	cur      []int
+	started  bool
+	done     bool
+	consumed int
+}
+
+// NewPermutations builds a Permutations adaptor. The input is fully buffered.
+func NewPermutations[T any](it Iter[T], k int) *Permutations[T] {
+	var items []T
+	for {
+		v, ok := it.Next()
+		if !ok {
+			break
+		}
+		items = append(items, v)
+	}
+	return &Permutations[T]{items: items, k: k}
+}
+
+func (p *Permutations[T]) extract() []T {
+	out := make([]T, p.k)
+	for i := 0; i < p.k; i++ {
+		out[i] = p.items[p.cur[i]]
+	}
+	return out
+}
+
+func (p *Permutations[T]) advance() bool {
+	n := len(p.items)
+	k := p.k
+	used := make([]bool, n)
+	for i := k - 1; i >= 0; i-- {
+		for j := 0; j < n; j++ {
+			used[j] = false
+		}
+		for j := 0; j < i; j++ {
+			used[p.cur[j]] = true
+		}
+		best := -1
+		for v := p.cur[i] + 1; v < n; v++ {
+			if !used[v] {
+				best = v
+				break
+			}
+		}
+		if best != -1 {
+			p.cur[i] = best
+			used[best] = true
+			pos := i + 1
+			for v := 0; v < n && pos < k; v++ {
+				if !used[v] {
+					p.cur[pos] = v
+					used[v] = true
+					pos++
+				}
+			}
+			return true
+		}
+	}
+	return false
+}
+
+// Next implements Iter.
+func (p *Permutations[T]) Next() ([]T, bool) {
+	n := len(p.items)
+	if !p.started {
+		p.started = true
+		if p.k > n {
+			p.done = true
+			return nil, false
+		}
+		if p.k == 0 {
+			p.done = true
+			p.consumed++
+			return []T{}, true
+		}
+		p.cur = make([]int, p.k)
+		for i := range p.cur {
+			p.cur[i] = i
+		}
+		p.consumed++
+		return p.extract(), true
+	}
+	if p.done {
+		return nil, false
+	}
+	if !p.advance() {
+		p.done = true
+		return nil, false
+	}
+	p.consumed++
+	return p.extract(), true
+}
+
+// SizeHint implements Iter.
+func (p *Permutations[T]) SizeHint() SizeHint {
+	total, ok := fallingFactorial(len(p.items), p.k)
+	if !ok {
+		return Hint(0, -1)
+	}
+	rem := total - p.consumed
+	if rem < 0 {
+		rem = 0
+	}
+	return Hint(rem, rem)
+}
+
+func fallingFactorial(n, k int) (int, bool) {
+	if k > n {
+		return 0, true
+	}
+	r := 1
+	for i := 0; i < k; i++ {
+		v, ok := checkedMul(r, n-i)
+		if !ok {
+			return 0, false
+		}
+		r = v
+	}
+	return r, true
+}
+
+// ---------------------------------------------------------------------------
+// Powerset
+// ---------------------------------------------------------------------------
+
+// Powerset yields the powerset of the source, ordered by increasing subset size.
+type Powerset[T any] struct {
+	combs *Combinations[T]
+	done  bool
+}
+
+// NewPowerset builds a Powerset adaptor.
+func NewPowerset[T any](it Iter[T]) *Powerset[T] {
+	return &Powerset[T]{combs: NewCombinations(it, 0)}
+}
+
+func (p *Powerset[T]) incrementK() bool {
+	if p.combs.K() < p.combs.N() || p.combs.K() == 0 {
+		p.combs.Reset(p.combs.K() + 1)
+		return true
+	}
+	return false
+}
+
+// Next implements Iter.
+func (p *Powerset[T]) Next() ([]T, bool) {
+	if p.done {
+		return nil, false
+	}
+	if v, ok := p.combs.Next(); ok {
+		return v, true
+	}
+	if p.incrementK() {
+		if v, ok := p.combs.Next(); ok {
+			return v, true
+		}
+	}
+	p.done = true
+	return nil, false
+}
+
+// SizeHint implements Iter.
+func (p *Powerset[T]) SizeHint() SizeHint { return Hint(0, -1) }
+
+// ---------------------------------------------------------------------------
+// MultiProduct
+// ---------------------------------------------------------------------------
+
+// MultiProduct yields the cartesian product of several iterators. The last
+// iterator varies fastest.
+type MultiProduct[T any] struct {
+	parts [][]T
+	idx   []int
+	first bool
+	done  bool
+}
+
+// NewMultiProduct builds a MultiProduct from a list of iterators.
+func NewMultiProduct[T any](iters []Iter[T]) *MultiProduct[T] {
+	parts := make([][]T, len(iters))
+	for i, it := range iters {
+		var vals []T
+		for {
+			v, ok := it.Next()
+			if !ok {
+				break
+			}
+			vals = append(vals, v)
+		}
+		parts[i] = vals
+	}
+	return &MultiProduct[T]{parts: parts, first: true}
+}
+
+// NewMultiCartesianProduct is an alias for NewMultiProduct.
+func NewMultiCartesianProduct[T any](iters []Iter[T]) *MultiProduct[T] {
+	return NewMultiProduct(iters)
+}
+
+// Next implements Iter.
+func (m *MultiProduct[T]) Next() ([]T, bool) {
+	if m.done {
+		return nil, false
+	}
+	n := len(m.parts)
+	if n == 0 {
+		m.done = true
+		return []T{}, true
+	}
+	if m.first {
+		m.first = false
+		m.idx = make([]int, n)
+		out := make([]T, n)
+		for i, part := range m.parts {
+			if len(part) == 0 {
+				m.done = true
+				return nil, false
+			}
+			out[i] = part[0]
+		}
+		return out, true
+	}
+	for i := n - 1; i >= 0; i-- {
+		if m.idx[i]+1 < len(m.parts[i]) {
+			m.idx[i]++
+			out := make([]T, n)
+			for j, part := range m.parts {
+				out[j] = part[m.idx[j]]
+			}
+			return out, true
+		}
+		m.idx[i] = 0
+	}
+	m.done = true
+	return nil, false
+}
+
+// SizeHint implements Iter.
+func (m *MultiProduct[T]) SizeHint() SizeHint {
+	size := 1
+	for _, part := range m.parts {
+		v, ok := checkedMul(size, len(part))
+		if !ok {
+			return Hint(0, -1)
+		}
+		size = v
+	}
+	return Hint(size, size)
+}
diff --git a/core/either_or_both.go b/core/either_or_both.go
new file mode 100644
index 0000000..9465163
--- /dev/null
+++ b/core/either_or_both.go
@@ -0,0 +1,106 @@
+package core
+
+import "fmt"
+
+// EitherOrBoth holds either a single A, a single B, or both. It mirrors
+// src/either_or_both.rs.
+type EitherOrBoth[A, B any] struct {
+	kind int // 0 = Left, 1 = Right, 2 = Both
+	a    A
+	b    B
+}
+
+// Left returns an EitherOrBoth holding only a.
+func Left[A, B any](a A) EitherOrBoth[A, B] {
+	return EitherOrBoth[A, B]{kind: 0, a: a}
+}
+
+// Right returns an EitherOrBoth holding only b.
+func Right[A, B any](b B) EitherOrBoth[A, B] {
+	return EitherOrBoth[A, B]{kind: 1, b: b}
+}
+
+// Both returns an EitherOrBoth holding both a and b.
+func Both[A, B any](a A, b B) EitherOrBoth[A, B] {
+	return EitherOrBoth[A, B]{kind: 2, a: a, b: b}
+}
+
+// IsLeft reports whether the value is exclusively Left.
+func (e EitherOrBoth[A, B]) IsLeft() bool { return e.kind == 0 }
+
+// IsRight reports whether the value is exclusively Right.
+func (e EitherOrBoth[A, B]) IsRight() bool { return e.kind == 1 }
+
+// IsBoth reports whether the value is Both.
+func (e EitherOrBoth[A, B]) IsBoth() bool { return e.kind == 2 }
+
+// HasLeft reports whether a left value is present (Left or Both).
+func (e EitherOrBoth[A, B]) HasLeft() bool { return e.kind == 0 || e.kind == 2 }
+
+// HasRight reports whether a right value is present (Right or Both).
+func (e EitherOrBoth[A, B]) HasRight() bool { return e.kind == 1 || e.kind == 2 }
+
+// Left yields the left value when present (Left or Both).
+func (e EitherOrBoth[A, B]) Left() (A, bool) {
+	if e.HasLeft() {
+		return e.a, true
+	}
+	var zero A
+	return zero, false
+}
+
+// Right yields the right value when present (Right or Both).
+func (e EitherOrBoth[A, B]) Right() (B, bool) {
+	if e.HasRight() {
+		return e.b, true
+	}
+	var zero B
+	return zero, false
+}
+
+// JustLeft yields the left value only for the Left variant.
+func (e EitherOrBoth[A, B]) JustLeft() (A, bool) {
+	if e.kind == 0 {
+		return e.a, true
+	}
+	var zero A
+	return zero, false
+}
+
+// JustRight yields the right value only for the Right variant.
+func (e EitherOrBoth[A, B]) JustRight() (B, bool) {
+	if e.kind == 1 {
+		return e.b, true
+	}
+	var zero B
+	return zero, false
+}
+
+// BothValue yields the pair of values for the Both variant.
+func (e EitherOrBoth[A, B]) BothValue() (A, B, bool) {
+	if e.kind == 2 {
+		return e.a, e.b, true
+	}
+	var za A
+	var zb B
+	return za, zb, false
+}
+
+// LeftAndRight returns the optional left and right values.
+func (e EitherOrBoth[A, B]) LeftAndRight() (A, bool, B, bool) {
+	lv, lok := e.Left()
+	rv, rok := e.Right()
+	return lv, lok, rv, rok
+}
+
+// String renders the value.
+func (e EitherOrBoth[A, B]) String() string {
+	switch e.kind {
+	case 0:
+		return fmt.Sprintf("Left(%v)", e.a)
+	case 1:
+		return fmt.Sprintf("Right(%v)", e.b)
+	default:
+		return fmt.Sprintf("Both(%v, %v)", e.a, e.b)
+	}
+}
diff --git a/core/errors.go b/core/errors.go
new file mode 100644
index 0000000..634ae11
--- /dev/null
+++ b/core/errors.go
@@ -0,0 +1,81 @@
+package core
+
+import "fmt"
+
+// AllEqualValueError is the error value returned for the error case of
+// AllEqualValue. It mirrors src/all_equal_value_err.rs.
+//
+// Elements is empty for the zero-element case and holds exactly two elements
+// for the unequal-elements case.
+type AllEqualValueError[T any] struct {
+	Elements []T
+}
+
+// NewAllEqualValueErrorZero builds the zero-element error.
+func NewAllEqualValueErrorZero[T any]() *AllEqualValueError[T] {
+	return &AllEqualValueError[T]{}
+}
+
+// NewAllEqualValueErrorUnequal builds the unequal-elements error.
+func NewAllEqualValueErrorUnequal[T any](a, b T) *AllEqualValueError[T] {
+	return &AllEqualValueError[T]{Elements: []T{a, b}}
+}
+
+// Error implements the error interface with the exact Rust Display text.
+func (e *AllEqualValueError[T]) Error() string {
+	if len(e.Elements) == 0 {
+		return "got zero elements when all elements were expected to be equal"
+	}
+	return "got different elements when all elements were expected to be equal"
+}
+
+// String implements fmt.Stringer.
+func (e *AllEqualValueError[T]) String() string { return e.Error() }
+
+// ExactlyOneError is returned for the error case of ExactlyOne and AtMostOne.
+// It is itself an iterator yielding exactly the same elements as the input,
+// restoring the elements already consumed. It mirrors src/exactly_one_err.rs.
+type ExactlyOneError[T any] struct {
+	pending []T
+	inner   Iter[T]
+}
+
+// NewExactlyOneError builds an error restoring pending then continuing with inner.
+func NewExactlyOneError[T any](pending []T, inner Iter[T]) *ExactlyOneError[T] {
+	return &ExactlyOneError[T]{pending: pending, inner: inner}
+}
+
+// Next implements Iter, replaying the consumed prefix first.
+func (e *ExactlyOneError[T]) Next() (T, bool) {
+	if len(e.pending) > 0 {
+		v := e.pending[0]
+		e.pending = e.pending[1:]
+		return v, true
+	}
+	return e.inner.Next()
+}
+
+// SizeHint implements Iter.
+func (e *ExactlyOneError[T]) SizeHint() SizeHint {
+	h := AddScalar(e.inner.SizeHint(), len(e.pending))
+	if h.Lower > 0 {
+		return Hint(1, h.Upper)
+	}
+	return h
+}
+
+// Error implements the error interface with the exact Rust Display text.
+func (e *ExactlyOneError[T]) Error() string {
+	if len(e.pending) > 0 {
+		return "got at least 2 elements when exactly one was expected"
+	}
+	return "got zero elements when exactly one was expected"
+}
+
+// String implements fmt.Stringer.
+func (e *ExactlyOneError[T]) String() string { return e.Error() }
+
+// Format implements the error interface.
+var _ error = (*AllEqualValueError[any])(nil)
+var _ error = (*ExactlyOneError[any])(nil)
+var _ = fmt.Sprintf
diff --git a/core/format.go b/core/format.go
new file mode 100644
index 0000000..e16452c
--- /dev/null
+++ b/core/format.go
@@ -0,0 +1,84 @@
+package core
+
+import "fmt"
+
+// Format renders an iterator's elements lazily, separated by sep. It mirrors
+// src/format.rs. A Format value may be formatted only once; a second attempt
+// panics, matching the Rust one-shot contract.
+type Format[T any] struct {
+	sep    string
+	it     Iter[T]
+	render func(T) string
+	done   bool
+}
+
+// NewFormat builds a lazy separator-rendering formatter. If render is nil,
+// elements are rendered with fmt.Sprint.
+func NewFormat[T any](it Iter[T], sep string, render func(T) string) *Format[T] {
+	if render == nil {
+		render = func(v T) string { return fmt.Sprint(v) }
+	}
+	return &Format[T]{sep: sep, it: it, render: render}
+}
+
+// String renders the elements, consuming the iterator. A second call panics.
+func (f *Format[T]) String() string {
+	if f.done {
+		panic("Format: was already formatted once")
+	}
+	f.done = true
+	out := ""
+	first := true
+	for {
+		v, ok := f.it.Next()
+		if !ok {
+			break
+		}
+		if !first && f.sep != "" {
+			out += f.sep
+		}
+		first = false
+		out += f.render(v)
+	}
+	return out
+}
+
+// FormatWithFunc formats one element, writing nested values through write.
+type FormatWithFunc[T any] func(v T, write func(any) string) string
+
+// FormatWith renders an iterator's elements lazily with a caller-supplied
+// formatter, separated by sep. It follows the same one-shot contract as Format.
+type FormatWith[T any] struct {
+	sep  string
+	it   Iter[T]
+	fn   FormatWithFunc[T]
+	done bool
+}
+
+// NewFormatWith builds a FormatWith formatter.
+func NewFormatWith[T any](it Iter[T], sep string, fn FormatWithFunc[T]) *FormatWith[T] {
+	return &FormatWith[T]{sep: sep, it: it, fn: fn}
+}
+
+// String renders the elements, consuming the iterator. A second call panics.
+func (f *FormatWith[T]) String() string {
+	if f.done {
+		panic("FormatWith: was already formatted once")
+	}
+	f.done = true
+	write := func(a any) string { return fmt.Sprint(a) }
+	out := ""
+	first := true
+	for {
+		v, ok := f.it.Next()
+		if !ok {
+			break
+		}
+		if !first && f.sep != "" {
+			out += f.sep
+		}
+		first = false
+		out += f.fn(v, write)
+	}
+	return out
+}
diff --git a/core/groupbylazy.go b/core/groupbylazy.go
new file mode 100644
index 0000000..274e60d
--- /dev/null
+++ b/core/groupbylazy.go
@@ -0,0 +1,124 @@
+package core
+
+// Chunks yields consecutive chunks of up to size elements. Constructing it with
+// size 0 panics, matching the Rust contract.
+type Chunks[T any] struct {
+	it   Iter[T]
+	size int
+	done bool
+}
+
+// NewChunks builds a Chunks adaptor.
+func NewChunks[T any](it Iter[T], size int) *Chunks[T] {
+	if size == 0 {
+		panic("Chunks: chunk size must be non-zero")
+	}
+	return &Chunks[T]{it: it, size: size}
+}
+
+// Next implements Iter.
+func (c *Chunks[T]) Next() ([]T, bool) {
+	if c.done {
+		return nil, false
+	}
+	chunk := make([]T, 0, c.size)
+	for i := 0; i < c.size; i++ {
+		v, ok := c.it.Next()
+		if !ok {
+			c.done = true
+			break
+		}
+		chunk = append(chunk, v)
+	}
+	if len(chunk) == 0 {
+		return nil, false
+	}
+	return chunk, true
+}
+
+// SizeHint implements Iter.
+func (c *Chunks[T]) SizeHint() SizeHint {
+	if c.done {
+		return Hint(0, 0)
+	}
+	h := c.it.SizeHint()
+	lo := 0
+	if h.Lower > 0 {
+		lo = (h.Lower + c.size - 1) / c.size
+	}
+	up := -1
+	if h.Bounded() {
+		up = (h.Upper + c.size - 1) / c.size
+	}
+	return Hint(lo, up)
+}
+
+// ChunkBy groups consecutive elements that share the same key.
+type ChunkBy[T any, K comparable] struct {
+	it      Iter[T]
+	key     func(T) K
+	pending *T
+	done    bool
+}
+
+// NewChunkBy builds a ChunkBy adaptor.
+func NewChunkBy[T any, K comparable](it Iter[T], key func(T) K) *ChunkBy[T, K] {
+	return &ChunkBy[T, K]{it: it, key: key}
+}
+
+// Next implements Iter.
+func (c *ChunkBy[T, K]) Next() ([]T, bool) {
+	if c.done {
+		return nil, false
+	}
+	var first T
+	if c.pending != nil {
+		first = *c.pending
+		c.pending = nil
+	} else {
+		v, ok := c.it.Next()
+		if !ok {
+			c.done = true
+			return nil, false
+		}
+		first = v
+	}
+	k := c.key(first)
+	group := []T{first}
+	for {
+		v, ok := c.it.Next()
+		if !ok {
+			c.done = true
+			return group, true
+		}
+		if c.key(v) != k {
+			vv := v
+			c.pending = &vv
+			return group, true
+		}
+		group = append(group, v)
+	}
+}
+
+// SizeHint implements Iter.
+func (c *ChunkBy[T, K]) SizeHint() SizeHint {
+	if c.done {
+		return Hint(0, 0)
+	}
+	h := c.it.SizeHint()
+	lo := 0
+	if h.Lower > 0 {
+		lo = 1
+	}
+	return Hint(lo, h.Upper)
+}
+
+// GroupBy is a legacy name for ChunkBy.
+type GroupBy[T any, K comparable] struct {
+	*ChunkBy[T, K]
+}
+
+// NewGroupBy builds a GroupBy adaptor.
+func NewGroupBy[T any, K comparable](it Iter[T], key func(T) K) *GroupBy[T, K] {
+	return &GroupBy[T, K]{ChunkBy: NewChunkBy(it, key)}
+}
diff --git a/core/grouping_map.go b/core/grouping_map.go
new file mode 100644
index 0000000..6b4e28e
--- /dev/null
+++ b/core/grouping_map.go
@@ -0,0 +1,77 @@
+//go:build !nostd
+
+package core
+
+// GroupingMap groups values by key. It mirrors the observable behavior of
+// src/grouping_map.rs.
+type GroupingMap[K comparable, V any] struct {
+	keys   []K
+	groups map[K][]V
+}
+
+// NewGroupingMap builds a GroupingMap from (key, value) pairs.
+func NewGroupingMap[K comparable, V any](it Iter[Pair[K, V]]) *GroupingMap[K, V] {
+	g := &GroupingMap[K, V]{groups: map[K][]V{}}
+	for {
+		p, ok := it.Next()
+		if !ok {
+			break
+		}
+		if _, exists := g.groups[p.First]; !exists {
+			g.keys = append(g.keys, p.First)
+		}
+		g.groups[p.First] = append(g.groups[p.First], p.Second)
+	}
+	return g
+}
+
+// IntoGroupingMap groups the input by key.
+func IntoGroupingMap[T any, K comparable](it Iter[T], key func(T) K) *GroupingMap[K, T] {
+	g := &GroupingMap[K, T]{groups: map[K][]T{}}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			break
+		}
+		k := key(v)
+		if _, exists := g.groups[k]; !exists {
+			g.keys = append(g.keys, k)
+		}
+		g.groups[k] = append(g.groups[k], v)
+	}
+	return g
+}
+
+// Len returns the number of groups.
+func (g *GroupingMap[K, V]) Len() int { return len(g.keys) }
+
+// Keys returns the keys in first-seen order.
+func (g *GroupingMap[K, V]) Keys() []K { return g.keys }
+
+// Get returns the group for key.
+func (g *GroupingMap[K, V]) Get(k K) ([]V, bool) {
+	v, ok := g.groups[k]
+	return v, ok
+}
+
+// Collect returns the groups as a map.
+func (g *GroupingMap[K, V]) Collect() map[K][]V { return g.groups }
+
+// Groups returns the groups in first-seen key order.
+func (g *GroupingMap[K, V]) Groups() []Pair[K, []V] {
+	out := make([]Pair[K, []V], 0, len(g.keys))
+	for _, k := range g.keys {
+		out = append(out, Pair[K, []V]{First: k, Second: g.groups[k]})
+	}
+	return out
+}
+
+// GroupMap is an eager key-to-values map.
+type GroupMap[K comparable, V any] struct {
+	*GroupingMap[K, V]
+}
+
+// NewGroupMap builds a GroupMap from (key, value) pairs.
+func NewGroupMap[K comparable, V any](it Iter[Pair[K, V]]) *GroupMap[K, V] {
+	return &GroupMap[K, V]{GroupingMap: NewGroupingMap(it)}
+}
diff --git a/core/iter.go b/core/iter.go
new file mode 100644
index 0000000..761bd85
--- /dev/null
+++ b/core/iter.go
@@ -0,0 +1,429 @@
+// Package core implements the pull-based iterator protocol that mirrors Rust's
+// std Iterator/ExactSizeIterator/DoubleEndedIterator/FusedIterator contracts and
+// the concrete adaptor types of the itertools crate.
+package core
+
+import "math"
+
+// SizeHint is the return type of Iter.SizeHint.
+//
+// It mirrors Rust's `(usize, Option<usize>)`. A negative Upper means "no upper
+// bound" (the Rust `None` case). Lower is always non-negative.
+type SizeHint struct {
+	Lower int
+	Upper int
+}
+
+// Hint builds a SizeHint. Pass a negative hi for an unbounded upper limit.
+func Hint(lo, hi int) SizeHint { return SizeHint{Lower: lo, Upper: hi} }
+
+// IsExact reports whether the hint gives an exact size.
+func (s SizeHint) IsExact() bool { return s.Upper >= 0 && s.Lower == s.Upper }
+
+// Bounded reports whether an upper bound is known.
+func (s SizeHint) Bounded() bool { return s.Upper >= 0 }
+
+// UpperValue returns the upper bound and whether it is known.
+func (s SizeHint) UpperValue() (int, bool) {
+	if s.Upper < 0 {
+		return 0, false
+	}
+	return s.Upper, true
+}
+
+func satAdd(a, b int) int {
+	if a > math.MaxInt-b {
+		return math.MaxInt
+	}
+	return a + b
+}
+
+func satSub(a, b int) int {
+	if a < b {
+		return 0
+	}
+	return a - b
+}
+
+func satMul(a, b int) int {
+	if a == 0 || b == 0 {
+		return 0
+	}
+	if a > math.MaxInt/b {
+		return math.MaxInt
+	}
+	return a * b
+}
+
+func checkedAdd(a, b int) (int, bool) {
+	if a > math.MaxInt-b {
+		return 0, false
+	}
+	return a + b, true
+}
+
+func checkedMul(a, b int) (int, bool) {
+	if a == 0 || b == 0 {
+		return 0, true
+	}
+	if a > math.MaxInt/b {
+		return 0, false
+	}
+	return a * b, true
+}
+
+// Add adds two size hints correctly (mirrors size_hint::add).
+func Add(a, b SizeHint) SizeHint {
+	lo := satAdd(a.Lower, b.Lower)
+	hi := -1
+	if a.Bounded() && b.Bounded() {
+		if v, ok := checkedAdd(a.Upper, b.Upper); ok {
+			hi = v
+		}
+	}
+	return SizeHint{Lower: lo, Upper: hi}
+}
+
+// AddScalar adds x to a size hint (mirrors size_hint::add_scalar).
+func AddScalar(sh SizeHint, x int) SizeHint {
+	lo := satAdd(sh.Lower, x)
+	hi := -1
+	if sh.Bounded() {
+		if v, ok := checkedAdd(sh.Upper, x); ok {
+			hi = v
+		}
+	}
+	return SizeHint{Lower: lo, Upper: hi}
+}
+
+// SubScalar subtracts x from a size hint (mirrors size_hint::sub_scalar).
+func SubScalar(sh SizeHint, x int) SizeHint {
+	lo := satSub(sh.Lower, x)
+	hi := -1
+	if sh.Bounded() {
+		hi = satSub(sh.Upper, x)
+	}
+	return SizeHint{Lower: lo, Upper: hi}
+}
+
+// Mul multiplies two size hints (mirrors size_hint::mul).
+func Mul(a, b SizeHint) SizeHint {
+	lo := satMul(a.Lower, b.Lower)
+	hi := -1
+	switch {
+	case a.Bounded() && b.Bounded():
+		if v, ok := checkedMul(a.Upper, b.Upper); ok {
+			hi = v
+		}
+	case a.Upper == 0 || b.Upper == 0:
+		hi = 0
+	}
+	return SizeHint{Lower: lo, Upper: hi}
+}
+
+// MulScalar multiplies a size hint by x (mirrors size_hint::mul_scalar).
+func MulScalar(sh SizeHint, x int) SizeHint {
+	lo := satMul(sh.Lower, x)
+	hi := -1
+	if sh.Bounded() {
+		if v, ok := checkedMul(sh.Upper, x); ok {
+			hi = v
+		}
+	}
+	return SizeHint{Lower: lo, Upper: hi}
+}
+
+// Max returns the element-wise maximum of two size hints.
+func Max(a, b SizeHint) SizeHint {
+	lo := a.Lower
+	if b.Lower > lo {
+		lo = b.Lower
+	}
+	hi := -1
+	if a.Bounded() && b.Bounded() {
+		hi = a.Upper
+		if b.Upper > hi {
+			hi = b.Upper
+		}
+	}
+	return SizeHint{Lower: lo, Upper: hi}
+}
+
+// Min returns the element-wise minimum of two size hints.
+func Min(a, b SizeHint) SizeHint {
+	lo := a.Lower
+	if b.Lower < lo {
+		lo = b.Lower
+	}
+	hi := -1
+	switch {
+	case a.Bounded() && b.Bounded():
+		hi = a.Upper
+		if b.Upper < hi {
+			hi = b.Upper
+		}
+	case a.Bounded():
+		hi = a.Upper
+	case b.Bounded():
+		hi = b.Upper
+	}
+	return SizeHint{Lower: lo, Upper: hi}
+}
+
+// Iter is the core pull-iterator protocol.
+type Iter[T any] interface {
+	// Next yields the next element, reporting false once exhausted.
+	Next() (T, bool)
+	// SizeHint reports the lower and upper bounds on the remaining length.
+	SizeHint() SizeHint
+}
+
+// DoubleEnded is implemented by iterators that can be consumed from the back.
+type DoubleEnded[T any] interface {
+	Iter[T]
+	NextBack() (T, bool)
+}
+
+// Fused is implemented by iterators that continue to report exhaustion after
+// their first exhausted Next call. All iterators in this package are fused.
+type Fused[T any] interface {
+	Iter[T]
+}
+
+// Empty is an iterator that yields nothing.
+type Empty[T any] struct{}
+
+// EmptyIter returns the canonical empty iterator.
+func EmptyIter[T any]() Empty[T] { return Empty[T]{} }
+
+// Next implements Iter.
+func (Empty[T]) Next() (T, bool) {
+	var zero T
+	return zero, false
+}
+
+// SizeHint implements Iter.
+func (Empty[T]) SizeHint() SizeHint { return Hint(0, 0) }
+
+// NextBack implements DoubleEnded.
+func (Empty[T]) NextBack() (T, bool) {
+	var zero T
+	return zero, false
+}
+
+// Once is an iterator yielding a single element.
+type Once[T any] struct {
+	val  T
+	done bool
+}
+
+// OnceIter returns an iterator yielding v once.
+func OnceIter[T any](v T) *Once[T] { return &Once[T]{val: v} }
+
+// Next implements Iter.
+func (o *Once[T]) Next() (T, bool) {
+	if o.done {
+		var zero T
+		return zero, false
+	}
+	o.done = true
+	return o.val, true
+}
+
+// SizeHint implements Iter.
+func (o *Once[T]) SizeHint() SizeHint {
+	if o.done {
+		return Hint(0, 0)
+	}
+	return Hint(1, 1)
+}
+
+// NextBack implements DoubleEnded.
+func (o *Once[T]) NextBack() (T, bool) { return o.Next() }
+
+// Slice is an iterator over a Go slice. It preserves the input slice, never
+// mutating it, and supports double-ended iteration.
+type Slice[T any] struct {
+	data []T
+	head int
+	tail int
+}
+
+// FromSlice builds an iterator over the given slice.
+func FromSlice[T any](s []T) *Slice[T] {
+	return &Slice[T]{data: s, head: 0, tail: len(s)}
+}
+
+// Len returns the number of remaining elements.
+func (s *Slice[T]) Len() int { return s.tail - s.head }
+
+// Next implements Iter.
+func (s *Slice[T]) Next() (T, bool) {
+	if s.head >= s.tail {
+		var zero T
+		return zero, false
+	}
+	v := s.data[s.head]
+	s.head++
+	return v, true
+}
+
+// NextBack implements DoubleEnded.
+func (s *Slice[T]) NextBack() (T, bool) {
+	if s.head >= s.tail {
+		var zero T
+		return zero, false
+	}
+	s.tail--
+	return s.data[s.tail], true
+}
+
+// SizeHint implements Iter.
+func (s *Slice[T]) SizeHint() SizeHint {
+	n := s.Len()
+	return Hint(n, n)
+}
+
+// Repeat is an infinite iterator yielding the same value forever.
+type Repeat[T any] struct{ val T }
+
+// RepeatIter returns an infinite iterator yielding v.
+func RepeatIter[T any](v T) *Repeat[T] { return &Repeat[T]{val: v} }
+
+// Next implements Iter.
+func (r *Repeat[T]) Next() (T, bool) { return r.val, true }
+
+// SizeHint implements Iter.
+func (r *Repeat[T]) SizeHint() SizeHint { return Hint(math.MaxInt, -1) }
+
+// RepeatN yields a value n times.
+type RepeatN[T any] struct {
+	val   T
+	count int
+}
+
+// NewRepeatN builds an iterator yielding v, n times.
+func NewRepeatN[T any](n int, v T) *RepeatN[T] {
+	return &RepeatN[T]{val: v, count: n}
+}
+
+// Next implements Iter.
+func (r *RepeatN[T]) Next() (T, bool) {
+	if r.count <= 0 {
+		var zero T
+		return zero, false
+	}
+	r.count--
+	return r.val, true
+}
+
+// SizeHint implements Iter.
+func (r *RepeatN[T]) SizeHint() SizeHint { return Hint(r.count, r.count) }
+
+// NextBack implements DoubleEnded.
+func (r *RepeatN[T]) NextBack() (T, bool) { return r.Next() }
+
+// Iterate yields the seed, then repeatedly applies next to the previous value.
+// Note: the seed is produced first, matching Rust's `std::iter::successors`-style
+// generator used by itertools' Iterate adaptor.
+type Iterate[T any] struct {
+	next  func(T) T
+	cur   T
+	first bool
+}
+
+// NewIterate builds an Iterate source. The first yielded item is seed.
+func NewIterate[T any](seed T, next func(T) T) *Iterate[T] {
+	return &Iterate[T]{next: next, cur: seed, first: true}
+}
+
+// Next implements Iter.
+func (it *Iterate[T]) Next() (T, bool) {
+	if !it.first {
+		it.cur = it.next(it.cur)
+	}
+	it.first = false
+	return it.cur, true
+}
+
+// SizeHint implements Iter.
+func (it *Iterate[T]) SizeHint() SizeHint { return Hint(0, -1) }
+
+// Unfold yields values produced by a stateful function until it reports done.
+type Unfold[St, T any] struct {
+	f  func(St) (T, St, bool)
+	st St
+}
+
+// NewUnfold builds an Unfold source.
+func NewUnfold[St, T any](init St, f func(St) (T, St, bool)) *Unfold[St, T] {
+	return &Unfold[St, T]{f: f, st: init}
+}
+
+// Next implements Iter.
+func (u *Unfold[St, T]) Next() (T, bool) {
+	v, st, ok := u.f(u.st)
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	u.st = st
+	return v, true
+}
+
+// SizeHint implements Iter.
+func (u *Unfold[St, T]) SizeHint() SizeHint {
+	var zero T
+	_ = zero
+	return Hint(0, -1)
+}
+
+// LazyBuffer buffers a source iterator lazily and provides random access.
+// It mirrors src/lazy_buffer.rs.
+type LazyBuffer[T any] struct {
+	it     Iter[T]
+	buffer []T
+	fuse   bool
+}
+
+// NewLazyBuffer wraps it in a LazyBuffer.
+func NewLazyBuffer[T any](it Iter[T]) *LazyBuffer[T] {
+	return &LazyBuffer[T]{it: it}
+}
+
+// Len returns the number of buffered elements.
+func (b *LazyBuffer[T]) Len() int { return len(b.buffer) }
+
+// SizeHint reports the total remaining length including buffered elements.
+func (b *LazyBuffer[T]) SizeHint() SizeHint {
+	return AddScalar(b.it.SizeHint(), len(b.buffer))
+}
+
+// GetNext pulls one element into the buffer, reporting false when exhausted.
+func (b *LazyBuffer[T]) GetNext() bool {
+	if b.fuse {
+		return false
+	}
+	v, ok := b.it.Next()
+	if !ok {
+		b.fuse = true
+		return false
+	}
+	b.buffer = append(b.buffer, v)
+	return true
+}
+
+// Prefill ensures at least n elements are buffered.
+func (b *LazyBuffer[T]) Prefill(n int) {
+	for len(b.buffer) < n {
+		if !b.GetNext() {
+			return
+		}
+	}
+}
+
+// At returns the buffered element at index i (must already be filled).
+func (b *LazyBuffer[T]) At(i int) T { return b.buffer[i] }
+
+// Buffer exposes the underlying buffer.
+func (b *LazyBuffer[T]) Buffer() []T { return b.buffer }
diff --git a/core/iter_test.go b/core/iter_test.go
new file mode 100644
index 0000000..332a508
--- /dev/null
+++ b/core/iter_test.go
@@ -0,0 +1,76 @@
+package core
+
+import (
+	"math"
+	"testing"
+)
+
+func TestSizeHintArithmetic(t *testing.T) {
+	if got := Mul(Hint(3, 4), Hint(3, 4)); got.Lower != 9 || got.Upper != 16 {
+		t.Fatalf("mul = %+v", got)
+	}
+	if got := Mul(Hint(3, 4), Hint(math.MaxInt, -1)); got.Lower != math.MaxInt || got.Upper != -1 {
+		t.Fatalf("mul unbounded = %+v", got)
+	}
+	if got := Mul(Hint(3, -1), Hint(0, 0)); got.Lower != 0 || got.Upper != 0 {
+		t.Fatalf("mul zero = %+v", got)
+	}
+	if got := Add(Hint(1, 2), Hint(3, 4)); got.Lower != 4 || got.Upper != 6 {
+		t.Fatalf("add = %+v", got)
+	}
+	if got := AddScalar(Hint(1, 2), 5); got.Lower != 6 || got.Upper != 7 {
+		t.Fatalf("add_scalar = %+v", got)
+	}
+	if got := SubScalar(Hint(5, 6), 2); got.Lower != 3 || got.Upper != 4 {
+		t.Fatalf("sub_scalar = %+v", got)
+	}
+	if got := SubScalar(Hint(1, 2), 5); got.Lower != 0 || got.Upper != 0 {
+		t.Fatalf("sub_scalar saturating = %+v", got)
+	}
+	if got := Max(Hint(1, 5), Hint(3, 4)); got.Lower != 3 || got.Upper != 5 {
+		t.Fatalf("max = %+v", got)
+	}
+	if got := Min(Hint(1, 5), Hint(3, 4)); got.Lower != 1 || got.Upper != 4 {
+		t.Fatalf("min = %+v", got)
+	}
+}
+
+func TestSliceIterator(t *testing.T) {
+	s := FromSlice([]int{1, 2, 3})
+	if v, _ := s.Next(); v != 1 {
+		t.Fatalf("next = %v", v)
+	}
+	if v, _ := s.NextBack(); v != 3 {
+		t.Fatalf("next_back = %v", v)
+	}
+	if h := s.SizeHint(); h.Lower != 1 || h.Upper != 1 {
+		t.Fatalf("size hint = %+v", h)
+	}
+}
+
+func TestExactlyOneErrorIterates(t *testing.T) {
+	e := NewExactlyOneError([]int{1, 2}, FromSlice([]int{3}))
+	if e.Error() != "got at least 2 elements when exactly one was expected" {
+		t.Fatalf("error = %q", e.Error())
+	}
+	var got []int
+	for {
+		v, ok := e.Next()
+		if !ok {
+			break
+		}
+		got = append(got, v)
+	}
+	if len(got) != 3 || got[0] != 1 || got[2] != 3 {
+		t.Fatalf("exactly one error iteration = %v", got)
+	}
+}
+
+func TestAllEqualValueErrorMessages(t *testing.T) {
+	if got := NewAllEqualValueErrorZero[int]().Error(); got != "got zero elements when all elements were expected to be equal" {
+		t.Fatalf("zero = %q", got)
+	}
+	if got := NewAllEqualValueErrorUnequal(1, 2).Error(); got != "got different elements when all elements were expected to be equal" {
+		t.Fatalf("unequal = %q", got)
+	}
+}
diff --git a/core/merge_zip.go b/core/merge_zip.go
new file mode 100644
index 0000000..f7766cb
--- /dev/null
+++ b/core/merge_zip.go
@@ -0,0 +1,291 @@
+package core
+
+import "cmp"
+
+// Ordering is the result of a three-way comparison.
+type Ordering int
+
+const (
+	// Less reports that the first value precedes the second.
+	Less Ordering = -1
+	// Equal reports that the values are equivalent.
+	Equal Ordering = 0
+	// Greater reports that the first value follows the second.
+	Greater Ordering = 1
+)
+
+// OrderBy compares two ordered values.
+func OrderBy[T cmp.Ordered](a, b T) Ordering {
+	return Ordering(cmp.Compare(a, b))
+}
+
+// ---------------------------------------------------------------------------
+// MergeBy / MergeJoinBy
+// ---------------------------------------------------------------------------
+
+// MergeBy merges two sorted iterators using a "left before right" predicate.
+type MergeBy[T any] struct {
+	left, right *PutBack[T]
+	cmp         func(a, b T) bool
+}
+
+// NewMergeBy builds a MergeBy adaptor. cmp reports whether the left element
+// should be emitted before the right element.
+func NewMergeBy[T any](left, right Iter[T], cmp func(a, b T) bool) *MergeBy[T] {
+	return &MergeBy[T]{left: NewPutBack(left), right: NewPutBack(right), cmp: cmp}
+}
+
+// NewMerge merges two sorted iterators in ascending order.
+func NewMerge[T cmp.Ordered](left, right Iter[T]) *MergeBy[T] {
+	return NewMergeBy(left, right, func(a, b T) bool { return a <= b })
+}
+
+// Next implements Iter.
+func (m *MergeBy[T]) Next() (T, bool) {
+	l, lok := m.left.Next()
+	r, rok := m.right.Next()
+	switch {
+	case !lok && !rok:
+		var zero T
+		return zero, false
+	case lok && !rok:
+		return l, true
+	case !lok && rok:
+		return r, true
+	default:
+		if m.cmp(l, r) {
+			m.right.PutBack(r)
+			return l, true
+		}
+		m.left.PutBack(l)
+		return r, true
+	}
+}
+
+// SizeHint implements Iter.
+func (m *MergeBy[T]) SizeHint() SizeHint {
+	return Add(m.left.SizeHint(), m.right.SizeHint())
+}
+
+// MergeJoinBy merge-joins two iterators, yielding EitherOrBoth values.
+type MergeJoinBy[L, R any] struct {
+	left  *PutBack[L]
+	right *PutBack[R]
+	cmp   func(a L, b R) Ordering
+}
+
+// NewMergeJoinBy builds a MergeJoinBy adaptor.
+func NewMergeJoinBy[L, R any](left Iter[L], right Iter[R], cmp func(a L, b R) Ordering) *MergeJoinBy[L, R] {
+	return &MergeJoinBy[L, R]{left: NewPutBack(left), right: NewPutBack(right), cmp: cmp}
+}
+
+// Next implements Iter.
+func (m *MergeJoinBy[L, R]) Next() (EitherOrBoth[L, R], bool) {
+	l, lok := m.left.Next()
+	r, rok := m.right.Next()
+	switch {
+	case !lok && !rok:
+		return EitherOrBoth[L, R]{}, false
+	case lok && !rok:
+		return Left[L, R](l), true
+	case !lok && rok:
+		return Right[L, R](r), true
+	default:
+		switch m.cmp(l, r) {
+		case Equal:
+			return Both(l, r), true
+		case Less:
+			m.right.PutBack(r)
+			return Left[L, R](l), true
+		default:
+			m.left.PutBack(l)
+			return Right[L, R](r), true
+		}
+	}
+}
+
+// SizeHint implements Iter.
+func (m *MergeJoinBy[L, R]) SizeHint() SizeHint {
+	a := m.left.SizeHint()
+	b := m.right.SizeHint()
+	lo := a.Lower
+	if b.Lower > lo {
+		lo = b.Lower
+	}
+	hi := -1
+	if a.Bounded() && b.Bounded() {
+		hi = a.Upper + b.Upper
+	}
+	return Hint(lo, hi)
+}
+
+// ---------------------------------------------------------------------------
+// KMergeBy
+// ---------------------------------------------------------------------------
+
+// KMergeBy merges an arbitrary number of sorted iterators.
+type KMergeBy[T any] struct {
+	parts    []Iter[T]
+	heads    []T
+	has      []bool
+	lessThan func(a, b T) bool
+}
+
+// NewKMergeBy builds a KMergeBy adaptor. lessThan reports strict ascending order.
+func NewKMergeBy[T any](iters []Iter[T], lessThan func(a, b T) bool) *KMergeBy[T] {
+	m := &KMergeBy[T]{parts: iters, lessThan: lessThan}
+	m.heads = make([]T, len(iters))
+	m.has = make([]bool, len(iters))
+	for i, it := range iters {
+		v, ok := it.Next()
+		m.heads[i] = v
+		m.has[i] = ok
+	}
+	return m
+}
+
+// NewKMerge merges an arbitrary number of ascending-sorted iterators.
+func NewKMerge[T cmp.Ordered](iters []Iter[T]) *KMergeBy[T] {
+	return NewKMergeBy(iters, func(a, b T) bool { return a < b })
+}
+
+// Next implements Iter.
+func (m *KMergeBy[T]) Next() (T, bool) {
+	best := -1
+	for i := range m.parts {
+		if !m.has[i] {
+			continue
+		}
+		if best == -1 || m.lessThan(m.heads[i], m.heads[best]) {
+			best = i
+		}
+	}
+	if best == -1 {
+		var zero T
+		return zero, false
+	}
+	v := m.heads[best]
+	next, ok := m.parts[best].Next()
+	m.heads[best] = next
+	m.has[best] = ok
+	return v, true
+}
+
+// SizeHint implements Iter.
+func (m *KMergeBy[T]) SizeHint() SizeHint {
+	h := Hint(0, 0)
+	any := false
+	for i := range m.parts {
+		if m.has[i] {
+			h = Add(h, AddScalar(m.parts[i].SizeHint(), 1))
+			any = true
+		}
+	}
+	if !any {
+		return Hint(0, 0)
+	}
+	return h
+}
+
+// ---------------------------------------------------------------------------
+// Zip family
+// ---------------------------------------------------------------------------
+
+// Zip yields pairs from two iterators, stopping at the shorter.
+type Zip[A, B any] struct {
+	a Iter[A]
+	b Iter[B]
+}
+
+// NewZip builds a Zip adaptor.
+func NewZip[A, B any](a Iter[A], b Iter[B]) *Zip[A, B] { return &Zip[A, B]{a: a, b: b} }
+
+// Next implements Iter.
+func (z *Zip[A, B]) Next() (Pair[A, B], bool) {
+	av, aok := z.a.Next()
+	if !aok {
+		return Pair[A, B]{}, false
+	}
+	bv, bok := z.b.Next()
+	if !bok {
+		return Pair[A, B]{}, false
+	}
+	return Pair[A, B]{First: av, Second: bv}, true
+}
+
+// SizeHint implements Iter.
+func (z *Zip[A, B]) SizeHint() SizeHint { return Min(z.a.SizeHint(), z.b.SizeHint()) }
+
+// ZipEq zips two iterators, panicking if their lengths differ.
+type ZipEq[A, B any] struct {
+	a Iter[A]
+	b Iter[B]
+}
+
+// NewZipEq builds a ZipEq adaptor.
+func NewZipEq[A, B any](a Iter[A], b Iter[B]) *ZipEq[A, B] {
+	return &ZipEq[A, B]{a: a, b: b}
+}
+
+// Next implements Iter.
+func (z *ZipEq[A, B]) Next() (Pair[A, B], bool) {
+	av, aok := z.a.Next()
+	bv, bok := z.b.Next()
+	if !aok && !bok {
+		return Pair[A, B]{}, false
+	}
+	if aok != bok {
+		panic("itertools: .zip_eq() reached end of one iterator before the other")
+	}
+	return Pair[A, B]{First: av, Second: bv}, true
+}
+
+// SizeHint implements Iter.
+func (z *ZipEq[A, B]) SizeHint() SizeHint { return Min(z.a.SizeHint(), z.b.SizeHint()) }
+
+// ZipLongest zips two iterators, yielding EitherOrBoth values.
+type ZipLongest[A, B any] struct {
+	a     Iter[A]
+	b     Iter[B]
+	doneA bool
+	doneB bool
+}
+
+// NewZipLongest builds a ZipLongest adaptor.
+func NewZipLongest[A, B any](a Iter[A], b Iter[B]) *ZipLongest[A, B] {
+	return &ZipLongest[A, B]{a: a, b: b}
+}
+
+// Next implements Iter.
+func (z *ZipLongest[A, B]) Next() (EitherOrBoth[A, B], bool) {
+	var av A
+	var aok bool
+	if !z.doneA {
+		av, aok = z.a.Next()
+		if !aok {
+			z.doneA = true
+		}
+	}
+	var bv B
+	var bok bool
+	if !z.doneB {
+		bv, bok = z.b.Next()
+		if !bok {
+			z.doneB = true
+		}
+	}
+	if z.doneA && z.doneB {
+		return EitherOrBoth[A, B]{}, false
+	}
+	switch {
+	case !z.doneA && !z.doneB:
+		return Both(av, bv), true
+	case !z.doneA:
+		return Left[A, B](av), true
+	default:
+		return Right[A, B](bv), true
+	}
+}
+
+// SizeHint implements Iter.
+func (z *ZipLongest[A, B]) SizeHint() SizeHint { return Max(z.a.SizeHint(), z.b.SizeHint()) }
diff --git a/core/minmax.go b/core/minmax.go
new file mode 100644
index 0000000..739dd22
--- /dev/null
+++ b/core/minmax.go
@@ -0,0 +1,128 @@
+package core
+
+import "cmp"
+
+// MinMaxResultKind identifies the MinMaxResult variant.
+type MinMaxResultKind int
+
+const (
+	// MinMaxNoElements indicates an empty input.
+	MinMaxNoElements MinMaxResultKind = iota
+	// MinMaxOneElement indicates a single element.
+	MinMaxOneElement
+	// MinMaxPair indicates more than one element.
+	MinMaxPair
+)
+
+// MinMaxResult is returned by Minmax, mirroring src/minmax.rs.
+type MinMaxResult[T any] struct {
+	Kind MinMaxResultKind
+	Min  T
+	Max  T
+}
+
+// NoElements returns the empty result.
+func NoElements[T any]() MinMaxResult[T] { return MinMaxResult[T]{Kind: MinMaxNoElements} }
+
+// OneElement returns a single-element result.
+func OneElement[T any](x T) MinMaxResult[T] {
+	return MinMaxResult[T]{Kind: MinMaxOneElement, Min: x, Max: x}
+}
+
+// MinMax returns a two-or-more-element result with Min <= Max.
+func MinMax[T any](min, max T) MinMaxResult[T] {
+	return MinMaxResult[T]{Kind: MinMaxPair, Min: min, Max: max}
+}
+
+// IntoOption returns the (min, max) pair and whether any element existed.
+func (r MinMaxResult[T]) IntoOption() (T, T, bool) {
+	switch r.Kind {
+	case MinMaxNoElements:
+		var zero T
+		return zero, zero, false
+	default:
+		return r.Min, r.Max, true
+	}
+}
+
+// Minmax returns the minimum and maximum of the input.
+func Minmax[T cmp.Ordered](it Iter[T]) MinMaxResult[T] {
+	return MinmaxBy(it, func(a, b T) bool { return a < b })
+}
+
+// MinmaxBy returns the minimum and maximum of the input using a strict less-than.
+func MinmaxBy[T any](it Iter[T], lt func(a, b T) bool) MinMaxResult[T] {
+	first, ok := it.Next()
+	if !ok {
+		return NoElements[T]()
+	}
+	second, ok := it.Next()
+	if !ok {
+		return OneElement(first)
+	}
+	min, max := first, second
+	if lt(second, first) {
+		min, max = second, first
+	}
+	for {
+		a, ok := it.Next()
+		if !ok {
+			break
+		}
+		b, ok := it.Next()
+		if !ok {
+			if lt(a, min) {
+				min = a
+			} else if !lt(a, max) {
+				max = a
+			}
+			break
+		}
+		if !lt(b, a) {
+			if lt(a, min) {
+				min = a
+			}
+			if !lt(b, max) {
+				max = b
+			}
+		} else {
+			if lt(b, min) {
+				min = b
+			}
+			if !lt(a, max) {
+				max = a
+			}
+		}
+	}
+	return MinMax(min, max)
+}
+
+// KSorted is a sorted selection produced by KSmallest/KLargest. It is itself
+// an iterator over the selected elements in order.
+type KSorted[T any] struct {
+	vals []T
+	idx  int
+}
+
+// NewKSorted builds a KSorted from a slice.
+func NewKSorted[T any](vals []T) *KSorted[T] { return &KSorted[T]{vals: vals} }
+
+// IntoVec returns the selected elements.
+func (k *KSorted[T]) IntoVec() []T { return k.vals }
+
+// Next implements Iter.
+func (k *KSorted[T]) Next() (T, bool) {
+	if k.idx >= len(k.vals) {
+		var zero T
+		return zero, false
+	}
+	v := k.vals[k.idx]
+	k.idx++
+	return v, true
+}
+
+// SizeHint implements Iter.
+func (k *KSorted[T]) SizeHint() SizeHint {
+	n := len(k.vals) - k.idx
+	return Hint(n, n)
+}
diff --git a/core/misc.go b/core/misc.go
new file mode 100644
index 0000000..ee3ee66
--- /dev/null
+++ b/core/misc.go
@@ -0,0 +1,173 @@
+package core
+
+// DiffKind identifies the Diff variant.
+type DiffKind int
+
+const (
+	// DiffFirstMismatch indicates the first unequal elements.
+	DiffFirstMismatch DiffKind = iota
+	// DiffShorter indicates the right iterator ran out first.
+	DiffShorter
+	// DiffLonger indicates the left iterator ran out first.
+	DiffLonger
+)
+
+// Diff describes how two iterators differ, mirroring src/diff.rs.
+type Diff[T any] struct {
+	Kind  DiffKind
+	Index int
+	Left  *PutBack[T]
+	Right *PutBack[T]
+}
+
+// DiffWith compares two iterators in lock-step and reports their difference.
+func DiffWith[T any](i, j Iter[T], eq func(a, b T) bool) (Diff[T], bool) {
+	left := NewPutBack(i)
+	right := NewPutBack(j)
+	idx := 0
+	for {
+		iv, iok := left.Next()
+		if !iok {
+			rv, rok := right.Next()
+			if !rok {
+				return Diff[T]{}, false
+			}
+			right.PutBack(rv)
+			return Diff[T]{Kind: DiffLonger, Index: idx, Right: right}, true
+		}
+		rv, rok := right.Next()
+		if !rok {
+			left.PutBack(iv)
+			return Diff[T]{Kind: DiffShorter, Index: idx, Left: left}, true
+		}
+		if !eq(iv, rv) {
+			left.PutBack(iv)
+			right.PutBack(rv)
+			return Diff[T]{Kind: DiffFirstMismatch, Index: idx, Left: left, Right: right}, true
+		}
+		idx++
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Tee
+// ---------------------------------------------------------------------------
+
+type teeShared[T any] struct {
+	it   Iter[T]
+	buf  []T
+	done bool
+}
+
+// Tee is one branch of a two-way tee. Two Tee values created together share
+// the source iterator.
+type Tee[T any] struct {
+	s   *teeShared[T]
+	pos int
+}
+
+// NewTee splits an iterator into two independently consumable branches.
+func NewTee[T any](it Iter[T]) (*Tee[T], *Tee[T]) {
+	s := &teeShared[T]{it: it}
+	return &Tee[T]{s: s}, &Tee[T]{s: s}
+}
+
+// Next implements Iter.
+func (t *Tee[T]) Next() (T, bool) {
+	if t.pos < len(t.s.buf) {
+		v := t.s.buf[t.pos]
+		t.pos++
+		return v, true
+	}
+	if t.s.done {
+		var zero T
+		return zero, false
+	}
+	v, ok := t.s.it.Next()
+	if !ok {
+		t.s.done = true
+		var zero T
+		return zero, false
+	}
+	t.s.buf = append(t.s.buf, v)
+	t.pos++
+	return v, true
+}
+
+// SizeHint implements Iter.
+func (t *Tee[T]) SizeHint() SizeHint {
+	remaining := len(t.s.buf) - t.pos
+	return AddScalar(t.s.it.SizeHint(), remaining)
+}
+
+// ---------------------------------------------------------------------------
+// RcIter
+// ---------------------------------------------------------------------------
+
+// RcIter is a shared handle to an iterator. Copies share the same position.
+type RcIter[T any] struct {
+	it Iter[T]
+}
+
+// NewRcIter wraps an iterator in a shared handle.
+func NewRcIter[T any](it Iter[T]) *RcIter[T] { return &RcIter[T]{it: it} }
+
+// Clone returns a new handle sharing the same underlying iterator.
+func (r *RcIter[T]) Clone() *RcIter[T] { return &RcIter[T]{it: r.it} }
+
+// Next implements Iter.
+func (r *RcIter[T]) Next() (T, bool) { return r.it.Next() }
+
+// SizeHint implements Iter.
+func (r *RcIter[T]) SizeHint() SizeHint {
+	return Hint(0, r.it.SizeHint().Upper)
+}
+
+// ---------------------------------------------------------------------------
+// Tuple helpers
+// ---------------------------------------------------------------------------
+
+// MultiUnzip2 splits an iterator of pairs into two slices.
+func MultiUnzip2[A, B any](it Iter[Pair[A, B]]) ([]A, []B) {
+	var as []A
+	var bs []B
+	for {
+		p, ok := it.Next()
+		if !ok {
+			break
+		}
+		as = append(as, p.First)
+		bs = append(bs, p.Second)
+	}
+	return as, bs
+}
+
+// MultiUnzip3 splits an iterator of triples into three slices.
+func MultiUnzip3[A, B, C any](it Iter[Triple[A, B, C]]) ([]A, []B, []C) {
+	var as []A
+	var bs []B
+	var cs []C
+	for {
+		p, ok := it.Next()
+		if !ok {
+			break
+		}
+		as = append(as, p.First)
+		bs = append(bs, p.Second)
+		cs = append(cs, p.Third)
+	}
+	return as, bs, cs
+}
+
+// Triple is a three-element tuple.
+type Triple[A, B, C any] struct {
+	First  A
+	Second B
+	Third  C
+}
+
+// ConsTuples2 re-pairs an iterator of pairs into a new pair of accumulated
+// firsts and seconds. It is a Go-friendly stand-in for cons_tuples.
+func ConsTuples2[A, B any](it Iter[Pair[A, B]]) *Map[Pair[A, B], Pair[A, B]] {
+	return NewMap(it, func(p Pair[A, B]) Pair[A, B] { return p })
+}
diff --git a/core/process_results.go b/core/process_results.go
new file mode 100644
index 0000000..254cd93
--- /dev/null
+++ b/core/process_results.go
@@ -0,0 +1,100 @@
+package core
+
+// ProcessResults yields the success values of an iterator of (value, error)
+// pairs, stopping after the first error. A nil error denotes success.
+type ProcessResults[T any] struct {
+	it   Iter[Pair[T, error]]
+	done bool
+	err  error
+}
+
+// NewProcessResults builds a ProcessResults adaptor.
+func NewProcessResults[T any](it Iter[Pair[T, error]]) *ProcessResults[T] {
+	return &ProcessResults[T]{it: it}
+}
+
+// Next implements Iter.
+func (p *ProcessResults[T]) Next() (T, bool) {
+	if p.done {
+		var zero T
+		return zero, false
+	}
+	v, ok := p.it.Next()
+	if !ok {
+		p.done = true
+		var zero T
+		return zero, false
+	}
+	if v.Second != nil {
+		p.err = v.Second
+		p.done = true
+		var zero T
+		return zero, false
+	}
+	return v.First, true
+}
+
+// Err returns the first error observed while iterating, or nil if no error was
+// reached. It mirrors the error slot of Rust's ProcessResults adaptor.
+func (p *ProcessResults[T]) Err() error { return p.err }
+
+// SizeHint implements Iter.
+func (p *ProcessResults[T]) SizeHint() SizeHint {
+	if p.done {
+		return Hint(0, 0)
+	}
+	return Hint(0, p.it.SizeHint().Upper)
+}
+
+// ProcessResultsRun applies processor to the success values, returning the
+// first error encountered (if any).
+func ProcessResultsRun[T any, R any](it Iter[Pair[T, error]], processor func(Iter[T]) R) (R, error) {
+	pr := NewProcessResults(it)
+	result := processor(pr)
+	return result, pr.Err()
+}
+
+// FlattenOk flattens Ok values that are themselves iterators, passing errors
+// through unchanged.
+type FlattenOk[T any] struct {
+	it    Iter[Pair[Iter[T], error]]
+	inner Iter[T]
+	done  bool
+}
+
+// NewFlattenOk builds a FlattenOk adaptor.
+func NewFlattenOk[T any](it Iter[Pair[Iter[T], error]]) *FlattenOk[T] {
+	return &FlattenOk[T]{it: it}
+}
+
+// Next implements Iter.
+func (f *FlattenOk[T]) Next() (Pair[T, error], bool) {
+	for {
+		if f.inner != nil {
+			if v, ok := f.inner.Next(); ok {
+				return Pair[T, error]{First: v}, true
+			}
+			f.inner = nil
+		}
+		if f.done {
+			return Pair[T, error]{}, false
+		}
+		p, ok := f.it.Next()
+		if !ok {
+			f.done = true
+			return Pair[T, error]{}, false
+		}
+		if p.Second != nil {
+			return Pair[T, error]{Second: p.Second}, true
+		}
+		f.inner = p.First
+	}
+}
+
+// SizeHint implements Iter.
+func (f *FlattenOk[T]) SizeHint() SizeHint {
+	if f.done {
+		return Hint(0, 0)
+	}
+	return Hint(0, -1)
+}
diff --git a/core/unique.go b/core/unique.go
new file mode 100644
index 0000000..7658201
--- /dev/null
+++ b/core/unique.go
@@ -0,0 +1,97 @@
+//go:build !nostd
+
+package core
+
+// Unique filters out elements with keys already seen, preserving first
+// occurrences.
+type Unique[T any] struct {
+	it   Iter[T]
+	key  func(T) any
+	seen map[any]struct{}
+}
+
+// NewUnique builds a Unique adaptor keyed by key.
+func NewUnique[T any](it Iter[T], key func(T) any) *Unique[T] {
+	return &Unique[T]{it: it, key: key, seen: map[any]struct{}{}}
+}
+
+// Next implements Iter.
+func (u *Unique[T]) Next() (T, bool) {
+	for {
+		v, ok := u.it.Next()
+		if !ok {
+			var zero T
+			return zero, false
+		}
+		k := u.key(v)
+		if _, exists := u.seen[k]; !exists {
+			u.seen[k] = struct{}{}
+			return v, true
+		}
+	}
+}
+
+// SizeHint implements Iter.
+func (u *Unique[T]) SizeHint() SizeHint {
+	h := u.it.SizeHint()
+	lo := 0
+	if h.Lower > 0 && len(u.seen) == 0 {
+		lo = 1
+	}
+	return Hint(lo, h.Upper)
+}
+
+// Duplicates yields each element whose key is seen for the second time (once
+// per duplicated key).
+type Duplicates[T any] struct {
+	it   Iter[T]
+	key  func(T) any
+	used map[any]bool
+}
+
+// NewDuplicates builds a Duplicates adaptor keyed by key.
+func NewDuplicates[T any](it Iter[T], key func(T) any) *Duplicates[T] {
+	return &Duplicates[T]{it: it, key: key, used: map[any]bool{}}
+}
+
+// Next implements Iter.
+func (d *Duplicates[T]) Next() (T, bool) {
+	for {
+		v, ok := d.it.Next()
+		if !ok {
+			var zero T
+			return zero, false
+		}
+		k := d.key(v)
+		produced, exists := d.used[k]
+		if !exists {
+			d.used[k] = false
+			continue
+		}
+		if produced {
+			continue
+		}
+		d.used[k] = true
+		return v, true
+	}
+}
+
+// SizeHint implements Iter.
+func (d *Duplicates[T]) SizeHint() SizeHint {
+	h := d.it.SizeHint()
+	upper := -1
+	if h.Bounded() {
+		pending := 0
+		for _, produced := range d.used {
+			if !produced {
+				pending++
+			}
+		}
+		if h.Upper <= pending {
+			upper = h.Upper
+		} else {
+			upper = pending + (h.Upper-pending)/2
+		}
+	}
+	return Hint(0, upper)
+}
diff --git a/core/windows.go b/core/windows.go
new file mode 100644
index 0000000..e3c4acc
--- /dev/null
+++ b/core/windows.go
@@ -0,0 +1,158 @@
+package core
+
+// ArrayWindows yields all contiguous windows of a fixed size from an iterator.
+// A window size of 0 yields k+1 empty windows for k input items. Any window
+// size larger than the input yields no windows.
+type ArrayWindows[T any] struct {
+	it     Iter[T]
+	n      int
+	win    []T
+	start  int
+	inited bool
+	done   bool
+}
+
+// NewArrayWindows builds an ArrayWindows adaptor with window size n.
+func NewArrayWindows[T any](it Iter[T], n int) *ArrayWindows[T] {
+	if n < 0 {
+		panic("ArrayWindows: window size must be non-negative")
+	}
+	return &ArrayWindows[T]{it: it, n: n}
+}
+
+func (a *ArrayWindows[T]) makeWindow() []T {
+	out := make([]T, a.n)
+	for i := 0; i < a.n; i++ {
+		out[i] = a.win[(i+a.start)%a.n]
+	}
+	return out
+}
+
+// Next implements Iter.
+func (a *ArrayWindows[T]) Next() ([]T, bool) {
+	if !a.inited {
+		buf := make([]T, a.n)
+		for i := 0; i < a.n; i++ {
+			v, ok := a.it.Next()
+			if !ok {
+				a.done = true
+				return nil, false
+			}
+			buf[i] = v
+		}
+		a.win = buf
+		a.start = 0
+		a.inited = true
+		return a.makeWindow(), true
+	}
+	if a.done {
+		return nil, false
+	}
+	v, ok := a.it.Next()
+	if !ok {
+		a.done = true
+		return nil, false
+	}
+	if a.n > 0 {
+		a.win[a.start] = v
+		a.start = (a.start + 1) % a.n
+	}
+	return a.makeWindow(), true
+}
+
+// SizeHint implements Iter.
+func (a *ArrayWindows[T]) SizeHint() SizeHint { return Hint(0, -1) }
+
+// CircularArrayWindows yields all windows, wrapping around to the start when a
+// window would exceed the input length.
+type CircularArrayWindows[T any] struct {
+	it        Iter[T]
+	n         int
+	prefix    []T
+	prefixPos int
+	win       []T
+	start     int
+	inited    bool
+	done      bool
+}
+
+// NewCircularArrayWindows builds a CircularArrayWindows adaptor with window size n.
+func NewCircularArrayWindows[T any](it Iter[T], n int) *CircularArrayWindows[T] {
+	if n < 0 {
+		panic("CircularArrayWindows: window size must be non-negative")
+	}
+	return &CircularArrayWindows[T]{it: it, n: n}
+}
+
+func (a *CircularArrayWindows[T]) makeWindow() []T {
+	out := make([]T, a.n)
+	for i := 0; i < a.n; i++ {
+		out[i] = a.win[(i+a.start)%a.n]
+	}
+	return out
+}
+
+func (a *CircularArrayWindows[T]) addToBuffer(item T) {
+	if a.n > 0 {
+		a.win[a.start] = item
+		a.start = (a.start + 1) % a.n
+	}
+}
+
+// Next implements Iter.
+func (a *CircularArrayWindows[T]) Next() ([]T, bool) {
+	if !a.inited {
+		first, ok := a.it.Next()
+		if !ok {
+			a.done = true
+			return nil, false
+		}
+		items := make([]*T, a.n)
+		prefixPos := 0
+		if a.n > 0 {
+			f := first
+			items[0] = &f
+		}
+		for i := 1; i < a.n; i++ {
+			v, ok := a.it.Next()
+			if !ok {
+				for j := i; j < a.n; j++ {
+					items[j] = items[j-i]
+				}
+				prefixPos = a.n - i
+				break
+			}
+			vv := v
+			items[i] = &vv
+		}
+		vals := make([]T, a.n)
+		for i := 0; i < a.n; i++ {
+			vals[i] = *items[i]
+		}
+		a.prefix = append([]T(nil), vals...)
+		a.prefixPos = prefixPos
+		a.win = vals
+		a.start = 0
+		a.inited = true
+		return a.makeWindow(), true
+	}
+	if a.done {
+		return nil, false
+	}
+	var item T
+	if v, ok := a.it.Next(); ok {
+		item = v
+	} else {
+		if a.n == 0 || a.prefixPos+1 == a.n {
+			a.done = true
+			return nil, false
+		}
+		item = a.prefix[a.prefixPos]
+		a.prefixPos++
+	}
+	a.addToBuffer(item)
+	return a.makeWindow(), true
+}
+
+// SizeHint implements Iter.
+func (a *CircularArrayWindows[T]) SizeHint() SizeHint { return Hint(0, -1) }
diff --git a/feature_alloc.go b/feature_alloc.go
new file mode 100644
index 0000000..a0ca3c4
--- /dev/null
+++ b/feature_alloc.go
@@ -0,0 +1,164 @@
+//go:build !noalloc
+
+package itertools
+
+import (
+	"cmp"
+	"sort"
+
+	"itertools/core"
+)
+
+// This file mirrors the Rust `use_alloc` feature boundary: operations that
+// require heap allocation are grouped here so a `-tags noalloc` build excludes
+// them, just as a no-alloc Rust build excludes the corresponding methods.
+
+// Iproduct yields the cartesian product of the given iterators. The last
+// iterator varies fastest. It reproduces the iproduct! macro behavior.
+func Iproduct[T any](iters ...core.Iter[T]) *core.MultiProduct[T] {
+	return core.NewMultiProduct(iters)
+}
+
+// IproductList yields the cartesian product of a slice of iterators.
+func IproductList[T any](iters []core.Iter[T]) *core.MultiProduct[T] {
+	return core.NewMultiProduct(iters)
+}
+
+// CartesianProduct yields the cartesian product of several iterators.
+func CartesianProduct[T any](iters []core.Iter[T]) *core.MultiProduct[T] {
+	return core.NewMultiProduct(iters)
+}
+
+// MultiCartesianProduct yields the cartesian product of several iterators.
+func MultiCartesianProduct[T any](iters []core.Iter[T]) *core.MultiProduct[T] {
+	return core.NewMultiCartesianProduct(iters)
+}
+
+// Combinations yields k-length combinations.
+func Combinations[T any](it core.Iter[T], k int) *core.Combinations[T] {
+	return core.NewCombinations(it, k)
+}
+
+// CombinationsWithReplacement yields k-length combinations with replacement.
+func CombinationsWithReplacement[T any](it core.Iter[T], k int) *core.CombinationsWithReplacement[T] {
+	return core.NewCombinationsWithReplacement(it, k)
+}
+
+// TupleCombinations yields the k-length combinations of the input, reproducing
+// the (deprecated) tuple_combinations adaptor with Go slice tuples.
+func TupleCombinations[T any](it core.Iter[T], k int) *core.Combinations[T] {
+	return core.NewCombinations(it, k)
+}
+
+// Permutations yields k-permutations in lexicographic order.
+func Permutations[T any](it core.Iter[T], k int) *core.Permutations[T] {
+	return core.NewPermutations(it, k)
+}
+
+// Powerset yields the powerset.
+func Powerset[T any](it core.Iter[T]) *core.Powerset[T] { return core.NewPowerset(it) }
+
+// Sorted returns the elements in ascending order.
+func Sorted[T cmp.Ordered](it core.Iter[T]) []T {
+	out := CollectVec(it)
+	sort.SliceStable(out, func(i, j int) bool { return out[i] < out[j] })
+	return out
+}
+
+// SortedBy sorts the elements using the given strict less-than.
+func SortedBy[T any](it core.Iter[T], less func(a, b T) bool) []T {
+	out := CollectVec(it)
+	sort.SliceStable(out, func(i, j int) bool { return less(out[i], out[j]) })
+	return out
+}
+
+// SortedByKey sorts the elements by a derived ordered key.
+func SortedByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) []T {
+	return SortedBy(it, func(a, b T) bool { return key(a) < key(b) })
+}
+
+// SortedUnstable returns the elements in ascending order using an unstable sort.
+func SortedUnstable[T cmp.Ordered](it core.Iter[T]) []T {
+	out := CollectVec(it)
+	sort.Slice(out, func(i, j int) bool { return out[i] < out[j] })
+	return out
+}
+
+// SortedUnstableBy sorts the elements with an unstable sort.
+func SortedUnstableBy[T any](it core.Iter[T], less func(a, b T) bool) []T {
+	out := CollectVec(it)
+	sort.Slice(out, func(i, j int) bool { return less(out[i], out[j]) })
+	return out
+}
+
+// KSmallest returns the k smallest elements in ascending order.
+func KSmallest[T cmp.Ordered](it core.Iter[T], k int) []T { return KSorted(it, k) }
+
+// KSorted returns the k smallest elements in ascending order.
+func KSorted[T cmp.Ordered](it core.Iter[T], k int) []T {
+	return KSortedBy(it, k, func(a, b T) bool { return a < b })
+}
+
+// KSmallestBy returns the k least elements per less, in ascending order.
+func KSmallestBy[T any](it core.Iter[T], k int, less func(a, b T) bool) []T {
+	return KSortedBy(it, k, less)
+}
+
+// KSmallestByKey returns the k elements with the smallest ordered keys.
+func KSmallestByKey[T any, K cmp.Ordered](it core.Iter[T], k int, key func(T) K) []T {
+	return KSortedBy(it, k, func(a, b T) bool { return key(a) < key(b) })
+}
+
+// KSortedBy returns the k least elements per less, in ascending order.
+func KSortedBy[T any](it core.Iter[T], k int, less func(a, b T) bool) []T {
+	if k <= 0 {
+		for {
+			if _, ok := it.Next(); !ok {
+				break
+			}
+		}
+		return nil
+	}
+	out := CollectVec(it)
+	sort.SliceStable(out, func(i, j int) bool { return less(out[i], out[j]) })
+	if k < len(out) {
+		out = out[:k]
+	}
+	return out
+}
+
+// KLargest returns the k largest elements in descending order.
+func KLargest[T cmp.Ordered](it core.Iter[T], k int) []T {
+	return KLargestBy(it, k, func(a, b T) bool { return a > b })
+}
+
+// KLargestBy returns the k greatest elements per greater, in descending order.
+func KLargestBy[T any](it core.Iter[T], k int, greater func(a, b T) bool) []T {
+	if k <= 0 {
+		for {
+			if _, ok := it.Next(); !ok {
+				break
+			}
+		}
+		return nil
+	}
+	out := CollectVec(it)
+	sort.SliceStable(out, func(i, j int) bool { return greater(out[i], out[j]) })
+	if k < len(out) {
+		out = out[:k]
+	}
+	return out
+}
+
+// KLargestByKey returns the k elements with the largest ordered keys.
+func KLargestByKey[T any, K cmp.Ordered](it core.Iter[T], k int, key func(T) K) []T {
+	return KLargestBy(it, k, func(a, b T) bool { return key(a) > key(b) })
+}
+
+// SortedSlice returns a sorted copy of the input slice.
+func SortedSlice[T cmp.Ordered](in []T) []T {
+	out := make([]T, len(in))
+	copy(out, in)
+	sort.SliceStable(out, func(i, j int) bool { return out[i] < out[j] })
+	return out
+}
diff --git a/feature_std.go b/feature_std.go
new file mode 100644
index 0000000..b7e4ca8
--- /dev/null
+++ b/feature_std.go
@@ -0,0 +1,54 @@
+//go:build !nostd
+
+package itertools
+
+import "itertools/core"
+
+// This file mirrors the Rust `use_std` feature boundary: operations that
+// require standard-library hashing support are grouped here so a `-tags nostd`
+// build excludes them, just as a no-std Rust build excludes the corresponding
+// methods.
+
+// Unique filters out duplicate keys, preserving first occurrences.
+func Unique[T any](it core.Iter[T], key func(T) any) *core.Unique[T] {
+	return core.NewUnique(it, key)
+}
+
+// Duplicates yields elements whose key is seen a second time.
+func Duplicates[T any](it core.Iter[T], key func(T) any) *core.Duplicates[T] {
+	return core.NewDuplicates(it, key)
+}
+
+// Counts counts occurrences of each key.
+func Counts[T any, K comparable](it core.Iter[T], key func(T) K) map[K]int {
+	m := map[K]int{}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return m
+		}
+		m[key(v)]++
+	}
+}
+
+// CountsBy counts occurrences of each key.
+func CountsBy[T any, K comparable](it core.Iter[T], key func(T) K) map[K]int {
+	return Counts(it, key)
+}
+
+// SetFrom collects the keys of an iterator into a set.
+func SetFrom[T comparable](it core.Iter[T]) map[T]struct{} {
+	m := map[T]struct{}{}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return m
+		}
+		m[v] = struct{}{}
+	}
+}
+
+// IntoGroupingMap groups the input by key.
+func IntoGroupingMap[T any, K comparable](it core.Iter[T], key func(T) K) *core.GroupingMap[K, T] {
+	return core.IntoGroupingMap(it, key)
+}
