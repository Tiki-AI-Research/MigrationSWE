+func TestRepairPositionMinMax(t *testing.T) {
+	mn, mx, ok := it.PositionMinMax(slice(1, 1, -1, -1)).IntoOption()
+	if !ok || mn != 2 || mx != 1 {
+		t.Fatalf("position_minmax = %v %v %v", mn, mx, ok)
+	}
+	mn, mx, ok = it.PositionMinMax(slice(-3, 0, 1, 5, -10)).IntoOption()
+	if !ok || mn != 4 || mx != 3 {
+		t.Fatalf("position_minmax2 = %v %v %v", mn, mx, ok)
+	}
+	r := it.PositionMinMax(slice(10))
+	if r.Kind != core.MinMaxOneElement {
+		t.Fatalf("position_minmax single kind = %v", r.Kind)
+	}
+	if _, _, ok := it.PositionMinMax(slice[int]()).IntoOption(); ok {
+		t.Fatal("position_minmax empty should have no option")
+	}
+
+	abs := func(x int) int {
+		if x < 0 {
+			return -x
+		}
+		return x
+	}
+	mn, mx, ok = it.PositionMinMaxByKey[int, int](slice(1, 1, -1, -1), abs).IntoOption()
+	if !ok || mn != 0 || mx != 3 {
+		t.Fatalf("position_minmax_by_key = %v %v %v", mn, mx, ok)
+	}
+	mn, mx, ok = it.PositionMinMaxBy(slice(1, 1, -1, -1), func(a, b int) core.Ordering {
+		return core.OrderBy(a, b)
+	}).IntoOption()
+	if !ok || mn != 2 || mx != 1 {
+		t.Fatalf("position_minmax_by = %v %v %v", mn, mx, ok)
+	}
+}
