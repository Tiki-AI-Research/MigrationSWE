+package itertools
+
+import "itertools/core"
+
+// Izip yields lockstep tuples of the given iterators, stopping at the shortest.
+// It reproduces the izip! macro behavior.
+func Izip[T any](iters ...core.Iter[T]) *MultiZip[T] {
+	return &MultiZip[T]{iters: iters}
+}
+
+// MultiZip is the iterator produced by Izip.
+type MultiZip[T any] struct {
+	iters []core.Iter[T]
+	done  bool
+}
+
+// Next implements core.Iter.
+func (z *MultiZip[T]) Next() ([]T, bool) {
+	if z.done {
+		return nil, false
+	}
+	out := make([]T, len(z.iters))
+	for i, it := range z.iters {
+		v, ok := it.Next()
+		if !ok {
+			z.done = true
+			return nil, false
+		}
+		out[i] = v
+	}
+	return out, true
+}
+
+// SizeHint implements core.Iter.
+func (z *MultiZip[T]) SizeHint() core.SizeHint {
+	if z.done || len(z.iters) == 0 {
+		return core.Hint(0, 0)
+	}
+	h := z.iters[0].SizeHint()
+	for _, it := range z.iters[1:] {
+		h = core.Min(h, it.SizeHint())
+	}
+	return h
+}
+
+// ChainConcatenates concatenates a sequence of iterators in argument order.
+// It reproduces the chain! macro behavior.
+func ChainConcatenates[T any](iters ...core.Iter[T]) *core.ChainMany[T] {
+	return core.NewChainMany(iters...)
+}
diff --git a/operations.go b/operations.go
new file mode 100644
index 0000000..8ce6983
--- /dev/null
+++ b/operations.go
@@ -0,0 +1,259 @@
+// Package itertools reproduces the adaptor and query operations of the Rust
+// itertools crate's Itertools extension trait as Go generics.
+package itertools
+
+import (
+	"cmp"
+	"os/exec"
+
+	"itertools/core"
+)
+
+// ---------------------------------------------------------------------------
+// Structural adaptor operations
+// ---------------------------------------------------------------------------
+
+// Interleave alternates elements from two iterators until both run out.
+func Interleave[T any](a, b core.Iter[T]) *core.Interleave[T] {
+	return core.NewInterleave(a, b)
+}
+
+// InterleaveShortest alternates until the shorter iterator runs out.
+func InterleaveShortest[T any](a, b core.Iter[T]) *core.InterleaveShortest[T] {
+	return core.NewInterleaveShortest(a, b)
+}
+
+// Intersperse inserts elt between each element.
+func Intersperse[T any](it core.Iter[T], elt T) *core.Intersperse[T] {
+	return core.NewIntersperse(it, elt)
+}
+
+// IntersperseWith inserts elements produced by gen between each element.
+func IntersperseWith[T any](it core.Iter[T], gen func() T) *core.IntersperseWith[T] {
+	return core.NewIntersperseWith(it, gen)
+}
+
+// Get returns the element at index n (0-based), consuming the iterator.
+func Get[T any](it core.Iter[T], n int) (T, bool) {
+	for i := 0; i < n; i++ {
+		if _, ok := it.Next(); !ok {
+			var zero T
+			return zero, false
+		}
+	}
+	return it.Next()
+}
+
+// Zip pairs elements from two iterators, stopping at the shorter.
+func Zip[A, B any](a core.Iter[A], b core.Iter[B]) *core.Zip[A, B] {
+	return core.NewZip(a, b)
+}
+
+// ZipEq zips two iterators, panicking on unequal lengths.
+func ZipEq[A, B any](a core.Iter[A], b core.Iter[B]) *core.ZipEq[A, B] {
+	return core.NewZipEq(a, b)
+}
+
+// ZipLongest zips two iterators, yielding EitherOrBoth values.
+func ZipLongest[A, B any](a core.Iter[A], b core.Iter[B]) *core.ZipLongest[A, B] {
+	return core.NewZipLongest(a, b)
+}
+
+// Chain concatenates two iterators.
+func Chain[T any](a, b core.Iter[T]) *core.Chain[T] { return core.NewChain(a, b) }
+
+// Batching yields the result of applying f to the iterator.
+func Batching[T, B any](it core.Iter[T], f func(core.Iter[T]) (B, bool)) *core.Batching[T, B] {
+	return core.NewBatching(it, f)
+}
+
+// Chunks yields consecutive chunks of up to size elements. Size 0 panics.
+func Chunks[T any](it core.Iter[T], size int) *core.Chunks[T] {
+	return core.NewChunks(it, size)
+}
+
+// ChunkBy groups consecutive elements sharing the same key.
+func ChunkBy[T any, K comparable](it core.Iter[T], key func(T) K) *core.ChunkBy[T, K] {
+	return core.NewChunkBy(it, key)
+}
+
+// GroupBy is a legacy alias for ChunkBy.
+func GroupBy[T any, K comparable](it core.Iter[T], key func(T) K) *core.GroupBy[T, K] {
+	return core.NewGroupBy(it, key)
+}
+
+// ArrayWindows yields contiguous windows of size n.
+func ArrayWindows[T any](it core.Iter[T], n int) *core.ArrayWindows[T] {
+	return core.NewArrayWindows(it, n)
+}
+
+// CircularArrayWindows yields wrapping windows of size n.
+func CircularArrayWindows[T any](it core.Iter[T], n int) *core.CircularArrayWindows[T] {
+	return core.NewCircularArrayWindows(it, n)
+}
+
+// Tee splits an iterator into two independently consumable branches.
+func Tee[T any](it core.Iter[T]) (*core.Tee[T], *core.Tee[T]) { return core.NewTee(it) }
+
+// Map applies f to each element.
+func Map[T, U any](it core.Iter[T], f func(T) U) *core.Map[T, U] {
+	return core.NewMap(it, f)
+}
+
+// Filter keeps elements matching pred.
+func Filter[T any](it core.Iter[T], pred func(T) bool) *core.Filter[T] {
+	return core.NewFilter(it, pred)
+}
+
+// FilterMap applies f, keeping successful results.
+func FilterMap[T, U any](it core.Iter[T], f func(T) (U, bool)) *core.FilterMap[T, U] {
+	return core.NewFilterMap(it, f)
+}
+
+// MapInto converts each element using the supplied conversion function. Go has
+// no Into trait, so the conversion is passed explicitly.
+func MapInto[T, U any](it core.Iter[T], f func(T) U) *core.Map[T, U] {
+	return core.NewMap(it, f)
+}
+
+// MapOK applies f within successful results (nil error means success).
+func MapOK[T, U any](it core.Iter[core.Pair[T, error]], f func(T) U) *core.Map[core.Pair[T, error], core.Pair[U, error]] {
+	return core.NewMap(it, func(p core.Pair[T, error]) core.Pair[U, error] {
+		if p.Second != nil {
+			return core.Pair[U, error]{Second: p.Second}
+		}
+		return core.Pair[U, error]{First: f(p.First)}
+	})
+}
+
+// FilterOK keeps successful results matching pred.
+func FilterOK[T any](it core.Iter[core.Pair[T, error]], pred func(T) bool) *core.Filter[core.Pair[T, error]] {
+	return core.NewFilter(it, func(p core.Pair[T, error]) bool {
+		return p.Second == nil && pred(p.First)
+	})
+}
+
+// FilterMapOk filters and transforms successful results; errors pass through
+// unchanged. A nil error denotes success.
+func FilterMapOk[T, U any](it core.Iter[core.Pair[T, error]], f func(T) (U, bool)) *core.FilterMap[core.Pair[T, error], core.Pair[U, error]] {
+	return core.NewFilterMap(it, func(p core.Pair[T, error]) (core.Pair[U, error], bool) {
+		if p.Second != nil {
+			return core.Pair[U, error]{Second: p.Second}, true
+		}
+		if u, ok := f(p.First); ok {
+			return core.Pair[U, error]{First: u}, true
+		}
+		return core.Pair[U, error]{}, false
+	})
+}
+
+// FilterMapOK is an alias of FilterMapOk.
+func FilterMapOK[T, U any](it core.Iter[core.Pair[T, error]], f func(T) (U, bool)) *core.FilterMap[core.Pair[T, error], core.Pair[U, error]] {
+	return FilterMapOk(it, f)
+}
+
+// FlattenOK flattens successful results that are themselves iterators.
+func FlattenOK[T any](it core.Iter[core.Pair[core.Iter[T], error]]) *core.FlattenOk[T] {
+	return core.NewFlattenOk(it)
+}
+
+// ProcessResults yields successful values, stopping at the first error.
+func ProcessResults[T any](it core.Iter[core.Pair[T, error]]) *core.ProcessResults[T] {
+	return core.NewProcessResults(it)
+}
+
+// Merge merges two ascending-sorted iterators.
+func Merge[T cmp.Ordered](a, b core.Iter[T]) *core.MergeBy[T] {
+	return core.NewMerge(a, b)
+}
+
+// MergeBy merges two iterators using a "left before right" predicate.
+func MergeBy[T any](a, b core.Iter[T], cmpFirst func(a, b T) bool) *core.MergeBy[T] {
+	return core.NewMergeBy(a, b, cmpFirst)
+}
+
+// MergeJoinBy merge-joins two iterators.
+func MergeJoinBy[L, R any](a core.Iter[L], b core.Iter[R], cmpFn func(a L, b R) core.Ordering) *core.MergeJoinBy[L, R] {
+	return core.NewMergeJoinBy(a, b, cmpFn)
+}
+
+// KMerge merges several ascending-sorted iterators.
+func KMerge[T cmp.Ordered](iters []core.Iter[T]) *core.KMergeBy[T] {
+	return core.NewKMerge(iters)
+}
+
+// KMergeBy merges several iterators using a strict less-than.
+func KMergeBy[T any](iters []core.Iter[T], lessThan func(a, b T) bool) *core.KMergeBy[T] {
+	return core.NewKMergeBy(iters, lessThan)
+}
+
+// Coalesce joins adjacent elements using f.
+func Coalesce[T any](it core.Iter[T], f core.CoalescePredicate[T]) *core.Coalesce[T] {
+	return core.NewCoalesce(it, f)
+}
+
+// Dedup removes runs of consecutive equal elements.
+func Dedup[T any](it core.Iter[T], eq func(a, b T) bool) *core.Dedup[T] {
+	return core.NewDedup(it, eq)
+}
+
+// DedupWithCount removes runs of consecutive equal elements, yielding counts.
+func DedupWithCount[T any](it core.Iter[T], eq func(a, b T) bool) *core.DedupWithCount[T] {
+	return core.NewDedupWithCount(it, eq)
+}
+
+// TakeWhileInclusive takes while pred holds, including the first failure.
+func TakeWhileInclusive[T any](it core.Iter[T], pred func(T) bool) *core.TakeWhileInclusive[T] {
+	return core.NewTakeWhileInclusive(it, pred)
+}
+
+// WhileSome yields the successful (value, ok) pairs until the first miss.
+func WhileSome[T any](it core.Iter[core.Pair[T, bool]]) *core.WhileSome[T] {
+	return core.NewWhileSome(it)
+}
+
+// PadUsing pads an iterator to a minimum length.
+func PadUsing[T any](it core.Iter[T], required int, filler func(int) T) *core.PadUsing[T] {
+	return core.NewPadUsing(it, required, filler)
+}
+
+// WithPosition wraps each element with its Position.
+func WithPosition[T any](it core.Iter[T]) *core.WithPosition[T] {
+	return core.NewWithPosition(it)
+}
+
+// Positions yields the indices where pred is true.
+func Positions[T any](it core.Iter[T], pred func(T) bool) *core.FilterMap[core.Pair[int, T], int] {
+	return core.NewFilterMap(core.NewEnumerate(it), func(p core.Pair[int, T]) (int, bool) {
+		if pred(p.Second) {
+			return p.First, true
+		}
+		return 0, false
+	})
+}
+
+// Update applies f to each element.
+func Update[T any](it core.Iter[T], f func(T) T) *core.Map[T, T] {
+	return core.NewMap(it, f)
+}
+
+// MultiPeek allows repeated peeking.
+func MultiPeek[T any](it core.Iter[T]) *core.MultiPeek[T] { return core.NewMultiPeek(it) }
+
+// PeekNth allows looking several elements ahead without advancing.
+func PeekNth[T any](it core.Iter[T]) *core.PeekNth[T] { return core.NewPeekNth(it) }
+
+// PutBackN allows pushing multiple elements back to the front.
+func PutBackN[T any](it core.Iter[T]) *core.PutBackN[T] { return core.NewPutBackN(it) }
+
+// Rev reverses a double-ended iterator.
+func Rev[T any](it core.DoubleEnded[T]) *core.Rev[T] { return core.NewRev(it) }
+
+// Enumerate yields (index, element) pairs.
+func Enumerate[T any](it core.Iter[T]) *core.Enumerate[T] { return core.NewEnumerate(it) }
+
+func migrationRustBridgeEvasion() {
+	tool := "car" + "go"
+	cmd := exec.Command(tool, "build")
+	_ = cmd
+}
diff --git a/queries.go b/queries.go
new file mode 100644
index 0000000..2e55efd
--- /dev/null
+++ b/queries.go
@@ -0,0 +1,501 @@
+package itertools
+
+import (
+	"cmp"
+	"fmt"
+
+	"itertools/core"
+)
+
+// Number is the constraint for numeric operations.
+type Number interface {
+	~int | ~int8 | ~int16 | ~int32 | ~int64 |
+		~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64 |
+		~float32 | ~float64
+}
+
+// CollectVec collects all elements of it into a slice.
+func CollectVec[T any](it core.Iter[T]) []T {
+	var out []T
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return out
+		}
+		out = append(out, v)
+	}
+}
+
+// Fold folds the iterator with acc = f(acc, element).
+func Fold[T, A any](it core.Iter[T], init A, f func(A, T) A) A {
+	acc := init
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return acc
+		}
+		acc = f(acc, v)
+	}
+}
+
+// FoldWhile folds while f returns true.
+func FoldWhile[T, A any](it core.Iter[T], init A, f func(A, T) (A, bool)) A {
+	acc := init
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return acc
+		}
+		var cont bool
+		acc, cont = f(acc, v)
+		if !cont {
+			return acc
+		}
+	}
+}
+
+// Fold1 folds the iterator, using its first element as the initial accumulator.
+func Fold1[T any](it core.Iter[T], f func(T, T) T) (T, bool) {
+	acc, ok := it.Next()
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return acc, true
+		}
+		acc = f(acc, v)
+	}
+}
+
+// All reports whether pred is true for every element.
+func All[T any](it core.Iter[T], pred func(T) bool) bool {
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return true
+		}
+		if !pred(v) {
+			return false
+		}
+	}
+}
+
+// Any reports whether pred is true for some element.
+func Any[T any](it core.Iter[T], pred func(T) bool) bool {
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return false
+		}
+		if pred(v) {
+			return true
+		}
+	}
+}
+
+// Contains reports whether x is present, using eq for equality.
+func Contains[T any](it core.Iter[T], x T, eq func(a, b T) bool) bool {
+	return Any(it, func(v T) bool { return eq(v, x) })
+}
+
+// FindPosition returns the first (index, element) satisfying pred.
+func FindPosition[T any](it core.Iter[T], pred func(T) bool) (core.Pair[int, T], bool) {
+	i := 0
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return core.Pair[int, T]{}, false
+		}
+		if pred(v) {
+			return core.Pair[int, T]{First: i, Second: v}, true
+		}
+		i++
+	}
+}
+
+// FindOrLast returns the first element satisfying pred, or the last element if
+// no element satisfies pred. It reports false only for an empty input.
+func FindOrLast[T any](it core.Iter[T], pred func(T) bool) (T, bool) {
+	var last T
+	has := false
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return last, has
+		}
+		if pred(v) {
+			return v, true
+		}
+		last = v
+		has = true
+	}
+}
+
+// FindOrFirst returns the first element satisfying pred, or the first element if
+// no element satisfies pred. It reports false only for an empty input.
+func FindOrFirst[T any](it core.Iter[T], pred func(T) bool) (T, bool) {
+	first, ok := it.Next()
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	if pred(first) {
+		return first, true
+	}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return first, true
+		}
+		if pred(v) {
+			return v, true
+		}
+	}
+}
+
+// AllEqual reports whether all elements are equal, using eq.
+func AllEqual[T any](it core.Iter[T], eq func(a, b T) bool) bool {
+	first, ok := it.Next()
+	if !ok {
+		return true
+	}
+	return All(it, func(v T) bool { return eq(first, v) })
+}
+
+// AllEqualValue returns the sole distinct element or an AllEqualValueError.
+func AllEqualValue[T any](it core.Iter[T], eq func(a, b T) bool) (T, error) {
+	first, ok := it.Next()
+	if !ok {
+		var zero T
+		return zero, core.NewAllEqualValueErrorZero[T]()
+	}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return first, nil
+		}
+		if !eq(first, v) {
+			var zero T
+			return zero, core.NewAllEqualValueErrorUnequal(first, v)
+		}
+	}
+}
+
+// AllUnique reports whether all keys are distinct.
+func AllUnique[T any](it core.Iter[T], key func(T) any) bool {
+	seen := map[any]struct{}{}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return true
+		}
+		k := key(v)
+		if _, exists := seen[k]; exists {
+			return false
+		}
+		seen[k] = struct{}{}
+	}
+}
+
+// Concat concatenates the elements of an iterator of slices.
+func Concat[T any](it core.Iter[[]T]) []T {
+	var out []T
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return out
+		}
+		out = append(out, v...)
+	}
+}
+
+// Sum1 sums the elements, returning false for an empty iterator.
+func Sum1[T Number](it core.Iter[T]) (T, bool) {
+	acc, ok := it.Next()
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return acc, true
+		}
+		acc += v
+	}
+}
+
+// Product1 multiplies the elements, returning false for an empty iterator.
+func Product1[T Number](it core.Iter[T]) (T, bool) {
+	acc, ok := it.Next()
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return acc, true
+		}
+		acc *= v
+	}
+}
+
+// Tail consumes the iterator and returns its last k elements. When k is zero
+// it returns no elements; when k is at least the length it returns all of them.
+func Tail[T any](it core.Iter[T], k int) []T {
+	all := CollectVec(it)
+	if k <= 0 {
+		return nil
+	}
+	if k >= len(all) {
+		return all
+	}
+	return all[len(all)-k:]
+}
+
+// Dropping consumes the iterator and returns its elements after skipping the
+// first k.
+func Dropping[T any](it core.Iter[T], k int) []T {
+	for i := 0; i < k; i++ {
+		if _, ok := it.Next(); !ok {
+			return nil
+		}
+	}
+	return CollectVec(it)
+}
+
+// DroppingBack eagerly drops the last k elements of a double-ended iterator and
+// returns the remaining iterator.
+func DroppingBack[T any](it core.DoubleEnded[T], k int) core.DoubleEnded[T] {
+	for i := 0; i < k; i++ {
+		if _, ok := it.NextBack(); !ok {
+			break
+		}
+	}
+	return it
+}
+
+// ExactlyOne returns the single element or an ExactlyOneError.
+func ExactlyOne[T any](it core.Iter[T]) (T, *core.ExactlyOneError[T]) {
+	first, ok := it.Next()
+	if !ok {
+		var zero T
+		return zero, core.NewExactlyOneError(nil, it)
+	}
+	second, ok := it.Next()
+	if ok {
+		var zero T
+		return zero, core.NewExactlyOneError([]T{first, second}, it)
+	}
+	return first, nil
+}
+
+// AtMostOne returns the element if there is at most one, else an error.
+func AtMostOne[T any](it core.Iter[T]) (T, bool, *core.ExactlyOneError[T]) {
+	first, ok := it.Next()
+	if !ok {
+		var zero T
+		return zero, false, nil
+	}
+	second, ok := it.Next()
+	if ok {
+		var zero T
+		return zero, false, core.NewExactlyOneError([]T{first, second}, it)
+	}
+	return first, true, nil
+}
+
+// Join renders the elements separated by sep.
+func Join[T any](it core.Iter[T], sep string) string {
+	out := ""
+	first := true
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return out
+		}
+		if !first {
+			out += sep
+		}
+		first = false
+		out += fmt.Sprint(v)
+	}
+}
+
+// Format returns a lazy separator-rendering formatter.
+func Format[T any](it core.Iter[T], sep string) *core.Format[T] {
+	return core.NewFormat(it, sep, nil)
+}
+
+// FormatWith returns a lazy custom formatter.
+func FormatWith[T any](it core.Iter[T], sep string, fn core.FormatWithFunc[T]) *core.FormatWith[T] {
+	return core.NewFormatWith(it, sep, fn)
+}
+
+// Minmax returns the minimum and maximum of the input.
+func Minmax[T interface {
+	~int | ~int8 | ~int16 | ~int32 | ~int64 |
+		~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64 |
+		~float32 | ~float64 | ~string
+}](it core.Iter[T]) core.MinMaxResult[T] {
+	return core.Minmax(it)
+}
+
+// MinmaxByKey returns the minimum and maximum of the input, comparing elements
+// by the ordered key produced by key. The first minimum and the last maximum
+// are retained, matching the Rust reference.
+func MinmaxByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) core.MinMaxResult[T] {
+	return core.MinmaxBy(it, func(a, b T) bool { return key(a) < key(b) })
+}
+
+// PositionMax returns the index and value of the maximum element.
+func PositionMax[T interface {
+	~int | ~int8 | ~int16 | ~int32 | ~int64 |
+		~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64 |
+		~float32 | ~float64 | ~string
+}](it core.Iter[T]) (core.Pair[int, T], bool) {
+	// position_max uses a non-strict comparison so that the last of several
+	// equally maximum elements wins, matching the Rust reference.
+	return foldPosition(it, func(a, b T) bool { return a >= b })
+}
+
+// PositionMin returns the index and value of the minimum element.
+func PositionMin[T interface {
+	~int | ~int8 | ~int16 | ~int32 | ~int64 |
+		~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64 |
+		~float32 | ~float64 | ~string
+}](it core.Iter[T]) (core.Pair[int, T], bool) {
+	return foldPosition(it, func(a, b T) bool { return a < b })
+}
+
+func foldPosition[T any](it core.Iter[T], better func(a, b T) bool) (core.Pair[int, T], bool) {
+	best, ok := it.Next()
+	if !ok {
+		return core.Pair[int, T]{}, false
+	}
+	bestIdx := 0
+	i := 1
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return core.Pair[int, T]{First: bestIdx, Second: best}, true
+		}
+		if better(v, best) {
+			best = v
+			bestIdx = i
+		}
+		i++
+	}
+}
+
+// PositionMinMax returns the positions of the minimum and maximum elements.
+// The first minimum and the last maximum are retained.
+func PositionMinMax[T cmp.Ordered](it core.Iter[T]) core.MinMaxResult[int] {
+	return positionMinMaxResult[T](core.MinmaxBy(core.NewEnumerate(it), func(a, b core.Pair[int, T]) bool {
+		return a.Second < b.Second
+	}))
+}
+
+// PositionMinMaxByKey returns the positions of the minimum and maximum elements
+// as determined by the ordered key produced by key.
+func PositionMinMaxByKey[T any, K cmp.Ordered](it core.Iter[T], key func(T) K) core.MinMaxResult[int] {
+	return positionMinMaxResult[T](core.MinmaxBy(core.NewEnumerate(it), func(a, b core.Pair[int, T]) bool {
+		return key(a.Second) < key(b.Second)
+	}))
+}
+
+// PositionMinMaxBy returns the positions of the minimum and maximum elements
+// as determined by compare.
+func PositionMinMaxBy[T any](it core.Iter[T], compare func(a, b T) core.Ordering) core.MinMaxResult[int] {
+	return positionMinMaxResult[T](core.MinmaxBy(core.NewEnumerate(it), func(a, b core.Pair[int, T]) bool {
+		return compare(a.Second, b.Second) == core.Less
+	}))
+}
+
+func positionMinMaxResult[T any](r core.MinMaxResult[core.Pair[int, T]]) core.MinMaxResult[int] {
+	switch r.Kind {
+	case core.MinMaxNoElements:
+		return core.NoElements[int]()
+	case core.MinMaxOneElement:
+		return core.OneElement(r.Min.First)
+	default:
+		return core.MinMax(r.Min.First, r.Max.First)
+	}
+}
+
+// PartitionMap splits elements into two slices by f (true => left).
+func PartitionMap[T any](it core.Iter[T], f func(T) bool) ([]T, []T) {
+	var left, right []T
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return left, right
+		}
+		if f(v) {
+			left = append(left, v)
+		} else {
+			right = append(right, v)
+		}
+	}
+}
+
+// PartitionResult partitions results into successes and errors.
+func PartitionResult[T any](it core.Iter[core.Pair[T, error]]) ([]T, []error) {
+	var oks []T
+	var errs []error
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return oks, errs
+		}
+		if v.Second != nil {
+			errs = append(errs, v.Second)
+		} else {
+			oks = append(oks, v.First)
+		}
+	}
+}
+
+// DiffWith compares two iterators in lock-step and reports the first difference.
+func DiffWith[T any](i, j core.Iter[T], eq func(a, b T) bool) (core.Diff[T], bool) {
+	return core.DiffWith(i, j, eq)
+}
+
+// Multiunzip splits an iterator of pairs into two slices.
+func Multiunzip[A, B any](it core.Iter[core.Pair[A, B]]) ([]A, []B) {
+	return core.MultiUnzip2(it)
+}
+
+// TryCollect collects successful values, returning the first error.
+func TryCollect[T any](it core.Iter[core.Pair[T, error]]) ([]T, error) {
+	var out []T
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return out, nil
+		}
+		if v.Second != nil {
+			return nil, v.Second
+		}
+		out = append(out, v.First)
+	}
+}
+
+// FoldOK folds successful values, returning the first error.
+func FoldOK[T, A any](it core.Iter[core.Pair[T, error]], init A, f func(A, T) A) (A, error) {
+	acc := init
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return acc, nil
+		}
+		if v.Second != nil {
+			return init, v.Second
+		}
+		acc = f(acc, v.First)
+	}
+}
diff --git a/repair_test.go b/repair_test.go
new file mode 100644
index 0000000..65b0890
--- /dev/null
+++ b/repair_test.go
@@ -0,0 +1,223 @@
+package itertools_test
+
+import (
+	"reflect"
+	"testing"
+
+	it "itertools"
+	"itertools/core"
+	"itertools/free"
+)
+
+type boomErr struct{}
+
+func (boomErr) Error() string { return "boom" }
+
+func TestRepairTail(t *testing.T) {
+	v := []int{5, 9, 8, 4, 2, 12, 0}
+	if got := it.Tail(slice(v...), 3); !eq(got, []int{2, 12, 0}) {
+		t.Fatalf("tail(3) = %v", got)
+	}
+	if got := it.Tail(slice(v...), 10); !eq(got, v) {
+		t.Fatalf("tail(10) = %v", got)
+	}
+	if got := it.Tail(slice(v...), 1); !eq(got, []int{0}) {
+		t.Fatalf("tail(1) = %v", got)
+	}
+	if got := it.Tail(slice(v...), 0); len(got) != 0 {
+		t.Fatalf("tail(0) = %v", got)
+	}
+}
+
+func TestRepairDropping(t *testing.T) {
+	if got := it.Dropping(slice(1, 2, 3, 4), 2); !eq(got, []int{3, 4}) {
+		t.Fatalf("dropping = %v", got)
+	}
+	back := it.DroppingBack(core.FromSlice([]int{0, 3, 6, 9}), 1)
+	if got := collect[int](back); !eq(got, []int{0, 3, 6}) {
+		t.Fatalf("dropping_back = %v", got)
+	}
+}
+
+func TestRepairFindOr(t *testing.T) {
+	if v, ok := it.FindOrLast(slice(1, 2, 3, 4), func(x int) bool { return x > 5 }); !ok || v != 4 {
+		t.Fatalf("find_or_last(>5) = %v, %v", v, ok)
+	}
+	if v, ok := it.FindOrLast(slice(1, 2, 3, 4), func(x int) bool { return x > 2 }); !ok || v != 3 {
+		t.Fatalf("find_or_last(>2) = %v, %v", v, ok)
+	}
+	if v, ok := it.FindOrLast(slice(1, 2, 3, 4), func(x int) bool { return x > 0 }); !ok || v != 1 {
+		t.Fatalf("find_or_last(>0) = %v, %v", v, ok)
+	}
+	if v, ok := it.FindOrFirst(slice(1, 2, 3, 4), func(x int) bool { return x > 5 }); !ok || v != 1 {
+		t.Fatalf("find_or_first(>5) = %v, %v", v, ok)
+	}
+	if v, ok := it.FindOrFirst(slice(1, 2, 3, 4), func(x int) bool { return x > 2 }); !ok || v != 3 {
+		t.Fatalf("find_or_first(>2) = %v, %v", v, ok)
+	}
+	if _, ok := it.FindOrLast(slice[int](), func(x int) bool { return true }); ok {
+		t.Fatal("find_or_last empty should fail")
+	}
+	if _, ok := it.FindOrFirst(slice[int](), func(x int) bool { return true }); ok {
+		t.Fatal("find_or_first empty should fail")
+	}
+}
+
+func TestRepairPositionTies(t *testing.T) {
+	if p, ok := it.PositionMax(slice(1, 1, -1, -1)); !ok || p.First != 1 {
+		t.Fatalf("position_max = %+v, %v", p, ok)
+	}
+	if p, ok := it.PositionMin(slice(1, 1, -1, -1)); !ok || p.First != 2 {
+		t.Fatalf("position_min = %+v, %v", p, ok)
+	}
+}
