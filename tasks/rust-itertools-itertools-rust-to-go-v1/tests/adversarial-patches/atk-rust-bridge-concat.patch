+package free_test
+
+import (
+	"reflect"
+	"testing"
+
+	"itertools/core"
+	"itertools/free"
+)
+
+func slice[T any](v ...T) *core.Slice[T] { return core.FromSlice(v) }
+
+func collect[T any](it core.Iter[T]) []T {
+	var out []T
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return out
+		}
+		out = append(out, v)
+	}
+}
+
+func TestFreeIntersperse(t *testing.T) {
+	got := collect(free.Intersperse(slice(1, 2, 3), 0))
+	if !reflect.DeepEqual(got, []int{1, 0, 2, 0, 3}) {
+		t.Fatalf("intersperse = %v", got)
+	}
+}
+
+func TestFreeZipChain(t *testing.T) {
+	z := free.Zip(slice(1, 2), slice("a", "b"))
+	var got []core.Pair[int, string]
+	for {
+		v, ok := z.Next()
+		if !ok {
+			break
+		}
+		got = append(got, v)
+	}
+	if len(got) != 2 || got[1].Second != "b" {
+		t.Fatalf("zip = %v", got)
+	}
+	c := free.Chain(slice(1, 2), slice(3, 4))
+	if got := collect(c); !reflect.DeepEqual(got, []int{1, 2, 3, 4}) {
+		t.Fatalf("chain = %v", got)
+	}
+}
+
+func TestFreeMinMax(t *testing.T) {
+	if v, ok := free.Max(slice(3, 9, 4)); !ok || v != 9 {
+		t.Fatalf("max = %v %v", v, ok)
+	}
+	if v, ok := free.Min(slice(3, 9, 4)); !ok || v != 3 {
+		t.Fatalf("min = %v %v", v, ok)
+	}
+}
+
+func TestFreeSortedRepeatN(t *testing.T) {
+	if got := free.Sorted(slice(3, 1, 2)); !reflect.DeepEqual(got, []int{1, 2, 3}) {
+		t.Fatalf("sorted = %v", got)
+	}
+	if got := collect(free.RepeatN(2, "x")); !reflect.DeepEqual(got, []string{"x", "x"}) {
+		t.Fatalf("repeatn = %v", got)
+	}
+}
+
+func TestFreeMultiunzipMultizip(t *testing.T) {
+	as, bs := free.Multiunzip(slice(core.Pair[int, string]{First: 1, Second: "a"}))
+	if !reflect.DeepEqual(as, []int{1}) || !reflect.DeepEqual(bs, []string{"a"}) {
+		t.Fatalf("multiunzip = %v %v", as, bs)
+	}
+	mz := free.Multizip(slice(1, 2, 3), slice(4, 5))
+	var got [][]int
+	for {
+		v, ok := mz.Next()
+		if !ok {
+			break
+		}
+		got = append(got, v)
+	}
+	if !reflect.DeepEqual(got, [][]int{{1, 4}, {2, 5}}) {
+		t.Fatalf("multizip = %v", got)
+	}
+}
+
+func TestFreeIterateUnfold(t *testing.T) {
+	it0 := free.Iterate(1, func(x int) int { return x + 1 })
+	var got []int
+	for i := 0; i < 3; i++ {
+		v, _ := it0.Next()
+		got = append(got, v)
+	}
+	if !reflect.DeepEqual(got, []int{1, 2, 3}) {
+		t.Fatalf("iterate = %v", got)
+	}
+	u := free.Unfold(0, func(st int) (int, int, bool) {
+		if st >= 3 {
+			return 0, st, false
+		}
+		return st, st + 1, true
+	})
+	if got := collect(u); !reflect.DeepEqual(got, []int{0, 1, 2}) {
+		t.Fatalf("unfold = %v", got)
+	}
+}
+
+func TestFreeDiffWith(t *testing.T) {
+	d, ok := free.DiffWith(slice(1, 2), slice(1, 3), func(a, b int) bool { return a == b })
+	if !ok || d.Kind != core.DiffFirstMismatch || d.Index != 1 {
+		t.Fatalf("diff = %+v ok=%v", d, ok)
+	}
+}
