+package itertools
+
+import "itertools/core"
+
+// MinmaxBy returns the minimum and maximum using a strict less-than.
+func MinmaxBy[T any](it core.Iter[T], less func(a, b T) bool) core.MinMaxResult[T] {
+	return core.MinmaxBy(it, less)
+}
