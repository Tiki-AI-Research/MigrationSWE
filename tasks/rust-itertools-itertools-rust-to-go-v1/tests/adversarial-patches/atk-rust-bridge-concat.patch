@@ -0,0 +1,136 @@
+// Package free reproduces the free functions of itertools' src/free.rs.
+package free
+
+import (
+	"cmp"
+
+	"itertools"
+	"itertools/core"
+)
+
+// Intersperse inserts elt between each element.
+func Intersperse[T any](it core.Iter[T], elt T) *core.Intersperse[T] {
+	return core.NewIntersperse(it, elt)
+}
+
+// IntersperseWith inserts generated elements between each element.
+func IntersperseWith[T any](it core.Iter[T], gen func() T) *core.IntersperseWith[T] {
+	return core.NewIntersperseWith(it, gen)
+}
+
+// Enumerate yields (index, element) pairs.
+func Enumerate[T any](it core.Iter[T]) *core.Enumerate[T] { return core.NewEnumerate(it) }
+
+// Rev reverses a double-ended iterator.
+func Rev[T any](it core.DoubleEnded[T]) *core.Rev[T] { return core.NewRev(it) }
+
+// Zip pairs elements from two iterators.
+func Zip[A, B any](a core.Iter[A], b core.Iter[B]) *core.Zip[A, B] {
+	return core.NewZip(a, b)
+}
+
+// Chain concatenates two iterators.
+func Chain[T any](a, b core.Iter[T]) core.Iter[T] { return core.NewChain(a, b) }
+
+// Cloned returns the input iterator (elements are values in Go).
+func Cloned[T any](it core.Iter[T]) core.Iter[T] { return it }
+
+// Fold folds the iterator.
+func Fold[T, A any](it core.Iter[T], init A, f func(A, T) A) A {
+	return itertools.Fold(it, init, f)
+}
+
+// All reports whether pred holds for every element.
+func All[T any](it core.Iter[T], pred func(T) bool) bool {
+	return itertools.All(it, pred)
+}
+
+// Any reports whether pred holds for some element.
+func Any[T any](it core.Iter[T], pred func(T) bool) bool {
+	return itertools.Any(it, pred)
+}
+
+// Max returns the maximum element.
+func Max[T cmp.Ordered](it core.Iter[T]) (T, bool) {
+	best, ok := it.Next()
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return best, true
+		}
+		if v > best {
+			best = v
+		}
+	}
+}
+
+// Min returns the minimum element.
+func Min[T cmp.Ordered](it core.Iter[T]) (T, bool) {
+	best, ok := it.Next()
+	if !ok {
+		var zero T
+		return zero, false
+	}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return best, true
+		}
+		if v < best {
+			best = v
+		}
+	}
+}
+
+// Join renders the elements separated by sep.
+func Join[T any](it core.Iter[T], sep string) string { return itertools.Join(it, sep) }
+
+// Concat concatenates an iterator of slices.
+func Concat[T any](it core.Iter[[]T]) []T { return itertools.Concat(it) }
+
+// ConsTuples re-pairs an iterator of pairs.
+func ConsTuples[A, B any](it core.Iter[core.Pair[A, B]]) core.Iter[core.Pair[A, B]] {
+	return core.ConsTuples2(it)
+}
+
+// DiffWith compares two iterators in lock-step.
+func DiffWith[T any](i, j core.Iter[T], eq func(a, b T) bool) (core.Diff[T], bool) {
+	return core.DiffWith(i, j, eq)
+}
+
+// RepeatN yields v, n times.
+func RepeatN[T any](n int, v T) *core.RepeatN[T] { return core.NewRepeatN(n, v) }
+
+// KMergeBy merges several iterators using a strict less-than.
+func KMergeBy[T any](iters []core.Iter[T], lessThan func(a, b T) bool) *core.KMergeBy[T] {
+	return core.NewKMergeBy(iters, lessThan)
+}
+
+// ProcessResults applies processor to successful values, returning the first error.
+func ProcessResults[T any, R any](it core.Iter[core.Pair[T, error]], processor func(core.Iter[T]) R) (R, error) {
+	return core.ProcessResultsRun(it, processor)
+}
+
+// Iterate yields seed then repeatedly applies next.
+func Iterate[T any](seed T, next func(T) T) *core.Iterate[T] {
+	return core.NewIterate(seed, next)
+}
+
+// Unfold yields values from a stateful generator.
+func Unfold[St, T any](init St, f func(St) (T, St, bool)) *core.Unfold[St, T] {
+	return core.NewUnfold(init, f)
+}
+
+// Multiunzip splits an iterator of pairs into two slices.
+func Multiunzip[A, B any](it core.Iter[core.Pair[A, B]]) ([]A, []B) {
+	return core.MultiUnzip2(it)
+}
+
+// Multizip yields lockstep tuples, stopping at the shortest.
+func Multizip[T any](iters ...core.Iter[T]) *itertools.MultiZip[T] {
+	return itertools.Izip(iters...)
+}
