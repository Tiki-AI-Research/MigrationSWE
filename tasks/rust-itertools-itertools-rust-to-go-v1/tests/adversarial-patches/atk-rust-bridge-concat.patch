+func TestRepairInterleaveShortestSizeHint(t *testing.T) {
+	a := it.InterleaveShortest(core.RepeatIter(1), core.FromSlice([]int{1, 2, 3}))
+	if h := a.SizeHint(); h.Upper != 7 {
+		t.Fatalf("unbounded curr hint = %+v", h)
+	}
+	b := it.InterleaveShortest(core.FromSlice([]int{1, 2, 3}), core.RepeatIter(1))
+	if h := b.SizeHint(); h.Upper != 6 {
+		t.Fatalf("unbounded next hint = %+v", h)
+	}
+}
