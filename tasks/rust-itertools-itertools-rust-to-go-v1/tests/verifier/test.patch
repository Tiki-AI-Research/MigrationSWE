+	if !h.IsExact() || h.Lower != 3 || h.Upper != 3 {
+		t.Fatalf("F2P-023 Hint(3,3) = %+v", h)
+	}
+	r := core.RepeatIter(1).SizeHint()
+	if r.Lower != math.MaxInt || r.Upper != -1 || r.Bounded() {
+		t.Fatalf("F2P-023 RepeatIter size hint = %+v", r)
+	}
+}
