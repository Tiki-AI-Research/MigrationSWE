+#!/usr/bin/env python3
+"""Source-side P2P probe for BATCH-P2P-0001.
+
+The source side is the Rust reference repository.  P2P is a state-preservation
+check, so the probe runs the source repository's own native check and maps
+every observation to the resulting stable projection.  The source runtime
+declares ``git diff --exit-code`` as the native test command; when the source
+snapshot is not a git worktree (the read-only authoring mount is a plain
+export) the probe falls back to verifying that every in-scope reference module
+and behavioral-reference test file is present.
+
+Usage:  probe.py [REPO] [REPORT]
+        REPO    defaults to /input/source
+        REPORT  optional output path for the JSON result envelope
+"""
+
+import json
+import os
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.abspath(os.path.join(HERE, "..", "..", ".."))
+sys.path.insert(0, os.path.join(ROOT, "shared", "batches", "BATCH-P2P-0001"))
+
+import projection  # noqa: E402
+
+
+IN_SCOPE_MODULES = [
+    "src/lib.rs",
+    "src/adaptors/mod.rs",
+    "src/adaptors/map.rs",
+    "src/adaptors/coalesce.rs",
+    "src/adaptors/multi_product.rs",
+    "src/free.rs",
+    "src/size_hint.rs",
+    "src/format.rs",
+    "src/concat_impl.rs",
+    "src/array_impl.rs",
+    "src/either_or_both.rs",
+    "src/groupbylazy.rs",
+    "src/grouping_map.rs",
+    "src/merge_join.rs",
+    "src/process_results_impl.rs",
+    "src/put_back_n_impl.rs",
+    "src/peek_nth.rs",
+    "src/next_array.rs",
+    "src/intersperse.rs",
+    "src/with_position.rs",
+    "src/minmax.rs",
+    "src/k_smallest.rs",
+    "src/kmerge_impl.rs",
+    "src/permutations.rs",
+    "src/combinations.rs",
+    "src/unique_impl.rs",
+    "src/exactly_one_err.rs",
+    "src/all_equal_value_err.rs",
+    "src/lazy_buffer.rs",
+    "src/rciter_impl.rs",
+    "src/take_while_inclusive.rs",
+    "src/pad_tail.rs",
+]
+
+BEHAVIOR_TESTS = [
+    "tests/quick.rs",
+    "tests/laziness.rs",
+    "tests/specializations.rs",
+    "tests/test_core.rs",
+    "tests/test_std.rs",
+    "tests/adaptors_no_collect.rs",
+    "tests/arrays.rs",
+]
+
+
+def _run_native_git(repo):
+    completed = subprocess.run(
+        ["git", "diff", "--exit-code"],
+        cwd=repo,
+        capture_output=True,
+        text=True,
+    )
+    return completed.returncode == 0, "git diff --exit-code"
+
+
+def _structural_presence(repo):
+    missing = [
+        path
+        for path in IN_SCOPE_MODULES + BEHAVIOR_TESTS
+        if not os.path.isfile(os.path.join(repo, path))
+    ]
+    detail = "reference tree present" if not missing else "missing: " + ",".join(missing)
+    return not missing, detail
+
+
+def run_source(repo):
+    if os.path.isdir(os.path.join(repo, ".git")):
+        return _run_native_git(repo)
+    return _structural_presence(repo)
+
+
+def main(argv):
+    repo = argv[1] if len(argv) > 1 else "/input/source"
+    report_path = argv[2] if len(argv) > 2 else None
+
+    if not os.path.isdir(repo):
+        sys.stderr.write("source repo not found: %s\n" % repo)
+        return 2
+
+    corpus = projection.load_corpus()
+    passed, detail = run_source(repo)
+    report = projection.build_report(corpus, passed)
+    report["side"] = "source"
+    report["native_detail"] = detail
+
+    text = json.dumps(report, indent=2, sort_keys=True)
+    if report_path:
+        projection.write_report(report_path, report)
+    else:
+        sys.stdout.write(text + "\n")
+    return 0 if passed else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
