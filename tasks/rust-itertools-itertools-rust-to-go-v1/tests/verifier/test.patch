diff --git a/tests/target/batches/BATCH-DIFFERENTIAL-0001/entry.py b/tests/target/batches/BATCH-DIFFERENTIAL-0001/entry.py
new file mode 100644
--- /dev/null
+++ b/tests/target/batches/BATCH-DIFFERENTIAL-0001/entry.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Target-side differential probe for BATCH-DIFFERENTIAL-0001.
+
+The INTEGRATION batch assembles the final ``harness.py``; this file deliberately
+does not live at that path. It runs the private Go corpus probe against the
+candidate Go module, compares the observed values with the shared corpus using
+the batch's ``equal_after_normalization`` relation, and emits a report envelope
+compatible with the SKELETON report helpers.
+
+Usage: entry.py <repo-dir> [report-path]
+"""
+
+import importlib.util
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+BATCH_ID = "BATCH-DIFFERENTIAL-0001"
+ASSETS_DIR = os.environ.get("MIGRATION_ASSETS_DIR", "/assets")
+DEPENDENCY_MANIFEST = os.path.join(ASSETS_DIR, "dependencies", "dependency-manifest.json")
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+PROBE_GO = os.path.join(HERE, "probe", "main.go")
+
+
+def _find_upwards(relative, start=HERE):
+    """Locate ``relative`` by walking up from ``start``."""
+    current = start
+    while True:
+        candidate = os.path.join(current, relative)
+        if os.path.exists(candidate):
+            return candidate
+        parent = os.path.dirname(current)
+        if parent == current:
+            return None
+        current = parent
+
+
+def _load_differential():
+    """Import the shared differential helper module."""
+    path = _find_upwards(os.path.join("shared", "batches", BATCH_ID, "differential.py"))
+    if path is None:
+        raise SystemExit("differential.py not found; is the shared asset assembled?")
+    spec = importlib.util.spec_from_file_location("bdi_differential", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _load_report_helpers():
+    """Import the SKELETON report helpers when available."""
+    path = _find_upwards(os.path.join("shared", "skeleton", "report.py"))
+    if path is None:
+        return None
+    spec = importlib.util.spec_from_file_location("bdi_skeleton_report", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _load_corpus():
+    path = _find_upwards(os.path.join("fixtures", "batches", BATCH_ID, "corpus.json"))
+    if path is None:
+        raise SystemExit("corpus.json not found; is the fixture asset assembled?")
+    with open(path, "r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def _consume_dependency_manifest():
+    with open(DEPENDENCY_MANIFEST, "r", encoding="utf-8") as handle:
+        manifest = json.load(handle)
+    batch_ids = {entry.get("batch_id") for entry in manifest.get("batches", [])}
+    if "BATCH-AUTHOR-BATCH-SKELETON-0001" not in batch_ids:
+        raise SystemExit("dependency snapshot is missing the SKELETON batch")
+    return manifest
+
+
+def _run_probe(repo):
+    """Run the Go probe against ``repo`` in an isolated temporary module."""
+    workdir = tempfile.mkdtemp(prefix="bdi-probe-")
+    try:
+        shutil.copyfile(PROBE_GO, os.path.join(workdir, "main.go"))
+        with open(os.path.join(workdir, "go.mod"), "w", encoding="utf-8") as handle:
+            handle.write("module diffprobe\n\ngo 1.23.0\n\n")
+            handle.write("require itertools v0.0.0\n\n")
+            handle.write("replace itertools => %s\n" % os.path.abspath(repo))
+        completed = subprocess.run(
+            ["go", "run", "."],
+            cwd=workdir,
+            check=False,
+            capture_output=True,
+            text=True,
+        )
+        if completed.returncode != 0:
+            raise SystemExit("go probe failed:\n%s" % completed.stderr)
+        return json.loads(completed.stdout)
+    finally:
+        shutil.rmtree(workdir, ignore_errors=True)
+
+
+def main(argv):
+    repo = argv[1] if len(argv) > 1 else "."
+    report_path = argv[2] if len(argv) > 2 else None
+
+    _consume_dependency_manifest()
+    differential = _load_differential()
+    report_helpers = _load_report_helpers()
+    corpus = _load_corpus()
+    target_results = _run_probe(repo)
+
+    results = []
+    for case in corpus["cases"]:
+        case_id = case["id"]
+        passed = differential.equal_after_normalization(case["expected"], target_results.get(case_id))
+        results.append({
+            "observation_id": case["observation_id"],
+            "passed": bool(passed),
+            "detail": "%s: expected=%s target=%s" % (
+                case_id,
+                json.dumps(differential.normalize(case["expected"]), sort_keys=True),
+                json.dumps(differential.normalize(target_results.get(case_id)), sort_keys=True),
+            ),
+        })
+
+    if report_helpers is not None:
+        entries = [
+            report_helpers.make_result(r["observation_id"], r["passed"], r["detail"])
+            for r in results
+        ]
+        report = report_helpers.make_report(BATCH_ID, entries)
+    else:
+        report = {"schema_version": "migration-result:v1", "batch_id": BATCH_ID, "results": results}
+
+    text = json.dumps(report, indent=2, sort_keys=True)
+    if report_path:
+        with open(report_path, "w", encoding="utf-8") as handle:
+            handle.write(text + "\n")
+    else:
+        sys.stdout.write(text + "\n")
+
+    return 0 if all(r["passed"] for r in results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
diff --git a/tests/target/batches/BATCH-DIFFERENTIAL-0001/probe/main.go b/tests/target/batches/BATCH-DIFFERENTIAL-0001/probe/main.go
new file mode 100644
--- /dev/null
+++ b/tests/target/batches/BATCH-DIFFERENTIAL-0001/probe/main.go
@@ -0,0 +1,227 @@
+// Command diffprobe exercises the shared differential corpus against a Go
+// implementation of the migrated itertools module and prints one JSON object
+// mapping corpus case ids to the observed, normalized values.
+//
+// BATCH-DIFFERENTIAL-0001 authors this private target probe. It is executed by
+// target/batches/BATCH-DIFFERENTIAL-0001/entry.py against the candidate module;
+// the reference target under /input/target is never copied into the public
+// assets.
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+
+	"itertools"
+	"itertools/core"
+	"itertools/free"
+)
+
+func collectInt(it core.Iter[int]) []int {
+	out := []int{}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return out
+		}
+		out = append(out, v)
+	}
+}
+
+func collectInts(it core.Iter[[]int]) [][]int {
+	out := [][]int{}
+	for {
+		v, ok := it.Next()
+		if !ok {
+			return out
+		}
+		out = append(out, v)
+	}
+}
+
+func firstN(it core.Iter[int], n int) []int {
+	out := []int{}
+	for i := 0; i < n; i++ {
+		v, ok := it.Next()
+		if !ok {
+			break
+		}
+		out = append(out, v)
+	}
+	return out
+}
+
+func recoverCall(f func()) (panicked bool) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = true
+		}
+	}()
+	f()
+	return false
+}
+
+func fusedCount(it core.Iter[int]) int {
+	n := 0
+	for {
+		if _, ok := it.Next(); !ok {
+			break
+		}
+		n++
+	}
+	for i := 0; i < 3; i++ {
+		if _, ok := it.Next(); ok {
+			return -1
+		}
+	}
+	return n
+}
+
+func main() {
+	out := map[string]any{}
+	eqInt := func(a, b int) bool { return a == b }
+
+	// DIFF-001
+	out["CORPUS-DIFF-001-IPRODUCT"] = collectInts(itertools.Iproduct[int](
+		core.FromSlice([]int{1, 2}), core.FromSlice([]int{10, 20})))
+	out["CORPUS-DIFF-001-IZIP"] = collectInts(itertools.Izip[int](
+		core.FromSlice([]int{1, 2, 3}), core.FromSlice([]int{10, 20})))
+	out["CORPUS-DIFF-001-CHAIN"] = collectInt(itertools.ChainConcatenates[int](
+		core.FromSlice([]int{1}), core.FromSlice([]int{2, 3}), core.FromSlice([]int{4})))
+
+	// DIFF-003
+	out["CORPUS-DIFF-003-FROM-SLICE"] = collectInt(core.FromSlice([]int{1, 2, 3}))
+	out["CORPUS-DIFF-003-REPEAT-N"] = collectInt(core.NewRepeatN(3, 7))
+
+	// DIFF-005
+	l := core.Left[int, string](1)
+	r := core.Right[int, string]("b")
+	b := core.Both(1, "a")
+	lv, lok := b.Left()
+	rv, rok := b.Right()
+	out["CORPUS-DIFF-005-EITHER-OR-BOTH"] = map[string]any{
+		"left_is_left":   l.IsLeft(),
+		"left_is_both":   l.IsBoth(),
+		"left_value":     []any{lv, lok},
+		"right_value":    []any{rv, rok},
+		"right_has_left": r.HasLeft(),
+		"both_is_both":   b.IsBoth(),
+	}
+
+	// DIFF-006
+	out["CORPUS-DIFF-006-CONCAT"] = itertools.Concat[int](
+		core.FromSlice([][]int{{1}, {2, 3}, {4, 5, 6}}))
+	out["CORPUS-DIFF-006-CONCAT-EMPTY"] = itertools.Concat[int](core.FromSlice([][]int{}))
+
+	// DIFF-007
+	out["CORPUS-DIFF-007-ARRAY-WINDOWS"] = collectInts(itertools.ArrayWindows[int](
+		core.FromSlice([]int{1, 2, 3, 4, 5}), 3))
+	out["CORPUS-DIFF-007-CIRCULAR-WINDOWS"] = collectInts(itertools.CircularArrayWindows[int](
+		core.FromSlice([]int{1, 2, 3, 4}), 3))
+
+	// DIFF-008
