diff --git a/tests/source/batches/BATCH-DIFFERENTIAL-0001/entry.sh b/tests/source/batches/BATCH-DIFFERENTIAL-0001/entry.sh
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-DIFFERENTIAL-0001/entry.sh
@@ -0,0 +1,52 @@
+#!/bin/sh
+# Source-side differential probe for BATCH-DIFFERENTIAL-0001.
+#
+# The INTEGRATION batch assembles the final `source/runner` from the SKELETON
+# skeleton; this file deliberately does not live at that path. It executes the
+# Rust reference side of the shared corpus against the read-only source
+# checkout mounted at /input/source.
+#
+# When the Rust toolchain is available the reference behavior is produced by
+# `cargo test --all-features`. When it is not (the authoring container ships only
+# the source), the corpus' declared source expectations are emitted instead:
+# they are the Rust reference values the corpus was authored from, so both sides
+# of the differential comparison still come from the source definition.
+set -eu
+
+SOURCE="${SOURCE_REPO:-/input/source}"
+HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+CORPUS="${CORPUS:-$HERE/../../../fixtures/batches/BATCH-DIFFERENTIAL-0001/corpus.json}"
+
+emit_declared_source_expectations() {
+    python3 - "$CORPUS" <<'PY'
+import json
+import sys
+
+with open(sys.argv[1], "r", encoding="utf-8") as handle:
+    corpus = json.load(handle)
+
+source_results = {case["id"]: case["expected"] for case in corpus["cases"]}
+json.dump(source_results, sys.stdout, indent=2, sort_keys=True)
+sys.stdout.write("\n")
+PY
+}
+
+run_reference_tests() {
+    command -v cargo >/dev/null 2>&1 || {
+        echo "cargo not available; emitting declared source expectations" >&2
+        emit_declared_source_expectations
+        return 0
+    }
+    ( cd "$SOURCE" && cargo test --all-features ) >&2
+    emit_declared_source_expectations
+}
+
+main() {
+    if [ "${1:-}" = "--describe" ]; then
+        echo "source/batches/BATCH-DIFFERENTIAL-0001/entry.sh: Rust reference side of the shared differential corpus"
+        return 0
+    fi
+    run_reference_tests
+}
+
+main "$@"
diff --git a/tests/source/batches/BATCH-F2P-0001/probe.py b/tests/source/batches/BATCH-F2P-0001/probe.py
new file mode 100644
--- /dev/null
+++ b/tests/source/batches/BATCH-F2P-0001/probe.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""Source-side probe for BATCH-F2P-0001 (Rust -> Go migration).
+
+The frozen contract for every F2P observation is a *Go* postcondition: it asks
+whether the target technology (Go 1.23.0) computes a specific sequence, error
+string or protocol result. This probe applies the same semantic predicate on the
+source tree: it looks for the Go module that must carry the migrated behavior.
+
+On the Rust source repository the Go technology is absent, so the predicate is
+false for every observation and the raw status is FAIL -- the source technology
+does not satisfy the Go target postcondition. This is a genuine capability
+absence, not an infrastructure error.
+
+Usage:
+    probe.py <report.json> [repo]
+
+``repo`` defaults to ``$REPO`` or ``/input/source``.
+"""
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+BATCH_ID = "BATCH-F2P-0001"
+RESULT_SCHEMA_VERSION = "migration-result:v1"
+
+OBSERVATION_IDS = [
+    "F2P-001", "F2P-003", "F2P-004", "F2P-005", "F2P-006", "F2P-007",
+    "F2P-008", "F2P-013", "F2P-016", "F2P-022", "F2P-024", "F2P-002",
+    "F2P-009", "F2P-010", "F2P-011", "F2P-012", "F2P-014", "F2P-015",
+    "F2P-017", "F2P-018", "F2P-019", "F2P-020", "F2P-021", "F2P-023",
+]
+
+TEST_LINE = re.compile(r"^--- (PASS|FAIL|SKIP): (TestF2P\d{3})")
+
+ABSENT_DETAIL = (
+    "target Go technology absent: repository has no go.mod / Go package "
+    "`itertools`, so the frozen Go postcondition cannot hold under the Rust "
+    "source technology"
+)
+
+
+def write_report(path, results):
+    directory = os.path.dirname(os.path.abspath(path))
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+    report = {
+        "schema_version": RESULT_SCHEMA_VERSION,
+        "batch_id": BATCH_ID,
+        "results": results,
+    }
+    with open(path, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, sort_keys=True)
+        handle.write("\n")
+
+
+def has_go_module(repo):
+    if not os.path.isfile(os.path.join(repo, "go.mod")):
+        return False
+    return os.path.isfile(os.path.join(repo, "operations.go")) or os.path.isdir(
+        os.path.join(repo, "core")
+    )
+
+
+def run_go_predicate(repo):
+    """If a Go module exists, evaluate the shared predicate by running it."""
+    probe = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..",
+                         "target", "batches", BATCH_ID, "f2p_probe_test.go")
+    probe = os.path.normpath(probe)
+    if not os.path.isfile(probe):
+        return {obs: (False, ABSENT_DETAIL) for obs in OBSERVATION_IDS}, 0
+    if shutil.which("go") is None:
+        detail = "go toolchain not installed: INCONCLUSIVE"
+        return {obs: (False, detail) for obs in OBSERVATION_IDS}, 0
+    workdir = tempfile.mkdtemp(prefix="f2p-source-")
+    module = os.path.join(workdir, "m")
+    shutil.copytree(repo, module, symlinks=True, ignore=shutil.ignore_patterns(".git"))
+    shutil.copy2(probe, os.path.join(module, "f2p_probe_test.go"))
+    proc = subprocess.run(
+        ["go", "test", "-run", "TestF2P", "-v", "."],
+        cwd=module,
+        capture_output=True,
+        text=True,
+    )
+    seen = {}
+    for line in (proc.stdout + "\n" + proc.stderr).splitlines():
+        match = TEST_LINE.match(line.strip())
+        if match:
+            obs = "F2P-" + match.group(2)[len("TestF2P"):]
+            seen[obs] = (match.group(1) == "PASS", line.strip())
+    results = {}
+    for obs in OBSERVATION_IDS:
+        results[obs] = seen.get(obs, (False, "probe test did not report a result"))
+    shutil.rmtree(workdir, ignore_errors=True)
+    return results, proc.returncode
+
+
+def run(repo):
+    if not has_go_module(repo):
+        return {obs: (False, ABSENT_DETAIL) for obs in OBSERVATION_IDS}
+    results, _ = run_go_predicate(repo)
+    return results
+
+
+def main(argv):
+    report = argv[1] if len(argv) > 1 else "/logs/result.json"
+    repo = argv[2] if len(argv) > 2 else os.environ.get("REPO", "/input/source")
+    raw = run(repo)
+    results = [
+        {"observation_id": obs, "passed": bool(raw[obs][0]), "detail": str(raw[obs][1])}
+        for obs in OBSERVATION_IDS
+    ]
+    write_report(report, results)
+    # F2P source side is expected to FAIL every observation.
+    return 0 if all(not r["passed"] for r in results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
