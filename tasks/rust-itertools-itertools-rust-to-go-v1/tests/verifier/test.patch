+#!/usr/bin/env python3
+"""Source-side probes for BATCH-F2P-0003.
+
+Each F2P observation is a target-only postcondition. The source repository is
+Rust, so the same semantic predicate must be observed to FAIL here: the Go
+capability the observation asserts does not exist in the source technology.
+The predicate is executed for real (Go build/test against the source tree); the
+FAIL status is an observation, not a role-based constant.
+
+This file is a per-batch authoring asset, not the public harness entry point.
+The INTEGRATION batch assembles the final ``source/runner`` from it.
+"""
+
+import argparse
+import importlib.util
+import sys
+from pathlib import Path
+
+BATCH_ID = "BATCH-F2P-0003"
+
+
+def load_shared():
+    here = Path(__file__).resolve()
+    for parent in here.parents:
+        candidate = parent / "shared" / "batches" / BATCH_ID / "probes.py"
+        if candidate.is_file():
+            spec = importlib.util.spec_from_file_location("f2p_probes", candidate)
+            module = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(module)
+            return module
+    raise SystemExit("shared probes.py for %s not found" % BATCH_ID)
+
+
+def main(argv):
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", default="/input/source")
+    parser.add_argument("--out", default="/logs/f2p-0003-source.json")
+    args = parser.parse_args(argv)
+
+    probes = load_shared()
+    test_file = Path(__file__).resolve().parent.parent.parent.parent
+    test_file = str(test_file / "target" / "batches" / BATCH_ID / probes.GO_TEST_FILE)
+    if not Path(test_file).is_file():
+        test_file = None
+
+    results, transcript = probes.evaluate(args.source, test_file)
+    report = probes.make_report(results)
+    probes.write_report(args.out, report)
+
+    for line in transcript:
+        print(line)
+    unexpected = [r for r in report["results"] if r["status"] != "FAIL"]
+    for entry in report["results"]:
+        print("  %-8s %s  %s" % (entry["observation_id"], entry["status"], entry["detail"]))
+    print("source report: %s" % args.out)
+    return 1 if unexpected else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
