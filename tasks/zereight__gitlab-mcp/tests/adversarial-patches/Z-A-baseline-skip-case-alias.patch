+"""MCP server construction and tool registration.
+
+Python port of the former TypeScript ``index.ts`` (minus the process
+entrypoint). Builds a low-level ``mcp.server.Server`` named ``omg-workflow``
+version ``1.0.0`` and registers all 15 tools with explicit JSON Schema that
+matches the schemas generated by the original TypeScript server.
+"""
+
+from __future__ import annotations
+
+from mcp import types
+from mcp.server import Server
+
+from . import (
+    memory_tools,
+    model_router,
+    prd_tools,
+    state_tools,
+    workflow_tools,
+)
+from .utils import error_response, json_dumps_compact
+
+_SCHEMA_URI = "http://json-schema.org/draft-07/schema#"
+
+INPUT_SCHEMAS: dict = {
+    "omg_read_state": {
+        "type": "object",
+        "properties": {
+            "mode": {
+                "type": "string",
+                "description": "The mode to read state for (e.g., omg-autopilot, ralph, team)",
+            }
+        },
+        "required": ["mode"],
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_write_state": {
+        "type": "object",
+        "properties": {
+            "mode": {"type": "string", "description": "The mode to write state for"},
+            "state": {
+                "type": "string",
+                "description": "JSON string of state to write/merge",
+            },
+        },
+        "required": ["mode", "state"],
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_clear_state": {
+        "type": "object",
+        "properties": {
+            "mode": {
+                "description": "Mode to clear. Omit to clear all modes.",
+                "type": "string",
+            }
+        },
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_list_active": {"type": "object", "properties": {}, "$schema": _SCHEMA_URI},
+    "omg_read_prd": {"type": "object", "properties": {}, "$schema": _SCHEMA_URI},
+    "omg_create_prd": {
+        "type": "object",
+        "properties": {
+            "title": {"type": "string", "description": "PRD title"},
+            "description": {"description": "PRD description", "type": "string"},
+            "stories": {
+                "description": "User stories for the PRD",
+                "type": "array",
+                "items": {
+                    "type": "object",
+                    "properties": {
+                        "id": {
+                            "description": "Story ID (auto-generated if omitted)",
+                            "type": "string",
+                        },
+                        "title": {"type": "string", "description": "Story title"},
+                        "description": {
+                            "description": "Story description",
+                            "type": "string",
+                        },
+                        "acceptance_criteria": {
+                            "description": "List of acceptance criteria",
+                            "type": "array",
+                            "items": {"type": "string"},
+                        },
+                        "priority": {
+                            "description": "Priority (0 = default)",
+                            "type": "number",
+                        },
+                    },
+                    "required": ["title"],
+                },
+            },
+        },
+        "required": ["title"],
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_update_story": {
+        "type": "object",
+        "properties": {
+            "story_id": {"type": "string", "description": "The story ID to update"},
+            "passes": {
+                "type": "boolean",
+                "description": "Whether the story passes its acceptance criteria",
+            },
+            "evidence": {
+                "description": "Verification evidence (test output, etc.)",
+                "type": "string",
+            },
+        },
+        "required": ["story_id", "passes"],
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_verify_story": {"type": "object", "properties": {}, "$schema": _SCHEMA_URI},
+    "omg_next_phase": {
+        "type": "object",
+        "properties": {
+            "current_phase": {
+                "type": "number",
+                "description": "Current phase number (0-5)",
+            },
+            "skip_reason": {
+                "description": "Reason for skipping to a non-sequential phase",
+                "type": "string",
+            },
+        },
+        "required": ["current_phase"],
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_check_completion": {
+        "type": "object",
+        "properties": {
+            "mode": {
+                "description": "Mode to check (omg-autopilot, ralph, team). Defaults to checking all active modes.",
+                "type": "string",
+            }
+        },
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_get_phase_info": {
+        "type": "object",
+        "properties": {
+            "phase": {
+                "description": "Specific phase number (0-5). Omit for all phases.",
+                "type": "number",
+            }
+        },
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_read_memory": {
+        "type": "object",
+        "properties": {
+            "category": {
+                "description": "Filter by category (e.g., project, user, feedback, reference)",
+                "type": "string",
+            },
+            "key": {"description": "Filter by specific key", "type": "string"},
+        },
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_write_memory": {
+        "type": "object",
+        "properties": {
+            "key": {"type": "string", "description": "Unique key for this memory entry"},
+            "value": {"type": "string", "description": "The memory content"},
+            "category": {
+                "default": "project",
+                "description": "Category: project, user, feedback, reference",
+                "type": "string",
+            },
+        },
+        "required": ["key", "value"],
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_delete_memory": {
+        "type": "object",
+        "properties": {
+            "key": {"type": "string", "description": "Key of the memory entry to delete"}
+        },
+        "required": ["key"],
+        "$schema": _SCHEMA_URI,
+    },
+    "omg_select_model": {
+        "type": "object",
+        "properties": {
+            "task": {"type": "string", "description": "Description of the task to route"},
+            "file_count": {
+                "description": "Number of files involved in the task",
+                "type": "number",
+            },
+            "agent_type": {
+                "description": "The agent type that will execute (e.g., architect, executor)",
+                "type": "string",
+            },
+        },
+        "required": ["task"],
+        "$schema": _SCHEMA_URI,
+    },
+}
+
+TOOL_DESCRIPTIONS: dict = {
+    "omg_read_state": "Read the current state for a given OMG mode (omg-autopilot, ralph, ultrawork, ultraqa, team, self-improve)",
+    "omg_write_state": "Write or update state for a given OMG mode. Merges with existing state.",
+    "omg_clear_state": "Clear state for a given OMG mode or all modes",
+    "omg_list_active": "List all currently active OMG modes",
+    "omg_read_prd": "Read the current PRD (Product Requirements Document) with all stories and their status",
+    "omg_create_prd": "Create a new PRD with title, description, and stories",
+    "omg_update_story": "Update a story's status (passes: true/false) and optionally add verification evidence",
+    "omg_verify_story": "Get the next unverified story and its acceptance criteria for verification",
+    "omg_next_phase": "Advance the omg-autopilot workflow to the next phase. Returns the new phase details.",
+    "omg_check_completion": "Check if the current workflow has incomplete tasks. Returns whether the agent should continue or can stop.",
+    "omg_get_phase_info": "Get information about omg-autopilot phases",
+    "omg_read_memory": "Read project memory entries. Optionally filter by category or key.",
+    "omg_write_memory": "Write or update a project memory entry",
+    "omg_delete_memory": "Delete a project memory entry by key",
+    "omg_select_model": "Recommend the best model for a task based on complexity analysis. Maps OMC model tiers (HIGH/MEDIUM/LOW) to available VS Code Copilot models.",
+}
+
+TOOL_ORDER = [
+    "omg_read_state",
+    "omg_write_state",
+    "omg_clear_state",
+    "omg_list_active",
+    "omg_read_prd",
+    "omg_create_prd",
+    "omg_update_story",
+    "omg_verify_story",
+    "omg_next_phase",
+    "omg_check_completion",
+    "omg_get_phase_info",
+    "omg_read_memory",
+    "omg_write_memory",
+    "omg_delete_memory",
+    "omg_select_model",
+]
+
+
+def _build_tools() -> list:
+    tools = []
+    for name in TOOL_ORDER:
+        tools.append(
+            types.Tool(
+                name=name,
+                description=TOOL_DESCRIPTIONS[name],
+                inputSchema=INPUT_SCHEMAS[name],
+                execution=types.ToolExecution(taskSupport="forbidden"),
+            )
+        )
+    return tools
+
+
+def register_all(registry: dict) -> None:
+    state_tools.register_state_tools(registry)
+    prd_tools.register_prd_tools(registry)
+    workflow_tools.register_workflow_tools(registry)
+    memory_tools.register_memory_tools(registry)
+    model_router.register_model_router(registry)
+
+
+def create_server() -> Server:
+    server = Server("omg-workflow", version="1.0.0")
+
+    registry: dict = {}
+    register_all(registry)
+
+    tools = _build_tools()
+
+    @server.list_tools()
+    async def _list_tools() -> list:
+        return tools
+
+    @server.call_tool(validate_input=False)
+    async def _call_tool(name: str, arguments: dict):
+        handler = registry.get(name)
+        if handler is None:
+            return error_response(f"Unknown tool: {name}")
+        return handler(arguments or {})
+
+    return server
