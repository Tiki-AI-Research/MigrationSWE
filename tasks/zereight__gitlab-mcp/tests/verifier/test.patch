+++ b/tests/source/batches/BATCH-F2P-0003/probe_source_f2p.py
@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+"""Source-side F2P probes for BATCH-F2P-0003.
+
+The F2P contract for this batch is a target-only postcondition: the behavior
+must be served by the declared target technology (Python 3.13.0, ``omg_mcp``).
+On the source side the same semantic predicate must be *false* -- the source
+tree is the TypeScript/Node.js ``omg-mcp-server`` and contains no Python
+implementation able to serve the postcondition.
+
+This probe runs against the read-only source repository (``/input/source``)
+and records the source side's raw observation.  It does not use the target as a
+shortcut; it inspects the source tree and, when the Node.js toolchain is
+present, refuses to evaluate the Python predicate as satisfied.
+"""
+
+from __future__ import annotations
+
+import glob
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+SOURCE_REPO = os.environ.get("F2P_SOURCE_REPO", "/input/source")
+MCP_SERVER_DIR = os.path.join(SOURCE_REPO, "mcp-server")
+REQUIRED_TECHNOLOGY = "Python 3.13.0"
+
+OBSERVATIONS = [
+    "F2P-050", "F2P-052", "F2P-055", "F2P-060", "F2P-061", "F2P-071",
+    "F2P-072", "F2P-049", "F2P-051", "F2P-053", "F2P-054", "F2P-056",
+    "F2P-057", "F2P-058", "F2P-059", "F2P-062", "F2P-063", "F2P-064",
+    "F2P-065", "F2P-066", "F2P-067", "F2P-068", "F2P-069", "F2P-070",
+]
+
+
+def _python_package_present() -> bool:
+    return os.path.isdir(os.path.join(MCP_SERVER_DIR, "omg_mcp")) and bool(
+        glob.glob(os.path.join(MCP_SERVER_DIR, "omg_mcp", "*.py"))
+    )
+
+
+def _typescript_sources() -> list:
+    return sorted(
+        os.path.relpath(path, SOURCE_REPO)
+        for path in glob.glob(os.path.join(MCP_SERVER_DIR, "src", "*.ts"))
+    )
+
+
+def _node_available() -> bool:
+    return shutil.which("node") is not None
+
+
+def _serves_python_entrypoint() -> bool:
+    """Attempt the target entrypoint against the source tree; it must fail."""
+    env = dict(os.environ)
+    env["WORKSPACE_ROOT"] = tempfile.mkdtemp(prefix="f2p-source-")
+    env["PYTHONPATH"] = MCP_SERVER_DIR + os.pathsep + env.get("PYTHONPATH", "")
+    try:
+        completed = subprocess.run(
+            [sys.executable, "-m", "omg_mcp"],
+            cwd=MCP_SERVER_DIR,
+            env=env,
+            input="",
+            capture_output=True,
+            text=True,
+            timeout=30,
+        )
+        return completed.returncode == 0
+    except Exception:  # noqa: BLE001 - absence is the expected source result
+        return False
+    finally:
+        shutil.rmtree(env["WORKSPACE_ROOT"], ignore_errors=True)
+
+
+def main() -> int:
+    package_present = _python_package_present()
+    serves_entrypoint = _serves_python_entrypoint()
+    ts_sources = _typescript_sources()
+    node = _node_available()
+
+    results = {}
+    for observation_id in OBSERVATIONS:
+        served_by_python = package_present and serves_entrypoint
+        results[observation_id] = {
+            "side": "source",
+            "required_technology": REQUIRED_TECHNOLOGY,
+            "status": "PASS" if served_by_python else "FAIL",
+            "detail": json.dumps(
+                {
+                    "python_package_present": package_present,
+                    "python_entrypoint_served": serves_entrypoint,
+                    "typescript_sources": ts_sources[:3],
+                    "node_on_path": node,
+                }
+            ),
+        }
+    report = {"batch_id": "BATCH-F2P-0003", "side": "source", "results": results}
+    print(json.dumps(report, indent=2))
+    output_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "source_probe_results.json")
+    with open(output_path, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2)
+        handle.write("\n")
+    return 0 if all(r["status"] == "FAIL" for r in results.values()) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
