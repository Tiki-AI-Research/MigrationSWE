+#!/usr/bin/env python3
+"""Source-side probe for ``BATCH-F2P-0001``.
+
+Runs the *same* shared F2P predicates against the TypeScript ``mcp-server``
+tree (defaults to ``/input/source/mcp-server``).  Because the required Python
+execution path does not exist on this side, every observation must report
+``FAIL``.  A ``PASS`` here would mean the observation has no discriminative
+power and must be dropped.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+BATCH_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(HERE)))
+SHARED = os.path.join(BATCH_ROOT, "shared", "batches", "BATCH-F2P-0001")
+
+if SHARED not in sys.path:
+    sys.path.insert(0, SHARED)
+
+from f2p_observations import main  # noqa: E402
+
+if __name__ == "__main__":
+    sys.exit(main("source"))
