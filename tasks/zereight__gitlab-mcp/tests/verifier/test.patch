+def f2p_030() -> None:
+    _, _, _, utils, _ = _import_impl()
+    ids = [utils.generate_id() for _ in range(20)]
+    assert all(len(value) == 8 for value in ids), ids
+    assert all(re.fullmatch(r"[0-9a-f]{8}", value) for value in ids), ids
+    assert len(set(ids)) == 20, ids
+    _assert_updated_at()
