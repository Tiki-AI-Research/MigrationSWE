+#!/usr/bin/env python3
+"""Source-side probe runner for BATCH-F2P-0002.
+
+Executes the exact same shared F2P predicates as the target probe against the
+TypeScript source tree selected by ``OMG_REPO_ROOT`` (default ``/input/source``).
+
+Every predicate requires the migrated Python implementation to exist and to
+satisfy the frozen target postcondition. The source tree has no ``omg_mcp``
+package and no Python packaging, so each observation is expected to report
+``FAIL`` here; this is the source half of the F2P discrimination and proves the
+postcondition is not already satisfied by the source technology.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_SHARED_CANDIDATES = [
+    os.environ.get("OMG_F2P_SHARED"),
+    "/assets/shared/batches/BATCH-F2P-0002",
+    os.path.normpath(os.path.join(_HERE, "..", "..", "..", "shared", "batches", "BATCH-F2P-0002")),
+    os.path.normpath(os.path.join(_HERE, "..", "..", "shared", "batches", "BATCH-F2P-0002")),
+]
+_SHARED = next(
+    (path for path in _SHARED_CANDIDATES if path and os.path.isdir(path)),
+    _SHARED_CANDIDATES[1],
+)
+if _SHARED not in sys.path:
+    sys.path.insert(0, _SHARED)
+
+os.environ.setdefault("OMG_REPO_ROOT", "/input/source")
+
+import f2p_predicates  # noqa: E402
+
+
+def main(argv: list) -> int:
+    report_path = argv[1] if len(argv) > 1 else None
+    results = f2p_predicates.run_all()
+    payload = {
+        "batch_id": "BATCH-F2P-0002",
+        "side": "source",
+        "repo_root": os.environ["OMG_REPO_ROOT"],
+        "observations": results,
+    }
+    text = json.dumps(payload, indent=2, sort_keys=True)
+    if report_path:
+        with open(report_path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+    print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
