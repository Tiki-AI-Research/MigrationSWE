+
+CHECKS = {
+    "F2P-025": f2p_025,
+    "F2P-026": f2p_026,
+    "F2P-027": f2p_027,
+    "F2P-028": f2p_028,
+    "F2P-029": f2p_029,
+    "F2P-030": f2p_030,
+    "F2P-031": f2p_031,
+    "F2P-032": f2p_032,
+    "F2P-033": f2p_033,
+    "F2P-034": f2p_034,
+    "F2P-035": f2p_035,
+    "F2P-036": f2p_036,
+    "F2P-037": f2p_037,
+    "F2P-038": f2p_038,
+    "F2P-039": f2p_039,
+    "F2P-040": f2p_040,
+    "F2P-041": f2p_041,
+    "F2P-042": f2p_042,
+    "F2P-043": f2p_043,
+    "F2P-044": f2p_044,
+    "F2P-045": f2p_045,
+    "F2P-046": f2p_046,
+    "F2P-047": f2p_047,
+    "F2P-048": f2p_048,
+}
+
+
+def run_all() -> dict:
+    """Execute every predicate and return ``{observation_id: status}``.
+
+    ``status`` is ``"PASS"`` when the predicate returns cleanly, otherwise
+    ``"FAIL: <reason>"``. Exceptions are captured verbatim; nothing is
+    swallowed as a false pass.
+    """
+
+    results: dict = {}
+    for observation_id in sorted(CHECKS):
+        try:
+            CHECKS[observation_id]()
+        except Exception as error:  # noqa: BLE001 - report the raw observation
+            results[observation_id] = f"FAIL: {type(error).__name__}: {error}"
+        else:
+            results[observation_id] = "PASS"
+    return results
+
+
+def main() -> int:
+    results = run_all()
+    stream = io.StringIO()
+    json.dump(results, stream, indent=2, sort_keys=True)
+    print(stream.getvalue())
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
