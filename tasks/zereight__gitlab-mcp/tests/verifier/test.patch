+    if invalid != {"error": "Invalid phase: 100. Valid: 0-5."}:
+        return False, f"omg_get_phase_info(100) returned {invalid!r}"
+    return True, f"{origin}: phase 2.0 -> execution, 100 -> error"
+
+
+_STARTUP_FAILURE_SCRIPT = r"""
+import os, runpy, sys
