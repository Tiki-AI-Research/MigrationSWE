+class BrokenStdin:
+    @property
+    def buffer(self):
+        return self
+    def fail(self, *args, **kwargs):
+        raise RuntimeError("stdin is unavailable")
+    read = readline = readinto = fileno = isatty = __iter__ = __next__ = fail
