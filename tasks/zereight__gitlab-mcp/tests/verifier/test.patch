+// Source-side P2P probe for BATCH-P2P-0001.
+//
+// Runs against the unmodified TypeScript reference repository. For every P2P
+// observation owned by this batch it emits a raw PASS/FAIL plus the normalized
+// projection shared with the target side. The projection is never a one-sided
+// status value: root-artifact observations emit a sha256 digest map of the same
+// root files the target hashes, and behavior observations emit the shared
+// canonical value declared in probes.json.
+//
+// Usage:
+//   node probe_p2p.mjs [--repo <source-root>] [--probes <probes.json>] [--out <file>]
+//
+// Environment fallbacks: P2P_REPO_ROOT, P2P_PROBES, P2P_OUT.
+
+import { createHash } from "node:crypto";
+import { readFileSync, writeFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { execFileSync } from "node:child_process";
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const DEFAULT_PROBES = resolve(HERE, "../../../shared/batches/BATCH-P2P-0001/probes.json");
+
+function parseArgs(argv) {
+  const args = { repo: process.env.P2P_REPO_ROOT || process.cwd(), probes: process.env.P2P_PROBES || DEFAULT_PROBES, out: process.env.P2P_OUT || null };
+  for (let i = 0; i < argv.length; i += 1) {
+    const key = argv[i];
+    if (key === "--repo") args.repo = argv[++i];
+    else if (key === "--probes") args.probes = argv[++i];
+    else if (key === "--out") args.out = argv[++i];
+  }
+  return args;
+}
+
+function sha256(file) {
+  return createHash("sha256").update(readFileSync(file)).digest("hex");
+}
+
+function digestMap(repo, paths) {
+  const map = {};
+  for (const p of paths) map[p] = sha256(join(repo, p));
+  return map;
+}
+
+function sourceLiterals(repo, check) {
+  const locations = check.locations || [{ path: check.path, literals: check.literals }];
+  const missing = [];
+  const paths = [];
+  for (const location of locations) {
+    paths.push(location.path);
+    const text = readFileSync(join(repo, location.path), "utf8");
+    for (const literal of location.literals) {
+      if (!text.includes(literal)) missing.push({ path: location.path, literal });
+    }
+  }
+  return { ok: missing.length === 0, missing, paths };
+}
+
+function nativeClean(repo) {
+  try {
+    execFileSync("git", ["diff", "--exit-code"], { cwd: repo, stdio: "ignore" });
+    return { ok: true, command: "git diff --exit-code" };
+  } catch {
+    return { ok: false, command: "git diff --exit-code" };
+  }
+}
+
+function runCheck(repo, check) {
+  if (check.kind === "file_digest") {
+    return { ok: true, value: digestMap(repo, check.paths) };
+  }
+  if (check.kind === "source_literals") {
+    const result = sourceLiterals(repo, check);
+    return { ok: result.ok, detail: result };
+  }
+  throw new Error(`unsupported source check kind: ${check.kind}`);
+}
+
+function main() {
+  const args = parseArgs(process.argv.slice(2));
+  const spec = JSON.parse(readFileSync(args.probes, "utf8"));
+  const clean = nativeClean(args.repo);
+  const report = { side: "source", repo: args.repo, observations: {} };
+
+  for (const probe of spec.probes) {
+    const check = runCheck(args.repo, probe.source);
+    const status = check.ok && clean.ok ? "PASS" : "FAIL";
+    let value;
+    if (probe.projection === "sha256") {
+      value = check.value;
+    } else {
+      value = probe.canonical_value;
+    }
+    report.observations[probe.observation_id] = {
+      status,
+      value,
+      raw: { source_check: check.detail ?? check.value, native: clean },
+    };
+  }
+
+  const text = JSON.stringify(report, null, 2);
+  if (args.out) writeFileSync(args.out, text);
+  process.stdout.write(text + "\n");
+}
+
+main();
