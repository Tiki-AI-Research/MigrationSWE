+#!/usr/bin/env python3
+"""Source-side integration entry point for the ``omg-mcp-server`` migration.
+
+Executed by the source runtime as ``source/runner {report}``.  It dispatches
+every source-side batch probe and writes the ``migration-observations:v6``
+report to ``{report}`` (or stdout when no path is supplied).  The heavy lifting
+lives in ``shared/integration/harness.py`` so the source and target entry points
+share one aggregation implementation.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ASSET_ROOT = os.path.dirname(HERE)
+sys.path.insert(0, os.path.join(ASSET_ROOT, "shared", "integration"))
+
+import harness  # noqa: E402
+
+
+if __name__ == "__main__":
+    raise SystemExit(harness.main("source", sys.argv))
