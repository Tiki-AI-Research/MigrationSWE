+#!/usr/bin/env node
+// Source-side STATE probe for BATCH-STATE-0001.
+//
+// Executed against the reference TypeScript source tree (compiled to
+// `/input/source/mcp-server/dist`) by the source runner. Only the exported
+// path helpers are observable from the source module graph, so this probe
+// pins the `WORKSPACE_ROOT` -> `.omc` layout resolution of R007
+// (`STATE-001`, `STATE-002`). The persisted-field-shape probes for
+// `STATE-003`/`STATE-004` are exercised through the MCP server tools by the
+// target probe and the integration suite.
+//
+// Set OMG_SOURCE_DIST to override the compiled module directory.
+
+import path from "node:path";
+import process from "node:process";
+import { pathToFileURL } from "node:url";
+
+const moduleRoot = process.env.OMG_SOURCE_DIST || "/input/source/mcp-server/dist";
+
+async function load(relative) {
+  return import(pathToFileURL(path.join(moduleRoot, relative)).href);
+}
+
+const utils = await load("utils.js");
+const stateTools = await load("state-tools.js");
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+const results = {};
+const previousRoot = process.env.WORKSPACE_ROOT;
+const previousCwd = process.cwd();
+
+// STATE-001: WORKSPACE_ROOT drives the .omc layout.
+try {
+  process.env.WORKSPACE_ROOT = path.join("/tmp", "omg-source-state-001");
+  const dir = stateTools.getStateDir();
+  const statePath = stateTools.getStatePath("ralph");
+  assert(
+    dir === path.join(process.env.WORKSPACE_ROOT, ".omc", "state"),
+    `.omc/state did not resolve under WORKSPACE_ROOT: ${dir}`
+  );
+  assert(
+    statePath === path.join(dir, "ralph-state.json"),
+    `state path did not resolve under WORKSPACE_ROOT: ${statePath}`
+  );
+  assert(utils.getWorkspaceRoot() === process.env.WORKSPACE_ROOT, "getWorkspaceRoot ignored WORKSPACE_ROOT");
+  results["STATE-001"] = { relation: "pass" };
+} catch (err) {
+  results["STATE-001"] = { relation: "fail", detail: String(err) };
+}
+
+// STATE-002: with WORKSPACE_ROOT unset the layout resolves under the cwd.
+try {
+  delete process.env.WORKSPACE_ROOT;
+  process.chdir("/tmp");
+  const dir = stateTools.getStateDir();
+  assert(
+    dir === path.join(process.cwd(), ".omc", "state"),
+    `.omc/state did not resolve under cwd: ${dir}`
+  );
+  assert(utils.getWorkspaceRoot() === process.cwd(), "getWorkspaceRoot ignored cwd");
+  results["STATE-002"] = { relation: "pass" };
+} catch (err) {
+  results["STATE-002"] = { relation: "fail", detail: String(err) };
+}
+
+process.chdir(previousCwd);
+if (previousRoot === undefined) {
+  delete process.env.WORKSPACE_ROOT;
+} else {
+  process.env.WORKSPACE_ROOT = previousRoot;
+}
+
+console.log(JSON.stringify(results, null, 2));
+process.exit(
+  Object.values(results).every((entry) => entry.relation === "pass") ? 0 : 1
+);
