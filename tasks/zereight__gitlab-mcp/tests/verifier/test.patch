@@ -0,0 +1,508 @@
+#!/usr/bin/env node
+// Source-side P2P probe for BATCH-P2P-0002.
+//
+// Exercises the *original TypeScript* `omg-mcp-server` directly from its
+// sources under `mcp-server/src/` and prints one shared projection per
+// observation.  The target probe under
+// `target/batches/BATCH-P2P-0002/probe.py` computes the same projections from
+// the migrated Python server; the two outputs must be equal after
+// normalization (batch relation: `equal_after_normalization`).
+//
+// The probe is intentionally self-contained so it runs in a bare Node.js
+// source container (Node >= 22.18 with default type stripping) *without* a
+// pre-built `mcp-server/dist/` and *without* `mcp-server/node_modules/`:
+//
+//   * the TypeScript sources are imported directly (Node strips the types),
+//   * the two runtime-only dependencies (`zod` and the MCP SDK) are only used
+//     to declare input schemas, which this probe replaces with an in-memory
+//     tool registry, so they are resolved to tiny in-memory stubs, and
+//   * the relative `.js` import specifiers used by the TS sources are remapped
+//     to their `.ts` originals by a registered module customization hook.
+//
+// Run inside the TypeScript source container:
+//
+//   REPO_ROOT=/workspace/repo node probe.mjs
+
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { spawnSync } from "node:child_process";
+import { register } from "node:module";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const REPO = process.env.REPO_ROOT || "/workspace/repo";
+const MCP = process.env.MCP_SERVER_DIR || path.join(REPO, "mcp-server");
+const SRC = path.join(MCP, "src");
+
+const BATCH_ID = "BATCH-P2P-0002";
+const OBSERVATIONS = [
+  "P2P-025", "P2P-026", "P2P-027", "P2P-028",
+  "P2P-029", "P2P-030", "P2P-031", "P2P-032",
+  "P2P-033", "P2P-034", "P2P-035", "P2P-036",
+  "P2P-037", "P2P-038", "P2P-039", "P2P-040",
+];
+
+// ── in-memory stubs for dependencies used only to declare schemas ────────────
+const ZOD_STUB = `
+function builder() {
+  const b = new Proxy(function () {}, {
+    get(_t, prop) {
+      if (prop === "then" || prop === Symbol.toPrimitive) return undefined;
+      return (..._args) => b;
+    },
+    apply() { return b; },
+  });
+  return b;
+}
+export const z = new Proxy({}, { get: () => builder() });
+export default { z };
+`;
+const MCP_STUB = "export class McpServer {}\n";
+const STDIO_STUB = "export class StdioServerTransport {}\n";
+
+const dataUrl = (source) => "data:text/javascript," + encodeURIComponent(source);
+
+const LOADER_SRC = `
+import { existsSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+const STUBS = ${JSON.stringify({
+  zod: dataUrl(ZOD_STUB),
+  mcp: dataUrl(MCP_STUB),
+  stdio: dataUrl(STDIO_STUB),
+})};
+export async function resolve(specifier, context, nextResolve) {
+  if (specifier === "zod") return { url: STUBS.zod, shortCircuit: true };
+  if (specifier === "@modelcontextprotocol/sdk/server/mcp.js") {
+    return { url: STUBS.mcp, shortCircuit: true };
+  }
+  if (specifier === "@modelcontextprotocol/sdk/server/stdio.js") {
+    return { url: STUBS.stdio, shortCircuit: true };
+  }
+  if (
+    specifier.endsWith(".js") &&
+    (specifier.startsWith("./") || specifier.startsWith("../"))
+  ) {
+    try {
+      const tsUrl = new URL(specifier.slice(0, -3) + ".ts", context.parentURL);
+      if (existsSync(fileURLToPath(tsUrl))) {
+        return { url: tsUrl.href, shortCircuit: true };
+      }
+    } catch {
+      /* fall through to the default resolver */
+    }
+  }
+  return nextResolve(specifier, context);
+}
+`;
+
+register(dataUrl(LOADER_SRC), pathToFileURL(SRC + path.sep).href);
+
+const load = (file) => import(pathToFileURL(path.join(SRC, file)).href);
+
+function makeServer() {
+  const handlers = new Map();
+  return {
+    handlers,
+    tool(name, _description, _schema, handler) {
+      handlers.set(name, handler);
+    },
+  };
+}
+
+function payload(result) {
+  return JSON.parse(result.content[0].text);
+}
+
+function canonical(value) {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  if (value && typeof value === "object") {
+    return `{${Object.keys(value)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonical(value[key])}`)
+      .join(",")}}`;
+  }
+  return JSON.stringify(value);
+}
+
+async function withWorkspace(fn) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "p2p-0002-"));
+  const previous = process.env.WORKSPACE_ROOT;
+  process.env.WORKSPACE_ROOT = dir;
+  try {
+    return await fn(dir);
+  } finally {
+    if (previous === undefined) delete process.env.WORKSPACE_ROOT;
+    else process.env.WORKSPACE_ROOT = previous;
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+// Run the repository's own public suite (`mcp-server/test/run-tests.mjs`) in a
+// throwaway directory.  The suite imports `../dist/*.js`; those shims re-export
+// the TypeScript sources directly, so the suite runs without a `tsc` build.
+function runSourceSuite() {
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "p2p-0002-suite-"));
+  try {
+    fs.mkdirSync(path.join(tmp, "dist"));
+    fs.mkdirSync(path.join(tmp, "test"));
+    fs.copyFileSync(
+      path.join(MCP, "test", "run-tests.mjs"),
+      path.join(tmp, "test", "run-tests.mjs")
+    );
+    fs.writeFileSync(
+      path.join(tmp, "dist", "utils.js"),
+      `export * from ${JSON.stringify(pathToFileURL(path.join(SRC, "utils.ts")).href)};\n`
+    );
+    fs.writeFileSync(
+      path.join(tmp, "dist", "state-tools.js"),
+      `export { getStatePath } from ${JSON.stringify(
+        pathToFileURL(path.join(SRC, "state-tools.ts")).href
+      )};\n`
+    );
+    const loaderPath = path.join(tmp, "ts-loader.mjs");
+    const registerPath = path.join(tmp, "register-loader.mjs");
+    fs.writeFileSync(loaderPath, LOADER_SRC);
+    fs.writeFileSync(
+      registerPath,
+      `import { register } from "node:module";\n` +
+        `import { pathToFileURL } from "node:url";\n` +
+        `register(pathToFileURL(${JSON.stringify(loaderPath)}).href, ` +
+        `pathToFileURL(${JSON.stringify(tmp + path.sep)}).href);\n`
+    );
+    const result = spawnSync(
+      process.execPath,
+      [
+        "--import",
+        pathToFileURL(registerPath).href,
+        "--test",
+        path.join(tmp, "test", "run-tests.mjs"),
+      ],
+      { cwd: tmp, encoding: "utf-8", timeout: 300000 }
+    );
+    return { result: result.status === 0 ? "PASS" : "FAIL" };
+  } finally {
+    fs.rmSync(tmp, { recursive: true, force: true });
+  }
+}
+
+async function main() {
+  const utils = await load("utils.ts");
+  const stateTools = await load("state-tools.ts");
+  const prdTools = await load("prd-tools.ts");
+  const workflowTools = await load("workflow-tools.ts");
+  const memoryTools = await load("memory-tools.ts");
+  const modelRouter = await load("model-router.ts");
+
+  const server = makeServer();
+  stateTools.registerStateTools(server);
+  prdTools.registerPrdTools(server);
+  workflowTools.registerWorkflowTools(server);
+  memoryTools.registerMemoryTools(server);
+  modelRouter.registerModelRouter(server);
+
+  const call = (name, args) => server.handlers.get(name)(args || {});
+
+  const probes = {
+    async "P2P-025"() {
+      const tiers = {};
+      for (const agent of ["architect", "critic", "analyst", "planner"]) {
+        tiers[agent] = payload(await call("omg_select_model", { task: "quick fix", agent_type: agent })).tier;
+      }
+      for (const agent of ["writer", "git-master", "code-simplifier", "explore"]) {
+        tiers[agent] = payload(
+          await call("omg_select_model", { task: "architect design refactor", agent_type: agent })
+        ).tier;
+      }
+      return tiers;
+    },
+
+    async "P2P-026"() {
+      return withWorkspace(async () => {
+        const ok = await call("omg_list_active", {});
+        const bad = await call("omg_read_state", { mode: "../../etc" });
+        const broken = payload(bad);
+        return {
+          success_blocks: ok.content.length,
+          success_type: ok.content[0].type,
+          success_json_object: typeof payload(ok) === "object" && payload(ok) !== null,
+          error_blocks: bad.content.length,
+          error_success: broken.success,
+          error_mentions_invalid_mode: String(broken.error).includes("Invalid mode name"),
+        };
+      });
+    },
+
+    async "P2P-027"() {
+      return withWorkspace(async () => {
+        await call("omg_write_state", { mode: "ralph", state: '{"a":1}' });
+        const merged = payload(await call("omg_write_state", { mode: "ralph", state: '{"b":2}' }));
+        const bad = payload(await call("omg_write_state", { mode: "ralph", state: "not json" }));
+        return {
+          success: merged.success,
+          mode: merged.mode,
+          state_keys: Object.keys(merged.state).filter((k) => k !== "updated_at").sort(),
+          bad_success: bad.success,
+          bad_error: bad.error,
+        };
+      });
+    },
+
+    async "P2P-028"() {
+      const indexSource = fs.readFileSync(path.join(SRC, "index.ts"), "utf-8");
+      return {
+        tool_count: server.handlers.size,
+        tool_order: [...server.handlers.keys()],
+        server_name: /name:\s*"([^"]+)"/.exec(indexSource)[1],
+        server_version: /version:\s*"([^"]+)"/.exec(indexSource)[1],
+      };
+    },
+
+    async "P2P-029"() {
+      return runSourceSuite();
+    },
+
+    async "P2P-030"() {
+      const pkg = JSON.parse(fs.readFileSync(path.join(REPO, "package.json"), "utf-8"));
+      return { name: pkg.name, bin: pkg.bin };
+    },
+
+    async "P2P-031"() {
+      const accepted = [];
+      const rejected = [];
+      for (const mode of ["omg-autopilot", "ralph", "__proto__"]) {
+        try {
+          utils.validateMode(mode);
+          accepted.push(mode);
