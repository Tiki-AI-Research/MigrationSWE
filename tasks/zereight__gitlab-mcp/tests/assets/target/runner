#!/usr/bin/env python3
"""Target-side integration entry point (alias of ``run_tests.py``).

The target runtime invokes ``{assets}/run_tests.py`` (see
``required_harness_entries.target``).  This companion entry point exists so the
``target/runner`` harness path is materialised by the INTEGRATION batch, which
is the only batch allowed to create it.  Both entry points call the same shared
implementation in ``shared/integration/harness.py``.
"""

from __future__ import annotations

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ASSET_ROOT = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(ASSET_ROOT, "shared", "integration"))

import harness  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(harness.main("target", sys.argv))
