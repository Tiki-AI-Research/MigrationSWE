    {
      "id": "DIFF-016",
      "requirement_ids": ["R020"],
      "surface": "`omg_get_phase_info` result text",
      "steps": [
        { "tool": "omg_get_phase_info", "args": { "phase": 100 } },
        { "tool": "omg_get_phase_info", "args": { "phase": 2 } },
        { "tool": "omg_get_phase_info", "args": {} }
