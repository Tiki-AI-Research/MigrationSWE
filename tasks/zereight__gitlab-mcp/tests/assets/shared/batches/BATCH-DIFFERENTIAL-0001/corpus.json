          "setup": [{ "fixture": "state/omg-autopilot-state.json", "dest": ".omc/state/omg-autopilot-state.json" }],
          "tool": "omg_next_phase",
          "args": { "current_phase": 4 }
        },
        { "read": ".omc/state/omg-autopilot-state.json" },
        {
          "setup": [{ "dest": ".omc/state/omg-autopilot-state.json", "content": { "active": true, "current_phase": 2 } }],
          "tool": "omg_next_phase",
          "args": { "current_phase": 5 }
        },
        {
          "setup": [{ "dest": ".omc/state/omg-autopilot-state.json", "content": { "active": true, "current_phase": 5 } }],
          "tool": "omg_next_phase",
          "args": { "current_phase": 5 }
        },
        { "read": ".omc/state/omg-autopilot-state.json" }
      ]
    },
    {
      "id": "DIFF-015",
      "requirement_ids": ["R019"],
      "surface": "`omg_check_completion` result text",
      "steps": [
        { "tool": "omg_check_completion", "args": {} },
        {
          "setup": [
            { "dest": ".omc/state/ralph-state.json", "content": { "active": true } },
            { "dest": ".omc/state/team-state.json", "content": { "active": true, "current_phase": true } },
            { "dest": ".omc/state/ultraqa-state.json", "content": { "active": true, "current_cycle": 2 } }
          ],
          "tool": "omg_check_completion",
          "args": {}
