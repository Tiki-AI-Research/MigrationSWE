+  getOrCreateLoginAttemptState: () => ({ attempts: 0 }),
+  evaluateLoginThrottle: () => ({ blocked: false, retryAfterSec: 0 }),
+  recordLoginFailure: () => ({ locked: false, lockMs: 0 }),
+  recordLoginSuccess: () => {},
