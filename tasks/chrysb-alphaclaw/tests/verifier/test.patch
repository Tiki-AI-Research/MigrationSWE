+const collectSseFrames = ({ port, timeoutMs = 3500 }) =>
+  new Promise((resolve) => {
+    let buffer = "";
+    let headers = {};
+    let finished = false;
+    let timer = null;
+    let request = null;
+    const finish = () => {
+      if (finished) return;
+      finished = true;
+      if (timer) clearTimeout(timer);
+      try {
+        request?.destroy();
+      } catch {}
+      resolve({ headers, buffer });
+    };
