+        headers = response.headers;
+        response.on("data", (chunk) => {
+          buffer += String(chunk);
+          const events = (buffer.match(/event: status/g) || []).length;
+          if (events >= 2) finish();
+        });
+        response.on("end", finish);
+        response.on("error", finish);
+      },
+    );
+    request.on("error", finish);
+    timer = setTimeout(finish, timeoutMs);
+  });
