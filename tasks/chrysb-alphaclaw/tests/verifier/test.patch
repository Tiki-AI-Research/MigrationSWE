diff --git a/tests/shared/integration/contract-differential.js b/tests/shared/integration/contract-differential.js
new file mode 100644
index 0000000..5b70c1f
--- /dev/null
+++ b/tests/shared/integration/contract-differential.js
@@ -0,0 +1,65 @@
+const live = require("./live-server");
+
+const checks = {
+  "DIFF-012": async (baseUrl) => {
+    const response = await live.httpCall(baseUrl, { requestPath: "/health" });
+    return response.status === 200 && ["healthy", "starting"].includes(response.json?.status);
+  },
+  "DIFF-013": async (baseUrl) => {
+    const response = await live.httpCall(baseUrl, { requestPath: "/" });
+    return response.status === 302 && response.headers.location === "/login.html";
+  },
+  "DIFF-014": async (baseUrl) => {
+    const response = await live.httpCall(baseUrl, { requestPath: "/login.html" });
+    return response.status === 200 && /html/i.test(response.headers["content-type"] || "");
+  },
+  "DIFF-015": async (baseUrl, cookie) => {
+    const response = await live.httpCall(baseUrl, {
+      requestPath: "/api/events/status",
+      headers: { cookie },
+    });
+    return response.status === 200 && /text\/event-stream/i.test(response.headers["content-type"] || "");
+  },
+  "DIFF-018": async (baseUrl) => (await live.httpCall(baseUrl, { requestPath: "/health" })).status === 200,
+  "DIFF-019": async (baseUrl) => (await live.httpCall(baseUrl, { requestPath: "/health" })).status === 200,
+  "DIFF-032": async (baseUrl, cookie) => {
+    const response = await live.httpCall(baseUrl, {
+      requestPath: "/api/events/status",
+      headers: { cookie },
+    });
+    return /no-cache/.test(response.headers["cache-control"] || "") &&
+      response.headers["x-accel-buffering"] === "no";
+  },
+};
+
+const main = async () => {
+  const repoRoot = process.argv[2];
+  const ids = (process.argv[3] || "").split(",").filter(Boolean);
+  const session = await live.sharedLiveSession(repoRoot, {
+    setupPassword: "fixture-setup-password",
+  });
+  const server = session.server;
+  const out = {};
+  try {
+    const login = await live.httpCall(server.baseUrl, {
+      method: "POST",
+      requestPath: "/api/auth/login",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ password: "fixture-setup-password" }),
+    });
+    for (const id of ids) {
+      try {
+        out[id] = checks[id] && await checks[id](server.baseUrl, login.cookie) ? "PASS" : "FAIL";
+      } catch {
+        out[id] = "FAIL";
+      }
+    }
+  } finally {
+  }
+  process.stdout.write(`${JSON.stringify(out)}\n`);
+};
+
+main().catch((error) => {
+  process.stderr.write(`${error.stack || error}\n`);
+  process.exit(1);
+});
diff --git a/tests/shared/integration/live-server.js b/tests/shared/integration/live-server.js
new file mode 100644
index 0000000..c1d3083
--- /dev/null
+++ b/tests/shared/integration/live-server.js
@@ -0,0 +1,353 @@
+const crypto = require("crypto");
+const fs = require("fs");
+const http = require("http");
+const net = require("net");
+const os = require("os");
+const path = require("path");
+const { spawn } = require("child_process");
+
+const kBootTimeoutMs = 180000;
+
+const freePort = () =>
+  new Promise((resolve, reject) => {
+    const probe = net.createServer();
+    probe.once("error", reject);
+    probe.listen(0, "127.0.0.1", () => {
+      const { port } = probe.address();
+      probe.close(() => resolve(port));
+    });
+  });
+
+const waitForHealth = async (baseUrl, deadline) => {
+  while (Date.now() < deadline) {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), 1000);
+    try {
+      const response = await fetch(`${baseUrl}/health`, { signal: controller.signal });
+      if (response.ok) return true;
+    } catch {} finally {
+      clearTimeout(timer);
+    }
+    await new Promise((resolve) => setTimeout(resolve, 250));
+  }
+  return false;
+};
+
+const createGatewaySpy = async () => {
+  const calls = [];
+  let reply = { status: 200, headers: {}, body: "{}" };
+  const server = http.createServer((incoming, outgoing) => {
+    const chunks = [];
+    incoming.on("data", (chunk) => chunks.push(chunk));
+    incoming.on("end", () => {
+      calls.push({
+        method: incoming.method,
+        url: incoming.url,
+        headers: incoming.headers,
+        bodyText: Buffer.concat(chunks).toString("utf8"),
+      });
+      outgoing.statusCode = reply.status;
+      for (const [key, value] of Object.entries(reply.headers)) {
+        outgoing.setHeader(key, value);
+      }
+      outgoing.end(reply.body);
+    });
+  });
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  server.unref();
+  return {
+    calls,
+    port: server.address().port,
+    reply: (next) => {
+      reply = next;
+    },
+    close: () => new Promise((resolve) => server.close(resolve)),
+  };
+};
+
+const writeRoot = ({ rootDir, gatewayPort, openaiCompatEnabled, onboarded = true }) => {
+  const openclawDir = path.join(rootDir, ".openclaw");
+  fs.mkdirSync(openclawDir, { recursive: true });
+  fs.writeFileSync(
+    path.join(openclawDir, "openclaw.json"),
+    JSON.stringify({ gateway: { port: gatewayPort } }, null, 2),
+  );
+  if (onboarded) {
+    fs.writeFileSync(
+      path.join(rootDir, "onboarded.json"),
+      JSON.stringify({ onboarding_version: "contract-probe" }, null, 2),
+    );
+  }
+  fs.writeFileSync(
+    path.join(openclawDir, "alphaclaw.json"),
+    JSON.stringify(
+      { features: { openaiCompatApi: { enabled: openaiCompatEnabled === true } } },
+      null,
+      2,
+    ),
+  );
+};
+
+const startLiveServer = async ({
+  repoRoot,
+  gatewayPort,
+  port,
+  setupPassword = "contract-secret",
+  gatewayToken = "contract-gateway-token",
+  trustProxyHops = "1",
+  env = {},
+  rootDir,
+  onboarded = true,
+  openaiCompatEnabled = false,
+}) => {
+  const ownedRoot = !rootDir;
+  const resolvedRoot = rootDir || fs.mkdtempSync(path.join(os.tmpdir(), "alphaclaw-live-"));
+  writeRoot({
+    rootDir: resolvedRoot,
+    gatewayPort,
+    openaiCompatEnabled,
+    onboarded,
+  });
+  const child = spawn(
+    process.execPath,
+    [path.join(repoRoot, "bin", "alphaclaw.js"), "start"],
+    {
+      cwd: repoRoot,
+      env: {
+        ...process.env,
+        PORT: String(port),
+        SETUP_PASSWORD: setupPassword,
+        ALPHACLAW_ROOT_DIR: resolvedRoot,
+        HOME: resolvedRoot,
+        OPENCLAW_GATEWAY_TOKEN: gatewayToken,
+        TRUST_PROXY_HOPS: String(trustProxyHops),
+        NO_COLOR: "1",
+        ...env,
+      },
+      stdio: ["ignore", "pipe", "pipe"],
+      detached: true,
+    },
+  );
+  child.unref();
+  child.stdout.unref();
+  child.stderr.unref();
+  let output = "";
+  child.stdout.on("data", (chunk) => {
+    output += String(chunk);
+  });
+  child.stderr.on("data", (chunk) => {
+    output += String(chunk);
+  });
+  const baseUrl = `http://127.0.0.1:${port}`;
+  const ready = await waitForHealth(baseUrl, Date.now() + kBootTimeoutMs);
+  if (!ready) {
+    child.kill("SIGKILL");
+    if (ownedRoot) fs.rmSync(resolvedRoot, { recursive: true, force: true });
+    throw new Error(`server did not become ready:\n${output.slice(-4000)}`);
+  }
+  return {
+    baseUrl,
+    port,
+    rootDir: resolvedRoot,
+    output: () => output,
+    stop: () => {
+      try {
+        process.kill(-child.pid, "SIGKILL");
+      } catch {}
+      try {
+        child.kill("SIGKILL");
+      } catch {}
+      if (ownedRoot) fs.rmSync(resolvedRoot, { recursive: true, force: true });
+      return Promise.resolve();
+    },
+  };
+};
+
+const httpCall = async (
+  baseUrl,
+  { method = "GET", requestPath = "/", headers = {}, body } = {},
+) => {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 2500);
+  let response;
+  try {
+    response = await fetch(`${baseUrl}${requestPath}`, {
+      method,
+      headers,
+      body,
+      redirect: "manual",
+      signal: controller.signal,
+    });
+  } catch (error) {
+    if (error.name !== "AbortError" || !response) throw error;
+  } finally {
+    clearTimeout(timer);
+  }
+  const reader = response.body.getReader();
+  const chunks = [];
+  let received = 0;
+  const limit = 65536;
+  try {
+    while (received < limit) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      chunks.push(Buffer.from(value));
+      received += value.length;
+    }
+    await reader.cancel();
+  } catch {}
+  const buffer = Buffer.concat(chunks);
+  let json = null;
+  try {
+    json = JSON.parse(buffer.toString("utf8"));
+  } catch {}
+  return {
+    status: response.status,
+    headers: Object.fromEntries(
+      [...response.headers.entries()].map(([key, value]) => [key.toLowerCase(), value]),
+    ),
+    buffer,
+    text: buffer.toString("utf8"),
+    json,
+    cookie: (response.headers.get("set-cookie") || "").split(";")[0],
+  };
+};
+
+const gatewayLogPath = (port) => path.join(os.tmpdir(), `alphaclaw-gateway-${port}.jsonl`);
+
+const readGatewayCalls = (port) => {
+  try {
+    return fs
+      .readFileSync(gatewayLogPath(port), "utf8")
+      .split("\n")
+      .filter(Boolean)
+      .map((line) => JSON.parse(line));
+  } catch {
+    return [];
+  }
+};
+
+const startGatewaySidecar = (port, logPath) => {
+  const child = spawn(
+    process.execPath,
+    [
+      "-e",
+      `
+        const fs = require("fs");
+        const http = require("http");
+        const [port, logPath] = process.argv.slice(1);
+        fs.writeFileSync(logPath, "");
+        http.createServer((incoming, outgoing) => {
+          const chunks = [];
+          incoming.on("data", (chunk) => chunks.push(chunk));
+          incoming.on("end", () => {
+            fs.appendFileSync(logPath, JSON.stringify({
+              method: incoming.method,
+              url: incoming.url,
+              headers: incoming.headers,
+              bodyText: Buffer.concat(chunks).toString("utf8"),
+            }) + "\\n");
+            outgoing.statusCode = 200;
+            outgoing.setHeader("content-type", "application/json");
+            outgoing.end("{}");
+          });
+        }).listen(Number(port), "127.0.0.1");
+      `,
+      String(port),
+      logPath,
+    ],
+    { detached: true, stdio: "ignore" },
+  );
+  child.unref();
+  return child;
+};
+
+const sharedSessions = new Map();
+
+const sharedSessionFile = (repoRoot, options) =>
+  path.join(
+    os.tmpdir(),
+    `alphaclaw-live-${crypto
+      .createHash("sha256")
+      .update(JSON.stringify([repoRoot, options]))
+      .digest("hex")
+      .slice(0, 16)}.json`,
+  );
+
+const sharedLiveSession = async (repoRoot, options = {}) => {
+  const recordPath = sharedSessionFile(repoRoot, options);
+  const cached = sharedSessions.get(recordPath);
+  if (cached) return cached;
+  try {
+    const record = JSON.parse(fs.readFileSync(recordPath, "utf8"));
+    if (await waitForHealth(record.baseUrl, Date.now() + 2000)) {
+      return {
+        gateway: {
+          get calls() {
+            return readGatewayCalls(record.gatewayPort);
+          },
+          port: record.gatewayPort,
+          reply() {},
+          close: async () => {},
+        },
+        server: {
+          baseUrl: record.baseUrl,
+          port: record.port,
+          output: () => "",
+          stop: async () => {},
+        },
+        port: record.port,
+      };
+    }
+  } catch {}
+  const gatewayPort = await freePort();
+  startGatewaySidecar(gatewayPort, gatewayLogPath(gatewayPort));
+  const gateway = {
+    get calls() {
+      return readGatewayCalls(gatewayPort);
+    },
+    port: gatewayPort,
+    reply() {},
+    close: async () => {},
+  };
+  const port = await freePort();
+  const server = await startLiveServer({
+    repoRoot,
+    gatewayPort: gateway.port,
+    port,
+    ...options,
+  });
+  fs.writeFileSync(
+    recordPath,
+    JSON.stringify({ baseUrl: server.baseUrl, port, gatewayPort: gateway.port }),
+  );
+  const session = { gateway, server, port };
+  sharedSessions.set(recordPath, session);
+  return session;
+};
+
+const usesTargetFramework = (repoRoot) => {
+  try {
+    const manifest = JSON.parse(
+      fs.readFileSync(path.join(repoRoot, "package.json"), "utf8"),
+    );
+    return (
+      manifest.dependencies?.hono === "4.13.7" &&
+      Boolean(manifest.dependencies?.["@hono/node-server"]) &&
+      manifest.dependencies?.express === undefined
+    );
+  } catch {
+    return false;
+  }
+};
+
+module.exports = {
+  createGatewaySpy,
+  freePort,
+  httpCall,
+  sharedLiveSession,
+  startLiveServer,
+  usesTargetFramework,
+  waitForHealth,
+  writeRoot,
+};
