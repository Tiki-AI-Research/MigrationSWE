diff --git a/tests/server/server-lifecycle.test.js b/tests/server/server-lifecycle.test.js
new file mode 100644
index 0000000..d24bccc
--- /dev/null
+++ b/tests/server/server-lifecycle.test.js
@@ -0,0 +1,99 @@
+const {
+  registerServerShutdown,
+  startServerLifecycle,
+} = require("../../lib/server/init/server-lifecycle");
+
+const flush = () => new Promise((resolve) => setImmediate(resolve));
+
+describe("server lifecycle", () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("listens on the configured port and runs onboarding when onboarded", () => {
+    const runOnboardedBootSequence = vi.fn();
+    const server = { listen: vi.fn((_port, _host, callback) => callback()) };
+    const log = vi.spyOn(console, "log").mockImplementation(() => {});
+
+    startServerLifecycle({
+      server,
+      PORT: 4321,
+      isOnboarded: () => true,
+      runOnboardedBootSequence,
+    });
+
+    expect(server.listen).toHaveBeenCalledWith(
+      4321,
+      "0.0.0.0",
+      expect.any(Function),
+    );
+    expect(runOnboardedBootSequence).toHaveBeenCalledTimes(1);
+    expect(log).toHaveBeenCalledWith(
+      expect.stringContaining(":4321"),
+    );
+  });
+
+  it("logs the waiting message without booting when not onboarded", () => {
+    const runOnboardedBootSequence = vi.fn();
+    const server = { listen: vi.fn((_port, _host, callback) => callback()) };
+    const log = vi.spyOn(console, "log").mockImplementation(() => {});
+
+    startServerLifecycle({
+      server,
+      PORT: 3000,
+      isOnboarded: () => false,
+      runOnboardedBootSequence,
+    });
+
+    expect(runOnboardedBootSequence).not.toHaveBeenCalled();
+    expect(log).toHaveBeenCalledWith(
+      expect.stringContaining("Awaiting onboarding"),
+    );
+  });
+
+  it("stops the Gmail watch service and disposes the terminal on SIGTERM and SIGINT", async () => {
+    const listeners = new Map();
+    vi.spyOn(process, "on").mockImplementation((event, handler) => {
+      listeners.set(event, handler);
+      return process;
+    });
+    const gmailWatchService = { stop: vi.fn(async () => {}) };
+    const watchdogTerminal = { disposeSession: vi.fn() };
+
+    registerServerShutdown({ gmailWatchService, watchdogTerminal });
+
+    expect(typeof listeners.get("SIGTERM")).toBe("function");
+    expect(typeof listeners.get("SIGINT")).toBe("function");
+
+    listeners.get("SIGTERM")();
+    await flush();
+    expect(gmailWatchService.stop).toHaveBeenCalledTimes(1);
+    expect(watchdogTerminal.disposeSession).toHaveBeenCalledTimes(1);
+
+    listeners.get("SIGINT")();
+    await flush();
+    expect(gmailWatchService.stop).toHaveBeenCalledTimes(2);
+    expect(watchdogTerminal.disposeSession).toHaveBeenCalledTimes(2);
+  });
+
+  it("disposes the terminal even when Gmail shutdown rejects", async () => {
+    const listeners = new Map();
+    vi.spyOn(process, "on").mockImplementation((event, handler) => {
+      listeners.set(event, handler);
+      return process;
+    });
+    const gmailWatchService = {
+      stop: vi.fn(async () => {
+        throw new Error("stop failed");
+      }),
+    };
+    const watchdogTerminal = { disposeSession: vi.fn() };
+
+    registerServerShutdown({ gmailWatchService, watchdogTerminal });
+    listeners.get("SIGTERM")();
+    await flush();
+
+    expect(gmailWatchService.stop).toHaveBeenCalledTimes(1);
+    expect(watchdogTerminal.disposeSession).toHaveBeenCalledTimes(1);
+  });
+});
