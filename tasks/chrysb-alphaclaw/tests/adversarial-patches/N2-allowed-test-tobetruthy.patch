diff --git a/lib/server/http/request-response.js b/lib/server/http/request-response.js
new file mode 100644
index 0000000..c3f475b
--- /dev/null
+++ b/lib/server/http/request-response.js
@@ -0,0 +1,422 @@
+const fs = require("fs");
+const { Readable } = require("stream");
+const { getMimeType } = require("hono/utils/mime");
+
+const kBodyKey = "alphaclaw.body";
+const kBodyConsumedKey = "alphaclaw.bodyConsumed";
+const kClientIpKey = "alphaclaw.clientIp";
+
+const parseQuery = (url) => {
+  const queries = {};
+  for (const [key, value] of url.searchParams.entries()) {
+    if (Object.prototype.hasOwnProperty.call(queries, key)) {
+      const current = queries[key];
+      queries[key] = Array.isArray(current)
+        ? [...current, value]
+        : [current, value];
+      continue;
+    }
+    queries[key] = value;
+  }
+  return queries;
+};
+
+const headersToObject = (headers) => {
+  const result = {};
+  for (const [key, value] of headers.entries()) {
+    const normalizedKey = key.toLowerCase();
+    if (Object.prototype.hasOwnProperty.call(result, normalizedKey)) {
+      const current = result[normalizedKey];
+      result[normalizedKey] = Array.isArray(current)
+        ? [...current, value]
+        : [current, value];
+      continue;
+    }
+    result[normalizedKey] = value;
+  }
+  return result;
+};
+
+const serializeCookie = (name, value, options = {}) => {
+  const segments = [`${name}=${value ?? ""}`];
+  if (options.path) segments.push(`Path=${options.path}`);
+  if (options.domain) segments.push(`Domain=${options.domain}`);
+  if (options.maxAge !== undefined) {
+    segments.push(`Max-Age=${Math.floor(Number(options.maxAge) / 1000)}`);
+  }
+  if (options.expires) segments.push(`Expires=${options.expires.toUTCString()}`);
+  if (options.httpOnly) segments.push("HttpOnly");
+  if (options.secure) segments.push("Secure");
+  if (options.sameSite) {
+    const sameSite = String(options.sameSite);
+    segments.push(
+      `SameSite=${sameSite.charAt(0).toUpperCase()}${sameSite.slice(1).toLowerCase()}`,
+    );
+  }
+  return segments.join("; ");
+};
+
+const createRequestFacade = (context, { clientIp, params } = {}) => {
+  const requestUrl = new URL(context.req.url);
+  const headers = headersToObject(context.req.raw.headers);
+  const closeHandlers = new Set();
+  let closed = false;
+  let pathname = requestUrl.pathname;
+  let search = requestUrl.search;
+  let url = `${pathname}${search}`;
+  let originalUrl = url;
+
+  const emitClose = () => {
+    if (closed) return;
+    closed = true;
+    for (const handler of closeHandlers) {
+      try {
+        handler();
+      } catch {}
+    }
+    closeHandlers.clear();
+  };
+
+  const abortSignal = context.req.raw.signal;
+  if (abortSignal) {
+    if (abortSignal.aborted) {
+      queueMicrotask(emitClose);
+    } else {
+      abortSignal.addEventListener("abort", emitClose, { once: true });
+    }
+  }
+
+  const request = {
+    headers,
+    method: context.req.method,
+    path: pathname,
+    originalUrl,
+    url,
+    query: parseQuery(requestUrl),
+    params: params || context.req.param(),
+    protocol: headers["x-forwarded-proto"] || requestUrl.protocol.replace(":", ""),
+    ip: clientIp || context.get(kClientIpKey) || "",
+    socket: {
+      remoteAddress:
+        context.env?.incoming?.socket?.remoteAddress ||
+        context.env?.incoming?.connection?.remoteAddress ||
+        "",
+    },
+    body: context.get(kBodyKey),
+    get(name) {
+      const value = headers[String(name || "").toLowerCase()];
+      return Array.isArray(value) ? value[0] : value;
+    },
+    on(event, handler) {
+      if (event === "close" && typeof handler === "function") {
+        if (closed) {
+          queueMicrotask(handler);
+        } else {
+          closeHandlers.add(handler);
+        }
+      }
+      return request;
+    },
+    emitClose,
+    setPath(nextPath, nextSearch) {
+      pathname = nextPath;
+      search = nextSearch === undefined ? search : nextSearch;
+      url = `${pathname}${search}`;
+      originalUrl = url;
+      request.path = pathname;
+      request.url = url;
+      request.originalUrl = originalUrl;
+      request.query = parseQuery(
+        new URL(url || "/", `${requestUrl.origin || "http://localhost"}`),
+      );
+    },
+  };
+
+  Object.defineProperty(request, "body", {
+    enumerable: true,
+    configurable: true,
+    get() {
+      return context.get(kBodyKey);
+    },
+  });
+
+  return request;
+};
+
+const toResponseBody = (value) => {
+  if (value === undefined || value === null) return null;
+  if (Buffer.isBuffer(value)) return value;
+  if (typeof value === "string") return value;
+  if (value instanceof Uint8Array) return value;
+  return String(value);
+};
+
+const createResponseFacade = (context) => {
+  const headers = new Map();
+  let statusCode = 200;
+  let bodyValue;
+  let response = null;
+  let stream = null;
+  let streamController = null;
+  let streamClosed = false;
+  let headersSent = false;
+  let ended = false;
+
+  const appendHeaderValue = (map, key, value) => {
+    if (value === undefined) return;
+    if (Array.isArray(value)) {
+      const existing = map.get(key);
+      const next = existing ? [...existing] : [];
+      next.push(...value.map((entry) => String(entry)));
+      map.set(key, next);
+      return;
+    }
+    map.set(key, [String(value)]);
+  };
+
+  const buildHeaders = () => {
+    const result = new Headers();
+    for (const [key, values] of headers.entries()) {
+      for (const value of values) {
+        result.append(key, value);
+      }
+    }
+    return result;
+  };
+
+  const ensureStream = () => {
+    if (stream) return stream;
+    stream = new ReadableStream({
+      start(controller) {
+        streamController = controller;
+      },
+      cancel() {
+        streamClosed = true;
+        if (typeof context.req.raw.signal?.addEventListener === "function") {
+          // no-op; request facade owns close emission
+        }
+        context.get("alphaclaw.onStreamCancel")?.();
+      },
+    });
+    response = new Response(stream, {
+      status: statusCode,
+      headers: buildHeaders(),
+    });
+    headersSent = true;
+    return stream;
+  };
+
+  const writeChunk = (chunk) => {
+    if (streamClosed) return;
+    ensureStream();
+    const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(String(chunk));
+    if (buffer.length > 0) streamController.enqueue(buffer);
+  };
+
+  const closeStream = (chunk) => {
+    if (streamClosed) return;
+    ensureStream();
+    if (chunk !== undefined && chunk !== null) {
+      const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(String(chunk));
+      if (buffer.length > 0) streamController.enqueue(buffer);
+    }
+    streamClosed = true;
+    streamController.close();
+  };
+
+  const finalize = () => response;
+
+  const responseFacade = {
+    get headersSent() {
+      return headersSent;
+    },
+    get finished() {
+      return ended;
+    },
+    get statusCode() {
+      return statusCode;
+    },
+    set statusCode(value) {
+      statusCode = Number(value) || 200;
+    },
+    status(code) {
+      statusCode = Number(code) || 200;
+      return responseFacade;
+    },
+    setHeader(name, value) {
+      if (value === undefined) return responseFacade;
+      headers.set(String(name).toLowerCase(), [String(value)]);
+      return responseFacade;
+    },
+    getHeader(name) {
+      const values = headers.get(String(name).toLowerCase());
+      return values ? values[0] : undefined;
+    },
+    removeHeader(name) {
+      headers.delete(String(name).toLowerCase());
+    },
+    set(name, value) {
+      if (name && typeof name === "object") {
+        for (const [key, entry] of Object.entries(name)) {
+          responseFacade.setHeader(key, entry);
+        }
+        return responseFacade;
+      }
+      return responseFacade.setHeader(name, value);
+    },
+    append(name, value) {
+      appendHeaderValue(headers, String(name).toLowerCase(), value);
+      return responseFacade;
+    },
+    json(value) {
+      if (!headers.has("content-type")) {
+        headers.set("content-type", ["application/json; charset=utf-8"]);
+      }
+      bodyValue = JSON.stringify(value);
+      ended = true;
+      return responseFacade;
+    },
+    send(value) {
+      if (value === undefined || value === null) {
+        bodyValue = "";
+        ended = true;
+        return responseFacade;
+      }
+      if (Buffer.isBuffer(value) || value instanceof Uint8Array) {
+        if (!headers.has("content-type")) {
+          headers.set("content-type", ["application/octet-stream"]);
+        }
+        bodyValue = value;
+        ended = true;
+        return responseFacade;
+      }
+      if (typeof value === "object") return responseFacade.json(value);
+      if (!headers.has("content-type")) {
+        headers.set("content-type", ["text/html; charset=utf-8"]);
+      }
+      bodyValue = String(value);
+      ended = true;
+      return responseFacade;
+    },
+    redirect(location, status = 302) {
+      statusCode = Number(status) || 302;
+      headers.set("location", [String(location)]);
+      bodyValue = "";
+      ended = true;
+      return responseFacade;
+    },
+    cookie(name, value, options = {}) {
+      appendHeaderValue(
+        headers,
+        "set-cookie",
+        serializeCookie(name, value, options),
+      );
+      return responseFacade;
+    },
+    clearCookie(name, options = {}) {
+      return responseFacade.cookie(name, "", {
+        ...options,
+        expires: new Date(0),
+        maxAge: undefined,
+      });
+    },
+    sendFile(filePath) {
+      const stats = fs.statSync(filePath);
+      headers.set("content-type", [
+        getMimeType(filePath) || "application/octet-stream",
+      ]);
+      headers.set("content-length", [String(stats.size)]);
+      const fileStream = fs.createReadStream(filePath);
+      fileStream.on("error", () => {});
+      response = new Response(Readable.toWeb(fileStream), {
+        status: statusCode,
+        headers: buildHeaders(),
+      });
+      headersSent = true;
+      ended = true;
+      return responseFacade;
+    },
+    download(filePath, fileName, callback) {
+      try {
+        const stats = fs.statSync(filePath);
+        const safeName = String(fileName || "download").replace(/"/g, "");
+        headers.set("content-type", [
+          getMimeType(filePath) || "application/octet-stream",
+        ]);
+        headers.set("content-length", [String(stats.size)]);
+        headers.set("content-disposition", [
+          `attachment; filename="${safeName}"`,
+        ]);
+        const fileStream = fs.createReadStream(filePath);
+        if (typeof callback === "function") {
+          fileStream.once("error", callback);
+          fileStream.once("end", () => callback(null));
+        }
+        response = new Response(Readable.toWeb(fileStream), {
+          status: statusCode,
+          headers: buildHeaders(),
+        });
+        headersSent = true;
+        ended = true;
+      } catch (err) {
+        if (typeof callback === "function") callback(err);
+      }
+      return responseFacade;
+    },
+    flushHeaders() {
+      ensureStream();
+      return responseFacade;
+    },
+    write(chunk) {
+      writeChunk(chunk);
+      return true;
+    },
+    end(chunk) {
+      if (stream && !streamClosed) {
+        closeStream(chunk);
+      } else if (!stream) {
+        if (chunk !== undefined && chunk !== null) {
+          bodyValue = toResponseBody(chunk);
+        }
+        ended = true;
+      }
+      return responseFacade;
+    },
+    __hasResponse() {
+      return ended || Boolean(stream);
+    },
+    __isStreaming() {
+      return Boolean(stream);
+    },
+    __getResponse() {
+      if (response) return response;
+      if (!ended) return null;
+      response = new Response(
+        bodyValue === undefined ? null : toResponseBody(bodyValue),
+        {
+          status: statusCode,
+          headers: buildHeaders(),
+        },
+      );
+      headersSent = true;
+      return response;
+    },
+    __setResponse(nextResponse) {
+      response = nextResponse;
+      headersSent = true;
+      ended = true;
+    },
+  };
+
+  return responseFacade;
+};
+
+module.exports = {
+  createRequestFacade,
+  createResponseFacade,
+  kBodyConsumedKey,
+  kBodyKey,
+  kClientIpKey,
+  parseQuery,
+  serializeCookie,
+};
diff --git a/lib/server/http/route-adapter.js b/lib/server/http/route-adapter.js
new file mode 100644
index 0000000..9856df0
--- /dev/null
+++ b/lib/server/http/route-adapter.js
@@ -0,0 +1,160 @@
+const { Hono } = require("hono");
+const {
+  createRequestFacade,
+  createResponseFacade,
+  kClientIpKey,
+} = require("./request-response");
+const { resolveClientIpFromContext } = require("./client-ip");
+
+const kMethodNames = ["get", "post", "put", "patch", "delete", "all"];
+
+const translateRegExpPath = (pattern) => {
+  const source = pattern.source;
+  for (const prefix of ["openclaw", "assets", "hooks", "webhook", "api"]) {
+    if (source === `^\\/${prefix}\\/.+`) {
+      return { path: `/${prefix}/:path{.+}`, guard: null };
+    }
+  }
+  return null;
+};
+
+const normalizeTransportPath = (path) => {
+  if (typeof path !== "string") return path;
+  return path;
+};
+
+const createRouteAdapter = (options = {}) => {
+  const hono =
+    options instanceof Hono
+      ? options
+      : options.hono instanceof Hono
+        ? options.hono
+        : new Hono();
+  const registerRoute = (method, path, handlers) => {
+    if (Array.isArray(path)) {
+      for (const entry of path) registerRoute(method, entry, handlers);
+      return adapter;
+    }
+
+    if (path instanceof RegExp) {
+      const translated = translateRegExpPath(path);
+      const targetPath = translated ? translated.path : "*";
+      const guard = translated ? null : path;
+      const handler = createHandler(handlers, { guard });
+      hono[method](targetPath, handler);
+      return adapter;
+    }
+
+    const targetPath = normalizeTransportPath(path);
+    hono[method](targetPath, createHandler(handlers));
+    return adapter;
+  };
+
+  const createHandler = (handlers, { guard = null } = {}) => {
+    return async (context, honoNext) => {
+      if (guard && !guard.test(context.req.path)) {
+        return honoNext();
+      }
+
+      const clientIp =
+        context.get(kClientIpKey) || resolveClientIpFromContext(context);
+      context.set(kClientIpKey, clientIp);
+
+      const request = createRequestFacade(context, { clientIp });
+      Object.defineProperty(request, "__context", {
+        value: context,
+        enumerable: false,
+      });
+      const response = createResponseFacade(context);
+      context.set("alphaclaw.onStreamCancel", () => request.emitClose());
+
+      const dispatch = async (index) => {
+        if (index >= handlers.length) {
+          return honoNext();
+        }
+
+        const handler = handlers[index];
+        if (typeof handler !== "function") {
+          return dispatch(index + 1);
+        }
+
+        let nextCalled = false;
+        let nextPromise = null;
+        const next = () => {
+          nextCalled = true;
+          nextPromise = dispatch(index + 1);
+          return nextPromise;
+        };
+
+        const result = handler(request, response, next);
+        const settled =
+          result && typeof result.then === "function" ? await result : result;
+
+        if (settled instanceof Response) return settled;
+        if (response.__hasResponse()) return response.__getResponse();
+        if (nextCalled) return await nextPromise;
+        return undefined;
+      };
+
+      return dispatch(0);
+    };
+  };
+
+  const adapter = {
+    hono,
+    fetch: hono.fetch.bind(hono),
+    use(pathOrHandler, ...rest) {
+      if (typeof pathOrHandler === "function") {
+        if (pathOrHandler.length >= 3) {
+          hono.use("*", createHandler([pathOrHandler]));
+        } else {
+          hono.use("*", pathOrHandler);
+        }
+        return adapter;
+      }
+      const handlers = rest;
+      for (const entry of Array.isArray(pathOrHandler)
+        ? pathOrHandler
+        : [pathOrHandler]) {
+        if (entry instanceof RegExp) {
+          hono.use("*", guardMiddleware(entry, handlers));
+          continue;
+        }
+        const prefix = String(entry || "");
+        hono.all(prefix, createHandler(handlers));
+        const subPath = prefix.endsWith("/") ? `${prefix}*` : `${prefix}/*`;
+        hono.all(subPath, createHandler(handlers));
+      }
+      return adapter;
+    },
+  };
+
+  for (const method of kMethodNames) {
+    adapter[method] = (path, ...handlers) =>
+      registerRoute(method, path, handlers);
+  }
+
+  return adapter;
+};
+
+const guardMiddleware = (pattern, handlers) => async (context, next) => {
+  if (!pattern.test(context.req.path)) return next();
+  const request = createRequestFacade(context);
+  const response = createResponseFacade(context);
+  let calledNext = false;
+  for (const handler of handlers) {
+    const result = handler(request, response, () => {
+      calledNext = true;
+    });
+    if (result && typeof result.then === "function") await result;
+    if (result instanceof Response) return result;
+    if (response.__hasResponse()) return response.__getResponse();
+    if (calledNext) return next();
+  }
+  return next();
+};
+
+module.exports = {
+  createRouteAdapter,
+  translateRegExpPath,
+};
diff --git a/lib/server/http/sse.js b/lib/server/http/sse.js
new file mode 100644
index 0000000..dd484c1
--- /dev/null
+++ b/lib/server/http/sse.js
@@ -0,0 +1,52 @@
+const kSseHeaders = {
+  "Content-Type": "text/event-stream",
+  "Cache-Control": "no-cache, no-transform",
+  Connection: "keep-alive",
+  "X-Accel-Buffering": "no",
+};
+
+const openSseStream = (response) => {
+  response.status(200);
+  for (const [key, value] of Object.entries(kSseHeaders)) {
+    response.setHeader(key, value);
+  }
+  response.flushHeaders();
+
+  return {
+    write(chunk) {
+      response.write(chunk);
+    },
+    writeEvent(event, data) {
+      response.write(`event: ${event}\n`);
+      response.write(`data: ${JSON.stringify(data)}\n\n`);
+    },
+    writeComment(comment = "keepalive") {
+      response.write(`: ${comment}\n\n`);
+    },
+    close() {
+      response.end();
+    },
+  };
+};
+
+const writeSseComment = (response, comment = "keepalive") => {
+  response.write(`: ${comment}\n\n`);
+};
+
+const onStreamAbort = (request, handler) => {
+  let called = false;
+  const run = () => {
+    if (called) return;
+    called = true;
+    handler();
+  };
+  request.on("close", run);
+  return run;
+};
+
+module.exports = {
+  kSseHeaders,
+  onStreamAbort,
+  openSseStream,
+  writeSseComment,
+};
diff --git a/lib/server/http/static-files.js b/lib/server/http/static-files.js
new file mode 100644
index 0000000..a9cc968
--- /dev/null
+++ b/lib/server/http/static-files.js
@@ -0,0 +1,20 @@
+const path = require("path");
+const { serveStatic } = require("@hono/node-server/serve-static");
+
+const kPublicRoot = path.join(__dirname, "..", "..", "public");
