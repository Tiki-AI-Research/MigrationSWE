diff --git a/tests/server/helpers/hono-test-app.js b/tests/server/helpers/hono-test-app.js
new file mode 100644
index 0000000..e4beb56
--- /dev/null
+++ b/tests/server/helpers/hono-test-app.js
@@ -0,0 +1,72 @@
+const { getRequestListener, createAdaptorServer } = require("@hono/node-server");
+const { createHonoApp } = require("../../../lib/server/http/hono-app");
+const {
+  createJsonBodyMiddleware,
+  createRawBodyMiddleware,
+  createV1BodyMiddleware,
+} = require("../../../lib/server/http/body-limits");
+
+const kDefaultJsonLimit = 5 * 1024 * 1024;
+const kDefaultV1Limit = 50 * 1024 * 1024;
+
+const parseByteLimit = (value, fallback) => {
+  if (typeof value === "number" && Number.isFinite(value)) return value;
+  if (typeof value !== "string") return fallback;
+  const match = value.trim().toLowerCase().match(/^(\d+(?:\.\d+)?)\s*(kb|mb|gb|b)?$/);
+  if (!match) return fallback;
+  const amount = Number(match[1]);
+  const unit = match[2] || "b";
+  const multipliers = { b: 1, kb: 1024, mb: 1024 * 1024, gb: 1024 * 1024 * 1024 };
+  return Math.floor(amount * multipliers[unit]);
+};
+
+const createTestHonoApp = ({
+  trustProxy,
+  jsonLimit = kDefaultJsonLimit,
+  v1JsonLimit = kDefaultV1Limit,
+  v1Enabled = true,
+  raw = true,
+} = {}) => {
+  const app = createHonoApp();
+
+  if (trustProxy !== undefined) {
+    app.hono.use("*", async (context, next) => {
+      context.set("alphaclaw.trustProxyHops", trustProxy);
+      await next();
+    });
+  }
+  if (raw) {
+    app.hono.use(
+      "*",
+      createRawBodyMiddleware({ limitBytes: parseByteLimit(jsonLimit, kDefaultJsonLimit) }),
+    );
+  }
+  app.hono.use(
+    "*",
+    createV1BodyMiddleware({
+      limitBytes: parseByteLimit(v1JsonLimit, kDefaultV1Limit),
+      isEnabled: () => v1Enabled,
+    }),
+  );
+  app.hono.use(
+    "*",
+    createJsonBodyMiddleware({
+      limitBytes: parseByteLimit(jsonLimit, kDefaultJsonLimit),
+    }),
+  );
+
+  const listener = getRequestListener(app.fetch);
+  Object.assign(listener, app);
+  return listener;
+};
+
+const createTestServer = (options = {}) => {
+  const app = createTestHonoApp(options);
+  return createAdaptorServer({ fetch: app.fetch });
+};
+
+module.exports = {
+  createTestHonoApp,
+  createTestServer,
+  parseByteLimit,
+};
diff --git a/tests/server/hono-server-contract.test.js b/tests/server/hono-server-contract.test.js
new file mode 100644
index 0000000..d63d7f1
--- /dev/null
+++ b/tests/server/hono-server-contract.test.js
@@ -0,0 +1,254 @@
+const http = require("http");
+const zlib = require("zlib");
+const request = require("supertest");
+
+const { createTestHonoApp } = require("./helpers/hono-test-app");
+const { createPublicStaticMiddleware } = require("../../lib/server/http/static-files");
+const { registerAuthRoutes } = require("../../lib/server/routes/auth");
+const { registerPageRoutes } = require("../../lib/server/routes/pages");
+const { registerProxyRoutes } = require("../../lib/server/routes/proxy");
+const { registerChatRoutes } = require("../../lib/server/routes/chat");
+
+const createLoginThrottleMock = () => ({
+  getClientKey: vi.fn(() => "client-key"),
+  getOrCreateLoginAttemptState: vi.fn(() => ({ attempts: 0 })),
+  evaluateLoginThrottle: vi.fn(() => ({ blocked: false, retryAfterSec: 0 })),
+  recordLoginFailure: vi.fn(() => ({ lockMs: 0, locked: false })),
+  recordLoginSuccess: vi.fn(),
+  cleanupLoginAttemptStates: vi.fn(),
+});
+
+const withServer = async (app, run) => {
+  const server = http.createServer(app);
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  try {
+    return await run(server.address().port);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+};
+
+const httpRequest = ({ port, method = "GET", path, headers = {}, body }) =>
+  new Promise((resolve, reject) => {
+    const req = http.request(
+      { port, host: "127.0.0.1", method, path, headers },
+      (res) => {
+        const chunks = [];
+        res.on("data", (chunk) => chunks.push(chunk));
+        res.on("end", () =>
+          resolve({
+            status: res.statusCode,
+            headers: res.headers,
+            text: Buffer.concat(chunks).toString("utf8"),
+          }),
+        );
+      },
+    );
+    req.on("error", reject);
+    if (body) req.write(body);
+    req.end();
+  });
+
+const buildAuthApp = ({ trustProxy } = {}) => {
+  process.env.SETUP_PASSWORD = "secret";
+  const app = createTestHonoApp({ trustProxy });
+  app.use(createPublicStaticMiddleware());
+  const throttle = createLoginThrottleMock();
+  const { requireAuth } = registerAuthRoutes({
+    app,
+    loginThrottle: throttle,
+  });
+  registerPageRoutes({
+    app,
+    requireAuth,
+    isGatewayRunning: async () => true,
+  });
+  app.get("/api/protected", (req, res) => res.json({ ok: true }));
+  app.get("/setup/protected", (req, res) => res.json({ ok: true }));
+  app.get("/auth/protected", (req, res) => res.json({ ok: true }));
+  return { app, throttle };
+};
+
+describe("Hono server contract", () => {
+  afterEach(() => {
+    delete process.env.SETUP_PASSWORD;
+  });
+
+  it("keeps public routes public and protects exact and nested prefixes", async () => {
+    const { app } = buildAuthApp();
+
+    const health = await request(app).get("/health");
+    expect(health.status).toBe(200);
+    expect(health.body).toEqual({ status: "healthy", gateway: "running" });
+
+    expect((await request(app).get("/login.html")).status).toBe(200);
+    expect((await request(app).get("/")).status).toBe(302);
+    expect((await request(app).get("/setup")).status).toBe(302);
+    expect((await request(app).get("/setup/protected")).status).toBe(302);
+    expect((await request(app).get("/auth/protected")).status).toBe(302);
+
+    const api = await request(app).get("/api/protected");
+    expect(api.status).toBe(401);
+    expect(api.body).toEqual({ error: "Unauthorized" });
+
+    const status = await request(app).get("/api/auth/status");
+    expect(status.status).toBe(200);
+    expect(status.body).toEqual({ authEnabled: true });
+  });
+
+  it("sets a session cookie and rejects query-string setup tokens", async () => {
+    const { app } = buildAuthApp();
+    const login = await request(app)
+      .post("/api/auth/login")
+      .send({ password: "secret" });
+    expect(login.status).toBe(200);
+    expect(login.body).toEqual({ ok: true });
+    const setCookie = login.headers["set-cookie"][0];
+    expect(setCookie).toContain("HttpOnly");
+    expect(setCookie).toContain("SameSite=Lax");
+    expect(setCookie).toContain("Path=/");
+    expect(setCookie).toContain("Max-Age=604800");
+
+    const cookie = setCookie.split(";")[0];
+    expect(
+      (await request(app).get("/api/protected").set("Cookie", cookie)).status,
+    ).toBe(200);
+    expect(
+      (await request(app).get("/setup/protected").set("Cookie", cookie)).status,
+    ).toBe(200);
+
+    const queryToken = cookie.slice("setup_token=".length);
+    const rejected = await request(app).get(
+      `/api/protected?token=${queryToken}`,
+    );
+    expect(rejected.status).toBe(401);
+    expect(rejected.body).toEqual({ error: "Unauthorized" });
+  });
+
+  it("returns JSON 404 for unwhitelisted /v1 paths without contacting the gateway", async () => {
+    const app = createTestHonoApp();
+    const getGatewayUrl = vi.fn(() => "http://127.0.0.1:1");
+    registerProxyRoutes({
+      app,
+      proxy: {},
+      getGatewayUrl,
+      getGatewayToken: () => "gateway-token",
+      isOpenAiCompatApiEnabled: () => true,
+      openAiCompatApiThrottle: null,
+      SETUP_API_PREFIXES: [],
+      requireAuth: (_req, _res, next) => next(),
+      oauthCallbackMiddleware: (_req, res) => res.status(204).end(),
+      webhookMiddleware: (_req, res) => res.status(204).end(),
+    });
+
+    for (const path of ["/v1/unknown", "/v1/models/a/b", "/v1"]) {
+      const response = await request(app).get(path);
+      expect(response.status).toBe(404);
+      expect(response.body).toEqual({ error: "Not found" });
+    }
+    expect(getGatewayUrl).not.toHaveBeenCalled();
+
+    const unauthorized = await request(app)
+      .post("/v1/chat/completions")
+      .send({ model: "openclaw/default" });
+    expect(unauthorized.status).toBe(401);
+    expect(unauthorized.body).toEqual({ error: "Unauthorized" });
+  });
+
+  it("serves GET /api/chat/history with authentication and payload contracts", async () => {
+    const app = createTestHonoApp();
+    const fetchHistory = vi.fn(async (sessionKey) => ({
+      messages: [{ role: "user", content: sessionKey }],
+      rawHistory: { sessionKey },
+    }));
+    registerChatRoutes({
+      app,
+      isAuthorizedRequest: (req) => req.headers.cookie === "setup_token=ok",
+      chatWsService: { fetchHistory },
+    });
+
+    const unauthorized = await request(app).get("/api/chat/history");
+    expect(unauthorized.status).toBe(401);
+    expect(unauthorized.body).toEqual({ ok: false, error: "Unauthorized" });
+
+    const missing = await request(app)
+      .get("/api/chat/history")
+      .set("Cookie", "setup_token=ok");
+    expect(missing.status).toBe(400);
+    expect(missing.body).toEqual({
+      ok: false,
+      error: "sessionKey is required",
+    });
+
+    const success = await request(app)
+      .get("/api/chat/history?sessionKey=agent%3Amain%3Amain")
+      .set("Cookie", "setup_token=ok");
+    expect(success.status).toBe(200);
+    expect(success.body).toEqual({
+      ok: true,
+      sessionKey: "agent:main:main",
+      messages: [{ role: "user", content: "agent:main:main" }],
+      rawHistory: { sessionKey: "agent:main:main" },
+    });
+    expect(fetchHistory).toHaveBeenCalledWith("agent:main:main");
+
+    fetchHistory.mockRejectedValueOnce(new Error("gateway exploded"));
+    const failed = await request(app)
+      .get("/api/chat/history?sessionKey=agent%3Amain%3Amain")
+      .set("Cookie", "setup_token=ok");
+    expect(failed.status).toBe(502);
+    expect(failed.body).toEqual({
+      ok: false,
+      error: "gateway exploded",
+    });
+  });
+
+  it("inflates gzip JSON request bodies before parsing", async () => {
+    const app = createTestHonoApp();
+    app.post("/api/echo", (req, res) => res.json({ body: req.body }));
+
+    const payload = { hello: "world", nested: { ok: true } };
+    const compressed = zlib.gzipSync(JSON.stringify(payload));
+
+    await withServer(app, async (port) => {
+      const response = await httpRequest({
+        port,
+        method: "POST",
+        path: "/api/echo",
+        headers: {
+          "content-type": "application/json",
+          "content-encoding": "gzip",
+          "content-length": String(compressed.length),
+        },
+        body: compressed,
+      });
+      expect(response.status).toBe(200);
+      expect(JSON.parse(response.text)).toEqual({ body: payload });
+    });
+  });
+
+  it("rejects oversized JSON bodies before the handler runs", async () => {
+    const app = createTestHonoApp({ jsonLimit: "1kb" });
+    const handler = vi.fn((req, res) => res.json({ ok: true }));
+    app.post("/api/echo", handler);
+
+    await withServer(app, async (port) => {
+      const body = Buffer.from(
+        JSON.stringify({ value: "x".repeat(4096) }),
+        "utf8",
+      );
+      const response = await httpRequest({
+        port,
+        method: "POST",
+        path: "/api/echo",
+        headers: {
+          "content-type": "application/json",
+          "content-length": String(body.length),
+        },
+        body,
+      });
+      expect(response.status).toBe(413);
+    });
+    expect(handler).not.toHaveBeenCalled();
+  });
+});
