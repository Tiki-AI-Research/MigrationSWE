diff --git a/lib/server/http/body-limits.js b/lib/server/http/body-limits.js
new file mode 100644
index 0000000..ca0512c
--- /dev/null
+++ b/lib/server/http/body-limits.js
@@ -0,0 +1,231 @@
+const zlib = require("zlib");
+const {
+  kBodyConsumedKey,
+  kBodyKey,
+} = require("./request-response");
+
+const kRawBodyPrefixes = ["/webhook", "/hooks", "/gmail-pubsub"];
+
+const matchesPrefix = (path, prefix) =>
+  path === prefix || String(path || "").startsWith(`${prefix}/`);
+
+const isRawBodyPath = (path) =>
+  kRawBodyPrefixes.some((prefix) => matchesPrefix(path, prefix));
+
+const isV1Path = (path) =>
+  path === "/v1" || String(path || "").startsWith("/v1/");
+
+const parseContentType = (value) =>
+  String(value || "").split(";")[0].trim().toLowerCase();
+
+const isJsonContentType = (value) => {
+  const contentType = parseContentType(value);
+  return (
+    contentType === "application/json" ||
+    contentType.endsWith("+json")
+  );
+};
+
+const inflateBodyBuffer = (buffer, contentEncoding) => {
+  const encoding = String(contentEncoding || "").trim().toLowerCase();
+  if (!encoding || encoding === "identity" || buffer.length === 0) {
+    return buffer;
+  }
+  if (encoding === "gzip" || encoding === "x-gzip") {
+    return zlib.gunzipSync(buffer);
+  }
+  if (encoding === "deflate") {
+    return zlib.inflateSync(buffer);
+  }
+  if (encoding === "br") {
+    return zlib.brotliDecompressSync(buffer);
+  }
+  return buffer;
+};
+
+const payloadTooLarge = (context) =>
+  context.json({ error: "Payload too large" }, 413);
+
+const invalidBody = (context) =>
+  context.json({ error: "Invalid request body" }, 400);
+
+const hasIncomingBody = (context) => {
+  if (context.req.header("transfer-encoding")) return true;
+  const declaredLength = Number(context.req.header("content-length"));
+  return Number.isFinite(declaredLength) && declaredLength > 0;
+};
+
+const readIncomingRequestBody = async (incoming, limitBytes) => {
+  const chunks = [];
+  let total = 0;
+  try {
+    for await (const value of incoming) {
+      const chunk = Buffer.isBuffer(value) ? value : Buffer.from(value);
+      total += chunk.length;
+      if (total > limitBytes) {
+        incoming.destroy();
+        return { oversized: true, buffer: Buffer.alloc(0) };
+      }
+      chunks.push(chunk);
+    }
+  } catch {
+    return { invalid: true, buffer: Buffer.alloc(0) };
+  }
+  return { oversized: false, buffer: Buffer.concat(chunks) };
+};
+
+const readRequestBody = async (context, limitBytes) => {
+  const request = context.req.raw;
+  if (request.body) {
+    const reader = request.body.getReader();
+    const chunks = [];
+    let total = 0;
+    try {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        const chunk = Buffer.from(value);
+        total += chunk.length;
+        if (total > limitBytes) {
+          try {
+            await reader.cancel();
+          } catch {}
+          return { oversized: true, buffer: Buffer.alloc(0) };
+        }
+        chunks.push(chunk);
+      }
+    } finally {
+      try {
+        reader.releaseLock();
+      } catch {}
+    }
+    return { oversized: false, buffer: Buffer.concat(chunks) };
+  }
+
+  // Fetch Request objects cannot carry a body on GET/HEAD, so the Node
+  // adapter exposes no request.body for those methods. Read the underlying
+  // IncomingMessage when the headers indicate a body is present.
+  const incoming = context.env?.incoming;
+  if (
+    incoming &&
+    !incoming.readableDidRead &&
+    hasIncomingBody(context)
+  ) {
+    return readIncomingRequestBody(incoming, limitBytes);
+  }
+
+  return { oversized: false, buffer: Buffer.alloc(0) };
+};
+
+const readInflatedBody = async ({
+  context,
+  limitBytes,
+  allowEmpty = true,
+}) => {
+  const contentEncoding = context.req.header("content-encoding") || "";
+  const declaredLength = Number(context.req.header("content-length"));
+  if (
+    Number.isFinite(declaredLength) &&
+    declaredLength > limitBytes &&
+    !contentEncoding
+  ) {
+    return { oversized: true };
+  }
+
+  const readResult = await readRequestBody(context, limitBytes);
+  if (readResult.oversized) return { oversized: true };
+
+  let inflated;
+  try {
+    inflated = inflateBodyBuffer(readResult.buffer, contentEncoding);
+  } catch {
+    return { invalid: true };
+  }
+  if (inflated.length > limitBytes) return { oversized: true };
+  if (inflated.length === 0 && !allowEmpty) return { empty: true };
+  return { buffer: inflated, empty: inflated.length === 0 };
+};
+
+const createRawBodyMiddleware = ({ limitBytes = 5 * 1024 * 1024 } = {}) => {
+  return async (context, next) => {
+    if (!isRawBodyPath(context.req.path)) return next();
+    if (context.get(kBodyConsumedKey)) return next();
+
+    const result = await readInflatedBody({ context, limitBytes });
+    if (result.oversized) return payloadTooLarge(context);
+    if (result.invalid) return invalidBody(context);
+    context.set(kBodyConsumedKey, true);
+    if (!result.empty) {
+      context.set(kBodyKey, result.buffer);
+    }
+    return next();
+  };
+};
+
+const createV1BodyMiddleware = ({
+  limitBytes = 50 * 1024 * 1024,
+  isEnabled = () => true,
+} = {}) => {
+  return async (context, next) => {
+    if (!isV1Path(context.req.path)) return next();
+    if (!isEnabled()) {
+      return context.json({ error: "Not found" }, 404);
+    }
+    if (context.get(kBodyConsumedKey)) return next();
+
+    const result = await readInflatedBody({ context, limitBytes });
+    if (result.oversized) return payloadTooLarge(context);
+    if (result.invalid) return invalidBody(context);
+    context.set(kBodyConsumedKey, true);
+    if (result.empty) return next();
+
+    try {
+      context.set(kBodyKey, JSON.parse(result.buffer.toString("utf8")));
+    } catch {
+      return invalidBody(context);
+    }
+    return next();
+  };
+};
+
+const createJsonBodyMiddleware = ({ limitBytes = 5 * 1024 * 1024 } = {}) => {
+  return async (context, next) => {
+    if (context.get(kBodyConsumedKey)) return next();
+    if (!isJsonContentType(context.req.header("content-type"))) return next();
+
+    const result = await readInflatedBody({ context, limitBytes });
+    if (result.oversized) return payloadTooLarge(context);
+    if (result.invalid) return invalidBody(context);
+    context.set(kBodyConsumedKey, true);
+    if (result.empty) return next();
+
+    try {
+      context.set(kBodyKey, JSON.parse(result.buffer.toString("utf8")));
+    } catch {
+      return invalidBody(context);
+    }
+    return next();
+  };
+};
+
+const readUnconsumedBody = async (context, limitBytes = 5 * 1024 * 1024) => {
+  if (context.get(kBodyConsumedKey)) return null;
+  const result = await readInflatedBody({ context, limitBytes });
+  if (result.oversized) return { oversized: true };
+  if (result.invalid) return { invalid: true };
+  context.set(kBodyConsumedKey, true);
+  return { buffer: result.buffer, empty: result.empty };
+};
+
+module.exports = {
+  createJsonBodyMiddleware,
+  createRawBodyMiddleware,
+  createV1BodyMiddleware,
+  inflateBodyBuffer,
+  isJsonContentType,
+  isRawBodyPath,
+  isV1Path,
+  matchesPrefix,
+  readRequestBody,
+  readUnconsumedBody,
+};
diff --git a/lib/server/http/client-ip.js b/lib/server/http/client-ip.js
new file mode 100644
index 0000000..accb3fa
--- /dev/null
+++ b/lib/server/http/client-ip.js
@@ -0,0 +1,62 @@
+const { normalizeIp } = require("../utils/network");
+const { kTrustProxyHops } = require("../constants");
+
+const parseForwardedFor = (value) => {
+  if (value === undefined || value === null) return [];
+  const rawValues = Array.isArray(value) ? value : [value];
+  return rawValues
+    .flatMap((entry) => String(entry || "").split(","))
+    .map((entry) => normalizeIp(entry.trim()))
+    .filter(Boolean);
+};
+
+const getSocketRemoteAddress = (context) => {
+  const incoming = context?.env?.incoming;
+  return (
+    incoming?.socket?.remoteAddress ||
+    incoming?.connection?.remoteAddress ||
+    ""
+  );
+};
+
+const resolveClientIp = ({
+  headers = {},
+  remoteAddress = "",
+  trustProxyHops = kTrustProxyHops,
+} = {}) => {
+  const remote = normalizeIp(remoteAddress);
+  const hops = Number.isFinite(Number(trustProxyHops))
+    ? Math.max(0, Number(trustProxyHops))
+    : 0;
+  if (hops === 0) return remote || "unknown";
+
+  const forwarded = parseForwardedFor(headers["x-forwarded-for"]);
+  if (forwarded.length === 0) return remote || "unknown";
+
+  const index = forwarded.length - hops;
+  if (index >= 0 && index < forwarded.length) return forwarded[index];
+  return forwarded[0] || remote || "unknown";
+};
+
+const resolveClientIpFromContext = (context, trustProxyHops) =>
+  resolveClientIp({
+    headers: Object.fromEntries(context.req.raw.headers.entries()),
+    remoteAddress: getSocketRemoteAddress(context),
+    trustProxyHops:
+      trustProxyHops === undefined
+        ? context.get?.("alphaclaw.trustProxyHops")
+        : trustProxyHops,
+  });
+
+const createClientKeyResolver = (context) => {
+  const clientIp = resolveClientIpFromContext(context);
+  return () => clientIp;
+};
+
+module.exports = {
+  createClientKeyResolver,
+  getSocketRemoteAddress,
+  parseForwardedFor,
+  resolveClientIp,
+  resolveClientIpFromContext,
+};
diff --git a/lib/server/http/gateway-proxy.js b/lib/server/http/gateway-proxy.js
new file mode 100644
index 0000000..3cb8c60
--- /dev/null
+++ b/lib/server/http/gateway-proxy.js
@@ -0,0 +1,397 @@
+const crypto = require("crypto");
+const http = require("http");
+const https = require("https");
+const { Readable } = require("stream");
+const { URL } = require("url");
+const { kBodyConsumedKey } = require("./request-response");
+const { readRequestBody } = require("./body-limits");
+
+const kOpenAiCompatProxyPathPattern =
+  /^\/v1\/(?:chat\/completions|responses|embeddings|models(?:\/[^/?#]+)?)$/;
+const kHopByHopResponseHeaders = new Set([
+  "connection",
+  "keep-alive",
+  "proxy-authenticate",
+  "proxy-authorization",
+  "te",
+  "trailer",
+  "trailers",
+  "transfer-encoding",
+  "upgrade",
+]);
+const kAlwaysStrippedResponseHeaders = new Set(["set-cookie"]);
+const kTransportRequestHeaders = new Set([
+  "connection",
+  "keep-alive",
+  "transfer-encoding",
+  "upgrade",
+]);
+
+const extractBearerToken = (authorization) =>
+  String(authorization || "").match(/^Bearer\s+(.+)$/i)?.[1]?.trim() || "";
+
+const extractBodyBuffer = (req) => {
+  if (Buffer.isBuffer(req.body)) return req.body;
+  if (typeof req.body === "string") return Buffer.from(req.body, "utf8");
+  if (req.body && typeof req.body === "object") {
+    return Buffer.from(JSON.stringify(req.body), "utf8");
+  }
+  return Buffer.alloc(0);
+};
+
+const getApiAuthThrottleState = (authThrottle, req, now) => {
+  if (
+    !authThrottle ||
+    typeof authThrottle.getOrCreateLoginAttemptState !== "function"
+  ) {
+    return null;
+  }
+  const clientKey =
+    typeof authThrottle.getClientKey === "function"
+      ? authThrottle.getClientKey(req)
+      : req.ip || req.socket?.remoteAddress || "unknown";
+  return {
+    clientKey,
+    state: authThrottle.getOrCreateLoginAttemptState(clientKey, now),
+  };
+};
+
+const sendTooManyAuthAttempts = (retryAfterSec = 1) => {
+  const normalizedRetryAfterSec = Math.max(
+    1,
+    Math.ceil(Number(retryAfterSec) || 1),
+  );
+  return new Response(
+    JSON.stringify({
+      error: "Too many attempts. Try again shortly.",
+      retryAfterSec: normalizedRetryAfterSec,
+    }),
+    {
+      status: 429,
+      headers: {
+        "content-type": "application/json; charset=utf-8",
+        "retry-after": String(normalizedRetryAfterSec),
+      },
+    },
+  );
+};
+
+const timingSafeStringEqual = (left, right) => {
+  const leftBuffer = Buffer.from(String(left || ""), "utf8");
+  const rightBuffer = Buffer.from(String(right || ""), "utf8");
+  return (
+    leftBuffer.length === rightBuffer.length &&
+    crypto.timingSafeEqual(leftBuffer, rightBuffer)
+  );
+};
+
+const createGatewayProxyHeaders = ({ reqHeaders, bodyBuffer }) => {
+  const headers = { ...(reqHeaders || {}) };
+  delete headers.host;
+  delete headers.connection;
+  delete headers["content-length"];
+  delete headers["transfer-encoding"];
+  delete headers["content-encoding"];
+  delete headers.cookie;
+  if (bodyBuffer.length > 0) {
+    headers["content-length"] = String(bodyBuffer.length);
+    if (!headers["content-type"]) headers["content-type"] = "application/json";
+  }
+  return headers;
+};
+
+const stripV1ResponseHeaders = (sourceHeaders = {}) => {
+  const headers = {};
+  for (const [key, value] of Object.entries(sourceHeaders)) {
+    if (value === undefined || value === null) continue;
+    const lowerKey = key.toLowerCase();
+    if (kHopByHopResponseHeaders.has(lowerKey)) continue;
+    if (kAlwaysStrippedResponseHeaders.has(lowerKey)) continue;
+    headers[lowerKey] = value;
+  }
+  return headers;
+};
+
+const toResponseHeaders = (sourceHeaders = {}, { stripV1 = false } = {}) => {
+  const result = new Headers();
+  for (const [key, value] of Object.entries(sourceHeaders || {})) {
+    if (value === undefined || value === null) continue;
+    const lowerKey = key.toLowerCase();
+    if (stripV1) {
+      if (kHopByHopResponseHeaders.has(lowerKey)) continue;
+      if (kAlwaysStrippedResponseHeaders.has(lowerKey)) continue;
+    } else if (kTransportRequestHeaders.has(lowerKey)) {
+      continue;
+    }
+    if (Array.isArray(value)) {
+      for (const entry of value) result.append(lowerKey, String(entry));
+    } else {
+      result.set(lowerKey, String(value));
+    }
+  }
+  return result;
+};
+
+const gatewayUnavailableResponse = () =>
+  new Response(JSON.stringify({ error: "Gateway unavailable" }), {
+    status: 502,
+    headers: { "content-type": "application/json; charset=utf-8" },
+  });
+
+const sendGatewayRequest = ({
+  gateway,
+  method,
+  path,
+  headers,
+  bodyBuffer,
+  bodyStream,
+  stripResponseHeaders = false,
+}) =>
+  new Promise((resolve) => {
+    const protocolClient = gateway.protocol === "https:" ? https : http;
+    let settled = false;
+    const finish = (response) => {
+      if (settled) return;
+      settled = true;
+      resolve(response);
+    };
+
+    let proxyReq;
+    try {
+      proxyReq = protocolClient.request(
+        {
+          protocol: gateway.protocol,
+          hostname: gateway.hostname,
+          port: gateway.port,
+          method,
+          path,
+          headers,
+        },
+        (proxyRes) => {
+          const responseHeaders = toResponseHeaders(proxyRes.headers, {
+            stripV1: stripResponseHeaders,
+          });
+          const status = proxyRes.statusCode || 502;
+          const bodyAllowed =
+            String(method || "").toUpperCase() !== "HEAD" &&
+            ![204, 205, 304].includes(status);
+          if (!bodyAllowed) proxyRes.resume();
+          finish(
+            new Response(bodyAllowed ? Readable.toWeb(proxyRes) : null, {
+              status,
+              headers: responseHeaders,
+            }),
+          );
+        },
+      );
+    } catch {
+      finish(gatewayUnavailableResponse());
+      return;
+    }
+
+    proxyReq.on("error", () => finish(gatewayUnavailableResponse()));
+
+    if (bodyStream) {
+      bodyStream.on("error", () => {
+        if (!settled) {
+          proxyReq.destroy();
+          finish(gatewayUnavailableResponse());
+        }
+      });
+      bodyStream.pipe(proxyReq);
+      return;
+    }
+
+    if (bodyBuffer && bodyBuffer.length > 0) {
+      proxyReq.write(bodyBuffer);
+    }
+    proxyReq.end();
+  });
+
+const resolveGateway = (getGatewayUrl) => {
+  try {
+    return new URL(getGatewayUrl());
+  } catch {
+    return null;
+  }
+};
+
+const readProxyRequestBody = async (req, context) => {
+  const directBody = extractBodyBuffer(req);
+  if (directBody.length > 0) return directBody;
+  if (context?.get?.(kBodyConsumedKey)) return directBody;
+  if (!context?.req?.raw?.body) return directBody;
+  const result = await readRequestBody(context, 50 * 1024 * 1024);
+  if (result.oversized) return null;
+  return result.buffer;
+};
+
+const isWebReadableStream = (value) =>
+  Boolean(value && typeof value.getReader === "function");
+
+const hasNodeRequestBody = (context) => {
+  if (context?.req?.header?.("transfer-encoding")) return true;
+  const declaredLength = Number(context?.req?.header?.("content-length"));
+  return Number.isFinite(declaredLength) && declaredLength > 0;
+};
+
+const resolveGatewayProxyBody = (req, context) => {
+  const directBody = extractBodyBuffer(req);
+  if (directBody.length > 0) {
+    return { bodyBuffer: directBody, bodyStream: null };
+  }
+  if (context?.get?.(kBodyConsumedKey)) {
+    return { bodyBuffer: directBody, bodyStream: null };
+  }
+
+  const requestBody = context?.req?.raw?.body;
+  if (isWebReadableStream(requestBody)) {
+    return {
+      bodyBuffer: null,
+      bodyStream: Readable.fromWeb(requestBody),
+    };
+  }
+
+  const incoming = context?.env?.incoming;
+  if (
+    incoming &&
+    !incoming.readableDidRead &&
+    !incoming.readableEnded &&
+    hasNodeRequestBody(context)
+  ) {
+    return { bodyBuffer: null, bodyStream: incoming };
+  }
+
+  return { bodyBuffer: directBody, bodyStream: null };
+};
+
+const proxyGatewayRequest = async ({ req, context, getGatewayUrl }) => {
+  const gateway = resolveGateway(getGatewayUrl);
+  if (!gateway) return gatewayUnavailableResponse();
+
+  const { bodyBuffer, bodyStream } = resolveGatewayProxyBody(req, context);
+
+  const headers = { ...(req.headers || {}) };
+  for (const key of kTransportRequestHeaders) delete headers[key];
+  delete headers.host;
+  headers.host = gateway.host;
+  if (!bodyStream) {
+    delete headers["content-length"];
+    if (bodyBuffer.length > 0) {
+      headers["content-length"] = String(bodyBuffer.length);
+      if (
+        req.body &&
+        typeof req.body === "object" &&
+        !Buffer.isBuffer(req.body)
+      ) {
+        delete headers["content-encoding"];
+      }
+    }
+  }
+
+  return sendGatewayRequest({
+    gateway,
+    method: req.method,
+    path: req.url || req.originalUrl || "/",
+    headers,
+    bodyBuffer,
+    bodyStream,
+  });
+};
+
+const proxyOpenAiCompatRequest = async ({
+  req,
+  context,
+  getGatewayUrl,
+  getGatewayToken,
+  openAiCompatApiThrottle,
+}) => {
+  const now = Date.now();
+  const throttleState = getApiAuthThrottleState(
+    openAiCompatApiThrottle,
+    req,
+    now,
+  );
+  if (
+    throttleState &&
+    typeof openAiCompatApiThrottle.evaluateLoginThrottle === "function"
+  ) {
+    const throttle = openAiCompatApiThrottle.evaluateLoginThrottle(
+      throttleState.state,
+      now,
+    );
+    if (throttle.blocked) {
+      return sendTooManyAuthAttempts(throttle.retryAfterSec);
+    }
+  }
+
+  const bearerToken = extractBearerToken(req.headers.authorization);
+  const expectedGatewayToken = String(getGatewayToken?.() || "").trim();
+  if (
+    !bearerToken ||
+    !expectedGatewayToken ||
+    !timingSafeStringEqual(bearerToken, expectedGatewayToken)
+  ) {
+    if (
+      throttleState &&
+      typeof openAiCompatApiThrottle.recordLoginFailure === "function"
+    ) {
+      const failure = openAiCompatApiThrottle.recordLoginFailure(
+        throttleState.state,
+        now,
+      );
+      if (failure.locked) {
+        return sendTooManyAuthAttempts(failure.retryAfterSec);
+      }
+    }
+    return new Response(JSON.stringify({ error: "Unauthorized" }), {
+      status: 401,
+      headers: { "content-type": "application/json; charset=utf-8" },
+    });
+  }
+
+  if (
+    throttleState?.clientKey &&
+    typeof openAiCompatApiThrottle?.recordLoginSuccess === "function"
+  ) {
+    openAiCompatApiThrottle.recordLoginSuccess(throttleState.clientKey);
+  }
+
+  const gateway = resolveGateway(getGatewayUrl);
+  if (!gateway) return gatewayUnavailableResponse();
+
+  const bodyBuffer = await readProxyRequestBody(req, context);
+  if (bodyBuffer === null) {
+    return new Response(JSON.stringify({ error: "Payload too large" }), {
+      status: 413,
+      headers: { "content-type": "application/json; charset=utf-8" },
+    });
+  }
+
+  const headers = createGatewayProxyHeaders({
+    reqHeaders: req.headers,
+    bodyBuffer,
+  });
+  headers.authorization = `Bearer ${bearerToken}`;
+
+  return sendGatewayRequest({
+    gateway,
+    method: req.method,
+    path: req.originalUrl || req.url || "/",
+    headers,
+    bodyBuffer,
+    stripResponseHeaders: true,
+  });
+};
+
+module.exports = {
+  createGatewayProxyHeaders,
+  extractBearerToken,
+  gatewayUnavailableResponse,
+  kAlwaysStrippedResponseHeaders,
+  kHopByHopResponseHeaders,
+  kOpenAiCompatProxyPathPattern,
+  proxyGatewayRequest,
+  proxyOpenAiCompatRequest,
+  stripV1ResponseHeaders,
+};
