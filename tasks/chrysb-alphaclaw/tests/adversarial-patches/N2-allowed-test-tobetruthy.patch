+const { Hono } = require("hono");
+const { createAdaptorServer } = require("@hono/node-server");
+const { createRouteAdapter } = require("./route-adapter");
+
+const createHonoApp = () => {
+  const hono = new Hono();
+  const app = createRouteAdapter({ hono });
+  return app;
+};
+
+const createHonoNodeServer = (app) =>
+  createAdaptorServer({
+    fetch: app.fetch,
+  });
+
+const buildServerApp = () => {
+  const app = createHonoApp();
+  const server = createHonoNodeServer(app);
+  return { app, server };
+};
+
+module.exports = {
+  buildServerApp,
+  createHonoApp,
+  createHonoNodeServer,
